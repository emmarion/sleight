    (subterm erased (Add a b c1) p) (erased (Add a b c2) q) -> (erased (Eq (Nat) c1 c2) e))
  (let-match erased p (AddSucc a1 _ d1 p1) ((AddZero _) (match erased q _ ((AddZero _) (Refl (Nat) c1)) (absurd AddSucc))))
  (let-match erased q (AddSucc _ _ d2 q1) (absurd AddZero))
  (match erased (add-fn a1 b d1 d2 p1 q1) _ ((Refl _ _) (Refl (Nat) c1))))

(def-fns _ $ (erased mul-fn : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c1) (erased (Nat) c2)
    (subterm erased (Mul a b c1) p) (erased (Mul a b c2) q) -> (erased (Eq (Nat) c1 c2) e))
  (let-match erased p (MulSucc a1 _ x1 _ m1 p1)
    ((MulZero _) (match erased q _ ((MulZero _) (Refl (Nat) c1)) (absurd MulSucc))))
  (let-match erased q (MulSucc _ _ x2 _ m2 q1) (absurd MulZero))
  (match erased (mul-fn a1 b x1 x2 m1 m2) _
    ((Refl _ _) (add-fn x1 b c1 c2 p1 q1))))

(def-fns _ $ (erased add-pos-lt : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c) (subterm erased (Add a b c) p) (erased (Lt (Zero) b) pos) -> (erased (Lt a c) q))
  (match erased p _
    ((AddZero _) pos)
    ((AddSucc a1 _ c1 p1) (LtS a1 c1 (add-pos-lt a1 b c1 p1 pos)))))

(def-fns _ $ (erased mul-le : (erased (Nat) q) (erased (Nat) c) (erased (Nat) k) (subterm erased (Mul q c k) mm) (erased (Lt (Zero) c) pos) -> (erased (Lt q (Succ k)) l))
  (match erased mm _
    ((MulZero _) (LtZ k))
    ((MulSucc q1 _ k1 _ mm1 p1)
      (LtS q1 k (lt-le-trans q1 (Succ k1) k (mul-le q1 c k1 mm1 pos) (LtS k1 k (add-pos-lt k1 c k p1 pos)))))))

(def-adts $ (Bin : -> Type)
  enum
  (many BZ : -> (Bin))
  (many B1 : (many (Bin) rest) -> (Bin))
  (many B2 : (many (Bin) rest) -> (Bin)))

(def-adts
  ((Numeral : ((Bin) b) ((Nat) n) -> Type)
    enum
    (many NZ : -> (Numeral (BZ) (Zero)))
    (many N1 : (erased (Bin) b) (erased (Nat) m) (erased (Nat) d) (erased (Numeral b m) v) (erased (Double m d) dd)
       -> (Numeral (B1 b) (Succ d)))
    (many N2 : (erased (Bin) b) (erased (Nat) m) (erased (Nat) d) (erased (Numeral b m) v) (erased (Double m d) dd)
       -> (Numeral (B2 b) (Succ (Succ d))))))

(def-fns _ $ (many bin-to-nat : (subterm many (Bin) b) -> (many (Nat) n) (erased (Numeral b n) v))
  (match many b _
    ((BZ) (values (Zero) (NZ)))
    ((B1 b1)
      (let ((many m) (erased v1)) (notail $ bin-to-nat b1))
      (let ((many d) (erased dd)) (double m))
      (values (Succ d) (N1 b1 m d v1 dd)))
    ((B2 b1)
      (let ((many m) (erased v1)) (notail $ bin-to-nat b1))
      (let ((many d) (erased dd)) (double m))
      (values (Succ (Succ d)) (N2 b1 m d v1 dd)))))

(def-fns _ $ (erased lt-unique :
    (erased (Nat) a) (erased (Nat) b) (subterm erased (Lt a b) p) (erased (Lt a b) q) ->
    (erased (Eq (Lt a b) p q) e))
  (let-match erased p (LtS a1 b1 p1) ((LtZ _) (match erased q _ ((LtZ _) (Refl (Lt a b) p)) (absurd LtS))))
  (let-match erased q (LtS _ _ q1) (absurd LtZ))
  (let ((erased ih)) (lt-unique a1 b1 p1 q1))
  (match erased ih _ ((Refl _ _) (Refl (Lt a b) p))))

(def-fns _ $ (erased double-fn :
    (erased (Nat) m) (erased (Nat) d1) (erased (Nat) d2)
    (subterm erased (Double m d1) p) (erased (Double m d2) q) -> (erased (Eq (Nat) d1 d2) e))
  (let-match erased p (DS a1 b1 pp) ((D0) (match erased q _ ((D0) (Refl (Nat) d1)) (absurd DS))))
  (let-match erased q (DS _ b2 qq) (absurd D0))
  (let ((erased ih)) (double-fn a1 b1 b2 pp qq))
  (match erased ih _ ((Refl _ _) (Refl (Nat) d1))))

(def-fns _ $ (erased pow2-fn : (erased (Nat) k) (erased (Nat) v) (erased (Nat) w)
    (subterm erased (Pow2 k v) p) (erased (Pow2 k w) q) -> (erased (Eq (Nat) v w) e))
  (let-match erased p (PS k1 v1 v2 p1 d1) ((P0) (match erased q _ ((P0) (Refl (Nat) (Succ (Zero)))) (absurd PS))))
  (let-match erased q (PS _ w1 w2 q1 d2)
    (absurd P0))
  (match erased (pow2-fn k1 v1 w1 p1 q1) _ ((Refl _ _) (double-fn v1 v2 w2 d1 d2))))

(def-fns _ $ (many extern shl : (many (Nat) n) (many (Nat) k) ->
    (many (Nat) r) (erased (Nat) v) (erased (Pow2 k v) pk) (erased (Mul n v r) p))
  (let ((many v) (erased pk) (erased _)) (pow2 k))
  (let ((many r) (erased p)) (mul n v))
  (values r v pk p))

(def-fns _ $ (many extern shr : (many (Nat) n) (many (Nat) k) ->
    (many (Nat) q) (erased (Nat) v) (erased (Pow2 k v) pk)
    (erased (Nat) m) (erased (Nat) r) (erased (Mul q v m) mm) (erased (Add m r n) a) (erased (Lt r v) p))
  (let ((many v) (erased pk) (erased pos)) (pow2 k))
  (let ((many q) (erased m) (erased r) (erased mm) (erased a) (erased p)) (div n v pos))
  (values q v pk m r mm a p))

(def-fns _ $ (many nat-shl at shl : (many (Nat) n) (many (Nat) k) -> (many (Nat) r))
  (let ((many r) (erased _) (erased _) (erased _)) (delegate (shl n k)))
  r)

(def-fns _ $ (many nat-shr at shr : (many (Nat) n) (many (Nat) k) -> (many (Nat) q))
  (let ((many q) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _)) (delegate (shr n k)))
  q)

(def-adts $ (Bit : -> Type)
  enum
  (many Bit0 : -> (Bit))
  (many Bit1 : -> (Bit)))

(def-adts $ (BitOp : -> Type)
  enum
  (many MkBitOp : (many (Bit) f01) (many (Bit) f10) (many (Bit) f11) -> (BitOp)))

(def-adts
  ((BitApply : ((BitOp) t) ((Bit) x) ((Bit) y) ((Bit) z) -> Type)
    enum
    (many Ap00 : (erased (BitOp) t) -> (BitApply t (Bit0) (Bit0) (Bit0)))
    (many Ap01 : (erased (Bit) f01) (erased (Bit) f10) (erased (Bit) f11) -> (BitApply (MkBitOp f01 f10 f11) (Bit0) (Bit1) f01))
    (many Ap10 : (erased (Bit) f01) (erased (Bit) f10) (erased (Bit) f11) -> (BitApply (MkBitOp f01 f10 f11) (Bit1) (Bit0) f10))
    (many Ap11 : (erased (Bit) f01) (erased (Bit) f10) (erased (Bit) f11) -> (BitApply (MkBitOp f01 f10 f11) (Bit1) (Bit1) f11)))
  ((BitCons : ((Nat) m) ((Bit) x) ((Nat) n) -> Type)
    enum
    (many BC0 : (erased (Nat) m) (erased (Nat) d) (erased (Double m d) dd) -> (BitCons m (Bit0) d))
    (many BC1 : (erased (Nat) m) (erased (Nat) d) (erased (Double m d) dd) -> (BitCons m (Bit1) (Succ d))))
  ((Bitwise : ((BitOp) t) ((Nat) a) ((Nat) b) ((Nat) c) -> Type)
    enum
    (many BwZero : (erased (BitOp) t) -> (Bitwise t (Zero) (Zero) (Zero)))
    (many BwBit : (erased (BitOp) t) (erased (Nat) a) (erased (Nat) b) (erased (Nat) c)
       (erased (Bit) x) (erased (Bit) y) (erased (Bit) z) (erased (Nat) a2) (erased (Nat) b2) (erased (Nat) c2)
       (erased (Bitwise t a b c) p) (erased (BitApply t x y z) e)
       (erased (BitCons a x a2) pa) (erased (BitCons b y b2) pb) (erased (BitCons c z c2) pc)
       -> (Bitwise t a2 b2 c2))))

(let ((many and-op)) (MkBitOp (Bit0) (Bit0) (Bit1)))

(let ((many or-op)) (MkBitOp (Bit1) (Bit1) (Bit1)))

(let ((many xor-op)) (MkBitOp (Bit1) (Bit1) (Bit0)))

(def-fns _ $ (erased double-lt : (erased (Nat) m) (erased (Nat) d) (subterm erased (Double m d) dd) -> (erased (Lt m (Succ d)) l))
  (match erased dd _
    ((D0) (LtZ (Zero)))
    ((DS a b d1) (LtS a (Succ (Succ b)) (lt-weaken a (Succ b) (double-lt a b d1))))))

(def-fns _ $ (erased bitcons-lt : (erased (Nat) m) (erased (Bit) x) (erased (Nat) n) (erased (BitCons m x n) p) (erased (Lt (Zero) n) pos) -> (erased (Lt m n) l))
  (let-match erased p (BC0 _ _ dd)
    ((BC1 _ d dd) (double-lt m d dd)))
  (match erased dd _
    (absurd (D0) pos)
    ((DS a b d1) (LtS a (Succ b) (double-lt a b d1)))))

(def-fns _ $ (many nat-bit : (many (Nat) n) -> (many (Nat) m) (many (Bit) x) (erased (BitCons m x n) p))
  (match many (nat-halve n) _
    ((HZ) (values (Zero) (Bit0) (BC0 (Zero) (Zero) (D0))))
    ((H1 m d dd) (values m (Bit1) (BC1 m d dd)))
    ((H2 m d dd) (values (Succ m) (Bit0) (BC0 (Succ m) (Succ (Succ d)) (DS m d dd))))))

(def-fns _ $ (many bit-snoc : (many (Nat) c) (many (Bit) z) -> (many (Nat) c2) (erased (BitCons c z c2) p))
  (let ((many d) (erased dd)) (double c))
  (match many z _
    ((Bit0) (values d (BC0 c d dd)))
    ((Bit1) (values (Succ d) (BC1 c d dd)))))

(def-fns _ $ (many bit-apply : (many (BitOp) t) (many (Bit) x) (many (Bit) y) -> (many (Bit) z) (erased (BitApply t x y z) e))
  (let-match many t (MkBitOp f01 f10 f11))
  (match many x _
    ((Bit0) (match many y _ ((Bit0) (values (Bit0) (Ap00 t))) ((Bit1) (values f01 (Ap01 f01 f10 f11)))))
    ((Bit1) (match many y _ ((Bit0) (values f10 (Ap10 f01 f10 f11))) ((Bit1) (values f11 (Ap11 f01 f10 f11)))))))

(def-fns _ $ (many bitwise-step : (many (BitOp) t) (erased (Nat) a) (erased (Nat) b) (erased (Nat) a1) (erased (Nat) b1)
    (many (Bit) x) (many (Bit) y) (erased (BitCons a1 x a) pa) (erased (BitCons b1 y b) pb)
    (many (Nat) c1) (erased (Bitwise t a1 b1 c1) p1) ->
    (many (Nat) c) (erased (Bitwise t a b c) p))
  (let ((many z) (erased e)) (bit-apply t x y))
  (let ((many c) (erased pc)) (bit-snoc c1 z))
  (values c (BwBit t a1 b1 c1 x y z a b c p1 e pa pb pc)))

(def-fns _ $ (many bitwise : (many (BitOp) t) (subterm many (Nat) a) (subterm many (Nat) b) -> (many (Nat) c) (erased (Bitwise t a b c) p))
  (let ((many a1) (many x) (erased pa)) (nat-bit a))
  (let ((many b1) (many y) (erased pb)) (nat-bit b))
  (match many a _
    ((Zero)
      (let-match many b (Succ b0) ((Zero) (values (Zero) (BwZero t))))
      (let-match erased pa (BC0 _ _ da) (absurd BC1))
      (let-match erased da (D0) (absurd DS))
      (let ((erased sb)) (lt-subterm b1 b (bitcons-lt b1 y b pb (LtZ b0))))
      (let ((many c1) (erased p1)) (notail $ bitwise t a1 (subterm sb) b1))
      (bitwise-step t a b a1 b1 x y pa pb c1 p1))
    ((Succ a0)
      (let ((erased sa)) (lt-subterm a1 a (bitcons-lt a1 x a pa (LtZ a0))))
      (let ((many c1) (erased p1)) (notail $ bitwise t (subterm sa) a1 b1))
      (bitwise-step t a b a1 b1 x y pa pb c1 p1))))

(def-fns _ $ (many extern nat-and : (many (Nat) a) (many (Nat) b) -> (many (Nat) c) (erased (Bitwise and-op a b c) p))
  (tail (bitwise and-op a b)))

(def-fns _ $ (many extern nat-or : (many (Nat) a) (many (Nat) b) -> (many (Nat) c) (erased (Bitwise or-op a b c) p))
  (tail (bitwise or-op a b)))

(def-fns _ $ (many extern nat-xor : (many (Nat) a) (many (Nat) b) -> (many (Nat) c) (erased (Bitwise xor-op a b c) p))
  (tail (bitwise xor-op a b)))

(def-fns _ $ (erased double-inj :
    (erased (Nat) m1) (erased (Nat) m2) (erased (Nat) d)
    (subterm erased (Double m1 d) p) (erased (Double m2 d) q) -> (erased (Eq (Nat) m1 m2) e))
  (let-match erased p (DS a1 b1 pp) ((D0) (match erased q _ ((D0) (Refl (Nat) m1)) (absurd DS))))
  (let-match erased q (DS a2 _ qq) (absurd D0))
  (let ((erased ih)) (double-inj a1 a2 b1 pp qq))
  (match erased ih _ ((Refl _ _) (Refl (Nat) m1))))

(def-fns _ $ (erased absurd double-parity :
    (erased (Nat) a) (erased (Nat) b) (erased (Nat) e)
    (subterm erased (Double a (Succ e)) p) (erased (Double b e) q) -> (erased (False) f))
  (let-match erased p (DS a1 _ pp))
  (let-match erased q (DS a2 b2 qq))
  (double-parity a1 a2 b2 pp qq))

(def-fns _ $ (erased numeral-zero :
    (erased (Nat) n) (erased (Numeral (BZ) n) v) -> (erased (Eq (Nat) n (Zero)) e))
  (match erased v _
    ((NZ) (Refl (Nat) n))
    (absurd N1)
    (absurd N2)))

(def-fns _ $ (erased numeral-fn :
    (erased (Bin) b) (erased (Nat) m1) (erased (Nat) m2)
    (subterm erased (Numeral b m1) v1) (erased (Numeral b m2) v2) -> (erased (Eq (Nat) m1 m2) e))
  (match erased v1 _
    ((NZ) (match erased v2 _ ((NZ) (Refl (Nat) m1)) (absurd N1) (absurd N2)))
    ((N1 c1 x1 d1 w1 dd1)
      (let-match erased v2 (N1 _ x2 d2 w2 dd2) (absurd NZ) (absurd N2))
      (let ((erased ih)) (numeral-fn c1 x1 x2 w1 w2))
      (let-match erased ih (Refl _ _))
      (let ((erased ed)) (double-fn x1 d1 d2 dd1 dd2))
      (match erased ed _ ((Refl _ _) (Refl (Nat) m1))))
    ((N2 c1 x1 d1 w1 dd1)
      (let-match erased v2 (N2 _ x2 d2 w2 dd2) (absurd NZ) (absurd N1))
      (let ((erased ih)) (numeral-fn c1 x1 x2 w1 w2))
      (let-match erased ih (Refl _ _))
      (let ((erased ed)) (double-fn x1 d1 d2 dd1 dd2))
      (match erased ed _ ((Refl _ _) (Refl (Nat) m1))))))

(def-fns _ $ (erased numeral-inj :
    (erased (Bin) b1) (erased (Bin) b2) (erased (Nat) n)
    (subterm erased (Numeral b1 n) v1) (erased (Numeral b2 n) v2) -> (erased (Eq (Bin) b1 b2) e))
  (match erased v1 _
    ((NZ) (match erased v2 _ ((NZ) (Refl (Bin) b1)) (absurd N1) (absurd N2)))
    ((N1 c1 m1 d1 w1 dd1)
      (let-match erased v2 (N1 c2 m2 _ w2 dd2) (absurd NZ) (absurd (N2 _ m2 d2 _ dd2) (double-parity m1 m2 d2 dd1 dd2)))
      (let ((erased em)) (double-inj m1 m2 d1 dd1 dd2))
      (let-match erased em (Refl _ _))
      (let ((erased ih)) (numeral-inj c1 c2 m1 w1 w2))
      (match erased ih _ ((Refl _ _) (Refl (Bin) b1))))
    ((N2 c1 m1 d1 w1 dd1)
      (let-match erased v2 (N2 c2 m2 _ w2 dd2) (absurd NZ) (absurd (N1 _ m2 _ _ dd2) (double-parity m2 m1 d1 dd2 dd1)))
      (let ((erased em)) (double-inj m1 m2 d1 dd1 dd2))
      (let-match erased em (Refl _ _))
      (let ((erased ih)) (numeral-inj c1 c2 m1 w1 w2))
      (match erased ih _ ((Refl _ _) (Refl (Bin) b1))))))

(def-adts
  ((BinSucc : ((Bin) b) ((Bin) c) -> Type)
    enum
    (many BSZ : -> (BinSucc (BZ) (B1 (BZ))))
    (many BS1 : (erased (Bin) b) -> (BinSucc (B1 b) (B2 b)))
    (many BS2 : (erased (Bin) b) (erased (Bin) c) (erased (BinSucc b c) s) -> (BinSucc (B2 b) (B1 c)))))

(def-fns _ $ (erased numeral-succ :
    (erased (Bin) b) (erased (Bin) c) (erased (Nat) m) (erased (Nat) n)
    (subterm erased (BinSucc b c) s)
    (erased (Numeral b m) v) (erased (Numeral c n) w) -> (erased (Eq (Nat) n (Succ m)) e))
  (match erased s _
    ((BSZ)
      (let-match erased v (NZ) (absurd N1) (absurd N2))
      (let-match erased w (N1 _ _ _ w1 dd1) (absurd NZ) (absurd N2))
      (let-match erased w1 (NZ)
        (absurd N1)
        (absurd N2))
      (match erased dd1 _ ((D0) (Refl (Nat) n)) (absurd DS)))
    ((BS1 _)
      (let-match erased v (N1 c1 x1 d1 w1 dd1) (absurd NZ) (absurd N2))
      (let-match erased w (N2 _ x2 d2 w2 dd2) (absurd NZ) (absurd N1))
      (let ((erased ex)) (numeral-fn c1 x1 x2 w1 w2))
      (let-match erased ex (Refl _ _))
      (let ((erased ed)) (double-fn x1 d1 d2 dd1 dd2))
      (match erased ed _ ((Refl _ _) (Refl (Nat) n))))
    ((BS2 b0 c0 s0)
      (let-match erased v (N2 _ x1 d1 w1 dd1) (absurd NZ) (absurd N1))
      (let-match erased w (N1 _ x2 _ w2 dd2) (absurd NZ) (absurd N2))
      (let ((erased ih)) (numeral-succ b0 c0 x1 x2 s0 w1 w2))
      (let-match erased ih (Refl _ _))
      (let-match erased dd2 (DS _ bb ddx) (absurd D0))
      (let ((erased ed)) (double-fn x1 d1 bb dd1 ddx))
      (match erased ed _ ((Refl _ _) (Refl (Nat) n))))))

(def-adts $ (Char : -> Type)
  enum newtype
  (many MkChar : (many (U8) u) -> (Char)))

(def-adts
  ((CharLt : ((Char) a) ((Char) b) -> Type)
    enum
    (many MkCharLt : (erased (Nat) m) (erased (Nat) n)
                     (erased (Lt m u8-modulus) pm) (erased (Lt n u8-modulus) pn)
                     (erased (Lt m n) p) -> (CharLt (MkChar (MkU8 m pm)) (MkChar (MkU8 n pn))))))

(def-lvl char-lvl)

(def-adts $ (String : -> Type)
  enum extern
  (many SNil : -> (String))
  (many SCons : (many (Char) c) (many (String) rest) -> (String)))

;! warn SCons copies the whole string, O(n); build a `Rope` and `flatten` it once

(def-adts
  ((Append : ((String) a) ((String) b) ((String) c) -> Type)
    enum
    (many AppNil : (erased (String) b) -> (Append (SNil) b b))
    (many AppCons : (erased (Char) ch) (erased (String) a) (erased (String) b) (erased (String) c) (erased (Append a b c) q)
       -> (Append (SCons ch a) b (SCons ch c)))))

(def-fns _ $ (many extern append : (subterm many (String) a) (many (String) b) -> (many (String) c) (erased (Append a b c) p))
  (let-match many a (SCons ch rest) ((SNil) (values b (AppNil b))))
  (let ((many c) (erased q)) (notail $ append rest b))
  (values (SCons ch c) (AppCons ch rest b c q)))

(def-lvl str-lvl)

(def-fns str-lvl $ (many extern trim : (many (String) s) -> (many s is t))
  s)

(def-fns str-lvl $ (many str-append at append : (many (String) a) (many (String) b) -> (many (String) c))
  (let ((many c) (erased _)) (delegate (append a b)))
  c)

(def-adts
  ((StrLt : ((String) a) ((String) b) -> Type)
    enum
    (many SLtNil : (erased (Char) d) (erased (String) t) -> (StrLt (SNil) (SCons d t)))
    (many SLtHead : (erased (Char) c) (erased (Char) d) (erased (String) s) (erased (String) t) (erased (CharLt c d) p) -> (StrLt (SCons c s) (SCons d t)))
    (many SLtTail : (erased (Char) c) (erased (String) s) (erased (String) t) (erased (StrLt s t) p) -> (StrLt (SCons c s) (SCons c t)))))

(def-adts
  ((StrLength : ((String) s) ((Nat) n) -> Type)
    enum
    (many SLenNil : -> (StrLength (SNil) (Zero)))
    (many SLenCons : (erased (Char) c) (erased (String) s) (erased (Nat) n) (erased (StrLength s n) p) -> (StrLength (SCons c s) (Succ n)))))

(def-fns _ $ (many extern str-length : (subterm many (String) s) -> (many (Nat) n) (erased (StrLength s n) p))
  (let-match many s (SCons c rest) ((SNil) (values (Zero) (SLenNil))))
  (let ((many n) (erased p)) (notail $ str-length rest))
  (values (Succ n) (SLenCons c rest n p)))

(def-fns _ $ (many extern str-split : (many (String) s) (subterm many (Nat) k) (erased (Nat) len) (erased (StrLength s len) l) (erased (Lt k (Succ len)) le) ->
    (many (String) a) (many (String) b) (erased (Append a b s) p) (erased (StrLength a k) la))
  (let-match many k (Succ k1) ((Zero) (values (SNil) s (AppNil s) (SLenNil))))
  (let-match many s (SCons c rest) (absurd (SNil) (let-match erased l (SLenNil)) (let-match erased le (LtS _ _ q)) q))
  (let-match erased l (SLenCons _ _ len1 l1))
  (let-match erased le (LtS _ _ q))
  (let ((many a1) (many b) (erased p) (erased la1)) (notail $ str-split rest k1 len1 l1 q))
  (values (SCons c a1) b (AppCons c a1 b rest p) (SLenCons c a1 k1 la1)))

(def-adts $ (Rope : -> Type)
  enum
  (many REmpty : -> (Rope))
  (many RStr : (many (String) s) -> (Rope))
  (many RCat : (many (Rope) a) (many (Rope) b) -> (Rope))
  (many RChar : (many (Char) c) -> (Rope)))

(def-adts
  ((Flat : ((Rope) r) ((String) s) -> Type)
    enum
    (many FlatEmpty : -> (Flat (REmpty) (SNil)))
    (many FlatStr : (erased (String) s) -> (Flat (RStr s) s))
    (many FlatCat : (erased (Rope) a) (erased (Rope) b) (erased (String) s1) (erased (String) s2) (erased (String) s)
                    (erased (Flat a s1) p) (erased (Flat b s2) q) (erased (Append s1 s2 s) ap) -> (Flat (RCat a b) s))
    (many FlatChar : (erased (Char) c) -> (Flat (RChar c) (SCons c (SNil))))))

(def-fns _ $ (many extern flatten : (subterm many (Rope) r) -> (many (String) s) (erased (Flat r s) p))
  (let-match many r (RCat a b)
    ((REmpty) (values (SNil) (FlatEmpty)))
    ((RStr s) (values s (FlatStr s)))
    ((RChar c) (values (SCons c (SNil)) (FlatChar c))))
  (let ((many s1) (erased p)) (notail $ flatten a))
  (let ((many s2) (erased q)) (notail $ flatten b))
  (let ((many s) (erased ap)) (append s1 s2))
  (values s (FlatCat a b s1 s2 s p q ap)))

(let ((many ten)) (Succ (Succ eight)))

(let ((many ten-dec)) (lt-dec (Zero) ten))

(comptime-match many ten-dec (Yes tda tdb ten-positive))

(let ((many ten-dec2)) (lt-dec (Succ (Zero)) ten))

(comptime-match many ten-dec2 (Yes tea teb ten-above-one))

(let ((many forty-eight)) (nat-add (nat-mul (Succ (Succ (Succ (Succ (Zero))))) ten) eight))

(def-fns _ $ (many digit-char : (many (Nat) d) -> (many (Char) c))
  (let ((many code)) (nat-add forty-eight d))
  (match many (lt-dec code u8-modulus) _
    ((Yes _ _ p) (MkChar $ MkU8 code p))
    ((No _ _ _) (MkChar $ MkU8 (Zero) u8-modulus-pos))))

(def-fns _ $ (many nat-digits : (subterm many (Nat) n) (many (Rope) acc) -> (many (Rope) r))
  (let-match many n (Succ n1) ((Zero) acc))
  (let ((many q) (many d) (erased m) (erased mm) (erased a) (erased _)) (divmod n ten ten-positive))
  (let ((erased lt)) (divmod-lt n1 ten q d m mm a ten-above-one))
  (tail $ nat-digits (subterm (lt-subterm q n lt)) q $ RCat (RChar $ digit-char d) acc))

(def-fns _ $ (many extern nat-str : (subterm many (Nat) n) -> (many (String) s))
  (let-match many n (Succ _) ((Zero) (SCons (digit-char (Zero)) (SNil))))
  (let ((many s) (erased _)) (flatten $ nat-digits n $ REmpty))
  s)

(def-adts $ (Unit : -> Type)
  enum
  (many MkUnit : -> (Unit)))

(def-adts $ (Bool : -> Type)
  enum
  (many BTrue : -> (Bool))
  (many BFalse : -> (Bool)))

(def-adts
  ((Maybe : (Type A) -> Type)
    enum
    (many None : (erased Type A) -> (Maybe A))
    (many Some : (erased Type A) (many A a) -> (Maybe A))))

(def-adts
  ((Result : (Type A) -> Type)
    enum
    (many Ok : (erased Type A) (many A a) -> (Result A))
    (many Fail : (erased Type A) (many (String) message) -> (Result A))))

(def-adts
  ((List : (Type A) -> Type)
    enum
    (many Nil : (erased Type A) -> (List A))
    (many Cons : (erased Type A) (many A head) (many (List A) rest) -> (List A))))

(def-adts
  ((Length : (Type A) ((List A) xs) ((Nat) n) -> Type)
    enum
    (many LengthNil : (erased Type A) -> (Length A (Nil A) (Zero)))
    (many LengthCons : (erased Type A) (erased A x) (erased (List A) rest) (erased (Nat) n) (erased (Length A rest n) p)
       -> (Length A (Cons A x rest) (Succ n))))
  ((Nth : (Type A) ((List A) xs) ((Nat) i) (A x) -> Type)
    enum
    (many NthHere : (erased Type A) (erased A x) (erased (List A) rest) -> (Nth A (Cons A x rest) (Zero) x))
    (many NthThere : (erased Type A) (erased A y) (erased (List A) rest) (erased (Nat) i) (erased A x) (erased (Nth A rest i x) p)
       -> (Nth A (Cons A y rest) (Succ i) x)))
  ((SetNth : (Type A) ((List A) xs) ((Nat) i) (A y) ((List A) ys) -> Type)
    enum
    (many SetHere : (erased Type A) (erased A x) (erased A y) (erased (List A) rest)
       -> (SetNth A (Cons A x rest) (Zero) y (Cons A y rest)))
    (many SetThere : (erased Type A) (erased A x) (erased (List A) rest) (erased (Nat) i) (erased A y) (erased (List A) rest2)
                     (erased (SetNth A rest i y rest2) p)
                     -> (SetNth A (Cons A x rest) (Succ i) y (Cons A x rest2))))
  ((Repeat : (Type A) ((Nat) n) (A x) ((List A) xs) -> Type)
    enum
    (many RepeatNil : (erased Type A) (erased A x) -> (Repeat A (Zero) x (Nil A)))
    (many RepeatCons : (erased Type A) (erased (Nat) n) (erased A x) (erased (List A) xs) (erased (Repeat A n x xs) p)
       -> (Repeat A (Succ n) x (Cons A x xs)))))

(def-adts
  ((Pair : (Type A) (Type B) -> Type)
    enum
    (many MkPair : (erased Type A) (erased Type B) (many A first) (many B second) -> (Pair A B))))

(def-adts $ (EntryKind : -> Type)
  enum
  (many IsFile : -> (EntryKind))
  (many IsDir : -> (EntryKind))
  (many IsOther : -> (EntryKind))
  (many Missing : -> (EntryKind)))

(def-adts $ (Change : -> Type)
  enum
  (many Changed : -> (Change))
  (many Unchanged : -> (Change)))

(def-lvl thunk-lvl)

(def-fns thunk-lvl $ (many thunk : (erased Type A) (erased (Level) L) (many A a) -> (many (Fn L -> (many A r)) k))
  (def-fns L $ (many held : -> (many A r)) a)
  held)

(def-fns thunk-lvl $ (many unique-thunk : (erased Type A) (erased (Level) L) (unique A a) -> (unique (UniqueFn L -> (unique A r)) k))
  (def-unique L $ (unique held : -> (unique A r)) a)
  held)

(def-adts $ (Usage : -> Type)
  enum
  (many MkUsage : (many (Nat) wall-ns) (many (Nat) user-ns) (many (Nat) sys-ns)
     (many (Nat) minor-words) (many (Nat) promoted-words) (many (Nat) major-words)
     (many (Nat) minor-gcs) (many (Nat) major-gcs) -> (Usage)))

(def-adts $ (Stopwatch : -> Type)
  enum
  (many Start : -> (Stopwatch))  ; allocates the answer, compacts the heap, then reads
  (many Stop : -> (Stopwatch)))

(def-adts $ (Request : (Type A) -> Type)
  enum
  (many WriteOut : (many (String) text) -> (Request (Unit)))
  (many WriteErr : (many (String) text) -> (Request (Unit)))
  (many ReadLine : -> (Request (Maybe (String))))  ; newline stripped; None at EOF
  (many ReadFile : (many (String) path) -> (Request (Result (String))))
  (many ReadFileIn : (many (String) dir) (many (String) path) -> (Request (Result (String))))
  (many WriteFile : (many (String) path) (many (String) text) -> (Request (Result (Unit))))
  (many GetArgs : -> (Request (List (String))))
  (many GetEnv : (many (String) name) -> (Request (Maybe (String))))
  (many GetEnvs : -> (Request (List (Pair (String) (String)))))
  (many AppendFile : (many (String) path) (many (String) text) -> (Request (Result (Unit))))
  (many ReadRemaining : -> (Request (String)))
  (many ListDir : (many (String) path) -> (Request (Result (List (String)))))  ; sorted, without . and ..
  (many GetCwd : -> (Request (String)))
  (many Stat : (many (String) path) -> (Request (Result (EntryKind))))  ; Missing if absent; Fail if unreadable
  (many MkDir : (many (String) path) -> (Request (Result (Change))))  ; one level
  (many DeleteFile : (many (String) path) -> (Request (Result (Change))))  ; Unchanged if absent
  (many DeleteDir : (many (String) path) -> (Request (Result (Change))))  ; Unchanged if absent
  (many ConfineDir : (many (String) dir) -> (Request (Result (Unit))))
  (many ConfineOutputBytes : (many (Nat) bytes) -> (Request (Result (Unit))))
  (many Measure : (many (Stopwatch) s) -> (Request (Usage))))

(def-adts $ (Array : (Type A) ((List A) xs) -> Type)
  enum extern
  (many ANil : (erased Type A) -> (Array A (Nil A)))
  (many ACons : (erased Type A) (erased (List A) xs)
                (unique A head) (unique (Array A xs) rest)
                -> (Array A (Cons A head xs))))

;! warn ACons copies the whole array, O(n); allocate with `array-new` and fill with `array-place`

;! warn Array copies the array's tail, O(n); read with `array-get` and `array-length`, or their `-many` forms at many

(def-adts $ (MaybeUninit : (Type A) -> Type)
  union newtype
  (many Uninit : (erased Type A) (many (Slot) s) -> (MaybeUninit A))
  (many Init : (erased Type A) (unique A value) -> (MaybeUninit A)))

(def-adts $ (Copy : (Type A) -> Type)
  enum newtype
  (many MkCopy : (erased Type A) (many A v) -> (Copy A)))

(def-adts
  ((AllInit : (Type A) ((List (MaybeUninit A)) xs) ((List A) ys) -> Type)
    enum
    (many AINil : (erased Type A) -> (AllInit A (Nil (MaybeUninit A)) (Nil A)))
    (many AICons : (erased Type A) (erased A x) (erased (List (MaybeUninit A)) rest) (erased (List A) rest2)
                   (erased (AllInit A rest rest2) p)
                   -> (AllInit A (Cons (MaybeUninit A) (Init A x) rest) (Cons A x rest2)))))

(def-fns _ $ (many extern array-new : (erased Type A) (subterm many (Nat) n) ->
    (erased (List (MaybeUninit A)) xs) (unique (Array (MaybeUninit A) xs) a)
    (erased (Repeat (MaybeUninit A) n (Uninit A vacant-slot) xs) p))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) (ANil _) (RepeatNil _ _))))
  (let ((erased xs1) (unique tl) (erased q)) (notail $ array-new A n1))
  (values (Cons (MaybeUninit A) (Uninit A vacant-slot) xs1) (ACons _ _ (Uninit _ vacant-slot) tl) (RepeatCons _ _ _ _ q)))

(def-fns _ $ (many extern array-swap : (erased Type A) (erased (List A) xs)
    (unique (Array A xs) a) (subterm many (Nat) i) (unique A x)
    (erased A m) (erased (Nth A xs i m) nth) ->
    (unique m is old) (erased (List A) ys) (unique (Array A ys) r at a)
    (erased (SetNth A xs i x ys) p))
  (let-match unique a (ACons _ xs1 hd tl u) (absurd (ANil _ _) nth))
  (match many i _
    ((Zero)
      (let-match erased nth (NthHere _ _ _) (absurd NthThere))
      (values hd (Cons A x xs1) (u _ _ x (at) tl) (SetHere _ _ _ _)))
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (let ((unique old) (erased ys1) (unique tl3) (erased p1)) (tail (array-swap _ _ tl i1 x _ q)))
      (values old (Cons A hd ys1) (at (u _ _ hd tl3)) (SetThere _ _ _ _ _ _ p1)))))

(def-fns _ $ (many extern array-pluck : (erased Type A) (erased (List (MaybeUninit A)) xs)
    (unique (Array (MaybeUninit A) xs) a) (subterm many (Nat) i)
    (erased (MaybeUninit A) m) (erased (Nth (MaybeUninit A) xs i m) nth) ->
    (unique m is v) (erased (List (MaybeUninit A)) ys) (unique (Array (MaybeUninit A) ys) r at a)
    (erased (SetNth (MaybeUninit A) xs i (Uninit A (slot-of v)) ys) p))
  (let-match unique a (ACons _ xs1 hd tl u) (absurd (ANil _ _) nth))
  (match many i _
    ((Zero)
      (let-match erased nth (NthHere _ _ _) (absurd NthThere))
      (values hd (Cons (MaybeUninit A) (Uninit A (slot-of hd)) xs1) (at (u _ _ (Uninit _ (slot-of hd)) tl))
              (SetHere _ _ _ _)))
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (let ((unique v) (erased ys1) (unique tl3) (erased p1)) (tail (array-pluck _ _ tl i1 _ q)))
      (values v (Cons (MaybeUninit A) hd ys1) (at (u _ _ hd tl3)) (SetThere _ _ _ _ _ _ p1)))))

(def-fns _ $ (many extern array-place : (erased Type A) (erased (List A) xs)
    (unique (Array A xs) a) (many (Nat) i) (unique A x)
    (erased A m) (erased (Nth A xs i m) nth) ->
    (erased (List A) ys) (unique (Array A ys) r at a) (erased (SetNth A xs i x ys) p))
  (let ((unique _) (erased ys) (unique r) (erased p)) (array-swap _ _ a i x _ nth))
  (values ys r p))

(def-fns _ $ (many extern array-get : (erased Type A) (erased (List (Copy A)) xs)
    (unique (Array (Copy A) xs) a) (subterm many (Nat) i)
    (erased A x) (erased (Nth (Copy A) xs i (MkCopy A x)) nth) ->
    (many x is v) (unique a is r at a))
  (let-match unique a (ACons _ _ hd tl u) (absurd (ANil _ _) nth))
  (match many i _
    ((Zero)
      (let-match erased nth (NthHere _ _ _) (absurd NthThere))
      (let-match unique hd (MkCopy _ v))
      (values v (at (u _ _ (MkCopy _ v) tl))))
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (let ((many v) (unique tl3)) (tail (array-get _ _ tl i1 _ q)))
      (values v (at (u _ _ hd tl3))))))

(def-fns _ $ (many extern array-get-many : (erased Type A) (erased (List A) xs)
    (many (Array A xs) a) (subterm many (Nat) i)
    (erased A x) (erased (Nth A xs i x) nth) -> (many x is v))
  (let-match many a (ACons _ _ hd tl) (absurd (ANil _) nth))
  (match many i _
    ((Zero)
      (let-match erased nth (NthHere _ _ _) (absurd NthThere))
      hd)
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (tail (array-get-many _ _ tl i1 _ q)))))

(def-fns _ $ (many extern array-length : (erased Type A) (erased (List A) xs)
    (subterm unique (Array A xs) a) -> (many (Nat) len) (erased (Length A xs len) p) (unique a is r at a))
  (let-match unique a (ACons _ _ hd tl u) ((ANil _ u) (values (Zero) (LengthNil _) (at (u _)))))
  (let ((many l1) (erased p1) (unique tl2)) (notail $ array-length _ _ tl))
  (values (Succ l1) (LengthCons _ _ _ _ p1) (at (u _ _ hd tl2))))

(def-fns _ $ (many extern array-length-many : (erased Type A) (erased (List A) xs)
    (subterm many (Array A xs) a) -> (many (Nat) len) (erased (Length A xs len) p))
  (let-match many a (ACons _ _ _ tl) ((ANil _) (values (Zero) (LengthNil _))))
  (let ((many l1) (erased p1)) (notail $ array-length-many _ _ tl))
  (values (Succ l1) (LengthCons _ _ _ _ p1)))

(def-fns _ $ (many extern list-to-array : (erased Type A) (subterm many (List (Copy A)) xs) ->
    (unique (Array (Copy A) xs) a))
  (let-match many xs (Cons _ hd tl) ((Nil _) (ANil _)))
  (let-match many hd (MkCopy _ v))
  (let ((unique a1)) (notail $ list-to-array _ tl))
  (ACons _ _ (MkCopy _ v) a1))

(def-fns _ $ (many extern array-make : (erased Type A) (subterm many (Nat) n) (many A x) ->
    (erased (List (Copy A)) xs) (unique (Array (Copy A) xs) a) (erased (Repeat (Copy A) n (MkCopy A x) xs) p))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) (ANil _) (RepeatNil _ _))))
  (let ((erased xs1) (unique a1) (erased p1)) (notail $ array-make A n1 x))
  (values (Cons (Copy A) (MkCopy A x) xs1) (ACons _ _ (MkCopy _ x) a1) (RepeatCons _ _ _ _ p1)))

(def-fns _ $ (erased init-witness : (erased Type A) (erased (List (MaybeUninit A)) xs) (erased (List A) ys)
    (erased (Array (MaybeUninit A) xs) a) (subterm erased (AllInit A xs ys) all) ->
    (erased (Array A ys) b)
    (erased (Coercible (Unique) (Array (MaybeUninit A) xs) a (Unique) (Array A ys) b) c))
  (let-match erased all (AICons _ x tl ys1 q)
    ((AINil _)
      (let-match erased a (ANil _))
      (values (ANil _) (coercible-ctor _ ANil (MaybeUninit A) A))))
  (let-match erased a (ACons _ _ _ rest))
  (let ((erased b1) (erased c1)) (init-witness _ _ _ rest q))
  (values (ACons _ _ x b1)
          (coercible-ctor _ ACons (MaybeUninit A) A tl ys1
             (coercible-sym (coercible-wrap _ Init _ x))
             c1)))

(def-adts $ (Bytes : ((List (U8)) xs) -> Type)
  enum extern
  (many BNil : -> (Bytes (Nil (U8))))
  (many BCons : (erased (List (U8)) xs) (many (U8) head) (unique (Bytes xs) rest) -> (Bytes (Cons (U8) head xs))))

;! warn BCons copies the whole buffer, O(n); allocate with `bytes-make` and fill with `bytes-set`

;! warn Bytes copies the buffer's tail, O(n); read with `bytes-get` and `bytes-length`, or their `-many` forms at many

(def-adts
  ((StrBytes : ((String) s) ((List (U8)) xs) -> Type)
    enum
    (many SBNil : -> (StrBytes (SNil) (Nil (U8))))
    (many SBCons : (erased (U8) u) (erased (String) s) (erased (List (U8)) xs) (erased (StrBytes s xs) p)
       -> (StrBytes (SCons (MkChar u) s) (Cons (U8) u xs)))))

(def-fns _ $ (many extern bytes-make : (subterm many (Nat) n) (many (U8) x) ->
    (erased (List (U8)) xs) (unique (Bytes xs) b) (erased (Repeat (U8) n x xs) p))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) (BNil) (RepeatNil _ _))))
  (let ((erased xs1) (unique b1) (erased p1)) (notail $ bytes-make n1 x))
  (values (Cons (U8) x xs1) (BCons _ x b1) (RepeatCons _ _ _ _ p1)))

(def-fns _ $ (many extern bytes-get : (erased (List (U8)) xs) (unique (Bytes xs) b) (subterm many (Nat) i)
    (erased (U8) x) (erased (Nth (U8) xs i x) nth) -> (many x is v) (unique b is r at b))
  (let-match unique b (BCons _ hd tl u) (absurd (BNil) nth))
  (match many i _
    ((Zero)
      (let-match erased nth (NthHere _ _ _) (absurd NthThere))
      (values hd (at (u _ hd tl))))
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (let ((many v) (unique tl3)) (tail (bytes-get _ tl i1 _ q)))
      (values v (at (u _ hd tl3))))))

(def-fns _ $ (many extern bytes-get-many : (erased (List (U8)) xs) (many (Bytes xs) b) (subterm many (Nat) i)
    (erased (U8) x) (erased (Nth (U8) xs i x) nth) -> (many x is v))
  (let-match many b (BCons _ hd tl) (absurd BNil nth))
  (match many i _
    ((Zero) (let-match erased nth (NthHere _ _ _) (absurd NthThere)) hd)
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (tail (bytes-get-many _ tl i1 _ q)))))

(def-fns _ $ (many extern bytes-set : (erased (List (U8)) xs) (unique (Bytes xs) b) (subterm many (Nat) i) (many (U8) x)
    (erased (U8) m) (erased (Nth (U8) xs i m) nth) ->
    (erased (List (U8)) ys) (unique (Bytes ys) r at b) (erased (SetNth (U8) xs i x ys) p))
  (let-match unique b (BCons xs1 hd tl u) (absurd (BNil) nth))
  (match many i _
    ((Zero)
      (let-match erased nth (NthHere _ _ _) (absurd NthThere))
      (values (Cons (U8) x xs1) (u _ x (at) tl) (SetHere _ _ _ _)))
    ((Succ i1)
      (let-match erased nth (NthThere _ _ _ _ _ q) (absurd NthHere))
      (let ((erased ys1) (unique tl3) (erased p1)) (tail (bytes-set _ tl i1 x _ q)))
      (values (Cons (U8) hd ys1) (at (u _ hd tl3)) (SetThere _ _ _ _ _ _ p1)))))

(def-fns _ $ (many extern bytes-length : (erased (List (U8)) xs) (subterm unique (Bytes xs) b) ->
    (many (Nat) len) (erased (Length (U8) xs len) p) (unique b is r at b))
  (let-match unique b (BCons _ hd tl u) ((BNil u) (values (Zero) (LengthNil _) (at (u)))))
  (let ((many l1) (erased p1) (unique tl2)) (notail $ bytes-length _ tl))
  (values (Succ l1) (LengthCons _ _ _ _ p1) (at (u _ hd tl2))))

(def-fns _ $ (many extern bytes-length-many : (erased (List (U8)) xs) (subterm many (Bytes xs) b) ->
    (many (Nat) len) (erased (Length (U8) xs len) p))
  (let-match many b (BCons _ _ tl) ((BNil) (values (Zero) (LengthNil _))))
  (let ((many l1) (erased p1)) (notail $ bytes-length-many _ tl))
  (values (Succ l1) (LengthCons _ _ _ _ p1)))

(def-fns _ $ (many extern str-bytes-copy : (subterm many (String) s) ->
    (erased (List (U8)) xs) (unique (Bytes xs) b) (erased (StrBytes s xs) p))
  (let-match many s (SCons c rest) ((SNil) (values (Nil _) (BNil) (SBNil))))
  (let-match many c (MkChar u))
  (let ((erased xs1) (unique b1) (erased p1)) (notail $ str-bytes-copy rest))
  (values (Cons (U8) u xs1) (BCons _ u b1) (SBCons u rest xs1 p1)))

(def-fns _ $ (many extern bytes-str : (erased (List (U8)) xs) (subterm many (Bytes xs) b) ->
    (many (String) s) (erased (StrBytes s xs) p))
  (let-match many b (BCons xs1 hd tl) ((BNil) (values (SNil) (SBNil))))
  (let ((many s1) (erased p1)) (notail $ bytes-str _ tl))
  (values (SCons (MkChar hd) s1) (SBCons hd s1 xs1 p1)))

(def-fns _ $ (many extern bytes-copy : (erased (List (U8)) xs) (subterm many (Bytes xs) b) -> (unique b is c))
  (let-match many b (BCons _ hd tl) ((BNil) (BNil)))
  (BCons _ hd (notail $ bytes-copy _ tl)))

(def-fns _ $ (many extern array-copy : (erased Type A) (erased (List (Copy A)) xs) (subterm many (Array (Copy A) xs) a) ->
    (unique a is c))
  (let-match many a (ACons _ _ hd tl) ((ANil _) (ANil _)))
  (let-match many hd (MkCopy _ v))
  (ACons _ _ (MkCopy _ v) (notail $ array-copy _ _ tl)))

(def-adts
  ((Splice : (Type A) ((List A) xs) ((Nat) i) ((Nat) n) ((List A) ys) ((List A) zs) -> Type)
    enum
    (many SpliceNil : (erased Type A) (erased (List A) xs) -> (Splice A xs (Zero) (Zero) (Nil A) xs))
    (many SpliceHere : (erased Type A) (erased A x) (erased A y) (erased (List A) xs) (erased (Nat) n) (erased (List A) ys) (erased (List A) zs)
       (erased (Splice A xs (Zero) n ys zs) p) -> (Splice A (Cons A x xs) (Zero) (Succ n) (Cons A y ys) (Cons A y zs)))
    (many SpliceThere : (erased Type A) (erased A x) (erased (List A) xs) (erased (Nat) i) (erased (Nat) n) (erased (List A) ys) (erased (List A) zs)
       (erased (Splice A xs i n ys zs) p) -> (Splice A (Cons A x xs) (Succ i) n ys (Cons A x zs)))))

(def-fns _ $ (erased splice-range : (erased Type A) (erased (List A) xs) (erased (Nat) len) (subterm erased (Length A xs len) l)
    (erased (Nat) i) (erased (Nat) n) (erased (Nat) e) (erased (Add i n e) a) (erased (Lt e (Succ len)) le) ->
    (erased (List A) ys) (erased (Splice A xs i n ys xs) p))
  (match erased a _
    ((AddZero _)
      (let-match erased n (Succ n1) ((Zero) (values (Nil A) (SpliceNil _ _))))
      (let-match erased l (LengthCons _ x _ _ l1) (absurd (LengthNil _) (let-match erased le (LtS _ _ z)) z))
      (let-match erased le (LtS _ _ le1))
      (let ((erased ys1) (erased p1)) (splice-range _ _ _ l1 (Zero) n1 n1 (AddZero n1) le1))
      (values (Cons A x ys1) (SpliceHere _ _ _ _ _ _ _ p1)))
    ((AddSucc i1 _ e1 a1)
      (let-match erased l (LengthCons _ _ _ _ l1) (absurd (LengthNil _) (let-match erased le (LtS _ _ z)) z))
      (let-match erased le (LtS _ _ le1))
      (let ((erased ys1) (erased p1)) (splice-range _ _ _ l1 i1 n e1 a1 le1))
      (values ys1 (SpliceThere _ _ _ _ _ _ _ p1)))))

(def-fns _ $ (many extern bytes-sub : (erased (List (U8)) xs) (subterm many (Bytes xs) b) (many (Nat) i) (many (Nat) n)
    (erased (List (U8)) ys) (erased (Splice (U8) xs i n ys xs) range) -> (unique (Bytes ys) c))
  (match many i _
    ((Succ i1)
      (let-match erased range (SpliceThere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceHere))
      (let-match many b (BCons _ _ tl) (absurd BNil))
      (tail $ bytes-sub _ tl i1 n _ q))
    ((Zero)
      (let-match many n (Succ n1)
        ((Zero) (let-match erased range (SpliceNil _ _) (absurd SpliceHere) (absurd SpliceThere)) (BNil)))
      (let-match erased range (SpliceHere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceThere))
      (let-match many b (BCons _ hd tl) (absurd BNil))
      (BCons _ hd (notail $ bytes-sub _ tl (Zero) n1 _ q)))))

(def-fns _ $ (many extern array-sub : (erased Type A) (erased (List (Copy A)) xs) (subterm many (Array (Copy A) xs) a) (many (Nat) i) (many (Nat) n)
    (erased (List (Copy A)) ys) (erased (Splice (Copy A) xs i n ys xs) range) -> (unique (Array (Copy A) ys) c))
  (match many i _
    ((Succ i1)
      (let-match erased range (SpliceThere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceHere))
      (let-match many a (ACons _ _ _ tl) (absurd ANil))
      (tail $ array-sub _ _ tl i1 n _ q))
    ((Zero)
      (let-match many n (Succ n1)
        ((Zero) (let-match erased range (SpliceNil _ _) (absurd SpliceHere) (absurd SpliceThere)) (ANil _)))
      (let-match erased range (SpliceHere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceThere))
      (let-match many a (ACons _ _ hd tl) (absurd ANil))
      (let-match many hd (MkCopy _ v))
      (ACons _ _ (MkCopy _ v) (notail $ array-sub _ _ tl (Zero) n1 _ q)))))

(def-fns _ $ (many extern bytes-blit : (erased (List (U8)) xs) (subterm many (Bytes xs) src) (many (Nat) i)
    (erased (List (U8)) ds) (subterm unique (Bytes ds) dst) (many (Nat) j) (many (Nat) n)
    (erased (List (U8)) ys) (erased (Splice (U8) xs i n ys xs) from)
    (erased (List (U8)) old) (erased (Splice (U8) ds j n old ds) to) ->
    (erased (List (U8)) zs) (unique (Bytes zs) r at dst) (erased (Splice (U8) ds j n ys zs) p))
  (let-match many i (Zero)
    ((Succ i1)
      (let-match erased from (SpliceThere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceHere))
      (let-match many src (BCons _ _ stl) (absurd BNil))
      (tail $ bytes-blit _ stl i1 _ dst j n _ q _ to)))
  (let-match many j (Zero)
    ((Succ j1)
      (let-match unique dst (BCons _ dh dtl u) (absurd (BNil) to))
      (let-match erased to (SpliceThere _ _ _ _ _ _ _ q2) (absurd SpliceNil) (absurd SpliceHere))
      (let ((erased zs1) (unique tl3) (erased p1)) (tail $ bytes-blit _ src (Zero) _ dtl j1 n _ from _ q2))
      (values (Cons (U8) dh zs1) (at (u _ dh tl3)) (SpliceThere _ _ _ _ _ _ _ p1))))
  (let-match many n (Succ n1)
    ((Zero)
      (let-match erased from (SpliceNil _ _) (absurd SpliceHere) (absurd SpliceThere))
      (values ds dst (SpliceNil _ _))))
  (let-match erased from (SpliceHere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceThere))
  (let-match unique dst (BCons _ _ dtl u) (absurd (BNil) to))
  (let-match erased to (SpliceHere _ _ _ _ _ _ _ q2) (absurd SpliceNil) (absurd SpliceThere))
  (let-match many src (BCons _ h stl) (absurd BNil))
  (let ((erased zs1) (unique tl3) (erased p1)) (notail $ bytes-blit _ stl (Zero) _ dtl (Zero) n1 _ q _ q2))
  (values (Cons (U8) h zs1) (u _ h (at) tl3) (SpliceHere _ _ _ _ _ _ _ p1)))

(def-fns _ $ (many extern array-blit : (erased Type A) (erased (List (Copy A)) xs) (subterm many (Array (Copy A) xs) src) (many (Nat) i)
    (erased (List (Copy A)) ds) (subterm unique (Array (Copy A) ds) dst) (many (Nat) j) (many (Nat) n)
    (erased (List (Copy A)) ys) (erased (Splice (Copy A) xs i n ys xs) from)
    (erased (List (Copy A)) old) (erased (Splice (Copy A) ds j n old ds) to) ->
    (erased (List (Copy A)) zs) (unique (Array (Copy A) zs) r at dst) (erased (Splice (Copy A) ds j n ys zs) p))
  (let-match many i (Zero)
    ((Succ i1)
      (let-match erased from (SpliceThere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceHere))
      (let-match many src (ACons _ _ _ stl) (absurd ANil))
      (tail $ array-blit _ _ stl i1 _ dst j n _ q _ to)))
  (let-match many j (Zero)
    ((Succ j1)
      (let-match unique dst (ACons _ _ dh dtl u) (absurd (ANil _) to))
      (let-match erased to (SpliceThere _ _ _ _ _ _ _ q2) (absurd SpliceNil) (absurd SpliceHere))
      (let ((erased zs1) (unique tl3) (erased p1)) (tail $ array-blit _ _ src (Zero) _ dtl j1 n _ from _ q2))
      (values (Cons (Copy A) dh zs1) (at (u _ _ dh tl3)) (SpliceThere _ _ _ _ _ _ _ p1))))
  (let-match many n (Succ n1)
    ((Zero)
      (let-match erased from (SpliceNil _ _) (absurd SpliceHere) (absurd SpliceThere))
      (values ds dst (SpliceNil _ _))))
  (let-match erased from (SpliceHere _ _ _ _ _ _ _ q) (absurd SpliceNil) (absurd SpliceThere))
  (let-match unique dst (ACons _ _ _ dtl u) (absurd (ANil _) to))
  (let-match erased to (SpliceHere _ _ _ _ _ _ _ q2) (absurd SpliceNil) (absurd SpliceThere))
  (let-match many src (ACons _ _ h stl) (absurd ANil))
  (let-match many h (MkCopy _ v))
  (let ((erased zs1) (unique tl3) (erased p1)) (notail $ array-blit _ _ stl (Zero) _ dtl (Zero) n1 _ q _ q2))
  (values (Cons (Copy A) (MkCopy A v) zs1) (u _ _ (MkCopy _ v) (at) tl3) (SpliceHere _ _ _ _ _ _ _ p1)))

(def-adts $ (Pos : -> Type)
  enum
  (many NoPos : -> (Pos))
  (many MkPos : (many (String) file) (many (Nat) line) (many (Nat) col) -> (Pos)))

(def-adts $ (JMEq : (Type A) (A a) (Type B) (B b) -> Type)
  enum
  (many JMRefl : (erased Type A) (erased A a) -> (JMEq A a A a)))

(def-opaque $ (Gensym : ((Nat) n) ((String) s) -> Type))

(def-opaque $ (MacroWorld : -> Type))

(def-prim $ (erased gensym-unique : (erased (Nat) n) (erased (String) s) (erased (String) t)
    (erased (Gensym n s) a) (erased (Gensym n t) b) ->
    (erased (JMEq (Gensym n s) a (Gensym n t) b) e)))

(def-adts $ (Mult : -> Type)
  enum
  (many MErased : -> (Mult))
  (many MMany : -> (Mult))
  (many MUnique : -> (Mult)))

(def-opaque $ (Settled : ((Mult) m) (Type T) (T t) -> Type))

(def-opaque $ (Placed : ((Slot) s) (Type T) (T v) -> Type))

(def-prim $ (erased placed-eq : (erased (Slot) s) (erased Type T) (erased T v)
    (erased (Placed s T v) p) (erased (Placed s T v) q) ->
    (erased (Eq (Placed s T v) p q) e)))

(def-adts $ (Symbol : -> Type)
  enum
  (many SName : (many (String) s) -> (Symbol))
  (many SGen : (many (Nat) n) (many (String) s) (erased (Gensym n s) g) -> (Symbol)))

(def-adts $ (Resolution : -> Type)
  enum
  (many RSettled : (erased (Mult) m) (erased Type T) (erased T t) (many (Settled m T t) h) -> (Resolution))
  (many RHypothetical : -> (Resolution))
  (many RUnbound : -> (Resolution)))

(def-adts $ (Raw : -> Type)
  enum extern
  (many RawSymbol : (many (Pos) pos) (many (Symbol) s) -> (Raw))
  (many RawWild : (many (Pos) pos) -> (Raw))
  (many RawList : (many (Pos) pos) (many (List $ Raw) items) -> (Raw))
  (many RawSettled : (many (Pos) pos) (erased (Mult) m) (erased Type A) (erased A a) (many (Settled m A a) c) -> (Raw)))

(def-adts $ (Macro : -> Type)
  enum newtype
  (many MkMacro : (erased (Level) L)
     (many (Fn L (unique (MacroWorld) mw) (many (Pos) here) (many (List $ Raw) args) ->
               (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out)) f)
     -> (Macro)))
