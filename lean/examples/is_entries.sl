(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (Add (((Nat) a) ((Nat) b) ((Nat) c))
  (AddZ (((Nat) b)) (Add (Zero) b b))
  (AddS (((Nat) a) ((Nat) b) ((Nat) c) ((Add a b c) p)) (Add (Succ a) b (Succ c)))))
(def-adts (Two (((Nat) a))
  (MkTwo (((Nat) a) ((Succ (Succ a)) is s)) (Two a))))
(def-lvl L)
(def-fns L (reify (((Nat) a) ((Nat) b) ((Nat) c) ((Add a b c) p)) ((c is d)) c))
(def-fns L (pred2 (((Nat) a) ((Two a) t)) (((Nat) r))
  (match t (((Nat) r))
    ((MkTwo x s)
      (match s (((Nat) r))
        ((Succ k) k))))))
(let (d) (reify (Succ (Zero)) (Zero) (Succ (Zero)) (AddS (Zero) (Zero) (Zero) (AddZ (Zero)))))
(let (((Succ (Zero)) is e)) d)
(values e (pred2 (Zero) (MkTwo (Zero) (Succ (Succ (Zero))))))
