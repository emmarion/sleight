; tests/paradox_knot_bad.sl in the full syntax
(def-adts
  ((Absurd : -> Type)
    enum))
(def-adts
  ((Bad : -> Type)
    enum
    (many MkBad : (erased (Level) l) (many (Fn l (many (Bad) b) -> (many (Absurd) f)) g) -> (Bad))))
(def-lvl F)
(def-fns F $ (many factory : (many (Bad) b) -> (erased (Level) W) (many (Fn W -> (many (Absurd) f)) o))
  (def-lvl W)
  (let ((erased pb)) (prove-predates b W))
  (match many b (((Level) V) ((Fn V -> (many (Absurd) f)) o))
    ((MkBad l g)
      (let ((erased ps)) (prove-subterm l b))
      (let ((erased pl)) (predates-subterm pb ps))
      (def-fns W $ (many o : -> (many (Absurd) f))
        (g (predates pl) b))
      (values W o))))
(def-lvl K)
(def-fns K $ (many knot : (many (Bad) b) -> (many (Absurd) f))
  (let ((erased pfk)) (prove-predates F K))
  (let ((erased W) (many o)) (factory (predates pfk) b))
  (let ((erased p)) (prove-predates W K))
  (o (predates p)))
(knot (MkBad K knot))
