; tests/paradox_knot_bad.sl in the minimal syntax
(def-adts (Absurd ()))
(def-adts (Bad () (MkBad (((Level) l) ((Fn l (((Bad) b)) (((Absurd) f))) g)) (Bad))))
(def-lvl F)
(def-fns F (factory (((Bad) b)) (((Level) W) ((Fn W () (((Absurd) f))) o))
  (def-lvl W)
  (let (pb) (prove-predates b W))
  (match b (((Level) V) ((Fn V () (((Absurd) f))) o))
    ((MkBad l g)
      (let (ps) (prove-subterm l b))
      (let (pl) (predates-subterm pb ps))
      (def-fns W (o () (((Absurd) f)) (g (predates pl) b)))
      (values W o)))))
(def-lvl K)
(def-fns K (knot (((Bad) b)) (((Absurd) f))
  (let (pfk) (prove-predates F K))
  (let (W o) (factory (predates pfk) b))
  (let (p) (prove-predates W K))
  (o (predates p))))
(knot (MkBad K knot))
