; DESIGN.md section 48: calls in a body with no decrease annotation
(def-fns _ $ (many length : (erased Type A) (subterm many (List A) xs) -> (many (Nat) n))
  (match many xs (((Nat) r))
    ((Nil a) (Zero))
    ((Cons a hd tl) (Succ (length A (subterm _) tl)))))
(def-lvl F)
(def-fns F $ (many map-factory : (erased (Level) M) -> (erased (Level) L) (many (Fn L (erased Type A) (erased Type B) (many (Fn M (many A x) -> (many B y)) f) (subterm many (List A) xs) -> (many (List B) ys)) mapped))
  (def-fns _ $ (many map : (erased Type A) (erased Type B) (many (Fn M (many A x) -> (many B y)) f) (subterm many (List A) xs) -> (many (List B) ys))
    (match many xs (((List B) r))
      ((Nil a) (Nil B))
      ((Cons a hd tl) (Cons B (f (predates _) hd) (map A B f tl)))))
  (values (level-of map) map))
(def-fns _ $ (many inc : (many (Nat) n) -> (many (Nat) m))
  (Succ n))
(let ((erased ML) (many map-nat)) (map-factory (level-of inc)))
(let ((many xs)) (Cons (Nat) (Zero) (Cons (Nat) (Succ (Zero)) (Nil (Nat)))))
(Cons (Nat) (length (Nat) xs) (map-nat (Nat) (Nat) inc xs))
