; DESIGN.md section 48: calls in a body with no decrease annotation
(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (List ((Type A)) (Nil ((Type A)) (List A)) (Cons ((Type A) (A head) ((List A) rest)) (List A))))
(def-fns _ (length ((Type A) (subterm (List A) xs)) (((Nat) n))
  (match xs (((Nat) r))
    ((Nil a) (Zero))
    ((Cons a hd tl) (Succ (length A (subterm _) tl))))))
(def-lvl F)
(def-fns F (map-factory (((Level) M))
    (((Level) L)
     ((Fn L ((Type A) (Type B) ((Fn M ((A x)) ((B y))) f) (subterm (List A) xs)) (((List B) ys))) mapped))
  (def-fns _ (map ((Type A) (Type B) ((Fn M ((A x)) ((B y))) f) (subterm (List A) xs)) (((List B) ys))
    (match xs (((List B) r))
      ((Nil a) (Nil B))
      ((Cons a hd tl) (Cons B (f (predates _) hd) (map A B f tl))))))
  (values (level-of map) map)))
(def-fns _ (inc (((Nat) n)) (((Nat) m)) (Succ n)))
(let (ML map-nat) (map-factory (level-of inc)))
(let (xs) (Cons (Nat) (Zero) (Cons (Nat) (Succ (Zero)) (Nil (Nat)))))
(values (length (Nat) xs) (map-nat (Nat) (Nat) inc xs))
