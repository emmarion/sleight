; (level-of f) for a parameter reads the level of its Fn type (DESIGN.md section 53)
(def-fns _ $ (many inc : (many (Nat) n) -> (many (Nat) m))
  (Succ n))
(def-lvl M)
(def-fns M $ (many twice : (erased (Level) L) (erased (Predates (Level) L M) p)
    (many (Fn L (many (Nat) x) -> (many (Nat) y)) f) (many (Nat) n) -> (many (Nat) m))
  (let ((erased (Predates (Level) (level-of f) M) q)) p)
  (f (predates q) (f (predates q) n)))
(let ((erased p)) (prove-predates (level-of inc) M))
(twice (level-of inc) p inc 1)
