; DESIGN.md sections 21 and 25: absurd functions and branches
(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (False ()))
(def-adts (Le (((Nat) a) ((Nat) b))
  (LeZ (((Nat) b)) (Le (Zero) b))
  (LeS (((Nat) a) ((Nat) b) ((Le a b) p)) (Le (Succ a) (Succ b)))))
(def-fns _ (absurd explode ((Type A) ((False) f)) ((A a)) f))
(def-fns _ (pred (((Nat) n) ((Le (Succ (Zero)) n) p)) (((Nat) r))
  (match p (((Nat) r))
    (absurd LeZ)
    ((LeS a b q) b))))
(def-fns _ (zero-or (((Nat) n) ((False) f)) (((Nat) r))
  (match n (((Nat) r))
    ((Zero) (Zero))
    (absurd (Succ k) f))))
(pred (Succ (Succ (Zero))) (LeS (Zero) (Succ (Zero)) (LeZ (Succ (Zero)))))
