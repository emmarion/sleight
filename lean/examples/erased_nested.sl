; a call nested in an argument for an erased parameter or field is itself erased
(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (Add (((Nat) a) ((Nat) b) ((Nat) c))
  (AddZ (((Nat) b)) (Add (Zero) b b))
  (AddS (((Nat) a) ((Nat) b) ((Nat) c) (erased (Add a b c) p)) (Add (Succ a) b (Succ c)))))
(def-lvl L)
(def-fns L (erased addZR ((subterm many (Nat) n)) ((erased (Add n (Zero) n) p))
  (match erased n (((Add n (Zero) n) p))
    ((Zero) (AddZ (Zero)))
    ((Succ k) (let (q) (prove-subterm k n)) (AddS k (Zero) k (addZR (subterm q) k))))))
(def-lvl M)
(def-fns M (keep ((many (Nat) n) (erased (Add n (Zero) n) p)) ((many (Nat) r)) n))
(def-adts (Pair () (MkPair (((Nat) n) (erased (Add n (Zero) n) p)) (Pair))))
(let ((many two)) (Succ (Succ (Zero))))
(values (keep two (addZR two)) (MkPair two (addZR two)))
