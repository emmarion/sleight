(def-lvl L)
(def-fns L $ (many twice : (many (Nat) n) -> (many (Nat) r))
  (Succ (Succ n)))
(let ((many (Nat) a) (many (Succ (Zero)) is b))
  (let ((many z)) (Zero))
  (def-lvl M)
  (values (twice z) (Succ z)))
(let ((many (Nat) c)) (twice b))
(Cons (Nat) a (Cons (Nat) b (Cons (Nat) c (Nil (Nat)))))
