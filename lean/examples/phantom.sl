; phantom constructors (DESIGN.md section 21): built only in erased positions, and erased throughout their branches
(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (Opt () (None () (Opt)) (erased Hidden (((Nat) n)) (Opt))))
(def-lvl L)
(def-fns L (get ((many (Opt) o) (erased (Nat) e)) (((Nat) r))
  (match o (((Nat) r))
    ((None) (Succ (Zero)))
    ((Hidden n) e))))
(def-fns L (erased peek ((erased (Opt) o)) (((Nat) r))
  (match erased o (((Nat) r))
    ((None) (Zero))
    ((Hidden n) n))))
(let ((erased h)) (Hidden (Succ (Zero))))
(let ((erased k)) (peek h))
(get (None) k)
