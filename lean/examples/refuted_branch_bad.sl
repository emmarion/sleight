(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (Vec ((Type A) ((Nat) n))
  (VNil ((Type A)) (Vec A (Zero)))
  (VCons ((Type A) ((Nat) n) (A x) ((Vec A n) xs)) (Vec A (Succ n)))))
(def-lvl L)
(def-fns L (head ((Type A) ((Nat) n) ((Vec A (Succ n)) v)) ((A x))
  (match v ((A x))
    ((VNil a) (head A n v))
    ((VCons a m x xs) x))))
(Zero)
