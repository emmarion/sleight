(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-lvl L)
(def-fns L (succ2 (((Nat) n) ((Succ n) is m)) (((Succ m) is r)) (Succ m)))
(def-lvl M)
(let (q) (prove-predates L M))
(def-fns M (apply (((Fn L (((Nat) n) ((Succ n) is m)) (((Succ m) is r))) f) ((Nat) x))
    (((Nat) y) ((Succ (Succ x)) is z))
  (let (y) (f (predates q) x (Succ x)))
  (let (a ((Succ a) is b))
    (match x (((Nat) a) ((Succ a) is b))
      ((Zero) (values y (Succ y)))
      ((Succ k) (values y (Succ y)))))
  (let (((Succ a) is c)) b)
  (values y y)))
(let (u v) (apply succ2 (Zero)))
(values u v)
