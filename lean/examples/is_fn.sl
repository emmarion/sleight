(def-lvl L)
(def-fns L $ (many succ2 : (many (Nat) n) (many (Succ n) is m) -> (many (Succ m) is r))
  (Succ m))
(def-lvl M)
(let ((erased q)) (prove-predates L M))
(def-fns M $ (many apply : (many (Fn L (many (Nat) n) (many (Succ n) is m) -> (many (Succ m) is r)) f) (many (Nat) x) -> (many (Nat) y) (many (Succ (Succ x)) is z))
  (let ((many y)) (f (predates q) x (Succ x)))
  (let ((many a) (many (Succ a) is b))
    (match many x (((Nat) a) ((Succ a) is b))
      ((Zero) (values y (Succ y)))
      ((Succ k) (values y (Succ y)))))
  (let ((many (Succ a) is c)) b)
  (values y y))
(let ((many u) (many v)) (apply succ2 (Zero)))
(Cons (Nat) u (Cons (Nat) v (Nil (Nat))))
