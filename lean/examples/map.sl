; DESIGN.md section 57 in the minimal syntax
(def-adts (Nat () (Zero () (Nat)) (Succ (((Nat) pred)) (Nat))))
(def-adts (List ((Type A)) (Nil ((Type A)) (List A)) (Cons ((Type A) (A head) ((List A) rest)) (List A))))
(def-lvl F)
(def-fns F (map-factory (((Level) M))
    (((Level) L)
     ((Fn L ((Type A) (Type B) ((Fn M ((A x)) ((B y))) f) (subterm (List A) xs)) (((List B) ys))) mapped))
  (def-lvl L)
  (let (pml) (prove-predates M L))
  (def-fns L (map ((Type A) (Type B) ((Fn M ((A x)) ((B y))) f) (subterm (List A) xs)) (((List B) ys))
    (match xs (((List B) r))
      ((Nil a) (Nil B))
      ((Cons a hd tl)
        (let (p) (prove-subterm tl xs))
        (Cons B (f (predates pml) hd) (map A B f (subterm p) tl))))))
  (values L map)))
(def-lvl I)
(def-fns I (inc (((Nat) n)) (((Nat) m)) (Succ n)))
(let (ML map-nat) (map-factory I))
(let (xs) (Cons (Nat) (Zero) (Cons (Nat) (Succ (Zero)) (Nil (Nat)))))
(map-nat (Nat) (Nat) inc xs)
