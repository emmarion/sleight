(def-lvl L)
(def-fns L $ (many length : (erased Type A) (subterm many (List A) xs) -> (many (Nat) n))
  (match many xs (((Nat) n))
    ((Nil a) (Zero))
    ((Cons a hd tl)
      (let ((erased p)) (prove-subterm tl xs))
      (Succ (length a (subterm p) tl)))))
(length (Nat) (Cons (Nat) (Zero) (Cons (Nat) (Zero) (Cons (Nat) (Zero) (Nil (Nat))))))
