(def-lvl E0)
(def-lvl N0)
(let ((erased en)) (prove-predates E0 N0))
(def-adts $ (MB : ((Nat) i) -> Type)
  enum
  (many MkMB : (erased (Nat) i) (erased (Level) l) (erased (Predates (Level) l E0) pl)
     (many (Fn l (erased (Ex MB) x) -> (erased (False) f)) g) -> (MB i)))
(def-lvl O0)
(let ((erased no)) (prove-predates N0 O0))
(def-lvl D0)
(def-fns D0 $ (erased dec : (erased (Nat) n) -> (erased (Or (MB n) (Fn E0 (erased (MB n) q) -> (erased (False) f))) r))
  (def-fns E0 $ (erased omega : (erased (MB n) q) -> (erased (False) f))
    (let-match erased q (MkMB _ l pl g))
    (g (predates pl) (MkEx MB n q)))
  (Inr _ _ omega))
(def-fns O0 $ (erased nn : (erased (Fn N0 (erased (Ex MB) x) -> (erased (False) f)) ne) -> (erased (False) f))
  (let ((erased pne)) (prove-predates N0 E0))
  (ne (MkEx MB (Zero) (MkMB (Zero) N0 pne ne))))
(def-lvl K)
