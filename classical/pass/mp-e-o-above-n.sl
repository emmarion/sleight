(def-lvl N)
(def-adts $ (MB : ((Nat) i) -> Type)
  enum
  (many MkMB : (erased (Nat) i) (many (Fn N (erased (Ex MB) x) -> (erased (False) f)) g) -> (MB i)))
(def-lvl E)
(def-lvl O)
(def-lvl D)
(def-fns D $ (erased dec : (erased (Nat) n) -> (erased (Or (MB n) (Fn E (erased (MB n) q) -> (erased (False) f))) r))
  (def-fns E $ (erased omega : (erased (MB n) q) -> (erased (False) f))
    (let-match erased q (MkMB _ g))
    (g (MkEx MB n q)))
  (Inr _ _ omega))
(def-fns O $ (erased nn : (erased (Fn N (erased (Ex MB) x) -> (erased (False) f)) ne) -> (erased (False) f))
  (ne (MkEx MB (Zero) (MkMB (Zero) ne))))
(def-lvl K)
(let ((erased dk)) (prove-predates D K))
(let ((erased ok)) (prove-predates O K))
(def-fns _ $ (many no-mp :
    (erased (Fn K (erased (Level) N) (erased (Level) O) (erased (Level) D) (erased (Level) E)
        (erased (Predates (Level) N O) no) (erased (Predates (Level) D K) dk) (erased (Predates (Level) O K) ok)
        (erased (TyCtor ((Nat) n) -> Type) Q)
        (erased (Fn D (erased (Nat) n) -> (erased (Or (Q n) (Fn E (erased (Q n) q) -> (erased (False) f))) r)) dec)
        (erased (Fn O (erased (Fn N (erased (Ex Q) x) -> (erased (False) f)) h) -> (erased (False) f)) nn) ->
        (erased (Ex Q) r)) mp) ->
    (erased (Level) Z) (many (Fn Z -> (many (False) f)) absurdity))
  (let ((erased no)) (prove-predates N O))
  (def-fns _ $ (many absurd absurd absurdity : -> (many (False) f))
    (let-match erased (mp N O D E no dk ok MB dec nn) (MkEx _ n q))
    (let-match erased q (MkMB _ g))
    (g (MkEx MB n q)))
  (values (level-of absurdity) absurdity))
