(def-lvl E0)
(def-lvl N0)
(let ((erased en)) (prove-predates E0 N0))
(def-adts $ (MB : ((Nat) i) -> Type)
  enum
  (many MkMB : (erased (Nat) i) (many (Fn N0 (erased (Ex MB) x) -> (erased (False) f)) g) -> (MB i)))
(def-lvl O0)
(let ((erased no)) (prove-predates N0 O0))
(def-fns O0 $ (erased nn : (erased (Fn N0 (erased (Ex MB) x) -> (erased (False) f)) ne) -> (erased (False) f))
  (ne (MkEx MB (Zero) (MkMB (Zero) ne))))
(def-lvl K)
(let ((erased ok)) (prove-predates O0 K))
(def-fns _ $ (many no-mp :
    (erased (Fn K (erased (Level) N) (erased (Level) O) (erased (Level) D) (erased (Level) E)
        (erased (Predates (Level) E N) en) (erased (Predates (Level) N O) no) (erased (Predates (Level) O K) ok)
        (erased (TyCtor ((Nat) n) -> Type) Q)
        (erased (Fn D (erased (Nat) n) -> (erased (Or (Q n) (Fn E (erased (Q n) q) -> (erased (False) f))) r)) dec)
        (erased (Fn O (erased (Fn N (erased (Ex Q) x) -> (erased (False) f)) h) -> (erased (False) f)) nn) ->
        (erased (Ex Q) r)) mp) ->
    (erased (Level) Z) (many (Fn Z -> (many (False) f)) absurdity))
  (def-fns _ $ (erased absurd dec : (erased (Nat) n) -> (erased (Or (MB n) (Fn E0 (erased (MB n) q) -> (erased (False) f))) r))
    (let-match erased (mp N0 O0 (level-of dec) E0 en no ok MB dec nn) (MkEx _ m q))
    (let-match erased q (MkMB _ g))
    (g (MkEx MB m q)))
  (def-fns _ $ (many absurd absurd absurdity : -> (many (False) f))
    (let-match erased (mp N0 O0 (level-of dec) E0 en no ok MB dec nn) (MkEx _ n q))
    (let-match erased q (MkMB _ g))
    (g (MkEx MB n q)))
  (values (level-of absurdity) absurdity))
