(def-adts $ (Empty : ((Nat) i) -> Type)
  enum)
(def-lvl E0)
(def-lvl N0)
(let ((erased en)) (prove-predates E0 N0))
(def-lvl D0)
(def-fns D0 $ (erased dec : (erased (Nat) n) -> (erased (Or (Empty n) (Fn E0 (erased (Empty n) q) -> (erased (False) f))) r))
  (def-fns E0 $ (erased absurd omega : (erased (Empty n) q) -> (erased (False) f))
    q)
  (Inr _ _ omega))
(def-lvl K)
(let ((erased dk)) (prove-predates D0 K))
(def-fns _ $ (many no-mp :
    (erased (Fn K (erased (Level) N) (erased (Level) O) (erased (Level) D) (erased (Level) E)
        (erased (Predates (Level) E N) en) (erased (Predates (Level) N O) no) (erased (Predates (Level) D K) dk)
        (erased (TyCtor ((Nat) n) -> Type) Q)
        (erased (Fn D (erased (Nat) n) -> (erased (Or (Q n) (Fn E (erased (Q n) q) -> (erased (False) f))) r)) dec)
        (erased (Fn O (erased (Fn N (erased (Ex Q) x) -> (erased (False) f)) h) -> (erased (False) f)) nn) ->
        (erased (Ex Q) r)) mp) ->
    (erased (Level) Z) (many (Fn Z -> (many (False) f)) absurdity))
  (def-lvl O0)
  (let ((erased no)) (prove-predates N0 O0))
  (def-fns O0 $ (erased absurd nn : (erased (Fn N0 (erased (Ex Empty) x) -> (erased (False) f)) ne) -> (erased (False) f))
    (let-match erased (mp N0 O0 D0 E0 en no dk Empty dec nn) (MkEx _ n q))
    q)
  (def-fns _ $ (many absurd absurd absurdity : -> (many (False) f))
    (let-match erased (mp N0 O0 D0 E0 en no dk Empty dec nn) (MkEx _ n q))
    q)
  (values (level-of absurdity) absurdity))
