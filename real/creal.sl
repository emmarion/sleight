      (let ((erased wm) (erased hwm)) (qmult qtwo um))
      (let ((erased v) (erased hv)) (qminus c a))
      (let-match erased (qlt-le-dec wm v) (IsGe _ _ _ _ _ l) ((IsLt _ _ _ _ _ l) (SplitBelow sx sy sz (MkCRealLt sx sz m a c v um wm ha hc hv hum hwm l))))
      (let ((erased f) (erased hf)) (qminus b c))
      (let ((erased e)) (qeq-le wm u (qpower2-succ m n um u wm hum hm hu hwm)))
      (let ((erased p1) (erased hp1)) (qplus w v))
      (let ((erased p2) (erased hp2)) (qplus t wm))
      (let ((erased p3) (erased hp3)) (qplus wm wm))
      (let ((erased p4) (erased hp4)) (qplus u u))
      (let ((erased bu) (erased hbu)) (qplus p1 p3))
      (let ((erased bv) (erased hbv)) (qplus p2 p4))
      (let ((erased bs) (erased hbs)) (qplus wm bv))
      (let ((erased bt) (erased hbt)) (qplus f bu))
      (SplitAbove sx sy sz (MkCRealLt sz sy m c b f um wm hc hb hf hum hwm (qr-lt _ _ (qr-lin (OLt) bu bv wm f bs bt
        (qr-plus-mono (OLt) (OLe) (OLt) p1 p2 p3 p4 bu bv (OMeetLt _)
          (qr-plus-mono (OLt) (OLe) (OLt) w t v wm p1 p2 (OMeetLt _) (QRLt _ _ lt) (QRLe _ _ l) hp1 hp2)
          (qr-plus-mono (OLe) (OLe) (OLe) wm u wm u p3 p4 (OMeetLe _) (QRLe _ _ e) (QRLe _ _ e) hp3 hp4) hbu hbv)
        hbs hbt
        (qring-eq (Cons _ wm $ Cons _ b $ Cons _ a $ Cons _ u $ Cons _ c $ Nil (Q)) _ _ bs bt qr-split
          (qev-add (qev-var 0) (qev-add (qev-add (qev-minus _ _ _ _ _ _ (qev-var 1) (qev-var 2) ht) (qev-var 0) hp2) (qev-add (qev-var 3) (qev-var 3) hp4) hbv) hbs)
          (qev-add (qev-minus _ _ _ _ _ _ (qev-var 1) (qev-var 4) hf)
            (qev-add (qev-add (qev-mul (qev-two) (qev-var 3) hw) (qev-minus _ _ _ _ _ _ (qev-var 4) (qev-var 2) hv) hp1) (qev-add (qev-var 0) (qev-var 0) hp3) hbu) hbt)))))))
    ((erased creal-eq-trans : (erased (Spec) sx sy sz) (erased (CReal M sx) x) (erased (CReal M sy) y) (erased (CReal M sz) z)
        (erased (Level) Lx Ly) (erased (CRealEq Lx sx sy) h1) (erased (CRealEq Ly sy sz) h2) -> (erased (Level) K) (erased (CRealEq K sx sz) r))
      (let-match erased h1 (MkCRealEq _ _ _ yx xy))
      (let-match erased h2 (MkCRealEq _ _ _ zy yz))
      (let-match erased yx (MkCRealLe _ _ _ f-yx))
      (let-match erased xy (MkCRealLe _ _ _ f-xy))
      (let-match erased zy (MkCRealLe _ _ _ f-zy))
      (let-match erased yz (MkCRealLe _ _ _ f-yz))
      (def-fns _
        ((erased gzx : (erased (CRealLt sx sz) h) -> (erased (False) f))
          (match erased (creal-lt-dec sx sz sy x z y h) _ ((SplitBelow _ _ _ l) (f-yx l)) ((SplitAbove _ _ _ l) (f-zy l))))
        ((erased gxz : (erased (CRealLt sz sx) h) -> (erased (False) f))
          (match erased (creal-lt-dec sz sx sy z x y h) _ ((SplitBelow _ _ _ l) (f-yz l)) ((SplitAbove _ _ _ l) (f-xy l)))))
      (values (level-of gzx) (MkCRealEq (level-of gzx) sx sz (MkCRealLe (level-of gzx) sz sx gzx) (MkCRealLe (level-of gzx) sx sz gxz)))))
  (values (level-of creal-cauchy-at) creal-cauchy-at creal-bound-at creal-seq-term creal-seq-fn creal-lt-above-at creal-lt-irrefl creal-eq-refl (level-of creal-lt-dec) creal-lt-dec creal-eq-trans))

(def-adts $ (Near : ((Spec) s) ((Z) j) ((Q) a) -> Type)
  enum
  (many MkNear : (erased (Spec) s) (erased (Z) j) (erased (Q) a t d e c w)
      (erased (SeqAt s j t) ht) (erased (QMinus a t d) hd) (erased (QAbs d e) he)
      (erased (QPower qtwo j c) hc) (erased (QMult qtwo c w) hw) (erased (QLe e w) le)
      -> (Near s j a)))
