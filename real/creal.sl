(let ((erased qtwo)) (Qmake (Zpos (Succ (Zero))) (Zero)))

(def-adts $ (QEval : ((List (Q)) env) ((ZExpr) e) ((Q) q) -> Type)
  enum
  (many QEvVar : (erased (List (Q)) env) (erased (Nat) i) (erased (Q) q) (erased (Nth (Q) env i q) p) -> (QEval env (ZEVar i) q))
  (many QEvNum : (erased (List (Q)) env) (erased (Nat) k) (erased (Z) z) (erased (ZView z k (Zero)) v) -> (QEval env (ZENum k) (Qmake z (Zero))))
  (many QEvAdd : (erased (List (Q)) env) (erased (ZExpr) a b) (erased (Q) x y z)
     (erased (QEval env a x) ea) (erased (QEval env b y) eb) (erased (QPlus x y z) h) -> (QEval env (ZEAdd a b) z))
  (many QEvMul : (erased (List (Q)) env) (erased (ZExpr) a b) (erased (Q) x y z)
     (erased (QEval env a x) ea) (erased (QEval env b y) eb) (erased (QMult x y z) h) -> (QEval env (ZEMul a b) z))
  (many QEvOpp : (erased (List (Q)) env) (erased (ZExpr) a) (erased (Q) x z) (erased (QEval env a x) ea) (erased (QOpp x z) h)
     -> (QEval env (ZEOpp a) z)))

(def-adts $ (Times3 : ((Nat) i) ((Nat) j) -> Type)
  enum
  (many Times3Zero : -> (Times3 (Zero) (Zero)))
  (many Times3Succ : (erased (Nat) i j) (erased (Times3 i j) t) -> (Times3 (Succ i) (Succ (Succ (Succ j))))))

(def-fns _ $ (many times3 : (subterm many (Nat) i) -> (many (Nat) j) (erased (Times3 i j) t))
  (let-match many i (Succ i1) ((Zero) (values (Zero) (Times3Zero))))
  (let ((many j1) (erased t1)) (notail $ times3 i1))
  (values (Succ (Succ (Succ j1))) (Times3Succ i1 j1 t1)))

(def-adts $ (QTr : ((ZExpr) e) ((Expr) p) ((Expr) n) ((Expr) d) -> Type)
  enum
  (many QTrVar : (erased (Nat) i j) (erased (Times3 i j) t) -> (QTr (ZEVar i) (EVar j) (EVar (Succ j)) (EVar (Succ (Succ j)))))
  (many QTrNum : (erased (Nat) k) -> (QTr (ZENum k) (ENum k) (ENum (Zero)) (ENum (Succ (Zero)))))
  (many QTrAdd : (erased (ZExpr) a b) (erased (Expr) pa na da pb nb db) (erased (QTr a pa na da) ta) (erased (QTr b pb nb db) tb)
     -> (QTr (ZEAdd a b) (EAdd (EAdd (EMul pa db) (EMul na (ENum (Zero)))) (EAdd (EMul pb da) (EMul nb (ENum (Zero)))))
          (EAdd (EAdd (EMul pa (ENum (Zero))) (EMul na db)) (EAdd (EMul pb (ENum (Zero))) (EMul nb da))) (EMul da db)))
  (many QTrMul : (erased (ZExpr) a b) (erased (Expr) pa na da pb nb db) (erased (QTr a pa na da) ta) (erased (QTr b pb nb db) tb)
     -> (QTr (ZEMul a b) (EAdd (EMul pa pb) (EMul na nb)) (EAdd (EMul pa nb) (EMul na pb)) (EMul da db)))
  (many QTrOpp : (erased (ZExpr) a) (erased (Expr) pa na da) (erased (QTr a pa na da) ta) -> (QTr (ZEOpp a) na pa da)))

(def-fns _ $ (many qtr : (subterm many (ZExpr) e) -> (many (Expr) p n d) (erased (QTr e p n d) t))
  (match many e _
    ((ZEVar i) (let ((many j) (erased h)) (times3 i)) (values (EVar j) (EVar (Succ j)) (EVar (Succ (Succ j))) (QTrVar i j h)))
    ((ZENum k) (values (ENum k) (ENum (Zero)) (ENum (Succ (Zero))) (QTrNum k)))
    ((ZEAdd a b)
      (let ((many pa) (many na) (many da) (erased ta)) (notail $ qtr a))
      (let ((many pb) (many nb) (many db) (erased tb)) (notail $ qtr b))
      (values (EAdd (EAdd (EMul pa db) (EMul na (ENum (Zero)))) (EAdd (EMul pb da) (EMul nb (ENum (Zero)))))
        (EAdd (EAdd (EMul pa (ENum (Zero))) (EMul na db)) (EAdd (EMul pb (ENum (Zero))) (EMul nb da))) (EMul da db) (QTrAdd a b pa na da pb nb db ta tb)))
    ((ZEMul a b)
      (let ((many pa) (many na) (many da) (erased ta)) (notail $ qtr a))
      (let ((many pb) (many nb) (many db) (erased tb)) (notail $ qtr b))
      (values (EAdd (EMul pa pb) (EMul na nb)) (EAdd (EMul pa nb) (EMul na pb)) (EMul da db) (QTrMul a b pa na da pb nb db ta tb)))
    ((ZEOpp a)
      (let ((many pa) (many na) (many da) (erased ta)) (notail $ qtr a))
      (values na pa da (QTrOpp a pa na da ta)))))

(def-adts $ (QZEnv : ((List (Q)) qs) ((List (Nat)) ns) -> Type)
  enum
  (many QZNil : -> (QZEnv (Nil (Q)) (Nil (Nat))))
  (many QZCons : (erased (Z) z) (erased (Nat) p n d) (erased (List (Q)) qs) (erased (List (Nat)) ns) (erased (ZView z p n) v) (erased (QZEnv qs ns) r)
     -> (QZEnv (Cons (Q) (Qmake z d) qs) (Cons (Nat) p $ Cons (Nat) n $ Cons (Nat) (Succ d) ns))))

(def-fns _ $ (erased qzenv : (subterm erased (List (Q)) qs) -> (erased (List (Nat)) ns) (erased (QZEnv qs ns) r))
  (let-match erased qs (Cons _ q qs1) ((Nil _) (values (Nil (Nat)) (QZNil))))
  (let-match erased q (Qmake z d))
  (let ((erased p) (erased n) (erased v)) (zview z))
  (let ((erased ns) (erased r)) (qzenv qs1))
  (values (Cons (Nat) p $ Cons (Nat) n $ Cons (Nat) (Succ d) ns) (QZCons z p n d qs1 ns v r)))

(def-fns _ $ (erased qzenv-nth : (erased (List (Q)) qs) (erased (List (Nat)) ns) (erased (Nat) i j) (erased (Q) q)
    (erased (QZEnv qs ns) r) (subterm erased (Nth (Q) qs i q) h) (erased (Times3 i j) t) ->
    (erased (Z) z) (erased (Nat) d p n) (erased (Eq (Q) q (Qmake z d)) e) (erased (ZView z p n) v)
    (erased (Nth (Nat) ns j p) np) (erased (Nth (Nat) ns (Succ j) n) nn) (erased (Nth (Nat) ns (Succ (Succ j)) (Succ d)) nd))
  (match erased h _
    ((NthHere _ _ _)
      (let-match erased r (QZCons z p n d _ _ v _))
      (let-match erased t (Times3Zero))
      (values z d p n (Refl _ q) v (NthHere _ p _) (NthThere _ p _ _ n (NthHere _ n _))
        (NthThere _ p _ _ (Succ d) $ NthThere _ n _ _ (Succ d) (NthHere _ (Succ d) _))))
    ((NthThere _ _ _ i1 _ h1)
      (let-match erased r (QZCons z0 p0 n0 d0 qs1 ns1 _ r1))
      (let-match erased t (Times3Succ _ j1 t1))
      (let ((erased z) (erased d) (erased p) (erased n) (erased e) (erased v) (erased np) (erased nn) (erased nd)) (qzenv-nth qs1 ns1 i1 j1 q r1 h1 t1))
      (values z d p n e v
        (NthThere _ p0 _ _ p $ NthThere _ n0 _ _ p $ NthThere _ (Succ d0) _ _ p np)
        (NthThere _ p0 _ _ n $ NthThere _ n0 _ _ n $ NthThere _ (Succ d0) _ _ n nn)
        (NthThere _ p0 _ _ (Succ d) $ NthThere _ n0 _ _ (Succ d) $ NthThere _ (Succ d0) _ _ (Succ d) nd)))))

(def-fns _ $ (erased rep-mul : (erased (List (Nat)) ns) (erased (Expr) p1 n1 p2 n2) (erased (Z) a b c) (erased (Nat) x1 y1 x2 y2)
    (erased (Eval ns p1 x1) e1) (erased (Eval ns n1 y1) f1) (erased (Eval ns p2 x2) e2) (erased (Eval ns n2 y2) f2)
    (erased (ZOf a x1 y1) o1) (erased (ZOf b x2 y2) o2) (erased (ZMul a b c) h) ->
    (erased (Nat) x y) (erased (Eval ns (EAdd (EMul p1 p2) (EMul n1 n2)) x) ex) (erased (Eval ns (EAdd (EMul p1 n2) (EMul n1 p2)) y) ey)
    (erased (ZOf c x y) o))
  (let ((erased m1) (erased k1)) (mul x1 x2))
  (let ((erased m2) (erased k2)) (mul y1 y2))
  (let ((erased m3) (erased k3)) (mul x1 y2))
  (let ((erased m4) (erased k4)) (mul y1 x2))
  (let ((erased x) (erased hx)) (add m1 m2))
  (let ((erased y) (erased hy)) (add m3 m4))
  (values x y (EvAdd ns _ _ m1 m2 x (EvMul ns _ _ _ _ m1 e1 e2 k1) (EvMul ns _ _ _ _ m2 f1 f2 k2) hx)
    (EvAdd ns _ _ m3 m4 y (EvMul ns _ _ _ _ m3 e1 f2 k3) (EvMul ns _ _ _ _ m4 f1 e2 k4) hy)
    (zmul-rep a b c x1 y1 x2 y2 m1 m2 m3 m4 x y h o1 o2 k1 k2 k3 k4 hx hy)))

(def-fns _ $ (erased den-mul : (erased (Nat) a b c) (erased (ZMul (Zpos a) (Zpos b) (Zpos c)) h) -> (erased (Mul (Succ a) (Succ b) (Succ c)) m))
  (let ((erased s) (erased hs)) (mul (Succ a) (Succ b)))
  (let ((erased e) (erased _)) (zview-fn (Zpos c) s (Zero) (Succ c) (Zero) (znat-mul _ _ _ _ _ s (ZViewPos a) (ZViewPos b) h hs) (ZViewPos c)))
  (let-match erased e (Refl _ _))
  hs)

(def-fns _ $ (erased qeval-sound : (erased (List (Q)) qs) (erased (List (Nat)) ns) (erased (ZExpr) e) (erased (Expr) ep en ed) (erased (Q) q)
    (erased (QZEnv qs ns) r) (subterm erased (QEval qs e q) ev) (erased (QTr e ep en ed) t) ->
    (erased (Z) z) (erased (Nat) d p n) (erased (Eq (Q) q (Qmake z d)) eq)
    (erased (Eval ns ep p) vp) (erased (Eval ns en n) vn) (erased (Eval ns ed (Succ d)) vd) (erased (ZOf z p n) o))
  (match erased ev _
    ((QEvVar _ i _ h)
      (let-match erased t (QTrVar _ j tj))
      (let ((erased z) (erased d) (erased p) (erased n) (erased eq) (erased v) (erased np) (erased nn) (erased nd)) (qzenv-nth qs ns i j q r h tj))
      (values z d p n eq (EvVar ns j p np) (EvVar ns (Succ j) n nn) (EvVar ns (Succ (Succ j)) (Succ d) nd) (zview-of z p n v)))
    ((QEvNum _ k z v)
      (let-match erased t (QTrNum _))
      (values z (Zero) k (Zero) (Refl _ q) (EvNum ns k) (EvNum ns (Zero)) (EvNum ns (Succ (Zero))) (zview-of z k (Zero) v)))
    ((QEvAdd _ a b x y _ ea eb h)
      (let-match erased t (QTrAdd _ _ pa na da pb nb db ta tb))
      (let ((erased zx) (erased dx) (erased px) (erased nx) (erased ex) (erased vpx) (erased vnx) (erased vdx) (erased ox)) (qeval-sound qs ns a pa na da x r ea ta))
      (let ((erased zy) (erased dy) (erased py) (erased ny) (erased ey) (erased vpy) (erased vny) (erased vdy) (erased oy)) (qeval-sound qs ns b pb nb db y r eb tb))
      (let-match erased ex (Refl _ _))
      (let-match erased ey (Refl _ _))
      (let-match erased h (MkQPlus _ _ l m z _ _ d hl hm hz hd))
      (let ((erased x1) (erased y1) (erased vx1) (erased vy1) (erased o1))
        (rep-mul ns pa na db (ENum (Zero)) zx (Zpos dy) l px nx (Succ dy) (Zero) vpx vnx vdy (EvNum ns (Zero)) ox (zview-of _ _ _ (ZViewPos dy)) hl))
      (let ((erased x2) (erased y2) (erased vx2) (erased vy2) (erased o2))
        (rep-mul ns pb nb da (ENum (Zero)) zy (Zpos dx) m py ny (Succ dx) (Zero) vpy vny vdx (EvNum ns (Zero)) oy (zview-of _ _ _ (ZViewPos dx)) hm))
      (let ((erased p) (erased hp)) (add x1 x2))
      (let ((erased n) (erased hn)) (add y1 y2))
      (values z d p n (Refl _ q) (EvAdd ns _ _ x1 x2 p vx1 vx2 hp) (EvAdd ns _ _ y1 y2 n vy1 vy2 hn)
        (EvMul ns _ _ _ _ _ vdx vdy (den-mul dx dy d hd)) (zadd-rep l m z x1 y1 x2 y2 p n hz o1 o2 hp hn)))
    ((QEvMul _ a b x y _ ea eb h)
      (let-match erased t (QTrMul _ _ pa na da pb nb db ta tb))
      (let ((erased zx) (erased dx) (erased px) (erased nx) (erased ex) (erased vpx) (erased vnx) (erased vdx) (erased ox)) (qeval-sound qs ns a pa na da x r ea ta))
      (let ((erased zy) (erased dy) (erased py) (erased ny) (erased ey) (erased vpy) (erased vny) (erased vdy) (erased oy)) (qeval-sound qs ns b pb nb db y r eb tb))
      (let-match erased ex (Refl _ _))
      (let-match erased ey (Refl _ _))
      (let-match erased h (MkQMult _ _ z _ _ d hz hd))
      (let ((erased p) (erased n) (erased vp) (erased vn) (erased o)) (rep-mul ns pa na pb nb zx zy z px nx py ny vpx vnx vpy vny ox oy hz))
      (values z d p n (Refl _ q) vp vn (EvMul ns _ _ _ _ _ vdx vdy (den-mul dx dy d hd)) o))
    ((QEvOpp _ a x _ ea h)
      (let-match erased t (QTrOpp _ pa na da ta))
      (let ((erased zx) (erased dx) (erased px) (erased nx) (erased ex) (erased vpx) (erased vnx) (erased vdx) (erased ox)) (qeval-sound qs ns a pa na da x r ea ta))
      (let-match erased ex (Refl _ _))
      (let-match erased h (MkQOpp _ z _ hz))
      (values z dx nx px (Refl _ q) vnx vpx vdx (zopp-rep zx z px nx hz ox)))))

(def-adts $ (QRingEq : ((ZExpr) e1) ((ZExpr) e2) -> Type)
  enum
  (many MkQRingEq : (erased (ZExpr) e1 e2) (erased (Expr) p1 n1 d1 p2 n2 d2) (erased (QTr e1 p1 n1 d1) t1) (erased (QTr e2 p2 n2 d2) t2)
     (erased (RingEq (EAdd (EAdd (EMul p1 d2) (EMul n1 (ENum (Zero)))) (EAdd (EMul p2 (ENum (Zero))) (EMul n2 d1)))
                     (EAdd (EAdd (EMul p2 d1) (EMul n2 (ENum (Zero)))) (EAdd (EMul p1 (ENum (Zero))) (EMul n1 d2)))) r)
     -> (QRingEq e1 e2)))

(def-fns _ $ (many qring-check : (many (ZExpr) e1 e2) -> (many (Maybe (QRingEq e1 e2)) r))
  (let ((many p1) (many n1) (many d1) (erased t1)) (qtr e1))
  (let ((many p2) (many n2) (many d2) (erased t2)) (qtr e2))
  (match many (ring-check (EAdd (EAdd (EMul p1 d2) (EMul n1 (ENum (Zero)))) (EAdd (EMul p2 (ENum (Zero))) (EMul n2 d1)))
                          (EAdd (EAdd (EMul p2 d1) (EMul n2 (ENum (Zero)))) (EAdd (EMul p1 (ENum (Zero))) (EMul n1 d2)))) _
    ((Some _ r) (Some _ (MkQRingEq e1 e2 p1 n1 d1 p2 n2 d2 t1 t2 r)))
    ((None _) (None _))))

(def-fns _ $ (erased qring-eq : (erased (List (Q)) env) (erased (ZExpr) e1 e2) (erased (Q) x y) (erased (QRingEq e1 e2) h)
    (erased (QEval env e1 x) v1) (erased (QEval env e2 y) v2) -> (erased (QEq x y) e))
  (let-match erased h (MkQRingEq _ _ p1 n1 d1 p2 n2 d2 t1 t2 r))
  (let ((erased ns) (erased ze)) (qzenv env))
  (let ((erased zx) (erased dx) (erased px) (erased nx) (erased ex) (erased vpx) (erased vnx) (erased vdx) (erased ox)) (qeval-sound env ns e1 p1 n1 d1 x ze v1 t1))
  (let ((erased zy) (erased dy) (erased py) (erased ny) (erased ey) (erased vpy) (erased vny) (erased vdy) (erased oy)) (qeval-sound env ns e2 p2 n2 d2 y ze v2 t2))
  (let-match erased ex (Refl _ _))
  (let-match erased ey (Refl _ _))
  (let ((erased l1) (erased hl1)) (zmul zx (Zpos dy)))
  (let ((erased l2) (erased hl2)) (zmul zy (Zpos dx)))
  (let ((erased x1) (erased y1) (erased vx1) (erased vy1) (erased o1))
    (rep-mul ns p1 n1 d2 (ENum (Zero)) zx (Zpos dy) l1 px nx (Succ dy) (Zero) vpx vnx vdy (EvNum ns (Zero)) ox (zview-of _ _ _ (ZViewPos dy)) hl1))
  (let ((erased x2) (erased y2) (erased vx2) (erased vy2) (erased o2))
    (rep-mul ns p2 n2 d1 (ENum (Zero)) zy (Zpos dx) l2 py ny (Succ dx) (Zero) vpy vny vdx (EvNum ns (Zero)) oy (zview-of _ _ _ (ZViewPos dx)) hl2))
  (let ((erased s1) (erased hs1)) (add x1 y2))
  (let ((erased s2) (erased hs2)) (add x2 y1))
  (let-match erased (ring-sound ns _ _ s1 s2 r (EvAdd ns _ _ x1 y2 s1 vx1 vy2 hs1) (EvAdd ns _ _ x2 y1 s2 vx2 vy1 hs2)) (Refl _ _))
  (let-match erased (zof-eq l1 l2 x1 y1 x2 y2 o1 o2 (MkDiffEq x1 y1 x2 y2 s1 hs1 hs2)) (Refl _ _))
  (MkQEq zx zy l1 dx dy hl1 hl2))

(def-macro (qev-var args here mw)
  (let ((unique mw1) (many i) (many n)) (zindex-arg mw here args))
  (values mw1 (qq (QEvVar _ _ _ (~ n)))))

(def-macro (qev-add args)
  (qq (QEvAdd _ _ _ _ _ _ (~@ args))))

(def-macro (qev-mul args)
  (qq (QEvMul _ _ _ _ _ _ (~@ args))))

(def-fns _ $ (erased qev-minus : (erased (List (Q)) env) (erased (ZExpr) a b) (erased (Q) x y z) (erased (QEval env a x) ea) (erased (QEval env b y) eb)
    (erased (QMinus x y z) h) -> (erased (QEval env (ZEAdd a (ZEOpp b)) z) r))
  (let-match erased h (MkQMinus _ _ o _ ho hp))
  (QEvAdd env a (ZEOpp b) x o z ea (QEvOpp env b y o eb ho) hp))

(def-fns _ $ (erased omeet-le : (erased (ORel) k) -> (erased (OMeet k (OLe) k) m))
  (match erased k _ ((OLt) (OMeetLt (OLe))) ((OLe) (OMeetLe (OLe)))))

(def-fns _ $ (erased qr-eq : (erased (ORel) k) (erased (Q) x y x2 y2) (erased (QEq x x2) ex) (erased (QEq y y2) ey) (erased (QR k x y) h)
    -> (erased (QR k x2 y2) r))
  (qr-trans k (OLe) k x2 y y2 (omeet-le k)
    (qr-trans (OLe) k k x2 x y (OMeetLe k) (QRLe _ _ (qeq-le x2 x (qeq-sym x x2 ex))) h)
    (QRLe _ _ (qeq-le y y2 ey))))

(comptime-match many (qring-check (ZEAdd (ZEAdd (zvar 0) (zvar 1)) (ZEOpp (zvar 1))) (zvar 0)) (Some _ qr-add-sub))

(def-fns _ $ (erased qr-lin : (erased (ORel) k) (erased (Q) u v a b s t) (erased (QR k u v) h) (erased (QPlus a v s) hs) (erased (QPlus b u t) ht)
    (erased (QEq s t) e) -> (erased (QR k a b) r))
  (let ((erased p) (erased hp)) (qplus a u))
  (let ((erased o) (erased ho)) (qopp u))
  (let ((erased p2) (erased hp2)) (qplus p o))
  (let ((erased t2) (erased ht2)) (qplus t o))
  (let ((erased r1)) (qr-plus-mono (OLe) k k a a u v p s (OMeetLe k) (QRLe _ _ (qle-refl a)) h hp hs))
  (let ((erased r2)) (qr-plus-mono k (OLe) k p t o o p2 t2 (omeet-le k) (qr-eq k p s p t (qeq-refl p) e r1) (QRLe _ _ (qle-refl o)) hp2 ht2))
  (qr-eq k p2 t2 a b
    (qring-eq (Cons _ a $ Cons _ u $ Nil (Q)) _ _ p2 a qr-add-sub (qev-add (qev-add (qev-var 0) (qev-var 1) hp) (QEvOpp _ _ _ _ (qev-var 1) ho) hp2) (qev-var 0))
    (qring-eq (Cons _ b $ Cons _ u $ Nil (Q)) _ _ t2 b qr-add-sub (qev-add (qev-add (qev-var 0) (qev-var 1) ht) (QEvOpp _ _ _ _ (qev-var 1) ho) ht2) (qev-var 0))
    r2))

(def-fns _ $ (erased succ-lt-double : (erased (Nat) k v w) (subterm erased (Lt k v) l) (erased (Double v w) d) -> (erased (Lt (Succ k) w) r))
  (let-match erased d (DS v1 w1 d1) (absurd (D0) l))
  (match erased l _
    ((LtZ _) (LtS (Zero) (Succ w1) (LtZ w1)))
    ((LtS k1 _ l1) (LtS (Succ k1) (Succ w1) (lt-weaken (Succ k1) w1 (succ-lt-double k1 v1 w1 l1 d1))))))

(def-fns _ $ (erased nat-lt-pow2 : (erased (Nat) k v) (subterm erased (Pow2 k v) p) -> (erased (Lt k v) r))
  (let-match erased p (PS k1 v1 _ p1 d) ((P0) (LtZ (Zero))))
  (succ-lt-double k1 v1 v (nat-lt-pow2 k1 v1 p1) d))

(def-fns _ $ (erased zpos-lt : (erased (Nat) a b) (erased (Lt a b) l) -> (erased (ZLt (Zpos a) (Zpos b)) r))
  (MkZLt _ _ _ _ _ _ _ _ (ZViewPos a) (ZViewPos b) (add-zero-right (Succ a)) (add-zero-right (Succ b)) (LtS a b l)))

(def-fns _ $ (erased zpos-le : (erased (Nat) a b) (erased (Lt a (Succ b)) l) -> (erased (ZLe (Zpos a) (Zpos b)) r))
  (MkZLe _ _ _ _ _ _ _ _ (ZViewPos a) (ZViewPos b) (add-zero-right (Succ a)) (add-zero-right (Succ b)) (LtS a (Succ b) l)))

(def-fns _ $ (erased qarch : (erased (Q) g) (erased (QLt (Qmake (Z0) (Zero)) g) h) ->
