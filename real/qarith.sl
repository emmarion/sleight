  (many QRLe : (erased (Q) x y) (erased (QLe x y) h) -> (QR (OLe) x y)))

(def-fns _ $ (erased qr-cross : (erased (ORel) k) (erased (Z) nx ny) (erased (Nat) dx dy) (erased (QR k (Qmake nx dx) (Qmake ny dy)) h) ->
    (erased (Z) l r) (erased (ZMul nx (Zpos dy) l) hl) (erased (ZMul ny (Zpos dx) r) hr) (erased (ZR k l r) z))
  (match erased h _
    ((QRLt _ _ q) (let-match erased q (MkQLt _ _ l r _ _ hl hr lt)) (values l r hl hr (ZRLt _ _ lt)))
    ((QRLe _ _ q) (let-match erased q (MkQLe _ _ l r _ _ hl hr le)) (values l r hl hr (ZRLe _ _ le)))))

(def-fns _ $ (erased cross-qr : (erased (ORel) k) (erased (Z) nx ny l r) (erased (Nat) dx dy)
    (erased (ZMul nx (Zpos dy) l) hl) (erased (ZMul ny (Zpos dx) r) hr) (erased (ZR k l r) z) -> (erased (QR k (Qmake nx dx) (Qmake ny dy)) h))
