  (let-match erased k (MkQMult _ _ n2 _ _ d2 hn2 hd2))
  (let-match erased (zmul-fn _ _ _ _ hn hn2) (Refl _ _))
  (let-match erased (zmul-fn _ _ _ _ hd hd2) (Refl _ _))
  (Refl _ z))

(def-fns _ $ (erased qopp-fn : (erased (Q) x z w) (erased (QOpp x z) h) (erased (QOpp x w) k) -> (erased (Eq (Q) z w) e))
  (let-match erased h (MkQOpp _ n _ hn))
  (let-match erased k (MkQOpp _ n2 _ hn2))
  (let-match erased (zopp-fn _ _ _ hn hn2) (Refl _ _))
  (Refl _ z))

(def-fns _ $ (erased qabs-fn : (erased (Q) x z w) (erased (QAbs x z) h) (erased (QAbs x w) k) -> (erased (Eq (Q) z w) e))
  (let-match erased h (MkQAbs _ n _ hn))
  (let-match erased k (MkQAbs _ n2 _ hn2))
  (let-match erased (zabs-fn _ _ _ hn hn2) (Refl _ _))
  (Refl _ z))

(def-fns _ $ (erased qminus-fn : (erased (Q) x y z w) (erased (QMinus x y z) h) (erased (QMinus x y w) k) -> (erased (Eq (Q) z w) e))
  (let-match erased h (MkQMinus _ _ o _ ho hp))
  (let-match erased k (MkQMinus _ _ o2 _ ho2 hp2))
  (let-match erased (qopp-fn _ _ _ ho ho2) (Refl _ _))
  (qplus-fn _ _ _ _ hp hp2))
