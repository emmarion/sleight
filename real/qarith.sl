    (erased (ZMul nx (Zpos dy) l) hl) (erased (ZMul ny (Zpos dx) r) hr) -> (erased (ZR k l r) z))
  (let ((erased l1) (erased r1) (erased hl1) (erased hr1) (erased z)) (qr-cross k nx ny dx dy h))
  (let-match erased (zmul-fn _ _ _ _ hl hl1) (Refl _ _))
  (let-match erased (zmul-fn _ _ _ _ hr hr1) (Refl _ _))
