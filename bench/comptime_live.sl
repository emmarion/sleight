; generated by bench/gen.py: the same list kept as a Const and as the final value, so every block of it
; is reachable and the emitter must walk, order and write all of them
(def-lvl GL)
(def-fns GL $ (many gen-list : (subterm many (Nat) n) (many (List $ Nat) acc) -> (many (List $ Nat) r))
  (match many n _ ((Zero) acc) ((Succ j) (tail (gen-list j (Cons (Nat) j acc))))))
(let ((many big)) (gen-list 12000 (Nil (Nat))))
big
