; generated by bench/gen.py: a long list built at compile time and folded away, so nothing reaches it
(def-lvl GL)
(def-fns GL $ (many gen-list : (subterm many (Nat) n) (many (List $ Nat) acc) -> (many (List $ Nat) r))
  (match many n _ ((Zero) acc) ((Succ j) (tail (gen-list j (Cons (Nat) j acc))))))
(def-fns GL $ (many gen-total : (subterm many (List $ Nat) xs) (many (Nat) acc) -> (many (Nat) r))
  (match many xs _ ((Nil a) acc) ((Cons a x rest) (tail (gen-total rest (nat-add x acc))))))
(let ((many t)) (gen-total (gen-list 12000 (Nil (Nat))) 0))
t
