(let ((many size)) 1000000)
(let ((erased size-fits)) (prove-literal-lt 1000000 4611686018427387904))
(let ((erased range-fits)) (prove-literal-lt 1073741824 4611686018427387904))
(let ((erased range-pos)) (prove-literal-lt 0 1073741824))
(let ((erased (Lt 0 u8-modulus) zero-u8)) u8-modulus-pos)

(def-fns _ $ (many gen : (subterm many (Nat) k) (many (Nat) seed) (unique (ULst) acc)
    (erased (Nat) j) (erased (LenU acc j) l) (erased (Add k j size) c) -> (unique (ULst) r) (erased (LenU r size) lr))
  (let-match many k (Succ k1) ((Zero) (let-match erased c (AddZero _)) (values acc l)))
  (let-match erased c (AddSucc _ _ s1 c1))
  (let ((many x) (erased x-below) (erased _)) (nat-mod (nat-add (nat-mul seed 1103515245) 12345) 1073741824 range-pos))
  (tail $ gen k1 x (UCons (MkU62 x (lt-trans _ _ _ x-below range-fits)) acc) (Succ j) (LCons _ _ _ l) (add-succ-right k1 j s1 c1)))

(def-fns _ $ (many checksum : (subterm many (ULst) xs) (many (Nat) i) (many (Nat) acc) -> (many (Nat) sum))
  (let-match many xs (UCons x xt) ((UNil) acc))
  (let-match many x (MkU62 v _))
  (tail $ checksum xt (nat-add i 1) (nat-add acc (nat-mul i v))))

(def-fns _ $ (many minus : (many (Nat) a) (many (Nat) b) -> (many (Nat) c))
  (let-match many (lt-dec b (Succ a)) (Yes _ _ le) ((No _ _ _) 0))
  (let ((many c) (erased _)) (sub a b le))
  c)

(def-fns _ $ (many line : (many (String) name) (many (Nat) v) (many (String) rest) -> (many (String) s))
  (str-append name (str-append " " (str-append (nat-str v) (str-append "\n" rest)))))

(def-lvl Main)

(def-unique Main $ (unique start : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program Main) next))
  (let ((unique xs) (erased lxs)) (gen size 42 (UNil) 0 (LNil) (add-zero-right size)))
  (let ((unique stop-req)) (Measure (Stop)))
  (let ((unique w1) (many u0)) (world-do _ w (Measure (Start))))
  (let ((unique r) (erased _) (erased _)) (msort xs size lxs size-fits))
  (let ((unique w2) (many u1)) (world-do _ w1 stop-req))
  (let-match many u0 (MkUsage wall0 _ _ minor0 promoted0 major0 _ _))
  (let-match many u1 (MkUsage wall1 _ _ minor1 _ major1 _ _))
  (let ((many text))
    (line "checksum" (checksum (share r) 0 0)
      $ line "sort-ns" (minus wall1 wall0)
      $ line "minor-words" (minus minor1 minor0) $ line "major-words" (minus major1 major0)
      $ line "setup-minor-words" minor0 $ line "setup-promoted-words" promoted0 $ line "setup-major-words" major0 ""))
  (let ((unique w3) (many _)) (world-do _ w2 (WriteOut text)))
  (values w3 (Exit Main (MkU8 0 zero-u8))))

(Continue Main start)
