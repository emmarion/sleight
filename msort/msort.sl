(def-adts
  ((Order : ((U62) x) ((U62) y) -> Type)
    enum
    (many OLe : (erased (U62) x) (erased (U62) y) (erased (LeU x y) p) -> (Order x y))
    (many OGt : (erased (U62) x) (erased (U62) y) (erased (LeU y x) p) -> (Order x y))))

(def-fns _ $ (many le-dec : (many (U62) x) (many (U62) y) -> (many (Order x y) o))
  (let-match many x (MkU62 a pa))
  (let-match many y (MkU62 b pb))
  (match many (u62-cmp a b pa pb) _
    ((CLt _ _ _ _ p) (OLe x y (MkLeU a pa b pb (lt-weaken a b p))))
    ((CEq _ _ _) (OLe x y (MkLeU a pa b pb (lt-succ a))))
    ((CGt _ _ _ _ q) (OGt x y (MkLeU b pb a pa (lt-weaken b a q))))))

(def-fns _ $ (many merge-into : (many (U62) h) (erased (Slot) t)
    (unique (Cell UCons (slot-of h) t) hole)
    (subterm unique (ULst) xs) (subterm unique (ULst) ys) ->
    (erased (ULst) m) (erased (MergeU xs ys m) pm) (unique (UCons h m) is r at hole))
  (let-match unique xs (UCons x xt c1) ((UNil) (values ys (MNilL ys) (hole (at) h ys))))
  (let-match unique ys (UCons y yt c2) ((UNil) (values xs (MNilR xs) (hole (at) h (at unique (c1 x xt))))))
  (match many (le-dec x y) _
    ((OLe _ _ l)
      (let ((unique hole2)) (cell-write unique hole (UCons _ (slot-of c1))))
      (let ((erased m2) (erased p2) (unique r2)) (tail (merge-into x _ c1 xt (at unique (c2 y yt)))))
      (values r2 (MLeft x xt y yt m2 l p2) (at unique (hole2 h r2))))
    ((OGt _ _ l)
      (let ((unique hole2)) (cell-write unique hole (UCons _ (slot-of c2))))
      (let ((erased m2) (erased p2) (unique r2)) (tail (merge-into y _ c2 (at unique (c1 x xt)) yt)))
      (values r2 (MRight x xt y yt m2 l p2) (at unique (hole2 h r2))))))

(def-fns _ $ (many merge : (unique (ULst) xs) (unique (ULst) ys) -> (unique (ULst) r) (erased (MergeU xs ys r) pm))
  (let-match unique xs (UCons x xt c1) ((UNil) (values ys (MNilL ys))))
  (let-match unique ys (UCons y yt c2) ((UNil) (let ((unique r)) (at unique (c1 x xt))) (values r (MNilR r))))
  (match many (le-dec x y) _
    ((OLe _ _ l)
      (let ((erased m2) (erased p2) (unique r2)) (merge-into x _ c1 xt (at unique (c2 y yt))))
      (values r2 (MLeft x xt y yt m2 l p2)))
    ((OGt _ _ l)
      (let ((erased m2) (erased p2) (unique r2)) (merge-into y _ c2 (at unique (c1 x xt)) yt))
      (values r2 (MRight x xt y yt m2 l p2)))))

(def-fns _ $ (many split-into : (many (U62) h) (erased (Slot) t)
    (unique (Cell UCons (slot-of h) t) hole)
    (subterm many (Nat) k) (unique (ULst) xs) (erased (Nat) j) (erased (Nat) n) (erased (LenU xs n) ln) (erased (Add k j n) a)
    (erased (Lt n u62-modulus) bn) ->
    (erased (ULst) p) (unique (UCons h p) is r at hole) (unique (ULst) rest)
    (erased (LenU p k) lp) (erased (LenU rest j) lr) (erased (CatU p rest xs) cp))
  (let ((erased bk)) (lt-le-trans k (Succ n) u62-modulus (add-le-left k j n a) (LtS n u62-modulus bn)))
  (let-match many (u62-cmp k 0 bk u62-modulus-pos) (CGt _ _ _ _ kpos)
    (absurd (CLt _ _ _ _ neg) neg)
    ((CEq _ _ _) (let-match erased a (AddZero _)) (values (UNil) (hole (at) h (UNil)) xs (LNil) ln (CatNil xs))))
  (let-match erased kpos (LtZ k1))
  (let ((many k1r)) (u62-dec k1 k bk))
  (let-match erased a (AddSucc _ _ n1 a1))
  (let-match unique xs (UCons x xt c1) (absurd (UNil) ln))
  (let-match erased ln (LCons _ _ _ l1))
  (let ((unique hole2)) (cell-write unique hole (UCons _ (slot-of c1))))
  (let ((erased p2) (unique r2) (unique rest) (erased lp2) (erased lr) (erased cp2))
    (tail (split-into x _ c1 k1r xt j n1 l1 a1 (lt-trans n1 n u62-modulus (lt-succ n1) bn))))
  (values r2 (at unique (hole2 h r2)) rest (LCons x p2 k1 lp2) lr (CatCons x p2 rest xt cp2)))

(def-fns _ $ (many msort-n : (subterm many (Nat) n) (unique (ULst) xs) (erased (LenU xs n) ln) (erased (Lt n u62-modulus) bn) ->
    (unique (ULst) r) (erased (SortedU r) s) (erased (PermU xs r) pr))
  (let-match unique xs (UCons x xt c1) ((UNil) (values (UNil) (SortNil) (PNil))))
  (let-match erased ln (LCons _ _ n1 l1))
  (let-match many (u62-lt-dec n 2 bn two-fits) (No _ _ _ _ le-ge)
    ((Yes _ _ _ _ lt2)
      (let-match erased lt2 (LtS _ _ lt1))
      (let-match erased lt1 (LtZ _) (absurd (LtS _ _ z) z))
      (let-match erased l1 (LNil))
      (let ((unique r)) (at unique (c1 x xt)))
      (values r (SortCons x (UNil) (LHNil x) (SortNil)) (perm-refl r))))
  (let ((erased ge)) (le-lt-succ _ _ le-ge))
  (let-match erased ge (LtS _ _ ge1))
  (let-match erased ge1 (LtS _ _ ge2))
  (let-match erased ge2 (LtZ _))
  (let ((many q) (erased _) (erased pv) (erased m) (erased rr) (erased mm) (erased am) (erased rlt) (erased bq))
    (u62-shr n 1 bn (LtS (Zero) sixty-two (lt-trans (Zero) eight sixty-two (LtZ _) (eight-lt-sixty-two)))))
  (let-match erased pv (PS _ _ _ p0 d2))
  (let-match erased p0 (P0))
  (let-match erased d2 (DS _ _ d1))
  (let-match erased d1 (D0))
  (let ((erased qq)) (mul-two-add q m mm))
  (let-match erased q (Succ q0)
    (absurd (Zero)
      (let-match erased qq (AddZero _))
      (let-match erased am (AddZero _))
      (let-match erased rlt (LtS _ _ r1))
      (let-match erased r1 (LtS _ _ r2))
      r2))
  (let ((erased s) (erased qs)) (add q rr))
  (let ((erased qk)) (add-assoc q q m rr n s qq am qs))
  (let ((many k2) (erased qd) (erased bs)) (u62-sub n q bn (add-le-left q s n qk)))
  (let-match erased (add-cancel q k2 s n qd qk) (Refl _ _))
  (let-match erased qs (AddSucc _ _ s0 _))
  (let ((many k1m)) (u62-dec q0 q bq))
  (let-match erased qk (AddSucc _ _ _ a1))
  (let ((erased p) (unique r1) (unique rest) (erased lp) (erased lr) (erased cp)) (split-into x _ c1 k1m xt k2 n1 l1 a1 (lt-trans n1 n u62-modulus (lt-succ n1) bn)))
  (let ((erased sp1)) (lt-subterm q n (add-pos-lt q s n qk (LtZ s0))))
  (let ((erased sp2)) (lt-subterm s n (add-pos-lt s q n (add-comm q s n qk) (LtZ q0))))
  (let ((unique s1) (erased ss1) (erased ps1)) (notail $ msort-n (subterm sp1) q r1 (LCons x p q0 lp) bq))
  (let ((unique s2) (erased ss2) (erased ps2)) (notail $ msort-n (subterm sp2) k2 rest lr bs))
  (let ((unique r) (erased pm)) (merge s1 s2))
  (let ((erased cm) (erased pcm)) (cat-exists s1 rest))
  (let ((erased cf) (erased pcf)) (cat-exists s1 s2))
  (values r (merge-sorted s1 s2 r ss1 ss2 pm)
    (PTrans _ _ _ (perm-cat-left r1 s1 rest xs cm ps1 (CatCons x p rest xt cp) pcm)
      (PTrans _ _ _ (perm-cat-right s1 rest s2 cm cf ps2 pcm pcf) (merge-perm s1 s2 r cf pm pcf)))))

(def-fns _ $ (many ulen : (subterm unique (ULst) xs) (many (Nat) acc) (erased (Nat) len) (erased (LenU xs len) l)
    (erased (Nat) total) (erased (Add len acc total) a) (erased (Lt total u62-modulus) bt) ->
    (many total is n) (unique xs is r at xs))
  (let-match unique xs (UCons x xt c)
    ((UNil c) (let-match erased l (LNil)) (let-match erased a (AddZero _)) (values acc (at unique (c)))))
  (let-match erased l (LCons _ _ len1 l1))
  (let-match erased a (AddSucc _ _ t1 a0))
  (let ((erased a1)) (add-succ-right len1 acc t1 a0))
  (let ((erased b1)) (lt-le-trans (Succ acc) (Succ total) u62-modulus
                       (add-le-left (Succ acc) len1 total (add-comm len1 (Succ acc) total a1)) (LtS total u62-modulus bt)))
  (let ((many n) (unique xt2)) (tail (ulen xt (u62-inc acc b1) len1 l1 total a1 bt)))
  (values n (at unique (c x xt2))))

(def-fns _ $ (many msort : (unique (ULst) xs) (erased (Nat) len) (erased (LenU xs len) l) (erased (Lt len u62-modulus) b) ->
    (unique (ULst) r) (erased (SortedU r) s) (erased (PermU xs r) p))
  (let ((many n) (unique xs2)) (ulen xs 0 len l len (add-zero-right len) b))
  (msort-n n xs2 l b))
