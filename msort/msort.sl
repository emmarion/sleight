(def-adts
  ((Order : ((U62) x) ((U62) y) -> Type)
    enum
    (many OLe : (erased (U62) x) (erased (U62) y) (erased (LeU x y) p) -> (Order x y))
    (many OGt : (erased (U62) x) (erased (U62) y) (erased (LeU y x) p) -> (Order x y))))

(def-fns _ $ (many le-dec : (many (U62) x) (many (U62) y) -> (many (Order x y) o))
  (let-match many x (MkU62 a pa))
  (let-match many y (MkU62 b pb))
  (match many (u62-cmp a b pa pb) _
    ((CLt _ _ _ _ p) (OLe x y (MkLeU a pa b pb (lt-weaken a b p))))
    ((CEq _ _ _) (OLe x y (MkLeU a pa b pb (lt-succ a))))
    ((CGt _ _ _ _ q) (OGt x y (MkLeU b pb a pa (lt-weaken b a q))))))

(def-fns _ $ (many merge-into : (many (U62) h) (erased (Slot) t)
    (unique (Cell UCons (slot-of h) t) hole)
    (subterm unique (ULst) xs) (subterm unique (ULst) ys) ->
    (erased (ULst) m) (erased (MergeU xs ys m) pm) (unique (UCons h m) is r at hole))
  (let-match unique xs (UCons x xt c1) ((UNil c) (values ys (MNilL ys) (hole (at) h ys))))
  (let-match unique ys (UCons y yt c2) ((UNil d) (values xs (MNilR xs) (hole (at) h (at (c1 x xt))))))
  (match many (le-dec x y) _
    ((OLe _ _ l)
      (let ((unique hole2)) (cell-write unique hole (UCons _ (slot-of c1))))
      (let ((erased m2) (erased p2) (unique r2)) (tail (merge-into x _ c1 xt (at (c2 y yt)))))
      (values r2 (MLeft x xt y yt m2 l p2) (at (hole2 h r2))))
    ((OGt _ _ l)
      (let ((unique hole2)) (cell-write unique hole (UCons _ (slot-of c2))))
      (let ((erased m2) (erased p2) (unique r2)) (tail (merge-into y _ c2 (at (c1 x xt)) yt)))
      (values r2 (MRight x xt y yt m2 l p2) (at (hole2 h r2))))))

(def-fns _ $ (many merge : (unique (ULst) xs) (unique (ULst) ys) -> (unique (ULst) r) (erased (MergeU xs ys r) pm))
  (let-match unique xs (UCons x xt c1) ((UNil c) (values ys (MNilL ys))))
  (let-match unique ys (UCons y yt c2) ((UNil d) (let ((unique r)) (at (c1 x xt))) (values r (MNilR r))))
  (match many (le-dec x y) _
    ((OLe _ _ l)
      (let ((erased m2) (erased p2) (unique r2)) (merge-into x _ c1 xt (at (c2 y yt))))
      (values r2 (MLeft x xt y yt m2 l p2)))
    ((OGt _ _ l)
      (let ((erased m2) (erased p2) (unique r2)) (merge-into y _ c2 (at (c1 x xt)) yt))
      (values r2 (MRight x xt y yt m2 l p2)))))

(def-fns _ $ (many split-into : (many (U62) h) (erased (Slot) t)
    (unique (Cell UCons (slot-of h) t) hole)
    (subterm many (Nat) k) (unique (ULst) xs) (erased (Nat) j) (erased (Nat) n) (erased (LenU xs n) ln) (erased (Add k j n) a) ->
    (erased (ULst) p) (unique (UCons h p) is r at hole) (unique (ULst) rest)
    (erased (LenU p k) lp) (erased (LenU rest j) lr) (erased (CatU p rest xs) cp))
  (let-match many k (Succ k1)
    ((Zero) (let-match erased a (AddZero _)) (values (UNil) (hole (at) h (UNil)) xs (LNil) ln (CatNil xs))))
  (let-match erased a (AddSucc _ _ n1 a1))
  (let-match unique xs (UCons x xt c1) (absurd (UNil) ln))
  (let-match erased ln (LCons _ _ _ l1))
  (let ((unique hole2)) (cell-write unique hole (UCons _ (slot-of c1))))
  (let ((erased p2) (unique r2) (unique rest) (erased lp2) (erased lr) (erased cp2)) (tail (split-into x _ c1 k1 xt j n1 l1 a1)))
  (values r2 (at (hole2 h r2)) rest (LCons x p2 k1 lp2) lr (CatCons x p2 rest xt cp2)))

(def-fns _ $ (many msort-n : (subterm many (Nat) n) (unique (ULst) xs) (erased (LenU xs n) ln) ->
    (unique (ULst) r) (erased (SortedU r) s) (erased (PermU xs r) pr))
  (let-match unique xs (UCons x xt c1) ((UNil c) (values (UNil) (SortNil) (PNil))))
  (let-match erased ln (LCons _ _ n1 l1))
  (let-match many n (Succ n1r))
  (let-match many n1r (Succ n2)
    ((Zero)
      (let-match erased l1 (LNil))
      (let ((unique r)) (at (c1 x xt)))
      (values r (SortCons x (UNil) (LHNil x) (SortNil)) (perm-refl r))))
  (let ((many k1m) (many k2) (erased a) (erased pos))
    (match many (nat-halve n) (((Nat) k1m) ((Nat) k2) ((Add (Succ k1m) k2 n) a) ((Lt (Zero) k2) pos))
      ((H1 m d dd)
        (let-match erased dd (DS m0 _ _))
        (let-match many m (Succ m0r))
        (values m0r (Succ m) (add-succ-right m m d (double-add m d dd)) (LtZ m)))
      ((H2 m d dd)
        (values m (Succ m) (AddSucc m (Succ m) (Succ d) (add-succ-right m m d (double-add m d dd))) (LtZ m)))))
  (let-match erased a (AddSucc _ _ _ a1))
  (let ((erased p) (unique r1) (unique rest) (erased lp) (erased lr) (erased cp)) (split-into x _ c1 k1m xt k2 n1 l1 a1))
  (let ((erased sp1)) (lt-subterm (Succ k1m) n (add-pos-lt (Succ k1m) k2 n a pos)))
  (let ((erased sp2)) (lt-subterm k2 n (add-pos-lt k2 (Succ k1m) n (add-comm (Succ k1m) k2 n a) (LtZ k1m))))
  (let ((unique s1) (erased ss1) (erased ps1)) (notail $ msort-n (subterm sp1) (Succ k1m) r1 (LCons x p k1m lp)))
  (let ((unique s2) (erased ss2) (erased ps2)) (notail $ msort-n (subterm sp2) k2 rest lr))
  (let ((unique r) (erased pm)) (merge s1 s2))
  (let ((erased cm) (erased pcm)) (cat-exists s1 rest))
  (let ((erased cf) (erased pcf)) (cat-exists s1 s2))
  (values r (merge-sorted s1 s2 r ss1 ss2 pm)
    (PTrans _ _ _ (perm-cat-left r1 s1 rest xs cm ps1 (CatCons x p rest xt cp) pcm)
      (PTrans _ _ _ (perm-cat-right s1 rest s2 cm cf ps2 pcm pcf) (merge-perm s1 s2 r cf pm pcf)))))

(def-fns _ $ (many ulen : (subterm unique (ULst) xs) (many (Nat) acc) ->
    (many (Nat) n) (erased (Nat) len) (erased (LenU xs len) l) (erased (Add len acc n) a) (unique xs is r at xs))
  (let-match unique xs (UCons x xt c) ((UNil c) (values acc (Zero) (LNil) (AddZero acc) (at (c)))))
  (let ((many n) (erased len) (erased l) (erased a) (unique xt2)) (tail (ulen xt (Succ acc))))
  (values n (Succ len) (LCons x xt len l) (add-shift len acc n a) (at (c x xt2))))

(def-fns _ $ (many msort : (unique (ULst) xs) -> (unique (ULst) r) (erased (SortedU r) s) (erased (PermU xs r) p))
  (let ((many n) (erased len) (erased l) (erased a) (unique xs2)) (ulen xs (Zero)))
  (let-match erased (add-fn len (Zero) n len a (add-zero-right len)) (Refl _ _))
  (msort-n n xs2 l))
