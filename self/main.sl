; self/main.sl -- the compiler's entry point: a Program (DESIGN.md section 42) reading the files named on its
; command line, elaborating them in one scope in order after the prelude (embedded as lib/embed.sl's
; prelude-source), and writing the extracted OCaml to stdout as one string, or under --interpret performing
; the program itself (self/interp.sl); elaboration errors go to stderr with exit code 1. The levels are
; minted in self/interp.sl.

(def-fns util-lvl $ (many write-lines : (subterm many (List $ String) es) (unique (World) w at vacant-slot) -> (unique (World) w2 at w))
  (let-match many es (Cons _ e rest) ((Nil _) w))
  (tail $ write-lines rest $ say-to (BTrue) "\n" $ say-to (BTrue) e w))

; Each file the sources hold, with the name the messages give it; a syntax error ends that file's reading. The first
; source is the prelude (lib/builtin.ml).
(def-fns util-lvl $ (many run-files : (unique (ElabWorld) ew) (many (Bool) notes) (subterm many (List $ SrcFile) srcs) (many (Env) env) (many (Bool) first) -> (unique (ElabWorld) ewr at ew) (many (Env) r))
  (let-match many srcs (Cons _ f rest) ((Nil _) (values ew env)))
  (let-match many f (MkSrcFile path name _ _))
  (let ((many env1)) $ env-at-loc env $ MkLoc name $ MkSpot 1 1)
  (let ((many items) (many err) (many regions)) $ parse f)
  (let ((many ws)) $ indent-warnings notes f)
  (let ((many envw)) $ env-warn-all env1 ws)
  (let ((unique ew1) (many (Env) env2))
    (match many err (((ElabWorld) _ at ew) ((Env) env2))
      ((Some _ e)
        (let-match many e (MkSynErr pos m paren note))
        (let ((many shape)) $ match many (and notes $ and paren $ list-is-empty _ ws) (((List $ String) _)) ((BTrue) (Cons _ (shape-note path) $ Nil _)) ((BFalse) (Nil _)))
        (let ((many lines)) $ match many note (((List $ String) _))
          ((None _) shape)
          ((Some _ pn) (match many pn _ ((MkPair _ _ np nm) (Cons _ (located (env-at envw np) ": note: " nm) shape)))))
        (values ew (env-fail envw $ join-strs (Cons _ (located (env-at envw pos) ": syntax error: " m) lines) "\n")))
      ((None _) (let ((unique ew2) (many envt)) $ run-toplevel ew expansion-limit items (Nil _) 0 first $ env-set-regions envw regions) (values ew2 (end-file envt)))))
  (tail $ run-files ew1 notes rest (match many first (((Env) _)) ((BTrue) (env-set-externs (env-set-prelude env2 $ env-scope env2) $ BFalse)) ((BFalse) env2)) $ BFalse))

(def-fns util-lvl $ (many src-paths : (subterm many (List $ Pair (String) $ String) srcs) -> (many (List $ String) r))
  (let-match many srcs (Cons _ ps rest) ((Nil _) (Nil _)))
  (let-match many ps (MkPair _ _ path _))
  (Cons _ path $ notail $ src-paths rest))

(def-fns util-lvl $ (many shown : (many (Bool) first-only) (subterm many (List $ Said) ss) (many (Bool) seen) (many (List $ MsgMeta) table) (many (Env) env) -> (many (List $ String) r))
  (let-match many ss (Cons _ x rest) ((Nil _) (Nil _)))
  (let ((many lo) (many text) (many err)) $ match many x (((Loc) _) ((Maybe $ String) _) ((Bool) _))
    ((SaidWarning sl t) (values sl (Some _ t) $ BFalse))
    ((SaidError sl t) (values sl (Some _ t) $ BTrue))
    ((SaidNote sl t) (values sl (Some _ t) $ BFalse))
    (else (values (MkLoc "" $ MkSpot 0 0) (None _) $ BFalse)))
  (let-match many text (Some _ t) ((None _) (tail $ shown first-only rest seen table env)))
  (let-match many (and first-only seen) (BFalse) ((BTrue) (Cons _ "slc: stopped at the first error (--first-error)" $ Nil _)))
  (let ((many t2) (many table2)) $ resolve-marks lo (expand-frames env t) table)
  (Cons _ t2 $ notail $ shown first-only rest (or seen err) table2 env))

(def-fns util-lvl $ (many srcs-files : (subterm many (List $ Pair (String) $ String) srcs) -> (many (List $ SrcFile) r))
  (let-match many srcs (Cons _ ps rest) ((Nil _) (Nil _)))
  (let-match many ps (MkPair _ _ path src))
  (let ((many fs) (erased _)) $ list-append _ (src-files path src) $ notail $ srcs-files rest)
  fs)

(def-fns util-lvl $ (many last-path : (subterm many (List $ SrcFile) srcs) -> (many (String) r))
  (let-match many srcs (Cons _ f rest) ((Nil _) "-"))
  (let-match many rest (Nil _) ((Cons _ _ _) (tail $ last-path rest)))
  (let-match many f (MkSrcFile _ name _ _))
  name)

(def-fns util-lvl $ (many goal-refused : (subterm many (List $ Pair (String) $ String) flags) -> (many (Maybe $ String) r))
  (let-match many flags (Cons _ p rest) ((Nil _) (None _)))
  (let-match many p (MkPair _ _ f _))
  (match many (or (str-eqb f "--interpret") $ or (str-eqb f "--no-prelude") (str-eqb f "--build")) _ ((BTrue) (Some _ f)) ((BFalse) (tail $ goal-refused rest))))

(def-fns util-lvl $ (many goal-mode-of : (many (String) g) -> (many (Maybe $ GoalMode) r))
  (let-match many (str-eqb g "none") (BFalse) ((BTrue) (Some _ $ GoalUnrequired)))
  (let-match many (str-eqb g "open") (BFalse) ((BTrue) (Some _ $ GoalOpen)))
  (let-match many (str-eqb g "proved") (BTrue) ((BFalse) (None _)))
  (Some _ $ GoalProved))

(def-fns run-lvl $ (many goal-verdict : (many (List $ Pair (String) $ String) flags) (many (Bool) pass) (unique (World) w at vacant-slot) -> (unique (World) w2 at w))
  (let-match many (flag-value flags "--goal") (Some _ g) ((None _) w))
  (let-match many (goal-mode-of g) (Some _ gm) ((None _) w))
  (let-match many gm (GoalUnrequired) (else (say-to (BFalse) (str-cat3 "--goal " g $ str-cat ": " $ match many pass _ ((BTrue) "PASS\n") ((BFalse) "FAIL\n")) w)))
  w)

(def-fns util-lvl $ (many failed : (many (String) m) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (failed-with _ exit-fail m w))

(def-fns run-lvl $ (many usage : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (failed "usage: slc [--no-prelude] [--no-templates] [--interpret] [--confine-read path] [--confine-write path] [--comptime-unconfine name] [--confine-output-bytes n] [--eval-fuel n] [--inline n] [--no-env] [--no-exec] [--first-error] [--warnings-as-errors] [--warn-unused] [--fn-same] [--no-shape-note] [--hints file] [--goal none|open|proved] [--build prog [--byte]] file.sl ... [-- arg ...] > out.ml" w))

(def-fns run-lvl $ (many run-program : (many (Env) env) (many (List $ String) pargs) (many (Bool) with-env) (many (Bool) with-exec) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (let ((erased hs) (many h)) (env-heap env))
  (interp-finals env pargs with-env with-exec _ (list-rev _ $ heap-finals _ h) _ h (le-refl hs) w))

(def-fns util-lvl $ (many ocamlfind : (many (List $ String) args) (many (String) dir) (many (Result $ Unit) wrote) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (many (Result $ Exited) r))
  (let-match many wrote (Ok _ _) ((Fail _ m) (values w (Fail _ m))))
  (host-exec "ocamlfind" args (Some _ dir) w))

(def-fns run-lvl $ (many build : (many (Bool) byte) (many (Maybe $ String) inline) (many (String) path) (many (String) ml) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (let ((many dir)) $ str-cat path ".build")
  (let ((unique w1) (many created)) (world-do _ w $ MkDir dir))
  (let-match many created (Ok _ change) ((Fail _ m) (failed-with _ exit-toolchain m w1)))
  (let-match many change (Changed) ((Unchanged) (failed-with _ exit-toolchain (str-cat dir ": already exists") w1)))
  (let ((many src)) $ str-cat dir "/main.ml")
  (let ((unique w2) (many wrote)) (world-do _ w1 $ WriteFile src ml))
  (let ((unique w2a) (many cwd)) (world-do _ w2 $ GetCwd))
  (let ((many exe)) $ match many (str-starts "/" path) (((String) _)) ((BTrue) path) ((BFalse) (str-cat3 cwd "/" path)))
  (let ((unique w3) (many ran)) $ ocamlfind (compile-args byte inline exe) dir wrote w2a)
  (let ((unique w4) (many entries)) (world-do _ w3 $ ListDir dir))
  (let ((unique w5)) $ delete-files dir (match many entries (((List $ String) _)) ((Ok _ names) names) ((Fail _ _) (Nil _))) w4)
  (let ((unique w6) (many removed)) (world-do _ w5 $ DeleteDir dir))
  (let-match many ran (Ok _ exited) ((Fail _ m) (failed-with _ exit-toolchain m w6)))
  (let-match many exited (MkExited code out err))
  (let ((unique w7)) $ say-to (BTrue) (str-cat out err) w6)
  (let-match many code (MkU8 n _))
  (let-match many n (Zero) (else (failed-with _ exit-ocamlopt (str-cat "ocamlfind exited with code " $ nat-str n) w7)))
  (let-match many removed (Ok _ _) ((Fail _ m) (failed-with _ exit-toolchain m w7)))
  (values w7 (Exit _ exit-ok)))

(def-fns compile-lvl $ (many compile : (many (List $ Pair (String) $ String) flags) (many (List $ String) pargs) (many (String) help) (many (List $ Pair (String) $ String) srcs) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (let ((many prelude)) $ not $ has-flag flags "--no-prelude")
  (let ((many with-env)) $ not $ has-flag flags "--no-env")
  (let ((many with-exec)) $ not $ has-flag flags "--no-exec")
  (let ((many bytes)) $ flag-value flags "--confine-output-bytes")
  (let ((many reads)) $ list-rev _ $ flag-values flags "--confine-read")
  (let ((many writes)) $ list-rev _ $ flag-values flags "--confine-write")
  (let ((many sources)) $ list-rev-onto _ (flag-values flags "--comptime-unconfine") $ list-drop _ (match many prelude (((Nat) _)) ((BTrue) 1) ((BFalse) 0)) $ src-paths srcs)
  (let ((many fuel)) $ flag-value flags "--eval-fuel")
  (let-match many (match many fuel (((Bool) _)) ((Some _ f) (is-some _ $ str-nat f)) ((None _) (BTrue))) (BTrue) ((BFalse) (failed "--eval-fuel takes a number of steps" w)))
  (let ((many inline)) $ flag-value flags "--inline")
  (let-match many (match many inline (((Bool) _)) ((Some _ n) (is-some _ $ str-nat n)) ((None _) (BTrue))) (BTrue) ((BFalse) (failed "--inline must be a non-negative integer" w)))
  (let-match many (and (has-flag flags "--byte") $ not $ has-flag flags "--build") (BFalse) ((BTrue) (failed "--byte needs --build" w)))
  (let-match many (and (has-flag flags "--build") $ has-flag flags "--interpret") (BFalse) ((BTrue) (failed "--build does not take --interpret" w)))
  (let ((many goal-arg)) $ match many (flag-value flags "--goal") (((String) _)) ((Some _ g) g) ((None _) "none"))
  (let ((many mode)) $ goal-mode-of goal-arg)
  (let-match many mode (Some _ gm) ((None _) (failed "--goal takes none, open or proved" w)))
  (let-match many (match many gm (((Maybe $ String) _)) ((GoalUnrequired) (None _)) (else (goal-refused flags))) (None _) ((Some _ f) (failed (str-cat3 "--goal " goal-arg $ str-cat " does not take " f) $ goal-verdict flags (BFalse) w)))
  (let ((many base-env)) (env-set-goals (env-set-sources (env-set-help (env-place-at (make-builtins) null-id $ TVar null-id) help) sources) $ MkGoals gm (None _) (Many) (TErr "no goal") "" $ None _))
  (let ((many builtins)) $ env-set-inline (env-set-fn-same (match many fuel (((Env) _)) ((Some _ f) (env-set-fuel base-env $ parse-nat f)) ((None _) base-env)) $ has-flag flags "--fn-same") inline)
  (let ((unique ew)) (MkElabWorld _ $ place-at _ w))
  (let ((many files)) $ srcs-files srcs)
  (let ((unique ew1) (many env0)) $ run-files ew (not $ has-flag flags "--no-shape-note") files (env-set-warn-unused (env-set-externs (match many prelude (((Env) _)) ((BTrue) builtins) ((BFalse) (env-set-prelude builtins $ env-scope builtins))) $ BTrue) $ has-flag flags "--warn-unused") prelude)
  (let-match unique ew1 (MkElabWorld _ pw0))
  (let ((unique w0)) (unplace-at _ _ _ pw0))
  (let-match erased (placed-slot _ _ _ pw0) (Refl _ _))
  (let ((many by-warnings)) $ and (has-flag flags "--warnings-as-errors") $ and (not $ env-failed env0) $ said-failed (BTrue) $ env-said env0)
  (let ((many env)) $ match many (or by-warnings $ env-failed env0) (((Env) _)) ((BTrue) env0) ((BFalse) (close-goal env0 $ last-path files)))
  (let ((unique w1)) $ write-lines (match many by-warnings (((List $ String) _)) ((BTrue) (Cons _ "slc: warnings are treated as errors (--warnings-as-errors)" $ Nil _)) ((BFalse) (Nil _)))
    $ write-lines (shown (has-flag flags "--first-error") (list-rev _ $ env-said env) (BFalse) (Nil _) env) w0)
  (let-match many (or (env-failed env) by-warnings) (BFalse) ((BTrue) (values (goal-verdict flags (BFalse) w1) (Exit _ exit-fail))))
  (let-match many gm (GoalUnrequired) (else (values (goal-verdict flags (BTrue) w1) (Exit _ exit-ok))))
  (let-match many (has-flag flags "--interpret") (BTrue)
    ((BFalse)
      (let ((many out) (erased _)) $ flatten $ emit-program (not $ has-flag flags "--no-templates") reads writes bytes with-env with-exec env $ Nil _)
      (match many (flag-value flags "--build") _
        ((Some _ path) (build (has-flag flags "--byte") inline path out w1))
        ((None _) (values (say-to (BFalse) out w1) (Exit _ exit-ok))))))
  (let ((unique w2) (many confined)) (world-do _ w1 $ ConfinePaths reads $ match many reads _ ((Cons _ _ _) writes) ((Nil _) (match many writes _ ((Nil _) (Cons _ "/" $ Nil _)) (else writes)))))
  (let-match many confined (Ok _ _) ((Fail _ m) (failed m w2)))
  (let-match many bytes (Some _ b) ((None _) (run-program env pargs with-env with-exec w2)))
  (let-match many (str-nat b) (Some _ nb) ((None _) (failed (str-cat b ": not a number of bytes") w2)))
  (let ((unique w3) (many limited)) (world-do _ w2 (ConfineOutputBytes nb)))
  (let-match many limited (Ok _ _) ((Fail _ m) (failed m w3)))
  (run-program env pargs with-env with-exec w3))

(def-fns slc-lvl $ (many read-files : (many (List $ Pair (String) $ String) flags) (many (List $ String) pargs) (many (String) help) (subterm many (List $ String) paths) (many (List $ Pair (String) $ String) acc) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (let-match many paths (Cons _ path rest) ((Nil _) (compile flags pargs help (list-rev _ acc) w)))
  (let ((unique w1) (many r)) (world-do _ w (ReadFile path)))
  (let-match many r (Ok _ src) ((Fail _ m) (failed m $ goal-verdict flags (BFalse) w1)))
  (tail $ read-files flags pargs help rest (Cons _ (MkPair _ _ path src) acc) w1))

; The files up to a "--", and the interpreted program's own arguments after it.
(def-fns util-lvl $ (many split-args : (subterm many (List $ String) args) -> (many (List $ String) files) (many (List $ String) pargs))
  (let-match many args (Cons _ p rest) ((Nil _) (values (Nil _) (Nil _))))
  (let-match many (str-eqb p "--") (BFalse) ((BTrue) (values (Nil _) rest)))
  (let ((many files) (many pargs)) (notail $ split-args rest))
  (values (Cons _ p files) pargs))

; Without --no-prelude the embedded prelude goes ahead of the files, under the path the reference names it
; by (lib/builtin.ml).
(def-fns start-lvl $ (many start-with : (many (List $ String) args) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (let ((many before) (many pargs)) (split-args args))
  (let-match many (read-flags before (Nil _) (Nil _)) (Ok _ read) ((Fail _ m) (failed m w)))
  (let-match many read (MkPair _ _ flags files))
  (let-match many (list-is-empty _ files) (BFalse) ((BTrue) (usage w)))
  (let ((many srcs)) $ match many (has-flag flags "--no-prelude") (((List $ Pair (String) $ String) _))
    ((BTrue) (Nil _))
    ((BFalse) (Cons _ (MkPair _ _ "lib/prelude.sl" prelude-source) $ Nil _)))
  (let-match many (flag-value flags "--hints") (Some _ h) ((None _) (read-files flags pargs specials-help files srcs w)))
  (let ((unique w1) (many r)) (world-do _ w (ReadFile h)))
  (let-match many r (Ok _ text) ((Fail _ m) (failed m w1)))
  (read-files flags pargs text files srcs w1))

(def-unique io-lvl $ (unique start : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io-lvl) p))
  (let ((unique w1) (many args)) (world-do _ w (GetArgs)))
  (start-with args w1))

(Continue _ start)
