        (let ((unique ew2) (many env3) (many ress) (many c2) (many pre2) (many codes) (erased pk)) $ notail $ elab-values ew1 fuel callbacks _ sugar arest env2 c1 mrest trest fs $ Cons _ (res-term $ first-res _ _ rs lock) done)
