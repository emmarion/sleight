  ((many elab-two-terms : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) args) (many (Env) env) -> (unique (ElabWorld) ewr at ew) (many (Env) r) (many (Term) a) (many (Term) aty) (many (Term) b) (many (Term) bty))
