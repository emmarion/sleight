  ((many elab-refute : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) root) (subterm many (List $ Syn) items) (erased (Within items root) w) (many (List $ Nat) frames) (many (Env) env) (many (List $ List $ Nat) ctx) -> (unique (ElabWorld) ewr at ew)
