  ((many coercible-ctor-args : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) args) (many (Env) env) (many (List $ List $ Nat) ctx) (many (List $ Entry) tele) (many (List $ Term) src) (many (List $ Term) tgt) (many (Nat) c) (many (Term) side) -> (unique (ElabWorld) ewr at ew) (many (Env) r) (many (List $ Term) src2) (many (List $ Term) tgt2))
    (def-fns refusal-lvl $ (many wrong : -> (many (Env) r)) (env-error env "internal: `coercible-ctor` argument count"))
