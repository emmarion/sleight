  ; A body: statements then the final expression (section 27); [items] sits within [root].
  ((many elab-body : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) root) (subterm many (List $ Syn) items) (erased (Within items root) w) (many (List $ Nat) frames) (many (Env) env0) (many (List $ List $ Nat) ctx) (many (List $ Multiplicity) expect) (many (Maybe $ List $ Entry) tele) (many (Maybe $ Sink) sink) -> (unique (ElabWorld) ewr at ew)
