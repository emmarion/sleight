                (let ((many ress2) (erased lock)) $ list-fit _ _ expect ress no-res)
                (values ew3 env2 ress2 h lock)))
            (let ((unique ew9) (many env9) (many ress9) (many h9) (erased lock9)) $ notail $ elab-expr-demand ew1 f2 callbacks _ (raw-size out) out (env-in-expansion env-x $ env-expansions env-x) ctx expect tele cc demand)
            (values ew9 (env-back env-x env9) ress9 h9 lock9)))))
    (let ((unique ew4) (many env-y) (many sy)) $ notail $ splice-call fuel callbacks _ ew1 env-x raw)
    (let-match many sy (None _)
      ((Some _ ry)
        (let-match many ry (Ok _ raw2)
          ((Fail _ m)
            (let ((unique ew5) (many env2) (many ress) (many h)) $ expr-error ew4 ctx expect env-y m "macro")
            (let ((many ress2) (erased lock)) $ list-fit _ _ expect ress no-res)
            (values ew5 env2 ress2 h lock)))
        (let-match many fuel (Succ f2)
          ((Zero)
            (let ((unique ew6) (many env2) (many ress) (many h)) $ expr-error ew4 ctx expect env-y "more than 10000 macro expansions" "macro")
            (let ((many ress2) (erased lock)) $ list-fit _ _ expect ress no-res)
            (values ew6 env2 ress2 h lock)))
        (tail $ elab-expr-demand ew4 f2 callbacks _ (raw-size raw2) raw2 env-y ctx expect tele cc demand)))
