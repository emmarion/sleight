  ((many elab-ctors : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) ctors) (many (Env) env) (many (Nat) tid) (many (Bool) nt) (many (List $ Nat) frames) -> (unique (ElabWorld) ewr at ew) (many (Env) r) (many (List $ Pair (Multiplicity) $ Nat) cs))
