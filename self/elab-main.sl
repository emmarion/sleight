  ((many check-call-proof : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm erased (List $ Syn) rawargs) (subterm many (Ann rawargs) ann) (many (Env) env0) (many (List $ List $ Nat) ctx) (many (Res) callee) (many (Callee) desc) (many (List $ Spot) sites) (many (Term) lv) (many (List $ Entry) params) (many (List $ Term) args) (many (List $ Term) arg-tys) -> (unique (ElabWorld) ewr at ew) (many (Env) r))
