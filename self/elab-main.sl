; self/elab-main.sl -- the main block of the elaborator begun in self/elab.sl.

(def-fns _ $ (many host-exec : (many (String) prog) (many (List $ String) args) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (many (Result $ Exited) r))
  (let ((unique w1) (many envs)) (world-do _ w $ GetEnvs))
  (world-do _ w1 $ Exec prog args envs (None _) ""))

(def-fns _ $ (many delete-files : (many (String) dir) (subterm many (List $ String) names) (unique (World) w at vacant-slot) -> (unique (World) w2 at w))
  (let-match many names (Cons _ n rest) ((Nil _) w))
  (let ((unique w1) (many _)) (world-do _ w $ DeleteFile $ str-cat3 dir "/" n))
  (tail $ delete-files dir rest w1))

(def-fns _ $ (many exited-ok : (many (String) what) (many (Result $ Exited) r) -> (many (Result $ String) out))
  (let-match many r (Ok _ e) ((Fail _ m) (Fail _ m)))
  (let-match many e (MkExited code out err))
  (let-match many code (MkU8 n _))
  (let-match many n (Zero) (else (Fail _ $ str-cat3 what (str-cat " exited with code " $ nat-str n) $ str-cat3 "\n" out err)))
  (Ok _ out))

(def-fns _ $ (many native-run : (many (String) ml) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (many (Result $ Nat) r))
  (let ((unique w1) (many tmp)) $ host-exec "mktemp" (Cons _ "-d" $ Nil _) w)
  (let-match many (exited-ok "mktemp" tmp) (Ok _ mout) ((Fail _ m) (values w1 $ Fail _ m)))
  (let ((many dir) (many _)) $ str-until mout 10)
  (let ((many src)) $ str-cat dir "/main.ml")
  (let ((many exe)) $ str-cat dir "/main")
  (let ((unique w2) (many wrote)) (world-do _ w1 $ WriteFile src ml))
  (let ((unique w3) (many built)) $ host-exec "ocamlfind" (Cons _ "ocamlopt" $ Cons _ "-package" $ Cons _ "zarith,unix" $ Cons _ "-linkpkg" $ Cons _ src $ Cons _ "-o" $ Cons _ exe $ Nil _) w2)
  (let ((unique w4) (many ran)) $ match many (exited-ok "ocamlfind" built) (((World) _ at w3) ((Result $ Exited) _))
    ((Ok _ _) (host-exec exe (Nil _) w3))
    ((Fail _ m) (values w3 $ Fail _ m)))
  (let ((unique w5) (many entries)) (world-do _ w4 $ ListDir dir))
  (let ((unique w6)) $ delete-files dir (match many entries (((List $ String) _)) ((Ok _ names) names) ((Fail _ _) (Nil _))) w5)
  (let ((unique w7) (many _)) (world-do _ w6 $ DeleteDir dir))
  (let-match many wrote (Ok _ _) ((Fail _ m) (values w7 $ Fail _ m)))
  (let-match many (exited-ok "the compiled function" ran) (Ok _ out) ((Fail _ m) (values w7 $ Fail _ m)))
  (values w7 $ match many (str-nat out) (((Result $ Nat) _)) ((Some _ i) (Ok _ i)) ((None _) (Fail _ $ str-cat "the compiled function printed " out))))

(def-fns _ $ (many fielded : (subterm many (List $ Ctor) cs) -> (many (Maybe $ Ctor) r))
  (let-match many cs (Cons _ c rest) ((Nil _) (None _)))
  (match many (ctor-arity c) _ ((Zero) (tail $ fielded rest)) (else (Some _ c))))

(def-fns _ $ (many native-invoke : (unique (ElabWorld) ew) (many (Env) env) (many (Nat) hid) (many (Adt) adt) -> (unique (ElabWorld) ewr at ew) (many (Env) r) (many (Maybe $ Nat) cid))
  (let-match many (env-failed env) (BFalse) ((BTrue) (values ew env $ None _)))
  (let ((erased _) (many h)) $ env-heap env)
  (let-match many (settled-ref _ (heap-entries _ h) hid) (Some _ f) ((None _) (values ew (env-error env "internal: `native-compute` of a function with no stored value") $ None _)))
  (let ((many ml)) $ rope-str $ emit-program (BTrue) (Nil _) (Nil _) (None _) (BTrue) (BTrue) (env-with-store env _ (heap-store _ h) (heap-entries _ h) $ Cons _ (MkPair _ _ f type-term) $ Nil _) $ Some _ adt)
  (let-match unique ew (MkElabWorld _ pw))
  (let ((unique w)) (unplace-at _ _ _ pw))
  (let-match erased (placed-slot _ _ _ pw) (Refl _ _))
  (let ((unique w1) (many r)) $ native-run ml w)
  (let ((unique ew1)) $ MkElabWorld _ $ place-at _ w1)
  (let-match many r (Ok _ i) ((Fail _ m) (values ew1 (env-error env $ str-cat "`native-compute`: " m) $ None _)))
  (match many (list-nth _ (adt-ctors adt) i) _
    ((NthHit _ _ _ c _) (values ew1 env $ Some _ $ ctor-id c))
    ((NthMiss _ _ _ _) (values ew1 (env-error env $ str-cat3 "`native-compute`: the compiled function answered discriminant " (nat-str i) $ str-cat3 ", which " (adt-name adt) " does not have") $ None _))))

(let ((erased hop-0)) (Zero))
(let ((erased hop-1)) (Succ hop-0))
(let ((erased hop-2)) (Succ hop-1))
(let ((erased hop-3)) (Succ hop-2))
(let ((erased hop-4)) (Succ hop-3))
(let ((erased hop-5)) (Succ hop-4))
(let ((erased hop-6)) (Succ hop-5))
(let ((erased hop-7)) (Succ hop-6))
(let ((erased hop-8)) (Succ hop-7))
(let ((erased hop-9)) (Succ hop-8))

(def-fns _
  ((many eval : (subterm erased (Nat) xf) (subterm erased (Nat) callbacks) (subterm erased hop-0 is _) (subterm many (Nat) fuel) (erased (Hist Block) hs) (many (Heap hs) hp) (erased (List $ List $ Nat) ctx) (erased (List $ Multiplicity) ms) (subterm many (Code ctx ms) code) (many (St hs ctx) st) (erased Type W) (many (Performer W xf callbacks) pf) (unique W w) ->
      (erased (Hist Block) hs2) (many (Heap hs2) hp2) (erased (Suffix Block hs2 hs) le) (many (List $ Ref Block hs2) vs) (erased (Picked (Ref Block hs2) ms vs) pk) (unique W w2 at w))
    (match many code _
      ((CVar _ _ p)
        (let-match many st (MkSt _ _ env))
        (let ((erased h2) (many hp2) (erased le) (many v)) $ frames-get _ _ p _ hp env)
        (values h2 hp2 le (Cons _ v $ Nil _) (PkMany _ _ v (Nil _) $ PkNil _) w))
      ((CConst _ x)
        (let ((erased h2) (many hp2) (erased le) (many v)) $ settled-entry-value _ hp x)
        (values h2 hp2 le (Cons _ v $ Nil _) (PkMany _ _ v (Nil _) $ PkNil _) w))
      ((CValue _ v)
        (let ((erased _) (erased pv3)) (block-widen _ _ (empty-suffix _ hs) v))
        (let ((erased hl2) (many hp2) (erased sf2) (many a)) $ halloc _ hp (coerce v pv3))
        (values hl2 hp2 sf2 (Cons _ a $ Nil _) (PkMany _ _ a (Nil _) $ PkNil _) w))
      ((CErased _ ms2)
        (let ((erased hl2) (many hp2) (erased sf2) (many a)) $ halloc _ hp $ BToken _)
        (let ((many vs) (erased pk)) $ vals-of _ ms2 a)
        (values hl2 hp2 sf2 vs pk w))
      ((CValues _ ms2 cs2 pk) (tail $ eval-picked xf callbacks _ fuel _ hp _ cs2 ms2 pk st _ pf w))
      ((CApp _ ms2 f args _)
        (let ((erased _) (many hp1) (erased le1) (many fvs) (erased fpk) (unique W w1)) $ notail $ eval xf callbacks _ fuel _ hp _ _ f st _ pf w)
        (let ((many fv0)) $ vals-one _ fvs fpk)
        (let ((erased _) (erased ps1)) (st-widen _ _ le1 _ st))
        (let ((erased _) (many hp2) (erased le2) (many avs) (unique W w2)) $ notail $ eval-list xf callbacks _ fuel _ hp1 _ args (coerce st ps1) _ pf w1)
        (let ((erased _) (erased pf0)) (ref-widen _ _ _ le2 fv0))
        (let ((many fv)) (coerce fv0 pf0))
        (match many fuel _
          ((Zero)
            (let ((erased h3) (many hp3) (erased le3) (many r) (erased rpk)) $ error-vals _ hp2 ms2 "out of fuel")
            (values h3 hp3 (hist-le-trans _ _ _ (hist-le-trans _ _ _ le1 le2) le3) r rpk w2))
          ((Succ k)
            (let ((erased h3) (many hp3) (erased le3) (many r) (erased rpk) (unique W w3)) $ tail $ apply xf callbacks _ k _ hp2 fv avs ms2 _ pf w2)
            (values h3 hp3 (hist-le-trans _ _ _ (hist-le-trans _ _ _ le1 le2) le3) r rpk w3))))
      ((CLet _ _ _ ids pk rhs rest)
        (let ((erased _) (many hp1) (erased le1) (many vs) (erased vpk) (unique W w1)) $ notail $ eval xf callbacks _ fuel _ hp _ _ rhs st _ pf w)
        (let ((erased lk)) (picked-lockstep _ _ _ _ _ pk vpk))
        (let ((erased _) (erased ps2)) (st-widen _ _ le1 _ st))
        (let ((erased h2) (many hp2) (erased le2) (many r) (erased rpk) (unique W w2)) $ tail $ eval xf callbacks _ fuel _ hp1 _ _ rest (st-push _ _ (coerce st ps2) ids vs lk) _ pf w1)
        (values h2 hp2 (hist-le-trans _ _ _ le1 le2) r rpk w2))
      ((CLetRec _ _ _ g rest)
        (let-match many st (MkSt _ _ env))
        (let-match many g (MkGroup _ ids _ _))
        (let ((erased _) (many hp1) (erased sf1) (many ga)) $ halloc _ hp $ BGroup _ _ _ g env)
        (let ((erased le1)) sf1)
        (let ((erased _) (erased pn1)) (frames-widen _ _ le1 _ env))
        (let ((erased h2) (many hp2) (erased le2) (many r) (erased rpk) (unique W w2)) $ tail $ eval xf callbacks _ fuel _ hp1 _ _ rest (MkSt _ _ (FrGroup _ _ ids ga g (coerce env pn1))) _ pf w)
        (values h2 hp2 (hist-le-trans _ _ _ le1 le2) r rpk w2))
      ((CMatch _ ns scrut shape branches dfl _)
        (let ((erased h1) (many hp1) (erased le1) (many svs) (erased spk) (unique W w1)) $ notail $ eval xf callbacks _ fuel _ hp _ _ scrut st _ pf w)
        (let ((many v)) $ vals-one _ svs spk)
        (let ((erased _) (erased ps3)) (st-widen _ _ le1 _ st))
        (let ((many st1)) (coerce st ps3))
        (let ((erased (Hist Block) h2) (many (Heap h2) hp2) (erased (Suffix Block h2 h1) le2) (many (Maybe $ Pair (Nat) $ List $ Ref Block h2) read) (unique W w2))
          (match many shape (((Hist Block) h2) ((Heap h2) hp2) ((Suffix Block h2 h1) le2) ((Maybe $ Pair (Nat) $ List $ Ref Block h2) read) (W w2 at w))
            ((ShKnown _ adt)
              (let ((erased h1k) (many hp1k) (erased le1k) (many r)) $ dispatch _ hp1 (adt-ext adt) (adt-tagged adt) v)
              (values h1k hp1k le1k r w1))
            ((ShNone _) (values h1 hp1 (le-refl h1) (None _) w1))
            ((ShHeld _ mcode held)
              (let ((erased h1b) (many hp1b) (erased le1b) (many mvs) (erased mpk) (unique W w1b)) $ notail $ eval xf callbacks _ fuel _ hp1 _ _ mcode st1 _ pf w1)
              (let ((many mref)) $ vals-one _ mvs mpk)
              (let ((erased _) (many mb) (erased _)) (hread _ hp1b mref))
              (let-match many mb (BMat _ a) (else (values h1b hp1b le1b (None _) w1b)))
              (let ((erased _) (erased pv4)) (ref-widen _ _ _ le1b v))
              (let ((erased h1c) (many hp1c) (erased le1c) (many r)) $ dispatch _ hp1b (adt-ext a) (adt-tagged held) (coerce v pv4))
              (values h1c hp1c (hist-le-trans _ _ _ le1b le1c) r w1b))))
        (let ((erased _) (erased ps4)) (st-widen _ _ le2 _ st1))
        (let ((many st2)) (coerce st1 ps4))
        (let ((erased _) (erased pv5)) (ref-widen _ _ _ le2 v))
        (let ((many v2)) (coerce v pv5))
        (let ((erased (Hist Block) h3) (many (Heap h3) hp3) (erased (Suffix Block h3 h2) le3) (many (List $ Ref Block h3) r) (erased (Picked (Ref Block h3) ns r) rpk) (unique W w3))
          (match many read (((Hist Block) h3) ((Heap h3) hp3) ((Suffix Block h3 h2) le3) ((List $ Ref Block h3) r) ((Picked (Ref Block h3) ns r) rpk) (W w3 at w))
            ((Some _ p)
              (let-match many p (MkPair _ _ i fields))
              (let-match many (has-branch _ _ branches i) (BFalse)
                ((BTrue) (tail $ eval-branch xf callbacks _ fuel _ hp2 _ ns branches i fields st2 _ pf w2)))
              (match many dfl _ ((Some _ d) (tail $ eval xf callbacks _ fuel _ hp2 _ _ d (st-push _ _ st2 (Nil _) (Nil _) (LsNil _ _)) _ pf w2)) ((None _) (tail $ eval-branch xf callbacks _ fuel _ hp2 _ ns branches i fields st2 _ pf w2))))
            ((None _)
              (let-match many branches (Cons _ br _)
                ((Nil _) (match many dfl _ ((Some _ d) (tail $ eval xf callbacks _ fuel _ hp2 _ _ d (st-push _ _ st2 (Nil _) (Nil _) (LsNil _ _)) _ pf w2)) ((None _) (error-w _ hp2 ns "no branch" _ w2)))))
              (let-match many br (MkBranch _ _ _ ids body))
              (let ((erased _) (many hp2b) (erased le2b) (many fs) (erased lk)) $ fit-addrs _ hp2 ids $ ctor-fields _ hp2
                (match many shape (((Bool) _)) ((ShKnown _ adt) (adt-newtype adt)) ((ShHeld _ _ adt) (adt-newtype adt)) ((ShNone _) (BTrue)))
                (list-length _ ids) v2)
              (let ((erased _) (erased ps5)) (st-widen _ _ le2b _ st2))
              (let ((erased h2c) (many hp2c) (erased le2c) (many r) (erased rpk) (unique W w2c)) $ tail $ eval xf callbacks _ fuel _ hp2b _ _ body (st-push _ _ (coerce st2 ps5) ids fs lk) _ pf w2)
              (values h2c hp2c (hist-le-trans _ _ _ le2b le2c) r rpk w2c))))
        (values h3 hp3 (hist-le-trans _ _ _ (hist-le-trans _ _ _ le1 le2) le3) r rpk w3))
      ((CCellAlloc _ ctor slots)
        (let ((erased _) (many hp1) (erased le1) (many fs) (unique W w1)) (notail $ eval-list xf callbacks _ fuel _ hp _ slots st _ pf w))
        (let ((erased h2) (many hp2) (erased le2) (many v)) (halloc _ hp1 (BTag _ ctor fs)))
        (values h2 hp2 (hist-le-trans _ _ _ le1 le2) (Cons _ v (Nil _)) (PkMany _ _ v (Nil _) (PkNil _)) w1))
      ((CCellWrite _ _ cell slots)
        (let ((erased _) (many hp1) (erased le1) (many cvs) (erased cpk) (unique W w1)) (notail $ eval xf callbacks _ fuel _ hp _ _ cell st _ pf w))
        (let ((many cv)) (vals-one _ cvs cpk))
        (let ((erased _) (erased pst)) (st-widen _ _ le1 _ st))
        (let ((erased h2) (many hp2) (erased le2) (many indices) (many vals) (unique W w2))
          (notail $ eval-updates xf callbacks _ fuel _ hp1 _ slots (coerce st pst) _ pf w1))
        (let ((erased _) (erased pcv)) (ref-widen _ _ _ le2 cv))
        (let ((many target)) (coerce cv pcv))
        (let ((erased _) (many body) (erased sf)) (hread _ hp2 target))
        (let ((erased (Hist Block) h3) (many (Heap h3) hp3) (erased (Suffix Block h3 h2) le3)
            (many (List $ Ref Block h3) vs) (erased (Picked (Ref Block h3) many-one vs) pk))
          (match many body _
            ((BTag _ ctor fields)
              (let ((erased _) (erased pf2)) (refs-widen _ _ _ sf fields))
              (let ((many hp3)) (hwrite _ hp2 target (BTag _ ctor (replace-fields _ (coerce fields pf2) indices vals))))
              (values h2 hp3 (le-refl h2) (Cons _ target (Nil _)) (PkMany _ _ target (Nil _) (PkNil _))))
            ((BToken _) (values h2 hp2 (le-refl h2) (Cons _ target (Nil _)) (PkMany _ _ target (Nil _) (PkNil _))))
            (else (error-vals _ hp2 many-one "not a cell"))))
        (values h3 hp3 (hist-le-trans _ _ _ (hist-le-trans _ _ _ le1 le2) le3) vs pk w2))
      ; a copy of the block with the writes applied (section 37), the old block untouched
      ((CCellCopy _ _ cell slots)
        (let ((erased _) (many hp1) (erased le1) (many cvs) (erased cpk) (unique W w1)) (notail $ eval xf callbacks _ fuel _ hp _ _ cell st _ pf w))
        (let ((many cv)) (vals-one _ cvs cpk))
        (let ((erased _) (erased pst)) (st-widen _ _ le1 _ st))
        (let ((erased h2) (many hp2) (erased le2) (many indices) (many vals) (unique W w2))
          (notail $ eval-updates xf callbacks _ fuel _ hp1 _ slots (coerce st pst) _ pf w1))
        (let ((erased _) (erased pcv)) (ref-widen _ _ _ le2 cv))
        (let ((erased _) (many body) (erased sf)) (hread _ hp2 (coerce cv pcv)))
        (let ((erased (Hist Block) h3) (many (Heap h3) hp3) (erased (Suffix Block h3 h2) le3)
            (many (List $ Ref Block h3) vs) (erased (Picked (Ref Block h3) many-one vs) pk))
          (match many body _
            ((BTag _ ctor fields)
              (let ((erased _) (erased pf2)) (refs-widen _ _ _ sf fields))
              (let ((erased h3) (many hp3) (erased le3) (many v)) (halloc _ hp2 (BTag _ ctor (replace-fields _ (coerce fields pf2) indices vals))))
              (values h3 hp3 le3 (Cons _ v (Nil _)) (PkMany _ _ v (Nil _) (PkNil _))))
            ((BToken _) (let ((many v)) (coerce cv pcv)) (values h2 hp2 (le-refl h2) (Cons _ v (Nil _)) (PkMany _ _ v (Nil _) (PkNil _))))
            (else (error-vals _ hp2 many-one "not a cell"))))
        (values h3 hp3 (hist-le-trans _ _ _ (hist-le-trans _ _ _ le1 le2) le3) vs pk w2))
      ((CCellRead _ _ index cell)
        (let ((erased h1) (many hp1) (erased le1) (many cvs) (erased cpk) (unique W w1)) (notail $ eval xf callbacks _ fuel _ hp _ _ cell st _ pf w))
        (let ((many cv)) (vals-one _ cvs cpk))
        (let ((erased _) (many body) (erased sf)) (hread _ hp1 cv))
        (let ((erased (Hist Block) h2) (many (Heap h2) hp2) (erased (Suffix Block h2 h1) le2)
            (many (List $ Ref Block h2) vs) (erased (Picked (Ref Block h2) many-one vs) pk))
          (match many body _
            ((BTag _ _ fields)
              (let-match many (list-nth _ fields index) (NthHit _ _ _ v _)
                ((NthMiss _ _ _ _) (error-vals _ hp1 many-one "cell field out of range")))
              (let ((erased _) (erased pv)) (ref-widen _ _ _ sf v))
              (let ((many out)) (coerce v pv))
              (values h1 hp1 (le-refl h1) (Cons _ out (Nil _)) (PkMany _ _ out (Nil _) (PkNil _))))
            (else (error-vals _ hp1 many-one "not a cell"))))
        (values h2 hp2 (hist-le-trans _ _ _ le1 le2) vs pk w1))
      ((CWorldDo _ req)
        (let ((erased h1) (many hp1) (erased le1) (many rvs) (erased rpk) (unique W w1)) (notail $ eval xf callbacks _ fuel _ hp _ _ req st _ pf w))
        (let ((erased h2) (many hp2) (erased le2) (many v) (unique W w2))
          (match many pf (((Hist Block) h2) ((Heap h2) hp2) ((Suffix Block h2 h1) le2) ((Ref Block h2) v) (W w2 at w1))
            ((MkPerformer _ _ _ perform _) (perform _ hp1 (vals-one _ rvs rpk) w1))
            ((MkMacroPerformer _ _ _ perform _) (perform _ hp1 (vals-one _ rvs rpk) w1))))
        (values h2 hp2 (hist-le-trans _ _ _ le1 le2) (Cons _ v (Nil _)) (PkMany _ _ v (Nil _) (PkNil _)) w2))
      ((CPrim _ ms2 p args)
        (let ((erased h1) (many hp1) (erased le1) (many avs) (unique W w1)) (notail $ eval-list xf callbacks _ fuel _ hp _ args st _ pf w))
        (let ((erased _) (many hp2) (erased le2) (many vs) (unique W w2))
          (match many (or (sp-eq p $ SpExpr $ ExSettledType) $ or (sp-eq p $ SpExpr $ ExSettledErase) $ or (sp-eq p $ SpExpr $ ExSettledValue) $ sp-eq p $ SpExpr $ ExSettledMult) (((Hist Block) h2) ((Heap h2) hp2) ((Suffix Block h2 h1) le2) ((List $ Ref Block h2) vs) (W w2 at w1))
            ((BTrue)
              (let ((erased hc) (many hpc) (erased lec) (many v)) $ settled-prim _ hp1 p avs)
              (values hc hpc lec (Cons _ v $ Nil _) w1))
            ((BFalse)
              (let-match many (sp-eq p $ SpExpr $ ExSlotEq) (BTrue)
                ((BFalse)
                  (let-match many pf (MkMacroPerformer s x k _ prim) ((MkPerformer _ _ _ _ prim) (prim _ hp1 p avs w1)))
                  (let-match many (or (sp-eq p $ SpExpr $ ExSettledTyApply) $ sp-eq p $ SpExpr $ ExSettledValApply) (BTrue) ((BFalse) (prim _ hp1 p avs w1)))
                  (let ((erased h3) (many hp3) (erased le3) (many v) (unique (MacroState s) w3)) $ notail $ apply-answer x k _ s _ hp1 (sp-eq p $ SpExpr $ ExSettledTyApply) avs w1)
                  (values h3 hp3 le3 (Cons _ v $ Nil _) w3)))
              (let-match many (slot-eq-answer _ avs) (Some _ v)
                ((None _)
                  (let ((erased hc) (many hpc) (erased lec) (many e)) $ halloc _ hp1 $ BError _ "`slot-eq` with no constructors")
                  (values hc hpc lec (Cons _ e $ Nil _) w1)))
              (values h1 hp1 (le-refl h1) (Cons _ v $ Nil _) w1))))
        (let ((erased h3) (many hp3) (erased le3) (many r) (erased rpk)) $ vals-fit _ hp2 ms2 vs)
        (values h3 hp3 (hist-le-trans _ _ _ le1 $ hist-le-trans _ _ _ le2 le3) r rpk w2))
      ((CAbsurd _ ms2) (error-w _ hp ms2 "absurd code reached" _ w))
      ((CError _ ms2 m) (error-w _ hp ms2 m _ w))))

  ((many eval-list : (subterm erased (Nat) xf) (subterm erased (Nat) callbacks) (subterm erased hop-0 is _) (subterm many (Nat) fuel) (erased (Hist Block) hs) (many (Heap hs) hp) (erased (List $ List $ Nat) ctx) (subterm many (List $ Code ctx many-one) cs) (many (St hs ctx) st) (erased Type W) (many (Performer W xf callbacks) pf) (unique W w) ->
      (erased (Hist Block) hs2) (many (Heap hs2) hp2) (erased (Suffix Block hs2 hs) le) (many (List $ Ref Block hs2) vs) (unique W w2 at w))
    (let-match many cs (Cons _ c rest) ((Nil _) (values hs hp (le-refl hs) (Nil _) w)))
    (let ((erased _) (many hp1) (erased le1) (many vs1) (erased pk1) (unique W w1)) $ notail $ eval xf callbacks _ fuel _ hp _ _ c st _ pf w)
    (let ((many vo1)) $ vals-one _ vs1 pk1)
    (let ((erased _) (erased ps6)) (st-widen _ _ le1 _ st))
