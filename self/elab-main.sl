  ; An expression of the given size and erasures (sections 14, 27); [tele] is the telescope a bare _ reuses.
  ((many elab-expr-demand : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (Syn) raw) (many (Env) env-in) (many (List $ List $ Nat) ctx) (many (List $ Multiplicity) expect) (many (Maybe $ List $ Entry) tele) (many (CC) cc) (many (ExprDemand expect) demand) -> (unique (ElabWorld) ewr at ew)
