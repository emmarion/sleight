        ((BTrue)
          (let ((unique ew2) (many envb2)) $ notail $ elab-refute ew fuel callbacks _ sugar (subterm pb) body body (WHere _) (Nil _) envr bctx)
          (values ew2 envb2 $ CAbsurd _ rms))
        ((BFalse)
