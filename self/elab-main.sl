  ((many define-adts : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) adts) (subterm many (AdtHeaders adts) headers) (many (Env) env) (many (Tids adts headers) tids) -> (unique (ElabWorld) ewr at ew) (many (Env) r) (many (List $ Pair (Nat) $ Block (Ref Block (HEmpty Block))) consts))
