    (let ((erased _) (many fb) (erased flt)) (hread _ hp f))
    (match many fb _
      ((BFn _ ga i _)
        (let ((erased _) (erased pg1)) (ref-widen _ _ _ flt ga))
        (let ((many g)) (coerce ga pg1))
        (let ((erased _) (many gb) (erased glt)) (hread _ hp g))
        (let-match many gb (BGroup _ _ _ group cenv) (else (error-w _ hp ms "not a group" _ w)))
        (let-match many group (MkGroup _ ids fns _))
        (let-match many (list-nth _ fns i) (NthHit _ _ _ p _) ((NthMiss _ _ _ _) (error-w _ hp ms "no such member" _ w)))
        (let-match many p (MkPair _ _ _ fn))
        (let-match many fn (MkFunc _ _ rets _ _ params body impl _)
          ((MkAlias _ _ _ _ _) (error-w _ hp ms "internal: an alias applied" _ w)))
        (match many impl _
          ((Some _ im)
            (let-match many im (MkImpl se ecs))
            (let-match many se (MkSomeExtern _ e))
            (let ((erased _) (many hp1) (erased le1) (many r)) $ apply-extern _ e ecs _ hp args)
            (let ((erased h2) (many hp2) (erased le2) (many r2) (erased pk2)) $ vals-fit _ hp1 ms r)
            (values h2 hp2 (hist-le-trans _ _ _ le1 le2) r2 pk2 w))
          ((None _)
            (let-match many fuel (Succ k) ((Zero) (error-w _ hp ms "out of fuel" _ w)))
            (let ((erased _) (many hp2) (erased le2) (many vs) (erased lkp)) $ fit-addrs _ hp params args)
            (let ((erased _) (erased pg2)) (ref-widen _ _ _ le2 g))
            (let ((erased _) (erased pn2)) (frames-widen _ _ (hist-le-trans _ _ _ glt le2) _ cenv))
            (let ((many env)) $ FrVals _ _ params vs lkp $ FrGroup _ _ ids (coerce g pg2) group (coerce cenv pn2))
            (match many (mults-same rets ms) _
              ((None _)
                (let ((erased h3) (many hp3) (erased le3) (many r) (erased rpk)) $ error-vals _ hp2 ms "arity mismatch")
                (values h3 hp3 (hist-le-trans _ _ _ le2 le3) r rpk w))
              ((Some _ same)
                (let ((erased h3) (many hp3) (erased le3) (many r) (erased rpk) (unique W w3)) $ tail $ eval xf callbacks _ k _ hp2 _ _ body (MkSt _ _ env) _ pf w)
                (values h3 hp3 (hist-le-trans _ _ _ le2 le3) r (picked-same _ rets ms r same rpk) w3))))))
      ((BCtorFn _ c)
        (let ((erased _) (many hp2) (erased le2) (many v)) $ construct _ hp c args)
        (let ((erased h3) (many hp3) (erased le3) (many r) (erased rpk)) $ vals-fit _ hp2 ms $ Cons _ v $ Nil _)
        (values h3 hp3 (hist-le-trans _ _ _ le2 le3) r rpk w))
