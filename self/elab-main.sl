        (values ew1 (check env2 "type" ty sharing-term) t))))

  ((many elab-coercible-proof : (unique (ElabWorld) ew) (subterm many (Nat) fuel) (subterm erased (Nat) callbacks) (subterm erased hop-8 is _) (subterm many (Nat) sugar) (subterm many (List $ Syn) args) (many (Env) env) (many (List $ List $ Nat) ctx) (many (Nat) ctor) (many (Maybe $ Pair (Term) $ Term) sides) -> (unique (ElabWorld) ewr at ew) (many (Env) e) (many (Res) r))
