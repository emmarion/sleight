(def-fns _ $ (many escape-letter : (many (Char) c) -> (many (Maybe $ Char) e))
  (let-match many (char-eq c #\") (Unequal _ _ _ _ _) ((Equal _ _ _) (Some _ #\")))
  (let-match many (char-eq c #\\) (Unequal _ _ _ _ _) ((Equal _ _ _) (Some _ #\\)))
  (let-match many (char-eq c #\newline) (Unequal _ _ _ _ _) ((Equal _ _ _) (Some _ #\n)))
  (match many (char-eq c #\tab) _ ((Equal _ _ _) (Some _ #\t)) ((Unequal _ _ _ _ _) (None _))))

(def-fns _ $ (many escape-width : (many (Char) c) -> (many (Char) w))
  (let-match many (escape-letter c) (None _) ((Some _ _) #\x02))
  (match many (char-between c #\space #\~) _ ((BTrue) #\x01) ((BFalse) #\x04)))

(def-fns _ $ (many escape-byte : (many (Nat) k) (erased (Lt k u8-modulus) q) (many (Nat) w) (many (Nat) d) -> (many (Char) c))
  (let-match many (nat-eq w 1) (Unequal _ _ _ _ _) ((Equal _ _ _) (MkChar $ MkU8 k q)))
  (let-match many d (Succ d1) ((Zero) #\\))
  (let-match many d1 (Succ d2) ((Zero) (match many (escape-letter $ MkChar $ MkU8 k q) _ ((Some _ e) e) ((None _) #\x))))
  (let ((many hi) (many lo)) (hex-chars k q))
  (match many d2 _ ((Zero) hi) ((Succ _) lo)))

(def-fns _ $ (erased add-shift : (erased (Nat) a b c) (subterm erased (Add a (Succ b) c) p) -> (erased (Add (Succ a) b c) q))
  (match erased p _
    ((AddZero _) (AddSucc (Zero) b b (AddZero b)))
    ((AddSucc a1 _ c1 p1) (AddSucc (Succ a1) b c1 (add-shift a1 b c1 p1)))))

(def-fns _ $ (many width-rope : (subterm many (Nat) k) (erased (Lt k (Succ u8-modulus)) p) (many (Rope) acc) -> (many (Rope) r))
  (let-match many k (Succ k1) ((Zero) acc))
  (let-match erased p (LtS _ _ q))
  (tail $ width-rope k1 (lt-weaken _ _ q) $ RCat (RChar $ escape-width $ MkChar $ MkU8 k1 q) acc))

(let ((many escape-widths)) (rope-str $ width-rope u8-modulus (lt-succ u8-modulus) $ REmpty))
(let ((many widths-len) (erased widths-sl)) (str-length escape-widths))
(comptime-match many (nat-eq widths-len u8-modulus) (Equal _ _ _))

(def-adts $ (EscW : ((Nat) k) ((Nat) w) -> Type)
  enum
  (many MkEscW : (erased (Nat) k) (erased (Nat) w) (erased (Lt w u8-modulus) q) (erased (String) a) (erased (String) b)
     (erased (Append a (SCons (MkChar (MkU8 w q)) b) escape-widths) p) (erased (StrLength a k) la) -> (EscW k w)))

(def-fns _ $ (many esc-width-of : (many (Nat) k) (erased (Lt k u8-modulus) q) -> (many (Nat) w) (erased (EscW k w) e))
  (let ((many c) (erased a) (erased b) (erased p) (erased la)) (str-get escape-widths k u8-modulus widths-sl q))
  (let-match many c (MkChar u))
  (let-match many u (MkU8 w lt))
  (values w (MkEscW k w lt a b p la)))

(def-fns _ $ (erased esc-w-fn : (erased (Nat) k v w) (erased (EscW k v) e) (erased (EscW k w) f) -> (erased (Eq (Nat) v w) r))
  (let-match erased e (MkEscW _ _ _ a _ p la))
  (let-match erased f (MkEscW _ _ _ a2 _ p2 la2))
  (let-match erased (append-unique a a2 _ _ escape-widths k p la p2 la2) (Refl _ _))
  (Refl _ v))

(def-adts $ (EscWidth : ((String) t) ((Nat) n) -> Type)
  enum
  (many EWNil : -> (EscWidth (SNil) (Zero)))
  (many EWCons : (erased (Nat) k) (erased (Lt k u8-modulus) q) (erased (String) t) (erased (Nat) w) (erased (Nat) r) (erased (Nat) n)
     (erased (EscW k w) e) (erased (EscWidth t r) rest) (erased (Add w r n) ad)
     -> (EscWidth (SCons (MkChar (MkU8 k q)) t) n)))

(def-fns _ $ (many escaped-width : (many (String) s) (erased (Nat) len) (erased (StrLength s len) ls)
    (subterm many (Nat) i) (erased (String) a t) (erased (Append a t s) p) (erased (StrLength a i) la)
    (many (Nat) acc) (erased (EscWidth t acc) e) ->
    (many (Nat) n) (erased (EscWidth s n) f))
  (let-match many i (Succ i1)
    ((Zero) (let-match erased la (SLenNil)) (let-match erased p (AppNil _)) (values acc e)))
  (let-match erased (prefix-lt a t s i len p la ls) (LtS _ _ lt))
  (let ((many c) (erased a2) (erased b) (erased p2) (erased la2)) (str-get s i1 len ls lt))
  (let ((erased a3) (erased p3) (erased la3)) (append-snoc a2 b s c i1 p2 la2))
  (let-match erased (append-unique a3 a b t s i p3 la3 p la) (Refl _ _))
  (let-match many c (MkChar u))
  (let-match many u (MkU8 k q))
  (let ((many w) (erased ew)) (esc-width-of k q))
  (let ((many acc2) (erased ad)) (add w acc))
  (tail $ escaped-width s len ls i1 a2 (SCons c b) p2 la2 acc2 (EWCons k q b w acc acc2 ew e ad)))

(def-fns _ $ (many bytes-write : (erased (List (U8)) xs) (erased (Nat) n) (erased (Length (U8) xs n) l) (unique (Bytes xs) b)
    (many (Nat) i) (erased (Lt i n) lt) (many (Char) c) ->
    (erased (List (U8)) ys) (erased (Length (U8) ys n) l2) (unique (Bytes ys) r at b))
  (let ((erased x) (erased nth)) (nth-exists _ xs n i l lt))
  (let-match many c (MkChar u))
  (let ((erased ys) (unique b2) (erased sp)) (bytes-set _ b i u x nth))
  (values ys (setnth-length _ xs i n u ys sp l) b2))

(def-fns _ $ (many put-bytes : (many (Nat) k) (erased (Lt k u8-modulus) q) (many (Nat) w) (subterm many (Nat) left) (many (Nat) d)
    (erased (Nat) rest rr m) (erased (Add left rest rr) al)
    (erased (List (U8)) xs) (erased (Length (U8) xs (Succ m)) l) (unique (Bytes xs) b) (many (Nat) j) (erased (Add j rr m) aj) ->
    (erased (List (U8)) ys) (erased (Length (U8) ys (Succ m)) l2) (unique (Bytes ys) r at b) (many (Nat) j2) (erased (Add j2 rest m) aj2))
  (let-match many left (Succ left1) ((Zero) (let-match erased al (AddZero _)) (values xs l b j aj)))
  (let-match erased al (AddSucc _ _ rr1 al1))
  (let ((erased ys) (erased l2) (unique b2)) (bytes-write xs (Succ m) l b j (add-le-left j rr m aj) (escape-byte k q w d)))
  (tail $ put-bytes k q w left1 (Succ d) rest rr1 m al1 ys l2 b2 (Succ j) (add-shift j rr1 m aj)))

(def-fns _ $ (many escape-into : (many (String) s) (erased (Nat) len) (erased (StrLength s len) ls)
    (subterm many (Nat) left) (many (Nat) i) (erased (String) a t) (erased (Append a t s) p) (erased (StrLength a i) la)
    (erased (StrLength t left) lst) (erased (Nat) rr m) (erased (EscWidth t rr) e)
    (erased (List (U8)) xs) (erased (Length (U8) xs (Succ m)) l) (unique (Bytes xs) b) (many (Nat) j) (erased (Add j rr m) aj) ->
    (erased (List (U8)) ys) (unique (Bytes ys) r at b))
  (let-match many left (Succ left1) ((Zero) (values xs b)))
  (let-match erased lst (SLenCons c0 t1 _ lst1))
  (let ((erased a2) (erased p2) (erased la2)) (append-snoc a t1 s c0 i p la))
  (let-match erased (prefix-lt a2 t1 s (Succ i) len p2 la2 ls) (LtS _ _ lt))
  (let ((many c) (erased a3) (erased b3) (erased p3) (erased la3)) (str-get s i len ls lt))
  (let-match erased (append-unique a3 a (SCons c b3) t s i p3 la3 p la) (Refl _ _))
  (let-match erased e (EWCons k _ _ w rest _ ew e1 ad))
  (let-match many c (MkChar u))
  (let-match many u (MkU8 k2 q2))
  (let ((many w2) (erased ew2)) (esc-width-of k2 q2))
  (let-match erased (esc-w-fn k w w2 ew ew2) (Refl _ _))
  (let ((erased ys) (erased l2) (unique b2) (many j2) (erased aj2)) (put-bytes k2 q2 w2 w2 0 rest rr m ad xs l b j aj))
  (tail $ escape-into s len ls left1 (Succ i) a2 t1 p2 la2 lst1 rest m e1 ys l2 b2 j2 aj2))

(def-fns _ $ (many lit-string : (many (String) s) -> (many (String) r))
  (let ((many len) (erased ls)) (str-length s))
  (let ((many total) (erased e)) (escaped-width s len ls len s (SNil) (append-nil-right s) ls (Zero) (EWNil)))
  (let ((many n)) (Succ (Succ total)))
  (let-match many #\" (MkChar quote))
  (let ((erased xs) (unique b) (erased rp)) (bytes-make n quote))
  (let ((erased _) (unique b2))
    (escape-into s len ls len (Zero) (SNil) s (AppNil s) (SLenNil) ls total (Succ total) e
      xs (repeat-length _ n quote xs rp) b (Succ (Zero)) (AddSucc (Zero) total total (AddZero total))))
  (let ((many c)) (share b2))
  (let ((many r) (erased _)) (bytes-str _ c))
  r)

(def-fns _ $ (many escape-ok : (many (Char) e) -> (many (Bool) r))
  (or (char-eqb e #\n) $ or (char-eqb e #\t) $ or (char-eqb e #\") $ char-eqb e #\\))

(def-fns _ $ (many unescape : (many (Char) e) -> (many (Char) c))
  (let-match many (char-eq e #\n) (Unequal _ _ _ _ _) ((Equal _ _ _) #\newline))
  (match many (char-eq e #\t) _ ((Equal _ _ _) #\tab) ((Unequal _ _ _ _ _) e)))

(def-fns _ $ (erased add-lt : (erased (Nat) a b c) (erased (Add a (Succ b) c) p) -> (erased (Lt a c) q))
  (let-match erased (add-le-left (Succ a) b c (add-shift a b c p)) (LtS _ _ q))
  q)

(def-adts $ (EscState : -> Type)
  enum
  (many EsNorm : -> (EscState))
  (many EsEsc : -> (EscState))
  (many EsHex0 : -> (EscState))
  (many EsHex1 : -> (EscState)))

(def-adts $ (EscStep : ((EscState) st) ((Char) c) ((EscState) st2) ((Nat) j) ((Nat) j2) -> Type)
  enum
  (many StNormBs : (erased (Nat) j) -> (EscStep (EsNorm) #\\ (EsEsc) j j))
  (many StNormChar : (erased (Char) c) (erased (Apart (Char) CharLt c #\\) d) (erased (Nat) j) -> (EscStep (EsNorm) c (EsNorm) j (Succ j)))
  (many StEscX : (erased (Nat) j) -> (EscStep (EsEsc) #\x (EsHex0) j j))
  (many StEscLetter : (erased (Char) c) (erased (Apart (Char) CharLt c #\x) d) (erased (Nat) j) -> (EscStep (EsEsc) c (EsNorm) j (Succ j)))
  (many StHex0 : (erased (Char) c) (erased (Nat) j) -> (EscStep (EsHex0) c (EsHex1) j j))
  (many StHex1 : (erased (Char) c) (erased (Nat) j) -> (EscStep (EsHex1) c (EsNorm) j (Succ j))))

; EscRun s i st j: the first i characters of s, read from EsNorm, leave the state st and decode to j bytes.
(def-adts $ (EscRun : ((String) s) ((Nat) i) ((EscState) st) ((Nat) j) -> Type)
  enum
  (many ERStart : (erased (String) s) -> (EscRun s (Zero) (EsNorm) (Zero)))
  (many ERStep : (erased (String) s) (erased (Nat) i) (erased (EscState) st) (erased (Nat) j) (erased (EscRun s i st j) run)
     (erased (Char) c) (erased (String) a) (erased (String) b) (erased (Append a (SCons c b) s) p) (erased (StrLength a i) la)
     (erased (EscState) st2) (erased (Nat) j2) (erased (EscStep st c st2 j j2) e) -> (EscRun s (Succ i) st2 j2)))

(def-fns _ $ (erased absurd char-apart-irrefl : (erased (Char) a) (erased (Apart (Char) CharLt a a) d) -> (erased (False) f))
  (match erased d _
    (absurd (ApLt _ _ _ _ p) (let-match erased p (MkCharLt m _ _ _ q)) (lt-asym m m q (lt-weaken m m q)))
    (absurd (ApGt _ _ _ _ p) (let-match erased p (MkCharLt m _ _ _ q)) (lt-asym m m q (lt-weaken m m q)))))

(def-fns _ $ (erased esc-step-fn : (erased (EscState) st st2 st3) (erased (Char) c) (erased (Nat) j j2 j3)
    (erased (EscStep st c st2 j j2) p) (erased (EscStep st c st3 j j3) q) -> (erased (Eq (EscState) st2 st3) e) (erased (Eq (Nat) j2 j3) f))
  (match erased p _
    ((StNormBs _) (match erased q _ ((StNormBs _) (values (Refl _ st2) (Refl _ j2))) (absurd (StNormChar _ d _) (char-apart-irrefl _ d))))
    ((StNormChar _ d _) (match erased q _ ((StNormChar _ _ _) (values (Refl _ st2) (Refl _ j2))) (absurd (StNormBs _) (char-apart-irrefl _ d))))
    ((StEscX _) (match erased q _ ((StEscX _) (values (Refl _ st2) (Refl _ j2))) (absurd (StEscLetter _ d _) (char-apart-irrefl _ d))))
    ((StEscLetter _ d _) (match erased q _ ((StEscLetter _ _ _) (values (Refl _ st2) (Refl _ j2))) (absurd (StEscX _) (char-apart-irrefl _ d))))
    ((StHex0 _ _) (let-match erased q (StHex0 _ _)) (values (Refl _ st2) (Refl _ j2)))
    ((StHex1 _ _) (let-match erased q (StHex1 _ _)) (values (Refl _ st2) (Refl _ j2)))))

(def-fns _ $ (erased esc-step-le : (erased (EscState) st st2) (erased (Char) c) (erased (Nat) j j2)
    (erased (EscStep st c st2 j j2) p) -> (erased (Lt j (Succ j2)) q))
  (match erased p _
    ((StNormBs _) (lt-succ j))
    ((StNormChar _ _ _) (lt-weaken j (Succ j) (lt-succ j)))
    ((StEscX _) (lt-succ j))
    ((StEscLetter _ _ _) (lt-weaken j (Succ j) (lt-succ j)))
    ((StHex0 _ _) (lt-succ j))
    ((StHex1 _ _) (lt-weaken j (Succ j) (lt-succ j)))))

(def-fns _ $ (erased esc-run-fn : (erased (String) s) (erased (Nat) i) (erased (EscState) st st2) (erased (Nat) j j2)
    (subterm erased (EscRun s i st j) p) (erased (EscRun s i st2 j2) q) -> (erased (Eq (EscState) st st2) e) (erased (Eq (Nat) j j2) f))
  (let-match erased p (ERStep _ i0 st0 j0 p0 c a b ap la _ _ e0)
    ((ERStart _) (let-match erased q (ERStart _)) (values (Refl _ st) (Refl _ j))))
  (let-match erased q (ERStep _ _ st1 j1 q0 c1 a1 b1 ap1 la1 _ _ e1))
  (let ((erased es) (erased ej)) (esc-run-fn s i0 st0 st1 j0 j1 p0 q0))
  (let-match erased es (Refl _ _))
  (let-match erased ej (Refl _ _))
  (let-match erased (append-unique a a1 (SCons c b) (SCons c1 b1) s i0 ap la ap1 la1) (Refl _ _))
  (esc-step-fn st0 st st2 c j0 j j2 e0 e1))

(def-fns _ $ (erased esc-run-mono : (erased (String) s) (erased (Nat) i i2) (erased (EscState) st st2) (erased (Nat) j j2)
    (erased (EscRun s i st j) p) (subterm erased (EscRun s i2 st2 j2) q) (erased (Lt i (Succ i2)) le) -> (erased (Lt j (Succ j2)) r))
  (let-match erased q (ERStep _ i3 st3 j3 q0 _ _ _ _ _ _ _ e3)
    ((ERStart _)
      (let-match erased le (LtZ _) (absurd (LtS a _ l0) (lt-zero a l0)))
      (let-match erased p (ERStart _))
      (lt-succ j)))
  (let-match erased (nat-cmp i (Succ i3)) (CEq _ _ _)
    ((CLt _ _ _ _ lt) (le-trans j j3 j2 (esc-run-mono s i i3 st st3 j j3 p q0 lt) (esc-step-le st3 st2 _ j3 j2 e3)))
    (absurd (CGt _ _ _ _ gt) (lt-asym _ _ gt le)))
  (let ((erased _) (erased ej)) (esc-run-fn s i st st2 j j2 p q))
  (let-match erased ej (Refl _ _))
  (lt-succ j))

(def-adts $ (Scan : ((String) s) ((Nat) len) -> Type)
  enum
  (many ScanEnd : (erased (String) s) (erased (Nat) len) (many (Nat) e) (erased (Lt e len) lt) (many (Bool) esc)
     (many (Nat) d) (erased (EscState) st) (erased (EscRun s e st d) run) -> (Scan s len))
  (many ScanUnterminated : (erased (String) s) (erased (Nat) len) -> (Scan s len))
  (many ScanBad : (erased (String) s) (erased (Nat) len) (many (Nat) off) (many (Char) e) -> (Scan s len)))

(def-fns _ $ (many read-scan : (many (String) s) (erased (Nat) len) (erased (StrLength s len) ls)
    (many (Nat) i) (subterm many (Nat) left) (erased (Add i left len) sum) (many (EscState) st) (many (Nat) bs) (many (Bool) esc)
    (many (Nat) j) (erased (EscRun s i st j) run) ->
    (many (Scan s len) r))
  (let-match many left (Succ l1)
    ((Zero) (match many st _ ((EsNorm) (ScanUnterminated _ _)) ((EsEsc) (ScanUnterminated _ _)) (else (ScanBad _ _ bs #\x78)))))
  (let ((erased lt)) (add-lt i l1 len sum))
  (let ((many c) (erased a) (erased b) (erased p) (erased la)) (str-get s i len ls lt))
  (let ((erased sum2)) (add-shift i l1 len sum))
  (match many st _
    ((EsNorm)
      (let-match many (char-eq c #\") (Unequal _ _ _ _ _) ((Equal _ _ _) (ScanEnd _ _ i lt esc j _ run)))
      (let-match many (char-eq c #\\) (Unequal _ _ _ _ d)
        ((Equal _ _ _) (tail $ read-scan s len ls (Succ i) l1 sum2 (EsEsc) i (BTrue) j (ERStep _ _ _ _ run c a b p la _ _ $ StNormBs j))))
      (tail $ read-scan s len ls (Succ i) l1 sum2 (EsNorm) bs esc (Succ j) (ERStep _ _ _ _ run c a b p la _ _ $ StNormChar c d j)))
    ((EsEsc)
      (let-match many (char-eq c #\x) (Unequal _ _ _ _ d)
        ((Equal _ _ _) (tail $ read-scan s len ls (Succ i) l1 sum2 (EsHex0) bs esc j (ERStep _ _ _ _ run c a b p la _ _ $ StEscX j))))
      (let-match many (escape-ok c) (BTrue) ((BFalse) (ScanBad _ _ bs c)))
      (tail $ read-scan s len ls (Succ i) l1 sum2 (EsNorm) bs esc (Succ j) (ERStep _ _ _ _ run c a b p la _ _ $ StEscLetter c d j)))
    ((EsHex0)
      (let-match many (is-hex c) (BTrue) ((BFalse) (ScanBad _ _ bs #\x78)))
      (tail $ read-scan s len ls (Succ i) l1 sum2 (EsHex1) bs esc j (ERStep _ _ _ _ run c a b p la _ _ $ StHex0 c j)))
    ((EsHex1)
      (let-match many (is-hex c) (BTrue) ((BFalse) (ScanBad _ _ bs #\x78)))
      (tail $ read-scan s len ls (Succ i) l1 sum2 (EsNorm) bs esc (Succ j) (ERStep _ _ _ _ run c a b p la _ _ $ StHex1 c j)))))

(def-fns _ $ (erased run-room : (erased (String) s) (erased (Nat) i e) (erased (EscState) st ste) (erased (Nat) j d)
    (erased (EscRun s (Succ i) st (Succ j)) run) (erased (EscRun s e ste d) fin) (erased (Lt i e) lt) -> (erased (Lt j d) r))
  (lt-succ-inv j d $ esc-run-mono s (Succ i) e st ste (Succ j) d run fin $ LtS i e lt))

(def-fns _ $ (many unescape-into : (many (String) s) (erased (Nat) len) (erased (StrLength s len) ls)
    (erased (Nat) e) (erased (Lt e len) le) (erased (EscState) ste) (erased (Nat) d) (erased (EscRun s e ste d) fin)
    (many (Nat) i) (subterm many (Nat) left) (erased (Add i left e) sum) (many (EscState) st) (many (Nibble) hi)
    (erased (List (U8)) xs) (erased (Length (U8) xs d) l) (unique (Bytes xs) b) (many (Nat) j) (erased (EscRun s i st j) run) ->
    (erased (List (U8)) ys) (erased (Length (U8) ys d) l2) (unique (Bytes ys) r at b))
  (let-match many left (Succ l1) ((Zero) (values xs l b)))
  (let ((erased ie)) (add-lt i l1 e sum))
  (let ((many c) (erased a) (erased bb) (erased p) (erased la)) (str-get s i len ls $ lt-trans i e len ie le))
  (let ((erased sum2)) (add-shift i l1 e sum))
  (match many st _
    ((EsNorm)
      (let-match many (char-eq c #\\) (Unequal _ _ _ _ dc)
        ((Equal _ _ _) (tail $ unescape-into s len ls e le ste d fin (Succ i) l1 sum2 (EsEsc) hi xs l b j (ERStep _ _ _ _ run c a bb p la _ _ $ StNormBs j))))
      (let ((erased run2)) (ERStep _ _ _ _ run c a bb p la _ _ $ StNormChar c dc j))
      (let ((erased ys) (erased l2) (unique b2)) (bytes-write xs d l b j (run-room s i e _ ste j d run2 fin ie) c))
      (tail $ unescape-into s len ls e le ste d fin (Succ i) l1 sum2 (EsNorm) hi ys l2 b2 (Succ j) run2))
    ((EsEsc)
      (let-match many (char-eq c #\x) (Unequal _ _ _ _ dc)
        ((Equal _ _ _) (tail $ unescape-into s len ls e le ste d fin (Succ i) l1 sum2 (EsHex0) hi xs l b j (ERStep _ _ _ _ run c a bb p la _ _ $ StEscX j))))
      (let ((erased run2)) (ERStep _ _ _ _ run c a bb p la _ _ $ StEscLetter c dc j))
      (let ((erased ys) (erased l2) (unique b2)) (bytes-write xs d l b j (run-room s i e _ ste j d run2 fin ie) $ unescape c))
      (tail $ unescape-into s len ls e le ste d fin (Succ i) l1 sum2 (EsNorm) hi ys l2 b2 (Succ j) run2))
    ((EsHex0) (tail $ unescape-into s len ls e le ste d fin (Succ i) l1 sum2 (EsHex1) (hex-digit c) xs l b j (ERStep _ _ _ _ run c a bb p la _ _ $ StHex0 c j)))
    ((EsHex1)
      (let ((erased run2)) (ERStep _ _ _ _ run c a bb p la _ _ $ StHex1 c j))
      (let ((erased ys) (erased l2) (unique b2)) (bytes-write xs d l b j (run-room s i e _ ste j d run2 fin ie) $ byte-of-nibbles hi $ hex-digit c))
      (tail $ unescape-into s len ls e le ste d fin (Succ i) l1 sum2 (EsNorm) hi ys l2 b2 (Succ j) run2))))

(def-adts $ (Unescaped : -> Type)
  enum
  (many ReadOk : (many (String) body) (many (Nat) used) (many (String) rest) -> (Unescaped))
  (many ReadUnterminated : -> (Unescaped))
  (many ReadBadEscape : (many (Nat) off) (many (Char) e) -> (Unescaped))
  (many ReadNoQuote : -> (Unescaped)))

(def-fns _ $ (many read-string : (many (String) s) -> (many (Unescaped) r))
  (let-match many s (SCons q s1) ((SNil) (ReadNoQuote)))
  (let-match many (char-eqb q #\") (BTrue) ((BFalse) (ReadNoQuote)))
  (let ((many len) (erased ls)) (str-length s1))
  (let-match many (read-scan s1 len ls (Zero) len (AddZero len) (EsNorm) (Zero) (BFalse) (Zero) (ERStart s1)) (ScanEnd _ _ e lt esc d ste fin)
    ((ScanUnterminated _ _) (ReadUnterminated))
    ((ScanBad _ _ off c) (ReadBadEscape (Succ off) c)))
  (let ((many _) (many rest) (erased _) (erased _)) (str-split s1 (Succ e) len ls (LtS e len lt)))
  (let ((many used)) (Succ (Succ e)))
  (let-match many esc (BTrue)
    ((BFalse)
      (let ((many raw) (many _) (erased _) (erased _)) (str-split s1 e len ls (lt-weaken e len lt)))
      (ReadOk raw used rest)))
  (let-match many #\x00 (MkChar z))
  (let ((erased xs) (unique b) (erased rp)) (bytes-make d z))
  (let ((erased _) (erased _) (unique b2))
    (unescape-into s1 len ls e lt ste d fin (Zero) e (AddZero e) (EsNorm) (MkNibble (Zero) sixteen-positive) xs (repeat-length _ d z xs rp) b (Zero) (ERStart s1)))
  (let ((many c)) (share b2))
  (let ((many body) (erased _)) (bytes-str _ c))
  (ReadOk body used rest))

(def-fns _ $ (many spell-text : (many (String) s) -> (many (String) r))
  (match many (is-plain-name s) _ ((BTrue) s) ((BFalse) (rope-str $ rcat (RStr "#") $ RStr $ lit-string s))))

(def-fns _ $ (many shown-text : (many (Shown) s) -> (many (String) r))
  (match many s _
    ((ShText t) t)
    ((ShNat n) (nat-str n))
    ((ShChr c) (rope-str $ lit-char-rope c))
    ((ShStr t) (lit-string t))))

(def-fns _ $ (many spell-name : (many (Name) n) -> (many (String) r))
  (match many n _
    ((NSrc s) (spell-text s))
    ((NGen k s) (str-cat3 "__g" (nat-str k) $ str-cat "_" $ spell-text s))
    ((NHandle _ _ _ s) (shown-text s))))

(def-fns _ $ (many name-text : (many (Name) n) -> (many (String) r))
  (match many n _ ((NSrc s) s) (else (spell-name n))))
