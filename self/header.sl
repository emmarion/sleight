  $ RCat (RStr "type 'a array_model = ANil | ACons of 'a * 'a\n")
  $ RCat (RStr "type 'v list_model = Nil | Cons of 'v * 'v\n")
  $ RCat (RStr "\n")
  $ RCat (RStr "(* No host float is ever a value of the language, so no array is a flat float array, and an extracted template\n")
