  $ RCat (RStr "\n")
  $ RCat (RStr "(* What the driver builds and reads of the prelude, each a direct operation on the program's own values. *)\n")
  $ RCat (RStr "type 'v ops = {\n")
  $ RCat (RStr "  zero : 'v;\n")
  $ RCat (RStr "  succ : 'v -> 'v;\n")
  $ RCat (RStr "  pred : 'v -> 'v option;\n")
