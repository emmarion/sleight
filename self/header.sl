  $ RCat (RStr "\n")
  $ RCat (RStr "type 'v t = { of_string : string -> 'v; to_string : 'v -> string; run_io : world -> 'v -> int; run_main : world -> 'v -> unit }\n")
  $ RCat (RStr "\n")
  $ RCat (RStr "let read_file path = In_channel.with_open_bin path In_channel.input_all\n")
  $ RCat (RStr "let write_file path s = Out_channel.with_open_bin path (fun oc -> Out_channel.output_string oc s)\n")
  $ RCat (RStr "let append_file path s = Out_channel.with_open_gen [ Open_append; Open_creat; Open_wronly ] 0o666 path (fun oc -> Out_channel.output_string oc s)\n")
  $ RCat (RStr "let explain = function Unix.Unix_error (e, _, a) -> (if a = \"\" then \"\" else a ^ \": \") ^ Unix.error_message e | Sys_error m -> m | e -> Printexc.to_string e\n")
  $ RCat (RStr "let is_dir p = match (Unix.stat p).st_kind with Unix.S_DIR -> true | _ -> false | exception _ -> false\n")
  $ RCat (RStr "\n")
  $ RCat (RStr "let host_envs () =\n")
  $ RCat (RStr "  List.filter_map\n")
  $ RCat (RStr "    (fun s -> Option.map (fun i -> (String.sub s 0 i, String.sub s (i + 1) (String.length s - i - 1))) (String.index_opt s '='))\n")
  $ RCat (RStr "    (Array.to_list (Unix.environment ()))\n")
  $ RCat (RStr "\n")
  $ RCat (RStr "let make ?of_host ?to_host o =\n")
  $ RCat (RStr "  let rec nat v = match o.pred v with Some p -> 1 + nat p | None -> 0 in\n")
  $ RCat (RStr "  let u8 v = nat (o.un_u8 v) in\n")
  $ RCat (RStr "  let of_string s =\n")
  $ RCat (RStr "    match of_host with\n")
  $ RCat (RStr "    | Some f -> f s\n")
  $ RCat (RStr "    | None ->\n")
  $ RCat (RStr "        let rec nat n = if n = 0 then o.zero else o.succ (nat (n - 1)) in\n")
  $ RCat (RStr "        String.fold_right (fun ch acc -> o.scons (o.char (o.u8 (nat (Char.code ch)))) acc) s o.snil\n")
  $ RCat (RStr "  in\n")
  $ RCat (RStr "  let to_string v =\n")
  $ RCat (RStr "    match to_host with\n")
  $ RCat (RStr "    | Some f -> f v\n")
  $ RCat (RStr "    | None ->\n")
  $ RCat (RStr "        let buf = Buffer.create 64 in\n")
  $ RCat (RStr "        let rec go v = match o.un_str v with Some (ch, rest) -> Buffer.add_char buf (Char.chr (u8 (o.un_char ch))); go rest | None -> () in\n")
  $ RCat (RStr "        go v;\n")
  $ RCat (RStr "        Buffer.contents buf\n")
  $ RCat (RStr "  in\n")
  $ RCat (RStr "  let run_io w v =\n")
  $ RCat (RStr "    let result f = match f () with x -> o.ok x | exception ((Unix.Unix_error _ | Sys_error _) as e) -> o.fail (of_string (explain e)) in\n")
  $ RCat (RStr "    let list of_item xs = List.fold_right (fun x acc -> o.cons (of_item x) acc) xs o.nil in\n")
  $ RCat (RStr "    let change already f =\n")
  $ RCat (RStr "      match f () with\n")
  $ RCat (RStr "      | () -> o.ok o.changed\n")
  $ RCat (RStr "      | exception Unix.Unix_error (e, _, _) when already e -> o.ok o.unchanged\n")
  $ RCat (RStr "      | exception ((Unix.Unix_error _ | Sys_error _) as e) -> o.fail (of_string (explain e))\n")
  $ RCat (RStr "    in\n")
  $ RCat (RStr "    let rec loop v =\n")
  $ RCat (RStr "      match o.request v with\n")
  $ RCat (RStr "      | Exit code -> u8 code\n")
  $ RCat (RStr "      | Step k -> loop (o.apply0 k)\n")
  $ RCat (RStr "      | WriteOut (s, k) -> w.out (to_string s); loop (o.apply0 k)\n")
  $ RCat (RStr "      | WriteErr (s, k) -> w.err (to_string s); loop (o.apply0 k)\n")
  $ RCat (RStr "      | ReadLine k -> loop (o.apply k (match w.read_line () with Some l -> o.some (of_string l) | None -> o.none))\n")
  $ RCat (RStr "      | ReadFile (path, k) -> loop (o.apply k (result (fun () -> of_string (read_file (to_string path)))))\n")
  $ RCat (RStr "      | WriteFile (path, s, k) -> loop (o.apply k (result (fun () -> write_file (to_string path) (to_string s); o.unit)))\n")
  $ RCat (RStr "      | GetArgs k -> loop (o.apply k (list of_string w.args))\n")
  $ RCat (RStr "      | GetEnv (name, k) -> loop (o.apply k (match w.env (to_string name) with Some v -> o.some (of_string v) | None -> o.none))\n")
  $ RCat (RStr "      | GetEnvs k -> loop (o.apply k (list (fun (n, v) -> o.pair (of_string n) (of_string v)) (List.sort compare (w.envs ()))))\n")
  $ RCat (RStr "      | AppendFile (path, s, k) -> loop (o.apply k (result (fun () -> append_file (to_string path) (to_string s); o.unit)))\n")
  $ RCat (RStr "      | ReadRemaining k -> loop (o.apply k (of_string (w.read_rest ())))\n")
  $ RCat (RStr "      | ListDir (path, k) -> loop (o.apply k (result (fun () -> list of_string (List.sort compare (Array.to_list (Sys.readdir (to_string path)))))))\n")
  $ RCat (RStr "      | GetCwd k -> loop (o.apply k (of_string (w.cwd ())))\n")
  $ RCat (RStr "      | Stat (path, k) ->\n")
  $ RCat (RStr "          let p = to_string path in\n")
  $ RCat (RStr "          loop\n")
  $ RCat (RStr "            (o.apply k\n")
  $ RCat (RStr "               (match (Unix.stat p).st_kind with\n")
  $ RCat (RStr "               | Unix.S_REG -> o.ok o.is_file\n")
  $ RCat (RStr "               | Unix.S_DIR -> o.ok o.is_dir\n")
  $ RCat (RStr "               | _ -> o.ok o.is_other\n")
  $ RCat (RStr "               | exception Unix.Unix_error (Unix.ENOENT, _, _) -> o.ok o.missing\n")
  $ RCat (RStr "               | exception (Unix.Unix_error _ as e) -> o.fail (of_string (explain e))))\n")
  $ RCat (RStr "      | MkDir (path, k) ->\n")
  $ RCat (RStr "          let p = to_string path in\n")
  $ RCat (RStr "          loop (o.apply k (change (fun e -> e = Unix.EEXIST && is_dir p) (fun () -> Unix.mkdir p 0o777)))\n")
  $ RCat (RStr "      | DeleteFile (path, k) -> loop (o.apply k (change (fun e -> e = Unix.ENOENT) (fun () -> Unix.unlink (to_string path))))\n")
  $ RCat (RStr "      | DeleteDir (path, k) -> loop (o.apply k (change (fun e -> e = Unix.ENOENT) (fun () -> Unix.rmdir (to_string path))))\n")
  $ RCat (RStr "    in\n")
  $ RCat (RStr "    loop v\n")
  $ RCat (RStr "  in\n")
  $ RCat (RStr "  let run_main w f = w.out (to_string (o.apply f (of_string (w.read_rest ())))) in\n")
  $ RCat (RStr "  { of_string; to_string; run_io; run_main }\n")
  $ RCat (RStr "end\n")
  $ RCat (RStr "let absurd () = prerr_endline \"runtime error: absurd code reached\"; exit 1\n")
  $ RCat (RStr "type yes = Yes_ and no = No_\n")
  $ RCat (RStr "let m_plain : Obj.t = Obj.repr (fun (v : Obj.t) : Obj.t -> v)\n")
  $ RCat (RStr "let des_Nat v = Obj.repr (Ffi_core.nat_view ~z:Obj.obj ~nat:Obj.repr v)\n")
  $ RCat (RStr "let con_Nat v = Ffi_core.nat_of ~z:Obj.obj ~nat:Obj.repr (Obj.obj v)\n")
  $ RCat (RStr "let des_Half v = Obj.repr (Ffi_core.half_view ~z:Obj.obj ~nat:Obj.repr v)\n")
  $ RCat (RStr "let con_Half v = Ffi_core.half_of ~z:Obj.obj ~nat:Obj.repr (Obj.obj v)\n")
  $ RCat (RStr "let des_String v = Obj.repr (Ffi_core.str_view ~slice:Obj.obj ~u8:Obj.repr ~str:Obj.repr v)\n")
  $ RCat (RStr "let con_String v = Ffi_core.str_of ~z:Obj.obj ~slice:Obj.obj ~str:Obj.repr (Obj.obj v)\n")
  $ RCat (RStr "let des_Array v = Obj.repr (Ffi_core.array_view ~array:Obj.obj ~wrap:Obj.repr v)\n")
  $ RCat (RStr "let con_Array v = Ffi_core.array_of ~array:Obj.obj ~wrap:Obj.repr (Obj.obj v)\n")
  $ RCat (RStr "let show_any (v : Obj.t) : string = \"?\"\n")
  $ RCat (RStr "let flush_to oc s = output_string oc s; flush oc\n")
  $ RCat (RStr "let program_args = let rec go = function [] -> [] | \"--\" :: rest -> rest | _ :: rest -> go rest in go (Array.to_list Sys.argv)\n")
  $ RCat (RStr "let world = { Driver_core.read_rest = (fun () -> In_channel.input_all stdin); read_line = (fun () -> In_channel.input_line stdin); out = flush_to stdout; err = flush_to stderr; args = program_args; env = Sys.getenv_opt; envs = Driver_core.host_envs; cwd = Sys.getcwd; exit; print = print_endline }\n")
  $ REmpty)

(let ((many extern-templates))
  $ RCat (RStr "; Templates for the extraction of extern types (ASSUMPTIONS 133): \"match T: text\" for a type and\n")
  $ RCat (RStr "; \"build T i: text\" for its constructor i, text being OCaml over Obj.t with holes {s} the scrutinee,\n")
  $ RCat (RStr "; {bI} the body of constructor I's arm, {fI.J} the binder of its field J, {aI} a build argument and {tK}\n")
  $ RCat (RStr "; a temporary. Every hole but a body is filled with a variable name, and a body sits in tail position.\n")
  $ RCat (RStr "; \"fn F: text\" is extern function F, {aI} its I-th non-erased argument, text its non-erased results.\n")
  $ RCat (RStr "match Nat: if (Obj.obj {s} : Z.t) == Z.zero then {b0} else let {f1.0} = Obj.repr (Z.pred (Obj.obj {s} : Z.t)) in {b1}\n")
  $ RCat (RStr "build Nat 0: Obj.repr Z.zero\n")
  $ RCat (RStr "build Nat 1: Obj.repr (Z.succ (Obj.obj {a0} : Z.t))\n")
  $ RCat (RStr "match Half: let {t0} = (Obj.obj {s} : Z.t) in if {t0} == Z.zero then {b0} else let {t1} = (if Obj.is_int {s} then Obj.repr (((Obj.obj {s} : int) - 1) asr 1) else Obj.repr (Z.shift_right (Z.pred {t0}) 1)) in if (if Obj.is_int {s} then (Obj.obj {s} : int) land 1 = 1 else Z.is_odd {t0}) then let {f1.0} = {t1} in {b1} else let {f2.0} = {t1} in {b2}\n")
  $ RCat (RStr "build Half 0: Obj.repr Z.zero\n")
  $ RCat (RStr "build Half 1: Obj.repr (Z.succ (Z.shift_left (Obj.obj {a0} : Z.t) 1))\n")
  $ RCat (RStr "build Half 2: Obj.repr (Z.add (Z.shift_left (Obj.obj {a0} : Z.t) 1) (Z.of_int 2))\n")
  $ RCat (RStr "match String: let ({t0}, {t1}, {t2}) = (Obj.obj {s} : Ffi_core.slice) in if {t2} = 0 then {b0} else let {f1.0} = Obj.repr (Z.of_int (Char.code {t0}.[{t1}])) and {f1.1} = Obj.repr (({t0}, {t1} + 1, {t2} - 1) : Ffi_core.slice) in {b1}\n")
  $ RCat (RStr "build String 0: Obj.repr ((\"\", 0, 0) : Ffi_core.slice)\n")
  $ RCat (RStr "build String 1: let ({t0}, {t1}, {t2}) = (Obj.obj {a1} : Ffi_core.slice) in Obj.repr ((String.make 1 (Char.chr (Z.to_int (Obj.obj {a0} : Z.t))) ^ String.sub {t0} {t1} {t2}, 0, {t2} + 1) : Ffi_core.slice)\n")
  $ RCat (RStr "fn nat-cmp: let {t0} = Z.compare (Obj.obj {a0} : Z.t) (Obj.obj {a1} : Z.t) in Obj.repr (if {t0} < 0 then 0 else if {t0} = 0 then 1 else 2)\n")
  $ RCat (RStr "fn lt-dec: Obj.repr (if Z.lt (Obj.obj {a0} : Z.t) (Obj.obj {a1} : Z.t) then 0 else 1)\n")
  $ RCat (RStr "fn u62-add: Obj.repr ((Obj.obj {a0} : int) + (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn u62-sub: Obj.repr ((Obj.obj {a0} : int) - (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn u62-mul: Obj.repr ((Obj.obj {a0} : int) * (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn u62-div: Obj.repr ((Obj.obj {a0} : int) / (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn u62-mod: Obj.repr ((Obj.obj {a0} : int) mod (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn u62-divmod: let {t0} = (Obj.obj {a0} : int) and {t1} = (Obj.obj {a1} : int) in Obj.repr (Obj.repr ({t0} / {t1}), Obj.repr ({t0} mod {t1}))\n")
  $ RCat (RStr "fn u62-cmp: let {t0} = (Obj.obj {a0} : int) and {t1} = (Obj.obj {a1} : int) in Obj.repr (if {t0} < {t1} then 0 else if {t0} = {t1} then 1 else 2)\n")
  $ RCat (RStr "fn u62-lt-dec: Obj.repr (if (Obj.obj {a0} : int) < (Obj.obj {a1} : int) then 0 else 1)\n")
  $ RCat (RStr "fn array-pluck: Obj.repr (Array.unsafe_get (Obj.obj {a0} : Ffi_core.word array) (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn array-get: Obj.repr (Array.unsafe_get (Obj.obj {a0} : Ffi_core.word array) (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn array-get-many: Obj.repr (Array.unsafe_get (Obj.obj {a0} : Ffi_core.word array) (Obj.obj {a1} : int))\n")
  $ RCat (RStr "fn array-place: Array.unsafe_set (Obj.obj {a0} : Ffi_core.word array) (Obj.obj {a1} : int) (Obj.obj {a2} : Ffi_core.word); Obj.repr ()\n")
  $ RCat (RStr "fn array-swap: let {t0} = (Obj.obj {a0} : Ffi_core.word array) and {t1} = (Obj.obj {a1} : int) in let {t2} = Array.unsafe_get {t0} {t1} in Array.unsafe_set {t0} {t1} (Obj.obj {a2} : Ffi_core.word); Obj.repr {t2}\n")
  $ RCat (RStr "fn array-place-imm: Array.unsafe_set (Obj.obj {a0} : int array) (Obj.obj {a1} : int) (Obj.obj {a2} : int); Obj.repr ()\n")
  $ RCat (RStr "fn array-swap-imm: let {t0} = (Obj.obj {a0} : int array) and {t1} = (Obj.obj {a1} : int) in let {t2} = Array.unsafe_get {t0} {t1} in Array.unsafe_set {t0} {t1} (Obj.obj {a2} : int); Obj.repr {t2}\n")
  $ RCat (RStr "fn array-make: Obj.repr (Array.make (Obj.obj {a0} : int) {a1})\n")
  $ RCat (RStr "fn array-length: Obj.repr (Array.length (Obj.obj {a0} : Ffi_core.word array))\n")
  $ RCat (RStr "fn array-length-many: Obj.repr (Array.length (Obj.obj {a0} : Ffi_core.word array))\n")
  $ REmpty)

(let ((many prelude-source)) "; The source prelude (DESIGN.md section 41), elaborated ahead of every program. Its extern-marked\n; definitions are the models the FFI's implementations in ffi.ml stand in for.\n;\n; Neither compiler reads this file at run time: lib/dune embeds it into the reference as Prelude_source,\n; and self/gen_header.py into slc as self/header.sl's prelude-source, so an edit here needs a rebuild of\n; each (self/bootstrap.sh regenerates the header). Both compilers also name some of its definitions in their\n; own source -- the literal types, the IO driver's types, the lemmas unary and distinct expand to, and the\n; externs lib/ffi.ml and lib/ffi_templates.txt implement -- so renaming one here means renaming it there too.\n\n(def-adts $ (Nat : -> Type)\n  enum extern\n  (many Zero : -> (Nat))\n  (many Succ : (many (Nat) pred) -> (Nat)))\n\n(def-adts $ (False : -> Type)\n  enum)\n\n(def-adts\n  ((Eq : (Type A) (A x) (A y) -> Type)\n    enum\n    (many Refl : (erased Type A) (erased A x) -> (Eq A x x))))\n\n(def-fns _ $ (erased eq-trans : (erased Type A) (erased A x) (erased A y) (erased A z)\n    (erased (Eq A x y) e) (erased (Eq A y z) f) -> (erased (Eq A x z) g))\n  (match erased e _ ((Refl a b) (match erased f _ ((Refl c d) (Refl A x))))))\n\n(def-fns _ $ (erased eq-cong-succ : (erased (Nat) x) (erased (Nat) y) (erased (Eq (Nat) x y) e) ->\n    (erased (Eq (Nat) (Succ x) (Succ y)) f))\n  (match erased e _ ((Refl a b) (Refl (Nat) (Succ x)))))\n\n(def-adts\n  ((Add : ((Nat) a) ((Nat) b) ((Nat) c) -> Type)\n    enum\n    (many AddZero : (erased (Nat) b) -> (Add (Zero) b b))\n    (many AddSucc : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c) (erased (Add a b c) q) -> (Add (Succ a) b (Succ c)))))\n\n(def-adts\n  ((Lt : ((Nat) a) ((Nat) b) -> Type)\n    enum\n    (many LtZ : (erased (Nat) b) -> (Lt (Zero) (Succ b)))\n    (many LtS : (erased (Nat) a) (erased (Nat) b) (erased (Lt a b) p) -> (Lt (Succ a) (Succ b)))))\n\n(def-adts\n  ((Double : ((Nat) a) ((Nat) b) -> Type)\n    enum\n    (many D0 : -> (Double (Zero) (Zero)))\n    (many DS : (erased (Nat) a) (erased (Nat) b) (erased (Double a b) d) -> (Double (Succ a) (Succ (Succ b))))))\n\n(def-adts\n  ((Pow2 : ((Nat) k) ((Nat) v) -> Type)\n    enum\n    (many P0 : -> (Pow2 (Zero) (Succ (Zero))))\n    (many PS : (erased (Nat) k) (erased (Nat) v) (erased (Nat) w) (erased (Pow2 k v) p) (erased (Double v w) d)\n       -> (Pow2 (Succ k) w))))\n\n(def-adts\n  ((Mod : ((Nat) s) ((Nat) c) ((Nat) r) -> Type)\n    enum\n    (many ModLt : (erased (Nat) s) (erased (Nat) c) (erased (Lt s c) p) -> (Mod s c s))\n    (many ModSub : (erased (Nat) s1) (erased (Nat) c) (erased (Nat) s) (erased (Nat) r) (erased (Add c s1 s) a) (erased (Mod s1 c r) m)\n       -> (Mod s c r))))\n\n(def-adts\n  ((Dec : ((Nat) a) ((Nat) b) -> Type)\n    enum\n    (many Yes : (erased (Nat) a) (erased (Nat) b) (erased (Lt a b) p) -> (Dec a b))\n    (many No : (erased (Nat) a) (erased (Nat) b) (erased (Lt b (Succ a)) q) -> (Dec a b))))\n\n; Parametric in the carrier and its strict order, every field erased, so a value is only its tag and two\n; instances differ by a coercion (section 38).\n(def-adts\n  ((Cmp : (Type T) ((TyCtor (T x) (T y) -> Type) R) (T a) (T b) -> Type)\n    enum\n    (many CLt : (erased Type T) (erased (TyCtor (T x) (T y) -> Type) R) (erased T a) (erased T b)\n                (erased (R a b) p) -> (Cmp T R a b))\n    (many CEq : (erased Type T) (erased (TyCtor (T x) (T y) -> Type) R) (erased T a) -> (Cmp T R a a))\n    (many CGt : (erased Type T) (erased (TyCtor (T x) (T y) -> Type) R) (erased T a) (erased T b)\n                (erased (R b a) q) -> (Cmp T R a b))))\n\n(def-fns _ $ (erased add-zero-right : (subterm erased (Nat) a) -> (erased (Add a (Zero) a) p))\n  (match erased a _\n    ((Zero) (AddZero (Zero)))\n    ((Succ a1) (AddSucc a1 (Zero) a1 (add-zero-right a1)))))\n\n(def-fns _ $ (erased add-succ-right : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c) (subterm erased (Add a b c) p) ->\n    (erased (Add a (Succ b) (Succ c)) q))\n  (match erased p _\n    ((AddZero b0) (AddZero (Succ b)))\n    ((AddSucc a1 b1 c0 q0) (AddSucc a1 (Succ b) (Succ c0) (add-succ-right a1 b c0 q0)))))\n\n(def-fns _ $ (erased add-succ-right-inv : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c) (subterm erased (Add a (Succ b) c) p) ->\n    (erased (Nat) c1) (erased (Eq (Nat) c (Succ c1)) e) (erased (Add a b c1) q))\n  (let-match erased p (AddSucc a1 b1 c0 q0) ((AddZero b0) (values b (Refl (Nat) c) (AddZero b))))\n  (let ((erased c1) (erased e1) (erased q1)) (add-succ-right-inv a1 b c0 q0))\n  (match erased e1 _\n    ((Refl t r) (values (Succ c1) (Refl (Nat) c) (AddSucc a1 b c1 q1)))))\n\n(def-fns _ $ (erased add-diag-double : (subterm erased (Nat) a) (erased (Nat) b) (erased (Add a a b) p) -> (erased (Double a b) d))\n  (let-match erased p (AddSucc a1 b1 c0 q0) ((AddZero b0) (D0)))\n  (let ((erased c1) (erased e1) (erased q1)) (add-succ-right-inv a1 a1 c0 q0))\n  (match erased e1 _\n    ((Refl t r) (DS a1 c1 (add-diag-double a1 c1 q1)))))\n\n(def-fns _ $ (erased double-pos : (erased (Nat) v) (erased (Nat) w) (erased (Lt (Zero) v) q) (erased (Double v w) d) ->\n    (erased (Lt (Zero) w) r))\n  (let-match erased q (LtZ b) (absurd LtS))\n  (match erased d _\n    (absurd D0)\n    ((DS a b2 d1) (LtZ (Succ b2)))))\n\n(def-fns _ $ (erased absurd lt-asym : (erased (Nat) r) (erased (Nat) c) (subterm erased (Lt r c) p) (erased (Lt c (Succ r)) g) -> (erased (False) f))\n  (match erased p _\n    (absurd (LtZ b) (let-match erased g (LtS x y g1)) g1)\n    (absurd (LtS a b p1) (let-match erased g (LtS x y g1)) (lt-asym a b p1 g1))))\n\n(def-fns _ $ (erased mod-succ-lt : (erased (Nat) s) (erased (Nat) c) (erased (Nat) r) (subterm erased (Mod s c r) q) (erased (Lt (Succ r) c) lt) ->\n    (erased (Mod (Succ s) c (Succ r)) q1))\n  (match erased q _\n    ((ModLt x y p0) (ModLt (Succ s) c lt))\n    ((ModSub s1 c0 s0 r0 a m) (ModSub (Succ s1) c (Succ s) (Succ r) (add-succ-right c s1 s a) (mod-succ-lt s1 c r m lt)))))\n\n(def-fns _ $ (erased mod-succ-wrap : (erased (Nat) s) (erased (Nat) r) (subterm erased (Mod s (Succ r) r) q) -> (erased (Mod (Succ s) (Succ r) (Zero)) q1))\n  (match erased q _\n    ((ModLt x y p0) (ModSub (Zero) (Succ r) (Succ s) (Zero) (add-zero-right (Succ r)) (ModLt (Zero) (Succ r) (LtZ r))))\n    ((ModSub s1 c0 s0 r0 a m) (ModSub (Succ s1) (Succ r) (Succ s) (Zero) (add-succ-right (Succ r) s1 s a) (mod-succ-wrap s1 r m)))))\n\n(def-adts\n  ((Half : ((Nat) n) -> Type)\n    enum extern\n    (many HZ : -> (Half (Zero)))\n    (many H1 : (many (Nat) m) (erased (Nat) d) (erased (Double m d) dd) -> (Half (Succ d)))\n    (many H2 : (many (Nat) m) (erased (Nat) d) (erased (Double m d) dd) -> (Half (Succ (Succ d))))))\n\n(def-fns _ $ (many extern nat-halve : (subterm many (Nat) n) -> (many (Half n) h))\n  (let-match many n (Succ k) ((Zero) (HZ)))\n  (match many (notail $ nat-halve k) _\n    ((HZ) (H1 (Zero) (Zero) (D0)))\n    ((H1 m d dd) (H2 m d dd))\n    ((H2 m d dd) (H1 (Succ m) (Succ (Succ d)) (DS m d dd)))))\n\n(def-fns _ $ (many extern add : (subterm many (Nat) a) (many (Nat) b) -> (many (Nat) c) (erased (Add a b c) p))\n  (let-match many a (Succ k) ((Zero) (values b (AddZero b))))\n  (let ((many c) (erased q)) (notail $ add k b))\n  (values (Succ c) (AddSucc k b c q)))\n\n(def-fns _ $ (erased lt-succ : (subterm erased (Nat) a) -> (erased (Lt a (Succ a)) p))\n  (match erased a _\n    ((Zero) (LtZ (Zero)))\n    ((Succ a1) (LtS a1 (Succ a1) (lt-succ a1)))))\n\n(def-fns _ $ (erased lt-weaken : (erased (Nat) x) (erased (Nat) y) (subterm erased (Lt x y) p) -> (erased (Lt x (Succ y)) q))\n  (match erased p _\n    ((LtZ b) (LtZ (Succ b)))\n    ((LtS a b p1) (LtS a (Succ b) (lt-weaken a b p1)))))\n\n(def-fns _ $ (many extern nat-cmp : (subterm many (Nat) a) (many (Nat) b) -> (many (Cmp (Nat) Lt a b) c))\n  (match many a _\n    ((Zero)\n      (match many b _\n        ((Zero) (CEq (Nat) Lt a))\n        ((Succ b1) (CLt (Nat) Lt a b (L