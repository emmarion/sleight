(def-fns _ $ (erased reps-at : (erased (List (Nat)) nd rep ls) (erased (Nat) i j k l) (subterm erased (Reps nd rep i ls) rs)
    (erased (Nth (Nat) ls j l) p) (erased (Add j i k) a) -> (erased (Nat) r) (erased (Nth (Nat) rep l r) pr) (erased (NodeReach nd r k) reach))
  (let-match erased rs (RepsCons _ _ ls1 _ l1 r1 pr1 reach1 rs1) (absurd (RepsNil _ _ _) p))
  (let-match erased p (NthThere _ _ _ j1 _ p1)
    ((NthHere _ _ _) (let-match erased a (AddZero _)) (values r1 pr1 reach1)))
  (let-match erased a (AddSucc _ _ k1 a1))
  (reps-at nd rep ls1 (Succ i) j1 k l rs1 p1 (add-succ-right j1 i k1 a1)))

(def-fns _ $ (erased alllt-nth : (erased (List (Nat)) s) (erased (Nat) n i x) (subterm erased (AllLt s n) al) (erased (Nth (Nat) s i x) p) ->
    (erased (Lt x n) r))
  (let-match erased al (ALCons y _ s1 q al1) (absurd (ALNil _) p))
  (let-match erased p (NthThere _ _ _ i1 _ p1) ((NthHere _ _ _) q))
  (alllt-nth s1 n i1 x al1 p1))

(def-fns _ $ (erased alllt-snoc : (erased (List (Nat)) s s2) (erased (Nat) n a) (subterm erased (AllLt s n) al) (erased (Lt a n) la)
    (erased (Snoc (Nat) s a s2) sn) -> (erased (AllLt s2 n) r))
  (let-match erased al (ALCons y _ s1 q al1) ((ALNil _) (let-match erased sn (SnocNil _ _)) (ALCons a n _ la (ALNil n))))
  (let-match erased sn (SnocCons _ _ _ _ s3 sn1))
  (ALCons y n s3 q (alllt-snoc s1 s3 n a al1 la sn1)))

(def-fns _ $ (erased alllt-succ : (erased (List (Nat)) s) (erased (Nat) n) (subterm erased (AllLt s n) al) -> (erased (AllLt s (Succ n)) r))
  (let-match erased al (ALCons y _ s1 q al1) ((ALNil _) (ALNil (Succ n))))
  (ALCons y (Succ n) s1 (lt-weaken y n q) (alllt-succ s1 n al1)))

(def-fns _ $ (erased allis-alllt : (erased (List (Nat)) s) (erased (Nat) u n) (subterm erased (AllIs s u) a) (erased (Lt u n) l) ->
    (erased (AllLt s n) r))
  (let-match erased a (AllIsCons _ s1 a1) ((AllIsNil _) (ALNil n)))
  (ALCons u n s1 l (allis-alllt s1 u n a1 l)))

(def-fns _ $ (erased alllt-app : (erased (List (Nat)) a b c) (erased (Nat) n) (subterm erased (LApp (Nat) a b c) p)
    (erased (AllLt a n) la) (erased (AllLt b n) lb) -> (erased (AllLt c n) r))
  (let-match erased p (LAppCons _ x a1 _ c1 p1) ((LAppNil _ _) lb))
  (let-match erased la (ALCons _ _ _ q la1))
  (ALCons x n c1 q (alllt-app a1 b c1 n p1 la1 lb)))

(def-fns _ $ (erased alllt-app-l : (erased (List (Nat)) a b c) (erased (Nat) n) (subterm erased (LApp (Nat) a b c) p)
    (erased (AllLt c n) lc) -> (erased (AllLt a n) la) (erased (AllLt b n) lb))
  (let-match erased p (LAppCons _ x a1 _ c1 p1) ((LAppNil _ _) (values (ALNil n) lc)))
  (let-match erased lc (ALCons _ _ _ q lc1))
  (let ((erased la) (erased lb)) (alllt-app-l a1 b c1 n p1 lc1))
  (values (ALCons x n a1 q la) lb))

(def-fns _ $ (erased grouplab-lt : (erased (List (Nat)) pl fl) (erased (List (Group)) gs) (erased (Nat) t) (subterm erased (GroupLab pl gs) gl)
    (erased (AllLt pl t) al) (erased (GFlat gs fl) gf) -> (erased (AllLt fl t) r))
  (let-match erased gl (GLCons _ xs d u gs1 p a gl1) ((GLNil _) (let-match erased gf (GFlatNil)) (ALNil t)))
  (let-match erased gf (GFlatCons _ _ fl1 _ _ q gf1))
  (alllt-app xs fl1 fl t q (allis-alllt xs u t a (alllt-nth pl t d u al p)) (grouplab-lt pl fl1 gs1 t gl1 al gf1)))

(def-fns _ $ (erased grouplab-grow : (erased (List (Nat)) pl pl2) (erased (List (Group)) gs) (erased (Nat) a) (subterm erased (GroupLab pl gs) gl)
    (erased (Snoc (Nat) pl a pl2) sn) -> (erased (GroupLab pl2 gs) r))
  (let-match erased gl (GLCons _ xs d u gs1 p q gl1) ((GLNil _) (GLNil pl2)))
  (GLCons pl2 xs d u gs1 (snoc-old _ pl pl2 a u d sn p) q (grouplab-grow pl pl2 gs1 a gl1 sn)))

(def-fns _ $ (erased repeat-allis : (erased (Nat) k t) (erased (List (Nat)) ns) (subterm erased (Repeat (Nat) k t ns) rp) -> (erased (AllIs ns t) r))
  (let-match erased rp (RepeatCons _ k1 _ ns1 rp1) ((RepeatNil _ _) (AllIsNil t)))
  (AllIsCons t ns1 (repeat-allis k1 t ns1 rp1)))

; Some edge of the map joins a dart labelled s to one labelled t.
(def-adts $ (Joined : ((List (Nat)) e) ((List (Nat)) pl) ((Nat) s) ((Nat) t) -> Type)
  enum
  (many MkJoined : (erased (List (Nat)) e pl) (erased (Nat) s t x y) (erased (Nth (Nat) e x y) pe) (erased (Nth (Nat) pl x s) ps)
      (erased (Nth (Nat) pl y t) pt) -> (Joined e pl s t)))

(def-adts $ (AllJoined : ((List (Nat)) e) ((List (Nat)) pl) ((List (Nat)) r) ((Nat) t) -> Type)
  enum
  (many AJNil : (erased (List (Nat)) e pl) (erased (Nat) t) -> (AllJoined e pl (Nil (Nat)) t))
  (many AJCons : (erased (List (Nat)) e pl r) (erased (Nat) s t) (erased (Joined e pl s t) j) (erased (AllJoined e pl r t) rest)
      -> (AllJoined e pl (Cons (Nat) s r) t)))

(def-fns _ $ (erased joined-grow : (erased (List (Nat)) e pl e2 pl2) (erased (Nat) s t) (erased (Joined e pl s t) j)
    (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree pl pl2 (Nil (Nat))) gp) -> (erased (Joined e2 pl2 s t) r))
  (let-match erased j (MkJoined _ _ _ _ x y pe ps pt))
  (MkJoined e2 pl2 s t x y (agree-nth e e2 (Nil _) x y ge pe (NotInNil x)) (agree-nth pl pl2 (Nil _) x s gp ps (NotInNil x))
    (agree-nth pl pl2 (Nil _) y t gp pt (NotInNil y))))

(def-fns _ $ (erased alljoined-grow : (erased (List (Nat)) e pl e2 pl2 r) (erased (Nat) t) (subterm erased (AllJoined e pl r t) j)
    (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree pl pl2 (Nil (Nat))) gp) -> (erased (AllJoined e2 pl2 r t) res))
  (let-match erased j (AJCons _ _ r1 s _ j1 rest) ((AJNil _ _ _) (AJNil e2 pl2 t)))
  (AJCons e2 pl2 r1 s t (joined-grow e pl e2 pl2 s t j1 ge gp) (alljoined-grow e pl e2 pl2 r1 t rest ge gp)))

; The sweep's state before step t: the map, its darts' labels pl, one representative dart per label in rep, and the
; frontier gs, whose items in order are fl.
(def-adts $ (State : ((Nat) t) ((List (Nat)) e) ((List (Nat)) nd) ((List (Nat)) pl) ((List (Nat)) rep) ((List (Group)) gs)
    ((List (Nat)) fl) -> Type)
  enum
  (many MkState : (erased (Nat) t n d0) (erased (List (Nat)) e nd pl rep s xs0 fl) (erased (List (Group)) gsr)
      (erased (PlaneMap e nd) pm) (erased (Length (Nat) e n) le) (erased (Length (Nat) nd n) ln) (erased (Length (Nat) pl n) lp)
      (erased (Length (Nat) rep t) lr)
      (erased (Darts (Cons (Group) (MkGroup d0 xs0) gsr) s) ds) (erased (Distinct s) dist)
      (erased (Chain e nd s (Cons (Group) (MkGroup d0 xs0) gsr) d0) ch)
      (erased (Respects pl nd pl) rp) (erased (AllLt pl t) al) (erased (GroupLab pl (Cons (Group) (MkGroup d0 xs0) gsr)) gl)
      (erased (GFlat (Cons (Group) (MkGroup d0 xs0) gsr) fl) gf) (erased (Reps nd rep (Zero) pl) rs)
      -> (State t e nd pl rep (Cons (Group) (MkGroup d0 xs0) gsr) fl)))

(def-fns _ $ (erased sub-snoc : (erased (Nat) d) (erased (List (Nat)) m m2 s) (subterm erased (Sub m s) sb) (erased (In d s) p)
    (erased (Snoc (Nat) m d m2) sn) -> (erased (Sub m2 s) r))
  (match erased sb _
    ((SubNil _) (let-match erased sn (SnocNil _ _)) (SubCons d _ s p (SubNil s)))
    ((SubCons x m1 _ q sb1)
      (let-match erased sn (SnocCons _ _ _ _ m3 sn1))
      (SubCons x m3 s q (sub-snoc d m1 m3 s sb1 p sn1)))))

; The head group moves to the end.
(def-fns _ $ (erased state-rot : (erased (Nat) t d0 d1) (erased (List (Nat)) e nd pl rep xs0 xs1 fl) (erased (List (Group)) gsr)
    (erased (State t e nd pl rep (Cons (Group) (MkGroup d0 xs0) $ Cons (Group) (MkGroup d1 xs1) gsr) fl) st) ->
    (erased (List (Group)) gs2) (erased (List (Nat)) fl2) (erased (Snoc (Group) (Cons (Group) (MkGroup d1 xs1) gsr) (MkGroup d0 xs0) gs2) sg)
    (erased (State t e nd pl rep gs2 fl2) st2) (erased (Rot (Nat) fl2 fl) ro))
  (let-match erased st (MkState _ n _ _ _ _ _ s _ _ _ pm le ln lp lr ds dist ch rp al gl gf rs))
  (let-match erased ds (DartsCons _ _ s1 _ ds1))
  (let-match erased dist (DistCons _ _ nd0 dist1))
  (let-match erased ch (ChainCons _ _ _ _ _ _ _ _ _ k0 ch1))
  (let-match erased gl (GLCons _ _ _ u0 _ pu0 a0 gl1))
  (let-match erased gf (GFlatCons _ _ fl1 _ _ p gf1))
  (let ((erased gs1)) (Cons (Group) (MkGroup d1 xs1) gsr))
  (let ((erased gs2) (erased sg)) (snoc-exists _ gs1 (MkGroup d0 xs0)))
  (let ((erased s2) (erased ss)) (snoc-exists _ s1 d0))
  (let ((erased fl2) (erased a2)) (lapp-exists _ fl1 xs0))
  (let ((erased sb)) (sub-snoc d0 s1 s2 s (sub-cons d0 s1 s1 (sub-refl s1)) (InHere d0 s1) ss))
  (let ((erased ch2)) (chain-snoc e nd s xs0 gs1 gs2 d0 d1 ch1 k0 sg))
  (let-match erased sg (SnocCons _ _ _ _ gsr2 _))
  (values gs2 fl2 sg
    (MkState t n d1 e nd pl rep s2 xs1 fl2 gsr2 pm le ln lp lr (darts-snoc gs1 gs2 s1 s2 xs0 d0 ds1 sg ss) (distinct-snoc d0 s1 s2 dist1 nd0 ss)
      (chain-weaken e nd s s2 gs2 d1 ch2 sb) rp al (grouplab-snoc pl xs0 gs1 gs2 d0 u0 gl1 sg pu0 a0) (flat-snoc gs1 gs2 d0 xs0 fl1 fl2 gf1 sg a2) rs)
    (MkRot _ fl2 fl xs0 fl1 p a2)))

; The groups gs1 before g move to the end.
(def-fns _ $ (erased state-rot-n : (erased (Nat) t) (erased (List (Nat)) e nd pl rep fl) (subterm erased (List (Group)) gs1)
    (erased (Group) g) (erased (List (Group)) gs2 gs) (erased (LApp (Group) gs1 (Cons (Group) g gs2) gs) p)
    (erased (State t e nd pl rep gs fl) st) ->
    (erased (List (Group)) gs3) (erased (List (Nat)) fl2) (erased (LApp (Group) gs2 gs1 gs3) q)
    (erased (State t e nd pl rep (Cons (Group) g gs3) fl2) st2))
  (let-match erased gs1 (Cons _ h gs1b)
    ((Nil _) (let-match erased p (LAppNil _ _)) (values gs2 fl (lapp-nil _ gs2) st)))
  (let-match erased p (LAppCons _ _ _ _ rest p1))
  (let-match erased h (MkGroup d0 xs0))
  (let-match erased gs1b (Nil _)
    ((Cons _ h2 gs1c)
      (let-match erased p1 (LAppCons _ _ _ _ rest2 _))
      (let-match erased h2 (MkGroup d1 xs1))
      (let ((erased gs4) (erased fl3) (erased sg) (erased st3) (erased _)) (state-rot t d0 d1 e nd pl rep xs0 xs1 fl rest2 st))
      (let ((erased b2) (erased s2) (erased p2)) (app-snoc _ gs1b (Cons _ g gs2) rest gs4 h p1 sg))
      (let-match erased s2 (SnocCons _ _ _ _ gs2h s3))
      (let ((erased gs3) (erased fl2) (erased q) (erased st2)) (state-rot-n t e nd pl rep fl3 gs1b g gs2h gs4 p2 st3))
      (values gs3 fl2 (snoc-app _ gs2 gs2h gs1b gs3 h s3 q) st2)))
  (let-match erased p1 (LAppNil _ _))
  (let-match erased g (MkGroup d1 xs1))
  (let ((erased gs4) (erased fl3) (erased sg) (erased st3) (erased _)) (state-rot t d0 d1 e nd pl rep xs0 xs1 fl gs2 st))
  (let-match erased sg (SnocCons _ _ _ _ gs2h s3))
  (values gs2h fl3 (snoc-app _ gs2 gs2h (Nil _) gs2h h s3 (lapp-nil _ gs2h)) st3))

; The state rotated so that the run r starts in the head group (d, b ++ y), right after b; the items after r,
; then b, read on round the frontier, are qp.
(def-adts $ (Located : ((Nat) t) ((List (Nat)) e) ((List (Nat)) nd) ((List (Nat)) pl) ((List (Nat)) rep) ((List (Nat)) r)
    ((List (Nat)) qp) -> Type)
  enum
  (many MkLocated : (erased (Nat) t d) (erased (List (Nat)) e nd pl rep r qp by b y fl2 rest f3 yf3) (erased (List (Group)) gs3)
      (erased (State t e nd pl rep (Cons (Group) (MkGroup d by) gs3) fl2) st) (erased (LApp (Nat) b y by) pb)
      (erased (GFlat gs3 f3) g3) (erased (LApp (Nat) y f3 yf3) py) (erased (LApp (Nat) r rest yf3) pr)
      (erased (LApp (Nat) rest b qp) pq) (erased (Lead r y) ld)
      -> (Located t e nd pl rep r qp)))

(def-fns _ $ (erased head-lab : (erased (Nat) t d) (erased (List (Nat)) e nd pl rep by fl) (erased (List (Group)) gs)
    (erased (State t e nd pl rep (Cons (Group) (MkGroup d by) gs) fl) st) -> (erased (Nat) u) (erased (Nth (Nat) pl d u) p)
    (erased (AllIs by u) a))
  (let-match erased st (MkState _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ gl _ _))
  (let-match erased gl (GLCons _ _ _ u _ p a _))
  (values u p a))

(def-fns _ $ (erased locate : (erased (Nat) t) (erased (List (Nat)) e nd pl rep fl xs p r q pr qp) (erased (List (Group)) gs)
    (erased (State t e nd pl rep gs fl) st) (erased (Rot (Nat) fl xs) ro) (erased (LApp (Nat) p r pr) a1) (erased (LApp (Nat) pr q xs) a2)
    (erased (Distinct r) dr) (erased (LApp (Nat) q p qp) a3) -> (erased (Located t e nd pl rep r qp) loc))
  (let-match erased st (MkState _ _ d0 _ _ _ _ _ x0 _ gsr _ _ _ _ _ _ _ _ _ _ _ gf _))
  (match erased (cyc-split _ fl xs p r q pr qp ro a1 a2 a3) _
    ((CRFlat _ _ _ _ u w rw p1 p2 p3)
      (let-match erased (group-split gsr d0 x0 u rw fl gf p2) (MkCut _ gs1 gs2 _ _ b y by f1 f2 d pg pb g1 g2 pu pv ld))
      (let ((erased gs3) (erased fl2) (erased qg) (erased st2)) (state-rot-n t e nd pl rep fl gs1 (MkGroup d by) gs2 gs pg st))
      (let ((erased f3) (erased q3) (erased g3)) (flat-app gs2 gs1 gs3 f2 f1 g2 g1 qg))
      (let ((erased yf3) (erased py)) (lapp-exists _ y f3))
      (let ((erased rw2) (erased s1) (erased s2)) (lapp-assoc-back _ y f2 f1 f3 yf3 q3 py))
      (let-match erased (lapp-fn _ y f2 rw2 rw s1 pv) (Refl _ _))
      (let ((erased rest) (erased s3) (erased s4)) (lapp-assoc _ r w f1 rw yf3 p1 s2))
      (let ((erased x) (erased s5)) (lapp-exists _ rest b))
      (let ((erased fb) (erased s6) (erased s7)) (lapp-assoc _ w f1 b rest x s3 s5))
      (let-match erased (lapp-fn _ f1 b fb u s6 pu) (Refl _ _))
      (let-match erased (lapp-fn _ w u x qp s7 p3) (Refl _ _))
      (let ((erased ld2)) (match erased ld (((Lead r y) l))
        ((LeadNil _) (let-match erased p1 (LAppNil _ _)) (LeadNil y))
        ((LeadCons _ ys y0) (LeadCons r ys y0))))
      (MkLocated t d e nd pl rep r qp by b y fl2 rest f3 yf3 gs3 st2 pb g3 py s4 s5 ld2))
    ((CRWrap _ _ _ _ r1 r2 _ r2m x1 x2 t1 t2 n1 n2 p1 p2 p3)
      (let-match erased n1 (Refl _ _))
      (let-match erased (group-split gsr d0 x0 r2m r1 fl gf p3) (MkCut _ gs1 gs2 _ _ b y by f1 f2 d pg pb g1 g2 pu pv ld))
      (let-match erased ld (LeadCons _ ys y0))
      (let ((erased gs3) (erased fl2) (erased qg) (erased st2)) (state-rot-n t e nd pl rep fl gs1 (MkGroup d by) gs2 gs pg st))
      (let ((erased f3) (erased q3) (erased g3)) (flat-app gs2 gs1 gs3 f2 f1 g2 g1 qg))
      (let ((erased yf3) (erased py)) (lapp-exists _ y f3))
      (let ((erased r1b) (erased s1) (erased s2)) (lapp-assoc-back _ y f2 f1 f3 yf3 q3 py))
      (let-match erased (lapp-fn _ y f2 r1b r1 s1 pv) (Refl _ _))
      (match erased (lapp-split _ f1 b r2 qp r2m pu p2) _
        ((SplitLeft _ _ _ _ _ m fm mb)
          (let-match erased m (Nil _)
            (absurd (Cons _ z m1)
                (let ((erased u0) (erased _) (erased a0)) (head-lab t d e nd pl rep by fl2 gs3 st2))
                (let ((erased ab) (erased ay)) (allis-app b y by u0 pb a0))
                (let-match erased mb (LAppCons _ _ _ _ _ _))
                (let-match erased ab (AllIsCons _ _ _))
                (let-match erased ay (AllIsCons _ _ _))
                (let-match erased pv (LAppCons _ _ _ _ _ _))
                (distinct-app z r1 r2 r p1 dr (InHere z _) (in-app-r z f1 m r2 fm (InHere z m1)))))
          (let-match erased mb (LAppNil _ _))
          (let-match erased (lapp-fn _ f1 (Nil _) r2 f1 fm (lapp-nil _ f1)) (Refl _ _))
          (let-match erased (lapp-fn _ r1 r2 yf3 r s2 p1) (Refl _ _))
          (MkLocated t d e nd pl rep r qp by b y fl2 (Nil _) f3 yf3 gs3 st2 pb g3 py (lapp-nil _ r) (LAppNil _ b) (LeadCons r ys y0)))
        ((SplitRight _ _ _ _ _ m rm mb)
          (let ((erased r3) (erased s3) (erased s4)) (lapp-assoc-back _ r1 r2 m f1 yf3 rm s2))
          (let-match erased (lapp-fn _ r1 r2 r3 r s3 p1) (Refl _ _))
          (MkLocated t d e nd pl rep r qp by b y fl2 m f3 yf3 gs3 st2 pb g3 py s4 mb (LeadCons r ys y0)))))))

; Midway through step t: v = t has darts, y1 the first; the frontier is (db, b), (y1, []), (c, xs), gsr; the run
; still to close is rr, and after it come rest, the items of the frontier from there on round to b.
(def-adts $ (Fan : ((Nat) t) ((List (Nat)) e) ((List (Nat)) nd) ((List (Nat)) pl) ((List (Nat)) rep) ((Nat) db) ((List (Nat)) b)
    ((Nat) y1) ((Nat) c) ((List (Nat)) xs) ((List (Group)) gsr) ((List (Nat)) rr) ((List (Nat)) rest) -> Type)
  enum
  (many MkFan : (erased (Nat) t n db y1 c) (erased (List (Nat)) e nd pl rep s b xs fr xfr rr rest) (erased (List (Group)) gsr)
      (erased (PlaneMap e nd) pm) (erased (Length (Nat) e n) le) (erased (Length (Nat) nd n) ln) (erased (Length (Nat) pl n) lp)
      (erased (Length (Nat) rep (Succ t)) lr)
      (erased (Darts (Cons (Group) (MkGroup db b) $ Cons (Group) (MkGroup y1 (Nil (Nat))) $ Cons (Group) (MkGroup c xs) gsr) s) ds)
      (erased (Distinct s) dist)
      (erased (Chain e nd s (Cons (Group) (MkGroup db b) $ Cons (Group) (MkGroup y1 (Nil (Nat))) $ Cons (Group) (MkGroup c xs) gsr) db) ch)
      (erased (Respects pl nd pl) rp) (erased (AllLt pl (Succ t)) al) (erased (Nth (Nat) pl y1 t) py) (erased (Nth (Nat) rep t y1) ry)
      (erased (GroupLab pl (Cons (Group) (MkGroup db b) $ Cons (Group) (MkGroup y1 (Nil (Nat))) $ Cons (Group) (MkGroup c xs) gsr)) gl)
      (erased (GFlat gsr fr) gf) (erased (LApp (Nat) xs fr xfr) px) (erased (LApp (Nat) rr rest xfr) pr) (erased (AllLt xfr t) ax)
      (erased (Reps nd rep (Zero) pl) rs)
      -> (Fan t e nd pl rep db b y1 c xs gsr rr rest)))

(def-fns _ $ (erased fan-chord : (erased (Nat) t db y1 c a) (erased (List (Nat)) e nd pl rep b xs rr rest) (erased (List (Group)) gsr)
    (erased (Fan t e nd pl rep db b y1 c (Cons (Nat) a xs) gsr (Cons (Nat) a rr) rest) f) ->
    (erased (List (Nat)) e2 nd2 pl2) (erased (Nat) x) (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree pl pl2 (Nil (Nat))) gp)
    (erased (Fan t e2 nd2 pl2 rep db b y1 x xs gsr rr rest) f2) (erased (Joined e2 pl2 a t) j))
  (let-match erased f (MkFan _ n _ _ _ _ _ _ _ s _ _ fr xfr _ _ _ pm le ln lp lr ds dist ch rp al py ry gl gf px pr ax rs))
  (let-match erased ds (DartsCons _ _ _ _ ds1))
  (let-match erased ds1 (DartsCons _ _ _ _ ds2))
  (let-match erased ds2 (DartsCons _ _ sr _ ds3))
  (let-match erased gl (GLCons _ _ _ ub _ pub ab gl1))
  (let-match erased gl1 (GLCons _ _ _ _ _ _ _ gl2))
  (let-match erased gl2 (GLCons _ _ _ u _ pu au gl3))
  (let-match erased au (AllIsCons _ _ au1))
  (let-match erased px (LAppCons _ _ _ _ xfr1 px1))
  (let-match erased pr (LAppCons _ _ _ _ _ pr1))
  (let-match erased ax (ALCons _ _ _ lat ax1))
  (let-match erased dist (DistCons _ _ _ dist1))
  (let-match erased dist1 (DistCons _ _ ny1 _))
  (let ((erased y1-c) (erased _)) (notin-head y1 c _ ny1))
  (let ((erased e2) (erased nd1) (erased nd2) (erased g) (erased i1) (erased i2) (erased pm2) (erased ch2))
    (chord-step e nd sr pl b (Nil _) (Cons _ a xs) (Nil _) xs gsr n db y1 c t a pm le ln ch ds3 dist rp py pu (ApGt _ _ t a lat)))
  (let ((erased pl1) (erased sp1)) (snoc-exists _ pl t))
  (let ((erased pl2) (erased sp2)) (snoc-exists _ pl1 a))
  (let ((erased lp1)) (snoc-length _ pl pl1 t n sp1 lp))
  (let ((erased lp2)) (snoc-length _ pl1 pl2 a (Succ n) sp2 lp1))
  (let ((erased ln1)) (insert-length nd nd1 y1 n n i1 ln))
  (let ((erased ln2)) (insert-length nd1 nd2 c (Succ n) (Succ n) i2 ln1))
  (let ((erased le0) (erased le2)) (grow-length e e2 n g))
  (let ((erased pc1)) (snoc-old _ pl pl1 t a c sp1 pu))
  (let ((erased rp2)) (respects-insert pl1 pl2 nd1 nd2 c (Succ n) (Succ n) a
    (respects-insert pl pl1 nd nd1 y1 n n t rp i1 lp py sp1) i2 lp1 pc1 sp2))
  (let ((erased gp)) (AgTrans pl pl1 pl2 (Nil _) (AgSnoc pl pl1 (Nil _) t sp1) (AgSnoc pl1 pl2 (Nil _) a sp2)))
  (let ((erased al2)) (alllt-snoc pl1 pl2 (Succ t) a (alllt-snoc pl pl1 (Succ t) t al (lt-succ t) sp1) (lt-weaken a t lat) sp2))
  (let ((erased py2)) (agree-nth pl pl2 (Nil _) y1 t gp py (NotInNil y1)))
  (let ((erased gl4)) (GLCons pl2 b db ub _ (agree-nth pl pl2 (Nil _) db ub gp pub (NotInNil db)) ab
    (GLCons pl2 (Nil _) y1 t _ py2 (AllIsNil t) (GLCons pl2 xs (Succ n) a gsr (snoc-new _ pl1 pl2 a (Succ n) sp2 lp1) au1
      (grouplab-grow pl1 pl2 gsr a (grouplab-grow pl pl1 gsr t gl3 sp1) sp2)))))
  (let ((erased rs1)) (reps-insert nd nd1 rep pl y1 n (Zero) rs i1 ln))
  (let ((erased rs2)) (reps-insert nd1 nd2 rep pl c (Succ n) (Zero) rs1 i2 ln1))
  (let ((erased py1)) (insert-other nd1 nd2 c (Succ n) y1 n i2 (insert-at nd nd1 y1 n i1) y1-c))
  (let ((erased rs3)) (reps-snoc nd2 rep pl pl1 (Zero) n n t y1 rs2 lp (add-zero-right n) sp1 ry (NRStep nd2 y1 n n py1 (NRHere nd2 n))))
  (let ((erased ra) (erased pra) (erased rc)) (reps-at nd rep pl (Zero) c c a rs pu (add-zero-right c)))
  (let ((erased rc2)) (nr-snoc nd2 ra c (Succ n) (nr-insert nd1 nd2 c (Succ n) ra c (nr-insert nd nd1 y1 n ra c rc i1 ln) i2 ln1)
    (insert-at nd1 nd2 c (Succ n) i2)))
  (let ((erased rs4)) (reps-snoc nd2 rep pl1 pl2 (Zero) (Succ n) (Succ n) a ra rs3 lp1 (add-zero-right (Succ n)) sp2 pra rc2))
  (let ((erased j)) (MkJoined e2 pl2 a t (Succ n) n (edge-high e e2 n g) (snoc-new _ pl1 pl2 a (Succ n) sp2 lp1)
    (agree-nth pl1 pl2 (Nil _) n t (AgSnoc pl1 pl2 (Nil _) a sp2) (snoc-new _ pl pl1 t n sp1 lp) (NotInNil n))))
  (values e2 nd2 pl2 (Succ n) (grow-agree e e2 n g) gp
    (MkFan t (Succ (Succ n)) db y1 (Succ n) e2 nd2 pl2 rep _ b xs fr xfr1 rr rest gsr pm2 le2 ln2 lp2 lr
      (DartsCons db b _ _ $ DartsCons y1 (Nil _) _ _ $ DartsCons (Succ n) xs sr gsr ds3)
      (distinct-chord db y1 c n sr dist (chain-lt e nd s s _ db n ch ds ln)) ch2 rp2 al2 py2 ry gl4 gf px1 pr1 ax1 rs4)
    j))

(def-fns _ $ (erased fan-drop : (erased (Nat) t db y1 c a) (erased (List (Nat)) e nd pl rep b rr rest) (erased (List (Group)) gsr)
    (erased (Fan t e nd pl rep db b y1 c (Nil (Nat)) gsr (Cons (Nat) a rr) rest) f) ->
    (erased (Nat) c2) (erased (List (Nat)) z) (erased (List (Group)) gsr2)
    (erased (Subterm (List (Group)) gsr2 (List (Group)) gsr) sm) (erased (Fan t e nd pl rep db b y1 c2 z gsr2 (Cons (Nat) a rr) rest) f2))
  (let-match erased f (MkFan _ n _ _ _ _ _ _ _ s _ _ fr xfr _ _ _ pm le ln lp lr ds dist ch rp al py ry gl gf px pr ax rs))
  (let-match erased px (LAppNil _ _))
  (let-match erased pr (LAppCons _ _ _ _ _ _))
  (let-match erased gf (GFlatCons c2 z fr2 _ gsr2 pz gf2))
  (let-match erased ds (DartsCons _ _ _ _ ds1))
  (let-match erased ds1 (DartsCons _ _ _ _ ds2))
  (let-match erased ds2 (DartsCons _ _ _ _ ds3))
  (let-match erased ds3 (DartsCons _ _ sr _ ds4))
  (let-match erased gl (GLCons _ _ _ ub _ pub ab gl1))
  (let-match erased gl1 (GLCons _ _ _ _ _ py1 ay gl2))
  (let-match erased gl2 (GLCons _ _ _ _ _ _ _ gl3))
  (values c2 z gsr2 (prove-subterm gsr2 gsr)
    (MkFan t n db y1 c2 e nd pl rep _ b z fr2 fr (Cons _ a rr) rest gsr2 pm le ln lp lr
      (DartsCons db b _ _ $ DartsCons y1 (Nil _) _ _ $ DartsCons c2 z sr gsr2 ds4) (distinct-drop db y1 c c2 sr dist)
      (drop-step e nd sr b (Nil _) z gsr2 db y1 c c2 pm ch dist) rp al py ry
      (GLCons pl b db ub _ pub ab (GLCons pl (Nil _) y1 _ _ py1 ay gl3)) gf2 pz pr ax rs)))

(def-fns _ $ (erased fan-same : (erased (Nat) t db y1 c a x) (erased (List (Nat)) e nd pl rep b xs rr rest) (erased (List (Group)) gsr)
    (erased (Fan t e nd pl rep db b y1 c (Cons (Nat) x xs) gsr (Cons (Nat) a rr) rest) f) -> (erased (Eq (Nat) x a) q))
  (let-match erased f (MkFan _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ px pr _ _))
  (let-match erased px (LAppCons _ _ _ _ _ _))
  (let-match erased pr (LAppCons _ _ _ _ _ _))
  (Refl _ x))

(def-fns _ $ (erased fan-loop : (erased (Nat) t db y1 c) (erased (List (Nat)) e nd pl rep b xs rest) (subterm erased (List (Nat)) rr)
    (subterm erased (List (Group)) gsr) (erased (Fan t e nd pl rep db b y1 c xs gsr rr rest) f) ->
    (erased (List (Nat)) e2 nd2 pl2 xs2) (erased (Nat) c2) (erased (List (Group)) gsr2)
    (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree pl pl2 (Nil (Nat))) gp)
    (erased (Fan t e2 nd2 pl2 rep db b y1 c2 xs2 gsr2 (Nil (Nat)) rest) f2) (erased (AllJoined e2 pl2 rr t) j))
  (let-match erased rr (Cons _ a rr1)
    ((Nil _) (values e nd pl xs c gsr (AgRefl e (Nil _)) (AgRefl pl (Nil _)) f (AJNil e pl t))))
  (let-match erased xs (Cons _ x xs1)
    ((Nil _)
      (let ((erased c3) (erased z) (erased gsr3) (erased sm) (erased f3)) (fan-drop t db y1 c a e nd pl rep b rr1 rest gsr f))
      (fan-loop t db y1 c3 e nd pl rep b z rest rr (subterm sm) gsr3 f3)))
  (let-match erased (fan-same t db y1 c a x e nd pl rep b xs1 rr1 rest gsr f) (Refl _ _))
  (let ((erased e3) (erased nd3) (erased pl3) (erased x3) (erased ge3) (erased gp3) (erased f3) (erased j3))
    (fan-chord t db y1 c a e nd pl rep b xs1 rr1 rest gsr f))
  (let ((erased e2) (erased nd2) (erased pl2) (erased xs2) (erased c2) (erased gsr2) (erased ge2) (erased gp2) (erased f2) (erased j2))
    (fan-loop t db y1 x3 e3 nd3 pl3 rep b xs1 rest rr1 gsr f3))
  (values e2 nd2 pl2 xs2 c2 gsr2 (AgTrans e e3 e2 (Nil _) ge3 ge2) (AgTrans pl pl3 pl2 (Nil _) gp3 gp2) f2
    (AJCons e2 pl2 rr1 a t (joined-grow e3 pl3 e2 pl2 a t j3 ge2 gp2) j2)))

; The first edge of step t, a pendant at the head group's corner: the head group's items are b ++ yh ++ y3, and yh
; is the head of the run when there is one.
(def-fns _ $ (erased fan-pendant : (erased (Nat) t d) (erased (List (Nat)) e nd pl rep by b y yh y3 fl2 f3 xfr rr rest) (erased (List (Group)) gs3)
    (erased (State t e nd pl rep (Cons (Group) (MkGroup d by) gs3) fl2) st) (erased (LApp (Nat) b y by) pb) (erased (LApp (Nat) yh y3 y) ph)
    (erased (GFlat gs3 f3) g3) (erased (LApp (Nat) y3 f3 xfr) px) (erased (LApp (Nat) rr rest xfr) pr) ->
    (erased (List (Nat)) e2 nd2 pl2 rep2) (erased (Nat) n u) (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree pl pl2 (Nil (Nat))) gp)
    (erased (Fan t e2 nd2 pl2 rep2 d b (Succ n) n y3 gs3 rr rest) f) (erased (AllIs y u) ay)
    (erased (Nth (Nat) e2 n (Succ n)) pe) (erased (Nth (Nat) pl2 n u) pn) (erased (Nth (Nat) pl2 (Succ n) t) pt))
  (let-match erased st (MkState _ n _ _ _ _ _ s _ _ _ pm le ln lp lr ds dist ch rp al gl gf rs))
  (let-match erased ds (DartsCons _ _ sr _ ds1))
  (let-match erased gl (GLCons _ _ _ u _ pu aby gl1))
  (let ((erased ab) (erased ay)) (allis-app b y by u pb aby))
  (let ((erased _) (erased ay3)) (allis-app yh y3 y u ph ay))
  (let ((erased e2) (erased nd1) (erased nd2) (erased g) (erased i1) (erased sn) (erased pm2) (erased ch2))
    (pendant-step e nd sr by b (Nil _) y3 gs3 n d pm le ln ch ds1 dist))
  (let ((erased lt-u)) (alllt-nth pl t d u al pu))
  (let ((erased pl1) (erased sp1)) (snoc-exists _ pl u))
  (let ((erased pl2) (erased sp2)) (snoc-exists _ pl1 t))
  (let ((erased lp1)) (snoc-length _ pl pl1 u n sp1 lp))
  (let ((erased lp2)) (snoc-length _ pl1 pl2 t (Succ n) sp2 lp1))
  (let ((erased rep2) (erased sr2)) (snoc-exists _ rep (Succ n)))
  (let ((erased ln1)) (insert-length nd nd1 d n n i1 ln))
  (let ((erased ln2)) (snoc-length _ nd1 nd2 (Succ n) (Succ n) sn ln1))
  (let ((erased le0) (erased le2)) (grow-length e e2 n g))
  (let ((erased gp)) (AgTrans pl pl1 pl2 (Nil _) (AgSnoc pl pl1 (Nil _) u sp1) (AgSnoc pl1 pl2 (Nil _) t sp2)))
  (let ((erased rp2)) (respects-new pl1 pl2 nd1 nd2 (Succ n) t (respects-insert pl pl1 nd nd1 d n n u rp i1 lp pu sp1) sn lp1 sp2))
  (let ((erased al2)) (alllt-snoc pl1 pl2 (Succ t) t (alllt-snoc pl pl1 (Succ t) u (alllt-succ pl t al) (lt-weaken u t lt-u) sp1) (lt-succ t) sp2))
  (let ((erased pt)) (snoc-new _ pl1 pl2 t (Succ n) sp2 lp1))
  (let ((erased pn)) (agree-nth pl1 pl2 (Nil _) n u (AgSnoc pl1 pl2 (Nil _) t sp2) (snoc-new _ pl pl1 u n sp1 lp) (NotInNil n)))
  (let ((erased gl4)) (GLCons pl2 b d u _ (agree-nth pl pl2 (Nil _) d u gp pu (NotInNil d)) ab
    (GLCons pl2 (Nil _) (Succ n) t _ pt (AllIsNil t) (GLCons pl2 y3 n u gs3 pn ay3
      (grouplab-grow pl1 pl2 gs3 t (grouplab-grow pl pl1 gs3 u gl1 sp1) sp2)))))
  (let-match erased gf (GFlatCons _ _ f4 _ _ pf gf1))
  (let-match erased (flat-fn gs3 f4 f3 gf1 g3) (Refl _ _))
  (let ((erased afl)) (grouplab-lt pl fl2 _ t gl al gf))
  (let ((erased aby2) (erased af3)) (alllt-app-l by f3 fl2 t pf afl))
  (let ((erased _) (erased ay2)) (alllt-app-l b y by t pb aby2))
  (let ((erased _) (erased ay4)) (alllt-app-l yh y3 y t ph ay2))
  (let ((erased ru) (erased pru) (erased rd)) (reps-at nd rep pl (Zero) d d u rs pu (add-zero-right d)))
  (let ((erased rs1)) (reps-grow nd1 nd2 rep2 pl (Succ n) (Zero) (reps-insert nd nd1 rep2 pl d n (Zero) (reps-rep nd rep rep2 pl (Succ n) (Zero) rs sr2) i1 ln) sn))
  (let ((erased rd2)) (nr-snoc nd2 ru d n (nr-grow nd1 nd2 (Succ n) ru d (nr-insert nd nd1 d n ru d rd i1 ln) sn)
    (snoc-old _ nd1 nd2 (Succ n) n d sn (insert-at nd nd1 d n i1))))
  (let ((erased rs2)) (reps-snoc nd2 rep2 pl pl1 (Zero) n n u ru rs1 lp (add-zero-right n) sp1 (snoc-old _ rep rep2 (Succ n) ru u sr2 pru) rd2))
  (let ((erased rs3)) (reps-snoc nd2 rep2 pl1 pl2 (Zero) (Succ n) (Succ n) t (Succ n) rs2 lp1 (add-zero-right (Succ n)) sp2
    (snoc-new _ rep rep2 (Succ n) t sr2 lr) (NRHere nd2 (Succ n))))
  (values e2 nd2 pl2 rep2 n u (grow-agree e e2 n g) gp
    (MkFan t (Succ (Succ n)) d (Succ n) n e2 nd2 pl2 rep2 _ b y3 f3 xfr rr rest gs3 pm2 le2 ln2 lp2 (snoc-length _ rep rep2 (Succ n) t sr2 lr)
      (DartsCons d b _ _ $ DartsCons (Succ n) (Nil _) _ _ $ DartsCons n y3 sr gs3 ds1)
      (distinct-pendant d n sr dist (chain-lt e nd s s _ d n ch ds ln)) ch2 rp2 al2 pt (snoc-new _ rep rep2 (Succ n) t sr2 lr) gl4 g3 px pr
      (alllt-app y3 f3 xfr t px ay4 af3) rs3)
    ay (edge-low e e2 n g) pn pt))

(def-fns _ $ (erased chain-set2 : (erased (List (Nat)) e nd s xb ya yb) (erased (List (Group)) gs) (erased (Nat) d y dn)
    (erased (Chain e nd s (Cons (Group) (MkGroup d xb) $ Cons (Group) (MkGroup y ya) gs) dn) ch) ->
