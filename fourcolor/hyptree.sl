; Euler_tree of jordan.v for planar hypermaps: every edge cycle has a dart z that is fixed by n or f, or not on the edge
; cycle of n z. The proof is not Gonthier's: with c = n . f, whose cycles are the edge cycles, cutting z out of its face
; cycle would lower the genus unless the darts from c z on to the one before z in its face come back to themselves
; under n, and then c z is a dart with a shorter such run.

; The walk up to the first time it reaches u, a dart it leaves; it never leaves u.
(def-fns _ $ (erased path-upto : (erased (List (Nat)) p s xs) (erased (Nat) x y u j) (subterm erased (Path p s x y xs) w) (erased (In u xs) pu)
    (erased (Length (Nat) xs j) l) -> (erased (List (Nat)) ys) (erased (Nat) j2) (erased (Path p (Cons (Nat) u s) x u ys) r)
    (erased (Length (Nat) ys j2) l2) (erased (Lt j2 j) lt))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ px out w1) (absurd (PathHere _ _ _) pu))
  (let-match erased l (LengthCons _ _ _ j1 l1))
  (let-match erased (nat-eq x u) (Unequal _ _ _ _ nxu) ((Equal _ _ _) (values (Nil _) (Zero) (PathHere p _ x) (LengthNil _) (LtZ j1))))
  (let ((erased ys1) (erased j3) (erased w2) (erased l3) (erased lt1)) (path-upto p s xs1 x1 y u j1 w1 (in-tail u x xs1 pu (apart-sym x u nxu)) l1))
  (values (Cons _ x ys1) (Succ j3) (PathStep p _ ys1 x x1 u px (NotInCons x u s nxu out) w2) (LengthCons _ x ys1 j3 l3) (LtS j3 j1 lt1)))

(def-fns _ $ (erased path-add : (erased (List (Nat)) p s xs) (erased (Nat) x y a) (subterm erased (Path p s x y xs) w) (erased (NotIn a xs) out)
    -> (erased (Path p (Cons (Nat) a s) x y xs) r))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ px ox w1) ((PathHere _ _ _) (PathHere p _ x)))
  (let-match erased out (NotInCons _ _ _ ne out1))
  (PathStep p _ xs1 x x1 y px (NotInCons x a s (apart-sym a x ne) ox) (path-add p s xs1 x1 y a w1 out1)))

; Two walks to y: the start of each is on the other.
(def-fns _ $ (erased walks-meet : (erased (Nat) d x x2 y) (erased (List (Nat)) p q s s2 xs ys) (erased (Perm d p q) pm)
    (subterm erased (Path p s x y xs) w) (erased (Path p s2 x2 y ys) v) -> (erased (Or (In x2 (Cons (Nat) y xs)) (In x (Cons (Nat) y ys))) r))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ px out w1) ((PathHere _ _ _) (OrR _ _ (InHere x ys))))
  (let-match erased (walks-meet d x1 x2 y p q s s2 xs1 ys pm w1 v) (OrR _ _ i1) ((OrL _ _ i2) (OrL _ _ (in-skip x2 y x xs1 i2))))
  (let-match erased (nat-eq x1 x2) (Unequal _ _ _ _ ne) ((Equal _ _ _) (OrL _ _ (in-skip x2 y x xs1 (path-start-in p s xs1 x1 y w1)))))
  (let ((erased u) (erased pu) (erased pn)) (path-prev p s2 ys x2 y x1 v i1 ne))
  (let-match erased (perm-inj d u x x1 p q pm pn px) (Refl _ _))
  (OrR _ _ (InThere u y ys pu)))

; A walk that never leaves z, from the dart after a = c z, never leaves a.
(def-fns _ $ (erased fresh-start : (erased (Nat) d x y z a) (erased (List (Nat)) c ci s ys) (erased (Perm d c ci) pc) (erased (Path c s x y ys) w)
    (erased (In z s) iz) (erased (Nth (Nat) c z a) pza) (erased (Nth (Nat) c a x) pax) (erased (Apart (Nat) Lt a z) ne) -> (erased (NotIn a ys) r))
  (let-match erased (in-dec a ys) (OrR _ _ out)
    (absurd (OrL _ _ ia)
      (let-match erased (nat-eq a x) (Unequal _ _ _ _ nax)
        (absurd (Equal _ _ _) (let-match erased (perm-inj d z a a c ci pc pza pax) (Refl _ _)) (apart-irrefl z ne)))
      (let ((erased u) (erased iu) (erased pu)) (path-prev c s ys x y a w (InThere a y ys ia) nax))
      (let-match erased (perm-inj d u z a c ci pc pu pza) (Refl _ _))
      (apart-irrefl u (notin-in u u ys (path-avoid c s ys x y u w iz) iu))))
  out)

(def-fns _ $ (erased path-under : (erased (Nat) d x y) (erased (List (Nat)) p q s xs) (erased (Perm d p q) pm) (subterm erased (Path p s x y xs) w)
    (erased (Lt x d) lx) -> (erased (Under xs d) u) (erased (Lt y d) ly))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ px out w1) ((PathHere _ _ _) (values (UnderNil d) lx)))
  (let ((erased u1) (erased ly)) (path-under d x1 y p q s xs1 pm w1 (perm-val d x x1 p q pm px)))
  (values (UnderCons xs1 x d lx u1) ly))

(def-fns _ $ (erased path-from : (erased (List (Nat)) p s xs) (erased (Nat) x y u) (subterm erased (Path p s x y xs) w) (erased (In u xs) pu)
    -> (erased (SomePath p s u y) r))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ px out w1) (absurd (PathHere _ _ _) pu))
  (let-match erased (nat-eq u x) (Unequal _ _ _ _ ne) ((Equal _ _ _) (MkSomePath p s _ u y w)))
  (path-from p s xs1 x1 y u w1 (in-tail u x xs1 pu ne)))

; The cycle of c through x0: the walk cs from y0 = c x0 back to x0, its darts x0 :: cs.
(def-fns _ $ (erased orbit-step : (erased (Nat) d x0 y0 a b) (erased (List (Nat)) c ci cs) (erased (Perm d c ci) pc) (erased (Nth (Nat) c x0 y0) p0)
    (erased (Path c (Nil (Nat)) y0 x0 cs) cy) (erased (In a (Cons (Nat) x0 cs)) ia) (erased (Nth (Nat) c a b) pab) -> (erased (In b (Cons (Nat) x0 cs)) r))
  (let-match erased ia (InThere _ _ _ ia1)
    ((InHere _ _) (let-match erased (nth-fn _ c x0 b y0 pab p0) (Refl _ _)) (path-start-in c _ cs y0 x0 cy)))
  (path-next c _ cs y0 x0 a b cy ia1 pab))

(def-fns _ $ (erased orbit-prev : (erased (Nat) d x0 y0 a b) (erased (List (Nat)) c ci cs) (erased (Perm d c ci) pc) (erased (Nth (Nat) c x0 y0) p0)
    (erased (Path c (Nil (Nat)) y0 x0 cs) cy) (erased (In b (Cons (Nat) x0 cs)) ib) (erased (Nth (Nat) c a b) pab) -> (erased (In a (Cons (Nat) x0 cs)) r))
  (let-match erased (nat-eq b y0) (Unequal _ _ _ _ ne)
    ((Equal _ _ _) (let-match erased (perm-inj d a x0 b c ci pc pab p0) (Refl _ _)) (InHere a cs)))
  (let ((erased v) (erased iv) (erased pv)) (path-prev c _ cs y0 x0 b cy ib ne))
  (let-match erased (perm-inj d v a b c ci pc pv pab) (Refl _ _))
  (InThere v x0 cs iv))

(def-fns _ $ (erased orbit-walk-in : (erased (Nat) d x0 y0 a y) (erased (List (Nat)) c ci cs s ys) (erased (Perm d c ci) pc) (erased (Nth (Nat) c x0 y0) p0)
    (erased (Path c (Nil (Nat)) y0 x0 cs) cy) (erased (In a (Cons (Nat) x0 cs)) ia) (subterm erased (Path c s a y ys) w) -> (erased (In y (Cons (Nat) x0 cs)) r))
  (let-match erased w (PathStep _ _ ys1 _ a1 _ pa out w1) ((PathHere _ _ _) ia))
  (orbit-walk-in d x0 y0 a1 y c ci cs s ys1 pc p0 cy (orbit-step d x0 y0 a a1 c ci cs pc p0 cy ia pa) w1))

(def-fns _ $ (erased orbit-root : (erased (Nat) d x0 y0 a) (erased (List (Nat)) c cs) (erased (Path c (Nil (Nat)) y0 x0 cs) cy)
    (erased (In a (Cons (Nat) x0 cs)) ia) -> (erased (SomePath c (Nil (Nat)) a x0) r))
  (let-match erased ia (InThere _ _ _ ia1) ((InHere _ _) (MkSomePath c _ _ x0 x0 (PathHere c _ x0))))
  (path-from c _ cs y0 x0 a cy ia1))

(def-fns _ $ (erased orbit-conn : (erased (Nat) d x0 y0 a b) (erased (List (Nat)) c cs) (erased (List (Bond)) gc) (erased (Graph d c gc) gr)
    (erased (Path c (Nil (Nat)) y0 x0 cs) cy) (erased (In a (Cons (Nat) x0 cs)) ia) (erased (In b (Cons (Nat) x0 cs)) ib) -> (erased (Conn gc a b) r))
  (let-match erased (orbit-root d x0 y0 a c cs cy ia) (MkSomePath _ _ xs _ _ wa))
  (let-match erased (orbit-root d x0 y0 b c cs cy ib) (MkSomePath _ _ ys _ _ wb))
  (conn-cat gc a x0 b (path-graph-conn d a x0 c _ xs gc wa gr) (conn-sym gc b x0 (path-graph-conn d b x0 c _ ys gc wb gr))))

; Every dart a of s is moved by n and by f, and n a is in o.
(def-adts $ (Good : ((List (Nat)) n f o s) -> Type)
  enum
  (many GoodNil : (erased (List (Nat)) n f o) -> (Good n f o (Nil (Nat))))
  (many GoodCons : (erased (List (Nat)) n f o s) (erased (Nat) a b a2) (erased (Nth (Nat) n a b) pb) (erased (Apart (Nat) Lt b a) nb)
      (erased (Nth (Nat) f a a2) pa2) (erased (Apart (Nat) Lt a2 a) na2) (erased (In b o) ib) (erased (Good n f o s) rest)
      -> (Good n f o (Cons (Nat) a s))))

; A dart a of s that is fixed by n or f, or whose image under n is not in o.
(def-adts $ (Bad : ((List (Nat)) n f o s) -> Type)
  enum
  (many BadNode : (erased (List (Nat)) n f o s) (erased (Nat) a) (erased (In a s) ia) (erased (Nth (Nat) n a a) pa) -> (Bad n f o s))
  (many BadFace : (erased (List (Nat)) n f o s) (erased (Nat) a) (erased (In a s) ia) (erased (Nth (Nat) f a a) pa) -> (Bad n f o s))
  (many BadOut : (erased (List (Nat)) n f o s) (erased (Nat) a b) (erased (In a s) ia) (erased (Nth (Nat) n a b) pb) (erased (NotIn b o) out)
      -> (Bad n f o s)))

(def-fns _ $ (erased good-at : (erased (List (Nat)) n f o s) (erased (Nat) a b a2) (subterm erased (Good n f o s) gd) (erased (In a s) ia)
    (erased (Nth (Nat) n a b) pb) (erased (Nth (Nat) f a a2) pa2) -> (erased (Apart (Nat) Lt b a) nb) (erased (Apart (Nat) Lt a2 a) na2) (erased (In b o) ib))
  (let-match erased gd (GoodCons _ _ _ s1 a1 b1 c1 pb1 nb1 pc1 nc1 ib1 gd1) (absurd (GoodNil _ _ _) ia))
  (let-match erased ia (InThere _ _ _ ia1)
    ((InHere _ _)
      (let-match erased (nth-fn _ n a b b1 pb pb1) (Refl _ _))
      (let-match erased (nth-fn _ f a a2 c1 pa2 pc1) (Refl _ _))
      (values nb1 nc1 ib1)))
  (good-at n f o s1 a b a2 gd1 ia1 pb pa2))

(def-fns _ $ (erased bad-cons : (erased (List (Nat)) n f o s) (erased (Nat) a) (erased (Bad n f o s) bd) -> (erased (Bad n f o (Cons (Nat) a s)) r))
  (match erased bd _
    ((BadNode _ _ _ _ x ix px) (BadNode n f o _ x (InThere x a s ix) px))
    ((BadFace _ _ _ _ x ix px) (BadFace n f o _ x (InThere x a s ix) px))
    ((BadOut _ _ _ _ x y ix px out) (BadOut n f o _ x y (InThere x a s ix) px out))))

(def-fns _ $ (erased good-dec : (erased (Nat) d) (erased (List (Nat)) n ni f fi o s) (erased (Perm d n ni) pn) (erased (Perm d f fi) pf)
    (subterm erased (Under s d) u) -> (erased (Or (Bad n f o s) (Good n f o s)) r))
  (let-match erased u (UnderCons s1 a _ la u1) ((UnderNil _) (OrR _ _ (GoodNil n f o))))
  (let ((erased b) (erased pb) (erased _)) (perm-nth d a n ni pn la))
  (let ((erased a2) (erased pa2) (erased _)) (perm-nth d a f fi pf la))
  (let-match erased (nat-eq b a) (Unequal _ _ _ _ nb) ((Equal _ _ _) (OrL _ _ (BadNode n f o _ a (InHere a s1) pb))))
  (let-match erased (nat-eq a2 a) (Unequal _ _ _ _ na2) ((Equal _ _ _) (OrL _ _ (BadFace n f o _ a (InHere a s1) pa2))))
  (let-match erased (in-dec b o) (OrL _ _ ib) ((OrR _ _ out) (OrL _ _ (BadOut n f o _ a b (InHere a s1) pb out))))
  (match erased (good-dec d n ni f fi o s1 pn pf u1) _
    ((OrL _ _ bd) (OrL _ _ (bad-cons n f o s1 a bd)))
    ((OrR _ _ gd) (OrR _ _ (GoodCons n f o s1 a b a2 pb nb pa2 na2 ib gd)))))

; The descent: z on the cycle o of c, w the dart before z in its face, a1 = c z, and a walk from a1 to w that leaves
; neither z nor w, j < N steps long.
(def-fns _ $ (erased tree-go : (subterm erased (Nat) N) (erased (Nat) d j z w a1 x0 y0) (erased (List (Nat)) e n f c cs xs) (erased (Hypermap d e n f) h)
    (erased (Genus d e n f (Zero)) g) (erased (Respects n f c) rc) (erased (Nth (Nat) c x0 y0) p0) (erased (Path c (Nil (Nat)) y0 x0 cs) cy)
    (erased (Good n f (Cons (Nat) x0 cs) (Cons (Nat) x0 cs)) gd) (erased (In z (Cons (Nat) x0 cs)) iz) (erased (In w (Cons (Nat) x0 cs)) iw)
    (erased (Nth (Nat) c z a1) pza1) (erased (Path c (Cons (Nat) z (Cons (Nat) w (Nil (Nat)))) a1 w xs) wb) (erased (Length (Nat) xs j) lxs)
    (erased (Lt j N) ljn) (erased (Nth (Nat) f w z) pfw) -> (erased (False) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased ci) (erased rci) (erased pc)) (perm-comp d n ni f fi c pmn pmf rc))
  (let ((erased uo) (erased lx0)) (path-under d y0 x0 c ci _ cs pc cy (perm-val d x0 y0 c ci pc p0)))
  (let ((erased uO)) (UnderCons cs x0 d lx0 uo))
  (let ((erased ia1)) (orbit-step d x0 y0 z a1 c ci cs pc p0 cy iz pza1))
  (let ((erased la1)) (perm-val d z a1 c ci pc pza1))
  (let ((erased b) (erased pb) (erased _)) (perm-nth d a1 n ni pmn la1))
  (let ((erased fa1) (erased pfa1) (erased _)) (perm-nth d a1 f fi pmf la1))
  (let ((erased nba1) (erased nfa1) (erased ib)) (good-at n f _ _ a1 b fa1 gd ia1 pb pfa1))
  (let ((erased lz)) (perm-val d w z f fi pmf pfw))
  (let ((erased fz) (erased pfz) (erased _)) (perm-nth d z f fi pmf lz))
  (let ((erased nz) (erased pnz) (erased _)) (perm-nth d z n ni pmn lz))
  (let ((erased _) (erased nfz) (erased _)) (good-at n f _ _ z nz fz gd iz pnz pfz))
  (let-match erased (nat-eq w z) (Unequal _ _ _ _ nwz)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ f w z fz pfw pfz) (Refl _ _)) (apart-irrefl w nfz)))
  (let ((erased lw)) (nth-lt-length _ f w d z pfw (perm-length d f fi pmf)))
  (let-match erased (in-dec b (Cons _ w xs)) (OrL _ _ inb)
    ((OrR _ _ outb)
      (let ((erased gc) (erased grc)) (perm-graph d c ci pc))
      (let ((erased ys0) (erased wb0)) (conn-path d b w c ci gc pc grc (orbit-conn d x0 y0 b w c cs gc grc cy ib iw)))
      (let ((erased ys) (erased wb1)) (cut-first c _ ys0 b w wb0))
      (let-match erased (walks-meet d a1 b w c ci _ _ xs ys pc wb wb1) (OrR _ _ ia1y)
        (absurd (OrL _ _ i) (apart-irrefl b (notin-in b b _ outb i))))
      (let ((erased u) (erased iu) (erased pu)) (path-prev c _ ys b w a1 wb1 ia1y (apart-sym b a1 nba1)))
      (let-match erased (perm-inj d u z a1 c ci pc pu pza1) (Refl _ _))
      (let ((erased k) (erased lys)) (length-exists _ ys))
      (let ((erased zs) (erased _) (erased wz) (erased _) (erased _)) (path-upto c _ ys b w z k wb1 iu lys))
      (face-drop d w z a1 b e n f c _ (Cons _ z xs) xs zs h g rc pfw nwz lw (PathStep c _ xs z a1 w pza1 (NotInNil z) (path-forget c _ xs a1 w wb))
        (InThere w z _ (InHere w _)) (InHere z _) pb wb wz)))
  (let ((erased v) (erased iv) (erased pcv)) (path-prev c _ xs a1 w b wb inb nba1))
  (let ((erased lv)) (nth-lt-length _ c v d b pcv (perm-length d c ci pc)))
  (let ((erased fv) (erased pfv) (erased _)) (perm-nth d v f fi pmf lv))
  (let-match erased (perm-inj d fv a1 b n ni pmn (respects-nth n f c v fv b rc pfv pcv) pb) (Refl _ _))
  (let-match erased wb (PathStep _ _ xs2 _ a2 _ pa12 outa1 wb2) (absurd (PathHere _ _ _) iv))
  (let-match erased lxs (LengthCons _ _ _ j1 lxs2))
  (let-match erased (nat-eq v a1) (Unequal _ _ _ _ nva1)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ f a1 fa1 a1 pfa1 pfv) (Refl _ _)) (apart-irrefl a1 nfa1)))
  (let ((erased ys) (erased j2) (erased wv) (erased lys) (erased lt2)) (path-upto c _ xs2 a2 w v j1 wb2 (in-tail v a1 xs2 iv nva1) lxs2))
  (let ((erased outa)) (fresh-start d a2 v z a1 c ci _ ys pc wv (InThere z v _ (InHere z _)) pza1 pa12 (notin-in a1 z _ outa1 (InHere z _))))
  (let ((erased wv2)) (path-add c _ ys a2 v a1 (path-add c _ ys a2 v v (path-forget c _ ys a2 v wv) (path-avoid c _ ys a2 v v wv (InHere v _))) outa))
  (let-match erased N (Succ N1) (absurd (Zero) ljn))
  (tree-go N1 d j2 a1 v a2 x0 y0 e n f c cs ys h g rc p0 cy gd ia1 (orbit-prev d x0 y0 v b c ci cs pc p0 cy ib pcv) pa12 wv2 lys
    (lt-trans j2 j1 N1 lt2 (lt-pred j1 N1 ljn)) pfv))

; A dart z on the edge cycle of x that is fixed by n or f, or not on the edge cycle of n z (clink z z || ~~ cross_edge z).
(def-adts $ (Leaf : ((List (Nat)) e n f) ((Nat) x) -> Type)
  enum
  (many LeafNode : (erased (List (Nat)) e n f) (erased (Nat) x z) (erased (SomePath e (Nil (Nat)) x z) w) (erased (Nth (Nat) n z z) pz)
      -> (Leaf e n f x))
  (many LeafFace : (erased (List (Nat)) e n f) (erased (Nat) x z) (erased (SomePath e (Nil (Nat)) x z) w) (erased (Nth (Nat) f z z) pz)
      -> (Leaf e n f x))
  (many LeafCut : (erased (List (Nat)) e n f) (erased (Nat) x z z2) (erased (SomePath e (Nil (Nat)) x z) w) (erased (Nth (Nat) n z z2) pz)
      (erased (Seps e z z2) sp) -> (Leaf e n f x)))

(def-fns _ $ (erased under-in : (erased (List (Nat)) xs) (erased (Nat) x d) (subterm erased (Under xs d) u) (erased (In x xs) ix) -> (erased (Lt x d) r))
  (let-match erased u (UnderCons xs1 y _ ly u1) (absurd (UnderNil _) ix))
  (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) ly))
  (under-in xs1 x d u1 ix1))

(def-fns _ $ (erased orbit-e-walk : (erased (Nat) d x0 y0 a) (erased (List (Nat)) e c cs) (erased (Perm d e c) pe)
    (erased (Path c (Nil (Nat)) y0 x0 cs) cy) (erased (In a (Cons (Nat) x0 cs)) ia) -> (erased (SomePath e (Nil (Nat)) x0 a) r))
  (let ((erased pc)) (perm-sym d e c pe))
  (let ((erased gc) (erased grc)) (perm-graph d c e pc))
  (let ((erased ge) (erased gre)) (perm-graph d e c pe))
  (let ((erased xs) (erased w)) (conn-path d x0 a e c ge pe gre
    (spans-conn ge gc x0 a (orbit-conn d x0 y0 x0 a c cs gc grc cy (InHere x0 cs) ia) (spans-inv d e c ge gc (graph-fun d c gc grc) pc gre))))
  (MkSomePath e _ xs x0 a w))

(def-fns _ $ (erased bad-leaf : (erased (Nat) d x0 y0) (erased (List (Nat)) e n f c ni cs) (erased (Perm d e c) pe) (erased (Perm d n ni) pn)
    (erased (Nth (Nat) c x0 y0) p0) (erased (Path c (Nil (Nat)) y0 x0 cs) cy) (erased (Under (Cons (Nat) x0 cs) d) uo)
    (erased (Bad n f (Cons (Nat) x0 cs) (Cons (Nat) x0 cs)) bd) -> (erased (Leaf e n f x0) r))
  (let-match erased bd (BadOut _ _ _ _ a b ia pab out)
    ((BadNode _ _ _ _ a ia pa) (LeafNode e n f x0 a (orbit-e-walk d x0 y0 a e c cs pe cy ia) pa))
    ((BadFace _ _ _ _ a ia pa) (LeafFace e n f x0 a (orbit-e-walk d x0 y0 a e c cs pe cy ia) pa)))
  (let ((erased pc)) (perm-sym d e c pe))
  (let ((erased gc) (erased grc)) (perm-graph d c e pc))
  (let ((erased ge) (erased gre)) (perm-graph d e c pe))
  (let ((erased ke) (erased oe)) (orbits-exists d e c pe))
  (let-match erased (orbits-dec d ke a b e c pe oe (under-in _ a d uo ia) (perm-val d a b n ni pn pab)) (OrR _ _ sp)
    (absurd (OrL _ _ sab)
      (let-match erased sab (MkSomePath _ _ ys _ _ wab))
      (let ((erased zs) (erased wc)) (conn-path d a b c e gc pc grc
        (spans-conn gc ge a b (path-graph-conn d a b e _ ys ge wab gre) (spans-inv d c e gc ge (graph-fun d e ge gre) pe grc))))
      (apart-irrefl b (notin-in b b _ out (orbit-walk-in d x0 y0 a b c e cs _ zs pc p0 cy ia wc)))))
  (LeafCut e n f x0 a b (orbit-e-walk d x0 y0 a e c cs pe cy ia) pab sp))

; Euler_tree, for a hypermap of genus 0.
(def-fns _ $ (erased euler-tree : (erased (Nat) d x0) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (Lt x0 d) lx0) -> (erased (Leaf e n f x0) r))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased pc)) (perm-sym d e c pe))
  (let ((erased y0) (erased p0) (erased ly0)) (perm-nth d x0 c e pc lx0))
  (let ((erased cs) (erased cy)) (cycle d x0 y0 c e pc p0 lx0))
  (let ((erased uo) (erased _)) (path-under d y0 x0 c e _ cs pc cy ly0))
  (let ((erased uO)) (UnderCons cs x0 d lx0 uo))
  (let-match erased (good-dec d n ni f fi (Cons _ x0 cs) (Cons _ x0 cs) pmn pmf uO) (OrL _ _ bd)
    (absurd (OrR _ _ gd)
      (let ((erased gc) (erased grc)) (perm-graph d c e pc))
      (let ((erased b0) (erased pb0) (erased lb0)) (perm-nth d x0 n ni pmn lx0))
      (let ((erased fx0) (erased pfx0) (erased _)) (perm-nth d x0 f fi pmf lx0))
      (let ((erased w) (erased pw) (erased lw)) (perm-nth d b0 e c pe lb0))
      (let ((erased pfw)) (hyper-third d w b0 x0 e n f h pw pb0))
      (let ((erased _) (erased _) (erased ib0)) (good-at n f _ _ x0 b0 fx0 gd (InHere x0 cs) pb0 pfx0))
      (let ((erased cw) (erased pcw)) (nth-exists _ c d w (perm-length d c e pc) lw))
      (let-match erased (nth-fn _ n x0 cw b0 (respects-nth n f c w x0 cw rc pfw pcw) pb0) (Refl _ _))
      (let ((erased iw)) (orbit-prev d x0 y0 w b0 c e cs pc p0 cy ib0 pcw))
      (let ((erased ws) (erased ww)) (conn-path d y0 w c e gc pc grc (orbit-conn d x0 y0 y0 w c cs gc grc cy (path-start-in c _ cs y0 x0 cy) iw)))
      (let ((erased ws1) (erased ww1)) (cut-first c _ ws y0 w ww))
      (let-match erased (same-path c _ y0 w (cut-last c _ ws1 y0 w x0 y0 ww1 p0)) (MkSomePath _ _ ws2 _ _ ww2))
      (let ((erased j) (erased lj)) (length-exists _ ws2))
      (tree-go (Succ j) d j x0 w y0 x0 y0 e n f c cs ws2 h g rc p0 cy gd (InHere x0 cs) iw p0 ww2 lj (lt-succ j) pfw)))
  (bad-leaf d x0 y0 e n f c ni cs pe pmn p0 cy uO bd))
