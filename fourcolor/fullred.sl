  (many TsOne : (erased (List (Nat)) lab lr S) (erased (Nat) y l) (erased (In y S) iy) (erased (Nth (Nat) lab y l) pl) (erased (NotIn l lr) ol)
      (erased (AllLab lab (Cons (Nat) l lr) S) al) -> (TrivSide lab lr S (Succ (Zero)))))

