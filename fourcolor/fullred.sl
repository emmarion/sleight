(def-adts $ (TrivRed : -> Type)
  enum
  (many MkTrivRed : (erased (Level) G)
      (erased (Fn G (erased (Level) B) (erased (Predates (Level) (level-of birk-glue) B) pbk) (erased (BirkhoffChecks) bks) (erased (Nat) dc dm)
