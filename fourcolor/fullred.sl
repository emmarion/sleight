; embed5.sl's FullRed, after embed_full of embed.v, with minimality as data. Load after embed5.sl, in its chain. That these
; statements match Coq's has been checked only by reading.

; radius2 of embeddable as a certificate over the kernel as: from the face of x0, each kernel dart x is two edge steps away,
; x0 ~ a, edge a = ea in as, ea ~ eb = edge b, b ~ x (~ the faces of the configuration map).
(def-adts $ (R2At : ((List (Nat)) ec fc as) ((Nat) x0 x) -> Type)
  enum
  (many MkR2At : (erased (List (Nat)) ec fc as) (erased (Nat) x0 x a ea b eb) (erased (SomePath fc (Nil (Nat)) x0 a) pa) (erased (Nth (Nat) ec a ea) pea)
      (erased (In ea as) iea) (erased (SomePath fc (Nil (Nat)) ea eb) pab) (erased (Nth (Nat) ec b eb) peb) (erased (SomePath fc (Nil (Nat)) b x) pb)
      -> (R2At ec fc as x0 x)))

(def-adts $ (R2All : ((List (Nat)) ec fc as) ((Nat) x0) ((List (Nat)) xs) -> Type)
  enum
  (many R2Nil : (erased (List (Nat)) ec fc as) (erased (Nat) x0) -> (R2All ec fc as x0 (Nil (Nat))))
  (many R2Cons : (erased (List (Nat)) ec fc as xs) (erased (Nat) x0 x) (erased (R2At ec fc as x0 x) p) (erased (R2All ec fc as x0 xs) rest)
      -> (R2All ec fc as x0 (Cons (Nat) x xs))))

(def-adts $ (Radius2 : ((List (Nat)) ec fc as) -> Type)
  enum
  (many MkRadius2 : (erased (List (Nat)) ec fc as) (erased (Nat) x0) (erased (In x0 as) i0) (erased (R2All ec fc as x0 as) ra) -> (Radius2 ec fc as)))

(def-fns _ $ (erased r2-at : (erased (List (Nat)) ec fc as xs) (erased (Nat) x0 x) (subterm erased (R2All ec fc as x0 xs) ra) (erased (In x xs) ix)
    -> (erased (R2At ec fc as x0 x) r))
  (let-match erased ra (R2Cons _ _ _ xs1 _ y p ra1) (absurd (R2Nil _ _ _ _) ix))
  (match erased ix _ ((InHere _ _) p) ((InThere _ _ _ ix1) (r2-at ec fc as xs1 x0 x ra1 ix1))))

; A walk x0 :: p along rlink of the configuration map ending at z, p in the kernel: the hom ring of embed_full, before it is
; made simple, and a simple one, its images on distinct faces of the map (labelled by lab).
(def-adts $ (ShortP : ((List (Nat)) ec fc hl lab as) ((Nat) x0 z k) -> Type)
  enum
  (many MkShortP : (erased (List (Nat)) ec fc hl lab as q hq lq) (erased (Nat) x0 z k k2) (erased (RPath ec fc x0 q z) rq) (erased (Within q as) wq)
      (erased (Respects hl q hq) rh) (erased (Respects lab hq lq) rl) (erased (Distinct lq) dl) (erased (Length (Nat) q k2) lk) (erased (Lt k2 (Succ k)) lt)
      -> (ShortP ec fc hl lab as x0 z k)))

; pre_hom_ring x p with ~~ rlink (last x p) x and at most five darts: x :: p an rlink walk of kernel darts of the configuration
; map whose image is a ring of the map, and the edge image ez of its last dart z on another face than x.
(def-adts $ (HomBad : ((List (Nat)) ec fc em fm as hl) -> Type)
  enum
  (many MkHomBad : (erased (List (Nat)) ec fc em fm as hl p hp) (erased (Nat) x z hx ez k) (erased (RPath ec fc x p z) rp) (erased (Within (Cons (Nat) x p) as) wp)
      (erased (Respects hl (Cons (Nat) x p) (Cons (Nat) hx hp)) rh) (erased (Ring em fm hx hp) rg) (erased (Length (Nat) (Cons (Nat) x p) k) lk) (erased (Lt k 6) l6)
      (erased (Nth (Nat) ec z ez) pez) (erased (Kernel fc (Cons (Nat) x (Nil (Nat))) ez) nr) -> (HomBad ec fc em fm as hl)))

(def-fns _ $ (erased gc-inv : (erased (Nat) dc x y) (erased (List (Nat)) ec nc rc as) (erased (GcOK dc ec nc rc as) ok) (erased (Length (Nat) ec dc) le)
    (erased (Nth (Nat) ec x y) py) -> (erased (Nth (Nat) ec y x) r))
  (let-match erased (gc-at dc x ec nc rc as ok (nth-lt-length _ ec x dc y py le)) (MkGcAt _ _ _ _ _ ex nx pe pe2 pn rs ep cl cs))
  (let-match erased (nth-fn _ ec x y ex py pe) (Refl _ _))
  pe2)

(def-fns _ $ (erased facelab-rf : (erased (Nat) d) (erased (List (Nat)) f lab) (erased (FaceLab d f lab) fl) -> (erased (Respects lab f lab) r))
  (let-match erased fl (MkFaceLab _ k _ fi _ ids rs gf pf gr io ro cl ll))
  (const-respects lab ids f lab gf (graph-zip d f ids gf gr io) cl (respects-id-right d ids lab io ll)))

(def-fns _ $ (erased within-split : (erased (List (Nat)) B q as) (subterm erased (List (Nat)) A) (erased (AppN A B q) ap) (erased (Within q as) w)
    -> (erased (Within A as) wa) (erased (Within B as) wb))
  (let-match erased ap (AppCons A1 _ q1 a ap1) ((AppNil _) (values (WNil as) w)))
  (let-match erased w (WCons _ _ _ ia w1))
  (let ((erased wa) (erased wb)) (within-split B q1 as A1 ap1 w1))
  (values (WCons as a A1 ia wa) wb))

(def-fns _ $ (erased within-app : (erased (List (Nat)) B q as) (subterm erased (List (Nat)) A) (erased (AppN A B q) ap) (erased (Within A as) wa)
    (erased (Within B as) wb) -> (erased (Within q as) w))
  (let-match erased ap (AppCons A1 _ q1 a ap1) ((AppNil _) wb))
  (let-match erased wa (WCons _ _ _ ia wa1))
  (WCons as a q1 ia (within-app B q1 as A1 ap1 wa1 wb)))

(def-fns _ $ (erased resp-app : (erased (List (Nat)) lab Y Z ly) (subterm erased (List (Nat)) X) (erased (AppN X Y Z) ap) (erased (List (Nat)) lx)
    (erased (Respects lab X lx) rx) (erased (Respects lab Y ly) ry) -> (erased (List (Nat)) lz) (erased (Respects lab Z lz) rz) (erased (AppN lx ly lz) al))
  (let-match erased ap (AppCons X1 _ Z1 a ap1) ((AppNil _) (let-match erased rx (RespNil _)) (values ly ry (AppNil ly))))
  (let-match erased rx (RespCons _ _ lx1 _ l pl rx1))
  (let ((erased lz1) (erased rz1) (erased al1)) (resp-app lab Y Z1 ly X1 ap1 lx1 rx1 ry))
  (values (Cons _ l lz1) (RespCons lab Z1 lz1 a l pl rz1) (AppCons lx1 ly lz1 l al1)))

; The images of an rlink walk of kernel darts are an rlink walk of the map (cface_ac_h with embed_functor).
(def-fns _ $ (erased rpath-h : (erased (Nat) dc dm a b wa) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl P hP) (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en)
    (erased (FunctorAll ec em as hl as) fu) (erased (In a as) ia) (subterm erased (RPath ec fc a P b) rp) (erased (Within P as) wp) (erased (Respects hl P hP) rh)
    (erased (Nth (Nat) hl a wa) pa) -> (erased (Nat) wb) (erased (Nth (Nat) hl b wb) pb) (erased (RPath em fm wa hP wb) r))
  (let-match erased rp (RPCons _ _ P1 _ ea z _ pe sp rp1) ((RPNil _ _ _) (let-match erased rh (RespNil _)) (values wa pa (RPNil em fm wa))))
  (let-match erased wp (WCons _ _ _ iz wp1))
  (let-match erased rh (RespCons _ _ hP1 _ wz pz rh1))
  (let-match erased sp (MkSomePath _ _ xs _ _ pth))
  (let ((erased iea)) (ker-path-inv dc dm ea z ec nc fc ksc rc em nm fm ksm as hl (Nil _) xs en iz pth))
  (let ((erased v) (erased pv) (erased pm)) (functor-at ec em as hl as a ea wa fu ia pe iea pa))
  (let ((erased v2) (erased pv2) (erased spm)) (face-h dc dm ea z v ec nc fc ksc rc em nm fm ksm as hl (Nil _) xs en iea pth pv))
  (let-match erased (nth-fn _ hl z v2 wz pv2 pz) (Refl _ _))
  (let ((erased wb) (erased pb) (erased r1)) (rpath-h dc dm z b wz ec nc fc ksc rc em nm fm ksm as hl P1 hP1 en fu iz rp1 wp1 rh1 pz))
  (values wb pb (RPCons em fm hP1 wa v wz wb pm spm r1)))


; ~~ rlink z x, or z = t, where edge t = s, s ~ x and h (edge z) = h s (through cface_inj_embed).
(def-fns _ $ (erased nrl : (erased (Nat) dc dm z ez x s t u wz) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl) (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en)
    (erased (FunctorAll ec em as hl as) fu) (erased (In z as) iz) (erased (In x as) ix) (erased (Nth (Nat) ec z ez) pez)
    (erased (Nth (Nat) ec t s) pts) (erased (SomePath fc (Nil (Nat)) s x) sx) (erased (Nth (Nat) hl s u) pu) (erased (Nth (Nat) hl z wz) pz) (erased (Nth (Nat) em wz u) pm)
    -> (erased (Or (Kernel fc (Cons (Nat) x (Nil (Nat))) ez) (Eq (Nat) z t)) r))
  (let ((erased nfc) (erased nic) (erased fic) (erased nfm) (erased nim) (erased fim) (erased qe) (erased qn) (erased qf) (erased qem) (erased qnm) (erased qfm))
    (hc-perms dc dm ec nc fc ksc rc em nm fm ksm as hl en))
  (let ((erased gf) (erased gr)) (perm-graph dc fc fic qf))
  (let ((erased lx)) (ker-lt dc dm x ec nc fc ksc rc em nm fm ksm as hl en ix))
  (let ((erased lez)) (perm-val dc z ez ec nfc qe pez))
  (match erased (band-dec dc ez fc fic (Cons _ x (Nil _)) gf qf gr (UnderCons (Nil _) x dc lx (UnderNil dc)) lez) _
    ((OrR _ _ k) (OrL _ _ k))
    ((OrL _ _ fb)
      (let-match erased fb (MkFband _ _ _ x2 ix2 spz))
      (let-match erased ix2 (InHere _ _) (absurd (InThere _ _ _ i) i))
      (let-match erased sx (MkSomePath _ _ ws _ _ pw))
      (let ((erased is)) (ker-path-inv dc dm s x ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws en ix pw))
      (let-match erased (some-cat fc ez x s spz (some-sym dc s x fc fic qf sx (ker-lt dc dm s ec nc fc ksc rc em nm fm ksm as hl en is))) (MkSomePath _ _ ys _ _ pzs))
      (let-match erased spz (MkSomePath _ _ zs _ _ pzx))
      (let ((erased iez)) (ker-path-inv dc dm ez x ec nc fc ksc rc em nm fm ksm as hl (Nil _) zs en ix pzx))
      (let ((erased v) (erased pv) (erased pmv)) (functor-at ec em as hl as z ez wz fu iz pez iez pz))
      (let-match erased (nth-fn _ em wz v u pmv pm) (Refl _ _))
      (let-match erased (cface-inj dc dm ez s v ec nc fc ksc rc em nm fm ksm as hl (Nil _) ys en iez pzs pv pu) (Refl _ _))
      (OrR _ _ (perm-inj dc z t ez ec nfc qe pez pts)))))

(def-fns _ $ (erased within-in : (erased (List (Nat)) as) (erased (Nat) x) (subterm erased (List (Nat)) xs) (erased (Within xs as) w) (erased (In x xs) ix) -> (erased (In x as) r))
  (let-match erased w (WCons _ y xs1 iy w1) (absurd (WNil _) ix))
  (match erased ix _ ((InHere _ _) iy) ((InThere _ _ _ ix1) (within-in as x xs1 w1 ix1))))

(def-fns _ $ (erased suffix-le : (erased (List (Nat)) Y Z) (erased (Nat) n) (subterm erased (List (Nat)) X) (erased (AppN X Y Z) ap) (erased (Length (Nat) Z n) lz)
    -> (erased (Nat) m) (erased (Length (Nat) Y m) ly) (erased (Lt m (Succ n)) lt))
  (let-match erased ap (AppCons X1 _ Z1 a ap1) ((AppNil _) (values n lz (lt-succ n))))
  (let-match erased lz (LengthCons _ _ _ n1 lz1))
  (let ((erased m) (erased ly) (erased lt)) (suffix-le Y Z1 n1 X1 ap1 lz1))
  (values m ly (lt-weaken m (Succ n1) lt)))

(def-fns _ $ (erased snoc-le : (erased (List (Nat)) Y Z W) (erased (Nat) y y2 n) (subterm erased (List (Nat)) X) (erased (AppN X (Cons (Nat) y Y) Z) ap)
    (erased (AppN X (Cons (Nat) y2 (Nil (Nat))) W) aw) (erased (Length (Nat) Z n) lz) -> (erased (Nat) m) (erased (Length (Nat) W m) lw) (erased (Lt m (Succ n)) lt))
  (let-match erased ap (AppCons X1 _ Z1 a ap1)
    ((AppNil _) (let-match erased aw (AppNil _)) (let-match erased lz (LengthCons _ _ _ n1 _))
      (values (Succ (Zero)) (LengthCons _ y2 (Nil _) (Zero) (LengthNil _)) (LtS (Zero) (Succ n1) (LtZ n1)))))
  (let-match erased aw (AppCons _ _ W1 _ aw1))
  (let-match erased lz (LengthCons _ _ _ n1 lz1))
  (let ((erased m) (erased lw) (erased lt)) (snoc-le Y Z1 W1 y y2 n1 X1 ap1 aw1 lz1))
  (values (Succ m) (LengthCons _ a W1 m lw) (LtS m (Succ n1) lt)))

(def-fns _ $ (erased disj-one : (erased (Nat) l) (subterm erased (List (Nat)) xs) (erased (NotIn l xs) o) -> (erased (Disj xs (Cons (Nat) l (Nil (Nat)))) r))
  (let-match erased o (NotInCons _ x xs1 ne o1) ((NotInNil _) (DisjNil _)))
  (DisjCons x xs1 _ (NotInCons x l (Nil _) (apart-sym l x ne) (NotInNil x)) (disj-one l xs1 o1)))

; Coq's shortening of the walk in embed_full: a walk x0 :: p of k darts after x0, k < 6, p in the kernel, is shortened to one
; whose images are on distinct faces, or gives a hom ring of at most five darts that does not close (IHf5).
(def-fns _ $ (erased shorten : (erased (Nat) dc dm x0 z k) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl lab) (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en)
    (erased (FunctorAll ec em as hl as) fu) (erased (FaceLab dm fm lab) fl) (erased (Bridgeless dm em nm fm) bl) (subterm erased (List (Nat)) p)
    (erased (RPath ec fc x0 p z) rp) (erased (Within p as) wp) (erased (Length (Nat) p k) lk) (erased (Lt k 6) l6)
    -> (erased (Or (HomBad ec fc em fm as hl) (ShortP ec fc hl lab as x0 z k)) r))
  (let-match erased rp (RPCons _ _ p1 _ ex0 x1 _ pe0 sp0 rp1)
    ((RPNil _ _ _) (let-match erased lk (LengthNil _))
      (OrR _ _ (MkShortP ec fc hl lab as (Nil _) (Nil _) (Nil _) x0 x0 (Zero) (Zero) (RPNil ec fc x0) (WNil as) (RespNil hl) (RespNil lab) (DistNil) (LengthNil _) (lt-succ (Zero))))))
  (let-match erased wp (WCons _ _ _ ix1 wp1))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let ((erased l61)) (lt-succ-left k1 6 l6))
  (let-match erased (shorten dc dm x1 z k1 ec nc fc ksc rc em nm fm ksm as hl lab en fu fl bl p1 rp1 wp1 lk1 l61) (OrR _ _ sh) ((OrL _ _ hb) (OrL _ _ hb)))
  (let-match erased sh (MkShortP _ _ _ _ _ q hq lq _ _ _ k2 rq wq rh rl dl lk2 lt2))
  (let ((erased nfc) (erased nic) (erased fic) (erased nfm) (erased nim) (erased fim) (erased qe) (erased qn) (erased qf) (erased qem) (erased qnm) (erased qfm))
    (hc-perms dc dm ec nc fc ksc rc em nm fm ksm as hl en))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ kf _ fi2 _ ids rs gf2 pf2 gr2 io ro cl ll))
  (let ((erased w1) (erased pw1) (erased lw1)) (h-val dc dm x1 ec nc fc ksc rc em nm fm ksm as hl en ix1))
  (let ((erased l1) (erased pl1)) (nth-exists _ lab dm w1 ll lw1))
  (let-match erased (in-dec l1 lq) (OrL _ _ il)
    ((OrR _ _ o)
      (OrR _ _ (MkShortP ec fc hl lab as (Cons _ x1 q) (Cons _ w1 hq) (Cons _ l1 lq) x0 z k (Succ k2) (RPCons ec fc q x0 ex0 x1 z pe0 sp0 rq) (WCons as x1 q ix1 wq)
        (RespCons hl q hq x1 w1 pw1 rh) (RespCons lab hq lq w1 l1 pl1 rl) (DistCons l1 lq o dl) (LengthCons _ x1 q k2 lk2) (LtS k2 k lt2)))))
  (let ((erased v) (erased iv) (erased plv)) (respects-in lab hq lq l1 rl il))
  (let ((erased x2) (erased ix2q) (erased px2)) (respects-in hl q hq v rh iv))
  (let ((erased sv)) (facelab-same dm v w1 l1 fm lab fl plv pl1))
  (let ((erased ix2)) (within-in as x2 q wq ix2q))
  (let-match erased sv (MkSomePath _ _ vs _ _ pv))
  (let ((erased x3) (erased s23) (erased px3)) (h-face-back dc dm x2 v w1 ec nc fc ksc rc em nm fm ksm as hl (Nil _) vs en ix2 px2 pv))
  (let ((erased A) (erased B) (erased c) (erased ecc) (erased r1) (erased pec) (erased sc2) (erased r2) (erased ap)) (rpath-split ec fc q x1 z x2 rq ix2q))
  (let-match erased s23 (MkSomePath _ _ ws23 _ _ p23))
  (let ((erased ix3)) (ker-path dc dm x2 x3 ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws23 en ix2 p23))
  (let ((erased hA) (erased hB) (erased rA) (erased rB) (erased ah)) (resp-split hl (Cons _ x2 B) q hq A ap rh))
  (let ((erased lA) (erased lB) (erased rlA) (erased rlB) (erased al)) (resp-split lab hB hq lq hA ah rl))
  (let ((erased wA) (erased wB)) (within-split (Cons _ x2 B) q as A ap wq))
  (let-match erased (nat-eq x1 x3) (Unequal _ _ _ _ ne13)
    ((Equal _ _ _)
      (let ((erased s0)) (some-cat fc ex0 x1 x2 sp0 (some-sym dc x2 x1 fc fic qf (MkSomePath fc (Nil _) ws23 x2 x1 p23)
        (ker-lt dc dm x2 ec nc fc ksc rc em nm fm ksm as hl en ix2))))
      (let ((erased dA) (erased dB)) (app-parts lB lq lA al dl))
      (let ((erased kb) (erased lb) (erased ltb)) (suffix-le (Cons _ x2 B) q k2 A ap lk2))
      (OrR _ _ (MkShortP ec fc hl lab as (Cons _ x2 B) hB lB x0 z k kb (RPCons ec fc B x0 ex0 x2 z pe0 s0 r2) wB rB rlB dB lb
        (lt-tr kb (Succ k2) (Succ k) ltb (LtS k2 k lt2))))))
  (let-match erased sc2 (MkSomePath _ _ cs _ _ pc2))
  (let ((erased iec)) (ker-path-inv dc dm ecc x2 ec nc fc ksc rc em nm fm ksm as hl (Nil _) cs en ix2 pc2))
  (let-match erased A (Cons _ x A1)
    ((Nil _)
      (let-match erased r1 (RPNil _ _ _))
      (let ((erased v1) (erased pv1) (erased pmv1)) (functor-at ec em as hl as x1 ecc w1 fu ix1 pec iec pw1))
      (let ((erased v2) (erased pv2) (erased sm)) (face-h dc dm ecc x2 v1 ec nc fc ksc rc em nm fm ksm as hl (Nil _) cs en iec pc2 pv1))
      (let-match erased (nth-fn _ hl x2 v2 v pv2 px2) (Refl _ _))
      (match erased (no-bridge dm w1 v1 em nm fm bl pmv1 (some-sym dm v1 w1 fm fim qfm (some-cat fm v1 v w1 sm sv) (perm-val dm w1 v1 em nfm qem pmv1))) _)))
  (let-match erased r1 (RPCons _ _ _ _ e1 _ _ pe1 s1x r11))
  (let ((erased PQ) (erased rR) (erased apR)) (rpath-join ec fc (Nil _) A1 x c ecc x3 x3 r11 pec (some-cat fc ecc x2 x3 sc2 (MkSomePath fc (Nil _) ws23 x2 x3 p23)) (RPNil ec fc x3)))
  (let-match erased wA (WCons _ _ _ ix wA1))
  (let ((erased wPQ)) (within-app (Cons _ x3 (Nil _)) PQ as A1 apR wA1 (WCons as x3 (Nil _) ix3 (WNil as))))
  (let-match erased rA (RespCons _ _ hA1 _ hx phx rA1))
  (let ((erased hPQ) (erased rPQ) (erased ahPQ)) (resp-app hl (Cons _ x3 (Nil _)) PQ (Cons _ w1 (Nil _)) A1 apR hA1 rA1 (RespCons hl (Nil _) (Nil _) x3 w1 px3 (RespNil hl))))
  (let ((erased wb) (erased pb) (erased rpm)) (rpath-h dc dm x x3 hx ec nc fc ksc rc em nm fm ksm as hl PQ hPQ en fu ix rR wPQ rPQ phx))
  (let-match erased (nth-fn _ hl x3 wb w1 pb px3) (Refl _ _))
  (let-match erased s1x (MkSomePath _ _ es _ _ pex))
  (let ((erased ie1)) (ker-path-inv dc dm e1 x ec nc fc ksc rc em nm fm ksm as hl (Nil _) es en ix pex))
  (let ((erased ve) (erased pve) (erased pmve)) (functor-at ec em as hl as x1 e1 w1 fu ix1 pe1 ie1 pw1))
  (let ((erased vx) (erased pvx) (erased smx)) (face-h dc dm e1 x ve ec nc fc ksc rc em nm fm ksm as hl (Nil _) es en ie1 pex pve))
  (let-match erased (nth-fn _ hl x vx hx pvx phx) (Refl _ _))
  (let-match erased rlA (RespCons _ _ lA1 _ lx plx rlA1))
  (let-match erased rB (RespCons _ _ hB1 _ v4 pv4 rB1))
  (let-match erased (nth-fn _ hl x2 v4 v pv4 px2) (Refl _ _))
  (let-match erased rlB (RespCons _ _ lB1 _ lv plv2 rlB1))
  (let-match erased (nth-fn _ lab v lv l1 plv2 plv) (Refl _ _))
  (let ((erased oA) (erased oB)) (app-mid-notin lB1 lq lA l1 al dl))
  (let ((erased dA) (erased dB)) (app-parts lB lq lA al dl))
  (let-match erased dA (DistCons _ _ oxA dA1))
  (let-match erased oA (NotInCons _ _ _ n1x oA1))
