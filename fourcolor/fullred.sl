  (let-match erased oa (MkOffAt _ _ _ y l2 iy pl2 ol2))
  (OrL _ _ (MkOffAt lab L _ y l2 (InThere y x xs1 iy) pl2 ol2)))

; m + 1 darts of S on distinct faces, none a face of the ring (labels lr), as Scattered takes them.
(def-adts $ (Picked : ((List (Nat)) lab lr S) ((Nat) m) -> Type)
