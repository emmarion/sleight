(def-adts $ (LeftKit : ((Level) M) ((Level) P) -> Type)
  enum
  (many MkLeftKit : (erased (Level) M P)
      (erased (Fn P (erased (RPoint M) p q r) (erased (RLeft M p q r) l)
          -> (erased (RPointApart M r p) rp) (erased (RPointApart M r q) rq)) left-apart)
      -> (LeftKit M P)))

(def-adts $ (REnds : ((Level) M) ((List (REdge M)) es) ((List (RPoint M)) us) -> Type)
  enum
  (many RENil : (erased (Level) M) -> (REnds M (Nil (REdge M)) (Nil (RPoint M))))
  (many RECons : (erased (Level) M) (erased (RPoint M) a b) (erased (List (REdge M)) es) (erased (List (RPoint M)) us)
      (erased (REnds M es us) rest)
      -> (REnds M (Cons (REdge M) (MkREdge M a b) es) (Cons (RPoint M) a (Cons (RPoint M) b us)))))

(def-fns _ $ (erased rends : (erased (Level) M) (subterm erased (List (REdge M)) es) -> (erased (List (RPoint M)) us) (erased (REnds M es us) r))
  (let-match erased es (Cons _ e es1) ((Nil _) (values (Nil _) (RENil M))))
  (let-match erased e (MkREdge _ a b))
  (let ((erased us1) (erased r1)) (rends M es1))
  (values (Cons _ a $ Cons _ b us1) (RECons M a b es1 us1 r1)))

(def-fns _ $ (erased pairs-kit : (erased (Level) M P) -> (erased (Level) L)
    (erased (Fn L (erased (PointKit M P) pk) (erased (LeftKit M P) lk) (erased (List (REdge M)) es) (erased (List (RPoint M)) us)
        (subterm erased (REnds M es us) en) (erased (RDrawing M es) d) -> (erased (DichTab M us) tab)) drawing-tab))
  (def-fns _ $ (erased offline-apart : (erased (LeftKit M P) lk) (erased (RPoint M) a b r) (erased (ROffLine M a b r) o)
      -> (erased (Dich M a r) da) (erased (Dich M b r) db))
    (let-match erased lk (MkLeftKit _ _ left-apart))
    (match erased o _
      ((ROffLeft _ _ _ _ l)
        (let ((erased ra) (erased rb)) (left-apart a b r l))
        (values (DichAp M a r (rpointapart-sym M r a ra)) (DichAp M b r (rpointapart-sym M r b rb))))
      ((ROffRight _ _ _ _ l)
        (let ((erased rb) (erased ra)) (left-apart b a r l))
        (values (DichAp M a r (rpointapart-sym M r a ra)) (DichAp M b r (rpointapart-sym M r b rb))))))
  (def-fns _ $ (erased left-dich : (erased (LeftKit M P) lk) (erased (RPoint M) a b r) (erased (RLeft M a b r) l)
      -> (erased (Dich M a r) da) (erased (Dich M b r) db))
    (offline-apart lk a b r (ROffLeft M a b r l)))
  (def-fns _ $ (erased share-dich : (erased (PointKit M P) pk) (erased (RPoint M) a b c) (erased (RPointEq M c a) e)
      (erased (RPointApart M a b) ab) -> (erased (Dich M a c) dac) (erased (Dich M b c) dbc))
    (let-match erased pk (MkPointKit _ _ _ _ compat _))
    (values (DichEq M a c (rpointeq-sym M c a e)) (DichAp M b c (rpointapart-sym M c b (compat c a b e ab)))))
  (def-fns _ $ (erased compatible-dich : (erased (PointKit M P) pk) (erased (LeftKit M P) lk) (erased (RPoint M) a b c d)
      (erased (RPointApart M a b) ab) (erased (RCompatible M a b c d) h)
      -> (erased (Dich M a c) ac) (erased (Dich M a d) ad) (erased (Dich M b c) bc) (erased (Dich M b d) bd))
    (let ((erased ba)) (rpointapart-sym M a b ab))
    (match erased h _
      ((RShareCA _ _ _ _ _ e o)
        (let ((erased ac) (erased bc)) (share-dich pk a b c e ab))
        (let ((erased ad) (erased bd)) (offline-apart lk a b d o))
        (values ac ad bc bd))
      ((RShareCB _ _ _ _ _ e o)
        (let ((erased bc) (erased ac)) (share-dich pk b a c e ba))
        (let ((erased ad) (erased bd)) (offline-apart lk a b d o))
        (values ac ad bc bd))
      ((RShareDA _ _ _ _ _ e o)
        (let ((erased ad) (erased bd)) (share-dich pk a b d e ab))
        (let ((erased ac) (erased bc)) (offline-apart lk a b c o))
        (values ac ad bc bd))
      ((RShareDB _ _ _ _ _ e o)
        (let ((erased bd) (erased ad)) (share-dich pk b a d e ba))
        (let ((erased ac) (erased bc)) (offline-apart lk a b c o))
        (values ac ad bc bd))
      ((RSplitByAB _ _ _ _ _ cd _ _)
        (match erased cd _
          ((RBothLeft _ _ _ _ _ lc ld)
            (let ((erased ac) (erased bc)) (left-dich lk a b c lc))
            (let ((erased ad) (erased bd)) (left-dich lk a b d ld))
            (values ac ad bc bd))
          ((RBothRight _ _ _ _ _ lc ld)
            (let ((erased bc) (erased ac)) (left-dich lk b a c lc))
            (let ((erased bd) (erased ad)) (left-dich lk b a d ld))
            (values ac ad bc bd))))
      ((RSplitByCD _ _ _ _ _ oc od _)
        (let ((erased ac) (erased bc)) (offline-apart lk a b c oc))
        (let ((erased ad) (erased bd)) (offline-apart lk a b d od))
        (values ac ad bc bd))))
  (def-fns _ $ (erased compatall-dich : (erased (PointKit M P) pk) (erased (LeftKit M P) lk) (erased (RPoint M) a b)
      (erased (RPointApart M a b) ab) (erased (List (REdge M)) es) (erased (List (RPoint M)) us)
      (subterm erased (REnds M es us) en) (erased (RCompatibleAll M a b es) ca)
      -> (erased (DichAll M a us) da) (erased (DichAll M b us) db))
    (let-match erased en (RECons _ c d es1 us1 en1) ((RENil _) (values (DANil M a) (DANil M b))))
    (let-match erased ca (RCACons _ _ _ _ _ _ h rest))
    (let ((erased ac) (erased ad) (erased bc) (erased bd)) (compatible-dich pk lk a b c d ab h))
    (let ((erased da) (erased db)) (compatall-dich pk lk a b ab es1 us1 en1 rest))
    (values (DACons M a c _ ac $ DACons M a d us1 ad da) (DACons M b c _ bc $ DACons M b d us1 bd db)))
  (def-fns _ $ (erased drawing-tab : (erased (PointKit M P) pk) (erased (LeftKit M P) lk) (erased (List (REdge M)) es)
      (erased (List (RPoint M)) us) (subterm erased (REnds M es us) en) (erased (RDrawing M es) d)
      -> (erased (DichTab M us) tab))
    (let-match erased en (RECons _ a b es1 us1 en1) ((RENil _) (DTNil M)))
    (let-match erased d (RDrawCons _ _ _ _ ab ca d1))
    (let ((erased da) (erased db)) (compatall-dich pk lk a b ab es1 us1 en1 ca))
    (DTCons M a _ (DACons M a b us1 (DichAp M a b ab) da) $ DTCons M b us1 db $ drawing-tab pk lk es1 us1 en1 d1))
  (values (level-of drawing-tab) drawing-tab))
