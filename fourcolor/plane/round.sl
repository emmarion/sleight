      ((COR _ _ _ _ _ l) (OffRight va vb vr (lm-left us j J le g b a r l vb va vr sb sa sr)))))
  (def-fns _ $ (erased cside-nat : (erased (List (RPoint M)) us) (erased (Z) j J) (erased (ZLe j J) le) (erased (Grid) g) (erased (RPoint M) a b c d)
      (erased (CSide M J a b c d) h) (erased (Point) va vb vc vd) (erased (Snap M N us j g a va) sa) (erased (Snap M N us j g b vb) sb)
