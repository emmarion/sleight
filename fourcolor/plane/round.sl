          (lm-left us j J2 (zle-trans _ _ _ le l2) g a b d hd va vb vd sa sb sd)))
      ((CSR _ _ J1 J2 _ _ _ _ l1 l2 hc hd)
        (BothRight va vb vc vd (lm-left us j J1 (zle-trans _ _ _ le l1) g b a c hc vb va vc sb sa sc)
          (lm-left us j J2 (zle-trans _ _ _ le l2) g b a d hd vb va vd sb sa sd)))))
  (def-fns _ $ (erased ccompat-nat : (erased (List (RPoint M)) us) (erased (Z) j J) (erased (ZLe j J) le) (erased (Grid) g) (erased (RPoint M) a b c d)
      (erased (CCompat M N J a b c d) h) (erased (Point) va vb vc vd) (erased (Snap M N us j g a va) sa) (erased (Snap M N us j g b vb) sb)
      (erased (Snap M N us j g c vc) sc) (erased (Snap M N us j g d vd) sd) -> (erased (Compatible va vb vc vd) o))
    (match erased h _
      ((CShareCA _ _ _ _ _ _ _ e x)
