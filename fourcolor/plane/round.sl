    (let-match erased sn2 (SnCons _ _ _ _ _ _ _ hs1 _ sb sn1))
    (DrawCons va vb ns1 (pap-nat us j k (zle-trans _ _ _ le lp) g a b p va vb sa sb)
      (cca-nat us j J1 (zle-trans _ _ _ le l1) g a b es1 x va vb sa sb ns1 xs1 hs1 en1 sn1)
      (cdraw-nat us j J2 (zle-trans _ _ _ le l2) g es1 y ns1 xs1 hs1 en1 sn1)))
  (def-fns _ $ (erased allea-of : (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g) (erased (RPoint M) u) (erased (Point) v)
      (erased (Snap M N us j g u v) su) (erased (List (RPoint M)) hs) (erased (List (RN M)) xs)
      (subterm erased (DichAll M N u hs) dl) (erased (Snaps M N us j g hs xs) sn) -> (erased (AllEA M (MkRN M u v) xs) r))
    (let-match erased dl (DchCons _ _ _ w hs1 dw rest) ((DchNil _ _ _) (let-match erased sn (SnNil _ _ _ _ _)) (AENil M (MkRN M u v))))
