          (coff-nat us j J3 (zle-trans _ _ _ le l3) g c d b y vc vd vb sc sd sb)))
      ((CSplitCD _ _ _ J1 J2 J3 _ _ _ _ l1 l2 l3 x y s)
        (SplitByCD va vb vc vd (coff-nat us j J1 (zle-trans _ _ _ le l1) g a b c x va vb vc sa sb sc)
          (coff-nat us j J2 (zle-trans _ _ _ le l2) g a b d y va vb vd sa sb sd)
          (cside-nat us j J3 (zle-trans _ _ _ le l3) g c d a b s vc vd va vb sc sd sa sb)))))
  (def-fns _ $ (erased cca-nat : (erased (List (RPoint M)) us) (erased (Z) j J) (erased (ZLe j J) le) (erased (Grid) g) (erased (RPoint M) a b)
      (erased (List (REdge M)) es) (subterm erased (CCA M N J a b es) h) (erased (Point) va vb)
      (erased (Snap M N us j g a va) sa) (erased (Snap M N us j g b vb) sb)
