      ((CShareDB _ _ _ _ _ _ _ e x)
        (let-match erased (snap-eq us j g d b vd vb sd sb (ESEq M N d b e)) (Refl _ _))
        (ShareDB va vb vc (coff-nat us j J le g a b c x va vb vc sa sb sc)))
      ((CSplitAB _ _ _ J1 J2 J3 _ _ _ _ l1 l2 l3 s x y)
