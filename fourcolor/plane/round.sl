  (def-fns _ $ (erased reps-of : (erased (List (RPoint M)) us) (erased (Z) j) (erased (DichTab M N us) tab)
      (subterm erased (List (RPoint M)) hs) (erased (Suffix (RPoint M) hs us) suf)
