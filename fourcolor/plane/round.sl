    (values (Cons _ (MkQPoint tx ty) qs) (RQCons M N us j u _ hs1 qs (MkRepQ M N us j u sx sy x y tx ty fe hx hy) rest)))
  (def-fns _ $ (erased round : (erased (List (REdge M)) es) (erased (RDrawing M N es) d) -> (erased (Rounding M es) r))
    (let ((erased us) (erased en)) (rends M es))
    (let ((erased tab)) (drawing-tab pk lk es us en d))
    (let ((erased j) (erased cd)) (cdraw-of M N es d))
    (let ((erased qs) (erased rs)) (reps-of us j tab us (SufHere _ us)))
    (let ((erased g) (erased vs) (erased gl)) (grid-of qs))
    (let ((erased ns) (erased xs) (erased ends) (erased sn)) (snaps-of M N us j g es us en qs rs vs gl))
    (MkRounding M es ns xs ends (coh-of us j g us xs tab sn) (cdraw-nat us j j (zle-refl j) g es cd ns xs us ends sn)))
  (values (level-of round) round))
