    (let-match erased sn2 (SnCons _ _ _ _ _ _ _ hs1 _ sd sn1))
    (CACons va vb vc vd ns1 (ccompat-nat us j J1 (zle-trans _ _ _ le l1) g a b c d x va vb vc vd sa sb sc sd)
      (cca-nat us j J2 (zle-trans _ _ _ le l2) g a b es1 y va vb sa sb ns1 xs1 hs1 en1 sn1)))
  (def-fns _ $ (erased cdraw-nat : (erased (List (RPoint M)) us) (erased (Z) j J) (erased (ZLe j J) le) (erased (Grid) g)
      (erased (List (REdge M)) es) (subterm erased (CDraw M N J es) h)
      (erased (List (Edge)) ns) (erased (List (RN M)) xs) (erased (List (RPoint M)) hs) (erased (EndPairs M es ns xs) en) (erased (Snaps M N us j g hs xs) sn)
      -> (erased (Drawing ns) r))
