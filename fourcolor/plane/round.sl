(def-adts $ (RepQ : ((Level) M) ((Level) N) ((List (RPoint M)) us) ((Z) j) ((RPoint M) u) ((QPoint) q) -> Type)
  enum
  (many MkRepQ : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) (erased (RPoint M) u) (erased (Spec) sx sy)
      (erased (CReal M sx) x) (erased (CReal M sy) y) (erased (Q) tx ty)
      (erased (FirstEq M N us u (MkRPoint M sx sy x y)) fe) (erased (SeqAt sx j tx) hx) (erased (SeqAt sy j ty) hy)
      -> (RepQ M N us j u (MkQPoint tx ty))))

(def-adts $ (RepQs : ((Level) M) ((Level) N) ((List (RPoint M)) us) ((Z) j) ((List (RPoint M)) hs) ((List (QPoint)) qs) -> Type)
  enum
  (many RQNil : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) -> (RepQs M N us j (Nil (RPoint M)) (Nil (QPoint))))
  (many RQCons : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) (erased (RPoint M) u) (erased (QPoint) q)
      (erased (List (RPoint M)) hs) (erased (List (QPoint)) qs) (erased (RepQ M N us j u q) h) (erased (RepQs M N us j hs qs) rest)
      -> (RepQs M N us j (Cons (RPoint M) u hs) (Cons (QPoint) q qs))))

(def-adts $ (Snap : ((Level) M) ((Level) N) ((List (RPoint M)) us) ((Z) j) ((Grid) g) ((RPoint M) u) ((Point) v) -> Type)
  enum
  (many MkSnap : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g) (erased (RPoint M) u)
      (erased (QPoint) q) (erased (Point) v) (erased (RepQ M N us j u q) h) (erased (OnGrid g q v) o)
      -> (Snap M N us j g u v)))

(def-adts $ (Snaps : ((Level) M) ((Level) N) ((List (RPoint M)) us) ((Z) j) ((Grid) g) ((List (RPoint M)) hs) ((List (RN M)) xs) -> Type)
  enum
  (many SnNil : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g)
      -> (Snaps M N us j g (Nil (RPoint M)) (Nil (RN M))))
  (many SnCons : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g) (erased (RPoint M) u) (erased (Point) v)
      (erased (List (RPoint M)) hs) (erased (List (RN M)) xs) (erased (Snap M N us j g u v) h) (erased (Snaps M N us j g hs xs) rest)
      -> (Snaps M N us j g (Cons (RPoint M) u hs) (Cons (RN M) (MkRN M u v) xs))))

(def-adts $ (COff : ((Level) M) ((Z) J) ((RPoint M) a) ((RPoint M) b) ((RPoint M) r) -> Type)
  enum
  (many COL : (erased (Level) M) (erased (Z) J) (erased (RPoint M) a b r) (erased (LeftMargin M a b r J) h) -> (COff M J a b r))
  (many COR : (erased (Level) M) (erased (Z) J) (erased (RPoint M) a b r) (erased (LeftMargin M b a r J) h) -> (COff M J a b r)))

(def-adts $ (CSide : ((Level) M) ((Z) J) ((RPoint M) a) ((RPoint M) b) ((RPoint M) c) ((RPoint M) d) -> Type)
  enum
  (many CSL : (erased (Level) M) (erased (Z) J J1 J2) (erased (RPoint M) a b c d) (erased (ZLe J J1) l1) (erased (ZLe J J2) l2)
      (erased (LeftMargin M a b c J1) hc) (erased (LeftMargin M a b d J2) hd) -> (CSide M J a b c d))
  (many CSR : (erased (Level) M) (erased (Z) J J1 J2) (erased (RPoint M) a b c d) (erased (ZLe J J1) l1) (erased (ZLe J J2) l2)
      (erased (LeftMargin M b a c J1) hc) (erased (LeftMargin M b a d J2) hd) -> (CSide M J a b c d)))

(def-adts $ (CCompat : ((Level) M) ((Level) N) ((Z) J) ((RPoint M) a) ((RPoint M) b) ((RPoint M) c) ((RPoint M) d) -> Type)
  enum
  (many CShareCA : (erased (Level) M N) (erased (Z) J) (erased (RPoint M) a b c d) (erased (RPointEq M N c a) e) (erased (COff M J a b d) o)
      -> (CCompat M N J a b c d))
  (many CShareCB : (erased (Level) M N) (erased (Z) J) (erased (RPoint M) a b c d) (erased (RPointEq M N c b) e) (erased (COff M J a b d) o)
      -> (CCompat M N J a b c d))
  (many CShareDA : (erased (Level) M N) (erased (Z) J) (erased (RPoint M) a b c d) (erased (RPointEq M N d a) e) (erased (COff M J a b c) o)
      -> (CCompat M N J a b c d))
  (many CShareDB : (erased (Level) M N) (erased (Z) J) (erased (RPoint M) a b c d) (erased (RPointEq M N d b) e) (erased (COff M J a b c) o)
      -> (CCompat M N J a b c d))
  (many CSplitAB : (erased (Level) M N) (erased (Z) J J1 J2 J3) (erased (RPoint M) a b c d) (erased (ZLe J J1) l1) (erased (ZLe J J2) l2) (erased (ZLe J J3) l3)
      (erased (CSide M J1 a b c d) s) (erased (COff M J2 c d a) x) (erased (COff M J3 c d b) y) -> (CCompat M N J a b c d))
  (many CSplitCD : (erased (Level) M N) (erased (Z) J J1 J2 J3) (erased (RPoint M) a b c d) (erased (ZLe J J1) l1) (erased (ZLe J J2) l2) (erased (ZLe J J3) l3)
      (erased (COff M J1 a b c) x) (erased (COff M J2 a b d) y) (erased (CSide M J3 c d a b) s) -> (CCompat M N J a b c d)))

(def-adts $ (CCA : ((Level) M) ((Level) N) ((Z) J) ((RPoint M) a) ((RPoint M) b) ((List (REdge M)) es) -> Type)
  enum
  (many CCANil : (erased (Level) M N) (erased (Z) J) (erased (RPoint M) a b) -> (CCA M N J a b (Nil (REdge M))))
  (many CCACons : (erased (Level) M N) (erased (Z) J J1 J2) (erased (RPoint M) a b c d) (erased (List (REdge M)) es)
      (erased (ZLe J J1) l1) (erased (ZLe J J2) l2) (erased (CCompat M N J1 a b c d) h) (erased (CCA M N J2 a b es) rest)
      -> (CCA M N J a b (Cons (REdge M) (MkREdge M c d) es))))

(def-adts $ (CAp : ((Spec) s) ((Spec) t) ((Z) k) -> Type)
  enum
  (many CALt : (erased (Spec) s t) (erased (Z) k) (erased (LtNear s t k) h) -> (CAp s t k))
  (many CAGt : (erased (Spec) s t) (erased (Z) k) (erased (LtNear t s k) h) -> (CAp s t k)))

(def-adts $ (PAp : ((Level) M) ((Z) k) ((RPoint M) a) ((RPoint M) b) -> Type)
  enum
  (many PAX : (erased (Level) M) (erased (Z) k) (erased (Spec) px py qx qy)
      (erased (CReal M px) xp) (erased (CReal M py) yp) (erased (CReal M qx) xq) (erased (CReal M qy) yq) (erased (CAp px qx k) c)
      -> (PAp M k (MkRPoint M px py xp yp) (MkRPoint M qx qy xq yq)))
  (many PAY : (erased (Level) M) (erased (Z) k) (erased (Spec) px py qx qy)
      (erased (CReal M px) xp) (erased (CReal M py) yp) (erased (CReal M qx) xq) (erased (CReal M qy) yq) (erased (CAp py qy k) c)
      -> (PAp M k (MkRPoint M px py xp yp) (MkRPoint M qx qy xq yq))))

(def-adts $ (CDraw : ((Level) M) ((Level) N) ((Z) J) ((List (REdge M)) es) -> Type)
  enum
  (many CDNil : (erased (Level) M N) (erased (Z) J) -> (CDraw M N J (Nil (REdge M))))
  (many CDCons : (erased (Level) M N) (erased (Z) J k J1 J2) (erased (RPoint M) a b) (erased (List (REdge M)) es)
      (erased (ZLe J k) lk) (erased (ZLe J J1) l1) (erased (ZLe J J2) l2)
      (erased (PAp M k a b) p) (erased (CCA M N J1 a b es) x) (erased (CDraw M N J2 es) rest)
      -> (CDraw M N J (Cons (REdge M) (MkREdge M a b) es))))

(def-fns _ $ (erased zmin3 : (erased (Z) a b c) -> (erased (Z) m) (erased (ZLe m a) ha) (erased (ZLe m b) hb) (erased (ZLe m c) hc))
  (let ((erased n) (erased nb) (erased nc)) (zmin2 b c))
  (let ((erased m) (erased ma) (erased mn)) (zmin2 a n))
  (values m ma (zle-trans m n b mn nb) (zle-trans m n c mn nc)))

(def-fns _ $ (erased coff-of : (erased (Level) M) (erased (RPoint M) a b r) (erased (ROffLine M a b r) o) -> (erased (Z) J) (erased (COff M J a b r) h))
  (match erased o _
    ((ROffLeft _ _ _ _ l) (let ((erased J) (erased h)) (left-margin M a b r l)) (values J (COL M J a b r h)))
    ((ROffRight _ _ _ _ l) (let ((erased J) (erased h)) (left-margin M b a r l)) (values J (COR M J a b r h)))))

(def-fns _ $ (erased cside-of : (erased (Level) M) (erased (RPoint M) a b c d) (erased (RSameSide M a b c d) s)
    -> (erased (Z) J) (erased (CSide M J a b c d) h))
  (match erased s _
    ((RBothLeft _ _ _ _ _ lc ld)
      (let ((erased J1) (erased hc)) (left-margin M a b c lc))
      (let ((erased J2) (erased hd)) (left-margin M a b d ld))
      (let ((erased J) (erased l1) (erased l2)) (zmin2 J1 J2))
      (values J (CSL M J J1 J2 a b c d l1 l2 hc hd)))
    ((RBothRight _ _ _ _ _ lc ld)
      (let ((erased J1) (erased hc)) (left-margin M b a c lc))
      (let ((erased J2) (erased hd)) (left-margin M b a d ld))
      (let ((erased J) (erased l1) (erased l2)) (zmin2 J1 J2))
      (values J (CSR M J J1 J2 a b c d l1 l2 hc hd)))))

(def-fns _ $ (erased ccompat-of : (erased (Level) M N) (erased (RPoint M) a b c d) (erased (RCompatible M N a b c d) h)
    -> (erased (Z) J) (erased (CCompat M N J a b c d) r))
  (match erased h _
    ((RShareCA _ _ _ _ _ _ e o) (let ((erased J) (erased x)) (coff-of M a b d o)) (values J (CShareCA M N J a b c d e x)))
    ((RShareCB _ _ _ _ _ _ e o) (let ((erased J) (erased x)) (coff-of M a b d o)) (values J (CShareCB M N J a b c d e x)))
    ((RShareDA _ _ _ _ _ _ e o) (let ((erased J) (erased x)) (coff-of M a b c o)) (values J (CShareDA M N J a b c d e x)))
    ((RShareDB _ _ _ _ _ _ e o) (let ((erased J) (erased x)) (coff-of M a b c o)) (values J (CShareDB M N J a b c d e x)))
    ((RSplitByAB _ _ _ _ _ _ cd oa ob)
      (let ((erased J1) (erased s)) (cside-of M a b c d cd))
      (let ((erased J2) (erased x)) (coff-of M c d a oa))
      (let ((erased J3) (erased y)) (coff-of M c d b ob))
      (let ((erased J) (erased l1) (erased l2) (erased l3)) (zmin3 J1 J2 J3))
      (values J (CSplitAB M N J J1 J2 J3 a b c d l1 l2 l3 s x y)))
    ((RSplitByCD _ _ _ _ _ _ oc od ab)
      (let ((erased J1) (erased x)) (coff-of M a b c oc))
      (let ((erased J2) (erased y)) (coff-of M a b d od))
      (let ((erased J3) (erased s)) (cside-of M c d a b ab))
      (let ((erased J) (erased l1) (erased l2) (erased l3)) (zmin3 J1 J2 J3))
      (values J (CSplitCD M N J J1 J2 J3 a b c d l1 l2 l3 x y s)))))

(def-fns _ $ (erased cca-of : (erased (Level) M N) (erased (RPoint M) a b) (erased (List (REdge M)) es) (subterm erased (RCompatibleAll M N a b es) h)
    -> (erased (Z) J) (erased (CCA M N J a b es) r))
  (let-match erased h (RCACons _ _ _ _ c d es1 hc rest) ((RCANil _ _ _ _) (values (Z0) (CCANil M N (Z0) a b))))
  (let ((erased J1) (erased x)) (ccompat-of M N a b c d hc))
  (let ((erased J2) (erased y)) (cca-of M N a b es1 rest))
  (let ((erased J) (erased l1) (erased l2)) (zmin2 J1 J2))
  (values J (CCACons M N J J1 J2 a b c d es1 l1 l2 x y)))

(def-fns _ $ (erased cap-of : (erased (Spec) s t) (erased (CRealAppart s t) d) -> (erased (Z) k) (erased (CAp s t k) r))
  (match erased d _
    ((AppartLt _ _ l) (let ((erased k) (erased h)) (creal-lt-near s t l)) (values k (CALt s t k h)))
    ((AppartGt _ _ l) (let ((erased k) (erased h)) (creal-lt-near t s l)) (values k (CAGt s t k h)))))

(def-fns _ $ (erased pap-of : (erased (Level) M) (erased (RPoint M) a b) (erased (RPointApart M a b) d) -> (erased (Z) k) (erased (PAp M k a b) r))
  (match erased d _
    ((RApartX _ px py qx qy xp yp xq yq e) (let ((erased k) (erased c)) (cap-of px qx e)) (values k (PAX M k px py qx qy xp yp xq yq c)))
    ((RApartY _ px py qx qy xp yp xq yq e) (let ((erased k) (erased c)) (cap-of py qy e)) (values k (PAY M k px py qx qy xp yp xq yq c)))))

(def-fns _ $ (erased cdraw-of : (erased (Level) M N) (erased (List (REdge M)) es) (subterm erased (RDrawing M N es) d)
    -> (erased (Z) J) (erased (CDraw M N J es) r))
  (let-match erased d (RDrawCons _ _ a b es1 ab ca d1) ((RDrawNil _ _) (values (Z0) (CDNil M N (Z0)))))
  (let ((erased k) (erased p)) (pap-of M a b ab))
  (let ((erased J1) (erased x)) (cca-of M N a b es1 ca))
  (let ((erased J2) (erased y)) (cdraw-of M N es1 d1))
  (let ((erased J) (erased lk) (erased l1) (erased l2)) (zmin3 k J1 J2))
  (values J (CDCons M N J k J1 J2 a b es1 lk l1 l2 p x y)))

(def-fns _ $ (erased snaps-of : (erased (Level) M N) (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g)
    (erased (List (REdge M)) es) (erased (List (RPoint M)) hs) (subterm erased (REnds M es hs) en)
    (erased (List (QPoint)) qs) (erased (RepQs M N us j hs qs) rs) (erased (List (Point)) vs) (erased (GridList g qs vs) gl)
    -> (erased (List (Edge)) ns) (erased (List (RN M)) xs) (erased (EndPairs M es ns xs) ends) (erased (Snaps M N us j g hs xs) sn))
  (let-match erased en (RECons _ a b es1 hs1 en1) ((RENil _) (values (Nil _) (Nil _) (EndsNil M) (SnNil M N us j g))))
  (let-match erased rs (RQCons _ _ _ _ _ qa _ _ ha rs2))
  (let-match erased rs2 (RQCons _ _ _ _ _ qb _ qs1 hb rs1))
  (let-match erased gl (GridCons _ _ va _ _ oa gl2))
  (let-match erased gl2 (GridCons _ _ vb _ vs1 ob gl1))
  (let ((erased ns) (erased xs) (erased ends) (erased sn)) (snaps-of M N us j g es1 hs1 en1 qs1 rs1 vs1 gl1))
  (values (Cons _ (MkEdge va vb) ns) (Cons _ (MkRN M a va) $ Cons _ (MkRN M b vb) xs) (EndsCons M a b va vb es1 ns xs ends)
    (SnCons M N us j g a va _ _ (MkSnap M N us j g a qa va ha oa) $ SnCons M N us j g b vb hs1 xs (MkSnap M N us j g b qb vb hb ob) sn)))

(def-fns _ $ (erased rounds : (erased (Level) M N) -> (erased (Level) L)
    (erased (Fn L (erased (List (REdge M)) es) (erased (RDrawing M N es) drawn) -> (erased (Rounding M es) r)) round))
  (let ((erased P) (erased pk)) (point-kit M N))
  (let ((erased Pl) (erased lk)) (left-kit M))
  (let ((erased _) (erased drawing-tab)) (pairs-kit M N P Pl))
  (let ((erased _) (erased first-eq) (erased same)) (rep-kit M N P))
  (let ((erased _) (erased _) (erased _) (erased seq-term) (erased seq-fn) (erased _) (erased real-irrefl) (erased _)
        (erased _) (erased _) (erased _)) (creal-kit M))
  (let ((erased _) (erased _) (erased _) (erased _) (erased lt-near-at) (erased _) (erased near-of-eq)) (creal-eq-kit M N))
  (let ((erased _) (erased left-approx)) (approx-kit M))
  (def-fns _ $ (erased rpointeq-refl : (erased (RPoint M) u) -> (erased (Level) K) (erased (RPointEq M K u u) e))
    (let-match erased u (MkRPoint _ sx sy x y))
    (def-fns _
      ((erased fx : (erased (CRealLt sx sx) h) -> (erased (False) f)) (real-irrefl sx x h))
      ((erased fy : (erased (CRealLt sy sy) h) -> (erased (False) f)) (real-irrefl sy y h)))
    (let ((erased K)) (level-of fx))
    (let ((erased ex)) (MkCRealLe K sx sx fx))
    (let ((erased ey)) (MkCRealLe K sy sy fy))
    (values K (MkRPointEq M K sx sy sx sy x y x y (MkCRealEq K sx sx ex ex) (MkCRealEq K sy sy ey ey))))
  (def-fns _ $ (erased eqsame-eq : (erased (RPoint M) u w) (erased (EqSame M N u w) e) -> (erased (Level) K) (erased (RPointEq M K u w) r))
    (match erased e _
      ((ESEq _ _ _ _ q) (values N q))
      ((ESSame _ _ _) (rpointeq-refl u))))
  (def-fns _ $ (erased snap-near : (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g) (erased (RPoint M) u) (erased (Point) v)
      (erased (Snap M N us j g u v) s) -> (erased (QPoint) q) (erased (NearPoint M u j q) n) (erased (OnGrid g q v) o))
    (let-match erased s (MkSnap _ _ _ _ _ _ q _ h o))
    (let-match erased h (MkRepQ _ _ _ _ _ sx sy x y tx ty fe hx hy))
    (let ((erased n)) (match erased (fe-eq M N us u _ fe) (((NearPoint M u j q) n))
      ((ESEq _ _ _ _ e)
        (let-match erased e (MkRPointEq _ _ px py _ _ xp yp _ _ ex ey))
        (MkNearPoint M px py xp yp j tx ty (near-of-eq px sx xp ex j tx hx) (near-of-eq py sy yp ey j ty hy)))
      ((ESSame _ _ _) (MkNearPoint M sx sy x y j tx ty (creal-near-self sx j tx hx) (creal-near-self sy j ty hy)))))
    (values q n o))
  (def-fns _ $ (erased snap-eq : (erased (List (RPoint M)) us) (erased (Z) j) (erased (Grid) g) (erased (RPoint M) u w) (erased (Point) v z)
      (erased (Snap M N us j g u v) su) (erased (Snap M N us j g w z) sw) (erased (EqSame M N u w) e) -> (erased (Eq (Point) v z) r))
    (let-match erased su (MkSnap _ _ _ _ _ _ _ _ hu ou))
    (let-match erased sw (MkSnap _ _ _ _ _ _ _ _ hw ow))
    (let-match erased hu (MkRepQ _ _ _ _ _ sx sy x y tx ty fu hx hy))
    (let-match erased hw (MkRepQ _ _ _ _ _ _ _ _ _ tx2 ty2 fw hx2 hy2))
    (let-match erased (same pk us u w _ _ fu fw e) (Refl _ _))
    (let-match erased (seq-fn sx x j tx tx2 hx hx2) (Refl _ _))
    (let-match erased (seq-fn sy y j ty ty2 hy hy2) (Refl _ _))
    (grid-fn g _ v z ou ow))
  (def-fns _ $ (erased lm-left : (erased (List (RPoint M)) us) (erased (Z) j J) (erased (ZLe j J) le) (erased (Grid) g) (erased (RPoint M) p q r)
      (erased (LeftMargin M p q r J) h) (erased (Point) vp vq vr)
      (erased (Snap M N us j g p vp) sp) (erased (Snap M N us j g q vq) sq) (erased (Snap M N us j g r vr) sr) -> (erased (Left vp vq vr) l))
    (let ((erased a) (erased na) (erased ga)) (snap-near us j g p vp sp))
    (let ((erased b) (erased nb) (erased gb)) (snap-near us j g q vq sq))
    (let ((erased c) (erased nc) (erased gc)) (snap-near us j g r vr sr))
    (grid-left g a b c vp vq vr ga gb gc (left-approx p q r J j h le a b c na nb nc)))
  (def-fns _ $ (erased cap-q : (erased (Spec) s t) (erased (CReal M s) x) (erased (CReal M t) y) (erased (Z) k j) (erased (CAp s t k) h) (erased (ZLe j k) le)
      (erased (Q) a b) (erased (Near s j a) na) (erased (Near t j b) nb) -> (erased (Apart (Q) QLt a b) r))
    (match erased h _
      ((CALt _ _ _ l) (ApLt _ _ a b (lt-near-at s t x y k j a b l le na nb)))
      ((CAGt _ _ _ l) (ApGt _ _ a b (lt-near-at t s y x k j b a l le nb na)))))
  (def-fns _ $ (erased pap-nat : (erased (List (RPoint M)) us) (erased (Z) j k) (erased (ZLe j k) le) (erased (Grid) g) (erased (RPoint M) a b)
      (erased (PAp M k a b) h) (erased (Point) va vb) (erased (Snap M N us j g a va) sa) (erased (Snap M N us j g b vb) sb)
      -> (erased (PointApart va vb) r))
    (let ((erased qa) (erased na) (erased ga)) (snap-near us j g a va sa))
    (let ((erased qb) (erased nb) (erased gb)) (snap-near us j g b vb sb))
    (let-match erased na (MkNearPoint _ sx sy x y _ ax ay nx ny))
    (let-match erased nb (MkNearPoint _ tx ty u w _ bx by mx my))
    (let ((erased d)) (match erased h (((QPointApart qa qb) d))
      ((PAX _ _ _ _ _ _ _ _ _ _ c) (QApartX ax ay bx by (cap-q sx tx x u k j c le ax bx nx mx)))
      ((PAY _ _ _ _ _ _ _ _ _ _ c) (QApartY ax ay bx by (cap-q sy ty y w k j c le ay by ny my)))))
    (grid-apart g qa qb va vb ga gb d))
  (def-fns _ $ (erased coff-nat : (erased (List (RPoint M)) us) (erased (Z) j J) (erased (ZLe j J) le) (erased (Grid) g) (erased (RPoint M) a b r)
      (erased (COff M J a b r) h) (erased (Point) va vb vr)
      (erased (Snap M N us j g a va) sa) (erased (Snap M N us j g b vb) sb) (erased (Snap M N us j g r vr) sr) -> (erased (OffLine va vb vr) o))
