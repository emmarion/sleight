  (let ((erased t) (erased ht)) (qplus dv v))
  (qr-le (OLe) _ _ (qr-lin (OLe) v u du dv s t (QRLe _ _ h) hs ht
    (qring-eq (Cons _ a $ Cons _ u $ Cons _ v $ Nil (Q)) _ _ s t qr-minus-shift
      (qev-add (qev-minus _ _ _ _ _ _ (qev-var 0) (qev-var 1) hu) (qev-var 1) hs)
      (qev-add (qev-minus _ _ _ _ _ _ (qev-var 0) (qev-var 2) hv) (qev-var 2) ht)))))

(def-fns _ $ (erased qminus-qeq-r : (erased (Q) a b c d e) (erased (QEq b c) h) (erased (QMinus a b d) hd) (erased (QMinus a c e) he)
