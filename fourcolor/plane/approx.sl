(def-adts $ (CoordSplit : ((Spec) sa) ((Spec) sb) ((Z) j) ((Q) t) -> Type)
  enum
  (many CSApart : (erased (Spec) sa sb) (erased (Z) j) (erased (Q) t) (erased (CRealAppart sa sb) d) -> (CoordSplit sa sb j t))
  (many CSNear : (erased (Spec) sa sb) (erased (Z) j) (erased (Q) t) (erased (Near sb j t) n) -> (CoordSplit sa sb j t)))

(def-adts $ (PointSplit : ((Level) M) ((RPoint M) a) ((RPoint M) b) ((Z) j) ((QPoint) t) -> Type)
  enum
  (many PSApart : (erased (Level) M) (erased (RPoint M) a b) (erased (Z) j) (erased (QPoint) t) (erased (RPointApart M b a) d) -> (PointSplit M a b j t))
  (many PSNear : (erased (Level) M) (erased (RPoint M) a b) (erased (Z) j) (erased (QPoint) t) (erased (NearPoint M b j t) n) -> (PointSplit M a b j t)))

(def-fns _ $ (erased left-kit : (erased (Level) M) -> (erased (Level) P) (erased (LeftKit M P) k))
  (let ((erased L1) (erased _) (erased _) (erased seq-term) (erased _) (erased _) (erased _) (erased _) (erased L2) (erased _) (erased _)) (creal-kit M))
  (let ((erased LA) (erased left-approx)) (approx-kit M))
  (def-fns _ $ (erased coord-split : (erased (Spec) sa sb) (erased (CReal M sb) xb) (erased (Z) j) (erased (Q) ta) (erased (SeqAt sa j ta) ha)
      -> (erased (CoordSplit sa sb j ta) r))
    (let ((erased tb) (erased hb)) (seq-term sb xb j))
    (let ((erased d) (erased hd)) (qminus ta tb))
    (let ((erased e) (erased he)) (qabs d))
    (let ((erased c) (erased hc)) (qpower qtwo j))
    (let ((erased w) (erased hw)) (qmult qtwo c))
    (match erased (qlt-le-dec w e) _
      ((IsLt _ _ _ _ _ lt) (CSApart sa sb j ta (creal-appart-at sa sb j ta tb d e c w ha hb hd he hc hw lt)))
      ((IsGe _ _ _ _ _ le) (CSNear sa sb j ta (MkNear sb j ta tb d e c w hb hd he hc hw le)))))
  (def-fns _ $ (erased point-split : (erased (RPoint M) a b) (erased (Z) j) -> (erased (QPoint) t) (erased (NearPoint M a j t) na) (erased (PointSplit M a b j t) s))
    (let-match erased a (MkRPoint _ sx sy x y))
    (let-match erased b (MkRPoint _ tx ty u v))
    (let ((erased ax) (erased hx)) (seq-term sx x j))
    (let ((erased ay) (erased hy)) (seq-term sy y j))
    (let ((erased t)) (MkQPoint ax ay))
    (let ((erased na)) (MkNearPoint M sx sy x y j ax ay (creal-near-self sx j ax hx) (creal-near-self sy j ay hy)))
    (let-match erased (coord-split sx tx u j ax hx) (CSNear _ _ _ _ nx)
      ((CSApart _ _ _ _ d) (values t na (PSApart M a b j t (rpointapart-sym M a b (RApartX M sx sy tx ty x y u v d))))))
    (let-match erased (coord-split sy ty v j ay hy) (CSNear _ _ _ _ ny)
      ((CSApart _ _ _ _ d) (values t na (PSApart M a b j t (rpointapart-sym M a b (RApartY M sx sy tx ty x y u v d))))))
    (values t na (PSNear M a b j t (MkNearPoint M tx ty u v j ax ay nx ny))))
  (def-fns _ $ (erased left-apart : (erased (RPoint M) p q r) (erased (RLeft M p q r) l) -> (erased (RPointApart M r p) rp) (erased (RPointApart M r q) rq))
    (let ((erased J) (erased h)) (left-margin M p q r l))
    (let ((erased a) (erased na) (erased sa)) (point-split p r J))
    (let ((erased b) (erased nb) (erased sb)) (point-split q r J))
    (let-match erased sa (PSApart _ _ _ _ _ rp)
      (absurd (PSNear _ _ _ _ _ nr) (qleft-pqp a b (left-approx p q r J J h (zle-refl J) a b a na nb nr))))
    (let-match erased sb (PSApart _ _ _ _ _ rq)
      (absurd (PSNear _ _ _ _ _ nr) (qleft-pqq a b (left-approx p q r J J h (zle-refl J) a b b na nb nr))))
    (values rp rq))
  (values (level-of left-apart) (MkLeftKit M (level-of left-apart) left-apart)))
