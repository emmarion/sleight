                (qev-add (qev-var 4) (qev-add (qev-add (qev-mul (qev-var 5) (qev-var 6) hdl) (qev-mul (qev-var 5) (qev-var 6) hdl) hi2) (qev-mul (qev-var 5) (qev-var 6) hdl) hj2) he2) hv1)
              (qev-var 7) hv2)
            (qev-minus _ _ _ _ _ _ (qev-minus _ _ _ _ _ _ (qev-var 3) (qev-var 2) hc) (qev-mul (qev-two) (qev-var 4) he) hg) hv3) hs)
