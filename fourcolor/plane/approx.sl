    (values sa d2 d3 e hsa hd2 hd3 he w))
  (def-fns _ $ (erased left-approx : (erased (RPoint M) p q r) (erased (Z) J j) (erased (LeftMargin M p q r J) h) (erased (ZLe j J) hj)
      (erased (QPoint) a b c) (erased (NearPoint M p j a) na) (erased (NearPoint M q j b) nb) (erased (NearPoint M r j c) nc)
      -> (erased (QLeft a b c) l))
    (let-match erased h (MkLeftMargin _ _ _ _ s1 s2 h1 h2 m _ v ra rb rc d e g w cv k k6 cJ y ha hb hc hd he hg lt sp sq sr jv hcv hk hk6 pk6 hcJ hy ly))
