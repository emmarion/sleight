    (qr-le (OLe) _ _ (qr-lin (OLe) qzero y x s s t (QRLe _ _ hy) hs ht (qring-eq env _ _ s t qr-plus-zero-r (qev-add (qev-var 0) (qev-var 1) hs) (qev-add (qev-add (qev-var 0) (qev-var 1) hs) (qev-zero) ht))))
    (qr-le (OLe) _ _ (qr-lin (OLe) qzero x y s u t (QRLe _ _ hx) hu ht (qring-eq env _ _ u t qr-plus-zero-l (qev-add (qev-var 1) (qev-var 0) hu) (qev-add (qev-add (qev-var 0) (qev-var 1) hs) (qev-zero) ht))))))

(def-fns _ $ (erased qmult-nonneg : (erased (Q) x y z) (erased (QLe qzero x) hx) (erased (QLe qzero y) hy) (erased (QMult x y z) h)
    -> (erased (QLe qzero z) r))
