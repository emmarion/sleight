  (let ((erased s) (erased hs)) (qplus m12 m3))
  (values s (MkQShoelace px py qx qy rx ry s (MkShoe (Q) QMult QPlus px py qx qy rx ry m1 m2 m3 m12 s h1 h2 h3 h12 hs))))

