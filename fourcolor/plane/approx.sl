(comptime-match many (qring-check (ZEAdd (zvar 0) (zvar 1)) (ZEAdd (ZEAdd (zvar 0) (zvar 1)) (ZENum (Zero)))) (Some _ qr-plus-zero-r))

(def-fns _ $ (erased qle-plus : (erased (Q) x y s) (erased (QLe qzero x) hx) (erased (QLe qzero y) hy) (erased (QPlus x y s) hs)
    -> (erased (QLe x s) lx) (erased (QLe y s) ly))
