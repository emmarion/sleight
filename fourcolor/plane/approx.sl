(def-fns _ $ (erased qclose-plus : (erased (Q) xa xb s ya yb y t c d1 d2 e1 e2 c1) (erased (Z) k k1)
    (erased (QClose xa ya e1) wa) (erased (QPlus c d1 e1) he1) (erased (QClose xb yb e2) wb) (erased (QPlus c d2 e2) he2)
    (erased (QPlus xa xb s) hs) (erased (QPlus ya yb y) hy) (erased (QRed y t) hr)
    (erased (QPower qtwo k c) hc) (erased (ZAdd k (Zpos (Zero)) k1) hk) (erased (QPower qtwo k1 c1) hc1)
    -> (erased (Q) d e) (erased (QPlus d1 d2 d) hd) (erased (QPlus c1 d e) he) (erased (QClose s t e) w))
  (let-match erased wa (MkQClose _ _ _ da fa hda hfa la))
  (let-match erased wb (MkQClose _ _ _ db fb hdb hfb lb))
  (let ((erased z) (erased hz)) (qminus s t))
  (let ((erased z0) (erased hz0)) (qminus s y))
  (let ((erased sg) (erased hsg)) (qplus da db))
  (let ((erased fz) (erased hfz)) (qabs z))
  (let ((erased g) (erased hg)) (qplus e1 e2))
  (let ((erased d) (erased hd)) (qplus d1 d2))
  (let ((erased e) (erased he)) (qplus c1 d))
  (let ((erased w2) (erased hw2)) (qmult qtwo c))
  (let ((erased ez)) (qeq-trans z z0 sg (qminus-qeq-r s t y z z0 (qeq-sym y t (qred-correct y t hr)) hz hz0)
    (qring-eq (Cons _ xa $ Cons _ xb $ Cons _ ya $ Cons _ yb $ Nil (Q)) _ _ z0 sg qr-sum-diff
      (qev-minus _ _ _ _ _ _ (qev-add (qev-var 0) (qev-var 1) hs) (qev-add (qev-var 2) (qev-var 3) hy) hz0)
      (qev-add (qev-minus _ _ _ _ _ _ (qev-var 0) (qev-var 2) hda) (qev-minus _ _ _ _ _ _ (qev-var 1) (qev-var 3) hdb) hsg))))
  (let ((erased u1) (erased hu1)) (qplus g c1))
  (let ((erased u2) (erased hu2)) (qplus e w2))
  (let ((erased lg)) (qr-le (OLe) _ _ (qr-lin (OLe) w2 c1 g e u1 u2 (QRLe _ _ (qeq-le w2 c1 (qpower2-succ k k1 c c1 w2 hc hk hc1 hw2))) hu1 hu2
    (qring-eq (Cons _ c $ Cons _ d1 $ Cons _ d2 $ Cons _ c1 $ Nil (Q)) _ _ u1 u2 qr-double-up
      (qev-add (qev-add (qev-add (qev-var 0) (qev-var 1) he1) (qev-add (qev-var 0) (qev-var 2) he2) hg) (qev-var 3) hu1)
      (qev-add (qev-add (qev-var 3) (qev-add (qev-var 1) (qev-var 2) hd) he) (qev-mul (qev-two) (qev-var 0) hw2) hu2)))))
  (values d e hd he (MkQClose s t e z fz hz hfz (qle-trans fz g e (abs-sum-le da db sg z fa fb fz e1 e2 g hsg ez hfa la hfb lb hg hfz) lg))))

