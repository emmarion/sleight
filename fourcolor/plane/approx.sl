    (let ((erased g3) (erased hg3) (erased w3)) (mult-approx rx py m3 xr yp p3 n1 j v v3 cx ay k3 c1 dl hv3 ncx nay e3 srx spy tol hc1))
    (let ((erased d2) (erased e12) (erased hd2) (erased he12) (erased w12))
