                (qev-mul (qev-two) (qev-var 6) hw2) hu2) (qev-mul (qev-var 5) (qev-var 0) hYcj) hu3)
            (qev-mul (qev-var 4) (qev-var 0) hXcj) hu4) ht)))))
    (values e he (MkQClose pq r e zd fz hz hfz (qle-trans fz Bs e lz lB))))
  (def-fns _ $ (erased shoe-approx : (erased (RPoint M) p q r) (erased (Spec) s) (erased (RShoelace M p q r s) h) (erased (Z) n j v) (erased (Q) t cn dl)
      (erased (SeqAt s n t) ht) (erased (QPower qtwo n cn) hcn) (erased (QPoint) a b c) (erased (NearPoint M p j a) na) (erased (NearPoint M q j b) nb)
