(def-fns _ $ (erased qabs-qeq : (erased (Q) x y a b) (erased (QEq x y) e) (erased (QAbs x a) ha) (erased (QAbs y b) hb) -> (erased (QEq a b) r))
  (let-match erased e (MkQEq nx ny l dx dy hl hr))
  (let-match erased ha (MkQAbs _ ma _ hma))
  (let-match erased hb (MkQAbs _ mb _ hmb))
  (let ((erased e1) (erased he1) (erased hab1)) (zabs-mul-pos nx l ma dy hl hma))
  (let ((erased e2) (erased he2) (erased hab2)) (zabs-mul-pos ny l mb dx hr hmb))
  (let-match erased (zabs-fn _ _ _ hab1 hab2) (Refl _ _))
  (MkQEq ma mb e1 dx dy he1 he2))

(def-fns _ $ (erased abs-sum-le : (erased (Q) x y s z a b c e f g) (erased (QPlus x y s) hs) (erased (QEq z s) hz)
    (erased (QAbs x a) ha) (erased (QLe a e) hae) (erased (QAbs y b) hb) (erased (QLe b f) hbf) (erased (QPlus e f g) hg) (erased (QAbs z c) hc)
    -> (erased (QLe c g) r))
  (let ((erased c2) (erased hc2)) (qabs s))
  (let ((erased t) (erased ht)) (qplus a b))
  (qle-trans c c2 g (qeq-le c c2 (qabs-qeq z s c c2 hz hc hc2))
    (qle-trans c2 t g (qabs-triangle x y s a b c2 t hs ha hb hc2 ht) (qplus-le-compat a e b f t g hae hbf ht hg))))

(def-fns _ $ (erased abs-mul-le : (erased (Q) x y t a b e f g c) (erased (QMult x y t) h)
    (erased (QAbs x a) ha) (erased (QLe a e) hae) (erased (QAbs y b) hb) (erased (QLe b f) hbf) (erased (QMult e f g) hg) (erased (QAbs t c) hc)
    -> (erased (QLe c g) r))
  (let ((erased w) (erased hw)) (qmult a b))
  (let-match erased (qabs-qmult x y t a b c w h ha hb hc hw) (Refl _ _))
  (let ((erased eb) (erased heb)) (qmult e b))
  (let ((erased be) (erased hbe)) (qmult b e))
  (let ((erased fe) (erased hfe)) (qmult f e))
  (let-match erased (qmult-comm _ _ _ _ heb hbe) (Refl _ _))
  (let-match erased (qmult-comm _ _ _ _ hg hfe) (Refl _ _))
  (let ((erased pe)) (qle-trans _ a e (qabs-nonneg x a ha) hae))
  (qle-trans c eb g (qmult-le-compat-r a e b c eb (qabs-nonneg y b hb) hae hw heb) (qmult-le-compat-r b f e be g pe hbf hbe hfe)))

