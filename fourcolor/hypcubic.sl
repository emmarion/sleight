; cubic_Euler of geometry.v: in a connected map whose edges have two darts and nodes three, 6 kf + 12 genus = d + 12 for
; the number kf of faces, so the genus is 0 exactly when 6 kf = d + 12. Needs ring.sl for the products.

(def-fns _ $ (erased double-mul : (erased (Nat) a b) (subterm erased (Double a b) db) -> (erased (Mul a (Succ (Succ (Zero))) b) r))
  (let-match erased db (DS a1 b1 db1) ((D0) (MulZero _)))
  (MulSucc a1 _ b1 _ (double-mul a1 b1 db1) (add-succ-right b1 _ _ (add-succ-right b1 _ _ (add-zero-right b1)))))

(def-fns _ $ (erased cubic-euler : (erased (Nat) d gen kf) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h)
    (erased (AllOrder d e (Succ (Succ (Zero)))) plain) (erased (AllOrder d n (Succ (Succ (Succ (Zero))))) cubic) (erased (Connected d e n f) cc)
    (erased (Genus d e n f gen) p) (erased (Orbits d f kf) of)
    -> (erased (Nat) a b s) (erased (Mul kf (Succ (Succ (Succ (Succ (Succ (Succ (Zero))))))) a) ma)
    (erased (Mul gen (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Zero))))))))))))) b) mb)
    (erased (Add a b s) ab) (erased (Add d (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Zero))))))))))))) s) ds))
  (let ((erased one)) (Succ (Zero)))
  (let ((erased two)) (Succ one))
  (let ((erased three)) (Succ two))
  (let ((erased six)) (Succ (Succ (Succ three))))
  (let ((erased twelve)) (Succ (Succ (Succ (Succ (Succ (Succ six)))))))
  (let ((erased (Mul one six six) m16)) (MulSucc _ _ _ _ (MulZero six) (AddZero six)))
  (let ((erased (Mul two three six) m23)) (MulSucc _ _ _ _ (MulSucc _ _ _ _ (MulZero three) (AddZero three)) (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddZero three))))))
  (let ((erased (Mul three two six) m32)) (MulSucc _ _ _ _ (MulSucc _ _ _ _ (MulSucc _ _ _ _ (MulZero two) (AddZero two))
      (AddSucc _ _ _ (AddSucc _ _ _ (AddZero two)))) (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddZero two)))))))
  (let ((erased (Mul two six twelve) m26)) (MulSucc _ _ _ _ m16
      (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddZero six)))))))))
  (let ((erased (Add three three six) a33)) (AddSucc _ _ _ (AddSucc _ _ _ (AddSucc _ _ _ (AddZero three)))))
  (let ((erased (Add two one three) a21)) (AddSucc _ _ _ (AddSucc _ _ _ (AddZero one))))
  (let ((erased nf) (erased ni) (erased _) (erased _) (erased pe) (erased pn) (erased _)) (hyper-core d e n f h))
  (let-match erased p (MkGenus _ _ ke kn kf2 kc _ lhs s1 rhs g2 _ _ _ g oe on of2 gl cs dc al a1 ar dg ag))
  (let-match erased (orbits-unique d kf2 kf f of2 of) (Refl _ _))
  (let-match erased cc (MkConnected _ _ _ _ g3 gl3 cs3))
  (let-match erased (glink-fn d e n f g g3 gl gl3) (Refl _ _))
  (let-match erased (classes-unique g d kc one cs cs3) (Refl _ _))
  (let-match erased dc (DS _ _ dc1))
  (let-match erased dc1 (D0))
  (let ((erased me)) (orbit-count d ke two e nf pe oe plain))
  (let ((erased mn)) (orbit-count d kn three n ni pn on cubic))
  (let ((erased l6) (erased pl6)) (mul lhs six))
  (let ((erased g6) (erased pg6)) (mul g2 six))
  (let ((erased r6) (erased pr6)) (mul rhs six))
  (let ((erased s6) (erased ps6)) (mul s1 six))
  (let ((erased f6) (erased pf6)) (mul kf six))
  (let ((erased e6) (erased pe6)) (mul ke six))
  (let ((erased n6) (erased pn6)) (mul kn six))
  (let ((erased d3) (erased pd3)) (mul d three))
  (let ((erased d2) (erased pd2)) (mul d two))
  (let ((erased d6) (erased pd6)) (mul d six))
  (let-match erased (mul-fn ke six e6 d3 pe6 (mul-assoc ke two three d d3 six me pd3 m23)) (Refl _ _))
  (let-match erased (mul-fn kn six n6 d2 pn6 (mul-assoc kn three two d d2 six mn pd2 m32)) (Refl _ _))
  (let ((erased gw)) (mul-assoc gen two six g2 g6 twelve (double-mul gen g2 dg) pg6 m26))
  (let ((erased a66)) (mul-distr g2 rhs lhs six g6 r6 l6 ag pg6 pr6 pl6))
  (let ((erased asf)) (mul-distr s1 kf rhs six s6 f6 r6 ar ps6 pf6 pr6))
  (let ((erased aen)) (mul-distr ke kn s1 six e6 n6 s6 a1 pe6 pn6 ps6))
  (let ((erased adt)) (mul-distr d two lhs six d6 twelve l6 (add-comm two d lhs al) pd6 m26 pl6))
  (let ((erased a3d)) (mul-distr three three six d d3 d3 d6 a33 (mul-comm d three d3 pd3) (mul-comm d three d3 pd3) (mul-comm d six d6 pd6)))
  (let ((erased a2d)) (mul-distr two one three d d2 d d3 a21 (mul-comm d two d2 pd2) (MulSucc _ _ _ _ (MulZero d) (AddZero d)) (mul-comm d three d3 pd3)))
  (let ((erased gs) (erased p1) (erased p2)) (add-assoc-inv g6 s6 f6 r6 l6 asf a66))
  (let ((erased gf) (erased p3) (erased p4)) (add-assoc s6 g6 f6 gs l6 (add-comm g6 s6 gs p1) p2))
  (let ((erased y) (erased p5) (erased p6)) (add-assoc-inv d3 d2 d d3 d6 a2d a3d))
  (let-match erased (add-fn d3 d2 y s6 p5 aen) (Refl _ _))
  (let ((erased dt) (erased p7) (erased p8)) (add-assoc s6 d twelve d6 l6 p6 adt))
  (let-match erased (add-cancel s6 gf dt l6 p4 p8) (Refl _ _))
  (values f6 g6 gf pf6 gw (add-comm g6 f6 gf p3) p7))

; The genus is 0 exactly when 6 kf = d + 12.
(def-fns _ $ (erased cubic-planar : (erased (Nat) d kf) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h)
    (erased (AllOrder d e (Succ (Succ (Zero)))) plain) (erased (AllOrder d n (Succ (Succ (Succ (Zero))))) cubic) (erased (Connected d e n f) cc)
    (erased (Genus d e n f (Zero)) p) (erased (Orbits d f kf) of)
    -> (erased (Nat) s) (erased (Mul kf (Succ (Succ (Succ (Succ (Succ (Succ (Zero))))))) s) ma)
    (erased (Add d (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Succ (Zero))))))))))))) s) ds))
  (let ((erased a) (erased _) (erased s) (erased ma) (erased mb) (erased ab) (erased ds)) (cubic-euler d (Zero) kf e n f h plain cubic cc p of))
  (let-match erased mb (MulZero _))
  (let-match erased (add-fn a (Zero) s a ab (add-zero-right a)) (Refl _ _))
  (values a ma ds))
