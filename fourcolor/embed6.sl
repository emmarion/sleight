  (let ((erased lem) (erased lnm) (erased lfm)) (hyper-lengths dm em nm fm hm))
  (let-match erased sc (MkSCycle _ _ _ _ yc fpc backc sm))
  (let-match erased sm (MkSimple _ _ lab lsr rfl rl dl))
  (let ((erased ur)) (resp-under lab lsr dc rc rl (respects-length lab fc lab dc rfl lfc)))
  (let ((erased crr) (erased sn)) (snoc-exists _ cp c0))
  (let ((erased hsn)) (fpath-hits nc crr c0 yc c0 cp fpc backc sn))
  (let ((erased erc) (erased re)) (respects-exists ec rc dc ur lec))
  (let ((erased err) (erased rer)) (respects-exists ec crr dc (sub-under crr rc dc (snoc-sub cp crr c0 sn) ur) lec))
  (let ((erased re2)) re)
  (let-match erased re2 (RespCons _ _ ep _ e0 pe0 re1))
  (let ((erased snr)) (resp-snoc ec cp crr ep err c0 e0 sn re1 pe0 rer))
  (let ((erased rfe)) (face-back dc ec nc fc rc crr err hc hsn rer))
  (let ((erased lens)) (respects-length lab fc lab dc rfl lfc))
  (let ((erased uerc)) (respects-under-vals ec rc erc dc re (perm-under dc ec nfc qe)))
  (let ((erased uerr)) (sub-under err erc dc (snoc-sub ep err e0 snr) uerc))
  (let ((erased cs) (erased c) (erased snc) (erased rcs) (erased pcxx)) (respects-unsnoc lab ep err lsr e0 snr (face-labs dc fc lab rc lsr err rfe rfl lens uerr rl)))
  (let ((erased rlerc)) (RespCons lab ep cs e0 c pcxx rcs))
  (let ((erased dle)) (distinct-rot c cs lsr snc dl))
  (let ((erased derc)) (distinct-back lab erc (Cons _ c cs) dle rlerc))
  (let ((erased yr) (erased tr) (erased rpr) (erased ptr) (erased spr)) (rp-build dc e0 e0 ec fc fic err rc qf ep (resp-back dc ec nc rc as ok rc erc re ur) rfe snr uerr))
  (let ((erased rg)) (MkRing ec fc ep e0 yr tr rpr ptr spr (MkSimple fc erc lab (Cons _ c cs) rfl rlerc dle)))
  (let ((erased m) (erased lerc)) (length-exists _ erc))
  (let ((erased lerc2)) lerc)
  (let-match erased lerc2 (LengthCons _ _ _ m1 lep))
  (let ((erased lerr)) (snoc-length _ ep err e0 m1 snr lep))
  (let ((erased qei)) (perm-sym dc ec nfc qe))
  (let ((erased sde) (erased sa1)) (setall-exists ec err dc m lec erc uerc lerc lerr))
  (let ((erased sdei) (erased sa2)) (setall-exists nfc erc dc m (perm-length dc nfc ec qei) err uerr lerr lerc))
  (let ((erased hs1)) (setall-hits ec erc err sde sa1 derc))
  (let ((erased hs2)) (setall-hits nfc err erc sdei sa2 (distinct-snoc-cons e0 ep err snr derc)))
  (let ((erased zr) (erased bcl) (erased sp)) (split-exists rc ids))
  (let ((erased uids)) (perm-under dc ids ids (perm-id dc ids io)))
  (let ((erased dzr) (erased dbcl)) (split-distinct rc ids zr bcl sp (iota-distinct dc ids io)))
  (let ((erased szr) (erased sbcl)) (split-sub rc ids zr bcl sp))
  (let ((erased ub)) (sub-under bcl ids dc sbcl uids))
  (let ((erased dd) (erased lbcl)) (length-exists _ bcl))
  (let ((erased web)) (erc-bcl dc ec nc rc as erc ids zr bcl ok re ur uerc io sp erc (within-refl erc)))
  (let ((erased seb)) (split-sub-t bcl erc erc (Nil _) (within-split bcl erc web)))
  (let ((erased see)) (sub-of-snoc ep err e0 snr erc (sub-refl erc)))
  (let ((erased ser)) (snoc-sub ep err e0 snr))
  (let ((erased wb)) (within-refl bcl))
  (let ((erased bj1)) (bij-build dc m ec nfc erc err bcl sde sdei qe sa1 sa2 hs1 hs2 lerc lerr seb see ser bcl
    (dsides-e dc e0 ec nc rc as ep err ids zr bcl nfc ok qe re ur snr io sp ub bcl wb)))
  (let ((erased bj2)) (dbij-n dc ec nc rc as ids zr bcl nic ok qn io sp ub bcl wb))
  (let ((erased idd) (erased ed) (erased edi) (erased iod) (erased pmed) (erased med0) (erased med1)) (restrict dd sde sdei bcl bj1 dbcl lbcl))
  (let ((erased idd2) (erased nd) (erased ndi) (erased iod2) (erased pmnd) (erased mnd) (erased mnd1)) (restrict dd nc nic bcl bj2 dbcl lbcl))
  (let-match erased (iota-fn dd idd idd2 iod iod2) (Refl _ _))
  (let ((erased fd) (erased hdm0)) (hyper-mk dd ed edi nd ndi pmed pmnd))
  (let ((erased hdm)) (hyper-rot dd fd ed nd hdm0))
  (let ((erased bd) (erased rbd)) (pos-exists bcl erc seb))
  (let ((erased led)) (perm-length dd ed edi pmed))
  (let ((erased y1) (erased fp1) (erased py1)) (hits-fpath sde err ep e0 e0 hs1 snr))
  (let ((erased cyd)) (ncyc-pull bcl ed sde idd erc bd dd med0 iod dbcl lbcl led rbd (NCCons sde ep e0 y1 fp1 py1)))
  (let ((erased dbd)) (distinct-back bcl bd erc derc rbd))
  (let ((erased ubd)) (resp-under bcl erc dd bd rbd lbcl))
  (let ((erased sd)) (disk-simple dc dd m e0 ec nc fc ep err sde lab (Cons _ c cs) ed nd fd bcl idd bd hc rg snr sa1 hs1 lerc lerr rfl rlerc dle hdm med0 mnd iod lbcl dbcl
    rbd dbd ubd))
  (let ((erased dk)) (MkDkCx dc dd m ec nc fc rc as erc err bcl ed nd fd sde idd crr hc ok re hsn rer sa1 hs1 lerc lerr hdm med0 mnd iod lbcl ub))
  (let ((erased hd) (erased rhd)) (respects-exists h1 bcl dc ub lh))
  (let ((erased rG) (erased rrg)) (respects-exists h1 erc dc uerc lh))
  (let ((erased RV) (erased rv)) (revapp-exists (Nat) rG (Nil _)))
  (let ((erased idm) (erased iom)) (iota-exists dm))
  (let ((erased zh) (erased zs) (erased spm)) (split-exists hd idm))
  (let ((erased hr) (erased ap)) (app-exists RV zs))
  (let ((erased rx)) (MkRCx dc dm ec rc erc bcl h1 hd RV zs hr ids zr idm zh rG io sp ub re ur uerc rhd rrg rv iom spm ap))
  (let ((erased rrg2)) rrg)
  (let-match erased rrg2 (RespCons _ _ G _ g0 pg0 rrg1))
  (let-match erased RV (Cons _ v0 V) (absurd (Nil _) (match erased (revapp-in rG (Nil _) RV g0 rv (OrL _ _ (InHere g0 G))) _)))
  (let ((erased RVR) (erased sn2)) (snoc-exists _ V v0))
  (let ((erased djb)) (split-disj rc ids zr bcl sp))
  (let ((erased drg)) (map-inj dc dm ec nc fc ksc rc em nm fm ksm as hl ids h1 rG cx erc derc (within-disj bcl rc erc web djb) rrg))
  (let ((erased lhd)) (respects-length h1 bcl hd dd rhd lbcl))
  (let ((erased dhd)) (map-inj dc dm ec nc fc ksc rc em nm fm ksm as hl ids h1 hd cx bcl dbcl djb rhd))
  (let ((erased uhd)) (respects-under-vals h1 bcl hd dm rhd uh))
  (let ((erased lrg)) (respects-length h1 erc rG m rrg lerc))
  (let ((erased dRV)) (revapp-distinct rG (Nil _) RV rv drg (DistNil) (off-nil rG)))
  (let ((erased lRV)) (revapp-length rG (Nil _) RV m (Zero) m rv lrg (LengthNil _) (add-zero-right m)))
  (let ((erased lRV2)) lRV)
  (let-match erased lRV2 (LengthCons _ _ _ mv lV))
  (let ((erased lRVR)) (snoc-length _ V RVR v0 mv sn2 lV))
  (let ((erased dRVR)) (distinct-snoc-cons v0 V RVR sn2 dRV))
  (let ((erased wrh)) (rv-hd dc dm ec nc rc as erc bcl h1 hd RV zs hr ok rx RV (within-refl RV)))
  (let ((erased srh)) (split-sub-t hd RV RV (Nil _) (within-split hd RV wrh)))
  (let ((erased dzh) (erased dzs)) (split-distinct hd idm zh zs spm (iota-distinct dm idm iom)))
  (let ((erased szh) (erased szs)) (split-sub hd idm zh zs spm))
  (let ((erased dhr)) (app-distinct RV zs hr ap dRV dzs (disj-sym zs hd (split-disj hd idm zh zs spm) RV srh)))
  (let ((erased uidm)) (perm-under dm idm idm (perm-id dm idm iom)))
  (let ((erased uRV)) (sub-under RV hd dm srh uhd))
  (let ((erased uhr)) (sub-under hr idm dm (app-sub RV zs hr idm ap (under-sub dm RV idm uRV iom) szs) uidm))
  (let ((erased dr) (erased lhr)) (length-exists _ hr))
  (let ((erased srv)) (snoc-sub V RVR v0 sn2))
  (let ((erased uRVR)) (sub-under RVR RV dm srv uRV))
  (let ((erased snm) (erased sa3)) (setall-exists nm RVR dm m lnm RV uRV lRV lRVR))
  (let ((erased snmi) (erased sa4)) (setall-exists nim RV dm m (perm-length dm nim nm (perm-sym dm nm nim qnm)) RVR uRVR lRVR lRV))
  (let ((erased hs3)) (setall-hits nm RV RVR snm sa3 dRV))
  (let ((erased hs4)) (setall-hits nim RVR RV snmi sa4 dRVR))
  (let ((erased shrx)) (app-sub-l RV zs hr RV ap (sub-refl RV)))
  (let ((erased whr)) (within-refl hr))
  (let ((erased bj3)) (rbij-e dc dm ec nc fc ksc rc em nm fm ksm as hl ids h1 erc bcl hd RV zs hr nfm cx rx qem uhr g hr whr))
  (let ((erased bj4)) (bij-build dm m nm nim RV RVR hr snm snmi qnm sa3 sa4 hs3 hs4 lRV lRVR shrx (sub-of-snoc V RVR v0 sn2 RV (sub-refl RV)) srv hr
    (rsides-n dc dm v0 ec nc fc ksc rc em nm fm ksm as hl ids h1 erc bcl hd V zs hr nim RVR cx rx qnm uhr sn2 wrh hr whr)))
  (let ((erased idr) (erased er) (erased eri) (erased ior) (erased pmer) (erased mer) (erased mer1)) (restrict dr em nfm hr bj3 dhr lhr))
  (let ((erased idr2) (erased nr) (erased nri) (erased ior2) (erased pmnr) (erased mnr0) (erased mnr1)) (restrict dr snm snmi hr bj4 dhr lhr))
  (let-match erased (iota-fn dr idr idr2 ior ior2) (Refl _ _))
  (let ((erased fr) (erased hrm0)) (hyper-mk dr er eri nr nri pmer pmnr))
  (let ((erased hrm)) (hyper-rot dr fr er nr hrm0))
  (let ((erased br) (erased rbr)) (pos-exists hr RV shrx))
  (let ((erased y2) (erased fp2) (erased py2)) (hits-fpath snm RVR V v0 v0 hs3 sn2))
  (let ((erased cyr)) (ncyc-pull hr nr snm idr RV br dr mnr0 ior dhr lhr (perm-length dr nr nri pmnr) rbr (NCCons snm V v0 y2 fp2 py2)))
  (let ((erased uidsx)) (perm-under dc ids ids (perm-id dc ids io)))
