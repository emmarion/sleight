; Renaming darts by a permutation s: classes and orbit counts are kept, and the mirror keeps the genus.

; g2 is g with both ends of every bond renamed by s.
(def-adts $ (MapB : ((List (Nat)) s) ((List (Bond)) g g2) -> Type)
  enum
  (many MapNil : (erased (List (Nat)) s) -> (MapB s (Nil (Bond)) (Nil (Bond))))
  (many MapCons : (erased (List (Nat)) s) (erased (List (Bond)) g g2) (erased (Nat) x y x2 y2) (erased (Nth (Nat) s x x2) px)
      (erased (Nth (Nat) s y y2) py) (erased (MapB s g g2) rest)
      -> (MapB s (Cons (Bond) (MkBond x y) g) (Cons (Bond) (MkBond x2 y2) g2))))

(def-fns _ $ (erased map-exists : (erased (Nat) d) (erased (List (Nat)) s si) (erased (List (Bond)) g) (subterm erased (Below g d) bg)
    (erased (Perm d s si) pm) -> (erased (List (Bond)) g2) (erased (MapB s g g2) r))
  (let-match erased bg (BelowCons g1 x y _ lx ly bg1) ((BelowNil _) (values (Nil _) (MapNil s))))
  (let ((erased x2) (erased px) (erased _)) (perm-nth d x s si pm lx))
  (let ((erased y2) (erased py) (erased _)) (perm-nth d y s si pm ly))
  (let ((erased g3) (erased m1)) (map-exists d s si g1 bg1 pm))
  (values (Cons _ (MkBond x2 y2) g3) (MapCons s g1 g3 x y x2 y2 px py m1)))

(def-fns _ $ (erased adj-map : (erased (List (Nat)) s) (erased (List (Bond)) g g2) (erased (Nat) x y x2 y2) (subterm erased (Adj g x y) a)
    (erased (MapB s g g2) mb) (erased (Nth (Nat) s x x2) px) (erased (Nth (Nat) s y y2) py) -> (erased (Adj g2 x2 y2) r))
  (let-match erased mb (MapCons _ g1 g3 u v u2 v2 pu pv mb1) (absurd (MapNil _) a))
  (match erased a _
    ((AdjFwd _ _ _)
      (let-match erased (nth-fn _ s x x2 u2 px pu) (Refl _ _))
      (let-match erased (nth-fn _ s y y2 v2 py pv) (Refl _ _))
      (AdjFwd g3 x2 y2))
    ((AdjBwd _ _ _)
      (let-match erased (nth-fn _ s y y2 u2 py pu) (Refl _ _))
      (let-match erased (nth-fn _ s x x2 v2 px pv) (Refl _ _))
      (AdjBwd g3 y2 x2))
    ((AdjThere _ _ _ _ a1) (AdjThere g3 (MkBond u2 v2) x2 y2 (adj-map s g1 g3 x y x2 y2 a1 mb1 px py)))))

(def-fns _ $ (erased conn-map : (erased (Nat) d) (erased (List (Nat)) s si) (erased (List (Bond)) g g2) (erased (Nat) x y x2 y2)
    (subterm erased (Conn g x y) c) (erased (MapB s g g2) mb) (erased (Below g d) bg) (erased (Perm d s si) pm) (erased (Nth (Nat) s x x2) px)
    (erased (Nth (Nat) s y y2) py) -> (erased (Conn g2 x2 y2) r))
  (let-match erased c (ConnStep _ _ w _ a c1) ((ConnHere _ _) (let-match erased (nth-fn _ s x x2 y2 px py) (Refl _ _)) (ConnHere g2 x2)))
  (let ((erased w2) (erased pw) (erased _)) (perm-nth d w s si pm (below-adj g d x w a bg)))
  (ConnStep g2 x2 w2 y2 (adj-map s g g2 x w x2 w2 a mb px pw) (conn-map d s si g g2 w y w2 y2 c1 mb bg pm pw py)))

(def-fns _ $ (erased in-map : (erased (List (Nat)) s rs rs2) (erased (Nat) r r2) (subterm erased (In r rs) pin) (erased (Respects s rs rs2) rp)
    (erased (Nth (Nat) s r r2) pr) -> (erased (In r2 rs2) res))
  (let-match erased rp (RespCons _ rs1 rs3 j l pj rp1) (absurd (RespNil _) pin))
  (let-match erased pin (InThere _ _ _ pin1) ((InHere _ _) (let-match erased (nth-fn _ s r r2 l pr pj) (Refl _ _)) (InHere r2 rs3)))
  (InThere r2 l rs3 (in-map s rs1 rs3 r r2 pin1 rp1 pr)))

(def-fns _ $ (erased notin-map : (erased (Nat) d) (erased (List (Nat)) s si rs rs2) (erased (Nat) x x2) (erased (NotIn x rs) out)
    (subterm erased (Respects s rs rs2) rp) (erased (Nth (Nat) s x x2) px) (erased (Perm d s si) pm) -> (erased (NotIn x2 rs2) r))
  (let-match erased rp (RespCons _ rs1 rs3 j l pj rp1) ((RespNil _) (NotInNil x2)))
  (let-match erased out (NotInCons _ _ _ ne out1))
  (NotInCons x2 l rs3 (img-apart d x j x2 l s si pm px pj ne) (notin-map d s si rs1 rs3 x x2 out1 rp1 px pm)))

(def-fns _ $ (erased distinct-map : (erased (Nat) d) (erased (List (Nat)) s si rs rs2) (erased (Distinct rs) dr)
    (subterm erased (Respects s rs rs2) rp) (erased (Perm d s si) pm) -> (erased (Distinct rs2) r))
  (let-match erased rp (RespCons _ rs1 rs3 j l pj rp1) ((RespNil _) (DistNil)))
  (let-match erased dr (DistCons _ _ out dr1))
  (DistCons l rs3 (notin-map d s si rs1 rs3 j l out rp1 pj pm) (distinct-map d s si rs1 rs3 dr1 rp1 pm)))

(def-fns _ $ (erased under-nth : (erased (List (Nat)) xs) (erased (Nat) j x d) (erased (Under xs d) u) (subterm erased (Nth (Nat) xs j x) p)
    -> (erased (Lt x d) r))
  (let-match erased u (UnderCons xs1 y _ ly u1) (absurd (UnderNil _) p))
  (let-match erased p (NthThere _ _ _ j1 _ p1) ((NthHere _ _ _) ly))
  (under-nth xs1 j1 x d u1 p1))

(def-fns _ $ (erased respects-under-out : (erased (List (Nat)) lab xs ls) (erased (Nat) d) (subterm erased (Respects lab xs ls) rp)
    (erased (Under lab d) ul) -> (erased (Under ls d) r))
  (let-match erased rp (RespCons _ xs1 ls1 j l p rp1) ((RespNil _) (UnderNil d)))
  (UnderCons ls1 l d (under-nth lab j l d ul p) (respects-under-out lab xs1 ls1 d rp1 ul)))

(def-fns _ $ (erased rooted-under : (erased (List (Bond)) g) (erased (List (Nat)) rs xs ls lab) (erased (Nat) d) (subterm erased (Rooted g rs xs ls) ro)
    (erased (Respects lab rs rs) fix) (erased (Length (Nat) lab d) ll) -> (erased (Under ls d) r))
  (let-match erased ro (RootedCons _ _ xs1 ls1 x r pin c ro1) ((RootedNil _ _) (UnderNil d)))
  (UnderCons ls1 r d (nth-lt-length _ lab r d r (fixed-in lab rs r fix pin) ll) (rooted-under g rs xs1 ls1 lab d ro1 fix ll)))

; lab2 = s . lab . si.
(def-adts $ (Relab : ((Nat) d) ((List (Nat)) s lab lab2) -> Type)
  enum
  (many MkRelab : (erased (Nat) d) (erased (List (Nat)) s si lab l1 lab2) (erased (Perm d s si) pm) (erased (Respects lab si l1) r1)
      (erased (Respects s l1 lab2) r2) (erased (Length (Nat) l1 d) ll1) (erased (Length (Nat) lab2 d) ll2) -> (Relab d s lab lab2)))

(def-fns _ $ (erased relab-at : (erased (Nat) d x x2 l l2) (erased (List (Nat)) s lab lab2) (erased (Relab d s lab lab2) rl)
    (erased (Nth (Nat) s x x2) px) (erased (Nth (Nat) lab x l) pl) (erased (Nth (Nat) s l l2) pl2) -> (erased (Nth (Nat) lab2 x2 l2) r))
  (let-match erased rl (MkRelab _ _ si _ l1 _ pm r1 r2 ll1 ll2))
  (let ((erased lx2)) (perm-val d x x2 s si pm px))
  (let ((erased v) (erased pv)) (nth-exists _ l1 d x2 ll1 lx2))
  (let-match erased (nth-fn _ lab x l v pl (respects-nth lab si l1 x2 x v r1 (perm-inv d x x2 s si pm px) pv)) (Refl _ _))
  (let ((erased w) (erased pw)) (nth-exists _ lab2 d x2 ll2 lx2))
  (let-match erased (nth-fn _ s l l2 w pl2 (respects-nth s l1 lab2 x2 l w r2 pv pw)) (Refl _ _))
  pw)

(def-fns _ $ (erased fix-map : (erased (Nat) d) (erased (List (Nat)) s lab lab2 rs rs2) (subterm erased (Respects lab rs rs) fix)
    (erased (Respects s rs rs2) rrs) (erased (Relab d s lab lab2) rl) -> (erased (Respects lab2 rs2 rs2) r))
  (let-match erased fix (RespCons _ rs1 _ j _ pj fix1) ((RespNil _) (let-match erased rrs (RespNil _)) (RespNil lab2)))
  (let-match erased rrs (RespCons _ _ rs3 _ j2 pj2 rrs1))
  (RespCons lab2 rs3 rs3 j2 j2 (relab-at d j j2 j j2 s lab lab2 rl pj2 pj pj2) (fix-map d s lab lab2 rs1 rs3 fix1 rrs1 rl)))

(def-fns _ $ (erased const-map : (erased (Nat) d) (erased (List (Nat)) s si lab lab2) (erased (List (Bond)) g g2) (subterm erased (MapB s g g2) mb)
    (erased (Const lab g) cl) (erased (Relab d s lab lab2) rl) (erased (Perm d s si) pm) (erased (Under lab d) ul) -> (erased (Const lab2 g2) r))
  (let-match erased mb (MapCons _ g1 g3 x y x2 y2 px py mb1) ((MapNil _) (ConstNil lab2)))
  (let-match erased cl (ConstCons _ _ _ _ l lx ly cl1))
  (let ((erased l2) (erased pl) (erased _)) (perm-nth d l s si pm (under-nth lab x l d ul lx)))
  (ConstCons lab2 g3 x2 y2 l2 (relab-at d x x2 l l2 s lab lab2 rl px lx pl) (relab-at d y y2 l l2 s lab lab2 rl py ly pl)
    (const-map d s si lab lab2 g1 g3 mb1 cl1 rl pm ul)))

; The positions xs, with us = si . xs, ls1 = lab . us and ls2 = s . ls1, are rooted in the renamed graph.
(def-fns _ $ (erased rooted-map : (erased (Nat) d) (erased (List (Nat)) s si lab ids rs rs2 xs us ls1 ls2) (erased (List (Bond)) g g2)
    (subterm erased (Respects si xs us) rx) (erased (Respects lab us ls1) ru) (erased (Respects s ls1 ls2) rv)
    (erased (Iota d ids) io) (erased (Rooted g rs ids lab) ro) (erased (Respects s rs rs2) rrs) (erased (MapB s g g2) mb) (erased (Below g d) bg)
    (erased (Perm d s si) pm) -> (erased (Rooted g2 rs2 xs ls2) r))
  (let-match erased rx (RespCons _ xs1 us1 x u pu rx1)
    ((RespNil _) (let-match erased ru (RespNil _)) (let-match erased rv (RespNil _)) (RootedNil g2 rs2)))
  (let-match erased ru (RespCons _ _ ls3 _ r pr ru1))
  (let-match erased rv (RespCons _ _ ls4 _ r2 pr2 rv1))
  (let ((erased qm)) (perm-sym d s si pm))
  (let ((erased pin) (erased c)) (classes-root g d ids lab rs u r io ro pr (perm-val d x u si s qm pu)))
  (RootedCons g2 rs2 xs1 ls4 x r2 (in-map s rs rs2 r r2 pin rrs pr2)
    (conn-map d s si g g2 r u r2 x c mb bg pm pr2 (perm-inv d x u si s qm pu))
    (rooted-map d s si lab ids rs rs2 xs1 us1 ls3 ls4 g g2 rx1 ru1 rv1 io ro rrs mb bg pm)))

; Renaming the darts keeps the count of classes.
(def-fns _ $ (erased classes-map : (erased (Nat) d k) (erased (List (Nat)) s si) (erased (List (Bond)) g g2) (erased (Perm d s si) pm)
    (erased (MapB s g g2) mb) (erased (Classes g d k) cs) -> (erased (Classes g2 d k) r))
  (let-match erased cs (MkClasses _ _ _ ids lab rs io ll lr dr fix cl ro))
  (let-match erased pm (MkPerm _ _ _ ids2 io2 ls sis ssi))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased lsi)) (respects-length-inv s si ids d ssi (iota-length d ids io)))
  (let ((erased ul)) (rooted-under g rs ids lab lab d ro fix ll))
  (let ((erased l1) (erased r1)) (respects-exists lab si d (perm-under d si s (perm-sym d s si pm)) ll))
  (let ((erased ll1)) (respects-length lab si l1 d r1 lsi))
  (let ((erased lab2) (erased r2)) (respects-exists s l1 d (respects-under-out lab si l1 d r1 ul) ls))
  (let ((erased rl)) (MkRelab d s si lab l1 lab2 pm r1 r2 ll1 (respects-length s l1 lab2 d r2 ll1)))
  (let ((erased rs2) (erased rrs)) (respects-exists s rs d (respects-under lab rs rs d fix ll) ls))
  (MkClasses g2 d k ids lab2 rs2 io (respects-length s l1 lab2 d r2 ll1) (respects-length s rs rs2 k rrs lr) (distinct-map d s si rs rs2 dr rrs pm)
    (fix-map d s lab lab2 rs rs2 fix rrs rl) (const-map d s si lab lab2 g g2 mb cl rl pm ul)
    (rooted-map d s si lab ids rs rs2 ids si l1 lab2 g g2 (respects-id-right d ids si io lsi) r1 r2 io ro rrs mb (classes-below g d k cs) pm)))

(def-fns _ $ (erased fun-below : (erased (Nat) d) (erased (List (Nat)) p) (erased (List (Bond)) g) (subterm erased (Fun p g) f) (erased (Length (Nat) p d) lp)
    (erased (Under p d) up) -> (erased (Below g d) r))
  (let-match erased f (FunCons _ g1 x y px f1) ((FunNil _) (BelowNil d)))
  (BelowCons g1 x y d (nth-lt-length _ p x d y px lp) (under-nth p x y d up px) (fun-below d p g1 f1 lp up)))

; p2 = s . p . si, with t = p . si.
(def-fns _ $ (erased spans-conj-in : (erased (Nat) d) (erased (List (Nat)) s si p t p2) (erased (List (Bond)) gp gm gp2) (subterm erased (Fun p2 gp2) f)
    (erased (Perm d s si) pm) (erased (Respects p si t) rt) (erased (Respects s t p2) rp2) (erased (Graph d p gp) grp) (erased (MapB s gp gm) mb)
    -> (erased (Spans gm gp2) r))
  (let-match erased f (FunCons _ g1 y z pz f1) ((FunNil _) (SpansNil gm)))
  (let ((erased qm)) (perm-sym d s si pm))
  (let ((erased lt)) (respects-length p si t d rt (perm-length d si s qm)))
  (let ((erased ly)) (nth-lt-length _ p2 y d z pz (respects-length s t p2 d rp2 lt)))
  (let ((erased u) (erased pu) (erased _)) (perm-nth d y si s qm ly))
  (let ((erased v) (erased pv)) (nth-exists _ t d y lt ly))
  (SpansCons gm g1 y z (conn-adj gm y z (adj-map s gp gm u v y z (graph-adj d u v p gp grp (respects-nth p si t y u v rt pu pv)) mb
      (perm-inv d y u si s qm pu) (respects-nth s t p2 y v z rp2 pv pz)))
    (spans-conj-in d s si p t p2 gp gm g1 f1 pm rt rp2 grp mb)))

(def-fns _ $ (erased spans-conj-out : (erased (Nat) d) (erased (List (Nat)) s si p t p2) (erased (List (Bond)) gp g1 gm gp2) (subterm erased (MapB s g1 gm) mb)
    (erased (Fun p g1) f) (erased (Perm d s si) pm) (erased (Respects p si t) rt) (erased (Respects s t p2) rp2) (erased (Graph d p2 gp2) grp2)
    -> (erased (Spans gp2 gm) r))
  (let-match erased mb (MapCons _ g3 gm1 x y x2 y2 px2 py2 mb1) ((MapNil _) (SpansNil gp2)))
  (let-match erased f (FunCons _ _ _ _ pxy f1))
  (let ((erased lt)) (respects-length p si t d rt (perm-length d si s (perm-sym d s si pm))))
  (let ((erased lp2)) (respects-length s t p2 d rp2 lt))
  (let ((erased lx2)) (perm-val d x x2 s si pm px2))
  (let ((erased v) (erased pv)) (nth-exists _ t d x2 lt lx2))
  (let-match erased (nth-fn _ p x y v pxy (respects-nth p si t x2 x v rt (perm-inv d x x2 s si pm px2) pv)) (Refl _ _))
  (let ((erased z) (erased pz)) (nth-exists _ p2 d x2 lp2 lx2))
  (let-match erased (nth-fn _ s y y2 z py2 (respects-nth s t p2 x2 y z rp2 pv pz)) (Refl _ _))
  (SpansCons gp2 gm1 x2 y2 (conn-adj gp2 x2 y2 (graph-adj d x2 y2 p2 gp2 grp2 pz)) (spans-conj-out d s si p t p2 gp g3 gm1 gp2 mb1 f1 pm rt rp2 grp2)))

; A conjugate s . p . si of p has as many orbits as p.
(def-fns _ $ (erased orbits-conj : (erased (Nat) d k) (erased (List (Nat)) s si p t p2) (erased (Perm d s si) pm) (erased (Orbits d p k) ob)
    (erased (Respects p si t) rt) (erased (Respects s t p2) rp2) -> (erased (Orbits d p2 k) r))
  (let-match erased ob (MkOrbits _ _ _ gp grp cs))
  (let ((erased gm) (erased mb)) (map-exists d s si gp (classes-below gp d k cs) pm))
  (let ((erased lt)) (respects-length p si t d rt (perm-length d si s (perm-sym d s si pm))))
  (let ((erased lp2)) (respects-length s t p2 d rp2 lt))
  (let ((erased gp2) (erased grp2)) (graph-exists d p2 lp2))
  (let ((erased fp2)) (graph-fun d p2 gp2 grp2))
  (MkOrbits d k p2 gp2 grp2 (classes-equiv gm gp2 d k (classes-map d k s si gp gm pm mb cs)
    (spans-conj-out d s si p t p2 gp gp gm gp2 mb (graph-fun d p gp grp) pm rt rp2 grp2)
    (spans-conj-in d s si p t p2 gp gm gp2 fp2 pm rt rp2 grp mb)
    (fun-below d p2 gp2 fp2 lp2 (respects-under-out s t p2 d rp2 (perm-under d s si pm))))))

(def-fns _ $ (erased spans-comp : (erased (Nat) d) (erased (List (Nat)) n f c) (erased (List (Bond)) gn gf gc h) (subterm erased (Fun c gc) fc)
    (erased (Respects f n c) rc) (erased (Length (Nat) n d) ln) (erased (Graph d n gn) grn) (erased (Graph d f gf) grf) (erased (Spans h gn) sn)
    (erased (Spans h gf) sf) -> (erased (Spans h gc) r))
  (let-match erased fc (FunCons _ g1 x z pz f1) ((FunNil _) (SpansNil h)))
  (let ((erased y) (erased py)) (nth-exists _ n d x ln (nth-lt-length _ c x d z pz (respects-length f n c d rc ln))))
  (SpansCons h g1 x z (conn-cat h x y z (spans-adj h gn x y (graph-adj d x y n gn grn py) sn)
      (spans-adj h gf y z (graph-adj d y z f gf grf (respects-nth f n c x y z rc py pz)) sf))
    (spans-comp d n f c gn gf g1 h f1 rc ln grn grf sn sf)))

; The mirror: edge f . n, node and face inverted.
(def-fns _ $ (erased hyper-mirror : (erased (Nat) d) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h)
    -> (erased (List (Nat)) fn ni fi) (erased (Hypermap d fn ni fi) h2) (erased (Respects f n fn) rfn) (erased (Perm d n ni) pn) (erased (Perm d f fi) pf))
  (let ((erased ni) (erased pn)) (hyper-perm d n f e (hyper-rot d e n f h)))
  (let ((erased fi) (erased pf)) (hyper-perm d f e n (hyper-rot d n f e (hyper-rot d e n f h))))
  (let-match erased pn (MkPerm _ _ _ ids io ln nin nni))
  (let-match erased pf (MkPerm _ _ _ ids2 io2 lf fif ffi))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased lni)) (respects-length-inv n ni ids d nni li))
  (let ((erased un)) (perm-under d n ni pn))
  (let ((erased fn) (erased rfn)) (respects-exists f n d un lf))
  (let ((erased lfn)) (respects-length f n fn d rfn ln))
  (let ((erased nf2) (erased rnf)) (respects-exists ni fi d (perm-under d fi f (perm-sym d f fi pf)) lni))
  (let ((erased en2)) (respects-assoc ni n f ids fn f d nni (respects-id-right d ids f io lf) rfn lfn ln))
  (values fn ni fi
    (MkHypermap d fn ni fi ids n f nf2 io (respects-assoc-inv n f fi fn ids n rfn (respects-id-left d ids n io un) fif) nin en2 fif rnf
      (respects-assoc-inv fi ni fn nf2 f ids rnf ffi en2))
    rfn pn pf))

; The mirror keeps the genus.
(def-fns _ $ (erased genus-mirror : (erased (Nat) d gen) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    -> (erased (List (Nat)) fn ni fi) (erased (Hypermap d fn ni fi) h2) (erased (Respects f n fn) rfn) (erased (Perm d n ni) pn) (erased (Perm d f fi) pf)
    (erased (Genus d fn ni fi gen) r))
  (let ((erased kc) (erased ke) (erased kn) (erased kf) (erased g) (erased oe) (erased on) (erased of) (erased gl) (erased cc) (erased es))
    (genus-parts d gen e n f p))
  (let ((erased fn) (erased ni) (erased fi) (erased h2) (erased rfn) (erased pn) (erased pf)) (hyper-mirror d e n f h))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke0 cen kn0 cnf kf0))
  (let-match erased pf (MkPerm _ _ _ ids2 io2 lf2 fif ffi))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased lnf)) (respects-length n f nf d cnf lf))
  (let ((erased lfn)) (respects-length f n fn d rfn ln))
  (let ((erased pme)) (MkPerm d e nf ids io le (respects-assoc e f n fe nf ids d cfe ke0 cnf lnf lf) kf0))
  (let ((erased ofn)) (orbits-conj d ke f fi nf n fn pf (orbits-inv d ke e nf pme oe)
    (respects-assoc fi f n ids nf n d ffi (respects-id-right d ids n io ln) cnf lnf lf) rfn))
  (let-match erased gl (MkGlink _ _ _ _ ge gn gf _ _ gre grn grf _ _))
  (let ((erased qn)) (perm-sym d n ni pn))
  (let ((erased qf)) (perm-sym d f fi pf))
  (let ((erased gfn) (erased grfn)) (graph-exists d fn lfn))
  (let ((erased gni) (erased grni)) (perm-graph d ni n qn))
  (let ((erased gfi) (erased grfi)) (perm-graph d fi f qf))
  (let ((erased g2) (erased gl2)) (glink-exists d fn ni fi gfn gni gfi grfn grni grfi))
  (let ((erased se) (erased sn) (erased sf)) (glink-spans d e n f ge gn gf g gl gre grn grf))
  (let ((erased tfn) (erased tni) (erased tfi)) (glink-spans d fn ni fi gfn gni gfi g2 gl2 grfn grni grfi))
  (let ((erased un) (erased uf)) (values (spans-to-inv d ni n g2 gni gn tni qn grni grn) (spans-to-inv d fi f g2 gfi gf tfi qf grfi grf)))
  (let ((erased gnf) (erased cgnf)) (cat-exists gn gf))
  (values fn ni fi h2 rfn pn pf
    (genus-make d gen kc ke kn kf fn ni fi g2 ofn (orbits-inv d kn n ni pn on) (orbits-inv d kf f fi pf of) gl2
      (glink-classes d kc e n f fn ni fi g g2 h2 gl2 cc
        (glink-to d e n f g g2 ge gn gf gl gre grn grf
          (spans-trans g2 gnf ge (spans-edge d e n f nf ge gn gf gnf (graph-fun d e ge gre) pme cnf lf grn grf cgnf) (spans-cat g2 gn gf gnf cgnf un uf))
          un uf)
        (glink-to d fn ni fi g2 g gfn gni gfi gl2 grfn grni grfi (spans-comp d n f fn gn gf gfn g (graph-fun d fn gfn grfn) rfn ln grn grf sn sf)
          (spans-to-inv d n ni g gn gni sn pn grn grni) (spans-to-inv d f fi g gf gfi sf pf grf grfi)))
      es)))

; p2 = s . p . si, through t = p . si.
(def-adts $ (Conj : ((List (Nat)) s si p p2) -> Type)
  enum
  (many MkConj : (erased (List (Nat)) s si p t p2) (erased (Respects p si t) r1) (erased (Respects s t p2) r2) -> (Conj s si p p2)))

(def-fns _ $ (erased conj-exists : (erased (Nat) d) (erased (List (Nat)) s si p) (erased (Perm d s si) pm) (erased (Under p d) up) (erased (Length (Nat) p d) lp)
    -> (erased (List (Nat)) p2) (erased (Conj s si p p2) r))
  (let ((erased t) (erased rt)) (respects-exists p si d (perm-under d si s (perm-sym d s si pm)) lp))
  (let ((erased p2) (erased rp2)) (respects-exists s t d (respects-under-out p si t d rt up) (perm-length d s si pm)))
  (values p2 (MkConj s si p t p2 rt rp2)))

; p2 . s = s . p = v.
(def-fns _ $ (erased conj-v : (erased (Nat) d) (erased (List (Nat)) s si p p2) (erased (Perm d s si) pm) (erased (Conj s si p p2) cj)
    (erased (Under p d) up) (erased (Length (Nat) p d) lp) -> (erased (List (Nat)) v) (erased (Respects p2 s v) r1) (erased (Respects s p v) r2))
  (let-match erased cj (MkConj _ _ _ t _ rt rp2))
  (let-match erased pm (MkPerm _ _ _ ids io ls sis ssi))
  (let ((erased lsi)) (respects-length-inv s si ids d ssi (iota-length d ids io)))
  (let ((erased lt)) (respects-length p si t d rt lsi))
  (let ((erased v) (erased rv)) (respects-exists s p d up ls))
  (values v (respects-assoc s t s p p2 v d (respects-assoc s si p ids t p d sis (respects-id-right d ids p io lp) rt lt lsi) rv rp2
    (respects-length s t p2 d rp2 lt) lt) rv))

; Composing with a permutation s on the right is injective.
(def-fns _ $ (erased respects-cancel : (erased (Nat) d) (erased (List (Nat)) s si a b v) (erased (Perm d s si) pm) (erased (Respects a s v) ra)
    (erased (Respects b s v) rb) (erased (Length (Nat) a d) la) (erased (Length (Nat) b d) lb) -> (erased (Eq (List (Nat)) a b) e))
  (let-match erased pm (MkPerm _ _ _ ids io ls sis ssi))
  (let ((erased u) (erased ru)) (respects-exists v si d (perm-under d si s (perm-sym d s si pm)) (respects-length a s v d ra ls)))
  (let-match erased (respects-fn a ids u a (respects-assoc-inv si s a ids v u ssi ru ra) (respects-id-right d ids a io la)) (Refl _ _))
  (respects-fn b ids u b (respects-assoc-inv si s b ids v u ssi ru rb) (respects-id-right d ids b io lb)))

(def-fns _ $ (erased conj-size : (erased (Nat) d) (erased (List (Nat)) s si p p2) (erased (Perm d s si) pm) (erased (Conj s si p p2) cj)
    -> (erased (Length (Nat) p2 d) l) (erased (Under p2 d) u))
  (let-match erased cj (MkConj _ _ _ t _ rt rp2))
  (values (respects-length s t p2 d rp2 (respects-length p si t d rt (perm-length d si s (perm-sym d s si pm))))
    (respects-under-out s t p2 d rp2 (perm-under d s si pm))))

; Conjugating by s keeps composites.
(def-fns _ $ (erased conj-respects : (erased (Nat) d) (erased (List (Nat)) s si p q r p2 q2 r2) (erased (Perm d s si) pm)
    (erased (Conj s si p p2) cp) (erased (Conj s si q q2) cq) (erased (Conj s si r r2) cr) (erased (Respects p q r) rpq)
    (erased (Under p d) up) (erased (Under q d) uq) (erased (Under r d) ur) (erased (Length (Nat) p d) lp) (erased (Length (Nat) q d) lq)
    (erased (Length (Nat) r d) lr) -> (erased (Respects p2 q2 r2) res))
  (let ((erased ls)) (perm-length d s si pm))
  (let ((erased us)) (perm-under d s si pm))
  (let ((erased vp) (erased rp1) (erased rp2)) (conj-v d s si p p2 pm cp up lp))
  (let ((erased vq) (erased rq1) (erased rq2)) (conj-v d s si q q2 pm cq uq lq))
  (let ((erased vr) (erased rr1) (erased rr2)) (conj-v d s si r r2 pm cr ur lr))
  (let ((erased lvp)) (respects-length s p vp d rp2 lp))
  (let ((erased lp2) (erased _)) (conj-size d s si p p2 pm cp))
  (let ((erased lq2) (erased uq2)) (conj-size d s si q q2 pm cq))
  (let ((erased lr2) (erased _)) (conj-size d s si r r2 pm cr))
  (let ((erased a) (erased ra)) (respects-exists p2 q2 d uq2 lp2))
  (let ((erased z1) (erased rz)) (respects-exists p2 vq d (respects-under-out s q vq d rq2 us) lp2))
  (let ((erased la)) (respects-length p2 q2 a d ra lq2))
  (let-match erased (respects-fn vp q z1 vr (respects-assoc q s p2 vq vp z1 d rq2 rz rp1 lvp ls) (respects-assoc q p s r vp vr d rpq rr2 rp2 lvp lp))
    (Refl _ _))
  (let-match erased (respects-cancel d s si a r2 vr pm (respects-assoc s q2 p2 vq a z1 d rq1 rz ra la lq2) rr1 la lr2) (Refl _ _))
  ra)

; Renaming the darts of a hypermap by s.
(def-fns _ $ (erased hyper-relabel : (erased (Nat) d) (erased (List (Nat)) e n f s si) (erased (Hypermap d e n f) h) (erased (Perm d s si) pm)
    -> (erased (List (Nat)) e2 n2 f2) (erased (Conj s si e e2) ce) (erased (Conj s si n n2) cn) (erased (Conj s si f f2) cf)
    (erased (Hypermap d e2 n2 f2) h2))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let-match erased pm (MkPerm _ _ _ ids2 io2 ls sis ssi))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased nfe) (erased pme)) (hyper-perm d e n f h))
  (let ((erased fn2) (erased pmn)) (hyper-perm d n f e (hyper-rot d e n f h)))
  (let ((erased ef2) (erased pmf)) (hyper-perm d f e n (hyper-rot d n f e (hyper-rot d e n f h))))
  (let ((erased ue)) (perm-under d e nfe pme))
  (let ((erased un)) (perm-under d n fn2 pmn))
  (let ((erased uf)) (perm-under d f ef2 pmf))
  (let ((erased lfe)) (respects-length f e fe d cfe le))
  (let ((erased len)) (respects-length e n en d cen ln))
  (let ((erased lnf)) (respects-length n f nf d cnf lf))
  (let ((erased ufe)) (respects-under-out f e fe d cfe uf))
  (let ((erased uen)) (respects-under-out e n en d cen ue))
  (let ((erased unf)) (respects-under-out n f nf d cnf un))
  (let ((erased uids)) (respects-under-out n fe ids d ke un))
  (let ((erased lids)) (iota-length d ids io))
  (let ((erased e2) (erased ce)) (conj-exists d s si e pm ue le))
  (let ((erased n2) (erased cn)) (conj-exists d s si n pm un ln))
  (let ((erased f2) (erased cf)) (conj-exists d s si f pm uf lf))
  (let ((erased fe2) (erased cfe2)) (conj-exists d s si fe pm ufe lfe))
  (let ((erased en2) (erased cen2)) (conj-exists d s si en pm uen len))
  (let ((erased nf2) (erased cnf2)) (conj-exists d s si nf pm unf lnf))
  (let ((erased cid)) (MkConj s si ids si ids (respects-id-left d ids si io (perm-under d si s (perm-sym d s si pm))) ssi))
  (values e2 n2 f2 ce cn cf (MkHypermap d e2 n2 f2 ids fe2 en2 nf2 io
    (conj-respects d s si f e fe f2 e2 fe2 pm cf ce cfe2 cfe uf ue ufe lf le lfe)
    (conj-respects d s si n fe ids n2 fe2 ids pm cn cfe2 cid ke un ufe uids ln lfe lids)
    (conj-respects d s si e n en e2 n2 en2 pm ce cn cen2 cen ue un uen le ln len)
    (conj-respects d s si f en ids f2 en2 ids pm cf cen2 cid kn uf uen uids lf len lids)
    (conj-respects d s si n f nf n2 f2 nf2 pm cn cf cnf2 cnf un uf unf ln lf lnf)
    (conj-respects d s si e nf ids e2 nf2 ids pm ce cnf2 cid kf ue unf uids le lnf lids))))

(def-fns _ $ (erased map-cat : (erased (List (Nat)) s) (erased (List (Bond)) g h gh x) (subterm erased (Cat g h gh) c) (erased (MapB s gh x) mb)
    -> (erased (List (Bond)) y z) (erased (MapB s g y) my) (erased (MapB s h z) mz) (erased (Cat y z x) cyz))
  (let-match erased c (CatCons g1 _ gh1 b c1) ((CatNil _) (values (Nil _) x (MapNil s) mb (CatNil x))))
  (let-match erased mb (MapCons _ _ x1 u v u2 v2 pu pv mb1))
  (let ((erased y1) (erased z) (erased my1) (erased mz) (erased c2)) (map-cat s g1 h gh1 x1 c1 mb1))
  (values (Cons _ (MkBond u2 v2) y1) z (MapCons s g1 y1 u v u2 v2 pu pv my1) mz (CatCons y1 z x1 (MkBond u2 v2) c2)))

; Renaming the darts keeps the genus.
(def-fns _ $ (erased genus-relabel : (erased (Nat) d gen) (erased (List (Nat)) e n f s si) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Perm d s si) pm)
    -> (erased (List (Nat)) e2 n2 f2) (erased (Conj s si e e2) ce) (erased (Conj s si n n2) cn) (erased (Conj s si f f2) cf)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Genus d e2 n2 f2 gen) r))
  (let ((erased e2) (erased n2) (erased f2) (erased ce) (erased cn) (erased cf) (erased h2)) (hyper-relabel d e n f s si h pm))
  (let ((erased kc) (erased ke) (erased kn) (erased kf) (erased g) (erased oe) (erased on) (erased of) (erased gl) (erased cc) (erased es))
    (genus-parts d gen e n f p))
  (let-match erased ce (MkConj _ _ _ te _ rte re2))
  (let-match erased cn (MkConj _ _ _ tn _ rtn rn2))
  (let-match erased cf (MkConj _ _ _ tf _ rtf rf2))
  (let-match erased gl (MkGlink _ _ _ _ ge gn gf gnf _ gre grn grf c1 c2))
  (let ((erased gm) (erased mb)) (map-exists d s si g (classes-below g d kc cc) pm))
  (let ((erased gem) (erased gnfm) (erased mbe) (erased mbnf) (erased cm2)) (map-cat s ge gnf g gm c2 mb))
  (let ((erased gnm) (erased gfm) (erased mbn) (erased mbf) (erased cm1)) (map-cat s gn gf gnf gnfm c1 mbnf))
  (let ((erased le2) (erased _)) (conj-size d s si e e2 pm ce))
  (let ((erased ge2) (erased gre2)) (graph-exists d e2 le2))
  (let ((erased ln2) (erased _)) (conj-size d s si n n2 pm cn))
  (let ((erased gn2) (erased grn2)) (graph-exists d n2 ln2))
  (let ((erased lf2) (erased _)) (conj-size d s si f f2 pm cf))
  (let ((erased gf2) (erased grf2)) (graph-exists d f2 lf2))
  (let ((erased g2) (erased gl2)) (glink-exists d e2 n2 f2 ge2 gn2 gf2 gre2 grn2 grf2))
  (let ((erased te2) (erased tn2) (erased tf2)) (glink-spans d e2 n2 f2 ge2 gn2 gf2 g2 gl2 gre2 grn2 grf2))
  (values e2 n2 f2 ce cn cf h2
    (genus-make d gen kc ke kn kf e2 n2 f2 g2 (orbits-conj d ke s si e te e2 pm oe rte re2) (orbits-conj d kn s si n tn n2 pm on rtn rn2)
      (orbits-conj d kf s si f tf f2 pm of rtf rf2) gl2
      (glink-classes d kc e n f e2 n2 f2 gm g2 h2 gl2 (classes-map d kc s si g gm pm mb cc)
        (spans-cat g2 gem gnfm gm cm2 (spans-trans g2 ge2 gem (spans-conj-out d s si e te e2 ge ge gem ge2 mbe (graph-fun d e ge gre) pm rte re2 gre2) te2)
          (spans-cat g2 gnm gfm gnfm cm1
            (spans-trans g2 gn2 gnm (spans-conj-out d s si n tn n2 gn gn gnm gn2 mbn (graph-fun d n gn grn) pm rtn rn2 grn2) tn2)
            (spans-trans g2 gf2 gfm (spans-conj-out d s si f tf f2 gf gf gfm gf2 mbf (graph-fun d f gf grf) pm rtf rf2 grf2) tf2)))
        (glink-to d e2 n2 f2 g2 gm ge2 gn2 gf2 gl2 gre2 grn2 grf2
          (spans-trans gm gem ge2 (spans-conj-in d s si e te e2 ge gem ge2 (graph-fun d e2 ge2 gre2) pm rte re2 gre mbe)
            (spans-lift-l gem gnfm gm gem (spans-self gem) cm2))
          (spans-trans gm gnm gn2 (spans-conj-in d s si n tn n2 gn gnm gn2 (graph-fun d n2 gn2 grn2) pm rtn rn2 grn mbn)
            (spans-lift-r gem gnfm gm gnm (spans-lift-l gnm gfm gnfm gnm (spans-self gnm) cm1) cm2))
          (spans-trans gm gfm gf2 (spans-conj-in d s si f tf f2 gf gfm gf2 (graph-fun d f2 gf2 grf2) pm rtf rf2 grf mbf)
            (spans-lift-r gem gnfm gm gfm (spans-lift-r gnm gfm gnfm gfm (spans-self gfm) cm1) cm2))))
      es)))
