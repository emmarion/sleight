; The Euler sum of a node and a face permutation, reached by building the face permutation from the identity one
; transposition at a time, and the uniqueness of the genus.

(def-fns _ $ (erased fixed-sub : (erased (List (Nat)) lab rs ids) (erased (Nat) d) (subterm erased (Respects lab rs rs) fix)
    (erased (Length (Nat) lab d) ll) (erased (Iota d ids) io) -> (erased (Sub rs ids) r))
  (let-match erased fix (RespCons _ rs1 _ j _ p fix1) ((RespNil _) (SubNil ids)))
  (SubCons j rs1 ids (iota-in d j ids io (nth-lt-length _ lab j d j p ll)) (fixed-sub lab rs1 ids d fix1 ll io)))

(def-fns _ $ (erased classes-bound : (erased (List (Bond)) g) (erased (Nat) d k) (erased (Classes g d k) cs) -> (erased (Lt k (Succ d)) r))
  (let-match erased cs (MkClasses _ _ _ ids lab rs io ll lr dr fix _ _))
  (pigeonhole rs ids k d dr (fixed-sub lab rs ids d fix ll io) lr (iota-length d ids io)))

(def-fns _ $ (erased orbits-bound : (erased (Nat) d k) (erased (List (Nat)) p) (erased (Orbits d p k) ob) -> (erased (Lt k (Succ d)) r))
  (let-match erased ob (MkOrbits _ _ _ g _ cs))
  (classes-bound g d k cs))

(def-fns _ $ (erased orbits-unique : (erased (Nat) d k1 k2) (erased (List (Nat)) p) (erased (Orbits d p k1) o1) (erased (Orbits d p k2) o2)
    -> (erased (Eq (Nat) k1 k2) e))
  (let-match erased o1 (MkOrbits _ _ _ g1 gr1 cs1))
  (let-match erased o2 (MkOrbits _ _ _ g2 gr2 cs2))
  (let-match erased (graph-fn d p g1 g2 gr1 gr2) (Refl _ _))
  (classes-unique g1 d k1 k2 cs1 cs2))

(def-fns _ $ (erased perm-id : (erased (Nat) d) (erased (List (Nat)) ids) (erased (Iota d ids) io) -> (erased (Perm d ids ids) r))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased rp)) (respects-id-right d ids ids io li))
  (MkPerm d ids ids ids io li rp rp))

(def-fns _ $ (erased spans-loops : (erased (Nat) d) (erased (List (Nat)) ids) (erased (List (Bond)) g h) (subterm erased (Fun ids g) f)
    (erased (Iota d ids) io) -> (erased (Spans h g) r))
  (let-match erased f (FunCons _ g1 x y px f1) ((FunNil _) (SpansNil h)))
  (let-match erased (iota-at d x y ids io px) (Refl _ _))
  (SpansCons h g1 x x (ConnHere h x) (spans-loops d ids g1 h f1 io)))

(def-fns _ $ (erased orbits-id : (erased (Nat) d) (erased (List (Nat)) ids) (erased (Iota d ids) io) -> (erased (Orbits d ids d) r))
  (let ((erased pm)) (perm-id d ids io))
  (let ((erased g) (erased gr)) (perm-graph d ids ids pm))
  (MkOrbits d d ids g gr (classes-equiv (Nil (Bond)) g d d (classes-nil d) (SpansNil g) (spans-loops d ids g (Nil (Bond)) (graph-fun d ids g gr) io)
    (graph-below d ids ids g (graph-fun d ids g gr) pm))))

(def-fns _ $ (erased respects-fn : (erased (List (Nat)) lab xs l1 l2) (subterm erased (Respects lab xs l1) p) (erased (Respects lab xs l2) q)
    -> (erased (Eq (List (Nat)) l1 l2) e))
  (let-match erased p (RespCons _ xs1 m1 j v pv p1) ((RespNil _) (let-match erased q (RespNil _)) (Refl _ l1)))
  (let-match erased q (RespCons _ _ m2 _ w pw q1))
  (let-match erased (nth-fn _ lab j v w pv pw) (Refl _ _))
  (let-match erased (respects-fn lab xs1 m1 m2 p1 q1) (Refl _ _))
  (Refl _ l1))

; xs and ys differ at some position.
(def-adts $ (NeAt : ((List (Nat)) xs ys) -> Type)
  enum
  (many MkNeAt : (erased (List (Nat)) xs ys) (erased (Nat) j x y) (erased (Nth (Nat) xs j x) px) (erased (Nth (Nat) ys j y) py)
      (erased (Apart (Nat) Lt x y) ne) -> (NeAt xs ys)))

(def-fns _ $ (erased list-dec : (erased (List (Nat)) xs ys) (erased (Nat) k) (subterm erased (Length (Nat) xs k) lx) (erased (Length (Nat) ys k) ly)
    -> (erased (Or (Eq (List (Nat)) xs ys) (NeAt xs ys)) r))
  (let-match erased lx (LengthCons _ x xs1 k1 lx1) ((LengthNil _) (let-match erased ly (LengthNil _)) (OrL _ _ (Refl _ xs))))
  (let-match erased ly (LengthCons _ y ys1 _ ly1))
  (let-match erased (nat-eq x y) (Equal _ _ _)
    ((Unequal _ _ _ _ ne) (OrR _ _ (MkNeAt xs ys (Zero) x y (NthHere _ x xs1) (NthHere _ y ys1) ne))))
  (match erased (list-dec xs1 ys1 k1 lx1 ly1) _
    ((OrL _ _ e) (let-match erased e (Refl _ _)) (OrL _ _ (Refl _ xs)))
    ((OrR _ _ t) (let-match erased t (MkNeAt _ _ j u v pu pv ne))
      (OrR _ _ (MkNeAt xs ys (Succ j) u v (NthThere _ x xs1 j u pu) (NthThere _ x ys1 j v pv) ne)))))

(def-fns _ $ (erased spans-inv : (erased (Nat) d) (erased (List (Nat)) p q) (erased (List (Bond)) gp gq) (subterm erased (Fun q gq) f)
    (erased (Perm d q p) pm) (erased (Graph d p gp) gr) -> (erased (Spans gp gq) r))
  (let-match erased f (FunCons _ g1 x y py f1) ((FunNil _) (SpansNil gp)))
  (SpansCons gp g1 x y (conn-adj gp x y (adj-sym gp y x (graph-adj d y x p gp gr (perm-inv d x y q p pm py)))) (spans-inv d p q gp g1 f1 pm gr)))

; A permutation and its inverse have the same orbits.
(def-fns _ $ (erased orbits-inv : (erased (Nat) d k) (erased (List (Nat)) p q) (erased (Perm d p q) pm) (erased (Orbits d p k) ob) -> (erased (Orbits d q k) r))
  (let-match erased ob (MkOrbits _ _ _ gp grp cs))
  (let ((erased qm)) (perm-sym d p q pm))
  (let ((erased gq) (erased grq)) (perm-graph d q p qm))
  (MkOrbits d k q gq grq (classes-equiv gp gq d k cs (spans-inv d q p gq gp (graph-fun d p gp grp) pm grq) (spans-inv d p q gp gq (graph-fun d q gq grq) qm grp)
    (graph-below d q p gq (graph-fun d q gq grq) qm))))

; n . f is a permutation, with inverse fi . ni.
(def-fns _ $ (erased perm-comp : (erased (Nat) d) (erased (List (Nat)) n ni f fi c) (erased (Perm d n ni) pn) (erased (Perm d f fi) pf)
    (erased (Respects n f c) rc) -> (erased (List (Nat)) ci) (erased (Respects fi ni ci) rci) (erased (Perm d c ci) r))
  (let-match erased pn (MkPerm _ _ _ ids io _ nin nni))
  (let-match erased pf (MkPerm _ _ _ ids2 io2 lf fif ffi))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased lni)) (respects-length-inv n ni ids d nni li))
  (let ((erased uni)) (perm-under d ni n (perm-sym d n ni pn)))
  (let ((erased ci) (erased rci)) (respects-exists fi ni d uni (respects-length-inv f fi ids d ffi li)))
  (let ((erased nic)) (respects-assoc-inv f n ni c ids f rc (respects-id-left d ids f io (perm-under d f fi pf)) nin))
  (let ((erased fci)) (respects-assoc-inv ni fi f ci ids ni rci (respects-id-left d ids ni io uni) ffi))
  (let ((erased lc)) (respects-length n f c d rc lf))
  (values ci rci (MkPerm d c ci ids io lc
    (respects-assoc c ni fi f ci ids d nic fif rci (respects-length fi ni ci d rci lni) lni)
    (respects-assoc ci f n ni c ids d fci nni rc lc lf))))

(def-fns _ $ (erased img-apart : (erased (Nat) d x b y b2) (erased (List (Nat)) p q) (erased (Perm d p q) pm) (erased (Nth (Nat) p x y) px)
    (erased (Nth (Nat) p b b2) pb) (erased (Apart (Nat) Lt x b) ne) -> (erased (Apart (Nat) Lt y b2) r))
  (match erased (nat-eq y b2) _
    (absurd (Equal _ _ _) (let-match erased (perm-inj d x b y p q pm px pb) (Refl _ _)) (apart-irrefl x ne))
    ((Unequal _ _ _ _ r) r)))

(def-fns _ $ (erased inv-swap : (erased (Nat) d a b a2 b2) (erased (List (Nat)) p q p2 q2) (erased (List (Bond)) g2) (subterm erased (Fun p2 g2) f)
    (erased (Perm d p q) pm) (erased (Upd2 p a b2 b a2 p2) up) (erased (Upd2 q b2 a a2 b q2) uq) (erased (Nth (Nat) p a a2) pa)
    (erased (Nth (Nat) p b b2) pb) -> (erased (InvOn q2 g2) r))
  (let-match erased f (FunCons _ g1 x y px f1) ((FunNil _) (InvNil q2)))
  (let ((erased rest)) (inv-swap d a b a2 b2 p q p2 q2 g1 f1 pm up uq pa pb))
  (match erased (upd2-case p p2 a b2 b a2 x y up px) _
    ((UCa _ _ _ _ _) (InvCons q2 g1 a b2 (upd2-a q q2 b2 a a2 b uq) rest))
    ((UCb _ _ _ _ _) (InvCons q2 g1 b a2 (upd2-b q q2 b2 a a2 b uq) rest))
    ((UCo _ _ _ _ _ _ _ na nb q1)
      (InvCons q2 g1 x y (upd2-other q q2 b2 a a2 b y x uq (perm-inv d x y p q pm q1)
        (img-apart d x b y b2 p q pm q1 pb nb) (img-apart d x a y a2 p q pm q1 pa na)) rest))))

; Exchanging the images of two darts keeps a permutation.
(def-fns _ $ (erased perm-swap : (erased (Nat) d a b a2 b2) (erased (List (Nat)) p q p2) (erased (Perm d p q) pm)
    (erased (Nth (Nat) p a a2) pa) (erased (Nth (Nat) p b b2) pb) (erased (Upd2 p a b2 b a2 p2) up)
    -> (erased (List (Nat)) q2) (erased (Upd2 q b2 a a2 b q2) uq) (erased (Perm d p2 q2) r))
  (let-match erased up (MkUpd2 _ _ _ _ _ _ _ ne _ _))
  (let-match erased pm (MkPerm _ _ _ ids io lp _ pq))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased lq)) (respects-length-inv p q ids d pq li))
  (let ((erased q2) (erased uq)) (upd2-exists q b2 a a2 b d lq (perm-val d b b2 p q pm pb) (perm-val d a a2 p q pm pa)
    (apart-sym a2 b2 (img-apart d a b a2 b2 p q pm pa pb ne))))
  (let ((erased lp2)) (upd2-length p p2 a b2 b a2 d up lp))
  (let ((erased lq2)) (upd2-length q q2 b2 a a2 b d uq lq))
  (let ((erased g2) (erased z2)) (zip-exists ids p2 d li lp2))
  (let ((erased h2) (erased w2)) (zip-exists ids q2 d li lq2))
  (values q2 uq (MkPerm d p2 q2 ids io lp2
    (inv-respects ids p2 q2 g2 z2 (inv-swap d a b a2 b2 p q p2 q2 g2 (graph-fun d p2 g2 (MkGraph d p2 ids g2 io lp2 z2)) pm up uq pa pb))
    (inv-respects ids q2 p2 h2 w2 (inv-swap d b2 a2 b a q p q2 p2 h2 (graph-fun d q2 h2 (MkGraph d q2 ids h2 io lq2 w2)) (perm-sym d p q pm) uq up
      (perm-inv d b b2 p q pm pb) (perm-inv d a a2 p q pm pa))))))

; Undoing an update of two entries is an update of the same two entries.
(def-fns _ $ (erased upd2-restore : (erased (List (Nat)) p p2) (erased (Nat) a u b v x y d) (erased (Upd2 p a u b v p2) up)
    (erased (Nth (Nat) p a x) pa) (erased (Nth (Nat) p b y) pb) (erased (Length (Nat) p d) lp) -> (erased (Upd2 p2 a x b y p) r))
  (let-match erased up (MkUpd2 _ p1 _ _ _ _ _ ne s1 s2))
  (let ((erased la)) (nth-lt-length _ p a d x pa lp))
  (let ((erased lb)) (nth-lt-length _ p b d y pb lp))
  (let ((erased ws) (erased sw)) (setnth-exists _ p d b v lp lb))
  (let ((erased t)) (setnth-reorder p p1 p2 ws a b u v s1 s2 sw ne))
  (let ((erased lws)) (setnth-length _ p b d v ws sw lp))
  (let ((erased zs) (erased sz)) (setnth-exists _ p2 d a x (setnth-length _ ws a d u p2 t lws) la))
  (let-match erased (setnth-same _ ws a x zs (setnth-keep p ws b a v x sw pa ne) (setnth-twice _ ws a u x p2 zs t sz)) (Refl _ _))
  (let ((erased vs) (erased sv)) (setnth-exists _ ws d b y lws lb))
  (let-match erased (setnth-same _ p b y vs pb (setnth-twice _ p b v y ws vs sw sv)) (Refl _ _))
  (MkUpd2 p2 ws p a x b y ne sz sv))

(def-fns _ $ (erased respects-upd2 : (erased (List (Nat)) lab f c f2) (erased (Nat) a u b v u2 v2) (erased (Respects lab f c) rp)
    (erased (Upd2 f a u b v f2) up) (erased (Nth (Nat) lab u u2) pu) (erased (Nth (Nat) lab v v2) pv)
    -> (erased (List (Nat)) c2) (erased (Upd2 c a u2 b v2 c2) uc) (erased (Respects lab f2 c2) r))
  (let-match erased up (MkUpd2 _ f1 _ _ _ _ _ ne s1 s2))
  (let ((erased c1) (erased t1) (erased r1)) (respects-setnth2 lab f f1 c a u u2 rp s1 pu))
  (let ((erased c2) (erased t2) (erased r2)) (respects-setnth2 lab f1 f2 c1 b v v2 r1 s2 pv))
  (values c2 (MkUpd2 c c1 c2 a u2 b v2 ne t1 t2) r2))

; h joins the graph of an update of p if it joins the graph of p and the two new links.
(def-fns _ $ (erased spans-upd : (erased (Nat) d a u b v) (erased (List (Nat)) p p2) (erased (List (Bond)) g g2 h) (subterm erased (Fun p2 g2) f)
    (erased (Upd2 p a u b v p2) up) (erased (Graph d p g) gr) (erased (Spans h g) sp) (erased (Conn h a u) ca) (erased (Conn h b v) cb)
    -> (erased (Spans h g2) r))
  (let-match erased f (FunCons _ g1 x y px f1) ((FunNil _) (SpansNil h)))
  (let ((erased rest)) (spans-upd d a u b v p p2 g g1 h f1 up gr sp ca cb))
  (match erased (upd2-case p p2 a u b v x y up px) _
    ((UCa _ _ _ _ _) (SpansCons h g1 a u ca rest))
    ((UCb _ _ _ _ _) (SpansCons h g1 b v cb rest))
    ((UCo _ _ _ _ _ _ _ _ _ q1) (SpansCons h g1 x y (spans-adj h g x y (graph-adj d x y p g gr q1) sp) rest))))

; A walk along n . f that never leaves a or b is joined by n and the update f2 of f at a and b.
(def-fns _ $ (erased path-conn-comp : (erased (Nat) d x y a u b v) (erased (List (Nat)) n f f2 c s xs) (erased (List (Bond)) gn gf2 g)
    (subterm erased (Path c s x y xs) w) (erased (In a s) pa) (erased (In b s) pb) (erased (Respects n f c) rc) (erased (Upd2 f a u b v f2) up)
    (erased (Length (Nat) f d) lf) (erased (Graph d n gn) grn) (erased (Graph d f2 gf2) grf) (erased (Cat gn gf2 g) cg) -> (erased (Conn g x y) r))
  (let-match erased w (PathStep _ _ xs1 _ z _ pz out w1) ((PathHere _ _ _) (ConnHere g x)))
  (let ((erased lx)) (nth-lt-length _ c x d z pz (respects-length n f c d rc lf)))
  (let ((erased t) (erased pt)) (nth-exists _ f d x lf lx))
  (ConnStep g x t y (adj-cat-r gn gf2 g x t (graph-adj d x t f2 gf2 grf (upd2-other f f2 a u b v x t up pt (notin-in x a s out pa) (notin-in x b s out pb))) cg)
    (ConnStep g t z y (adj-cat-l gn gf2 g t z (graph-adj d t z n gn grn (respects-nth n f c x t z rc pt pz)) cg)
      (path-conn-comp d z y a u b v n f f2 c s xs1 gn gf2 g w1 pa pb rc up lf grn grf cg))))

; lab is constant along p.
(def-adts $ (Seps : ((List (Nat)) p) ((Nat) x y) -> Type)
  enum
  (many MkSeps : (erased (List (Nat)) p lab) (erased (Nat) x y) (erased (Separates lab p x y) s) -> (Seps p x y)))

(def-fns _ $ (erased const-respects : (erased (List (Nat)) lab xs ys ls) (erased (List (Bond)) g) (subterm erased (Zip xs ys g) z)
    (erased (Const lab g) cl) (erased (Respects lab xs ls) rp) -> (erased (Respects lab ys ls) r))
  (let-match erased z (ZipCons xs1 ys1 g1 x y z1) ((ZipNil) (let-match erased rp (RespNil _)) (RespNil lab)))
  (let-match erased cl (ConstCons _ _ _ _ l px py cl1))
  (let-match erased rp (RespCons _ _ ls1 _ l0 p0 rp1))
  (let-match erased (nth-fn _ lab x l l0 px p0) (Refl _ _))
  (RespCons lab ys1 ls1 y l py (const-respects lab xs1 ys1 ls1 g1 z1 cl1 rp1)))

; Two darts are on one orbit or told apart by a labelling constant along p.
(def-fns _ $ (erased orbits-dec : (erased (Nat) d k x y) (erased (List (Nat)) p q) (erased (Perm d p q) pm) (erased (Orbits d p k) ob)
    (erased (Lt x d) lx) (erased (Lt y d) ly) -> (erased (Or (SomePath p (Nil (Nat)) x y) (Seps p x y)) r))
  (let-match erased ob (MkOrbits _ _ _ g gr cs))
  (let-match erased cs (MkClasses _ _ _ ids lab rs io ll _ _ _ cl ro))
  (let-match erased gr (MkGraph _ _ ids2 _ io2 _ z))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased rx) (erased qx)) (nth-exists _ lab d x ll lx))
  (let ((erased ry) (erased qy)) (nth-exists _ lab d y ll ly))
  (let ((erased _) (erased cx)) (classes-root g d ids lab rs x rx io ro qx lx))
  (let ((erased _) (erased cy)) (classes-root g d ids lab rs y ry io ro qy ly))
  (let ((erased rl)) (const-respects lab ids p lab g z cl (respects-id-right d ids lab io ll)))
  (let-match erased (nat-cmp rx ry) (CEq _ _ _)
    ((CLt _ _ _ _ l) (OrR _ _ (MkSeps p lab x y (MkSeparates lab p x y rx ry rl qx qy (ApLt _ _ rx ry l)))))
    ((CGt _ _ _ _ l) (OrR _ _ (MkSeps p lab x y (MkSeparates lab p x y rx ry rl qx qy (ApGt _ _ rx ry l))))))
  (let ((erased xs) (erased w)) (conn-path d x y p q g pm gr (conn-cat g x rx y (conn-sym g rx x cx) cy)))
  (OrL _ _ (MkSomePath p _ xs x y w)))

; Splitting a off its orbit: f2 is f with a sent to f (f a) and f a fixed.
(def-fns _ $ (erased split-fixed : (erased (Nat) d k a a2) (erased (List (Nat)) f fi) (erased (Perm d f fi) pf) (erased (Orbits d f k) of)
    (erased (Nth (Nat) f a a2) pa) (erased (Apart (Nat) Lt a a2) ne) (erased (Lt a d) la)
    -> (erased (Nat) b2) (erased (List (Nat)) f2 fi2) (erased (Nth (Nat) f a2 b2) pb) (erased (Upd2 f a b2 a2 a2 f2) up)
    (erased (Perm d f2 fi2) pf2) (erased (Orbits d f2 (Succ k)) of2))
  (let ((erased la2)) (perm-val d a a2 f fi pf pa))
  (let ((erased b2) (erased pb) (erased _)) (perm-nth d a2 f fi pf la2))
  (let ((erased f2) (erased up)) (upd2-exists f a b2 a2 a2 d (perm-length d f fi pf) la la2 ne))
  (let ((erased xs) (erased w)) (cycle d a a2 f fi pf pa la))
  (let ((erased fi2) (erased _) (erased pf2)) (perm-swap d a a2 a2 b2 f fi f2 pf pa pb up))
  (values b2 f2 fi2 pb up pf2 (orbits-split d k a a2 a2 b2 f fi f2 xs pf of pa pb up la la2 w)))

; 2 kc + d = k1 + k2 + k3 + 2 gen, in the shape of Genus.
(def-adts $ (EulerSum : ((Nat) kc d k1 k2 k3 gen) -> Type)
  enum
  (many MkEulerSum : (erased (Nat) kc d k1 k2 k3 gen c2 lhs s1 rhs g2) (erased (Double kc c2) dc) (erased (Add c2 d lhs) al)
      (erased (Add k1 k2 s1) a1) (erased (Add s1 k3 rhs) ar) (erased (Double gen g2) dg) (erased (Add g2 rhs lhs) ag)
      -> (EulerSum kc d k1 k2 k3 gen)))

(def-fns _ $ (erased es-base : (erased (Nat) k d) -> (erased (EulerSum k d k k d (Zero)) r))
  (let ((erased s1) (erased a1)) (add k k))
  (let ((erased lhs) (erased al)) (add s1 d))
  (MkEulerSum k d k k d (Zero) s1 lhs s1 lhs (Zero) (add-diag-double k s1 a1) al a1 al (D0) (AddZero lhs)))

(def-fns _ $ (erased es-join : (erased (Nat) kc d k1 k2 k3 g) (erased (EulerSum kc d k1 k2 (Succ k3) g) es) -> (erased (EulerSum kc d (Succ k1) k2 k3 g) r))
  (let-match erased es (MkEulerSum _ _ _ _ _ _ c2 lhs s1 rhs g2 dc al a1 ar dg ag))
  (MkEulerSum kc d (Succ k1) k2 k3 g c2 lhs (Succ s1) rhs g2 dc al (AddSucc k1 k2 s1 a1) (add-succ-left s1 k3 rhs ar) dg ag))

(def-fns _ $ (erased es-split : (erased (Nat) kc d k1 k2 k3 g) (erased (EulerSum kc d (Succ k1) k2 (Succ k3) g) es)
    -> (erased (Nat) r0 lhs) (erased (Add k1 k2 r0) a0) (erased (Nat) r1) (erased (Add r0 k3 r1) a1) (erased (Nat) c2 g2)
    (erased (Double kc c2) dc) (erased (Add c2 d lhs) al) (erased (Double g g2) dg) (erased (Add g2 (Succ (Succ r1)) lhs) ag))
  (let-match erased es (MkEulerSum _ _ _ _ _ _ c2 lhs _ _ g2 dc al a1 ar dg ag))
  (let-match erased a1 (AddSucc _ _ s0 a0))
  (let-match erased ar (AddSucc _ _ q1 ar1))
  (let ((erased r1) (erased e) (erased ar0)) (add-succ-right-inv s0 k3 q1 ar1))
  (let-match erased e (Refl _ _))
  (values s0 lhs a0 r1 ar0 c2 g2 dc al dg ag))

(def-fns _ $ (erased es-conn : (erased (Nat) kc d k1 k2 k3 g) (erased (EulerSum kc d (Succ k1) k2 (Succ k3) g) es) -> (erased (EulerSum kc d k1 k2 k3 (Succ g)) r))
  (let ((erased s0) (erased lhs) (erased a0) (erased r1) (erased ar0) (erased c2) (erased g2) (erased dc) (erased al) (erased dg) (erased ag))
    (es-split kc d k1 k2 k3 g es))
  (MkEulerSum kc d k1 k2 k3 (Succ g) c2 lhs s0 r1 (Succ (Succ g2)) dc al a0 ar0 (DS g g2 dg)
    (add-succ-left (Succ g2) r1 lhs (add-succ-left g2 (Succ r1) lhs ag))))

(def-fns _ $ (erased es-sep : (erased (Nat) kc d k1 k2 k3 g) (erased (EulerSum (Succ kc) d (Succ k1) k2 (Succ k3) g) es) -> (erased (EulerSum kc d k1 k2 k3 g) r))
  (let ((erased s0) (erased _) (erased a0) (erased r1) (erased ar0) (erased _) (erased g2) (erased dc) (erased al) (erased dg) (erased ag))
    (es-split (Succ kc) d k1 k2 k3 g es))
  (let-match erased dc (DS _ c0 dc0))
  (let-match erased al (AddSucc _ _ _ al1))
  (let-match erased al1 (AddSucc _ _ l0 al0))
  (let ((erased _) (erased e1) (erased ag1)) (add-succ-right-inv g2 (Succ r1) (Succ (Succ l0)) ag))
  (let-match erased e1 (Refl _ _))
  (let ((erased _) (erased e0) (erased ag0)) (add-succ-right-inv g2 r1 (Succ l0) ag1))
  (let-match erased e0 (Refl _ _))
  (MkEulerSum kc d k1 k2 k3 g c0 l0 s0 r1 g2 dc0 al0 a0 ar0 dg ag0))

; The links of n and f join what the links of n, of f2 (f with f a fixed) and a-(f a) join.
(def-fns _ $ (erased classes-unswap : (erased (Nat) d k a a2 b2) (erased (List (Nat)) n ni f fi f2 fi2) (erased (List (Bond)) gn gf gf2 g g2)
    (erased (Perm d n ni) pn) (erased (Perm d f fi) pf) (erased (Perm d f2 fi2) _pf2) (erased (Graph d n gn) grn) (erased (Graph d f gf) grf)
    (erased (Graph d f2 gf2) grf2) (erased (Cat gn gf g) cg) (erased (Cat gn gf2 g2) cg2) (erased (Nth (Nat) f a a2) pa) (erased (Nth (Nat) f a2 b2) pb)
    (erased (Upd2 f a b2 a2 a2 f2) up) (erased (Classes (Cons (Bond) (MkBond a a2) g2) d k) cs) -> (erased (Classes g d k) r))
  (let ((erased x)) (Cons (Bond) (MkBond a a2) g2))
  (let ((erased lf)) (perm-length d f fi pf))
  (let ((erased cfa)) (conn-adj g a a2 (adj-cat-r gn gf g a a2 (graph-adj d a a2 f gf grf pa) cg)))
  (let ((erased cfb)) (conn-adj g a2 b2 (adj-cat-r gn gf g a2 b2 (graph-adj d a2 b2 f gf grf pb) cg)))
  (let ((erased cxa)) (conn-adj x a a2 (AdjFwd g2 a a2)))
  (let ((erased cxb)) (conn-cat x a2 a b2 (conn-sym x a a2 cxa)
    (conn-cons g2 (MkBond a a2) a b2 (conn-adj g2 a b2 (adj-cat-r gn gf2 g2 a b2 (graph-adj d a b2 f2 gf2 grf2 (upd2-a f f2 a b2 a2 a2 up)) cg2)))))
  (let ((erased bn)) (graph-below d n ni gn (graph-fun d n gn grn) pn))
  (classes-equiv x g d k cs
    (SpansCons g g2 a a2 cfa (spans-cat g gn gf2 g2 cg2 (spans-lift-l gn gf g gn (spans-self gn) cg)
      (spans-upd d a b2 a2 a2 f f2 gf gf2 g (graph-fun d f2 gf2 grf2) up grf (spans-lift-r gn gf g gf (spans-self gf) cg) (conn-cat g a a2 b2 cfa cfb)
        (ConnHere g a2))))
    (spans-cat x gn gf g cg (spans-cons g2 gn (MkBond a a2) (spans-lift-l gn gf2 g2 gn (spans-self gn) cg2))
      (spans-upd d a a2 a2 b2 f2 f gf2 gf x (graph-fun d f gf grf) (upd2-restore f f2 a b2 a2 a2 a2 b2 d up pa pb lf) grf2
        (spans-cons g2 gf2 (MkBond a a2) (spans-lift-r gn gf2 g2 gf2 (spans-self gf2) cg2)) cxa cxb))
    (below-cat gn gf g d cg bn (graph-below d f fi gf (graph-fun d f gf grf) pf))))

(def-fns _ $ (erased orbits-exists : (erased (Nat) d) (erased (List (Nat)) p q) (erased (Perm d p q) pm)
    -> (erased (Nat) k) (erased (Orbits d p k) r))
  (let ((erased g) (erased gr)) (perm-graph d p q pm))
  (let ((erased k) (erased cs)) (classes-exists g d (graph-below d p q g (graph-fun d p g gr) pm)))
  (values k (MkOrbits d k p g gr cs)))

; One transposition: from the Euler sum of n and f2, which is f with a2 = f a fixed, that of n and f, of the same genus or
; one more.
(def-fns _ $ (erased euler-step : (erased (Nat) d kn kf kx kx2 kc2 gen2 a a2 b2) (erased (List (Nat)) n ni f fi c f2 fi2 c2)
    (erased (List (Bond)) gn gf g gf2 g2) (erased (Perm d n ni) pn) (erased (Perm d f fi) pf) (erased (Perm d f2 fi2) pf2)
    (erased (Respects n f c) rc) (erased (Respects n f2 c2) rc2) (erased (Orbits d c kx) oc) (erased (Orbits d c2 kx2) oc2)
    (erased (Graph d n gn) grn) (erased (Graph d f gf) grf) (erased (Graph d f2 gf2) grf2) (erased (Cat gn gf g) cg) (erased (Cat gn gf2 g2) cg2)
    (erased (Nth (Nat) f a a2) pa) (erased (Nth (Nat) f a2 b2) pb) (erased (Upd2 f a b2 a2 a2 f2) up)
    (erased (Classes g2 d kc2) cs2) (erased (EulerSum kc2 d kx2 kn (Succ kf) gen2) es2)
    -> (erased (Nat) kc gen) (erased (Classes g d kc) cs) (erased (EulerSum kc d kx kn kf gen) es)
    (erased (Or (Eq (Nat) gen gen2) (Eq (Nat) gen (Succ gen2))) st))
  (let ((erased lf)) (perm-length d f fi pf))
  (let ((erased la)) (nth-lt-length _ f a d a2 pa lf))
  (let ((erased la2)) (perm-val d a a2 f fi pf pa))
  (let ((erased lc)) (respects-length n f c d rc lf))
  (let ((erased ca) (erased pca)) (nth-exists _ c d a lc la))
  (let ((erased ca2) (erased pca2)) (nth-exists _ c d a2 lc la2))
  (let ((erased pna2)) (respects-nth n f c a a2 ca rc pa pca))
  (let ((erased c3) (erased uc) (erased rc3)) (respects-upd2 n f c f2 a b2 a2 a2 ca2 ca rc up (respects-nth n f c a2 b2 ca2 rc pb pca2) pna2))
  (let-match erased (respects-fn n f2 c2 c3 rc2 rc3) (Refl _ _))
  (let ((erased ci) (erased _) (erased pc)) (perm-comp d n ni f fi c pn pf rc))
  (let ((erased gc) (erased grc)) (perm-graph d c ci pc))
  (let-match erased (orbits-dec d kx a2 a c ci pc oc la2 la) (OrR _ _ ss)
    ((OrL _ _ sp)
      (let-match erased sp (MkSomePath _ _ xs _ _ w))
      (let-match erased (orbits-unique d kx2 (Succ kx) c2 oc2 (orbits-split d kx a a2 ca ca2 c ci c2 xs pc oc pca pca2 uc la la2 w)) (Refl _ _))
      (let-match erased (classes-dec g2 d kc2 a a2 cs2 la la2) (OrR _ _ sep)
        ((OrL _ _ cn)
          (values kc2 (Succ gen2)
            (classes-unswap d kc2 a a2 b2 n ni f fi f2 fi2 gn gf gf2 g g2 pn pf pf2 grn grf grf2 cg cg2 pa pb up
              (classes-link-same g2 d kc2 a a2 cs2 cn la la2))
            (es-conn kc2 d kx kn kf gen2 es2) (OrR _ _ (Refl _ (Succ gen2))))))
      (let ((erased k1) (erased e) (erased cs3)) (classes-link-merge g2 d kc2 a a2 cs2 sep la la2))
      (let-match erased e (Refl _ _))
      (values k1 gen2 (classes-unswap d k1 a a2 b2 n ni f fi f2 fi2 gn gf gf2 g g2 pn pf pf2 grn grf grf2 cg cg2 pa pb up cs3)
        (es-sep k1 d kx kn kf gen2 es2) (OrL _ _ (Refl _ gen2)))))
  (let-match erased ss (MkSeps _ lab _ _ se))
  (let ((erased k1) (erased e) (erased oc3))
    (orbits-join d kx a a2 ca ca2 c ci c2 lab pc oc pca pca2 uc la la2 (separates-sym lab c a2 a se)))
  (let-match erased e (Refl _ _))
  (let-match erased (orbits-unique d kx2 k1 c2 oc2 oc3) (Refl _ _))
  (let ((erased ys) (erased wy)) (cycle d a ca c ci pc pca la))
  (let-match erased (cut-both c ys ca a a2 ca2 wy pca2) (OrL _ _ sy)
    (absurd (OrR _ _ sz)
      (let-match erased sz (MkSomePath _ _ zs _ _ wz))
      (sep-conn gc a2 a (sep-of-separates d a2 a lab c gc grc se)
        (ConnStep gc a2 ca2 a (graph-adj d a2 ca2 c gc grc pca2) (path-graph-conn d ca2 a c _ zs gc wz grc)))))
  (let-match erased sy (MkSomePath _ _ zs _ _ wz))
  (let ((erased cn)) (ConnStep g2 a2 ca a (adj-cat-l gn gf2 g2 a2 ca (graph-adj d a2 ca n gn grn pna2) cg2)
    (path-conn-comp d ca a a b2 a2 a2 n f f2 c _ zs gn gf2 g2 wz (InThere a a2 _ (InHere a _)) (InHere a2 _) rc up lf grn grf2 cg2)))
  (values kc2 gen2
    (classes-unswap d kc2 a a2 b2 n ni f fi f2 fi2 gn gf gf2 g g2 pn pf pf2 grn grf grf2 cg cg2 pa pb up
      (classes-link-same g2 d kc2 a a2 cs2 (conn-sym g2 a2 a cn) la la2))
    (es-join kc2 d k1 kn kf gen2 es2) (OrL _ _ (Refl _ gen2))))

; With c = n . f: 2 kc + d = kx + kn + kf + 2 gen, kc the classes of the links of n and f and kx the orbits of c.
(def-fns _ $ (erased euler-core : (erased (Nat) d kn kf kx) (erased (List (Nat)) n ni f fi c) (erased (List (Bond)) gn gf g)
    (erased (Perm d n ni) pn) (erased (Perm d f fi) pf) (erased (Respects n f c) rc)
    (erased (Orbits d n kn) on) (erased (Orbits d f kf) of) (erased (Orbits d c kx) oc)
    (erased (Graph d n gn) grn) (erased (Graph d f gf) grf) (erased (Cat gn gf g) cg)
    (subterm erased (Nat) m) (erased (Add kf m d) am)
    -> (erased (Nat) kc gen) (erased (Classes g d kc) cs) (erased (EulerSum kc d kx kn kf gen) es))
  (let ((erased ids) (erased io)) (iota-exists d))
  (let ((erased lf)) (perm-length d f fi pf))
  (let ((erased ln)) (perm-length d n ni pn))
  (let-match erased (list-dec ids f d (iota-length d ids io) lf) (OrR _ _ ne)
    ((OrL _ _ e)
      (let-match erased e (Refl _ _))
      (let-match erased (respects-fn n ids c n rc (respects-id-right d ids n io ln)) (Refl _ _))
      (let-match erased (orbits-unique d kx kn n oc on) (Refl _ _))
      (let-match erased (orbits-unique d kf d ids of (orbits-id d ids io)) (Refl _ _))
      (let-match erased on (MkOrbits _ _ _ gn2 grn2 csn))
      (let-match erased (graph-fn d n gn gn2 grn grn2) (Refl _ _))
      (values kn (Zero)
        (classes-equiv gn g d kn csn (spans-lift-l gn gf g gn (spans-self gn) cg)
          (spans-cat gn gn gf g cg (spans-self gn) (spans-loops d ids gf gn (graph-fun d ids gf grf) io))
          (below-cat gn gf g d cg (graph-below d n ni gn (graph-fun d n gn grn) pn) (graph-below d ids fi gf (graph-fun d ids gf grf) pf)))
        (es-base kn d))))
  (let-match erased ne (MkNeAt _ _ j a a2 pj pa nea))
  (let-match erased (iota-at d j a ids io pj) (Refl _ _))
  (let ((erased b2) (erased f2) (erased fi2) (erased pb) (erased up) (erased pf2) (erased of2))
    (split-fixed d kf a a2 f fi pf of pa nea (nth-lt-length _ f a d a2 pa lf)))
  (let-match erased m (Succ m1)
    (absurd (Zero)
      (let-match erased (add-fn kf (Zero) kf d (add-zero-right kf) am) (Refl _ _))
      (lt-irrefl (Succ kf) (orbits-bound kf (Succ kf) f2 of2))))
  (let ((erased c2) (erased rc2)) (respects-exists n f2 d (perm-under d f2 fi2 pf2) ln))
  (let ((erased ci2) (erased _) (erased pc2)) (perm-comp d n ni f2 fi2 c2 pn pf2 rc2))
  (let ((erased kx2) (erased oc2)) (orbits-exists d c2 ci2 pc2))
  (let ((erased gf2) (erased grf2)) (graph-exists d f2 (perm-length d f2 fi2 pf2)))
  (let ((erased g2) (erased cg2)) (cat-exists gn gf2))
  (let ((erased kc2) (erased gen2) (erased cs2) (erased es2))
    (euler-core d kn (Succ kf) kx2 n ni f2 fi2 c2 gn gf2 g2 pn pf2 rc2 on of2 oc2 grn grf2 cg2 m1 (add-succ-left kf m1 d am)))
  (let ((erased kc) (erased gen) (erased cs) (erased es) (erased _))
    (euler-step d kn kf kx kx2 kc2 gen2 a a2 b2 n ni f fi c f2 fi2 c2 gn gf g gf2 g2 pn pf pf2 rc rc2 oc oc2 grn grf grf2 cg cg2 pa pb up cs2 es2))
  (values kc gen cs es))

; The edge links are joined by the node and face links.
(def-fns _ $ (erased spans-edge : (erased (Nat) d) (erased (List (Nat)) e n f nf) (erased (List (Bond)) ge gn gf g) (subterm erased (Fun e ge) fe)
    (erased (Perm d e nf) pm) (erased (Respects n f nf) rc) (erased (Length (Nat) f d) lf) (erased (Graph d n gn) grn) (erased (Graph d f gf) grf)
    (erased (Cat gn gf g) cg) -> (erased (Spans g ge) r))
  (let-match erased fe (FunCons _ g1 x y px f1) ((FunNil _) (SpansNil g)))
  (let ((erased w) (erased pw)) (nth-exists _ f d y lf (perm-val d x y e nf pm px)))
  (SpansCons g g1 x y
    (conn-sym g y x (ConnStep g y w x (adj-cat-r gn gf g y w (graph-adj d y w f gf grf pw) cg)
      (conn-adj g w x (adj-cat-l gn gf g w x (graph-adj d w x n gn grn (respects-nth n f nf y w x rc pw (perm-inv d x y e nf pm px))) cg))))
    (spans-edge d e n f nf g1 gn gf g f1 pm rc lf grn grf cg)))

(def-fns _ $ (erased add-cancel : (erased (Nat) b a a2 c) (subterm erased (Add b a c) p) (erased (Add b a2 c) q) -> (erased (Eq (Nat) a a2) e))
  (let-match erased p (AddSucc b1 _ c1 p1) ((AddZero _) (let-match erased q (AddZero _)) (Refl _ a)))
  (let-match erased q (AddSucc _ _ _ q1))
  (add-cancel b1 a a2 c1 p1 q1))

(def-fns _ $ (erased cat-fn : (erased (List (Bond)) g h x y) (subterm erased (Cat g h x) p) (erased (Cat g h y) q) -> (erased (Eq (List (Bond)) x y) e))
  (let-match erased p (CatCons g1 _ x1 _ p1) ((CatNil _) (let-match erased q (CatNil _)) (Refl _ x)))
  (let-match erased q (CatCons _ _ y1 _ q1))
  (let-match erased (cat-fn g1 h x1 y1 p1 q1) (Refl _ _))
  (Refl _ x))

(def-fns _ $ (erased glink-fn : (erased (Nat) d) (erased (List (Nat)) e n f) (erased (List (Bond)) g h) (erased (Glink d e n f g) p)
    (erased (Glink d e n f h) q) -> (erased (Eq (List (Bond)) g h) r))
  (let-match erased p (MkGlink _ _ _ _ ge gn gf gnf _ pe pn pf c1 c2))
  (let-match erased q (MkGlink _ _ _ _ he hn hf hnf _ qe qn qf d1 d2))
  (let-match erased (graph-fn d e ge he pe qe) (Refl _ _))
  (let-match erased (graph-fn d n gn hn pn qn) (Refl _ _))
  (let-match erased (graph-fn d f gf hf pf qf) (Refl _ _))
  (let-match erased (cat-fn gn gf gnf hnf c1 d1) (Refl _ _))
  (cat-fn ge gnf g h c2 d2))

; The genus is determined by the hypermap.
(def-fns _ $ (erased genus-unique : (erased (Nat) d g1 g2) (erased (List (Nat)) e n f) (erased (Genus d e n f g1) p) (erased (Genus d e n f g2) q)
    -> (erased (Eq (Nat) g1 g2) r))
  (let-match erased p (MkGenus _ _ ke kn kf kc c2 lhs s1 rhs h2 _ _ _ g oe on of gl cc dc al a1 ar dg ag))
  (let-match erased q (MkGenus _ _ ke2 kn2 kf2 kc2 c22 lhs2 s12 rhs2 h22 _ _ _ g3 oe2 on2 of2 gl2 cc2 dc2 al2 a12 ar2 dg2 ag2))
  (let-match erased (orbits-unique d ke ke2 e oe oe2) (Refl _ _))
  (let-match erased (orbits-unique d kn kn2 n on on2) (Refl _ _))
  (let-match erased (orbits-unique d kf kf2 f of of2) (Refl _ _))
  (let-match erased (glink-fn d e n f g g3 gl gl2) (Refl _ _))
  (let-match erased (classes-unique g d kc kc2 cc cc2) (Refl _ _))
  (let-match erased (double-fn kc c2 c22 dc dc2) (Refl _ _))
  (let-match erased (add-fn c2 d lhs lhs2 al al2) (Refl _ _))
  (let-match erased (add-fn ke kn s1 s12 a1 a12) (Refl _ _))
  (let-match erased (add-fn s1 kf rhs rhs2 ar ar2) (Refl _ _))
  (let-match erased (add-cancel rhs h2 h22 lhs (add-comm h2 rhs lhs ag) (add-comm h22 rhs lhs ag2)) (Refl _ _))
  (double-inj g1 g2 h2 dg dg2))
