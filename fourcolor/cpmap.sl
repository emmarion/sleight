; The maps of the construction programs of red.sl (Gonthier's cpmap), on the pointed maps of cfmap.sl. Load after
; cfmap.sl and red/red.sl.

; cp has no A step (the steps cpmap builds here).
(def-adts $ (NoA : ((List (Step)) cp) -> Type)
  enum
  (many NoANil : -> (NoA (Nil (Step))))
  (many NoAR : (erased (Nat) k) (erased (List (Step)) cp) (erased (NoA cp) p) -> (NoA (Cons (Step) (SR k) cp)))
  (many NoARr : (erased (List (Step)) cp) (erased (NoA cp) p) -> (NoA (Cons (Step) (SRr) cp)))
  (many NoAY : (erased (List (Step)) cp) (erased (NoA cp) p) -> (NoA (Cons (Step) (SY) cp)))
  (many NoAH : (erased (List (Step)) cp) (erased (NoA cp) p) -> (NoA (Cons (Step) (SH) cp)))
  (many NoAU : (erased (List (Step)) cp) (erased (NoA cp) p) -> (NoA (Cons (Step) (SU) cp)))
  (many NoAK : (erased (List (Step)) cp) (erased (NoA cp) p) -> (NoA (Cons (Step) (SK) cp))))

; Gonthier's cubic_prog: only R, U, Y and H steps.
(def-adts $ (CubicProg : ((List (Step)) cp) -> Type)
  enum
  (many CubNil : -> (CubicProg (Nil (Step))))
  (many CubR : (erased (Nat) k) (erased (List (Step)) cp) (erased (CubicProg cp) p) -> (CubicProg (Cons (Step) (SR k) cp)))
  (many CubY : (erased (List (Step)) cp) (erased (CubicProg cp) p) -> (CubicProg (Cons (Step) (SY) cp)))
  (many CubH : (erased (List (Step)) cp) (erased (CubicProg cp) p) -> (CubicProg (Cons (Step) (SH) cp)))
  (many CubU : (erased (List (Step)) cp) (erased (CubicProg cp) p) -> (CubicProg (Cons (Step) (SU) cp))))

; Gonthier's config_prog: only R, Y and H steps, ending with a Y step.
(def-adts $ (ConfigProg : ((List (Step)) cp) -> Type)
  enum
  (many CfgR : (erased (Nat) k) (erased (List (Step)) cp) (erased (ConfigProg cp) p) -> (ConfigProg (Cons (Step) (SR k) cp)))
  (many CfgY1 : -> (ConfigProg (Cons (Step) (SY) (Nil (Step)))))
  (many CfgY : (erased (List (Step)) cp) (erased (ConfigProg cp) p) -> (ConfigProg (Cons (Step) (SY) cp)))
  (many CfgH : (erased (List (Step)) cp) (erased (ConfigProg cp) p) -> (ConfigProg (Cons (Step) (SH) cp))))

; The map (d, e, f) and ring r that cp builds, its steps applied from the end of cp (Gonthier's cpmap): K is R' then N then
; R 1, Y is U then N, and H is U then N twice.
(def-adts $ (Cpmap : ((List (Step)) cp) ((Nat) d) ((List (Nat)) e f r) -> Type)
  enum
  (many CmNil : -> (Cpmap (Nil (Step)) (Succ (Succ (Zero))) (Cons (Nat) (Succ (Zero)) (Cons (Nat) (Zero) (Nil (Nat))))
      (Cons (Nat) (Zero) (Cons (Nat) (Succ (Zero)) (Nil (Nat)))) (Cons (Nat) (Succ (Zero)) (Cons (Nat) (Zero) (Nil (Nat))))))
  (many CmR : (erased (Nat) k d) (erased (List (Step)) cp) (erased (List (Nat)) e f r r2) (erased (Cpmap cp d e f r) c) (erased (Rot k r r2) rt)
      -> (Cpmap (Cons (Step) (SR k) cp) d e f r2))
  (many CmRr : (erased (Nat) m d) (erased (List (Step)) cp) (erased (List (Nat)) e f r r2) (erased (Cpmap cp d e f r) c)
      (erased (Length (Nat) r (Succ m)) l) (erased (Rot m r r2) rt) -> (Cpmap (Cons (Step) (SRr) cp) d e f r2))
  (many CmU : (erased (Nat) d) (erased (List (Step)) cp) (erased (List (Nat)) e f r e2 f2 r2) (erased (Cpmap cp d e f r) c)
      (erased (EcpU d e f r e2 f2 r2) u) -> (Cpmap (Cons (Step) (SU) cp) (Succ (Succ d)) e2 f2 r2))
  (many CmY : (erased (Nat) d) (erased (List (Step)) cp) (erased (List (Nat)) e f r e1 f1 r1 e2 f2 r2) (erased (Cpmap cp d e f r) c)
      (erased (EcpU d e f r e1 f1 r1) u) (erased (EcpN (Succ (Succ d)) e1 f1 r1 e2 f2 r2) nn)
      -> (Cpmap (Cons (Step) (SY) cp) (Succ (Succ (Succ (Succ d)))) e2 f2 r2))
  (many CmH : (erased (Nat) d) (erased (List (Step)) cp) (erased (List (Nat)) e f r e1 f1 r1 e2 f2 r2 e3 f3 r3) (erased (Cpmap cp d e f r) c)
      (erased (EcpU d e f r e1 f1 r1) u) (erased (EcpN (Succ (Succ d)) e1 f1 r1 e2 f2 r2) nn)
      (erased (EcpN (Succ (Succ (Succ (Succ d)))) e2 f2 r2 e3 f3 r3) nn2)
      -> (Cpmap (Cons (Step) (SH) cp) (Succ (Succ (Succ (Succ (Succ (Succ d)))))) e3 f3 r3))
  (many CmK : (erased (Nat) m d) (erased (List (Step)) cp) (erased (List (Nat)) e f r r1 e2 f2 r2 r3) (erased (Cpmap cp d e f r) c)
      (erased (Length (Nat) r (Succ m)) l) (erased (Rot m r r1) rt) (erased (EcpN d e f r1 e2 f2 r2) nn) (erased (Rot (Succ (Zero)) r2 r3) rt2)
      -> (Cpmap (Cons (Step) (SK) cp) (Succ (Succ d)) e2 f2 r3)))

(def-fns _ $ (erased cpmap-map : (erased (List (Step)) cp) (erased (Nat) d) (erased (List (Nat)) e f r) (subterm erased (Cpmap cp d e f r) c)
    -> (erased (List (Nat)) n) (erased (PointedMap d e n f r) pm))
  (match erased c _
    ((CmNil) (values (Cons (Nat) (Succ (Zero)) (Cons (Nat) (Zero) (Nil (Nat)))) (cpmap0)))
    ((CmR k _ cp1 _ _ r1 _ c1 rt)
      (let ((erased n) (erased pm)) (cpmap-map cp1 d e f r1 c1))
      (values n (pointed-rot d k e n f r1 r pm rt)))
    ((CmRr m _ cp1 _ _ r1 _ c1 l rt)
      (let ((erased n) (erased pm)) (cpmap-map cp1 d e f r1 c1))
      (values n (pointed-rot d m e n f r1 r pm rt)))
    ((CmU d0 cp1 e0 f0 r0 _ _ _ c1 u)
      (let ((erased n0) (erased pm0)) (cpmap-map cp1 d0 e0 f0 r0 c1))
      (ecpU-map d0 e0 n0 f0 r0 e f r pm0 u))
    ((CmY d0 cp1 e0 f0 r0 e1 f1 r1 _ _ _ c1 u nn)
      (let ((erased n0) (erased pm0)) (cpmap-map cp1 d0 e0 f0 r0 c1))
      (let ((erased n1) (erased pm1)) (ecpU-map d0 e0 n0 f0 r0 e1 f1 r1 pm0 u))
      (ecpN-map (Succ (Succ d0)) e1 n1 f1 r1 e f r pm1 nn))
    ((CmH d0 cp1 e0 f0 r0 e1 f1 r1 e2 f2 r2 _ _ _ c1 u nn nn2)
      (let ((erased n0) (erased pm0)) (cpmap-map cp1 d0 e0 f0 r0 c1))
      (let ((erased n1) (erased pm1)) (ecpU-map d0 e0 n0 f0 r0 e1 f1 r1 pm0 u))
      (let ((erased n2) (erased pm2)) (ecpN-map (Succ (Succ d0)) e1 n1 f1 r1 e2 f2 r2 pm1 nn))
      (ecpN-map (Succ (Succ (Succ (Succ d0)))) e2 n2 f2 r2 e f r pm2 nn2))
    ((CmK m d0 cp1 e0 f0 r0 r1 _ _ r2 _ c1 l rt nn rt2)
      (let ((erased n0) (erased pm0)) (cpmap-map cp1 d0 e0 f0 r0 c1))
      (let ((erased n2) (erased pm2)) (ecpN-map d0 e0 n0 f0 r1 e f r2 (pointed-rot d0 m e0 n0 f0 r0 r1 pm0 rt) nn))
      (values n2 (pointed-rot d (Succ (Zero)) e n2 f r2 r pm2 rt2)))))

(def-fns _ $ (erased noa-tail : (erased (Step) s) (erased (List (Step)) cp) (erased (NoA (Cons (Step) s cp)) na) -> (erased (NoA cp) r))
  (match erased na _ ((NoAR _ _ p) p) ((NoARr _ p) p) ((NoAY _ p) p) ((NoAH _ p) p) ((NoAU _ p) p) ((NoAK _ p) p)))

(def-fns _ $ (erased pointed-ring : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (PointedMap d e n f r) pm)
    -> (erased (Nat) a) (erased (List (Nat)) p) (erased (Eq (List (Nat)) r (Cons (Nat) a p)) q))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h cr))
  (let-match erased cr (MkCpring _ p a _ _ _ _))
  (values a p (Refl _ r)))

; Runs cp, building its map and ring with a certificate of the construction.
(def-fns _ $ (many cpmap-c : (subterm many (List (Step)) cp) (erased (NoA cp) na) -> (many (Nat) d) (many (List (Nat)) e f r) (erased (Cpmap cp d e f r) c))
  (let-match many cp (Cons _ s rest)
    ((Nil _) (values (Succ (Succ (Zero))) (Cons _ (Succ (Zero)) (Cons _ (Zero) (Nil _))) (Cons _ (Zero) (Cons _ (Succ (Zero)) (Nil _)))
      (Cons _ (Succ (Zero)) (Cons _ (Zero) (Nil _))) (CmNil))))
  (let ((many d) (many e) (many f) (many r) (erased c)) (notail $ cpmap-c rest (noa-tail s rest na)))
  (let ((erased n) (erased pm)) (cpmap-map rest d e f r c))
  (let ((erased a) (erased p) (erased q)) (pointed-ring d e n f r pm))
  (let-match erased q (Refl _ _))
  (let-match many r (Cons _ a1 p1))
  (let ((erased d2) (erased d4)) (values (Succ (Succ d)) (Succ (Succ (Succ (Succ d))))))
  (match many s _
    ((SR k) (let ((many r2) (erased rt)) (rot-c k r)) (values d e f r2 (CmR k d rest e f r r2 c rt)))
    ((SRr) (let ((many r2) (erased m) (erased l) (erased rt)) (rotr1-c a1 p1)) (values d e f r2 (CmRr m d rest e f r r2 c l rt)))
    ((SU)
      (let ((many e2) (many f2) (many r2) (erased u) (erased _) (erased _)) (ecpU-c d e f r n pm))
      (values (Succ (Succ d)) e2 f2 r2 (CmU d rest e f r e2 f2 r2 c u)))
    ((SY)
      (let ((many e1) (many f1) (many r1) (erased u) (erased n1) (erased pm1)) (ecpU-c d e f r n pm))
      (let ((many e2) (many f2) (many r2) (erased nn) (erased _) (erased _)) (ecpN-c (Succ (Succ d)) e1 f1 r1 n1 pm1))
      (values (Succ (Succ (Succ (Succ d)))) e2 f2 r2 (CmY d rest e f r e1 f1 r1 e2 f2 r2 c u nn)))
    ((SH)
      (let ((many e1) (many f1) (many r1) (erased u) (erased n1) (erased pm1)) (ecpU-c d e f r n pm))
      (let ((many e2) (many f2) (many r2) (erased nn) (erased n2) (erased pm2)) (ecpN-c (Succ (Succ d)) e1 f1 r1 n1 pm1))
      (let ((many e3) (many f3) (many r3) (erased nn2) (erased _) (erased _)) (ecpN-c (Succ (Succ (Succ (Succ d)))) e2 f2 r2 n2 pm2))
      (values (Succ (Succ (Succ (Succ (Succ (Succ d)))))) e3 f3 r3 (CmH d rest e f r e1 f1 r1 e2 f2 r2 e3 f3 r3 c u nn nn2)))
    ((SK)
      (let ((many r1) (erased m) (erased l) (erased rt)) (rotr1-c a1 p1))
      (let ((many e2) (many f2) (many r2) (erased nn) (erased _) (erased _)) (ecpN-c d e f r1 n (pointed-rot d m e n f r r1 pm rt)))
      (let ((many r3) (erased rt2)) (rot-c (Succ (Zero)) r2))
      (values (Succ (Succ d)) e2 f2 r3 (CmK m d rest e f r r1 e2 f2 r2 r3 c l rt nn rt2)))
    (absurd (SA) na)))
