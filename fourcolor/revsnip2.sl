; More of revsnip.v, for plain maps: the faces and disks of the reverse ring, nontrivial rings and the chord rings. Load after
; revsnip.sl.

(def-fns _ $ (erased some-cat : (erased (List (Nat)) f) (erased (Nat) x y z) (erased (SomePath f (Nil (Nat)) x y) p) (erased (SomePath f (Nil (Nat)) y z) q)
    -> (erased (SomePath f (Nil (Nat)) x z) r))
  (let-match erased p (MkSomePath _ _ xs _ _ w))
  (let-match erased q (MkSomePath _ _ ys _ _ v))
  (let ((erased zs) (erased u)) (path-cat f (Nil _) xs ys x y z w v))
  (MkSomePath f (Nil _) zs x z u))

; Every dart of B is on the face of a dart of A.
(def-adts $ (FaceSub : ((List (Nat)) f B A) -> Type)
  enum
  (many FSNil : (erased (List (Nat)) f A) -> (FaceSub f (Nil (Nat)) A))
  (many FSCons : (erased (List (Nat)) f B A) (erased (Nat) b a) (erased (In a A) ia) (erased (SomePath f (Nil (Nat)) b a) sp) (erased (FaceSub f B A) rest)
      -> (FaceSub f (Cons (Nat) b B) A)))

(def-fns _ $ (erased facesub-at : (erased (List (Nat)) f B A) (erased (Nat) b) (subterm erased (FaceSub f B A) fs) (erased (In b B) ib)
    -> (erased (Nat) a) (erased (In a A) ia) (erased (SomePath f (Nil (Nat)) b a) sp))
  (let-match erased fs (FSCons _ Bt _ b1 a ia sp fs1) (absurd (FSNil _ _) ib))
  (match erased ib _ ((InHere _ _) (values a ia sp)) ((InThere _ _ _ ib1) (facesub-at f Bt A b fs1 ib1))))

; fband B is part of fband A.
(def-fns _ $ (erased fband-sub : (erased (List (Nat)) f B A) (erased (Nat) x) (erased (FaceSub f B A) fs) (erased (Fband f B x) fb) -> (erased (Fband f A x) r))
  (let-match erased fb (MkFband _ _ _ y iy w))
  (let ((erased a) (erased ia) (erased sp)) (facesub-at f B A y fs iy))
  (MkFband f A x a ia (some-cat f x y a w sp)))

(def-fns _ $ (erased labs-sub : (erased (List (Nat)) f A lab lsA) (erased (Nat) d) (subterm erased (List (Nat)) B) (erased (FaceSub f B A) fs)
    (erased (Respects lab f lab) rf) (erased (Respects lab A lsA) ra) (erased (Under B d) ub) (erased (Length (Nat) lab d) ll)
    -> (erased (List (Nat)) lsB) (erased (Respects lab B lsB) rb) (erased (Sub lsB lsA) sb))
  (let-match erased fs (FSCons _ Bt _ b a ia sp fs1) ((FSNil _ _) (values (Nil _) (RespNil lab) (HSubNil lsA))))
  (let-match erased ub (UnderCons _ _ _ lb ub1))
  (let ((erased l) (erased pl)) (nth-exists _ lab d b ll lb))
  (let-match erased sp (MkSomePath _ _ xs _ _ w))
  (let ((erased lsB1) (erased rb1) (erased sb1)) (labs-sub f A lab lsA d Bt fs1 rf ra ub1 ll))
  (values (Cons _ l lsB1) (RespCons lab Bt lsB1 b l pl rb1)
    (HSubCons l lsB1 lsA (in-map lab A lsA a l ia ra (path-label f lab (Nil _) xs b a l w rf pl)) sb1)))

; kernel A is part of kernel B.
(def-fns _ $ (erased kernel-sub : (erased (List (Nat)) f B A) (erased (Nat) d x) (erased (FaceSub f B A) fs) (erased (Under B d) ub) (erased (Length (Nat) f d) lf)
    (erased (Kernel f A x) k) -> (erased (Kernel f B x) r))
  (let-match erased k (MkKernel _ _ lab lsA _ l rf ra px ol))
  (let ((erased lsB) (erased rb) (erased sb)) (labs-sub f A lab lsA d B fs rf ra ub (respects-length lab f lab d rf lf)))
  (MkKernel f B lab lsB x l rf rb px (notin-sub l lsB lsA sb ol)))

; A dart u of RR = rev (map e r) is on the face of the dart after e u on r, and a dart a of r on the face of the edge image of the
; dart before it, which is on RR.
(def-fns _ $ (erased rev-face : (erased (Nat) d x0 u) (erased (List (Nat)) e n f p er RR) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Ring e f x0 p) rg) (erased (Respects e (Cons (Nat) x0 p) er) rm) (erased (RevApp (Nat) er (Nil (Nat)) RR) ra) (erased (In u RR) iu)
    -> (erased (Nat) a2) (erased (In a2 (Cons (Nat) x0 p)) ia) (erased (SomePath f (Nil (Nat)) u a2) sp))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased a) (erased pa) (erased ia)) (rev-ring-in d u e _ er RR pl le rm ra iu))
  (let ((erased m) (erased lr)) (length-exists _ (Cons _ x0 p)))
  (let ((erased rr) (erased sn)) (snoc-exists _ p x0))
  (let ((erased lr2)) lr)
  (let-match erased lr2 (LengthCons _ _ _ m1 lp))
  (let ((erased a2) (erased ia2)) (in2-exists _ rr a m ia lr (snoc-length _ p rr x0 m1 sn lp)))
  (let ((erased ea) (erased pea) (erased spa)) (ring-link e f p rr x0 a a2 rg sn ia2))
  (let ((erased pa2) (erased na)) (plain-eq d u a e pl (nth-lt-length _ e u d a pa le) pa))
  (let-match erased (nth-fn _ e a u ea pa2 pea) (Refl _ _))
  (values a2 (sub-in rr _ a2 (snoc-sub p rr x0 sn) (in2-in-left rr _ a2 a (in2-sym _ rr a a2 ia2))) spa))

(def-fns _ $ (erased ring-face : (erased (Nat) d x0 a) (erased (List (Nat)) e n f p er RR) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Ring e f x0 p) rg) (erased (Respects e (Cons (Nat) x0 p) er) rm) (erased (RevApp (Nat) er (Nil (Nat)) RR) ra) (erased (In a (Cons (Nat) x0 p)) ia)
    -> (erased (Nat) u) (erased (In u RR) iu) (erased (SomePath f (Nil (Nat)) a u) sp))
  (let ((erased r)) (Cons _ x0 p))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased m) (erased lr)) (length-exists _ r))
  (let ((erased rr) (erased sn)) (snoc-exists _ p x0))
  (let ((erased lr2)) lr)
  (let-match erased lr2 (LengthCons _ _ _ m1 lp))
  (let ((erased a1) (erased j2)) (in2-exists rr _ a m (sub-in r rr a (sub-of-snoc p rr x0 sn r (sub-refl r)) ia) (snoc-length _ p rr x0 m1 sn lp) lr))
  (let ((erased j3)) (in2-sym rr r a a1 j2))
  (let ((erased u) (erased pu) (erased sp)) (ring-link e f p rr x0 a1 a rg sn j3))
  (let ((erased ia1)) (in2-in-left r rr a1 a j3))
  (let ((erased pu2) (erased nu)) (plain-eq d a1 u e pl (nth-lt-length _ e a1 d u pu le) pu))
  (values u (ring-rev-in d u a1 e r er RR pl le rm ra pu2 ia1) (some-sym d u a f fi pf sp (nth-lt-length _ e u d a1 pu2 le))))

(def-fns _ $ (erased facesub-rev : (erased (Nat) d x0) (erased (List (Nat)) e n f p er RR) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Ring e f x0 p) rg) (erased (Respects e (Cons (Nat) x0 p) er) rm) (erased (RevApp (Nat) er (Nil (Nat)) RR) ra) (subterm erased (List (Nat)) B)
    (erased (Sub B RR) sb) -> (erased (FaceSub f B (Cons (Nat) x0 p)) r))
  (let-match erased sb (HSubCons b Bt _ ib sb1) ((HSubNil _) (FSNil f _)))
  (let ((erased a) (erased ia) (erased sp)) (rev-face d x0 b e n f p er RR h pl rg rm ra ib))
  (FSCons f Bt _ b a ia sp (facesub-rev d x0 e n f p er RR h pl rg rm ra Bt sb1)))

(def-fns _ $ (erased facesub-ring : (erased (Nat) d x0) (erased (List (Nat)) e n f p er RR) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Ring e f x0 p) rg) (erased (Respects e (Cons (Nat) x0 p) er) rm) (erased (RevApp (Nat) er (Nil (Nat)) RR) ra) (subterm erased (List (Nat)) B)
    (erased (Sub B (Cons (Nat) x0 p)) sb) -> (erased (FaceSub f B RR) r))
  (let-match erased sb (HSubCons b Bt _ ib sb1) ((HSubNil _) (FSNil f _)))
  (let ((erased u) (erased iu) (erased sp)) (ring-face d x0 b e n f p er RR h pl rg rm ra ib))
  (FSCons f Bt _ b u iu sp (facesub-ring d x0 e n f p er RR h pl rg rm ra Bt sb1)))

(def-fns _ $ (erased ring-under : (erased (Nat) d x0) (erased (List (Nat)) e n f p) (erased (Hypermap d e n f) h) (erased (Ring e f x0 p) rg)
    -> (erased (Under (Cons (Nat) x0 p) d) ur))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let-match erased rg (MkRing _ _ _ _ w ew rp pw sw sm))
  (let-match erased sm (MkSimple _ _ lab ls rf rl dl))
  (resp-under lab ls d (Cons _ x0 p) rl (respects-length lab f lab d rf lf)))

; fband_rev_ring and its kernel form: RR and r are each on the faces of the other.
(def-fns _ $ (erased rev-subs : (erased (Nat) d x0) (erased (List (Nat)) e n f p er RR) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Ring e f x0 p) rg) (erased (Respects e (Cons (Nat) x0 p) er) rm) (erased (RevApp (Nat) er (Nil (Nat)) RR) ra)
    -> (erased (FaceSub f RR (Cons (Nat) x0 p)) a) (erased (FaceSub f (Cons (Nat) x0 p) RR) b) (erased (Under (Cons (Nat) x0 p) d) ur) (erased (Under RR d) uR))
  (let ((erased r)) (Cons _ x0 p))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (values (facesub-rev d x0 e n f p er RR h pl rg rm ra RR (sub-refl RR)) (facesub-ring d x0 e n f p er RR h pl rg rm ra r (sub-refl r))
    (ring-under d x0 e n f p h rg) (revapp-under er (Nil _) RR d ra (respects-under-vals e r er d rm (perm-under d e nf pe)) (UnderNil d))))

; The darts of xs lie on distinct faces, none of them the face of a dart of r: a labelling constant along f gives them distinct
; labels, none of them that of a dart of r.
(def-adts $ (Scattered : ((List (Nat)) f r xs) -> Type)
  enum
  (many MkScattered : (erased (List (Nat)) f r xs lab lr lx) (erased (Respects lab f lab) rf) (erased (Respects lab r lr) rr) (erased (Respects lab xs lx) rx)
      (erased (Distinct lx) dx) (erased (Disj lx lr) dj) -> (Scattered f r xs)))

(def-fns _ $ (erased scattered-sub : (erased (List (Nat)) f B A xs) (erased (Nat) d) (erased (FaceSub f B A) fs) (erased (Under B d) ub) (erased (Length (Nat) f d) lf)
    (erased (Scattered f A xs) sp) -> (erased (Scattered f B xs) r))
  (let-match erased sp (MkScattered _ _ _ lab lA lx rf ra rx dx dj))
  (let ((erased lB) (erased rb) (erased sb)) (labs-sub f A lab lA d B fs rf ra ub (respects-length lab f lab d rf lf)))
  (MkScattered f B xs lab lB lx rf rb rx dx (disj-sub lA lB lx dj sb)))

; nontrivial_ring m r: m < fcard face (diskF r) and m < fcard face (diskFC r), read as m + 1 darts of each on distinct faces, the
; darts of diskN r and those off it given by a DiskSplit. That this matches Coq's fcard has been checked only by reading.
(def-adts $ (NonTrivial : ((Nat) d) ((List (Nat)) e n f r) ((Nat) m) -> Type)
  enum
  (many MkNonTrivial : (erased (Nat) d m) (erased (List (Nat)) e n f r hd zs xs ys) (erased (DiskSplit d e n r hd zs) ds)
      (erased (Length (Nat) xs (Succ m)) lx) (erased (Length (Nat) ys (Succ m)) ly) (erased (Sub xs hd) sx) (erased (Sub ys zs) sy)
      (erased (Scattered f r xs) px) (erased (Scattered f r ys) py) -> (NonTrivial d e n f r m)))

(def-fns _ $ (erased ds-lt : (erased (Nat) d x) (erased (List (Nat)) e n r hd zs) (erased (DiskSplit d e n r hd zs) ds) (erased (HOr (In x hd) (In x zs)) ix)
    -> (erased (Lt x d) lx))
  (let ((erased ids) (erased io) (erased sp)) (ds-split d e n r hd zs ds))
  (let ((erased sa) (erased sb)) (split-sub hd ids hd zs sp))
  (under-in ids x d (perm-under d ids ids (perm-id d ids io))
    (match erased ix (((In x ids) res)) ((OrL _ _ i) (sub-in hd ids x sa i)) ((OrR _ _ i) (sub-in zs ids x sb i)))))

; With e x0 = y on r = x0 :: y, every dart a clink path reaches from diskN r is in diskN r.
(def-fns _ $ (erased pair-disk : (erased (Nat) d x0 y a b) (erased (List (Nat)) e n f L) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Nth (Nat) e x0 y) pxy) (subterm erased (CPath n f a L b) cp) (erased (DiskN n f (Cons (Nat) x0 (Cons (Nat) y (Nil (Nat)))) a) da)
    -> (erased (DiskN n f (Cons (Nat) x0 (Cons (Nat) y (Nil (Nat)))) b) db))
  (let ((erased r)) (Cons _ x0 (Cons _ y (Nil _))))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf2)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (match erased cp _
    ((CPNil _ _ _) da)
    ((CPNode _ _ L1 _ c _ pnc cp1) (pair-disk d x0 y c b e n f L1 h pl pxy cp1 (disk-pre n f r a c da pnc)))
    ((CPFace _ _ L1 _ c _ pf cp1)
      (pair-disk d x0 y c b e n f L1 h pl pxy cp1
        (match erased (in-dec a r) (((DiskN n f r c) res))
          ((OrR _ _ o) (disk-step n f r a c da (DPFace n f r a c c o pf (DPNil n f r c))))
          ((OrL _ _ ia)
            (let ((erased la)) (nth-lt-length _ f a d c pf lf))
            (let ((erased ea) (erased pea) (erased lea)) (perm-nth d a e nf pe la))
            (let ((erased pea2) (erased nea)) (plain-eq d a ea e pl la pea))
            (let ((erased iea)) (match erased ia (((In ea r) res))
              ((InHere _ _) (let-match erased (nth-fn _ e x0 y ea pxy pea) (Refl _ _)) (InThere ea x0 _ (InHere ea (Nil _))))
              ((InThere _ _ _ ia1)
                (let-match erased ia1 (InHere _ _) (absurd (InThere _ _ _ i) (match erased i _)))
                (let ((erased pyx) (erased nyx)) (plain-eq d x0 y e pl (nth-lt-length _ e x0 d y pxy le) pxy))
                (let-match erased (nth-fn _ e y x0 ea pyx pea) (Refl _ _))
                (InHere ea _))))
            (MkDiskN n f r c ea c iea (hyper-node d c a ea e n f h pf pea2) (DPNil n f r c))))))))

; nontrivial_ring_proper.
(def-fns _ $ (erased nontrivial-proper : (erased (Nat) d x0 m) (erased (List (Nat)) e n f p) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Bridgeless d e n f) b) (erased (AllOrder d e (Succ (Succ (Zero)))) pl) (erased (Connected d e n f) cn) (erased (Ring e f x0 p) rg)
    (erased (NonTrivial d e n f (Cons (Nat) x0 p) m) nt) -> (erased (Proper e (Cons (Nat) x0 p)) pr))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased rg1)) rg)
  (let-match erased rg1 (MkRing _ _ _ _ w ew rp pw sw sm))
  (match erased p (((Proper e (Cons (Nat) x0 p)) res))
    (absurd (Nil _)
      (let-match erased rp (RPNil _ _ _))
      (let-match erased (some-sym d ew x0 f fi pf sw (perm-val d x0 ew e nf pe pw)) (MkSomePath _ _ xs _ _ w2))
      (bridgeless-face d x0 ew e n f (Nil _) xs b pw w2))
    ((Cons _ y p1)
      (let-match erased rp (RPCons _ _ _ _ ex0 _ _ pex0 _ _))
      (let-match erased p1 (Nil _) ((Cons _ z p2) (ProperBig e p2 x0 y z)))
      (match erased (nat-eq ex0 y) _
        ((Unequal _ _ _ _ ne) (ProperTwo e x0 y ex0 pex0 ne))
        (absurd (Equal _ _ _)
          (let ((erased r)) (Cons _ x0 (Cons _ y (Nil _))))
          (let-match erased nt (MkNonTrivial _ _ _ _ _ _ hd zs xs ys ds lx ly sx sy px py))
          (let-match erased ly (LengthCons _ y0 ys1 _ ly1))
          (let ((erased iy0)) (sub-in ys zs y0 sy (InHere y0 ys1)))
          (let ((erased lx0)) (nth-lt-length _ e x0 d ex0 pex0 le))
          (let ((erased L) (erased cp)) (connected-clink d x0 y0 e n f h cn lx0 (ds-lt d y0 e n r hd zs ds (OrR _ _ iy0))))
          (ds-out d y0 x0 e n f p hd zs h gen rg (ring-under d x0 e n f p h rg) ds iy0
            (pair-disk d x0 y x0 y0 e n f L h pl pex0 cp (disk-ring d x0 n ni f r pn (InHere x0 _) lx0))))))))

; A dart off the diskN part hdX of one DiskSplit is in the other part zsB of any other.
(def-fns _ $ (erased ds-off : (erased (Nat) d x x0) (erased (List (Nat)) e n f p hdX zsX hdB zsB) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f x0 p) rg) (erased (Under (Cons (Nat) x0 p) d) ur) (erased (DiskSplit d e n (Cons (Nat) x0 p) hdX zsX) dsX)
    (erased (DiskSplit d e n (Cons (Nat) x0 p) hdB zsB) dsB) (erased (NotIn x hdX) o) (erased (Lt x d) lx) -> (erased (In x zsB) iz))
  (let ((erased ids) (erased io) (erased sp)) (ds-split d e n _ hdB zsB dsB))
  (match erased (split-cover hdB ids hdB zsB x sp (iota-in d x ids io lx)) _
    (absurd (OrL _ _ i)
      (apart-irrefl x (notin-in x x hdX o (ds-mem d x x0 e n f p hdX zsX h gen rg ur dsX (ds-in d x x0 e n f p hdB zsB h gen rg ur dsB i) lx))))
    ((OrR _ _ i) i)))

; Darts of diskN r are off diskN RR, and darts off diskN r are in diskN RR, whatever DiskSplits name them.
(def-fns _ $ (erased rev-sub-in : (erased (Nat) d) (erased (List (Nat)) e n f r RR hd hd2 hdA zsA hdB zsB) (erased (RevCtx d e n f r RR hd hd2) cx)
    (erased (Connected d e n f) cn) (erased (DiskSplit d e n r hdA zsA) dsA) (erased (DiskSplit d e n RR hdB zsB) dsB) (subterm erased (List (Nat)) xs)
    (erased (Sub xs hdA) sx) -> (erased (Sub xs zsB) res))
  (let-match erased sx (HSubCons x xs1 _ ix sx1) ((HSubNil _) (HSubNil zsB)))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er _ zs _ zs2 h gen pl rg pr ur ds rm ra rg2 pr2 ur2 ds2))
  (let ((erased lx)) (ds-lt d x e n r hdA zsA dsA (OrL _ _ ix)))
  (let ((erased dn)) (ds-in d x x0 e n f p hdA zsA h gen rg ur dsA ix))
  (HSubCons x xs1 zsB
    (match erased (rev-disk d x e n f r RR hd hd2 cx cn lx) (((In x zsB) res))
      ((TwoR _ _ _ _ _ _ _ _ o) (ds-off d x y0 e n f Q hd2 zs2 hdB zsB h gen rg2 ur2 ds2 dsB o lx))
      (absurd (TwoRR _ _ _ _ _ _ _ _ o) (apart-irrefl x (notin-in x x hd o (ds-mem d x x0 e n f p hd zs h gen rg ur ds dn lx)))))
    (rev-sub-in d e n f r RR hd hd2 hdA zsA hdB zsB cx cn dsA dsB xs1 sx1)))

(def-fns _ $ (erased rev-sub-out : (erased (Nat) d) (erased (List (Nat)) e n f r RR hd hd2 hdA zsA hdB zsB) (erased (RevCtx d e n f r RR hd hd2) cx)
    (erased (Connected d e n f) cn) (erased (DiskSplit d e n r hdA zsA) dsA) (erased (DiskSplit d e n RR hdB zsB) dsB) (subterm erased (List (Nat)) ys)
    (erased (Sub ys zsA) sy) -> (erased (Sub ys hdB) res))
  (let-match erased sy (HSubCons y ys1 _ iy sy1) ((HSubNil _) (HSubNil hdB)))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er _ zs _ zs2 h gen pl rg pr ur ds rm ra rg2 pr2 ur2 ds2))
  (let ((erased ly)) (ds-lt d y e n r hdA zsA dsA (OrR _ _ iy)))
  (HSubCons y ys1 hdB
    (match erased (rev-disk d y e n f r RR hd hd2 cx cn ly) (((In y hdB) res))
      (absurd (TwoR _ _ _ _ _ _ _ dn _) (ds-out d y x0 e n f p hdA zsA h gen rg ur dsA iy dn))
      ((TwoRR _ _ _ _ _ _ _ dn _) (ds-mem d y y0 e n f Q hdB zsB h gen rg2 ur2 dsB dn ly)))
    (rev-sub-out d e n f r RR hd hd2 hdA zsA hdB zsB cx cn dsA dsB ys1 sy1)))

; nontrivial_rev_ring.
(def-fns _ $ (erased nontrivial-rev : (erased (Nat) d m) (erased (List (Nat)) e n f r RR hd hd2) (erased (RevCtx d e n f r RR hd hd2) cx)
    (erased (Connected d e n f) cn) (erased (NonTrivial d e n f r m) nt) -> (erased (NonTrivial d e n f RR m) res))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er _ zs _ zs2 h gen pl rg pr ur ds rm ra rg2 pr2 ur2 ds2))
  (let-match erased nt (MkNonTrivial _ _ _ _ _ _ hdA zsA xs ys dsA lx ly sx sy px py))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased fa) (erased fb) (erased ur1) (erased uR)) (rev-subs d x0 e n f p er RR h pl rg rm ra))
  (MkNonTrivial d m e n f RR hd2 zs2 ys xs ds2 ly lx (rev-sub-out d e n f r RR hd hd2 hdA zsA hd2 zs2 cx cn dsA ds2 ys sy)
    (rev-sub-in d e n f r RR hd hd2 hdA zsA hd2 zs2 cx cn dsA ds2 xs sx) (scattered-sub f RR r ys d fa uR lf py) (scattered-sub f RR r xs d fa uR lf px)))

(def-fns _ $ (erased kernel-face : (erased (List (Nat)) f r) (erased (Nat) x y) (erased (Kernel f r x) k) (erased (Nth (Nat) f x y) pf) -> (erased (Kernel f r y) res))
  (let-match erased k (MkKernel _ _ lab ls _ l rf rp px ol))
  (MkKernel f r lab ls y l rf rp (respects-nth lab f lab x y l rf pf px) ol))

(def-fns _ $ (erased kernel-face-inv : (erased (Nat) d x y) (erased (List (Nat)) f r) (erased (Length (Nat) f d) lf) (erased (Kernel f r y) k) (erased (Nth (Nat) f x y) pf)
    -> (erased (Kernel f r x) res))
  (let-match erased k (MkKernel _ _ lab ls _ l rf rp py ol))
  (let ((erased l2) (erased px)) (nth-exists _ lab d x (respects-length lab f lab d rf lf) (nth-lt-length _ f x d y pf lf)))
  (let-match erased (nth-fn _ lab y l l2 py (respects-nth lab f lab x y l2 rf pf px)) (Refl _ _))
  (MkKernel f r lab ls x l rf rp px ol))

; diskFC_face, with diskFC r read as the darts zs off diskN r that are on no face of r: it is closed under face, both ways.
(def-fns _ $ (erased diskfc-face : (erased (Nat) d x y x0) (erased (List (Nat)) e n f p hd zs) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f x0 p) rg) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds) (erased (In x zs) iz) (erased (Kernel f (Cons (Nat) x0 p) x) k)
    (erased (Nth (Nat) f x y) pf) -> (erased (In y zs) iy) (erased (Kernel f (Cons (Nat) x0 p) y) ky))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased ur)) (ring-under d x0 e n f p h rg))
  (let ((erased ky)) (kernel-face f _ x y k pf))
  (let ((erased ly)) (perm-val d x y f fi pmf pf))
  (values
    (match erased (in-dec y hd) (((In y zs) res))
      (absurd (OrL _ _ i)
        (let-match erased (diskf-face-inv d x y n f fi _ pmf (MkDiskF n f _ y (ds-in d y x0 e n f p hd zs h gen rg ur ds i) ky) pf) (MkDiskF _ _ _ _ dx _))
        (ds-out d x x0 e n f p hd zs h gen rg ur ds iz dx))
      ((OrR _ _ o) (ds-off d y x0 e n f p hd zs hd zs h gen rg ur ds ds o ly)))
    ky))

(def-fns _ $ (erased diskfc-face-inv : (erased (Nat) d x y x0) (erased (List (Nat)) e n f p hd zs) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f x0 p) rg) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds) (erased (In y zs) iz) (erased (Kernel f (Cons (Nat) x0 p) y) k)
    (erased (Nth (Nat) f x y) pf) -> (erased (In x zs) ix) (erased (Kernel f (Cons (Nat) x0 p) x) kx))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased ur)) (ring-under d x0 e n f p h rg))
  (let ((erased kx)) (kernel-face-inv d x y f _ lf k pf))
  (let ((erased lx)) (nth-lt-length _ f x d y pf lf))
  (values
    (match erased (in-dec x hd) (((In x zs) res))
      (absurd (OrL _ _ i)
        (let-match erased (diskf-face n f _ x y (MkDiskF n f _ x (ds-in d x x0 e n f p hd zs h gen rg ur ds i) kx) pf) (MkDiskF _ _ _ _ dy _))
        (ds-out d y x0 e n f p hd zs h gen rg ur ds iz dy))
      ((OrR _ _ o) (ds-off d x x0 e n f p hd zs hd zs h gen rg ur ds ds o lx)))
    kx))

; diskN_rot and fband_rot: diskN and fband depend only on the darts of the ring.
(def-fns _ $ (erased dpath-move : (erased (List (Nat)) n f r s) (erased (Nat) x y) (subterm erased (DPath n f r x y) dp) (erased (Sub s r) sb) -> (erased (DPath n f s x y) res))
  (match erased dp _
    ((DPNil _ _ _ _) (DPNil n f s x))
    ((DPNode _ _ _ _ z _ o pn dp1) (DPNode n f s x z y (notin-sub x s r sb o) pn (dpath-move n f r s z y dp1 sb)))
    ((DPFace _ _ _ _ z _ o pf dp1) (DPFace n f s x z y (notin-sub x s r sb o) pf (dpath-move n f r s z y dp1 sb)))))

(def-fns _ $ (erased disk-move : (erased (List (Nat)) n f r s) (erased (Nat) x) (erased (DiskN n f r x) dn) (erased (Sub r s) rs) (erased (Sub s r) sr)
    -> (erased (DiskN n f s x) res))
  (let-match erased dn (MkDiskN _ _ _ _ y y2 iy pn dp))
  (MkDiskN n f s x y y2 (sub-in r s y rs iy) pn (dpath-move n f r s y2 x dp sr)))

(def-fns _ $ (erased fband-move : (erased (List (Nat)) f r s) (erased (Nat) x) (erased (Fband f r x) fb) (erased (Sub r s) rs) -> (erased (Fband f s x) res))
  (let-match erased fb (MkFband _ _ _ y iy w))
  (MkFband f s x y (sub-in r s y rs iy) w))

(def-fns _ $ (erased patch-disk : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) -> (erased (Hypermap dd ed nd fd) hdm) (erased (Length (Nat) hd dd) lhd) (erased (Distinct hd) dhd))
  (let-match erased pt
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (values hdm lhd dhd))

(def-fns _ $ (erased some-step : (erased (List (Nat)) f) (erased (Nat) a b) (erased (Nth (Nat) f a b) pf) -> (erased (SomePath f (Nil (Nat)) a b) r))
  (MkSomePath f (Nil _) (Cons _ a (Nil _)) a b (PathStep f (Nil _) (Nil _) a b b pf (NotInNil a) (PathHere f (Nil _) b))))

; Along a path a :: q of p ending at b, with p b = c, p w = u for w on it: u follows w on q followed by c.
(def-fns _ $ (erased fpath-in2 : (erased (List (Nat)) p q qc) (erased (Nat) a b c w u) (subterm erased (FPath p a q b) fp) (erased (HSnoc (Nat) q c qc) sn)
    (erased (Nth (Nat) p b c) pb) (erased (In w (Cons (Nat) a q)) iw) (erased (Nth (Nat) p w u) pw) -> (erased (In2 (Cons (Nat) a q) qc w u) r))
  (match erased fp _
    ((FPNil _ _)
      (let-match erased sn (SnocNil _ _))
      (let-match erased iw (InHere _ _) (absurd (InThere _ _ _ i) (match erased i _)))
      (let-match erased (nth-fn _ p a u c pw pb) (Refl _ _))
      (I2Here a u (Nil _) (Nil _)))
    ((FPCons _ q1 _ a1 _ pa fp1)
      (let-match erased sn (SnocCons _ _ _ _ qc1 sn1))
      (let-match erased iw (InHere _ _) ((InThere _ _ _ iw1) (I2There a a1 w u q qc1 (fpath-in2 p q1 qc1 a1 b c w u fp1 sn1 pb iw1 pw))))
      (let-match erased (nth-fn _ p a u a1 pw pa) (Refl _ _))
      (I2Here a u q qc1))))

(def-fns _ $ (erased in2-map : (erased (List (Nat)) h R S T U) (erased (Nat) x y) (subterm erased (In2 R T x y) i) (erased (Respects h R S) rs) (erased (Respects h T U) rt)
    -> (erased (Nat) hx hy) (erased (Nth (Nat) h x hx) px) (erased (Nth (Nat) h y hy) py) (erased (In2 S U hx hy) r))
  (let-match erased rs (RespCons _ R1 S1 _ s1 ps rs1) (absurd (RespNil _) (match erased i _)))
  (let-match erased rt (RespCons _ T1 U1 _ u1 pu rt1) (absurd (RespNil _) (match erased i _)))
  (let-match erased i (I2There _ _ _ _ _ _ j1) ((I2Here _ _ _ _) (values s1 u1 ps pu (I2Here s1 u1 S1 U1))))
  (let ((erased hx) (erased hy) (erased px) (erased py) (erased r1)) (in2-map h R1 S1 T1 U1 x y j1 rs1 rt1))
  (values hx hy px py (I2There s1 u1 hx hy S1 U1 r1)))

; An edge cycle bd of the disk map sent to the ring r: from the edge image of hd w, the face of hd u is reached, for u = ed w.
(def-fns _ $ (erased ncyc-link : (erased (Nat) x0 w u) (erased (List (Nat)) e f p ed hd bd) (erased (Ring e f x0 p) rg) (erased (NCyc ed bd) nc)
    (erased (Respects hd bd (Cons (Nat) x0 p)) rb) (erased (In w bd) iw) (erased (Nth (Nat) ed w u) pw)
    -> (erased (Nat) hw ehw hu) (erased (Nth (Nat) hd w hw) phw) (erased (Nth (Nat) e hw ehw) pe) (erased (Nth (Nat) hd u hu) phu)
    (erased (SomePath f (Nil (Nat)) ehw hu) sp))
  (let-match erased nc (NCCons _ B b0 bl fp back) (absurd (NCNil _) iw))
  (let ((erased rb2)) rb)
  (let-match erased rb2 (RespCons _ _ _ _ _ pb0 rb1))
  (let ((erased bdr) (erased sn)) (snoc-exists _ B b0))
  (let ((erased rr) (erased sn2)) (snoc-exists _ p x0))
  (let ((erased hw) (erased hu) (erased phw) (erased phu) (erased k3))
    (in2-map hd bd (Cons _ x0 p) bdr rr w u (fpath-in2 ed B bdr b0 bl b0 w u fp sn back iw pw) rb (respects-snoc hd B bdr p rr b0 x0 rb1 pb0 sn sn2)))
  (let ((erased ehw) (erased pe) (erased sp)) (ring-link e f p rr x0 hw hu rg sn2 k3))
  (values hw ehw hu phw pe phu sp))

; The homomorphic half of cface_snipd: a face step of the disk map of a ring r stays on a face of the whole map.
(def-fns _ $ (erased snipd-step : (erased (Nat) d dd dr x0 u v x y) (erased (List (Nat)) e n f p ed nd fd er nr fr hd hr bd br)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (erased (Nth (Nat) fd u v) pf) (erased (Nth (Nat) hd u x) hx) (erased (Nth (Nat) hd v y) hy) -> (erased (SomePath f (Nil (Nat)) x y) sp))
  (let ((erased pt2)) pt)
  (let-match erased pt2
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let-match erased (in-dec u bd) (OrL _ _ iu) ((OrR _ _ o) (some-step f x y (patch-face-d d dd dr e n f ed nd fd er nr fr hd hr bd br pt u v x y o pf hx hy))))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hdm))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased lv)) (perm-val dd u v fd fdi pmfd pf))
  (let ((erased w) (erased pw) (erased lw)) (perm-nth dd v nd ndi pmnd lv))
  (let ((erased pew)) (hyper-edge dd w v u ed nd fd hdm pw pf))
  (let ((erased hw) (erased ehw) (erased hu) (erased phw) (erased pe) (erased phu) (erased sp))
    (ncyc-link x0 w u e f p ed hd bd rg cyd rb (ncyc-prev dd ed nfd bd w u pmed cyd iu pew) pew))
  (let-match erased (nth-fn _ hd u x hu hx phu) (Refl _ _))
  (let ((erased hw2) (erased phw2) (erased pny)) (morph hd nd n (Nil _) idd dd v w y mnd iod lv (NotInNil v) pw hy))
  (let-match erased (nth-fn _ hd w hw hw2 phw phw2) (Refl _ _))
  (some-cat f x ehw y (some-sym d ehw x f fi pmf sp (perm-val d hw ehw e nf pme pe)) (some-step f ehw y (hyper-third d ehw hw y e n f h pe pny))))

(def-fns _ $ (erased snipd-push : (erased (Nat) d dd dr x0 a b ha) (erased (List (Nat)) e n f p ed nd fd er nr fr hd hr bd br s xs)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (subterm erased (Path fd s a b xs) w) (erased (Nth (Nat) hd a ha) pa) -> (erased (Nat) hb) (erased (Nth (Nat) hd b hb) pb) (erased (SomePath f (Nil (Nat)) ha hb) sp))
  (let-match erased w (PathStep _ _ xs1 _ a1 _ pf _ w1) ((PathHere _ _ _) (values ha pa (MkSomePath f (Nil _) (Nil _) ha ha (PathHere f (Nil _) ha)))))
  (let ((erased hdm) (erased lhd) (erased dhd)) (patch-disk d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hdm))
  (let ((erased ha1) (erased pa1)) (nth-exists _ hd dd a1 lhd (perm-val dd a a1 fd fdi pmfd pf)))
  (let ((erased hb) (erased pb) (erased sp)) (snipd-push d dd dr x0 a1 b ha1 e n f p ed nd fd er nr fr hd hr bd br s xs1 pt rg rb w1 pa1))
  (values hb pb (some-cat f ha ha1 hb (snipd-step d dd dr x0 a a1 ha ha1 e n f p ed nd fd er nr fr hd hr bd br pt rg rb pf pa pa1) sp)))

(def-fns _ $ (erased patch-whole : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) -> (erased (Hypermap d e n f) h) (erased (Under hd d) uhd))
  (let-match erased pt
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (values h uhd))

; A face path of the whole map leaving from no dart of the ring r is one of the disk map.
(def-fns _ $ (erased snipd-pull : (erased (Nat) d dd dr a b ad) (erased (List (Nat)) e n f r ed nd fd er nr fr hd hr bd br s xs)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects hd bd r) rb) (subterm erased (Path f s a b xs) w) (erased (Off r xs) off)
    (erased (Nth (Nat) hd ad a) pa) -> (erased (Nat) bd2) (erased (Nth (Nat) hd bd2 b) pb) (erased (SomePath fd (Nil (Nat)) ad bd2) sp))
  (let-match erased w (PathStep _ _ xs1 _ a1 _ pf _ w1) ((PathHere _ _ _) (values ad pa (MkSomePath fd (Nil _) (Nil _) ad ad (PathHere fd (Nil _) ad)))))
  (let-match erased off (OffCons _ _ _ oa off1))
  (let ((erased hdm) (erased lhd) (erased dhd)) (patch-disk d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hdm))
  (let ((erased a1d) (erased pfd) (erased la1)) (perm-nth dd ad fd fdi pmfd (nth-lt-length _ hd ad dd a pa lhd)))
  (let ((erased ha1) (erased pa1)) (nth-exists _ hd dd a1d lhd la1))
  (let ((erased oad)) (match erased (in-dec ad bd) (((NotIn ad bd) res))
    (absurd (OrL _ _ i) (apart-irrefl a (notin-in a a r oa (in-map hd bd r ad a i rb pa))))
    ((OrR _ _ o) o)))
  (let-match erased (nth-fn _ f a a1 ha1 pf (patch-face-d d dd dr e n f ed nd fd er nr fr hd hr bd br pt ad a1d a ha1 oad pfd pa pa1)) (Refl _ _))
  (let ((erased bd2) (erased pb) (erased sp)) (snipd-pull d dd dr a1 b a1d e n f r ed nd fd er nr fr hd hr bd br s xs1 pt rb w1 off1 pa1))
  (values bd2 pb (some-cat fd ad a1d bd2 (some-step fd ad a1d pfd) sp)))

; A face path of the whole map from hd ad to a dart z of the ring gives one of the disk map from ad to the dart of bd sent to z.
(def-fns _ $ (erased snipd-pull-ring : (erased (Nat) d dd dr x0 a z ad) (erased (List (Nat)) e n f p ed nd fd er nr fr hd hr bd br xs)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (erased (Path f (Nil (Nat)) a z xs) w) (erased (In z (Cons (Nat) x0 p)) iz) (erased (Nth (Nat) hd ad a) pa)
    -> (erased (Nat) zd) (erased (Nth (Nat) hd zd z) pz) (erased (SomePath fd (Nil (Nat)) ad zd) sp))
  (let ((erased h) (erased uhd)) (patch-whole d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased rg1)) rg)
  (let-match erased rg1 (MkRing _ _ _ _ wr ew rp pw sw sm))
  (let-match erased sm (MkSimple _ _ lab ls rf rl dl))
  (let ((erased ll)) (respects-length lab f lab d rf lf))
  (let ((erased l) (erased pl)) (nth-exists _ lab d a ll (under-nth hd ad a d uhd pa)))
  (let ((erased ys) (erased w2)) (walk-to f xs a z w))
  (snipd-pull d dd dr a z ad e n f _ ed nd fd er nr fr hd hr bd br (Cons _ z (Nil _)) ys pt rb w2
    (path-off-simple f lab _ ls ys a z l w2 rf rl dl iz pl (path-label f lab (Nil _) xs a z l w rf pl)) pa))

; The other half of cface_snipd: darts of the disk map whose images share a face of the whole map share a face of the disk map.
(def-fns _ $ (erased snipd-face-inv : (erased (Nat) d dd dr x0 u v x y) (erased (List (Nat)) e n f p ed nd fd er nr fr hd hr bd br)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (erased (Nth (Nat) hd u x) hx) (erased (Nth (Nat) hd v y) hy) (erased (SomePath f (Nil (Nat)) x y) sp) -> (erased (SomePath fd (Nil (Nat)) u v) res))
  (let ((erased hdm) (erased lhd) (erased dhd)) (patch-disk d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased h) (erased uhd)) (patch-whole d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hdm))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let-match erased sp (MkSomePath _ _ xs _ _ w))
  (match erased (meet-dec (Cons _ x0 p) xs) _
    ((MeetNone _ _ o)
      (let ((erased vd) (erased pv) (erased sp1)) (snipd-pull d dd dr x y u e n f _ ed nd fd er nr fr hd hr bd br (Nil _) xs pt rb w o hx))
      (let-match erased (distinct-nth hd vd v y dhd pv hy) (Refl _ _))
      sp1)
    ((MeetAt _ _ z iz ir)
      (let ((erased P) (erased Q) (erased w1) (erased w2) (erased ap)) (path-split f (Nil _) xs x y z w iz))
      (let ((erased zd) (erased pz) (erased sp1)) (snipd-pull-ring d dd dr x0 x z u e n f p ed nd fd er nr fr hd hr bd br P pt rg rb w1 ir hx))
      (let-match erased (some-sym d z y f fi pmf (MkSomePath f (Nil _) (Cons _ z Q) z y w2) (under-in _ z d (ring-under d x0 e n f p h rg) ir))
        (MkSomePath _ _ ys _ _ w3))
      (let ((erased zd2) (erased pz2) (erased sp2)) (snipd-pull-ring d dd dr x0 y z v e n f p ed nd fd er nr fr hd hr bd br ys pt rg rb w3 ir hy))
      (let-match erased (distinct-nth hd zd zd2 z dhd pz pz2) (Refl _ _))
      (some-cat fd u zd v sp1 (some-sym dd v zd fd fdi pmfd sp2 (nth-lt-length _ hd v dd y hy lhd))))))

(def-fns _ $ (erased four-edge : (erased (List (Nat)) e f ks) (erased (Nat) x y a b) (erased (FourColoring e f ks) c) (erased (Nth (Nat) e x y) pe)
    (erased (Nth (Nat) ks x a) pa) (erased (Nth (Nat) ks y b) pb) -> (erased (Apart (Nat) Lt b a) r))
  (let-match erased c (MkFourColoring _ _ _ ke rf re df u))
  (differ-nth ke ks x b a df (respects-at ks e ke x y b re pe pb) pa))

(def-fns _ $ (erased app-out : (erased (List (Nat)) ys zs) (erased (Nat) x) (subterm erased (List (Nat)) xs) (erased (AppN xs ys zs) ap) (erased (In x zs) ix)
    -> (erased (HOr (In x xs) (In x ys)) r))
  (let-match erased ap (AppCons xs1 _ zs1 y ap1) ((AppNil _) (OrR _ _ ix)))
  (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) (OrL _ _ (InHere x xs1))))
  (match erased (app-out ys zs1 x xs1 ap1 ix1) _ ((OrL _ _ i) (OrL _ _ (InThere x y xs1 i))) ((OrR _ _ i) (OrR _ _ i))))

; lab numbers the faces of the map by their roots.
(def-adts $ (FaceLab : ((Nat) d) ((List (Nat)) f lab) -> Type)
  enum
  (many MkFaceLab : (erased (Nat) d k) (erased (List (Nat)) f fi lab ids rs) (erased (List (Bond)) gf) (erased (HPerm d f fi) pf) (erased (Graph d f gf) gr)
      (erased (Iota d ids) io) (erased (Rooted gf rs ids lab) ro) (erased (Const lab gf) cl) (erased (Length (Nat) lab d) ll) -> (FaceLab d f lab)))

(def-fns _ $ (erased facelab-exists : (erased (Nat) d) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) -> (erased (List (Nat)) lab) (erased (FaceLab d f lab) fl))
  (let ((erased gf) (erased gr)) (perm-graph d f fi pf))
  (let ((erased k) (erased cs)) (classes-exists gf d (graph-below d f fi gf (graph-fun d f gf gr) pf)))
  (let-match erased cs (MkClasses _ _ _ ids lab rs io ll lr dr fix cl ro))
  (values lab (MkFaceLab d k f fi lab ids rs gf pf gr io ro cl ll)))

(def-fns _ $ (erased facelab-path : (erased (Nat) d x y l) (erased (List (Nat)) f lab) (erased (FaceLab d f lab) fl) (erased (SomePath f (Nil (Nat)) x y) sp)
    (erased (Nth (Nat) lab x l) px) -> (erased (Nth (Nat) lab y l) py))
  (let-match erased fl (MkFaceLab _ k _ fi _ ids rs gf pf gr io ro cl ll))
  (let-match erased sp (MkSomePath _ _ xs _ _ w))
  (conn-const lab gf x y l (path-graph-conn d x y f (Nil _) xs gf w gr) cl px))

(def-fns _ $ (erased facelab-same : (erased (Nat) d x y l) (erased (List (Nat)) f lab) (erased (FaceLab d f lab) fl) (erased (Nth (Nat) lab x l) px)
    (erased (Nth (Nat) lab y l) py) -> (erased (SomePath f (Nil (Nat)) x y) sp))
  (let-match erased fl (MkFaceLab _ k _ fi _ ids rs gf pf gr io ro cl ll))
  (let ((erased xs) (erased w)) (conn-path d x y f fi gf pf gr
    (same-root gf d x y l ids lab rs io ro px py (nth-lt-length _ lab x d l px ll) (nth-lt-length _ lab y d l py ll))))
  (MkSomePath f (Nil _) xs x y w))

; ks colours a dart x as kd colours the darts of the disk map whose images share its face, if there are any, with ld their
; face labels.
(def-adts $ (ExtAt : ((List (Nat)) lab ld kd) ((Nat) x c) -> Type)
  enum
  (many EAIn : (erased (List (Nat)) lab ld kd) (erased (Nat) x l j c) (erased (Nth (Nat) lab x l) px) (erased (Nth (Nat) ld j l) pj) (erased (Nth (Nat) kd j c) pc)
      -> (ExtAt lab ld kd x c))
  (many EAOut : (erased (List (Nat)) lab ld kd) (erased (Nat) x l) (erased (Nth (Nat) lab x l) px) (erased (NotIn l ld) o) -> (ExtAt lab ld kd x (Zero))))

(def-adts $ (Extend : ((List (Nat)) lab ld kd xs cs) -> Type)
  enum
  (many ExNil : (erased (List (Nat)) lab ld kd) -> (Extend lab ld kd (Nil (Nat)) (Nil (Nat))))
  (many ExCons : (erased (List (Nat)) lab ld kd xs cs) (erased (Nat) x c) (erased (ExtAt lab ld kd x c) a) (erased (Extend lab ld kd xs cs) rest)
      -> (Extend lab ld kd (Cons (Nat) x xs) (Cons (Nat) c cs))))

(def-fns _ $ (erased extend-exists : (erased (List (Nat)) lab ld kd) (erased (Nat) d k) (erased (Length (Nat) lab d) ll) (erased (Length (Nat) ld k) lld)
    (erased (Length (Nat) kd k) lkd) (subterm erased (List (Nat)) xs) (erased (Under xs d) ux) -> (erased (List (Nat)) cs) (erased (Extend lab ld kd xs cs) ex))
  (let-match erased xs (Cons _ x xs1) ((Nil _) (values (Nil _) (ExNil lab ld kd))))
  (let-match erased ux (UnderCons _ _ _ lx ux1))
  (let ((erased cs1) (erased ex1)) (extend-exists lab ld kd d k ll lld lkd xs1 ux1))
  (let ((erased l) (erased pl)) (nth-exists _ lab d x ll lx))
  (let-match erased (in-dec l ld) (OrL _ _ il) ((OrR _ _ o) (values (Cons _ (Zero) cs1) (ExCons lab ld kd xs1 cs1 x (Zero) (EAOut lab ld kd x l pl o) ex1))))
  (let ((erased j) (erased pj)) (in-nth l ld il))
  (let ((erased c) (erased pc)) (nth-exists _ kd k j lkd (nth-lt-length _ ld j k l pj lld)))
  (values (Cons _ c cs1) (ExCons lab ld kd xs1 cs1 x c (EAIn lab ld kd x l j c pl pj pc) ex1)))

(def-fns _ $ (erased extend-nth : (erased (List (Nat)) lab ld kd cs) (erased (Nat) i x) (subterm erased (List (Nat)) xs) (erased (Extend lab ld kd xs cs) ex)
    (erased (Nth (Nat) xs i x) px) -> (erased (Nat) c) (erased (Nth (Nat) cs i c) pc) (erased (ExtAt lab ld kd x c) a))
  (let-match erased ex (ExCons _ _ _ xs1 cs1 y c a ex1) (absurd (ExNil _ _ _) px))
  (let-match erased px (NthThere _ _ _ j1 _ px1) ((NthHere _ _ _) (values c (NthHere _ c cs1) a)))
  (let ((erased c2) (erased pc) (erased a2)) (extend-nth lab ld kd cs1 j1 x xs1 ex1 px1))
  (values c2 (NthThere _ c cs1 j1 c2 pc) a2))

(def-fns _ $ (erased extend-under : (erased (List (Nat)) lab ld kd xs) (subterm erased (List (Nat)) cs) (erased (Extend lab ld kd xs cs) ex) (erased (Under kd 4) u)
    -> (erased (Under cs 4) r))
  (let-match erased cs (Cons _ c cs1) ((Nil _) (UnderNil 4)))
  (let-match erased ex (ExCons _ _ _ xs1 _ x _ a ex1))
  (unary 4)
  (UnderCons cs1 c 4 (match erased a (((Lt c 4) res)) ((EAIn _ _ _ _ l j _ px pj pc) (under-nth kd j c 4 u pc)) ((EAOut _ _ _ _ l px o) (LtZ _)))
    (extend-under lab ld kd xs1 cs1 ex1 u)))

(def-fns _ $ (erased extend-length : (erased (List (Nat)) lab ld kd xs cs) (erased (Nat) k) (subterm erased (Extend lab ld kd xs cs) ex) (erased (Length (Nat) xs k) l)
    -> (erased (Length (Nat) cs k) r))
  (let-match erased ex (ExCons _ _ _ xs1 cs1 x c a ex1) ((ExNil _ _ _) l))
  (let-match erased l (LengthCons _ _ _ k1 l1))
  (LengthCons _ c cs1 k1 (extend-length lab ld kd xs1 cs1 k1 ex1 l1)))

; A four-colouring kd of the disk map of a ring r extended to the whole map by faces (the colouring kr of rev_ring_cotrace, read on
; the whole map).
(def-adts $ (Ext : ((Nat) d dd) ((List (Nat)) e n f ed nd fd hd bd r kd ks) -> Type)
  enum
  (many MkExt : (erased (Nat) d dd dr x0) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br p kd ks lab ld ids)
      (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
      (erased (FaceLab d f lab) fl) (erased (Respects lab hd ld) rl) (erased (FourColoring ed fd kd) cd) (erased (Iota d ids) io) (erased (Extend lab ld kd ids ks) ex)
      -> (Ext d dd e n f ed nd fd hd bd (Cons (Nat) x0 p) kd ks)))

(def-fns _ $ (erased ext-exists : (erased (Nat) d dd dr x0) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br p kd)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (erased (FourColoring ed fd kd) cd) -> (erased (List (Nat)) ks) (erased (Ext d dd e n f ed nd fd hd bd (Cons (Nat) x0 p) kd ks) ext) (erased (Length (Nat) ks d) lks))
  (let ((erased h) (erased uhd)) (patch-whole d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased hdm) (erased lhd) (erased dhd)) (patch-disk d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased led) (erased lnd) (erased lfd)) (hyper-lengths dd ed nd fd hdm))
  (let ((erased lab) (erased fl)) (facelab-exists d f fi pmf))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ _ _ ids rs gf pf gr io ro cl ll))
  (let ((erased ld) (erased rl)) (respects-exists lab hd d uhd ll))
  (let-match erased cd (MkFourColoring _ _ _ ke rf re df u))
  (let ((erased lkd)) (respects-length kd fd kd dd rf lfd))
  (let ((erased ks) (erased ex)) (extend-exists lab ld kd d dd ll (respects-length lab hd ld dd rl lhd) lkd ids (perm-under d ids ids (perm-id d ids io))))
  (values ks (MkExt d dd dr x0 e n f ed nd fd er nr fr hd hr bd br p kd ks lab ld ids pt rg rb fl rl cd io ex)
    (extend-length lab ld kd ids ks d ex (iota-length d ids io))))

(def-fns _ $ (erased ext-at : (erased (List (Nat)) lab ld kd ids ks) (erased (Nat) d x c) (erased (Extend lab ld kd ids ks) ex) (erased (Iota d ids) io)
    (erased (Nth (Nat) ks x c) pc) -> (erased (ExtAt lab ld kd x c) a))
  (let ((erased c2) (erased pc2) (erased a)) (extend-nth lab ld kd ks x x ids ex (iota-nth d x ids io (nth-lt-length _ ks x d c pc
    (extend-length lab ld kd ids ks d ex (iota-length d ids io))))))
  (let-match erased (nth-fn _ ks x c c2 pc pc2) (Refl _ _))
  a)

; Two darts of the disk map with images on a face of lab l have one colour under kd.
(def-fns _ $ (erased ext-two : (erased (Nat) d dd dr x0 j j2 l c c2) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br p kd lab ld)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Ring e f x0 p) rg) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (erased (FaceLab d f lab) fl) (erased (Respects lab hd ld) rl) (erased (FourColoring ed fd kd) cd) (erased (Nth (Nat) ld j l) pj) (erased (Nth (Nat) ld j2 l) pj2)
    (erased (Nth (Nat) kd j c) pc) (erased (Nth (Nat) kd j2 c2) pc2) -> (erased (Eq (Nat) c c2) eq))
  (let ((erased hdm) (erased lhd) (erased dhd)) (patch-disk d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased lld)) (respects-length lab hd ld dd rl lhd))
  (let ((erased hj) (erased phj)) (nth-exists _ hd dd j lhd (nth-lt-length _ ld j dd l pj lld)))
  (let ((erased hj2) (erased phj2)) (nth-exists _ hd dd j2 lhd (nth-lt-length _ ld j2 dd l pj2 lld)))
  (let-match erased (snipd-face-inv d dd dr x0 j j2 hj hj2 e n f p ed nd fd er nr fr hd hr bd br pt rg rb phj phj2
    (facelab-same d hj hj2 l f lab fl (respects-nth lab hd ld j hj l rl phj pj) (respects-nth lab hd ld j2 hj2 l rl phj2 pj2))) (MkSomePath _ _ xs _ _ w))
  (let-match erased cd (MkFourColoring _ _ _ ke rf re df u))
  (nth-fn _ kd j2 c c2 (path-label fd kd (Nil _) xs j j2 c w rf pc) pc2))

; ks is kd on the images of the disk map ...
(def-fns _ $ (erased ext-hd : (erased (Nat) d dd zd z c) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (erased (Nth (Nat) hd zd z) pz) (erased (Nth (Nat) kd zd c) pc) -> (erased (Nth (Nat) ks z c) res))
  (let-match erased ext (MkExt _ _ dr x0 _ _ _ _ _ _ er nr fr _ hr _ br p _ _ lab ld ids pt rg rb fl rl cd io ex))
  (let ((erased h) (erased uhd)) (patch-whole d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased lz)) (under-nth hd zd z d uhd pz))
  (let ((erased c1) (erased pc1) (erased a)) (extend-nth lab ld kd ks z z ids ex (iota-nth d z ids io lz)))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ _ _ _ rs gf pf gr _ ro cl ll))
  (let ((erased l0) (erased pl0)) (nth-exists _ lab d z ll lz))
  (let ((erased ild)) (in-map lab hd ld z l0 (nth-in hd zd z pz) rl pl0))
  (match erased a (((Nth (Nat) ks z c) res))
    ((EAIn _ _ _ _ l j _ pl pj pcj)
      (let-match erased (nth-fn _ lab z l l0 pl pl0) (Refl _ _))
      (let-match erased (ext-two d dd dr x0 j zd l c1 c e n f ed nd fd er nr fr hd hr bd br p kd lab ld pt rg rb fl rl cd pj (respects-at lab hd ld zd z l rl pz pl) pcj pc)
        (Refl _ _))
      pc1)
    (absurd (EAOut _ _ _ _ l pl o) (let-match erased (nth-fn _ lab z l l0 pl pl0) (Refl _ _)) (apart-irrefl l (notin-in l l ld o ild)))))

; ... and is constant on faces.
(def-fns _ $ (erased ext-face : (erased (Nat) d dd x y c c2) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (erased (SomePath f (Nil (Nat)) x y) sp) (erased (Nth (Nat) ks x c) px) (erased (Nth (Nat) ks y c2) py) -> (erased (Eq (Nat) c c2) eq))
  (let-match erased ext (MkExt _ _ dr x0 _ _ _ _ _ _ er nr fr _ hr _ br p _ _ lab ld ids pt rg rb fl rl cd io ex))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ _ _ _ rs gf pf gr _ ro cl ll))
  (match erased (ext-at lab ld kd ids ks d x c ex io px) _
    ((EAIn _ _ _ _ l j _ pl pj pcj)
      (match erased (ext-at lab ld kd ids ks d y c2 ex io py) _
        ((EAIn _ _ _ _ l2 j2 _ pl2 pj2 pcj2)
          (let-match erased (nth-fn _ lab y l l2 (facelab-path d x y l f lab fl sp pl) pl2) (Refl _ _))
          (ext-two d dd dr x0 j j2 l c c2 e n f ed nd fd er nr fr hd hr bd br p kd lab ld pt rg rb fl rl cd pj pj2 pcj pcj2))
        (absurd (EAOut _ _ _ _ l2 pl2 o)
          (let-match erased (nth-fn _ lab y l l2 (facelab-path d x y l f lab fl sp pl) pl2) (Refl _ _))
          (apart-irrefl l (notin-in l l ld o (nth-in ld j l pj))))))
    ((EAOut _ _ _ _ l pl o)
      (match erased (ext-at lab ld kd ids ks d y c2 ex io py) _
        (absurd (EAIn _ _ _ _ l2 j2 _ pl2 pj2 pcj2)
          (let-match erased (nth-fn _ lab y l l2 (facelab-path d x y l f lab fl sp pl) pl2) (Refl _ _))
          (apart-irrefl l (notin-in l l ld o (nth-in ld j2 l pj2))))
        ((EAOut _ _ _ _ l2 pl2 o2) (Refl _ c))))))

(def-fns _ $ (erased ext-lt-f : (erased (Nat) d dd x y) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (erased (Nth (Nat) f x y) pxy) -> (erased (Lt y d) ly))
  (let-match erased ext (MkExt _ _ dr x0 _ _ _ _ _ _ er nr fr _ hr _ br p _ _ lab ld ids pt rg rb fl rl cd io ex))
  (let ((erased h) (erased uhd)) (patch-whole d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (perm-val d x y f fi pmf pxy))

(def-fns _ $ (erased ext-const : (erased (Nat) d dd) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks) (erased (List (Bond)) g) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (erased (Length (Nat) ks d) lks) (erased (Length (Nat) f d) lf) (subterm erased (Fun f g) fn) -> (erased (Const ks g) cl))
  (let-match erased fn (FunCons _ g1 x y pxy fn1) ((FunNil _) (ConstNil ks)))
  (let ((erased c) (erased pc)) (nth-exists _ ks d x lks (nth-lt-length _ f x d y pxy lf)))
  (let ((erased c2) (erased pc2)) (nth-exists _ ks d y lks (ext-lt-f d dd x y e n f ed nd fd hd bd r kd ks ext pxy)))
  (let-match erased (ext-face d dd x y c c2 e n f ed nd fd hd bd r kd ks ext (some-step f x y pxy) pc pc2) (Refl _ _))
  (ConstCons ks g1 x y c pc pc2 (ext-const d dd e n f ed nd fd hd bd r kd ks g1 ext lks lf fn1)))

(def-fns _ $ (erased ext-under : (erased (Nat) d dd) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    -> (erased (Under ks 4) u))
  (let-match erased ext (MkExt _ _ dr x0 _ _ _ _ _ _ er nr fr _ hr _ br p _ _ lab ld ids pt rg rb fl rl cd io ex))
  (let-match erased cd (MkFourColoring _ _ _ ke rf re df u))
  (extend-under lab ld kd ids ks ex u))

; ks tells apart a dart of the image of the disk map and its edge image.
(def-fns _ $ (erased ext-edge : (erased (Nat) d dd zd z ez c c2) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (erased (Nth (Nat) hd zd z) pz) (erased (Nth (Nat) e z ez) pe) (erased (Nth (Nat) ks z c) pc) (erased (Nth (Nat) ks ez c2) pc2) -> (erased (Apart (Nat) Lt c c2) ne))
  (let ((erased ext2)) ext)
  (let-match erased ext2 (MkExt _ _ dr x0 _ _ _ _ _ _ er nr fr _ hr _ br p _ _ lab ld ids pt rg rb fl rl cd io ex))
  (let ((erased pt2)) pt)
  (let-match erased pt2
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids1 idd idr bG bGr h hdm hrm io1 iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hdm))
  (let ((erased led) (erased lnd) (erased lfd)) (hyper-lengths dd ed nd fd hdm))
  (let ((erased lzd)) (nth-lt-length _ hd zd dd z pz lhd))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth dd zd ed nfd pmed lzd))
  (let ((erased hu) (erased phu) (erased spu)) (match erased (in-dec zd bd) (((Nat) hu) ((Nth (Nat) hd u hu) phu) ((SomePath f (Nil (Nat)) ez hu) spu))
    ((OrR _ _ o)
      (let ((erased w) (erased hw) (erased pw)) (morph hd ed e bd idd dd zd u z med iod lzd o pu pz))
      (let-match erased (nth-fn _ e z ez w pe pw) (Refl _ _))
      (values ez hw (MkSomePath f (Nil _) (Nil _) ez ez (PathHere f (Nil _) ez))))
    ((OrL _ _ izd)
      (let ((erased hw) (erased ehw) (erased hu) (erased phw) (erased pe2) (erased phu) (erased sp)) (ncyc-link x0 zd u e f p ed hd bd rg cyd rb izd pu))
      (let-match erased (nth-fn _ hd zd z hw pz phw) (Refl _ _))
      (let-match erased (nth-fn _ e z ez ehw pe pe2) (Refl _ _))
      (values hu phu sp))))
  (let-match erased cd (MkFourColoring _ _ _ ke rf re df uk))
  (let ((erased lkd)) (respects-length kd fd kd dd rf lfd))
  (let ((erased a) (erased pa)) (nth-exists _ kd dd zd lkd lzd))
  (let ((erased b) (erased pb)) (nth-exists _ kd dd u lkd lu))
  (let-match erased (nth-fn _ ks z c a pc (ext-hd d dd zd z a e n f ed nd fd hd bd _ kd ks ext pz pa)) (Refl _ _))
  (let ((erased lks)) (extend-length lab ld kd ids ks d ex (iota-length d ids io)))
  (let ((erased c3) (erased pc3)) (nth-exists _ ks d hu lks (under-nth hd u hu d uhd phu)))
  (let-match erased (nth-fn _ ks hu c3 b pc3 (ext-hd d dd u hu b e n f ed nd fd hd bd _ kd ks ext phu pb)) (Refl _ _))
  (let-match erased (ext-face d dd ez hu c2 b e n f ed nd fd hd bd _ kd ks ext spu pc2 pc3) (Refl _ _))
  (apart-sym b c (four-edge ed fd kd zd u c b cd pu pa pb)))

; Each e a of A is on the face of the dart of B at its position.
(def-adts $ (Links : ((List (Nat)) e f A B) -> Type)
  enum
  (many LkNil : (erased (List (Nat)) e f) -> (Links e f (Nil (Nat)) (Nil (Nat))))
  (many LkCons : (erased (List (Nat)) e f A B) (erased (Nat) a b ea) (erased (Nth (Nat) e a ea) pe) (erased (SomePath f (Nil (Nat)) ea b) sp) (erased (Links e f A B) rest)
      -> (Links e f (Cons (Nat) a A) (Cons (Nat) b B))))

(def-fns _ $ (erased rpath-links : (erased (List (Nat)) e f PP) (erased (Nat) x y ey c) (subterm erased (List (Nat)) P) (erased (RPath e f x P y) rp)
    (erased (Nth (Nat) e y ey) pe) (erased (SomePath f (Nil (Nat)) ey c) sp) (erased (HSnoc (Nat) P c PP) sn) -> (erased (Links e f (Cons (Nat) x P) PP) r))
  (let-match erased rp (RPCons _ _ P1 _ ex z _ px w rp1)
    ((RPNil _ _ _) (let-match erased sn (SnocNil _ _)) (LkCons e f (Nil _) (Nil _) x c ey pe sp (LkNil e f))))
  (let-match erased sn (SnocCons _ _ _ _ PP1 sn1))
  (LkCons e f P PP1 x z ex px w (rpath-links e f PP1 z y ey c P1 rp1 pe sp sn1)))

(def-fns _ $ (erased ring-links : (erased (List (Nat)) e f p rr) (erased (Nat) x0) (erased (Ring e f x0 p) rg) (erased (HSnoc (Nat) p x0 rr) sn)
    -> (erased (Links e f (Cons (Nat) x0 p) rr) r))
  (let-match erased rg (MkRing _ _ _ _ y ey rp pe w sm))
  (rpath-links e f rr x0 y ey x0 p rp pe w sn))

; ks colours each e a as the dart of B linked to it.
(def-fns _ $ (erased ext-links : (erased (Nat) d dd) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks B EA L M) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (subterm erased (List (Nat)) A) (erased (Links e f A B) lk) (erased (Respects e A EA) re) (erased (Respects ks EA L) rl) (erased (Respects ks B M) rm)
    -> (erased (Eq (List (Nat)) L M) eq))
  (let-match erased lk (LkCons _ _ A1 Bt a b ea pe sp lk1) ((LkNil _ _) (let-match erased re (RespNil _)) (let-match erased rl (RespNil _))
    (let-match erased rm (RespNil _)) (Refl _ L)))
  (let-match erased re (RespCons _ _ EA1 _ ea2 pe2 re1))
  (let-match erased (nth-fn _ e a ea ea2 pe pe2) (Refl _ _))
  (let-match erased rl (RespCons _ _ L1 _ l pl rl1))
  (let-match erased rm (RespCons _ _ M1 _ m pm rm1))
  (let-match erased (ext-face d dd ea b l m e n f ed nd fd hd bd r kd ks ext sp pl pm) (Refl _ _))
  (let-match erased (ext-links d dd e n f ed nd fd hd bd r kd ks Bt EA1 L1 M1 ext A1 lk1 re1 rl1 rm1) (Refl _ _))
  (Refl _ L))

; ks colours r as kd colours bd.
(def-fns _ $ (erased ext-ring : (erased (Nat) d dd) (erased (List (Nat)) e n f ed nd fd hd bd r kd ks R lc) (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext)
    (subterm erased (List (Nat)) B) (erased (Respects hd B R) rb) (erased (Respects kd B lc) rk) -> (erased (Respects ks R lc) res))
  (let-match erased rb (RespCons _ Bt R1 b z pz rb1) ((RespNil _) (let-match erased rk (RespNil _)) (RespNil ks)))
  (let-match erased rk (RespCons _ _ lc1 _ c pc rk1))
  (RespCons ks R1 lc1 z c (ext-hd d dd b z c e n f ed nd fd hd bd r kd ks ext pz pc) (ext-ring d dd e n f ed nd fd hd bd r kd ks R1 lc1 ext Bt rb1 rk1)))

(def-fns _ $ (erased revapp-flip : (erased Type A) (erased (List A) pre w r t) (subterm erased (RevApp A pre w r) a) (erased (RevApp A w pre t) b)
    -> (erased (RevApp A r (Nil A) t) res))
  (let-match erased a (RACons _ s pre1 _ _ a1) ((RANil _ _) b))
  (revapp-flip A pre1 (Cons A s w) r t a1 (RACons A s w pre1 t b)))

(def-fns _ $ (erased tracefrom-shift : (erased (Col) c0 c c1) (erased (List (Col)) lc et) (subterm erased (TraceFrom c0 c lc et) t)
    -> (erased (Col) s) (erased (AddK c0 c1 s) a) (erased (List (Col)) lc2 et2) (erased (HSnoc (Col) lc c0 lc2) sl) (erased (HSnoc (Col) et s et2) se)
    (erased (TraceFrom c1 c lc2 et2) r))
  (let ((erased s) (erased a)) (addc-total c0 c1))
  (let-match erased t (TFCons _ _ c2 s0 lc1 et1 a0 t1)
    ((TFEnd _ _ s0 a0)
      (values s a (Cons _ c0 (Nil _)) (Cons _ s0 (Cons _ s (Nil _))) (SnocNil _ c0) (SnocCons _ s0 s (Nil _) (Cons _ s (Nil _)) (SnocNil _ s))
        (TFCons c1 c c0 s0 (Nil _) (Cons _ s (Nil _)) a0 (TFEnd c1 c0 s a)))))
  (let ((erased s1) (erased a1) (erased lc3) (erased et3) (erased sl1) (erased se1) (erased r1)) (tracefrom-shift c0 c2 c1 lc1 et1 t1))
  (let-match erased (addc-fn c0 c1 s s1 a a1) (Refl _ _))
  (values s a (Cons _ c2 lc3) (Cons _ s0 et3) (SnocCons _ c2 c0 lc1 lc3 sl1) (SnocCons _ s0 s et1 et3 se1) (TFCons c1 c c2 s0 lc3 et3 a0 r1)))

; trace_rot: rotating the colours by one rotates the trace by one.
(def-fns _ $ (erased trace-rot : (erased (Col) c) (erased (List (Col)) lc lc2 et) (erased (Trace (Cons (Col) c lc) et) t) (erased (HSnoc (Col) lc c lc2) sn)
    -> (erased (Col) s) (erased (List (Col)) E et2) (erased (Eq (List (Col)) et (Cons (Col) s E)) eq) (erased (HSnoc (Col) E s et2) se) (erased (Trace lc2 et2) r))
  (let-match erased t (TrCons _ _ _ tf))
  (let-match erased tf (TFCons _ _ l1 s rest et1 a t1)
    ((TFEnd _ _ s a) (let-match erased sn (SnocNil _ _)) (values s (Nil _) (Cons _ s (Nil _)) (Refl _ et) (SnocNil _ s) t)))
  (let ((erased s1) (erased a1) (erased lc3) (erased et3) (erased sl) (erased se) (erased r1)) (tracefrom-shift c l1 l1 rest et1 t1))
  (let-match erased (addc-fn c l1 s s1 a a1) (Refl _ _))
  (let-match erased sn (SnocCons _ _ _ _ lc4 sn1))
  (let-match erased (hsnoc-fn _ rest lc3 lc4 c sl sn1) (Refl _ _))
  (values s et1 et3 (Refl _ et) se (TrCons l1 lc3 et3 r1)))

; The extension ks of a colouring of the disk map of r, with the remainder map of RR = rev (map e r) on hr2, RV2 = rev RR
; followed by the darts zs2 off diskN RR.
(def-adts $ (CoCtx : ((Nat) d dd) ((List (Nat)) e n f ed nd fd hd bd kd ks hr2) -> Type)
  enum
  (many MkCoCtx : (erased (Nat) d dd) (erased (List (Nat)) e n f ed nd fd hd bd r RR hdA hdB kd ks zs hd2 zs2 RV2 hr2)
      (erased (Ext d dd e n f ed nd fd hd bd r kd ks) ext) (erased (RevCtx d e n f r RR hdA hdB) cx) (erased (Connected d e n f) cn)
      (erased (DiskSplit d e n r hd zs) ds1) (erased (DiskSplit d e n RR hd2 zs2) ds2) (erased (RevApp (Nat) RR (Nil (Nat)) RV2) rv2) (erased (AppN RV2 zs2 hr2) ap2)
      -> (CoCtx d dd e n f ed nd fd hd bd kd ks hr2)))

; ks tells apart each dart of hr2 and its edge image.
(def-fns _ $ (erased rr-apart : (erased (Nat) d dd x ex c c2) (erased (List (Nat)) e n f ed nd fd hd bd kd ks hr2) (erased (CoCtx d dd e n f ed nd fd hd bd kd ks hr2) co)
    (erased (In x hr2) ix) (erased (Nth (Nat) e x ex) pe) (erased (Nth (Nat) ks x c) pc) (erased (Nth (Nat) ks ex c2) pc2) -> (erased (Apart (Nat) Lt c c2) ne))
  (let-match erased co (MkCoCtx _ _ _ _ _ _ _ _ _ _ r RR hdA hdB _ _ zs hd2 zs2 RV2 _ ext cx cn ds1 ds2 rv2 ap2))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er hdc zsc hd2c zs2c h gen pl rg pr ur dsc rm ra rg2 pr2 ur2 dsc2))
  (let ((erased ext2)) ext)
  (let-match erased ext2 (MkExt _ _ dr x0e _ _ _ _ _ _ er1 nr1 fr1 _ hr1 _ br1 p1 _ _ lab ld ids pt rg1 rb fl rl cd io exd))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (match erased (app-out zs2 hr2 x RV2 ap2 ix) _
    ((OrR _ _ ixz)
      (let ((erased lx)) (ds-lt d x e n RR hd2 zs2 ds2 (OrR _ _ ixz)))
      (let ((erased iz)) (match erased (rev-disk d x e n f r RR hdA hdB cx cn lx) (((In x hd) res))
        ((TwoR _ _ _ _ _ _ _ dn _) (ds-mem d x x0 e n f p hd zs h gen rg ur ds1 dn lx))
        (absurd (TwoRR _ _ _ _ _ _ _ dn _) (ds-out d x y0 e n f Q hd2 zs2 h gen rg2 ur2 ds2 ixz dn))))
      (let ((erased zd) (erased pz)) (in-nth x hd iz))
      (ext-edge d dd zd x ex c c2 e n f ed nd fd hd bd r kd ks ext pz pe pc pc2))
    ((OrL _ _ ixr)
      (let ((erased ixR)) (match erased (revapp-out RR (Nil _) RV2 x rv2 ixr) (((In x RR) res)) ((OrL _ _ i) i) (absurd (OrR _ _ i) (match erased i _))))
      (let ((erased ex2) (erased pe2) (erased iex)) (rev-ring-in d x e r er RR pl le rm ra ixR))
      (let-match erased (nth-fn _ e x ex ex2 pe pe2) (Refl _ _))
      (let ((erased j) (erased ij) (erased pj)) (respects-in hd bd r ex rb iex))
      (let ((erased pex) (erased nex)) (plain-eq d x ex e pl (nth-lt-length _ e x d ex pe le) pe))
      (apart-sym c2 c (ext-edge d dd j ex x c2 c e n f ed nd fd hd bd r kd ks ext pj pex pc2 pc)))))

(def-fns _ $ (erased color-proper-rr : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd hd bd kd ks hr er nfr idr kr) (erased (List (Bond)) g0)
    (erased (CoCtx d dd e n f ed nd fd hd bd kd ks hr) co) (erased (HPerm dr er nfr) pmer) (erased (MorphOff hr er e (Nil (Nat)) idr) mer) (erased (Iota dr idr) ior)
    (erased (Length (Nat) ks d) lks) (erased (Length (Nat) hr dr) lhr) (erased (Under hr d) uhr) (erased (Respects ks hr kr) rkr) (subterm erased (Fun er g0) fn)
    -> (erased (KProper kr g0) r))
  (let-match erased fn (FunCons _ g1 u v pe1 fn1) ((FunNil _) (ProperNil kr)))
  (let ((erased lu)) (pre-lt dr u v er nfr pmer pe1))
  (let ((erased x) (erased hx)) (nth-exists _ hr dr u lhr lu))
  (let ((erased y) (erased hy) (erased qy)) (morph hr er e (Nil _) idr dr u v x mer ior lu (NotInNil u) pe1 hx))
  (let ((erased l1) (erased p1)) (nth-exists _ ks d x lks (under-nth hr u x d uhr hx)))
  (let ((erased l2) (erased p2)) (nth-exists _ ks d y lks (under-nth hr v y d uhr hy)))
  (ProperCons kr g1 u v l1 l2 (respects-at ks hr kr u x l1 rkr hx p1) (respects-at ks hr kr v y l2 rkr hy p2)
    (rr-apart d dd x y l1 l2 e n f ed nd fd hd bd kd ks hr co (nth-in hr u x hx) qy p1 p2)
    (color-proper-rr d dd dr e n f ed nd fd hd bd kd ks hr er nfr idr kr g1 co pmer mer ior lks lhr uhr rkr fn1)))

; rev_ring_cotrace, from the disk map of r to the remainder map of RR: a ring trace et of bd gives the ring trace rot 1 et of br2.
(def-fns _ $ (erased cotrace : (erased (Nat) d dd dr dd2 dr2) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2)
    (erased (List (Col)) et) (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects hd bd r) rb) (erased (DiskSplit d e n r hd zs) ds1)
    (erased (RevCtx d e n f r RR hdA hdB) cx) (erased (Connected d e n f) cn) (erased (Patch d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2) pt2)
    (erased (RevApp (Nat) RR (Nil (Nat)) RV2) rv2) (erased (Respects hr2 br2 RV2) rbr2) (erased (DiskSplit d e n RR hd2 zs2) ds2) (erased (AppN RV2 zs2 hr2) ap2)
    (erased (RingTrace ed fd bd et) td)
    -> (erased (Col) s) (erased (List (Col)) E et2) (erased (Eq (List (Col)) et (Cons (Col) s E)) eq) (erased (HSnoc (Col) E s et2) se)
    (erased (RingTrace er2 fr2 br2 et2) tr))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er0 hdc zsc hd2c zs2c h gen pl rg pr ur dsc rm ra rg2 pr2 ur2 dsc2))
  (let-match erased td (MkRingTrace _ _ _ kd lc cs _ cd rl co t))
  (let ((erased ks) (erased ext) (erased lks)) (ext-exists d dd dr x0 e n f ed nd fd er nr fr hd hr bd br p kd pt rg rb cd))
  (let ((erased cco)) (MkCoCtx d dd e n f ed nd fd hd bd r RR hdA hdB kd ks zs hd2 zs2 RV2 hr2 ext cx cn ds1 ds2 rv2 ap2))
  (let ((erased pt3)) pt2)
  (let-match erased pt3
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h2 hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased nfr) (erased nri) (erased fri) (erased rnfr) (erased pmer) (erased pmnr) (erased pmfr)) (hyper-core dr2 er2 nr2 fr2 hrm))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased gf) (erased grf)) (perm-graph d f fi pmf))
  (let ((erased ger) (erased grer)) (perm-graph dr2 er2 nfr pmer))
  (let ((erased gfr) (erased grfr)) (perm-graph dr2 fr2 fri pmfr))
  (let ((erased kr) (erased rkr)) (respects-exists ks hr2 d uhr lks))
  (let ((erased lkr)) (respects-length ks hr2 kr dr2 rkr lhr))
  (let ((erased ckr)) (proper-coloring dr2 er2 fr2 kr idr ger
    (color-proper-rr d dd dr2 e n f ed nd fd hd bd kd ks hr2 er2 nfr idr kr ger cco pmer mer ior lks lhr uhr rkr (graph-fun dr2 er2 ger grer))
    grer ior
    (const-respects kr idr fr2 kr gfr (graph-zip dr2 fr2 idr gfr grfr ior)
      (color-const-r d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 fi fri ks kr gf gfr pt2 pmf pmfr grf
        (ext-const d dd e n f ed nd fd hd bd r kd ks gf ext lks lf (graph-fun d f gf grf)) lks lhr uhr rkr (graph-fun dr2 fr2 gfr grfr))
      (respects-id-right dr2 idr kr ior lkr))
    (respects-under-vals ks hr2 kr 4 rkr (ext-under d dd e n f ed nd fd hd bd r kd ks ext)) lkr (perm-under dr2 er2 nfr pmer)))
  (let ((erased lcr)) (ext-ring d dd e n f ed nd fd hd bd r kd ks r lc ext bd rb rl))
  (let-match erased lcr (RespCons _ _ lc1 _ l0 pl0 lcr1))
  (let-match erased co (All2Cons _ _ _ _ c0 _ cs1 pc0 co1))
  (let ((erased rr) (erased sn)) (snoc-exists _ p x0))
  (let ((erased M) (erased snm)) (snoc-exists _ lc1 l0))
  (let ((erased rM)) (respects-snoc ks p rr lc1 M x0 l0 lcr1 pl0 sn snm))
  (let ((erased L) (erased rL)) (respects-exists ks er0 d (respects-under-vals e r er0 d rm (perm-under d e nf pme)) lks))
  (let-match erased (ext-links d dd e n f ed nd fd hd bd r kd ks rr er0 L M ext r (ring-links e f p rr x0 rg sn) rm rL rM) (Refl _ _))
  (let-match erased (revapp-fn _ RR (Nil _) RV2 er0 rv2 (revapp-flip _ er0 (Nil _) RR er0 ra (RANil _ er0))) (Refl _ _))
  (let ((erased cs2) (erased sc) (erased co2)) (cols-snoc lc1 L cs1 l0 c0 co1 snm pc0))
  (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased t2)) (trace-rot c0 cs1 cs2 et t sc))
  (values s E et2 eq se
    (MkRingTrace er2 fr2 br2 kr L cs2 et2 ckr (respects-assoc br2 hr2 ks RV2 kr L dr2 rbr2 rL rkr lkr lhr) co2 t2)))

; colorable_from_ring: a ring trace et of the disk map of r whose reverse is a ring trace of the disk map of RR gives a four-colouring.
(def-fns _ $ (erased colorable-from-ring : (erased (Nat) d dd dr dd2 dr2)
    (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2)
    (erased (List (Col)) et ev) (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects hd bd r) rb) (erased (DiskSplit d e n r hd zs) ds1)
    (erased (RevCtx d e n f r RR hdA hdB) cx) (erased (Connected d e n f) cn) (erased (Patch d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2) pt2)
    (erased (RevApp (Nat) RR (Nil (Nat)) RV2) rv2) (erased (Respects hr2 br2 RV2) rbr2) (erased (DiskSplit d e n RR hd2 zs2) ds2) (erased (AppN RV2 zs2 hr2) ap2)
    (erased (RingTrace ed fd bd et) td) (erased (RevApp (Col) et (Nil (Col)) ev) re) (erased (RingTrace ed2 fd2 bd2 ev) td2)
    -> (erased (List (Nat)) ks) (erased (FourColoring e f ks) c))
  (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased tr))
    (cotrace d dd dr dd2 dr2 e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2 et pt rb ds1 cx cn pt2 rv2 rbr2 ds2 ap2 td))
  (let-match erased eq (Refl _ _))
  (patch-colorable d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 ev et2 pt2 td2
    (RRCons ev E et2 s (revapp-flip (Col) et (Nil _) ev et re (RANil (Col) et)) se) tr))
