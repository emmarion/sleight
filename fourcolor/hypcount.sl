; Counting darts by orbits: when every orbit of p has c darts and there are k orbits, there are k * c darts. The darts
; are listed orbit by orbit, from the roots of the orbit classes, and that list is compared with 0..d-1.

; zs is xs followed by ys.
(def-adts $ (AppN : ((List (Nat)) xs ys zs) -> Type)
  enum
  (many AppNil : (erased (List (Nat)) ys) -> (AppN (Nil (Nat)) ys ys))
  (many AppCons : (erased (List (Nat)) xs ys zs) (erased (Nat) x) (erased (AppN xs ys zs) rest) -> (AppN (Cons (Nat) x xs) ys (Cons (Nat) x zs))))

(def-fns _ $ (erased app-exists : (subterm erased (List (Nat)) xs) (erased (List (Nat)) ys) -> (erased (List (Nat)) zs) (erased (AppN xs ys zs) r))
  (let-match erased xs (Cons _ x xs1) ((Nil _) (values ys (AppNil ys))))
  (let ((erased zs1) (erased r1)) (app-exists xs1 ys))
  (values (Cons _ x zs1) (AppCons xs1 ys zs1 x r1)))

(def-fns _ $ (erased add-ex : (subterm erased (Nat) a) (erased (Nat) b) -> (erased (Nat) c) (erased (Add a b c) p))
  (let-match erased a (Succ a1) ((Zero) (values b (AddZero b))))
  (let ((erased c1) (erased p1)) (add-ex a1 b))
  (values (Succ c1) (AddSucc a1 b c1 p1)))

(def-fns _ $ (erased app-length : (erased (List (Nat)) xs ys zs) (erased (Nat) a b c) (subterm erased (AppN xs ys zs) ap) (erased (Length (Nat) xs a) la)
    (erased (Length (Nat) ys b) lb) (erased (Add a b c) p) -> (erased (Length (Nat) zs c) r))
  (let-match erased ap (AppCons xs1 _ zs1 x ap1) ((AppNil _) (let-match erased la (LengthNil _)) (let-match erased p (AddZero _)) lb))
  (let-match erased la (LengthCons _ _ _ a1 la1))
  (let-match erased p (AddSucc _ _ c1 p1))
  (LengthCons _ x zs1 c1 (app-length xs1 ys zs1 a1 b c1 ap1 la1 lb p1)))

(def-fns _ $ (erased app-in-l : (erased (List (Nat)) xs ys zs) (erased (Nat) x) (subterm erased (AppN xs ys zs) ap) (erased (In x xs) ix)
    -> (erased (In x zs) r))
  (let-match erased ap (AppCons xs1 _ zs1 y ap1) (absurd (AppNil _) ix))
  (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) (InHere x zs1)))
  (InThere x y zs1 (app-in-l xs1 ys zs1 x ap1 ix1)))

(def-fns _ $ (erased app-in-r : (erased (List (Nat)) xs ys zs) (erased (Nat) x) (subterm erased (AppN xs ys zs) ap) (erased (In x ys) ix)
    -> (erased (In x zs) r))
  (let-match erased ap (AppCons xs1 _ zs1 y ap1) ((AppNil _) ix))
  (InThere x y zs1 (app-in-r xs1 ys zs1 x ap1 ix)))

(def-fns _ $ (erased app-in-inv : (erased (List (Nat)) xs ys zs) (erased (Nat) x) (subterm erased (AppN xs ys zs) ap) (erased (In x zs) ix)
    -> (erased (Or (In x xs) (In x ys)) r))
  (let-match erased ap (AppCons xs1 _ zs1 y ap1) ((AppNil _) (OrR _ _ ix)))
  (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) (OrL _ _ (InHere x xs1))))
  (match erased (app-in-inv xs1 ys zs1 x ap1 ix1) _
    ((OrL _ _ i) (OrL _ _ (InThere x y xs1 i)))
    ((OrR _ _ i) (OrR _ _ i))))

(def-fns _ $ (erased notin-app : (erased (List (Nat)) xs ys zs) (erased (Nat) x) (subterm erased (AppN xs ys zs) ap) (erased (NotIn x xs) ox)
    (erased (NotIn x ys) oy) -> (erased (NotIn x zs) r))
  (let-match erased ap (AppCons xs1 _ zs1 y ap1) ((AppNil _) oy))
  (let-match erased ox (NotInCons _ _ _ ne ox1))
  (NotInCons x y zs1 ne (notin-app xs1 ys zs1 x ap1 ox1 oy)))

(def-fns _ $ (erased app-distinct : (erased (List (Nat)) xs ys zs) (subterm erased (AppN xs ys zs) ap) (erased (Distinct xs) dx)
    (erased (Distinct ys) dy) (erased (Disj xs ys) dj) -> (erased (Distinct zs) r))
  (let-match erased ap (AppCons xs1 _ zs1 x ap1) ((AppNil _) dy))
  (let-match erased dx (DistCons _ _ ox dx1))
  (let-match erased dj (DisjCons _ _ _ oy dj1))
  (DistCons x zs1 (notin-app xs1 ys zs1 x ap1 ox oy) (app-distinct xs1 ys zs1 ap1 dx1 dy dj1)))

; Two walks from x to y that never leave y are the same.
(def-fns _ $ (erased walk-uniq : (erased (List (Nat)) p s s2 xs ys) (erased (Nat) x y) (subterm erased (Path p (Cons (Nat) y s) x y xs) w)
    (erased (Path p (Cons (Nat) y s2) x y ys) v) -> (erased (Eq (List (Nat)) xs ys) e))
  (match erased w _
    ((PathHere _ _ _)
      (let-match erased v (PathHere _ _ _) (absurd (PathStep _ _ _ _ _ _ _ out _) (apart-irrefl x (notin-in x x _ out (InHere x s2)))))
      (Refl _ xs))
    ((PathStep _ _ xs1 _ x1 _ px out w1)
      (let-match erased v (PathStep _ _ ys1 _ x2 _ px2 _ v1) (absurd (PathHere _ _ _) (apart-irrefl x (notin-in x x _ out (InHere x s)))))
      (let-match erased (nth-fn _ p x x1 x2 px px2) (Refl _ _))
      (let-match erased (walk-uniq p s s2 xs1 ys1 x1 y w1 v1) (Refl _ _))
      (Refl _ xs))))

(def-fns _ $ (erased path-suffix : (erased (List (Nat)) p s xs) (erased (Nat) x y u j) (subterm erased (Path p s x y xs) w) (erased (In u xs) pu)
    (erased (Length (Nat) xs j) l) -> (erased (List (Nat)) zs) (erased (Nat) j2) (erased (Path p s u y zs) r) (erased (Length (Nat) zs j2) l2)
    (erased (Lt j2 (Succ j)) lt))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ _ _ w1) (absurd (PathHere _ _ _) pu))
  (let-match erased l (LengthCons _ _ _ j1 l1))
  (let-match erased (nat-eq u x) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values xs j w l (lt-succ j))))
  (let ((erased zs) (erased j2) (erased r) (erased l2) (erased lt)) (path-suffix p s xs1 x1 y u j1 w1 (in-tail u x xs1 pu ne) l1))
  (values zs j2 r l2 (lt-weaken j2 (Succ j1) lt)))

; A walk that never leaves its end visits no dart twice.
(def-fns _ $ (erased walk-distinct : (erased (List (Nat)) p s xs) (erased (Nat) x y) (subterm erased (Path p (Cons (Nat) y s) x y xs) w)
    -> (erased (Distinct xs) r))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ _ _ w1) ((PathHere _ _ _) (DistNil)))
  (let-match erased (in-dec x xs1) (OrR _ _ ox)
    (absurd (OrL _ _ ix)
      (let ((erased j) (erased lj)) (length-exists _ xs1))
      (let ((erased zs) (erased j2) (erased wz) (erased lz) (erased lt)) (path-suffix p _ xs1 x1 y x j w1 ix lj))
      (let-match erased (walk-uniq p s s zs xs x y wz w) (Refl _ _))
      (let-match erased (length-fn _ _ j2 (Succ j) lz (LengthCons _ x xs1 j lj)) (Refl _ _))
      (lt-irrefl (Succ j) lt)))
  (DistCons x xs1 ox (walk-distinct p s xs1 x1 y w1)))

(def-fns _ $ (erased iota-distinct : (erased (Nat) d) (erased (List (Nat)) ids) (subterm erased (Iota d ids) io) -> (erased (Distinct ids) r))
  (let-match erased io (IotaS n ids0 _ io0 sn) ((IotaZ) (DistNil)))
  (let-match erased (in-dec n ids0) (OrR _ _ out)
    (absurd (OrL _ _ ix)
      (let ((erased j) (erased pj)) (in-nth n ids0 ix))
      (let-match erased (iota-at n j n ids0 io0 pj) (Refl _ _))
      (lt-irrefl j (nth-lt-length _ ids0 j n j pj (iota-length n ids0 io0)))))
  (distinct-snoc-cons n ids0 ids sn (DistCons n ids0 out (iota-distinct n ids0 io0))))

(def-fns _ $ (erased le-antisym : (subterm erased (Nat) a) (erased (Nat) b) (erased (Lt a (Succ b)) p) (erased (Lt b (Succ a)) q) -> (erased (Eq (Nat) a b) e))
  (let-match erased a (Succ a1) ((Zero) (let-match erased (lt-one b q) (Refl _ _)) (Refl _ (Zero))))
  (let-match erased p (LtS _ _ p1))
  (let-match erased b (Succ b1) (absurd (Zero) p1))
  (let-match erased (le-antisym a1 b1 p1 (lt-pred b1 (Succ a1) q)) (Refl _ _))
  (Refl _ a))

; ls lists, root by root, the darts of the cycle of p through each root in rs.
(def-adts $ (OrbCat : ((List (Nat)) p rs ls) -> Type)
  enum
  (many OCNil : (erased (List (Nat)) p) -> (OrbCat p (Nil (Nat)) (Nil (Nat))))
  (many OCCons : (erased (List (Nat)) p rs xs ls ls2) (erased (Nat) r y) (erased (Nth (Nat) p r y) py)
      (erased (Path p (Cons (Nat) r (Nil (Nat))) y r xs) w) (erased (AppN (Cons (Nat) r xs) ls ls2) ap) (erased (OrbCat p rs ls) rest)
      -> (OrbCat p (Cons (Nat) r rs) ls2)))

; ns sums to s.
(def-adts $ (NSum : ((List (Nat)) ns) ((Nat) s) -> Type)
  enum
  (many NSNil : -> (NSum (Nil (Nat)) (Zero)))
  (many NSCons : (erased (Nat) c s s2) (erased (List (Nat)) ns) (erased (NSum ns s) p) (erased (Add c s s2) a) -> (NSum (Cons (Nat) c ns) s2)))

(def-fns _ $ (erased nsum-fn : (erased (List (Nat)) ns) (erased (Nat) a b) (subterm erased (NSum ns a) p) (erased (NSum ns b) q) -> (erased (Eq (Nat) a b) e))
  (let-match erased p (NSCons c s1 _ ns1 p1 a1) ((NSNil) (let-match erased q (NSNil)) (Refl _ a)))
  (let-match erased q (NSCons _ s2 _ _ q1 a2))
  (let-match erased (nsum-fn ns1 s1 s2 p1 q1) (Refl _ _))
  (add-fn c s1 a b a1 a2))

; The cycles through the darts rs, whose orders are os, laid end to end.
(def-fns _ $ (erased orbcat-sum : (erased (List (Nat)) p rs os) (subterm erased (Orders p rs os) ob)
    -> (erased (List (Nat)) ls) (erased (Nat) len) (erased (OrbCat p rs ls) oc) (erased (Length (Nat) ls len) l) (erased (NSum os len) sm))
  (let-match erased ob (OrdCons _ rs1 os1 r c o ob1) ((OrdNil _) (values (Nil _) (Zero) (OCNil p) (LengthNil _) (NSNil))))
  (let-match erased o (MkOrder _ xs _ y c1 py w lxs))
  (let ((erased ls1) (erased len1) (erased oc1) (erased l1) (erased m1)) (orbcat-sum p rs1 os1 ob1))
  (let ((erased ls2) (erased ap)) (app-exists (Cons _ r xs) ls1))
  (let ((erased len2) (erased a2)) (add-ex c len1))
  (values ls2 len2 (OCCons p rs1 xs ls1 ls2 r y py w ap oc1) (app-length (Cons _ r xs) ls1 ls2 c len1 len2 ap (LengthCons _ r xs c1 lxs) l1 a2)
    (NSCons c len1 len2 os1 m1 a2)))

(def-fns _ $ (erased orders-all : (erased (Nat) d c k) (erased (List (Nat)) p rs) (erased (AllOrder d p c) ao) (subterm erased (Under rs d) u)
    (erased (Length (Nat) rs k) lk) -> (erased (List (Nat)) os) (erased (Nat) s) (erased (Orders p rs os) ob) (erased (NSum os s) sm) (erased (Mul k c s) m))
  (let-match erased u (UnderCons rs1 r _ lr u1)
    ((UnderNil _) (let-match erased lk (LengthNil _)) (values (Nil _) (Zero) (OrdNil p) (NSNil) (MulZero c))))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let ((erased os1) (erased s1) (erased ob1) (erased sm1) (erased m1)) (orders-all d c k1 p rs1 ao u1 lk1))
  (let ((erased s2) (erased a2)) (add-ex c s1))
  (values (Cons _ c os1) s2 (OrdCons p rs1 os1 r c (all-order d c r p ao lr) ob1) (NSCons c s1 s2 os1 sm1 a2) (MulSucc k1 c s1 s2 m1 (add-comm c s1 s2 a2))))

(def-fns _ $ (erased orbit-label : (erased (Nat) d r y x) (erased (List (Nat)) p) (erased (List (Bond)) g) (erased (List (Nat)) lab xs) (erased (Graph d p g) gr) (erased (Const lab g) cl)
    (erased (Path p (Cons (Nat) r (Nil (Nat))) y r xs) w) (erased (Nth (Nat) lab r r) prr) (erased (In x (Cons (Nat) r xs)) ix)
    -> (erased (Nth (Nat) lab x r) res))
  (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) prr))
  (let-match erased (path-from p _ xs y r x w ix1) (MkSomePath _ _ zs _ _ wz))
  (conn-const lab g r x r (conn-sym g x r (path-graph-conn d x r p _ zs g wz gr)) cl prr))

(def-fns _ $ (erased orbcat-label : (erased (Nat) d x) (erased (List (Nat)) p) (erased (List (Bond)) g) (erased (List (Nat)) lab rs0 rs ls) (erased (Graph d p g) gr) (erased (Const lab g) cl)
    (erased (Respects lab rs0 rs0) fix) (erased (Sub rs rs0) sb) (subterm erased (OrbCat p rs ls) oc) (erased (In x ls) ix)
    -> (erased (Nat) l) (erased (Nth (Nat) lab x l) pl) (erased (In l rs) il))
  (let-match erased oc (OCCons _ rs1 xs ls1 _ r y _ w ap oc1) (absurd (OCNil _) ix))
  (let-match erased sb (SubCons _ _ _ ir sb1))
  (let-match erased (app-in-inv (Cons _ r xs) ls1 ls x ap ix) (OrR _ _ i)
    ((OrL _ _ i) (values r (orbit-label d r y x p g lab xs gr cl w (fixed-in lab rs0 r fix ir) i) (InHere r rs1))))
  (let ((erased l) (erased pl) (erased il)) (orbcat-label d x p g lab rs0 rs1 ls1 gr cl fix sb1 oc1 i))
  (values l pl (InThere l r rs1 il)))

; No dart of m, part of the cycle through r, is in ls, whose darts have their roots in rs, which does not hold r.
(def-fns _ $ (erased orb-disj : (erased (Nat) d r y) (erased (List (Nat)) p) (erased (List (Bond)) g) (erased (List (Nat)) lab rs0 rs xs ls m) (erased (Graph d p g) gr) (erased (Const lab g) cl)
    (erased (Respects lab rs0 rs0) fix) (erased (Sub rs rs0) sb) (erased (OrbCat p rs ls) oc) (erased (Path p (Cons (Nat) r (Nil (Nat))) y r xs) w)
    (erased (Nth (Nat) lab r r) prr) (erased (NotIn r rs) out) (subterm erased (Sub m (Cons (Nat) r xs)) sm) -> (erased (Disj m ls) res))
  (let-match erased sm (SubCons x m1 _ ix sm1) ((SubNil _) (DisjNil ls)))
  (let-match erased (in-dec x ls) (OrR _ _ ox)
    (absurd (OrL _ _ il)
      (let ((erased l) (erased pl) (erased ilr)) (orbcat-label d x p g lab rs0 rs ls gr cl fix sb oc il))
      (let-match erased (nth-fn _ lab x l r pl (orbit-label d r y x p g lab xs gr cl w prr ix)) (Refl _ _))
      (apart-irrefl l (notin-in l l rs out ilr))))
  (DisjCons x m1 ls ox (orb-disj d r y p g lab rs0 rs xs ls m1 gr cl fix sb oc w prr out sm1)))

(def-fns _ $ (erased orbcat-distinct : (erased (Nat) d) (erased (List (Nat)) p) (erased (List (Bond)) g) (erased (List (Nat)) lab rs0 rs ls) (erased (Graph d p g) gr) (erased (Const lab g) cl)
    (erased (Respects lab rs0 rs0) fix) (erased (Sub rs rs0) sb) (erased (Distinct rs) dr) (subterm erased (OrbCat p rs ls) oc) -> (erased (Distinct ls) r))
  (let-match erased oc (OCCons _ rs1 xs ls1 _ r y _ w ap oc1) ((OCNil _) (DistNil)))
  (let-match erased sb (SubCons _ _ _ ir sb1))
  (let-match erased dr (DistCons _ _ out dr1))
  (app-distinct (Cons _ r xs) ls1 ls ap (DistCons r xs (path-avoid p _ xs y r r w (InHere r _)) (walk-distinct p _ xs y r w))
    (orbcat-distinct d p g lab rs0 rs1 ls1 gr cl fix sb1 dr1 oc1)
    (orb-disj d r y p g lab rs0 rs1 xs ls1 (Cons _ r xs) gr cl fix sb1 oc1 w (fixed-in lab rs0 r fix ir) out (sub-refl (Cons _ r xs)))))

(def-fns _ $ (erased orbcat-cover : (erased (Nat) d x r) (erased (List (Nat)) p q) (erased (List (Bond)) g) (erased (List (Nat)) rs ls) (erased (Perm d p q) pm) (erased (Graph d p g) gr)
    (subterm erased (OrbCat p rs ls) oc) (erased (In r rs) ir) (erased (Conn g r x) cn) -> (erased (In x ls) res))
  (let-match erased oc (OCCons _ rs1 xs ls1 _ r1 y py w ap oc1) (absurd (OCNil _) ir))
  (let-match erased ir (InHere _ _) ((InThere _ _ _ ir1) (app-in-r (Cons _ r1 xs) ls1 ls x ap (orbcat-cover d x r p q g rs1 ls1 pm gr oc1 ir1 cn))))
  (let ((erased ws) (erased wx)) (conn-path d r x p q g pm gr cn))
  (app-in-l (Cons _ r xs) ls1 ls x ap (orbit-walk-in d r y r x p q xs _ ws pm py (path-forget p _ xs y r w) (InHere r xs) wx)))

(def-fns _ $ (erased lab-sub : (erased (Nat) d) (erased (List (Nat)) p) (erased (List (Bond)) g) (erased (List (Nat)) lab rs ls ids m) (erased (Iota d ids) io) (erased (Length (Nat) lab d) ll)
    (erased (Graph d p g) gr) (erased (Const lab g) cl) (erased (Respects lab rs rs) fix) (erased (OrbCat p rs ls) oc) (subterm erased (Sub m ls) sm)
    -> (erased (Sub m ids) r))
  (let-match erased sm (SubCons x m1 _ ix sm1) ((SubNil _) (SubNil ids)))
  (let ((erased l) (erased pl) (erased _)) (orbcat-label d x p g lab rs rs ls gr cl fix (sub-refl rs) oc ix))
  (SubCons x m1 ids (iota-in d x ids io (nth-lt-length _ lab x d l pl ll)) (lab-sub d p g lab rs ls ids m1 io ll gr cl fix oc sm1)))

(def-fns _ $ (erased cover-sub : (erased (Nat) d) (erased (List (Nat)) p q) (erased (List (Bond)) g) (erased (List (Nat)) lab rs ls ids m) (erased (Perm d p q) pm) (erased (Iota d ids) io)
    (erased (Length (Nat) lab d) ll) (erased (Graph d p g) gr) (erased (Rooted g rs ids lab) ro) (erased (OrbCat p rs ls) oc) (subterm erased (Sub m ids) sm)
    -> (erased (Sub m ls) r))
  (let-match erased sm (SubCons x m1 _ ix sm1) ((SubNil _) (SubNil ls)))
  (let ((erased j) (erased pj)) (in-nth x ids ix))
  (let-match erased (iota-at d j x ids io pj) (Refl _ _))
  (let ((erased lx)) (nth-lt-length _ ids x d x pj (iota-length d ids io)))
  (let ((erased rt) (erased prt)) (nth-exists _ lab d x ll lx))
  (let ((erased irt) (erased cn)) (classes-root g d ids lab rs x rt io ro prt lx))
  (SubCons x m1 ls (orbcat-cover d x rt p q g rs ls pm gr oc irt cn) (cover-sub d p q g lab rs ls ids m1 pm io ll gr ro oc sm1)))

; The orders os of p at the roots rs of its classes sum to d.
(def-fns _ $ (erased orbit-sum : (erased (Nat) d) (erased (List (Nat)) p q ids lab rs os) (erased (List (Bond)) g) (erased (Perm d p q) pm) (erased (Graph d p g) gr)
    (erased (Iota d ids) io) (erased (Length (Nat) lab d) ll) (erased (Distinct rs) dr) (erased (Respects lab rs rs) fix) (erased (Const lab g) cl)
    (erased (Rooted g rs ids lab) ro) (erased (Orders p rs os) ob) -> (erased (NSum os d) r))
  (let ((erased ls) (erased len) (erased oc) (erased lls) (erased m)) (orbcat-sum p rs os ob))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased p1)) (pigeonhole ls ids len d (orbcat-distinct d p g lab rs rs ls gr cl fix (sub-refl rs) dr oc)
    (lab-sub d p g lab rs ls ids ls io ll gr cl fix oc (sub-refl ls)) lls li))
  (let ((erased p2)) (pigeonhole ids ls d len (iota-distinct d ids io) (cover-sub d p q g lab rs ls ids ids pm io ll gr ro oc (sub-refl ids)) li lls))
  (let-match erased (le-antisym len d p1 p2) (Refl _ _))
  m)

; If every dart has order c under p, and p has k orbits, then k * c = d.
(def-fns _ $ (erased orbit-count : (erased (Nat) d k c) (erased (List (Nat)) p q) (erased (Perm d p q) pm) (erased (Orbits d p k) ob)
    (erased (AllOrder d p c) ao) -> (erased (Mul k c d) r))
  (let-match erased ob (MkOrbits _ _ _ g gr cs))
  (let-match erased cs (MkClasses _ _ _ ids lab rs io ll lr dr fix cl ro))
  (let ((erased os) (erased s) (erased oo) (erased sm) (erased m)) (orders-all d c k p rs ao (respects-under lab rs rs d fix ll) lr))
  (let-match erased (nsum-fn os s d sm (orbit-sum d p q ids lab rs os g pm gr io ll dr fix cl ro oo)) (Refl _ _))
  m)
