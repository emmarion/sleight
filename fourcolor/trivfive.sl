    -> (erased (WSub qs lr) r))
  (let-match erased sq (HSubCons l1 qs1 _ il sq1) ((HSubNil _) (HSubNil lr)))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rf))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core dm em nm fm h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths dm em nm fm h))
  (let ((erased fr2)) fr)
  (let-match erased fr2 (MkFRec _ _ _ _ _ _ _ _ _ _ Rs _ o lvv dv alv rv rlv dl plx))
  (let ((erased u) (erased eu) (erased _) (erased pu) (erased pe) (erased pl1)) (fr-wit dm y l k l1 em nm fm fe lab Vs ls fr c il))
  (let-match erased (facelab-same dm y u l fm lab fl plx pu) (MkSomePath _ _ ws _ _ w))
  (let-match erased (diskf-walk nm fm _ (Nil _) ws y u w dfy) (MkDiskF _ _ _ _ dnu _))
  (let ((erased s) (erased ps)) (nth-exists _ fm dm eu lf (perm-val dm u eu em nf qe pe)))
  (let ((erased isd)) (ds-mem dm s hx em nm fm hp hd zs h gen rg (ring-under dm hx em nm fm hp h rg) ds
    (disk-pre nm fm _ u s dnu (hyp-nfe dm u eu s em nm fm h pe ps)) (perm-val dm eu s fm fi qf ps)))
  (let ((erased l2) (erased pl2) (erased il2)) (allab-in lab (Cons _ l lr) s hd al isd))
  (let-match erased (nth-fn _ lab s l2 l1 pl2 (respects-nth lab fm lab eu s l1 rf ps pl1)) (Refl _ _))
  (HSubCons l1 qs1 lr (match erased il2 (((In l1 lr) r))
      ((InThere _ _ _ i) i)
      (absurd (InHere _ _) (apart-irrefl l (edge-apart dm u eu l l em nm fm fe lab c pe pu pl1))))
    (spk-sub dm hx y l k em nm fm fe lab hp hd zs lr Vs ls c rg ds dfy al fr qs1 sq1)))

