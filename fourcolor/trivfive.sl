; The hom ring hx :: hp of five darts, its diskN side hd meeting only the face of y (label l) off the ring, with that face
; read as FRec, whose spoke labels ls cover the labels lr of the ring.
(def-adts $ (FCx : ((Level) B) ((Nat) dm) ((List (Nat)) em nm fm fe lab) ((Nat) hx) ((List (Nat)) hp hd zs lr) ((Nat) y l) ((List (Nat)) Vs ls) -> Type)
  enum
  (many MkFCx : (erased (Level) B) (erased (Nat) dm) (erased (List (Nat)) em nm fm fe lab) (erased (Nat) hx) (erased (List (Nat)) hp hd zs lr) (erased (Nat) y l)
      (erased (List (Nat)) Vs ls) (erased (Nat) k) (erased (MinCx B dm em nm fm fe lab) m) (erased (Ring em fm hx hp) rg) (erased (Proper em (Cons (Nat) hx hp)) pr)
      (erased (DiskSplit dm em nm (Cons (Nat) hx hp) hd zs) ds) (erased (Respects lab (Cons (Nat) hx hp) lr) rl) (erased (In y hd) iy) (erased (Nth (Nat) lab y l) pl)
      (erased (NotIn l lr) ol) (erased (FRec dm em nm fm fe lab y l k Vs ls) fr) (erased (WSub lr ls) sl) -> (FCx B dm em nm fm fe lab hx hp hd zs lr y l Vs ls)))

(def-fns _ $ (erased spk-sub : (erased (Nat) dm hx y l k) (erased (List (Nat)) em nm fm fe lab hp hd zs lr Vs ls) (erased (Spk dm em nm fm fe lab) c)
    (erased (Ring em fm hx hp) rg) (erased (DiskSplit dm em nm (Cons (Nat) hx hp) hd zs) ds) (erased (DiskF nm fm (Cons (Nat) hx hp) y) dfy)
