  (let-match erased fl2 (MkFaceLab _ k _ _ _ _ rs gf pf gr _ ro cl ll))
  (let ((erased ids) (erased iod)) (iota-exists (Succ (Succ d0))))
  (let ((erased ui)) (perm-under d0 idk idk (perm-id d0 idk io)))
  (values (MkBridgeless d0 e4 n4 f4 ge4 gf gre4 gr
      (allsep-pull d0 x y e n f e2 n2 f2 e4 nf4 f4 fi4 lab H t idk gf ge4 w bl dr pe4 pf4 mf me io dh fl cl ll (graph-fun d0 e4 ge4 gre4)))
    (all-of-oo d0 _ e4 idk io (oo-pull d0 x y e n f e2 n2 f2 e4 nf4 H t idk idk w pl dr pe4 me io dh ui))
    (precubic-part _ d0 n H ids n4 ni4 idk pn4 (morph-node d0 x y e n f e2 n2 f2 H t n4 idk w dr ui mn) io iod dh lh uh pc)))

(def-fns _ $ (erased drop2-t : (erased (Nat) d0 x y) (erased (List (Nat)) H t) (erased (Drop2 d0 x y H t) dr)
    -> (erased (Under t (Succ d0)) ut) (erased (Length (Nat) t (Succ (Succ d0))) lt))
