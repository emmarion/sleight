          (values cx cy (set2-z ks0 ks x cx y cy st) (set2-other ks0 ks x cx y cy v cy st pca nax nay) (apart-sym cy cx ne)))
        ((XYB _ _ _ _ _ pxy2 pyx2 pfx pfy)
