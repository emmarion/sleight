  (let-match erased sw1 (MkSwap _ _ _ _ ps1 psx psd))
  (let-match erased sw2 (MkSwap _ _ _ _ ps2 psy psd2))
  (values (respects-under-vals s2x s1 t (Succ d0) rt (under-snoc-add s2 s2x (Zero) (Succ d0) sx (perm-under (Succ d0) s2 s2 ps2) (LtZ d0)))
    (respects-length s2x s1 t _ rt (perm-length _ s1 s1 ps1))))

; ks0 = (k4 ++ [0]) . t.
(def-adts $ (Lift : ((Nat) d0 x y) ((List (Nat)) e n f e2 n2 f2 ks0) -> Type)
  enum
  (many MkLift : (erased (Nat) d0 x y) (erased (List (Nat)) e n f e2 n2 f2 e4 n4 f4 H t idk k4 ke k4x ks0)
      (erased (Walk2 (Succ (Succ d0)) x y e n f e2 n2 f2) w) (erased (AllOrder (Succ (Succ d0)) e (Succ (Succ (Zero)))) pl) (erased (Drop2 d0 x y H t) dr)
      (erased (Hypermap d0 e4 n4 f4) h4) (erased (Iota d0 idk) io) (erased (MorphOff H f4 f2 (Nil (Nat)) idk) mf) (erased (MorphOff H e4 e2 (Nil (Nat)) idk) me)
      (erased (Respects k4 f4 k4) rf) (erased (Respects k4 e4 ke) re) (erased (Differ ke k4) df) (erased (Under k4 4) u4) (erased (Length (Nat) k4 d0) lk)
      (erased (Snoc (Nat) k4 (Zero) k4x) sk) (erased (Respects k4x t ks0) rt) -> (Lift d0 x y e n f e2 n2 f2 ks0)))

(def-fns _ $ (erased lift-live : (erased (Nat) d0 x y u) (erased (List (Nat)) e n f e2 n2 f2 ks0) (erased (Lift d0 x y e n f e2 n2 f2 ks0) lf)
    (erased (Lt u (Succ (Succ d0))) lu) (erased (Apart (Nat) Lt u x) nux) (erased (Apart (Nat) Lt u y) nuy)
    -> (erased (Nat) c) (erased (Nth (Nat) ks0 u c) pc) (erased (Lt c 4) lc))
  (let-match erased lf (MkLift _ _ _ _ _ _ _ _ _ e4 n4 f4 H t idk k4 ke k4x _ w pl dr h4 io mf me rf re df u4 lk sk rt))
  (let ((erased i) (erased tu) (erased li) (erased hi)) (drop2-out d0 x y u H t dr lu nux nuy))
  (let ((erased c) (erased pc)) (nth-exists _ k4 d0 i lk li))
  (values c (respects-at k4x t ks0 u i c rt tu (snoc-old _ k4 k4x (Zero) c i sk pc)) (under-nth k4 i c 4 u4 pc)))

(def-fns _ $ (erased lift-face : (erased (Nat) d0 x y u v c) (erased (List (Nat)) e n f e2 n2 f2 ks0) (erased (Lift d0 x y e n f e2 n2 f2 ks0) lf)
    (erased (Lt u (Succ (Succ d0))) lu) (erased (Apart (Nat) Lt u x) nux) (erased (Apart (Nat) Lt u y) nuy) (erased (Nth (Nat) f2 u v) puv)
    (erased (Nth (Nat) ks0 u c) pc) -> (erased (Nth (Nat) ks0 v c) r))
  (let-match erased lf (MkLift _ _ _ _ _ _ _ _ _ e4 n4 f4 H t idk k4 ke k4x _ w pl dr h4 io mf me rf re df u4 lk sk rt))
  (let ((erased i) (erased tu) (erased li) (erased hi)) (drop2-out d0 x y u H t dr lu nux nuy))
  (let ((erased nf4) (erased ni4) (erased fi4) (erased rnf4) (erased pe4) (erased pn4) (erased pf4)) (hyper-core d0 e4 n4 f4 h4))
  (let ((erased j) (erased pj) (erased lj)) (perm-nth d0 i f4 fi4 pf4 li))
  (let ((erased w0) (erased hw) (erased qw)) (morph H f4 f2 (Nil _) idk d0 i j u mf io li (NotInNil i) pj hi))
  (let-match erased (nth-fn _ f2 u w0 v qw puv) (Refl _ _))
  (let ((erased b) (erased hb) (erased lb) (erased nbx) (erased nby) (erased tb)) (drop2-in d0 x y j H t dr lj))
  (let-match erased (nth-fn _ H j b w0 hb hw) (Refl _ _))
  (let ((erased ci) (erased pci)) (nth-exists _ k4 d0 i lk li))
  (let-match erased (nth-fn _ ks0 u c ci pc (respects-at k4x t ks0 u i ci rt tu (snoc-old _ k4 k4x (Zero) ci i sk pci))) (Refl _ _))
  (respects-at k4x t ks0 v j c rt tb (snoc-old _ k4 k4x (Zero) c j sk (respects-nth k4 f4 k4 i j c rf pj pci))))

(def-fns _ $ (erased lift-edge : (erased (Nat) d0 x y u v c1 c2) (erased (List (Nat)) e n f e2 n2 f2 ks0) (erased (Lift d0 x y e n f e2 n2 f2 ks0) lf)
    (erased (Lt u (Succ (Succ d0))) lu) (erased (Apart (Nat) Lt u x) nux) (erased (Apart (Nat) Lt u y) nuy) (erased (Nth (Nat) e2 u v) puv)
    (erased (Nth (Nat) ks0 u c1) p1) (erased (Nth (Nat) ks0 v c2) p2) -> (erased (Apart (Nat) Lt c1 c2) r))
  (let-match erased lf (MkLift _ _ _ _ _ _ _ _ _ e4 n4 f4 H t idk k4 ke k4x _ w pl dr h4 io mf me rf re df u4 lk sk rt))
  (let ((erased i) (erased tu) (erased li) (erased hi)) (drop2-out d0 x y u H t dr lu nux nuy))
  (let ((erased nf4) (erased ni4) (erased fi4) (erased rnf4) (erased pe4) (erased pn4) (erased pf4)) (hyper-core d0 e4 n4 f4 h4))
  (let ((erased j) (erased pj) (erased lj)) (perm-nth d0 i e4 nf4 pe4 li))
  (let ((erased w0) (erased hw) (erased qw)) (morph H e4 e2 (Nil _) idk d0 i j u me io li (NotInNil i) pj hi))
  (let-match erased (nth-fn _ e2 u w0 v qw puv) (Refl _ _))
  (let ((erased b) (erased hb) (erased lb) (erased nbx) (erased nby) (erased tb)) (drop2-in d0 x y j H t dr lj))
  (let-match erased (nth-fn _ H j b w0 hb hw) (Refl _ _))
  (let ((erased ci) (erased pci)) (nth-exists _ k4 d0 i lk li))
  (let ((erased cj) (erased pcj)) (nth-exists _ k4 d0 j lk lj))
  (let-match erased (nth-fn _ ks0 u c1 ci p1 (respects-at k4x t ks0 u i ci rt tu (snoc-old _ k4 k4x (Zero) ci i sk pci))) (Refl _ _))
  (let-match erased (nth-fn _ ks0 v c2 cj p2 (respects-at k4x t ks0 v j cj rt tb (snoc-old _ k4 k4x (Zero) cj j sk pcj))) (Refl _ _))
  (apart-sym c2 c1 (differ-nth ke k4 i c2 c1 df (respects-at k4 e4 ke i j c2 re pj pcj) pci)))

; cx and cy are the colours of the faces of x and y when e x is not y, and 0 and 1 when it is.
(def-adts $ (XYCol : ((List (Nat)) e f ks0) ((Nat) x y cx cy) -> Type)
  enum
  (many XYA : (erased (List (Nat)) e f ks0) (erased (Nat) x y a b wx wy cx cy) (erased (Nth (Nat) e x a) pa) (erased (Nth (Nat) e y b) pb)
      (erased (Nth (Nat) f b x) pfb) (erased (Nth (Nat) f a y) pfa) (erased (Nth (Nat) f x wx) pwx) (erased (Nth (Nat) f y wy) pwy)
      (erased (Apart (Nat) Lt a x) nax) (erased (Apart (Nat) Lt a y) nay) (erased (Apart (Nat) Lt b x) nbx) (erased (Apart (Nat) Lt b y) nby)
      (erased (Apart (Nat) Lt wx x) nxx) (erased (Apart (Nat) Lt wx y) nxy) (erased (Apart (Nat) Lt wy x) nyx) (erased (Apart (Nat) Lt wy y) nyy)
      (erased (Nth (Nat) ks0 wx cx) cxp) (erased (Nth (Nat) ks0 wy cy) cyp) -> (XYCol e f ks0 x y cx cy))
  (many XYB : (erased (List (Nat)) e f ks0) (erased (Nat) x y) (erased (Nth (Nat) e x y) pxy) (erased (Nth (Nat) e y x) pyx) (erased (Nth (Nat) f x x) pfx)
      (erased (Nth (Nat) f y y) pfy) -> (XYCol e f ks0 x y (Zero) (Succ (Zero)))))

(def-fns _ $ (erased xy-col : (erased (Nat) d0 x y) (erased (List (Nat)) e n f e2 n2 f2 ks0) (erased (Lift d0 x y e n f e2 n2 f2 ks0) lf)
    -> (erased (Nat) cx cy) (erased (XYCol e f ks0 x y cx cy) xc) (erased (Lt cx 4) lcx) (erased (Lt cy 4) lcy))
  (let-match erased lf (MkLift _ _ _ _ _ _ _ _ _ e4 n4 f4 H t idk k4 ke k4x _ w pl dr h4 io mf me rf re df u4 lk sk rt))
  (let-match erased w (MkWalk2 _ _ _ _ _ _ e1 n1 f1 _ _ _ h h1 h2 sn1 sf1 sn2 sf2 pxy pyx nyx lx ly))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core _ e n f h))
  (let ((erased a) (erased pa) (erased la)) (perm-nth _ x e nf pme lx))
  (let ((erased b) (erased pb) (erased lb)) (perm-nth _ y e nf pme ly))
  (let-match erased (nat-eq a y) (Unequal _ _ _ _ nay)
    ((Equal _ _ _)
      (let ((erased pyx2) (erased _)) (plain-eq _ x y e pl lx pa))
      (let ((erased c) (erased pc) (erased lc)) (perm-nth _ x f fi pmf lx))
      (let-match erased (perm-inj _ c x y n ni pmn (hyper-node _ c x y e n f h pc pyx2) pxy) (Refl _ _))
      (let ((erased c2) (erased pc2) (erased lc2)) (perm-nth _ y f fi pmf ly))
      (let-match erased (perm-inj _ c2 y x n ni pmn (hyper-node _ c2 y x e n f h pc2 pa) pyx) (Refl _ _))
      (values (Zero) (Succ (Zero)) (XYB e f ks0 x y pa pyx2 pc pc2) (LtZ _) (LtS _ _ (LtZ _)))))
  (let ((erased wx) (erased pfb) (erased pwx) (erased _) (erased nxx) (erased nxy) (erased nax) (erased nbx) (erased nby))
    (swap-geo _ x y a b e n f h pl pxy pyx nyx lx ly pa pb nay))
  (let ((erased wy) (erased pfa) (erased pwy) (erased _) (erased nyy) (erased nyx2) (erased _) (erased _) (erased _))
    (swap-geo _ y x b a e n f h pl pyx pxy (apart-sym y x nyx) ly lx pb pa nbx))
  (let ((erased cx) (erased cxp) (erased lcx)) (lift-live d0 x y wx e n f e2 n2 f2 ks0 lf (perm-val _ x wx f fi pmf pwx) nxx nxy))
  (let ((erased cy) (erased cyp) (erased lcy)) (lift-live d0 x y wy e n f e2 n2 f2 ks0 lf (perm-val _ y wy f fi pmf pwy) nyx2 nyy))
  (values cx cy (XYA e f ks0 x y a b wx wy cx cy pa pb pfb pfa pwx pwy nax nay nbx nby nxx nxy nyx2 nyy cxp cyp) lcx lcy))

(def-fns _ $ (erased xy-apart : (erased (Nat) d0 x y a b wx wy cx cy) (erased (List (Nat)) e n f e2 n2 f2 ks0) (erased (Lift d0 x y e n f e2 n2 f2 ks0) lf)
    (erased (Nth (Nat) e x a) pa) (erased (Nth (Nat) e y b) pb) (erased (Nth (Nat) f b x) pfb) (erased (Nth (Nat) f a y) pfa) (erased (Nth (Nat) f x wx) pwx)
    (erased (Nth (Nat) f y wy) pwy) (erased (Apart (Nat) Lt a x) nax) (erased (Apart (Nat) Lt a y) nay) (erased (Apart (Nat) Lt b x) nbx) (erased (Apart (Nat) Lt b y) nby)
    (erased (Apart (Nat) Lt wx y) nxy) (erased (Apart (Nat) Lt wy x) nyx) (erased (Nth (Nat) ks0 wx cx) cxp) (erased (Nth (Nat) ks0 wy cy) cyp)
    -> (erased (Nth (Nat) ks0 a cy) pca) (erased (Nth (Nat) ks0 b cx) pcb) (erased (Apart (Nat) Lt cy cx) ne))
  (let ((erased lf2)) lf)
