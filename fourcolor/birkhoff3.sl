  (let-match erased w (MkWalk2 _ _ _ _ _ _ e1 n1 f1 _ _ _ h h1 h2 sn1 sf1 sn2 sf2 pxy pyx nyx0 lx ly))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core _ e n f h))
  (let ((erased la) (erased lb)) (values (perm-val _ x a e nf pme pa) (perm-val _ y b e nf pme pb)))
  (let ((erased ca) (erased pca) (erased _)) (lift-live d0 x y a e n f e2 n2 f2 ks0 lf la nax nay))
  (let ((erased cb) (erased pcb) (erased _)) (lift-live d0 x y b e n f e2 n2 f2 ks0 lf lb nbx nby))
  (let-match erased (nth-fn _ ks0 wx cx cb cxp
      (lift-face d0 x y b wx cb e n f e2 n2 f2 ks0 lf lb nbx nby (w2-face-x _ x y b wx e n f e2 n2 f2 w nbx nby nxy pfb pwx) pcb)) (Refl _ _))
  (let-match erased (nth-fn _ ks0 wy cy ca cyp
      (lift-face d0 x y a wy ca e n f e2 n2 f2 ks0 lf la nax nay (w2-face-y _ x y a wy e n f e2 n2 f2 w nax nay nyx pfa pwy) pca)) (Refl _ _))
  (values pca pcb (lift-edge d0 x y a b ca cb e n f e2 n2 f2 ks0 lf la nax nay (e2-x _ x y a b e n f e2 n2 f2 w pl pa pb nay) pca pcb)))

(def-fns _ $ (erased col-face : (erased (Nat) d0 x y u v cx cy) (erased (List (Nat)) e n f e2 n2 f2 ks0 ks) (erased (Lift d0 x y e n f e2 n2 f2 ks0) lf)
    (erased (XYCol e f ks0 x y cx cy) xc) (erased (Set2 ks0 x cx y cy ks) st) (erased (Lt u (Succ (Succ d0))) lu) (erased (Nth (Nat) f u v) puv)
    -> (erased (Nat) c) (erased (Nth (Nat) ks u c) pu) (erased (Nth (Nat) ks v c) pv))
