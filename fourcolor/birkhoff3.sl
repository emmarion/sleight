; x and n x = y form a node cycle.
(def-adts $ (NodeTwo : ((Nat) d) ((List (Nat)) n) -> Type)
  enum
  (many MkNodeTwo : (erased (Nat) d x y) (erased (List (Nat)) n) (erased (Nth (Nat) n x y) pxy) (erased (Nth (Nat) n y x) pyx) (erased (Apart (Nat) Lt y x) nyx)
