          (values cy pu (set2-ez ks0 ks x cx y cy st)))
        (absurd (XYB _ _ _ _ _ pxy2 pyx2 pfx pfy) (let-match erased (perm-inj _ u y y f fi pmf puv pfy) (Refl _ _)) (apart-irrefl y nuy)))))
  (values c0 pu (set2-other ks0 ks x cx y cy v c0 st
