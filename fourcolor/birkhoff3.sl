  (let ((erased c0) (erased pc0) (erased _)) (lift-live d0 x y u e n f e2 n2 f2 ks0 lf lu nux nuy))
  (let ((erased pu)) (set2-other ks0 ks x cx y cy u c0 st pc0 nux nuy))
