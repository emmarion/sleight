; minimal_counter_example_is_cubic of coloring.v, and birkhoff.v's spoke ring, min_arity and
; minimal_counter_example_is_plain_cubic_pentagonal (embed.sl's BirkGeo), with minimality as data: each step gives the
; fact or a Reduces. Load after birkhoff2.sl and split.sl.

(def-fns _ $ (erased skip-id : (erased (Nat) d z) (erased (List (Nat)) p q p2) (erased (HPerm d p q) pm) (erased (Skip p z p2) sk) (erased (Nth (Nat) p z z) pz)
    -> (erased (Eq (List (Nat)) p2 p) r))
  (match erased sk _
    ((SkipFixed _ _ _) (Refl _ p))
    (absurd (SkipCut _ _ _ w u pw _ ne _) (let-match erased (perm-inj d w z z p q pm pw pz) (Refl _ _)) (apart-irrefl w ne))))

; A WalkupE at a dart z that p fixes: p2 i = s (p (s i)) below d, so s0, the swap s without its last entry, sends p2 to p.
(def-fns _ $ (erased cut-morph : (erased (Nat) d z) (erased (List (Nat)) p q s s0 p2 m) (erased (HPerm (Succ d) p q) pm) (erased (Swap (Succ d) z d s) sw)
    (erased (Snoc (Nat) s0 z s) sn) (erased (Length (Nat) s0 d) l0) (erased (Length (Nat) p2 d) lp2) (erased (Cut d z s p p2) ct) (erased (Nth (Nat) p z z) pz)
    (subterm erased (Under m d) u) -> (erased (MorphOff s0 p2 p (Nil (Nat)) m) r))
  (let-match erased u (UnderCons m1 i _ li u1) ((UnderNil _) (MONil s0 p2 p (Nil _))))
  (let-match erased sw (MkSwap _ _ _ _ ps psz psd))
  (let-match erased ct (MkCut _ _ _ _ p1 pb _ sk cj sb))
  (let-match erased (skip-id (Succ d) z p q p1 pm sk pz) (Refl _ _))
  (let-match erased cj (MkConj _ _ _ t _ rt rb))
  (let ((erased a) (erased psa)) (nth-exists _ s0 d i l0 li))
  (let ((erased psi)) (snoc-old _ s0 s z a i sn psa))
  (let ((erased v) (erased pv) (erased lv)) (perm-nth (Succ d) a p q pm (perm-val (Succ d) i a s s ps psi)))
  (let ((erased w) (erased psv) (erased lw)) (perm-nth (Succ d) v s s ps lv))
  (let-match erased (snoc-back _ p2 pb d w i d sb lp2 (respects-at s t pb i v w rb (respects-at p s t i a v rt psi pv) psv)) (OrL _ _ p2i)
    (absurd (OrR _ _ ei) (let-match erased ei (Refl _ _)) (lt-irrefl i li)))
  (let-match erased (nat-eq v z) (Unequal _ _ _ _ nvz)
    (absurd (Equal _ _ _)
      (let-match erased (perm-inj (Succ d) a z z p q pm pv pz) (Refl _ _))
      (let-match erased (perm-inj (Succ d) i d z s s ps psi psd) (Refl _ _))
      (lt-irrefl i li)))
  (let-match erased (snoc-back _ s0 s z v w d sn l0 (perm-inv (Succ d) v w s s ps psv)) (OrL _ _ ps0w)
    (absurd (OrR _ _ ew) (let-match erased ew (Refl _ _)) (let-match erased (nth-fn _ s d v z (perm-inv (Succ d) v w s s ps psv) psd) (Refl _ _))
      (apart-irrefl v nvz)))
  (MOAt s0 p2 p (Nil _) m1 i w a v p2i psa ps0w pv (cut-morph d z p q s s0 p2 m1 pm sw sn l0 lp2 ct pz u1)))

(def-fns _ $ (erased morph-comp : (erased (Nat) ka) (erased (List (Nat)) h1 h2 hh pa pb pc ia m) (erased (MorphOff h1 pb pa (Nil (Nat)) ia) m1)
    (erased (Iota ka ia) io) (erased (Length (Nat) h1 ka) l1) (erased (Under h2 ka) u2) (erased (Respects h1 h2 hh) rh)
    (subterm erased (MorphOff h2 pc pb (Nil (Nat)) m) m2) -> (erased (MorphOff hh pc pa (Nil (Nat)) m) r))
  (let-match erased m2 (MOAt _ _ _ _ ms i y z w pcy hz hy pbz rest) ((MONil _ _ _ _) (MONil hh pc pa (Nil _))) (absurd (MOSkip _ _ _ _ _ _ ib _) ib))
  (let ((erased lz)) (under-nth h2 i z ka u2 hz))
  (let ((erased a) (erased pa1)) (nth-exists _ h1 ka z l1 lz))
  (let ((erased b) (erased hb) (erased pab)) (morph h1 pb pa (Nil _) ia ka z w a m1 io lz (NotInNil z) pbz pa1))
  (MOAt hh pc pa (Nil _) ms i y a b pcy (respects-at h1 h2 hh i z a rh hz pa1) (respects-at h1 h2 hh y w b rh hy hb) pab
    (morph-comp ka h1 h2 hh pa pb pc ia ms m1 io l1 u2 rh rest)))

; WalkupE at a dart z fixed by n and f: the map on d darts, with s0 sending its node and face permutations to those of the map.
(def-fns _ $ (erased drop-dead : (erased (Nat) d z) (erased (List (Nat)) e n f idd) (erased (Hypermap (Succ d) e n f) h) (erased (Genus (Succ d) e n f (Zero)) g)
    (erased (Lt z (Succ d)) lz) (erased (Nth (Nat) n z z) pnz) (erased (Nth (Nat) f z z) pfz) (erased (Iota d idd) io)
    -> (erased (List (Nat)) e2 n2 f2 s s0) (erased (Hypermap d e2 n2 f2) h2) (erased (Genus d e2 n2 f2 (Zero)) g2) (erased (Swap (Succ d) z d s) sw)
    (erased (Snoc (Nat) s0 z s) sn) (erased (Length (Nat) s0 d) l0) (erased (MorphOff s0 n2 n (Nil (Nat)) idd) mn) (erased (MorphOff s0 f2 f (Nil (Nat)) idd) mf))
  (let ((erased s) (erased e2) (erased n2) (erased f2) (erased gen2) (erased sw) (erased cn) (erased cf) (erased h2) (erased g2) (erased le))
    (walkup-e d (Zero) z e n f h g lz))
  (let-match erased (lt-one gen2 le) (Refl _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core (Succ d) e n f h))
  (let ((erased le2) (erased ln2) (erased lf2)) (hyper-lengths d e2 n2 f2 h2))
  (let ((erased sw2)) sw)
  (let-match erased sw2 (MkSwap _ _ _ _ ps psz psd))
  (let ((erased s0) (erased a) (erased sn) (erased l0)) (snoc-split _ s d (perm-length (Succ d) s s ps)))
  (let-match erased (nth-fn _ s d a z (snoc-new _ s0 s a d sn l0) psd) (Refl _ _))
  (let ((erased ui)) (perm-under d idd idd (perm-id d idd io)))
  (values e2 n2 f2 s s0 h2 g2 sw sn l0 (cut-morph d z n ni s s0 n2 idd pn sw sn l0 ln2 cn pnz ui) (cut-morph d z f fi s s0 f2 idd pf sw sn l0 lf2 cf pfz ui)))

(def-fns _ $ (erased lt-ne : (erased (Nat) a b) (erased (Lt a (Succ b)) p) (erased (Apart (Nat) Lt a b) ne) -> (erased (Lt a b) r))
  (match erased ne _
    ((ApLt _ _ _ _ l) l)
    (absurd (ApGt _ _ _ _ l) (lt-irrefl b (lt-le-trans b a b l p)))))

(def-fns _ $ (erased notin-unsnoc : (erased (Nat) x a) (erased (List (Nat)) xs ys) (subterm erased (Snoc (Nat) xs a ys) sn) (erased (NotIn x ys) o)
    -> (erased (NotIn x xs) r))
  (let-match erased sn (SnocCons _ y _ xs1 ys1 sn1) ((SnocNil _ _) (NotInNil x)))
  (let-match erased o (NotInCons _ _ _ ne o1))
  (NotInCons x y xs1 ne (notin-unsnoc x a xs1 ys1 sn1 o1)))

(def-fns _ $ (erased distinct-unsnoc : (erased (Nat) a) (erased (List (Nat)) xs ys) (subterm erased (Snoc (Nat) xs a ys) sn) (erased (Distinct ys) dy)
    -> (erased (Distinct xs) r))
  (let-match erased sn (SnocCons _ x _ xs1 ys1 sn1) ((SnocNil _ _) (DistNil)))
  (let-match erased dy (DistCons _ _ out dy1))
  (DistCons x xs1 (notin-unsnoc x a xs1 ys1 sn1 out) (distinct-unsnoc a xs1 ys1 sn1 dy1)))

(def-fns _ $ (erased perm-distinct : (erased (Nat) d) (erased (List (Nat)) s si) (erased (HPerm d s si) pm) -> (erased (Distinct s) r))
  (let ((erased ids) (erased io)) (iota-exists d))
  (distinct-map d s si ids s (iota-distinct d ids io) (respects-id-right d ids s io (perm-length d s si pm)) pm))

; Two WalkupEs at darts x and y fixed by n and f, as Drop2 records them: H sends the darts 0..d0-1 of the smaller map to the
; darts of the map other than x and y, and t sends them back.
(def-adts $ (Drop2 : ((Nat) d0 x y) ((List (Nat)) H t) -> Type)
  enum
  (many MkDrop2 : (erased (Nat) d0 x y y1) (erased (List (Nat)) H t s1 s10 s2 s20 s2x) (erased (Swap (Succ (Succ d0)) x (Succ d0) s1) sw1)
      (erased (Snoc (Nat) s10 x s1) sn1) (erased (Length (Nat) s10 (Succ d0)) l1) (erased (Nth (Nat) s1 y y1) py1)
      (erased (Swap (Succ d0) y1 d0 s2) sw2) (erased (Snoc (Nat) s20 y1 s2) sn2) (erased (Length (Nat) s20 d0) l2) (erased (Snoc (Nat) s2 (Zero) s2x) sx)
      (erased (Respects s10 s20 H) rh) (erased (Respects s2x s1 t) rt) -> (Drop2 d0 x y H t)))

(def-fns _ $ (erased drop2-in : (erased (Nat) d0 x y i) (erased (List (Nat)) H t) (erased (Drop2 d0 x y H t) dr) (erased (Lt i d0) li)
    -> (erased (Nat) b) (erased (Nth (Nat) H i b) pb) (erased (Lt b (Succ (Succ d0))) lb) (erased (Apart (Nat) Lt b x) nx) (erased (Apart (Nat) Lt b y) ny)
    (erased (Nth (Nat) t b i) tb))
  (let-match erased dr (MkDrop2 _ _ _ y1 _ _ s1 s10 s2 s20 s2x sw1 sn1 l1 py1 sw2 sn2 l2 sx rh rt))
  (let-match erased sw1 (MkSwap _ _ _ _ ps1 psx psd))
  (let-match erased sw2 (MkSwap _ _ _ _ ps2 psy psd2))
  (let ((erased a) (erased pa)) (nth-exists _ s20 d0 i l2 li))
  (let ((erased pa2)) (snoc-old _ s20 s2 y1 a i sn2 pa))
  (let ((erased la)) (perm-val (Succ d0) i a s2 s2 ps2 pa2))
  (let ((erased b) (erased pb)) (nth-exists _ s10 (Succ d0) a l1 la))
  (let ((erased pb2)) (snoc-old _ s10 s1 x b a sn1 pb))
  (values b (respects-at s10 s20 H i a b rh pa pb) (perm-val _ a b s1 s1 ps1 pb2)
    (img-apart _ a (Succ d0) b x s1 s1 ps1 pb2 psd (ApLt _ _ a (Succ d0) la))
    (img-apart _ a y1 b y s1 s1 ps1 pb2 (perm-inv _ y y1 s1 s1 ps1 py1) (img-apart (Succ d0) i d0 a y1 s2 s2 ps2 pa2 psd2 (ApLt _ _ i d0 li)))
    (respects-at s2x s1 t b a i rt (perm-inv _ a b s1 s1 ps1 pb2) (snoc-old _ s2 s2x (Zero) i a sx (perm-inv (Succ d0) i a s2 s2 ps2 pa2)))))

(def-fns _ $ (erased drop2-out : (erased (Nat) d0 x y u) (erased (List (Nat)) H t) (erased (Drop2 d0 x y H t) dr) (erased (Lt u (Succ (Succ d0))) lu)
    (erased (Apart (Nat) Lt u x) nx) (erased (Apart (Nat) Lt u y) ny) -> (erased (Nat) i) (erased (Nth (Nat) t u i) tu) (erased (Lt i d0) li) (erased (Nth (Nat) H i u) hi))
  (let-match erased dr (MkDrop2 _ _ _ y1 _ _ s1 s10 s2 s20 s2x sw1 sn1 l1 py1 sw2 sn2 l2 sx rh rt))
  (let-match erased sw1 (MkSwap _ _ _ _ ps1 psx psd))
  (let-match erased sw2 (MkSwap _ _ _ _ ps2 psy psd2))
  (let ((erased a) (erased pa) (erased la)) (perm-nth _ u s1 s1 ps1 lu))
  (let ((erased na)) (img-apart _ u y a y1 s1 s1 ps1 pa py1 ny))
  (let ((erased la1)) (lt-ne a (Succ d0) la (img-apart _ u x a (Succ d0) s1 s1 ps1 pa psx nx)))
  (let ((erased i) (erased pi) (erased li1)) (perm-nth (Succ d0) a s2 s2 ps2 la1))
  (let ((erased li)) (lt-ne i d0 li1 (img-apart (Succ d0) a y1 i d0 s2 s2 ps2 pi psy na)))
  (let-match erased (snoc-back _ s20 s2 y1 a i d0 sn2 l2 (perm-inv (Succ d0) a i s2 s2 ps2 pi)) (OrL _ _ p20)
    (absurd (OrR _ _ e) (let-match erased e (Refl _ _)) (lt-irrefl i li)))
  (let-match erased (snoc-back _ s10 s1 x u a (Succ d0) sn1 l1 (perm-inv _ u a s1 s1 ps1 pa)) (OrL _ _ p10)
    (absurd (OrR _ _ e) (let-match erased e (Refl _ _)) (lt-irrefl a la1)))
  (values i (respects-at s2x s1 t u a i rt pa (snoc-old _ s2 s2x (Zero) i a sx pi)) li (respects-at s10 s20 H i a u rh p20 p10)))

; The two WalkupEs, from a map on d0 + 2 darts with x and y fixed by n and f.
(def-fns _ $ (erased drop-two : (erased (Nat) d0 x y) (erased (List (Nat)) e n f) (erased (Hypermap (Succ (Succ d0)) e n f) h)
    (erased (Genus (Succ (Succ d0)) e n f (Zero)) g) (erased (Lt x (Succ (Succ d0))) lx) (erased (Lt y (Succ (Succ d0))) ly) (erased (Apart (Nat) Lt y x) nyx)
    (erased (Nth (Nat) n x x) pnx) (erased (Nth (Nat) f x x) pfx) (erased (Nth (Nat) n y y) pny) (erased (Nth (Nat) f y y) pfy) (erased (List (Nat)) idk)
    (erased (Iota d0 idk) iok)
    -> (erased (List (Nat)) e4 n4 f4 H t) (erased (Hypermap d0 e4 n4 f4) h4) (erased (Genus d0 e4 n4 f4 (Zero)) g4) (erased (Drop2 d0 x y H t) dr)
    (erased (MorphOff H n4 n (Nil (Nat)) idk) mn) (erased (MorphOff H f4 f (Nil (Nat)) idk) mf) (erased (Length (Nat) H d0) lh) (erased (Under H (Succ (Succ d0))) uh)
    (erased (Distinct H) dh))
  (let ((erased ids1) (erased io1)) (iota-exists (Succ d0)))
  (let ((erased e3) (erased n3) (erased f3) (erased s1) (erased s10) (erased h3) (erased g3) (erased sw1) (erased sn1) (erased l10) (erased mn3) (erased mf3))
    (drop-dead (Succ d0) x e n f ids1 h g lx pnx pfx io1))
  (let ((erased sw1b)) sw1)
  (let-match erased sw1b (MkSwap _ _ _ _ ps1 psx psd))
  (let ((erased y1) (erased py1) (erased ly1)) (perm-nth _ y s1 s1 ps1 ly))
  (let ((erased ly2)) (lt-ne y1 (Succ d0) ly1 (img-apart _ y x y1 (Succ d0) s1 s1 ps1 py1 psx nyx)))
  (let-match erased (snoc-back _ s10 s1 x y y1 (Succ d0) sn1 l10 (perm-inv _ y y1 s1 s1 ps1 py1)) (OrL _ _ p10)
    (absurd (OrR _ _ e1) (let-match erased e1 (Refl _ _)) (lt-irrefl y1 ly2)))
  (let ((erased nf3) (erased ni3) (erased fi3) (erased rnf3) (erased pe3) (erased pn3) (erased pf3)) (hyper-core (Succ d0) e3 n3 f3 h3))
  (let ((erased j) (erased pj) (erased lj)) (perm-nth (Succ d0) y1 n3 ni3 pn3 ly2))
  (let ((erased w) (erased hw) (erased qw)) (morph s10 n3 n (Nil _) ids1 (Succ d0) y1 j y mn3 io1 ly2 (NotInNil y1) pj p10))
  (let-match erased (nth-fn _ n y w y qw pny) (Refl _ _))
  (let-match erased (perm-inj _ j y1 y s1 s1 ps1 (snoc-old _ s10 s1 x y j sn1 hw) (snoc-old _ s10 s1 x y y1 sn1 p10)) (Refl _ _))
  (let ((erased j2) (erased pj2) (erased lj2)) (perm-nth (Succ d0) y1 f3 fi3 pf3 ly2))
  (let ((erased w2) (erased hw2) (erased qw2)) (morph s10 f3 f (Nil _) ids1 (Succ d0) y1 j2 y mf3 io1 ly2 (NotInNil y1) pj2 p10))
  (let-match erased (nth-fn _ f y w2 y qw2 pfy) (Refl _ _))
  (let-match erased (perm-inj _ j2 y1 y s1 s1 ps1 (snoc-old _ s10 s1 x y j2 sn1 hw2) (snoc-old _ s10 s1 x y y1 sn1 p10)) (Refl _ _))
  (let ((erased e4) (erased n4) (erased f4) (erased s2) (erased s20) (erased h4) (erased g4) (erased sw2) (erased sn2) (erased l20) (erased mn4) (erased mf4))
    (drop-dead d0 y1 e3 n3 f3 idk h3 g3 ly2 pj pj2 iok))
  (let ((erased sw2b)) sw2)
  (let-match erased sw2b (MkSwap _ _ _ _ ps2 psy psd2))
  (let ((erased u20)) (under-snoc s2 s20 y1 (Succ d0) (perm-under (Succ d0) s2 s2 ps2) sn2))
  (let ((erased u10)) (under-snoc s1 s10 x _ (perm-under _ s1 s1 ps1) sn1))
  (let ((erased H) (erased rh)) (respects-exists s10 s20 (Succ d0) u20 l10))
  (let ((erased s2x) (erased sx)) (snoc-exists _ s2 (Zero)))
  (let ((erased t) (erased rt)) (respects-exists s2x s1 _ (perm-under _ s1 s1 ps1) (snoc-length _ s2 s2x (Zero) (Succ d0) sx (perm-length (Succ d0) s2 s2 ps2))))
  (values e4 n4 f4 H t h4 g4 (MkDrop2 d0 x y y1 H t s1 s10 s2 s20 s2x sw1 sn1 l10 py1 sw2 sn2 l20 sx rh rt)
    (morph-comp (Succ d0) s10 s20 H n n3 n4 ids1 idk mn3 io1 l10 u20 rh mn4) (morph-comp (Succ d0) s10 s20 H f f3 f4 ids1 idk mf3 io1 l10 u20 rh mf4)
    (respects-length s10 s20 H d0 rh l20) (respects-under-vals s10 s20 H _ rh u10)
    (respects-distinct s10 s20 H (distinct-unsnoc x s10 s1 sn1 (perm-distinct _ s1 s1 ps1)) (distinct-unsnoc y1 s20 s2 sn2 (perm-distinct (Succ d0) s2 s2 ps2)) rh)))
