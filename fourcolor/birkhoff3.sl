          (values cx cy (set2-z ks0 ks x cx y cy st) (set2-ez ks0 ks x cx y cy st) (ApLt _ _ (Zero) (Succ (Zero)) (LtZ _)))))))
  (let-match erased (nat-eq u y) (Unequal _ _ _ _ nuy)
    ((Equal _ _ _)
