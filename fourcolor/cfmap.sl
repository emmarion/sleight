; x is on r or has node order 3.
(def-adts $ (Cub : ((List (Nat)) n r) ((Nat) x) -> Type)
  enum
  (many CubOn : (erased (List (Nat)) n r) (erased (Nat) x) (erased (In x r) p) -> (Cub n r x))
  (many CubThree : (erased (List (Nat)) n r) (erased (Nat) x) (erased (Order n x (Succ (Succ (Succ (Zero))))) o) -> (Cub n r x)))

(def-adts $ (Cubics : ((List (Nat)) n r xs) -> Type)
  enum
  (many CubsNil : (erased (List (Nat)) n r) -> (Cubics n r (Nil (Nat))))
  (many CubsCons : (erased (List (Nat)) n r xs) (erased (Nat) x) (erased (Cub n r x) c) (erased (Cubics n r xs) rest) -> (Cubics n r (Cons (Nat) x xs))))

; Every dart off r has node order 3 (Gonthier's quasicubic r).
(def-adts $ (QuasiCubic : ((Nat) d) ((List (Nat)) n r) -> Type)
  enum
  (many MkQuasiCubic : (erased (Nat) d) (erased (List (Nat)) n r ids) (erased (Iota d ids) io) (erased (Cubics n r ids) cs) -> (QuasiCubic d n r)))

(def-fns _ $ (erased cubics-in : (erased (List (Nat)) n r xs) (erased (Nat) x) (subterm erased (Cubics n r xs) cs) (erased (In x xs) p) -> (erased (Cub n r x) c))
  (let-match erased cs (CubsCons _ _ xs1 y c1 cs1) (absurd (CubsNil _ _) p))
  (let-match erased p (InThere _ _ _ p1) ((InHere _ _) c1))
  (cubics-in n r xs1 x cs1 p1))

(def-fns _ $ (erased cubics-on : (erased (List (Nat)) n r xs) (subterm erased (Sub xs r) sb) -> (erased (Cubics n r xs) c))
  (let-match erased sb (SubCons x xs1 _ p sb1) ((SubNil _) (CubsNil n r)))
  (CubsCons n r xs1 x (CubOn n r x p) (cubics-on n r xs1 sb1)))

(def-fns _ $ (erased cubics-snoc : (erased (List (Nat)) n r xs xs2) (erased (Nat) x) (subterm erased (Cubics n r xs) cs) (erased (Cub n r x) c)
    (erased (Snoc (Nat) xs x xs2) s) -> (erased (Cubics n r xs2) res))
  (match erased cs _
    ((CubsNil _ _) (let-match erased s (SnocNil _ _)) (CubsCons n r (Nil (Nat)) x c (CubsNil n r)))
    ((CubsCons _ _ xs1 y c1 cs1) (let-match erased s (SnocCons _ _ _ _ xs3 s1)) (CubsCons n r xs3 y c1 (cubics-snoc n r xs1 xs3 x cs1 c s1)))))

; In the backward node path a p y, every dart is y or the node image of one of p.
(def-adts $ (Prev : ((List (Nat)) n p) ((Nat) y w) -> Type)
  enum
  (many PrevLast : (erased (List (Nat)) n p) (erased (Nat) y) -> (Prev n p y y))
  (many PrevIn : (erased (List (Nat)) n p) (erased (Nat) y w u) (erased (In u p) iu) (erased (Nth (Nat) n u w) pu) -> (Prev n p y w)))

(def-fns _ $ (erased rpath-prev : (erased (List (Nat)) n p) (erased (Nat) a y w) (subterm erased (RPath n a p y) rp) (erased (In w (Cons (Nat) a p)) i)
    -> (erased (Prev n p y w) r))
  (match erased rp _
    ((RPNil _ _) (let-match erased i (InHere _ _) (absurd (InThere _ _ _ i1) i1)) (PrevLast n p y))
    ((RPCons _ p1 _ z _ pz rp1)
      (let-match erased i (InThere _ _ _ i1) ((InHere _ _) (PrevIn n p y w z (InHere z p1) pz)))
      (let-match erased (rpath-prev n p1 z y w rp1 i1) (PrevIn _ _ _ _ u iu pu) ((PrevLast _ _ _) (PrevLast n p y)))
      (PrevIn n p y w u (InThere u z p1 iu) pu))))

; A ring is shut under the inverse of node.
(def-fns _ $ (erased ring-pre : (erased (Nat) d x w) (erased (List (Nat)) e n f r) (erased (Hypermap d e n f) h) (erased (Cpring n r) cr)
    (erased (Nth (Nat) n x w) px) (erased (In w r) i) -> (erased (In x r) res))
  (let ((erased ei) (erased ni) (erased fi) (erased _) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased cr (MkCpring _ p a y rp back dp))
  (match erased (rpath-prev n p a y w rp i) _
    ((PrevLast _ _ _) (let-match erased (perm-inj d x a y n ni pn px back) (Refl _ _)) (InHere a p))
    ((PrevIn _ _ _ _ u iu pu) (let-match erased (perm-inj d x u w n ni pn px pu) (Refl _ _)) (InThere x a p iu))))

(def-fns _ $ (erased ring-next-out : (erased (Nat) d x y) (erased (List (Nat)) e n f r) (erased (Hypermap d e n f) h) (erased (Cpring n r) cr)
    (erased (Nth (Nat) n x y) px) (erased (NotIn x r) out) -> (erased (NotIn y r) res))
  (let-match erased (in-dec y r) (OrR _ _ o) (absurd (OrL _ _ i) (apart-irrefl x (notin-in x x r out (ring-pre d x y e n f r h cr px i)))))
  o)

(def-fns _ $ (erased mk-order3 : (erased (List (Nat)) p) (erased (Nat) x y z) (erased (Nth (Nat) p x y) px) (erased (Nth (Nat) p y z) py)
    (erased (Nth (Nat) p z x) pz) (erased (Apart (Nat) Lt y x) ny) (erased (Apart (Nat) Lt z x) nz) -> (erased (Order p x (Succ (Succ (Succ (Zero))))) r))
  (let ((erased s)) (Cons (Nat) x (Nil (Nat))))
  (MkOrder p (Cons (Nat) y (Cons (Nat) z (Nil (Nat)))) x y (Succ (Succ (Zero))) px
    (PathStep p s (Cons (Nat) z (Nil (Nat))) y z x py (NotInCons y x (Nil (Nat)) ny (NotInNil y))
      (PathStep p s (Nil (Nat)) z x x pz (NotInCons z x (Nil (Nat)) nz (NotInNil z)) (PathHere p s x)))
    (LengthCons _ y _ (Succ (Zero)) (LengthCons _ z _ (Zero) (LengthNil _)))))

; A node of order 3 off the ring keeps its order when node changes only at the faces t, on the ring.
(def-fns _ $ (erased order3-move : (erased (Nat) d d2 x) (erased (List (Nat)) e n f e2 n2 f2 s t r) (erased (Hypermap d e n f) h)
    (erased (Hypermap d2 e2 n2 f2) h2) (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree f f2 s) gf) (erased (Respects f s t) st)
    (erased (Sub t r) tr) (erased (Cpring n r) cr) (erased (Order n x (Succ (Succ (Succ (Zero))))) o) (erased (NotIn x r) out)
    -> (erased (Order n2 x (Succ (Succ (Succ (Zero))))) res))
  (let-match erased o (MkOrder _ _ _ y _ px _ _))
  (let ((erased z) (erased py) (erased pz) (erased ny) (erased nz)) (order-three n x y o px))
  (let ((erased oy)) (ring-next-out d x y e n f r h cr px out))
  (let ((erased oz)) (ring-next-out d y z e n f r h cr py oy))
  (mk-order3 n2 x y z (node-move d d2 x y e n f e2 n2 f2 s t h h2 ge gf st px (notin-sub x t r tr out))
    (node-move d d2 y z e n f e2 n2 f2 s t h h2 ge gf st py (notin-sub y t r tr oy))
    (node-move d d2 z x e n f e2 n2 f2 s t h h2 ge gf st pz (notin-sub z t r tr oz)) ny nz))

(def-fns _ $ (erased cubics-move : (erased (Nat) d d2) (erased (List (Nat)) e n f e2 n2 f2 s t r r2 xs) (erased (Hypermap d e n f) h)
    (erased (Hypermap d2 e2 n2 f2) h2) (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree f f2 s) gf) (erased (Respects f s t) st)
    (erased (Sub t r) tr) (erased (Cpring n r) cr) (erased (Cubics n2 r2 r) cr2) (subterm erased (Cubics n r xs) cs) -> (erased (Cubics n2 r2 xs) res))
  (let-match erased cs (CubsCons _ _ xs1 x c cs1) ((CubsNil _ _) (CubsNil n2 r2)))
  (let ((erased rest)) (cubics-move d d2 e n f e2 n2 f2 s t r r2 xs1 h h2 ge gf st tr cr cr2 cs1))
  (let-match erased (in-dec x r) (OrR _ _ out) ((OrL _ _ i) (CubsCons n2 r2 xs1 x (cubics-in n2 r2 r x cr2 i) rest)))
  (let-match erased c (CubThree _ _ _ o) (absurd (CubOn _ _ _ i) (apart-irrefl x (notin-in x x r out i))))
  (CubsCons n2 r2 xs1 x (CubThree n2 r2 x (order3-move d d2 x e n f e2 n2 f2 s t r h h2 ge gf st tr cr o out)) rest))

; Where the U step changes face, and the faces t it changes node at.
(def-fns _ $ (erased ecpU-facts : (erased (Nat) d) (erased (List (Nat)) e n f r e2 f2 r2) (erased (PointedMap d e n f r) pm) (erased (EcpU d e f r e2 f2 r2) st)
    -> (erased (List (Nat)) s t) (erased (Agree e e2 (Nil (Nat))) ge) (erased (Agree f f2 s) gf) (erased (Respects f s t) rs) (erased (Sub t r) tr))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h cr))
  (let-match erased st (MkEcpU _ b c _ _ _ _ f0 _ lb pc g sn ins))
  (let-match erased cr (MkCpring _ p a y rp back dp))
  (let-match erased (last-fn r b y lb (rpath-last n p a y rp)) (Refl _ _))
  (let ((erased v) (erased pv) (erased pfa)) (hyper-back d b a e n f h back))
  (let-match erased (nth-fn _ e b c v pc pv) (Refl _ _))
  (let ((erased s) (erased t)) (values (Cons (Nat) c (Nil (Nat))) (Cons (Nat) a (Nil (Nat)))))
  (values s t (grow-agree e e2 d g) (AgTrans f f0 f2 s (AgSnoc f f0 s d sn) (AgInsert f0 f2 s c (Succ d) ins (InHere c (Nil (Nat)))))
    (RespCons f (Nil (Nat)) (Nil (Nat)) c a pfa (RespNil f)) (SubCons a (Nil (Nat)) r (InHere a p) (SubNil r))))

(def-fns _ $ (erased ecpU-cubic : (erased (Nat) d) (erased (List (Nat)) e n f r e2 n2 f2 r2) (erased (PointedMap d e n f r) pm)
    (erased (EcpU d e f r e2 f2 r2) st) (erased (Hypermap (Succ (Succ d)) e2 n2 f2) h2) (erased (QuasiCubic d n r) qc)
    -> (erased (QuasiCubic (Succ (Succ d)) n2 r2) res))
  (let ((erased s) (erased t) (erased ge) (erased gf) (erased rs) (erased tr)) (ecpU-facts d e n f r e2 f2 r2 pm st))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h cr))
  (let-match erased st (MkEcpU _ _ _ _ _ _ _ _ _ _ _ _ _ _))
  (let-match erased qc (MkQuasiCubic _ _ _ ids io cs))
  (let ((erased d1) (erased d2)) (values (Succ d) (Succ (Succ d))))
  (let ((erased sb)) (sub-cons d1 r (Cons (Nat) d r) (sub-cons d r r (sub-refl r))))
  (let ((erased cs2)) (cubics-move d d2 e n f e2 n2 f2 s t r r2 ids h h2 ge gf rs tr cr (cubics-on n2 r2 r sb) cs))
  (let ((erased ids1) (erased s1)) (snoc-exists _ ids d))
  (let ((erased ids2) (erased s2)) (snoc-exists _ ids1 d1))
  (MkQuasiCubic d2 n2 r2 ids2 (IotaS d1 ids1 ids2 (IotaS d ids ids1 io s1) s2)
    (cubics-snoc n2 r2 ids1 ids2 d1 (cubics-snoc n2 r2 ids ids1 d cs2 (CubOn n2 r2 d (InThere d d1 _ (InHere d r))) s1) (CubOn n2 r2 d1 (InHere d1 _)) s2)))

(def-fns _ $ (erased ecpN-cubic : (erased (Nat) d k) (erased (List (Nat)) e n f r e2 n2 f2 r2) (erased (PointedMap d e n f r) pm)
    (erased (EcpN d e f r e2 f2 r2) st) (erased (Hypermap (Succ (Succ d)) e2 n2 f2) h2) (erased (QuasiCubic d n r) qc)
    (erased (Length (Nat) r k) l) (erased (Lt (Succ (Zero)) k) pr) -> (erased (QuasiCubic (Succ (Succ d)) n2 r2) res))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h cr))
  (let-match erased st (MkEcpN _ x0 a ex z ea ez _ _ p _ f1 _ _ px pex pz pea pez g i1 i2 nr))
  (let-match erased qc (MkQuasiCubic _ _ _ ids io cs))
  (let ((erased ei) (erased ni) (erased fi) (erased _) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased d1) (erased d2)) (values (Succ d) (Succ (Succ d))))
  (let-match erased l (LengthCons _ _ _ k1 l1))
  (let-match erased p (Cons _ x1 p1) (absurd (Nil _) (let-match erased l1 (LengthNil _)) (let-match erased pr (LtS _ _ pr1)) pr1))
  (let-match erased px (PtrTwo _ _ _))
