  (let ((erased v) (erased pv) (erased pfx)) (hyper-back d a x0 e n f h nxa))
  (let-match erased (nth-fn _ e a ea v pea pv) (Refl _ _))
  (let ((erased nzx)) (hyper-node d x0 ex z e n f h pex pz))
  (let ((erased lez)) (perm-val d z ez e ei pe pez))
  (let ((erased lz)) (perm-val d ex z f fi pf pz))
  (let ((erased lx0)) (nth-lt-length _ n x0 d a nxa ln))
  (let ((erased w) (erased pw)) (nth-exists _ f d ez lf lez))
  (let ((erased nwz)) (hyper-node d z ez w e n f h pez pw))
  (let-match erased cr (MkCpring _ _ _ y rp back dp))
  (let-match erased dp (DistCons _ _ na _))
  (let-match erased na (NotInCons _ _ _ nax na1))
  (let ((erased nxz)) (let-match erased (nat-eq x0 z) (Unequal _ _ _ _ q)
    (absurd (Equal _ _ _) (apart-irrefl a (match erased (nth-fn _ n x0 a x0 nxa nzx) _ ((Refl _ _) nax))))) q)
  (let ((erased i0)) (InThere x0 a (Cons (Nat) x0 p1) (InHere x0 p1)))
  (let ((erased iz)) (ring-pre d z x0 e n f r h cr nzx i0))
  (let ((erased s) (erased t)) (values (Cons (Nat) ea (Cons (Nat) ez (Nil (Nat)))) (Cons (Nat) x0 (Cons (Nat) w (Nil (Nat))))))
  (let ((erased ag)) (AgTrans f f1 f2 s (AgInsert f f1 s ea d i1 (InHere ea _)) (AgInsert f1 f2 s ez d1 i2 (InThere ez ea _ (InHere ez _)))))
  (let ((erased rs)) (RespCons f _ _ ea x0 pfx (RespCons f _ _ ez w pw (RespNil f))))
  (let ((erased tr)) (SubCons x0 _ r i0 (SubCons w _ r (ring-pre d w z e n f r h cr nwz iz) (SubNil r))))
  (let ((erased f1d)) (insert-new f f1 ea d d x0 i1 lf pfx))
  (let ((erased nexa)) (img-apart d x0 a ex ea e ei pe pex pea (apart-sym a x0 nax)))
  (let ((erased nexz)) (img-apart d x0 z ex ez e ei pe pex pez nxz))
  (let ((erased t1)) (hyper-node d2 d1 d x0 e2 n2 f2 h2 (edge-high e e2 d g) (insert-other f1 f2 ez d1 d x0 i2 f1d (ApGt _ _ d ez lez))))
  (let ((erased t2)) (hyper-node d2 z ez d1 e2 n2 f2 h2 (edge-old e e2 d z ez g pez) (insert-at f1 f2 ez d1 i2)))
  (let ((erased t3)) (hyper-node d2 x0 ex z e2 n2 f2 h2 (edge-old e e2 d x0 ex g pex)
    (insert-other f1 f2 ez d1 ex z i2 (insert-other f f1 ea d ex z i1 pz nexa) nexz)))
  (let ((erased ad1x) (erased ad1z)) (values (ApGt _ _ d1 x0 (lt-weaken x0 d lx0)) (ApGt _ _ d1 z (lt-weaken z d lz))))
  (let ((erased ox)) (mk-order3 n2 x0 d1 z t1 t2 t3 ad1x (apart-sym x0 z nxz)))
  (let ((erased od)) (mk-order3 n2 d1 z x0 t2 t3 t1 (apart-sym d1 z ad1z) (apart-sym d1 x0 ad1x)))
  (let ((erased oz)) (mk-order3 n2 z x0 d1 t3 t1 t2 nxz ad1z))
  (let ((erased (Cubics n2 r2 r) cr2) (erased (In d r2) ind)) (match erased nr _
    ((NRShort _ _ _)
      (let-match erased p1 (Nil _)
        (absurd (Cons _ z2 q)
          (let-match erased rp (RPCons _ _ _ _ _ _ rp1))
          (let-match erased rp1 (RPCons _ _ _ _ _ pz2 _))
          (let-match erased (perm-inj d z2 z x0 n ni pn pz2 nzx) (Refl _ _))
          (let-match erased na1 (NotInCons _ _ _ nz _))
          (apart-irrefl a nz)))
      (values (CubsCons n2 r2 _ a (CubThree n2 r2 a oz) (CubsCons n2 r2 _ x0 (CubThree n2 r2 x0 ox) (CubsNil n2 r2))) (InHere d _)))
    ((NRLong _ _ _ _ z2 q ne)
      (let-match erased rp (RPCons _ _ _ _ _ _ rp1))
      (let-match erased rp1 (RPCons _ _ _ _ _ pz2 _))
      (let-match erased (perm-inj d z2 z x0 n ni pn pz2 nzx) (Refl _ _))
      (let ((erased cq)) (cubics-on n2 r2 q (sub-cons a q (Cons (Nat) d q) (sub-cons d q q (sub-refl q)))))
      (values (CubsCons n2 r2 _ a (CubOn n2 r2 a (InHere a _)) (CubsCons n2 r2 _ x0 (CubThree n2 r2 x0 ox) (CubsCons n2 r2 _ z (CubThree n2 r2 z oz) cq)))
        (InThere d a _ (InHere d q))))))
  (let ((erased ids1) (erased s1)) (snoc-exists _ ids d))
  (let ((erased ids2) (erased s2)) (snoc-exists _ ids1 d1))
  (MkQuasiCubic d2 n2 r2 ids2 (IotaS d1 ids1 ids2 (IotaS d ids ids1 io s1) s2)
    (cubics-snoc n2 r2 ids1 ids2 d1 (cubics-snoc n2 r2 ids ids1 d (cubics-move d d2 e n f e2 n2 f2 s t r r2 ids h h2 (grow-agree e e2 d g) ag rs tr cr cr2 cs)
      (CubOn n2 r2 d ind) s1) (CubThree n2 r2 d1 od) s2)))

; Edge and face fix node.
(def-fns _ $ (erased hyper-fe : (erased (Nat) d) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h)
    -> (erased (List (Nat)) fe) (erased (Respects f e fe) rfe) (erased (Perm d fe n) pm))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let ((erased lfe)) (respects-length f e fe d cfe le))
  (values fe cfe (MkPerm d fe n ids io lfe ke (respects-assoc n e f en fe ids d cen kn cfe lfe le))))

(def-fns _ $ (erased hyper-node-unique : (erased (Nat) d) (erased (List (Nat)) e n f n2) (erased (Hypermap d e n f) h) (erased (Hypermap d e n2 f) h2)
    -> (erased (Eq (List (Nat)) n n2) r))
  (let ((erased fe) (erased r1) (erased p1)) (hyper-fe d e n f h))
  (let ((erased fe2) (erased r2) (erased p2)) (hyper-fe d e n2 f h2))
  (let-match erased (respects-fn f e fe fe2 r1 r2) (Refl _ _))
  (perm-inv-unique d fe n n2 p1 p2))

(def-fns _ $ (erased snoc-in-new : (erased (Nat) x) (erased (List (Nat)) xs xs2) (subterm erased (Snoc (Nat) xs x xs2) s) -> (erased (In x xs2) r))
  (let-match erased s (SnocCons _ y _ xs1 ys1 s1) ((SnocNil _ _) (InHere x (Nil (Nat)))))
  (InThere x y ys1 (snoc-in-new x xs1 ys1 s1)))

(def-fns _ $ (erased snoc-in-old : (erased (Nat) x y) (erased (List (Nat)) xs xs2) (subterm erased (Snoc (Nat) xs x xs2) s) (erased (In y xs) i)
    -> (erased (In y xs2) r))
  (let-match erased s (SnocCons _ z _ xs1 ys1 s1) (absurd (SnocNil _ _) i))
  (let-match erased i (InThere _ _ _ i1) ((InHere _ _) (InHere y ys1)))
  (InThere y z ys1 (snoc-in-old x y xs1 ys1 s1 i1)))

(def-fns _ $ (erased in-rots : (erased (Nat) k y) (erased (List (Nat)) xs ys) (subterm erased (Rots k xs ys) rs) (erased (In y xs) i) -> (erased (In y ys) r))
  (let-match erased rs (RotsS k1 x xs1 xs2 _ s rs1) ((RotsZ _) i))
  (let ((erased (In y xs2) i2)) (match erased i _ ((InHere _ _) (snoc-in-new x xs1 xs2 s)) ((InThere _ _ _ i1) (snoc-in-old x y xs1 xs2 s i1))))
  (in-rots k1 y xs2 ys rs1 i2))

(def-fns _ $ (erased cubics-rot : (erased (Nat) k) (erased (List (Nat)) n r r2 xs) (subterm erased (Cubics n r xs) cs) (erased (Rot k r r2) rt)
    -> (erased (Cubics n r2 xs) res))
  (let-match erased cs (CubsCons _ _ xs1 x c cs1) ((CubsNil _ _) (CubsNil n r2)))
  (let ((erased rest)) (cubics-rot k n r r2 xs1 cs1 rt))
  (let-match erased c (CubOn _ _ _ i) ((CubThree _ _ _ o) (CubsCons n r2 xs1 x (CubThree n r2 x o) rest)))
  (CubsCons n r2 xs1 x (CubOn n r2 x (match erased rt _ ((RotIn _ _ _ _ _ _ rs) (in-rots k x r r2 rs i)) ((RotOver _ _ _ _ _) i))) rest))

(def-fns _ $ (erased quasicubic-rot : (erased (Nat) d k) (erased (List (Nat)) n r r2) (erased (QuasiCubic d n r) qc) (erased (Rot k r r2) rt)
    -> (erased (QuasiCubic d n r2) res))
  (let-match erased qc (MkQuasiCubic _ _ _ ids io cs))
  (MkQuasiCubic d n r2 ids io (cubics-rot k n r r2 ids cs rt)))

(def-fns _ $ (erased quasicubic0 : -> (erased (QuasiCubic (Succ (Succ (Zero))) (Cons (Nat) (Succ (Zero)) (Cons (Nat) (Zero) (Nil (Nat))))
    (Cons (Nat) (Succ (Zero)) (Cons (Nat) (Zero) (Nil (Nat))))) r))
  (let ((erased z) (erased o)) (values (Zero) (Succ (Zero))))
  (let ((erased l1) (erased l0)) (values (Cons (Nat) o (Nil (Nat))) (Cons (Nat) z (Nil (Nat)))))
  (let ((erased sw) (erased id)) (values (Cons (Nat) o l0) (Cons (Nat) z l1)))
  (MkQuasiCubic (Succ (Succ (Zero))) sw sw id (IotaS o l0 id (IotaS z (Nil (Nat)) l0 (IotaZ) (SnocNil _ z)) (SnocCons _ z o (Nil (Nat)) l1 (SnocNil _ o)))
    (CubsCons sw sw l1 z (CubOn sw sw z (InThere z o l0 (InHere z (Nil (Nat))))) (CubsCons sw sw (Nil (Nat)) o (CubOn sw sw o (InHere o l0)) (CubsNil sw sw)))))

(def-fns _ $ (erased pointed-hyper : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (PointedMap d e n f r) pm) -> (erased (Hypermap d e n f) h))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h _))
  h)

(def-fns _ $ (erased under-grow : (erased (List (Nat)) xs xs2) (erased (Nat) x b) (subterm erased (Under xs b) u) (erased (Lt x b) lx)
    (erased (Snoc (Nat) xs x xs2) s) -> (erased (Under xs2 b) r))
  (match erased u _
    ((UnderNil _) (let-match erased s (SnocNil _ _)) (UnderCons (Nil (Nat)) x b lx (UnderNil b)))
    ((UnderCons xs1 y _ ly u1) (let-match erased s (SnocCons _ _ _ _ xs3 s1)) (UnderCons xs3 y b ly (under-grow xs1 xs3 x b u1 lx s1)))))

; A colouring extended over a new edge d-(d+1) whose darts take the colours cd and cd1, given those keep the face
; colours of f2 (Snoc'd or Insert'ed from f) and differ.
(def-fns _ $ (erased color-grow : (erased (Nat) d cd cd1) (erased (List (Nat)) e f e2 f2 ks ks1 ks2) (erased (FourColoring e f ks) col)
    (erased (Length (Nat) ks d) lk) (erased (EdgeGrow e d e2) g) (erased (Snoc (Nat) ks cd ks1) s1) (erased (Snoc (Nat) ks1 cd1 ks2) s2)
    (erased (Respects ks2 f2 ks2) face) (erased (Lt cd 4) l1) (erased (Lt cd1 4) l2)
    (erased (Apart (Nat) Lt cd cd1) ne) -> (erased (FourColoring e2 f2 ks2) r))
  (let-match erased col (MkFourColoring _ _ _ ke _ ce edge four))
  (let-match erased g (MkEdgeGrow _ e1 _ _ len se1 se2))
  (let ((erased ke1) (erased sk1)) (snoc-exists _ ke cd1))
  (let ((erased ke2) (erased sk2)) (snoc-exists _ ke1 cd))
  (let ((erased lk1)) (snoc-length _ ks ks1 cd d s1 lk))
  (let ((erased ce2)) (respects-lab ks1 ks2 e ke cd1 (respects-lab ks ks1 e ke cd ce s1) s2))
  (MkFourColoring e2 f2 ks2 ke2 face
    (respects-snoc ks2 e1 e2 ke1 ke2 d cd (respects-snoc ks2 e e1 ke ke1 (Succ d) cd1 ce2 (snoc-new _ ks1 ks2 cd1 (Succ d) s2 lk1) se1 sk1)
      (snoc-old _ ks1 ks2 cd1 cd d s2 (snoc-new _ ks ks1 cd d s1 lk)) se2 sk2)
    (differ-snoc ke1 ks1 ke2 ks2 cd cd1 (differ-snoc ke ks ke1 ks1 cd1 cd edge sk1 s1 (apart-sym cd cd1 ne)) sk2 s2 ne)
    (under-grow ks1 ks2 cd1 _ (under-grow ks ks1 cd _ four l1 s1) l2 s2)))

; A colouring of the map before a U step, with c for the new face, colours the map after it; the ring colours gain c and
; the colour of the head.
(def-fns _ $ (erased ecpU-color : (erased (Nat) d c ka) (erased (List (Nat)) e n f r e2 f2 r2 ks rc) (erased (PointedMap d e n f r) pm)
    (erased (EcpU d e f r e2 f2 r2) st) (erased (FourColoring e f ks) col) (erased (Respects ks r (Cons (Nat) ka rc)) rr)
    (erased (Lt c 4) lc) (erased (Apart (Nat) Lt c ka) ne)
    -> (erased (List (Nat)) ks2) (erased (FourColoring e2 f2 ks2) col2) (erased (Respects ks2 r2 (Cons (Nat) ka (Cons (Nat) c (Cons (Nat) ka rc)))) rr2))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h cr))
  (let-match erased st (MkEcpU _ b c0 _ _ _ _ f0 _ lb pc g s ins))
  (let-match erased cr (MkCpring _ p a y rp back dp))
  (let-match erased (last-fn r b y lb (rpath-last n p a y rp)) (Refl _ _))
  (let ((erased v) (erased pv) (erased pfa)) (hyper-back d b a e n f h back))
  (let-match erased (nth-fn _ e b c0 v pc pv) (Refl _ _))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let-match erased col (MkFourColoring _ _ _ ke face ce edge four))
  (let ((erased lk)) (respects-length ks f ks d face lf))
  (let-match erased rr (RespCons _ _ _ _ _ pka rr1))
  (let ((erased l0) (erased p0)) (nth-exists _ ks d c0 lk (nth-lt-length _ f c0 d a pfa lf)))
  (let-match erased (nth-fn _ ks a ka l0 pka (respects-nth ks f ks c0 a l0 face pfa p0)) (Refl _ _))
  (let ((erased ks1) (erased s1)) (snoc-exists _ ks c))
  (let ((erased ks2) (erased s2)) (snoc-exists _ ks1 ka))
  (let ((erased lk1)) (snoc-length _ ks ks1 c d s1 lk))
  (let ((erased face2)) (respects-insert ks1 ks2 f0 f2 c0 (Succ d) d ka (respects-new ks ks1 f f0 d c face s lk s1) ins lk1 (snoc-old _ ks ks1 c ka c0 s1 p0) s2))
  (let ((erased lka)) (under-nth ks a ka _ four pka))
  (values ks2 (color-grow d c ka e f e2 f2 ks ks1 ks2 col lk g s1 s2 face2 lc lka ne)
    (RespCons ks2 (Cons (Nat) d r) (Cons (Nat) c (Cons (Nat) ka rc)) (Succ d) ka (snoc-new _ ks1 ks2 ka (Succ d) s2 lk1)
      (RespCons ks2 r (Cons (Nat) ka rc) d c (snoc-old _ ks1 ks2 ka c d s2 (snoc-new _ ks ks1 c d s1 lk)) (respects-lab ks1 ks2 r _ ka (respects-lab ks ks1 r _ c rr s1) s2)))))

; The colours rc of a ring of at least three darts, the colours kx of its second dart and kw of its fourth (its first,
; for three darts), and rc without its third.
(def-adts $ (Ring3 : ((List (Nat)) rc) ((Nat) kx kw) ((List (Nat)) rc2) -> Type)
  enum
  (many R3Four : (erased (Nat) ka kx kz kw) (erased (List (Nat)) q)
      -> (Ring3 (Cons (Nat) ka (Cons (Nat) kx (Cons (Nat) kz (Cons (Nat) kw q)))) kx kw (Cons (Nat) ka (Cons (Nat) kx (Cons (Nat) kw q)))))
  (many R3Three : (erased (Nat) ka kx kz)
      -> (Ring3 (Cons (Nat) ka (Cons (Nat) kx (Cons (Nat) kz (Nil (Nat))))) kx ka (Cons (Nat) ka (Cons (Nat) kx (Nil (Nat)))))))

; A colouring of the map before an N step colours the map after it, d taking the colour of x0 and d+1 that of the fourth
; dart of the ring, when those differ.
(def-fns _ $ (erased ecpN-color : (erased (Nat) d kx kw) (erased (List (Nat)) e n f r e2 f2 r2 ks rc rc2) (erased (PointedMap d e n f r) pm)
    (erased (EcpN d e f r e2 f2 r2) st) (erased (FourColoring e f ks) col) (erased (Respects ks r rc) rr) (erased (Ring3 rc kx kw rc2) r3)
    (erased (Apart (Nat) Lt kx kw) ne) -> (erased (List (Nat)) ks2) (erased (FourColoring e2 f2 ks2) col2) (erased (Respects ks2 r2 rc2) rr2))
  (let-match erased pm (MkPointedMap _ _ _ _ _ h cr))
  (let-match erased st (MkEcpN _ x0 a ex z ea ez _ _ p _ f1 _ _ px pex pz pea pez g i1 i2 nr))
  (let ((erased ei) (erased ni) (erased fi) (erased _) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let-match erased col (MkFourColoring _ _ _ ke face ce edge four))
  (let ((erased lk)) (respects-length ks f ks d face lf))
  (let-match erased rr (RespCons _ _ rc1 _ ka pka rr1))
  (let-match erased rr1 (RespCons _ p1 rc3 x1 kx1 pkx rr3) (absurd (RespNil _) r3))
  (let-match erased rr3 (RespCons _ q qc z2 kz pkz rrq) (absurd (RespNil _) r3))
  (let-match erased px (PtrTwo _ _ _))
  (let ((erased nxa)) (ptr-node a x0 n p cr px))
  (let ((erased v) (erased pv) (erased pfx)) (hyper-back d a x0 e n f h nxa))
  (let-match erased (nth-fn _ e a ea v pea pv) (Refl _ _))
  (let ((erased nzx)) (hyper-node d x0 ex z e n f h pex pz))
  (let-match erased cr (MkCpring _ _ _ y rp back dp))
  (let-match erased rp (RPCons _ _ _ _ _ _ rp1))
  (let-match erased rp1 (RPCons _ _ _ _ _ pz2 rp2))
  (let-match erased (perm-inj d z2 z x0 n ni pn pz2 nzx) (Refl _ _))
  (let-match erased nr (NRLong _ _ _ _ _ _ nza)
    (absurd (NRShort _ _ _)
      (let-match erased dp (DistCons _ _ na _))
      (let-match erased na (NotInCons _ _ _ _ na1))
      (let-match erased na1 (NotInCons _ _ _ nz _))
      (apart-irrefl a nz)))
  (let ((erased lez)) (perm-val d z ez e ei pe pez))
  (let ((erased w) (erased pw)) (nth-exists _ f d ez lf lez))
  (let ((erased nwz)) (hyper-node d z ez w e n f h pez pw))
  (let ((erased (Nth (Nat) ks w kw) pkw) (erased (Eq (List (Nat)) rc2 (Cons (Nat) ka (Cons (Nat) kx qc))) q2) (erased (Eq (Nat) kx kx1) q3))
    (match erased r3 _
      ((R3Four _ _ _ _ _)
        (let-match erased rrq (RespCons _ _ _ w2 _ pkw2 _))
        (let-match erased rp2 (RPCons _ _ _ _ _ pw2 _))
        (let-match erased (perm-inj d w2 w z n ni pn pw2 nwz) (Refl _ _))
        (values pkw2 (Refl _ rc2) (Refl _ kx)))
      ((R3Three _ _ _)
        (let-match erased rrq (RespNil _))
        (let-match erased rp2 (RPNil _ _))
        (let-match erased (perm-inj d a w z n ni pn back nwz) (Refl _ _))
        (values pka (Refl _ rc2) (Refl _ kx)))))
  (let-match erased q2 (Refl _ _))
  (let-match erased q3 (Refl _ _))
  (let ((erased l0) (erased p0)) (nth-exists _ ks d ea lk (perm-val d a ea e ei pe pea)))
  (let-match erased (nth-fn _ ks x0 kx l0 pkx (respects-nth ks f ks ea x0 l0 face pfx p0)) (Refl _ _))
  (let ((erased l1) (erased pl1)) (nth-exists _ ks d ez lk lez))
  (let-match erased (nth-fn _ ks w kw l1 pkw (respects-nth ks f ks ez w l1 face pw pl1)) (Refl _ _))
  (let ((erased ks1) (erased s1)) (snoc-exists _ ks kx))
  (let ((erased ks2) (erased s2)) (snoc-exists _ ks1 kw))
  (let ((erased lk1)) (snoc-length _ ks ks1 kx d s1 lk))
  (let ((erased face2)) (respects-insert ks1 ks2 f1 f2 ez (Succ d) d kw (respects-insert ks ks1 f f1 ea d d kx face i1 lk p0 s1) i2 lk1
    (snoc-old _ ks ks1 kx kw ez s1 pl1) s2))
  (values ks2 (color-grow d kx kw e f e2 f2 ks ks1 ks2 col lk g s1 s2 face2 (under-nth ks x0 kx _ four pkx) (under-nth ks w kw _ four pkw) ne)
    (RespCons ks2 (Cons (Nat) d q) (Cons (Nat) kx qc) a ka (snoc-old _ ks1 ks2 kw ka a s2 (snoc-old _ ks ks1 kx ka a s1 pka))
      (RespCons ks2 q qc d kx (snoc-old _ ks1 ks2 kw kx d s2 (snoc-new _ ks ks1 kx d s1 lk)) (respects-lab ks1 ks2 q qc kw (respects-lab ks ks1 q qc kx rrq s1) s2)))))
