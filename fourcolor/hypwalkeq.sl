; The equality case of the Walkup genus (genus_WalkupE_eq of walkup.v), for the WalkupE that keeps z as a dart fixed by
; all three permutations: when z is fixed by n, f or e, or n z is not on the edge cycle of z, the genus is kept.

(def-fns _ $ (erased shut-fixed : (erased (Nat) d z) (erased (List (Nat)) p q) (erased (List (Bond)) g) (erased (Perm d p q) pm)
    (erased (Nth (Nat) p z z) pz) (subterm erased (Fun p g) fg) -> (erased (Shut (Cons (Nat) z (Nil (Nat))) g) r))
  (let-match erased fg (FunCons _ g1 x y px f1) ((FunNil _) (ShutNil _)))
  (let ((erased rest)) (shut-fixed d z p q g1 pm pz f1))
  (let-match erased (nat-eq x z) (Unequal _ _ _ _ nxz)
    ((Equal _ _ _) (let-match erased (nth-fn _ p x y x px pz) (Refl _ _)) (ShutIn _ g1 x x (InHere x _) (InHere x _) rest)))
  (let-match erased (nat-eq y z) (Unequal _ _ _ _ nyz)
    (absurd (Equal _ _ _) (let-match erased (perm-inj d x z y p q pm px pz) (Refl _ _)) (apart-irrefl x nxz)))
  (ShutOut _ g1 x y (NotInCons x z _ nxz (NotInNil x)) (NotInCons y z _ nyz (NotInNil y)) rest))

(def-fns _ $ (erased shut-cat : (erased (List (Nat)) s) (erased (List (Bond)) g h gh) (subterm erased (Cat g h gh) c) (erased (Shut s g) sg)
    (erased (Shut s h) shx) -> (erased (Shut s gh) r))
  (let-match erased c (CatCons g1 _ gh1 b c1) ((CatNil _) shx))
  (match erased sg _
    ((ShutIn _ _ x y px py rest) (ShutIn s gh1 x y px py (shut-cat s g1 h gh1 c1 rest shx)))
    ((ShutOut _ _ x y px py rest) (ShutOut s gh1 x y px py (shut-cat s g1 h gh1 c1 rest shx)))))

(def-fns _ $ (erased fixed-walk : (erased (List (Nat)) p s xs) (erased (Nat) z y) (erased (Nth (Nat) p z z) pz) (subterm erased (Path p s z y xs) w)
    -> (erased (Eq (Nat) y z) r))
  (let-match erased w (PathStep _ _ xs1 _ z1 _ px _ w1) ((PathHere _ _ _) (Refl _ z)))
  (let-match erased (nth-fn _ p z z1 z px pz) (Refl _ _))
  (fixed-walk p s xs1 z y pz w1))

; Cutting z out of its face cycle, w the dart before it, keeps the genus when w and z are on different edge cycles.
(def-fns _ $ (erased face-keep-merge : (erased (Nat) d gen w z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Nth (Nat) f w z) pw) (erased (Apart (Nat) Lt w z) ne) (erased (Lt w d) lw) (erased (Seps e z w) sz)
    -> (erased (Nat) b2) (erased (List (Nat)) f2 e2) (erased (Nth (Nat) f z b2) pb) (erased (Upd2 f w b2 z z f2) up) (erased (Hypermap d e2 n f2) h2)
    (erased (Genus d e2 n f2 gen) p2))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pn) (erased pf) (erased kx) (erased kn) (erased kf) (erased kc)
      (erased ox) (erased on) (erased of) (erased gn) (erased gf) (erased g) (erased grn) (erased grf) (erased cg) (erased b2) (erased f2)
      (erased fi2) (erased e2) (erased c2) (erased pb) (erased up) (erased pf2) (erased h2) (erased gen2) (erased kx2) (erased kc2) (erased p2)
      (erased rc2) (erased ox2) (erased gf2) (erased g2) (erased grf2) (erased cg2) (erased cs2) (erased es2))
    (face-frame d gen w z e n f h p pw ne lw))
  (let ((erased pc)) (perm-sym d e c pe))
  (let ((erased lz)) (perm-val d w z f fi pf pw))
  (let-match erased (orbits-dec d kx z w c e pc ox lz lw) (OrR _ _ sc)
    (absurd (OrL _ _ sp)
      (let-match erased sp (MkSomePath _ _ xs _ _ wp))
      (let-match erased sz (MkSeps _ lab _ _ se))
      (let ((erased ge) (erased gre)) (perm-graph d e c pe))
      (let ((erased gc) (erased grc)) (perm-graph d c e pc))
      (sep-conn ge z w (sep-of-separates d z w lab e ge gre se)
        (spans-conn ge gc z w (path-graph-conn d z w c _ xs gc wp grc) (spans-inv d e c ge gc (graph-fun d c gc grc) pc gre)))))
  (let-match erased sc (MkSeps _ lab _ _ se))
  (let ((erased cs3) (erased es3))
    (euler-merge d kn kf kx kx2 kc2 gen2 w z b2 n ni f fi c f2 fi2 c2 lab gn gf g gf2 g2 pn pf pf2 rc rc2 ox ox2 grn grf grf2 cg cg2 pw pb up cs2 es2 se))
  (let-match erased (genus-unique d gen gen2 e n f p (core-genus d kx kn kf kc2 gen2 e n f c ni fi gn gf g pe rc pn pf ox on of grn grf cg cs3 es3))
    (Refl _ _))
  (values b2 f2 e2 pb up h2 p2))

; Cutting z out of its face cycle keeps the genus when n fixes z, which the cut leaves on its own.
(def-fns _ $ (erased face-keep-iso : (erased (Nat) d gen w z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Nth (Nat) f w z) pw) (erased (Apart (Nat) Lt w z) ne) (erased (Lt w d) lw) (erased (Nth (Nat) n z z) pnz)
    -> (erased (Nat) b2) (erased (List (Nat)) f2 e2) (erased (Nth (Nat) f z b2) pb) (erased (Upd2 f w b2 z z f2) up) (erased (Hypermap d e2 n f2) h2)
    (erased (Genus d e2 n f2 gen) p2))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pn) (erased pf) (erased kx) (erased kn) (erased kf) (erased kc)
      (erased ox) (erased on) (erased of) (erased gn) (erased gf) (erased g) (erased grn) (erased grf) (erased cg) (erased b2) (erased f2)
      (erased fi2) (erased e2) (erased c2) (erased pb) (erased up) (erased pf2) (erased h2) (erased gen2) (erased kx2) (erased kc2) (erased p2)
      (erased rc2) (erased ox2) (erased gf2) (erased g2) (erased grf2) (erased cg2) (erased cs2) (erased es2))
    (face-frame d gen w z e n f h p pw ne lw))
  (let ((erased pc)) (perm-sym d e c pe))
  (let ((erased lz)) (perm-val d w z f fi pf pw))
  (let ((erased v) (erased pv)) (nth-exists _ c d w (perm-length d c e pc) lw))
  (let-match erased (nth-fn _ n z v z (respects-nth n f c w z v rc pw pv) pnz) (Refl _ _))
  (let ((erased xs) (erased cw)) (cycle d w z c e pc pv lw))
  (let ((erased sep)) (shut-sep d w z _ g2
    (shut-cat _ gn gf2 g2 cg2 (shut-fixed d z n ni gn pn pnz (graph-fun d n gn grn)) (shut-fixed d z f2 fi2 gf2 pf2 (upd2-b f f2 w b2 z z up) (graph-fun d f2 gf2 grf2)))
    (below-cat gn gf2 g2 d cg2 (graph-below d n ni gn (graph-fun d n gn grn) pn) (graph-below d f2 fi2 gf2 (graph-fun d f2 gf2 grf2) pf2))
    (NotInCons w z _ ne (NotInNil w)) (InHere z _) lw lz))
  (let ((erased kc3) (erased cs3) (erased es3))
    (euler-split d kn kf kx kx2 kc2 gen2 w z b2 n ni f fi c f2 fi2 c2 xs gn gf g gf2 g2 pn pf pf2 rc rc2 ox ox2 grn grf grf2 cg cg2 pw pb up cs2 es2 cw sep))
  (let-match erased (genus-unique d gen gen2 e n f p (core-genus d kx kn kf kc3 gen2 e n f c ni fi gn gf g pe rc pn pf ox on of grn grf cg cs3 es3))
    (Refl _ _))
  (values b2 f2 e2 pb up h2 p2))

; Cutting z out of its node cycle keeps the genus when f fixes z, through the dual as walkup-node does.
(def-fns _ $ (erased node-keep-iso : (erased (Nat) d gen w z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Nth (Nat) n w z) pw) (erased (Apart (Nat) Lt w z) ne) (erased (Lt w d) lw) (erased (Nth (Nat) f z z) pfz)
    -> (erased (Nat) b2) (erased (List (Nat)) n2 e2) (erased (Nth (Nat) n z b2) pb) (erased (Upd2 n w b2 z z n2) up) (erased (Hypermap d e2 n2 f) h2)
    (erased (Genus d e2 n2 f gen) p2))
  (let ((erased ei) (erased fi) (erased ni) (erased hd) (erased pe) (erased pf) (erased pn) (erased pd)) (genus-dual d gen e n f h p))
  (let ((erased lz)) (perm-val d w z n ni pn pw))
  (let ((erased b2) (erased pb) (erased lb2)) (perm-nth d z n ni pn lz))
  (let ((erased pbi)) (perm-inv d z b2 n ni pn pb))
  (let ((erased w2) (erased ni2) (erased e2) (erased pw2) (erased ui) (erased h2) (erased p2))
    (face-keep-iso d gen b2 z ei fi ni hd pd pbi (apart-sym z b2 (img-apart d w z z b2 n ni pn pw pb ne)) lb2 (perm-inv d z z f fi pf pfz)))
  (let-match erased (nth-fn _ ni z w2 w pw2 (perm-inv d w z n ni pn pw)) (Refl _ _))
  (let ((erased n2) (erased un) (erased pn2)) (perm-swap d b2 z z w ni n ni2 (perm-sym d n ni pn) pbi pw2 ui))
  (let ((erased e3) (erased n3) (erased f3) (erased h3) (erased _) (erased pn3) (erased pf3) (erased p3)) (genus-dual d gen e2 fi ni2 h2 p2))
  (let-match erased (perm-inv-unique d ni2 n3 n2 pn3 pn2) (Refl _ _))
  (let-match erased (perm-inv-unique d fi f3 f pf3 (perm-sym d f fi pf)) (Refl _ _))
  (values b2 n3 e3 pb un h3 p3))

; glink z z or ~~ cross_edge z: z is fixed by n, f or e, or n z is on another edge cycle.
(def-adts $ (Keeps : ((List (Nat)) e n f) ((Nat) z) -> Type)
  enum
  (many KeepNode : (erased (List (Nat)) e n f) (erased (Nat) z) (erased (Nth (Nat) n z z) pz) -> (Keeps e n f z))
  (many KeepFace : (erased (List (Nat)) e n f) (erased (Nat) z) (erased (Nth (Nat) f z z) pz) -> (Keeps e n f z))
  (many KeepEdge : (erased (List (Nat)) e n f) (erased (Nat) z) (erased (Nth (Nat) e z z) pz) -> (Keeps e n f z))
  (many KeepCut : (erased (List (Nat)) e n f) (erased (Nat) z z2) (erased (Nth (Nat) n z z2) pz) (erased (Seps e z z2) sp) -> (Keeps e n f z)))

(def-fns _ $ (erased face-keep : (erased (Nat) d gen z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Lt z d) lz) (erased (Keeps e n f z) kp)
    -> (erased (List (Nat)) f2 e2) (erased (Skip f z f2) sk) (erased (Hypermap d e2 n f2) h2) (erased (Genus d e2 n f2 gen) p2))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased w) (erased pwi) (erased lw)) (perm-nth d z fi f (perm-sym d f fi pf) lz))
  (let ((erased pw)) (perm-inv d z w fi f (perm-sym d f fi pf) pwi))
  (let-match erased (nat-eq w z) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values f e (SkipFixed f z pw) h p)))
  (let-match erased kp (KeepNode _ _ _ _ pnz)
    ((KeepEdge _ _ _ _ pez)
      (let ((erased ke) (erased oe)) (orbits-exists d e c pe))
      (let-match erased (orbits-dec d ke z w e c pe oe lz lw) (OrR _ _ sz)
        (absurd (OrL _ _ sp) (let-match erased sp (MkSomePath _ _ xs _ _ wz)) (let-match erased (fixed-walk e _ xs z w pez wz) (Refl _ _)) (apart-irrefl w ne)))
      (let ((erased b2) (erased f2) (erased e2) (erased pb) (erased up) (erased h2) (erased p2)) (face-keep-merge d gen w z e n f h p pw ne lw sz))
      (values f2 e2 (SkipCut f f2 z w b2 pw pb ne up) h2 p2))
    ((KeepCut _ _ _ _ z2 pz2 sz2)
      (let-match erased sz2 (MkSeps _ lab _ _ se))
      (let-match erased se (MkSeparates _ _ _ _ l1 l2 rp p1 p2 differ))
      (let ((erased pl)) (respects-nth lab e lab z2 w l2 rp (hyper-third d z2 z w n f e (hyper-rot d e n f h) pz2 pw) p2))
      (let ((erased b2) (erased f2) (erased e2) (erased pb) (erased up) (erased h2) (erased p3))
        (face-keep-merge d gen w z e n f h p pw ne lw (MkSeps e lab z w (MkSeparates lab e z w l1 l2 rp p1 pl differ))))
      (values f2 e2 (SkipCut f f2 z w b2 pw pb ne up) h2 p3))
    (absurd (KeepFace _ _ _ _ pfz) (let-match erased (perm-inj d w z z f fi pf pw pfz) (Refl _ _)) (apart-irrefl w ne)))
  (let ((erased b2) (erased f2) (erased e2) (erased pb) (erased up) (erased h2) (erased p2)) (face-keep-iso d gen w z e n f h p pw ne lw pnz))
  (values f2 e2 (SkipCut f f2 z w b2 pw pb ne up) h2 p2))

; genus_WalkupE_eq: WalkupE at such a z keeps the genus.
(def-fns _ $ (erased genus-walkup-eq : (erased (Nat) d gen z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Lt z d) lz) (erased (Keeps e n f z) kp)
    -> (erased (List (Nat)) e2 n2 f2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Genus d e2 n2 f2 gen) p2))
  (let ((erased f1) (erased e1) (erased skf) (erased h1) (erased p1)) (face-keep d gen z e n f h p lz kp))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pn) (erased pf)) (hyper-core d e1 n f1 h1))
  (let ((erased w) (erased pwi) (erased lw)) (perm-nth d z ni n (perm-sym d n ni pn) lz))
  (let ((erased pw)) (perm-inv d z w ni n (perm-sym d n ni pn) pwi))
  (let-match erased (nat-eq w z) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values e1 n f1 (SkipFixed n z pw) skf h1 p1)))
  (let ((erased b2) (erased n2) (erased e2) (erased pb) (erased up) (erased h2) (erased p2))
    (node-keep-iso d gen w z e1 n f1 h1 p1 pw ne lw (skip-fixed f f1 z skf)))
  (values e2 n2 f1 (SkipCut n n2 z w b2 pw pb ne up) skf h2 p2))

; Away from z and n z, and from the dart e sends to z, WalkupE leaves the edge permutation as it was.
(def-fns _ $ (erased edge-keep : (erased (Nat) d z nz a y) (erased (List (Nat)) e n f e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf) (erased (Nth (Nat) n z nz) pnz)
    (erased (Nth (Nat) e a y) pa) (erased (Apart (Nat) Lt a z) az) (erased (Apart (Nat) Lt a nz) anz) (erased (Apart (Nat) Lt y z) yz)
    -> (erased (Nth (Nat) e2 a y) r))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased fy) (erased pfy) (erased _)) (perm-nth d y f fi pf (perm-val d a y e c pe pa)))
  (let ((erased w) (erased pw) (erased _)) (perm-nth d nz e c pe (perm-val d z nz n ni pn pnz)))
  (let-match erased (nat-eq fy z) (Unequal _ _ _ _ fyz)
    (absurd (Equal _ _ _)
      (let-match erased (perm-inj d y w fy f fi pf pfy (hyper-third d w nz z e n f h pw pnz)) (Refl _ _))
      (let-match erased (perm-inj d a nz y e c pe pa pw) (Refl _ _))
      (apart-irrefl a anz)))
  (let ((erased pny)) (hyper-third d fy y a f e n (hyper-rot d n f e (hyper-rot d e n f h)) pfy pa))
  (hyper-third d a fy y n2 f2 e2 (hyper-rot d e2 n2 f2 h2) (skip-keep z fy a n n2 skn pny fyz az) (skip-keep z y fy f f2 skf pfy yz fyz)))

; The labellings lab1 and lab2, constant along e, give the darts of a walk the labels of u, unlike those of z and n z.
(def-adts $ (Away : ((List (Nat)) e lab1 lab2) ((Nat) a z nz) -> Type)
  enum
  (many MkAway : (erased (List (Nat)) e lab1 lab2) (erased (Nat) a z nz l1 l2 m1 m2) (erased (Respects lab1 e lab1) r1) (erased (Respects lab2 e lab2) r2)
      (erased (Nth (Nat) lab1 a l1) pa1) (erased (Nth (Nat) lab1 z m1) pz1) (erased (Apart (Nat) Lt l1 m1) ne1)
      (erased (Nth (Nat) lab2 a l2) pa2) (erased (Nth (Nat) lab2 nz m2) pz2) (erased (Apart (Nat) Lt l2 m2) ne2) -> (Away e lab1 lab2 a z nz)))

(def-fns _ $ (erased label-apart : (erased (List (Nat)) lab) (erased (Nat) x y l m) (erased (Nth (Nat) lab x l) px) (erased (Nth (Nat) lab y m) py)
    (erased (Apart (Nat) Lt l m) ne) -> (erased (Apart (Nat) Lt x y) r))
  (let-match erased (nat-eq x y) (Unequal _ _ _ _ nxy)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ lab x l m px py) (Refl _ _)) (apart-irrefl l ne)))
  nxy)

(def-fns _ $ (erased away-step : (erased (Nat) a b z nz) (erased (List (Nat)) e lab1 lab2) (erased (Away e lab1 lab2 a z nz) aw) (erased (Nth (Nat) e a b) pab)
    -> (erased (Away e lab1 lab2 b z nz) r) (erased (Apart (Nat) Lt a z) az) (erased (Apart (Nat) Lt a nz) anz) (erased (Apart (Nat) Lt b z) bz))
  (let-match erased aw (MkAway _ _ _ _ _ _ l1 l2 m1 m2 r1 r2 pa1 pz1 ne1 pa2 pz2 ne2))
  (let ((erased pb1)) (respects-nth lab1 e lab1 a b l1 r1 pab pa1))
  (let ((erased pb2)) (respects-nth lab2 e lab2 a b l2 r2 pab pa2))
  (values (MkAway e lab1 lab2 b z nz l1 l2 m1 m2 r1 r2 pb1 pz1 ne1 pb2 pz2 ne2)
    (label-apart lab1 a z l1 m1 pa1 pz1 ne1) (label-apart lab2 a nz l2 m2 pa2 pz2 ne2) (label-apart lab1 b z l1 m1 pb1 pz1 ne1)))

(def-fns _ $ (erased cskip-same : (erased (Nat) d z nz u v) (erased (List (Nat)) e n f e2 n2 f2 lab1 lab2 s xs) (erased (Hypermap d e n f) h)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf) (erased (Nth (Nat) n z nz) pnz)
    (erased (Away e lab1 lab2 u z nz) aw) (subterm erased (Path e s u v xs) w) -> (erased (Path e2 (Nil (Nat)) u v xs) r))
  (let-match erased w (PathStep _ _ xs1 _ u1 _ pu _ w1) ((PathHere _ _ _) (PathHere e2 _ u)))
  (let ((erased aw1) (erased az) (erased anz) (erased bz)) (away-step u u1 z nz e lab1 lab2 aw pu))
  (PathStep e2 _ xs1 u u1 v (edge-keep d z nz u u1 e n f e2 n2 f2 h h2 skn skf pnz pu az anz bz) (NotInNil u)
    (cskip-same d z nz u1 v e n f e2 n2 f2 lab1 lab2 s xs1 h h2 skn skf pnz aw1 w1)))

(def-fns _ $ (erased cskip-same-back : (erased (Nat) d z nz u v) (erased (List (Nat)) e n f e2 n2 f2 lab1 lab2 s xs) (erased (Hypermap d e n f) h)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf) (erased (Nth (Nat) n z nz) pnz)
    (erased (Away e lab1 lab2 u z nz) aw) (subterm erased (Path e2 s u v xs) w) -> (erased (Path e (Nil (Nat)) u v xs) r))
  (let-match erased w (PathStep _ _ xs1 _ u1 _ pu _ w1) ((PathHere _ _ _) (PathHere e _ u)))
  (let ((erased c) (erased ni) (erased fi) (erased rc) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased le2) (erased _) (erased _)) (hyper-lengths d e2 n2 f2 h2))
  (let ((erased y) (erased py) (erased _)) (perm-nth d u e c pe (nth-lt-length _ e2 u d u1 pu le2)))
  (let ((erased aw1) (erased az) (erased anz) (erased yz)) (away-step u y z nz e lab1 lab2 aw py))
  (let-match erased (nth-fn _ e2 u u1 y pu (edge-keep d z nz u y e n f e2 n2 f2 h h2 skn skf pnz py az anz yz)) (Refl _ _))
  (PathStep e _ xs1 u u1 v py (NotInNil u) (cskip-same-back d z nz u1 v e n f e2 n2 f2 lab1 lab2 s xs1 h h2 skn skf pnz aw1 w1)))

(def-fns _ $ (erased seps-away : (erased (Nat) u z nz) (erased (List (Nat)) e) (erased (Seps e u z) s1) (erased (Seps e u nz) s2)
    -> (erased (List (Nat)) lab1 lab2) (erased (Away e lab1 lab2 u z nz) aw))
  (let-match erased s1 (MkSeps _ lab1 _ _ se1))
  (let-match erased se1 (MkSeparates _ _ _ _ l1 m1 r1 pa1 pz1 ne1))
  (let-match erased s2 (MkSeps _ lab2 _ _ se2))
  (let-match erased se2 (MkSeparates _ _ _ _ l2 m2 r2 pa2 pz2 ne2))
  (values lab1 lab2 (MkAway e lab1 lab2 u z nz l1 l2 m1 m2 r1 r2 pa1 pz1 ne1 pa2 pz2 ne2)))

; same_cskip_edge: for u on neither the edge cycle of z nor that of n z, WalkupE at z keeps the edge cycle of u.
(def-fns _ $ (erased same-cskip-to : (erased (Nat) d z nz u v) (erased (List (Nat)) e n f e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf) (erased (Nth (Nat) n z nz) pnz)
    (erased (Seps e u z) s1) (erased (Seps e u nz) s2) (erased (SomePath e (Nil (Nat)) u v) w) -> (erased (SomePath e2 (Nil (Nat)) u v) r))
  (let ((erased lab1) (erased lab2) (erased aw)) (seps-away u z nz e s1 s2))
  (let-match erased w (MkSomePath _ _ xs _ _ wx))
  (MkSomePath e2 _ xs u v (cskip-same d z nz u v e n f e2 n2 f2 lab1 lab2 _ xs h h2 skn skf pnz aw wx)))

(def-fns _ $ (erased same-cskip-from : (erased (Nat) d z nz u v) (erased (List (Nat)) e n f e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf) (erased (Nth (Nat) n z nz) pnz)
    (erased (Seps e u z) s1) (erased (Seps e u nz) s2) (erased (SomePath e2 (Nil (Nat)) u v) w) -> (erased (SomePath e (Nil (Nat)) u v) r))
  (let ((erased lab1) (erased lab2) (erased aw)) (seps-away u z nz e s1 s2))
  (let-match erased w (MkSomePath _ _ xs _ _ wx))
  (MkSomePath e _ xs u v (cskip-same-back d z nz u v e n f e2 n2 f2 lab1 lab2 _ xs h h2 skn skf pnz aw wx)))
