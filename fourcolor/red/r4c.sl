; The colour permutation that rows of red4's rotation tables built with r apply to each digit: p231 for 1, p312 for 2.
(def-adts $ (RotPm : ((Nat) r) ((Perm) g) -> Type)
  enum
  (many RotP1 : -> (RotPm (Succ (Zero)) p231))
  (many RotP2 : -> (RotPm (Succ (Succ (Zero))) p312)))

(def-fns _ $ (erased r4c-mod-div : (erased (Nat) s c r q k d) (subterm erased (Mod s c d) m) (erased (Mul q c k) mm) (erased (Add k r s) ad) (erased (Lt r c) rl)
    -> (erased (Eq (Nat) d r) e))
  (let-match erased mm (MulSucc q1 _ k1 _ mm1 ak)
    ((MulZero _) (let-match erased ad (AddZero _)) (mod-small s c d m rl)))
  (let ((erased kr) (erased akr) (erased acs)) (add-right-comm k1 c k r s ak ad))
  (let-match erased m (ModSub s1 _ _ _ a m1)
    (absurd (ModLt _ _ l) (lt-irrefl s (lt-le-trans s c s l (add-le-right kr c s acs)))))
  (let-match erased (add-cancel c s1 kr s a (add-comm kr c s acs)) (Refl _ _))
  (r4c-mod-div s1 c r q1 k1 d m1 mm1 akr rl))

; The digit d of the colour e moved by the rotation of r is that of the colour that g gives e.
(def-fns _ $ (erased r4c-rot-dig : (erased (Nat) d r s d2) (erased (Col) e) (erased (Perm) g) (erased (CD d e) cd) (erased (RotPm r g) rp) (erased (Add d r s) as)
    (erased (Mod s 3 d2) ms) -> (erased (Col) e2) (erased (PermC g e e2) pc) (erased (CD d2 e2) cd2))
  (let-match erased r4-e3 (Refl _ _))
  (let ((erased z) (erased one) (erased two)) (values (Zero) (Succ (Zero)) (Succ (Succ (Zero)))))
  (let ((erased l0) (erased l1) (erased l2)) (values (LtZ two) (LtS (Zero) two (LtZ one)) (LtS one two (LtS (Zero) one (LtZ z)))))
  (let ((erased m0) (erased m1)) (values (MulZero 3) (MulSucc z 3 z 3 (MulZero 3) (AddZero 3))))
  (let ((erased s1) (erased s2)) (values (AddSucc z one one (AddZero one)) (AddSucc one one two (AddSucc z one one (AddZero one)))))
  (match erased cd _
    ((Cd0)
      (let-match erased as (AddZero _))
      (match erased rp _
        ((RotP1) (let-match erased (r4c-mod-div s 3 s z z d2 ms m0 (AddZero s) l1) (Refl _ _)) (values (C2) (PC1 (C2) (C3) (C1)) (Cd1)))
        ((RotP2) (let-match erased (r4c-mod-div s 3 s z z d2 ms m0 (AddZero s) l2) (Refl _ _)) (values (C3) (PC1 (C3) (C1) (C2)) (Cd2)))))
    ((Cd1)
      (match erased rp _
        ((RotP1)
          (let-match erased (add-fn one one s two as s1) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 s z z d2 ms m0 (AddZero s) l2) (Refl _ _))
          (values (C3) (PC2 (C2) (C3) (C1)) (Cd2)))
        ((RotP2)
          (let-match erased (add-fn one two s 3 as (AddSucc z two two (AddZero two))) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 z one 3 d2 ms m1 (add-zero-right 3) l0) (Refl _ _))
          (values (C1) (PC2 (C3) (C1) (C2)) (Cd0)))))
    ((Cd2)
      (match erased rp _
        ((RotP1)
          (let-match erased (add-fn two one s 3 as (AddSucc one one two s1)) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 z one 3 d2 ms m1 (add-zero-right 3) l0) (Refl _ _))
          (values (C1) (PC3 (C2) (C3) (C1)) (Cd0)))
        ((RotP2)
          (let-match erased (add-fn two two s (Succ 3) as (AddSucc one two 3 (AddSucc z two two (AddZero two)))) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 one one 3 d2 ms m1 (add-succ-right 3 z 3 (add-zero-right 3)) l1) (Refl _ _))
          (values (C2) (PC3 (C3) (C1) (C2)) (Cd1)))))))

(def-fns _ $ (erased r4c-cd-fn : (erased (Nat) d) (erased (Col) a b) (erased (CD d a) p) (erased (CD d b) q) -> (erased (Eq (Col) a b) e))
  (match erased p _ ((Cd0) (let-match erased q (Cd0)) (Refl _ a)) ((Cd1) (let-match erased q (Cd1)) (Refl _ a)) ((Cd2) (let-match erased q (Cd2)) (Refl _ a))))

; v, made by red4's go from the trace prefix t of k colours pre (last first), is acc plus mu times the prefix of those colours moved by g.
(def-fns _ $ (erased r4c-go-rot : (erased (Nat) r t k acc mu v) (erased (Perm) g) (erased (RotPm r g) rp) (subterm erased (GoR r t k acc mu v) gr) (erased (List (Col)) pre)
    (erased (RIdx pre t) ri) (erased (Length (Col) pre k) le) ->
    (erased (List (Col)) pre2) (erased (PermT g pre pre2) pt) (erased (Nat) x y) (erased (RIdx pre2 x) ri2) (erased (Mul x mu y) mx) (erased (Add acc y v) ad))
  (match erased gr _
    ((GoZ _ _ _ _)
      (let-match erased le (LengthNil _))
      (values (Nil _) (PTNil g) (Zero) (Zero) (RINil) (MulZero mu) (add-zero-right acc)))
    ((GoS _ _ k1 _ _ _ t1 m3 d0 d s d2 xx acc1 mul1 mm adt dl md as ms mxx aa m1 g1)
      (let-match erased r4-e3 (Refl _ _))
      (let-match erased le (LengthCons _ e pre1 _ le1))
      (let-match erased ri (RICons _ p _ _ ri1 kd))
      (let ((erased c) (erased cd) (erased kc)) (kid-dg t1 m3 d0 t (mul3-thrice t1 m3 mm) adt dl))
      (let ((erased ep) (erased ec)) (kid-inj p t1 t e c kd kc))
      (let-match erased ep (Refl _ _))
      (let-match erased ec (Refl _ _))
      (let-match erased (r4c-mod-div t 3 d0 t1 m3 d md mm adt dl) (Refl _ _))
      (let ((erased e2) (erased pc) (erased cd2)) (r4c-rot-dig d0 r s d2 e g cd rp as ms))
      (let ((erased pre21) (erased pt1) (erased x1) (erased y1) (erased ri21) (erased mx1) (erased ad1)) (r4c-go-rot r t1 k1 acc1 mul1 v g rp g1 pre1 ri1 le1))
      (let ((erased q1) (erased tq1)) (thrice-exists x1))
      (let ((erased x) (erased ax)) (add q1 d2))
      (let ((erased d2l)) (match erased cd2 (((Lt d2 3) l)) ((Cd0) (LtZ _)) ((Cd1) (LtS _ _ (LtZ _))) ((Cd2) (LtS _ _ (LtS _ _ (LtZ _))))))
      (let ((erased c2) (erased cd3) (erased kx)) (kid-dg x1 q1 d2 x tq1 ax d2l))
      (let-match erased (r4c-cd-fn d2 e2 c2 cd2 cd3) (Refl _ _))
      (let ((erased z) (erased mz)) (mul q1 mu))
      (let-match erased (mul-fn x1 mul1 z y1 (mul-assoc x1 3 mu q1 z mul1 (thrice-mul x1 q1 tq1) mz m1) mx1) (Refl _ _))
      (let ((erased y) (erased my)) (mul x mu))
      (let ((erased ay)) (mul-distr q1 d2 x mu y1 xx y ax mz mxx my))
      (let ((erased bc) (erased ab) (erased av)) (add-assoc acc xx y1 acc1 v aa ad1))
      (let-match erased (add-fn xx y1 bc y ab (add-comm y1 xx y ay)) (Refl _ _))
      (values (Cons _ e2 pre21) (PTCons g e e2 pre1 pre21 pc pt1) x y (RICons pre21 x1 x e2 ri21 kx) my av))))

(def-fns _ $ (erased r4c-pw3-last : (erased (Nat) a m L) (subterm erased (Pw3 (Succ a) m L) p) -> (erased (Nat) L1) (erased (Pw3 a m L1) q) (erased (Thrice L1 L) t))
  (let-match erased p (PwS _ _ q0 _ tq p1))
  (let-match erased a (Succ a1) ((Zero) (let-match erased p1 (PwZ _)) (values m (PwZ m) tq)))
  (let ((erased L1) (erased q1) (erased t1)) (r4c-pw3-last a1 q0 L p1))
  (values L1 (PwS a1 m q0 L1 tq q1) t1))

; The child c of p along e, moved to the node n with n's children qn qo past p's qp, is n's child c2 along e.
(def-fns _ $ (erased r4c-kid-shift : (erased (Nat) p n c c2 qp qn qo) (erased (Col) e) (erased (Kid p e c) k) (erased (Thrice p qp) tp) (erased (Thrice n qn) tn)
    (erased (Add qo qp qn) ad) (erased (Add qo c c2) ac) -> (erased (Kid n e c2) r))
  (match erased k _
    ((Ki1 _ _ t1) (let-match erased (thrice-fn p qp c tp t1) (Refl _ _)) (let-match erased (add-fn qo qp c2 qn ac ad) (Refl _ _)) (Ki1 n qn tn))
    ((Ki2 _ c0 t1)
      (let-match erased (thrice-fn p qp c0 tp t1) (Refl _ _))
      (let-match erased (add-fn qo (Succ qp) c2 (Succ qn) ac (add-succ-right qo qp qn ad)) (Refl _ _))
      (Ki2 n qn tn))
    ((Ki3 _ c0 t1)
      (let-match erased (thrice-fn p qp c0 tp t1) (Refl _ _))
      (let-match erased (add-fn qo (Succ (Succ qp)) c2 (Succ (Succ qn)) ac (add-succ-right qo (Succ qp) (Succ qn) (add-succ-right qo qp qn ad))) (Refl _ _))
      (Ki3 n qn tn))))

; y L is three times y L1 when L is three times L1.
(def-fns _ $ (erased r4c-mul3 : (erased (Nat) y L L1 m m1) (erased (Mul y L m) mm) (erased (Mul y L1 m1) mm1) (erased (Thrice L1 L) tl) -> (erased (Thrice m1 m) r))
  (let ((erased z) (erased mz)) (mul m1 (Succ (Succ (Succ (Zero))))))
  (let-match erased (mul-fn y L z m (mul-assoc y L1 (Succ (Succ (Succ (Zero)))) m1 z L mm1 mz (thrice-mul L1 L tl)) mm) (Refl _ _))
  (mul3-thrice m1 z mz))

; The trace prefix of the colours pa then pb, last first, is y L + x, x being that of pa, of a colours, and y that of pb.
(def-fns _ $ (erased r4c-ridx-cat : (erased (List (Col)) pb pc) (erased (Nat) a L x y m t) (subterm erased (List (Col)) pa) (erased (RIdx pa x) ra) (erased (Length (Col) pa a) la)
    (erased (Pw3 a (Succ (Zero)) L) pw) (erased (RIdx pb y) rb) (erased (Mul y L m) mm) (erased (Add m x t) ad) (erased (App (Col) pa pb pc) ap) -> (erased (RIdx pc t) r))
  (let-match erased pa (Cons _ e pa1)
    ((Nil _)
      (let-match erased la (LengthNil _))
      (let-match erased pw (PwZ _))
      (let-match erased ra (RINil))
      (let-match erased ap (CatNil _ _))
      (let-match erased (mul-fn y (Succ (Zero)) m y mm (mul-one-right y)) (Refl _ _))
      (let-match erased (add-fn m (Zero) t m ad (add-zero-right m)) (Refl _ _))
      rb))
  (let-match erased la (LengthCons _ _ _ a1 la1))
  (let-match erased ra (RICons _ x1 _ _ ra1 kx))
  (let-match erased ap (CatCons _ _ _ _ pc1 ap1))
  (let ((erased L1) (erased pw1) (erased tl)) (r4c-pw3-last a1 (Succ (Zero)) L pw))
  (let ((erased m1) (erased mm1)) (mul y L1))
  (let ((erased t1) (erased ad1)) (add m1 x1))
  (let ((erased r1)) (r4c-ridx-cat pb pc1 a1 L1 x1 y m1 t1 pa1 ra1 la1 pw1 rb mm1 ad1 ap1))
  (let ((erased qx) (erased tx)) (thrice-exists x1))
  (let ((erased qt) (erased tt)) (thrice-exists t1))
  (let ((erased tm)) (r4c-mul3 y L L1 m m1 mm mm1 tl))
  (RICons pc1 t1 t e r1 (r4c-kid-shift x1 t1 x t qx qt m e kx tx tt (thrice-add m1 x1 t1 m qx qt tm tx tt ad1) ad)))

(def-fns _ $ (erased r4c-kid-add : (erased (Nat) p q c d) (erased (Col) e) (erased (Kid p e c) k) (erased (Thrice p q) tq) (erased (CD d e) cd) -> (erased (Add q d c) r))
  (match erased k _
    ((Ki1 _ _ t1) (let-match erased (thrice-fn p q c tq t1) (Refl _ _)) (let-match erased cd (Cd0)) (add-zero-right q))
    ((Ki2 _ c0 t1) (let-match erased (thrice-fn p q c0 tq t1) (Refl _ _)) (let-match erased cd (Cd1)) (add-succ-right q (Zero) q (add-zero-right q)))
    ((Ki3 _ c0 t1)
      (let-match erased (thrice-fn p q c0 tq t1) (Refl _ _))
      (let-match erased cd (Cd2))
      (add-succ-right q (Succ (Zero)) (Succ q) (add-succ-right q (Zero) q (add-zero-right q))))))

(def-fns _ $ (erased r4c-cd-lt : (erased (Nat) d) (erased (Col) e) (erased (CD d e) cd) -> (erased (Lt d 3) r))
  (let-match erased r4-e3 (Refl _ _))
  (match erased cd _ ((Cd0) (LtZ _)) ((Cd1) (LtS _ _ (LtZ _))) ((Cd2) (LtS _ _ (LtS _ _ (LtZ _))))))

; The colours pre, last first, of trace prefix t and of a + b colours, are pa then pb: t is y L + x, x below L the prefix of pa's a colours, y that of pb.
(def-fns _ $ (erased r4c-ridx-split : (erased (Nat) b ab t L) (subterm erased (Nat) a) (erased (List (Col)) pre) (erased (RIdx pre t) ri) (erased (Length (Col) pre ab) le)
    (erased (Add a b ab) s) (erased (Pw3 a (Succ (Zero)) L) pw) -> (erased (List (Col)) pa pb) (erased (Nat) x y m) (erased (RIdx pa x) ra) (erased (Length (Col) pa a) la)
    (erased (RIdx pb y) rb) (erased (Length (Col) pb b) lb) (erased (App (Col) pa pb pre) ap) (erased (Mul y L m) mm) (erased (Add m x t) ad) (erased (Lt x L) xl))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased a (Succ a1)
    ((Zero)
      (let-match erased s (AddZero _))
      (let-match erased pw (PwZ _))
      (values (Nil _) pre (Zero) t t (RINil) (LengthNil _) ri le (CatNil _ pre) (mul-one-right t) (add-zero-right t) (LtZ (Zero)))))
  (let-match erased s (AddSucc _ _ ab1 s1))
  (let-match erased le (LengthCons _ e pre1 _ le1))
  (let-match erased ri (RICons _ p _ _ ri1 kd))
  (let ((erased L1) (erased pw1) (erased tl)) (r4c-pw3-last a1 (Succ (Zero)) L pw))
  (let ((erased pa1) (erased pb) (erased x1) (erased y) (erased m1) (erased ra1) (erased la1) (erased rb) (erased lb) (erased ap1) (erased mm1) (erased ad1) (erased xl1))
    (r4c-ridx-split b ab1 p L1 a1 pre1 ri1 le1 s1 pw1))
  (let ((erased d) (erased cd)) (kid-cd p t e kd))
  (let ((erased qp) (erased tp)) (thrice-exists p))
  (let ((erased qx) (erased tx)) (thrice-exists x1))
  (let ((erased m) (erased mm)) (mul y L))
  (let ((erased tm)) (r4c-mul3 y L L1 m m1 mm mm1 tl))
  (let ((erased aq)) (thrice-add m1 x1 p m qx qp tm tx tp ad1))
  (let ((erased x) (erased ax)) (add qx d))
  (let ((erased dl)) (r4c-cd-lt d e cd))
  (let ((erased c2) (erased cd2) (erased kx)) (kid-dg x1 qx d x tx ax dl))
  (let-match erased (r4c-cd-fn d e c2 cd cd2) (Refl _ _))
  (let ((erased bc) (erased ab2) (erased atq)) (add-assoc m qx d qp t aq (r4c-kid-add p qp t d e kd tp cd)))
  (let-match erased (add-fn qx d bc x ab2 ax) (Refl _ _))
  (let ((erased xh)) (add-lt-mono qx d (Succ (Succ (Succ (Zero)))) x (Succ (Succ (Succ qx))) ax
    (add-succ-right qx (Succ (Succ (Zero))) (Succ (Succ qx)) (add-succ-right qx (Succ (Zero)) (Succ qx) (add-succ-right qx (Zero) qx (add-zero-right qx)))) dl))
  (values (Cons _ e pa1) pb x y m (RICons pa1 x1 x e ra1 kx) (LengthCons _ e pa1 a1 la1) rb lb (CatCons _ e pa1 pb pre1 ap1) mm atq
    (lt-le-trans x (Succ (Succ (Succ qx))) L xh (LtS _ _ (thrice-lt x1 L1 qx L xl1 tx tl)))))

(def-fns _ $ (erased r4c-ridx-lt : (erased (Nat) t n M) (subterm erased (List (Col)) pre) (erased (RIdx pre t) ri) (erased (Length (Col) pre n) le) (erased (Pw3 n (Succ (Zero)) M) pw)
    -> (erased (Lt t M) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased le (LengthNil _)) (let-match erased pw (PwZ _)) (let-match erased ri (RINil)) (LtZ (Zero))))
  (let-match erased le (LengthCons _ _ _ n1 le1))
  (let-match erased ri (RICons _ p _ _ ri1 kd))
  (let ((erased M1) (erased pw1) (erased tm)) (r4c-pw3-last n1 (Succ (Zero)) M pw))
  (let ((erased q0) (erased tq) (erased hi) (erased _)) (kid-base p t e kd))
  (lt-le-trans t (Succ (Succ (Succ q0))) M hi (LtS _ _ (thrice-lt p M1 q0 M (r4c-ridx-lt p n1 M1 pre1 ri1 le1 pw1) tq tm))))

(def-fns _ $ (erased r4c-div-uniq : (erased (Nat) c k r s q2 k2 r2) (subterm erased (Nat) q) (erased (Mul q c k) mm) (erased (Add k r s) ad) (erased (Lt r c) rl)
    (erased (Mul q2 c k2) mm2) (erased (Add k2 r2 s) ad2) (erased (Lt r2 c) rl2) -> (erased (Eq (Nat) q q2) e) (erased (Eq (Nat) r r2) f))
  (match erased mm _
    ((MulZero _)
      (let-match erased ad (AddZero _))
      (let-match erased mm2 (MulZero _)
        (absurd (MulSucc q21 _ k21 _ _ ak2)
          (let ((erased t2) (erased _) (erased a2)) (add-right-comm k21 c k2 r2 s ak2 ad2))
          (lt-irrefl s (lt-le-trans s c s rl (add-le-right t2 c s a2)))))
      (let-match erased ad2 (AddZero _))
      (values (Refl _ q) (Refl _ r)))
    ((MulSucc q1 _ k1 _ mm1 ak)
      (let ((erased t1) (erased b1) (erased a1)) (add-right-comm k1 c k r s ak ad))
      (let-match erased mm2 (MulSucc q21 _ k21 _ mm21 ak2)
        (absurd (MulZero _) (let-match erased ad2 (AddZero _)) (lt-irrefl s (lt-le-trans s c s rl2 (add-le-right t1 c s a1)))))
      (let ((erased t2) (erased b2) (erased a2)) (add-right-comm k21 c k2 r2 s ak2 ad2))
      (let-match erased (add-cancel c t1 t2 s (add-comm t1 c s a1) (add-comm t2 c s a2)) (Refl _ _))
      (let ((erased e1) (erased f1)) (r4c-div-uniq c k1 r t1 q21 k21 r2 q1 mm1 b1 rl mm21 b2 rl2))
      (let-match erased e1 (Refl _ _))
      (values (Refl _ q) f1))))

(def-fns _ $ (erased r4c-rt-get : (erased (Nat) r n i j) (erased (List (Copy (Nat))) xs) (subterm erased (RotTab r n i xs) rt) (erased (Lt j i) l)
    -> (erased (Nat) v) (erased (WElt xs j v) w) (erased (GoR r j n 0 1 v) g))
  (let-match erased rt (RtS _ _ ip v _ rt1 w g) (absurd (RtZ _ _ _) l))
  (let-match erased (nat-eq j ip) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values v w g)))
  (let-match erased ap (ApLt _ _ _ _ jl) (absurd (ApGt _ _ _ _ gt) (lt-irrefl j (lt-le-trans j (Succ ip) j l (LtS ip j gt)))))
  (r4c-rt-get r n ip j xs rt1 jl))

(def-fns _ $ (erased r4c-permt-app : (erased (Perm) g) (erased (List (Col)) pa pb pc pa2 pb2) (subterm erased (PermT g pa pa2) p) (erased (PermT g pb pb2) q)
    (erased (App (Col) pa pb pc) ap) -> (erased (List (Col)) pc2) (erased (App (Col) pa2 pb2 pc2) ap2) (erased (PermT g pc pc2) r))
  (let-match erased p (PTCons _ c d et1 et3 pcd p1) ((PTNil _) (let-match erased ap (CatNil _ _)) (values pb2 (CatNil _ pb2) q)))
  (let-match erased ap (CatCons _ _ _ _ pc1 ap1))
  (let ((erased pc21) (erased ap21) (erased r1)) (r4c-permt-app g et1 pb pc1 et3 pb2 p1 q ap1))
  (values (Cons _ d pc21) (CatCons _ d et3 pb2 pc21 ap21) (PTCons g c d pc1 pc21 pcd r1)))

; The colours, last first, of the prefix i of n colours.
(def-fns _ $ (erased r4c-ridx-num : (erased (Nat) n M i) (erased (Pw3 n (Succ (Zero)) M) pw) (erased (Lt i M) il) -> (erased (List (Col)) pre) (erased (RIdx pre i) ri)
    (erased (Length (Col) pre n) le))
  (let ((erased p) (erased et) (erased ti) (erased le) (erased pm)) (tidx-of (Succ (Zero)) M i n pw il))
  (let-match erased pm (LtZ _) (absurd (LtS _ _ l0) l0))
  (let ((erased pre) (erased ra) (erased ri)) (ridx-ext (Nil _) et (Zero) i (RINil) ti))
  (values pre ri (rev-len et (Nil _) pre n (Zero) n ra le (LengthNil _) (add-zero-right n))))

; The rotation red4's rot r selects, through the rows built with rr: rot 0 moves each colour by p231, rot 2 by p312.
(def-adts $ (RotSel : ((Nat) r) ((Nat) rr) ((Perm) g) -> Type)
  enum
  (many RsOne : -> (RotSel (Zero) (Succ (Zero)) p231))
  (many RsTwo : -> (RotSel (Succ (Succ (Zero))) (Succ (Succ (Zero))) p312)))

; red4's rot r t of kempe_flat: the trace t, of the colours pre (last first), with its colours moved by g.
(def-fns _ $ (many r4-rot : (erased (Nat) h) (many (Eng h) e) (many (Nat) r t) (erased (Nat) rr) (erased (Perm) g) (erased (RotSel r rr g) rs) (erased (List (Col)) pre)
    (erased (RIdx pre t) ri) (erased (Length (Col) pre (Succ h)) le) -> (many (Nat) u) (erased (List (Col)) pre2) (erased (PermT g pre pre2) pt) (erased (RIdx pre2 u) ri2))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match many e (MkEng _ gtu xs nd us ul0 vs uc0 lo rws rtab len o N ld hd lx ax ly pu ptr gc of zu zv pw ctu tb lc ad pl r0 r1 r2 r3 ce ge hc))
  (let ((erased rp) (erased ra) (erased rb) (erased rl))
    (match erased rs (((RotPm rr g) p) ((RowAt rws r rr ld) a) ((RowAt rws (Succ r) rr hd) b) ((Lt (Succ r) 4) l))
      ((RsOne) (values (RotP1) r0 r1 (LtS _ _ (LtZ _))))
      ((RsTwo) (values (RotP2) r2 r3 (LtS _ _ (LtS _ _ (LtS _ _ (LtZ _))))))))
  (let-match erased ra (MkRowAt _ _ _ _ Ma xa aa la pma rta aua nta))
  (let-match erased rb (MkRowAt _ _ _ _ Mb xb ab lb pmb rtb aub ntb))
  (let ((erased Nb)) (sz-u62 cnt-w vs N zv))
  (let ((erased tl)) (r4c-ridx-lt t (Succ h) N pre ri le pw))
  (let ((erased Nq) (erased pq)) (pw3-c hd lo))
  (let-match erased (pw3-fn (Succ (Zero)) Nq N (Succ h) (pw3-cat hd (Succ h) (Succ (Zero)) lo Nq ld pl pq ad) pw) (Refl _ _))
  (let ((erased lob)) (lt-le-trans lo (Succ N) u62-modulus (pw3-le hd lo N pq) (LtS N u62-modulus Nb)))
  (let ((erased lop)) (lt-pred (Zero) lo (pw3-le ld (Succ (Zero)) lo pl)))
  (let ((erased tb0)) (lt-trans t N u62-modulus tl Nb))
  (let ((many r1v)) (u62-inc r (lt-trans (Succ r) 4 u62-modulus rl r4-four-u62)))
  (let-match many (array-get-many _ _ rtab r1v _ ntb) (MkCopy _ rowb))
  (let-match many rowb (MkRRow _ _ _ _ arb _ _ _))
  (let ((many q) (erased k) (erased w0) (erased mm) (erased adq) (erased wl) (erased _)) (u62-div t lo tb0 lob lop))
  (let ((erased pa) (erased pb) (erased x) (erased y) (erased m) (erased rxa) (erased lpa) (erased ryb) (erased lpb) (erased ap) (erased mm2) (erased ad2) (erased xl))
    (r4c-ridx-split hd (Succ h) t lo ld pre ri le ad pl))
  (let ((erased eq) (erased ew)) (r4c-div-uniq lo k w0 t y m x q mm adq wl mm2 ad2 xl))
  (let-match erased eq (Refl _ _))
  (let-match erased ew (Refl _ _))
  (let ((erased hv0) (erased whv) (erased gh)) (r4c-rt-get rr hd Mb q xb rtb (r4c-ridx-lt q hd Mb pb ryb lpb pmb)))
  (let-match erased whv (MkWElt _ _ _ nthb))
  (let-match many (array-get-many _ _ arb q _ nthb) (MkCopy _ hv))
  (let ((erased pb2) (erased ptb) (erased xb2) (erased yb) (erased rib) (erased mxb) (erased adb)) (r4c-go-rot rr q hd (Zero) (Succ (Zero)) hv0 g rp gh pb ryb lpb))
  (let-match erased adb (AddZero _))
  (let-match erased (mul-fn xb2 (Succ (Zero)) yb xb2 mxb (mul-one-right xb2)) (Refl _ _))
  (let ((erased lv0) (erased wlv) (erased gl)) (r4c-rt-get rr ld Ma x xa rta (r4c-ridx-lt x ld Ma pa rxa lpa pma)))
  (let ((erased pa2) (erased pta) (erased xa2) (erased ya) (erased ria) (erased mxa) (erased ada)) (r4c-go-rot rr x ld (Zero) (Succ (Zero)) lv0 g rp gl pa rxa lpa))
  (let-match erased ada (AddZero _))
  (let-match erased (mul-fn xa2 (Succ (Zero)) ya xa2 mxa (mul-one-right xa2)) (Refl _ _))
  (let ((erased m1) (erased mm1)) (mul hv lo))
  (let ((erased u1) (erased au)) (add m1 lv0))
  (let ((erased pre2) (erased ap2) (erased pt)) (r4c-permt-app g pa pb pre pa2 pb2 pta ptb ap))
  (let ((erased ri2)) (r4c-ridx-cat pb2 pre2 ld lo lv0 hv m1 u1 pa2 ria (permt-length g pa pa2 ld pta lpa) pl rib mm1 au ap2))
  (let ((erased ub)) (lt-trans u1 N u62-modulus (r4c-ridx-lt u1 (Succ h) N pre2 ri2 (permt-length g pre pre2 (Succ h) pt le) pw) Nb))
  (let ((erased m1b)) (le-u62 m1 u1 (add-le-left m1 lv0 u1 au) ub))
  (let ((many mv)) (u62-mul hv lo (le-u62 hv m1 (mul-le hv lo m1 mm1 lop) m1b) lob m1 mm1 m1b))
  (let ((many w) (erased _) (erased md) (erased _)) (u62-mod t lo tb0 lob lop))
  (let-match erased (r4c-mod-div t lo x y m w md mm2 ad2 xl) (Refl _ _))
  (let-match many (array-get-many _ _ rtab r _ nta) (MkCopy _ rowa))
  (let-match many rowa (MkRRow _ _ _ _ ara _ _ _))
  (let-match erased wlv (MkWElt _ _ _ ntha))
  (let-match many (array-get-many _ _ ara w _ ntha) (MkCopy _ lv))
  (values (u62-add mv lv u1 au ub) pre2 pt ri2))

(def-fns _ $ (erased r4c-bitis-zero : (erased (Nat) d) (erased (Bit) a) (erased (BitIs (Zero) d a) bi) -> (erased (Eq (Bit) a (Bit0)) e))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p c))
  (let ((erased e1) (erased _)) (bsp-zero-x d lo y p))
  (let-match erased e1 (Refl _ _))
  (let ((erased _) (erased e2)) (bc-zero y1 a c))
  e2)

(def-fns _ $ (erased r4c-bitis-of0 : (erased (Nat) d) -> (erased (BitIs (Zero) d (Bit0)) r))
  (MkBitIs (Zero) d (Zero) (Zero) (Zero) (Bit0) (bsp-zz d) (bc-zz)))

(def-fns _ $ (erased r4c-bitis-up : (erased (Nat) x xa d) (erased (Bit) c xb) (erased (BitIs xa d c) bi) (erased (BitCons xa xb x) cx) -> (erased (BitIs x (Succ d) c) r))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p cy))
  (let ((erased lo2) (erased cl)) (bc-new lo xb))
  (MkBitIs x (Succ d) lo2 y y1 c (BspS d x xa lo2 lo y xb p cx cl) cy))

(def-fns _ $ (erased r4c-bitis-down : (erased (Nat) x xa d) (erased (Bit) a xb) (erased (BitIs x (Succ d) a) bi) (erased (BitCons xa xb x) cx) -> (erased (BitIs xa d a) r))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p cy))
  (let-match erased p (BspS _ _ x1 _ lo1 _ b p1 cx1 cl))
  (let ((erased e1) (erased _)) (bitcons-fn x1 b xa xb x cx1 cx))
  (let-match erased e1 (Refl _ _))
  (MkBitIs xa d lo1 y y1 a p1 cy))

; A bitwise operation acts on each bit.
(def-fns _ $ (erased r4c-bw-bitis : (erased (BitOp) t) (erased (Nat) x y z d) (erased (Bit) a b c) (subterm erased (Bitwise t x y z) bw) (erased (BitIs x d a) bx)
    (erased (BitIs y d b) by) (erased (BitApply t a b c) ap) -> (erased (BitIs z d c) r))
  (match erased bw _
    ((BwZero _)
      (let-match erased (r4c-bitis-zero d a bx) (Refl _ _))
      (let-match erased (r4c-bitis-zero d b by) (Refl _ _))
      (let-match erased (bitapply-fn t (Bit0) (Bit0) c (Bit0) ap (Ap00 t)) (Refl _ _))
      (r4c-bitis-of0 d))
    ((BwBit _ xa ya za xb yb zb _ _ _ bw1 ap1 cx cy cz)
      (let-match erased d (Zero)
        ((Succ d1)
          (r4c-bitis-up z za d1 c zb (r4c-bw-bitis t xa ya za d1 a b c bw1 (r4c-bitis-down x xa d1 a xb bx cx) (r4c-bitis-down y ya d1 b yb by cy) ap) cz)))
      (let-match erased bx (MkBitIs _ _ _ _ x1 _ px c1))
      (let-match erased px (BspZ _))
      (let ((erased _) (erased ea)) (bitcons-fn x1 a xa xb x c1 cx))
      (let-match erased ea (Refl _ _))
      (let-match erased by (MkBitIs _ _ _ _ y1 _ py c2))
      (let-match erased py (BspZ _))
      (let ((erased _) (erased eb)) (bitcons-fn y1 b ya yb y c2 cy))
      (let-match erased eb (Refl _ _))
      (let-match erased (bitapply-fn t a b c zb ap ap1) (Refl _ _))
      (MkBitIs z (Zero) (Zero) z za c (BspZ z) cz))))

; b is Bit1 when d is k, and Bit0 otherwise.
(def-adts $ (EqB : ((Nat) k) ((Nat) d) ((Bit) b) -> Type)
  enum
  (many EbSame : (erased (Nat) k) -> (EqB k k (Bit1)))
  (many EbDiff : (erased (Nat) k d) (erased (Apart (Nat) Lt k d) ap) -> (EqB k d (Bit0))))

(def-fns _ $ (erased r4c-pow2-bit : (erased (Nat) k v d) (subterm erased (Pow2 k v) pw) -> (erased (Bit) b) (erased (EqB k d b) eb) (erased (BitIs v d b) bi))
  (match erased pw _
    ((P0)
      (let ((erased one)) (BC1 (Zero) (Zero) (D0)))
      (match erased d (((Bit) b) ((EqB (Zero) d b) eb) ((BitIs (Succ (Zero)) d b) bi))
        ((Zero) (values (Bit1) (EbSame (Zero)) (MkBitIs v (Zero) (Zero) v (Zero) (Bit1) (BspZ v) one)))
        ((Succ d1)
          (values (Bit0) (EbDiff (Zero) d (ApLt (Nat) Lt (Zero) d (LtZ d1))) (r4c-bitis-up v (Zero) d1 (Bit0) (Bit1) (r4c-bitis-of0 d1) one)))))
    ((PS k1 v1 _ pw1 dd)
      (let ((erased cv)) (BC0 v1 v dd))
      (let-match erased d (Succ d1) ((Zero) (values (Bit0) (EbDiff k (Zero) (ApGt (Nat) Lt k (Zero) (LtZ k1))) (MkBitIs v (Zero) (Zero) v v1 (Bit0) (BspZ v) cv))))
      (let ((erased b) (erased eb1) (erased bi1)) (r4c-pow2-bit k1 v1 d1 pw1))
      (values b
        (match erased eb1 (((EqB k d b) r))
          ((EbSame _) (EbSame k))
          ((EbDiff _ _ ap) (EbDiff k d (match erased ap _ ((ApLt _ _ _ _ l) (ApLt (Nat) Lt k d (LtS k1 d1 l))) ((ApGt _ _ _ _ l) (ApGt (Nat) Lt k d (LtS d1 k1 l)))))))
        (r4c-bitis-up v v1 d1 b (Bit0) bi1 cv)))))

; a is Bit1 when t is a leaf, and Bit0 when t is empty.
(def-adts $ (Lf : ((Ctree) t) ((Bit) a) -> Type)
  enum
  (many LfE : -> (Lf (CEmpty) (Bit0)))
  (many LfL : (erased (Ctree) lf) -> (Lf (CLeaf lf) (Bit1))))

; c, below 8, has bit d set exactly when the tree of colour d + 1 among t1, t2 and t3, each empty or a leaf, is a leaf.
(def-adts $ (TB3 : ((Nat) c) ((Ctree) t1) ((Ctree) t2) ((Ctree) t3) -> Type)
  enum
  (many MkB3 : (erased (Nat) c) (erased (Ctree) t1 t2 t3) (erased (Bit) a1 a2 a3) (erased (Bsp 3 c c (Zero)) cb) (erased (BitIs c (Zero) a1) b1)
      (erased (BitIs c (Succ (Zero)) a2) b2) (erased (BitIs c (Succ (Succ (Zero))) a3) b3) (erased (Lf t1 a1) l1) (erased (Lf t2 a2) l2) (erased (Lf t3 a3) l3)
      -> (TB3 c t1 t2 t3)))

; a is Bit0 when z is 0, and Bit1 otherwise.
(def-adts $ (ZB : ((Nat) z) ((Bit) a) -> Type)
  enum
  (many ZbZ : -> (ZB (Zero) (Bit0)))
  (many ZbP : (erased (Nat) z) -> (ZB (Succ z) (Bit1))))

(comptime-match many (bsp-chk 3 1 1 0) (ESome _ r4c-bs1))
(comptime-match many (bsp-chk 3 2 2 0) (ESome _ r4c-bs2))
(comptime-match many (bsp-chk 3 4 4 0) (ESome _ r4c-bs4))
(comptime-match many (bsp-chk 3 0 0 0) (ESome _ r4c-bs0))

(let ((many r4c-v8) (erased r4c-p8) (erased _)) (pow2 3))
(comptime-match many (lt-dec r4c-v8 u8-modulus) (Yes _ _ _ _ r4c-8u8))
(comptime-match many (lt-dec 3 (Succ (sixty-two-many))) (Yes _ _ _ _ r4c-3-63))

(def-fns _ $ (erased r4c-b3-lt : (erased (Nat) c) (erased (Bsp 3 c c (Zero)) cb) -> (erased (Lt c u8-modulus) r))
  (lt-trans c r4c-v8 u8-modulus (bsp-lt 3 c c (Zero) r4c-v8 cb r4c-p8) r4c-8u8))

(def-fns _ $ (erased r4c-b3-sel : (erased (Nat) c d) (erased (Ctree) t1 t2 t3 u) (erased (Col) e) (erased (TB3 c t1 t2 t3) b) (erased (CD d e) cd)
    (erased (CtSel (CNode t1 t2 t3) e u) sl) -> (erased (Bit) a) (erased (BitIs c d a) bi) (erased (Lf u a) lf))
  (let-match erased b (MkB3 _ _ _ _ a1 a2 a3 _ b1 b2 b3 l1 l2 l3))
  (match erased cd (((Bit) a) ((BitIs c d a) bi) ((Lf u a) lf))
    ((Cd0) (let-match erased sl (SelN1 _ _ _)) (values a1 b1 l1))
    ((Cd1) (let-match erased sl (SelN2 _ _ _)) (values a2 b2 l2))
    ((Cd2) (let-match erased sl (SelN3 _ _ _)) (values a3 b3 l3))))

; red4's x land b in cadd: 0 exactly when the child of the bit b is empty.
(def-fns _ $ (erased r4c-b3-and : (erased (Nat) c m z d) (erased (Ctree) t1 t2 t3 u) (erased (Col) e) (erased (TB3 c t1 t2 t3) b) (erased (CD d e) cd)
    (erased (CtSel (CNode t1 t2 t3) e u) sl) (erased (Pow2 d m) pw) (erased (Bitwise and-op c m z) bwz) -> (erased (Bit) a) (erased (Lf u a) lf) (erased (ZB z a) zb))
  (let ((erased a) (erased bi) (erased lf)) (r4c-b3-sel c d t1 t2 t3 u e b cd sl))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p cy))
  (let ((erased f) (erased cf) (erased bv)) (bc-one a))
  (let ((erased fk) (erased pf)) (bsp-lo0 d f))
  (let ((erased bw)) (and-mask d (Succ (Zero)) c lo y f y1 (Succ (Zero)) m fk p (BspS (Zero) y y1 f (Zero) y1 a (BspZ y1) cy cf)
    (OnS (Zero) (Zero) (Succ (Zero)) (OnZ) (BC1 (Zero) (Zero) (D0))) (bsp-pow d m pw) pf))
  (let-match erased (bitwise-fn and-op c m z fk bwz bw) (Refl _ _))
  (values a lf
    (match erased bv (((ZB fk a) zb))
      ((BV0) (let-match erased (bsp-zero-hi d fk (Zero) pf) (Refl _ _)) (ZbZ))
      ((BV1)
        (let-match erased fk (Succ fk1) (absurd (Zero) (let ((erased e1) (erased _)) (bsp-zero-x d (Zero) (Succ (Zero)) pf)) e1))
        (ZbP fk1)))))

(def-fns _ $ (erased r4c-or0 : (erased (Bit) a) -> (erased (BitApply or-op a (Bit0) a) r))
  (match erased a _ ((Bit0) (Ap00 or-op)) ((Bit1) (Ap10 (Bit1) (Bit1) (Bit1)))))

(def-fns _ $ (erased r4c-or1 : (erased (Bit) a) -> (erased (BitApply or-op a (Bit1) (Bit1)) r))
  (match erased a _ ((Bit0) (Ap01 (Bit1) (Bit1) (Bit1))) ((Bit1) (Ap11 (Bit1) (Bit1) (Bit1)))))

; Bit d2 of red4's x lor b in cadd, b being 2^d: set at d, x's own elsewhere.
(def-fns _ $ (erased r4c-or-at : (erased (Nat) c m c2 d d2) (erased (Bit) a) (erased (Bitwise or-op c m c2) bw) (erased (Pow2 d m) pw) (erased (BitIs c d2 a) bi)
    -> (erased (Bit) b x) (erased (EqB d d2 b) eb) (erased (BitIs c2 d2 x) r) (erased (BitApply or-op a b x) ap))
  (let ((erased b) (erased eb) (erased bm)) (r4c-pow2-bit d m d2 pw))
  (let ((erased x) (erased ap)) (match erased b (((Bit) x) ((BitApply or-op a b x) ap)) ((Bit0) (values a (r4c-or0 a))) ((Bit1) (values (Bit1) (r4c-or1 a)))))
  (values b x eb (r4c-bw-bitis or-op c m c2 d2 a b x bw bi bm ap) ap))

; red4's x lor b in cadd: the child of the bit b made a leaf.
(def-fns _ $ (erased r4c-b3-or : (erased (Nat) c m c2 d) (erased (Ctree) o lf t1 t2 t3 s1 s2 s3) (erased (Col) e) (erased (TB3 c t1 t2 t3) b) (erased (CtSel o (C1) t1) x1)
    (erased (CtSel o (C2) t2) x2) (erased (CtSel o (C3) t3) x3) (erased (CD d e) cd) (erased (Pow2 d m) pw) (erased (Bitwise or-op c m c2) bw)
    (erased (Up3 e o (CLeaf lf) (CNode s1 s2 s3)) up) -> (erased (TB3 c2 s1 s2 s3) r) (erased (Lt c2 u8-modulus) cl))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e2 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased b (MkB3 _ _ _ _ a1 a2 a3 cb b1 b2 b3 l1 l2 l3))
  (let ((erased z) (erased one) (erased two)) (values (Zero) (Succ (Zero)) (Succ (Succ (Zero)))))
  (let ((erased y1) (erased z1) (erased e1) (erased c1) (erased p1)) (r4c-or-at c m c2 d z a1 bw pw b1))
  (let ((erased y2) (erased z2) (erased e2) (erased c2b) (erased p2)) (r4c-or-at c m c2 d one a2 bw pw b2))
  (let ((erased y3) (erased z3) (erased e3) (erased c3) (erased p3)) (r4c-or-at c m c2 d two a3 bw pw b3))
  (match erased up (((TB3 c2 s1 s2 s3) r) ((Lt c2 u8-modulus) cl))
    ((UpA _ _ v2 v3 w2 w3)
      (let-match erased cd (Cd0))
      (let-match erased pw (P0))
      (let ((erased cb2)) (or-lt 3 c m c2 cb r4c-bs1 bw))
      (let-match erased (sel-fn o v2 t2 (C2) w2 x2) (Refl _ _))
      (let-match erased (sel-fn o v3 t3 (C3) w3 x3) (Refl _ _))
      (let-match erased e1 (EbSame _) (absurd (EbDiff _ _ ap) (apart-irrefl _ ap)))
      (let-match erased e2 (EbDiff _ _ _))
      (let-match erased e3 (EbDiff _ _ _))
      (let-match erased (bitapply-fn or-op a1 (Bit1) z1 (Bit1) p1 (r4c-or1 a1)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a2 (Bit0) z2 a2 p2 (r4c-or0 a2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a3 (Bit0) z3 a3 p3 (r4c-or0 a3)) (Refl _ _))
      (values (MkB3 c2 s1 s2 s3 (Bit1) a2 a3 cb2 c1 c2b c3 (LfL lf) l2 l3) (r4c-b3-lt c2 cb2)))
    ((UpB _ _ v1 v3 w1 w3)
      (let-match erased cd (Cd1))
      (let-match erased pw (PS _ _ _ pwa dda))
      (let-match erased pwa (P0))
      (let-match erased dda (DS _ _ ddb))
      (let-match erased ddb (D0))
      (let ((erased cb2)) (or-lt 3 c m c2 cb r4c-bs2 bw))
      (let-match erased (sel-fn o v1 t1 (C1) w1 x1) (Refl _ _))
      (let-match erased (sel-fn o v3 t3 (C3) w3 x3) (Refl _ _))
      (let-match erased e1 (EbDiff _ _ _))
      (let-match erased e2 (EbSame _) (absurd (EbDiff _ _ ap) (apart-irrefl _ ap)))
      (let-match erased e3 (EbDiff _ _ _))
      (let-match erased (bitapply-fn or-op a1 (Bit0) z1 a1 p1 (r4c-or0 a1)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a2 (Bit1) z2 (Bit1) p2 (r4c-or1 a2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a3 (Bit0) z3 a3 p3 (r4c-or0 a3)) (Refl _ _))
      (values (MkB3 c2 s1 s2 s3 a1 (Bit1) a3 cb2 c1 c2b c3 l1 (LfL lf) l3) (r4c-b3-lt c2 cb2)))
    ((UpC _ _ v1 v2 w1 w2)
      (let-match erased cd (Cd2))
      (let-match erased pw (PS _ _ _ pwa dda))
      (let-match erased pwa (PS _ _ _ pwb ddb))
      (let-match erased pwb (P0))
      (let-match erased ddb (DS _ _ ddc))
      (let-match erased ddc (D0))
      (let-match erased dda (DS _ _ ddd))
      (let-match erased ddd (DS _ _ dde))
      (let-match erased dde (D0))
      (let ((erased cb2)) (or-lt 3 c m c2 cb r4c-bs4 bw))
      (let-match erased (sel-fn o v1 t1 (C1) w1 x1) (Refl _ _))
      (let-match erased (sel-fn o v2 t2 (C2) w2 x2) (Refl _ _))
      (let-match erased e1 (EbDiff _ _ _))
      (let-match erased e2 (EbDiff _ _ _))
      (let-match erased e3 (EbSame _) (absurd (EbDiff _ _ ap) (apart-irrefl _ ap)))
      (let-match erased (bitapply-fn or-op a1 (Bit0) z1 a1 p1 (r4c-or0 a1)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a2 (Bit0) z2 a2 p2 (r4c-or0 a2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a3 (Bit1) z3 (Bit1) p3 (r4c-or1 a3)) (Refl _ _))
      (values (MkB3 c2 s1 s2 s3 a1 a2 (Bit1) cb2 c1 c2b c3 l1 l2 (LfL lf)) (r4c-b3-lt c2 cb2)))))

; us2 is us after red4's ctr_path with v from the trie node of the path pre, last colour first: its ancestors, nearest first, set to v up to one already v.
(def-adts $ (CPth : ((List (U8)) us) ((List (U8)) us2) ((Nat) v) ((List (Col)) pre) -> Type)
  enum
  (many CpRoot : (erased (List (U8)) us) (erased (Nat) v) -> (CPth us us v (Nil (Col))))
  (many CpStop : (erased (List (U8)) us) (erased (Nat) v m) (erased (Col) e) (erased (List (Col)) pre) (erased (HIdx pre m) hi) (erased (Elt flag-w us m v) y)
      -> (CPth us us v (Cons (Col) e pre)))
  (many CpSet : (erased (List (U8)) us us1 us2) (erased (Nat) v m x) (erased (Col) e) (erased (List (Col)) pre) (erased (HIdx pre m) hi) (erased (Elt flag-w us m x) y)
      (erased (Apart (Nat) Lt x v) ap) (erased (Put flag-w us m v us1) pu) (erased (CPth us1 us2 v pre) c) -> (CPth us us2 v (Cons (Col) e pre))))

(def-lvl r4c-lp)

; red4's ctr_path ca h v p: from the trie node of the prefix p of depth h, its ancestors set to v up to one already v.
(def-fns _ $ (many r4-cpath : (erased (List (U8)) us0) (unique (Bytes us0) ca0) (erased (Nat) len) (erased (Sz flag-w us0 len) z0) (many (Nat) h0 v0 p0) (erased (Lt h0 17) hl)
    (erased (Lt v0 u8-modulus) vb) (erased (Lt p0 u62-modulus) pb) (erased (List (Col)) pre0) (erased (RIdx pre0 p0) ri0) (erased (Length (Col) pre0 h0) le0) (erased (Nat) d0)
    (erased (HIdx pre0 d0) hd0) (erased (Lt d0 len) dl0) -> (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca0) (erased (Sz flag-w us2 len) z2) (erased (CPth us0 us2 v0 pre0) cp))
  (let ((erased vb2)) (lt-trans v0 u8-modulus u62-modulus vb u8-below-u62))
  (def-fns r4c-lp $ (many up : (erased (List (U8)) us) (unique (Bytes us) ca at ca0) (erased (Sz flag-w us len) z) (many v0 is v at v0) (many (Nat) k p) (erased (Lt k 17) kl)
      (erased (Lt p u62-modulus) pbk) (subterm erased (List (Col)) pre) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (Nat) d) (erased (HIdx pre d) hd)
      (erased (Lt d len) dl) -> (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca) (erased (Sz flag-w us2 len) z2) (erased (CPth us us2 v pre) cp))
    (let-match erased r4-e3 (Refl _ _))
    (let-match many (nat-zero-dec k) (IsSucc k1)
      ((IsZero) (let-match erased le (LengthNil _)) (values us ca z (CpRoot us v))))
    (let-match erased le (LengthCons _ e pre1 _ le1))
    (let-match erased ri (RICons _ p1 _ _ ri1 kd))
    (let-match erased hd (HxCons _ m x _ hi1 km))
    (let ((erased kb)) (lt-trans k 17 u62-modulus kl r4-17-u62))
    (let ((erased kl1)) (lt-trans k1 k 17 (lt-succ k1) kl))
    (let ((many q) (erased k3) (erased r) (erased mm) (erased dq) (erased rl) (erased qb)) (u62-div p 3 pbk r4-three-u62 (LtZ _)))
    (let-match erased (kid-div p1 q p k3 r e kd mm dq rl) (Refl _ _))
    (let ((many o) (erased of) (erased _)) (r4-oget (u62-dec k1 k kb) kl1))
    (let ((erased jv) (erased aj)) (add o q))
    (let-match erased (hidx-det pre1 m jv hi1 (hidx-offs q k1 o jv pre1 ri1 le1 of aj)) (Refl _ _))
    (let ((erased q0) (erased tq) (erased _) (erased lo)) (kid-base m x e km))
    (let ((erased jl)) (lt-trans m d len (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq) (LtS q0 (Succ x) lo)) dl))
    (let ((many j)) (u62-add o q m aj (lt-trans m len u62-modulus jl (sz-u62 flag-w us len z))))
    (let ((erased c) (erased y)) (elt-exists flag-w us len m z jl))
    (let ((unique ca1) (many cv)) (r4-gb us ca j c y))
    (let ((erased cb) (erased _)) (flag-nth us m c y))
    (let-match many (u62-eq cv v (lt-trans c u8-modulus u62-modulus cb u8-below-u62) vb2) (Unequal _ _ _ _ ap)
      ((Equal _ _ _) (values us ca1 z (CpStop us v m e pre1 hi1 y))))
    (let ((erased us1) (unique ca2) (erased pu) (erased z1)) (r4-sb us ca1 j v len z jl vb))
    (let ((erased us2) (unique ca3) (erased z2) (erased cp1))
      (tail $ up us1 ca2 z1 v (u62-dec k1 k kb) q kl1 qb pre1 ri1 le1 m hi1 jl))
    (values us2 ca3 z2 (CpSet us us1 us2 v m c e pre1 hi1 y ap pu cp1)))
  (up us0 ca0 z0 v0 h0 p0 hl pb pre0 ri0 le0 d0 hd0 dl0))

(def-adts
  ; red4's ctr trie: node n, whose children are 3n + 1 to 3n + 3, holds t, of j + 1 more colours: its entry, and every entry below it, is 0 when t is empty;
  ; otherwise its entry is 1, or at j = 0 the bits of its children, leaves, colour 1 lowest.
  ((Ca : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many CaE : (erased (List (U8)) us) (erased (Nat) j n) (erased (Zr us j n) z) -> (Ca us j n (CEmpty)))
    (many CaL : (erased (List (U8)) us) (erased (Nat) n c) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n c) x) (erased (TB3 c t1 t2 t3) b) (erased (Occ3 t1 t2 t3) o)
        -> (Ca us (Zero) n (CNode t1 t2 t3)))
    (many CaN : (erased (List (U8)) us) (erased (Nat) j n q) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n (Succ (Zero))) x) (erased (Thrice n q) tq)
        (erased (Ca us j (Succ q) t1) k1) (erased (Ca us j (Succ (Succ q)) t2) k2) (erased (Ca us j (Succ (Succ (Succ q))) t3) k3) (erased (Occ3 t1 t2 t3) o)
        -> (Ca us (Succ j) n (CNode t1 t2 t3)))))

(def-fns _ $ (erased r4c-ca-below : (erased (List (U8)) us vs) (erased (Nat) j n i x) (erased (Ctree) t) (subterm erased (Ca us j n t) f) (erased (Put flag-w us i x vs) s)
    (erased (Lt i n) l) -> (erased (Ca vs j n t) r))
  (let ((erased ap)) (ApLt (Nat) Lt i n l))
  (let-match erased f (CaN _ j1 _ q t1 t2 t3 y tq k1 k2 k3 o)
    ((CaE _ _ _ z) (CaE vs j n (zr-below us vs j n i x z s l)))
    ((CaL _ _ c t1 t2 t3 y b o) (CaL vs n c t1 t2 t3 (put-other flag-w us vs i x n c s ap y) b o)))
  (let ((erased l1)) (lt-le-trans _ _ _ l (lt-weaken _ _ (thrice-le n q tq))))
  (let ((erased l2)) (lt-weaken _ _ l1))
  (CaN vs j1 n q t1 t2 t3 (put-other flag-w us vs i x n _ s ap y) tq (r4c-ca-below us vs j1 (Succ q) i x t1 k1 s l1) (r4c-ca-below us vs j1 (Succ (Succ q)) i x t2 k2 s l2)
    (r4c-ca-below us vs j1 (Succ (Succ (Succ q))) i x t3 k3 s (lt-weaken _ _ l2)) o))

(def-fns _ $ (erased r4c-ca-apart : (erased (List (U8)) us vs) (erased (Nat) j n m q i x) (erased (Ctree) t) (subterm erased (Ca us j n t) f) (erased (Put flag-w us i x vs) s)
    (erased (HDesc m i) d) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (Ca vs j n t) r))
  (let ((erased ap)) (ApGt (Nat) Lt i n (lt-le-trans _ _ _ nm (desc-ge m i d))))
  (let-match erased f (CaN _ j1 _ q2 t1 t2 t3 y tq2 k1 k2 k3 o)
    ((CaE _ _ _ z) (CaE vs j n (zr-apart us vs j n m q i x z s d nm tq mq)))
    ((CaL _ _ c t1 t2 t3 y b o) (CaL vs n c t1 t2 t3 (put-other flag-w us vs i x n c s ap y) b o)))
  (let-match erased (thrice-fn n q q2 tq tq2) (Refl _ _))
  (let ((erased y2)) (put-other flag-w us vs i x n _ s ap y))
  (match erased d _
    ((HDSelf _)
      (let ((erased l2)) (lt-weaken _ _ mq))
      (CaN vs j1 n q t1 t2 t3 y2 tq (r4c-ca-below us vs j1 (Succ q) i x t1 k1 s mq) (r4c-ca-below us vs j1 (Succ (Succ q)) i x t2 k2 s l2)
        (r4c-ca-below us vs j1 (Succ (Succ (Succ q))) i x t3 k3 s (lt-weaken _ _ l2)) o))
    ((HDKid _ q3 c2 _ tm hk d2)
      (let ((erased r1) (erased u1) (erased e1) (erased f1)) (apart-kid n m q q3 (Succ q) c2 nm tq mq tm hk (HK1 q)))
      (let ((erased r2) (erased u2) (erased e2) (erased f2)) (apart-kid n m q q3 (Succ (Succ q)) c2 nm tq mq tm hk (HK2 q)))
      (let ((erased r3) (erased u3) (erased e3) (erased f3)) (apart-kid n m q q3 (Succ (Succ (Succ q))) c2 nm tq mq tm hk (HK3 q)))
      (CaN vs j1 n q t1 t2 t3 y2 tq (r4c-ca-apart us vs j1 (Succ q) c2 r1 i x t1 k1 s d2 e1 u1 f1) (r4c-ca-apart us vs j1 (Succ (Succ q)) c2 r2 i x t2 k2 s d2 e2 u2 f2)
        (r4c-ca-apart us vs j1 (Succ (Succ (Succ q))) c2 r3 i x t3 k3 s d2 e3 u3 f3) o))))

(def-fns _ $ (erased r4c-ca-apart-in : (erased (List (U8)) us vs) (erased (Nat) j n m q) (erased (Ctree) t) (erased (Ca us j n t) f)
    (subterm erased (SetsBelow us vs m) w) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (Ca vs j n t) r))
  (match erased w _
    ((SbNil _ _) f)
    ((SbSet _ ws _ _ i x w1 s d) (r4c-ca-apart ws vs j n m q i x t (r4c-ca-apart-in us ws j n m q t f w1 nm tq mq) s d nm tq mq))))

(def-fns _ $ (erased r4c-ca-sib : (erased (List (U8)) us vs) (erased (Nat) j n m i x) (erased (Ctree) t) (erased (Ca us j n t) f) (erased (Put flag-w us i x vs) s)
    (erased (HDesc m i) d) (erased (Lt m n) mn) (erased (Lt n (Succ (Succ (Succ m)))) nm) (erased (Lt (Zero) m) mp) -> (erased (Ca vs j n t) r))
  (let-match erased d (HDKid _ q3 c _ t3 hk d2) ((HDSelf _) (r4c-ca-below us vs j n i x t f s mn)))
  (let ((erased qn) (erased tn)) (thrice-exists n))
  (let ((erased lo) (erased hi)) (hkid-lt q3 c hk))
  (let ((erased nq)) (le-trans n (Succ (Succ m)) q3 nm (LtS _ _ (thrice-ge2 m q3 mp t3))))
  (r4c-ca-apart us vs j n c qn i x t f s d2 (lt-le-trans _ _ _ nq (LtS _ _ lo)) tn
    (lt-le-trans _ _ _ hi (LtS _ _ (LtS _ _ (thrice-lt m n q3 qn mn t3 tn))))))

(def-fns _ $ (erased r4c-ca-sib-in : (erased (List (U8)) us vs) (erased (Nat) j n m) (erased (Ctree) t) (erased (Ca us j n t) f)
    (subterm erased (SetsBelow us vs m) w) (erased (Lt m n) mn) (erased (Lt n (Succ (Succ (Succ m)))) nm) (erased (Lt (Zero) m) mp) -> (erased (Ca vs j n t) r))
  (match erased w _
    ((SbNil _ _) f)
    ((SbSet _ ws _ _ i x w1 s d) (r4c-ca-sib ws vs j n m i x t (r4c-ca-sib-in us ws j n m t f w1 mn nm mp) s d mn nm mp))))

(def-fns _ $ (erased r4c-ca-lo : (erased (List (U8)) us vs) (erased (Nat) j a m) (erased (Ctree) t) (erased (Ca us j a t) f) (erased (SetsBelow us vs m) w)
    (erased (Lt a m) am) (erased (Lt m (Succ (Succ (Succ a)))) ma) (erased (Lt (Zero) a) ap) -> (erased (Ca vs j a t) r))
  (let ((erased qa) (erased ta)) (thrice-exists a))
  (r4c-ca-apart-in us vs j a m qa t f w am ta (le-trans m (Succ (Succ a)) qa ma (LtS _ _ (thrice-ge2 a qa ap ta)))))

(def-fns _ $ (erased r4c-ca-down : (erased (List (U8)) us) (erased (Nat) j n c) (erased (Ctree) t u) (erased (Col) e) (erased (Ca us (Succ j) n t) f)
    (erased (Kid n e c) kd) (erased (CtSel t e u) s) -> (erased (Ca us j (Succ c) u) r))
  (match erased f _
    ((CaE _ _ _ z)
      (let-match erased s (SelE _))
      (let-match erased z (MkZr _ _ _ q _ tq z1 z2 z3))
      (let ((erased zk))
        (match erased kd (((ZrK us (Succ j) (Succ c)) zk))
          ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) z1)
          ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) z2)
          ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) z3)))
      (let-match erased zk (ZkS _ _ _ z0))
      (CaE us j (Succ c) z0))
    ((CaN _ _ _ q t1 t2 t3 _ tq k1 k2 k3 _)
      (match erased kd _
        ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) (let-match erased s (SelN1 _ _ _)) k1)
        ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased s (SelN2 _ _ _)) k2)
        ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased s (SelN3 _ _ _)) k3)))))

(def-fns _ $ (erased r4c-ca-at : (erased (List (U8)) us) (erased (Nat) j n d D) (erased (Ctree) top t) (subterm erased (List (Col)) pre)
    (erased (Ca us D (Zero) top) f) (erased (HIdx pre n) hi) (erased (CtAt top pre t) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad) -> (erased (Ca us j n t) r))
  (match erased pre _
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) f)
    ((Cons _ e pre1)
      (let-match erased hi (HxCons _ n1 c _ hi1 k))
      (let-match erased pt (AtCons _ u _ _ _ at1 s))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Dq ad1))
      (r4c-ca-down us j n1 c u t e (r4c-ca-at us (Succ j) n1 d1 D top u pre1 f hi1 at1 le1 (add-succ-right d1 j Dq ad1)) k s))))

(def-fns _ $ (erased r4c-ca-step : (erased (List (U8)) us0 us) (erased (Nat) j p x) (erased (Col) e) (erased (Ctree) u s u2) (erased (Ca us0 (Succ j) p u) f)
    (erased (Occ u) ou) (erased (Up3 e u s u2) up) (erased (Kid p e x) k) (erased (SetsBelow us0 us (Succ x)) w) (erased (Ca us j (Succ x) s) ks) (erased (Occ s) os)
    -> (erased (Ca us (Succ j) p u2) r))
  (let-match erased f (CaN _ _ _ q b1 b2 b3 y tq k1 k2 k3 _) (absurd (CaE _ _ _ _) ou))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased pq)) (thrice-le p q tq))
  (match erased up _
    ((UpA _ _ v2 v3 w2 w3)
      (let-match erased k (Ki1 _ _ tk))
      (let-match erased (thrice-fn p q x tq tk) (Refl _ _))
      (let-match erased w2 (SelN2 _ _ _))
      (let-match erased w3 (SelN3 _ _ _))
      (CaN us j p q s b2 b3 (elt-sb us0 us p q1 (Succ (Zero)) y w pq) tq ks (r4c-ca-sib-in us0 us j q2 q1 b2 k2 w l12 l24 p1) (r4c-ca-sib-in us0 us j q3 q1 b3 k3 w l13 l34 p1)
        (Occ1 s b2 b3 os)))
    ((UpB _ _ v1 v3 w1 w3)
      (let-match erased k (Ki2 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelN1 _ _ _))
      (let-match erased w3 (SelN3 _ _ _))
      (CaN us j p q b1 s b3 (elt-sb us0 us p q2 (Succ (Zero)) y w (lt-weaken _ _ pq)) tq (r4c-ca-lo us0 us j q1 q2 b1 k1 w l12 l24 p1) ks
        (r4c-ca-sib-in us0 us j q3 q2 b3 k3 w l23 l35 p2) (Occ2 b1 s b3 os)))
    ((UpC _ _ v1 v2 w1 w2)
      (let-match erased k (Ki3 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelN1 _ _ _))
      (let-match erased w2 (SelN2 _ _ _))
      (CaN us j p q b1 b2 s (elt-sb us0 us p q3 (Succ (Zero)) y w (lt-weaken _ _ (lt-weaken _ _ pq))) tq (r4c-ca-lo us0 us j q1 q3 b1 k1 w l13 l34 p1)
        (r4c-ca-lo us0 us j q2 q3 b2 k2 w l23 l35 p2) ks (Occ3c b1 b2 s os)))))

; The same step from a parent that was empty, its entry now set to 1.
(def-fns _ $ (erased r4c-ca-step0 : (erased (List (U8)) us0 us us1) (erased (Nat) j p x) (erased (Col) e) (erased (Ctree) s u2) (erased (Zr us0 (Succ j) p) z)
    (erased (Put flag-w us p (Succ (Zero)) us1) pu) (erased (Up3 e (CEmpty) s u2) up) (erased (Kid p e x) k) (erased (SetsBelow us0 us (Succ x)) w)
    (erased (Ca us j (Succ x) s) ks) (erased (Occ s) os) -> (erased (Ca us1 (Succ j) p u2) r))
  (let-match erased z (MkZr _ _ _ q _ tq z1 z2 z3))
  (let-match erased z1 (ZkS _ _ _ y1))
  (let-match erased z2 (ZkS _ _ _ y2))
  (let-match erased z3 (ZkS _ _ _ y3))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased pq)) (thrice-le p q tq))
  (let ((erased pq2)) (lt-weaken _ _ pq))
  (let ((erased pq3)) (lt-weaken _ _ pq2))
  (let ((erased E) (erased y)) (values (CEmpty) (put-elt flag-w us us1 p (Succ (Zero)) pu)))
  (let ((erased c1) (erased c2) (erased c3)) (values (CaE us0 j q1 y1) (CaE us0 j q2 y2) (CaE us0 j q3 y3)))
  (match erased up _
    ((UpA _ _ _ _ w2 w3)
      (let-match erased k (Ki1 _ _ tk))
      (let-match erased (thrice-fn p q x tq tk) (Refl _ _))
      (let-match erased w2 (SelE _))
      (let-match erased w3 (SelE _))
      (CaN us1 j p q s E E y tq (r4c-ca-below us us1 j q1 p _ s ks pu pq)
        (r4c-ca-below us us1 j q2 p _ E (r4c-ca-sib-in us0 us j q2 q1 E c2 w l12 l24 p1) pu pq2)
        (r4c-ca-below us us1 j q3 p _ E (r4c-ca-sib-in us0 us j q3 q1 E c3 w l13 l34 p1) pu pq3) (Occ1 s E E os)))
    ((UpB _ _ _ _ w1 w3)
      (let-match erased k (Ki2 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelE _))
      (let-match erased w3 (SelE _))
      (CaN us1 j p q E s E y tq (r4c-ca-below us us1 j q1 p _ E (r4c-ca-lo us0 us j q1 q2 E c1 w l12 l24 p1) pu pq)
        (r4c-ca-below us us1 j q2 p _ s ks pu pq2)
        (r4c-ca-below us us1 j q3 p _ E (r4c-ca-sib-in us0 us j q3 q2 E c3 w l23 l35 p2) pu pq3) (Occ2 E s E os)))
    ((UpC _ _ _ _ w1 w2)
      (let-match erased k (Ki3 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelE _))
