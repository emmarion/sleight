    ((Cd0) (values q0 (Ki1 p q0 tq))) ((Cd1) (values (Succ q0) (Ki2 p q0 tq))) ((Cd2) (values (Succ (Succ q0)) (Ki3 p q0 tq)))))

(def-fns _ $ (erased r4c-ridx-perm : (erased (Nat) r t) (erased (Perm) g) (erased (RotPm r g) rp) (erased (List (Col)) pre2) (subterm erased (List (Col)) pre) (erased (RIdx pre t) ri)
    (erased (PermT g pre pre2) pt) -> (erased (Nat) t2) (erased (RIdx pre2 t2) r2))
  (let-match erased ri (RICons pre1 p1 _ e ri1 k) ((RINil) (let-match erased pt (PTNil _)) (values (Zero) (RINil))))
  (let-match erased pt (PTCons _ _ e2 _ pre21 pc pt1))
  (let ((erased q1) (erased r1)) (r4c-ridx-perm r p1 g rp pre21 pre1 ri1 pt1))
  (let ((erased d) (erased cd)) (kid-cd p1 t e k))
  (let ((erased d2) (erased cd2))
    (match erased rp (((Nat) d2) ((CD d2 e2) cd2))
      ((RotP1) (match erased pc (((Nat) d2) ((CD d2 e2) cd2)) (absurd (PC0 _) cd) ((PC1 _ _ _) (values (Succ (Zero)) (Cd1))) ((PC2 _ _ _) (values (Succ (Succ (Zero))) (Cd2))) ((PC3 _ _ _) (values (Zero) (Cd0)))))
      ((RotP2) (match erased pc (((Nat) d2) ((CD d2 e2) cd2)) (absurd (PC0 _) cd) ((PC1 _ _ _) (values (Succ (Succ (Zero))) (Cd2))) ((PC2 _ _ _) (values (Zero) (Cd0))) ((PC3 _ _ _) (values (Succ (Zero)) (Cd1)))))))
  (let ((erased q2) (erased k2)) (r4c-kid-mk q1 d2 e2 cd2))
  (values q2 (RICons pre21 q1 q2 e2 r1 k2)))

; The trace ti of pre is the rotation t1 by g of the trace i of pg exactly when the trace of pre rotated back by g2 is i.
(def-fns _ $ (erased r4c-rot-eq : (erased (Perm) g g2) (erased (PermInv g g2) pi) (erased (PermInv g2 g) pi2) (erased (Nat) h ti ia i t1) (erased (Bit) e) (erased (List (Col)) pre pa pg p1)
    (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le) (erased (PermT g2 pre pa) qa) (erased (RIdx pa ia) ra) (erased (Length (Col) pa (Succ h)) la)
    (erased (RIdx pg i) rg) (erased (Length (Col) pg (Succ h)) lg) (erased (PermT g pg p1) q1) (erased (RIdx p1 t1) r1) (erased (Length (Col) p1 (Succ h)) l1)
    (erased (EqB t1 ti e) eq) -> (erased (EqB i ia e) r))
  (match erased eq _
    ((EbSame _)
      (let-match erased (ridx-fn p1 pre t1 (Succ h) r1 ri l1 le) (Refl _ _))
      (let-match erased (permt-fn g2 p1 pg pa (permt-invert g g2 pg p1 pi q1) qa) (Refl _ _))
      (let-match erased (r4c-ridx-det pg i ia rg ra) (Refl _ _))
      (EbSame i))
    ((EbDiff _ _ ap)
      (match erased (nat-eq i ia) _
        ((Unequal _ _ _ _ ap2) (EbDiff i ia ap2))
        (absurd (Equal _ _ _)
          (let-match erased (ridx-fn pg pa i (Succ h) rg ra lg la) (Refl _ _))
          (let-match erased (permt-fn g pg p1 pre q1 (permt-invert g2 g pre pa pi2 qa)) (Refl _ _))
          (let-match erased (r4c-ridx-det pre t1 ti r1 ri) (Refl _ _))
          (apart-irrefl t1 ap))))))

(def-fns _ $ (erased r4c-or-shuffle : (erased (Bit) b0 e1 e2 b1 b2 ma mb m bf ba bb) (erased (BitApply or-op b0 e1 b1) o1) (erased (BitApply or-op b1 e2 b2) o2)
    (erased (BitApply or-op ma mb m) o3) (erased (BitApply or-op b2 m bf) o4) (erased (BitApply or-op e1 ma ba) o5) (erased (BitApply or-op e2 mb bb) o6)
    -> (erased (Bit) bab) (erased (BitApply or-op ba bb bab) r1) (erased (BitApply or-op b0 bab bf) r2))
  (match erased e1 _
    ((Bit1)
      (let-match erased (bitapply-fn or-op b0 (Bit1) b1 (Bit1) o1 (r4c-or1 b0)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit1) e2 b2 (Bit1) o2 (r4c-or1l e2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit1) m bf (Bit1) o4 (r4c-or1l m)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit1) ma ba (Bit1) o5 (r4c-or1l ma)) (Refl _ _))
      (values (Bit1) (r4c-or1l bb) (r4c-or1 b0)))
    ((Bit0)
      (let-match erased (bitapply-fn or-op b0 (Bit0) b1 b0 o1 (r4c-or0 b0)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit0) ma ba ma o5 (r4c-or0l ma)) (Refl _ _))
      (match erased e2 _
        ((Bit1)
          (let-match erased (bitapply-fn or-op b0 (Bit1) b2 (Bit1) o2 (r4c-or1 b0)) (Refl _ _))
          (let-match erased (bitapply-fn or-op (Bit1) m bf (Bit1) o4 (r4c-or1l m)) (Refl _ _))
          (let-match erased (bitapply-fn or-op (Bit1) mb bb (Bit1) o6 (r4c-or1l mb)) (Refl _ _))
          (values (Bit1) (r4c-or1 ba) (r4c-or1 b0)))
        ((Bit0)
          (let-match erased (bitapply-fn or-op b0 (Bit0) b2 b0 o2 (r4c-or0 b0)) (Refl _ _))
          (let-match erased (bitapply-fn or-op (Bit0) mb bb mb o6 (r4c-or0l mb)) (Refl _ _))
          (values m o3 o4))))))

(def-fns _ $ (erased r4c-gad-le : (erased (Nat) h i n) (erased (List (Copy (Nat))) xs) (erased (Ctree) c c3) (erased (List (Nat)) T T3) (subterm erased (GAd h xs i n c T c3 T3) ga)
    -> (erased (Lt i (Succ n)) r))
  (let-match erased ga (GaC _ _ _ _ _ _ _ _ _ c2 _ _ _ T2 _ _ _ _ _ _ _ _ _ _ _ _ _ g3) ((GaE _ _ _ _ _) (lt-succ n)))
  (lt-succ-left i (Succ n) (r4c-gad-le h (Succ i) n xs c2 c3 T2 T3 g3)))

; Over the gone entries i to n, R, the bit in c and in T of the trace ti of pre is or-ed with whether pre rotated back by 1 (pa, ia) or by 2 (pb, ib) is one of them.
(def-fns _ $ (erased r4c-gad-bit : (erased (Nat) h i n ti ia ib) (erased (List (Copy (Nat))) xs) (erased (Ctree) c c3 x0) (erased (List (Nat)) T T3 R) (erased (List (Col)) pre pa pb)
    (erased (Bit) b0) (subterm erased (GAd h xs i n c T c3 T3) ga) (erased (Fwd xs i n R) fw) (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le)
    (erased (PermT p312 pre pa) qa) (erased (RIdx pa ia) ra) (erased (Length (Col) pa (Succ h)) la) (erased (PermT p231 pre pb) qb) (erased (RIdx pb ib) rb)
    (erased (Length (Col) pb (Succ h)) lb) (erased (CtAt c pre x0) a0) (erased (Lf x0 b0) l0) (erased (MemB ti T b0) m0)
    -> (erased (Ctree) x) (erased (Bit) ba bb bab b) (erased (CtAt c3 pre x) a) (erased (Lf x b) l) (erased (MemB ti T3 b) m) (erased (MemB ia R ba) mba) (erased (MemB ib R bb) mbb)
    (erased (BitApply or-op ba bb bab) o1) (erased (BitApply or-op b0 bab b) o2))
  (match erased ga _
    ((GaE _ _ _ _ _)
      (let-match erased fw (FwE _ _) (absurd (FwC _ _ _ _ R1 _ f1) (lt-irrefl (Succ n) (r4c-fwd-le xs (Succ n) n R1 f1))))
      (values x0 (Bit0) (Bit0) (Bit0) b0 a0 l0 m0 (MbN ia _ (NotInNil ia)) (MbN ib _ (NotInNil ib)) (Ap00 or-op) (r4c-or0 b0)))
    ((GaC _ _ _ _ g t1 t2 _ c1 c2 _ _ T1 T2 _ pg p1 p2 w rg lg q1 r1 a1 q2 r2 a2 g3)
      (let-match erased fw (FwC _ _ _ y R1 wy fw1) (absurd (FwE _ _) (lt-irrefl (Succ i) (r4c-gad-le h (Succ i) i xs c2 c3 T2 T3 g3))))
      (let-match erased (welt-fn xs i y g wy w) (Refl _ _))
      (let ((erased lp1) (erased lp2)) (values (permt-length p231 pg p1 (Succ h) q1 lg) (permt-length p312 pg p2 (Succ h) q2 lg)))
      (let ((erased e1) (erased b1) (erased x1) (erased eq1) (erased ax1) (erased lx1) (erased mx1) (erased o1)) (r4c-cad-bit h t1 ti c c1 x0 T T1 p1 pre b0 a1 r1 lp1 ri le a0 l0 m0))
      (let ((erased e2) (erased b2) (erased x2) (erased eq2) (erased ax2) (erased lx2) (erased mx2) (erased o2)) (r4c-cad-bit h t2 ti c1 c2 x1 T1 T2 p2 pre b1 a2 r2 lp2 ri le ax1 lx1 mx1))
      (let ((erased x) (erased ma) (erased mb) (erased m) (erased bf) (erased ax) (erased lx) (erased mx) (erased mba1) (erased mbb1) (erased o3) (erased o4))
        (r4c-gad-bit h (Succ i) n ti ia ib xs c2 c3 x2 T2 T3 R1 pre pa pb b2 g3 fw1 ri le qa ra la qb rb lb ax2 lx2 mx2))
      (let ((erased eqa)) (r4c-rot-eq p231 p312 (PI231) (PI312) h ti ia g t1 e1 pre pa pg p1 ri le qa ra la rg lg q1 r1 lp1 eq1))
      (let ((erased eqb)) (r4c-rot-eq p312 p231 (PI312) (PI231) h ti ib g t2 e2 pre pb pg p2 ri le qb rb lb rg lg q2 r2 lp2 eq2))
      (let ((erased ba) (erased mba) (erased o5)) (r4c-memb-cons g ia R1 e1 ma eqa mba1))
      (let ((erased bb) (erased mbb) (erased o6)) (r4c-memb-cons g ib R1 e2 mb eqb mbb1))
      (let ((erased bab) (erased s1) (erased s2)) (r4c-or-shuffle b0 e1 e2 b1 b2 ma mb m bf ba bb o1 o2 o3 o4 o5 o6))
      (values x ba bb bab bf ax lx mx mba mbb s1 s2))))

(def-fns _ $ (erased r4c-mem-dec : (erased (Nat) x) (subterm erased (List (Nat)) R) -> (erased (Bit) b) (erased (MemB x R b) m))
  (let-match erased R (Cons _ y R1) ((Nil _) (values (Bit0) (MbN x R (NotInNil x)))))
  (let-match erased (nat-eq x y) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values (Bit1) (MbY x R (InHere x R1)))))
  (let ((erased b) (erased m)) (r4c-mem-dec x R1))
  (values b (match erased m (((MemB x R b) r)) ((MbY _ _ p) (MbY x R (InThere x y R1 p))) ((MbN _ _ o) (MbN x R (NotInCons x y R1 ap o))))))

(def-fns _ $ (erased r4c-fwd-at : (erased (List (Copy (Nat))) xs) (erased (Nat) i n y) (erased (List (Nat)) R) (subterm erased (Fwd xs i n R) f) (erased (In y R) p)
    -> (erased (Nat) j) (erased (WElt xs j y) w) (erased (Lt j n) l))
  (let-match erased f (FwC _ _ _ x R1 wx f1) (absurd (FwE _ _) p))
  (let ((erased il)) (lt-pred i n (r4c-fwd-le xs (Succ i) n R1 f1)))
  (let-match erased p (InThere _ _ _ p1) ((InHere _ _) (values i wx il)))
  (r4c-fwd-at xs (Succ i) n y R1 f1 p1))

; Bits read over the gone entries are those over the gone buffer.
(def-fns _ $ (erased r4c-memb-conv : (erased (List (Copy (Nat))) xs) (erased (Nat) n x) (erased (List (Nat)) R G) (erased (Bit) b) (erased (MemB x R b) m) (erased (Fwd xs (Zero) n R) fw)
    (erased (Tbk xs n G) tb) -> (erased (MemB x G b) r))
  (match erased m _
    ((MbY _ _ p) (let ((erased j) (erased w) (erased l)) (r4c-fwd-at xs (Zero) n x R fw p)) (MbY x G (r4c-tbk-at xs n j x G tb w l)))
    ((MbN _ _ o)
      (let ((erased b2) (erased m2)) (r4c-mem-dec x G))
      (let-match erased m2 (MbN _ _ _)
        (absurd (MbY _ _ p)
          (let ((erased j) (erased w) (erased l)) (r4c-tbk-in xs n x G tb p))
          (apart-irrefl x (notin-in x x R o (r4c-fwd-in xs (Zero) n j x R fw w (LtZ j) l)))))
      m2)))

(def-fns _ $ (erased r4c-ctat-e : (subterm erased (List (Col)) pre) -> (erased (CtAt (CEmpty) pre (CEmpty)) a))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (AtNil (CEmpty))))
  (AtCons (CEmpty) (CEmpty) (CEmpty) pre1 e (r4c-ctat-e pre1) (SelE e)))

(def-fns _ $ (erased r4c-ctat-h : (erased (Nat) k d j) (erased (Ctree) top t) (subterm erased (List (Col)) pre) (erased (CtH k top) hk) (erased (CtAt top pre t) a)
    (erased (Length (Col) pre d) le) (erased (Add d j k) ad) -> (erased (CtH j t) r))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (let-match erased a (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) hk))
  (let-match erased a (AtCons _ u _ _ _ a1 s))
  (let-match erased le (LengthCons _ _ _ d1 le1))
  (let-match erased ad (AddSucc _ _ k1 ad1))
  (let ((erased hu)) (r4c-ctat-h k d1 (Succ j) top u pre1 hk a1 le1 (add-succ-right d1 j k1 ad1)))
  (match erased s _
    ((SelN0 _ _ _) (HE j)) ((SelN1 w1 w2 w3) (sel-h j w1 w2 w3 t e hu s)) ((SelN2 w1 w2 w3) (sel-h j w1 w2 w3 t e hu s)) ((SelN3 w1 w2 w3) (sel-h j w1 w2 w3 t e hu s))
    (absurd (SelL _ _) hu) ((SelE _) (HE j))))

(def-fns _ $ (erased r4c-gonet-get : (erased (List (Nat)) T) (erased (Ctree) gone) (erased (Nat) j p i) (erased (List (Col)) pre w) (subterm erased (GoneT T gone j p pre) gt)
    (erased (TIdx p w i) ti) (erased (Length (Col) w j) lw) -> (erased (Nat) g) (erased (List (Col)) et) (erased (RevApp (Col) pre w et) ra) (erased (CtSub gone et g) s) (erased (TIn g T i) tn))
  (match erased gt _
    ((GtL _ _ _ g _ et ra s tn) (let-match erased lw (LengthNil _)) (let-match erased ti (TINil _)) (values g et ra s tn))
    ((GtN _ _ j1 _ q _ tq a1 a2 a3)
      (let-match erased lw (LengthCons _ e w1 _ lw1))
      (let-match erased ti (TICons _ c _ _ _ k ti1))
      (let ((erased g) (erased et) (erased ra) (erased s) (erased tn))
        (match erased k (((Nat) g) ((List (Col)) et) ((RevApp (Col) (Cons (Col) e pre) w1 et) ra) ((CtSub gone et g) s) ((TIn g T i) tn))
          ((Ki1 _ q1 t1) (let-match erased (thrice-fn p q q1 tq t1) (Refl _ _)) (r4c-gonet-get T gone j1 c i (Cons _ (C1) pre) w1 a1 ti1 lw1))
          ((Ki2 _ q1 t1) (let-match erased (thrice-fn p q q1 tq t1) (Refl _ _)) (r4c-gonet-get T gone j1 c i (Cons _ (C2) pre) w1 a2 ti1 lw1))
          ((Ki3 _ q1 t1) (let-match erased (thrice-fn p q q1 tq t1) (Refl _ _)) (r4c-gonet-get T gone j1 c i (Cons _ (C3) pre) w1 a3 ti1 lw1))))
      (let-match erased ra (RACons _ _ _ _ _ ra1))
      (values g et ra1 s tn))))

; The trace ia of gone, of the colours pa: its bit, whether ia is in G.
(def-fns _ $ (erased r4c-gone-bit : (erased (List (Nat)) G) (erased (Ctree) gone) (erased (Nat) h ia) (erased (List (Col)) pa) (erased (GoneT G gone (Succ h) (Zero) (Nil (Col))) gt)
    (erased (CtH (Succ h) gone) hg) (erased (RIdx pa ia) ra) (erased (Length (Col) pa (Succ h)) la) -> (erased (Ctree) z) (erased (Bit) v) (erased (CtAt gone pa z) az) (erased (Lf z v) lz)
    (erased (MemB ia G v) m))
  (let ((erased et) (erased re)) (rev-exists pa (Nil _)))
  (let ((erased ti)) (ridx-tidx pa (Nil _) et ia ia ra re (TINil ia)))
  (let ((erased le)) (rev-len pa (Nil _) et (Succ h) (Zero) (Succ h) re la (LengthNil _) (add-zero-right (Succ h))))
  (let ((erased g) (erased et2) (erased re2) (erased s) (erased tn)) (r4c-gonet-get G gone (Succ h) (Zero) ia (Nil _) et gt ti le))
  (let-match erased re2 (RANil _ _))
  (let ((erased z) (erased az)) (ctat-exists gone pa))
  (let ((erased n) (erased rz)) (root-exists z))
  (let-match erased (sub-fn gone et n g (at-sub gone z pa (Nil _) et n az re (SubNil z n rz)) s) (Refl _ _))
  (let ((erased hz)) (r4c-ctat-h (Succ h) (Succ h) (Zero) gone z pa hg az la (add-zero-right (Succ h))))
  (match erased tn _
    ((TiOut _ _ o) (let-match erased hz (HE _) (absurd (HL _ _) rz)) (values z (Bit0) az (LfE) (MbN ia G o)))
    ((TiIn _ _ _ p) (let-match erased hz (HL lf _) (absurd (HE _) rz)) (values z (Bit1) az (LfL lf) (MbY ia G p)))))

(def-fns _ $ (erased r4c-perm-sel : (erased (Perm) g) (erased (Ctree) v u x y) (erased (Col) e e2) (erased (CtPerm g v u) p) (erased (CtSel u e x) sx) (erased (PermC g e e2) pc)
    (erased (CtSel v e2 y) sy) -> (erased (CtPerm g y x) r))
  (match erased p _
    ((CPE _) (let-match erased sx (SelE _)) (let-match erased sy (SelE _)) (CPE g))
    ((CPL _ _) (let-match erased sx (SelL _ _)) (let-match erased sy (SelL _ _)) (CPE g))
    ((CPN g1 g2 g3 t1 t2 t3 u1 u2 u3 a1 a2 a3 _ s1 s2 s3 p1 p2 p3 c)
      (let ((erased sx2)) (cons-sel a1 a2 a3 u x e c sx))
      (match erased pc _
        ((PC0 _) (let-match erased sx2 (SelN0 _ _ _)) (let-match erased sy (SelN0 _ _ _)) (CPE g))
        ((PC1 _ _ _) (let-match erased sx2 (SelN1 _ _ _)) (let-match erased (sel-fn v y u1 e2 sy s1) (Refl _ _)) p1)
        ((PC2 _ _ _) (let-match erased sx2 (SelN2 _ _ _)) (let-match erased (sel-fn v y u2 e2 sy s2) (Refl _ _)) p2)
        ((PC3 _ _ _) (let-match erased sx2 (SelN3 _ _ _)) (let-match erased (sel-fn v y u3 e2 sy s3) (Refl _ _)) p3)))))

; The subtree of tp at pre, and that of t at pre moved by g.
(def-fns _ $ (erased r4c-perm-at : (erased (Perm) g) (erased (Ctree) t tp x y) (subterm erased (List (Col)) pre) (erased (List (Col)) pre2) (erased (CtPerm g t tp) p)
    (erased (CtAt tp pre x) ax) (erased (PermT g pre pre2) pt) (erased (CtAt t pre2 y) ay) -> (erased (CtPerm g y x) r))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (let-match erased ax (AtNil _)) (let-match erased pt (PTNil _)) (let-match erased ay (AtNil _)) p))
  (let-match erased ax (AtCons _ u _ _ _ ax1 sx))
  (let-match erased pt (PTCons _ _ e2 _ pre21 pc pt1))
  (let-match erased ay (AtCons _ v _ _ _ ay1 sy))
  (r4c-perm-sel g v u x y e e2 (r4c-perm-at g t tp u v pre1 pre21 p ax1 pt1 ay1) sx pc sy))

(def-fns _ $ (erased r4c-or-sel : (erased (Ctree) ua ub u xa xb x) (erased (Col) e) (erased (CtOr ua ub u) o) (erased (CtSel ua e xa) sa) (erased (CtSel ub e xb) sb)
    (erased (CtSel u e x) s) -> (erased (CtOr xa xb x) r))
  (match erased o _
    ((OrEL _) (let-match erased sa (SelE _)) (let-match erased (sel-fn ub xb x e sb s) (Refl _ _)) (OrEL x))
    ((OrER _) (let-match erased sb (SelE _)) (let-match erased (sel-fn ua xa x e sa s) (Refl _ _)) (OrER x))
    ((OrLL _ _) (let-match erased sa (SelL _ _)) (let-match erased sb (SelL _ _)) (let-match erased s (SelL _ _)) (OrEL (CEmpty)))
    ((OrNN l1 l2 l3 r1 r2 r3 u1 u2 u3 _ o1 o2 o3 c)
      (let ((erased s2)) (cons-sel u1 u2 u3 u x e c s))
      (match erased sa _
        ((SelN0 _ _ _) (let-match erased s2 (SelN0 _ _ _)) (let-match erased sb (SelN0 _ _ _)) (OrEL (CEmpty)))
        ((SelN1 _ _ _) (let-match erased s2 (SelN1 _ _ _)) (let-match erased sb (SelN1 _ _ _)) o1)
        ((SelN2 _ _ _) (let-match erased s2 (SelN2 _ _ _)) (let-match erased sb (SelN2 _ _ _)) o2)
        ((SelN3 _ _ _) (let-match erased s2 (SelN3 _ _ _)) (let-match erased sb (SelN3 _ _ _)) o3)))))

(def-fns _ $ (erased r4c-or-atp : (erased (Ctree) a b t xa xb x) (subterm erased (List (Col)) pre) (erased (CtOr a b t) o) (erased (CtAt a pre xa) aa) (erased (CtAt b pre xb) ab)
    (erased (CtAt t pre x) az) -> (erased (CtOr xa xb x) r))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (let-match erased aa (AtNil _)) (let-match erased ab (AtNil _)) (let-match erased az (AtNil _)) o))
  (let-match erased aa (AtCons _ ua _ _ _ aa1 sa))
  (let-match erased ab (AtCons _ ub _ _ _ ab1 sb))
  (let-match erased az (AtCons _ u _ _ _ az1 s))
  (r4c-or-sel ua ub u xa xb x e (r4c-or-atp a b t ua ub u pre1 o aa1 ab1 az1) sa sb s))

(def-fns _ $ (erased r4c-perm-lf : (erased (Perm) g) (erased (Ctree) y x) (erased (Bit) v) (erased (CtPerm g y x) p) (erased (Lf y v) l) -> (erased (Lf x v) r))
  (match erased l _ ((LfE) (let-match erased p (CPE _)) (LfE)) ((LfL lf) (let-match erased p (CPL _ _)) (LfL lf))))

(def-fns _ $ (erased r4c-or-lf : (erased (Ctree) xa xb x) (erased (Bit) va vb) (erased (CtOr xa xb x) o) (erased (Lf xa va) la) (erased (Lf xb vb) lb)
    -> (erased (Bit) v) (erased (Lf x v) l) (erased (BitApply or-op va vb v) ap))
