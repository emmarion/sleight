(def-adts
  ; Each trace of t, of j + 1 more colours from the prefix p, is in R.
  ((MI : ((List (Nat)) R) ((Nat) j) ((Nat) p) ((Ctree) t) -> Type)
    enum
    (many MiL : (erased (List (Nat)) R) (erased (Nat) p qp) (erased (Ctree) t t1 t2 t3) (erased (Thrice p qp) tp) (erased (CtSel t (C1) t1) s1) (erased (CtSel t (C2) t2) s2)
        (erased (CtSel t (C3) t3) s3) (erased (MI1 R qp t1) m1) (erased (MI1 R (Succ qp) t2) m2) (erased (MI1 R (Succ (Succ qp)) t3) m3) -> (MI R (Zero) p t))
    (many MiN : (erased (List (Nat)) R) (erased (Nat) j p qp) (erased (Ctree) t t1 t2 t3) (erased (Thrice p qp) tp) (erased (CtSel t (C1) t1) s1) (erased (CtSel t (C2) t2) s2)
        (erased (CtSel t (C3) t3) s3) (erased (MI R j qp t1) m1) (erased (MI R j (Succ qp) t2) m2) (erased (MI R j (Succ (Succ qp)) t3) m3) -> (MI R (Succ j) p t)))
  ; u, the trace i's leaf, is empty or i is in R.
  ((MI1 : ((List (Nat)) R) ((Nat) i) ((Ctree) u) -> Type)
    enum
    (many Mi1E : (erased (List (Nat)) R) (erased (Nat) i) -> (MI1 R i (CEmpty)))
    (many Mi1In : (erased (List (Nat)) R) (erased (Nat) i) (erased (Ctree) u) (erased (In i R) p) -> (MI1 R i u))))

