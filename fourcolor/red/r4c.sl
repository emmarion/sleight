; Over the entries i to n of the gone list xs, red4's cadd of each trace's rotations by 1 and by 2 takes c and T to c2 and T2.
(def-adts $ (GAd : ((Nat) h) ((List (Copy (Nat))) xs) ((Nat) i) ((Nat) n) ((Ctree) c) ((List (Nat)) T) ((Ctree) c2) ((List (Nat)) T2) -> Type)
  enum
  (many GaE : (erased (Nat) h) (erased (List (Copy (Nat))) xs) (erased (Nat) n) (erased (Ctree) c) (erased (List (Nat)) T) -> (GAd h xs n n c T c T))
  (many GaC : (erased (Nat) h) (erased (List (Copy (Nat))) xs) (erased (Nat) i n g t1 t2) (erased (Ctree) c c1 c2 c3) (erased (List (Nat)) T T1 T2 T3) (erased (List (Col)) pg p1 p2)
      (erased (WElt xs i g) w) (erased (RIdx pg g) rg) (erased (Length (Col) pg (Succ h)) lg) (erased (PermT p231 pg p1) q1) (erased (RIdx p1 t1) r1) (erased (CAd c T t1 p1 c1 T1) a1)
      (erased (PermT p312 pg p2) q2) (erased (RIdx p2 t2) r2) (erased (CAd c1 T1 t2 p2 c2 T2) a2) (erased (GAd h xs (Succ i) n c2 T2 c3 T3) g3) -> (GAd h xs i n c T c3 T3)))

(def-lvl r4c-lg)

; red4's loop of s_round over gone: each trace's rotations by 1 and by 2 join the ctr trie and celems.
(def-fns _ $ (many r4-gadd : (erased (List (U8)) us0) (unique (Bytes us0) ca0) (erased (Nat) len) (erased (Sz flag-w us0 len) zs0) (erased (List (Nat)) T0) (unique (Buf T0) cel0)
    (many (Nat) h0) (erased (Lt (Succ h0) 17) hl) (many (Eng h0) e) (erased (List (Nat)) G) (unique (Buf G) gb) (erased (Nat) N) (erased (Pw3 (Succ h0) (Succ (Zero)) N) pw)
    (erased (AllLt G N) al) (erased (Nat) k) (erased (Length (Nat) G k) lk) (erased (Lt k u62-modulus) kb) (erased (Ctree) c0) (erased (Ca us0 h0 (Zero) c0) f0) ->
    (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca0) (erased (Sz flag-w us2 len) zs2) (erased (List (Nat)) T2) (unique (Buf T2) cel2 at cel0) (unique gb is gb2 at gb)
    (erased (Ctree) c2) (erased (Ca us2 h0 (Zero) c2) f2) (erased (List (Copy (Nat))) xs) (erased (Nat) n) (erased (Tbk xs n G) tb) (erased (List (Nat)) R) (erased (Fwd xs (Zero) n R) fw)
    (erased (GAd h0 xs (Zero) n c0 T0 c2 T2) ga))
  (let-match erased r4-e0 (Refl _ _))
  (let-match unique gb (MkBuf _ xs a n cap l cp au nc tb u))
  (let-match erased (length-fn _ G n k (r4c-tbk-len xs n G tb) lk) (Refl _ _))
  (def-fns r4c-lg $ (many go : (erased (List (U8)) us) (unique (Bytes us) ca at ca0) (erased (Sz flag-w us len) zs) (erased (List (Nat)) T) (unique (Buf T) cel at cel0)
      (unique (Array (Copy (Nat)) xs) b at a) (many h0 is h at h0) (many n is nn at n) (many (Nat) i) (subterm erased (Nat) kk) (erased (Add i kk n) ad) (erased (Ctree) c)
      (erased (Ca us h (Zero) c) f) -> (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca) (erased (Sz flag-w us2 len) zs2) (erased (List (Nat)) T2) (unique (Buf T2) cel2 at cel)
      (unique b is b2 at b) (erased (Ctree) c2) (erased (Ca us2 h (Zero) c2) f2) (erased (GAd h xs i n c T c2 T2) ga))
    (let-match erased r4-e0 (Refl _ _))
    (let-match erased r4-e2 (Refl _ _))
    (let ((erased ib)) (le-u62 i n (add-le-left i kk n ad) kb))
    (let-match many (u62-lt-dec i nn ib kb) (Yes _ _ _ _ il)
      ((No _ _ _ _ le)
        (let-match erased kk (Zero) (absurd (Succ k0) (lt-irrefl i (lt-le-trans i n i (add-pos-lt i kk n ad (LtZ k0)) (le-lt-succ n i le)))))
        (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _))
        (values us ca zs T cel b c f (GaE h xs i c T))))
    (let-match erased kk (Succ k1) (absurd (Zero) (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _)) (lt-irrefl i il)))
    (let ((erased cv) (erased nth)) (nth-exists _ xs cap i l (lt-le-trans i n cap il nc)))
    (let-match erased cv (MkCopy _ x0))
    (let ((many g) (unique b1)) (array-get _ _ b i _ nth))
    (let ((erased wg)) (MkWElt xs i g nth))
    (let ((erased gl)) (r4c-alllt-in g N G al (r4c-tbk-at xs n i g G tb wg il)))
    (let ((erased pg) (erased rg) (erased lg)) (ridx-of h N g pw gl))
    (let ((many t1) (erased p1) (erased q1) (erased r1)) (r4-rot h e 0 g (Succ (Zero)) p231 (RsOne) pg rg lg))
    (let ((erased l1)) (permt-length p231 pg p1 (Succ h) q1 lg))
    (let ((erased us1) (unique ca1) (erased zs1) (erased T1) (unique cel1) (erased c1) (erased f1) (erased a1))
      (r4-cadd us ca len zs T cel h t1 hl N pw (r4c-ridx-lt t1 (Succ h) N p1 r1 l1 pw) c f p1 r1 l1))
    (let ((many t2) (erased p2) (erased q2) (erased r2)) (r4-rot h e 2 g (Succ (Succ (Zero))) p312 (RsTwo) pg rg lg))
    (let ((erased l2)) (permt-length p312 pg p2 (Succ h) q2 lg))
    (let ((erased us3) (unique ca3) (erased zs3) (erased T3) (unique cel3) (erased c3) (erased f3) (erased a3))
      (r4-cadd us1 ca1 len zs1 T1 cel1 h t2 hl N pw (r4c-ridx-lt t2 (Succ h) N p2 r2 l2 pw) c1 f1 p2 r2 l2))
    (let ((erased us4) (unique ca4) (erased zs4) (erased T4) (unique cel4) (unique b4) (erased c4) (erased f4) (erased ga))
      (tail $ go us3 ca3 zs3 T3 cel3 b1 h nn (u62-inc i (lt-le-trans (Succ i) (Succ n) u62-modulus (LtS i n il) (LtS n u62-modulus kb))) k1 (add-sh i k1 n ad) c3 f3))
    (values us4 ca4 zs4 T4 cel4 b4 c4 f4 (GaC h xs i n g t1 t2 c c1 c3 c4 T T1 T3 T4 pg p1 p2 wg rg lg q1 r1 a1 q2 r2 a3 ga)))
  (let ((erased us2) (unique ca2) (erased zs2) (erased T2) (unique cel2) (unique a2) (erased c2) (erased f2) (erased ga)) (go us0 ca0 zs0 T0 cel0 a h0 n 0 n (AddZero n) c0 f0))
  (let ((erased R) (erased fw)) (r4c-fwd-ex xs (Zero) n cap n (AddZero n) l au nc))
  (values us2 ca2 zs2 T2 cel2 (at unique (u G xs a2 n cap l cp au nc tb)) c2 f2 xs n tb R fw ga))

; y2 is what the trace path j holds after the path i is replaced by s, y before.
(def-adts $ (RpR : ((Nat) i) ((Nat) j) ((Ctree) s) ((Ctree) y) ((Ctree) y2) -> Type)
  enum
  (many RrS : (erased (Nat) i) (erased (Ctree) s y) -> (RpR i i s y s))
  (many RrO : (erased (Nat) i j) (erased (Ctree) s y) (erased (Apart (Nat) Lt i j) ap) -> (RpR i j s y y)))

(def-fns _ $ (erased r4c-up3-sel : (erased (Col) e f) (erased (Ctree) u s u2 y) (erased (Nat) a b) (erased (Up3 e u s u2) up) (erased (KidCmp e f a b) kc) (erased (CtSel u f y) sy)
    -> (erased (Ctree) y2) (erased (CtSel u2 f y2) s2) (erased (RpR a b s y y2) rr))
  (match erased kc _
    ((KcSame _ _)
      (values s (match erased up (((CtSel u2 e s) r)) ((UpA _ _ a2 a3 _ _) (SelN1 s a2 a3)) ((UpB _ _ a1 a3 _ _) (SelN2 a1 s a3)) ((UpC _ _ a1 a2 _ _) (SelN3 a1 a2 s)))
        (RrS a s y)))
    ((KcNe _ _ _ _ ne ap)
      (values y
        (match erased up (((CtSel u2 f y) r))
          ((UpA _ _ a2 a3 w2 w3)
            (match erased ne _
              ((N12) (let-match erased (sel-fn u y a2 f sy w2) (Refl _ _)) (SelN2 s a2 a3))
              ((N13) (let-match erased (sel-fn u y a3 f sy w3) (Refl _ _)) (SelN3 s a2 a3))))
          ((UpB _ _ a1 a3 w1 w3)
            (match erased ne _
              ((N21) (let-match erased (sel-fn u y a1 f sy w1) (Refl _ _)) (SelN1 a1 s a3))
              ((N23) (let-match erased (sel-fn u y a3 f sy w3) (Refl _ _)) (SelN3 a1 s a3))))
          ((UpC _ _ a1 a2 w1 w2)
            (match erased ne _
              ((N31) (let-match erased (sel-fn u y a1 f sy w1) (Refl _ _)) (SelN1 a1 a2 s))
              ((N32) (let-match erased (sel-fn u y a2 f sy w2) (Refl _ _)) (SelN2 a1 a2 s)))))
        (RrO a b s y ap)))))

(def-fns _ $ (erased r4c-rp-at : (erased (Ctree) top s t2 y) (erased (Nat) ip iq k) (subterm erased (List (Col)) p) (erased (List (Col)) q) (erased (Rp top p s t2) r)
    (erased (RIdx p ip) rp) (erased (RIdx q iq) rq) (erased (Length (Col) p k) lp) (erased (Length (Col) q k) lq) (erased (CtAt top q y) aq)
    -> (erased (Ctree) y2) (erased (CtAt t2 q y2) a2) (erased (RpR ip iq s y y2) rr))
  (let-match erased p (Cons _ e p1)
    ((Nil _)
      (let-match erased r (RpNil _ _))
      (let-match erased lp (LengthNil _))
      (let-match erased lq (LengthNil _))
      (let-match erased rp (RINil))
      (let-match erased rq (RINil))
      (let-match erased aq (AtNil _))
      (values s (AtNil s) (RrS (Zero) s top))))
  (let-match erased r (RpCons _ u u2 _ _ _ _ au up r1))
  (let-match erased rp (RICons _ a _ _ rp1 ka))
  (let-match erased lp (LengthCons _ _ _ k1 lp1))
  (let-match erased lq (LengthCons _ f q1 _ lq1))
  (let-match erased rq (RICons _ b _ _ rq1 kb))
  (let-match erased aq (AtCons _ v _ _ _ aq1 sv))
  (let ((erased y21) (erased a21) (erased rr1)) (r4c-rp-at top u2 t2 v a b k1 p1 q1 r1 rp1 rq1 lp1 lq1 aq1))
  (let-match erased rr1 (RrS _ _ _) ((RrO _ _ _ _ ap) (values y (AtCons t2 v y q1 f a21 sv) (RrO ip iq s y (kid-apart a b ip iq e f ap ka kb)))))
  (let-match erased (ridx-fn p1 q1 a k1 rp1 rq1 lp1 lq1) (Refl _ _))
  (let-match erased (ctat-fn top u v p1 au aq1) (Refl _ _))
  (let ((erased y2) (erased s2) (erased rr)) (r4c-up3-sel e f u s u2 y ip iq up (kid-dec a ip iq e f ka kb) sv))
  (values y2 (AtCons t2 u2 y2 q1 f a21 s2) rr))

; b is Bit1 exactly when x is in R.
(def-adts $ (MemB : ((Nat) x) ((List (Nat)) R) ((Bit) b) -> Type)
  enum
  (many MbY : (erased (Nat) x) (erased (List (Nat)) R) (erased (In x R) p) -> (MemB x R (Bit1)))
  (many MbN : (erased (Nat) x) (erased (List (Nat)) R) (erased (NotIn x R) p) -> (MemB x R (Bit0))))

(def-fns _ $ (erased r4c-or0l : (erased (Bit) a) -> (erased (BitApply or-op (Bit0) a a) r))
  (match erased a _ ((Bit0) (Ap00 or-op)) ((Bit1) (Ap01 (Bit1) (Bit1) (Bit1)))))

(def-fns _ $ (erased r4c-or1l : (erased (Bit) a) -> (erased (BitApply or-op (Bit1) a (Bit1)) r))
  (match erased a _ ((Bit0) (Ap10 (Bit1) (Bit1) (Bit1))) ((Bit1) (Ap11 (Bit1) (Bit1) (Bit1)))))

(def-fns _ $ (erased r4c-apart-sym : (erased (Nat) a b) (erased (Apart (Nat) Lt a b) p) -> (erased (Apart (Nat) Lt b a) r))
  (match erased p _ ((ApLt _ _ _ _ l) (ApGt (Nat) Lt b a l)) ((ApGt _ _ _ _ l) (ApLt (Nat) Lt b a l))))

(def-fns _ $ (erased r4c-memb-cons : (erased (Nat) g x) (erased (List (Nat)) R) (erased (Bit) e m) (erased (EqB g x e) eq) (erased (MemB x R m) mb)
    -> (erased (Bit) b) (erased (MemB x (Cons (Nat) g R) b) r) (erased (BitApply or-op e m b) o))
  (let-match erased eq (EbDiff _ _ ap) ((EbSame _) (values (Bit1) (MbY x _ (InHere x R)) (r4c-or1l m))))
  (match erased mb _
    ((MbY _ _ p) (values (Bit1) (MbY x _ (InThere x g R p)) (Ap01 (Bit1) (Bit1) (Bit1))))
    ((MbN _ _ p) (values (Bit0) (MbN x _ (NotInCons x g R (r4c-apart-sym g x ap) p)) (Ap00 or-op)))))

(def-fns _ $ (erased r4c-memb-fn : (erased (Nat) x) (erased (List (Nat)) R) (erased (Bit) a b) (erased (MemB x R a) p) (erased (MemB x R b) q) -> (erased (Eq (Bit) a b) e))
  (match erased p _
    ((MbY _ _ i) (let-match erased q (MbY _ _ _) (absurd (MbN _ _ o) (apart-irrefl x (notin-in x x R o i)))) (Refl _ a))
    ((MbN _ _ o) (let-match erased q (MbN _ _ _) (absurd (MbY _ _ i) (apart-irrefl x (notin-in x x R o i)))) (Refl _ a))))

; red4's cadd of t moves the trace ti's bit in c, kept equal to its bit in T, to its or with whether ti is t.
(def-fns _ $ (erased r4c-cad-bit : (erased (Nat) h t ti) (erased (Ctree) c c2 x0) (erased (List (Nat)) T T2) (erased (List (Col)) p pre) (erased (Bit) b0)
    (erased (CAd c T t p c2 T2) ad) (erased (RIdx p t) rp) (erased (Length (Col) p (Succ h)) lp) (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le)
    (erased (CtAt c pre x0) a0) (erased (Lf x0 b0) l0) (erased (MemB ti T b0) m0)
    -> (erased (Bit) e b) (erased (Ctree) x) (erased (EqB t ti e) eq) (erased (CtAt c2 pre x) a) (erased (Lf x b) l) (erased (MemB ti T2 b) m) (erased (BitApply or-op b0 e b) o))
