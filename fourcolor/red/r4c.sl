        (ClZ0 us1 n0 p o0 R1 (put-elt flag-w us us1 n0 (Zero) pu)) ao (sel-occ o0 (CLeaf lf) e so (OccL lf)) (TICons p xv xv e (Nil _) kd (TINil xv))
        (LengthCons _ e (Nil _) (Zero) (LengthNil _))))
