; The colour permutation that rows of red4's rotation tables built with r apply to each digit: p231 for 1, p312 for 2.
(def-adts $ (RotPm : ((Nat) r) ((Perm) g) -> Type)
  enum
  (many RotP1 : -> (RotPm (Succ (Zero)) p231))
  (many RotP2 : -> (RotPm (Succ (Succ (Zero))) p312)))

(def-fns _ $ (erased r4c-mod-div : (erased (Nat) s c r q k d) (subterm erased (Mod s c d) m) (erased (Mul q c k) mm) (erased (Add k r s) ad) (erased (Lt r c) rl)
    -> (erased (Eq (Nat) d r) e))
  (let-match erased mm (MulSucc q1 _ k1 _ mm1 ak)
    ((MulZero _) (let-match erased ad (AddZero _)) (mod-small s c d m rl)))
  (let ((erased kr) (erased akr) (erased acs)) (add-right-comm k1 c k r s ak ad))
  (let-match erased m (ModSub s1 _ _ _ a m1)
    (absurd (ModLt _ _ l) (lt-irrefl s (lt-le-trans s c s l (add-le-right kr c s acs)))))
  (let-match erased (add-cancel c s1 kr s a (add-comm kr c s acs)) (Refl _ _))
  (r4c-mod-div s1 c r q1 k1 d m1 mm1 akr rl))

; The digit d of the colour e moved by the rotation of r is that of the colour that g gives e.
(def-fns _ $ (erased r4c-rot-dig : (erased (Nat) d r s d2) (erased (Col) e) (erased (Perm) g) (erased (CD d e) cd) (erased (RotPm r g) rp) (erased (Add d r s) as)
    (erased (Mod s 3 d2) ms) -> (erased (Col) e2) (erased (PermC g e e2) pc) (erased (CD d2 e2) cd2))
  (let-match erased r4-e3 (Refl _ _))
  (let ((erased z) (erased one) (erased two)) (values (Zero) (Succ (Zero)) (Succ (Succ (Zero)))))
  (let ((erased l0) (erased l1) (erased l2)) (values (LtZ two) (LtS (Zero) two (LtZ one)) (LtS one two (LtS (Zero) one (LtZ z)))))
  (let ((erased m0) (erased m1)) (values (MulZero 3) (MulSucc z 3 z 3 (MulZero 3) (AddZero 3))))
  (let ((erased s1) (erased s2)) (values (AddSucc z one one (AddZero one)) (AddSucc one one two (AddSucc z one one (AddZero one)))))
  (match erased cd _
    ((Cd0)
      (let-match erased as (AddZero _))
      (match erased rp _
        ((RotP1) (let-match erased (r4c-mod-div s 3 s z z d2 ms m0 (AddZero s) l1) (Refl _ _)) (values (C2) (PC1 (C2) (C3) (C1)) (Cd1)))
        ((RotP2) (let-match erased (r4c-mod-div s 3 s z z d2 ms m0 (AddZero s) l2) (Refl _ _)) (values (C3) (PC1 (C3) (C1) (C2)) (Cd2)))))
    ((Cd1)
      (match erased rp _
        ((RotP1)
          (let-match erased (add-fn one one s two as s1) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 s z z d2 ms m0 (AddZero s) l2) (Refl _ _))
          (values (C3) (PC2 (C2) (C3) (C1)) (Cd2)))
        ((RotP2)
          (let-match erased (add-fn one two s 3 as (AddSucc z two two (AddZero two))) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 z one 3 d2 ms m1 (add-zero-right 3) l0) (Refl _ _))
          (values (C1) (PC2 (C3) (C1) (C2)) (Cd0)))))
    ((Cd2)
      (match erased rp _
        ((RotP1)
          (let-match erased (add-fn two one s 3 as (AddSucc one one two s1)) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 z one 3 d2 ms m1 (add-zero-right 3) l0) (Refl _ _))
          (values (C1) (PC3 (C2) (C3) (C1)) (Cd0)))
        ((RotP2)
          (let-match erased (add-fn two two s (Succ 3) as (AddSucc one two 3 (AddSucc z two two (AddZero two)))) (Refl _ _))
          (let-match erased (r4c-mod-div s 3 one one 3 d2 ms m1 (add-succ-right 3 z 3 (add-zero-right 3)) l1) (Refl _ _))
          (values (C2) (PC3 (C3) (C1) (C2)) (Cd1)))))))

(def-fns _ $ (erased r4c-cd-fn : (erased (Nat) d) (erased (Col) a b) (erased (CD d a) p) (erased (CD d b) q) -> (erased (Eq (Col) a b) e))
  (match erased p _ ((Cd0) (let-match erased q (Cd0)) (Refl _ a)) ((Cd1) (let-match erased q (Cd1)) (Refl _ a)) ((Cd2) (let-match erased q (Cd2)) (Refl _ a))))

; v, made by red4's go from the trace prefix t of k colours pre (last first), is acc plus mu times the prefix of those colours moved by g.
(def-fns _ $ (erased r4c-go-rot : (erased (Nat) r t k acc mu v) (erased (Perm) g) (erased (RotPm r g) rp) (subterm erased (GoR r t k acc mu v) gr) (erased (List (Col)) pre)
    (erased (RIdx pre t) ri) (erased (Length (Col) pre k) le) ->
    (erased (List (Col)) pre2) (erased (PermT g pre pre2) pt) (erased (Nat) x y) (erased (RIdx pre2 x) ri2) (erased (Mul x mu y) mx) (erased (Add acc y v) ad))
  (match erased gr _
    ((GoZ _ _ _ _)
      (let-match erased le (LengthNil _))
      (values (Nil _) (PTNil g) (Zero) (Zero) (RINil) (MulZero mu) (add-zero-right acc)))
    ((GoS _ _ k1 _ _ _ t1 m3 d0 d s d2 xx acc1 mul1 mm adt dl md as ms mxx aa m1 g1)
      (let-match erased r4-e3 (Refl _ _))
      (let-match erased le (LengthCons _ e pre1 _ le1))
      (let-match erased ri (RICons _ p _ _ ri1 kd))
      (let ((erased c) (erased cd) (erased kc)) (kid-dg t1 m3 d0 t (mul3-thrice t1 m3 mm) adt dl))
      (let ((erased ep) (erased ec)) (kid-inj p t1 t e c kd kc))
      (let-match erased ep (Refl _ _))
      (let-match erased ec (Refl _ _))
      (let-match erased (r4c-mod-div t 3 d0 t1 m3 d md mm adt dl) (Refl _ _))
      (let ((erased e2) (erased pc) (erased cd2)) (r4c-rot-dig d0 r s d2 e g cd rp as ms))
      (let ((erased pre21) (erased pt1) (erased x1) (erased y1) (erased ri21) (erased mx1) (erased ad1)) (r4c-go-rot r t1 k1 acc1 mul1 v g rp g1 pre1 ri1 le1))
      (let ((erased q1) (erased tq1)) (thrice-exists x1))
      (let ((erased x) (erased ax)) (add q1 d2))
      (let ((erased d2l)) (match erased cd2 (((Lt d2 3) l)) ((Cd0) (LtZ _)) ((Cd1) (LtS _ _ (LtZ _))) ((Cd2) (LtS _ _ (LtS _ _ (LtZ _))))))
      (let ((erased c2) (erased cd3) (erased kx)) (kid-dg x1 q1 d2 x tq1 ax d2l))
      (let-match erased (r4c-cd-fn d2 e2 c2 cd2 cd3) (Refl _ _))
      (let ((erased z) (erased mz)) (mul q1 mu))
      (let-match erased (mul-fn x1 mul1 z y1 (mul-assoc x1 3 mu q1 z mul1 (thrice-mul x1 q1 tq1) mz m1) mx1) (Refl _ _))
      (let ((erased y) (erased my)) (mul x mu))
      (let ((erased ay)) (mul-distr q1 d2 x mu y1 xx y ax mz mxx my))
      (let ((erased bc) (erased ab) (erased av)) (add-reassoc acc xx y1 acc1 v aa ad1))
      (let-match erased (add-fn xx y1 bc y ab (add-comm y1 xx y ay)) (Refl _ _))
      (values (Cons _ e2 pre21) (PTCons g e e2 pre1 pre21 pc pt1) x y (RICons pre21 x1 x e2 ri21 kx) my av))))

(def-fns _ $ (erased r4c-pw3-last : (erased (Nat) a m L) (subterm erased (Pw3 (Succ a) m L) p) -> (erased (Nat) L1) (erased (Pw3 a m L1) q) (erased (Thrice L1 L) t))
  (let-match erased p (PwS _ _ q0 _ tq p1))
  (let-match erased a (Succ a1) ((Zero) (let-match erased p1 (PwZ _)) (values m (PwZ m) tq)))
  (let ((erased L1) (erased q1) (erased t1)) (r4c-pw3-last a1 q0 L p1))
  (values L1 (PwS a1 m q0 L1 tq q1) t1))

; The child c of p along e, moved to the node n with n's children qn qo past p's qp, is n's child c2 along e.
(def-fns _ $ (erased r4c-kid-shift : (erased (Nat) p n c c2 qp qn qo) (erased (Col) e) (erased (Kid p e c) k) (erased (Thrice p qp) tp) (erased (Thrice n qn) tn)
    (erased (Add qo qp qn) ad) (erased (Add qo c c2) ac) -> (erased (Kid n e c2) r))
  (match erased k _
    ((Ki1 _ _ t1) (let-match erased (thrice-fn p qp c tp t1) (Refl _ _)) (let-match erased (add-fn qo qp c2 qn ac ad) (Refl _ _)) (Ki1 n qn tn))
    ((Ki2 _ c0 t1)
      (let-match erased (thrice-fn p qp c0 tp t1) (Refl _ _))
      (let-match erased (add-fn qo (Succ qp) c2 (Succ qn) ac (add-succ-right qo qp qn ad)) (Refl _ _))
      (Ki2 n qn tn))
    ((Ki3 _ c0 t1)
      (let-match erased (thrice-fn p qp c0 tp t1) (Refl _ _))
      (let-match erased (add-fn qo (Succ (Succ qp)) c2 (Succ (Succ qn)) ac (add-succ-right qo (Succ qp) (Succ qn) (add-succ-right qo qp qn ad))) (Refl _ _))
      (Ki3 n qn tn))))

; y L is three times y L1 when L is three times L1.
(def-fns _ $ (erased r4c-mul3 : (erased (Nat) y L L1 m m1) (erased (Mul y L m) mm) (erased (Mul y L1 m1) mm1) (erased (Thrice L1 L) tl) -> (erased (Thrice m1 m) r))
  (let ((erased z) (erased mz)) (mul m1 (Succ (Succ (Succ (Zero))))))
  (let-match erased (mul-fn y L z m (mul-assoc y L1 (Succ (Succ (Succ (Zero)))) m1 z L mm1 mz (thrice-mul L1 L tl)) mm) (Refl _ _))
  (mul3-thrice m1 z mz))

; The trace prefix of the colours pa then pb, last first, is y L + x, x being that of pa, of a colours, and y that of pb.
(def-fns _ $ (erased r4c-ridx-cat : (erased (List (Col)) pb pc) (erased (Nat) a L x y m t) (subterm erased (List (Col)) pa) (erased (RIdx pa x) ra) (erased (Length (Col) pa a) la)
    (erased (Pw3 a (Succ (Zero)) L) pw) (erased (RIdx pb y) rb) (erased (Mul y L m) mm) (erased (Add m x t) ad) (erased (LApp (Col) pa pb pc) ap) -> (erased (RIdx pc t) r))
  (let-match erased pa (Cons _ e pa1)
    ((Nil _)
      (let-match erased la (LengthNil _))
      (let-match erased pw (PwZ _))
      (let-match erased ra (RINil))
      (let-match erased ap (LAppNil _ _))
      (let-match erased (mul-fn y (Succ (Zero)) m y mm (mul-one-right y)) (Refl _ _))
      (let-match erased (add-fn m (Zero) t m ad (add-zero-right m)) (Refl _ _))
      rb))
  (let-match erased la (LengthCons _ _ _ a1 la1))
  (let-match erased ra (RICons _ x1 _ _ ra1 kx))
  (let-match erased ap (LAppCons _ _ _ _ pc1 ap1))
  (let ((erased L1) (erased pw1) (erased tl)) (r4c-pw3-last a1 (Succ (Zero)) L pw))
  (let ((erased m1) (erased mm1)) (mul y L1))
  (let ((erased t1) (erased ad1)) (add m1 x1))
  (let ((erased r1)) (r4c-ridx-cat pb pc1 a1 L1 x1 y m1 t1 pa1 ra1 la1 pw1 rb mm1 ad1 ap1))
  (let ((erased qx) (erased tx)) (thrice-exists x1))
  (let ((erased qt) (erased tt)) (thrice-exists t1))
  (let ((erased tm)) (r4c-mul3 y L L1 m m1 mm mm1 tl))
  (RICons pc1 t1 t e r1 (r4c-kid-shift x1 t1 x t qx qt m e kx tx tt (thrice-add m1 x1 t1 m qx qt tm tx tt ad1) ad)))

(def-fns _ $ (erased r4c-kid-add : (erased (Nat) p q c d) (erased (Col) e) (erased (Kid p e c) k) (erased (Thrice p q) tq) (erased (CD d e) cd) -> (erased (Add q d c) r))
  (match erased k _
    ((Ki1 _ _ t1) (let-match erased (thrice-fn p q c tq t1) (Refl _ _)) (let-match erased cd (Cd0)) (add-zero-right q))
    ((Ki2 _ c0 t1) (let-match erased (thrice-fn p q c0 tq t1) (Refl _ _)) (let-match erased cd (Cd1)) (add-succ-right q (Zero) q (add-zero-right q)))
    ((Ki3 _ c0 t1)
      (let-match erased (thrice-fn p q c0 tq t1) (Refl _ _))
      (let-match erased cd (Cd2))
      (add-succ-right q (Succ (Zero)) (Succ q) (add-succ-right q (Zero) q (add-zero-right q))))))

(def-fns _ $ (erased r4c-cd-lt : (erased (Nat) d) (erased (Col) e) (erased (CD d e) cd) -> (erased (Lt d 3) r))
  (let-match erased r4-e3 (Refl _ _))
  (match erased cd _ ((Cd0) (LtZ _)) ((Cd1) (LtS _ _ (LtZ _))) ((Cd2) (LtS _ _ (LtS _ _ (LtZ _))))))

; The colours pre, last first, of trace prefix t and of a + b colours, are pa then pb: t is y L + x, x below L the prefix of pa's a colours, y that of pb.
(def-fns _ $ (erased r4c-ridx-split : (erased (Nat) b ab t L) (subterm erased (Nat) a) (erased (List (Col)) pre) (erased (RIdx pre t) ri) (erased (Length (Col) pre ab) le)
    (erased (Add a b ab) s) (erased (Pw3 a (Succ (Zero)) L) pw) -> (erased (List (Col)) pa pb) (erased (Nat) x y m) (erased (RIdx pa x) ra) (erased (Length (Col) pa a) la)
    (erased (RIdx pb y) rb) (erased (Length (Col) pb b) lb) (erased (LApp (Col) pa pb pre) ap) (erased (Mul y L m) mm) (erased (Add m x t) ad) (erased (Lt x L) xl))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased a (Succ a1)
    ((Zero)
      (let-match erased s (AddZero _))
      (let-match erased pw (PwZ _))
      (values (Nil _) pre (Zero) t t (RINil) (LengthNil _) ri le (LAppNil _ pre) (mul-one-right t) (add-zero-right t) (LtZ (Zero)))))
  (let-match erased s (AddSucc _ _ ab1 s1))
  (let-match erased le (LengthCons _ e pre1 _ le1))
  (let-match erased ri (RICons _ p _ _ ri1 kd))
  (let ((erased L1) (erased pw1) (erased tl)) (r4c-pw3-last a1 (Succ (Zero)) L pw))
  (let ((erased pa1) (erased pb) (erased x1) (erased y) (erased m1) (erased ra1) (erased la1) (erased rb) (erased lb) (erased ap1) (erased mm1) (erased ad1) (erased xl1))
    (r4c-ridx-split b ab1 p L1 a1 pre1 ri1 le1 s1 pw1))
  (let ((erased d) (erased cd)) (kid-cd p t e kd))
  (let ((erased qp) (erased tp)) (thrice-exists p))
  (let ((erased qx) (erased tx)) (thrice-exists x1))
  (let ((erased m) (erased mm)) (mul y L))
  (let ((erased tm)) (r4c-mul3 y L L1 m m1 mm mm1 tl))
  (let ((erased aq)) (thrice-add m1 x1 p m qx qp tm tx tp ad1))
  (let ((erased x) (erased ax)) (add qx d))
  (let ((erased dl)) (r4c-cd-lt d e cd))
  (let ((erased c2) (erased cd2) (erased kx)) (kid-dg x1 qx d x tx ax dl))
  (let-match erased (r4c-cd-fn d e c2 cd cd2) (Refl _ _))
  (let ((erased bc) (erased ab2) (erased atq)) (add-reassoc m qx d qp t aq (r4c-kid-add p qp t d e kd tp cd)))
  (let-match erased (add-fn qx d bc x ab2 ax) (Refl _ _))
  (let ((erased xh)) (add-lt-mono qx d (Succ (Succ (Succ (Zero)))) x (Succ (Succ (Succ qx))) ax
    (add-succ-right qx (Succ (Succ (Zero))) (Succ (Succ qx)) (add-succ-right qx (Succ (Zero)) (Succ qx) (add-succ-right qx (Zero) qx (add-zero-right qx)))) dl))
  (values (Cons _ e pa1) pb x y m (RICons pa1 x1 x e ra1 kx) (LengthCons _ e pa1 a1 la1) rb lb (LAppCons _ e pa1 pb pre1 ap1) mm atq
    (lt-le-trans x (Succ (Succ (Succ qx))) L xh (LtS _ _ (thrice-lt x1 L1 qx L xl1 tx tl)))))

(def-fns _ $ (erased r4c-ridx-lt : (erased (Nat) t n M) (subterm erased (List (Col)) pre) (erased (RIdx pre t) ri) (erased (Length (Col) pre n) le) (erased (Pw3 n (Succ (Zero)) M) pw)
    -> (erased (Lt t M) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased le (LengthNil _)) (let-match erased pw (PwZ _)) (let-match erased ri (RINil)) (LtZ (Zero))))
  (let-match erased le (LengthCons _ _ _ n1 le1))
  (let-match erased ri (RICons _ p _ _ ri1 kd))
  (let ((erased M1) (erased pw1) (erased tm)) (r4c-pw3-last n1 (Succ (Zero)) M pw))
  (let ((erased q0) (erased tq) (erased hi) (erased _)) (kid-base p t e kd))
  (lt-le-trans t (Succ (Succ (Succ q0))) M hi (LtS _ _ (thrice-lt p M1 q0 M (r4c-ridx-lt p n1 M1 pre1 ri1 le1 pw1) tq tm))))

(def-fns _ $ (erased r4c-div-uniq : (erased (Nat) c k r s q2 k2 r2) (subterm erased (Nat) q) (erased (Mul q c k) mm) (erased (Add k r s) ad) (erased (Lt r c) rl)
    (erased (Mul q2 c k2) mm2) (erased (Add k2 r2 s) ad2) (erased (Lt r2 c) rl2) -> (erased (Eq (Nat) q q2) e) (erased (Eq (Nat) r r2) f))
  (match erased mm _
    ((MulZero _)
      (let-match erased ad (AddZero _))
      (let-match erased mm2 (MulZero _)
        (absurd (MulSucc q21 _ k21 _ _ ak2)
          (let ((erased t2) (erased _) (erased a2)) (add-right-comm k21 c k2 r2 s ak2 ad2))
          (lt-irrefl s (lt-le-trans s c s rl (add-le-right t2 c s a2)))))
      (let-match erased ad2 (AddZero _))
      (values (Refl _ q) (Refl _ r)))
    ((MulSucc q1 _ k1 _ mm1 ak)
      (let ((erased t1) (erased b1) (erased a1)) (add-right-comm k1 c k r s ak ad))
      (let-match erased mm2 (MulSucc q21 _ k21 _ mm21 ak2)
        (absurd (MulZero _) (let-match erased ad2 (AddZero _)) (lt-irrefl s (lt-le-trans s c s rl2 (add-le-right t1 c s a1)))))
      (let ((erased t2) (erased b2) (erased a2)) (add-right-comm k21 c k2 r2 s ak2 ad2))
      (let-match erased (add-cancel c t1 t2 s (add-comm t1 c s a1) (add-comm t2 c s a2)) (Refl _ _))
      (let ((erased e1) (erased f1)) (r4c-div-uniq c k1 r t1 q21 k21 r2 q1 mm1 b1 rl mm21 b2 rl2))
      (let-match erased e1 (Refl _ _))
      (values (Refl _ q) f1))))

(def-fns _ $ (erased r4c-rt-get : (erased (Nat) r n i j) (erased (List (Copy (Nat))) xs) (subterm erased (RotTab r n i xs) rt) (erased (Lt j i) l)
    -> (erased (Nat) v) (erased (WElt xs j v) w) (erased (GoR r j n 0 1 v) g))
  (let-match erased rt (RtS _ _ ip v _ rt1 w g) (absurd (RtZ _ _ _) l))
  (let-match erased (nat-eq j ip) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values v w g)))
  (let-match erased ap (ApLt _ _ _ _ jl) (absurd (ApGt _ _ _ _ gt) (lt-irrefl j (lt-le-trans j (Succ ip) j l (LtS ip j gt)))))
  (r4c-rt-get r n ip j xs rt1 jl))

(def-fns _ $ (erased r4c-permt-app : (erased (Perm) g) (erased (List (Col)) pa pb pc pa2 pb2) (subterm erased (PermT g pa pa2) p) (erased (PermT g pb pb2) q)
    (erased (LApp (Col) pa pb pc) ap) -> (erased (List (Col)) pc2) (erased (LApp (Col) pa2 pb2 pc2) ap2) (erased (PermT g pc pc2) r))
  (let-match erased p (PTCons _ c d et1 et3 pcd p1) ((PTNil _) (let-match erased ap (LAppNil _ _)) (values pb2 (LAppNil _ pb2) q)))
  (let-match erased ap (LAppCons _ _ _ _ pc1 ap1))
  (let ((erased pc21) (erased ap21) (erased r1)) (r4c-permt-app g et1 pb pc1 et3 pb2 p1 q ap1))
  (values (Cons _ d pc21) (LAppCons _ d et3 pb2 pc21 ap21) (PTCons g c d pc1 pc21 pcd r1)))

; The rotation red4's rot r selects, through the rows built with rr: rot 0 moves each colour by p231, rot 2 by p312.
(def-adts $ (RotSel : ((Nat) r) ((Nat) rr) ((Perm) g) -> Type)
  enum
  (many RsOne : -> (RotSel (Zero) (Succ (Zero)) p231))
  (many RsTwo : -> (RotSel (Succ (Succ (Zero))) (Succ (Succ (Zero))) p312)))

(def-fns _ $ (erased r4c-bitis-zero : (erased (Nat) d) (erased (Bit) a) (erased (BitIs (Zero) d a) bi) -> (erased (Eq (Bit) a (Bit0)) e))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p c))
  (let ((erased e1) (erased _)) (bsp-zero-x d lo y p))
  (let-match erased e1 (Refl _ _))
  (let ((erased _) (erased e2)) (bc-zero y1 a c))
  e2)

(def-fns _ $ (erased r4c-bitis-of0 : (erased (Nat) d) -> (erased (BitIs (Zero) d (Bit0)) r))
  (MkBitIs (Zero) d (Zero) (Zero) (Zero) (Bit0) (bsp-zz d) (bc-zz)))

(def-fns _ $ (erased r4c-bitis-up : (erased (Nat) x xa d) (erased (Bit) c xb) (erased (BitIs xa d c) bi) (erased (BitCons xa xb x) cx) -> (erased (BitIs x (Succ d) c) r))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p cy))
  (let ((erased lo2) (erased cl)) (bc-new lo xb))
  (MkBitIs x (Succ d) lo2 y y1 c (BspS d x xa lo2 lo y xb p cx cl) cy))

(def-fns _ $ (erased r4c-bitis-down : (erased (Nat) x xa d) (erased (Bit) a xb) (erased (BitIs x (Succ d) a) bi) (erased (BitCons xa xb x) cx) -> (erased (BitIs xa d a) r))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p cy))
  (let-match erased p (BspS _ _ x1 _ lo1 _ b p1 cx1 cl))
  (let ((erased e1) (erased _)) (bitcons-fn x1 b xa xb x cx1 cx))
  (let-match erased e1 (Refl _ _))
  (MkBitIs xa d lo1 y y1 a p1 cy))

; A bitwise operation acts on each bit.
(def-fns _ $ (erased r4c-bw-bitis : (erased (BitOp) t) (erased (Nat) x y z d) (erased (Bit) a b c) (subterm erased (Bitwise t x y z) bw) (erased (BitIs x d a) bx)
    (erased (BitIs y d b) by) (erased (BitApply t a b c) ap) -> (erased (BitIs z d c) r))
  (match erased bw _
    ((BwZero _)
      (let-match erased (r4c-bitis-zero d a bx) (Refl _ _))
      (let-match erased (r4c-bitis-zero d b by) (Refl _ _))
      (let-match erased (bitapply-fn t (Bit0) (Bit0) c (Bit0) ap (Ap00 t)) (Refl _ _))
      (r4c-bitis-of0 d))
    ((BwBit _ xa ya za xb yb zb _ _ _ bw1 ap1 cx cy cz)
      (let-match erased d (Zero)
        ((Succ d1)
          (r4c-bitis-up z za d1 c zb (r4c-bw-bitis t xa ya za d1 a b c bw1 (r4c-bitis-down x xa d1 a xb bx cx) (r4c-bitis-down y ya d1 b yb by cy) ap) cz)))
      (let-match erased bx (MkBitIs _ _ _ _ x1 _ px c1))
      (let-match erased px (BspZ _))
      (let ((erased _) (erased ea)) (bitcons-fn x1 a xa xb x c1 cx))
      (let-match erased ea (Refl _ _))
      (let-match erased by (MkBitIs _ _ _ _ y1 _ py c2))
      (let-match erased py (BspZ _))
      (let ((erased _) (erased eb)) (bitcons-fn y1 b ya yb y c2 cy))
      (let-match erased eb (Refl _ _))
      (let-match erased (bitapply-fn t a b c zb ap ap1) (Refl _ _))
      (MkBitIs z (Zero) (Zero) z za c (BspZ z) cz))))

; b is Bit1 when d is k, and Bit0 otherwise.
(def-adts $ (EqB : ((Nat) k) ((Nat) d) ((Bit) b) -> Type)
  enum
  (many EbSame : (erased (Nat) k) -> (EqB k k (Bit1)))
  (many EbDiff : (erased (Nat) k d) (erased (Apart (Nat) Lt k d) ap) -> (EqB k d (Bit0))))

(def-fns _ $ (erased r4c-pow2-bit : (erased (Nat) k v d) (subterm erased (Pow2 k v) pw) -> (erased (Bit) b) (erased (EqB k d b) eb) (erased (BitIs v d b) bi))
  (match erased pw _
    ((P0)
      (let ((erased one)) (BC1 (Zero) (Zero) (D0)))
      (match erased d (((Bit) b) ((EqB (Zero) d b) eb) ((BitIs (Succ (Zero)) d b) bi))
        ((Zero) (values (Bit1) (EbSame (Zero)) (MkBitIs v (Zero) (Zero) v (Zero) (Bit1) (BspZ v) one)))
        ((Succ d1)
          (values (Bit0) (EbDiff (Zero) d (ApLt (Nat) Lt (Zero) d (LtZ d1))) (r4c-bitis-up v (Zero) d1 (Bit0) (Bit1) (r4c-bitis-of0 d1) one)))))
    ((PS k1 v1 _ pw1 dd)
      (let ((erased cv)) (BC0 v1 v dd))
      (let-match erased d (Succ d1) ((Zero) (values (Bit0) (EbDiff k (Zero) (ApGt (Nat) Lt k (Zero) (LtZ k1))) (MkBitIs v (Zero) (Zero) v v1 (Bit0) (BspZ v) cv))))
      (let ((erased b) (erased eb1) (erased bi1)) (r4c-pow2-bit k1 v1 d1 pw1))
      (values b
        (match erased eb1 (((EqB k d b) r))
          ((EbSame _) (EbSame k))
          ((EbDiff _ _ ap) (EbDiff k d (match erased ap _ ((ApLt _ _ _ _ l) (ApLt (Nat) Lt k d (LtS k1 d1 l))) ((ApGt _ _ _ _ l) (ApGt (Nat) Lt k d (LtS d1 k1 l)))))))
        (r4c-bitis-up v v1 d1 b (Bit0) bi1 cv)))))

; a is Bit1 when t is a leaf, and Bit0 when t is empty.
(def-adts $ (Lf : ((Ctree) t) ((Bit) a) -> Type)
  enum
  (many LfE : -> (Lf (CEmpty) (Bit0)))
  (many LfL : (erased (Ctree) lf) -> (Lf (CLeaf lf) (Bit1))))

; c, below 8, has bit d set exactly when the tree of colour d + 1 among t1, t2 and t3, each empty or a leaf, is a leaf.
(def-adts $ (TB3 : ((Nat) c) ((Ctree) t1) ((Ctree) t2) ((Ctree) t3) -> Type)
  enum
  (many MkB3 : (erased (Nat) c) (erased (Ctree) t1 t2 t3) (erased (Bit) a1 a2 a3) (erased (Bsp 3 c c (Zero)) cb) (erased (BitIs c (Zero) a1) b1)
      (erased (BitIs c (Succ (Zero)) a2) b2) (erased (BitIs c (Succ (Succ (Zero))) a3) b3) (erased (Lf t1 a1) l1) (erased (Lf t2 a2) l2) (erased (Lf t3 a3) l3)
      -> (TB3 c t1 t2 t3)))

; a is Bit0 when z is 0, and Bit1 otherwise.
(def-adts $ (ZB : ((Nat) z) ((Bit) a) -> Type)
  enum
  (many ZbZ : -> (ZB (Zero) (Bit0)))
  (many ZbP : (erased (Nat) z) -> (ZB (Succ z) (Bit1))))

(comptime-match many (bsp-chk 3 1 1 0) (ESome _ r4c-bs1))
(comptime-match many (bsp-chk 3 2 2 0) (ESome _ r4c-bs2))
(comptime-match many (bsp-chk 3 4 4 0) (ESome _ r4c-bs4))
(comptime-match many (bsp-chk 3 0 0 0) (ESome _ r4c-bs0))

(let ((many r4c-v8) (erased r4c-p8) (erased _)) (pow2 3))
(comptime-match many (lt-dec r4c-v8 u8-modulus) (Yes _ _ _ _ r4c-8u8))
(comptime-match many (lt-dec 3 (Succ (sixty-two-many))) (Yes _ _ _ _ r4c-3-63))

(def-fns _ $ (erased r4c-b3-lt : (erased (Nat) c) (erased (Bsp 3 c c (Zero)) cb) -> (erased (Lt c u8-modulus) r))
  (lt-trans c r4c-v8 u8-modulus (bsp-lt 3 c c (Zero) r4c-v8 cb r4c-p8) r4c-8u8))

(def-fns _ $ (erased r4c-b3-sel : (erased (Nat) c d) (erased (Ctree) t1 t2 t3 u) (erased (Col) e) (erased (TB3 c t1 t2 t3) b) (erased (CD d e) cd)
    (erased (CtSel (CNode t1 t2 t3) e u) sl) -> (erased (Bit) a) (erased (BitIs c d a) bi) (erased (Lf u a) lf))
  (let-match erased b (MkB3 _ _ _ _ a1 a2 a3 _ b1 b2 b3 l1 l2 l3))
  (match erased cd (((Bit) a) ((BitIs c d a) bi) ((Lf u a) lf))
    ((Cd0) (let-match erased sl (SelN1 _ _ _)) (values a1 b1 l1))
    ((Cd1) (let-match erased sl (SelN2 _ _ _)) (values a2 b2 l2))
    ((Cd2) (let-match erased sl (SelN3 _ _ _)) (values a3 b3 l3))))

; red4's x land b in cadd: 0 exactly when the child of the bit b is empty.
(def-fns _ $ (erased r4c-b3-and : (erased (Nat) c m z d) (erased (Ctree) t1 t2 t3 u) (erased (Col) e) (erased (TB3 c t1 t2 t3) b) (erased (CD d e) cd)
    (erased (CtSel (CNode t1 t2 t3) e u) sl) (erased (Pow2 d m) pw) (erased (Bitwise and-op c m z) bwz) -> (erased (Bit) a) (erased (Lf u a) lf) (erased (ZB z a) zb))
  (let ((erased a) (erased bi) (erased lf)) (r4c-b3-sel c d t1 t2 t3 u e b cd sl))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ p cy))
  (let ((erased f) (erased cf) (erased bv)) (bc-one a))
  (let ((erased fk) (erased pf)) (bsp-lo0 d f))
  (let ((erased bw)) (and-mask d (Succ (Zero)) c lo y f y1 (Succ (Zero)) m fk p (BspS (Zero) y y1 f (Zero) y1 a (BspZ y1) cy cf)
    (OnS (Zero) (Zero) (Succ (Zero)) (OnZ) (BC1 (Zero) (Zero) (D0))) (bsp-pow d m pw) pf))
  (let-match erased (bitwise-fn and-op c m z fk bwz bw) (Refl _ _))
  (values a lf
    (match erased bv (((ZB fk a) zb))
      ((BV0) (let-match erased (bsp-zero-hi d fk (Zero) pf) (Refl _ _)) (ZbZ))
      ((BV1)
        (let-match erased fk (Succ fk1) (absurd (Zero) (let ((erased e1) (erased _)) (bsp-zero-x d (Zero) (Succ (Zero)) pf)) e1))
        (ZbP fk1)))))

(def-fns _ $ (erased r4c-or0 : (erased (Bit) a) -> (erased (BitApply or-op a (Bit0) a) r))
  (match erased a _ ((Bit0) (Ap00 or-op)) ((Bit1) (Ap10 (Bit1) (Bit1) (Bit1)))))

(def-fns _ $ (erased r4c-or1 : (erased (Bit) a) -> (erased (BitApply or-op a (Bit1) (Bit1)) r))
  (match erased a _ ((Bit0) (Ap01 (Bit1) (Bit1) (Bit1))) ((Bit1) (Ap11 (Bit1) (Bit1) (Bit1)))))

; Bit d2 of red4's x lor b in cadd, b being 2^d: set at d, x's own elsewhere.
(def-fns _ $ (erased r4c-or-at : (erased (Nat) c m c2 d d2) (erased (Bit) a) (erased (Bitwise or-op c m c2) bw) (erased (Pow2 d m) pw) (erased (BitIs c d2 a) bi)
    -> (erased (Bit) b x) (erased (EqB d d2 b) eb) (erased (BitIs c2 d2 x) r) (erased (BitApply or-op a b x) ap))
  (let ((erased b) (erased eb) (erased bm)) (r4c-pow2-bit d m d2 pw))
  (let ((erased x) (erased ap)) (match erased b (((Bit) x) ((BitApply or-op a b x) ap)) ((Bit0) (values a (r4c-or0 a))) ((Bit1) (values (Bit1) (r4c-or1 a)))))
  (values b x eb (r4c-bw-bitis or-op c m c2 d2 a b x bw bi bm ap) ap))

; red4's x lor b in cadd: the child of the bit b made a leaf.
(def-fns _ $ (erased r4c-b3-or : (erased (Nat) c m c2 d) (erased (Ctree) o lf t1 t2 t3 s1 s2 s3) (erased (Col) e) (erased (TB3 c t1 t2 t3) b) (erased (CtSel o (C1) t1) x1)
    (erased (CtSel o (C2) t2) x2) (erased (CtSel o (C3) t3) x3) (erased (CD d e) cd) (erased (Pow2 d m) pw) (erased (Bitwise or-op c m c2) bw)
    (erased (Up3 e o (CLeaf lf) (CNode s1 s2 s3)) up) -> (erased (TB3 c2 s1 s2 s3) r) (erased (Lt c2 u8-modulus) cl))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e2 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased b (MkB3 _ _ _ _ a1 a2 a3 cb b1 b2 b3 l1 l2 l3))
  (let ((erased z) (erased one) (erased two)) (values (Zero) (Succ (Zero)) (Succ (Succ (Zero)))))
  (let ((erased y1) (erased z1) (erased e1) (erased c1) (erased p1)) (r4c-or-at c m c2 d z a1 bw pw b1))
  (let ((erased y2) (erased z2) (erased e2) (erased c2b) (erased p2)) (r4c-or-at c m c2 d one a2 bw pw b2))
  (let ((erased y3) (erased z3) (erased e3) (erased c3) (erased p3)) (r4c-or-at c m c2 d two a3 bw pw b3))
  (match erased up (((TB3 c2 s1 s2 s3) r) ((Lt c2 u8-modulus) cl))
    ((UpA _ _ v2 v3 w2 w3)
      (let-match erased cd (Cd0))
      (let-match erased pw (P0))
      (let ((erased cb2)) (or-lt 3 c m c2 cb r4c-bs1 bw))
      (let-match erased (sel-fn o v2 t2 (C2) w2 x2) (Refl _ _))
      (let-match erased (sel-fn o v3 t3 (C3) w3 x3) (Refl _ _))
      (let-match erased e1 (EbSame _) (absurd (EbDiff _ _ ap) (apart-irrefl _ ap)))
      (let-match erased e2 (EbDiff _ _ _))
      (let-match erased e3 (EbDiff _ _ _))
      (let-match erased (bitapply-fn or-op a1 (Bit1) z1 (Bit1) p1 (r4c-or1 a1)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a2 (Bit0) z2 a2 p2 (r4c-or0 a2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a3 (Bit0) z3 a3 p3 (r4c-or0 a3)) (Refl _ _))
      (values (MkB3 c2 s1 s2 s3 (Bit1) a2 a3 cb2 c1 c2b c3 (LfL lf) l2 l3) (r4c-b3-lt c2 cb2)))
    ((UpB _ _ v1 v3 w1 w3)
      (let-match erased cd (Cd1))
      (let-match erased pw (PS _ _ _ pwa dda))
      (let-match erased pwa (P0))
      (let-match erased dda (DS _ _ ddb))
      (let-match erased ddb (D0))
      (let ((erased cb2)) (or-lt 3 c m c2 cb r4c-bs2 bw))
      (let-match erased (sel-fn o v1 t1 (C1) w1 x1) (Refl _ _))
      (let-match erased (sel-fn o v3 t3 (C3) w3 x3) (Refl _ _))
      (let-match erased e1 (EbDiff _ _ _))
      (let-match erased e2 (EbSame _) (absurd (EbDiff _ _ ap) (apart-irrefl _ ap)))
      (let-match erased e3 (EbDiff _ _ _))
      (let-match erased (bitapply-fn or-op a1 (Bit0) z1 a1 p1 (r4c-or0 a1)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a2 (Bit1) z2 (Bit1) p2 (r4c-or1 a2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a3 (Bit0) z3 a3 p3 (r4c-or0 a3)) (Refl _ _))
      (values (MkB3 c2 s1 s2 s3 a1 (Bit1) a3 cb2 c1 c2b c3 l1 (LfL lf) l3) (r4c-b3-lt c2 cb2)))
    ((UpC _ _ v1 v2 w1 w2)
      (let-match erased cd (Cd2))
      (let-match erased pw (PS _ _ _ pwa dda))
      (let-match erased pwa (PS _ _ _ pwb ddb))
      (let-match erased pwb (P0))
      (let-match erased ddb (DS _ _ ddc))
      (let-match erased ddc (D0))
      (let-match erased dda (DS _ _ ddd))
      (let-match erased ddd (DS _ _ dde))
      (let-match erased dde (D0))
      (let ((erased cb2)) (or-lt 3 c m c2 cb r4c-bs4 bw))
      (let-match erased (sel-fn o v1 t1 (C1) w1 x1) (Refl _ _))
      (let-match erased (sel-fn o v2 t2 (C2) w2 x2) (Refl _ _))
      (let-match erased e1 (EbDiff _ _ _))
      (let-match erased e2 (EbDiff _ _ _))
      (let-match erased e3 (EbSame _) (absurd (EbDiff _ _ ap) (apart-irrefl _ ap)))
      (let-match erased (bitapply-fn or-op a1 (Bit0) z1 a1 p1 (r4c-or0 a1)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a2 (Bit0) z2 a2 p2 (r4c-or0 a2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op a3 (Bit1) z3 (Bit1) p3 (r4c-or1 a3)) (Refl _ _))
      (values (MkB3 c2 s1 s2 s3 a1 a2 (Bit1) cb2 c1 c2b c3 l1 l2 (LfL lf)) (r4c-b3-lt c2 cb2)))))

; us2 is us after red4's ctr_path with v from the trie node of the path pre, last colour first: its ancestors, nearest first, set to v up to one already v.
(def-adts $ (CPth : ((List (U8)) us) ((List (U8)) us2) ((Nat) v) ((List (Col)) pre) -> Type)
  enum
  (many CpRoot : (erased (List (U8)) us) (erased (Nat) v) -> (CPth us us v (Nil (Col))))
  (many CpStop : (erased (List (U8)) us) (erased (Nat) v m) (erased (Col) e) (erased (List (Col)) pre) (erased (HIdx pre m) hi) (erased (Elt flag-w us m v) y)
      -> (CPth us us v (Cons (Col) e pre)))
  (many CpSet : (erased (List (U8)) us us1 us2) (erased (Nat) v m x) (erased (Col) e) (erased (List (Col)) pre) (erased (HIdx pre m) hi) (erased (Elt flag-w us m x) y)
      (erased (Apart (Nat) Lt x v) ap) (erased (Put flag-w us m v us1) pu) (erased (CPth us1 us2 v pre) c) -> (CPth us us2 v (Cons (Col) e pre))))

(def-lvl r4c-lp)

; red4's ctr_path ca h v p: from the trie node of the prefix p of depth h, its ancestors set to v up to one already v.
(def-fns _ $ (many r4-cpath : (erased (List (U8)) us0) (unique (Bytes us0) ca0) (erased (Nat) len) (erased (Sz flag-w us0 len) z0) (many (Nat) h0 v0 p0) (erased (Lt h0 17) hl)
    (erased (Lt v0 u8-modulus) vb) (erased (Lt p0 u62-modulus) pb) (erased (List (Col)) pre0) (erased (RIdx pre0 p0) ri0) (erased (Length (Col) pre0 h0) le0) (erased (Nat) d0)
    (erased (HIdx pre0 d0) hd0) (erased (Lt d0 len) dl0) -> (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca0) (erased (Sz flag-w us2 len) z2) (erased (CPth us0 us2 v0 pre0) cp))
  (let ((erased vb2)) (lt-trans v0 u8-modulus u62-modulus vb u8-below-u62))
  (def-fns r4c-lp $ (many up : (erased (List (U8)) us) (unique (Bytes us) ca at ca0) (erased (Sz flag-w us len) z) (many v0 is v at v0) (many (Nat) k p) (erased (Lt k 17) kl)
      (erased (Lt p u62-modulus) pbk) (subterm erased (List (Col)) pre) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (Nat) d) (erased (HIdx pre d) hd)
      (erased (Lt d len) dl) -> (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca) (erased (Sz flag-w us2 len) z2) (erased (CPth us us2 v pre) cp))
    (let-match erased r4-e3 (Refl _ _))
    (let-match many (nat-zero-dec k) (IsSucc k1)
      ((IsZero) (let-match erased le (LengthNil _)) (values us ca z (CpRoot us v))))
    (let-match erased le (LengthCons _ e pre1 _ le1))
    (let-match erased ri (RICons _ p1 _ _ ri1 kd))
    (let-match erased hd (HxCons _ m x _ hi1 km))
    (let ((erased kb)) (lt-trans k 17 u62-modulus kl r4-17-u62))
    (let ((erased kl1)) (lt-trans k1 k 17 (lt-succ k1) kl))
    (let ((many q) (erased k3) (erased r) (erased mm) (erased dq) (erased rl) (erased qb)) (u62-div p 3 pbk r4-three-u62 (LtZ _)))
    (let-match erased (kid-div p1 q p k3 r e kd mm dq rl) (Refl _ _))
    (let ((many o) (erased of) (erased _)) (r4-oget (u62-dec k1 k kb) kl1))
    (let ((erased jv) (erased aj)) (add o q))
    (let-match erased (hidx-det pre1 m jv hi1 (hidx-offs q k1 o jv pre1 ri1 le1 of aj)) (Refl _ _))
    (let ((erased q0) (erased tq) (erased _) (erased lo)) (kid-base m x e km))
    (let ((erased jl)) (lt-trans m d len (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq) (LtS q0 (Succ x) lo)) dl))
    (let ((many j)) (u62-add o q m aj (lt-trans m len u62-modulus jl (sz-u62 flag-w us len z))))
    (let ((erased c) (erased y)) (elt-exists flag-w us len m z jl))
    (let ((unique ca1) (many cv)) (r4-gb us ca j c y))
    (let ((erased cb) (erased _)) (flag-nth us m c y))
    (let-match many (u62-eq cv v (lt-trans c u8-modulus u62-modulus cb u8-below-u62) vb2) (Unequal _ _ _ _ ap)
      ((Equal _ _ _) (values us ca1 z (CpStop us v m e pre1 hi1 y))))
    (let ((erased us1) (unique ca2) (erased pu) (erased z1)) (r4-sb us ca1 j v len z jl vb))
    (let ((erased us2) (unique ca3) (erased z2) (erased cp1))
      (tail $ up us1 ca2 z1 v (u62-dec k1 k kb) q kl1 qb pre1 ri1 le1 m hi1 jl))
    (values us2 ca3 z2 (CpSet us us1 us2 v m c e pre1 hi1 y ap pu cp1)))
  (up us0 ca0 z0 v0 h0 p0 hl pb pre0 ri0 le0 d0 hd0 dl0))

(def-adts
  ; red4's ctr trie: node n, whose children are 3n + 1 to 3n + 3, holds t, of j + 1 more colours: its entry, and every entry below it, is 0 when t is empty;
  ; otherwise its entry is 1, or at j = 0 the bits of its children, leaves, colour 1 lowest.
  ((Ca : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many CaE : (erased (List (U8)) us) (erased (Nat) j n) (erased (Zr us j n) z) -> (Ca us j n (CEmpty)))
    (many CaL : (erased (List (U8)) us) (erased (Nat) n c) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n c) x) (erased (TB3 c t1 t2 t3) b) (erased (Occ3 t1 t2 t3) o)
        -> (Ca us (Zero) n (CNode t1 t2 t3)))
    (many CaN : (erased (List (U8)) us) (erased (Nat) j n q) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n (Succ (Zero))) x) (erased (Thrice n q) tq)
        (erased (Ca us j (Succ q) t1) k1) (erased (Ca us j (Succ (Succ q)) t2) k2) (erased (Ca us j (Succ (Succ (Succ q))) t3) k3) (erased (Occ3 t1 t2 t3) o)
        -> (Ca us (Succ j) n (CNode t1 t2 t3)))))

(def-fns _ $ (erased r4c-ca-fr : (erased (List (U8)) us vs) (erased (Nat) j n) (erased (Ctree) t) (subterm erased (Ca us j n t) g) (erased (MissWrites us vs (Succ j) n) f) -> (erased (Ca vs j n t) r))
  (let-match erased g (CaN _ j1 _ q t1 t2 t3 y tq k1 k2 k3 o)
    ((CaE _ _ _ z) (CaE vs j n (zr-fr us vs j n z f)))
    ((CaL _ _ c t1 t2 t3 y b o) (CaL vs n c t1 t2 t3 (fr-elt us vs j n c f y) b o)))
  (let ((erased f1) (erased f2) (erased f3)) (fr-kids us vs j n q f tq))
  (CaN vs j1 n q t1 t2 t3 (fr-elt us vs j n _ f y) tq (r4c-ca-fr us vs j1 (Succ q) t1 k1 f1) (r4c-ca-fr us vs j1 (Succ (Succ q)) t2 k2 f2)
    (r4c-ca-fr us vs j1 (Succ (Succ (Succ q))) t3 k3 f3) o))

(def-fns _ $ (erased r4c-ca-down : (erased (List (U8)) us) (erased (Nat) j n c) (erased (Ctree) t u) (erased (Col) e) (erased (Ca us (Succ j) n t) f)
    (erased (Kid n e c) kd) (erased (CtSel t e u) s) -> (erased (Ca us j (Succ c) u) r))
  (match erased f _
    ((CaE _ _ _ z)
      (let-match erased s (SelE _))
      (let-match erased z (MkZr _ _ _ q _ tq z1 z2 z3))
      (let ((erased zk))
        (match erased kd (((ZrK us (Succ j) (Succ c)) zk))
          ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) z1)
          ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) z2)
          ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) z3)))
      (let-match erased zk (ZkS _ _ _ z0))
      (CaE us j (Succ c) z0))
    ((CaN _ _ _ q t1 t2 t3 _ tq k1 k2 k3 _)
      (match erased kd _
        ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) (let-match erased s (SelN1 _ _ _)) k1)
        ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased s (SelN2 _ _ _)) k2)
        ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased s (SelN3 _ _ _)) k3)))))

(def-fns _ $ (erased r4c-ca-at : (erased (List (U8)) us) (erased (Nat) j n d D) (erased (Ctree) top t) (subterm erased (List (Col)) pre)
    (erased (Ca us D (Zero) top) f) (erased (HIdx pre n) hi) (erased (CtAt top pre t) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad) -> (erased (Ca us j n t) r))
  (match erased pre _
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) f)
    ((Cons _ e pre1)
      (let-match erased hi (HxCons _ n1 c _ hi1 k))
      (let-match erased pt (AtCons _ u _ _ _ at1 s))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Dq ad1))
      (r4c-ca-down us j n1 c u t e (r4c-ca-at us (Succ j) n1 d1 D top u pre1 f hi1 at1 le1 (add-succ-right d1 j Dq ad1)) k s))))

(def-fns _ $ (erased r4c-ca-step : (erased (List (U8)) us0 us) (erased (Nat) j p x) (erased (Col) e) (erased (Ctree) u s u2) (erased (Ca us0 (Succ j) p u) f)
    (erased (Occ u) ou) (erased (Up3 e u s u2) up) (erased (Kid p e x) k) (erased (SetsBelow us0 us (Succ x)) w) (erased (Ca us j (Succ x) s) ks) (erased (Occ s) os)
    -> (erased (Ca us (Succ j) p u2) r))
  (let-match erased f (CaN _ _ _ q b1 b2 b3 y tq k1 k2 k3 _) (absurd (CaE _ _ _ _) ou))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased pq)) (thrice-le p q tq))
  (match erased up _
    ((UpA _ _ v2 v3 w2 w3)
      (let-match erased k (Ki1 _ _ tk))
      (let-match erased (thrice-fn p q x tq tk) (Refl _ _))
      (let-match erased w2 (SelN2 _ _ _))
      (let-match erased w3 (SelN3 _ _ _))
      (CaN us j p q s b2 b3 (elt-sb us0 us p q1 (Succ (Zero)) y w pq) tq ks (r4c-ca-fr us0 us j q2 b2 k2 (fr-sib-in us0 us (Succ j) q2 q1 w l12 l24 p1)) (r4c-ca-fr us0 us j q3 b3 k3 (fr-sib-in us0 us (Succ j) q3 q1 w l13 l34 p1))
        (Occ1 s b2 b3 os)))
    ((UpB _ _ v1 v3 w1 w3)
      (let-match erased k (Ki2 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelN1 _ _ _))
      (let-match erased w3 (SelN3 _ _ _))
      (CaN us j p q b1 s b3 (elt-sb us0 us p q2 (Succ (Zero)) y w (lt-weaken _ _ pq)) tq (r4c-ca-fr us0 us j q1 b1 k1 (fr-lo us0 us (Succ j) q1 q2 w l12 l24 p1)) ks
        (r4c-ca-fr us0 us j q3 b3 k3 (fr-sib-in us0 us (Succ j) q3 q2 w l23 l35 p2)) (Occ2 b1 s b3 os)))
    ((UpC _ _ v1 v2 w1 w2)
      (let-match erased k (Ki3 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelN1 _ _ _))
      (let-match erased w2 (SelN2 _ _ _))
      (CaN us j p q b1 b2 s (elt-sb us0 us p q3 (Succ (Zero)) y w (lt-weaken _ _ (lt-weaken _ _ pq))) tq (r4c-ca-fr us0 us j q1 b1 k1 (fr-lo us0 us (Succ j) q1 q3 w l13 l34 p1))
        (r4c-ca-fr us0 us j q2 b2 k2 (fr-lo us0 us (Succ j) q2 q3 w l23 l35 p2)) ks (Occ3c b1 b2 s os)))))

; The same step from a parent that was empty, its entry now set to 1.
(def-fns _ $ (erased r4c-ca-step0 : (erased (List (U8)) us0 us us1) (erased (Nat) j p x) (erased (Col) e) (erased (Ctree) s u2) (erased (Zr us0 (Succ j) p) z)
    (erased (Put flag-w us p (Succ (Zero)) us1) pu) (erased (Up3 e (CEmpty) s u2) up) (erased (Kid p e x) k) (erased (SetsBelow us0 us (Succ x)) w)
    (erased (Ca us j (Succ x) s) ks) (erased (Occ s) os) -> (erased (Ca us1 (Succ j) p u2) r))
  (let-match erased z (MkZr _ _ _ q _ tq z1 z2 z3))
  (let-match erased z1 (ZkS _ _ _ y1))
  (let-match erased z2 (ZkS _ _ _ y2))
  (let-match erased z3 (ZkS _ _ _ y3))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased pq)) (thrice-le p q tq))
  (let ((erased pq2)) (lt-weaken _ _ pq))
  (let ((erased pq3)) (lt-weaken _ _ pq2))
  (let ((erased E) (erased y)) (values (CEmpty) (put-elt flag-w us us1 p (Succ (Zero)) pu)))
  (let ((erased c1) (erased c2) (erased c3)) (values (CaE us0 j q1 y1) (CaE us0 j q2 y2) (CaE us0 j q3 y3)))
  (match erased up _
    ((UpA _ _ _ _ w2 w3)
      (let-match erased k (Ki1 _ _ tk))
      (let-match erased (thrice-fn p q x tq tk) (Refl _ _))
      (let-match erased w2 (SelE _))
      (let-match erased w3 (SelE _))
      (CaN us1 j p q s E E y tq (r4c-ca-fr us us1 j q1 s ks (fr-one us us1 (Succ j) q1 p _ pu (miss-below p q1 (Succ j) pq)))
        (r4c-ca-fr us us1 j q2 E (r4c-ca-fr us0 us j q2 E c2 (fr-sib-in us0 us (Succ j) q2 q1 w l12 l24 p1)) (fr-one us us1 (Succ j) q2 p _ pu (miss-below p q2 (Succ j) pq2)))
        (r4c-ca-fr us us1 j q3 E (r4c-ca-fr us0 us j q3 E c3 (fr-sib-in us0 us (Succ j) q3 q1 w l13 l34 p1)) (fr-one us us1 (Succ j) q3 p _ pu (miss-below p q3 (Succ j) pq3))) (Occ1 s E E os)))
    ((UpB _ _ _ _ w1 w3)
      (let-match erased k (Ki2 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelE _))
      (let-match erased w3 (SelE _))
      (CaN us1 j p q E s E y tq (r4c-ca-fr us us1 j q1 E (r4c-ca-fr us0 us j q1 E c1 (fr-lo us0 us (Succ j) q1 q2 w l12 l24 p1)) (fr-one us us1 (Succ j) q1 p _ pu (miss-below p q1 (Succ j) pq)))
        (r4c-ca-fr us us1 j q2 s ks (fr-one us us1 (Succ j) q2 p _ pu (miss-below p q2 (Succ j) pq2)))
        (r4c-ca-fr us us1 j q3 E (r4c-ca-fr us0 us j q3 E c3 (fr-sib-in us0 us (Succ j) q3 q2 w l23 l35 p2)) (fr-one us us1 (Succ j) q3 p _ pu (miss-below p q3 (Succ j) pq3))) (Occ2 E s E os)))
    ((UpC _ _ _ _ w1 w2)
      (let-match erased k (Ki3 _ x0 tk))
      (let-match erased (thrice-fn p q x0 tq tk) (Refl _ _))
      (let-match erased w1 (SelE _))
      (let-match erased w2 (SelE _))
      (CaN us1 j p q E E s y tq (r4c-ca-fr us us1 j q1 E (r4c-ca-fr us0 us j q1 E c1 (fr-lo us0 us (Succ j) q1 q3 w l13 l34 p1)) (fr-one us us1 (Succ j) q1 p _ pu (miss-below p q1 (Succ j) pq)))
        (r4c-ca-fr us us1 j q2 E (r4c-ca-fr us0 us j q2 E c2 (fr-lo us0 us (Succ j) q2 q3 w l23 l35 p2)) (fr-one us us1 (Succ j) q2 p _ pu (miss-below p q2 (Succ j) pq2)))
        (r4c-ca-fr us us1 j q3 s ks (fr-one us us1 (Succ j) q3 p _ pu (miss-below p q3 (Succ j) pq3))) (Occ3c E E s os)))))

; red4's cadd above the trace's node n of the path pre, whose subtree o was nonempty: every node on the way up keeps its entry.
(def-fns _ $ (erased r4c-ca-glue : (erased (List (U8)) us0 us) (erased (Nat) n k d D) (erased (Ctree) top s t2 o) (subterm erased (List (Col)) pre)
    (erased (Rp top pre s t2) rp) (erased (HIdx pre n) hi) (erased (Length (Col) pre k) le) (erased (Add k d D) ad) (erased (Ca us0 D (Zero) top) f0)
    (erased (SetsBelow us0 us n) w) (erased (Ca us d n s) ks) (erased (Occ s) os) (erased (CtAt top pre o) ao) (erased (Occ o) oo) -> (erased (Ca us D (Zero) t2) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased rp (RpNil _ _)) (let-match erased hi (HxNil)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) ks))
  (let-match erased rp (RpCons _ u u2 _ _ _ _ au up rp1))
  (let-match erased hi (HxCons _ m x _ hi1 kd))
  (let-match erased le (LengthCons _ _ _ k1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let ((erased ad2)) (add-succ-right k1 d Dq ad1))
  (let-match erased ao (AtCons _ u0 _ _ _ au0 so))
  (let-match erased (ctat-fn top u0 u pre1 au0 au) (Refl _ _))
  (let ((erased ou)) (sel-occ u o e so oo))
  (let ((erased g2)) (r4c-ca-step us0 us d m x e u s u2 (r4c-ca-at us0 (Succ d) m k1 D top u pre1 f0 hi1 au le1 ad2) ou up kd w ks os))
  (let ((erased q) (erased tq)) (thrice-exists m))
  (r4c-ca-glue us0 us m k1 (Succ d) D top u2 t2 u pre1 rp1 hi1 le1 ad2 f0 (sb-up us0 us m q (Succ x) tq (kid-hkid m q x e kd tq) w) g2 (up3-occ e u s u2 up) au ou))

; red4's cadd above the trace's node n of the path pre, through ctr_path with 1.
(def-fns _ $ (erased r4c-ca-path : (erased (List (U8)) us0 us us2) (erased (Nat) n k d D) (erased (Ctree) top s t2 o) (subterm erased (List (Col)) pre)
    (erased (CPth us us2 (Succ (Zero)) pre) cp) (erased (Rp top pre s t2) rp) (erased (HIdx pre n) hi) (erased (Length (Col) pre k) le) (erased (Add k d D) ad)
    (erased (Ca us0 D (Zero) top) f0) (erased (SetsBelow us0 us n) w) (erased (Ca us d n s) ks) (erased (Occ s) os) (erased (CtAt top pre o) ao) -> (erased (Ca us2 D (Zero) t2) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased cp (CpRoot _ _)) (let-match erased rp (RpNil _ _)) (let-match erased hi (HxNil)) (let-match erased le (LengthNil _))
      (let-match erased ad (AddZero _)) ks))
  (let-match erased rp (RpCons _ u u2 _ _ _ _ au up rp1))
  (let-match erased hi (HxCons _ m x _ hi1 kd))
  (let-match erased le (LengthCons _ _ _ k1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let ((erased ad2)) (add-succ-right k1 d Dq ad1))
  (let-match erased ao (AtCons _ u0 _ _ _ au0 so))
  (let-match erased (ctat-fn top u0 u pre1 au0 au) (Refl _ _))
  (let ((erased fu)) (r4c-ca-at us0 (Succ d) m k1 D top u pre1 f0 hi1 au le1 ad2))
  (let ((erased q) (erased tq)) (thrice-exists m))
  (let ((erased hk)) (kid-hkid m q x e kd tq))
  (let ((erased q0) (erased tq0) (erased _) (erased lo)) (kid-base m x e kd))
  (let ((erased mn)) (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq0) (LtS q0 (Succ x) lo)))
  (let ((erased wm)) (sb-up us0 us m q (Succ x) tq hk w))
  (match erased cp _
    ((CpStop _ _ m2 _ _ hi2 y)
      (let-match erased (hidx-det pre1 m m2 hi1 hi2) (Refl _ _))
      (let-match erased fu (CaN _ _ _ _ a1 a2 a3 _ _ _ _ _ _)
        (absurd (CaE _ _ _ z) (let-match erased z (MkZr _ _ _ _ y0 _ _ _ _)) (elt-fn flag-w us m (Zero) (Succ (Zero)) (elt-sb us0 us m (Succ x) (Zero) y0 w mn) y)))
      (let ((erased ou)) (OccN a1 a2 a3))
      (r4c-ca-glue us0 us m k1 (Succ d) D top u2 t2 u pre1 rp1 hi1 le1 ad2 f0 wm (r4c-ca-step us0 us d m x e u s u2 fu ou up kd w ks os) (up3-occ e u s u2 up) au ou))
    ((CpSet _ us1 _ _ mh x0 _ _ hi2 y ap pu cp1)
      (let-match erased (hidx-det pre1 m mh hi1 hi2) (Refl _ _))
      (let-match erased fu (CaE _ _ _ z)
        (absurd (CaN _ _ _ _ _ _ _ y1 _ _ _ _ _)
          (let-match erased (elt-fn flag-w us m x0 (Succ (Zero)) y (elt-sb us0 us m (Succ x) (Succ (Zero)) y1 w mn)) (Refl _ _))
          (apart-irrefl x0 ap)))
      (r4c-ca-path us0 us1 us2 m k1 (Succ d) D top u2 t2 u pre1 cp1 rp1 hi1 le1 ad2 f0 (SbSet us0 us us1 m m (Succ (Zero)) wm pu (HDSelf m))
        (r4c-ca-step0 us0 us us1 d m x e s u2 z pu up kd w ks os) (up3-occ e u s u2 up) au))))

; The trace-level node n holding o: its entry c and children t1 to t3, as bits.
(def-fns _ $ (erased r4c-ca-lv : (erased (List (U8)) us) (erased (Nat) n) (erased (Ctree) o) (erased (Ca us (Zero) n o) f) ->
    (erased (Nat) c) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n c) y) (erased (TB3 c t1 t2 t3) b) (erased (CtSel o (C1) t1) s1) (erased (CtSel o (C2) t2) s2)
    (erased (CtSel o (C3) t3) s3))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased f (CaL _ _ c t1 t2 t3 y b _)
    ((CaE _ _ _ z)
      (let-match erased z (MkZr _ _ _ _ y0 _ _ _ _))
      (let ((erased E)) (CEmpty))
      (values (Zero) E E E y0 (MkB3 (Zero) E E E (Bit0) (Bit0) (Bit0) r4c-bs0 (r4c-bitis-of0 _) (r4c-bitis-of0 _) (r4c-bitis-of0 _) (LfE) (LfE) (LfE))
        (SelE _) (SelE _) (SelE _))))
  (values c t1 t2 t3 y b (SelN1 t1 t2 t3) (SelN2 t1 t2 t3) (SelN3 t1 t2 t3)))

(def-fns _ $ (erased r4c-sel3 : (erased (Ctree) o t1 t2 t3 u) (erased (Nat) d) (erased (Col) e) (erased (CtSel o (C1) t1) s1) (erased (CtSel o (C2) t2) s2) (erased (CtSel o (C3) t3) s3)
    (erased (CD d e) cd) (erased (CtSel (CNode t1 t2 t3) e u) sl) -> (erased (CtSel o e u) r))
  (match erased cd _
    ((Cd0) (let-match erased sl (SelN1 _ _ _)) s1)
    ((Cd1) (let-match erased sl (SelN2 _ _ _)) s2)
    ((Cd2) (let-match erased sl (SelN3 _ _ _)) s3)))

(def-fns _ $ (erased r4c-up3-occ3 : (erased (Col) e) (erased (Ctree) t u w1 w2 w3) (erased (Up3 e t u (CNode w1 w2 w3)) up) (erased (Occ u) o) -> (erased (Occ3 w1 w2 w3) r))
  (match erased up _ ((UpA _ _ _ _ _ _) (Occ1 w1 w2 w3 o)) ((UpB _ _ _ _ _ _) (Occ2 w1 w2 w3 o)) ((UpC _ _ _ _ _ _) (Occ3c w1 w2 w3 o))))

(def-fns _ $ (erased r4c-b3-zero : (erased (Ctree) t1 t2 t3) (erased (TB3 (Zero) t1 t2 t3) b) (erased (Occ3 t1 t2 t3) o) -> (erased (False) f))
  (let-match erased b (MkB3 _ _ _ _ a1 a2 a3 _ b1 b2 b3 l1 l2 l3))
  (match erased o (((False) f))
    (absurd (Occ1 _ _ _ oc) (let-match erased l1 (LfL _) (absurd (LfE) oc)) (r4c-bitis-zero _ (Bit1) b1))
    (absurd (Occ2 _ _ _ oc) (let-match erased l2 (LfL _) (absurd (LfE) oc)) (r4c-bitis-zero _ (Bit1) b2))
    (absurd (Occ3c _ _ _ oc) (let-match erased l3 (LfL _) (absurd (LfE) oc)) (r4c-bitis-zero _ (Bit1) b3))))

; red4's cadd of the trace t, of the colours pre (last first): already in c, or added to c as a leaf and pushed on T.
(def-adts $ (CAd : ((Ctree) c) ((List (Nat)) T) ((Nat) t) ((List (Col)) pre) ((Ctree) c2) ((List (Nat)) T2) -> Type)
  enum
  (many CadHas : (erased (Ctree) c lf) (erased (List (Nat)) T) (erased (Nat) t) (erased (List (Col)) pre) (erased (CtAt c pre (CLeaf lf)) a) -> (CAd c T t pre c T))
  (many CadNew : (erased (Ctree) c c2) (erased (List (Nat)) T) (erased (Nat) t) (erased (List (Col)) pre) (erased (CtAt c pre (CEmpty)) a)
      (erased (Rp c pre (CLeaf (CEmpty)) c2) rp) -> (CAd c T t pre c2 (Cons (Nat) t T))))

(def-adts
  ; Each trace of t, of j + 1 more colours from the prefix p, is in R.
  ((MI : ((List (Nat)) R) ((Nat) j) ((Nat) p) ((Ctree) t) -> Type)
    enum
    (many MiL : (erased (List (Nat)) R) (erased (Nat) p qp) (erased (Ctree) t t1 t2 t3) (erased (Thrice p qp) tp) (erased (CtSel t (C1) t1) s1) (erased (CtSel t (C2) t2) s2)
        (erased (CtSel t (C3) t3) s3) (erased (MI1 R qp t1) m1) (erased (MI1 R (Succ qp) t2) m2) (erased (MI1 R (Succ (Succ qp)) t3) m3) -> (MI R (Zero) p t))
    (many MiN : (erased (List (Nat)) R) (erased (Nat) j p qp) (erased (Ctree) t t1 t2 t3) (erased (Thrice p qp) tp) (erased (CtSel t (C1) t1) s1) (erased (CtSel t (C2) t2) s2)
        (erased (CtSel t (C3) t3) s3) (erased (MI R j qp t1) m1) (erased (MI R j (Succ qp) t2) m2) (erased (MI R j (Succ (Succ qp)) t3) m3) -> (MI R (Succ j) p t)))
  ; u, the trace i's leaf, is empty or i is in R.
  ((MI1 : ((List (Nat)) R) ((Nat) i) ((Ctree) u) -> Type)
    enum
    (many Mi1E : (erased (List (Nat)) R) (erased (Nat) i) -> (MI1 R i (CEmpty)))
    (many Mi1In : (erased (List (Nat)) R) (erased (Nat) i) (erased (Ctree) u) (erased (In i R) p) -> (MI1 R i u))))

(def-fns _ $ (erased r4c-mi1-drop : (erased (Nat) x i) (erased (List (Nat)) R) (erased (Ctree) u) (erased (MI1 (Cons (Nat) x R) i u) m) (erased (Apart (Nat) Lt i x) ap) -> (erased (MI1 R i u) r))
  (match erased m _ ((Mi1E _ _) (Mi1E R i)) ((Mi1In _ _ _ p) (Mi1In R i u (in-tail i x R p ap)))))

; R less its head x, which is no trace below the prefix p.
(def-fns _ $ (erased r4c-mi-drop : (erased (Nat) x j p px) (erased (List (Nat)) R) (erased (Ctree) t) (subterm erased (MI (Cons (Nat) x R) j p t) m) (erased (List (Col)) w)
    (erased (TIdx px w x) ti) (erased (Length (Col) w (Succ j)) lw) (erased (Apart (Nat) Lt p px) ap) -> (erased (MI R j p t) r))
  (match erased m _
    ((MiL _ _ qp _ t1 t2 t3 tp s1 s2 s3 m1 m2 m3)
      (let-match erased lw (LengthCons _ _ _ _ lw1))
      (let-match erased lw1 (LengthNil _))
      (let-match erased ti (TICons _ c _ e w1 k ti1))
      (let-match erased ti1 (TINil _))
      (MiL R p qp t t1 t2 t3 tp s1 s2 s3 (r4c-mi1-drop x qp R t1 m1 (kid-apart p px qp x (C1) e ap (Ki1 p qp tp) k))
        (r4c-mi1-drop x (Succ qp) R t2 m2 (kid-apart p px (Succ qp) x (C2) e ap (Ki2 p qp tp) k))
        (r4c-mi1-drop x (Succ (Succ qp)) R t3 m3 (kid-apart p px (Succ (Succ qp)) x (C3) e ap (Ki3 p qp tp) k))))
    ((MiN _ j1 _ qp _ t1 t2 t3 tp s1 s2 s3 m1 m2 m3)
      (let-match erased lw (LengthCons _ _ _ _ lw1))
      (let-match erased ti (TICons _ c _ e w1 k ti1))
      (MiN R j1 p qp t t1 t2 t3 tp s1 s2 s3 (r4c-mi-drop x j1 qp c R t1 m1 w1 ti1 lw1 (kid-apart p px qp c (C1) e ap (Ki1 p qp tp) k))
        (r4c-mi-drop x j1 (Succ qp) c R t2 m2 w1 ti1 lw1 (kid-apart p px (Succ qp) c (C2) e ap (Ki2 p qp tp) k))
        (r4c-mi-drop x j1 (Succ (Succ qp)) c R t3 m3 w1 ti1 lw1 (kid-apart p px (Succ (Succ qp)) c (C3) e ap (Ki3 p qp tp) k))))))

(def-fns _ $ (erased r4c-mi-down : (erased (List (Nat)) R) (erased (Nat) j p pc) (erased (Ctree) t u) (erased (Col) e) (erased (MI R (Succ j) p t) m) (erased (Kid p e pc) k)
    (erased (CtSel t e u) s) -> (erased (MI R j pc u) r))
  (let-match erased m (MiN _ _ _ qp _ t1 t2 t3 tp s1 s2 s3 m1 m2 m3))
  (match erased k _
    ((Ki1 _ _ tk) (let-match erased (thrice-fn p qp pc tp tk) (Refl _ _)) (let-match erased (sel-fn t u t1 e s s1) (Refl _ _)) m1)
    ((Ki2 _ c0 tk) (let-match erased (thrice-fn p qp c0 tp tk) (Refl _ _)) (let-match erased (sel-fn t u t2 e s s2) (Refl _ _)) m2)
    ((Ki3 _ c0 tk) (let-match erased (thrice-fn p qp c0 tp tk) (Refl _ _)) (let-match erased (sel-fn t u t3 e s s3) (Refl _ _)) m3)))

(def-adts
  ; During red4's cclear, the trie node n, of the trace prefix p, held t, of j + 1 more colours: still as Ca says, each trace of t in R, those left
  ; to clear; or cleared to 0, its children, if any, held the same way.
  ((CCl : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Nat) p) ((Ctree) t) ((List (Nat)) R) -> Type)
    enum
    (many ClK : (erased (List (U8)) us) (erased (Nat) j n p) (erased (Ctree) t) (erased (List (Nat)) R) (erased (Ca us j n t) f) (erased (MI R j p t) m) -> (CCl us j n p t R))
    (many ClZ0 : (erased (List (U8)) us) (erased (Nat) n p) (erased (Ctree) t) (erased (List (Nat)) R) (erased (Elt flag-w us n (Zero)) y) -> (CCl us (Zero) n p t R))
    (many ClZ : (erased (List (U8)) us) (erased (Nat) j n p q qp) (erased (Ctree) t1 t2 t3) (erased (List (Nat)) R) (erased (Elt flag-w us n (Zero)) y) (erased (Thrice n q) tq)
        (erased (Thrice p qp) tp) (erased (CCl us j (Succ q) qp t1 R) k1) (erased (CCl us j (Succ (Succ q)) (Succ qp) t2 R) k2)
        (erased (CCl us j (Succ (Succ (Succ q))) (Succ (Succ qp)) t3 R) k3) -> (CCl us (Succ j) n p (CNode t1 t2 t3) R))))

(def-fns _ $ (erased r4c-cl-fr : (erased (List (U8)) us vs) (erased (Nat) j n p) (erased (List (Nat)) R) (erased (Ctree) t) (subterm erased (CCl us j n p t R) g)
    (erased (MissWrites us vs (Succ j) n) f) -> (erased (CCl vs j n p t R) r))
  (let-match erased g (ClZ _ j1 _ _ q qp t1 t2 t3 _ y tq tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ c m) (ClK vs j n p t R (r4c-ca-fr us vs j n t c f) m))
    ((ClZ0 _ _ _ _ _ y) (ClZ0 vs n p t R (fr-elt us vs j n _ f y))))
  (let ((erased f1) (erased f2) (erased f3)) (fr-kids us vs j n q f tq))
  (ClZ vs j1 n p q qp t1 t2 t3 R (fr-elt us vs j n _ f y) tq tp (r4c-cl-fr us vs j1 (Succ q) qp R t1 k1 f1) (r4c-cl-fr us vs j1 (Succ (Succ q)) (Succ qp) R t2 k2 f2)
    (r4c-cl-fr us vs j1 (Succ (Succ (Succ q))) (Succ (Succ qp)) R t3 k3 f3)))

; R less its head x, which is no trace below the prefix p.
(def-fns _ $ (erased r4c-cl-drop : (erased (List (U8)) us) (erased (Nat) x j n p px) (erased (List (Nat)) R) (erased (Ctree) t) (subterm erased (CCl us j n p t (Cons (Nat) x R)) f)
    (erased (List (Col)) w) (erased (TIdx px w x) ti) (erased (Length (Col) w (Succ j)) lw) (erased (Apart (Nat) Lt p px) ap) -> (erased (CCl us j n p t R) r))
  (let-match erased f (ClZ _ j1 _ _ q qp t1 t2 t3 _ y tq tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ g m) (ClK us j n p t R g (r4c-mi-drop x j p px R t m w ti lw ap)))
    ((ClZ0 _ _ _ _ _ y) (ClZ0 us n p t R y)))
  (let-match erased lw (LengthCons _ _ _ _ lw1))
  (let-match erased ti (TICons _ c _ e w1 k ti1))
  (ClZ us j1 n p q qp t1 t2 t3 R y tq tp (r4c-cl-drop us x j1 (Succ q) qp c R t1 k1 w1 ti1 lw1 (kid-apart p px qp c (C1) e ap (Ki1 p qp tp) k))
    (r4c-cl-drop us x j1 (Succ (Succ q)) (Succ qp) c R t2 k2 w1 ti1 lw1 (kid-apart p px (Succ qp) c (C2) e ap (Ki2 p qp tp) k))
    (r4c-cl-drop us x j1 (Succ (Succ (Succ q))) (Succ (Succ qp)) c R t3 k3 w1 ti1 lw1 (kid-apart p px (Succ (Succ qp)) c (C3) e ap (Ki3 p qp tp) k))))

(def-fns _ $ (erased r4c-cl-down : (erased (List (U8)) us) (erased (List (Nat)) R) (erased (Nat) j n c p pc) (erased (Ctree) t u) (erased (Col) e) (erased (CCl us (Succ j) n p t R) f)
    (erased (Kid n e c) kd) (erased (Kid p e pc) kp) (erased (CtSel t e u) s) -> (erased (CCl us j (Succ c) pc u R) r))
  (let-match erased f (ClZ _ _ _ _ q qp t1 t2 t3 _ _ tq tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ g m) (ClK us j (Succ c) pc u R (r4c-ca-down us j n c t u e g kd s) (r4c-mi-down R j p pc t u e m kp s))))
  (match erased kd _
    ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) (let-match erased kp (Ki1 _ _ tk2)) (let-match erased (thrice-fn p qp pc tp tk2) (Refl _ _))
      (let-match erased s (SelN1 _ _ _)) k1)
    ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased kp (Ki2 _ p0 tk2)) (let-match erased (thrice-fn p qp p0 tp tk2) (Refl _ _))
      (let-match erased s (SelN2 _ _ _)) k2)
    ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased kp (Ki3 _ p0 tk2)) (let-match erased (thrice-fn p qp p0 tp tk2) (Refl _ _))
      (let-match erased s (SelN3 _ _ _)) k3)))

(def-fns _ $ (erased r4c-cl-at : (erased (List (U8)) us) (erased (List (Nat)) R) (erased (Nat) j n p d D) (erased (Ctree) top t) (subterm erased (List (Col)) pre)
    (erased (CCl us D (Zero) (Zero) top R) f) (erased (HIdx pre n) hi) (erased (RIdx pre p) ri) (erased (CtAt top pre t) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad)
    -> (erased (CCl us j n p t R) r))
  (match erased pre _
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased ri (RINil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) f)
    ((Cons _ e pre1)
      (let-match erased hi (HxCons _ n1 c _ hi1 k))
      (let-match erased ri (RICons _ p1 _ _ ri1 kp))
      (let-match erased pt (AtCons _ u _ _ _ at1 s))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Dq ad1))
      (r4c-cl-down us R j n1 c p1 p u t e (r4c-cl-at us R (Succ j) n1 p1 d1 D top u pre1 f hi1 ri1 at1 le1 (add-succ-right d1 j Dq ad1)) k kp s))))

; The children of a node of cclear, one of them the new child c of the path, moved from us0 to us and rid of the trace xt below c.
(def-fns _ $ (erased r4c-cl-kids : (erased (List (U8)) us0 us) (erased (Nat) d m x pm pc xt q qp) (erased (List (Nat)) R) (erased (Ctree) b1 b2 b3 o) (erased (Col) e)
    (erased (List (Col)) w) (erased (Thrice m q) tq) (erased (Thrice pm qp) tp) (erased (CCl us0 d (Succ q) qp b1 (Cons (Nat) xt R)) k1)
    (erased (CCl us0 d (Succ (Succ q)) (Succ qp) b2 (Cons (Nat) xt R)) k2) (erased (CCl us0 d (Succ (Succ (Succ q))) (Succ (Succ qp)) b3 (Cons (Nat) xt R)) k3)
    (erased (Kid m e x) kd) (erased (Kid pm e pc) kp) (erased (CtSel (CNode b1 b2 b3) e o) sl) (erased (SetsBelow us0 us (Succ x)) wb) (erased (CCl us d (Succ x) pc o R) kc)
    (erased (TIdx pc w xt) ti) (erased (Length (Col) w (Succ d)) lw) -> (erased (CCl us d (Succ q) qp b1 R) r1) (erased (CCl us d (Succ (Succ q)) (Succ qp) b2 R) r2)
    (erased (CCl us d (Succ (Succ (Succ q))) (Succ (Succ qp)) b3 R) r3))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased a12) (erased a23)) (values (lt-succ qp) (lt-succ (Succ qp))))
  (let ((erased a13)) (lt-weaken _ _ a12))
  (match erased kd _
    ((Ki1 _ _ tk)
      (let-match erased (thrice-fn m q x tq tk) (Refl _ _))
      (let-match erased kp (Ki1 _ _ tk2))
      (let-match erased (thrice-fn pm qp pc tp tk2) (Refl _ _))
      (let-match erased sl (SelN1 _ _ _))
      (values kc (r4c-cl-drop us xt d q2 (Succ qp) pc R b2 (r4c-cl-fr us0 us d q2 (Succ qp) _ b2 k2 (fr-sib-in us0 us (Succ d) q2 q1 wb l12 l24 p1)) w ti lw (ApGt (Nat) Lt _ _ a12))
        (r4c-cl-drop us xt d q3 (Succ (Succ qp)) pc R b3 (r4c-cl-fr us0 us d q3 (Succ (Succ qp)) _ b3 k3 (fr-sib-in us0 us (Succ d) q3 q1 wb l13 l34 p1)) w ti lw (ApGt (Nat) Lt _ _ a13))))
    ((Ki2 _ x0 tk)
      (let-match erased (thrice-fn m q x0 tq tk) (Refl _ _))
      (let-match erased kp (Ki2 _ p0 tk2))
      (let-match erased (thrice-fn pm qp p0 tp tk2) (Refl _ _))
      (let-match erased sl (SelN2 _ _ _))
      (values (r4c-cl-drop us xt d q1 qp pc R b1 (r4c-cl-fr us0 us d q1 qp _ b1 k1 (fr-lo us0 us (Succ d) q1 q2 wb l12 l24 p1)) w ti lw (ApLt (Nat) Lt _ _ a12)) kc
        (r4c-cl-drop us xt d q3 (Succ (Succ qp)) pc R b3 (r4c-cl-fr us0 us d q3 (Succ (Succ qp)) _ b3 k3 (fr-sib-in us0 us (Succ d) q3 q2 wb l23 l35 p2)) w ti lw (ApGt (Nat) Lt _ _ a23))))
    ((Ki3 _ x0 tk)
      (let-match erased (thrice-fn m q x0 tq tk) (Refl _ _))
      (let-match erased kp (Ki3 _ p0 tk2))
      (let-match erased (thrice-fn pm qp p0 tp tk2) (Refl _ _))
      (let-match erased sl (SelN3 _ _ _))
      (values (r4c-cl-drop us xt d q1 qp pc R b1 (r4c-cl-fr us0 us d q1 qp _ b1 k1 (fr-lo us0 us (Succ d) q1 q3 wb l13 l34 p1)) w ti lw (ApLt (Nat) Lt _ _ a13))
        (r4c-cl-drop us xt d q2 (Succ qp) pc R b2 (r4c-cl-fr us0 us d q2 (Succ qp) _ b2 k2 (fr-lo us0 us (Succ d) q2 q3 wb l23 l35 p2)) w ti lw (ApLt (Nat) Lt _ _ a23)) kc))))

(def-fns _ $ (erased r4c-ca-nz : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) o) (erased (Ca us j n o) f) (erased (Occ o) oo) -> (erased (Nat) c) (erased (Elt flag-w us n (Succ c)) y))
  (let-match erased f (CaN _ _ _ _ _ _ _ y _ _ _ _ _) ((CaE _ _ _ _) (match erased oo (((Nat) c) ((Elt flag-w us n (Succ c)) y))))
    ((CaL _ _ c t1 t2 t3 y b o3) (let-match erased c (Succ c1) (absurd (Zero) (r4c-b3-zero t1 t2 t3 b o3))) (values c1 y)))
  (values (Zero) y))

; red4's cclear above the cleared node n of the path pre, the node of the trace xt, once ctr_path has stopped: the zeroed ancestors keep 0.
(def-fns _ $ (erased r4c-cl-glue : (erased (List (U8)) us0 us) (erased (Nat) n k d D p xt) (erased (List (Nat)) R) (erased (Ctree) top o) (subterm erased (List (Col)) pre)
    (erased (List (Col)) w) (erased (HIdx pre n) hi) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (Add k d D) ad) (erased (CCl us0 D (Zero) (Zero) top (Cons (Nat) xt R)) f0)
    (erased (SetsBelow us0 us n) wb) (erased (CCl us d n p o R) kc) (erased (CtAt top pre o) ao) (erased (Occ o) oo) (erased (Elt flag-w us0 n (Zero)) y0) (erased (TIdx p w xt) ti)
    (erased (Length (Col) w (Succ d)) lw) -> (erased (CCl us D (Zero) (Zero) top R) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased ri (RINil)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) (let-match erased ao (AtNil _)) kc))
  (let-match erased hi (HxCons _ m x _ hi1 kd))
  (let-match erased ri (RICons _ pm _ _ ri1 kp))
  (let-match erased le (LengthCons _ _ _ k1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let ((erased ad2)) (add-succ-right k1 d Dq ad1))
  (let-match erased ao (AtCons _ u _ _ _ au so))
  (let ((erased ou)) (sel-occ u o e so oo))
  (let-match erased (r4c-cl-at us0 (Cons _ xt R) (Succ d) m pm k1 D top u pre1 f0 hi1 ri1 au le1 ad2) (ClZ _ _ _ _ q qp b1 b2 b3 _ y tq tp k4 k5 k6)
    (absurd (ClK _ _ _ _ _ _ g _)
      (let-match erased g (CaN _ _ _ _ _ _ _ _ _ _ _ _ _) (absurd (CaE _ _ _ _) ou))
      (let ((erased c) (erased yc)) (r4c-ca-nz us0 d (Succ x) o (r4c-ca-down us0 d m x u o e g kd so) oo))
      (elt-fn flag-w us0 (Succ x) (Succ c) (Zero) yc y0)))
  (let ((erased q0) (erased tq0) (erased _) (erased lo)) (kid-base m x e kd))
  (let ((erased mn)) (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq0) (LtS q0 (Succ x) lo)))
  (let ((erased r1) (erased r2) (erased r3)) (r4c-cl-kids us0 us d m x pm p xt q qp R b1 b2 b3 o e w tq tp k4 k5 k6 kd kp so wb kc ti lw))
  (r4c-cl-glue us0 us m k1 (Succ d) D pm xt R top u pre1 (Cons _ e w) hi1 ri1 le1 ad2 f0 (sb-up us0 us m q (Succ x) tq (kid-hkid m q x e kd tq) wb)
    (ClZ us d m pm q qp b1 b2 b3 R (elt-sb us0 us m (Succ x) (Zero) y wb mn) tq tp r1 r2 r3) au ou y (TICons pm p xt e w kp ti) (LengthCons _ e w (Succ d) lw)))

; red4's cclear above the cleared node n of the path pre, the node of the trace xt, through ctr_path with 0.
(def-fns _ $ (erased r4c-cl-path : (erased (List (U8)) us0 us us2) (erased (Nat) n k d D p xt) (erased (List (Nat)) R) (erased (Ctree) top o) (subterm erased (List (Col)) pre)
    (erased (List (Col)) w) (erased (CPth us us2 (Zero) pre) cp) (erased (HIdx pre n) hi) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (Add k d D) ad)
    (erased (CCl us0 D (Zero) (Zero) top (Cons (Nat) xt R)) f0) (erased (SetsBelow us0 us n) wb) (erased (CCl us d n p o R) kc) (erased (CtAt top pre o) ao) (erased (Occ o) oo)
    (erased (TIdx p w xt) ti) (erased (Length (Col) w (Succ d)) lw) -> (erased (CCl us2 D (Zero) (Zero) top R) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased cp (CpRoot _ _)) (let-match erased hi (HxNil)) (let-match erased ri (RINil)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _))
      (let-match erased ao (AtNil _)) kc))
  (let-match erased hi (HxCons _ m x _ hi1 kd))
  (let-match erased ri (RICons _ pm _ _ ri1 kp))
  (let-match erased le (LengthCons _ _ _ k1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let ((erased ad2)) (add-succ-right k1 d Dq ad1))
  (let-match erased ao (AtCons _ u _ _ _ au so))
  (let ((erased ou)) (sel-occ u o e so oo))
  (let ((erased fu)) (r4c-cl-at us0 (Cons _ xt R) (Succ d) m pm k1 D top u pre1 f0 hi1 ri1 au le1 ad2))
  (let ((erased q0) (erased tq0) (erased _) (erased lo)) (kid-base m x e kd))
  (let ((erased mn)) (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq0) (LtS q0 (Succ x) lo)))
  (let ((erased qm) (erased tqm)) (thrice-exists m))
  (let ((erased wm)) (sb-up us0 us m qm (Succ x) tqm (kid-hkid m qm x e kd tqm) wb))
  (let ((erased ti2) (erased lw2)) (values (TICons pm p xt e w kp ti) (LengthCons _ e w (Succ d) lw)))
  (match erased cp _
    ((CpStop _ _ m2 _ _ hi2 y)
      (let-match erased (hidx-det pre1 m m2 hi1 hi2) (Refl _ _))
      (let-match erased fu (ClZ _ _ _ _ q qp b1 b2 b3 _ y0 tq tp k4 k5 k6)
        (absurd (ClK _ _ _ _ _ _ g _)
          (let-match erased g (CaN _ _ _ _ _ _ _ y1 _ _ _ _ _) (absurd (CaE _ _ _ _) ou))
          (elt-fn flag-w us m (Succ (Zero)) (Zero) (elt-sb us0 us m (Succ x) (Succ (Zero)) y1 wb mn) y)))
      (let ((erased r1) (erased r2) (erased r3)) (r4c-cl-kids us0 us d m x pm p xt q qp R b1 b2 b3 o e w tq tp k4 k5 k6 kd kp so wb kc ti lw))
      (r4c-cl-glue us0 us m k1 (Succ d) D pm xt R top u pre1 (Cons _ e w) hi1 ri1 le1 ad2 f0 wm (ClZ us d m pm q qp b1 b2 b3 R y tq tp r1 r2 r3) au ou y0 ti2 lw2))
    ((CpSet _ us1 _ _ mh x0 _ _ hi2 y ap pu cp1)
      (let-match erased (hidx-det pre1 m mh hi1 hi2) (Refl _ _))
      (let-match erased fu (ClK _ _ _ _ _ _ g mi)
        (absurd (ClZ _ _ _ _ _ _ _ _ _ _ y0 _ _ _ _ _)
          (let-match erased (elt-fn flag-w us m x0 (Zero) y (elt-sb us0 us m (Succ x) (Zero) y0 wb mn)) (Refl _ _))
          (apart-irrefl (Zero) ap)))
      (let-match erased g (CaN _ _ _ q b1 b2 b3 _ tq c1 c2 c3 _) (absurd (CaE _ _ _ _) ou))
      (let-match erased mi (MiN _ _ _ qp _ v1 v2 v3 tp s1 s2 s3 m1 m2 m3))
      (let-match erased s1 (SelN1 _ _ _))
      (let-match erased s2 (SelN2 _ _ _))
      (let-match erased s3 (SelN3 _ _ _))
      (let ((erased R2) (erased _)) (values (Cons _ xt R) (Zero)))
      (let ((erased r1) (erased r2) (erased r3))
        (r4c-cl-kids us0 us d m x pm p xt q qp R b1 b2 b3 o e w tq tp (ClK us0 d (Succ q) qp b1 R2 c1 m1) (ClK us0 d (Succ (Succ q)) (Succ qp) b2 R2 c2 m2)
          (ClK us0 d (Succ (Succ (Succ q))) (Succ (Succ qp)) b3 R2 c3 m3) kd kp so wb kc ti lw))
      (let ((erased l1)) (thrice-le m q tq))
      (let ((erased l2)) (lt-weaken _ _ l1))
      (let ((erased new))
        (ClZ us1 d m pm q qp b1 b2 b3 R (put-elt flag-w us us1 m (Zero) pu) tq tp (r4c-cl-fr us us1 d (Succ q) qp R b1 r1 (fr-one us us1 (Succ d) (Succ q) m (Zero) pu (miss-below m (Succ q) (Succ d) l1)))
          (r4c-cl-fr us us1 d (Succ (Succ q)) (Succ qp) R b2 r2 (fr-one us us1 (Succ d) (Succ (Succ q)) m (Zero) pu (miss-below m (Succ (Succ q)) (Succ d) l2))) (r4c-cl-fr us us1 d (Succ (Succ (Succ q))) (Succ (Succ qp)) R b3 r3 (fr-one us us1 (Succ d) (Succ (Succ (Succ q))) m (Zero) pu (miss-below m (Succ (Succ (Succ q))) (Succ d) (lt-weaken _ _ l2))))))
      (r4c-cl-path us0 us1 us2 m k1 (Succ d) D pm xt R top u pre1 (Cons _ e w) cp1 hi1 ri1 le1 ad2 f0 (SbSet us0 us us1 m m (Zero) wm pu (HDSelf m)) new au ou ti2 lw2))))

(def-fns _ $ (erased r4c-mi1-nil : (erased (Nat) i) (erased (Ctree) u) (erased (MI1 (Nil (Nat)) i u) m) (erased (Occ u) o) -> (erased (False) f))
  (match erased m (((False) f)) (absurd (Mi1E _ _) o) (absurd (Mi1In _ _ _ p) p)))

(def-fns _ $ (erased r4c-ca-nil : (erased (List (U8)) us) (erased (Nat) j n p) (erased (Ctree) t) (subterm erased (Ca us j n t) f) (erased (MI (Nil (Nat)) j p t) m) (erased (Occ t) ot)
    -> (erased (False) r))
  (match erased f (((False) r))
    (absurd (CaE _ _ _ _) ot)
    ((CaL _ _ _ t1 t2 t3 _ _ o3)
      (let-match erased m (MiL _ _ _ _ _ _ _ _ s1 s2 s3 m1 m2 m3))
      (let-match erased s1 (SelN1 _ _ _))
      (let-match erased s2 (SelN2 _ _ _))
      (let-match erased s3 (SelN3 _ _ _))
      (match erased o3 (((False) r))
        ((Occ1 _ _ _ oc) (r4c-mi1-nil _ t1 m1 oc)) ((Occ2 _ _ _ oc) (r4c-mi1-nil _ t2 m2 oc)) ((Occ3c _ _ _ oc) (r4c-mi1-nil _ t3 m3 oc))))
    ((CaN _ j1 _ q t1 t2 t3 _ _ k1 k2 k3 o3)
      (let-match erased m (MiN _ _ _ qp _ _ _ _ _ s1 s2 s3 m1 m2 m3))
      (let-match erased s1 (SelN1 _ _ _))
      (let-match erased s2 (SelN2 _ _ _))
      (let-match erased s3 (SelN3 _ _ _))
      (match erased o3 (((False) r))
        ((Occ1 _ _ _ oc) (r4c-ca-nil us j1 (Succ q) qp t1 k1 m1 oc))
        ((Occ2 _ _ _ oc) (r4c-ca-nil us j1 (Succ (Succ q)) (Succ qp) t2 k2 m2 oc))
        ((Occ3c _ _ _ oc) (r4c-ca-nil us j1 (Succ (Succ (Succ q))) (Succ (Succ qp)) t3 k3 m3 oc))))))

; With nothing left to clear, every entry is 0.
(def-fns _ $ (erased r4c-cl-zr : (erased (List (U8)) us) (erased (Nat) j n p) (erased (Ctree) t) (subterm erased (CCl us j n p t (Nil (Nat))) f) -> (erased (Zr us j n) r))
  (let ((erased q) (erased tq)) (thrice-exists n))
  (let-match erased f (ClK _ _ _ _ _ _ g m)
    ((ClZ0 _ _ _ _ _ y) (MkZr us (Zero) n q y tq (ZkZ us _) (ZkZ us _) (ZkZ us _)))
    ((ClZ _ j1 _ _ q2 qp t1 t2 t3 _ y tq2 _ k1 k2 k3)
      (MkZr us j n q2 y tq2 (ZkS us j1 _ (r4c-cl-zr us j1 _ qp t1 k1)) (ZkS us j1 _ (r4c-cl-zr us j1 _ (Succ qp) t2 k2))
        (ZkS us j1 _ (r4c-cl-zr us j1 _ (Succ (Succ qp)) t3 k3)))))
  (let-match erased g (CaE _ _ _ z)
    (absurd (CaL _ _ _ t1 t2 t3 _ _ _) (r4c-ca-nil us j n p t g m (OccN t1 t2 t3)))
    (absurd (CaN _ _ _ _ t1 t2 t3 _ _ _ _ _ _) (r4c-ca-nil us j n p t g m (OccN t1 t2 t3))))
  z)

(def-fns _ $ (erased r4c-cl-elt : (erased (List (U8)) us) (erased (Nat) n p) (erased (Ctree) t) (erased (List (Nat)) R) (erased (CCl us (Zero) n p t R) f) -> (erased (Nat) c) (erased (Elt flag-w us n c) y))
  (let-match erased f (ClK _ _ _ _ _ _ g _) ((ClZ0 _ _ _ _ _ y) (values (Zero) y)))
  (let-match erased g (CaL _ _ c _ _ _ y _ _) ((CaE _ _ _ z) (let-match erased z (MkZr _ _ _ _ y0 _ _ _ _)) (values (Zero) y0)))
  (values c y))

; R lists the entries i to n of xs, in order.
(def-adts $ (Fwd : ((List (Copy (Nat))) xs) ((Nat) i) ((Nat) n) ((List (Nat)) R) -> Type)
  enum
  (many FwE : (erased (List (Copy (Nat))) xs) (erased (Nat) n) -> (Fwd xs n n (Nil (Nat))))
  (many FwC : (erased (List (Copy (Nat))) xs) (erased (Nat) i n x) (erased (List (Nat)) R) (erased (WElt xs i x) w) (erased (Fwd xs (Succ i) n R) f)
      -> (Fwd xs i n (Cons (Nat) x R))))

(def-fns _ $ (erased r4c-fwd-ex : (erased (List (Copy (Nat))) xs) (erased (Nat) i n cap) (subterm erased (Nat) k) (erased (Add i k n) ad) (erased (Length (Copy (Nat)) xs cap) l)
    (erased (AllCu xs) au) (erased (Lt n (Succ cap)) nc) -> (erased (List (Nat)) R) (erased (Fwd xs i n R) f))
  (let-match erased k (Succ k1) ((Zero) (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _)) (values (Nil _) (FwE xs i))))
  (let ((erased il)) (lt-le-trans i n cap (add-pos-lt i (Succ k1) n ad (LtZ k1)) nc))
  (let ((erased cv) (erased nth)) (nth-exists _ xs cap i l il))
  (let-match erased cv (MkCopy _ x))
  (let ((erased R) (erased f)) (r4c-fwd-ex xs (Succ i) n cap k1 (add-shift i k1 n ad) l au nc))
  (values (Cons _ x R) (FwC xs i n x R (MkWElt xs i x nth) f)))

(def-fns _ $ (erased r4c-fwd-in : (erased (List (Copy (Nat))) xs) (erased (Nat) i n j y) (erased (List (Nat)) R) (subterm erased (Fwd xs i n R) f) (erased (WElt xs j y) w)
    (erased (Lt i (Succ j)) ij) (erased (Lt j n) jn) -> (erased (In y R) r))
  (let-match erased f (FwC _ _ _ x R1 wx f1) (absurd (FwE _ _) (lt-irrefl j (lt-le-trans j i j jn ij))))
  (let-match erased (nat-eq i j) (Unequal _ _ _ _ ap) ((Equal _ _ _) (let-match erased (welt-fn xs i x y wx w) (Refl _ _)) (InHere y R1)))
  (let-match erased ap (ApLt _ _ _ _ l) (absurd (ApGt _ _ _ _ g) (lt-irrefl j (lt-le-trans j i j g ij))))
  (InThere y x R1 (r4c-fwd-in xs (Succ i) n j y R1 f1 w (LtS i j l) jn)))

(def-fns _ $ (erased r4c-tbk-in : (erased (List (Copy (Nat))) xs) (erased (Nat) k y) (erased (List (Nat)) T) (subterm erased (Tbk xs k T) b) (erased (In y T) p)
    -> (erased (Nat) j) (erased (WElt xs j y) w) (erased (Lt j k) l))
  (let-match erased b (TbkCons _ k1 x T1 b1 wx) (absurd (TbkNil _) p))
  (let-match erased p (InThere _ _ _ p1) ((InHere _ _) (values k1 wx (lt-succ k1))))
  (let ((erased j) (erased w) (erased l)) (r4c-tbk-in xs k1 y T1 b1 p1))
  (values j w (lt-weaken _ _ l)))

(def-fns _ $ (erased r4c-tbk-at : (erased (List (Copy (Nat))) xs) (erased (Nat) k i y) (erased (List (Nat)) T) (subterm erased (Tbk xs k T) b) (erased (WElt xs i y) w) (erased (Lt i k) l)
    -> (erased (In y T) r))
  (let-match erased b (TbkCons _ k1 x T1 b1 wx) (absurd (TbkNil _) l))
  (let-match erased (nat-eq i k1) (Unequal _ _ _ _ ap) ((Equal _ _ _) (let-match erased (welt-fn xs i y x w wx) (Refl _ _)) (InHere y T1)))
  (let-match erased ap (ApLt _ _ _ _ l1) (absurd (ApGt _ _ _ _ g) (lt-irrefl i (lt-le-trans i (Succ k1) i l (LtS k1 i g)))))
  (InThere y x T1 (r4c-tbk-at xs k1 i y T1 b1 w l1)))

(def-fns _
  ((erased r4c-mi-mono : (erased (List (Copy (Nat))) xs) (erased (Nat) n j p) (erased (List (Nat)) T R) (erased (Ctree) t) (subterm erased (MI T j p t) m) (erased (Tbk xs n T) b)
      (erased (Fwd xs (Zero) n R) f) -> (erased (MI R j p t) r))
    (match erased m _
      ((MiL _ _ qp _ t1 t2 t3 tp s1 s2 s3 m1 m2 m3)
        (MiL R p qp t t1 t2 t3 tp s1 s2 s3 (r4c-mi1-mono xs n qp T R t1 m1 b f) (r4c-mi1-mono xs n (Succ qp) T R t2 m2 b f) (r4c-mi1-mono xs n (Succ (Succ qp)) T R t3 m3 b f)))
      ((MiN _ j1 _ qp _ t1 t2 t3 tp s1 s2 s3 m1 m2 m3)
        (MiN R j1 p qp t t1 t2 t3 tp s1 s2 s3 (r4c-mi-mono xs n j1 qp T R t1 m1 b f) (r4c-mi-mono xs n j1 (Succ qp) T R t2 m2 b f)
          (r4c-mi-mono xs n j1 (Succ (Succ qp)) T R t3 m3 b f)))))
  ((erased r4c-mi1-mono : (erased (List (Copy (Nat))) xs) (erased (Nat) n i) (erased (List (Nat)) T R) (erased (Ctree) u) (subterm erased (MI1 T i u) m) (erased (Tbk xs n T) b)
      (erased (Fwd xs (Zero) n R) f) -> (erased (MI1 R i u) r))
    (let-match erased m (Mi1In _ _ _ p) ((Mi1E _ _) (Mi1E R i)))
    (let ((erased j) (erased w) (erased l)) (r4c-tbk-in xs n i T b p))
    (Mi1In R i u (r4c-fwd-in xs (Zero) n j i R f w (LtZ j) l))))

; Each element of T is a trace of c, of the colours pre, last first.
(def-adts $ (AMc : ((Nat) h) ((Ctree) c) ((List (Nat)) T) -> Type)
  enum
  (many AmNil : (erased (Nat) h) (erased (Ctree) c) -> (AMc h c (Nil (Nat))))
  (many AmCons : (erased (Nat) h x) (erased (Ctree) c lf) (erased (List (Nat)) T) (erased (List (Col)) pre) (erased (RIdx pre x) ri) (erased (Length (Col) pre (Succ h)) le)
      (erased (CtAt c pre (CLeaf lf)) a) (erased (AMc h c T) m) -> (AMc h c (Cons (Nat) x T))))

(def-fns _ $ (erased r4c-am-in : (erased (Nat) h x) (erased (Ctree) c) (erased (List (Nat)) T) (subterm erased (AMc h c T) m) (erased (In x T) p) ->
    (erased (List (Col)) pre) (erased (Ctree) lf) (erased (RIdx pre x) ri) (erased (Length (Col) pre (Succ h)) le) (erased (CtAt c pre (CLeaf lf)) a))
  (let-match erased m (AmCons _ y _ lf0 T1 pre0 ri0 le0 a0 m1) (absurd (AmNil _ _) p))
  (let-match erased p (InThere _ _ _ p1) ((InHere _ _) (values pre0 lf0 ri0 le0 a0)))
  (r4c-am-in h x c T1 m1 p1))

(def-fns _ $ (erased r4c-tbk-len : (erased (List (Copy (Nat))) xs) (erased (Nat) k) (erased (List (Nat)) T) (subterm erased (Tbk xs k T) b) -> (erased (Length (Nat) T k) r))
  (let-match erased b (TbkCons _ k1 x T1 b1 _) ((TbkNil _) (LengthNil _)))
  (LengthCons _ x T1 k1 (r4c-tbk-len xs k1 T1 b1)))

(def-fns _ $ (erased r4c-fwd-le : (erased (List (Copy (Nat))) xs) (erased (Nat) i n) (erased (List (Nat)) R) (subterm erased (Fwd xs i n R) f) -> (erased (Lt i (Succ n)) r))
  (let-match erased f (FwC _ _ _ _ R1 _ f1) ((FwE _ _) (lt-succ n)))
  (lt-succ-left i (Succ n) (r4c-fwd-le xs (Succ i) n R1 f1)))


; Over the entries i to n of the gone list xs, red4's cadd of each trace's rotations by 1 and by 2 takes c and T to c2 and T2.
(def-adts $ (GAd : ((Nat) h) ((List (Copy (Nat))) xs) ((Nat) i) ((Nat) n) ((Ctree) c) ((List (Nat)) T) ((Ctree) c2) ((List (Nat)) T2) -> Type)
  enum
  (many GaE : (erased (Nat) h) (erased (List (Copy (Nat))) xs) (erased (Nat) n) (erased (Ctree) c) (erased (List (Nat)) T) -> (GAd h xs n n c T c T))
  (many GaC : (erased (Nat) h) (erased (List (Copy (Nat))) xs) (erased (Nat) i n g t1 t2) (erased (Ctree) c c1 c2 c3) (erased (List (Nat)) T T1 T2 T3) (erased (List (Col)) pg p1 p2)
      (erased (WElt xs i g) w) (erased (RIdx pg g) rg) (erased (Length (Col) pg (Succ h)) lg) (erased (PermT p231 pg p1) q1) (erased (RIdx p1 t1) r1) (erased (CAd c T t1 p1 c1 T1) a1)
      (erased (PermT p312 pg p2) q2) (erased (RIdx p2 t2) r2) (erased (CAd c1 T1 t2 p2 c2 T2) a2) (erased (GAd h xs (Succ i) n c2 T2 c3 T3) g3) -> (GAd h xs i n c T c3 T3)))


; y2 is what the trace path j holds after the path i is replaced by s, y before.
(def-adts $ (RpR : ((Nat) i) ((Nat) j) ((Ctree) s) ((Ctree) y) ((Ctree) y2) -> Type)
  enum
  (many RrS : (erased (Nat) i) (erased (Ctree) s y) -> (RpR i i s y s))
  (many RrO : (erased (Nat) i j) (erased (Ctree) s y) (erased (Apart (Nat) Lt i j) ap) -> (RpR i j s y y)))

(def-fns _ $ (erased r4c-up3-sel : (erased (Col) e f) (erased (Ctree) u s u2 y) (erased (Nat) a b) (erased (Up3 e u s u2) up) (erased (KidCmp e f a b) kc) (erased (CtSel u f y) sy)
    -> (erased (Ctree) y2) (erased (CtSel u2 f y2) s2) (erased (RpR a b s y y2) rr))
  (match erased kc _
    ((KcSame _ _)
      (values s (match erased up (((CtSel u2 e s) r)) ((UpA _ _ a2 a3 _ _) (SelN1 s a2 a3)) ((UpB _ _ a1 a3 _ _) (SelN2 a1 s a3)) ((UpC _ _ a1 a2 _ _) (SelN3 a1 a2 s)))
        (RrS a s y)))
    ((KcNe _ _ _ _ ne ap)
      (values y
        (match erased up (((CtSel u2 f y) r))
          ((UpA _ _ a2 a3 w2 w3)
            (match erased ne _
              ((N12) (let-match erased (sel-fn u y a2 f sy w2) (Refl _ _)) (SelN2 s a2 a3))
              ((N13) (let-match erased (sel-fn u y a3 f sy w3) (Refl _ _)) (SelN3 s a2 a3))))
          ((UpB _ _ a1 a3 w1 w3)
            (match erased ne _
              ((N21) (let-match erased (sel-fn u y a1 f sy w1) (Refl _ _)) (SelN1 a1 s a3))
              ((N23) (let-match erased (sel-fn u y a3 f sy w3) (Refl _ _)) (SelN3 a1 s a3))))
          ((UpC _ _ a1 a2 w1 w2)
            (match erased ne _
              ((N31) (let-match erased (sel-fn u y a1 f sy w1) (Refl _ _)) (SelN1 a1 a2 s))
              ((N32) (let-match erased (sel-fn u y a2 f sy w2) (Refl _ _)) (SelN2 a1 a2 s)))))
        (RrO a b s y ap)))))

(def-fns _ $ (erased r4c-rp-at : (erased (Ctree) top s t2 y) (erased (Nat) ip iq k) (subterm erased (List (Col)) p) (erased (List (Col)) q) (erased (Rp top p s t2) r)
    (erased (RIdx p ip) rp) (erased (RIdx q iq) rq) (erased (Length (Col) p k) lp) (erased (Length (Col) q k) lq) (erased (CtAt top q y) aq)
    -> (erased (Ctree) y2) (erased (CtAt t2 q y2) a2) (erased (RpR ip iq s y y2) rr))
  (let-match erased p (Cons _ e p1)
    ((Nil _)
      (let-match erased r (RpNil _ _))
      (let-match erased lp (LengthNil _))
      (let-match erased lq (LengthNil _))
      (let-match erased rp (RINil))
      (let-match erased rq (RINil))
      (let-match erased aq (AtNil _))
      (values s (AtNil s) (RrS (Zero) s top))))
  (let-match erased r (RpCons _ u u2 _ _ _ _ au up r1))
  (let-match erased rp (RICons _ a _ _ rp1 ka))
  (let-match erased lp (LengthCons _ _ _ k1 lp1))
  (let-match erased lq (LengthCons _ f q1 _ lq1))
  (let-match erased rq (RICons _ b _ _ rq1 kb))
  (let-match erased aq (AtCons _ v _ _ _ aq1 sv))
  (let ((erased y21) (erased a21) (erased rr1)) (r4c-rp-at top u2 t2 v a b k1 p1 q1 r1 rp1 rq1 lp1 lq1 aq1))
  (let-match erased rr1 (RrS _ _ _) ((RrO _ _ _ _ ap) (values y (AtCons t2 v y q1 f a21 sv) (RrO ip iq s y (kid-apart a b ip iq e f ap ka kb)))))
  (let-match erased (ridx-fn p1 q1 a k1 rp1 rq1 lp1 lq1) (Refl _ _))
  (let-match erased (ctat-fn top u v p1 au aq1) (Refl _ _))
  (let ((erased y2) (erased s2) (erased rr)) (r4c-up3-sel e f u s u2 y ip iq up (kid-dec a ip iq e f ka kb) sv))
  (values y2 (AtCons t2 u2 y2 q1 f a21 s2) rr))

; b is Bit1 exactly when x is in R.
(def-adts $ (MemB : ((Nat) x) ((List (Nat)) R) ((Bit) b) -> Type)
  enum
  (many MbY : (erased (Nat) x) (erased (List (Nat)) R) (erased (In x R) p) -> (MemB x R (Bit1)))
  (many MbN : (erased (Nat) x) (erased (List (Nat)) R) (erased (NotIn x R) p) -> (MemB x R (Bit0))))

(def-fns _ $ (erased r4c-or0l : (erased (Bit) a) -> (erased (BitApply or-op (Bit0) a a) r))
  (match erased a _ ((Bit0) (Ap00 or-op)) ((Bit1) (Ap01 (Bit1) (Bit1) (Bit1)))))

(def-fns _ $ (erased r4c-or1l : (erased (Bit) a) -> (erased (BitApply or-op (Bit1) a (Bit1)) r))
  (match erased a _ ((Bit0) (Ap10 (Bit1) (Bit1) (Bit1))) ((Bit1) (Ap11 (Bit1) (Bit1) (Bit1)))))

(def-fns _ $ (erased r4c-memb-cons : (erased (Nat) g x) (erased (List (Nat)) R) (erased (Bit) e m) (erased (EqB g x e) eq) (erased (MemB x R m) mb)
    -> (erased (Bit) b) (erased (MemB x (Cons (Nat) g R) b) r) (erased (BitApply or-op e m b) o))
  (let-match erased eq (EbDiff _ _ ap) ((EbSame _) (values (Bit1) (MbY x _ (InHere x R)) (r4c-or1l m))))
  (match erased mb _
    ((MbY _ _ p) (values (Bit1) (MbY x _ (InThere x g R p)) (Ap01 (Bit1) (Bit1) (Bit1))))
    ((MbN _ _ p) (values (Bit0) (MbN x _ (NotInCons x g R (apart-sym g x ap) p)) (Ap00 or-op)))))

(def-fns _ $ (erased r4c-memb-fn : (erased (Nat) x) (erased (List (Nat)) R) (erased (Bit) a b) (erased (MemB x R a) p) (erased (MemB x R b) q) -> (erased (Eq (Bit) a b) e))
  (match erased p _
    ((MbY _ _ i) (let-match erased q (MbY _ _ _) (absurd (MbN _ _ o) (apart-irrefl x (notin-in x x R o i)))) (Refl _ a))
    ((MbN _ _ o) (let-match erased q (MbN _ _ _) (absurd (MbY _ _ i) (apart-irrefl x (notin-in x x R o i)))) (Refl _ a))))

; red4's cadd of t moves the trace ti's bit in c, kept equal to its bit in T, to its or with whether ti is t.
(def-fns _ $ (erased r4c-cad-bit : (erased (Nat) h t ti) (erased (Ctree) c c2 x0) (erased (List (Nat)) T T2) (erased (List (Col)) p pre) (erased (Bit) b0)
    (erased (CAd c T t p c2 T2) ad) (erased (RIdx p t) rp) (erased (Length (Col) p (Succ h)) lp) (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le)
    (erased (CtAt c pre x0) a0) (erased (Lf x0 b0) l0) (erased (MemB ti T b0) m0)
    -> (erased (Bit) e b) (erased (Ctree) x) (erased (EqB t ti e) eq) (erased (CtAt c2 pre x) a) (erased (Lf x b) l) (erased (MemB ti T2 b) m) (erased (BitApply or-op b0 e b) o))
  (match erased ad _
    ((CadHas _ lf _ _ _ ah)
      (let-match erased (nat-eq t ti) (Equal _ _ _) ((Unequal _ _ _ _ ap) (values (Bit0) b0 x0 (EbDiff t ti ap) a0 l0 m0 (r4c-or0 b0))))
      (let-match erased (ridx-fn p pre t (Succ h) rp ri lp le) (Refl _ _))
      (let-match erased (ctat-fn c x0 (CLeaf lf) pre a0 ah) (Refl _ _))
      (let-match erased l0 (LfL _))
      (values (Bit1) (Bit1) x0 (EbSame t) a0 l0 m0 (r4c-or1 (Bit1))))
    ((CadNew _ _ _ _ _ ae rpl)
      (let ((erased y2) (erased a2) (erased rr)) (r4c-rp-at c (CLeaf (CEmpty)) c2 x0 t ti (Succ h) p pre rpl rp ri lp le a0))
      (let-match erased rr (RrS _ _ _)
        ((RrO _ _ _ _ ap)
          (values (Bit0) b0 x0 (EbDiff t ti ap) a2 l0
            (match erased m0 (((MemB ti (Cons (Nat) t T) b0) r))
              ((MbY _ _ q) (MbY ti _ (InThere ti t T q)))
              ((MbN _ _ q) (MbN ti _ (NotInCons ti t T (apart-sym t ti ap) q))))
            (r4c-or0 b0))))
      (let-match erased (ridx-fn p pre t (Succ h) rp ri lp le) (Refl _ _))
      (let-match erased (ctat-fn c x0 (CEmpty) pre a0 ae) (Refl _ _))
      (let-match erased l0 (LfE))
      (values (Bit1) (Bit1) y2 (EbSame t) a2 (LfL (CEmpty)) (MbY t _ (InHere t T)) (r4c-or0l (Bit1))))))

(def-fns _ $ (erased r4c-ridx-det : (erased (List (Col)) pre) (erased (Nat) p q) (subterm erased (RIdx pre p) a) (erased (RIdx pre q) b) -> (erased (Eq (Nat) p q) r))
  (let-match erased a (RICons pre1 p1 _ e a1 k1) ((RINil) (let-match erased b (RINil)) (Refl _ p)))
  (let-match erased b (RICons _ p2 _ _ b1 k2))
  (let-match erased (r4c-ridx-det pre1 p1 p2 a1 b1) (Refl _ _))
  (let-match erased (kid-dec p1 p q e e k1 k2) (KcSame _ _) (absurd (KcNe _ _ _ _ ne _) ne))
  (Refl _ p))

(def-fns _ $ (erased r4c-kid-mk : (erased (Nat) p d) (erased (Col) e) (erased (CD d e) cd) -> (erased (Nat) q) (erased (Kid p e q) k))
  (let ((erased q0) (erased tq)) (thrice-exists p))
  (match erased cd (((Nat) q) ((Kid p e q) k))
    ((Cd0) (values q0 (Ki1 p q0 tq))) ((Cd1) (values (Succ q0) (Ki2 p q0 tq))) ((Cd2) (values (Succ (Succ q0)) (Ki3 p q0 tq)))))

(def-fns _ $ (erased r4c-ridx-perm : (erased (Nat) r t) (erased (Perm) g) (erased (RotPm r g) rp) (erased (List (Col)) pre2) (subterm erased (List (Col)) pre) (erased (RIdx pre t) ri)
    (erased (PermT g pre pre2) pt) -> (erased (Nat) t2) (erased (RIdx pre2 t2) r2))
  (let-match erased ri (RICons pre1 p1 _ e ri1 k) ((RINil) (let-match erased pt (PTNil _)) (values (Zero) (RINil))))
  (let-match erased pt (PTCons _ _ e2 _ pre21 pc pt1))
  (let ((erased q1) (erased r1)) (r4c-ridx-perm r p1 g rp pre21 pre1 ri1 pt1))
  (let ((erased d) (erased cd)) (kid-cd p1 t e k))
  (let ((erased d2) (erased cd2))
    (match erased rp (((Nat) d2) ((CD d2 e2) cd2))
      ((RotP1) (match erased pc (((Nat) d2) ((CD d2 e2) cd2)) (absurd (PC0 _) cd) ((PC1 _ _ _) (values (Succ (Zero)) (Cd1))) ((PC2 _ _ _) (values (Succ (Succ (Zero))) (Cd2))) ((PC3 _ _ _) (values (Zero) (Cd0)))))
      ((RotP2) (match erased pc (((Nat) d2) ((CD d2 e2) cd2)) (absurd (PC0 _) cd) ((PC1 _ _ _) (values (Succ (Succ (Zero))) (Cd2))) ((PC2 _ _ _) (values (Zero) (Cd0))) ((PC3 _ _ _) (values (Succ (Zero)) (Cd1)))))))
  (let ((erased q2) (erased k2)) (r4c-kid-mk q1 d2 e2 cd2))
  (values q2 (RICons pre21 q1 q2 e2 r1 k2)))

; The trace ti of pre is the rotation t1 by g of the trace i of pg exactly when the trace of pre rotated back by g2 is i.
(def-fns _ $ (erased r4c-rot-eq : (erased (Perm) g g2) (erased (PermInv g g2) pi) (erased (PermInv g2 g) pi2) (erased (Nat) h ti ia i t1) (erased (Bit) e) (erased (List (Col)) pre pa pg p1)
    (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le) (erased (PermT g2 pre pa) qa) (erased (RIdx pa ia) ra) (erased (Length (Col) pa (Succ h)) la)
    (erased (RIdx pg i) rg) (erased (Length (Col) pg (Succ h)) lg) (erased (PermT g pg p1) q1) (erased (RIdx p1 t1) r1) (erased (Length (Col) p1 (Succ h)) l1)
    (erased (EqB t1 ti e) eq) -> (erased (EqB i ia e) r))
  (match erased eq _
    ((EbSame _)
      (let-match erased (ridx-fn p1 pre t1 (Succ h) r1 ri l1 le) (Refl _ _))
      (let-match erased (permt-fn g2 p1 pg pa (permt-invert g g2 pg p1 pi q1) qa) (Refl _ _))
      (let-match erased (r4c-ridx-det pg i ia rg ra) (Refl _ _))
      (EbSame i))
    ((EbDiff _ _ ap)
      (match erased (nat-eq i ia) _
        ((Unequal _ _ _ _ ap2) (EbDiff i ia ap2))
        (absurd (Equal _ _ _)
          (let-match erased (ridx-fn pg pa i (Succ h) rg ra lg la) (Refl _ _))
          (let-match erased (permt-fn g pg p1 pre q1 (permt-invert g2 g pre pa pi2 qa)) (Refl _ _))
          (let-match erased (r4c-ridx-det pre t1 ti r1 ri) (Refl _ _))
          (apart-irrefl t1 ap))))))

(def-fns _ $ (erased r4c-or-shuffle : (erased (Bit) b0 e1 e2 b1 b2 ma mb m bf ba bb) (erased (BitApply or-op b0 e1 b1) o1) (erased (BitApply or-op b1 e2 b2) o2)
    (erased (BitApply or-op ma mb m) o3) (erased (BitApply or-op b2 m bf) o4) (erased (BitApply or-op e1 ma ba) o5) (erased (BitApply or-op e2 mb bb) o6)
    -> (erased (Bit) bab) (erased (BitApply or-op ba bb bab) r1) (erased (BitApply or-op b0 bab bf) r2))
  (match erased e1 _
    ((Bit1)
      (let-match erased (bitapply-fn or-op b0 (Bit1) b1 (Bit1) o1 (r4c-or1 b0)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit1) e2 b2 (Bit1) o2 (r4c-or1l e2)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit1) m bf (Bit1) o4 (r4c-or1l m)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit1) ma ba (Bit1) o5 (r4c-or1l ma)) (Refl _ _))
      (values (Bit1) (r4c-or1l bb) (r4c-or1 b0)))
    ((Bit0)
      (let-match erased (bitapply-fn or-op b0 (Bit0) b1 b0 o1 (r4c-or0 b0)) (Refl _ _))
      (let-match erased (bitapply-fn or-op (Bit0) ma ba ma o5 (r4c-or0l ma)) (Refl _ _))
      (match erased e2 _
        ((Bit1)
          (let-match erased (bitapply-fn or-op b0 (Bit1) b2 (Bit1) o2 (r4c-or1 b0)) (Refl _ _))
          (let-match erased (bitapply-fn or-op (Bit1) m bf (Bit1) o4 (r4c-or1l m)) (Refl _ _))
          (let-match erased (bitapply-fn or-op (Bit1) mb bb (Bit1) o6 (r4c-or1l mb)) (Refl _ _))
          (values (Bit1) (r4c-or1 ba) (r4c-or1 b0)))
        ((Bit0)
          (let-match erased (bitapply-fn or-op b0 (Bit0) b2 b0 o2 (r4c-or0 b0)) (Refl _ _))
          (let-match erased (bitapply-fn or-op (Bit0) mb bb mb o6 (r4c-or0l mb)) (Refl _ _))
          (values m o3 o4))))))

(def-fns _ $ (erased r4c-gad-le : (erased (Nat) h i n) (erased (List (Copy (Nat))) xs) (erased (Ctree) c c3) (erased (List (Nat)) T T3) (subterm erased (GAd h xs i n c T c3 T3) ga)
    -> (erased (Lt i (Succ n)) r))
  (let-match erased ga (GaC _ _ _ _ _ _ _ _ _ c2 _ _ _ T2 _ _ _ _ _ _ _ _ _ _ _ _ _ g3) ((GaE _ _ _ _ _) (lt-succ n)))
  (lt-succ-left i (Succ n) (r4c-gad-le h (Succ i) n xs c2 c3 T2 T3 g3)))

; Over the gone entries i to n, R, the bit in c and in T of the trace ti of pre is or-ed with whether pre rotated back by 1 (pa, ia) or by 2 (pb, ib) is one of them.
(def-fns _ $ (erased r4c-gad-bit : (erased (Nat) h i n ti ia ib) (erased (List (Copy (Nat))) xs) (erased (Ctree) c c3 x0) (erased (List (Nat)) T T3 R) (erased (List (Col)) pre pa pb)
    (erased (Bit) b0) (subterm erased (GAd h xs i n c T c3 T3) ga) (erased (Fwd xs i n R) fw) (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le)
    (erased (PermT p312 pre pa) qa) (erased (RIdx pa ia) ra) (erased (Length (Col) pa (Succ h)) la) (erased (PermT p231 pre pb) qb) (erased (RIdx pb ib) rb)
    (erased (Length (Col) pb (Succ h)) lb) (erased (CtAt c pre x0) a0) (erased (Lf x0 b0) l0) (erased (MemB ti T b0) m0)
    -> (erased (Ctree) x) (erased (Bit) ba bb bab b) (erased (CtAt c3 pre x) a) (erased (Lf x b) l) (erased (MemB ti T3 b) m) (erased (MemB ia R ba) mba) (erased (MemB ib R bb) mbb)
    (erased (BitApply or-op ba bb bab) o1) (erased (BitApply or-op b0 bab b) o2))
  (match erased ga _
    ((GaE _ _ _ _ _)
      (let-match erased fw (FwE _ _) (absurd (FwC _ _ _ _ R1 _ f1) (lt-irrefl (Succ n) (r4c-fwd-le xs (Succ n) n R1 f1))))
      (values x0 (Bit0) (Bit0) (Bit0) b0 a0 l0 m0 (MbN ia _ (NotInNil ia)) (MbN ib _ (NotInNil ib)) (Ap00 or-op) (r4c-or0 b0)))
    ((GaC _ _ _ _ g t1 t2 _ c1 c2 _ _ T1 T2 _ pg p1 p2 w rg lg q1 r1 a1 q2 r2 a2 g3)
      (let-match erased fw (FwC _ _ _ y R1 wy fw1) (absurd (FwE _ _) (lt-irrefl (Succ i) (r4c-gad-le h (Succ i) i xs c2 c3 T2 T3 g3))))
      (let-match erased (welt-fn xs i y g wy w) (Refl _ _))
      (let ((erased lp1) (erased lp2)) (values (permt-length p231 pg p1 (Succ h) q1 lg) (permt-length p312 pg p2 (Succ h) q2 lg)))
      (let ((erased e1) (erased b1) (erased x1) (erased eq1) (erased ax1) (erased lx1) (erased mx1) (erased o1)) (r4c-cad-bit h t1 ti c c1 x0 T T1 p1 pre b0 a1 r1 lp1 ri le a0 l0 m0))
      (let ((erased e2) (erased b2) (erased x2) (erased eq2) (erased ax2) (erased lx2) (erased mx2) (erased o2)) (r4c-cad-bit h t2 ti c1 c2 x1 T1 T2 p2 pre b1 a2 r2 lp2 ri le ax1 lx1 mx1))
      (let ((erased x) (erased ma) (erased mb) (erased m) (erased bf) (erased ax) (erased lx) (erased mx) (erased mba1) (erased mbb1) (erased o3) (erased o4))
        (r4c-gad-bit h (Succ i) n ti ia ib xs c2 c3 x2 T2 T3 R1 pre pa pb b2 g3 fw1 ri le qa ra la qb rb lb ax2 lx2 mx2))
      (let ((erased eqa)) (r4c-rot-eq p231 p312 (PI231) (PI312) h ti ia g t1 e1 pre pa pg p1 ri le qa ra la rg lg q1 r1 lp1 eq1))
      (let ((erased eqb)) (r4c-rot-eq p312 p231 (PI312) (PI231) h ti ib g t2 e2 pre pb pg p2 ri le qb rb lb rg lg q2 r2 lp2 eq2))
      (let ((erased ba) (erased mba) (erased o5)) (r4c-memb-cons g ia R1 e1 ma eqa mba1))
      (let ((erased bb) (erased mbb) (erased o6)) (r4c-memb-cons g ib R1 e2 mb eqb mbb1))
      (let ((erased bab) (erased s1) (erased s2)) (r4c-or-shuffle b0 e1 e2 b1 b2 ma mb m bf ba bb o1 o2 o3 o4 o5 o6))
      (values x ba bb bab bf ax lx mx mba mbb s1 s2))))

(def-fns _ $ (erased r4c-mem-dec : (erased (Nat) x) (subterm erased (List (Nat)) R) -> (erased (Bit) b) (erased (MemB x R b) m))
  (let-match erased R (Cons _ y R1) ((Nil _) (values (Bit0) (MbN x R (NotInNil x)))))
  (let-match erased (nat-eq x y) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values (Bit1) (MbY x R (InHere x R1)))))
  (let ((erased b) (erased m)) (r4c-mem-dec x R1))
  (values b (match erased m (((MemB x R b) r)) ((MbY _ _ p) (MbY x R (InThere x y R1 p))) ((MbN _ _ o) (MbN x R (NotInCons x y R1 ap o))))))

(def-fns _ $ (erased r4c-fwd-at : (erased (List (Copy (Nat))) xs) (erased (Nat) i n y) (erased (List (Nat)) R) (subterm erased (Fwd xs i n R) f) (erased (In y R) p)
    -> (erased (Nat) j) (erased (WElt xs j y) w) (erased (Lt j n) l))
  (let-match erased f (FwC _ _ _ x R1 wx f1) (absurd (FwE _ _) p))
  (let ((erased il)) (lt-pred i n (r4c-fwd-le xs (Succ i) n R1 f1)))
  (let-match erased p (InThere _ _ _ p1) ((InHere _ _) (values i wx il)))
  (r4c-fwd-at xs (Succ i) n y R1 f1 p1))

; Bits read over the gone entries are those over the gone buffer.
(def-fns _ $ (erased r4c-memb-conv : (erased (List (Copy (Nat))) xs) (erased (Nat) n x) (erased (List (Nat)) R G) (erased (Bit) b) (erased (MemB x R b) m) (erased (Fwd xs (Zero) n R) fw)
    (erased (Tbk xs n G) tb) -> (erased (MemB x G b) r))
  (match erased m _
    ((MbY _ _ p) (let ((erased j) (erased w) (erased l)) (r4c-fwd-at xs (Zero) n x R fw p)) (MbY x G (r4c-tbk-at xs n j x G tb w l)))
    ((MbN _ _ o)
      (let ((erased b2) (erased m2)) (r4c-mem-dec x G))
      (let-match erased m2 (MbN _ _ _)
        (absurd (MbY _ _ p)
          (let ((erased j) (erased w) (erased l)) (r4c-tbk-in xs n x G tb p))
          (apart-irrefl x (notin-in x x R o (r4c-fwd-in xs (Zero) n j x R fw w (LtZ j) l)))))
      m2)))

(def-fns _ $ (erased r4c-ctat-e : (subterm erased (List (Col)) pre) -> (erased (CtAt (CEmpty) pre (CEmpty)) a))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (AtNil (CEmpty))))
  (AtCons (CEmpty) (CEmpty) (CEmpty) pre1 e (r4c-ctat-e pre1) (SelE e)))

(def-fns _ $ (erased r4c-ctat-h : (erased (Nat) k d j) (erased (Ctree) top t) (subterm erased (List (Col)) pre) (erased (CtH k top) hk) (erased (CtAt top pre t) a)
    (erased (Length (Col) pre d) le) (erased (Add d j k) ad) -> (erased (CtH j t) r))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (let-match erased a (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) hk))
  (let-match erased a (AtCons _ u _ _ _ a1 s))
  (let-match erased le (LengthCons _ _ _ d1 le1))
  (let-match erased ad (AddSucc _ _ k1 ad1))
  (let ((erased hu)) (r4c-ctat-h k d1 (Succ j) top u pre1 hk a1 le1 (add-succ-right d1 j k1 ad1)))
  (match erased s _
    ((SelN0 _ _ _) (HE j)) ((SelN1 w1 w2 w3) (sel-h j w1 w2 w3 t e hu s)) ((SelN2 w1 w2 w3) (sel-h j w1 w2 w3 t e hu s)) ((SelN3 w1 w2 w3) (sel-h j w1 w2 w3 t e hu s))
    (absurd (SelL _ _) hu) ((SelE _) (HE j))))

(def-fns _ $ (erased r4c-gonet-get : (erased (List (Nat)) T) (erased (Ctree) gone) (erased (Nat) j p i) (erased (List (Col)) pre w) (subterm erased (GoneT T gone j p pre) gt)
    (erased (TIdx p w i) ti) (erased (Length (Col) w j) lw) -> (erased (Nat) g) (erased (List (Col)) et) (erased (RevApp (Col) pre w et) ra) (erased (CtSub gone et g) s) (erased (TIn g T i) tn))
  (match erased gt _
    ((GtL _ _ _ g _ et ra s tn) (let-match erased lw (LengthNil _)) (let-match erased ti (TINil _)) (values g et ra s tn))
    ((GtN _ _ j1 _ q _ tq a1 a2 a3)
      (let-match erased lw (LengthCons _ e w1 _ lw1))
      (let-match erased ti (TICons _ c _ _ _ k ti1))
      (let ((erased g) (erased et) (erased ra) (erased s) (erased tn))
        (match erased k (((Nat) g) ((List (Col)) et) ((RevApp (Col) (Cons (Col) e pre) w1 et) ra) ((CtSub gone et g) s) ((TIn g T i) tn))
          ((Ki1 _ q1 t1) (let-match erased (thrice-fn p q q1 tq t1) (Refl _ _)) (r4c-gonet-get T gone j1 c i (Cons _ (C1) pre) w1 a1 ti1 lw1))
          ((Ki2 _ q1 t1) (let-match erased (thrice-fn p q q1 tq t1) (Refl _ _)) (r4c-gonet-get T gone j1 c i (Cons _ (C2) pre) w1 a2 ti1 lw1))
          ((Ki3 _ q1 t1) (let-match erased (thrice-fn p q q1 tq t1) (Refl _ _)) (r4c-gonet-get T gone j1 c i (Cons _ (C3) pre) w1 a3 ti1 lw1))))
      (let-match erased ra (RACons _ _ _ _ _ ra1))
      (values g et ra1 s tn))))

; The trace ia of gone, of the colours pa: its bit, whether ia is in G.
(def-fns _ $ (erased r4c-gone-bit : (erased (List (Nat)) G) (erased (Ctree) gone) (erased (Nat) h ia) (erased (List (Col)) pa) (erased (GoneT G gone (Succ h) (Zero) (Nil (Col))) gt)
    (erased (CtH (Succ h) gone) hg) (erased (RIdx pa ia) ra) (erased (Length (Col) pa (Succ h)) la) -> (erased (Ctree) z) (erased (Bit) v) (erased (CtAt gone pa z) az) (erased (Lf z v) lz)
    (erased (MemB ia G v) m))
  (let ((erased et) (erased re)) (revapp-exists _ pa (Nil _)))
  (let ((erased ti)) (ridx-tidx pa (Nil _) et ia ia ra re (TINil ia)))
  (let ((erased le)) (rev-len pa (Nil _) et (Succ h) (Zero) (Succ h) re la (LengthNil _) (add-zero-right (Succ h))))
  (let ((erased g) (erased et2) (erased re2) (erased s) (erased tn)) (r4c-gonet-get G gone (Succ h) (Zero) ia (Nil _) et gt ti le))
  (let-match erased re2 (RANil _ _))
  (let ((erased z) (erased az)) (ctat-exists gone pa))
  (let ((erased n) (erased rz)) (root-exists z))
  (let-match erased (sub-fn gone et n g (at-sub gone z pa (Nil _) et n az re (SubNil z n rz)) s) (Refl _ _))
  (let ((erased hz)) (r4c-ctat-h (Succ h) (Succ h) (Zero) gone z pa hg az la (add-zero-right (Succ h))))
  (match erased tn _
    ((TiOut _ _ o) (let-match erased hz (HE _) (absurd (HL _ _) rz)) (values z (Bit0) az (LfE) (MbN ia G o)))
    ((TiIn _ _ _ p) (let-match erased hz (HL lf _) (absurd (HE _) rz)) (values z (Bit1) az (LfL lf) (MbY ia G p)))))

(def-fns _ $ (erased r4c-perm-sel : (erased (Perm) g) (erased (Ctree) v u x y) (erased (Col) e e2) (erased (CtPerm g v u) p) (erased (CtSel u e x) sx) (erased (PermC g e e2) pc)
    (erased (CtSel v e2 y) sy) -> (erased (CtPerm g y x) r))
  (match erased p _
    ((CPE _) (let-match erased sx (SelE _)) (let-match erased sy (SelE _)) (CPE g))
    ((CPL _ _) (let-match erased sx (SelL _ _)) (let-match erased sy (SelL _ _)) (CPE g))
    ((CPN g1 g2 g3 t1 t2 t3 u1 u2 u3 a1 a2 a3 _ s1 s2 s3 p1 p2 p3 c)
      (let ((erased sx2)) (cons-sel a1 a2 a3 u x e c sx))
      (match erased pc _
        ((PC0 _) (let-match erased sx2 (SelN0 _ _ _)) (let-match erased sy (SelN0 _ _ _)) (CPE g))
        ((PC1 _ _ _) (let-match erased sx2 (SelN1 _ _ _)) (let-match erased (sel-fn v y u1 e2 sy s1) (Refl _ _)) p1)
        ((PC2 _ _ _) (let-match erased sx2 (SelN2 _ _ _)) (let-match erased (sel-fn v y u2 e2 sy s2) (Refl _ _)) p2)
        ((PC3 _ _ _) (let-match erased sx2 (SelN3 _ _ _)) (let-match erased (sel-fn v y u3 e2 sy s3) (Refl _ _)) p3)))))

; The subtree of tp at pre, and that of t at pre moved by g.
(def-fns _ $ (erased r4c-perm-at : (erased (Perm) g) (erased (Ctree) t tp x y) (subterm erased (List (Col)) pre) (erased (List (Col)) pre2) (erased (CtPerm g t tp) p)
    (erased (CtAt tp pre x) ax) (erased (PermT g pre pre2) pt) (erased (CtAt t pre2 y) ay) -> (erased (CtPerm g y x) r))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (let-match erased ax (AtNil _)) (let-match erased pt (PTNil _)) (let-match erased ay (AtNil _)) p))
  (let-match erased ax (AtCons _ u _ _ _ ax1 sx))
  (let-match erased pt (PTCons _ _ e2 _ pre21 pc pt1))
  (let-match erased ay (AtCons _ v _ _ _ ay1 sy))
  (r4c-perm-sel g v u x y e e2 (r4c-perm-at g t tp u v pre1 pre21 p ax1 pt1 ay1) sx pc sy))

(def-fns _ $ (erased r4c-or-sel : (erased (Ctree) ua ub u xa xb x) (erased (Col) e) (erased (CtOr ua ub u) o) (erased (CtSel ua e xa) sa) (erased (CtSel ub e xb) sb)
    (erased (CtSel u e x) s) -> (erased (CtOr xa xb x) r))
  (match erased o _
    ((OrEL _) (let-match erased sa (SelE _)) (let-match erased (sel-fn ub xb x e sb s) (Refl _ _)) (OrEL x))
    ((OrER _) (let-match erased sb (SelE _)) (let-match erased (sel-fn ua xa x e sa s) (Refl _ _)) (OrER x))
    ((OrLL _ _) (let-match erased sa (SelL _ _)) (let-match erased sb (SelL _ _)) (let-match erased s (SelL _ _)) (OrEL (CEmpty)))
    ((OrNN l1 l2 l3 r1 r2 r3 u1 u2 u3 _ o1 o2 o3 c)
      (let ((erased s2)) (cons-sel u1 u2 u3 u x e c s))
      (match erased sa _
        ((SelN0 _ _ _) (let-match erased s2 (SelN0 _ _ _)) (let-match erased sb (SelN0 _ _ _)) (OrEL (CEmpty)))
        ((SelN1 _ _ _) (let-match erased s2 (SelN1 _ _ _)) (let-match erased sb (SelN1 _ _ _)) o1)
        ((SelN2 _ _ _) (let-match erased s2 (SelN2 _ _ _)) (let-match erased sb (SelN2 _ _ _)) o2)
        ((SelN3 _ _ _) (let-match erased s2 (SelN3 _ _ _)) (let-match erased sb (SelN3 _ _ _)) o3)))))

(def-fns _ $ (erased r4c-or-atp : (erased (Ctree) a b t xa xb x) (subterm erased (List (Col)) pre) (erased (CtOr a b t) o) (erased (CtAt a pre xa) aa) (erased (CtAt b pre xb) ab)
    (erased (CtAt t pre x) az) -> (erased (CtOr xa xb x) r))
  (let-match erased pre (Cons _ e pre1) ((Nil _) (let-match erased aa (AtNil _)) (let-match erased ab (AtNil _)) (let-match erased az (AtNil _)) o))
  (let-match erased aa (AtCons _ ua _ _ _ aa1 sa))
  (let-match erased ab (AtCons _ ub _ _ _ ab1 sb))
  (let-match erased az (AtCons _ u _ _ _ az1 s))
  (r4c-or-sel ua ub u xa xb x e (r4c-or-atp a b t ua ub u pre1 o aa1 ab1 az1) sa sb s))

(def-fns _ $ (erased r4c-perm-lf : (erased (Perm) g) (erased (Ctree) y x) (erased (Bit) v) (erased (CtPerm g y x) p) (erased (Lf y v) l) -> (erased (Lf x v) r))
  (match erased l _ ((LfE) (let-match erased p (CPE _)) (LfE)) ((LfL lf) (let-match erased p (CPL _ _)) (LfL lf))))

(def-fns _ $ (erased r4c-or-lf : (erased (Ctree) xa xb x) (erased (Bit) va vb) (erased (CtOr xa xb x) o) (erased (Lf xa va) la) (erased (Lf xb vb) lb)
    -> (erased (Bit) v) (erased (Lf x v) l) (erased (BitApply or-op va vb v) ap))
  (match erased o _
    ((OrEL _) (let-match erased la (LfE)) (values vb lb (r4c-or0l vb)))
    ((OrER _) (let-match erased lb (LfE)) (values va la (r4c-or0 va)))
    ((OrLL _ _) (let-match erased la (LfL _)) (let-match erased lb (LfL _)) (values (Bit1) (LfL (CEmpty)) (r4c-or1 (Bit1))))
    (absurd (OrNN _ _ _ _ _ _ _ _ _ _ _ _ _ _) la)))

(def-fns _ $ (erased r4c-perm-c : (erased (Perm) g) (subterm erased (Nat) j) (erased (Ctree) t) (erased (CtCanon j t) c) -> (erased (Ctree) tp) (erased (CtPerm g t tp) p)
    (erased (CtCanon j tp) ct))
  (match erased c _
    ((CanL _ k) (match erased k _ ((HE _) (values t (CPE g) c)) ((HL lf _) (values t (CPL g lf) c))))
    ((CanN j1 t1 t2 t3 _ c1 c2 c3 cn)
      (let-match erased cn (CnN _ _ _ _) ((CnE) (values t (CPE g) c)))
      (let-match erased g (MkPerm g1 g2 g3))
      (let ((erased u1) (erased s1)) (sel-node t1 t2 t3 g1))
      (let ((erased u2) (erased s2)) (sel-node t1 t2 t3 g2))
      (let ((erased u3) (erased s3)) (sel-node t1 t2 t3 g3))
      (let ((erased a1) (erased p1) (erased k1)) (r4c-perm-c g j1 u1 (canon-sel j1 t1 t2 t3 u1 g1 c1 c2 c3 s1)))
      (let ((erased a2) (erased p2) (erased k2)) (r4c-perm-c g j1 u2 (canon-sel j1 t1 t2 t3 u2 g2 c1 c2 c3 s2)))
      (let ((erased a3) (erased p3) (erased k3)) (r4c-perm-c g j1 u3 (canon-sel j1 t1 t2 t3 u3 g3 c1 c2 c3 s3)))
      (let ((erased tp) (erased cn2)) (cn-c a1 a2 a3))
      (values tp (CPN g1 g2 g3 t1 t2 t3 u1 u2 u3 a1 a2 a3 tp s1 s2 s3 p1 p2 p3 (cn-cons a1 a2 a3 tp cn2)) (CanN j1 a1 a2 a3 tp k1 k2 k3 cn2)))))

(def-fns _ $ (erased r4c-or-c : (subterm erased (Nat) j) (erased (Ctree) a b) (erased (CtCanon j a) ca) (erased (CtCanon j b) cb) -> (erased (Ctree) t) (erased (CtOr a b t) o)
    (erased (CtCanon j t) ct))
  (let-match erased a (CNode a1 a2 a3)
    ((CEmpty) (values b (OrEL b) cb))
    ((CLeaf la)
      (let-match erased b (CLeaf lb) ((CEmpty) (values a (OrER a) ca)) (absurd (CNode _ _ _) (let-match erased ca (CanL _ k) (absurd (CanN _ _ _ _ _ _ _ _ cn) cn)) (let-match erased cb (CanL _ k2)) k2))
      (let-match erased ca (CanL _ _) (absurd (CanN _ _ _ _ _ _ _ _ cn) cn))
      (values (CLeaf (CEmpty)) (OrLL la lb) (CanL _ (HL (CEmpty) (HE (Zero)))))))
  (let-match erased b (CNode b1 b2 b3) ((CEmpty) (values a (OrER a) ca)) (absurd (CLeaf _) (let-match erased cb (CanL _ k) (absurd (CanN _ _ _ _ _ _ _ _ cn) cn)) (let-match erased ca (CanL _ k2)) k2))
  (let-match erased ca (CanN j1 _ _ _ _ k1 k2 k3 cna) (absurd (CanL _ k) k))
  (let-match erased cna (CnN _ _ _ _))
  (let-match erased cb (CanN _ _ _ _ _ m1 m2 m3 cnb))
  (let-match erased cnb (CnN _ _ _ _))
  (let ((erased u1) (erased o1) (erased n1)) (r4c-or-c j1 a1 b1 k1 m1))
  (let ((erased u2) (erased o2) (erased n2)) (r4c-or-c j1 a2 b2 k2 m2))
  (let ((erased u3) (erased o3) (erased n3)) (r4c-or-c j1 a3 b3 k3 m3))
  (let ((erased t) (erased cn)) (cn-c u1 u2 u3))
  (values t (OrNN a1 a2 a3 b1 b2 b3 u1 u2 u3 t o1 o2 o3 (cn-cons u1 u2 u3 t cn)) (CanN j1 u1 u2 u3 t n1 n2 n3 cn)))

; red4's ctree_iter cadd over y, the subtree of ctr at the colours pre (last first) of the prefix p: the trie tree c and celems T become c2 and T2.
(def-adts $ (LW : ((Nat) h) ((Ctree) ctr y) ((List (Col)) pre) ((Nat) p) ((Ctree) c) ((List (Nat)) T) ((Ctree) c2) ((List (Nat)) T2) -> Type)
  enum
  (many LwE : (erased (Nat) h) (erased (Ctree) ctr) (erased (List (Col)) pre) (erased (Nat) p) (erased (Ctree) c) (erased (List (Nat)) T) -> (LW h ctr (CEmpty) pre p c T c T))
  (many LwL : (erased (Nat) h) (erased (Ctree) ctr lf) (erased (List (Col)) pre) (erased (Nat) p) (erased (Ctree) c c2) (erased (List (Nat)) T T2) (erased (RIdx pre p) ri)
      (erased (Length (Col) pre (Succ h)) le) (erased (CtAt ctr pre (CLeaf lf)) a) (erased (CAd c T p pre c2 T2) ad) -> (LW h ctr (CLeaf lf) pre p c T c2 T2))
  (many LwN : (erased (Nat) h) (erased (Ctree) ctr y1 y2 y3) (erased (List (Col)) pre) (erased (Nat) p q) (erased (Thrice p q) tq) (erased (Ctree) c c1 c2 c3)
      (erased (List (Nat)) T T1 T2 T3) (erased (LW h ctr y1 (Cons (Col) (C1) pre) q c T c1 T1) w1) (erased (LW h ctr y2 (Cons (Col) (C2) pre) (Succ q) c1 T1 c2 T2) w2)
      (erased (LW h ctr y3 (Cons (Col) (C3) pre) (Succ (Succ q)) c2 T2 c3 T3) w3) -> (LW h ctr (CNode y1 y2 y3) pre p c T c3 T3)))

; Over the walk, the trace ti's bit in c stays its bit in T.
(def-fns _ $ (erased r4c-lw-bit : (erased (Nat) h p ti) (erased (Ctree) ctr y c c2 x0) (erased (List (Nat)) T T2) (erased (List (Col)) pre tp) (erased (Bit) b0)
    (subterm erased (LW h ctr y pre p c T c2 T2) w) (erased (RIdx tp ti) ri) (erased (Length (Col) tp (Succ h)) le) (erased (CtAt c tp x0) a0) (erased (Lf x0 b0) l0)
    (erased (MemB ti T b0) m0) -> (erased (Bit) b) (erased (Ctree) x) (erased (CtAt c2 tp x) a) (erased (Lf x b) l) (erased (MemB ti T2 b) m))
  (match erased w _
    ((LwE _ _ _ _ _ _) (values b0 x0 a0 l0 m0))
    ((LwL _ _ _ _ _ _ _ _ _ rp lp _ ad)
      (let ((erased _) (erased b) (erased x) (erased _) (erased a) (erased l) (erased m) (erased _)) (r4c-cad-bit h p ti c c2 x0 T T2 pre tp b0 ad rp lp ri le a0 l0 m0))
      (values b x a l m))
    ((LwN _ _ y1 y2 y3 _ _ q _ _ c1 cb _ _ T1 Tb _ w1 w2 w3)
      (let ((erased b1) (erased x1) (erased a1) (erased l1) (erased m1)) (r4c-lw-bit h q ti ctr y1 c c1 x0 T T1 (Cons _ (C1) pre) tp b0 w1 ri le a0 l0 m0))
      (let ((erased b2) (erased x2) (erased a2) (erased l2) (erased m2)) (r4c-lw-bit h (Succ q) ti ctr y2 c1 cb x1 T1 Tb (Cons _ (C2) pre) tp b1 w2 ri le a1 l1 m1))
      (r4c-lw-bit h (Succ (Succ q)) ti ctr y3 cb c2 x2 Tb T2 (Cons _ (C3) pre) tp b2 w3 ri le a2 l2 m2))))

; The node at the colours pre of top, whose traces from the prefix 0 are as MI says, is as MI says from its own prefix n.
(def-fns _ $ (erased r4c-mi-node : (erased (List (Nat)) R) (erased (Nat) j n d D) (erased (Ctree) top t) (subterm erased (List (Col)) pre)
    (erased (MI R D (Zero) top) m) (erased (RIdx pre n) ri) (erased (CtAt top pre t) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad) -> (erased (MI R j n t) r))
  (match erased pre _
    ((Nil _) (let-match erased ri (RINil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) m)
    ((Cons _ e pre1)
      (let-match erased ri (RICons _ n1 _ _ ri1 k))
      (let-match erased pt (AtCons _ u _ _ _ at1 s))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Dq ad1))
      (r4c-mi-down R j n1 n u t e (r4c-mi-node R (Succ j) n1 d1 D top u pre1 m ri1 at1 le1 (add-succ-right d1 j Dq ad1)) k s))))

(def-fns _ $ (erased r4c-mi-leaf : (erased (List (Nat)) R) (erased (Nat) h ti) (erased (Ctree) top u) (erased (List (Col)) tp) (erased (MI R h (Zero) top) m) (erased (RIdx tp ti) ri)
    (erased (Length (Col) tp (Succ h)) le) (erased (CtAt top tp u) a) -> (erased (MI1 R ti u) r))
  (let-match erased le (LengthCons _ e pre _ le1))
  (let-match erased ri (RICons _ n _ _ ri1 k))
  (let-match erased a (AtCons _ v _ _ _ a1 s))
  (let-match erased (r4c-mi-node R (Zero) n h h top v pre m ri1 a1 le1 (add-zero-right h)) (MiL _ _ qp _ t1 t2 t3 tq s1 s2 s3 m1 m2 m3))
  (match erased k _
    ((Ki1 _ _ tk) (let-match erased (thrice-fn n qp ti tq tk) (Refl _ _)) (let-match erased (sel-fn v u t1 e s s1) (Refl _ _)) m1)
    ((Ki2 _ c0 tk) (let-match erased (thrice-fn n qp c0 tq tk) (Refl _ _)) (let-match erased (sel-fn v u t2 e s s2) (Refl _ _)) m2)
    ((Ki3 _ c0 tk) (let-match erased (thrice-fn n qp c0 tq tk) (Refl _ _)) (let-match erased (sel-fn v u t3 e s s3) (Refl _ _)) m3)))

; The trie tree c2 and celems T2 that red4's gone loop built over the gone buffer G from nothing, and ctr, the union of gone's two rotations; or that
; red4's ctree_iter cadd built over ctr from nothing.
(def-adts $ (GCtx : ((Nat) h) ((Ctree) c2) ((Ctree) ctr) ((List (Nat)) T2) -> Type)
  enum
  (many MkGCtx : (erased (Nat) h n) (erased (List (Copy (Nat))) xs) (erased (Ctree) c2 gone a b ctr) (erased (List (Nat)) T2 R G)
      (erased (GAd h xs (Zero) n (CEmpty) (Nil (Nat)) c2 T2) ga) (erased (Fwd xs (Zero) n R) fw) (erased (Tbk xs n G) tb) (erased (GoneT G gone (Succ h) (Zero) (Nil (Col))) gt)
      (erased (CtH (Succ h) gone) hg) (erased (CtPerm p312 gone a) pa) (erased (CtPerm p231 gone b) pb) (erased (CtOr a b ctr) o) -> (GCtx h c2 ctr T2))
  (many GcLoad : (erased (Nat) h) (erased (Ctree) c2 ctr) (erased (List (Nat)) T2) (erased (LW h ctr ctr (Nil (Col)) (Zero) (CEmpty) (Nil (Nat)) c2 T2) w)
      (erased (AMc h ctr T2) am) (erased (MI T2 h (Zero) ctr) mi) (erased (CtH (Succ h) ctr) hc) -> (GCtx h c2 ctr T2)))

; The trace ti, of the colours pre, has one bit in c2, in ctr and in T2.
(def-fns _ $ (erased r4c-pt-bit : (erased (Nat) h ti) (erased (Ctree) c2 ctr) (erased (List (Nat)) T2) (erased (List (Col)) pre) (erased (GCtx h c2 ctr T2) rc)
    (erased (RIdx pre ti) ri) (erased (Length (Col) pre (Succ h)) le)
    -> (erased (Ctree) x y) (erased (Bit) v) (erased (CtAt c2 pre x) ax) (erased (CtAt ctr pre y) ay) (erased (Lf x v) lx) (erased (Lf y v) ly) (erased (MemB ti T2 v) m))
  (let-match erased rc (MkGCtx _ n xs _ gone a b _ _ R G ga fw tb gt hg pa pb o)
    ((GcLoad _ _ _ _ w am mi hc)
      (let ((erased v) (erased x) (erased ax) (erased lx) (erased mx))
        (r4c-lw-bit h (Zero) ti ctr ctr (CEmpty) c2 (CEmpty) (Nil _) T2 (Nil _) pre (Bit0) w ri le (r4c-ctat-e pre) (LfE) (MbN ti (Nil _) (NotInNil ti))))
      (let ((erased y) (erased ay)) (ctat-exists ctr pre))
      (let ((erased hy)) (r4c-ctat-h (Succ h) (Succ h) (Zero) ctr y pre hc ay le (add-zero-right (Succ h))))
      (let ((erased ly))
        (match erased mx (((Lf y v) r))
          ((MbY _ _ i)
            (let ((erased pre2) (erased lf) (erased ri2) (erased le2) (erased a2)) (r4c-am-in h ti ctr T2 am i))
            (let-match erased (ridx-fn pre2 pre ti (Succ h) ri2 ri le2 le) (Refl _ _))
            (let-match erased (ctat-fn ctr y (CLeaf lf) pre ay a2) (Refl _ _))
            (LfL lf))
          ((MbN _ _ o)
            (match erased hy (((Lf y v) r))
              ((HE _) (LfE))
              (absurd (HL lf _) (match erased (r4c-mi-leaf T2 h ti ctr y pre mi ri le ay) _ (absurd (Mi1In _ _ _ i) (apart-irrefl ti (notin-in ti ti T2 o i)))))))))
      (values x y v ax ay lx ly mx)))
  (let ((erased la) (erased qa)) (permt-ex p312 pre (IP312)))
  (let ((erased lb) (erased qb)) (permt-ex p231 pre (IP231)))
  (let ((erased ia) (erased ra)) (r4c-ridx-perm (Succ (Succ (Zero))) ti p312 (RotP2) la pre ri qa))
  (let ((erased ib) (erased rb)) (r4c-ridx-perm (Succ (Zero)) ti p231 (RotP1) lb pre ri qb))
  (let ((erased lla) (erased llb)) (values (permt-length p312 pre la (Succ h) qa le) (permt-length p231 pre lb (Succ h) qb le)))
  (let ((erased x) (erased ba) (erased bb) (erased bab) (erased bx) (erased ax) (erased lx) (erased mx) (erased mba) (erased mbb) (erased o1) (erased o2))
    (r4c-gad-bit h (Zero) n ti ia ib xs (CEmpty) c2 (CEmpty) (Nil _) T2 R pre la lb (Bit0) ga fw ri le qa ra lla qb rb llb (r4c-ctat-e pre) (LfE) (MbN ti _ (NotInNil ti))))
  (let-match erased (bitapply-fn or-op (Bit0) bab bx bab o2 (r4c-or0l bab)) (Refl _ _))
  (let ((erased za) (erased va) (erased aza) (erased lza) (erased mva)) (r4c-gone-bit G gone h ia la gt hg ra lla))
  (let ((erased zb) (erased vb) (erased azb) (erased lzb) (erased mvb)) (r4c-gone-bit G gone h ib lb gt hg rb llb))
  (let-match erased (r4c-memb-fn ia G ba va (r4c-memb-conv xs n ia R G ba mba fw tb) mva) (Refl _ _))
  (let-match erased (r4c-memb-fn ib G bb vb (r4c-memb-conv xs n ib R G bb mbb fw tb) mvb) (Refl _ _))
  (let ((erased xa) (erased axa)) (ctat-exists a pre))
  (let ((erased xb) (erased axb)) (ctat-exists b pre))
  (let ((erased y) (erased ay)) (ctat-exists ctr pre))
  (let ((erased lxa)) (r4c-perm-lf p312 za xa ba (r4c-perm-at p312 gone a xa za pre la pa axa qa aza) lza))
  (let ((erased lxb)) (r4c-perm-lf p231 zb xb bb (r4c-perm-at p231 gone b xb zb pre lb pb axb qb azb) lzb))
  (let ((erased v) (erased ly) (erased ov)) (r4c-or-lf xa xb y ba bb (r4c-or-atp a b ctr xa xb y pre o axa axb ay) lxa lxb))
  (let-match erased (bitapply-fn or-op ba bb v bab ov o1) (Refl _ _))
  (values x y bab ax ay lx ly mx))

; t and u hold the same traces, whatever their leaves hold.
(def-adts $ (SameSet : ((Ctree) t) ((Ctree) u) -> Type)
  enum
  (many SsE : -> (SameSet (CEmpty) (CEmpty)))
  (many SsL : (erased (Ctree) a b) -> (SameSet (CLeaf a) (CLeaf b)))
  (many SsN : (erased (Ctree) t1 t2 t3 u1 u2 u3) (erased (SameSet t1 u1) s1) (erased (SameSet t2 u2) s2) (erased (SameSet t3 u3) s3)
      -> (SameSet (CNode t1 t2 t3) (CNode u1 u2 u3))))

(def-fns _ $ (erased r4c-ss-lf : (erased (Ctree) x y) (erased (Bit) v) (erased (Lf x v) lx) (erased (Lf y v) ly) -> (erased (SameSet x y) s))
  (match erased lx _ ((LfE) (let-match erased ly (LfE)) (SsE)) ((LfL a) (let-match erased ly (LfL b)) (SsL a b))))

(def-fns _ $ (erased r4c-lf-ss : (erased (Ctree) t u) (erased (Bit) v) (erased (Lf t v) l) (erased (SameSet t u) s) -> (erased (Lf u v) r))
  (match erased l _ ((LfE) (let-match erased s (SsE)) (LfE)) ((LfL _) (let-match erased s (SsL _ b)) (LfL b))))

(def-fns _ $ (erased r4c-occ-ss : (erased (Ctree) t u) (erased (Occ t) o) (erased (SameSet t u) s) -> (erased (Occ u) r))
  (match erased o _ ((OccN _ _ _) (let-match erased s (SsN _ _ _ u1 u2 u3 _ _ _)) (OccN u1 u2 u3)) ((OccL _) (let-match erased s (SsL _ b)) (OccL b))))

(def-fns _ $ (erased r4c-occ3-ss : (erased (Ctree) t1 t2 t3 u1 u2 u3) (erased (Occ3 t1 t2 t3) o) (erased (SameSet t1 u1) s1) (erased (SameSet t2 u2) s2) (erased (SameSet t3 u3) s3)
    -> (erased (Occ3 u1 u2 u3) r))
  (match erased o _
    ((Occ1 _ _ _ v) (Occ1 u1 u2 u3 (r4c-occ-ss t1 u1 v s1))) ((Occ2 _ _ _ v) (Occ2 u1 u2 u3 (r4c-occ-ss t2 u2 v s2))) ((Occ3c _ _ _ v) (Occ3c u1 u2 u3 (r4c-occ-ss t3 u3 v s3)))))

(def-fns _ $ (erased r4c-ss-up : (erased (Ctree) x1 x2 x3 x y1 y2 y3 y) (erased (Cn x1 x2 x3 x) cx) (erased (Cn y1 y2 y3 y) cy) (erased (SameSet x1 y1) s1) (erased (SameSet x2 y2) s2)
    (erased (SameSet x3 y3) s3) -> (erased (SameSet x y) r))
  (match erased cx _
    ((CnE)
      (let-match erased s1 (SsE))
      (let-match erased s2 (SsE))
      (let-match erased s3 (SsE))
      (let-match erased cy (CnE) (absurd (CnN _ _ _ o) (occ3-empty o)))
      (SsE))
    ((CnN _ _ _ o)
      (let-match erased cy (CnN _ _ _ _) (absurd (CnE) (occ3-empty (r4c-occ3-ss x1 x2 x3 (CEmpty) (CEmpty) (CEmpty) o s1 s2 s3))))
      (SsN x1 x2 x3 y1 y2 y3 s1 s2 s3))))

(def-fns _ $ (erased r4c-ca-cn : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) x) (erased (Ca us j n x) f) -> (erased (Ctree) x1 x2 x3) (erased (Cn x1 x2 x3 x) cn)
    (erased (CtSel x (C1) x1) s1) (erased (CtSel x (C2) x2) s2) (erased (CtSel x (C3) x3) s3))
  (let-match erased f (CaE _ _ _ _)
    ((CaL _ _ _ t1 t2 t3 _ _ o) (values t1 t2 t3 (CnN t1 t2 t3 o) (SelN1 t1 t2 t3) (SelN2 t1 t2 t3) (SelN3 t1 t2 t3)))
    ((CaN _ _ _ _ t1 t2 t3 _ _ _ _ _ o) (values t1 t2 t3 (CnN t1 t2 t3 o) (SelN1 t1 t2 t3) (SelN2 t1 t2 t3) (SelN3 t1 t2 t3))))
  (let ((erased E)) (CEmpty))
  (values E E E (CnE) (SelE (C1)) (SelE (C2)) (SelE (C3))))

(def-fns _ $ (erased r4c-ss-leaf : (erased (Nat) h p q) (erased (Ctree) c2 ctr x y xi yi) (erased (List (Nat)) T2) (erased (Col) e) (erased (List (Col)) pre) (erased (GCtx h c2 ctr T2) rc)
    (erased (Kid p e q) k) (erased (RIdx pre p) ri) (erased (Length (Col) pre h) le) (erased (CtAt c2 pre x) ax) (erased (CtAt ctr pre y) ay) (erased (CtSel x e xi) sx)
    (erased (CtSel y e yi) sy) -> (erased (SameSet xi yi) s) (erased (MI1 T2 q xi) m))
  (let ((erased x2) (erased y2) (erased v) (erased ax2) (erased ay2) (erased lx) (erased ly) (erased mb))
    (r4c-pt-bit h q c2 ctr T2 (Cons _ e pre) rc (RICons pre p q e ri k) (LengthCons _ e pre h le)))
  (let-match erased (ctat-fn c2 xi x2 (Cons _ e pre) (AtCons c2 x xi pre e ax sx) ax2) (Refl _ _))
  (let-match erased (ctat-fn ctr yi y2 (Cons _ e pre) (AtCons ctr y yi pre e ay sy) ay2) (Refl _ _))
  (values (r4c-ss-lf xi yi v lx ly) (match erased lx (((MI1 T2 q xi) m)) ((LfE) (Mi1E T2 q)) ((LfL _) (let-match erased mb (MbY _ _ i)) (Mi1In T2 q xi i)))))

(def-fns _ $ (erased r4c-ss-bld : (erased (Nat) h p d m) (erased (Ctree) c2 ctr x y) (erased (List (Nat)) T2) (erased (List (U8)) us) (erased (List (Col)) pre) (subterm erased (Nat) j)
    (erased (GCtx h c2 ctr T2) rc) (erased (RIdx pre p) ri) (erased (Length (Col) pre d) le) (erased (Add d j h) ad) (erased (Ca us j m x) f) (erased (CtAt c2 pre x) ax)
    (erased (CtAt ctr pre y) ay) (erased (CtCanon (Succ j) y) cy) -> (erased (SameSet x y) s) (erased (MI T2 j p x) mi))
  (let ((erased x1) (erased x2) (erased x3) (erased cnx) (erased sx1) (erased sx2) (erased sx3)) (r4c-ca-cn us j m x f))
  (let-match erased cy (CanN _ y1 y2 y3 _ k1 k2 k3 cny))
  (let ((erased sy1) (erased sy2) (erased sy3)) (cn-sel y1 y2 y3 y cny))
  (let ((erased qp) (erased tp)) (thrice-exists p))
  (let ((erased kp1) (erased kp2) (erased kp3)) (values (Ki1 p qp tp) (Ki2 p qp tp) (Ki3 p qp tp)))
  (match erased j _
    ((Zero)
      (let-match erased (add-fn d (Zero) h d ad (add-zero-right d)) (Refl _ _))
      (let ((erased s1) (erased m1)) (r4c-ss-leaf h p qp c2 ctr x y x1 y1 T2 (C1) pre rc kp1 ri le ax ay sx1 sy1))
      (let ((erased s2) (erased m2)) (r4c-ss-leaf h p (Succ qp) c2 ctr x y x2 y2 T2 (C2) pre rc kp2 ri le ax ay sx2 sy2))
      (let ((erased s3) (erased m3)) (r4c-ss-leaf h p (Succ (Succ qp)) c2 ctr x y x3 y3 T2 (C3) pre rc kp3 ri le ax ay sx3 sy3))
      (values (r4c-ss-up x1 x2 x3 x y1 y2 y3 y cnx cny s1 s2 s3) (MiL T2 p qp x x1 x2 x3 tp sx1 sx2 sx3 m1 m2 m3)))
    ((Succ j1)
      (let ((erased qm) (erased tm)) (thrice-exists m))
      (let ((erased ad1)) (add-shift d j1 h ad))
      (let ((erased s1) (erased m1))
        (r4c-ss-bld h qp (Succ d) (Succ qm) c2 ctr x1 y1 T2 us (Cons _ (C1) pre) j1 rc (RICons pre p qp (C1) ri kp1) (LengthCons _ (C1) pre d le) ad1
          (r4c-ca-down us j1 m qm x x1 (C1) f (Ki1 m qm tm) sx1) (AtCons c2 x x1 pre (C1) ax sx1) (AtCons ctr y y1 pre (C1) ay sy1) k1))
      (let ((erased s2) (erased m2))
        (r4c-ss-bld h (Succ qp) (Succ d) (Succ (Succ qm)) c2 ctr x2 y2 T2 us (Cons _ (C2) pre) j1 rc (RICons pre p (Succ qp) (C2) ri kp2) (LengthCons _ (C2) pre d le) ad1
          (r4c-ca-down us j1 m (Succ qm) x x2 (C2) f (Ki2 m qm tm) sx2) (AtCons c2 x x2 pre (C2) ax sx2) (AtCons ctr y y2 pre (C2) ay sy2) k2))
      (let ((erased s3) (erased m3))
        (r4c-ss-bld h (Succ (Succ qp)) (Succ d) (Succ (Succ (Succ qm))) c2 ctr x3 y3 T2 us (Cons _ (C3) pre) j1 rc (RICons pre p (Succ (Succ qp)) (C3) ri kp3)
          (LengthCons _ (C3) pre d le) ad1 (r4c-ca-down us j1 m (Succ (Succ qm)) x x3 (C3) f (Ki3 m qm tm) sx3) (AtCons c2 x x3 pre (C3) ax sx3) (AtCons ctr y y3 pre (C3) ay sy3) k3))
      (values (r4c-ss-up x1 x2 x3 x y1 y2 y3 y cnx cny s1 s2 s3) (MiN T2 j1 p qp x x1 x2 x3 tp sx1 sx2 sx3 m1 m2 m3)))))

(def-fns _ $ (erased r4c-ca-ss : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) t u) (subterm erased (Ca us j n t) f) (erased (SameSet t u) s) -> (erased (Ca us j n u) r))
  (match erased f _
    ((CaE _ _ _ z) (let-match erased s (SsE)) (CaE us j n z))
    ((CaL _ _ c t1 t2 t3 x b o)
      (let-match erased s (SsN _ _ _ u1 u2 u3 s1 s2 s3))
      (let-match erased b (MkB3 _ _ _ _ a1 a2 a3 cb b1 b2 b3 l1 l2 l3))
      (CaL us n c u1 u2 u3 x (MkB3 c u1 u2 u3 a1 a2 a3 cb b1 b2 b3 (r4c-lf-ss t1 u1 a1 l1 s1) (r4c-lf-ss t2 u2 a2 l2 s2) (r4c-lf-ss t3 u3 a3 l3 s3))
        (r4c-occ3-ss t1 t2 t3 u1 u2 u3 o s1 s2 s3)))
    ((CaN _ j1 _ q t1 t2 t3 x tq k1 k2 k3 o)
      (let-match erased s (SsN _ _ _ u1 u2 u3 s1 s2 s3))
      (CaN us j1 n q u1 u2 u3 x tq (r4c-ca-ss us j1 (Succ q) t1 u1 k1 s1) (r4c-ca-ss us j1 (Succ (Succ q)) t2 u2 k2 s2) (r4c-ca-ss us j1 (Succ (Succ (Succ q))) t3 u3 k3 s3)
        (r4c-occ3-ss t1 t2 t3 u1 u2 u3 o s1 s2 s3)))))

(def-fns _ $ (erased r4c-am-rp : (erased (Nat) h t) (erased (Ctree) c c2) (erased (List (Nat)) T) (erased (List (Col)) p) (subterm erased (AMc h c T) m) (erased (Rp c p (CLeaf (CEmpty)) c2) rp)
    (erased (RIdx p t) ri) (erased (Length (Col) p (Succ h)) le) -> (erased (AMc h c2 T) r))
  (let-match erased m (AmCons _ x _ lf T1 pre rx lx a m1) ((AmNil _ _) (AmNil h c2)))
  (let ((erased y2) (erased a2) (erased rr)) (r4c-rp-at c (CLeaf (CEmpty)) c2 (CLeaf lf) t x (Succ h) p pre rp ri rx le lx a))
  (let ((erased m2)) (r4c-am-rp h t c c2 T1 p m1 rp ri le))
  (match erased rr _ ((RrS _ _ _) (AmCons h x c2 (CEmpty) T1 pre rx lx a2 m2)) ((RrO _ _ _ _ _) (AmCons h x c2 lf T1 pre rx lx a2 m2))))

(def-fns _ $ (erased r4c-am-cad : (erased (Nat) h t) (erased (Ctree) c c2) (erased (List (Nat)) T T2) (erased (List (Col)) p) (erased (AMc h c T) m) (erased (CAd c T t p c2 T2) ad)
    (erased (RIdx p t) ri) (erased (Length (Col) p (Succ h)) le) -> (erased (AMc h c2 T2) r))
  (let-match erased ad (CadNew _ _ _ _ _ ae rp) ((CadHas _ _ _ _ _ _) m))
  (let ((erased y2) (erased a2) (erased rr)) (r4c-rp-at c (CLeaf (CEmpty)) c2 (CEmpty) t t (Succ h) p p rp ri ri le le ae))
  (let-match erased rr (RrS _ _ _) (absurd (RrO _ _ _ _ ap) (apart-irrefl t ap)))
  (AmCons h t c2 (CEmpty) T p ri le a2 (r4c-am-rp h t c c2 T p m rp ri le)))

(def-fns _ $ (erased r4c-am-gad : (erased (Nat) h i n) (erased (List (Copy (Nat))) xs) (erased (Ctree) c c3) (erased (List (Nat)) T T3) (subterm erased (GAd h xs i n c T c3 T3) ga)
    (erased (AMc h c T) m) -> (erased (AMc h c3 T3) r))
  (let-match erased ga (GaC _ _ _ _ _ t1 t2 _ c1 c2 _ _ T1 T2 _ pg p1 p2 _ _ lg q1 r1 a1 q2 r2 a2 g3) ((GaE _ _ _ _ _) m))
  (let ((erased m1)) (r4c-am-cad h t1 c c1 T T1 p1 m a1 r1 (permt-length p231 pg p1 (Succ h) q1 lg)))
  (r4c-am-gad h (Succ i) n xs c2 c3 T2 T3 g3 (r4c-am-cad h t2 c1 c2 T1 T2 p2 m1 a2 r2 (permt-length p312 pg p2 (Succ h) q2 lg))))

(def-fns _ $ (erased r4c-am-lt : (erased (Nat) h N) (erased (Ctree) c) (erased (List (Nat)) T) (subterm erased (AMc h c T) m) (erased (Pw3 (Succ h) (Succ (Zero)) N) pw) -> (erased (Under T N) r))
  (let-match erased m (AmCons _ x _ _ T1 pre ri le _ m1) ((AmNil _ _) (UnderNil N)))
  (UnderCons x N T1 (r4c-ridx-lt x (Succ h) N pre ri le pw) (r4c-am-lt h N c T1 m1 pw)))

; red4's gone loop over the gone buffer G, from a cleared trie, builds the ctr trie of CtRLR gone gone: c2 holds the traces of ctr, and celems T2 lists them.
(def-fns _ $ (erased r4c-ctr : (erased (Nat) h n) (erased (List (U8)) us) (erased (List (Copy (Nat))) xs) (erased (Ctree) c2 gone) (erased (List (Nat)) T2 R G)
    (erased (GAd h xs (Zero) n (CEmpty) (Nil (Nat)) c2 T2) ga) (erased (Fwd xs (Zero) n R) fw) (erased (Tbk xs n G) tb) (erased (GoneT G gone (Succ h) (Zero) (Nil (Col))) gt)
    (erased (CtCanon (Succ h) gone) cg) (erased (Ca us h (Zero) c2) f) -> (erased (Ctree) ctr) (erased (CtRLR gone gone ctr) rl) (erased (CtCanon (Succ h) ctr) cct)
    (erased (SameSet c2 ctr) ss) (erased (MI T2 h (Zero) c2) mi) (erased (AMc h c2 T2) am))
  (let ((erased a) (erased pa) (erased ca)) (r4c-perm-c p312 (Succ h) gone cg))
  (let ((erased b) (erased pb) (erased cb)) (r4c-perm-c p231 (Succ h) gone cg))
  (let ((erased ctr) (erased o) (erased cct)) (r4c-or-c (Succ h) a b ca cb))
  (let ((erased rc)) (MkGCtx h n xs c2 gone a b ctr T2 R G ga fw tb gt (canon-h (Succ h) gone cg) pa pb o))
  (let ((erased ss) (erased mi)) (r4c-ss-bld h (Zero) (Zero) (Zero) c2 ctr c2 ctr T2 us (Nil _) h rc (RINil) (LengthNil _) (AddZero h) f (AtNil c2) (AtNil ctr) cct))
  (values ctr (RLU gone gone a b ctr pa pb o) cct ss mi (r4c-am-gad h (Zero) n xs (CEmpty) c2 (Nil _) T2 ga (AmNil h (CEmpty)))))

(def-fns _ $ (erased r4c-lt-remove : (erased (Nat) x N) (erased (List (Nat)) L L2) (subterm erased (Ins (Nat) x L2 L) rm) (erased (Under L N) a) -> (erased (Under L2 N) r))
  (match erased rm _
    ((InsH _ _ _) (let-match erased a (UnderCons _ _ _ _ a1)) a1)
    ((InsT _ _ y ys L1 rm1) (let-match erased a (UnderCons _ _ _ l a1)) (UnderCons y N ys l (r4c-lt-remove x N L1 ys rm1 a1)))))

; A list of distinct numbers below N has at most N of them.
(def-fns _ $ (erased r4c-pigeon : (subterm erased (Nat) N) (erased (List (Nat)) L) (erased (Distinct L) d) (erased (Under L N) a) -> (erased (Nat) k) (erased (Length (Nat) L k) le)
    (erased (Lt k (Succ N)) kl))
  (let-match erased N (Succ Nq)
    ((Zero) (let-match erased a (UnderNil _) (absurd (UnderCons _ _ _ l _) l)) (values (Zero) (LengthNil _) (LtZ (Zero)))))
  (let ((erased b) (erased m)) (r4c-mem-dec Nq L))
  (match erased m (((Nat) k) ((Length (Nat) L k) le) ((Lt k (Succ N)) kl))
    ((MbN _ _ o)
      (let ((erased k) (erased le) (erased kl)) (r4c-pigeon Nq L d (under-tighten L Nq a o)))
      (values k le (lt-weaken k (Succ Nq) kl)))
    ((MbY _ _ i)
      (let ((erased L2) (erased rm)) (remove-exists Nq L i))
      (let ((erased k) (erased le) (erased kl))
        (r4c-pigeon Nq L2 (remove-distinct Nq L L2 rm d) (under-tighten L2 Nq (r4c-lt-remove Nq N L L2 rm a) (r4c-remove-out Nq L L2 rm d))))
      (values (Succ k) (remove-length Nq k L L2 rm le) (LtS k (Succ Nq) kl)))))

; So their number is a U62.
(def-fns _ $ (erased r4c-len-u62 : (erased (Nat) h N) (erased (List (Nat)) L) (erased (Distinct L) d) (erased (Under L N) a) (erased (Pw3 (Succ h) (Succ (Zero)) N) pw)
    (erased (Lt (Succ h) 17) hl) -> (erased (Nat) k) (erased (Length (Nat) L k) le) (erased (Lt k u62-modulus) kb))
  (let ((erased k) (erased le) (erased kl)) (r4c-pigeon N L d a))
  (values k le (lt-le-trans k (Succ N) u62-modulus kl (LtS N u62-modulus (lt-le-trans N (Succ r4-m16) u62-modulus (pw3-bound (Succ h) N pw hl) (LtS r4-m16 u62-modulus r4-m16-u62))))))

(def-fns _ $ (erased r4c-dist-cad : (erased (Nat) h t) (erased (Ctree) c c2) (erased (List (Nat)) T T2) (erased (List (Col)) p) (erased (Distinct T) d) (erased (AMc h c T) m)
    (erased (CAd c T t p c2 T2) ad) (erased (RIdx p t) ri) (erased (Length (Col) p (Succ h)) le) -> (erased (Distinct T2) r))
  (let-match erased ad (CadNew _ _ _ _ _ ae _) ((CadHas _ _ _ _ _ _) d))
  (let ((erased b) (erased mb)) (r4c-mem-dec t T))
  (let-match erased mb (MbN _ _ o)
    (absurd (MbY _ _ i)
      (let ((erased pre) (erased lf) (erased rx) (erased lx) (erased a)) (r4c-am-in h t c T m i))
      (let-match erased (ridx-fn pre p t (Succ h) rx ri lx le) (Refl _ _))
      (ctat-fn c (CLeaf lf) (CEmpty) p a ae)))
  (DistCons t T o d))

(def-fns _ $ (erased r4c-dist-gad : (erased (Nat) h i n) (erased (List (Copy (Nat))) xs) (erased (Ctree) c c3) (erased (List (Nat)) T T3) (subterm erased (GAd h xs i n c T c3 T3) ga)
    (erased (AMc h c T) m) (erased (Distinct T) d) -> (erased (Distinct T3) r))
  (let-match erased ga (GaC _ _ _ _ _ t1 t2 _ c1 c2 _ _ T1 T2 _ pg p1 p2 _ _ lg q1 r1 a1 q2 r2 a2 g3) ((GaE _ _ _ _ _) d))
  (let ((erased l1) (erased l2)) (values (permt-length p231 pg p1 (Succ h) q1 lg) (permt-length p312 pg p2 (Succ h) q2 lg)))
  (let ((erased d1) (erased m1)) (values (r4c-dist-cad h t1 c c1 T T1 p1 d m a1 r1 l1) (r4c-am-cad h t1 c c1 T T1 p1 m a1 r1 l1)))
  (r4c-dist-gad h (Succ i) n xs c2 c3 T2 T3 g3 (r4c-am-cad h t2 c1 c2 T1 T2 p2 m1 a2 r2 l2) (r4c-dist-cad h t2 c1 c2 T1 T2 p2 d1 m1 a2 r2 l2)))

; What red4's s_round leaves, from ctu and gtr: uc holds keep and ul its live children; the gone buffer G lists gone; the ctr trie and celems T hold
; c, which has the traces of ctr, the union of gone's two rotations.
(def-adts $ (SRnd : ((Nat) h) ((Ctree) ctu) ((Gtree) gtr) ((List Cnt) vs) ((List (U8)) us) ((List (Nat)) G) ((List (U8)) cs) ((Ctree) c) ((List (Nat)) T) -> Type)
  enum
  (many MkSRnd : (erased (Nat) h) (erased (Ctree) ctu) (erased (Gtree) gtr) (erased (List Cnt) vs) (erased (List (U8)) us) (erased (List (Nat)) G) (erased (List (U8)) cs)
      (erased (Ctree) c) (erased (List (Nat)) T) (erased (Ctree) keep gone ctr) (erased (CRes h ctu (Cons RG (MkRx (Gtree) (BS0) gtr) (Nil RG)) keep gone) cr)
      (erased (Tally vs (Succ h) (Zero) keep) tb) (erased (Lc us h (Zero) keep) lc) (erased (CtCanon (Succ h) gone) cg) (erased (GoneT G gone (Succ h) (Zero) (Nil (Col))) gt)
      (erased (CtRLR gone gone ctr) rl) (erased (CtCanon (Succ h) ctr) ccr) (erased (Ca cs h (Zero) c) f) (erased (SameSet c ctr) ss) (erased (MI T h (Zero) c) mi)
      (erased (AMc h c T) am) (erased (Distinct T) dt) -> (SRnd h ctu gtr vs us G cs c T)))

