      (MiN R j1 p qp t t1 t2 t3 tp s1 s2 s3 (r4c-mi-drop x j1 qp c R t1 m1 w1 ti1 lw1 (kid-apart p px qp c (C1) e ap (Ki1 p qp tp) k))
        (r4c-mi-drop x j1 (Succ qp) c R t2 m2 w1 ti1 lw1 (kid-apart p px (Succ qp) c (C2) e ap (Ki2 p qp tp) k))
        (r4c-mi-drop x j1 (Succ (Succ qp)) c R t3 m3 w1 ti1 lw1 (kid-apart p px (Succ (Succ qp)) c (C3) e ap (Ki3 p qp tp) k))))))

(def-fns _ $ (erased r4c-mi-down : (erased (List (Nat)) R) (erased (Nat) j p pc) (erased (Ctree) t u) (erased (Col) e) (erased (MI R (Succ j) p t) m) (erased (Kid p e pc) k)
    (erased (CtSel t e u) s) -> (erased (MI R j pc u) r))
  (let-match erased m (MiN _ _ _ qp _ t1 t2 t3 tp s1 s2 s3 m1 m2 m3))
  (match erased k _
    ((Ki1 _ _ tk) (let-match erased (thrice-fn p qp pc tp tk) (Refl _ _)) (let-match erased (sel-fn t u t1 e s s1) (Refl _ _)) m1)
    ((Ki2 _ c0 tk) (let-match erased (thrice-fn p qp c0 tp tk) (Refl _ _)) (let-match erased (sel-fn t u t2 e s s2) (Refl _ _)) m2)
    ((Ki3 _ c0 tk) (let-match erased (thrice-fn p qp c0 tp tk) (Refl _ _)) (let-match erased (sel-fn t u t3 e s s3) (Refl _ _)) m3)))

(def-adts
  ; During red4's cclear, the trie node n, of the trace prefix p, held t, of j + 1 more colours: still as Ca says, each trace of t in R, those left
  ; to clear; or cleared to 0, its children, if any, held the same way.
  ((CCl : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Nat) p) ((Ctree) t) ((List (Nat)) R) -> Type)
    enum
    (many ClK : (erased (List (U8)) us) (erased (Nat) j n p) (erased (Ctree) t) (erased (List (Nat)) R) (erased (Ca us j n t) f) (erased (MI R j p t) m) -> (CCl us j n p t R))
    (many ClZ0 : (erased (List (U8)) us) (erased (Nat) n p) (erased (Ctree) t) (erased (List (Nat)) R) (erased (Elt flag-w us n (Zero)) y) -> (CCl us (Zero) n p t R))
    (many ClZ : (erased (List (U8)) us) (erased (Nat) j n p q qp) (erased (Ctree) t1 t2 t3) (erased (List (Nat)) R) (erased (Elt flag-w us n (Zero)) y) (erased (Thrice n q) tq)
        (erased (Thrice p qp) tp) (erased (CCl us j (Succ q) qp t1 R) k1) (erased (CCl us j (Succ (Succ q)) (Succ qp) t2 R) k2)
        (erased (CCl us j (Succ (Succ (Succ q))) (Succ (Succ qp)) t3 R) k3) -> (CCl us (Succ j) n p (CNode t1 t2 t3) R))))

(def-fns _ $ (erased r4c-cl-below : (erased (List (U8)) us vs) (erased (Nat) j n i x p) (erased (List (Nat)) R) (erased (Ctree) t) (subterm erased (CCl us j n p t R) f)
    (erased (Put flag-w us i x vs) s) (erased (Lt i n) l) -> (erased (CCl vs j n p t R) r))
  (let ((erased ap)) (ApLt (Nat) Lt i n l))
  (let-match erased f (ClZ _ j1 _ _ q qp t1 t2 t3 _ y tq tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ g m) (ClK vs j n p t R (r4c-ca-below us vs j n i x t g s l) m))
    ((ClZ0 _ _ _ _ _ y) (ClZ0 vs n p t R (put-other flag-w us vs i x n _ s ap y))))
  (let ((erased l1)) (lt-le-trans _ _ _ l (lt-weaken _ _ (thrice-le n q tq))))
  (let ((erased l2)) (lt-weaken _ _ l1))
  (ClZ vs j1 n p q qp t1 t2 t3 R (put-other flag-w us vs i x n _ s ap y) tq tp (r4c-cl-below us vs j1 (Succ q) i x qp R t1 k1 s l1)
    (r4c-cl-below us vs j1 (Succ (Succ q)) i x (Succ qp) R t2 k2 s l2) (r4c-cl-below us vs j1 (Succ (Succ (Succ q))) i x (Succ (Succ qp)) R t3 k3 s (lt-weaken _ _ l2))))

(def-fns _ $ (erased r4c-cl-apart : (erased (List (U8)) us vs) (erased (Nat) j n m q i x p) (erased (List (Nat)) R) (erased (Ctree) t) (subterm erased (CCl us j n p t R) f)
    (erased (Put flag-w us i x vs) s) (erased (HDesc m i) d) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (CCl vs j n p t R) r))
  (let ((erased ap)) (ApGt (Nat) Lt i n (lt-le-trans _ _ _ nm (desc-ge m i d))))
  (let-match erased f (ClZ _ j1 _ _ q2 qp t1 t2 t3 _ y tq2 tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ g mi) (ClK vs j n p t R (r4c-ca-apart us vs j n m q i x t g s d nm tq mq) mi))
    ((ClZ0 _ _ _ _ _ y) (ClZ0 vs n p t R (put-other flag-w us vs i x n _ s ap y))))
  (let-match erased (thrice-fn n q q2 tq tq2) (Refl _ _))
  (let ((erased y2)) (put-other flag-w us vs i x n _ s ap y))
  (match erased d _
    ((HDSelf _)
      (let ((erased l2)) (lt-weaken _ _ mq))
      (ClZ vs j1 n p q qp t1 t2 t3 R y2 tq tp (r4c-cl-below us vs j1 (Succ q) i x qp R t1 k1 s mq) (r4c-cl-below us vs j1 (Succ (Succ q)) i x (Succ qp) R t2 k2 s l2)
        (r4c-cl-below us vs j1 (Succ (Succ (Succ q))) i x (Succ (Succ qp)) R t3 k3 s (lt-weaken _ _ l2))))
    ((HDKid _ q3 c2 _ tm hk d2)
      (let ((erased r1) (erased u1) (erased e1) (erased f1)) (apart-kid n m q q3 (Succ q) c2 nm tq mq tm hk (HK1 q)))
      (let ((erased r2) (erased u2) (erased e2) (erased f2)) (apart-kid n m q q3 (Succ (Succ q)) c2 nm tq mq tm hk (HK2 q)))
      (let ((erased r3) (erased u3) (erased e3) (erased f3)) (apart-kid n m q q3 (Succ (Succ (Succ q))) c2 nm tq mq tm hk (HK3 q)))
      (ClZ vs j1 n p q qp t1 t2 t3 R y2 tq tp (r4c-cl-apart us vs j1 (Succ q) c2 r1 i x qp R t1 k1 s d2 e1 u1 f1)
        (r4c-cl-apart us vs j1 (Succ (Succ q)) c2 r2 i x (Succ qp) R t2 k2 s d2 e2 u2 f2)
        (r4c-cl-apart us vs j1 (Succ (Succ (Succ q))) c2 r3 i x (Succ (Succ qp)) R t3 k3 s d2 e3 u3 f3)))))

(def-fns _ $ (erased r4c-cl-apart-in : (erased (List (U8)) us vs) (erased (Nat) j n m q p) (erased (List (Nat)) R) (erased (Ctree) t) (erased (CCl us j n p t R) f)
    (subterm erased (SetsBelow us vs m) w) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (CCl vs j n p t R) r))
  (match erased w _
    ((SbNil _ _) f)
    ((SbSet _ ws _ _ i x w1 s d) (r4c-cl-apart ws vs j n m q i x p R t (r4c-cl-apart-in us ws j n m q p R t f w1 nm tq mq) s d nm tq mq))))

(def-fns _ $ (erased r4c-cl-sib : (erased (List (U8)) us vs) (erased (Nat) j n m i x p) (erased (List (Nat)) R) (erased (Ctree) t) (erased (CCl us j n p t R) f)
    (erased (Put flag-w us i x vs) s) (erased (HDesc m i) d) (erased (Lt m n) mn) (erased (Lt n (Succ (Succ (Succ m)))) nm) (erased (Lt (Zero) m) mp) -> (erased (CCl vs j n p t R) r))
  (let-match erased d (HDKid _ q3 c _ t3 hk d2) ((HDSelf _) (r4c-cl-below us vs j n i x p R t f s mn)))
  (let ((erased qn) (erased tn)) (thrice-exists n))
  (let ((erased lo) (erased hi)) (hkid-lt q3 c hk))
  (let ((erased nq)) (le-trans n (Succ (Succ m)) q3 nm (LtS _ _ (thrice-ge2 m q3 mp t3))))
  (r4c-cl-apart us vs j n c qn i x p R t f s d2 (lt-le-trans _ _ _ nq (LtS _ _ lo)) tn
    (lt-le-trans _ _ _ hi (LtS _ _ (LtS _ _ (thrice-lt m n q3 qn mn t3 tn))))))

(def-fns _ $ (erased r4c-cl-sib-in : (erased (List (U8)) us vs) (erased (Nat) j n m p) (erased (List (Nat)) R) (erased (Ctree) t) (erased (CCl us j n p t R) f)
    (subterm erased (SetsBelow us vs m) w) (erased (Lt m n) mn) (erased (Lt n (Succ (Succ (Succ m)))) nm) (erased (Lt (Zero) m) mp) -> (erased (CCl vs j n p t R) r))
  (match erased w _
    ((SbNil _ _) f)
    ((SbSet _ ws _ _ i x w1 s d) (r4c-cl-sib ws vs j n m i x p R t (r4c-cl-sib-in us ws j n m p R t f w1 mn nm mp) s d mn nm mp))))

(def-fns _ $ (erased r4c-cl-lo : (erased (List (U8)) us vs) (erased (Nat) j a m p) (erased (List (Nat)) R) (erased (Ctree) t) (erased (CCl us j a p t R) f) (erased (SetsBelow us vs m) w)
    (erased (Lt a m) am) (erased (Lt m (Succ (Succ (Succ a)))) ma) (erased (Lt (Zero) a) ap) -> (erased (CCl vs j a p t R) r))
  (let ((erased qa) (erased ta)) (thrice-exists a))
  (r4c-cl-apart-in us vs j a m qa p R t f w am ta (le-trans m (Succ (Succ a)) qa ma (LtS _ _ (thrice-ge2 a qa ap ta)))))

; R less its head x, which is no trace below the prefix p.
(def-fns _ $ (erased r4c-cl-drop : (erased (List (U8)) us) (erased (Nat) x j n p px) (erased (List (Nat)) R) (erased (Ctree) t) (subterm erased (CCl us j n p t (Cons (Nat) x R)) f)
    (erased (List (Col)) w) (erased (TIdx px w x) ti) (erased (Length (Col) w (Succ j)) lw) (erased (Apart (Nat) Lt p px) ap) -> (erased (CCl us j n p t R) r))
  (let-match erased f (ClZ _ j1 _ _ q qp t1 t2 t3 _ y tq tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ g m) (ClK us j n p t R g (r4c-mi-drop x j p px R t m w ti lw ap)))
    ((ClZ0 _ _ _ _ _ y) (ClZ0 us n p t R y)))
  (let-match erased lw (LengthCons _ _ _ _ lw1))
  (let-match erased ti (TICons _ c _ e w1 k ti1))
  (ClZ us j1 n p q qp t1 t2 t3 R y tq tp (r4c-cl-drop us x j1 (Succ q) qp c R t1 k1 w1 ti1 lw1 (kid-apart p px qp c (C1) e ap (Ki1 p qp tp) k))
    (r4c-cl-drop us x j1 (Succ (Succ q)) (Succ qp) c R t2 k2 w1 ti1 lw1 (kid-apart p px (Succ qp) c (C2) e ap (Ki2 p qp tp) k))
    (r4c-cl-drop us x j1 (Succ (Succ (Succ q))) (Succ (Succ qp)) c R t3 k3 w1 ti1 lw1 (kid-apart p px (Succ (Succ qp)) c (C3) e ap (Ki3 p qp tp) k))))

(def-fns _ $ (erased r4c-cl-down : (erased (List (U8)) us) (erased (List (Nat)) R) (erased (Nat) j n c p pc) (erased (Ctree) t u) (erased (Col) e) (erased (CCl us (Succ j) n p t R) f)
    (erased (Kid n e c) kd) (erased (Kid p e pc) kp) (erased (CtSel t e u) s) -> (erased (CCl us j (Succ c) pc u R) r))
  (let-match erased f (ClZ _ _ _ _ q qp t1 t2 t3 _ _ tq tp k1 k2 k3)
    ((ClK _ _ _ _ _ _ g m) (ClK us j (Succ c) pc u R (r4c-ca-down us j n c t u e g kd s) (r4c-mi-down R j p pc t u e m kp s))))
  (match erased kd _
    ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) (let-match erased kp (Ki1 _ _ tk2)) (let-match erased (thrice-fn p qp pc tp tk2) (Refl _ _))
      (let-match erased s (SelN1 _ _ _)) k1)
    ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased kp (Ki2 _ p0 tk2)) (let-match erased (thrice-fn p qp p0 tp tk2) (Refl _ _))
      (let-match erased s (SelN2 _ _ _)) k2)
    ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased kp (Ki3 _ p0 tk2)) (let-match erased (thrice-fn p qp p0 tp tk2) (Refl _ _))
      (let-match erased s (SelN3 _ _ _)) k3)))

(def-fns _ $ (erased r4c-cl-at : (erased (List (U8)) us) (erased (List (Nat)) R) (erased (Nat) j n p d D) (erased (Ctree) top t) (subterm erased (List (Col)) pre)
    (erased (CCl us D (Zero) (Zero) top R) f) (erased (HIdx pre n) hi) (erased (RIdx pre p) ri) (erased (CtAt top pre t) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad)
    -> (erased (CCl us j n p t R) r))
  (match erased pre _
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased ri (RINil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) f)
    ((Cons _ e pre1)
      (let-match erased hi (HxCons _ n1 c _ hi1 k))
      (let-match erased ri (RICons _ p1 _ _ ri1 kp))
      (let-match erased pt (AtCons _ u _ _ _ at1 s))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Dq ad1))
      (r4c-cl-down us R j n1 c p1 p u t e (r4c-cl-at us R (Succ j) n1 p1 d1 D top u pre1 f hi1 ri1 at1 le1 (add-succ-right d1 j Dq ad1)) k kp s))))

; The children of a node of cclear, one of them the new child c of the path, moved from us0 to us and rid of the trace xt below c.
(def-fns _ $ (erased r4c-cl-kids : (erased (List (U8)) us0 us) (erased (Nat) d m x pm pc xt q qp) (erased (List (Nat)) R) (erased (Ctree) b1 b2 b3 o) (erased (Col) e)
    (erased (List (Col)) w) (erased (Thrice m q) tq) (erased (Thrice pm qp) tp) (erased (CCl us0 d (Succ q) qp b1 (Cons (Nat) xt R)) k1)
    (erased (CCl us0 d (Succ (Succ q)) (Succ qp) b2 (Cons (Nat) xt R)) k2) (erased (CCl us0 d (Succ (Succ (Succ q))) (Succ (Succ qp)) b3 (Cons (Nat) xt R)) k3)
    (erased (Kid m e x) kd) (erased (Kid pm e pc) kp) (erased (CtSel (CNode b1 b2 b3) e o) sl) (erased (SetsBelow us0 us (Succ x)) wb) (erased (CCl us d (Succ x) pc o R) kc)
    (erased (TIdx pc w xt) ti) (erased (Length (Col) w (Succ d)) lw) -> (erased (CCl us d (Succ q) qp b1 R) r1) (erased (CCl us d (Succ (Succ q)) (Succ qp) b2 R) r2)
    (erased (CCl us d (Succ (Succ (Succ q))) (Succ (Succ qp)) b3 R) r3))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased a12) (erased a23)) (values (lt-succ qp) (lt-succ (Succ qp))))
  (let ((erased a13)) (lt-weaken _ _ a12))
  (match erased kd _
    ((Ki1 _ _ tk)
      (let-match erased (thrice-fn m q x tq tk) (Refl _ _))
      (let-match erased kp (Ki1 _ _ tk2))
      (let-match erased (thrice-fn pm qp pc tp tk2) (Refl _ _))
      (let-match erased sl (SelN1 _ _ _))
      (values kc (r4c-cl-drop us xt d q2 (Succ qp) pc R b2 (r4c-cl-sib-in us0 us d q2 q1 (Succ qp) _ b2 k2 wb l12 l24 p1) w ti lw (ApGt (Nat) Lt _ _ a12))
        (r4c-cl-drop us xt d q3 (Succ (Succ qp)) pc R b3 (r4c-cl-sib-in us0 us d q3 q1 (Succ (Succ qp)) _ b3 k3 wb l13 l34 p1) w ti lw (ApGt (Nat) Lt _ _ a13))))
    ((Ki2 _ x0 tk)
      (let-match erased (thrice-fn m q x0 tq tk) (Refl _ _))
      (let-match erased kp (Ki2 _ p0 tk2))
      (let-match erased (thrice-fn pm qp p0 tp tk2) (Refl _ _))
      (let-match erased sl (SelN2 _ _ _))
      (values (r4c-cl-drop us xt d q1 qp pc R b1 (r4c-cl-lo us0 us d q1 q2 qp _ b1 k1 wb l12 l24 p1) w ti lw (ApLt (Nat) Lt _ _ a12)) kc
        (r4c-cl-drop us xt d q3 (Succ (Succ qp)) pc R b3 (r4c-cl-sib-in us0 us d q3 q2 (Succ (Succ qp)) _ b3 k3 wb l23 l35 p2) w ti lw (ApGt (Nat) Lt _ _ a23))))
    ((Ki3 _ x0 tk)
      (let-match erased (thrice-fn m q x0 tq tk) (Refl _ _))
      (let-match erased kp (Ki3 _ p0 tk2))
      (let-match erased (thrice-fn pm qp p0 tp tk2) (Refl _ _))
      (let-match erased sl (SelN3 _ _ _))
      (values (r4c-cl-drop us xt d q1 qp pc R b1 (r4c-cl-lo us0 us d q1 q3 qp _ b1 k1 wb l13 l34 p1) w ti lw (ApLt (Nat) Lt _ _ a13))
        (r4c-cl-drop us xt d q2 (Succ qp) pc R b2 (r4c-cl-lo us0 us d q2 q3 (Succ qp) _ b2 k2 wb l23 l35 p2) w ti lw (ApLt (Nat) Lt _ _ a23)) kc))))

(def-fns _ $ (erased r4c-ca-nz : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) o) (erased (Ca us j n o) f) (erased (Occ o) oo) -> (erased (Nat) c) (erased (Elt flag-w us n (Succ c)) y))
  (let-match erased f (CaN _ _ _ _ _ _ _ y _ _ _ _ _) ((CaE _ _ _ _) (match erased oo (((Nat) c) ((Elt flag-w us n (Succ c)) y))))
    ((CaL _ _ c t1 t2 t3 y b o3) (let-match erased c (Succ c1) (absurd (Zero) (r4c-b3-zero t1 t2 t3 b o3))) (values c1 y)))
  (values (Zero) y))

; red4's cclear above the cleared node n of the path pre, the node of the trace xt, once ctr_path has stopped: the zeroed ancestors keep 0.
(def-fns _ $ (erased r4c-cl-glue : (erased (List (U8)) us0 us) (erased (Nat) n k d D p xt) (erased (List (Nat)) R) (erased (Ctree) top o) (subterm erased (List (Col)) pre)
    (erased (List (Col)) w) (erased (HIdx pre n) hi) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (Add k d D) ad) (erased (CCl us0 D (Zero) (Zero) top (Cons (Nat) xt R)) f0)
    (erased (SetsBelow us0 us n) wb) (erased (CCl us d n p o R) kc) (erased (CtAt top pre o) ao) (erased (Occ o) oo) (erased (Elt flag-w us0 n (Zero)) y0) (erased (TIdx p w xt) ti)
    (erased (Length (Col) w (Succ d)) lw) -> (erased (CCl us D (Zero) (Zero) top R) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased ri (RINil)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) (let-match erased ao (AtNil _)) kc))
  (let-match erased hi (HxCons _ m x _ hi1 kd))
  (let-match erased ri (RICons _ pm _ _ ri1 kp))
  (let-match erased le (LengthCons _ _ _ k1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let ((erased ad2)) (add-succ-right k1 d Dq ad1))
  (let-match erased ao (AtCons _ u _ _ _ au so))
  (let ((erased ou)) (sel-occ u o e so oo))
  (let-match erased (r4c-cl-at us0 (Cons _ xt R) (Succ d) m pm k1 D top u pre1 f0 hi1 ri1 au le1 ad2) (ClZ _ _ _ _ q qp b1 b2 b3 _ y tq tp k4 k5 k6)
    (absurd (ClK _ _ _ _ _ _ g _)
      (let-match erased g (CaN _ _ _ _ _ _ _ _ _ _ _ _ _) (absurd (CaE _ _ _ _) ou))
      (let ((erased c) (erased yc)) (r4c-ca-nz us0 d (Succ x) o (r4c-ca-down us0 d m x u o e g kd so) oo))
      (elt-fn flag-w us0 (Succ x) (Succ c) (Zero) yc y0)))
  (let ((erased q0) (erased tq0) (erased _) (erased lo)) (kid-base m x e kd))
  (let ((erased mn)) (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq0) (LtS q0 (Succ x) lo)))
  (let ((erased r1) (erased r2) (erased r3)) (r4c-cl-kids us0 us d m x pm p xt q qp R b1 b2 b3 o e w tq tp k4 k5 k6 kd kp so wb kc ti lw))
  (r4c-cl-glue us0 us m k1 (Succ d) D pm xt R top u pre1 (Cons _ e w) hi1 ri1 le1 ad2 f0 (sb-up us0 us m q (Succ x) tq (kid-hkid m q x e kd tq) wb)
    (ClZ us d m pm q qp b1 b2 b3 R (elt-sb us0 us m (Succ x) (Zero) y wb mn) tq tp r1 r2 r3) au ou y (TICons pm p xt e w kp ti) (LengthCons _ e w (Succ d) lw)))

; red4's cclear above the cleared node n of the path pre, the node of the trace xt, through ctr_path with 0.
