      (let-match erased (ctat-fn c x0 (CLeaf lf) pre a0 ah) (Refl _ _))
      (let-match erased l0 (LfL _))
      (values (Bit1) (Bit1) x0 (EbSame t) a0 l0 m0 (r4c-or1 (Bit1))))
    ((CadNew _ _ _ _ _ ae rpl)
      (let ((erased y2) (erased a2) (erased rr)) (r4c-rp-at c (CLeaf (CEmpty)) c2 x0 t ti (Succ h) p pre rpl rp ri lp le a0))
      (let-match erased rr (RrS _ _ _)
        ((RrO _ _ _ _ ap)
          (values (Bit0) b0 x0 (EbDiff t ti ap) a2 l0
            (match erased m0 (((MemB ti (Cons (Nat) t T) b0) r))
              ((MbY _ _ q) (MbY ti _ (InThere ti t T q)))
              ((MbN _ _ q) (MbN ti _ (NotInCons ti t T (r4c-apart-sym t ti ap) q))))
            (r4c-or0 b0))))
      (let-match erased (ridx-fn p pre t (Succ h) rp ri lp le) (Refl _ _))
      (let-match erased (ctat-fn c x0 (CEmpty) pre a0 ae) (Refl _ _))
      (let-match erased l0 (LfE))
      (values (Bit1) (Bit1) y2 (EbSame t) a2 (LfL (CEmpty)) (MbY t _ (InHere t T)) (r4c-or0l (Bit1))))))

(def-fns _ $ (erased r4c-ridx-det : (erased (List (Col)) pre) (erased (Nat) p q) (subterm erased (RIdx pre p) a) (erased (RIdx pre q) b) -> (erased (Eq (Nat) p q) r))
  (let-match erased a (RICons pre1 p1 _ e a1 k1) ((RINil) (let-match erased b (RINil)) (Refl _ p)))
  (let-match erased b (RICons _ p2 _ _ b1 k2))
  (let-match erased (r4c-ridx-det pre1 p1 p2 a1 b1) (Refl _ _))
  (let-match erased (kid-dec p1 p q e e k1 k2) (KcSame _ _) (absurd (KcNe _ _ _ _ ne _) ne))
  (Refl _ p))

(def-fns _ $ (erased r4c-kid-mk : (erased (Nat) p d) (erased (Col) e) (erased (CD d e) cd) -> (erased (Nat) q) (erased (Kid p e q) k))
  (let ((erased q0) (erased tq)) (thrice-exists p))
