(def-adts $ (KidD : ((Nat) p) ((Col) e) -> Type)
  enum
  (many KdZero : (erased (Nat) p) -> (KidD p (C0)))
  (many KdKid : (erased (Nat) p a) (erased (Col) e) (erased (Kid p e a) k) -> (KidD p e)))

(def-fns _ $ (many kid-d : (erased (Nat) p q) (many (Col) e) (erased (Thrice p q) tq) -> (many (KidD p e) d))
  (match many e _
    ((C0) (KdZero p))
    ((C1) (KdKid p q (C1) (Ki1 p q tq)))
    ((C2) (KdKid p (Succ q) (C2) (Ki2 p q tq)))
    ((C3) (KdKid p (Succ (Succ q)) (C3) (Ki3 p q tq)))))

(def-fns _ $ (many tally-look : (subterm many (List (Col)) et) (many (Nat) j p) (erased (List Cnt) us) (many (Bytes us) a) (erased (Fit cnt-w us) f)
    (erased (Ctree) t) (erased (Tally us j p t) b) -> (many (Nat) n) (erased (CtSub t et n) s))
  (let ((many z)) (Zero))
  (let-match many et (Cons _ e et1)
    ((Nil _)
      (let-match many j (Succ _)
        ((Zero)
          (let-match erased b (TaL _ _ n _ x r _))
          (let-match erased f (MkFit _ _ len l))
          (values (cnt-get-many us a len l p n x) (SubNil t n r))))
      (let-match erased b (TaN _ _ _ _ _ _ _ _ _ _ _ _ cn))
      (values z (SubNil t z (match erased cn (((CtRoot t (Zero)) r)) ((CnE) (RootE)) ((CnN t1 t2 t3 _) (RootN t1 t2 t3)))))))
  (let-match many j (Succ j1)
    ((Zero)
      (let-match erased b (TaL _ _ _ _ _ _ k))
      (values z (SubCons t (CEmpty) e et1 z (match erased k (((CtSel t e (CEmpty)) sl)) ((HE _) (SelE e)) ((HL lf _) (SelL lf e))) (empty-sub et1)))))
  (let-match erased b (TaN _ _ _ q t1 t2 t3 _ tq b1 b2 b3 cn))
  (let-match many (kid-d p q e tq) (KdKid _ x _ k)
    ((KdZero _)
      (values z (SubCons t (CEmpty) e et1 z (match erased cn (((CtSel t (C0) (CEmpty)) sl)) ((CnE) (SelE (C0))) ((CnN _ _ _ _) (SelN0 t1 t2 t3)))
        (empty-sub et1)))))
  (let ((erased u) (erased bu) (erased sl)) (tally-down us j1 p x t e b k))
  (let ((many n) (erased sb)) (tail $ tally-look et1 j1 (kid-c p e x k (tally-u62 us j1 x u bu f)) us a f u bu))
  (values n (SubCons t u e et1 n sl sb)))

; The counts of kt, readable by trace.
(def-adts $ (KtA : ((Ctree) kt) -> Type)
  enum
  (many MkKtA : (erased (Ctree) kt) (many (Nat) j) (erased (List Cnt) us) (many (Bytes us) a) (erased (Fit cnt-w us) f) (erased (Tally us j (Zero) kt) b)
      -> (KtA kt)))

(def-fns _ $ (many kt-look : (erased (Ctree) kt) (many (KtA kt) ka) (many (List (Col)) et) -> (many (Nat) n) (erased (CtSub kt et n) s))
  (let-match many ka (MkKtA _ j us a f b))
  (tally-look et j (Zero) us a f kt b))

(def-adts $ (KtR : (Pred P) ((Nat) h) -> Type)
