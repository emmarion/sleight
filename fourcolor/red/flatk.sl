; The kids of the prefix p of the blocks of m 3^j, and of the heap node n.
(def-adts $ (Kids : ((Nat) len) ((Nat) lenL) ((Nat) j) ((Nat) p) ((Nat) n) ((Nat) m) ((Nat) mq) ((Nat) q) ((Nat) nq) -> Type)
  enum
  (many MkKids : (erased (Nat) len lenL j p n m mq q nq) (erased (Thrice p q) tq) (erased (Thrice n nq) tnq) (erased (Pw3 j mq len) w)
      (erased (Lt q mq) l1) (erased (Lt (Succ q) mq) l2) (erased (Lt (Succ (Succ q)) mq) l3) (erased (TrieFit lenL j (Succ nq)) f1)
      (erased (TrieFit lenL j (Succ (Succ nq))) f2) (erased (TrieFit lenL j (Succ (Succ (Succ nq)))) f3) -> (Kids len lenL j p n m mq q nq)))

(def-fns _ $ (many kt-kids : (erased (Nat) len lenL j m) (many (Nat) p n) (erased (Pw3 (Succ j) m len) w) (erased (Lt p m) pm) (erased (Lt len u62-modulus) lb)
    (erased (Lt lenL u62-modulus) lbl) (erased (TrieFit lenL (Succ j) n) tf) ->
    (erased (Nat) mq q nq) (erased (Kids len lenL j p n m mq q nq) kd) (many q is r1) (many (Succ nq) is c1)
    (erased (Lt (Succ (Succ q)) u62-modulus) rb) (erased (Lt (Succ (Succ (Succ nq))) u62-modulus) cb))
  (let-match erased w (PwS _ _ mq _ tmq w1))
  (let-match erased tf (TfN _ _ _ nq _ tnq f1 f2 f3))
  (let ((erased q) (erased tq)) (thrice-exists p))
  (let ((erased l3)) (thrice-lt p m q mq pm tq tmq))
  (let ((erased l2)) (lt-succ-left _ _ l3))
  (let ((erased rb)) (lt-trans _ _ _ (lt-le-trans _ _ _ l3 (pw3-le j mq len w1)) lb))
  (let ((erased cb)) (lt-trans _ _ _ (tfit-lt _ _ _ f3) lbl))
  (let ((many r1) (erased _) (erased _)) (base3 p q tq rb))
  (let ((many c1) (erased _) (erased _)) (node-kids n nq tnq cb))
  (values mq q nq (MkKids len lenL j p n m mq q nq tq tnq w1 (lt-succ-left _ _ l2) l2 l3 f1 f2 f3) r1 c1 rb cb))

(def-fns _ $ (erased evt-odd : (erased (Nat) cv j) (erased (Ctree) t) (erased (EvT cv (ESOdd) j t) v) -> (erased (Eq (Ctree) t (CEmpty)) r))
