(def-adts $ (CtA : ((Nat) h) ((Nat) len) ((Ctree) ctu) -> Type)
  enum
  (many MkCtA : (erased (Nat) h len) (erased (Ctree) ctu) (erased (List Cnt) us) (unique (Bytes us) a) (erased (Tally us (Succ h) (Zero) ctu) tb)
      (erased (Sz cnt-w us len) lu) (erased (List (U8)) ls) (unique (Bytes ls) fa) (erased (Room ls (Succ h)) rm)
      (erased (Lv ls flag-live (Succ h) (Zero) ctu) lv) (erased (List Cnt) ws) (unique (Bytes ws) g) (erased (Tally ws (Succ h) (Zero) (CEmpty)) wz)
      (erased (Sz cnt-w ws len) lw) (unique (Tq (Nil (Nat))) qt) -> (CtA h len ctu)))

(def-adts $ (Rm : ((Nat) h) ((Ctree) ctr) -> Type)
  enum
  (many MkRm : (erased (Nat) h) (erased (Ctree) ctr) (erased (List (U8)) ms) (unique (Bytes ms) m) (erased (Room ms (Succ h)) rm)
      (erased (Flags ms (Succ h) (Zero) ctr) f) (erased (List (U8)) fs) (unique (Bytes fs) fz) (erased (Room fs (Succ h)) rf) (many (Nat) gen)
      (erased (Lt gen u8-modulus) gnb) -> (Rm h ctr)))

(def-fns _ $ (many gen-next : (many (Nat) g) -> (many (Nat) g2) (erased (Lt g2 u8-modulus) gb2))
  (match many (lt-dec (Succ g) u8-modulus) _ ((Yes _ _ _ _ b) (values (Succ g) b)) ((No _ _ _ _ _) (values flag-live flag-one-lt8))))

; The membership arrays of gtu and gtr over the static tree sx.
(def-adts $ (GA : ((Nat) h) ((Sx) sx) ((Nat) n) ((Gtree) gtr) ((Gtree) gtu) -> Type)
  enum
  (many MkGA : (erased (Nat) h n) (erased (Sx) sx) (erased (Gtree) gtr gtu) (erased (List (U8)) us) (unique (Bytes us) ga) (erased (Sz flag-w us n) lu)
      (erased (Gm us (Succ h) sx (GSG gtu)) mu) (erased (List (U8)) ts) (unique (Bytes ts) gt) (erased (Sz flag-w ts n) lt)
      (erased (Gm ts (Succ h) sx (GSG gtr)) mt) -> (GA h sx n gtr gtu)))

(def-adts $ (KEnv : ((Nat) h) ((Nat) len) ((Sx) sx) ((Nat) gn) -> Type)
  enum
  (many MkKEnv : (erased (Nat) h len) (erased (Lt len u62-modulus) lb) (erased (List Cnt) us) (erased (Ctree) t) (erased (Tally us (Succ h) (Zero) t) tb)
      (erased (Sz cnt-w us len) lu) (many len is n) (many (Nat) off) (erased (Offs (Succ h) off) of) (erased (Sx) sx) (erased (Nat) gn)
      (erased (List (U8)) xl) (many (Xr xl) xs) (many (Nat) rf) (erased (Prs sx rf) pr) (erased (Pk xl (Succ h) sx (Zero) gn) pk) (erased (Lt gn u62-modulus) hb)
      -> (KEnv h len sx gn)))

(def-adts $ (KdF : ((Nat) h) ((Nat) len) ((Ctree) c0 r0) ((Gtree) g0) ((Sx) sx) ((Nat) gn) -> Type)
  enum
  (many MkKdF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (erased (Sx) sx) (erased (Nat) gn) (erased (Ctree) ctu) (unique (CtA h len ctu) ca)
      (many (KeepE ctu) e) (erased (Gtree) gtr gtu) (unique (GA h sx gn gtr gtu) gg) (erased (KR h c0 r0 g0 ctu gtr gtu) kr) (erased (Ctree) ctr)
      (unique (Rm h ctr) rf) -> (KdF h len c0 r0 g0 sx gn)))

(def-adts $ (KgF : ((Nat) h) ((Nat) len) ((Ctree) c0 r0) ((Gtree) g0) ((Sx) sx) ((Nat) gn) -> Type)
  enum
  (many MkKgF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (erased (Sx) sx) (erased (Nat) gn) (erased (Ctree) ctu) (unique (CtA h len ctu) ca)
      (many (KeepE ctu) e) (erased (Gtree) gx gtu) (unique (GA h sx gn gx gtu) gg) (erased (KR h c0 r0 g0 ctu (GEmpty) gtu) kr) (erased (Ctree) ctr)
      (erased (CR h c0 r0 g0 ctr) cr) (unique (Rm h ctr) rf) -> (KgF h len c0 r0 g0 sx gn)))

(def-adts $ (KrF : ((Nat) h) ((Nat) len) ((Ctree) c0 r0) ((Gtree) g0) ((Sx) sx) ((Nat) gn) -> Type)
  enum
  (many KDoneF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (erased (Sx) sx) (erased (Nat) gn) (unique (KdF h len c0 r0 g0 sx gn) s)
      -> (KrF h len c0 r0 g0 sx gn))
  (many KGoF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (erased (Sx) sx) (erased (Nat) gn) (unique (KgF h len c0 r0 g0 sx gn) s)
      -> (KrF h len c0 r0 g0 sx gn)))

(def-fns _ $ (many ktf-step : (erased (Ctree) c0 r0) (erased (Gtree) g0) (many (Nat) h) (erased (Nat) len) (erased (Sx) sx) (erased (Nat) gn)
    (many (KEnv h len sx gn) env) (unique (KdF h len c0 r0 g0 sx gn) s) -> (unique (KrF h len c0 r0 g0 sx gn) k))
  (let-match unique s (MkKdF _ _ _ _ _ _ _ ctu ca e gtr gtu gg kr ctr rf))
  (let-match many e (KLive _) ((KEmpty) (KDoneF h len c0 r0 g0 sx gn (MkKdF h len c0 r0 g0 sx gn ctu ca e gtr gtu gg kr ctr rf))))
  (let-match many env (MkKEnv _ _ lb us0 t0 tb0 lu0 n off of _ _ xl xs xf xpr xpk xhb))
  (let-match unique gg (MkGA _ _ _ _ _ gus gua glu gmu gts gtt glt gmt))
  (let ((unique gtt1) (many cr)) (live-c gts gtt xl h sx (Zero) xf gn xpr xpk (GSG gtr) gmt))
  (let-match many cr (LcLive _ _ _ lvr)
    ((LcDead _ _)
      (KDoneF h len c0 r0 g0 sx gn (MkKdF h len c0 r0 g0 sx gn ctu ca e gtr gtu (MkGA h gn sx gtr gtu gus gua glu gmu gts gtt1 glt gmt) kr ctr rf))))
  (let-match unique ca (MkCtA _ _ _ us a tb lu ls fa rml lv ws g wz lw qt))
  (let ((unique gua1) (many cu)) (live-c gus gua xl h sx (Zero) xf gn xpr xpk (GSG gtu) gmu))
  (let-match many cu (LcLive _ _ _ _)
    ((LcDead _ _)
      (let ((erased vs) (unique v) (erased lz) (erased fz)) (cnt-zeros us0 n lu0))
      (let ((erased gts2) (unique gtt2) (erased _) (erased glt2) (erased gmt2)) (gw-none xl sx (Zero) xf h gn gn xpr xpk (lt-succ gn) gus (GSG gtu) gmu gts gtt1 glt))
      (KDoneF h len c0 r0 g0 sx gn (MkKdF h len c0 r0 g0 sx gn (CEmpty)
        (MkCtA h len (CEmpty) ws g wz lw ls fa rml (LvE ls flag-live (Succ h) (Zero)) vs v (tally-zeros us0 vs (Succ h) (Zero) len t0 tb0 lu0 lz fz) lz qt)
        (KEmpty) (GEmpty) (GEmpty) (MkGA h gn sx (GEmpty) (GEmpty) gus gua1 glu gmu gts2 gtt2 glt2 gmt2) (KREmpty h c0 r0 g0 ctu gtr kr) ctr rf))))
  (let-match unique rf (MkRm _ _ ms m rm _ fs fz rfs gen gnb))
  (let ((erased keep) (erased gone) (erased c) (erased hk) (erased hg) (many e2) (erased us2) (unique a2) (erased tk) (erased lu2) (erased _) (erased ls2)
      (unique fa2) (erased rml2) (erased lv2) (erased ws2) (unique g2) (erased tg) (erased lw2) (erased fg) (erased T) (unique qT) (erased al) (erased zt) (erased fs2)
      (unique fz2) (erased rfs2) (erased lvg) (unique gtt2))
    (srestrict h xl xs sx xf gn xpr xpk xhb gtr gts gtt1 gmt lvr ctu len lb us a tb lu ls fa rml lv off of fs fz rfs gen gnb ws g wz lw qt))
  (let ((unique g3) (erased ms2) (unique m2) (erased rm2) (erased ctr2) (erased rl) (erased f) (unique fz3))
    (ctr-flags h ws2 g2 fg gone tg ms m rm fs2 fz2 rfs2 gen gnb lvg))
  (let ((many gen2) (erased gnb2)) (gen-next gen))
  (let-match unique qT (MkTq _ qxs qb qcap ql qcb qau qk qkc qov qr qu))
  (let ((erased ws3) (unique g4) (erased lw3) (erased wz3) (unique qb2)) (zero-t len (Succ h) ws2 g3 lw2 qxs qb qk (lt-le-trans _ _ _ qkc (LtS _ _ qcb)) qov T qr al zt))
  (let ((erased hc)) (canon-h (Succ h) ctu (tally-canon us (Succ h) (Zero) ctu tb)))
  (KGoF h len c0 r0 g0 sx gn (MkKgF h len c0 r0 g0 sx gn keep (MkCtA h len keep us2 a2 tk lu2 ls2 fa2 rml2 lv2 ws3 g4 wz3 lw3
      (qu (Nil _) qxs (at) qb2 (at) qcap ql qcb qau (Zero) (LtZ qcap) (Nil _) (tqr-nil qxs))) e2 gtr gtu
    (MkGA h gn sx gtr gtu gus gua1 glu gmu gts gtt2 glt gmt) (KRRestr h c0 r0 g0 ctu keep gone gtr gtu kr hc hk c)
    ctr2 (CRGone h c0 r0 g0 ctu keep gone ctr2 gtr gtu kr hc hg c rl) (MkRm h ctr2 ms2 m2 rm2 f fs2 fz3 rfs2 gen2 gnb2))))

(def-fns _ $ (many ktf-u : (erased (Ctree) c0 r0) (erased (Gtree) g0) (subterm many (Nat) d) (many (Nat) h) (erased (Nat) len) (erased (Sx) sx) (erased (Nat) gn)
    (many (KEnv h len sx gn) env) (unique (KgF h len c0 r0 g0 sx gn) s) -> (unique (KdF h len c0 r0 g0 sx gn) r))
  (let-match many d (Succ d1)
    ((Zero)
      (let-match unique s (MkKgF _ _ _ _ _ _ _ ctu ca e _ gtu gg kr ctr cr rf))
      (let-match unique rf (MkRm _ _ ms m rm f fs fz rfs gen gnb))
      (let-match unique gg (MkGA _ _ _ _ _ gus gua glu gmu gts gtt glt _))
      (let-match many env (MkKEnv _ _ _ _ _ _ _ _ _ _ _ _ xl xs xf xpr xpk xhb))
      (let ((unique m2) (erased gus2) (unique gua2) (erased glu2) (erased gts2) (unique gtt2) (erased glt2) (erased hit) (erased miss) (erased pt) (erased hs)
          (erased gmu2) (erased gmt2))
        (gwalk xl xs sx xf h gn xpr xpk xhb gtu gus gua glu gmu gts gtt glt ms m (room-fit ms (Succ h) rm) ctr f))
      (MkKdF h len c0 r0 g0 sx gn ctu ca e hit miss (MkGA h gn sx hit miss gus2 gua2 glu2 gmu2 gts2 gtt2 glt2 gmt2)
        (KRSplit h c0 r0 g0 ctu ctr gtu hit miss kr cr pt hs) ctr (MkRm h ctr ms m2 rm f fs fz rfs gen gnb))))
  (let ((unique s1)) (notail $ ktf-u c0 r0 g0 d1 h len sx gn env s))
  (let ((unique s2))
    (match unique (ktf-step c0 r0 g0 h len sx gn env s1) (((KdF h len c0 r0 g0 sx gn) r))
      ((KDoneF _ _ _ _ _ _ _ x) x)
      ((KGoF _ _ _ _ _ _ _ x) (notail $ ktf-u c0 r0 g0 d1 h len sx gn env x))))
  (match unique (ktf-step c0 r0 g0 h len sx gn env s2) _
    ((KDoneF _ _ _ _ _ _ _ x) x)
    ((KGoF _ _ _ _ _ _ _ x) (tail $ ktf-u c0 r0 g0 d1 h len sx gn env x))))

; sx has the shape of gs, of depth j.
(def-adts $ (Shp : ((Nat) j) ((Sx) sx) ((GSet) gs) -> Type)
  enum
  (many ShX : (erased (Nat) j) -> (Shp j (SxX) (GSG (GEmpty))))
  (many ShO : (erased (Nat) i) -> (Shp (Zero) (SxO i) (GSOne)))
  (many ShN : (erased (Nat) j i) (erased (Sx) t0 t1 t2 t3) (erased (GSet) a0 a1 a2 a3 gs) (erased (Shp j t0 a0) p0) (erased (Shp j t1 a1) p1)
      (erased (Shp j t2 a2) p2) (erased (Shp j t3 a3) p3) (erased (GTop j a0 a1 a2 a3 gs) tp) -> (Shp (Succ j) (SxN i t0 t1 t2 t3) gs)))

(def-fns _ $ (erased shp-gm : (erased (List (U8)) us) (erased (Nat) j lo hi n) (erased (Sx) sx) (erased (GSet) gs) (subterm erased (Shp j sx gs) shp)
    (erased (Span sx lo hi) sp) (erased (Lt hi (Succ n)) hn) (erased (Sz flag-w us n) z) (erased (Fill flag-w us (Succ (Zero))) rp) ->
    (erased (Gm us j sx gs) m))
  (match erased shp _
    ((ShX _) (GmX us j))
    ((ShO i) (let-match erased sp (SpO _)) (GmO1 us i (fill-elt flag-w us n (Succ (Zero)) i rp z (lt-le-trans _ _ _ (lt-succ i) hn))))
    ((ShN j1 i t0 t1 t2 t3 a0 a1 a2 a3 _ p0 p1 p2 p3 tp)
      (let-match erased sp (SpN _ h1 h2 h3 _ _ _ _ _ s0 s1 s2 s3))
      (let ((erased _) (erased _) (erased _) (erased ih)) (span-n i h1 h2 h3 hi t0 t1 t2 t3 s0 s1 s2 s3))
      (let ((erased n3)) (le-trans _ _ _ (span-le t3 h3 hi s3) hn))
      (let ((erased n2)) (le-trans _ _ _ (span-le t2 h2 h3 s2) n3))
      (let ((erased n1)) (le-trans _ _ _ (span-le t1 h1 h2 s1) n2))
      (GmN1 us j1 i t0 t1 t2 t3 a0 a1 a2 a3 gs (fill-elt flag-w us n (Succ (Zero)) i rp z (lt-le-trans _ _ _ ih hn))
        (shp-gm us j1 (Succ i) h1 n t0 a0 p0 s0 n1 z rp) (shp-gm us j1 h1 h2 n t1 a1 p1 s1 n2 z rp) (shp-gm us j1 h2 h3 n t2 a2 p2 s2 n3 z rp)
        (shp-gm us j1 h3 hi n t3 a3 p3 s3 hn z rp) tp))))

(def-fns _ $ (erased gm-clear : (erased (List (U8)) us ws) (erased (Nat) j lo hi n) (erased (Sx) sx) (erased (GSet) gs) (erased (Gm us (Succ j) sx gs) m)
    (erased (Span sx lo hi) sp) (erased (Lt hi (Succ n)) hn) (erased (Sz flag-w ws n) z) (erased (Fill flag-w ws (Zero)) rp) ->
    (erased (Gm ws (Succ j) sx (GSG (GEmpty))) r))
  (let-match erased m (GmN1 _ _ i t0 t1 t2 t3 _ _ _ _ _ _ _ _ _ _ _)
    ((GmX _ _) (GmX ws (Succ j)))
    ((GmN0 _ _ i t0 t1 t2 t3 _)
      (let-match erased sp (SpN _ h1 h2 h3 _ _ _ _ _ s0 s1 s2 s3))
      (let ((erased _) (erased _) (erased _) (erased ih)) (span-n i h1 h2 h3 hi t0 t1 t2 t3 s0 s1 s2 s3))
      (GmN0 ws j i t0 t1 t2 t3 (fill-elt flag-w ws n (Zero) i rp z (lt-le-trans _ _ _ ih hn)))))
  (let-match erased sp (SpN _ h1 h2 h3 _ _ _ _ _ s0 s1 s2 s3))
  (let ((erased _) (erased _) (erased _) (erased ih)) (span-n i h1 h2 h3 hi t0 t1 t2 t3 s0 s1 s2 s3))
  (GmN0 ws j i t0 t1 t2 t3 (fill-elt flag-w ws n (Zero) i rp z (lt-le-trans _ _ _ ih hn))))

(def-fns _ $ (many sx-slot : (many (Bool) b) (many (Nat) lo) ->
    (erased (Sx) x) (many (Nat) hi) (erased (Span x lo hi) sp) (erased (GSet) gs) (erased (BSet b gs) q) (erased (Shp (Zero) x gs) shp))
  (match many b _
    ((BTrue) (values (SxO lo) (Succ lo) (SpO lo) (GSOne) (BSetT) (ShO lo)))
    ((BFalse) (values (SxX) lo (SpX lo) (GSG (GEmpty)) (BSetF) (ShX (Zero))))))

(def-fns _ $ (many sx-of : (subterm many (Gtree) g) (many (Nat) j) (many (Nat) lo) ->
    (erased (Sx) x) (many (Nat) hi) (erased (Span x lo hi) sp) (many (ErasedMaybe (Shp j x (GSG g))) shp))
  (let ((many lo1)) (Succ lo))
  (let-match many j (Succ j1) ((Zero) (values (SxX) lo (SpX lo) (ENone _))))
  (let-match many g (GNode t0 t1 t2 t3)
    ((GEmpty) (values (SxX) lo (SpX lo) (ESome _ (ShX j))))
    (else
      (let-match many j1 (Zero) (else (values (SxX) lo (SpX lo) (ENone _))))
      (let-match many (gtree-kind g) (GKLeaf _ q l) ((GKNode _ _ _ _ _ _) (values (SxX) lo (SpX lo) (ENone _))))
      (let ((many b0) (many b1) (many b2) (many b3) (erased gb)) (gbits-c g))
      (let-match erased gb (GBLeaf _ _ l2) (absurd (GBNode _ _ _ _) l))
      (let ((erased o0) (many k1) (erased p0) (erased a0) (erased q0) (erased h0)) (sx-slot b0 lo1))
      (let ((erased o1) (many k2) (erased p1) (erased a1) (erased q1) (erased h1)) (sx-slot b1 k1))
      (let ((erased o2) (many k3) (erased p2) (erased a2) (erased q2) (erased h2)) (sx-slot b2 k2))
      (let ((erased o3) (many k4) (erased p3) (erased a3) (erased q3) (erased h3)) (sx-slot b3 k3))
      (values (SxN lo o0 o1 o2 o3) k4 (SpN lo k1 k2 k3 k4 o0 o1 o2 o3 p0 p1 p2 p3)
        (ESome _ (ShN (Zero) lo o0 o1 o2 o3 a0 a1 a2 a3 (GSG g) h0 h1 h2 h3 (GTL g b0 b1 b2 b3 a0 a1 a2 a3 l2 q0 q1 q2 q3))))))
  (let-match many j1 (Succ j2) ((Zero) (values (SxX) lo (SpX lo) (ENone _))))
  (let ((erased x0) (many k1) (erased p0) (many r0)) (notail $ sx-of t0 j1 lo1))
  (let ((erased x1) (many k2) (erased p1) (many r1)) (notail $ sx-of t1 j1 k1))
  (let ((erased x2) (many k3) (erased p2) (many r2)) (notail $ sx-of t2 j1 k2))
  (let ((erased x3) (many k4) (erased p3) (many r3)) (notail $ sx-of t3 j1 k3))
  (let ((erased x)) (SxN lo x0 x1 x2 x3))
  (let ((erased sp)) (SpN lo k1 k2 k3 k4 x0 x1 x2 x3 p0 p1 p2 p3))
  (let-match many r0 (ESome _ h0) ((ENone _) (values x k4 sp (ENone _))))
  (let-match many r1 (ESome _ h1) ((ENone _) (values x k4 sp (ENone _))))
  (let-match many r2 (ESome _ h2) ((ENone _) (values x k4 sp (ENone _))))
  (let-match many r3 (ESome _ h3) ((ENone _) (values x k4 sp (ENone _))))
  (values x k4 sp (ESome _ (ShN j1 lo x0 x1 x2 x3 (GSG t0) (GSG t1) (GSG t2) (GSG t3) (GSG g) h0 h1 h2 h3 (GTN j2 t0 t1 t2 t3)))))

; What sx-pk makes of the gtree g: the static tree x of depth j with entries [lo, hi) and presence f, its records written into xl2.
(def-adts $ (Sq : ((List (U8)) xl) ((List (U8)) xl2) ((Nat) len) ((Nat) j) ((Sx) x) ((Nat) lo) ((Nat) hi) ((Nat) f) ((Gtree) g) -> Type)
  enum
  (many MkSq : (erased (List (U8)) xl xl2) (erased (Nat) len j) (erased (Sx) x) (erased (Nat) lo hi f) (erased (Gtree) g) (erased (Sz flag-w xl2 len) l2)
      (erased (Wr rcd-w xl xl2 lo hi) w) (erased (Pk xl2 j x lo hi) pk)
      (erased (Shp j x (GSG g)) shp) (erased (Prs x f) pr) (erased (Lt hi u62-modulus) hb) -> (Sq xl xl2 len j x lo hi f g)))

(def-fns _ $ (many slot-pk : (erased (List (U8)) xl) (many (Bool) b) (many (Nat) lo) ->
    (erased (Sx) x) (many (Nat) hi f) (erased (GSet) gs) (erased (BSet b gs) q) (erased (Shp (Zero) x gs) shp) (erased (Prs x f) pr)
    (erased (Pk xl (Zero) x lo hi) pk))
  (match many b _
    ((BTrue) (values (SxO lo) (Succ lo) (Succ (Zero)) (GSOne) (BSetT) (ShO lo) (PrO lo) (PkO xl lo)))
    ((BFalse) (values (SxX) lo (Zero) (GSG (GEmpty)) (BSetF) (ShX (Zero)) (PrX) (PkX xl (Zero) lo)))))

(def-fns _ $ (erased pk-lt : (erased (List (U8)) xl) (erased (Nat) j lo hi) (erased (Sx) t0 t1 t2 t3) (erased (Pk xl (Succ j) (SxN lo t0 t1 t2 t3) lo hi) pk)
    -> (erased (Lt lo hi) r))
  (let-match erased pk (PkN _ _ _ h1 h2 h3 _ _ _ _ _ _ _ _ _ p0 p1 p2 p3 _ _ _ _ _))
  (let ((erased _) (erased _) (erased _) (erased a))
    (span-n lo h1 h2 h3 hi t0 t1 t2 t3 (pk-span xl j (Succ lo) h1 t0 p0) (pk-span xl j h1 h2 t1 p1) (pk-span xl j h2 h3 t2 p2) (pk-span xl j h3 hi t3 p3)))
  a)

(def-fns _ $ (many sx-pk : (subterm many (Gtree) g) (many (Nat) j lo) (erased (List (U8)) xl) (unique (Bytes xl) xb) (many (Nat) len)
    (erased (Sz flag-w xl len) l) (erased (Lt len u62-modulus) lb) ->
    (erased (Sx) x) (many (Nat) hi f) (erased (List (U8)) xl2) (unique (Bytes xl2) xb2 at xb) (many (ErasedMaybe (Sq xl xl2 len j x lo hi f g)) r))
  (let ((many lo1)) (Succ lo))
  (let-match many (nat-fits-u62 lo) (Yes _ _ _ _ lob) ((No _ _ _ _ _) (values (SxX) lo (Zero) xl xb (ENone _))))
  (let-match many j (Succ j1) ((Zero) (values (SxX) lo (Zero) xl xb (ENone _))))
  (let-match many g (GNode t0 t1 t2 t3)
