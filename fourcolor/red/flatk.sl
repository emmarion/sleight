  (let ((many d) (erased ad)) (add m m))
  (let ((many q) (erased aq)) (add d m))
  (let ((many len) (erased w)) (tail $ pw3-c j1 q))
  (values len (PwS j1 m q len (adds-thrice m d q ad aq) w)))

