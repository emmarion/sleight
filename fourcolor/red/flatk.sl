(def-adts $ (CtA : ((Nat) h) ((Nat) len) ((Ctree) ctu) -> Type)
  enum
  (many MkCtA : (erased (Nat) h len) (erased (Ctree) ctu) (erased (List Cnt) us) (unique (Array Cnt us) a) (erased (Tally us (Succ h) (Zero) ctu) tb)
      (erased (Length Cnt us len) lu) (erased (List Cnt) ls) (unique (Array Cnt ls) fa) (erased (Room ls (Succ h)) rm)
      (erased (Lv ls flag-live (Succ h) (Zero) ctu) lv) (erased (List Cnt) ws) (unique (Array Cnt ws) g) (erased (Tally ws (Succ h) (Zero) (CEmpty)) wz)
      (erased (Length Cnt ws len) lw) -> (CtA h len ctu)))

(def-adts $ (Rm : ((Nat) h) ((Ctree) ctr) -> Type)
  enum
  (many MkRm : (erased (Nat) h) (erased (Ctree) ctr) (erased (List Cnt) ms) (unique (Array Cnt ms) m) (erased (Room ms (Succ h)) rm)
      (erased (Flags ms (Succ h) (Zero) ctr) f) (erased (List Cnt) fs) (unique (Array Cnt fs) fz) (erased (Room fs (Succ h)) rf) (many (Nat) gen)
      (erased (Lt gen u62-modulus) gnb) -> (Rm h ctr)))

(def-fns _ $ (many gen-next : (many (Nat) g) (erased (Lt g u62-modulus) gb) -> (many (Nat) g2) (erased (Lt g2 u62-modulus) gb2))
  (match many (nat-fits-u62 (Succ g)) _ ((Yes _ _ _ _ b) (values (Succ g) b)) ((No _ _ _ _ _) (values g gb))))

(def-adts $ (KEnv : ((Nat) h) ((Nat) len) -> Type)
  enum
  (many MkKEnv : (erased (Nat) h len) (erased (Lt len u62-modulus) lb) (erased (List Cnt) us) (erased (Ctree) t) (erased (Tally us (Succ h) (Zero) t) tb)
      (erased (Length Cnt us len) lu) (many len is n) (many (Nat) off) (erased (Offs (Succ h) off) of) -> (KEnv h len)))

(def-adts $ (KdF : ((Nat) h) ((Nat) len) ((Ctree) c0 r0) ((Gtree) g0) -> Type)
  enum
  (many MkKdF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (erased (Ctree) ctu) (unique (CtA h len ctu) ca) (many (KeepE ctu) e)
      (many (Gtree) gtr) (unique (UGtree) gu) (erased (Gtree) gtu) (many (GKeep gtu) ge) (erased (KR h c0 r0 g0 ctu gtr gtu) kr) (erased (UG gu gtu) ug)
      (erased (Ctree) ctr) (unique (Rm h ctr) rf) -> (KdF h len c0 r0 g0)))

(def-adts $ (KgF : ((Nat) h) ((Nat) len) ((Ctree) c0 r0) ((Gtree) g0) -> Type)
  enum
  (many MkKgF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (erased (Ctree) ctu) (unique (CtA h len ctu) ca) (many (KeepE ctu) e)
      (unique (UGtree) gu) (erased (Gtree) gtu) (many (GKeep gtu) ge) (erased (KR h c0 r0 g0 ctu (GEmpty) gtu) kr) (erased (UG gu gtu) ug)
      (erased (Ctree) ctr) (erased (CR h c0 r0 g0 ctr) cr) (unique (Rm h ctr) rf) -> (KgF h len c0 r0 g0)))

(def-adts $ (KrF : ((Nat) h) ((Nat) len) ((Ctree) c0 r0) ((Gtree) g0) -> Type)
  enum
  (many KDoneF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (unique (KdF h len c0 r0 g0) s) -> (KrF h len c0 r0 g0))
  (many KGoF : (erased (Nat) h len) (erased (Ctree) c0 r0) (erased (Gtree) g0) (unique (KgF h len c0 r0 g0) s) -> (KrF h len c0 r0 g0)))

(def-fns _ $ (many ktf-step : (erased (Ctree) c0 r0) (erased (Gtree) g0) (many (Nat) h) (erased (Nat) len) (many (KEnv h len) env)
    (unique (KdF h len c0 r0 g0) s) -> (unique (KrF h len c0 r0 g0) k))
  (let-match unique s (MkKdF _ _ _ _ _ ctu ca e gtr gu gtu ge kr ug ctr rf))
  (let-match many e (KLive _) ((KEmpty) (KDoneF h len c0 r0 g0 (MkKdF h len c0 r0 g0 ctu ca e gtr gu gtu ge kr ug ctr rf))))
  (let-match many gtr (GEmpty) (else
    (let-match many env (MkKEnv _ _ lb us0 t0 tb0 lu0 n off of))
    (let-match unique ca (MkCtA _ _ _ us a tb lu ls fa rml lv ws g wz lw))
    (let-match many ge (GKLive _) ((GKEmpty)
      (let ((erased vs) (unique v) (erased rp)) (array-make (U62) n (MkU62 (Zero) u62-modulus-pos)))
      (KDoneF h len c0 r0 g0 (MkKdF h len c0 r0 g0 (CEmpty)
        (MkCtA h len (CEmpty) ws g wz lw ls fa rml (LvE ls flag-live (Succ h) (Zero)) vs v (tally-zeros us0 vs (Succ h) (Zero) len t0 tb0 lu0 rp)
          (repeat-length _ len _ vs rp))
        (KEmpty) (GEmpty) (UGEmpty) (GEmpty) (GKEmpty) (KREmpty h c0 r0 g0 ctu gtr kr) (UGE) ctr rf))))
    (let-match unique rf (MkRm _ _ ms m rm _ fs fz rfs gen gnb))
    (let ((erased keep) (erased gone) (erased c) (erased hk) (erased hg) (many e2) (erased us2) (unique a2) (erased tk) (erased lu2) (erased _) (erased ls2)
        (unique fa2) (erased rml2) (erased lv2) (erased ws2) (unique g2) (erased tg) (erased lw2) (erased fg) (many T) (erased al) (erased zt) (erased fs2)
        (unique fz2) (erased rfs2) (erased lvg))
      (srestrict h gtr ctu len lb us a tb lu ls fa rml lv off of fs fz rfs gen gnb ws g wz lw))
    (let ((unique g3) (erased ms2) (unique m2) (erased rm2) (erased ctr2) (erased rl) (erased f) (unique fz3))
      (ctr-flags h ws2 g2 fg gone tg ms m rm fs2 fz2 rfs2 gen gnb lvg))
    (let ((many gen2) (erased gnb2)) (gen-next gen gnb))
    (let ((erased ws3) (unique g4) (erased lw3) (erased wz3)) (zero-t len (Succ h) ws2 g3 lw2 T al zt))
    (let ((erased hc)) (canon-h (Succ h) ctu (tally-canon us (Succ h) (Zero) ctu tb)))
    (KGoF h len c0 r0 g0 (MkKgF h len c0 r0 g0 keep (MkCtA h len keep us2 a2 tk lu2 ls2 fa2 rml2 lv2 ws3 g4 wz3 lw3) e2 gu gtu ge (KRRestr h c0 r0 g0 ctu keep gone gtr gtu kr hc hk c) ug
      ctr2 (CRGone h c0 r0 g0 ctu keep gone ctr2 gtr gtu kr hc hg c rl) (MkRm h ctr2 ms2 m2 rm2 f fs2 fz3 rfs2 gen2 gnb2)))))
  (KDoneF h len c0 r0 g0 (MkKdF h len c0 r0 g0 ctu ca e gtr gu gtu ge kr ug ctr rf)))

(def-fns _ $ (many ktf-u : (erased (Ctree) c0 r0) (erased (Gtree) g0) (subterm many (Nat) d) (many (Nat) h) (erased (Nat) len) (many (KEnv h len) env)
    (unique (KgF h len c0 r0 g0) s) -> (unique (KdF h len c0 r0 g0) r))
  (let-match many d (Succ d1)
    ((Zero)
      (let-match unique s (MkKgF _ _ _ _ _ ctu ca e gu gtu ge kr ug ctr cr rf))
      (let-match unique rf (MkRm _ _ ms m rm f fs fz rfs gen gnb))
      (let ((unique m2) (many hit) (unique mu) (erased miss) (erased um) (erased pt) (erased hs) (many me))
        (ctr-gsplit gu gtu ug h ms m (room-fit ms (Succ h) rm) ctr f))
      (MkKdF h len c0 r0 g0 ctu ca e hit mu miss (gk-drop miss _ _ me) (KRSplit h c0 r0 g0 ctu ctr gtu hit miss kr cr pt hs) um ctr (MkRm h ctr ms m2 rm f fs fz rfs gen gnb))))
  (let ((unique s1)) (notail $ ktf-u c0 r0 g0 d1 h len env s))
  (let ((unique s2))
    (match unique (ktf-step c0 r0 g0 h len env s1) (((KdF h len c0 r0 g0) r))
      ((KDoneF _ _ _ _ _ x) x)
      ((KGoF _ _ _ _ _ x) (notail $ ktf-u c0 r0 g0 d1 h len env x))))
  (match unique (ktf-step c0 r0 g0 h len env s2) _
    ((KDoneF _ _ _ _ _ x) x)
    ((KGoF _ _ _ _ _ x) (tail $ ktf-u c0 r0 g0 d1 h len env x))))

(def-adts $ (FlatIn : ((Nat) h) ((Ctree) ctu) -> Type)
  enum
  (many MkFlatIn : (erased (Nat) h) (erased (Ctree) ctu) (erased (List Cnt) us ws ms ls) (many (Array Cnt us) a) (erased (SInit h ctu us ws) si)
      (many (Array Cnt ms) m) (erased (Room ms (Succ h)) rm) (many (Array Cnt ls) fl) (erased (Room ls (Succ h)) rml)
      (erased (Lv ls flag-live (Succ h) (Zero) ctu) lv) -> (FlatIn h ctu)))

(def-fns _ $ (many flat-in : (many (Nat) h) (many (Ctree) ctu) (erased (CtH (Succ h) ctu) hc) -> (many (Maybe (FlatIn h ctu)) r))
  (let ((erased us) (erased ws) (unique a) (unique _) (many t)) (sinit h ctu hc))
  (let-match many t (TryOk _ si) ((TryNo _) (None _)))
  (let ((erased ms) (unique m0) (many q)) (room-new (Succ h)))
  (let-match many q (TryOk _ rm) ((TryNo _) (None _)))
  (let ((many m)) (share m0))
  (let ((erased ls) (unique l) (erased rml) (many tf)) (room-flags (Succ h) ctu hc ms (array-copy _ _ m) rm))
  (let-match many tf (TryOk _ f) ((TryNo _) (None _)))
  (Some _ (MkFlatIn h ctu us ws ms ls (share a) si m rm (share l) rml (flags-lv ls (Succ h) (Zero) ctu f))))

(def-fns _ $ (many kempe-tree-f : (erased Pred P) (many (Nat) h) (erased (Ctree) ctu) (many (Ctree) ctr) (many (Gtree) gtu)
    (erased (CEv ctu (ESStart)) ce) (erased (GE ctu (Cons RS (MkRx (GSet) (BS0) (GSG gtu)) (Nil RS)) (ESStart) (Succ h)) ge)
    (erased (GCov (GSG gtu) (Zero) (BFalse) (Succ h)) gc) (erased (CtAllP P ctr (Nil (Col))) ca) (erased (CtH (Succ h) ctr) hr) (many (FlatIn h ctu) fi) ->
    (many (Ctree) ct) (many (Try (KSound P h ct)) ks))
  (let-match many fi (MkFlatIn _ _ us _ ms ls a si m rm fl rml lv))
  (let-match erased si (MkSInit _ _ _ _ len lb tb lu _ _))
  (let ((many n) (erased ln)) (array-length-many _ us a))
  (let-match erased (length-fn _ us len n lu ln) (Refl _ _))
  (let ((unique m1)) (array-copy _ _ m))
  (let ((unique fz)) (array-copy _ _ m))
  (let ((erased ms2) (unique m2) (erased rm2) (many tf)) (room-flags (Succ h) ctr hr ms m1 rm))
  (let-match many tf (TryOk _ f) ((TryNo _) (values ctr (TryNo _))))
  (let ((unique gu) (erased ug) (many ge2)) (ug-of gtu))
  (let ((unique a1)) (array-copy _ _ a))
  (let ((unique fa)) (array-copy _ _ fl))
  (let ((many off) (erased of)) (offs-c (Succ h)))
  (let ((erased ws) (unique g) (erased rp)) (array-make (U62) n (MkU62 (Zero) u62-modulus-pos)))
  (let-match unique
    (ktf-u ctu ctr gtu (Succ $ Succ h) h len (MkKEnv h len lb us ctu tb lu n off of)
      (MkKgF h len ctu ctr gtu ctu (MkCtA h len ctu us a1 tb lu ls fa rml lv ws g (tally-zeros us ws (Succ h) (Zero) len ctu tb lu rp) (repeat-length _ len _ ws rp)) (KLive ctu) gu gtu ge2 (KRBase h ctu ctr gtu) ug ctr (CRBase h ctu ctr gtu)
        (MkRm h ctr ms2 m2 rm2 f ms fz rm flag-live flag-one-lt)))
    (MkKdF _ _ _ _ _ c2 ca2 _ gtr _ gtu2 _ kr _ _ _))
  (let-match unique ca2 (MkCtA _ _ _ us2 a2 tb2 lu2 ls2 fa2 rml2 lv2 _ _ _ _))
  (let-match erased rml2 (MkRoom _ _ lenL ll lbl tfl))
  (let ((unique _) (many ct)) (tally-tree (Succ h) (Zero) (Zero) us2 (share a2) (MkFit us2 len lu2 lb) c2 tb2 ls2 fa2 lenL ll lbl tfl lv2))
  (values ct (TryOk _ (MkKSound P h ct gtr gtu2 (kr-kv P h ctu ctr gtu (KVBase P h ctu gtu ce ge gc) (CKBase P h ctr ca) ct gtr gtu2 kr)))))
