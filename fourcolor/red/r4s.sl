; One pair of the leaves' walk at depth k: dropped by its trie node, of entry 0 in us, or kept and hit at the leaf gs.
(def-adts $ (SL1 : ((Nat) k) ((GSet) gs) ((WP) x) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many S1Drop : (erased (List (U8)) us) (erased (Nat) k q o n) (erased (GSet) gs) (erased (Bstack) bs) (erased (List (WEv)) E0) (erased (Offs k o) of)
      (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z) -> (SL1 k gs (MkWP q bs) E0 (Cons (WEv) (WDrop us k (Succ (Zero)) q o n of ad z) E0)))
  (many S1Keep : (erased (List (U8)) us) (erased (Nat) k q o n v) (erased (GSet) gs) (erased (Bstack) bs) (erased (List (WEv)) E0 E) (erased (Offs k o) of)
      (erased (Add o q n) ad) (erased (Elt flag-w us n v) x) (erased (Apart (Nat) Lt v (Zero)) nz) (erased (WLf gs (Cons (WP) (MkWP q bs) (Nil (WP))) E0 E) f)
      -> (SL1 k gs (MkWP q bs) E0 E)))

; The pairs of Q at depth k in turn, in the leaves' walk.
(def-adts $ (SLv : ((Nat) k) ((GSet) gs) ((List (WP)) Q) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many SlNil : (erased (Nat) k) (erased (GSet) gs) (erased (List (WEv)) E0) -> (SLv k gs (Nil (WP)) E0 E0))
  (many SlCons : (erased (Nat) k) (erased (GSet) gs) (erased (WP) x) (erased (List (WP)) Q) (erased (List (WEv)) E0 E1 E) (erased (SL1 k gs x E0 E1) a)
      (erased (SLv k gs Q E1 E) l) -> (SLv k gs (Cons (WP) x Q) E0 E)))

(def-adts
  ; red4's swalk of the pairs P, at depth k, down gs, for traces of j more colours, makes E from E0.
  ((SWk : ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
    enum
    (many SwNil : (erased (Nat) k j) (erased (GSet) gs) (erased (List (WEv)) E0) -> (SWk k j gs (Nil (WP)) E0 E0))
    (many SwLeaf : (erased (Nat) k) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E) (erased (WLf gs P E0 E) l) -> (SWk k (Succ (Zero)) gs P E0 E))
    (many SwStep : (erased (Nat) k j) (erased (GSet) gs g0 g1 g2 g3) (erased (List (WP)) P Q0 Q1 Q2 Q3) (erased (List (WEv)) E0 E1 E2 E3 E4)
        (erased (SSy k j gs P (GPush) g0 Q0 E0 E1) y0) (erased (SSy k j gs P (GSkip) g1 Q1 E1 E2) y1) (erased (SSy k j gs P (GPop0) g2 Q2 E2 E3) y2)
        (erased (SSy k j gs P (GPop1) g3 Q3 E3 E4) y3) -> (SWk k (Succ (Succ j)) gs P E0 E4)))
  ; The walk's part for the symbol s, whose child g1 the pairs Q reach: none, a filter then a walk, or red4's sleaves above leaves.
  ((SSy : ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((Gsym) s) ((GSet) g1) ((List (WP)) Q) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
    enum
    (many SyNone : (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0) (erased (GSel gs s g1) sl)
        (erased (WStp s P Q) st) (erased (NoMC g1 (Succ j)) z) -> (SSy k j gs P s g1 Q E0 E0))
    (many SyGo : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q R) (erased (Gsym) s) (erased (List (WEv)) E0 E1 E)
        (erased (GSel gs s g1) sl) (erased (WStp s P Q) st) (erased (WFlt us (Succ k) (Succ j) Q R E0 E1) f) (erased (SWk (Succ k) (Succ j) g1 R E1 E) w)
        -> (SSy k j gs P s g1 Q E0 E))
    (many SyLvs : (erased (Nat) k) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0 E) (erased (GSel gs s g1) sl)
        (erased (WStp s P Q) st) (erased (SLv (Succ k) g1 Q E0 E) v) -> (SSy k (Zero) gs P s g1 Q E0 E))))

(def-fns _ $ (erased slv-trace : (erased (Nat) k q2 ks i c0) (erased (Bool) d0) (erased (GSet) gs) (erased (List (WP)) Q) (erased (List (WEv)) E0 E) (erased (Col) e)
    (subterm erased (SLv k gs Q E0 E) v) (erased (TIdx q2 (Cons (Col) e (Nil (Col))) i) ti) (erased (WCt Q gs q2 (Cons (Col) e (Nil (Col))) ks) pc)
    (erased (WSm E0 i c0 d0) sm) -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WGr c0 d0 ks c1 d1) g))
  (let ((erased rest)) (Cons (Col) e (Nil (Col))))
  (let ((erased le)) (LengthCons _ e (Nil _) (Zero) (LengthNil _)))
  (let-match erased ti (TICons _ x _ _ _ ke ti1))
  (let-match erased ti1 (TINil _))
  (let-match erased v (SlCons _ _ _ Q1 _ E1 _ sa v1)
    ((SlNil _ _ _) (let-match erased pc (WcNil _ _ _)) (values c0 d0 sm (wgr-exact c0 (Zero) c0 d0 (add-zero-right c0)))))
  (match erased sa _
    ((S1Drop us _ q o n _ bs _ of ad z)
      (let-match erased pc (WcHit _ a c' _ _ _ _ _ _ pc1 adc)
        ((WcMiss _ _ _ _ _ _ _ ap pc1)
          (slv-trace k q2 ks i c0 d0 gs Q1 E1 E e v1 ti pc1 (WmOut E0 us k (Succ (Zero)) q o n i c0 q2 d0 of ad z rest sm ti le ap))))
      (let ((erased c1) (erased d1) (erased sm1) (erased g)) (slv-trace k q2 c' i c0 (BTrue) gs Q1 E1 E e v1 ti pc1 (WmIn E0 us k (Succ (Zero)) q2 o n i c0 d0 of ad z rest sm ti le)))
      (values c1 d1 sm1 (wls-gr c0 ks c' c1 d0 (BTrue) d1 (WlsCov d0 ks c' (add-le-right a c' ks adc)) g)))
    ((S1Keep _ _ q _ _ _ _ bs _ _ _ _ _ _ f)
      (match erased pc _
        ((WcHit _ a c' _ _ _ _ _ m pc1 adc)
          (let ((erased x1) (erased s1) (erased a1)) (wlf-trace gs _ E0 E1 q2 i a c0 d0 e f (WcHit q2 a (Zero) a bs (Nil _) gs rest m (WcNil gs q2 rest) (add-zero-right a)) ke sm))
          (let ((erased c1) (erased d1) (erased sm1) (erased g)) (slv-trace k q2 c' i x1 d0 gs Q1 E1 E e v1 ti pc1 s1))
          (values c1 d1 sm1 (wgr-cat c0 a x1 c' c1 ks d0 d0 d1 (wgr-exact c0 a x1 d0 a1) g adc)))
        ((WcMiss _ _ _ _ _ _ _ ap pc1)
          (let ((erased x1) (erased s1) (erased a1)) (wlf-trace gs _ E0 E1 q2 i (Zero) c0 d0 e f (WcMiss q q2 (Zero) bs (Nil _) gs rest ap (WcNil gs q2 rest)) ke sm))
          (let-match erased (add-fn c0 (Zero) x1 c0 a1 (add-zero-right c0)) (Refl _ _))
          (slv-trace k q2 ks i c0 d0 gs Q1 E1 E e v1 ti pc1 s1))))))

(def-fns _ $ (erased ssy-parts : (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0 E)
    (erased (SSy k j gs P s g1 Q E0 E) y) -> (erased (GSel gs s g1) sl) (erased (WStp s P Q) st))
  (match erased y _
    ((SyNone _ _ _ _ _ _ _ _ sl st _) (values sl st))
    ((SyGo _ _ _ _ _ _ _ _ _ _ _ _ sl st _ _) (values sl st))
    ((SyLvs _ _ _ _ _ _ _ _ sl st _) (values sl st))))

(def-fns _
  ((erased sw-trace : (erased (Nat) k j q c i c0) (erased (Bool) d0) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E) (erased (List (Col)) rest)
      (subterm erased (SWk k j gs P E0 E) w) (erased (TIdx q rest i) ti) (erased (Length (Col) rest j) le) (erased (WCt P gs q rest c) pc) (erased (WSm E0 i c0 d0) sm)
      -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WGr c0 d0 c c1 d1) g))
    (match erased w _
      ((SwNil _ _ _ _) (let-match erased pc (WcNil _ _ _)) (values c0 d0 sm (wgr-exact c0 (Zero) c0 d0 (add-zero-right c0))))
      ((SwLeaf _ _ _ _ _ l)
        (let-match erased le (LengthCons _ e r1 _ le1))
        (let-match erased le1 (LengthNil _))
        (let-match erased ti (TICons _ iq _ _ _ ke ti1))
        (let-match erased ti1 (TINil _))
        (let ((erased c1) (erased sm1) (erased ad)) (wlf-trace gs P E0 E q i c c0 d0 e l pc ke sm))
        (values c1 d0 sm1 (wgr-exact c0 c c1 d0 ad)))
      ((SwStep _ j1 _ g0 g1 g2 g3 _ Q0 Q1 Q2 Q3 _ E1 E2 E3 _ y0 y1 y2 y3)
        (let-match erased le (LengthCons _ e rest1 _ le1))
        (let-match erased ti (TICons _ q2 _ _ _ kq ti1))
        (let ((erased s0) (erased t0)) (ssy-parts k j1 gs g0 P Q0 (GPush) E0 E1 y0))
        (let ((erased s1) (erased t1)) (ssy-parts k j1 gs g1 P Q1 (GSkip) E1 E2 y1))
        (let ((erased s2) (erased t2)) (ssy-parts k j1 gs g2 P Q2 (GPop0) E2 E3 y2))
        (let ((erased s3) (erased t3)) (ssy-parts k j1 gs g3 P Q3 (GPop1) E3 E y3))
        (let ((erased k0) (erased k1) (erased k2) (erased k3) (erased p0) (erased p1) (erased p2) (erased p3) (erased sm4))
          (wct-split q q2 c P gs g0 g1 g2 g3 s0 s1 s2 s3 e rest1 kq Q0 Q1 Q2 Q3 t0 t1 t2 t3 pc))
        (let ((erased ca) (erased da) (erased ma) (erased ga)) (sy-trace k j1 q2 k0 i c0 d0 gs g0 P Q0 (GPush) E0 E1 rest1 y0 ti1 le1 p0 sm))
        (let ((erased cb) (erased db) (erased mb) (erased gb)) (sy-trace k j1 q2 k1 i ca da gs g1 P Q1 (GSkip) E1 E2 rest1 y1 ti1 le1 p1 ma))
        (let ((erased cz) (erased dc) (erased mc) (erased gc)) (sy-trace k j1 q2 k2 i cb db gs g2 P Q2 (GPop0) E2 E3 rest1 y2 ti1 le1 p2 mb))
        (let ((erased cd) (erased dd) (erased md) (erased gd)) (sy-trace k j1 q2 k3 i cz dc gs g3 P Q3 (GPop1) E3 E rest1 y3 ti1 le1 p3 mc))
        (values cd dd md (wgr-sum c0 k0 k1 k2 k3 c ca cb cz cd d0 da db dc dd ga gb gc gd sm4)))))
  ((erased sy-trace : (erased (Nat) k j q2 ks i c0) (erased (Bool) d0) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0 E)
      (erased (List (Col)) rest) (subterm erased (SSy k j gs P s g1 Q E0 E) y) (erased (TIdx q2 rest i) ti) (erased (Length (Col) rest (Succ j)) le)
      (erased (WCt Q g1 q2 rest ks) pc) (erased (WSm E0 i c0 d0) sm) -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WGr c0 d0 ks c1 d1) g))
    (match erased y _
      ((SyNone _ _ _ _ _ _ _ _ _ _ z)
        (let-match erased (wct-zero (Succ j) q2 ks Q g1 rest z le pc) (Refl _ _))
        (values c0 d0 sm (wgr-exact c0 (Zero) c0 d0 (add-zero-right c0))))
      ((SyGo us _ _ _ _ _ _ R _ _ E1 _ _ _ f w)
        (let ((erased k2) (erased d1) (erased pr) (erased sm1) (erased ls)) (wflt-ct us (Succ k) (Succ j) q2 ks i c0 d0 g1 rest Q R E0 E1 f pc ti le sm))
        (let ((erased c1) (erased d2) (erased sm2) (erased g)) (sw-trace (Succ k) (Succ j) q2 k2 i c0 d1 g1 R E1 E rest w ti le pr sm1))
        (values c1 d2 sm2 (wls-gr c0 ks k2 c1 d0 d1 d2 ls g)))
      ((SyLvs _ _ _ _ _ _ _ _ _ _ v)
        (let-match erased le (LengthCons _ e r1 _ le1))
        (let-match erased le1 (LengthNil _))
        (slv-trace (Succ k) q2 ks i c0 d0 g1 Q E0 E e v ti pc sm)))))

(def-fns _
  ((erased lc-below : (erased (List (U8)) us vs) (erased (Nat) j n i x) (erased (Ctree) t) (subterm erased (Lc us j n t) f) (erased (Put flag-w us i x vs) s)
      (erased (Lt i n) l) -> (erased (Lc vs j n t) r))
    (let ((erased ap)) (ApLt (Nat) Lt i n l))
    (let-match erased f (LcN _ _ _ q c a1 a2 a3 c12 t1 t2 t3 y tq z1 z2 z3 s1 s2 k1 k2 k3) ((LcE _ _ _ y) (LcE vs j n (put-other flag-w us vs i x n _ s ap y))))
    (let ((erased l1)) (lt-le-trans _ _ _ l (lt-weaken _ _ (thrice-le n q tq))))
    (let ((erased l2)) (lt-weaken _ _ l1))
    (LcN vs j n q c a1 a2 a3 c12 t1 t2 t3 (put-other flag-w us vs i x n _ s ap y) tq z1 z2 z3 s1 s2 (lck-below us vs j (Succ q) i x t1 k1 s l1)
      (lck-below us vs j (Succ (Succ q)) i x t2 k2 s l2) (lck-below us vs j (Succ (Succ (Succ q))) i x t3 k3 s (lt-weaken _ _ l2))))
  ((erased lck-below : (erased (List (U8)) us vs) (erased (Nat) j n i x) (erased (Ctree) t) (subterm erased (LcK us j n t) k) (erased (Put flag-w us i x vs) s)
      (erased (Lt i n) l) -> (erased (LcK vs j n t) r))
    (let-match erased k (LkS _ j1 _ _ f) ((LkZ _ _ _) (LkZ vs n t)))
    (LkS vs j1 n t (lc-below us vs j1 n i x t f s l))))

(def-fns _
  ((erased lc-apart : (erased (List (U8)) us vs) (erased (Nat) j n m q i x) (erased (Ctree) t) (subterm erased (Lc us j n t) f) (erased (Put flag-w us i x vs) s)
      (erased (HDesc m i) d) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (Lc vs j n t) r))
    (let ((erased ap)) (ApGt (Nat) Lt i n (lt-le-trans _ _ _ nm (desc-ge m i d))))
    (let-match erased f (LcN _ _ _ q2 c a1 a2 a3 c12 t1 t2 t3 y tq2 z1 z2 z3 s1 s2 k1 k2 k3) ((LcE _ _ _ y) (LcE vs j n (put-other flag-w us vs i x n _ s ap y))))
    (let-match erased (thrice-fn n q q2 tq tq2) (Refl _ _))
    (let ((erased y2)) (put-other flag-w us vs i x n _ s ap y))
    (match erased d _
      ((HDSelf _)
        (let ((erased l2)) (lt-weaken _ _ mq))
        (LcN vs j n q c a1 a2 a3 c12 t1 t2 t3 y2 tq z1 z2 z3 s1 s2 (lck-below us vs j (Succ q) i x t1 k1 s mq) (lck-below us vs j (Succ (Succ q)) i x t2 k2 s l2)
          (lck-below us vs j (Succ (Succ (Succ q))) i x t3 k3 s (lt-weaken _ _ l2))))
      ((HDKid _ q3 c2 _ tm hk d2)
        (let ((erased r1) (erased u1) (erased e1) (erased f1)) (apart-kid n m q q3 (Succ q) c2 nm tq mq tm hk (HK1 q)))
        (let ((erased r2) (erased u2) (erased e2) (erased f2)) (apart-kid n m q q3 (Succ (Succ q)) c2 nm tq mq tm hk (HK2 q)))
        (let ((erased r3) (erased u3) (erased e3) (erased f3)) (apart-kid n m q q3 (Succ (Succ (Succ q))) c2 nm tq mq tm hk (HK3 q)))
        (LcN vs j n q c a1 a2 a3 c12 t1 t2 t3 y2 tq z1 z2 z3 s1 s2 (lck-apart us vs j (Succ q) c2 r1 i x t1 k1 s d2 e1 u1 f1)
          (lck-apart us vs j (Succ (Succ q)) c2 r2 i x t2 k2 s d2 e2 u2 f2) (lck-apart us vs j (Succ (Succ (Succ q))) c2 r3 i x t3 k3 s d2 e3 u3 f3)))))
  ((erased lck-apart : (erased (List (U8)) us vs) (erased (Nat) j n m q i x) (erased (Ctree) t) (subterm erased (LcK us j n t) k) (erased (Put flag-w us i x vs) s)
      (erased (HDesc m i) d) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (LcK vs j n t) r))
    (let-match erased k (LkS _ j1 _ _ f) ((LkZ _ _ _) (LkZ vs n t)))
    (LkS vs j1 n t (lc-apart us vs j1 n m q i x t f s d nm tq mq))))

(def-fns _ $ (erased lck-apart-in : (erased (List (U8)) us vs) (erased (Nat) j n m q) (erased (Ctree) t) (erased (LcK us j n t) f)
    (subterm erased (SetsBelow us vs m) w) (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (LcK vs j n t) r))
  (match erased w _
    ((SbNil _ _) f)
    ((SbSet _ ws _ _ i x w1 s d) (lck-apart ws vs j n m q i x t (lck-apart-in us ws j n m q t f w1 nm tq mq) s d nm tq mq))))

(def-fns _ $ (erased lck-sib : (erased (List (U8)) us vs) (erased (Nat) j n m i x) (erased (Ctree) t) (erased (LcK us j n t) f) (erased (Put flag-w us i x vs) s)
    (erased (HDesc m i) d) (erased (Lt m n) mn) (erased (Lt n (Succ (Succ (Succ m)))) nm) (erased (Lt (Zero) m) mp) -> (erased (LcK vs j n t) r))
  (let-match erased d (HDKid _ q3 c _ t3 hk d2) ((HDSelf _) (lck-below us vs j n i x t f s mn)))
  (let ((erased qn) (erased tn)) (thrice-exists n))
  (let ((erased lo) (erased hi)) (hkid-lt q3 c hk))
  (let ((erased nq)) (le-trans n (Succ (Succ m)) q3 nm (LtS _ _ (thrice-ge2 m q3 mp t3))))
  (lck-apart us vs j n c qn i x t f s d2 (lt-le-trans _ _ _ nq (LtS _ _ lo)) tn
    (lt-le-trans _ _ _ hi (LtS _ _ (LtS _ _ (thrice-lt m n q3 qn mn t3 tn))))))

(def-fns _ $ (erased lck-sib-in : (erased (List (U8)) us vs) (erased (Nat) j n m) (erased (Ctree) t) (erased (LcK us j n t) f)
    (subterm erased (SetsBelow us vs m) w) (erased (Lt m n) mn) (erased (Lt n (Succ (Succ (Succ m)))) nm) (erased (Lt (Zero) m) mp) -> (erased (LcK vs j n t) r))
  (match erased w _
    ((SbNil _ _) f)
    ((SbSet _ ws _ _ i x w1 s d) (lck-sib ws vs j n m i x t (lck-sib-in us ws j n m t f w1 mn nm mp) s d mn nm mp))))

(def-fns _ $ (erased lck-lo : (erased (List (U8)) us vs) (erased (Nat) j a m) (erased (Ctree) t) (erased (LcK us j a t) f) (erased (SetsBelow us vs m) w)
    (erased (Lt a m) am) (erased (Lt m (Succ (Succ (Succ a)))) ma) (erased (Lt (Zero) a) ap) -> (erased (LcK vs j a t) r))
  (let ((erased qa) (erased ta)) (thrice-exists a))
  (lck-apart-in us vs j a m qa t f w am ta (le-trans m (Succ (Succ a)) qa ma (LtS _ _ (thrice-ge2 a qa ap ta)))))

; u2 is u with its leaf at the trace et made one of count x, emptied nodes removed.
(def-adts $ (Chg : ((Ctree) u) ((List (Col)) et) ((Nat) x) ((Ctree) u2) -> Type)
  enum
  (many ChL : (erased (Ctree) lf s) (erased (Nat) x) (erased (CtRoot s x) r) (erased (CtH (Zero) s) k) -> (Chg (CLeaf lf) (Nil (Col)) x s))
  (many ChN : (erased (Ctree) u v v2 w1 w2 w3 u2) (erased (Col) e) (erased (List (Col)) et) (erased (Nat) x) (erased (CtSel u e v) s) (erased (Chg v et x v2) c)
      (erased (Up3 e u v2 (CNode w1 w2 w3)) up) (erased (Cn w1 w2 w3 u2) cn) -> (Chg u (Cons (Col) e et) x u2)))

(def-fns _ $ (erased tally-chg : (erased (List Cnt) us vs) (erased (Nat) j p i x) (erased (Ctree) u u2) (erased (List (Col)) et)
    (subterm erased (Chg u et x u2) cg) (erased (Tally us j p u) b) (erased (Put cnt-w us i x vs) w) (erased (TIdx p et i) ti) (erased (Length (Col) et j) le)
    -> (erased (Tally vs j p u2) r))
  (match erased cg _
    ((ChL lf s _ rt k)
      (let-match erased ti (TINil _))
      (let-match erased le (LengthNil _))
      (TaL vs p x s (put-elt cnt-w us vs p x w) rt k))
    ((ChN _ v v2 w1 w2 w3 _ e et1 _ sv c1 up cn)
      (let-match erased ti (TICons _ c _ _ _ kd ti1))
      (let-match erased le (LengthCons _ _ _ j1 le1))
      (let ((erased v0) (erased bc) (erased sc)) (tally-down us j1 p c u e b kd))
      (let-match erased (sel-fn u v v0 e sv sc) (Refl _ _))
      (tally-up us vs j1 p c i x e u v2 w1 w2 w3 u2 et1 b kd (tally-chg us vs j1 c i x v v2 et1 c1 bc w ti1 le1) w ti1 le1 up cn))))

(def-fns _ $ (erased chg-occ : (erased (Ctree) u u2) (erased (List (Col)) et) (erased (Nat) x) (subterm erased (Chg u et x u2) c) -> (erased (Occ u) o))
  (match erased c _ ((ChL lf _ _ _ _) (OccL lf)) ((ChN _ v _ _ _ _ _ e et1 _ sv c1 _ _) (sel-occ u v e sv (chg-occ v _ et1 x c1)))))

(def-fns _ $ (erased cn-occ : (erased (Col) e) (erased (Ctree) u v2 w1 w2 w3 u2) (erased (Up3 e u v2 (CNode w1 w2 w3)) up) (erased (Cn w1 w2 w3 u2) cn) (erased (Occ v2) o)
    -> (erased (Occ u2) r))
  (let-match erased cn (CnN a b c _) ((CnE) (match erased up _ (absurd (UpA _ _ _ _ _ _) o) (absurd (UpB _ _ _ _ _ _) o) (absurd (UpC _ _ _ _ _ _) o))))
  (OccN a b c))

(def-fns _ $ (erased kid-up3 : (erased (Nat) n) (erased (Col) e) (erased (Ctree) u v2 w) (erased (Up3 e u v2 w) up) -> (erased (Nat) c) (erased (Kid n e c) k))
  (let ((erased q) (erased tq)) (thrice-exists n))
  (match erased up _ ((UpA _ _ _ _ _ _) (values q (Ki1 n q tq))) ((UpB _ _ _ _ _ _) (values (Succ q) (Ki2 n q tq))) ((UpC _ _ _ _ _ _) (values (Succ (Succ q)) (Ki3 n q tq)))))

; Its child on the path stays nonempty (b 1), leaving the node's entry nA as nC, or empties (b 0), one less.
(def-adts $ (Dc1 : ((Nat) b) ((Nat) nC) ((Nat) nA) -> Type)
  enum
  (many Dc1S : (erased (Nat) nE) -> (Dc1 (Succ (Zero)) nE nE))
  (many Dc1Z : (erased (Nat) nE) -> (Dc1 (Zero) nE (Succ nE))))

; us2 is us1 with the entry nE of the node n made nC as its child on the path stays nonempty (b 1), unwritten, or empties (b 0), written one less.
(def-adts $ (EntW : ((List (U8)) us1) ((List (U8)) us2) ((Nat) n) ((Nat) b) ((Nat) nE) ((Nat) nC) -> Type)
  enum
  (many EwSame : (erased (List (U8)) us1) (erased (Nat) n nE) (erased (Elt flag-w us1 n nE) y) -> (EntW us1 us1 n (Succ (Zero)) nE nE))
  (many EwPut : (erased (List (U8)) us1 us2) (erased (Nat) n nC) (erased (Elt flag-w us1 n (Succ nC)) y) (erased (Put flag-w us1 n nC us2) s)
      -> (EntW us1 us2 n (Zero) (Succ nC) nC)))

; b is 0 when c is, and 1 otherwise.
(def-adts $ (Z01 : ((Nat) c) ((Nat) b) -> Type)
  enum
  (many Z01Z : -> (Z01 (Zero) (Zero)))
  (many Z01S : (erased (Nat) c) -> (Z01 (Succ c) (Succ (Zero)))))

(def-fns _ $ (erased z01-fn : (erased (Nat) c a b) (erased (Z01 c a) p) (erased (Z01 c b) q) -> (erased (Eq (Nat) a b) e))
  (match erased p _ ((Z01Z) (let-match erased q (Z01Z)) (Refl _ a)) ((Z01S _) (let-match erased q (Z01S _)) (Refl _ a))))

(def-fns _ $ (erased dc-first : (erased (Ctree) v2) (erased (Nat) b a2 a3 c12 nA) (erased (Nz v2 b) zb) (erased (Add (Succ (Zero)) a2 c12) d1) (erased (Add c12 a3 nA) d2)
    -> (erased (Nat) c3 nC) (erased (Add b a2 c3) e1) (erased (Add c3 a3 nC) e2) (erased (Dc1 b nC nA) dc))
  (let-match erased zb (NzE) ((NzL _) (values c12 nA d1 d2 (Dc1S nA))) ((NzN _ _ _) (values c12 nA d1 d2 (Dc1S nA))))
  (let-match erased d1 (AddSucc _ _ _ d0))
  (let-match erased d0 (AddZero _))
  (let-match erased d2 (AddSucc _ _ nC d3))
  (values a2 nC (AddZero a2) d3 (Dc1Z nC)))

(def-fns _ $ (erased dc-second : (erased (Ctree) v2) (erased (Nat) b a1 a3 c12 nA) (erased (Nz v2 b) zb) (erased (Add a1 (Succ (Zero)) c12) d1) (erased (Add c12 a3 nA) d2)
    -> (erased (Nat) c3 nC) (erased (Add a1 b c3) e1) (erased (Add c3 a3 nC) e2) (erased (Dc1 b nC nA) dc))
  (let-match erased zb (NzE) ((NzL _) (values c12 nA d1 d2 (Dc1S nA))) ((NzN _ _ _) (values c12 nA d1 d2 (Dc1S nA))))
  (let ((erased c1) (erased ec) (erased d0)) (add-succ-right-inv a1 (Zero) c12 d1))
  (let-match erased ec (Refl _ _))
  (let-match erased (add-fn a1 (Zero) c1 a1 d0 (add-zero-right a1)) (Refl _ _))
  (let-match erased d2 (AddSucc _ _ nC d3))
  (values a1 nC (add-zero-right a1) d3 (Dc1Z nC)))

(def-fns _ $ (erased dc-third : (erased (Ctree) v2) (erased (Nat) b a1 a2 c12 nA) (erased (Nz v2 b) zb) (erased (Add a1 a2 c12) d1) (erased (Add c12 (Succ (Zero)) nA) d2)
    -> (erased (Nat) c3 nC) (erased (Add a1 a2 c3) e1) (erased (Add c3 b nC) e2) (erased (Dc1 b nC nA) dc))
  (let-match erased zb (NzE) ((NzL _) (values c12 nA d1 d2 (Dc1S nA))) ((NzN _ _ _) (values c12 nA d1 d2 (Dc1S nA))))
  (let ((erased nC) (erased ec) (erased d0)) (add-succ-right-inv c12 (Zero) nA d2))
  (let-match erased ec (Refl _ _))
  (let-match erased (add-fn c12 (Zero) nC c12 d0 (add-zero-right c12)) (Refl _ _))
  (values c12 c12 d1 (add-zero-right c12) (Dc1Z c12)))

(def-fns _ $ (erased occ3-z01 : (erased (Ctree) w1 w2 w3) (erased (Nat) a1 a2 a3 c12 nE) (erased (Occ3 w1 w2 w3) o) (erased (Nz w1 a1) z1) (erased (Nz w2 a2) z2)
    (erased (Nz w3 a3) z3) (erased (Add a1 a2 c12) d1) (erased (Add c12 a3 nE) d2) -> (erased (Z01 nE (Succ (Zero))) r))
  (match erased o _
    ((Occ1 _ _ _ o1)
      (let-match erased (nz-fn w1 a1 (Succ (Zero)) z1 (nz-occ w1 o1)) (Refl _ _))
      (let-match erased d1 (AddSucc _ _ _ _))
      (let-match erased d2 (AddSucc _ _ nB _))
      (Z01S nB))
    ((Occ2 _ _ _ o2)
      (let-match erased (nz-fn w2 a2 (Succ (Zero)) z2 (nz-occ w2 o2)) (Refl _ _))
      (let ((erased c1) (erased ec) (erased _)) (add-succ-right-inv a1 (Zero) c12 d1))
      (let-match erased ec (Refl _ _))
      (let-match erased d2 (AddSucc _ _ nB _))
      (Z01S nB))
    ((Occ3c _ _ _ o3)
      (let-match erased (nz-fn w3 a3 (Succ (Zero)) z3 (nz-occ w3 o3)) (Refl _ _))
      (let ((erased nB) (erased ec) (erased _)) (add-succ-right-inv c12 (Zero) nE d2))
      (let-match erased ec (Refl _ _))
      (Z01S nB))))

(def-fns _ $ (erased lc-fin : (erased (List (U8)) us1 us2) (erased (Nat) j n q b nE nC nA a1 a2 a3 c12 nB) (erased (Ctree) w1 w2 w3 u2)
    (erased (Elt flag-w us1 n nA) y) (erased (Thrice n q) tq) (erased (Nz w1 a1) z1) (erased (Nz w2 a2) z2) (erased (Nz w3 a3) z3) (erased (Add a1 a2 c12) d1)
    (erased (Add c12 a3 nB) d2) (erased (Dc1 b nB nA) dc) (erased (EntW us1 us2 n b nE nC) ew)
    (erased (LcK us1 j (Succ q) w1) k1) (erased (LcK us1 j (Succ (Succ q)) w2) k2) (erased (LcK us1 j (Succ (Succ (Succ q))) w3) k3) (erased (Cn w1 w2 w3 u2) cn)
    -> (erased (Nat) nb) (erased (Nz u2 nb) zu) (erased (Z01 nC nb) zz) (erased (Lc us2 j n u2) r))
  (let ((erased eq) (erased e2) (erased h1) (erased h2) (erased h3))
    (match erased ew (((Eq (Nat) nB nC) eq) ((Elt flag-w us2 n nB) e2) ((LcK us2 j (Succ q) w1) h1) ((LcK us2 j (Succ (Succ q)) w2) h2) ((LcK us2 j (Succ (Succ (Succ q))) w3) h3))
      ((EwSame _ _ _ y2)
        (let-match erased dc (Dc1S _))
        (let-match erased (elt-fn flag-w us1 n nA nE y y2) (Refl _ _))
        (values (Refl _ nB) y k1 k2 k3))
      ((EwPut _ _ _ _ y2 s)
        (let-match erased dc (Dc1Z _))
        (let-match erased (elt-fn flag-w us1 n nA (Succ nC) y y2) (Refl _ _))
        (let ((erased l1)) (thrice-le n q tq))
        (let ((erased l2)) (lt-weaken _ _ l1))
        (values (Refl _ nB) (put-elt flag-w us1 us2 n nC s) (lck-below us1 us2 j (Succ q) n nC w1 k1 s l1) (lck-below us1 us2 j (Succ (Succ q)) n nC w2 k2 s l2)
          (lck-below us1 us2 j (Succ (Succ (Succ q))) n nC w3 k3 s (lt-weaken _ _ l2))))))
  (let-match erased eq (Refl _ _))
  (let-match erased cn (CnE)
    ((CnN _ _ _ o)
      (values (Succ (Zero)) (NzN w1 w2 w3) (occ3-z01 w1 w2 w3 a1 a2 a3 c12 nC o z1 z2 z3 d1 d2) (LcN us2 j n q nC a1 a2 a3 c12 w1 w2 w3 e2 tq z1 z2 z3 d1 d2 h1 h2 h3))))
  (let-match erased z1 (NzE))
  (let-match erased z2 (NzE))
  (let-match erased z3 (NzE))
  (let-match erased d1 (AddZero _))
  (let-match erased d2 (AddZero _))
  (values (Zero) (NzE) (Z01Z) (LcE us2 j n e2)))

(def-fns _ $ (erased lc-step : (erased (List (U8)) us us1 us2) (erased (Nat) j n c b nE nC) (erased (Col) e) (erased (Ctree) u v v2 w1 w2 w3 u2)
    (erased (Lc us j n u) f) (erased (Kid n e c) kd) (erased (CtSel u e v) sv) (erased (Occ v) ov) (erased (Up3 e u v2 (CNode w1 w2 w3)) up) (erased (Cn w1 w2 w3 u2) cn)
    (erased (SetsBelow us us1 (Succ c)) w) (erased (LcK us1 j (Succ c) v2) kv) (erased (Nz v2 b) zb) (erased (EntW us1 us2 n b nE nC) ew)
    -> (erased (Nat) nb) (erased (Nz u2 nb) zu) (erased (Z01 nC nb) zz) (erased (Lc us2 j n u2) r))
  (let-match erased f (LcN _ _ _ q nA a1 a2 a3 c12 t1 t2 t3 y tq z1 z2 z3 d1 d2 h1 h2 h3) (absurd (LcE _ _ _ _) (let-match erased sv (SelE _)) ov))
  (let ((erased q1) (erased q2) (erased q3)) (values (Succ q) (Succ (Succ q)) (Succ (Succ (Succ q)))))
  (let ((erased l12) (erased l23)) (values (lt-succ q1) (lt-succ q2)))
  (let ((erased l13) (erased l24) (erased l34)) (values (lt-weaken _ _ l12) (lt-weaken _ _ l23) (lt-succ q3)))
  (let ((erased l35) (erased p1) (erased p2)) (values (lt-weaken _ _ l34) (LtZ q) (LtZ q1)))
  (let ((erased nq)) (thrice-le n q tq))
  (let ((erased zv)) (nz-occ v ov))
  (match erased up _
    ((UpA _ _ v3 v4 x2 x3)
      (let-match erased kd (Ki1 _ _ tk))
      (let-match erased (thrice-fn n q c tq tk) (Refl _ _))
      (let-match erased (sel-fn u v3 t2 (C2) x2 (SelN2 t1 t2 t3)) (Refl _ _))
      (let-match erased (sel-fn u v4 t3 (C3) x3 (SelN3 t1 t2 t3)) (Refl _ _))
      (let-match erased (sel-fn u v t1 (C1) sv (SelN1 t1 t2 t3)) (Refl _ _))
      (let-match erased (nz-fn v a1 (Succ (Zero)) z1 zv) (Refl _ _))
      (let ((erased c3) (erased nB) (erased e1) (erased e2) (erased dc)) (dc-first v2 b a2 a3 c12 nA zb d1 d2))
      (lc-fin us1 us2 j n q b nE nC nA b a2 a3 c3 nB v2 t2 t3 u2 (elt-sb us us1 n q1 nA y w nq) tq zb z2 z3 e1 e2 dc ew
        kv (lck-sib-in us us1 j q2 q1 t2 h2 w l12 l24 p1) (lck-sib-in us us1 j q3 q1 t3 h3 w l13 l34 p1) cn))
    ((UpB _ _ v3 v4 x1 x3)
      (let-match erased kd (Ki2 _ c0 tk))
      (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _))
      (let-match erased (sel-fn u v3 t1 (C1) x1 (SelN1 t1 t2 t3)) (Refl _ _))
      (let-match erased (sel-fn u v4 t3 (C3) x3 (SelN3 t1 t2 t3)) (Refl _ _))
      (let-match erased (sel-fn u v t2 (C2) sv (SelN2 t1 t2 t3)) (Refl _ _))
      (let-match erased (nz-fn v a2 (Succ (Zero)) z2 zv) (Refl _ _))
      (let ((erased c3) (erased nB) (erased e1) (erased e2) (erased dc)) (dc-second v2 b a1 a3 c12 nA zb d1 d2))
      (lc-fin us1 us2 j n q b nE nC nA a1 b a3 c3 nB t1 v2 t3 u2 (elt-sb us us1 n q2 nA y w (lt-weaken _ _ nq)) tq z1 zb z3 e1 e2 dc ew
        (lck-lo us us1 j q1 q2 t1 h1 w l12 l24 p1) kv (lck-sib-in us us1 j q3 q2 t3 h3 w l23 l35 p2) cn))
    ((UpC _ _ v3 v4 x1 x2)
      (let-match erased kd (Ki3 _ c0 tk))
      (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _))
      (let-match erased (sel-fn u v3 t1 (C1) x1 (SelN1 t1 t2 t3)) (Refl _ _))
      (let-match erased (sel-fn u v4 t2 (C2) x2 (SelN2 t1 t2 t3)) (Refl _ _))
      (let-match erased (sel-fn u v t3 (C3) sv (SelN3 t1 t2 t3)) (Refl _ _))
      (let-match erased (nz-fn v a3 (Succ (Zero)) z3 zv) (Refl _ _))
      (let ((erased c3) (erased nB) (erased e1) (erased e2) (erased dc)) (dc-third v2 b a1 a2 c12 nA zb d1 d2))
      (lc-fin us1 us2 j n q b nE nC nA a1 a2 b c3 nB t1 t2 v2 u2 (elt-sb us us1 n q3 nA y w (lt-weaken _ _ (lt-weaken _ _ nq))) tq z1 z2 zb e1 e2 dc ew
        (lck-lo us us1 j q1 q3 t1 h1 w l13 l34 p1) (lck-lo us us1 j q2 q3 t2 h2 w l23 l35 p2) kv cn))))

(def-fns _ $ (erased lck-down : (erased (List (U8)) us) (erased (Nat) j n c) (erased (Col) e) (erased (Ctree) u v) (erased (Lc us j n u) f) (erased (Kid n e c) kd)
    (erased (CtSel u e v) sv) (erased (Occ v) ov) -> (erased (LcK us j (Succ c) v) r))
  (let-match erased f (LcN _ _ _ q _ _ _ _ _ t1 t2 t3 _ tq _ _ _ _ _ h1 h2 h3) (absurd (LcE _ _ _ _) (let-match erased sv (SelE _)) ov))
  (match erased kd _
    ((Ki1 _ _ tk) (let-match erased (thrice-fn n q c tq tk) (Refl _ _)) (let-match erased (sel-fn u v t1 e sv (SelN1 t1 t2 t3)) (Refl _ _)) h1)
    ((Ki2 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased (sel-fn u v t2 e sv (SelN2 t1 t2 t3)) (Refl _ _)) h2)
    ((Ki3 _ c0 tk) (let-match erased (thrice-fn n q c0 tq tk) (Refl _ _)) (let-match erased (sel-fn u v t3 e sv (SelN3 t1 t2 t3)) (Refl _ _)) h3)))

(def-fns _ $ (erased lc-ent : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) u) (erased (Lc us j n u) f) -> (erased (Nat) c) (erased (Elt flag-w us n c) y))
  (match erased f _ ((LcE _ _ _ y) (values (Zero) y)) ((LcN _ _ _ _ c _ _ _ _ _ _ _ y _ _ _ _ _ _ _ _ _) (values c y))))

(def-fns _ $ (erased lc-rl : (erased (List (U8)) us) (erased (Nat) j n x) (erased (Ctree) u u2) (erased (List (Col)) et) (subterm erased (Chg u et (Succ x) u2) cg)
    (erased (LcK us j n u) f) -> (erased (LcK us j n u2) r) (erased (Occ u2) o))
  (match erased cg _
    ((ChL lf s _ rt k)
      (let-match erased rt (RootL lf2 _ _))
      (let-match erased f (LkZ _ _ _) (absurd (LkS _ _ _ _ g) g))
      (values (LkZ us n s) (OccL lf2)))
    ((ChN _ v v2 w1 w2 w3 _ e et1 _ sv c1 up cn)
      (let ((erased c) (erased kd)) (kid-up3 n e u v2 _ up))
      (let ((erased ov)) (chg-occ v v2 et1 (Succ x) c1))
      (match erased f _
        ((LkZ _ _ _)
          (let ((erased _) (erased ov2)) (lc-rl us (Zero) (Succ c) x v v2 et1 c1 (LkZ us (Succ c) v)))
          (values (LkZ us n u2) (cn-occ e u v2 w1 w2 w3 u2 up cn ov2)))
        ((LkS _ j1 _ _ g)
          (let ((erased kv) (erased ov2)) (lc-rl us j1 (Succ c) x v v2 et1 c1 (lck-down us j1 n c e u v g kd sv ov)))
          (let ((erased ey) (erased y)) (lc-ent us j1 n u g))
          (let ((erased _) (erased _) (erased _) (erased g2))
            (lc-step us us us j1 n c (Succ (Zero)) ey ey e u v v2 w1 w2 w3 u2 g kd sv ov up cn (SbNil us (Succ c)) kv (nz-occ v2 ov2) (EwSame us n ey y)))
          (values (LkS us j1 n u2 g2) (cn-occ e u v2 w1 w2 w3 u2 up cn ov2)))))))

; us2 is us after red4's kill_up, coming up from the trace below the node n along et, has passed n, leaving its entry nC.
(def-adts $ (KD : ((List (U8)) us) ((List (U8)) us2) ((Nat) n) ((List (Col)) et) ((Nat) nC) -> Type)
  enum
  (many KdLeaf : (erased (List (U8)) us us2) (erased (Nat) n c nE nC) (erased (Col) e) (erased (Kid n e c) k) (erased (EntW us us2 n (Zero) nE nC) ew)
      -> (KD us us2 n (Cons (Col) e (Nil (Col))) nC))
  (many KdNode : (erased (List (U8)) us us1 us2) (erased (Nat) n c b nE nC nK) (erased (Col) e e2) (erased (List (Col)) et) (erased (Kid n e c) k)
      (erased (KD us us1 (Succ c) (Cons (Col) e2 et) nK) d) (erased (Z01 nK b) z) (erased (EntW us1 us2 n b nE nC) ew)
      -> (KD us us2 n (Cons (Col) e (Cons (Col) e2 et)) nC)))

(def-fns _ $ (erased kd-sb : (erased (List (U8)) us us2) (erased (Nat) n nC) (erased (List (Col)) et) (subterm erased (KD us us2 n et nC) kd) -> (erased (SetsBelow us us2 n) w))
  (let ((erased q) (erased tq)) (thrice-exists n))
  (match erased kd _
    ((KdLeaf _ _ _ _ _ _ _ _ ew) (let-match erased ew (EwPut _ _ _ _ _ s)) (SbSet us us us2 n n nC (SbNil us n) s (HDSelf n)))
    ((KdNode _ us1 _ _ c _ _ _ _ e _ _ k d _ ew)
      (let ((erased w1)) (sb-up us us1 n q (Succ c) tq (kid-hkid n q c e k tq) (kd-sb us us1 (Succ c) _ _ d)))
      (match erased ew _ ((EwSame _ _ _ _) w1) ((EwPut _ _ _ _ _ s) (SbSet us us1 us2 n n nC w1 s (HDSelf n)))))))

(def-fns _ $ (erased lc-kill : (erased (List (U8)) us us2) (erased (Nat) j n nC) (erased (Ctree) u u2) (erased (List (Col)) et) (subterm erased (KD us us2 n et nC) kd)
    (erased (Lc us j n u) f) (erased (Chg u et (Zero) u2) cg) (erased (Length (Col) et (Succ j)) le)
    -> (erased (Nat) nb) (erased (Nz u2 nb) zu) (erased (Z01 nC nb) zz) (erased (Lc us2 j n u2) r))
  (let-match erased cg (ChN _ v v2 w1 w2 w3 _ e et1 _ sv c1 up cn) (absurd (ChL _ _ _ _ _) kd))
  (let ((erased ov)) (chg-occ v v2 et1 (Zero) c1))
  (match erased kd _
    ((KdLeaf _ _ _ c _ _ _ k ew)
      (let-match erased c1 (ChL _ _ _ rt kk))
      (let-match erased rt (RootE) (absurd (RootN _ _ _) kk))
      (let-match erased le (LengthCons _ _ _ _ le1))
      (let-match erased le1 (LengthNil _))
      (lc-step us us us2 (Zero) n c (Zero) _ nC e u v (CEmpty) w1 w2 w3 u2 f k sv ov up cn (SbNil us (Succ c)) (LkZ us (Succ c) (CEmpty)) (NzE) ew))
    ((KdNode _ us1 _ _ c b _ _ nK _ _ _ k d z ew)
      (let-match erased le (LengthCons _ _ _ _ le1))
      (let-match erased le1 (LengthCons _ _ _ j1 _))
      (let-match erased (lck-down us j n c e u v f k sv ov) (LkS _ _ _ _ g))
      (let ((erased b2) (erased zv) (erased zc) (erased g2)) (lc-kill us us1 j1 (Succ c) nK v v2 et1 d g c1 le1))
      (let-match erased (z01-fn nK b b2 z zc) (Refl _ _))
      (lc-step us us1 us2 j n c b _ nC e u v v2 w1 w2 w3 u2 f k sv ov up cn (kd-sb us us1 (Succ c) nK et1 d) (LkS us1 j1 (Succ c) v2 g2) zv ew))))

; Each node above the trie node of the path pre, last colour first, has a nonzero entry in us.
(def-adts $ (APos : ((List (U8)) us) ((List (Col)) pre) -> Type)
  enum
  (many AposNil : (erased (List (U8)) us) -> (APos us (Nil (Col))))
  (many AposCons : (erased (List (U8)) us) (erased (List (Col)) pre) (erased (Col) e) (erased (Nat) m c) (erased (HIdx pre m) hi) (erased (Elt flag-w us m (Succ c)) y)
      (erased (APos us pre) a) -> (APos us (Cons (Col) e pre))))

(def-fns _ $ (erased sub-occ : (erased (Ctree) u) (erased (List (Col)) et) (erased (Nat) x) (subterm erased (CtSub u et (Succ x)) s) -> (erased (Occ u) o))
  (let-match erased s (SubNil _ _ rt) ((SubCons _ v e et1 _ sl s1) (sel-occ u v e sl (sub-occ v et1 x s1))))
  (let-match erased rt (RootL lf _ _))
  (OccL lf))

(def-fns _ $ (erased kid-sel : (erased (Nat) n) (erased (Ctree) u v) (erased (Col) e) (erased (CtSel u e v) sv) (erased (Occ v) ov) -> (erased (Nat) c) (erased (Kid n e c) k))
  (let ((erased q) (erased tq)) (thrice-exists n))
  (match erased sv _
    (absurd (SelN0 _ _ _) ov)
    ((SelN1 _ _ _) (values q (Ki1 n q tq)))
    ((SelN2 _ _ _) (values (Succ q) (Ki2 n q tq)))
    ((SelN3 _ _ _) (values (Succ (Succ q)) (Ki3 n q tq)))
    (absurd (SelL _ _) ov)
    (absurd (SelE _) ov)))

(def-fns _ $ (erased lc-pos : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) u v) (erased (Col) e) (erased (Lc us j n u) f) (erased (CtSel u e v) sv)
    (erased (Occ v) ov) -> (erased (Nat) c) (erased (Elt flag-w us n (Succ c)) y))
  (let-match erased f (LcN _ _ _ _ nE a1 a2 a3 c12 t1 t2 t3 y _ z1 z2 z3 d1 d2 _ _ _) (absurd (LcE _ _ _ _) (let-match erased sv (SelE _)) ov))
  (let ((erased o3))
    (match erased sv (((Occ3 t1 t2 t3) o))
      (absurd (SelN0 _ _ _) ov)
      ((SelN1 _ _ _) (Occ1 t1 t2 t3 ov))
      ((SelN2 _ _ _) (Occ2 t1 t2 t3 ov))
      ((SelN3 _ _ _) (Occ3c t1 t2 t3 ov))))
  (let-match erased (occ3-z01 t1 t2 t3 a1 a2 a3 c12 nE o3 z1 z2 z3 d1 d2) (Z01S c))
  (values c y))

(def-fns _ $ (erased lc-apos : (erased (List (U8)) us) (erased (Nat) j n x) (erased (Ctree) u) (subterm erased (List (Col)) rest) (erased (List (Col)) pre pt)
    (erased (Lc us j n u) f) (erased (CtSub u rest (Succ x)) sb) (erased (Length (Col) rest (Succ j)) le) (erased (HIdx pre n) hi) (erased (RevApp (Col) rest pre pt) ra)
    (erased (APos us pre) ap) -> (erased (APos us pt) r))
  (let-match erased le (LengthCons _ e rest1 _ le1))
  (let-match erased sb (SubCons _ v _ _ _ sv s1))
  (let ((erased ov)) (sub-occ v rest1 x s1))
  (let ((erased c) (erased kd)) (kid-sel n u v e sv ov))
  (let ((erased cy) (erased y)) (lc-pos us j n u v e f sv ov))
  (let ((erased ap2)) (AposCons us pre e n cy hi y ap))
  (let-match erased ra (RACons _ _ _ _ _ ra1))
  (let-match erased rest1 (Cons _ e2 rest2) ((Nil _) (let-match erased ra1 (RANil _ _)) ap2))
  (let-match erased le1 (LengthCons _ _ _ j1 _))
  (let-match erased (lck-down us j n c e u v f kd sv ov) (LkS _ _ _ _ g))
  (lc-apos us j1 (Succ c) x v rest1 (Cons _ e pre) pt g s1 le1 (HxCons pre n c e hi kd) ra1 ap2))

; What red4's kill_up has left to do above the node d of the path pre: its parent's entry for the trace below it along et, or for d, emptied.
(def-adts $ (KP : ((List (U8)) us0) ((List (U8)) us) ((List (Col)) pre) ((Nat) d) ((List (Col)) et) -> Type)
  enum
  (many KpLeaf : (erased (List (U8)) us0) (erased (List (Col)) pre) (erased (Col) e) (erased (Nat) d) -> (KP us0 us0 (Cons (Col) e pre) d (Nil (Col))))
  (many KpNode : (erased (List (U8)) us0 us) (erased (List (Col)) pre et) (erased (Nat) d) (erased (KD us0 us d et (Zero)) kd) -> (KP us0 us pre d et)))

; What red4's kill_up of the trace etf did: emptied the root, or stopped at the node a of the path pre, which keeps live children.
(def-adts $ (KRes : ((List (U8)) us0) ((List (U8)) us2) ((List (Col)) etf) -> Type)
  enum
  (many KrRoot : (erased (List (U8)) us0 us2) (erased (List (Col)) etf) (erased (KD us0 us2 (Zero) etf (Zero)) kd) -> (KRes us0 us2 etf))
  (many KrCut : (erased (List (U8)) us0 us2) (erased (List (Col)) pre et etf) (erased (Nat) a c) (erased (HIdx pre a) hi) (erased (APos us0 pre) ap)
      (erased (RevApp (Col) pre et etf) ra) (erased (KD us0 us2 a et (Succ c)) kd) -> (KRes us0 us2 etf)))

; red4's kill_up ul k p: the trie node d of the prefix p, of k colours, has emptied, so its parent has one live child fewer.
(def-fns _ $ (many r4-kill-up : (erased (List (U8)) us0 us) (unique (Bytes us) ul) (erased (Nat) len) (erased (Sz flag-w us len) z) (many (Nat) k p) (erased (Lt k 17) kl)
    (erased (Lt p u62-modulus) pb) (subterm erased (List (Col)) pre) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (Nat) d) (erased (HIdx pre d) hd)
    (erased (APos us0 pre) ap) (erased (List (Col)) et etf) (erased (RevApp (Col) pre et etf) ra) (erased (KP us0 us pre d et) kp) (erased (SetsBelow us0 us d) w) ->
    (erased (List (U8)) us2) (unique (Bytes us2) ul2 at ul) (erased (Sz flag-w us2 len) z2) (erased (KRes us0 us2 etf) kr))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match many (nat-zero-dec k) (IsSucc k1)
    ((IsZero)
      (let-match erased le (LengthNil _))
      (let-match erased hd (HxNil))
      (let-match erased ra (RANil _ _))
      (let-match erased kp (KpNode _ _ _ _ _ kd))
      (values us ul z (KrRoot us0 us etf kd))))
  (let-match erased le (LengthCons _ e pre1 _ le1))
  (let-match erased ri (RICons _ p1 _ _ ri1 kd))
  (let-match erased hd (HxCons _ m x _ hi1 km))
  (let-match erased ap (AposCons _ _ _ m2 c hi2 y ap1))
  (let-match erased (hidx-det pre1 m m2 hi1 hi2) (Refl _ _))
  (let-match erased ra (RACons _ _ _ _ _ ra1))
  (let ((erased kb)) (lt-trans k 17 u62-modulus kl r4-17-u62))
  (let ((erased kl1)) (lt-trans k1 k 17 (lt-succ k1) kl))
  (let ((many q) (erased k3) (erased r) (erased mm) (erased dq) (erased rl) (erased qb)) (u62-div p 3 pb r4-three-u62 (LtZ _)))
  (let-match erased (kid-div p1 q p k3 r e kd mm dq rl) (Refl _ _))
  (let ((many o) (erased of) (erased _)) (r4-oget (u62-dec k1 k kb) kl1))
  (let ((erased jv) (erased aj)) (add o q))
  (let-match erased (hidx-det pre1 m jv hi1 (hidx-offs q k1 o jv pre1 ri1 le1 of aj)) (Refl _ _))
  (let ((erased q0) (erased tq) (erased _) (erased lo)) (kid-base m x e km))
  (let ((erased y1)) (elt-sb us0 us m d (Succ c) y w (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 tq) (LtS q0 (Succ x) lo))))
  (let ((erased jl)) (elt-lt flag-w us m (Succ c) len y1 z))
  (let ((many j)) (u62-add o q m aj (lt-trans m len u62-modulus jl (sz-u62 flag-w us len z))))
  (let ((unique ul1) (many v)) (r4-gb us ul j (Succ c) y1))
  (let ((erased vb8) (erased _)) (flag-nth us m (Succ c) y1))
  (let ((erased vb)) (lt-trans (Succ c) u8-modulus u62-modulus vb8 u8-below-u62))
  (let ((many cv)) (u62-dec c v vb))
  (let ((erased us1) (unique ul2) (erased pu) (erased z1)) (r4-sb us ul1 j cv len z jl (lt-succ-left c u8-modulus vb8)))
  (let ((erased ew)) (EwPut us us1 m c y1 pu))
  (let ((erased kdm))
    (match erased kp (((KD us0 us1 m (Cons (Col) e et) c) kq))
      ((KpLeaf _ _ _ _) (KdLeaf us0 us1 m x (Succ c) c e km ew))
      ((KpNode _ _ _ _ _ kd0)
        (let-match erased et (Cons _ e2 et2) (absurd (Nil _) kd0))
        (KdNode us0 us us1 m x (Zero) (Succ c) c (Zero) e e2 et2 km kd0 (Z01Z) ew))))
  (let-match many (u62-eq cv (Zero) (lt-succ-left c u62-modulus vb) u62-modulus-pos) (Unequal _ _ _ _ nz)
    ((Equal _ _ _)
      (tail $ r4-kill-up us0 us1 ul2 len z1 (u62-dec k1 k kb) q kl1 qb pre1 ri1 le1 m hi1 ap1 (Cons _ e et) etf ra1 (KpNode us0 us1 pre1 (Cons _ e et) m kdm)
        (kd-sb us0 us1 m (Zero) (Cons _ e et) kdm))))
  (let-match erased c (Succ c1) (absurd (Zero) (apart-irrefl (Zero) nz)))
  (values us1 ul2 z1 (KrCut us0 us1 pre1 (Cons _ e et) etf m c1 hi1 ap1 ra1 kdm)))

(def-fns _ $ (erased kd-anc : (erased (List (U8)) us0 us2) (erased (Nat) a nC) (subterm erased (List (Col)) pre) (erased (List (Col)) et etf) (erased (KD us0 us2 a et nC) kd)
    (erased (Z01 nC (Succ (Zero))) z) (erased (APos us0 pre) ap) (erased (HIdx pre a) hi) (erased (RevApp (Col) pre et etf) ra) (erased (SetsBelow us0 us2 a) w)
    -> (erased (Nat) nR) (erased (KD us0 us2 (Zero) etf nR) r))
  (let-match erased hi (HxCons pre1 m x e hi1 km) ((HxNil) (let-match erased ra (RANil _ _)) (values nC kd)))
  (let-match erased ap (AposCons _ _ _ m2 c hi2 y ap1))
  (let-match erased (hidx-det pre1 m m2 hi1 hi2) (Refl _ _))
  (let-match erased ra (RACons _ _ _ _ _ ra1))
  (let-match erased et (Cons _ e2 et2) (absurd (Nil _) kd))
  (let ((erased q0) (erased t) (erased _) (erased lo)) (kid-base m x e km))
  (let ((erased y2)) (elt-sb us0 us2 m (Succ x) (Succ c) y w (lt-le-trans m (Succ q0) (Succ x) (thrice-le m q0 t) (LtS q0 (Succ x) lo))))
  (kd-anc us0 us2 m (Succ c) pre1 (Cons _ e et) etf (KdNode us0 us2 us2 m x (Succ (Zero)) (Succ c) (Succ c) nC e e2 et2 km kd z (EwSame us2 m (Succ c) y2))
    (Z01S c) ap1 hi1 ra1 (sb-up us0 us2 m q0 (Succ x) t (kid-hkid m q0 x e km t) w)))

(def-fns _ $ (erased kr-root : (erased (List (U8)) us0 us2) (erased (List (Col)) etf) (erased (KRes us0 us2 etf) kr) -> (erased (Nat) nR) (erased (KD us0 us2 (Zero) etf nR) r))
  (match erased kr _
    ((KrRoot _ _ _ kd) (values (Zero) kd))
    ((KrCut _ _ pre et _ a c hi ap ra kd) (kd-anc us0 us2 a (Succ c) pre et etf kd (Z01S c) ap hi ra (kd-sb us0 us2 a (Succ c) et kd)))))

; red4's died ul h t: the trace t, of the path pre, lost its last count; it is recorded gone, and its parent loses a live child.
(def-fns _ $ (many r4-died : (erased (List (Nat)) T) (unique (Buf T) gb) (erased (List (U8)) us) (unique (Bytes us) ul) (erased (Nat) len) (erased (Sz flag-w us len) z)
    (many (Nat) h t) (erased (Lt (Succ h) 17) hl) (erased (Lt t u62-modulus) tb) (erased (List (Col)) pre etf) (erased (RIdx pre t) ri) (erased (Length (Col) pre (Succ h)) le)
    (erased (Nat) d) (erased (HIdx pre d) hd) (erased (APos us pre) ap) (erased (RevApp (Col) pre (Nil (Col)) etf) ra) ->
    (unique (Buf (Cons (Nat) t T)) gb2 at gb) (erased (List (U8)) us2) (unique (Bytes us2) ul2 at ul) (erased (Sz flag-w us2 len) z2) (erased (KRes us us2 etf) kr))
  (let ((unique gb2)) (r4-bpush T gb t tb))
  (let-match erased le (LengthCons _ e pre1 _ _))
  (let ((erased us2) (unique ul2) (erased z2) (erased kr))
    (r4-kill-up us us ul len z (u62-inc h (lt-trans (Succ h) 17 u62-modulus hl r4-17-u62)) t hl tb pre ri le d hd ap (Nil _) etf ra (KpLeaf us pre1 e d) (SbNil us d)))
  (values gb2 us2 ul2 z2 kr))

(def-fns _ $ (erased chg-exists : (erased (Ctree) u s) (subterm erased (List (Col)) et) (erased (Nat) x y) (erased (CtSub u et (Succ x)) sb) (erased (CtRoot s y) rt)
    (erased (CtH (Zero) s) k) -> (erased (Ctree) u2) (erased (Chg u et y u2) c))
  (let-match erased sb (SubCons _ v e et1 _ sv s1) ((SubNil _ _ ru) (let-match erased ru (RootL lf _ _)) (values s (ChL lf s y rt k))))
  (let ((erased v2) (erased c1)) (chg-exists v s et1 x y s1 rt k))
  (let ((erased c) (erased kd)) (kid-sel (Zero) u v e sv (sub-occ v et1 x s1)))
  (let ((erased u3) (erased up)) (up3-c (Zero) c e kd u v2))
  (let ((erased w1) (erased w2) (erased w3) (erased up2))
    (match erased up (((Ctree) w1) ((Ctree) w2) ((Ctree) w3) ((Up3 e u v2 (CNode w1 w2 w3)) up2))
      ((UpA _ _ a2 a3 _ _) (values v2 a2 a3 up))
      ((UpB _ _ a1 a3 _ _) (values a1 v2 a3 up))
      ((UpC _ _ a1 a2 _ _) (values a1 a2 v2 up))))
  (let ((erased u2) (erased cn)) (cn-c w1 w2 w3))
  (values u2 (ChN u v v2 w1 w2 w3 u2 e et1 y sv c1 up2 cn)))

; Trace i, of count n0 at the start and m now, is in T exactly when it lost its last count.
(def-adts $ (TSt : ((Nat) n0) ((Nat) m) ((List (Nat)) T) ((Nat) i) -> Type)
  enum
  (many TstZero : (erased (Nat) m) (erased (List (Nat)) T) (erased (Nat) i) (erased (NotIn i T) o) -> (TSt (Zero) m T i))
  (many TstLive : (erased (Nat) n0 m) (erased (List (Nat)) T) (erased (Nat) i) (erased (NotIn i T) o) -> (TSt (Succ n0) (Succ m) T i))
  (many TstGone : (erased (Nat) n0) (erased (List (Nat)) T) (erased (Nat) i) (erased (In i T) p) -> (TSt (Succ n0) (Zero) T i)))

; Each trace below n has as its count in vs its count in vs0 less its hits in E, with T as TSt says.
(def-adts $ (UR : ((List Cnt) vs0) ((List Cnt) vs) ((List (WEv)) E) ((List (Nat)) T) ((Nat) n) -> Type)
  enum
  (many UrZ : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) -> (UR vs0 vs E T (Zero)))
  (many UrS : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) (erased (Nat) n n0 m c) (erased (UR vs0 vs E T n) u)
      (erased (Elt cnt-w vs0 n n0) e0) (erased (Elt cnt-w vs n m) e) (erased (HSum E n c) hs) (erased (Monus n0 c m) mo) (erased (TSt n0 m T n) ts)
      -> (UR vs0 vs E T (Succ n))))

; vs2 and T2 are vs and T after red4's dec by a of the trace t of count m: unwritten at 0, else written m less a, and recorded gone at 0.
(def-adts $ (DW : ((List Cnt) vs) ((List Cnt) vs2) ((List (Nat)) T) ((List (Nat)) T2) ((Nat) t) ((Nat) m) ((Nat) a) ((Nat) m2) -> Type)
  enum
  (many DwZero : (erased (List Cnt) vs) (erased (List (Nat)) T) (erased (Nat) t a) -> (DW vs vs T T t (Zero) a (Zero)))
  (many DwLive : (erased (List Cnt) vs vs2) (erased (List (Nat)) T) (erased (Nat) t m a m2) (erased (Monus (Succ m) a (Succ m2)) mo) (erased (Put cnt-w vs t (Succ m2) vs2) u)
      -> (DW vs vs2 T T t (Succ m) a (Succ m2)))
  (many DwGone : (erased (List Cnt) vs vs2) (erased (List (Nat)) T) (erased (Nat) t m a) (erased (Monus (Succ m) a (Zero)) mo) (erased (Put cnt-w vs t (Zero) vs2) u)
      -> (DW vs vs2 T (Cons (Nat) t T) t (Succ m) a (Zero))))

(def-fns _ $ (erased ur-hit : (erased (List Cnt) vs0 vs vs2) (erased (List (WEv)) E) (erased (List (Nat)) T T2) (erased (Nat) t m a m2 n) (subterm erased (UR vs0 vs E T n) u)
    (erased (DW vs vs2 T T2 t m a m2) dw) (erased (Elt cnt-w vs t m) et) -> (erased (UR vs0 vs2 (Cons (WEv) (WHit t a) E) T2 n) r))
  (let-match erased u (UrS _ _ _ _ i n0 mi ci u1 e0 ei hs mo ts) ((UrZ _ _ _ _) (UrZ vs0 vs2 _ T2)))
  (let ((erased r1)) (ur-hit vs0 vs vs2 E T T2 t m a m2 i u1 dw et))
  (let-match erased (nat-eq t i) (Equal _ _ _)
    ((Unequal _ _ _ _ ap)
      (let ((erased ap2)) (apart-sym t i ap))
      (let ((erased ei2) (erased ts2))
        (match erased dw (((Elt cnt-w vs2 i mi) ei2) ((TSt n0 mi T2 i) ts2))
          ((DwZero _ _ _ _) (values ei ts))
          ((DwLive _ _ _ _ _ _ _ _ pu) (values (put-other cnt-w vs vs2 t _ i mi pu ap ei) ts))
          ((DwGone _ _ _ _ _ _ _ pu)
            (values (put-other cnt-w vs vs2 t _ i mi pu ap ei)
              (match erased ts (((TSt n0 mi T2 i) q))
                ((TstZero _ _ _ o) (TstZero mi _ i (NotInCons i t T ap2 o)))
                ((TstLive n1 m1 _ _ o) (TstLive n1 m1 _ i (NotInCons i t T ap2 o)))
                ((TstGone n1 _ _ p) (TstGone n1 _ i (InThere i t T p))))))))
      (UrS vs0 vs2 _ T2 i n0 mi ci r1 e0 ei2 (HsOth E i t a ci hs ap) mo ts2)))
  (let-match erased (elt-fn cnt-w vs t m mi et ei) (Refl _ _))
  (let ((erased c2) (erased ad)) (add ci a))
  (let ((erased hs2)) (HsHit E t a ci c2 hs ad))
  (match erased dw _
    ((DwZero _ _ _ _) (UrS vs0 vs2 _ T2 t n0 (Zero) c2 r1 e0 ei hs2 (monus-add n0 ci (Zero) a (Zero) c2 mo (monus-zero a) ad) ts))
    ((DwLive _ _ _ _ m1 _ m3 mo2 pu)
      (let-match erased ts (TstLive n1 _ _ _ o) (absurd (TstZero _ _ _ _) mo))
      (UrS vs0 vs2 _ T2 t n0 (Succ m3) c2 r1 e0 (put-elt cnt-w vs vs2 t _ pu) hs2 (monus-add n0 ci (Succ m1) a (Succ m3) c2 mo mo2 ad) (TstLive n1 m3 T t o)))
    ((DwGone _ _ _ _ m1 _ mo2 pu)
      (let-match erased ts (TstLive n1 _ _ _ o) (absurd (TstZero _ _ _ _) mo))
      (UrS vs0 vs2 _ T2 t n0 (Zero) c2 r1 e0 (put-elt cnt-w vs vs2 t _ pu) hs2 (monus-add n0 ci (Succ m1) a (Zero) c2 mo mo2 ad) (TstGone n1 (Cons _ t T) t (InHere t T))))))

(def-fns _ $ (erased ur-drop : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) (erased (List (U8)) us) (erased (Nat) k j q o n2 n) (erased (Offs k o) of)
    (erased (Add o q n2) ad) (erased (Elt flag-w us n2 (Zero)) z) (subterm erased (UR vs0 vs E T n) u) -> (erased (UR vs0 vs (Cons (WEv) (WDrop us k j q o n2 of ad z) E) T n) r))
  (let-match erased u (UrS _ _ _ _ i n0 mi ci u1 e0 ei hs mo ts) ((UrZ _ _ _ _) (UrZ vs0 vs _ T)))
  (UrS vs0 vs _ T i n0 mi ci (ur-drop vs0 vs E T us k j q o n2 i of ad z u1) e0 ei (HsDrop E us k j q o n2 i ci of ad z hs) mo ts))

; m is 0, or v is not.
(def-adts $ (ZW : ((Nat) m) ((Nat) v) -> Type)
  enum
  (many ZwX : (erased (Nat) v) -> (ZW (Zero) v))
  (many ZwV : (erased (Nat) m v) -> (ZW m (Succ v))))

(def-fns _ $ (erased tally-zput : (erased (List Cnt) vs vs2) (erased (Nat) j p i x v) (subterm erased (Tally vs j p (CEmpty)) b) (erased (Put cnt-w vs i x vs2) w)
    (erased (Elt cnt-w vs i v) e) (erased (ZW x v) zw) -> (erased (Tally vs2 j p (CEmpty)) r))
  (match erased b _
    ((TaL _ _ n _ y rt k)
      (let-match erased rt (RootE))
      (let-match erased (nat-eq i p) (Equal _ _ _) ((Unequal _ _ _ _ ap) (TaL vs2 p (Zero) (CEmpty) (put-other cnt-w vs vs2 i x p (Zero) w ap y) (RootE) k)))
      (let-match erased (elt-fn cnt-w vs p v (Zero) e y) (Refl _ _))
      (let-match erased zw (ZwX _))
      (TaL vs2 p (Zero) (CEmpty) (put-elt cnt-w vs vs2 p (Zero) w) (RootE) k))
    ((TaN _ j1 _ q t1 t2 t3 _ tq b1 b2 b3 cn)
      (let-match erased cn (CnE))
      (TaN vs2 j1 p q t1 t2 t3 (CEmpty) tq (tally-zput vs vs2 j1 q i x v b1 w e zw) (tally-zput vs vs2 j1 (Succ q) i x v b2 w e zw)
