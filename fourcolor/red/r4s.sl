(def-adts $ (LcA : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) u) -> Type)
  enum
  (many LaE : (erased (List (U8)) us) (erased (Nat) j n) -> (LcA us j n (CEmpty)))
  (many LaK : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) u) (erased (LcK us j n u) k) -> (LcA us j n u)))

(def-fns _ $ (erased lc-at : (erased (List (U8)) us) (erased (Nat) j n d D) (erased (Ctree) top u) (subterm erased (List (Col)) pre)
    (erased (LcK us D (Zero) top) lz) (erased (HIdx pre n) hi) (erased (CtAt top pre u) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad) -> (erased (LcA us j n u) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) (LaK us j n top lz)))
  (let-match erased hi (HxCons _ n1 c _ hi1 k))
  (let-match erased pt (AtCons _ u1 _ _ _ at1 s))
  (let-match erased le (LengthCons _ _ _ d1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let-match erased (occ-c u) (OdY _ ou) ((OdE) (LaE us j n)))
  (let-match erased (lc-at us (Succ j) n1 d1 D top u1 pre1 lz hi1 at1 le1 (add-succ-right d1 j Dq ad1)) (LaK _ _ _ _ k1)
    (absurd (LaE _ _ _) (let-match erased s (SelE _)) ou))
  (let-match erased k1 (LkS _ _ _ _ f1))
  (LaK us j n u (lck-down us j n1 c e u1 u f1 k s ou)))

(def-fns _ $ (erased lc-zero : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) u) (erased (Lc us j n u) f) (erased (Elt flag-w us n (Zero)) y)
    (erased (CtCanon (Succ j) u) cu) -> (erased (Eq (Ctree) u (CEmpty)) e))
  (let-match erased f (LcN _ _ _ _ nE a1 a2 a3 c12 t1 t2 t3 y2 _ z1 z2 z3 d1 d2 _ _ _) ((LcE _ _ _ _) (Refl _ u)))
  (let-match erased cu (CanN _ _ _ _ _ _ _ _ cn))
  (let-match erased cn (CnN _ _ _ o))
  (let-match erased (occ3-z01 t1 t2 t3 a1 a2 a3 c12 nE o z1 z2 z3 d1 d2) (Z01S _))
  (match erased (elt-fn flag-w us n (Zero) nE y y2) (((Eq (Ctree) u (CEmpty)) e)) (absurd Refl)))

; The block of a trie node of entry 0 in us holds nothing.
(def-fns _ $ (erased lc-drop : (erased (List Cnt) vs) (erased (List (U8)) us) (erased (Nat) h d j q n) (erased (Ctree) cur) (erased (List (Col)) pre)
    (erased (Lc us h (Zero) cur) lc) (erased (Tally vs (Succ h) (Zero) cur) tb) (erased (RIdx pre q) ri) (erased (HIdx pre n) hi) (erased (Length (Col) pre d) le)
    (erased (Add d (Succ j) (Succ h)) ad) (erased (Elt flag-w us n (Zero)) y) -> (erased (Tally vs (Succ j) q (CEmpty)) r))
  (let ((erased u) (erased pt)) (ctat-exists cur pre))
  (let ((erased tu)) (tally-at vs (Succ j) q d (Succ h) cur u pre tb ri pt le ad))
  (let-match erased (lc-at us (Succ j) n d (Succ h) cur u pre (LkS us h (Zero) cur lc) hi pt le ad) (LaK _ _ _ _ k) ((LaE _ _ _) tu))
  (let-match erased k (LkS _ _ _ _ f))
  (let-match erased (lc-zero us j n u f y (tally-canon vs (Succ j) q u tu)) (Refl _ _))
  tu)

(def-fns _ $ (erased sst-drop : (erased (Nat) h N len k j q o n) (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (U8)) us) (erased (List (Nat)) T)
    (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z) (erased (List (Col)) pre) (erased (RIdx pre q) ri) (erased (Length (Col) pre k) le)
    (erased (Add k (Succ j) (Succ h)) akj) (erased (SSt h N len vs0 E vs us T) st) -> (erased (SSt h N len vs0 (Cons (WEv) (WDrop us k (Succ j) q o n of ad z) E) vs us T) r))
  (let-match erased st (MkSSt _ _ _ _ _ _ _ _ cur zv zu pw of2 hl ur tb lc dk))
  (MkSSt h N len vs0 _ vs us T cur zv zu pw of2 hl (ur-drop vs0 vs E T us k (Succ j) q o n N of ad z ur) tb lc
    (DkDrop vs E us k (Succ j) q o n of ad z (lc-drop vs us h k j q n cur pre lc tb ri (hidx-offs q k o n pre ri le of ad) le akj z) dk)))

; bs2 is the stack that the symbol g leaves from bs on a pair's first child.
(def-adts $ (KStk : ((Gsym) g) ((Bstack) bs) ((Bstack) bs2) -> Type)
  enum
  (many KsPush : (erased (Bstack) bs) -> (KStk (GPush) bs (BP0 bs)))
  (many KsSkip : (erased (Bstack) bs) -> (KStk (GSkip) bs bs))
  (many KsPop : (erased (Gsym) g) (erased (Bstack) bs c) (erased (IsPop g) ip) (erased (Popped bs c) pp) -> (KStk g bs c)))

; red4's sleaves on the first child p, of stack bsc, of a pair of stack bs under g: none when p is r4-none, else that pair's step.
(def-adts $ (SLa : ((Nat) k) ((GSet) gs) ((Gsym) g) ((Bstack) bs) ((Nat) p) ((Bstack) bsc) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many SaNone : (erased (Nat) k) (erased (GSet) gs) (erased (Gsym) g) (erased (Bstack) bs bsc) (erased (List (WEv)) E0) -> (SLa k gs g bs r4-none bsc E0 E0))
  (many SaOne : (erased (Nat) k p) (erased (GSet) gs) (erased (Gsym) g) (erased (Bstack) bs bsc) (erased (List (WEv)) E0 E) (erased (Lt p r4-none) l)
      (erased (KStk g bs bsc) ks) (erased (SL1 k gs (MkWP p bsc) E0 E) a) -> (SLa k gs g bs p bsc E0 E)))

; red4's sleaves on the second child p + 1 of a pair of stack bs: none unless the symbol s is Push.
(def-adts $ (SLb : ((Nat) k) ((GSet) gs) ((Nat) s) ((Nat) p) ((Bstack) bs) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many SbNo : (erased (Nat) k) (erased (GSet) gs) (erased (Nat) s p) (erased (Bstack) bs) (erased (List (WEv)) E0) (erased (Apart (Nat) Lt s (Zero)) ap) -> (SLb k gs s p bs E0 E0))
  (many SbPush : (erased (Nat) k p) (erased (GSet) gs) (erased (Bstack) bs) (erased (List (WEv)) E0 E) (erased (SL1 k gs (MkWP (Succ p) (BP1 bs)) E0 E) a)
      -> (SLb k gs (Zero) p bs E0 E)))

(def-fns _ $ (erased xpop-pop : (erased (Gsym) g) (erased (Bstack) bs c) (erased (Col) e) (erased (Sym g bs e c) y) (erased (Popped bs c) pp) -> (erased (IsPop g) ip))
  (match erased y _ (absurd (SSkip _) pp) (absurd (SPush2 _) pp) (absurd (SPush3 _) pp) ((SPop02 _) (IP0)) ((SPop12 _) (IP1)) ((SPop03 _) (IP0)) ((SPop13 _) (IP1))))

(def-fns _ $ (erased xt-one : (erased (Nat) p0 p b2) (erased (Bstack) bs) (erased (Gsym) g) (erased (XtP p0 bs g p) xp) (erased (XtB bs g b2) xb) (erased (Lt p r4-none) l)
    -> (erased (Bstack) bsc) (erased (KStk g bs bsc) ks) (erased (Bn bsc b2) bn))
  (match erased xp _
    ((XpPush _ _ _ _ _) (let-match erased xb (XbPush _ _ bn) (absurd (XbPop _ _ _ _ ip _ _) ip) (absurd (XbNone _ _ ip) ip)) (values (BP0 bs) (KsPush bs) bn))
    ((XpSkip _ _ _ _ _) (let-match erased xb (XbSkip _ _ bn) (absurd (XbPop _ _ _ _ ip _ _) ip) (absurd (XbNone _ _ ip) ip)) (values bs (KsSkip bs) bn))
    ((XpPop _ _ _ e _ c pp y _ _)
      (let ((erased ip)) (xpop-pop g bs c e y pp))
      (let-match erased xb (XbPop _ c2 _ _ _ pp2 bn) (absurd (XbPush _ _ _) ip) (absurd (XbSkip _ _ _) ip) (absurd (XbNone _ _ _) pp))
      (let-match erased (popped-fn bs c c2 pp pp2) (Refl _ _))
      (values c (KsPop g bs c ip pp) bn))
    (absurd (XpNone _ _ _) (lt-irrefl r4-none l))))

(def-fns _ $ (erased kid-fwd : (erased (Nat) p0 p W W2) (erased (Col) e) (erased (Kid p0 e p) k) (erased (Lt p0 W) l) (erased (Thrice W W2) tw) -> (erased (Lt p W2) r))
  (let ((erased q0) (erased tq) (erased hi) (erased _)) (kid-base p0 p e k))
  (lt-le-trans p (Succ (Succ (Succ q0))) W2 hi (LtS _ _ (thrice-lt p0 W q0 W2 l tq tw))))

(def-fns _ $ (erased xt-lt : (erased (Nat) p0 p W W2) (erased (Bstack) bs) (erased (Gsym) g) (erased (XtP p0 bs g p) xp) (erased (Lt p0 W) l) (erased (Thrice W W2) tw)
    (erased (Lt p r4-none) ln) -> (erased (Lt p W2) r))
  (match erased xp _
    ((XpPush _ _ _ k _) (kid-fwd p0 p W W2 (C2) k l tw))
    ((XpSkip _ _ _ k _) (kid-fwd p0 p W W2 (C1) k l tw))
    ((XpPop _ _ _ e _ _ _ _ k _) (kid-fwd p0 p W W2 e k l tw))
    (absurd (XpNone _ _ _) (lt-irrefl r4-none ln))))

(def-fns _ $ (erased bn-fn : (erased (Bstack) bs) (erased (Nat) a b) (subterm erased (Bn bs a) p) (erased (Bn bs b) q) -> (erased (Eq (Nat) a b) e))
