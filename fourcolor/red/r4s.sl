  (let-match erased f (LcN _ _ _ q nA a1 a2 a3 c12 t1 t2 t3 y tq z1 z2 z3 d1 d2 h1 h2 h3) (absurd (LcE _ _ _ _) (let-match erased sv (SelE _)) ov))
