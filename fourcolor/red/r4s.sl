(def-fns _ $ (erased ur-init : (erased (List Cnt) vs) (erased (Nat) N) (subterm erased (Nat) n) (erased (Sz cnt-w vs N) z) (erased (Lt n (Succ N)) l)
    -> (erased (UR vs vs (Nil (WEv)) (Nil (Nat)) n) r))
  (let-match erased n (Succ n1) ((Zero) (UrZ vs vs _ _)))
  (let-match erased l (LtS _ _ l1))
  (let ((erased n0) (erased e0)) (elt-exists cnt-w vs N n1 z l1))
  (UrS vs vs _ _ n1 n0 n0 (Zero) (ur-init vs N n1 z (lt-weaken n1 N l1)) e0 e0 (HsNil n1) (MoZ n0)
    (match erased n0 (((TSt n0 n0 (Nil (Nat)) n1) t)) ((Zero) (TstZero (Zero) _ n1 (NotInNil n1))) ((Succ m) (TstLive m m _ n1 (NotInNil n1))))))

(def-fns _ $ (erased ur-get : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) (erased (Nat) n i) (subterm erased (UR vs0 vs E T n) u) (erased (Lt i n) l)
    -> (erased (Nat) n0 m c) (erased (Elt cnt-w vs0 i n0) e0) (erased (Elt cnt-w vs i m) e) (erased (HSum E i c) hs) (erased (Monus n0 c m) mo) (erased (TSt n0 m T i) ts))
  (let-match erased u (UrS _ _ _ _ k n0 m c u1 e0 e hs mo ts) (absurd (UrZ _ _ _ _) l))
  (let-match erased (nat-eq i k) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values n0 m c e0 e hs mo ts)))
  (let-match erased ap (ApLt _ _ _ _ lt) (absurd (ApGt _ _ _ _ gt) (lt-asym k i gt l)))
  (ur-get vs0 vs E T k i u1 lt))

; A drop covering the trace i emptied it.
(def-fns _ $ (erased wsm-dok : (erased (List Cnt) vs) (erased (List (WEv)) E) (erased (Nat) i c m) (subterm erased (WSm E i c (BTrue)) sm) (erased (DOk vs E) dk)
    (erased (Elt cnt-w vs i m) e) -> (erased (Eq (Nat) m (Zero)) r))
  (match erased sm _
    ((WmHit E1 _ _ c1 _ _ sm1 _) (let-match erased dk (DkHit _ _ _ _ dk1)) (wsm-dok vs E1 i c1 m sm1 dk1 e))
    ((WmHitO E1 _ _ _ _ _ sm1 _) (let-match erased dk (DkHit _ _ _ _ dk1)) (wsm-dok vs E1 i c m sm1 dk1 e))
    ((WmIn _ us k j q o n _ _ _ of ad z rest _ ti le)
      (let-match erased dk (DkDrop _ _ _ _ _ _ _ _ _ _ _ b _))
      (let ((erased n2) (erased e2) (erased s2)) (tally-sub vs j q i (CEmpty) rest b ti le))
      (let-match erased (sub-fn (CEmpty) rest n2 (Zero) s2 (empty-sub rest)) (Refl _ _))
      (elt-fn cnt-w vs i m (Zero) e e2))
    ((WmOut E1 _ _ _ _ _ _ _ _ _ _ _ _ _ _ sm1 _ _ _) (let-match erased dk (DkDrop _ _ _ _ _ _ _ _ _ _ _ _ dk1)) (wsm-dok vs E1 i c m sm1 dk1 e))))

(def-fns _ $ (erased monus0-le : (erased (Nat) n c) (subterm erased (Monus n c (Zero)) mo) -> (erased (Lt n (Succ c)) l))
  (match erased mo _ ((MoZ _) (LtZ _)) ((MoE k) (LtZ _)) ((MoS n1 c1 _ mo1) (LtS _ _ (monus0-le n1 c1 mo1)))))

; How red4's s_round began the walk: the root of ul was 0, or the root pair walked down gtr.
(def-adts $ (SRoot : ((List (U8)) us) ((Nat) h) ((Gtree) gtr) ((List (WEv)) E) -> Type)
  enum
  (many SrDrop : (erased (List (U8)) us) (erased (Nat) h) (erased (Gtree) gtr) (erased (Elt flag-w us (Zero) (Zero)) z)
      -> (SRoot us h gtr (Cons (WEv) (WDrop us (Zero) (Succ h) (Zero) (Zero) (Zero) (OfZ) (AddZero (Zero)) z) (Nil (WEv)))))
  (many SrWalk : (erased (List (U8)) us) (erased (Nat) h) (erased (Gtree) gtr) (erased (List (WEv)) E)
      (erased (SWk (Zero) (Succ h) (GSG gtr) (Cons (WP) (MkWP (Zero) (BS0)) (Nil (WP))) (Nil (WEv)) E) w) -> (SRoot us h gtr E)))

; Each trace's count in vs is its count in vs0 less its matches in gtr.
(def-fns _ $ (erased root-trace : (erased (List Cnt) vs0 vs) (erased (List (U8)) us0) (erased (List (WEv)) E) (erased (List (Nat)) T) (erased (Nat) h N i n0 m c a) (erased (Gtree) gtr)
    (erased (List (Col)) et) (erased (SRoot us0 h gtr E) sr) (erased (TIdx (Zero) et i) ti) (erased (Length (Col) et (Succ h)) le) (erased (MC (GSG gtr) (BS0) et a) mc)
    (erased (HSum E i c) hs) (erased (Monus n0 c m) mo) (erased (DOk vs E) dk) (erased (Elt cnt-w vs i m) e) -> (erased (Monus n0 a m) r))
  (let ((erased c1) (erased d1) (erased sm1) (erased g))
    (match erased sr (((Nat) c1) ((Bool) d1) ((WSm E i c1 d1) sm1) ((WGr (Zero) (BFalse) a c1 d1) g))
      ((SrDrop _ _ _ z)
        (values (Zero) (BTrue) (WmIn (Nil _) us0 (Zero) (Succ h) (Zero) (Zero) (Zero) i (Zero) (BFalse) (OfZ) (AddZero (Zero)) z et (WmNil i) ti le)
          (WgT (Zero) a (Zero) a (BFalse) (AddZero a) (LtZ a) (LtZ (Zero)))))
      ((SrWalk _ _ _ _ w)
        (sw-trace (Zero) (Succ h) (Zero) a i (Zero) (BFalse) (GSG gtr) _ (Nil _) E et w ti le
          (WcHit (Zero) a (Zero) a (BS0) (Nil _) (GSG gtr) et mc (WcNil (GSG gtr) (Zero) et) (add-zero-right a)) (WmNil i)))))
  (let-match erased (hsum-fn E i c c1 hs (wsm-hsum E i c1 d1 sm1)) (Refl _ _))
  (match erased g _
    ((WgF _ _ _ ad) (let-match erased ad (AddZero _)) mo)
    ((WgT _ _ _ _ _ ad l _)
      (let-match erased ad (AddZero _))
      (let-match erased (wsm-dok vs E i c m sm1 dk e) (Refl _ _))
      (monus-le0 n0 a (le-trans n0 c a (monus0-le n0 c mo) l)))))

; In T exactly when g is not 0.
(def-adts $ (TIn : ((Nat) g) ((List (Nat)) T) ((Nat) i) -> Type)
  enum
  (many TiOut : (erased (List (Nat)) T) (erased (Nat) i) (erased (NotIn i T) o) -> (TIn (Zero) T i))
  (many TiIn : (erased (Nat) g) (erased (List (Nat)) T) (erased (Nat) i) (erased (In i T) p) -> (TIn (Succ g) T i)))

; Each trace of j more colours from the prefix p, after the reversed prefix pre, is in T exactly when gone holds it.
(def-adts $ (GoneT : ((List (Nat)) T) ((Ctree) gone) ((Nat) j) ((Nat) p) ((List (Col)) pre) -> Type)
  enum
  (many GtL : (erased (List (Nat)) T) (erased (Ctree) gone) (erased (Nat) p g) (erased (List (Col)) pre et) (erased (RevApp (Col) pre (Nil (Col)) et) ra)
      (erased (CtSub gone et g) s) (erased (TIn g T p) t) -> (GoneT T gone (Zero) p pre))
  (many GtN : (erased (List (Nat)) T) (erased (Ctree) gone) (erased (Nat) j p q) (erased (List (Col)) pre) (erased (Thrice p q) tq)
      (erased (GoneT T gone j q (Cons (Col) (C1) pre)) a1) (erased (GoneT T gone j (Succ q) (Cons (Col) (C2) pre)) a2)
      (erased (GoneT T gone j (Succ (Succ q)) (Cons (Col) (C3) pre)) a3) -> (GoneT T gone (Succ j) p pre)))

(def-fns _ $ (erased tin-of : (erased (Nat) n0 m g i) (erased (List (Nat)) T) (erased (TSt n0 m T i) ts) (erased (GoneCnt n0 m g) gc) -> (erased (TIn g T i) r))
  (match erased ts _
    ((TstZero _ _ _ o) (match erased gc (((TIn g T i) r)) ((GcGone _) (TiOut T i o)) ((GcKeep _ _) (TiOut T i o))))
    ((TstLive _ _ _ _ o) (let-match erased gc (GcKeep _ _)) (TiOut T i o))
    ((TstGone n1 _ _ p) (let-match erased gc (GcGone _)) (TiIn n1 T i p))))

; What red4's S round left: uc holds keep and ul its live children, and T lists the traces of gone.
(def-adts $ (SRes : ((Nat) h) ((Ctree) ctu) ((Gtree) gtr) ((List Cnt) vs) ((List (U8)) us) ((List (Nat)) T) -> Type)
  enum
  (many MkSRes : (erased (Nat) h) (erased (Ctree) ctu) (erased (Gtree) gtr) (erased (List Cnt) vs) (erased (List (U8)) us) (erased (List (Nat)) T) (erased (Ctree) keep gone)
      (erased (CRes h ctu (Cons RG (MkRx (Gtree) (BS0) gtr) (Nil RG)) keep gone) c) (erased (Tally vs (Succ h) (Zero) keep) tb) (erased (Lc us h (Zero) keep) lc)
      (erased (CtCanon (Succ h) gone) cg) (erased (GoneT T gone (Succ h) (Zero) (Nil (Col))) gt) -> (SRes h ctu gtr vs us T)))

; Both results, trace by trace below the prefix p.
(def-fns _ $ (erased sw-pw : (erased (Nat) h N len) (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (U8)) us us0) (erased (List (Nat)) T) (erased (Ctree) ctu keep gone cur)
    (erased (Gtree) gtr) (erased (SRoot us0 h gtr E) sr) (erased (Tally vs0 (Succ h) (Zero) ctu) t0) (erased (UR vs0 vs E T N) ur) (erased (Tally vs (Succ h) (Zero) cur) tb)
    (erased (Sz cnt-w vs N) zv) (erased (DOk vs E) dk) (erased (CRes h ctu (Cons RG (MkRx (Gtree) (BS0) gtr) (Nil RG)) keep gone) c) (erased (CtH (Succ h) ctu) hc)
    (erased (GoneOf (Succ h) ctu keep gone) go) (subterm erased (Nat) j) (erased (Nat) p d) (erased (List (Col)) pre) (erased (RIdx pre p) ri) (erased (Length (Col) pre d) lp)
    (erased (Add j d (Succ h)) ad) -> (erased (Pointwise vs keep j p pre) pk) (erased (GoneT T gone j p pre) pg))
  (let-match erased j (Succ j1)
    ((Zero)
      (let-match erased ad (AddZero _))
      (let ((erased et) (erased ra)) (rev-exists pre (Nil _)))
      (let ((erased ti)) (ridx-tidx pre (Nil _) et p p ri ra (TINil p)))
      (let ((erased le)) (rev-len pre (Nil _) et (Succ h) (Zero) (Succ h) ra lp (LengthNil _) (add-zero-right (Succ h))))
      (let ((erased n1) (erased e1) (erased _)) (tally-sub vs (Succ h) (Zero) p cur et tb ti le))
      (let ((erased n0) (erased m) (erased ch) (erased e0) (erased e) (erased hs) (erased mo) (erased ts)) (ur-get vs0 vs E T N p ur (elt-lt cnt-w vs p n1 N e1 zv)))
      (let ((erased n2) (erased e2) (erased s0)) (tally-sub vs0 (Succ h) (Zero) p ctu et t0 ti le))
      (let-match erased (elt-fn cnt-w vs0 p n0 n2 e0 e2) (Refl _ _))
      (let ((erased a) (erased mc)) (mc-exists (GSG gtr) (BS0) et))
      (let ((erased mo2)) (root-trace vs0 vs us0 E T h N p n0 m ch a gtr et sr ti le mc hs mo dk e))
      (let-match erased (cres-sub h ctu keep gone (Cons RG (MkRx (Gtree) (BS0) gtr) (Nil RG)) et n0 a c hc le s0
          (RCCons (BS0) gtr (Nil RG) et a (Zero) a mc (RCNil et) (add-zero-right a))) (MkKeepSub _ _ _ _ m2 o2 sk))
      (let-match erased (monus-uniq n0 a m m2 mo2 o2) (Refl _ _))
      (let ((erased g) (erased sg) (erased gc)) (gone-sub (Succ h) n0 m ctu keep gone et go s0 sk le))
      (values (PwL vs keep p m pre et ra sk e) (GtL T gone p g pre et ra sg (tin-of n0 m g p T ts gc)))))
  (let-match erased ad (AddSucc _ _ _ ad1))
  (let ((erased ad2)) (add-succ-right j1 d h ad1))
  (let ((erased q) (erased tq)) (thrice-exists p))
  (let ((erased k1) (erased g1)) (sw-pw h N len vs0 vs E us us0 T ctu keep gone cur gtr sr t0 ur tb zv dk c hc go j1 q (Succ d) (Cons _ (C1) pre) (RICons pre p q (C1) ri (Ki1 p q tq))
    (LengthCons _ (C1) pre d lp) ad2))
  (let ((erased k2) (erased g2)) (sw-pw h N len vs0 vs E us us0 T ctu keep gone cur gtr sr t0 ur tb zv dk c hc go j1 (Succ q) (Succ d) (Cons _ (C2) pre)
    (RICons pre p (Succ q) (C2) ri (Ki2 p q tq)) (LengthCons _ (C2) pre d lp) ad2))
  (let ((erased k3) (erased g3)) (sw-pw h N len vs0 vs E us us0 T ctu keep gone cur gtr sr t0 ur tb zv dk c hc go j1 (Succ (Succ q)) (Succ d) (Cons _ (C3) pre)
    (RICons pre p (Succ (Succ q)) (C3) ri (Ki3 p q tq)) (LengthCons _ (C3) pre d lp) ad2))
  (values (PwN vs keep j1 p q pre tq k1 k2 k3) (GtN T gone j1 p q pre tq g1 g2 g3)))

; red4's S round, start ul then swalk from the root, restricts ctu by gtr: uc then holds keep and ul its live children, and T lists the gone traces.
(def-fns _ $ (erased sw-res : (erased (Nat) h N len) (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (U8)) us us0) (erased (List (Nat)) T) (erased (Ctree) ctu)
    (erased (Gtree) gtr) (erased (Tally vs0 (Succ h) (Zero) ctu) t0) (erased (SRoot us0 h gtr E) sr) (erased (SSt h N len vs0 E vs us T) st) -> (erased (SRes h ctu gtr vs us T) r))
  (let-match erased st (MkSSt _ _ _ _ _ _ _ _ cur zv zu pw of hl ur tb lc dk))
  (let ((erased ct)) (tally-canon vs0 (Succ h) (Zero) ctu t0))
  (let ((erased hc)) (canon-h (Succ h) ctu ct))
  (let ((erased u0) (erased ut0) (erased _)) (ut-of h ctu hc))
  (let ((erased r)) (Cons RG (MkRx (Gtree) (BS0) gtr) (Nil RG)))
  (let ((erased _) (erased gn0) (erased k0) (erased _) (erased c0) (erased _) (erased _)) (ctree-restrict-u h u0 ctu ut0 r (RxCons (Gtree) (BS0) gtr (Nil RG) (RxNil (Gtree)))))
