; red4's (w lsr 2) land 60: the gtr symbols of a leaf word, times 4.
(def-fns _ $ (erased tr4-pf : (erased (Nat) w b cm ftr fu h2 v2 m2 r x) (erased (NWd w b cm ftr fu) d) (erased (Pow2 2 v2) pv) (erased (Mul h2 v2 m2) mm)
    (erased (Add m2 r w) ad) (erased (Lt r v2) rl) (erased (Bitwise and-op h2 60 x) px) -> (erased (Bsp 2 x (Zero) ftr) p) (erased (Lt ftr 16) fl))
  (let-match erased d (MkNWd _ _ _ _ _ y1 y2 p1 p2 p3))
  (let ((erased lo2) (erased y6) (erased loB) (erased q6) (erased q2) (erased _)) (bsp-split 2 2 4 w fu y1 r4-a224 p1))
  (let ((erased _) (erased e6)) (bsp-fn 2 w r h2 lo2 y6 (bsp-of 2 v2 h2 m2 r w pv mm ad rl) q6))
  (let-match erased e6 (Refl _ _))
  (let ((erased c4) (erased pc4)) (bsp-lo0 2 ftr))
  (let-match erased (bitwise-fn and-op h2 60 x c4 px (and-mask 2 4 h2 loB y1 ftr y2 15 60 c4 q2 p2 r4-o15 r4-b60 pc4)) (Refl _ _))
  (values pc4 (bsp-lt 4 y1 ftr y2 16 p2 r4-p16)))

; u is empty, or the node n holds it.
(def-adts $ (LcA : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) u) -> Type)
  enum
  (many LaE : (erased (List (U8)) us) (erased (Nat) j n) -> (LcA us j n (CEmpty)))
  (many LaK : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) u) (erased (LcK us j n u) k) -> (LcA us j n u)))

(def-fns _ $ (erased lc-at : (erased (List (U8)) us) (erased (Nat) j n d D) (erased (Ctree) top u) (subterm erased (List (Col)) pre)
    (erased (LcK us D (Zero) top) lz) (erased (HIdx pre n) hi) (erased (CtAt top pre u) pt) (erased (Length (Col) pre d) le) (erased (Add d j D) ad) -> (erased (LcA us j n u) r))
  (let-match erased pre (Cons _ e pre1)
    ((Nil _) (let-match erased hi (HxNil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) (LaK us j n top lz)))
  (let-match erased hi (HxCons _ n1 c _ hi1 k))
  (let-match erased pt (AtCons _ u1 _ _ _ at1 s))
  (let-match erased le (LengthCons _ _ _ d1 le1))
  (let-match erased ad (AddSucc _ _ Dq ad1))
  (let-match erased (occ-c u) (OdY _ ou) ((OdE) (LaE us j n)))
  (let-match erased (lc-at us (Succ j) n1 d1 D top u1 pre1 lz hi1 at1 le1 (add-succ-right d1 j Dq ad1)) (LaK _ _ _ _ k1)
    (absurd (LaE _ _ _) (let-match erased s (SelE _)) ou))
  (let-match erased k1 (LkS _ _ _ _ f1))
  (LaK us j n u (lck-down us j n1 c e u1 u f1 k s ou)))

(def-fns _ $ (erased lc-zero : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) u) (erased (Lc us j n u) f) (erased (Elt flag-w us n (Zero)) y)
    (erased (CtCanon (Succ j) u) cu) -> (erased (Eq (Ctree) u (CEmpty)) e))
  (let-match erased f (LcN _ _ _ _ nE a1 a2 a3 c12 t1 t2 t3 y2 _ z1 z2 z3 d1 d2 _ _ _) ((LcE _ _ _ _) (Refl _ u)))
  (let-match erased cu (CanN _ _ _ _ _ _ _ _ cn))
  (let-match erased cn (CnN _ _ _ o))
  (let-match erased (occ3-z01 t1 t2 t3 a1 a2 a3 c12 nE o z1 z2 z3 d1 d2) (Z01S _))
  (match erased (elt-fn flag-w us n (Zero) nE y y2) (((Eq (Ctree) u (CEmpty)) e)) (absurd Refl)))

; The block of a trie node of entry 0 in us holds nothing.
(def-fns _ $ (erased lc-drop : (erased (List Cnt) vs) (erased (List (U8)) us) (erased (Nat) h d j q n) (erased (Ctree) cur) (erased (List (Col)) pre)
    (erased (Lc us h (Zero) cur) lc) (erased (Tally vs (Succ h) (Zero) cur) tb) (erased (RIdx pre q) ri) (erased (HIdx pre n) hi) (erased (Length (Col) pre d) le)
    (erased (Add d (Succ j) (Succ h)) ad) (erased (Elt flag-w us n (Zero)) y) -> (erased (Tally vs (Succ j) q (CEmpty)) r))
  (let ((erased u) (erased pt)) (ctat-exists cur pre))
  (let ((erased tu)) (tally-at vs (Succ j) q d (Succ h) cur u pre tb ri pt le ad))
  (let-match erased (lc-at us (Succ j) n d (Succ h) cur u pre (LkS us h (Zero) cur lc) hi pt le ad) (LaK _ _ _ _ k) ((LaE _ _ _) tu))
  (let-match erased k (LkS _ _ _ _ f))
  (let-match erased (lc-zero us j n u f y (tally-canon vs (Succ j) q u tu)) (Refl _ _))
  tu)

(def-fns _ $ (erased sst-drop : (erased (Nat) h N len k j q o n) (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (U8)) us) (erased (List (Nat)) T)
    (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z) (erased (List (Col)) pre) (erased (RIdx pre q) ri) (erased (Length (Col) pre k) le)
