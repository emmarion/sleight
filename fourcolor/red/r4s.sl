  (let ((erased f1) (erased a1)) (ac0-hd _ x1 _ a2))
  (let ((erased f0) (erased _)) (ac0-hd _ x0 _ a1))
  (let-match erased f0 (Refl _ _))
  (let-match erased f1 (Refl _ _))
  (let-match erased f2 (Refl _ _))
  (let-match erased f3 (Refl _ _))
  (let-match erased e0 (BBF))
  (let-match erased e1 (BBF))
  (let-match erased e2 (BBF))
  (let-match erased e3 (BBF))
  (let-match erased ls (LSE))
