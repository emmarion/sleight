(def-fns _ $ (erased xt-one : (erased (Nat) p0 p b2) (erased (Bstack) bs) (erased (Gsym) g) (erased (XtP p0 bs g p) xp) (erased (XtB bs g b2) xb) (erased (Lt p r4-none) l)
