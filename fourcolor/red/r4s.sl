  (let-match erased st (MkSSt _ _ _ _ _ _ _ _ cur zv zu pw of2 hl ur tb lc dk al dt))
  (MkSSt h N len vs0 _ vs us T cur zv zu pw of2 hl (ur-drop vs0 vs E T us k (Succ j) q o n N of ad z ur) tb lc
    (DkDrop vs E us k (Succ j) q o n of ad z (lc-drop vs us h k j q n cur pre lc tb ri (hidx-offs q k o n pre ri le of ad) le akj z) dk) al dt))

; bs2 is the stack that the symbol g leaves from bs on a pair's first child.
(def-adts $ (KStk : ((Gsym) g) ((Bstack) bs) ((Bstack) bs2) -> Type)
  enum
  (many KsPush : (erased (Bstack) bs) -> (KStk (GPush) bs (BP0 bs)))
  (many KsSkip : (erased (Bstack) bs) -> (KStk (GSkip) bs bs))
  (many KsPop : (erased (Gsym) g) (erased (Bstack) bs c) (erased (IsPop g) ip) (erased (Popped bs c) pp) -> (KStk g bs c)))

; red4's sleaves on the first child p, of stack bsc, of a pair of stack bs under g: none when p is r4-none, else that pair's step.
(def-adts $ (SLa : ((Nat) k) ((GSet) gs) ((Gsym) g) ((Bstack) bs) ((Nat) p) ((Bstack) bsc) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many SaNone : (erased (Nat) k) (erased (GSet) gs) (erased (Gsym) g) (erased (Bstack) bs bsc) (erased (List (WEv)) E0) -> (SLa k gs g bs r4-none bsc E0 E0))
  (many SaOne : (erased (Nat) k p) (erased (GSet) gs) (erased (Gsym) g) (erased (Bstack) bs bsc) (erased (List (WEv)) E0 E) (erased (Lt p r4-none) l)
      (erased (KStk g bs bsc) ks) (erased (SL1 k gs (MkWP p bsc) E0 E) a) -> (SLa k gs g bs p bsc E0 E)))

; red4's sleaves on the second child p + 1 of a pair of stack bs: none unless the symbol s is Push.
(def-adts $ (SLb : ((Nat) k) ((GSet) gs) ((Nat) s) ((Nat) p) ((Bstack) bs) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many SbNo : (erased (Nat) k) (erased (GSet) gs) (erased (Nat) s p) (erased (Bstack) bs) (erased (List (WEv)) E0) (erased (Apart (Nat) Lt s (Zero)) ap) -> (SLb k gs s p bs E0 E0))
  (many SbPush : (erased (Nat) k p) (erased (GSet) gs) (erased (Bstack) bs) (erased (List (WEv)) E0 E) (erased (SL1 k gs (MkWP (Succ p) (BP1 bs)) E0 E) a)
      -> (SLb k gs (Zero) p bs E0 E)))

(def-fns _ $ (erased xpop-pop : (erased (Gsym) g) (erased (Bstack) bs c) (erased (Col) e) (erased (Sym g bs e c) y) (erased (Popped bs c) pp) -> (erased (IsPop g) ip))
