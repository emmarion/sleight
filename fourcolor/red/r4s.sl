(def-fns _ $ (erased slv-kids : (erased (Nat) k p0 p s) (erased (GSet) gs) (erased (Gsym) g) (erased (Bstack) bs bsc) (erased (List (WEv)) E0 E1 E2 E) (erased (List (WP)) Q0)
    (erased (XtP p0 bs g p) xp) (erased (SymN s g) sn) (erased (SLa k gs g bs p bsc E0 E1) sa) (erased (SLb k gs s p bs E1 E2) sb) (erased (SLv k gs Q0 E2 E) v)
    -> (erased (List (WP)) Q) (erased (WCh g (MkWP p0 bs) Q0 Q) ch) (erased (SLv k gs Q E0 E) r))
  (match erased xp _
    ((XpPush _ _ _ k2 l)
      (let-match erased sn (SnPush))
      (let-match erased sa (SaOne _ _ _ _ _ _ _ _ _ ks a1) (absurd (SaNone _ _ _ _ _ _) (lt-irrefl r4-none l)))
      (let-match erased ks (KsPush _) (absurd (KsPop _ _ _ ip _) ip))
      (let-match erased sb (SbPush _ _ _ _ _ _ a2) (absurd (SbNo _ _ _ _ _ _ ap) (apart-irrefl (Zero) ap)))
      (let-match erased k2 (Ki2 _ q0 tq))
      (values (Cons _ (MkWP p (BP0 bs)) (Cons _ (MkWP (Succ p) (BP1 bs)) Q0)) (WhPush p0 p (Succ p) bs k2 (Ki3 p0 q0 tq) Q0)
        (SlCons k gs _ _ E0 E1 E a1 (SlCons k gs _ _ E1 E2 E a2 v))))
    ((XpSkip _ _ _ k1 l)
      (let-match erased sn (SnSkip))
      (let-match erased sa (SaOne _ _ _ _ _ _ _ _ _ ks a1) (absurd (SaNone _ _ _ _ _ _) (lt-irrefl r4-none l)))
      (let-match erased ks (KsSkip _) (absurd (KsPop _ _ _ ip _) ip))
      (let-match erased sb (SbNo _ _ _ _ _ _ _))
      (values (Cons _ (MkWP p bs) Q0) (WhSkip p0 p bs k1 Q0) (SlCons k gs _ _ E0 E1 E a1 v)))
    ((XpPop _ _ _ e _ c pp y k1 l)
      (let ((erased ip)) (xpop-pop g bs c e y pp))
      (let-match erased sa (SaOne _ _ _ _ _ _ _ _ _ ks a1) (absurd (SaNone _ _ _ _ _ _) (lt-irrefl r4-none l)))
      (let-match erased ks (KsPop _ _ c2 _ pp2) (absurd (KsPush _) ip) (absurd (KsSkip _) ip))
      (let-match erased (popped-fn bs c c2 pp pp2) (Refl _ _))
      (let-match erased sb (SbNo _ _ _ _ _ _ _) (absurd (SbPush _ _ _ _ _ _ _) (let-match erased sn (SnPush)) ip))
      (values (Cons _ (MkWP p c) Q0) (WhPop p0 p g e bs c pp y k1 Q0) (SlCons k gs _ _ E0 E1 E a1 v)))
    ((XpNone _ _ ip)
      (let-match erased sa (SaNone _ _ _ _ _ _) (absurd (SaOne _ _ _ _ _ _ _ _ l _ _) (lt-irrefl r4-none l)))
      (let-match erased sb (SbNo _ _ _ _ _ _ _) (absurd (SbPush _ _ _ _ _ _ _) (let-match erased sn (SnPush)) ip))
      (values Q0 (WhNone p0 g ip Q0) v))))

(def-fns _ $ (erased pw3-thr : (erased (Nat) m q W N) (subterm erased (Nat) j) (erased (Thrice m q) tq) (erased (Pw3 j m W) pw) (erased (Pw3 j q N) pn) -> (erased (Thrice W N) r))
