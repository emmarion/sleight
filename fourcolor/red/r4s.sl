(def-fns _ $ (erased kid-fwd : (erased (Nat) p0 p W W2) (erased (Col) e) (erased (Kid p0 e p) k) (erased (Lt p0 W) l) (erased (Thrice W W2) tw) -> (erased (Lt p W2) r))
