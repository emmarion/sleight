    ((BnE) (let-match erased q (BnE)) (Refl _ a))
    ((Bn0 c m _ r bc) (let-match erased q (Bn0 _ m2 _ r2 bc2)) (let-match erased (bn-fn c m m2 r r2) (Refl _ _)) (bitcons-det m a b (Bit0) bc bc2))
    ((Bn1 c m _ r bc) (let-match erased q (Bn1 _ m2 _ r2 bc2)) (let-match erased (bn-fn c m m2 r r2) (Refl _ _)) (bitcons-det m a b (Bit1) bc bc2))))

; The second child of a Push: its stack word and bound.
(def-fns _ $ (erased bn-p1 : (erased (Nat) j b d) (erased (Bstack) bs) (erased (Bn bs b) bn) (erased (BnB (Succ j) b) bk) (erased (Bn (BP0 bs) d) bd)
    -> (erased (Bn (BP1 bs) (Succ d)) r) (erased (Lt (Succ d) u62-modulus) l))
  (let-match erased bd (Bn0 _ b2 _ r bc))
  (let-match erased bc (BC0 _ _ dd))
  (let-match erased (bn-fn bs b b2 bn r) (Refl _ _))
  (let-match erased bk (BbS _ _ d2 dd2 k1))
  (let-match erased (double-fn b d d2 dd dd2) (Refl _ _))
  (values (Bn1 bs b (Succ d) r (BC1 b d dd)) (bnb-lt j (Succ d) k1)))

(def-fns _ $ (erased slv-kids : (erased (Nat) k p0 p s) (erased (GSet) gs) (erased (Gsym) g) (erased (Bstack) bs bsc) (erased (List (WEv)) E0 E1 E2 E) (erased (List (WP)) Q0)
    (erased (XtP p0 bs g p) xp) (erased (SymN s g) sn) (erased (SLa k gs g bs p bsc E0 E1) sa) (erased (SLb k gs s p bs E1 E2) sb) (erased (SLv k gs Q0 E2 E) v)
    -> (erased (List (WP)) Q) (erased (WCh g (MkWP p0 bs) Q0 Q) ch) (erased (SLv k gs Q E0 E) r))
  (match erased xp _
    ((XpPush _ _ _ k2 l)
      (let-match erased sn (SnPush))
      (let-match erased sa (SaOne _ _ _ _ _ _ _ _ _ ks a1) (absurd (SaNone _ _ _ _ _ _) (lt-irrefl r4-none l)))
      (let-match erased ks (KsPush _) (absurd (KsPop _ _ _ ip _) ip))
      (let-match erased sb (SbPush _ _ _ _ _ _ a2) (absurd (SbNo _ _ _ _ _ _ ap) (apart-irrefl (Zero) ap)))
      (let-match erased k2 (Ki2 _ q0 tq))
      (values (Cons _ (MkWP p (BP0 bs)) (Cons _ (MkWP (Succ p) (BP1 bs)) Q0)) (WhPush p0 p (Succ p) bs k2 (Ki3 p0 q0 tq) Q0)
        (SlCons k gs _ _ E0 E1 E a1 (SlCons k gs _ _ E1 E2 E a2 v))))
    ((XpSkip _ _ _ k1 l)
      (let-match erased sn (SnSkip))
      (let-match erased sa (SaOne _ _ _ _ _ _ _ _ _ ks a1) (absurd (SaNone _ _ _ _ _ _) (lt-irrefl r4-none l)))
      (let-match erased ks (KsSkip _) (absurd (KsPop _ _ _ ip _) ip))
      (let-match erased sb (SbNo _ _ _ _ _ _ _))
      (values (Cons _ (MkWP p bs) Q0) (WhSkip p0 p bs k1 Q0) (SlCons k gs _ _ E0 E1 E a1 v)))
    ((XpPop _ _ _ e _ c pp y k1 l)
      (let ((erased ip)) (xpop-pop g bs c e y pp))
      (let-match erased sa (SaOne _ _ _ _ _ _ _ _ _ ks a1) (absurd (SaNone _ _ _ _ _ _) (lt-irrefl r4-none l)))
      (let-match erased ks (KsPop _ _ c2 _ pp2) (absurd (KsPush _) ip) (absurd (KsSkip _) ip))
      (let-match erased (popped-fn bs c c2 pp pp2) (Refl _ _))
      (let-match erased sb (SbNo _ _ _ _ _ _ _) (absurd (SbPush _ _ _ _ _ _ _) (let-match erased sn (SnPush)) ip))
      (values (Cons _ (MkWP p c) Q0) (WhPop p0 p g e bs c pp y k1 Q0) (SlCons k gs _ _ E0 E1 E a1 v)))
    ((XpNone _ _ ip)
      (let-match erased sa (SaNone _ _ _ _ _ _) (absurd (SaOne _ _ _ _ _ _ _ _ l _ _) (lt-irrefl r4-none l)))
      (let-match erased sb (SbNo _ _ _ _ _ _ _) (absurd (SbPush _ _ _ _ _ _ _) (let-match erased sn (SnPush)) ip))
      (values Q0 (WhNone p0 g ip Q0) v))))

; The loop of red4's sleaves ul uc h k s wc, from the pair i of level k on: each pair steps by the symbol s to the leaf of word wc, each child
; kept by its trie node getting the leaf's hits.
(def-fns _ $ (many r4-slv : (erased (Nat) N len) (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (U8)) us) (erased (List (Nat)) T) (unique (Bytes vs) uc)
    (unique (Bytes us) ul) (unique (Buf T) gb) (erased (List (MaybeUninit (WRow))) rp rb) (unique (Array (MaybeUninit (WRow)) rp) lp) (unique (Array (MaybeUninit (WRow)) rb) lb)
    (many (Nat) h k s wc o) (erased (Gsym) g) (erased (SymN s g) sn) (erased (Lt wc u62-modulus) wb) (erased (Nat) wb0 cm ftr fu) (erased (NWd wc wb0 cm ftr fu) wd)
    (erased (Gtree) l) (erased (LeafM l ftr) lm) (erased (List (Copy (Nat))) xs ys) (erased (Array (Copy (Nat)) xs) ra) (erased (Array (Copy (Nat)) ys) rb0)
    (erased (Nth (MaybeUninit (WRow)) rp k (Init (WRow) (MkWRow xs ra))) xp) (erased (Nth (MaybeUninit (WRow)) rb k (Init (WRow) (MkWRow ys rb0))) xb)
    (erased (Nat) W W2 jb) (erased (Thrice W W2) tw) (erased (Thrice W2 N) tn) (erased (Pw3 (Succ k) (Succ (Zero)) W2) pw2) (erased (Offs (Succ k) o) of)
    (erased (Add o W2 len) ol) (erased (Eq (Nat) h (Succ k)) hk) (many (Nat) i n) (erased (Lt n u62-modulus) nb) (subterm erased (Nat) m) (erased (Add i m n) ad)
    (erased (List (WP)) P) (erased (WPs xs ys W (Succ jb) i n P) ps) (erased (SSt h N len vs0 E vs us T) st) ->
    (erased (List Cnt) vs2) (unique (Bytes vs2) uc2 at uc) (erased (List (U8)) us2) (unique (Bytes us2) ul2 at ul) (erased (List (Nat)) T2) (unique (Buf T2) gb2 at gb)
    (unique (Array (MaybeUninit (WRow)) rp) lp2 at lp) (unique (Array (MaybeUninit (WRow)) rb) lb2 at lb) (erased (List (WP)) Q) (erased (WStp g P Q) stp)
    (erased (List (WEv)) E2) (erased (SLv h (GSG l) Q E E2) sv) (erased (SSt h N len vs0 E2 vs2 us2 T2) st2))
  (let-match erased hk (Refl _ _))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-none-e (Refl _ _))
  (let ((erased gs)) (GSG l))
  (let ((erased zu)) (let-match erased st (MkSSt _ _ _ _ _ _ _ _ _ _ zu0 _ _ _ _ _ _ _)) zu0)
  (let ((erased lenb)) (sz-u62 flag-w us len zu))
  (let ((erased W2b)) (lt-le-trans W2 (Succ len) u62-modulus (add-le-right o W2 len ol) (LtS len u62-modulus lenb)))
  (let ((erased ib)) (lt-le-trans i (Succ n) u62-modulus (add-le-left i m n ad) (LtS n u62-modulus nb)))
  (let-match many (u62-lt-dec i n ib nb) (Yes _ _ _ _ il)
    ((No _ _ _ _ le)
      (let-match erased m (Zero) (absurd (Succ m0) (lt-irrefl i (lt-le-trans i n i (add-pos-lt i m n ad (LtZ m0)) (le-lt-succ n i le)))))
      (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _))
      (let-match erased ps (WpsNil _ _ _ _ _) (absurd (WpsCons _ _ _ _ _ _ _ _ _ P1 _ _ _ _ _ w1) (lt-irrefl (Succ i) (wps-le xs ys W (Succ jb) (Succ i) i P1 w1))))
      (values vs uc us ul T gb lp lb (Nil _) (WtNil g) E (SlNil h gs E) st)))
  (let-match erased ps (WpsCons _ _ _ _ _ _ p0 b0 bs P1 xpe xbe bn bk pl ps1) (absurd (WpsNil _ _ _ _ _) (lt-irrefl i il)))
  (let-match erased xpe (MkWElt _ _ _ np))
  (let-match erased xbe (MkWElt _ _ _ nb2))
  (let-match erased m (Succ m1) (absurd (Zero) (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _)) (lt-irrefl i il)))
  (let ((unique lp1) (many pv)) (r4-rget rp lp k i xs ra xp p0 np))
  (let ((erased q0) (erased tq)) (thrice-exists p0))
  (let ((erased qw)) (thrice-lt p0 W q0 W2 pl tq tw))
  (let ((erased q3b)) (lt-le-trans (Succ (Succ (Succ q0))) (Succ W2) u62-modulus (LtS _ _ qw) (LtS W2 u62-modulus W2b)))
  (let ((erased q0b)) (lt-succ-left q0 u62-modulus (lt-succ-left (Succ q0) u62-modulus (lt-succ-left (Succ (Succ q0)) u62-modulus q3b))))
  (let ((many qv)) (r4-x3 pv q0 tq (lt-le-trans p0 (Succ q0) u62-modulus (thrice-le p0 q0 tq) (LtS q0 u62-modulus q0b)) q0b))
  (let ((unique lb1) (many bv)) (r4-rget rb lb k i ys rb0 xb b0 nb2))
  (let ((erased bb)) (bnb-lt (Succ jb) b0 bk))
  (let ((many pc) (erased xtp)) (r4-extp qv bv s p0 bs g tq bn bb sn q3b))
  (let ((many bc) (erased xtb) (erased bkc)) (r4-extb bv s jb bs g bn bk sn))
  (let ((erased nl1)) (lt-succ r4-none))
  (let ((erased pcl))
    (match erased xtp (((Lt pc (Succ r4-none)) z))
      ((XpPush _ _ _ _ l1) (lt-weaken _ _ l1)) ((XpSkip _ _ _ _ l1) (lt-weaken _ _ l1)) ((XpPop _ _ _ _ _ _ _ _ _ l1) (lt-weaken _ _ l1)) ((XpNone _ _ _) (lt-succ r4-none))))
  (let ((erased pcb)) (lt-le-trans pc (Succ r4-none) u62-modulus pcl (LtS _ _ nl1)))
  (let ((erased vs1) (unique uc1) (erased us1) (unique ul1) (erased T1) (unique gb1) (erased E1) (erased bsc) (erased sa) (erased st1))
    (match many (u62-lt-dec pc r4-none pcb nl1) (((List Cnt) vs1) ((Bytes vs1) uc1 at uc) ((List (U8)) us1) ((Bytes us1) ul1 at ul) ((List (Nat)) T1) ((Buf T1) gb1 at gb) ((List (WEv)) E1) ((Bstack) bsc) ((SLa h gs g bs pc bsc E E1) sa) ((SSt h N len vs0 E1 vs1 us1 T1) st1))
      ((No _ _ _ _ ge)
        (let-match erased xtp (XpNone _ _ _)
          (absurd (XpPush _ _ _ _ l1) (lt-irrefl pc (lt-le-trans pc r4-none pc l1 (le-lt-succ r4-none pc ge))))
          (absurd (XpSkip _ _ _ _ l1) (lt-irrefl pc (lt-le-trans pc r4-none pc l1 (le-lt-succ r4-none pc ge))))
          (absurd (XpPop _ _ _ _ _ _ _ _ _ l1) (lt-irrefl pc (lt-le-trans pc r4-none pc l1 (le-lt-succ r4-none pc ge)))))
        (values vs uc us ul T gb E bs (SaNone h gs g bs bs E) st))
      ((Yes _ _ _ _ pl1)
        (let ((erased bsc) (erased ks) (erased bnc)) (xt-one p0 pc bc bs g xtp xtb pl1))
        (let ((erased pcw)) (xt-lt p0 pc W W2 bs g xtp pl tw pl1))
        (let ((erased nd) (erased an)) (add o pc))
        (let ((erased ndl)) (lt-le-trans nd len len (add-lt-mono o pc W2 nd len an ol pcw) (lt-succ len)))
        (let ((many ndv)) (u62-add o pc nd an (lt-trans nd len u62-modulus ndl lenb)))
        (let ((erased v0) (erased x0)) (elt-exists flag-w us len nd zu ndl))
        (let ((unique ul2) (many v)) (r4-gb us ul ndv v0 x0))
        (let ((erased vb8) (erased _)) (flag-nth us nd v0 x0))
        (let ((erased qc) (erased tqc)) (thrice-exists pc))
        (let ((erased vb)) (lt-trans v u8-modulus u62-modulus vb8 u8-below-u62))
        (match many (u62-lt-dec (Zero) v u62-modulus-pos vb) (((List Cnt) vs1) ((Bytes vs1) uc1 at uc) ((List (U8)) us1) ((Bytes us1) ul1 at ul) ((List (Nat)) T1) ((Buf T1) gb1 at gb) ((List (WEv)) E1) ((Bstack) bsc2) ((SLa h gs g bs pc bsc2 E E1) sa) ((SSt h N len vs0 E1 vs1 us1 T1) st1))
          ((Yes _ _ _ _ vp)
