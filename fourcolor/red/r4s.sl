(def-fns _ $ (erased leafm0 : (erased (Gtree) l) (erased (LeafM l (Zero)) lm) -> (erased (Eq (Gtree) l (GEmpty)) e))
  (let-match erased lm (MkLeafM _ _ b0 b1 b2 b3 x0 x1 x2 x3 ls e0 e1 e2 e3 a))
