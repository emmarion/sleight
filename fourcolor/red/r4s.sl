; Trace i, of count n0 at the start and m now, is in T exactly when it lost its last count.
(def-adts $ (TSt : ((Nat) n0) ((Nat) m) ((List (Nat)) T) ((Nat) i) -> Type)
  enum
  (many TstZero : (erased (Nat) m) (erased (List (Nat)) T) (erased (Nat) i) (erased (NotIn i T) o) -> (TSt (Zero) m T i))
  (many TstLive : (erased (Nat) n0 m) (erased (List (Nat)) T) (erased (Nat) i) (erased (NotIn i T) o) -> (TSt (Succ n0) (Succ m) T i))
  (many TstGone : (erased (Nat) n0) (erased (List (Nat)) T) (erased (Nat) i) (erased (In i T) p) -> (TSt (Succ n0) (Zero) T i)))

; Each trace below n has as its count in vs its count in vs0 less its hits in E, with T as TSt says.
(def-adts $ (UR : ((List Cnt) vs0) ((List Cnt) vs) ((List (WEv)) E) ((List (Nat)) T) ((Nat) n) -> Type)
  enum
  (many UrZ : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) -> (UR vs0 vs E T (Zero)))
  (many UrS : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) (erased (Nat) n n0 m c) (erased (UR vs0 vs E T n) u)
      (erased (Elt cnt-w vs0 n n0) e0) (erased (Elt cnt-w vs n m) e) (erased (HSum E n c) hs) (erased (Monus n0 c m) mo) (erased (TSt n0 m T n) ts)
      -> (UR vs0 vs E T (Succ n))))

; vs2 and T2 are vs and T after red4's dec by a of the trace t of count m: unwritten at 0, else written m less a, and recorded gone at 0.
(def-adts $ (DW : ((List Cnt) vs) ((List Cnt) vs2) ((List (Nat)) T) ((List (Nat)) T2) ((Nat) t) ((Nat) m) ((Nat) a) ((Nat) m2) -> Type)
  enum
  (many DwZero : (erased (List Cnt) vs) (erased (List (Nat)) T) (erased (Nat) t a) -> (DW vs vs T T t (Zero) a (Zero)))
  (many DwLive : (erased (List Cnt) vs vs2) (erased (List (Nat)) T) (erased (Nat) t m a m2) (erased (Monus (Succ m) a (Succ m2)) mo) (erased (Put cnt-w vs t (Succ m2) vs2) u)
      -> (DW vs vs2 T T t (Succ m) a (Succ m2)))
  (many DwGone : (erased (List Cnt) vs vs2) (erased (List (Nat)) T) (erased (Nat) t m a) (erased (Monus (Succ m) a (Zero)) mo) (erased (Put cnt-w vs t (Zero) vs2) u)
      -> (DW vs vs2 T (Cons (Nat) t T) t (Succ m) a (Zero))))

(def-fns _ $ (erased ur-hit : (erased (List Cnt) vs0 vs vs2) (erased (List (WEv)) E) (erased (List (Nat)) T T2) (erased (Nat) t m a m2 n) (subterm erased (UR vs0 vs E T n) u)
    (erased (DW vs vs2 T T2 t m a m2) dw) (erased (Elt cnt-w vs t m) et) -> (erased (UR vs0 vs2 (Cons (WEv) (WHit t a) E) T2 n) r))
  (let-match erased u (UrS _ _ _ _ i n0 mi ci u1 e0 ei hs mo ts) ((UrZ _ _ _ _) (UrZ vs0 vs2 _ T2)))
  (let ((erased r1)) (ur-hit vs0 vs vs2 E T T2 t m a m2 i u1 dw et))
  (let-match erased (nat-eq t i) (Equal _ _ _)
    ((Unequal _ _ _ _ ap)
      (let ((erased ap2)) (apart-sym t i ap))
      (let ((erased ei2) (erased ts2))
        (match erased dw (((Elt cnt-w vs2 i mi) ei2) ((TSt n0 mi T2 i) ts2))
          ((DwZero _ _ _ _) (values ei ts))
          ((DwLive _ _ _ _ _ _ _ _ pu) (values (put-other cnt-w vs vs2 t _ i mi pu ap ei) ts))
          ((DwGone _ _ _ _ _ _ _ pu)
            (values (put-other cnt-w vs vs2 t _ i mi pu ap ei)
              (match erased ts (((TSt n0 mi T2 i) q))
                ((TstZero _ _ _ o) (TstZero mi _ i (NotInCons i t T ap2 o)))
                ((TstLive n1 m1 _ _ o) (TstLive n1 m1 _ i (NotInCons i t T ap2 o)))
                ((TstGone n1 _ _ p) (TstGone n1 _ i (InThere i t T p))))))))
      (UrS vs0 vs2 _ T2 i n0 mi ci r1 e0 ei2 (HsOth E i t a ci hs ap) mo ts2)))
  (let-match erased (elt-fn cnt-w vs t m mi et ei) (Refl _ _))
  (let ((erased c2) (erased ad)) (add ci a))
  (let ((erased hs2)) (HsHit E t a ci c2 hs ad))
  (match erased dw _
    ((DwZero _ _ _ _) (UrS vs0 vs2 _ T2 t n0 (Zero) c2 r1 e0 ei hs2 (monus-add n0 ci (Zero) a (Zero) c2 mo (monus-zero a) ad) ts))
    ((DwLive _ _ _ _ m1 _ m3 mo2 pu)
      (let-match erased ts (TstLive n1 _ _ _ o) (absurd (TstZero _ _ _ _) mo))
      (UrS vs0 vs2 _ T2 t n0 (Succ m3) c2 r1 e0 (put-elt cnt-w vs vs2 t _ pu) hs2 (monus-add n0 ci (Succ m1) a (Succ m3) c2 mo mo2 ad) (TstLive n1 m3 T t o)))
    ((DwGone _ _ _ _ m1 _ mo2 pu)
      (let-match erased ts (TstLive n1 _ _ _ o) (absurd (TstZero _ _ _ _) mo))
      (UrS vs0 vs2 _ T2 t n0 (Zero) c2 r1 e0 (put-elt cnt-w vs vs2 t _ pu) hs2 (monus-add n0 ci (Succ m1) a (Zero) c2 mo mo2 ad) (TstGone n1 (Cons _ t T) t (InHere t T))))))

(def-fns _ $ (erased ur-drop : (erased (List Cnt) vs0 vs) (erased (List (WEv)) E) (erased (List (Nat)) T) (erased (List (U8)) us) (erased (Nat) k j q o n2 n) (erased (Offs k o) of)
    (erased (Add o q n2) ad) (erased (Elt flag-w us n2 (Zero)) z) (subterm erased (UR vs0 vs E T n) u) -> (erased (UR vs0 vs (Cons (WEv) (WDrop us k j q o n2 of ad z) E) T n) r))
