; The 633 configurations of Coq's configurations.v in chunks of 20, one string per chunk (config-srcs, by gen.py), and
; DCfgs, which reads a chunk's bytes as its configurations: per configuration its symmetry (0 or 1), its contract (n + 1
; each, then 0) and its program (1 for H, 2 for Y, n + 3 for R n, then 0). decode-all decodes every chunk, with a DecAll
; that decall-fn shows determines them. Load after red.sl.

(def-adts $ (Parse : (Type I) (Type A) ((TyCtor (I s) (A x) (I r) -> Type) R) (I s) -> Type)
  enum
  (many POk : (erased Type I A) (erased (TyCtor (I s) (A x) (I r) -> Type) R) (erased I s) (many A x) (many I r) (erased (R s x r) d) -> (Parse I A R s))
  (many PNo : (erased Type I A) (erased (TyCtor (I s) (A x) (I r) -> Type) R) (erased I s) -> (Parse I A R s)))

(def-adts $ (Next : ((String) s) -> Type)
  enum
  (many NEnd : -> (Next (SNil)))
  (many NByte : (many (Nat) n) (erased (Lt n u8-modulus) p) (many (String) r) -> (Next (SCons (MkChar (MkU8 n p)) r))))

(def-fns _ $ (many next-byte : (many (String) s) -> (many (Next s) x))
  (let-match many s (SCons c r) ((SNil) (NEnd)))
  (let-match many c (MkChar u))
  (let-match many u (MkU8 n p))
  (NByte n p r))

(def-adts $ (DBool : ((String) s) ((Bool) b) ((String) r) -> Type)
  enum
  (many DBF : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (DBool (SCons (MkChar (MkU8 (Zero) p)) r) (BFalse) r))
  (many DBT : (erased (Lt (Succ (Zero)) u8-modulus) p) (erased (String) r) -> (DBool (SCons (MkChar (MkU8 (Succ (Zero)) p)) r) (BTrue) r)))

(def-adts $ (DNums : ((String) s) ((List (Nat)) ns) ((String) r) -> Type)
  enum
  (many DNEnd : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (DNums (SCons (MkChar (MkU8 (Zero) p)) r) (Nil (Nat)) r))
  (many DNCons : (erased (Nat) n) (erased (Lt (Succ n) u8-modulus) p) (erased (String) s r) (erased (List (Nat)) ns) (erased (DNums s ns r) d)
      -> (DNums (SCons (MkChar (MkU8 (Succ n) p)) s) (Cons (Nat) n ns) r)))

(def-adts $ (DSteps : ((String) s) ((List (Step)) ps) ((String) r) -> Type)
  enum
  (many DSEnd : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (DSteps (SCons (MkChar (MkU8 (Zero) p)) r) (Nil (Step)) r))
  (many DSH : (erased (Lt (Succ (Zero)) u8-modulus) p) (erased (String) s r) (erased (List (Step)) ps) (erased (DSteps s ps r) d)
      -> (DSteps (SCons (MkChar (MkU8 (Succ (Zero)) p)) s) (Cons (Step) (SH) ps) r))
  (many DSY : (erased (Lt (Succ (Succ (Zero))) u8-modulus) p) (erased (String) s r) (erased (List (Step)) ps) (erased (DSteps s ps r) d)
      -> (DSteps (SCons (MkChar (MkU8 (Succ (Succ (Zero))) p)) s) (Cons (Step) (SY) ps) r))
  (many DSR : (erased (Nat) n) (erased (Lt (Succ (Succ (Succ n))) u8-modulus) p) (erased (String) s r) (erased (List (Step)) ps) (erased (DSteps s ps r) d)
      -> (DSteps (SCons (MkChar (MkU8 (Succ (Succ (Succ n))) p)) s) (Cons (Step) (SR n) ps) r)))

(def-adts $ (DCfgs : ((String) s) ((List (Config)) cs) ((String) r) -> Type)
  enum
  (many DCNil : -> (DCfgs (SNil) (Nil (Config)) (SNil)))
  (many DCCons : (erased (String) s s1 s2 s3 r) (erased (Bool) b) (erased (List (Nat)) ns) (erased (List (Step)) ps) (erased (List (Config)) cs)
      (erased (DBool s b s1) db) (erased (DNums s1 ns s2) dn) (erased (DSteps s2 ps s3) ds) (erased (DCfgs s3 cs r) dc)
      -> (DCfgs s (Cons (Config) (MkConfig b ns ps) cs) r)))

(def-adts $ (DecAll : ((List (String)) ss) ((List (List (Config))) css) ((List (String)) r) -> Type)
  enum
  (many DANil : -> (DecAll (Nil (String)) (Nil (List (Config))) (Nil (String))))
  (many DACons : (erased (String) s) (erased (List (String)) ss r) (erased (List (Config)) cs) (erased (List (List (Config))) css)
      (erased (String) e) (erased (DCfgs s cs e) d) (erased (DecAll ss css r) a) -> (DecAll (Cons (String) s ss) (Cons (List (Config)) cs css) r)))

(def-fns _ $ (erased dbool-fn : (erased (String) s r1 r2) (erased (Bool) a b) (erased (DBool s a r1) p) (erased (DBool s b r2) q)
    -> (erased (Eq (Bool) a b) e) (erased (Eq (String) r1 r2) f))
  (match erased p _
    ((DBF _ _) (let-match erased q (DBF _ _)) (values (Refl _ a) (Refl _ r1)))
    ((DBT _ _) (let-match erased q (DBT _ _)) (values (Refl _ a) (Refl _ r1)))))

(def-fns _ $ (erased dnums-fn : (erased (String) s r1 r2) (erased (List (Nat)) a b) (subterm erased (DNums s a r1) p) (erased (DNums s b r2) q)
    -> (erased (Eq (List (Nat)) a b) e) (erased (Eq (String) r1 r2) f))
  (match erased p _
    ((DNEnd _ _) (let-match erased q (DNEnd _ _)) (values (Refl _ a) (Refl _ r1)))
    ((DNCons _ _ s1 _ ns d)
      (let-match erased q (DNCons _ _ _ _ ms d2))
      (let ((erased e) (erased f)) (dnums-fn s1 r1 r2 ns ms d d2))
      (let-match erased e (Refl _ _))
      (values (Refl _ a) f))))

(def-fns _ $ (erased dsteps-fn : (erased (String) s r1 r2) (erased (List (Step)) a b) (subterm erased (DSteps s a r1) p) (erased (DSteps s b r2) q)
    -> (erased (Eq (List (Step)) a b) e) (erased (Eq (String) r1 r2) f))
  (match erased p _
    ((DSEnd _ _) (let-match erased q (DSEnd _ _)) (values (Refl _ a) (Refl _ r1)))
    ((DSH _ s1 _ ps d) (let-match erased q (DSH _ _ _ ms d2)) (let ((erased e) (erased f)) (dsteps-fn s1 r1 r2 ps ms d d2))
      (let-match erased e (Refl _ _)) (values (Refl _ a) f))
    ((DSY _ s1 _ ps d) (let-match erased q (DSY _ _ _ ms d2)) (let ((erased e) (erased f)) (dsteps-fn s1 r1 r2 ps ms d d2))
      (let-match erased e (Refl _ _)) (values (Refl _ a) f))
    ((DSR _ _ s1 _ ps d) (let-match erased q (DSR _ _ _ _ ms d2)) (let ((erased e) (erased f)) (dsteps-fn s1 r1 r2 ps ms d d2))
      (let-match erased e (Refl _ _)) (values (Refl _ a) f))))

(def-fns _ $ (erased dcfgs-fn : (erased (String) s r1 r2) (erased (List (Config)) a b) (subterm erased (DCfgs s a r1) p) (erased (DCfgs s b r2) q)
    -> (erased (Eq (List (Config)) a b) e) (erased (Eq (String) r1 r2) f))
  (match erased p _
    ((DCNil) (let-match erased q (DCNil) (absurd (DCCons _ _ _ _ _ _ _ _ _ db _ _ _) db)) (values (Refl _ a) (Refl _ r1)))
    ((DCCons _ s1 s2 s3 _ _ ns ps cs db dn ds dc)
      (let-match erased q (DCCons _ t1 t2 t3 _ _ ms qs cs2 db2 dn2 ds2 dc2) (absurd (DCNil) db))
      (let ((erased eb) (erased e1)) (dbool-fn s s1 t1 _ _ db db2))
      (let-match erased eb (Refl _ _))
      (let-match erased e1 (Refl _ _))
      (let ((erased en) (erased e2)) (dnums-fn s1 s2 t2 ns ms dn dn2))
      (let-match erased en (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let ((erased ep) (erased e3)) (dsteps-fn s2 s3 t3 ps qs ds ds2))
      (let-match erased ep (Refl _ _))
      (let-match erased e3 (Refl _ _))
      (let ((erased ec) (erased f)) (dcfgs-fn s3 r1 r2 cs cs2 dc dc2))
      (let-match erased ec (Refl _ _))
      (values (Refl _ a) f))))

(def-fns _ $ (erased decall-fn : (erased (List (String)) ss r1 r2) (erased (List (List (Config))) a b) (subterm erased (DecAll ss a r1) p) (erased (DecAll ss b r2) q)
    -> (erased (Eq (List (List (Config))) a b) e))
  (match erased p _
    ((DANil) (let-match erased q (DANil)) (Refl _ a))
    ((DACons s ss1 _ cs css _ d a1)
      (let-match erased q (DACons _ _ _ cs2 css2 _ d2 a2))
      (let ((erased ec) (erased _)) (dcfgs-fn s _ _ cs cs2 d d2))
      (let-match erased ec (Refl _ _))
      (let-match erased (decall-fn ss1 r1 r2 css css2 a1 a2) (Refl _ _))
      (Refl _ a))))

(def-fns _ $ (many dec-bool : (many (String) s) -> (many (Parse (String) (Bool) DBool s) o))
  (let-match many (next-byte s) (NByte n p r) ((NEnd) (PNo _ _ _ _)))
  (let-match many n (Succ k) ((Zero) (POk _ _ _ _ (BFalse) r (DBF p r))))
  (let-match many k (Zero) (else (PNo _ _ _ _)))
  (POk _ _ _ _ (BTrue) r (DBT p r)))

(def-fns _ $ (many dec-nums : (subterm many (String) s) -> (many (Parse (String) (List (Nat)) DNums s) o))
  (let-match many (next-byte s) (NByte n p r) ((NEnd) (PNo _ _ _ _)))
  (let-match many n (Succ k) ((Zero) (POk _ _ _ _ (Nil _) r (DNEnd p r))))
  (let-match many (notail $ dec-nums r) (POk _ _ _ _ ns r2 d) (else (PNo _ _ _ _)))
  (POk _ _ _ _ (Cons _ k ns) r2 (DNCons k p r r2 ns d)))

(def-fns _ $ (many dec-steps : (subterm many (String) s) -> (many (Parse (String) (List (Step)) DSteps s) o))
  (let-match many (next-byte s) (NByte n p r) ((NEnd) (PNo _ _ _ _)))
  (let-match many n (Succ n1) ((Zero) (POk _ _ _ _ (Nil _) r (DSEnd p r))))
  (let-match many (notail $ dec-steps r) (POk _ _ _ _ ps r2 d) (else (PNo _ _ _ _)))
  (let-match many n1 (Succ n2) ((Zero) (POk _ _ _ _ (Cons _ (SH) ps) r2 (DSH p r r2 ps d))))
  (let-match many n2 (Succ k) ((Zero) (POk _ _ _ _ (Cons _ (SY) ps) r2 (DSY p r r2 ps d))))
  (POk _ _ _ _ (Cons _ (SR k) ps) r2 (DSR k p r r2 ps d)))

(def-fns _ $ (many dec-cfgs : (subterm many (Nat) fuel) (many (String) s) -> (many (Parse (String) (List (Config)) DCfgs s) o))
  (let-match many (next-byte s) (NByte _ _ _) ((NEnd) (POk _ _ _ _ (Nil _) (SNil) (DCNil))))
  (let-match many fuel (Succ f) ((Zero) (PNo _ _ _ _)))
  (let-match many (dec-bool s) (POk _ _ _ _ b s1 db) (else (PNo _ _ _ _)))
  (let-match many (dec-nums s1) (POk _ _ _ _ ns s2 dn) (else (PNo _ _ _ _)))
  (let-match many (dec-steps s2) (POk _ _ _ _ ps s3 ds) (else (PNo _ _ _ _)))
  (let-match many (notail $ dec-cfgs f s3) (POk _ _ _ _ cs r dc) (else (PNo _ _ _ _)))
  (POk _ _ _ _ (Cons _ (MkConfig b ns ps) cs) r (DCCons s s1 s2 s3 r b ns ps cs db dn ds dc)))

(def-fns _ $ (many dec-chunk : (many (String) s) -> (many (Parse (String) (List (Config)) DCfgs s) o)) (dec-cfgs 1000 s))

(def-fns _ $ (many decode-all : (subterm many (List (String)) ss) -> (many (Parse (List (String)) (List (List (Config))) DecAll ss) o))
  (let-match many ss (Cons _ s rest) ((Nil _) (POk _ _ _ _ (Nil _) (Nil _) (DANil))))
  (let-match many (dec-chunk s) (POk _ _ _ _ cs e d) (else (PNo _ _ _ _)))
  (let-match many (notail $ decode-all rest) (POk _ _ _ _ css r2 a) (else (PNo _ _ _ _)))
  (POk _ _ _ _ (Cons _ cs css) r2 (DACons s rest r2 cs css e d a)))

(let ((many config-srcs)) $ Cons _ "\x01\x0e\x00\x01\x06\x01\x08\x01\x08\x02\x07\x01\x07\x02\x05\x02\x04\x02\x00\x01\x07\x00\x01\x05\x01\x09\x02\x07\x01\x04\x02\x07\x01\x07\x02\x05\x02\x02\x00\x01\x12\x00\x01\x04\x01\x09\x01\x04\x02\x07\x01\x09\x01\x09\x01\x09\x02\x02\x07\x01\x04\x02\x06\x02\x04\x02\x00\x01\x02\x03\x0d\x0e\x00\x01\x05\x01\x0a\x02\x08\x01\x04\x02\x07\x01\x04\x02\x07\x02\x05\x02\x05\x02\x00\x01\x0b\x00\x01\x09\x01\x04\x02\x08\x01\x04\x02\x07\x01\x04\x02\x07\x01\x07\x02\x05\x02\x02\x00\x00\x14\x00\x01\x05\x01\x0b\x02\x07\x01\x0a\x01\x05\x01\x0a\x02\x09\x01\x04\x02\x04\x02\x05\x01\x07\x02\x05\x02\x02\x00\x01\x12\x00\x01\x06\x01\x0b\x01\x0b\x02\x09\x01\x04\x02\x08\x01\x04\x02\x08\x02\x06\x02\x05\x02\x02\x00\x01\x07\x00\x01\x05\x01\x0a\x02\x06\x01\x09\x02\x05\x01\x04\x01\x04\x02\x01\x07\x02\x02\x04\x02\x00\x01\x1b\x00\x01\x0b\x01\x04\x02\x0a\x01\x0a\x01\x04\x02\x08\x01\x0a\x02\x06\x01\x09\x01\x09\x02\x02\x02\x06\x02\x02\x00\x00\x15\x00\x01\x05\x01\x0c\x02\x07\x01\x05\x01\x0b\x02\x06\x01\x04\x02\x09\x01\x04\x02\x04\x02\x05\x01\x07\x02\x05\x02\x02\x00\x01\x02\x03\x09\x0a\x00\x01\x0b\x01\x04\x02\x0a\x01\x04\x02\x08\x01\x04\x01\x09\x01\x04\x02\x05\x01\x09\x02\x02\x02\x06\x02\x05\x02\x00\x01\x07\x00\x01\x05\x01\x0b\x02\x06\x01\x0a\x02\x06\x01\x09\x02\x05\x01\x04\x02\x01\x07\x02\x02\x04\x02\x00\x00\x18\x00\x01\x06\x01\x0c\x01\x0c\x02\x0a\x01\x04\x02\x08\x01\x05\x01\x0a\x02\x09\x02\x07\x02\x06\x02\x05\x02\x04\x02\x00\x01\x0f\x00\x01\x0b\x01\x04\x02\x0a\x01\x04\x02\x09\x01\x04\x02\x08\x01\x04\x02\x08\x01\x08\x02\x05\x02\x06\x02\x04\x02\x00\x00\x09\x0a\x10\x11\x00\x01\x0c\x01\x04\x02\x0b\x01\x0b\x01\x04\x02\x0a\x01\x04\x02\x09\x01\x0a\x02\x05\x01\x09\x02\x02\x02\x06\x02\x05\x02\x00\x00\x1f\x00\x01\x05\x01\x0d\x02\x06\x01\x0c\x02\x08\x01\x0b\x01\x05\x01\x0b\x02\x09\x01\x04\x01\x04\x02\x04\x02\x04\x02\x06\x02\x05\x02\x04\x02\x00\x01\x1b\x00\x01\x05\x01\x0d\x02\x07\x01\x0b\x01\x04\x02\x06\x01\x0b\x02\x07\x01\x0a\x01\x0a\x02\x06\x02\x07\x02\x06\x02\x02\x04\x02\x00\x00