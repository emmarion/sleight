; Load after ccheck.sl, in the order of PLAN.md.
(let ((many k1) (many k2) (many k4)) (values (cf001) (cf002) (cf004)))
(let-match many k4 (MkConfig sym4 _ p4))
(let ((many k5) (many k6)) (values (MkConfig sym4 (Nil _) p4) (MkConfig sym4 (Cons _ 0 (Nil _)) p4)))
(def-fns _ $ (many c1 : -> (many (Chk (Reducible CRX k2)) r)) (let ((many b) (many _)) (red-c k2 (Nil _))) b)
(def-fns _ $ (many c2 : -> (many (Chk (Reducible CRX k4)) r)) (let ((many b) (many _)) (red-c k4 (Nil _))) b)
(def-fns _ $ (many c3 : -> (many (Chk (Reducible CRX k1)) r)) (let ((many b) (many _)) (red-c k1 (Nil _))) b)
(def-fns _ $ (many c4 : -> (many (Chk (Reducible CRX k5)) r)) (let ((many b) (many _)) (red-c k5 (Nil _))) b)
(def-fns _ $ (many c5 : -> (many (Chk (Reducible CRX k6)) r)) (let ((many b) (many _)) (red-c k6 (Nil _))) b)

(let ((many r1) (many r2) (many r3) (many r4) (many r5)) (native-compute c1 c2 c3 c4 c5))
(comptime-match many r1 (CkY _ _))
(comptime-match many r2 (CkY _ _))
(comptime-match many r3 (CkY _ _))
(comptime-match many r4 (CkN _))
(comptime-match many r5 (CkN _))
