  (let-match erased (bw-zz t ch bh) (Refl _ _))
  (let-match erased (bitwise-fn t a b cl c bl bw) (Refl _ _))
  pc)

(def-fns _ $ (erased r4g-set-keep : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g w w2 b cm f u f2 u2) (erased (SetNth (Copy (Nat)) xs g (MkCopy (Nat) w2) ys) s)
    (erased (WElt xs g w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u2) d2) -> (erased (NKeep AnyFld xs ys) r))
  (NkCons AnyFld xs ys ys g w w2 b cm f u f2 u2 s x d d2 (MkAnyFld f u f2 u2) (NkNil AnyFld ys)))

(def-fns _ $ (erased r4g-nk-any : (erased (List (Copy (Nat))) xs ys) (subterm erased (NKeep KeepU xs ys) k) -> (erased (NKeep AnyFld xs ys) r))
