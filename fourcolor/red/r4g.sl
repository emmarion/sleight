  (NkCons AnyFld xs xs1 ys i w w2 b cm f u f2 u2 st x d d2 (MkAnyFld f u f2 u2) (r4g-nk-any xs1 ys k1)))

(def-fns _
  ; red4's upd nodes h k g: below node g at depth k, gtr taken out of gu, the gu parts of the nodes of gtr recomputed; r says whether g stays in gu.
  ((many r4-upd : (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) nd) (many (Nat) h k g) (erased (Lt (Succ h) 17) hk) (erased (Nat) len)
      (erased (Length (Copy (Nat)) xs len) lx) (erased (AllCu xs) au) (subterm erased (Nat) j) (subterm erased (Gtree) s0) (erased (NLay xs j g s0) ly) (erased (Add k j h) akj)
