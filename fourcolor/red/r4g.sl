    (match erased k _
      ((NivkE _ _ _ _ _ _ _ _ _ bi lh) (NivkE xs j b cm s bn lo hc (BFalse) bi lh))
      ((NivkP _ _ _ _ _ v g lo2 hi2 _ _ _ _ _ bi rk a gn ll lh p) (NivkP xs j b cm s v g lo2 hi2 bn lo hc c (BFalse) bi rk a gn ll lh (r4g-niv-f xs j g lo2 hi2 c z p))))))

(def-fns _
  ; With the hits buffer empty, no node has a part of gtr.
  ((erased r4g-niv-zero : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (erased (Bool) z) (subterm erased (NIv xs j g s0 lo hi z) iv)
      (erased (HAll xs (Zero) (Nil (Nat))) ha) -> (erased (NIv xs j g s0 lo hi (BTrue)) r))
    (let ((erased w) (erased b) (erased cm) (erased f) (erased u) (erased x) (erased d))
      (match erased iv (((Nat) w) ((Nat) b) ((Nat) cm) ((Nat) f) ((Nat) u) ((WElt xs g w) x) ((NWd w b cm f u) d))
        ((NivL _ _ _ wa ba ma fa ua _ _ xa da _) (values wa ba ma fa ua xa da))
        ((NivN _ _ _ wa ba ma fa ua _ _ _ _ _ _ _ _ _ _ xa da _ _ _ _ _ _ _) (values wa ba ma fa ua xa da))))
    (let-match erased x (MkWElt _ _ _ nth))
    (let-match erased (r4g-hall-get xs (Zero) g g w b cm f u (Nil _) ha nth (AddZero g) d) (ZiZ _ _) (absurd (ZiIn _ _ _ p) p))
    (match erased iv _
      ((NivL _ _ _ wa ba ma fa ua _ _ xa da _)
        (let ((erased ef) (erased _) (erased _) (erased _)) (r4g-wd-eq xs g wa ba ma fa ua w b cm (Zero) u xa da x d))
        (let-match erased ef (Refl _ _))
        (NivL xs g lo wa ba ma (Zero) ua s0 (BTrue) xa da (ZfZ)))
      ((NivN _ j1 _ wa ba ma fa ua _ bn m1 m2 m3 c0 c1 c2 c3 _ xa da _ gb bl k0 k1 k2 k3)
        (let ((erased ef) (erased _) (erased _) (erased _)) (r4g-wd-eq xs g wa ba ma fa ua w b cm (Zero) u xa da x d))
        (let-match erased ef (Refl _ _))
        (NivN xs j1 g wa ba ma (Zero) ua hi bn m1 m2 m3 c0 c1 c2 c3 (BTrue) xa da (ZfZ) gb bl (r4g-nivk-zero xs j1 ba ma (Zero) bn bn m1 c0 z k0 ha)
          (r4g-nivk-zero xs j1 ba ma (Succ (Zero)) bn m1 m2 c1 z k1 ha) (r4g-nivk-zero xs j1 ba ma (Succ (Succ (Zero))) bn m2 m3 c2 z k2 ha)
          (r4g-nivk-zero xs j1 ba ma (Succ (Succ (Succ (Zero)))) bn m3 hi c3 z k3 ha)))))
  ((erased r4g-nivk-zero : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s bn lo hc) (erased (Gtree) c) (erased (Bool) z) (subterm erased (NIvK xs j b cm s c bn lo hc z) k)
      (erased (HAll xs (Zero) (Nil (Nat))) ha) -> (erased (NIvK xs j b cm s c bn lo hc (BTrue)) r))
    (match erased k _
      ((NivkE _ _ _ _ _ _ _ _ _ bi lh) (NivkE xs j b cm s bn lo hc (BTrue) bi lh))
      ((NivkP _ _ _ _ _ v g lo2 hi2 _ _ _ _ _ bi rk a gn ll lh p) (NivkP xs j b cm s v g lo2 hi2 bn lo hc c (BTrue) bi rk a gn ll lh (r4g-niv-zero xs j g lo2 hi2 c z p ha))))))

(def-fns _
  ; A write that keeps a word's first child and child mask keeps the layout.
  ((erased r4g-niv-put : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo hi i w w2 b cm f u f2 u2) (erased (Gtree) s0) (erased (Bool) z) (subterm erased (NIv xs j g s0 lo hi z) iv)
      (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) ys) st) (erased (WElt xs i w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u2) d2) -> (erased (NIv ys j g s0 lo hi (BFalse)) r))
    (let ((erased w1) (erased b1) (erased cm1) (erased f1) (erased u1) (erased x1) (erased d1))
      (match erased iv (((Nat) w1) ((Nat) b1) ((Nat) cm1) ((Nat) f1) ((Nat) u1) ((WElt xs g w1) x1) ((NWd w1 b1 cm1 f1 u1) d1))
        ((NivL _ _ _ wa ba ma fa ua _ _ xa da _) (values wa ba ma fa ua xa da))
        ((NivN _ _ _ wa ba ma fa ua _ _ _ _ _ _ _ _ _ _ xa da _ _ _ _ _ _ _) (values wa ba ma fa ua xa da))))
    (let ((erased w3) (erased f3) (erased u3) (erased x3) (erased d3))
      (match erased (nat-eq g i) (((Nat) w3) ((Nat) f3) ((Nat) u3) ((WElt ys g w3) x3) ((NWd w3 b1 cm1 f3 u3) d3))
        ((Equal _ _ _)
          (let ((erased _) (erased eb) (erased ec) (erased _)) (r4g-wd-eq xs g w1 b1 cm1 f1 u1 w b cm f u x1 d1 x d))
          (let-match erased eb (Refl _ _))
          (let-match erased ec (Refl _ _))
          (values w2 f2 u2 (MkWElt ys g w2 (setnth-nth _ xs g _ ys st)) d2))
        ((Unequal _ _ _ _ ap) (values w1 f1 u1 (welt-set xs ys g w1 i _ x1 st (r4c-apart-sym g i ap)) d1))))
    (match erased iv _
      ((NivL _ _ _ wa ba ma fa ua _ _ xa da _)
        (let ((erased _) (erased eb) (erased ec) (erased _)) (r4g-wd-eq xs g wa ba ma fa ua w1 b1 cm1 f1 u1 xa da x1 d1))
        (let-match erased eb (Refl _ _))
        (let-match erased ec (Refl _ _))
        (NivL ys g lo w3 b1 cm1 f3 u3 s0 (BFalse) x3 d3 (ZfA f3)))
      ((NivN _ j1 _ wa ba ma fa ua _ bn m1 m2 m3 c0 c1 c2 c3 _ xa da _ gb bl k0 k1 k2 k3)
        (let ((erased _) (erased eb) (erased ec) (erased _)) (r4g-wd-eq xs g wa ba ma fa ua w1 b1 cm1 f1 u1 xa da x1 d1))
        (let-match erased eb (Refl _ _))
        (let-match erased ec (Refl _ _))
        (NivN ys j1 g w3 b1 cm1 f3 u3 hi bn m1 m2 m3 c0 c1 c2 c3 (BFalse) x3 d3 (ZfA f3) gb bl
          (r4g-nivk-put xs ys j1 b1 cm1 (Zero) bn bn m1 i w w2 b cm f u f2 u2 c0 z k0 st x d d2) (r4g-nivk-put xs ys j1 b1 cm1 (Succ (Zero)) bn m1 m2 i w w2 b cm f u f2 u2 c1 z k1 st x d d2)
          (r4g-nivk-put xs ys j1 b1 cm1 (Succ (Succ (Zero))) bn m2 m3 i w w2 b cm f u f2 u2 c2 z k2 st x d d2)
          (r4g-nivk-put xs ys j1 b1 cm1 (Succ (Succ (Succ (Zero)))) bn m3 hi i w w2 b cm f u f2 u2 c3 z k3 st x d d2)))))
  ((erased r4g-nivk-put : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b0 cm0 s bn lo hc i w w2 b cm f u f2 u2) (erased (Gtree) c) (erased (Bool) z)
      (subterm erased (NIvK xs j b0 cm0 s c bn lo hc z) k) (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) ys) st) (erased (WElt xs i w) x) (erased (NWd w b cm f u) d)
      (erased (NWd w2 b cm f2 u2) d2) -> (erased (NIvK ys j b0 cm0 s c bn lo hc (BFalse)) r))
    (match erased k _
      ((NivkE _ _ _ _ _ _ _ _ _ bi lh) (NivkE ys j b0 cm0 s bn lo hc (BFalse) bi lh))
      ((NivkP _ _ _ _ _ v g lo2 hi2 _ _ _ _ _ bi rk a gn ll lh p)
        (NivkP ys j b0 cm0 s v g lo2 hi2 bn lo hc c (BFalse) bi rk a gn ll lh (r4g-niv-put xs ys j g lo2 hi2 i w w2 b cm f u f2 u2 c z p st x d d2))))))

; The bits of a ghit entry, each as GhC says.
(def-fns _ $ (erased r4g-gh-bits : (erased (Nat) m x v) (erased (Bstack) bs) (erased (GhAt m bs x v) ga) -> (erased (Nat) t) (erased (Bit) c0 c1 c2 c3)
    (erased (BitIs v (Zero) c0) v0) (erased (BitIs v (Succ (Zero)) c1) v1) (erased (BitIs v (Succ (Succ (Zero))) c2) v2) (erased (BitIs v (Succ (Succ (Succ (Zero)))) c3) v3)
    (erased (GhC m t x (Zero) c0) h0) (erased (GhC m t x (Succ (Zero)) c1) h1) (erased (GhC m t x (Succ (Succ (Zero))) c2) h2) (erased (GhC m t x (Succ (Succ (Succ (Zero)))) c3) h3))
  (let-match erased ga (MkGhAt _ _ _ i tm t _ tn p q ge))
  (let-match erased ge (GheOk _ x2 tm2 t2 m2 _ c0 c1 c2 c3 p2 q2 _ v0 v1 v2 v3 h0 h1 h2 h3)
    (absurd (GheT3 _ x2 tm2 m2 _ p2 q2 _)
      (let ((erased ex) (erased et)) (bsp-fn 3 i x tm x2 tm2 p p2))
      (let-match erased et (Refl _ _))
      (let ((erased e3) (erased _)) (bsp-fn 2 tm t m (Succ (Succ (Succ (Zero)))) m2 q q2))
      (let-match erased e3 (Refl _ _))
      (match erased tn _)))
  (let ((erased ex) (erased et)) (bsp-fn 3 i x tm x2 tm2 p p2))
  (let-match erased ex (Refl _ _))
  (let-match erased et (Refl _ _))
  (let ((erased e2) (erased em)) (bsp-fn 2 tm t m t2 m2 q q2))
  (let-match erased e2 (Refl _ _))
  (let-match erased em (Refl _ _))
  (values t c0 c1 c2 c3 v0 v1 v2 v3 h0 h1 h2 h3))

; Bit c is at most bit d.
(def-adts $ (BLe : ((Bit) c) ((Bit) d) -> Type)
  enum
  (many BlZ : (erased (Bit) d) -> (BLe (Bit0) d))
  (many BlO : -> (BLe (Bit1) (Bit1))))

(def-fns _ $ (erased r4g-ghc-le : (erased (Nat) m t x s) (erased (Bit) c d) (erased (GhC m t x s c) h) (erased (BitIs m s d) bd) -> (erased (BLe c d) r))
  (let-match erased h (GhY _ _ _ _ _ _ _ _ bm _ _ _) ((GhZ _ _ _ _) (BlZ d)))
  (let-match erased (bitis-fn m s (Bit1) d bm bd) (Refl _ _))
  (BlO))

(def-fns _ $ (erased r4g-ble-1 : (erased (Bit) f) -> (erased (BLe f (Bit1)) r))
  (match erased f _ ((Bit0) (BlZ (Bit1))) ((Bit1) (BlO))))

(def-fns _ $ (erased r4g-ble-or : (erased (Bit) c e f d) (erased (BLe c d) p) (erased (BLe e d) q) (erased (BitApply or-op c e f) ap) -> (erased (BLe f d) r))
  (let-match erased p (BlZ _) ((BlO) (r4g-ble-1 f)))
  (let-match erased q (BlZ _) ((BlO) (r4g-ble-1 f)))
  (let-match erased ap (Ap00 _))
  (BlZ d))

; Each set bit of r below 16 is one of m.
(def-adts $ (RIn : ((Nat) r) ((Nat) m) -> Type)
  enum
  (many MkRIn : (erased (Nat) r m) (erased (Bit) c0 c1 c2 c3 d0 d1 d2 d3) (erased (BitIs r (Zero) c0) r0) (erased (BitIs r (Succ (Zero)) c1) r1)
      (erased (BitIs r (Succ (Succ (Zero))) c2) r2) (erased (BitIs r (Succ (Succ (Succ (Zero)))) c3) r3) (erased (BitIs m (Zero) d0) m0) (erased (BitIs m (Succ (Zero)) d1) m1)
      (erased (BitIs m (Succ (Succ (Zero))) d2) m2) (erased (BitIs m (Succ (Succ (Succ (Zero)))) d3) m3) (erased (BLe c0 d0) l0) (erased (BLe c1 d1) l1) (erased (BLe c2 d2) l2)
      (erased (BLe c3 d3) l3) (erased (Lt r 16) rl) -> (RIn r m)))

(def-fns _ $ (erased r4g-rin-zero : (erased (Nat) m) (erased (Lt m 16) ml) -> (erased (RIn (Zero) m) r))
  (let ((erased _) (erased _) (erased _) (erased _) (erased y0) (erased y1) (erased y2) (erased y3) (erased _) (erased _) (erased _) (erased _) (erased a)) (r4-bit4 m ml))
  (let ((erased m0) (erased m1) (erased m2) (erased m3)) (r4g-ac4-bits y0 y1 y2 y3 m a))
  (let-match erased r4-e0 (Refl _ _))
  (MkRIn (Zero) m (Bit0) (Bit0) (Bit0) (Bit0) y0 y1 y2 y3 (r4c-bitis-of0 _) (r4c-bitis-of0 _) (r4c-bitis-of0 _) (r4c-bitis-of0 _) m0 m1 m2 m3 (BlZ y0) (BlZ y1) (BlZ y2) (BlZ y3)
    r4g-0-16))

(def-fns _ $ (erased r4g-rin-bit : (erased (Nat) r v r1 m t x d) (erased (Bit) c e dm) (erased (BitIs r d c) br) (erased (BitIs v d e) bv) (erased (BitIs m d dm) bm) (erased (BLe c dm) l)
    (erased (GhC m t x d e) h) (erased (Bitwise or-op r v r1) o) -> (erased (Bit) f) (erased (BitIs r1 d f) b1) (erased (BLe f dm) l1))
  (let ((erased f) (erased ap)) (bit-apply or-op c e))
  (values f (r4c-bw-bitis or-op r v r1 d c e f o br bv ap) (r4g-ble-or c e f dm l (r4g-ghc-le m t x d e dm h bm) ap)))

; Or-ing in a ghit entry for the symbols m keeps r within m.
(def-fns _ $ (erased r4g-rin-or : (erased (Nat) r m x v r1) (erased (Bstack) bs) (erased (RIn r m) ri) (erased (GhAt m bs x v) ga) (erased (Bitwise or-op r v r1) o) (erased (Lt r1 16) rl1)
    -> (erased (RIn r1 m) res))
  (let-match erased ri (MkRIn _ _ c0 c1 c2 c3 d0 d1 d2 d3 p0 p1 p2 p3 m0 m1 m2 m3 l0 l1 l2 l3 _))
  (let ((erased t) (erased e0) (erased e1) (erased e2) (erased e3) (erased v0) (erased v1) (erased v2) (erased v3) (erased h0) (erased h1) (erased h2) (erased h3)) (r4g-gh-bits m x v bs ga))
  (let ((erased f0) (erased b0) (erased k0)) (r4g-rin-bit r v r1 m t x _ c0 e0 d0 p0 v0 m0 l0 h0 o))
  (let ((erased f1) (erased b1) (erased k1)) (r4g-rin-bit r v r1 m t x _ c1 e1 d1 p1 v1 m1 l1 h1 o))
  (let ((erased f2) (erased b2) (erased k2)) (r4g-rin-bit r v r1 m t x _ c2 e2 d2 p2 v2 m2 l2 h2 o))
  (let ((erased f3) (erased b3) (erased k3)) (r4g-rin-bit r v r1 m t x _ c3 e3 d3 p3 v3 m3 l3 h3 o))
  (MkRIn r1 m f0 f1 f2 f3 d0 d1 d2 d3 b0 b1 b2 b3 m0 m1 m2 m3 k0 k1 k2 k3 rl1))

(def-fns _ $ (erased r4g-tm-sym : (erased (Gsym) g) (erased (Nat) t) (erased (Col) e) (erased (Bstack) bs) (erased (TMatch g t e) tm) (erased (TopN bs t) tn)
    -> (erased (Bstack) bs2) (erased (Sym g bs e bs2) y))
  (match erased tm _
    ((TmPu2 _) (values (BP0 bs) (SPush2 bs)))
    ((TmPu3 _) (values (BP1 bs) (SPush3 bs)))
    ((TmSk _) (values bs (SSkip bs)))
    ((TmP02) (let-match erased tn (Tn0 c)) (values c (SPop02 c)))
    ((TmP03) (let-match erased tn (Tn1 c)) (values c (SPop03 c)))
    ((TmP13) (let-match erased tn (Tn0 c)) (values c (SPop13 c)))
    ((TmP12) (let-match erased tn (Tn1 c)) (values c (SPop12 c)))))

(def-fns _ $ (erased r4g-ghc-y : (erased (Nat) m t x s) (erased (Gsym) g) (erased (Bstack) bs) (erased (GhC m t x s (Bit1)) h) (erased (SymN s g) sn) (erased (TopN bs t) tn)
    -> (erased (Col) e) (erased (Nat) d) (erased (Bstack) bs2) (erased (BitIs m s (Bit1)) bm) (erased (CD d e) cd) (erased (BitIs x d (Bit1)) bx) (erased (Sym g bs e bs2) y))
  (let-match erased h (GhY _ _ _ _ d g2 e sn2 bm cd bx tm))
  (let ((erased e1))
    (match erased sn (((Eq (Gsym) g2 g) q))
      ((SnPush) (let-match erased sn2 (SnPush)) (Refl _ g2))
      ((SnSkip) (let-match erased sn2 (SnSkip)) (Refl _ g2))
      ((SnPop0) (let-match erased sn2 (SnPop0)) (Refl _ g2))
      ((SnPop1) (let-match erased sn2 (SnPop1)) (Refl _ g2))))
  (let-match erased e1 (Refl _ _))
  (let ((erased bs2) (erased y)) (r4g-tm-sym g t e bs tm tn))
  (values e d bs2 bm cd bx y))

; A set bit s of red4's ghit entry v for the symbols m under the stack bs against the trie bits x: s is in m and, under bs, takes a colour e whose
; bit d is set in x.
(def-fns _ $ (erased r4g-gh-bit : (erased (Nat) m x v s) (erased (Gsym) g) (erased (Bstack) bs) (erased (GhAt m bs x v) ga) (erased (SymN s g) sn) (erased (BitIs v s (Bit1)) bv)
    -> (erased (Col) e) (erased (Nat) d) (erased (Bstack) bs2) (erased (BitIs m s (Bit1)) bm) (erased (CD d e) cd) (erased (BitIs x d (Bit1)) bx) (erased (Sym g bs e bs2) y))
  (let-match erased ga (MkGhAt _ _ _ i tm t _ tn p q ge))
  (let-match erased ge (GheOk _ x2 tm2 t2 m2 _ c0 c1 c2 c3 p2 q2 _ v0 v1 v2 v3 h0 h1 h2 h3)
    (absurd (GheT3 _ x2 tm2 m2 _ p2 q2 _)
      (let ((erased ex) (erased et)) (bsp-fn 3 i x tm x2 tm2 p p2))
      (let-match erased et (Refl _ _))
      (let ((erased e3) (erased _)) (bsp-fn 2 tm t m (Succ (Succ (Succ (Zero)))) m2 q q2))
      (let-match erased e3 (Refl _ _))
      (match erased tn _)))
  (let ((erased ex) (erased et)) (bsp-fn 3 i x tm x2 tm2 p p2))
  (let-match erased ex (Refl _ _))
  (let-match erased et (Refl _ _))
  (let ((erased e2) (erased em)) (bsp-fn 2 tm t m t2 m2 q q2))
  (let-match erased e2 (Refl _ _))
  (let-match erased em (Refl _ _))
  (match erased sn _
    ((SnPush) (let-match erased (bitis-fn v (Zero) c0 (Bit1) v0 bv) (Refl _ _)) (r4g-ghc-y m t x (Zero) g bs h0 sn tn))
    ((SnSkip) (let-match erased (bitis-fn v (Succ (Zero)) c1 (Bit1) v1 bv) (Refl _ _)) (r4g-ghc-y m t x (Succ (Zero)) g bs h1 sn tn))
    ((SnPop0) (let-match erased (bitis-fn v (Succ (Succ (Zero))) c2 (Bit1) v2 bv) (Refl _ _)) (r4g-ghc-y m t x (Succ (Succ (Zero))) g bs h2 sn tn))
    ((SnPop1) (let-match erased (bitis-fn v (Succ (Succ (Succ (Zero)))) c3 (Bit1) v3 bv) (Refl _ _)) (r4g-ghc-y m t x (Succ (Succ (Succ (Zero)))) g bs h3 sn tn))))

; c is Bit0, or the symbol s is hit by r.
(def-adts $ (BitHit : ((Bit) c) ((List RC) r) ((Gsym) s) -> Type)
  enum
  (many BtZ : (erased (List RC) r) (erased (Gsym) s) -> (BitHit (Bit0) r s))
  (many BtY : (erased (List RC) r) (erased (Gsym) s) (erased (Hits r (Cons (Gsym) s (Nil (Gsym)))) h) -> (BitHit (Bit1) r s)))

; Each set bit of the leaf word m names a symbol hit by r.
(def-adts $ (LHit : ((Nat) m) ((List RC) r) -> Type)
  enum
  (many MkLHit : (erased (Nat) m) (erased (List RC) r) (erased (Bit) c0 c1 c2 c3) (erased (BitIs m (Zero) c0) m0) (erased (BitIs m (Succ (Zero)) c1) m1)
      (erased (BitIs m (Succ (Succ (Zero))) c2) m2) (erased (BitIs m (Succ (Succ (Succ (Zero)))) c3) m3) (erased (BitHit c0 r (GPush)) h0) (erased (BitHit c1 r (GSkip)) h1)
      (erased (BitHit c2 r (GPop0)) h2) (erased (BitHit c3 r (GPop1)) h3) -> (LHit m r)))

(def-fns _ $ (erased r4g-lhit-zero : (erased (List RC) r) -> (erased (LHit (Zero) r) res))
  (MkLHit (Zero) r (Bit0) (Bit0) (Bit0) (Bit0) (r4c-bitis-of0 _) (r4c-bitis-of0 _) (r4c-bitis-of0 _) (r4c-bitis-of0 _) (BtZ r (GPush)) (BtZ r (GSkip)) (BtZ r (GPop0))
    (BtZ r (GPop1))))

(def-fns _ $ (erased r4g-bh-cons : (erased RC x) (erased (List RC) r) (erased (Bit) c) (erased (Gsym) s) (erased (BitHit c r s) h) -> (erased (BitHit c (Cons RC x r) s) res))
  (let-match erased h (BtY _ _ hs) ((BtZ _ _) (BtZ _ s)))
  (let-match erased hs (MkHits _ _ bs t et el m mt))
  (BtY _ s (MkHits (Cons RC x r) _ bs t et (ElThere RC (MkRx (Ctree) bs t) x r el) m mt)))

(def-fns _ $ (erased r4g-lhit-cons : (erased RC x) (erased (List RC) r) (erased (Nat) m) (erased (LHit m r) lh) -> (erased (LHit m (Cons RC x r)) res))
  (let-match erased lh (MkLHit _ _ c0 c1 c2 c3 m0 m1 m2 m3 h0 h1 h2 h3))
  (MkLHit m _ c0 c1 c2 c3 m0 m1 m2 m3 (r4g-bh-cons x r c0 _ h0) (r4g-bh-cons x r c1 _ h1) (r4g-bh-cons x r c2 _ h2) (r4g-bh-cons x r c3 _ h3)))

(def-fns _ $ (erased r4g-hit-of : (erased (List (U8)) cs) (erased (Nat) n m x v s) (erased (Ctree) t) (erased (Bstack) bs) (erased (Gsym) g) (erased (List RC) r)
    (erased (Elem RC (MkRx (Ctree) bs t) r) el) (erased (Ca cs (Zero) n t) f) (erased (Elt flag-w cs n x) ex) (erased (GhAt m bs x v) ga) (erased (SymN s g) sn)
    (erased (BitIs v s (Bit1)) bv) -> (erased (Hits r (Cons (Gsym) g (Nil (Gsym)))) h))
  (let ((erased e) (erased d) (erased bs2) (erased _) (erased cd) (erased bx) (erased y)) (r4g-gh-bit m x v s g bs ga sn bv))
  (let-match erased f (CaL _ _ c t1 t2 t3 y1 b _)
    (absurd (CaE _ _ _ z)
      (let-match erased z (MkZr _ _ _ _ z0 _ _ _ _))
      (let-match erased (elt-fn flag-w cs n x (Zero) ex z0) (Refl _ _))
      (bitis-fn (Zero) d (Bit0) (Bit1) (r4c-bitis-of0 d) bx)))
  (let-match erased (elt-fn flag-w cs n x c ex y1) (Refl _ _))
  (let ((erased u) (erased sl)) (sel-exists t e))
  (let ((erased a) (erased bi) (erased lf)) (r4c-b3-sel x d t1 t2 t3 u e b cd sl))
  (let-match erased (bitis-fn x d a (Bit1) bi bx) (Refl _ _))
  (let-match erased lf (LfL lf1))
  (MkHits r (Cons _ g (Nil _)) bs t (Cons _ e (Nil _)) el (mem-cons t u e (Nil _) sl (leaf-mem lf1)) (MPCons bs bs2 e g (Nil _) (Nil _) y (MPNil bs2))))

(def-fns _ $ (erased r4g-lhit-bit : (erased (List (U8)) cs) (erased (Nat) n m x v r r1 s) (erased (Ctree) t) (erased (Bstack) bs) (erased (Gsym) g) (erased (List RC) rr)
    (erased (Elem RC (MkRx (Ctree) bs t) rr) el) (erased (Ca cs (Zero) n t) f) (erased (Elt flag-w cs n x) ex) (erased (GhAt m bs x v) ga) (erased (SymN s g) sn)
    (erased (Bitwise or-op r v r1) o) (erased (Bit) c e) (erased (BitIs r s c) br) (erased (BitIs v s e) bv) (erased (BitHit c rr g) h)
    -> (erased (Bit) c1) (erased (BitIs r1 s c1) b1) (erased (BitHit c1 rr g) h1))
  (let ((erased c1) (erased ap)) (bit-apply or-op c e))
  (let ((erased h1))
    (match erased ap (((BitHit c1 rr g) q))
      ((Ap00 _) h)
      ((Ap01 _ _ _) (BtY rr g (r4g-hit-of cs n m x v s t bs g rr el f ex ga sn bv)))
      ((Ap10 _ _ _) h)
      ((Ap11 _ _ _) h)))
  (values c1 (r4c-bw-bitis or-op r v r1 s c e c1 o br bv ap) h1))

(def-fns _ $ (erased r4g-lhit-or : (erased (List (U8)) cs) (erased (Nat) n m x v r r1) (erased (Ctree) t) (erased (Bstack) bs) (erased (List RC) rr)
    (erased (Elem RC (MkRx (Ctree) bs t) rr) el) (erased (Ca cs (Zero) n t) f) (erased (Elt flag-w cs n x) ex) (erased (GhAt m bs x v) ga)
    (erased (Bitwise or-op r v r1) o) (erased (LHit r rr) lh) -> (erased (LHit r1 rr) res))
  (let-match erased lh (MkLHit _ _ c0 c1 c2 c3 m0 m1 m2 m3 h0 h1 h2 h3))
  (let ((erased _) (erased e0) (erased e1) (erased e2) (erased e3) (erased v0) (erased v1) (erased v2) (erased v3) (erased _) (erased _) (erased _) (erased _))
    (r4g-gh-bits m x v bs ga))
  (let ((erased f0) (erased b0) (erased k0)) (r4g-lhit-bit cs n m x v r r1 (Zero) t bs (GPush) rr el f ex ga (SnPush) o c0 e0 m0 v0 h0))
  (let ((erased f1) (erased b1) (erased k1)) (r4g-lhit-bit cs n m x v r r1 (Succ (Zero)) t bs (GSkip) rr el f ex ga (SnSkip) o c1 e1 m1 v1 h1))
  (let ((erased f2) (erased b2) (erased k2)) (r4g-lhit-bit cs n m x v r r1 (Succ (Succ (Zero))) t bs (GPop0) rr el f ex ga (SnPop0) o c2 e2 m2 v2 h2))
  (let ((erased f3) (erased b3) (erased k3)) (r4g-lhit-bit cs n m x v r r1 (Succ (Succ (Succ (Zero)))) t bs (GPop1) rr el f ex ga (SnPop1) o c3 e3 m3 v3 h3))
  (MkLHit r1 rr f0 f1 f2 f3 b0 b1 b2 b3 k0 k1 k2 k3))

(def-fns _ $ (erased r4g-bh-bool : (erased (Bool) b) (erased (Bit) c) (erased (List RC) r) (erased (Gsym) s) (erased (BoolBit b c) e) (erased (BitHit c r s) h)
    -> (erased (BitHits b r s) res))
  (let-match erased e (BBT) ((BBF) (BHF r s)))
  (let-match erased h (BtY _ _ hs))
  (BHT r s hs))

(def-fns _ $ (erased r4g-leaf-ghit : (erased (Gtree) a) (erased (Nat) m) (erased (List RC) r) (erased (LeafM a m) la) (erased (LHit m r) lh) -> (erased (GHit (GSG a) r) res))
  (let ((erased b0) (erased b1) (erased b2) (erased b3) (erased x0) (erased x1) (erased x2) (erased x3) (erased ls) (erased e0) (erased e1) (erased e2) (erased e3)
        (erased k0) (erased k1) (erased k2) (erased k3)) (r4g-lm-bits a m la))
  (let-match erased lh (MkLHit _ _ c0 c1 c2 c3 m0 m1 m2 m3 h0 h1 h2 h3))
  (let-match erased (bitis-fn m (Zero) x0 c0 k0 m0) (Refl _ _))
  (let-match erased (bitis-fn m (Succ (Zero)) x1 c1 k1 m1) (Refl _ _))
  (let-match erased (bitis-fn m (Succ (Succ (Zero))) x2 c2 k2 m2) (Refl _ _))
  (let-match erased (bitis-fn m (Succ (Succ (Succ (Zero)))) x3 c3 k3 m3) (Refl _ _))
  (leaf-hit a b0 b1 b2 b3 r ls (r4g-bh-bool b0 x0 r (GPush) e0 h0) (r4g-bh-bool b1 x1 r (GSkip) e1 h1) (r4g-bh-bool b2 x2 r (GPop0) e2 h2)
    (r4g-bh-bool b3 x3 r (GPop1) e3 h3)))

; The pairs P, of k colours each, are the restrictions r of ctr: the pair at the prefix p with the stack bs is bs with the subtree of ctr at p.
(def-adts $ (PRx : ((Ctree) ctr) ((Nat) k) ((List (WP)) P) ((List RC) r) -> Type)
  enum
  (many PxNil : (erased (Ctree) ctr) (erased (Nat) k) -> (PRx ctr k (Nil (WP)) (Nil RC)))
  (many PxCons : (erased (Ctree) ctr t) (erased (Nat) k p) (erased (Bstack) bs) (erased (List (Col)) pre) (erased (List (WP)) P) (erased (List RC) r)
      (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (CtAt ctr pre t) ct) (erased (PRx ctr k P r) px)
      -> (PRx ctr k (Cons (WP) (MkWP p bs) P) (Cons RC (MkRx (Ctree) bs t) r))))

(def-fns _ $ (erased r4g-prx-kid : (erased (Ctree) ctr t) (erased (Nat) k p q) (erased (Gsym) g) (erased (Col) e) (erased (Bstack) bs bs2) (erased (List (Col)) pre)
    (erased (List (WP)) Q0) (erased (List RC) rr r0) (erased (RIdx pre p) ri) (erased (Length (Col) pre k) le) (erased (CtAt ctr pre t) ct)
    (erased (Elem RC (MkRx (Ctree) bs t) rr) el) (erased (Kid p e q) kd) (erased (Sym g bs e bs2) y) (erased (PRx ctr (Succ k) Q0 r0) px) (erased (RJust g rr r0) j)
    -> (erased (List RC) r2) (erased (PRx ctr (Succ k) (Cons (WP) (MkWP q bs2) Q0) r2) px2) (erased (RJust g rr r2) j2))
  (let ((erased t2) (erased sl)) (sel-exists t e))
  (values (Cons RC (MkRx (Ctree) bs2 t2) r0) (PxCons ctr t2 (Succ k) q bs2 (Cons _ e pre) Q0 r0 (RICons pre p q e ri kd) (LengthCons _ e pre k le) (AtCons ctr t t2 pre e ct sl) px)
    (RJCons g rr r0 bs bs2 t t2 e el y sl j)))

(def-fns _ $ (erased r4g-prx-stp : (erased (Ctree) ctr) (erased (Nat) k) (erased (Gsym) g) (erased (List (WP)) P Q) (erased (List RC) r rr) (subterm erased (WStp g P Q) st)
    (erased (PRx ctr k P r) px) (erased (Suffix RC r rr) sf) -> (erased (List RC) r2) (erased (PRx ctr (Succ k) Q r2) px2) (erased (RJust g rr r2) j))
  (let-match erased st (WtCons _ x P1 Q0 _ st1 ch) ((WtNil _) (values (Nil RC) (PxNil ctr (Succ k)) (RJNil g rr))))
  (let-match erased px (PxCons _ t _ p bs pre _ r1 ri le ct px1))
  (let ((erased el)) (suffix-elem RC (MkRx (Ctree) bs t) r rr sf (ElHere RC (MkRx (Ctree) bs t) r1)))
  (let ((erased r0) (erased px0) (erased j0)) (r4g-prx-stp ctr k g P1 Q0 r1 rr st1 px1 (SufNext RC (MkRx (Ctree) bs t) r1 rr sf)))
  (let-match erased ch (WhPush _ q2 q3 _ k2 k3 _)
    ((WhSkip _ q _ kq _) (r4g-prx-kid ctr t k p q g (C1) bs bs pre Q0 rr r0 ri le ct el kq (SSkip bs) px0 j0))
    ((WhPop _ q _ e _ b _ y kq _) (r4g-prx-kid ctr t k p q g e bs b pre Q0 rr r0 ri le ct el kq y px0 j0))
    ((WhNone _ _ _ _) (values r0 px0 j0)))
  (let ((erased r3) (erased px3) (erased j3)) (r4g-prx-kid ctr t k p q3 g (C3) bs (BP1 bs) pre Q0 rr r0 ri le ct el k3 (SPush3 bs) px0 j0))
  (r4g-prx-kid ctr t k p q2 g (C2) bs (BP0 bs) pre _ rr r3 ri le ct el k2 (SPush2 bs) px3 j3))

(def-fns _ $ (erased r4g-prx-flt : (erased (Ctree) ctr) (erased (List (U8)) us) (erased (Nat) k j) (erased (Gsym) g) (erased (List (WP)) Q R) (erased (List (WEv)) E0 E)
    (erased (List RC) rq rr) (subterm erased (WFlt us k j Q R E0 E) f) (erased (PRx ctr k Q rq) px) (erased (RJust g rr rq) jq)
    -> (erased (List RC) r2) (erased (PRx ctr k R r2) px2) (erased (RJust g rr r2) j2))
  (match erased f _
    ((WfNil _ _ _ _) (values (Nil RC) (PxNil ctr k) (RJNil g rr)))
    ((WfKeep _ _ _ q _ _ _ bs Q1 R1 _ _ _ _ _ _ f1)
      (let-match erased px (PxCons _ t _ _ _ pre _ rq1 ri le ct px1))
      (let-match erased jq (RJCons _ _ _ bs0 _ t0 _ e el y sl jq1))
      (let ((erased r3) (erased px3) (erased j3)) (r4g-prx-flt ctr us k j g Q1 R1 E0 E rq1 rr f1 px1 jq1))
      (values (Cons RC (MkRx (Ctree) bs t) r3) (PxCons ctr t k q bs pre R1 r3 ri le ct px3) (RJCons g rr r3 bs0 bs t0 t e el y sl j3)))
    ((WfDrop _ _ _ _ _ _ _ Q1 _ _ _ _ _ _ f1)
      (let-match erased px (PxCons _ _ _ _ _ _ _ rq1 _ _ _ px1))
      (let-match erased jq (RJCons _ _ _ _ _ _ _ _ _ _ _ jq1))
      (r4g-prx-flt ctr us k j g Q1 R _ E rq1 rr f1 px1 jq1))))

; Each kid a of as, from the symbol number s on, is hit by restrictions that its symbol advances r to.
(def-adts $ (HitL : ((List RC) r) ((Nat) s) ((List (Gtree)) as) -> Type)
  enum
  (many HlNil : (erased (List RC) r) (erased (Nat) s) -> (HitL r s (Nil (Gtree))))
  (many HlCons : (erased (List RC) r r1) (erased (Nat) s) (erased (Gsym) g) (erased (Gtree) a) (erased (List (Gtree)) as) (erased (SymN s g) sn) (erased (RJust g r r1) j)
      (erased (GHit (GSG a) r1) h) (erased (HitL r (Succ s) as) l) -> (HitL r s (Cons (Gtree) a as))))

(def-fns _ $ (erased r4g-hitl4 : (erased (List RC) r) (erased (Gtree) a0 a1 a2 a3)
    (erased (HitL r (Zero) (Cons (Gtree) a0 $ Cons (Gtree) a1 $ Cons (Gtree) a2 $ Cons (Gtree) a3 $ Nil (Gtree))) l) -> (erased (GHit (GSG (GNode a0 a1 a2 a3)) r) res))
  (let-match erased l (HlCons _ r0 _ _ _ _ s0 j0 h0 l1))
  (let-match erased s0 (SnPush))
  (let-match erased l1 (HlCons _ r1 _ _ _ _ s1 j1 h1 l2))
  (let-match erased s1 (SnSkip))
  (let-match erased l2 (HlCons _ r2 _ _ _ _ s2 j2 h2 l3))
  (let-match erased s2 (SnPop0))
  (let-match erased l3 (HlCons _ r3 _ _ _ _ s3 j3 h3 _))
  (let-match erased s3 (SnPop1))
  (node-ghit a0 a1 a2 a3 r r0 r1 r2 r3 j0 j1 j2 j3 h0 h1 h2 h3))

(def-fns _ $ (erased r4g-xt-sym : (erased (Nat) p p2) (erased (Bstack) bs bsc) (erased (Gsym) g) (erased (XtP p bs g p2) xp) (erased (KStk g bs bsc) ks) (erased (Lt p2 r4-none) l)
    -> (erased (Col) e) (erased (Kid p e p2) kd) (erased (Sym g bs e bsc) y))
  (match erased xp _
    ((XpPush _ _ _ k _) (let-match erased ks (KsPush _) (absurd (KsPop _ _ _ ip _) ip)) (values (C2) k (SPush2 bs)))
    ((XpSkip _ _ _ k _) (let-match erased ks (KsSkip _) (absurd (KsPop _ _ _ ip _) ip)) (values (C1) k (SSkip bs)))
    ((XpPop _ _ _ e _ c pp y k _)
      (let ((erased ip)) (xpop-pop g bs c e y pp))
      (let-match erased ks (KsPop _ _ c2 _ pp2) (absurd (KsPush _) ip) (absurd (KsSkip _) ip))
      (let-match erased (popped-fn bs c c2 pp pp2) (Refl _ _))
      (values e k y))
    (absurd (XpNone _ _ _) (lt-irrefl r4-none l))))

(def-fns _ $ (erased r4g-ble-bp : (erased (Bool) u) (erased (Bit) xu c) (erased (BoolBit u xu) eu) (erased (BLe c xu) l) -> (erased (Bool) a y) (erased (BoolBit a c) ea) (erased (BitPart u a y) q))
  (match erased l _
    ((BlO) (let-match erased eu (BBT)) (values (BTrue) (BFalse) (BBT) (BPL)))
    ((BlZ _) (match erased eu _ ((BBT) (values (BFalse) (BTrue) (BBF) (BPR))) ((BBF) (values (BFalse) (BFalse) (BBF) (BPN)))))))

; A leaf's marks r within its symbols fu in gu: the leaf of the marked symbols, within u.
(def-fns _ $ (erased r4g-gw-lf : (erased (Nat) r fu) (erased (Gtree) u) (erased (RIn r fu) ri) (erased (LeafM u fu) lu) -> (erased (Gtree) a) (erased (LeafM a r) la) (erased (GSub u a) gs))
  (let ((erased u0) (erased u1) (erased u2) (erased u3) (erased x0) (erased x1) (erased x2) (erased x3) (erased lsu) (erased e0) (erased e1) (erased e2) (erased e3)
        (erased n0) (erased n1) (erased n2) (erased n3)) (r4g-lm-bits u fu lu))
  (let-match erased ri (MkRIn _ _ c0 c1 c2 c3 d0 d1 d2 d3 r0 r1 r2 r3 m0 m1 m2 m3 l0 l1 l2 l3 rl))
  (let-match erased (bitis-fn fu (Zero) x0 d0 n0 m0) (Refl _ _))
  (let-match erased (bitis-fn fu (Succ (Zero)) x1 d1 n1 m1) (Refl _ _))
  (let-match erased (bitis-fn fu (Succ (Succ (Zero))) x2 d2 n2 m2) (Refl _ _))
  (let-match erased (bitis-fn fu (Succ (Succ (Succ (Zero)))) x3 d3 n3 m3) (Refl _ _))
  (let ((erased a0) (erased y0) (erased f0) (erased q0)) (r4g-ble-bp u0 x0 c0 e0 l0))
  (let ((erased a1) (erased y1) (erased f1) (erased q1)) (r4g-ble-bp u1 x1 c1 e1 l1))
  (let ((erased a2) (erased y2) (erased f2) (erased q2)) (r4g-ble-bp u2 x2 c2 e2 l2))
  (let ((erased a3) (erased y3) (erased f3) (erased q3)) (r4g-ble-bp u3 x3 c3 e3 l3))
  (let ((erased a) (erased lsa)) (leaf-sub u u0 u1 u2 u3 a0 a1 a2 a3 y0 y1 y2 y3 lsu q0 q1 q2 q3))
  (values a (r4g-leafm-of a a0 a1 a2 a3 c0 c1 c2 c3 r lsa f0 f1 f2 f3 r0 r1 r2 r3 rl) (GsbL u a u0 u1 u2 u3 a0 a1 a2 a3 y0 y1 y2 y3 lsu lsa q0 q1 q2 q3)))

(def-fns _ $ (erased r4g-subl4 : (erased (Gtree) u0 u1 u2 u3 a0 a1 a2 a3)
    (erased (SubL (Cons (Gtree) u0 $ Cons (Gtree) u1 $ Cons (Gtree) u2 $ Cons (Gtree) u3 $ Nil (Gtree)) (Cons (Gtree) a0 $ Cons (Gtree) a1 $ Cons (Gtree) a2 $ Cons (Gtree) a3 $ Nil (Gtree))) l)
    -> (erased (GSub (GNode u0 u1 u2 u3) (GNode a0 a1 a2 a3)) r))
