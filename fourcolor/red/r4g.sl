  (let ((erased ef) (erased _) (erased _) (erased _)) (r4g-wd-eq xs g wi bi cmi fi ui w b cm ftr fu xi di x d))
  (let-match erased ef (Refl _ _))
  (let-match erased zf (ZfZ))
  (let-match erased (bitwise-fn or-op (Zero) rv ftr2 rv o (or-sym rv (Zero) rv (or-zero-r rv (bits2-of rv)))) (Refl _ _))
  (let ((erased lu)) (r4g-np-lm xs g w b cm (Zero) fu fu s0 u (BFalse) pu x d (FdU (Zero) fu)))
  (let ((erased a) (erased la) (erased gs)) (r4g-gw-lf rv fu u ri lu))
  (let ((erased x2)) (MkWElt ys g w2 (setnth-nth _ xs g _ ys st)))
  (values a (NinCons xs ys ys g (RgOne g lo lo) (MkCopy (Nat) w2) st (IwG g lo lo) (NinNil ys _)) (NivL ys g lo w2 b cm rv fu s0 (BFalse) x2 d2 (ZfA rv))
    (NpL ys g w2 b cm rv fu fu s0 u (BFalse) x2 d2 (FdU rv fu) lu) (NpL ys g w2 b cm rv fu rv s0 a (BTrue) x2 d2 (FdT rv fu) la) gs (r4g-lm-pres a rv la ap)
    (r4g-leaf-ghit a rv rr la lh)))

(def-fns _
  ; A write that keeps a node word's first child and child mask keeps the layout.
  ((erased r4g-nlay-put : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g i w w2 b cm f u f2 u2) (erased (Gtree) s0) (subterm erased (NLay xs j g s0) ly)
      (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) ys) st) (erased (WElt xs i w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u2) d2) -> (erased (NLay ys j g s0) r))
    (match erased ly _
      ((NlL _ _ w1 b1 m1 f1 u1 _ x1 d1 lm)
        (let-match erased (nat-eq g i) (Equal _ _ _)
          ((Unequal _ _ _ _ ap) (NlL ys g w1 b1 m1 f1 u1 s0 (welt-set xs ys g w1 i _ x1 st (r4c-apart-sym g i ap)) d1 lm)))
        (let-match erased (welt-fn xs g w1 w x1 x) (Refl _ _))
        (let ((erased _) (erased e2) (erased e3)) (nwd-fn w1 b1 m1 f1 u1 b cm f u d1 d))
        (let-match erased e2 (Refl _ _))
        (let-match erased e3 (Refl _ _))
        (NlL ys g w2 b cm f2 u2 s0 (MkWElt ys g w2 (setnth-nth _ xs g _ ys st)) d2 lm))
      ((NlN _ j1 _ w1 b1 cm1 f1 u1 c0 c1 c2 c3 x1 d1 bb k0 k1 k2 k3)
        (let ((erased k0b) (erased k1b) (erased k2b) (erased k3b))
          (values (r4g-nlayk-put xs ys j1 b1 cm1 (Zero) i w w2 b cm f u f2 u2 c0 k0 st x d d2) (r4g-nlayk-put xs ys j1 b1 cm1 (Succ (Zero)) i w w2 b cm f u f2 u2 c1 k1 st x d d2)
            (r4g-nlayk-put xs ys j1 b1 cm1 (Succ (Succ (Zero))) i w w2 b cm f u f2 u2 c2 k2 st x d d2)
            (r4g-nlayk-put xs ys j1 b1 cm1 (Succ (Succ (Succ (Zero)))) i w w2 b cm f u f2 u2 c3 k3 st x d d2)))
        (let-match erased (nat-eq g i) (Equal _ _ _)
          ((Unequal _ _ _ _ ap) (NlN ys j1 g w1 b1 cm1 f1 u1 c0 c1 c2 c3 (welt-set xs ys g w1 i _ x1 st (r4c-apart-sym g i ap)) d1 bb k0b k1b k2b k3b)))
        (let-match erased (welt-fn xs g w1 w x1 x) (Refl _ _))
        (let ((erased _) (erased e2) (erased e3)) (nwd-fn w1 b1 cm1 f1 u1 b cm f u d1 d))
        (let-match erased e2 (Refl _ _))
        (let-match erased e3 (Refl _ _))
        (NlN ys j1 g w2 b cm f2 u2 c0 c1 c2 c3 (MkWElt ys g w2 (setnth-nth _ xs g _ ys st)) d2 bb k0b k1b k2b k3b))))
  ((erased r4g-nlayk-put : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b0 cm0 s i w w2 b cm f u f2 u2) (erased (Gtree) c) (subterm erased (NLayK xs j b0 cm0 s c) k)
      (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) ys) st) (erased (WElt xs i w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u2) d2)
      -> (erased (NLayK ys j b0 cm0 s c) r))
    (let-match erased k (NlkP _ _ _ _ _ v g1 _ bi rk a l) ((NlkE _ _ _ _ _ bi) (NlkE ys j b0 cm0 s bi)))
    (NlkP ys j b0 cm0 s v g1 c bi rk a (r4g-nlay-put xs ys j g1 i w w2 b cm f u f2 u2 c l st x d d2))))

; R relates the part fields f (gtr) and u (gu) of a word to those, f2 and u2, written over it: KeepU keeps u, AnyFld relates anything.
(def-adts $ (KeepU : ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type)
  enum
  (many MkKeepU : (erased (Nat) f u f2) -> (KeepU f u f2 u)))

(def-adts $ (AnyFld : ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type)
  enum
  (many MkAnyFld : (erased (Nat) f u f2 u2) -> (AnyFld f u f2 u2)))

; ys is xs after writes that each keep the written word's first child and child mask, and relate its part fields by R.
(def-adts $ (NKeep : ((TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) ((List (Copy (Nat))) xs) ((List (Copy (Nat))) ys) -> Type)
  enum
  (many NkNil : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs) -> (NKeep R xs xs))
  (many NkCons : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs xs1 ys) (erased (Nat) i w w2 b cm f u f2 u2)
      (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) xs1) st) (erased (WElt xs i w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u2) d2)
      (erased (R f u f2 u2) rr) (erased (NKeep R xs1 ys) k) -> (NKeep R xs ys)))

(def-fns _ $ (erased r4g-nk-cat : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs ys zs) (subterm erased (NKeep R xs ys) p)
    (erased (NKeep R ys zs) q) -> (erased (NKeep R xs zs) r))
  (let-match erased p (NkCons _ _ xs1 _ i w w2 b cm f u f2 u2 st x d d2 rr p1) ((NkNil _ _) q))
  (NkCons R xs xs1 zs i w w2 b cm f u f2 u2 st x d d2 rr (r4g-nk-cat R xs1 ys zs p1 q)))

(def-fns _ $ (erased r4g-nlay-keep : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g)
    (erased (Gtree) s0) (erased (NLay xs j g s0) ly) (subterm erased (NKeep R xs ys) k) -> (erased (NLay ys j g s0) r))
  (let-match erased k (NkCons _ _ xs1 _ i w w2 b cm f u f2 u2 st x d d2 _ k1) ((NkNil _ _) ly))
  (r4g-nlay-keep R xs1 ys j g s0 (r4g-nlay-put xs xs1 j g i w w2 b cm f u f2 u2 s0 ly st x d d2) k1))

(def-fns _ $ (erased r4g-niv-keep : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo hi)
    (erased (Gtree) s0) (erased (Bool) z) (erased (NIv xs j g s0 lo hi z) iv) (subterm erased (NKeep R xs ys) k) -> (erased (NIv ys j g s0 lo hi (BFalse)) r))
  (let-match erased k (NkCons _ _ xs1 _ i w w2 b cm f u f2 u2 st x d d2 _ k1) ((NkNil _ _) (r4g-niv-f xs j g lo hi s0 z iv)))
  (r4g-niv-keep R xs1 ys j g lo hi s0 (BFalse) (r4g-niv-put xs xs1 j g lo hi i w w2 b cm f u f2 u2 s0 z iv st x d d2) k1))

; A kid done, in front of the later kids done.
(def-fns _ $ (erased r4g-kd-cons : (erased (List (Copy (Nat))) ys1 ys) (erased (Nat) j b cm bn s lo hc hi) (erased (Gtree) c uk ak) (erased (List (Gtree)) ts us as)
    (erased (NIvK ys1 j b cm s c bn lo hc (BFalse)) iv) (erased (NPartK ys1 j b cm s c (BFalse) uk) pf) (erased (NPartK ys1 j b cm s c (BTrue) ak) pt) (erased (GSub uk ak) gs)
    (erased (NIn ys1 ys (RgKid b cm (Succ s) bn hc hi)) wn) (erased (KdL ys j b cm bn (Succ s) hc hi (BFalse) ts us as) kd) (erased (SubL us as) sl) (erased (Lt bn (Succ lo)) bl)
    -> (erased (KdL ys j b cm bn s lo hi (BFalse) (Cons (Gtree) c ts) (Cons (Gtree) uk us) (Cons (Gtree) ak as)) kd2) (erased (SubL (Cons (Gtree) uk us) (Cons (Gtree) ak as)) sl2))
  (let ((erased ko)) (KoB b cm s (Succ s) bn lo hc hc hi (lt-succ s) bl (le-trans bn lo hc bl (r4g-nivk-le ys1 j b cm s bn lo hc c (BFalse) iv)) (lt-succ hc)))
  (let ((erased iv2) (erased pf2)) (r4g-nin-kid ys1 ys j b cm s bn lo hc c uk (BFalse) (BFalse) (RgKid b cm (Succ s) bn hc hi) iv pf wn ko))
  (let ((erased _) (erased pt2)) (r4g-nin-kid ys1 ys j b cm s bn lo hc c ak (BTrue) (BFalse) (RgKid b cm (Succ s) bn hc hi) iv pt wn ko))
  (values (KdCons ys j b cm bn s lo hc hi (BFalse) c uk ak ts us as iv2 pf2 pt2 kd) (SuCons uk ak us as gs sl)))

; The writes of kid s, then of the later kids, lie in the kids' region from s on.
(def-fns _ $ (erased r4g-kd-nin : (erased (List (Copy (Nat))) xs ys1 ys) (erased (Nat) b cm s bn lo hc hi gc lo2 hi2 v) (erased (NIn xs ys1 (RgOne gc lo2 hi2)) w1)
    (erased (NIn ys1 ys (RgKid b cm (Succ s) bn hc hi)) w2) (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) rk) (erased (Add b v gc) a) (erased (Lt gc bn) gn)
    (erased (Lt lo (Succ lo2)) ll) (erased (Lt hi2 (Succ hc)) lh) (erased (Lt lo (Succ hc)) lhc) (erased (Lt hc (Succ hi)) hh) -> (erased (NIn xs ys (RgKid b cm s bn lo hi)) r))
  (r4g-nin-cat xs ys1 ys (RgKid b cm s bn lo hi) (r4g-nin-sub xs ys1 (RgOne gc lo2 hi2) (RgKid b cm s bn lo hi) w1 (RsKid gc lo2 hi2 b cm s bn lo hi v bi rk a gn ll (le-trans hi2 hc hi lh hh)))
    (r4g-nin-sub ys1 ys (RgKid b cm (Succ s) bn hc hi) (RgKid b cm s bn lo hi) w2 (RsNext b cm s bn lo hc hi lhc))))

(def-fns _ $ (erased r4g-nlayk-keep : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b0 cm0 s)
    (erased (Gtree) c) (erased (NLayK xs j b0 cm0 s c) ly) (subterm erased (NKeep R xs ys) k) -> (erased (NLayK ys j b0 cm0 s c) r))
  (let-match erased k (NkCons _ _ xs1 _ i w w2 b cm f u f2 u2 st x d d2 _ k1) ((NkNil _ _) ly))
  (r4g-nlayk-keep R xs1 ys j b0 cm0 s c (r4g-nlayk-put xs xs1 j b0 cm0 s i w w2 b cm f u f2 u2 c ly st x d d2) k1))

(def-fns _ $ (erased r4g-nls-keep : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b cm s)
    (erased (Gtree) t) (erased (List (Gtree)) ts) (subterm erased (NLs xs j b cm t s ts) nl) (erased (NKeep R xs ys) k) -> (erased (NLs ys j b cm t s ts) r))
  (let-match erased nl (NlsCons _ _ _ _ _ _ c ts1 g l sn sl ky nl1) ((NlsNil _ _ _ _ _) (NlsNil ys j b cm t)))
  (NlsCons ys j b cm s t c ts1 g l sn sl (r4g-nlayk-keep R xs ys j b cm s c ky k) (r4g-nls-keep R xs ys j b cm (Succ s) t ts1 nl1 k)))

(def-fns _ $ (erased r4g-mark-keep : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g m w w2 b cm ftr fu ftr2) (erased (SetNth (Copy (Nat)) xs g (MkCopy (Nat) w2) ys) s)
    (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d) (erased (NWd w2 b cm ftr2 fu) d2) -> (erased (NKeep KeepU xs ys) r))
  (NkCons KeepU xs ys ys g w w2 b cm ftr fu ftr2 fu s x d d2 (MkKeepU ftr fu ftr2) (NkNil KeepU ys)))

(comptime-match many (lt-dec 1 16) (Yes _ _ _ _ r4g-1-16))
(comptime-match many (lt-dec (Zero) 1) (Yes _ _ _ _ r4g-0-1))
(let ((erased r4g-1-nz)) (ApGt (Nat) Lt 1 (Zero) r4g-0-1))

(def-fns _ $ (erased r4g-and-sym : (erased (Nat) a b c) (subterm erased (Bitwise and-op a b c) p) -> (erased (Bitwise and-op b a c) r))
  (let-match erased p (BwBit _ a1 b1 c1 x y z _ _ _ p1 e pa pb pc) ((BwZero _) (BwZero and-op)))
  (let ((erased e2))
    (match erased e (((BitApply and-op y x z) e0))
      ((Ap00 _) (Ap00 and-op))
      ((Ap01 _ _ _) (Ap10 (Bit0) (Bit0) (Bit1)))
      ((Ap10 _ _ _) (Ap01 (Bit0) (Bit0) (Bit1)))
      ((Ap11 _ _ _) (Ap11 (Bit0) (Bit0) (Bit1)))))
  (BwBit and-op b1 a1 c1 y x z b a c (r4g-and-sym a1 b1 c1 p1) e2 pb pa pc))

; lnot 15 and lnot 240 within the 62 bits.
(let ((many r4g-y54) (erased r4g-o54)) (ones-c 54))
(let ((many r4g-y58) (erased r4g-o58)) (ones-c 58))
(let ((many r4g-k15) (erased _)) (mul r4g-y58 16))
(comptime-match many (bsp-chk 4 r4g-k15 (Zero) r4g-y58) (ESome _ r4g-bk15))
(comptime-match many (lt-dec r4g-k15 flag-um) (Yes _ _ _ _ r4g-k15-u62))
(let ((many r4g-y1) (erased _)) (mul r4g-y54 16))
(let ((many r4g-k240a) (erased _)) (mul r4g-y1 16))
(let ((many r4g-k240) (erased _)) (add r4g-k240a 15))
(comptime-match many (bsp-chk 4 r4g-k240 15 r4g-y1) (ESome _ r4g-bk240))
(comptime-match many (bsp-chk 4 r4g-y1 (Zero) r4g-y54) (ESome _ r4g-bk240h))
(comptime-match many (lt-dec r4g-k240 flag-um) (Yes _ _ _ _ r4g-k240-u62))
(comptime-match many (add-chk 4 58 (sixty-two-many)) (ESome _ r4g-a458))
(comptime-match many (add-chk 4 54 58) (ESome _ r4g-a454))

(def-fns _ $ (erased r4g-hi58 : (erased (Nat) w fu y1) (erased (Lt w u62-modulus) wb) (erased (Bsp 4 w fu y1) p) -> (erased (Bsp 58 y1 y1 (Zero)) r))
  (let ((erased lo1) (erased y) (erased lo2) (erased p1) (erased q1) (erased _)) (bsp-split 4 58 sixty-two w w (Zero) r4g-a458 (r4g-u62-bsp w wb)))
  (let ((erased _) (erased e)) (bsp-fn 4 w lo1 y fu y1 p1 p))
  (let-match erased e (Refl _ _))
  (let-match erased (bsp-zero-hi 58 y lo2 q1) (Refl _ _))
  q1)

(def-fns _ $ (erased r4g-hi54 : (erased (Nat) w fu y1 ftr y2) (erased (Lt w u62-modulus) wb) (erased (Bsp 4 w fu y1) p1) (erased (Bsp 4 y1 ftr y2) p2)
    -> (erased (Bsp 54 y2 y2 (Zero)) r))
  (let ((erased lo1) (erased y) (erased lo2) (erased q0) (erased q1) (erased _)) (bsp-split 4 54 58 y1 y1 (Zero) r4g-a454 (r4g-hi58 w fu y1 wb p1)))
  (let ((erased _) (erased e)) (bsp-fn 4 y1 lo1 y ftr y2 q0 p2))
  (let-match erased e (Refl _ _))
  (let-match erased (bsp-zero-hi 54 y lo2 q1) (Refl _ _))
  q1)

; red4's w land lnot 15 lor m in upd: the gu part of the word w set to m.
(def-fns _ $ (erased r4g-set-fu : (erased (Nat) w b cm ftr fu m a w2) (erased (Lt w u62-modulus) wb) (erased (NWd w b cm ftr fu) d) (erased (Lt m 16) ml)
    (erased (Bitwise and-op w r4g-k15 a) pa) (erased (Bitwise or-op a m w2) po) -> (erased (NWd w2 b cm ftr m) d2) (erased (Lt w2 u62-modulus) w2b))
  (let-match erased d (MkNWd _ _ _ _ _ y1 y2 p1 p2 p3))
  (let ((erased al) (erased ah) (erased pa1) (erased b1) (erased b2)) (r4g-bw-bsp and-op 4 w r4g-k15 a fu y1 (Zero) r4g-y58 p1 r4g-bk15 pa))
  (let-match erased (bitwise-fn and-op fu (Zero) al (Zero) b1 (and-zero fu (bits2-of fu))) (Refl _ _))
  (let-match erased (bitwise-fn and-op y1 r4g-y58 ah y1 b2 (and-low 58 y1 y1 (Zero) r4g-y58 (r4g-hi58 w fu y1 wb p1) r4g-o58)) (Refl _ _))
  (let ((erased zl) (erased zh) (erased pz) (erased c1) (erased c2))
    (r4g-bw-bsp or-op 4 a m w2 (Zero) y1 m (Zero) pa1 (bsp-of 4 16 (Zero) (Zero) m m r4-p16 (MulZero 16) (AddZero m) ml) po))
  (let-match erased (bitwise-fn or-op (Zero) m zl m c1 (or-sym m (Zero) m (or-zero-r m (bits2-of m)))) (Refl _ _))
  (let-match erased (bitwise-fn or-op y1 (Zero) zh y1 c2 (or-zero-r y1 (bits2-of y1))) (Refl _ _))
  (let ((erased ab)) (lt-le-trans a (Succ w) u62-modulus (and-le w r4g-k15 a pa) (LtS w u62-modulus wb)))
  (values (MkNWd w2 b cm ftr m y1 y2 pz p2 p3) (r4g-or-u62 a m w2 ab (lt-trans m 16 u62-modulus ml r4-16-u62) po)))

; red4's w land lnot 0xF0 in g_round: the gtr part of the word w cleared.
(def-fns _ $ (erased r4g-clr-tr : (erased (Nat) w b cm ftr fu w2) (erased (Lt w u62-modulus) wb) (erased (NWd w b cm ftr fu) d) (erased (Bitwise and-op w r4g-k240 w2) pa)
    -> (erased (NWd w2 b cm (Zero) fu) d2) (erased (Lt w2 u62-modulus) w2b))
  (let-match erased d (MkNWd _ _ _ _ _ y1 y2 p1 p2 p3))
  (let ((erased al) (erased ah) (erased pa1) (erased b1) (erased b2)) (r4g-bw-bsp and-op 4 w r4g-k240 w2 fu y1 15 r4g-y1 p1 r4g-bk240 pa))
  (let ((erased fl)) (bsp-lt 4 w fu y1 16 p1 r4-p16))
  (let-match erased (bitwise-fn and-op fu 15 al fu b1 (and-low 4 fu fu (Zero) 15 (bsp-of 4 16 (Zero) (Zero) fu fu r4-p16 (MulZero 16) (AddZero fu) fl) r4-o15))
    (Refl _ _))
  (let ((erased bl) (erased bh) (erased pb1) (erased c1) (erased c2)) (r4g-bw-bsp and-op 4 y1 r4g-y1 ah ftr y2 (Zero) r4g-y54 p2 r4g-bk240h b2))
  (let-match erased (bitwise-fn and-op ftr (Zero) bl (Zero) c1 (and-zero ftr (bits2-of ftr))) (Refl _ _))
  (let-match erased (bitwise-fn and-op y2 r4g-y54 bh y2 c2 (and-low 54 y2 y2 (Zero) r4g-y54 (r4g-hi54 w fu y1 ftr y2 wb p1 p2) r4g-o54)) (Refl _ _))
  (values (MkNWd w2 b cm (Zero) fu ah y2 pa1 pb1 p3) (lt-le-trans w2 (Succ w) u62-modulus (and-le w r4g-k240 w2 pa) (LtS w u62-modulus wb))))

; A node's first child and child mask are as they were after writes that keep them.
(def-fns _ $ (erased r4g-keep-bc : (erased (TyCtor ((Nat) f) ((Nat) u) ((Nat) f2) ((Nat) u2) -> Type) R) (erased (List (Copy (Nat))) xs ys) (erased (Nat) g w b cm f u w2 b2 cm2 f2 u2)
    (subterm erased (NKeep R xs ys) k) (erased (WElt xs g w) x) (erased (NWd w b cm f u) d) (erased (WElt ys g w2) x2) (erased (NWd w2 b2 cm2 f2 u2) d2)
    -> (erased (Eq (Nat) b b2) eb) (erased (Eq (Nat) cm cm2) ec))
  (let-match erased k (NkCons _ _ xs1 _ i wo wn bo cmo fo uo fn un st xo dw dn _ k1)
    ((NkNil _ _)
      (let-match erased (welt-fn xs g w w2 x x2) (Refl _ _))
      (let ((erased _) (erased eb) (erased ec)) (nwd-fn w b cm f u b2 cm2 f2 u2 d d2))
      (values eb ec)))
  (let ((erased w1) (erased f1) (erased u1) (erased x1) (erased d1))
    (match erased (nat-eq g i) (((Nat) w1) ((Nat) f1) ((Nat) u1) ((WElt xs1 g w1) x1) ((NWd w1 b cm f1 u1) d1))
      ((Equal _ _ _)
        (let-match erased (welt-fn xs g w wo x xo) (Refl _ _))
        (let ((erased _) (erased eb) (erased ec)) (nwd-fn w b cm f u bo cmo fo uo d dw))
        (let-match erased eb (Refl _ _))
        (let-match erased ec (Refl _ _))
        (values wn fn un (MkWElt xs1 g wn (setnth-nth _ xs g _ xs1 st)) dn))
      ((Unequal _ _ _ _ ap) (values w f u (welt-set xs xs1 g w i _ x st (r4c-apart-sym g i ap)) d))))
  (r4g-keep-bc R xs1 ys g w1 b cm f1 u1 w2 b2 cm2 f2 u2 k1 x1 d1 x2 d2))

(comptime-match many (lt-dec 0 2) (Yes _ _ _ _ r4g-0-2))
(comptime-match many (lt-dec 1 2) (Yes _ _ _ _ r4g-1-2))
(comptime-match many (lt-dec 2 16) (Yes _ _ _ _ r4g-2-16))

; An operation on two numbers below 2^k gives one below 2^k.
(def-fns _ $ (erased r4g-bw-lt : (erased (BitOp) t) (erased (Nat) k a b c) (erased (Bsp k a a (Zero)) pa) (erased (Bsp k b b (Zero)) pb) (erased (Bitwise t a b c) bw)
    -> (erased (Bsp k c c (Zero)) r))
  (let ((erased cl) (erased ch) (erased pc) (erased bl) (erased bh)) (r4g-bw-bsp t k a b c a (Zero) b (Zero) pa pb bw))
  (let-match erased (bw-zz t ch bh) (Refl _ _))
  (let-match erased (bitwise-fn t a b cl c bl bw) (Refl _ _))
  pc)

(def-fns _ $ (erased r4g-set-keep : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g w w2 b cm f u f2 u2) (erased (SetNth (Copy (Nat)) xs g (MkCopy (Nat) w2) ys) s)
