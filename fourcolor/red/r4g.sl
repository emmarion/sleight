      (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) nd2 at nd) (erased (Length (Copy (Nat)) ys len) lx2) (erased (AllCu ys) au2) (erased (NKeep AnyFld xs ys) nk)
      (erased (HAll ys (Zero) Hs) hl2) (many (Bool) r))
