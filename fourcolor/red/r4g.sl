          (let-match erased e1 (Refl _ _))
          (let-match erased (r4g-np-zero xs j gc w1 b1 cm1 (Zero) u1 c ak (BTrue) ptg x1 d1 (FdT (Zero) u1)) (GpE))
          (let ((many ug) (erased ugb)) (r4-in-gu wc wcb b1 cm1 f1 u1 d1))
          (let ((many cd) (erased gq))
            (match many (u62-eq ug (Zero) ugb u62-modulus-pos) (((Bool) q) ((GPres uk q) gq))
