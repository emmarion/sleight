        (NpN ys j1 g w3 b1 cm1 f3 u1 c0 c1 c2 c3 t0 t1 t2 t3 (BFalse) x3 d3 (FdU f3 u1) (r4g-npuk-put xs ys j1 b1 cm1 (Zero) i w w2 b cm f u f2 c0 t0 k0 st x d d2)
          (r4g-npuk-put xs ys j1 b1 cm1 (Succ (Zero)) i w w2 b cm f u f2 c1 t1 k1 st x d d2) (r4g-npuk-put xs ys j1 b1 cm1 (Succ (Succ (Zero))) i w w2 b cm f u f2 c2 t2 k2 st x d d2)
          (r4g-npuk-put xs ys j1 b1 cm1 (Succ (Succ (Succ (Zero)))) i w w2 b cm f u f2 c3 t3 k3 st x d d2)))))
  ((erased r4g-npuk-put : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b0 cm0 s i w w2 b cm f u f2) (erased (Gtree) c t) (subterm erased (NPartK xs j b0 cm0 s c (BFalse) t) k)
      (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) ys) st) (erased (WElt xs i w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u) d2)
      -> (erased (NPartK ys j b0 cm0 s c (BFalse) t) r))
    (let-match erased k (NpkP _ _ _ _ _ v g1 _ _ _ bi rk a p) ((NpkE _ _ _ _ _ _ bi) (NpkE ys j b0 cm0 s (BFalse) bi)))
    (NpkP ys j b0 cm0 s v g1 c t (BFalse) bi rk a (r4g-npu-put xs ys j g1 i w w2 b cm f u f2 c t p st x d d2))))

(def-fns _ $ (erased r4g-npu-keep : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g) (erased (Gtree) s0 t) (erased (NPart xs j g s0 (BFalse) t) np)
    (subterm erased (NKeep KeepU xs ys) k) -> (erased (NPart ys j g s0 (BFalse) t) r))
  (let-match erased k (NkCons _ _ xs1 _ i w w2 b cm f u f2 u2 st x d d2 rr k1) ((NkNil _ _) np))
  (let-match erased rr (MkKeepU _ _ _))
  (r4g-npu-keep xs1 ys j g s0 t (r4g-npu-put xs xs1 j g i w w2 b cm f u f2 s0 t np st x d d2) k1))

(def-fns _ $ (erased r4g-tm-sym : (erased (Gsym) g) (erased (Nat) t) (erased (Col) e) (erased (Bstack) bs) (erased (TMatch g t e) tm) (erased (TopN bs t) tn)
    -> (erased (Bstack) bs2) (erased (Sym g bs e bs2) y))
  (match erased tm _
    ((TmPu2 _) (values (BP0 bs) (SPush2 bs)))
    ((TmPu3 _) (values (BP1 bs) (SPush3 bs)))
    ((TmSk _) (values bs (SSkip bs)))
    ((TmP02) (let-match erased tn (Tn0 c)) (values c (SPop02 c)))
    ((TmP03) (let-match erased tn (Tn1 c)) (values c (SPop03 c)))
    ((TmP13) (let-match erased tn (Tn0 c)) (values c (SPop13 c)))
    ((TmP12) (let-match erased tn (Tn1 c)) (values c (SPop12 c)))))

(def-fns _ $ (erased r4g-ghc-y : (erased (Nat) m t x s) (erased (Gsym) g) (erased (Bstack) bs) (erased (GhC m t x s (Bit1)) h) (erased (SymN s g) sn) (erased (TopN bs t) tn)
    -> (erased (Col) e) (erased (Nat) d) (erased (Bstack) bs2) (erased (BitIs m s (Bit1)) bm) (erased (CD d e) cd) (erased (BitIs x d (Bit1)) bx) (erased (Sym g bs e bs2) y))
  (let-match erased h (GhY _ _ _ _ d g2 e sn2 bm cd bx tm))
  (let ((erased e1))
    (match erased sn (((Eq (Gsym) g2 g) q))
      ((SnPush) (let-match erased sn2 (SnPush)) (Refl _ g2))
      ((SnSkip) (let-match erased sn2 (SnSkip)) (Refl _ g2))
      ((SnPop0) (let-match erased sn2 (SnPop0)) (Refl _ g2))
      ((SnPop1) (let-match erased sn2 (SnPop1)) (Refl _ g2))))
  (let-match erased e1 (Refl _ _))
  (let ((erased bs2) (erased y)) (r4g-tm-sym g t e bs tm tn))
  (values e d bs2 bm cd bx y))

; A set bit s of red4's ghit entry v for the symbols m under the stack bs against the trie bits x: s is in m and, under bs, takes a colour e whose
; bit d is set in x.
(def-fns _ $ (erased r4g-gh-bit : (erased (Nat) m x v s) (erased (Gsym) g) (erased (Bstack) bs) (erased (GhAt m bs x v) ga) (erased (SymN s g) sn) (erased (BitIs v s (Bit1)) bv)
    -> (erased (Col) e) (erased (Nat) d) (erased (Bstack) bs2) (erased (BitIs m s (Bit1)) bm) (erased (CD d e) cd) (erased (BitIs x d (Bit1)) bx) (erased (Sym g bs e bs2) y))
  (let-match erased ga (MkGhAt _ _ _ i tm t _ tn p q ge))
  (let-match erased ge (GheOk _ x2 tm2 t2 m2 _ c0 c1 c2 c3 p2 q2 _ v0 v1 v2 v3 h0 h1 h2 h3)
    (absurd (GheT3 _ x2 tm2 m2 _ p2 q2 _)
      (let ((erased ex) (erased et)) (bsp-fn 3 i x tm x2 tm2 p p2))
      (let-match erased et (Refl _ _))
      (let ((erased e3) (erased _)) (bsp-fn 2 tm t m (Succ (Succ (Succ (Zero)))) m2 q q2))
      (let-match erased e3 (Refl _ _))
      (match erased tn _)))
  (let ((erased ex) (erased et)) (bsp-fn 3 i x tm x2 tm2 p p2))
  (let-match erased ex (Refl _ _))
  (let-match erased et (Refl _ _))
  (let ((erased e2) (erased em)) (bsp-fn 2 tm t m t2 m2 q q2))
  (let-match erased e2 (Refl _ _))
  (let-match erased em (Refl _ _))
  (match erased sn _
    ((SnPush) (let-match erased (bitis-fn v (Zero) c0 (Bit1) v0 bv) (Refl _ _)) (r4g-ghc-y m t x (Zero) g bs h0 sn tn))
    ((SnSkip) (let-match erased (bitis-fn v (Succ (Zero)) c1 (Bit1) v1 bv) (Refl _ _)) (r4g-ghc-y m t x (Succ (Zero)) g bs h1 sn tn))
    ((SnPop0) (let-match erased (bitis-fn v (Succ (Succ (Zero))) c2 (Bit1) v2 bv) (Refl _ _)) (r4g-ghc-y m t x (Succ (Succ (Zero))) g bs h2 sn tn))
    ((SnPop1) (let-match erased (bitis-fn v (Succ (Succ (Succ (Zero)))) c3 (Bit1) v3 bv) (Refl _ _)) (r4g-ghc-y m t x (Succ (Succ (Succ (Zero)))) g bs h3 sn tn))))
