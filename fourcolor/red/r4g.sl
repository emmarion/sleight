  ((erased r4g-nivk-f : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s bn lo hc) (erased (Gtree) c) (erased (Bool) z) (subterm erased (NIvK xs j b cm s c bn lo hc z) k)
