          (let ((erased gak)) (r4g-np-pres xs j gc w1 b1 cm1 f1 u1 f1 c ak (BTrue) ptg x1 d1 (FdT f1 u1) (ApGt (Nat) Lt f1 (Zero) (LtZ f2))))
