(def-fns _
  ; The layout holds whatever the parts of gtr.
  ((erased r4g-niv-f : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (erased (Bool) z) (subterm erased (NIv xs j g s0 lo hi z) iv)
