        (let ((erased pcw)) (xt-lt p0 pc W W2 bs g xtp pl tw pl1))
        (let ((erased nd) (erased an)) (add o pc))
        (let ((erased ndl)) (lt-le-trans nd len len (add-lt-mono o pc W2 nd len an ol pcw) (lt-succ len)))
        (let ((erased t) (erased ft) (erased _) (erased _) (erased _) (erased _)) (r4g-leaf-ca cs (Succ k) o pc nd W2 ctr f pw2 pcw of an))
        (let ((unique ca2) (many v) (erased _) (erased _) (erased _) (erased vl)) (r4-ghits cs ca len zc o m pc bc ml bsc bnc (bnb-lt jb bc bkc) nd an ndl t ft))
        (let ((many r1) (erased o1)) (u62-or r v rb1 (lt-trans v 16 u62-modulus vl r4-16-u62)))
