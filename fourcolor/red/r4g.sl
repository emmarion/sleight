; z is x op y on the low k bits and on the bits above them separately.
(def-fns _ $ (erased r4g-bw-bsp : (erased (BitOp) t) (erased (Nat) k x y z xl xh yl yh) (subterm erased (Bsp k x xl xh) px) (erased (Bsp k y yl yh) py)
    (erased (Bitwise t x y z) bw) -> (erased (Nat) zl zh) (erased (Bsp k z zl zh) pz) (erased (Bitwise t xl yl zl) bl) (erased (Bitwise t xh yh zh) bh))
  (let-match erased px (BspS k1 _ x1 _ xl1 _ a px1 cx cxl)
    ((BspZ _) (let-match erased py (BspZ _)) (values (Zero) z (BspZ z) (BwZero t) bw)))
  (let-match erased py (BspS _ _ y1 _ yl1 _ b py1 cy cyl))
  (let ((erased z1) (erased c) (erased bw1) (erased ap) (erased cz))
    (match erased bw (((Nat) z1) ((Bit) c) ((Bitwise t x1 y1 z1) bw1) ((BitApply t a b c) ap) ((BitCons z1 c z) cz))
      ((BwZero _)
        (let ((erased e1) (erased e2)) (bc-zero x1 a cx))
        (let-match erased e1 (Refl _ _))
        (let-match erased e2 (Refl _ _))
        (let ((erased e3) (erased e4)) (bc-zero y1 b cy))
        (let-match erased e3 (Refl _ _))
        (let-match erased e4 (Refl _ _))
        (values (Zero) (Bit0) (BwZero t) (Ap00 t) (bc-zz)))
      ((BwBit _ x2 y2 z2 a2 b2 c2 _ _ _ bw2 ap2 cx2 cy2 cz2)
        (let ((erased e1) (erased e2)) (bitcons-fn x2 a2 x1 a x cx2 cx))
        (let-match erased e1 (Refl _ _))
        (let-match erased e2 (Refl _ _))
        (let ((erased e3) (erased e4)) (bitcons-fn y2 b2 y1 b y cy2 cy))
        (let-match erased e3 (Refl _ _))
        (let-match erased e4 (Refl _ _))
        (values z2 c2 bw2 ap2 cz2))))
  (let ((erased zl1) (erased zh) (erased pz1) (erased bl1) (erased bh)) (r4g-bw-bsp t k1 x1 y1 z1 xl1 xh yl1 yh px1 py1 bw1))
  (let ((erased zl) (erased czl)) (bc-new zl1 c))
  (values zl zh (BspS k1 z z1 zl zl1 zh c pz1 cz czl) (BwBit t xl1 yl1 zl1 a b c xl yl zl bl1 ap cxl cyl czl) bh))

(def-fns _ $ (erased r4g-u62-bsp : (erased (Nat) x) (erased (Lt x u62-modulus) xb) -> (erased (Bsp sixty-two x x (Zero)) r))
  (bsp-of sixty-two u62-modulus (Zero) (Zero) x x u62-modulus-pow2 (MulZero u62-modulus) (AddZero x) xb))

(def-fns _ $ (erased r4g-or-u62 : (erased (Nat) a b c) (erased (Lt a u62-modulus) ab) (erased (Lt b u62-modulus) bb) (erased (Bitwise or-op a b c) o)
    -> (erased (Lt c u62-modulus) r))
  (bsp-lt sixty-two c c (Zero) u62-modulus (or-lt sixty-two a b c (r4g-u62-bsp a ab) (r4g-u62-bsp b bb) o) u62-modulus-pow2))

; red4's w lor (m lsl 4) in mark: m or-ed into the gtr part of the word w.
(def-fns _ $ (erased r4g-or-tr : (erased (Nat) w b cm ftr fu m m16 w2) (erased (NWd w b cm ftr fu) d) (erased (Bsp 4 m16 (Zero) m) pm) (erased (Lt m 16) ml)
    (erased (Bitwise or-op w m16 w2) o) -> (erased (Nat) ftr2) (erased (NWd w2 b cm ftr2 fu) d2) (erased (Bitwise or-op ftr m ftr2) o2))
  (let-match erased d (MkNWd _ _ _ _ _ y1 y2 p1 p2 p3))
  (let ((erased fu2) (erased z1) (erased q1) (erased o1) (erased oh)) (r4g-bw-bsp or-op 4 w m16 w2 fu y1 (Zero) m p1 pm o))
  (let-match erased (bitwise-fn or-op fu (Zero) fu2 fu o1 (or-zero-r fu (bits2-of fu))) (Refl _ _))
  (let ((erased ftr2) (erased z2) (erased q2) (erased o3) (erased o4))
    (r4g-bw-bsp or-op 4 y1 m z1 ftr y2 m (Zero) p2 (bsp-of 4 16 (Zero) (Zero) m m r4-p16 (MulZero 16) (AddZero m) ml) oh))
  (let-match erased (bitwise-fn or-op y2 (Zero) z2 y2 o4 (or-zero-r y2 (bits2-of y2))) (Refl _ _))
  (values ftr2 (MkNWd w2 b cm ftr2 fu z1 y2 q1 q2 p3) o3))

(def-fns _ $ (erased r4g-or-ge : (erased (Nat) a b c) (subterm erased (Bitwise or-op a b c) p) -> (erased (Lt a (Succ c)) r))
  (let-match erased p (BwBit _ a1 b1 c1 x y z _ _ _ p1 e pa pb pc) ((BwZero _) (LtZ (Zero))))
  (let ((erased l1)) (r4g-or-ge a1 b1 c1 p1))
  (match erased e _
    ((Ap00 _)
      (let-match erased pa (BC0 _ da dda))
      (let-match erased pc (BC0 _ dc ddc))
      (double-le-mono a1 c1 da dc l1 dda ddc))
    ((Ap01 _ _ _)
      (let-match erased pa (BC0 _ da dda))
      (let-match erased pc (BC1 _ dc ddc))
      (lt-weaken a (Succ dc) (double-le-mono a1 c1 da dc l1 dda ddc)))
    ((Ap10 _ _ _)
      (let-match erased pa (BC1 _ da dda))
      (let-match erased pc (BC1 _ dc ddc))
      (LtS da (Succ dc) (double-le-mono a1 c1 da dc l1 dda ddc)))
    ((Ap11 _ _ _)
      (let-match erased pa (BC1 _ da dda))
      (let-match erased pc (BC1 _ dc ddc))
      (LtS da (Succ dc) (double-le-mono a1 c1 da dc l1 dda ddc)))))

(def-fns _ $ (erased r4g-nz-up : (erased (Nat) f f2) (erased (Lt f (Succ f2)) l) (erased (Apart (Nat) Lt f (Zero)) ap) -> (erased (Apart (Nat) Lt f2 (Zero)) r))
  (let-match erased f (Succ f1) (absurd (Zero) (apart-irrefl (Zero) ap)))
  (let-match erased l (LtS _ _ l1))
  (let-match erased f2 (Succ f3) (absurd (Zero) l1))
  (ApGt (Nat) Lt f2 (Zero) (LtZ f3)))

(def-fns _ $ (erased r4g-rk-mono : (erased (Nat) a c x r w) (subterm erased (Rk a x r) p) (erased (Rk c x w) q) (erased (Lt a (Succ c)) l) -> (erased (Lt r (Succ w)) res))
  (let-match erased p (RkS a1 _ x1 r1 v _ b bc p1 bv ad) ((RkZ _) (LtZ w)))
  (let-match erased q (RkS c1 _ x2 w1 v2 _ b2 bc2 q1 bv2 ad2) (absurd (RkZ _) (let-match erased l (LtS _ _ l1)) l1))
  (let ((erased e1) (erased e2)) (bitcons-fn x1 b x2 b2 x bc bc2))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased (bitv-fn b v v2 bv bv2) (Refl _ _))
  (add-lt-mono v r1 (Succ w1) r (Succ w) ad (add-succ-right v w1 w ad2) (r4g-rk-mono a1 c1 x1 r1 w1 p1 q1 (lt-pred a1 (Succ c1) l))))

; A set bit s of x below t makes the rank at s less than at t.
(def-fns _ $ (erased r4g-rk-lt : (erased (Nat) s t x v w) (erased (Rk s x v) p) (erased (BitIs x s (Bit1)) bi) (erased (Rk t x w) q) (erased (Lt s t) l) -> (erased (Lt v w) r))
  (let-match erased bi (MkBitIs _ _ lo y y1 _ bp c))
  (lt-pred v w (r4g-rk-mono (Succ s) t x (Succ v) w (rk-step s x lo y y1 v (Succ (Zero)) (Succ v) (Bit1) p bp c (BV1) (add-one-r v)) q (LtS s t l))))

(def-fns _ $ (erased r4g-kid-lt : (erased (Nat) b s t cm v w g h) (erased (Rk s cm v) p) (erased (BitIs cm s (Bit1)) bi) (erased (Rk t cm w) q) (erased (Lt s t) l)
    (erased (Add b v g) a) (erased (Add b w h) c) -> (erased (Lt g h) r))
  (add-lt-mono b v w g h a c (r4g-rk-lt s t cm v w p bi q l)))

; The write regions: g or [lo, hi); or the kids at b, below hb, of the symbols from s on of the child mask cm, or [lo, hi).
(def-adts $ (Rgn : -> Type)
  enum
  (many RgOne : (erased (Nat) g lo hi) -> (Rgn))
  (many RgKid : (erased (Nat) b cm s hb lo hi) -> (Rgn)))

; i is in rg.
(def-adts $ (Iw : ((Nat) i) ((Rgn) rg) -> Type)
  enum
  (many IwG : (erased (Nat) g lo hi) -> (Iw g (RgOne g lo hi)))
  (many IwI : (erased (Nat) i g lo hi) (erased (Lt lo (Succ i)) a) (erased (Lt i hi) c) -> (Iw i (RgOne g lo hi)))
  (many IwK : (erased (Nat) i b cm s hb lo hi t v) (erased (Lt s (Succ t)) st) (erased (BitIs cm t (Bit1)) bi) (erased (Rk t cm v) rk) (erased (Add b v i) a)
      (erased (Lt i hb) ih) -> (Iw i (RgKid b cm s hb lo hi)))
  (many IwKI : (erased (Nat) i b cm s hb lo hi) (erased (Lt lo (Succ i)) a) (erased (Lt i hi) c) -> (Iw i (RgKid b cm s hb lo hi))))

; Each write from xs to ys is in rg.
(def-adts $ (NIn : ((List (Copy (Nat))) xs) ((List (Copy (Nat))) ys) ((Rgn) rg) -> Type)
  enum
  (many NinNil : (erased (List (Copy (Nat))) xs) (erased (Rgn) rg) -> (NIn xs xs rg))
  (many NinCons : (erased (List (Copy (Nat))) xs xs1 ys) (erased (Nat) i) (erased (Rgn) rg) (erased (Copy (Nat)) y) (erased (SetNth (Copy (Nat)) xs i y xs1) st)
      (erased (Iw i rg) iw) (erased (NIn xs1 ys rg) r) -> (NIn xs ys rg)))

(def-fns _ $ (erased r4g-nin-cat : (erased (List (Copy (Nat))) xs ys zs) (erased (Rgn) rg) (subterm erased (NIn xs ys rg) p) (erased (NIn ys zs rg) q) -> (erased (NIn xs zs rg) r))
  (let-match erased p (NinCons _ xs1 _ i _ y st iw p1) ((NinNil _ _) q))
  (NinCons xs xs1 zs i rg y st iw (r4g-nin-cat xs1 ys zs rg p1 q)))

; rg lies in rg2.
(def-adts $ (RgIn : ((Rgn) rg) ((Rgn) rg2) -> Type)
  enum
  (many RsKid : (erased (Nat) g lo2 hi2 b cm s hb lo hi v) (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) rk) (erased (Add b v g) a) (erased (Lt g hb) gh)
      (erased (Lt lo (Succ lo2)) l) (erased (Lt hi2 (Succ hi)) h) -> (RgIn (RgOne g lo2 hi2) (RgKid b cm s hb lo hi)))
  (many RsNext : (erased (Nat) b cm s hb lo lo2 hi) (erased (Lt lo (Succ lo2)) l) -> (RgIn (RgKid b cm (Succ s) hb lo2 hi) (RgKid b cm s hb lo hi)))
  (many RsUp : (erased (Nat) g b cm hb hi) (erased (Lt b (Succ hb)) l) (erased (Lt hb (Succ hi)) h) -> (RgIn (RgKid b cm (Zero) hb hb hi) (RgOne g b hi))))

(def-fns _ $ (erased r4g-iw-sub : (erased (Nat) i) (erased (Rgn) rg rg2) (erased (Iw i rg) iw) (erased (RgIn rg rg2) sb) -> (erased (Iw i rg2) r))
  (match erased sb _
    ((RsKid _ lo2 hi2 b cm s hb lo hi v bi rk a gh l h)
      (match erased iw _
        ((IwG _ _ _) (IwK i b cm s hb lo hi s v (lt-succ s) bi rk a gh))
        ((IwI _ _ _ _ c d) (IwKI i b cm s hb lo hi (le-trans lo lo2 i l c) (lt-le-trans i hi2 hi d h)))))
    ((RsNext b cm s hb lo lo2 hi l)
      (match erased iw _
        ((IwK _ _ _ _ _ _ _ t v st bi rk a ih) (IwK i b cm s hb lo hi t v (lt-succ-left s (Succ t) st) bi rk a ih))
        ((IwKI _ _ _ _ _ _ _ c d) (IwKI i b cm s hb lo hi (le-trans lo lo2 i l c) d))))
    ((RsUp g b cm hb hi l h)
      (match erased iw _
        ((IwK _ _ _ _ _ _ _ t v _ _ _ a ih) (IwI i g b hi (add-ge b v i a) (lt-le-trans i hb hi ih h)))
        ((IwKI _ _ _ _ _ _ _ c d) (IwI i g b hi (le-trans b hb i l c) d))))))

(def-fns _ $ (erased r4g-nin-sub : (erased (List (Copy (Nat))) xs ys) (erased (Rgn) rg rg2) (subterm erased (NIn xs ys rg) p) (erased (RgIn rg rg2) sb) -> (erased (NIn xs ys rg2) r))
  (let-match erased p (NinCons _ xs1 _ i _ y st iw p1) ((NinNil _ _) (NinNil xs rg2)))
  (NinCons xs xs1 ys i rg2 y st (r4g-iw-sub i rg rg2 iw sb) (r4g-nin-sub xs1 ys rg rg2 p1 sb)))

(def-fns _ $ (erased r4g-iv-out : (erased (Nat) i b hp lo hc bn v g lo2 hi2) (erased (OutS i b hp) o) (erased (Add b v g) a) (erased (Lt g bn) gn) (erased (Lt b (Succ lo)) bl)
    (erased (Lt lo (Succ lo2)) ll) (erased (Lt hi2 (Succ hc)) lh) (erased (Lt hc (Succ hp)) ch) (erased (Lt bn (Succ hp)) bh) -> (erased (Apart (Nat) Lt i g) ap) (erased (OutS i lo2 hi2) o2))
  (match erased o _
    ((OsL _ _ _ l) (values (ApLt (Nat) Lt i g (lt-le-trans i b g l (add-ge b v g a))) (OsL i lo2 hi2 (lt-le-trans i b lo2 l (le-trans b lo lo2 bl ll)))))
    ((OsR _ _ _ l) (values (ApGt (Nat) Lt i g (lt-le-trans g bn i gn (le-trans bn hp i bh l))) (OsR i lo2 hi2 (le-trans hi2 hc i lh (le-trans hc hp i ch l)))))))

(def-fns _
  ((erased r4g-niv-le : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (erased (Bool) z) (subterm erased (NIv xs j g s0 lo hi z) iv) -> (erased (Lt lo (Succ hi)) r))
    (let-match erased iv (NivN _ j1 _ _ b cm _ _ _ bn m1 m2 m3 c0 c1 c2 c3 _ _ _ _ _ bl k0 k1 k2 k3) ((NivL _ _ _ _ _ _ _ _ _ _ _ _ _) (lt-succ lo)))
    (le-trans b bn hi bl (le-trans bn m1 hi (r4g-nivk-le xs j1 b cm (Zero) bn bn m1 c0 z k0) (le-trans m1 m2 hi (r4g-nivk-le xs j1 b cm (Succ (Zero)) bn m1 m2 c1 z k1)
      (le-trans m2 m3 hi (r4g-nivk-le xs j1 b cm (Succ (Succ (Zero))) bn m2 m3 c2 z k2) (r4g-nivk-le xs j1 b cm (Succ (Succ (Succ (Zero)))) bn m3 hi c3 z k3))))))
  ((erased r4g-nivk-le : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s bn lo hc) (erased (Gtree) c) (erased (Bool) z) (subterm erased (NIvK xs j b cm s c bn lo hc z) k)
      -> (erased (Lt lo (Succ hc)) r))
    (let-match erased k (NivkP _ _ _ _ _ _ g lo2 hi2 _ _ _ _ _ _ _ _ _ ll lh p) ((NivkE _ _ _ _ _ _ _ _ _ _ lh) lh))
    (le-trans lo lo2 hc ll (le-trans lo2 hi2 hc (r4g-niv-le xs j g lo2 hi2 c z p) lh))))

; The chain of a node's kid intervals: b to bn, then bn, m1, m2, m3 to hi.
(def-adts $ (Chn : ((Nat) b) ((Nat) bn) ((Nat) m1) ((Nat) m2) ((Nat) m3) ((Nat) hi) -> Type)
  enum
  (many MkChn : (erased (Nat) b bn m1 m2 m3 hi) (erased (Lt b (Succ bn)) a0) (erased (Lt bn (Succ m1)) a1) (erased (Lt m1 (Succ m2)) a2) (erased (Lt m2 (Succ m3)) a3)
      (erased (Lt m3 (Succ hi)) a4) -> (Chn b bn m1 m2 m3 hi)))

(def-fns _ $ (erased r4g-chn : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm bn m1 m2 m3 hi) (erased (Gtree) c0 c1 c2 c3) (erased (Bool) z) (erased (Lt b (Succ bn)) bl)
    (erased (NIvK xs j b cm (Zero) c0 bn bn m1 z) k0) (erased (NIvK xs j b cm (Succ (Zero)) c1 bn m1 m2 z) k1) (erased (NIvK xs j b cm (Succ (Succ (Zero))) c2 bn m2 m3 z) k2)
    (erased (NIvK xs j b cm (Succ (Succ (Succ (Zero)))) c3 bn m3 hi z) k3) -> (erased (Chn b bn m1 m2 m3 hi) r))
  (MkChn b bn m1 m2 m3 hi bl (r4g-nivk-le xs j b cm (Zero) bn bn m1 c0 z k0) (r4g-nivk-le xs j b cm (Succ (Zero)) bn m1 m2 c1 z k1)
    (r4g-nivk-le xs j b cm (Succ (Succ (Zero))) bn m2 m3 c2 z k2) (r4g-nivk-le xs j b cm (Succ (Succ (Succ (Zero)))) bn m3 hi c3 z k3)))

; Bounds of the cell [lo, hc) of a kid: from b, below hi, with bn below hi.
(def-adts $ (KCl : ((Nat) b) ((Nat) bn) ((Nat) lo) ((Nat) hc) ((Nat) hi) -> Type)
  enum
  (many MkKCl : (erased (Nat) b bn lo hc hi) (erased (Lt b (Succ lo)) bl) (erased (Lt hc (Succ hi)) ch) (erased (Lt bn (Succ hi)) bh) -> (KCl b bn lo hc hi)))

(def-fns _ $ (erased r4g-cells : (erased (Nat) b bn m1 m2 m3 hi) (erased (Chn b bn m1 m2 m3 hi) c) ->
    (erased (KCl b bn bn m1 hi) c0) (erased (KCl b bn m1 m2 hi) c1) (erased (KCl b bn m2 m3 hi) c2) (erased (KCl b bn m3 hi hi) c3))
  (let-match erased c (MkChn _ _ _ _ _ _ a0 a1 a2 a3 a4))
  (let ((erased h3)) a4)
  (let ((erased h2)) (le-trans m2 m3 hi a3 h3))
  (let ((erased h1)) (le-trans m1 m2 hi a2 h2))
  (let ((erased hn)) (le-trans bn m1 hi a1 h1))
  (let ((erased b1)) (le-trans b bn m1 a0 a1))
  (let ((erased b2)) (le-trans b m1 m2 b1 a2))
  (values (MkKCl b bn bn m1 hi a0 h1 hn) (MkKCl b bn m1 m2 hi b1 h2 hn) (MkKCl b bn m2 m3 hi b2 h3 hn) (MkKCl b bn m3 hi hi (le-trans b m2 m3 b2 a3) (lt-succ hi) hn)))

(def-fns _
  ; A write outside g and [lo, hi) keeps the layout of g.
  ((erased r4g-niv-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo hi i) (erased (Gtree) s0) (erased (Bool) z) (erased (Copy (Nat)) y)
      (subterm erased (NIv xs j g s0 lo hi z) iv) (erased (SetNth (Copy (Nat)) xs i y ys) st) (erased (Apart (Nat) Lt i g) ap) (erased (OutS i lo hi) o) -> (erased (NIv ys j g s0 lo hi z) r))
    (let-match erased iv (NivN _ j1 _ w b cm f u _ bn m1 m2 m3 c0 c1 c2 c3 _ x d zf gb bl k0 k1 k2 k3)
      ((NivL _ _ _ w b cm f u _ _ x d zf) (NivL ys g lo w b cm f u s0 z (welt-set xs ys g w i y x st ap) d zf)))
    (let ((erased q0) (erased q1) (erased q2) (erased q3)) (r4g-cells b bn m1 m2 m3 hi (r4g-chn xs j1 b cm bn m1 m2 m3 hi c0 c1 c2 c3 z bl k0 k1 k2 k3)))
    (NivN ys j1 g w b cm f u hi bn m1 m2 m3 c0 c1 c2 c3 z (welt-set xs ys g w i y x st ap) d zf gb bl
      (r4g-nivk-set xs ys j1 b cm (Zero) bn bn m1 hi i c0 z y k0 st o q0) (r4g-nivk-set xs ys j1 b cm (Succ (Zero)) bn m1 m2 hi i c1 z y k1 st o q1)
      (r4g-nivk-set xs ys j1 b cm (Succ (Succ (Zero))) bn m2 m3 hi i c2 z y k2 st o q2) (r4g-nivk-set xs ys j1 b cm (Succ (Succ (Succ (Zero)))) bn m3 hi hi i c3 z y k3 st o q3)))
  ((erased r4g-nivk-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b cm s bn lo hc hp i) (erased (Gtree) c) (erased (Bool) z) (erased (Copy (Nat)) y)
      (subterm erased (NIvK xs j b cm s c bn lo hc z) k) (erased (SetNth (Copy (Nat)) xs i y ys) st) (erased (OutS i b hp) o) (erased (KCl b bn lo hc hp) cl)
      -> (erased (NIvK ys j b cm s c bn lo hc z) r))
    (let-match erased k (NivkP _ _ _ _ _ v g lo2 hi2 _ _ _ _ _ bi rk a gn ll lh p) ((NivkE _ _ _ _ _ _ _ _ _ bi lh) (NivkE ys j b cm s bn lo hc z bi lh)))
    (let-match erased cl (MkKCl _ _ _ _ _ bl ch bh))
    (let ((erased ap) (erased o2)) (r4g-iv-out i b hp lo hc bn v g lo2 hi2 o a gn bl ll lh ch bh))
    (NivkP ys j b cm s v g lo2 hi2 bn lo hc c z bi rk a gn ll lh (r4g-niv-set xs ys j g lo2 hi2 i c z y p st ap o2))))

(def-fns _
  ; A write outside g and [lo, hi) keeps the parts below g.
  ((erased r4g-np-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo hi i) (erased (Gtree) s0 t) (erased (Bool) sel z) (erased (Copy (Nat)) y)
      (erased (NIv xs j g s0 lo hi z) iv) (subterm erased (NPart xs j g s0 sel t) np) (erased (SetNth (Copy (Nat)) xs i y ys) st) (erased (Apart (Nat) Lt i g) ap) (erased (OutS i lo hi) o)
      -> (erased (NPart ys j g s0 sel t) r))
    (let-match erased np (NpN _ j1 _ w b cm f u c0 c1 c2 c3 t0 t1 t2 t3 _ x d fd k0 k1 k2 k3)
      ((NpE _ _ _ w b cm f u _ _ x d fd) (NpE ys j g w b cm f u s0 sel (welt-set xs ys g w i y x st ap) d fd))
      ((NpL _ _ w b cm f u v _ _ _ x d fd lm) (NpL ys g w b cm f u v s0 t sel (welt-set xs ys g w i y x st ap) d fd lm)))
    (let-match erased iv (NivN _ _ _ wv bv cmv _ _ _ bn m1 m2 m3 _ _ _ _ _ xv dv _ _ bl q0 q1 q2 q3))
    (let-match erased (welt-fn xs g w wv x xv) (Refl _ _))
    (let ((erased _) (erased eb) (erased ec)) (nwd-fn w b cm f u bv cmv _ _ d dv))
    (let-match erased eb (Refl _ _))
    (let-match erased ec (Refl _ _))
    (let ((erased l0) (erased l1) (erased l2) (erased l3)) (r4g-cells b bn m1 m2 m3 hi (r4g-chn xs j1 b cm bn m1 m2 m3 hi c0 c1 c2 c3 z bl q0 q1 q2 q3)))
    (NpN ys j1 g w b cm f u c0 c1 c2 c3 t0 t1 t2 t3 sel (welt-set xs ys g w i y x st ap) d fd
      (r4g-npk-set xs ys j1 b cm (Zero) bn bn m1 hi i c0 t0 sel z y q0 k0 st o l0) (r4g-npk-set xs ys j1 b cm (Succ (Zero)) bn m1 m2 hi i c1 t1 sel z y q1 k1 st o l1)
      (r4g-npk-set xs ys j1 b cm (Succ (Succ (Zero))) bn m2 m3 hi i c2 t2 sel z y q2 k2 st o l2)
      (r4g-npk-set xs ys j1 b cm (Succ (Succ (Succ (Zero)))) bn m3 hi hi i c3 t3 sel z y q3 k3 st o l3)))
  ((erased r4g-npk-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b cm s bn lo hc hp i) (erased (Gtree) c t) (erased (Bool) sel z) (erased (Copy (Nat)) y)
      (erased (NIvK xs j b cm s c bn lo hc z) iv) (subterm erased (NPartK xs j b cm s c sel t) k) (erased (SetNth (Copy (Nat)) xs i y ys) st) (erased (OutS i b hp) o)
      (erased (KCl b bn lo hc hp) cl) -> (erased (NPartK ys j b cm s c sel t) r))
    (let-match erased k (NpkP _ _ _ _ _ v g _ _ _ bi rk a p) ((NpkE _ _ _ _ _ _ bi) (NpkE ys j b cm s sel bi)))
    (let-match erased iv (NivkP _ _ _ _ _ v2 g2 lo2 hi2 _ _ _ _ _ _ rk2 a2 gn ll lh pv) (absurd (NivkE _ _ _ _ _ _ _ _ _ bi0 _) (bitis-fn cm s (Bit0) (Bit1) bi0 bi)))
    (let-match erased (rk-fn s cm v v2 rk rk2) (Refl _ _))
    (let-match erased (add-fn b v g g2 a a2) (Refl _ _))
    (let-match erased cl (MkKCl _ _ _ _ _ bl ch bh))
    (let ((erased ap) (erased o2)) (r4g-iv-out i b hp lo hc bn v g lo2 hi2 o a gn bl ll lh ch bh))
    (NpkP ys j b cm s v g c t sel bi rk a (r4g-np-set xs ys j g lo2 hi2 i c t sel z y pv p st ap o2))))

; The writes in rg miss the kid of the symbol s of a node whose children start at b, of child mask cm, below bn, its nodes below in [lo, hc): rg is
; an earlier kid's nodes, or the later kids' region.
(def-adts $ (KAway : ((Rgn) rg) ((Nat) b) ((Nat) cm) ((Nat) s) ((Nat) bn) ((Nat) lo) ((Nat) hc) -> Type)
  enum
  (many KoA : (erased (Nat) g2 lo2 hi2 b cm s bn lo hc s2 v2) (erased (BitIs cm s2 (Bit1)) bi) (erased (Rk s2 cm v2) rk) (erased (Add b v2 g2) a) (erased (Lt s2 s) l)
      (erased (Lt g2 bn) gn) (erased (Lt bn (Succ lo)) bl) (erased (Lt bn (Succ lo2)) bl2) (erased (Lt hi2 (Succ lo)) hl) -> (KAway (RgOne g2 lo2 hi2) b cm s bn lo hc))
  (many KoB : (erased (Nat) b cm s s2 bn lo hc lo2 hi) (erased (Lt s s2) l) (erased (Lt bn (Succ lo)) bl) (erased (Lt bn (Succ lo2)) bl2) (erased (Lt hc (Succ lo2)) hl)
      -> (KAway (RgKid b cm s2 bn lo2 hi) b cm s bn lo hc)))

(def-fns _ $ (erased r4g-kout : (erased (Nat) i b cm s bn lo hc v g lo3 hi3) (erased (Rgn) rg) (erased (KAway rg b cm s bn lo hc) ko) (erased (Iw i rg) iw)
    (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) rk) (erased (Add b v g) a) (erased (Lt g bn) gn) (erased (Lt lo (Succ lo3)) ll) (erased (Lt hi3 (Succ hc)) lh)
    -> (erased (Apart (Nat) Lt i g) ap) (erased (OutS i lo3 hi3) o))
  (match erased ko _
    ((KoA g2 lo2 hi2 _ _ _ _ _ _ s2 v2 bi2 rk2 a2 l gn2 bl bl2 hl)
      (match erased iw _
        ((IwG _ _ _) (values (ApLt (Nat) Lt i g (r4g-kid-lt b s2 s cm v2 v i g rk2 bi2 rk l a2 a)) (OsL i lo3 hi3 (lt-le-trans i bn lo3 gn2 (le-trans bn lo lo3 bl ll)))))
        ((IwI _ _ _ _ c d) (values (ApGt (Nat) Lt i g (lt-le-trans g bn i gn (le-trans bn lo2 i bl2 c))) (OsL i lo3 hi3 (lt-le-trans i hi2 lo3 d (le-trans hi2 lo lo3 hl ll)))))))
    ((KoB _ _ _ s2 _ _ _ lo2 hi l bl bl2 hl)
      (match erased iw _
        ((IwK _ _ _ _ _ _ _ t v2 st bi2 rk2 a2 ih)
          (values (ApGt (Nat) Lt i g (r4g-kid-lt b s t cm v v2 g i rk bi rk2 (lt-le-trans s s2 t l st) a a2)) (OsL i lo3 hi3 (lt-le-trans i bn lo3 ih (le-trans bn lo lo3 bl ll)))))
        ((IwKI _ _ _ _ _ _ _ c d) (values (ApGt (Nat) Lt i g (lt-le-trans g bn i gn (le-trans bn lo2 i bl2 c))) (OsR i lo3 hi3 (le-trans hi3 hc i lh (le-trans hc lo2 i hl c)))))))))

(def-fns _ $ (erased r4g-nin-np : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo3 hi3 b cm s bn lo hc v) (erased (Gtree) c t) (erased (Bool) sel z) (erased (Rgn) rg)
    (erased (NIv xs j g c lo3 hi3 z) iv) (erased (NPart xs j g c sel t) np) (subterm erased (NIn xs ys rg) w) (erased (KAway rg b cm s bn lo hc) ko)
    (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) rk) (erased (Add b v g) a) (erased (Lt g bn) gn) (erased (Lt lo (Succ lo3)) ll) (erased (Lt hi3 (Succ hc)) lh)
    -> (erased (NIv ys j g c lo3 hi3 z) iv2) (erased (NPart ys j g c sel t) np2))
  (let-match erased w (NinCons _ xs1 _ i _ y st iw w1) ((NinNil _ _) (values iv np)))
  (let ((erased ap) (erased o)) (r4g-kout i b cm s bn lo hc v g lo3 hi3 rg ko iw bi rk a gn ll lh))
  (r4g-nin-np xs1 ys j g lo3 hi3 b cm s bn lo hc v c t sel z rg (r4g-niv-set xs xs1 j g lo3 hi3 i c z y iv st ap o) (r4g-np-set xs xs1 j g lo3 hi3 i c t sel z y iv np st ap o)
    w1 ko bi rk a gn ll lh))

; Writes that miss the kid s keep its layout and parts.
(def-fns _ $ (erased r4g-nin-kid : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b cm s bn lo hc) (erased (Gtree) c t) (erased (Bool) sel z) (erased (Rgn) rg)
    (erased (NIvK xs j b cm s c bn lo hc z) iv) (erased (NPartK xs j b cm s c sel t) np) (erased (NIn xs ys rg) w) (erased (KAway rg b cm s bn lo hc) ko)
    -> (erased (NIvK ys j b cm s c bn lo hc z) iv2) (erased (NPartK ys j b cm s c sel t) np2))
  (let-match erased np (NpkP _ _ _ _ _ v g _ _ _ bi rk a p) ((NpkE _ _ _ _ _ _ bi)
    (let-match erased iv (NivkE _ _ _ _ _ _ _ _ _ _ lh) (absurd (NivkP _ _ _ _ _ _ _ _ _ _ _ _ _ _ bi1 _ _ _ _ _ _) (bitis-fn cm s (Bit0) (Bit1) bi bi1)))
    (values (NivkE ys j b cm s bn lo hc z bi lh) (NpkE ys j b cm s sel bi))))
  (let-match erased iv (NivkP _ _ _ _ _ v2 g2 lo2 hi2 _ _ _ _ _ _ rk2 a2 gn ll lh pv) (absurd (NivkE _ _ _ _ _ _ _ _ _ bi0 _) (bitis-fn cm s (Bit0) (Bit1) bi0 bi)))
  (let-match erased (rk-fn s cm v v2 rk rk2) (Refl _ _))
  (let-match erased (add-fn b v g g2 a a2) (Refl _ _))
  (let ((erased iv3) (erased np3)) (r4g-nin-np xs ys j g lo2 hi2 b cm s bn lo hc v c t sel z rg pv p w ko bi rk a gn ll lh))
  (values (NivkP ys j b cm s v g lo2 hi2 bn lo hc c z bi rk a gn ll lh iv3) (NpkP ys j b cm s v g c t sel bi rk a np3)))

; f, the gtr part of node a, is 0, or a is in Hs.
(def-adts $ (ZIn : ((Nat) f) ((Nat) a) ((List (Nat)) Hs) -> Type)
  enum
  (many ZiZ : (erased (Nat) a) (erased (List (Nat)) Hs) -> (ZIn (Zero) a Hs))
  (many ZiIn : (erased (Nat) f a) (erased (List (Nat)) Hs) (erased (In a Hs) p) -> (ZIn f a Hs)))

; Every node of xs, numbered from i, whose gtr part is not 0 is in Hs.
(def-adts $ (HAll : ((List (Copy (Nat))) xs) ((Nat) i) ((List (Nat)) Hs) -> Type)
  enum
  (many HalNil : (erased (Nat) i) (erased (List (Nat)) Hs) -> (HAll (Nil (Copy (Nat))) i Hs))
  (many HalCons : (erased (Nat) w i b cm f u) (erased (List (Copy (Nat))) xs) (erased (List (Nat)) Hs) (erased (NWd w b cm f u) d) (erased (ZIn f i Hs) z)
      (erased (HAll xs (Succ i) Hs) r) -> (HAll (Cons (Copy (Nat)) (MkCopy (Nat) w) xs) i Hs)))

; Every node of Hs is in Hs2.
(def-adts $ (HSub : ((List (Nat)) Hs) ((List (Nat)) Hs2) -> Type)
  enum
  (many HsbNil : (erased (List (Nat)) Hs2) -> (HSub (Nil (Nat)) Hs2))
  (many HsbCons : (erased (Nat) x) (erased (List (Nat)) Hs Hs2) (erased (In x Hs2) p) (erased (HSub Hs Hs2) r) -> (HSub (Cons (Nat) x Hs) Hs2)))

(def-fns _ $ (erased r4g-hsub-in : (erased (Nat) x) (erased (List (Nat)) Hs Hs2) (subterm erased (HSub Hs Hs2) s) (erased (In x Hs) p) -> (erased (In x Hs2) r))
  (let-match erased s (HsbCons y Hs1 _ q s1) (absurd (HsbNil _) p))
  (let-match erased p (InThere _ _ _ p1) ((InHere _ _) q))
  (r4g-hsub-in x Hs1 Hs2 s1 p1))

(def-fns _ $ (erased r4g-hsub-cons : (erased (Nat) g) (subterm erased (List (Nat)) Hs) (erased (List (Nat)) Hs2) (erased (HSub Hs Hs2) s) -> (erased (HSub Hs (Cons (Nat) g Hs2)) r))
  (let-match erased s (HsbCons y Hs1 _ q s1) ((HsbNil _) (HsbNil _)))
  (HsbCons y Hs1 _ (InThere y g Hs2 q) (r4g-hsub-cons g Hs1 Hs2 s1)))

(def-fns _ $ (erased r4g-hsub-refl : (subterm erased (List (Nat)) Hs) -> (erased (HSub Hs Hs) r))
  (let-match erased Hs (Cons _ x Hs1) ((Nil _) (HsbNil _)))
  (HsbCons x Hs1 Hs (InHere x Hs1) (r4g-hsub-cons x Hs1 Hs1 (r4g-hsub-refl Hs1))))

(def-fns _ $ (erased r4g-hall-mono : (erased (List (Copy (Nat))) xs) (erased (Nat) i) (erased (List (Nat)) Hs Hs2) (subterm erased (HAll xs i Hs) ha) (erased (HSub Hs Hs2) s)
    -> (erased (HAll xs i Hs2) r))
  (let-match erased ha (HalCons w _ b cm f u xs1 _ d z ha1) ((HalNil _ _) (HalNil i Hs2)))
  (HalCons w i b cm f u xs1 Hs2 d (match erased z (((ZIn f i Hs2) r)) ((ZiZ _ _) (ZiZ i Hs2)) ((ZiIn _ _ _ p) (ZiIn f i Hs2 (r4g-hsub-in i Hs Hs2 s p))))
    (r4g-hall-mono xs1 (Succ i) Hs Hs2 ha1 s)))

(def-fns _ $ (erased r4g-hall-get : (erased (List (Copy (Nat))) xs) (erased (Nat) i k a w b cm f u) (erased (List (Nat)) Hs) (subterm erased (HAll xs i Hs) ha)
    (erased (Nth (Copy (Nat)) xs k (MkCopy (Nat) w)) nth) (erased (Add i k a) ad) (erased (NWd w b cm f u) d) -> (erased (ZIn f a Hs) r))
  (let-match erased ha (HalCons w1 _ b1 cm1 f1 u1 xs1 _ d1 z ha1) (absurd (HalNil _ _) nth))
  (let-match erased nth (NthThere _ _ _ k1 _ nth1)
    ((NthHere _ _ _)
      (let-match erased (add-fn i (Zero) a i ad (add-zero-right i)) (Refl _ _))
      (let ((erased ef) (erased _) (erased _)) (nwd-fn w1 b1 cm1 f1 u1 b cm f u d1 d))
      (let-match erased ef (Refl _ _))
      z))
  (r4g-hall-get xs1 (Succ i) k1 a w b cm f u Hs ha1 nth1 (add-sh i k1 a ad) d))

(def-fns _ $ (erased r4g-hall-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) i k a w2 b cm f u) (erased (List (Nat)) Hs) (subterm erased (HAll xs i Hs) ha)
    (erased (SetNth (Copy (Nat)) xs k (MkCopy (Nat) w2) ys) st) (erased (Add i k a) ad) (erased (NWd w2 b cm f u) d) (erased (ZIn f a Hs) z) -> (erased (HAll ys i Hs) r))
  (let-match erased ha (HalCons w1 _ b1 cm1 f1 u1 xs1 _ d1 z1 ha1) (absurd (HalNil _ _) st))
  (let-match erased st (SetThere _ _ _ k1 _ ys1 st1)
    ((SetHere _ _ _ _) (let-match erased (add-fn i (Zero) a i ad (add-zero-right i)) (Refl _ _)) (HalCons w2 i b cm f u xs1 Hs d z ha1)))
  (HalCons w1 i b1 cm1 f1 u1 ys1 Hs d1 z1 (r4g-hall-set xs1 ys1 (Succ i) k1 a w2 b cm f u Hs ha1 st1 (add-sh i k1 a ad) d z)))

(def-fns _ $ (erased r4g-zin-drop : (erased (Nat) f a g) (erased (List (Nat)) R) (erased (ZIn f a (Cons (Nat) g R)) z) (erased (Apart (Nat) Lt a g) ap) -> (erased (ZIn f a R) r))
  (let-match erased z (ZiIn _ _ _ p) ((ZiZ _ _) (ZiZ a R)))
  (let-match erased p (InThere _ _ _ p1) (absurd (InHere _ _) (apart-irrefl a ap)))
  (ZiIn f a R p1))

(def-fns _ $ (erased r4g-hall-drop : (erased (List (Copy (Nat))) xs) (erased (Nat) i g) (erased (List (Nat)) R) (subterm erased (HAll xs i (Cons (Nat) g R)) ha) (erased (Lt g i) l)
    -> (erased (HAll xs i R) r))
  (let-match erased ha (HalCons w _ b cm f u xs1 _ d z ha1) ((HalNil _ _) (HalNil i R)))
  (HalCons w i b cm f u xs1 R d (r4g-zin-drop f i g R z (ApGt (Nat) Lt i g l)) (r4g-hall-drop xs1 (Succ i) g R ha1 (lt-weaken g i l))))

; Clearing the gtr part of node a, the first of the list, drops it from the list.
(def-fns _ $ (erased r4g-hall-clr : (erased (List (Copy (Nat))) xs ys) (erased (Nat) i k a w2 b cm u) (erased (List (Nat)) R) (subterm erased (HAll xs i (Cons (Nat) a R)) ha)
    (erased (SetNth (Copy (Nat)) xs k (MkCopy (Nat) w2) ys) st) (erased (Add i k a) ad) (erased (NWd w2 b cm (Zero) u) d) -> (erased (HAll ys i R) r))
  (let-match erased ha (HalCons w1 _ b1 cm1 f1 u1 xs1 _ d1 z1 ha1) (absurd (HalNil _ _) st))
  (let-match erased st (SetThere _ _ _ k1 _ ys1 st1)
    ((SetHere _ _ _ _)
      (let-match erased (add-fn i (Zero) a i ad (add-zero-right i)) (Refl _ _))
      (HalCons w2 i b cm (Zero) u xs1 R d (ZiZ i R) (r4g-hall-drop xs1 (Succ i) a R ha1 (lt-succ a)))))
  (HalCons w1 i b1 cm1 f1 u1 ys1 R d1 (r4g-zin-drop f1 i a R z1 (ApLt (Nat) Lt i a (add-pos-lt i (Succ k1) a ad (LtZ k1))))
    (r4g-hall-clr xs1 ys1 (Succ i) k1 a w2 b cm u R ha1 st1 (add-sh i k1 a ad) d)))

(def-fns _ $ (erased r4g-hsub-tf : (erased (List (Copy (Nat))) xs) (erased (Nat) k n) (erased (List (Nat)) T R) (subterm erased (Tbk xs k T) tb) (erased (Fwd xs (Zero) n R) fw)
    (erased (Lt k (Succ n)) kn) -> (erased (HSub T R) r))
  (let-match erased tb (TbkCons _ k1 x T1 tb1 wx) ((TbkNil _) (HsbNil R)))
  (let ((erased k1n)) (lt-pred k1 n kn))
  (HsbCons x T1 R (r4c-fwd-in xs (Zero) n k1 x R fw wx (LtZ k1) k1n) (r4g-hsub-tf xs k1 n T1 R tb1 fw (lt-weaken k1 n k1n))))

; With no node in the list, gtr is empty.
(def-fns _ $ (erased r4g-np-empty : (erased (List (Copy (Nat))) xs) (erased (Nat) j g) (erased (Gtree) s0) (erased (NLay xs j g s0) ly) (erased (HAll xs (Zero) (Nil (Nat))) ha)
    -> (erased (NPart xs j g s0 (BTrue) (GEmpty)) r))
  (let ((erased w) (erased b) (erased cm) (erased f) (erased u) (erased x) (erased d))
    (match erased ly (((Nat) w) ((Nat) b) ((Nat) cm) ((Nat) f) ((Nat) u) ((WElt xs g w) x) ((NWd w b cm f u) d))
      ((NlL _ _ wa ba ma fa ua _ xa da _) (values wa ba ma fa ua xa da))
      ((NlN _ _ _ wa ba ma fa ua _ _ _ _ xa da _ _ _ _ _) (values wa ba ma fa ua xa da))))
  (let-match erased x (MkWElt _ _ _ nth))
  (let-match erased (r4g-hall-get xs (Zero) g g w b cm f u (Nil _) ha nth (AddZero g) d) (ZiZ _ _) (absurd (ZiIn _ _ _ p) p))
  (NpE xs j g w b cm (Zero) u s0 (BTrue) x d (FdT (Zero) u)))

; Each node of Hs has a nonzero gtr part in xs.
(def-adts $ (HNz : ((List (Copy (Nat))) xs) ((List (Nat)) Hs) -> Type)
  enum
  (many HnNil : (erased (List (Copy (Nat))) xs) -> (HNz xs (Nil (Nat))))
  (many HnCons : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b cm f u) (erased (List (Nat)) Hs) (erased (WElt xs g w) x) (erased (NWd w b cm f u) d)
      (erased (Apart (Nat) Lt f (Zero)) ap) (erased (HNz xs Hs) r) -> (HNz xs (Cons (Nat) g Hs))))

; The hits buffer Hs, for the len node words xs: distinct nodes, those with a nonzero gtr part.
(def-adts $ (HOk : ((List (Copy (Nat))) xs) ((Nat) len) ((List (Nat)) Hs) -> Type)
  enum
  (many MkHOk : (erased (List (Copy (Nat))) xs) (erased (Nat) len) (erased (List (Nat)) Hs) (erased (AllLt Hs len) al) (erased (Distinct Hs) dt) (erased (HNz xs Hs) hz)
      (erased (HAll xs (Zero) Hs) ha) -> (HOk xs len Hs)))

(def-fns _ $ (erased r4g-hnz-notin : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b cm u) (erased (List (Nat)) Hs) (subterm erased (HNz xs Hs) hz) (erased (WElt xs g w) x)
    (erased (NWd w b cm (Zero) u) d) -> (erased (NotIn g Hs) r))
  (let-match erased hz (HnCons _ i wi bi cmi fi ui Hs1 xi di ap hz1) ((HnNil _) (NotInNil g)))
  (let-match erased (nat-eq g i) (Unequal _ _ _ _ ne)
    (absurd (Equal _ _ _)
      (let-match erased (welt-fn xs g w wi x xi) (Refl _ _))
      (let ((erased ef) (erased _) (erased _)) (nwd-fn w b cm (Zero) u bi cmi fi ui d di))
      (let-match erased ef (Refl _ _))
      (apart-irrefl (Zero) ap)))
  (NotInCons g i Hs1 ne (r4g-hnz-notin xs g w b cm u Hs1 hz1 x d)))

(def-fns _ $ (erased r4g-hnz-put : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g w w2 b cm f u f2) (erased (List (Nat)) Hs) (subterm erased (HNz xs Hs) hz)
    (erased (SetNth (Copy (Nat)) xs g (MkCopy (Nat) w2) ys) st) (erased (WElt xs g w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u) d2) (erased (Lt f (Succ f2)) l)
    -> (erased (HNz ys Hs) r))
  (let-match erased hz (HnCons _ i wi bi cmi fi ui Hs1 xi di ap hz1) ((HnNil _) (HnNil ys)))
  (let ((erased r1)) (r4g-hnz-put xs ys g w w2 b cm f u f2 Hs1 hz1 st x d d2 l))
  (let-match erased (nat-eq i g) (Equal _ _ _)
    ((Unequal _ _ _ _ ne) (HnCons ys i wi bi cmi fi ui Hs1 (welt-set xs ys i wi g _ xi st (r4c-apart-sym i g ne)) di ap r1)))
  (let-match erased (welt-fn xs i wi w xi x) (Refl _ _))
  (let ((erased ef) (erased _) (erased _)) (nwd-fn wi bi cmi fi ui b cm f u di d))
  (let-match erased ef (Refl _ _))
  (HnCons ys i w2 b cm f2 u Hs1 (MkWElt ys i w2 (setnth-nth _ xs i _ ys st)) d2 (r4g-nz-up f f2 l ap) r1))

; Hs2 is the hits buffer Hs after mark's push of node g, whose gtr part was f.
(def-adts $ (HPush : ((Nat) f) ((Nat) g) ((List (Nat)) Hs) ((List (Nat)) Hs2) -> Type)
  enum
  (many HpNew : (erased (Nat) g) (erased (List (Nat)) Hs) -> (HPush (Zero) g Hs (Cons (Nat) g Hs)))
  (many HpOld : (erased (Nat) f g) (erased (List (Nat)) Hs) (erased (Apart (Nat) Lt f (Zero)) ap) -> (HPush f g Hs Hs)))

(let ((many r4g-v256) (erased r4g-m1616)) (mul 16 16))
(comptime-match many (nat-eq r4g-v256 256) (Equal _ _ _))
(comptime-match many (lt-dec 0 16) (Yes _ _ _ _ r4g-0-16))

; The symbol g matches the colour e under the stack top t, as in red4's digits.
(def-adts $ (TMatch : ((Gsym) g) ((Nat) t) ((Col) e) -> Type)
  enum
  (many TmPu2 : (erased (Nat) t) -> (TMatch (GPush) t (C2)))
  (many TmPu3 : (erased (Nat) t) -> (TMatch (GPush) t (C3)))
  (many TmSk : (erased (Nat) t) -> (TMatch (GSkip) t (C1)))
  (many TmP02 : -> (TMatch (GPop0) (Succ (Zero)) (C2)))
  (many TmP03 : -> (TMatch (GPop0) (Succ (Succ (Zero))) (C3)))
  (many TmP13 : -> (TMatch (GPop1) (Succ (Zero)) (C3)))
  (many TmP12 : -> (TMatch (GPop1) (Succ (Succ (Zero))) (C2))))

; c, bit s of a ghit entry for the symbols m under the top t against the trie bits x, is clear, or s is in m and matches under t a colour whose
; bit in x is set.
(def-adts $ (GhC : ((Nat) m) ((Nat) t) ((Nat) x) ((Nat) s) ((Bit) c) -> Type)
  enum
  (many GhZ : (erased (Nat) m t x s) -> (GhC m t x s (Bit0)))
  (many GhY : (erased (Nat) m t x s d) (erased (Gsym) g) (erased (Col) e) (erased (SymN s g) sn) (erased (BitIs m s (Bit1)) bm) (erased (CD d e) cd)
      (erased (BitIs x d (Bit1)) bx) (erased (TMatch g t e) tm) -> (GhC m t x s (Bit1))))

; Entry i, 32 m + 8 t + x, of red4's ghit table, below 16; for t below 3, each bit as GhC says.
(def-adts $ (GHitE : ((Nat) i) ((Nat) v) -> Type)
  enum
  (many GheOk : (erased (Nat) i x tm t m v) (erased (Bit) c0 c1 c2 c3) (erased (Bsp 3 i x tm) p) (erased (Bsp 2 tm t m) q) (erased (Lt v 16) vl)
      (erased (BitIs v (Zero) c0) v0) (erased (BitIs v (Succ (Zero)) c1) v1) (erased (BitIs v (Succ (Succ (Zero))) c2) v2)
      (erased (BitIs v (Succ (Succ (Succ (Zero)))) c3) v3) (erased (GhC m t x (Zero) c0) h0) (erased (GhC m t x (Succ (Zero)) c1) h1)
      (erased (GhC m t x (Succ (Succ (Zero))) c2) h2) (erased (GhC m t x (Succ (Succ (Succ (Zero)))) c3) h3) -> (GHitE i v))
  (many GheT3 : (erased (Nat) i x tm m v) (erased (Bsp 3 i x tm) p) (erased (Bsp 2 tm (Succ (Succ (Succ (Zero)))) m) q) (erased (Lt v 16) vl) -> (GHitE i v)))

(def-fns _ $ (many r4g-bit : (many (Nat) m d) -> (many (Bit) b) (erased (BitIs m d b) bi))
  (let ((many lo) (many y) (erased p)) (bsp-c d m))
  (let ((many y1) (many b) (erased c)) (nat-bit y))
  (values b (MkBitIs m d lo y y1 b p c)))

(def-fns _ $ (many r4g-and : (erased (Nat) m t x s d) (erased (Gsym) g) (erased (Col) e) (erased (SymN s g) sn) (many (Bit) bm) (erased (BitIs m s bm) pm) (many (Bit) bx)
    (erased (CD d e) cd) (erased (BitIs x d bx) px) (erased (TMatch g t e) tm) -> (many (Bit) c) (erased (GhC m t x s c) h))
  (let-match many bm (Bit1) ((Bit0) (values (Bit0) (GhZ m t x s))))
  (let-match many bx (Bit1) ((Bit0) (values (Bit0) (GhZ m t x s))))
  (values (Bit1) (GhY m t x s d g e sn pm cd px tm)))

(def-fns _ $ (many r4g-or : (erased (Nat) m t x s) (many (Bit) a b) (erased (GhC m t x s a) ha) (erased (GhC m t x s b) hb) -> (many (Bit) c) (erased (GhC m t x s c) h))
  (match many a _ ((Bit1) (values (Bit1) ha)) ((Bit0) (values b hb))))

; v holds the bits c0 to c3, lowest first.
(def-fns _ $ (many r4g-word4 : (many (Bit) c0 c1 c2 c3) -> (many (Nat) v) (erased (Lt v 16) vl) (erased (BitIs v (Zero) c0) b0) (erased (BitIs v (Succ (Zero)) c1) b1)
    (erased (BitIs v (Succ (Succ (Zero))) c2) b2) (erased (BitIs v (Succ (Succ (Succ (Zero)))) c3) b3))
  (let ((many v3) (erased k3)) (bit-snoc 0 c3))
  (let ((many v2) (erased k2)) (bit-snoc v3 c2))
  (let ((many v1) (erased k1)) (bit-snoc v2 c1))
  (let ((many v) (erased k0)) (bit-snoc v1 c0))
  (let-match erased r4-e0 (Refl _ _))
  (let ((erased p3)) (BspS (Zero) v3 (Zero) v3 (Zero) (Zero) c3 (BspZ (Zero)) k3 k3))
  (let ((erased p2)) (BspS _ v2 v3 v2 v3 (Zero) c2 p3 k2 k2))
  (let ((erased p1)) (BspS _ v1 v2 v1 v2 (Zero) c1 p2 k1 k1))
  (let ((erased p0)) (BspS _ v v1 v v1 (Zero) c0 p1 k0 k0))
  (let-match erased r4-e4s (Refl _ _))
  (let ((erased q3)) (MkBitIs v3 (Zero) (Zero) v3 (Zero) c3 (BspZ v3) k3))
  (let ((erased q2)) (MkBitIs v2 (Zero) (Zero) v2 v3 c2 (BspZ v2) k2))
  (let ((erased q1)) (MkBitIs v1 (Zero) (Zero) v1 v2 c1 (BspZ v1) k1))
  (values v (bsp-lt 4 v v (Zero) 16 p0 r4-p16) (MkBitIs v (Zero) (Zero) v v1 c0 (BspZ v) k0) (r4c-bitis-up v v1 (Zero) c1 c0 q1 k0)
    (r4c-bitis-up v v1 (Succ (Zero)) c2 c0 (r4c-bitis-up v1 v2 (Zero) c2 c1 q2 k1) k0)
    (r4c-bitis-up v v1 (Succ (Succ (Zero))) c3 c0 (r4c-bitis-up v1 v2 (Succ (Zero)) c3 c1 (r4c-bitis-up v2 v3 (Zero) c3 c2 q3 k2) k1) k0)))

(def-fns _ $ (many ghit-at : (many (Nat) i) (erased (Lt i 512) il) -> (many (Nat) v) (erased (GHitE i v) p) (erased (Lt v u62-modulus) vb))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e2 (Refl _ _))
  (let-match erased r4-e3 (Refl _ _))
  (let ((many x) (many tm) (erased p)) (bsp-c 3 i))
  (let ((many t) (many m) (erased q)) (bsp-c 2 tm))
  (let ((many m0) (erased pm0)) (r4g-bit m 0))
  (let ((many m1) (erased pm1)) (r4g-bit m 1))
  (let ((many m2) (erased pm2)) (r4g-bit m 2))
  (let ((many m3) (erased pm3)) (r4g-bit m 3))
  (let ((many x0) (erased px0)) (r4g-bit x 0))
  (let ((many x1) (erased px1)) (r4g-bit x 1))
  (let ((many x2) (erased px2)) (r4g-bit x 2))
  (let ((many ca) (erased ha)) (r4g-and m t x (Zero) (Succ (Zero)) (GPush) (C2) (SnPush) m0 pm0 x1 (Cd1) px1 (TmPu2 t)))
  (let ((many cb) (erased hb)) (r4g-and m t x (Zero) (Succ (Succ (Zero))) (GPush) (C3) (SnPush) m0 pm0 x2 (Cd2) px2 (TmPu3 t)))
  (let ((many c0) (erased h0)) (r4g-or m t x (Zero) ca cb ha hb))
  (let ((many c1) (erased h1)) (r4g-and m t x (Succ (Zero)) (Zero) (GSkip) (C1) (SnSkip) m1 pm1 x0 (Cd0) px0 (TmSk t)))
  (match many t _
    ((Zero)
      (let ((many v) (erased vl) (erased b0) (erased b1) (erased b2) (erased b3)) (r4g-word4 c0 c1 (Bit0) (Bit0)))
      (values v (GheOk i x tm t m v c0 c1 (Bit0) (Bit0) p q vl b0 b1 b2 b3 h0 h1 (GhZ m t x _) (GhZ m t x _)) (lt-trans v 16 u62-modulus vl r4-16-u62)))
    ((Succ t1)
      (match many t1 _
        ((Zero)
          (let ((many c2) (erased h2)) (r4g-and m t x (Succ (Succ (Zero))) (Succ (Zero)) (GPop0) (C2) (SnPop0) m2 pm2 x1 (Cd1) px1 (TmP02)))
          (let ((many c3) (erased h3)) (r4g-and m t x (Succ (Succ (Succ (Zero)))) (Succ (Succ (Zero))) (GPop1) (C3) (SnPop1) m3 pm3 x2 (Cd2) px2 (TmP13)))
          (let ((many v) (erased vl) (erased b0) (erased b1) (erased b2) (erased b3)) (r4g-word4 c0 c1 c2 c3))
          (values v (GheOk i x tm t m v c0 c1 c2 c3 p q vl b0 b1 b2 b3 h0 h1 h2 h3) (lt-trans v 16 u62-modulus vl r4-16-u62)))
        ((Succ t2)
          (match many t2 _
            ((Zero)
              (let ((many c2) (erased h2)) (r4g-and m t x (Succ (Succ (Zero))) (Succ (Succ (Zero))) (GPop0) (C3) (SnPop0) m2 pm2 x2 (Cd2) px2 (TmP03)))
              (let ((many c3) (erased h3)) (r4g-and m t x (Succ (Succ (Succ (Zero)))) (Succ (Zero)) (GPop1) (C2) (SnPop1) m3 pm3 x1 (Cd1) px1 (TmP12)))
              (let ((many v) (erased vl) (erased b0) (erased b1) (erased b2) (erased b3)) (r4g-word4 c0 c1 c2 c3))
              (values v (GheOk i x tm t m v c0 c1 c2 c3 p q vl b0 b1 b2 b3 h0 h1 h2 h3) (lt-trans v 16 u62-modulus vl r4-16-u62)))
            ((Succ t3)
              (let-match erased t3 (Zero)
                (absurd (Succ t4)
                  (let ((erased w) (erased _) (erased pw) (erased _) (erased _) (erased tl)) (bsp-arith 2 tm t m q))
                  (let-match erased (pow2-fn 2 w 4 pw r4-p4) (Refl _ _))
                  (let-match erased tl (LtS _ _ l1))
                  (let-match erased l1 (LtS _ _ l2))
                  (let-match erased l2 (LtS _ _ l3))
                  (let-match erased l3 (LtS _ _ l4))
                  l4))
              (let ((many c3)) (match many m3 (((Bit) c)) ((Bit0) (Bit0)) ((Bit1) x0)))
              (let ((many v) (erased vl) (erased _) (erased _) (erased _) (erased _)) (r4g-word4 c0 c1 (Bit0) c3))
              (values v (GheT3 i x tm m v p q vl) (lt-trans v 16 u62-modulus vl r4-16-u62)))))))))

(comptime-match many (lt-dec 512 flag-um) (Yes _ _ _ _ r4g-512-u62))
(let ((erased r4g-ghl) (many r4g-gtab)) (tab-factory (level-of ghit-at)))
(let ((erased r4-ghit-l) (unique r4-ghit0) (erased r4-ghit-t) (erased r4-ghit-n) (erased r4-ghit-a)) (r4g-gtab GHitE 512 r4g-512-u62 ghit-at))
(let ((many r4-ghit)) (share r4-ghit0))

; An entry of the last level of the ctr trie is a 3-bit set.
(def-fns _ $ (erased r4g-ca-leaf : (erased (List (U8)) cs) (erased (Nat) n x) (erased (Ctree) t) (erased (Ca cs (Zero) n t) f) (erased (Elt flag-w cs n x) ex)
    -> (erased (Bsp 3 x x (Zero)) xb))
  (match erased f _
    ((CaE _ _ _ z)
      (let-match erased z (MkZr _ _ _ _ z0 _ _ _ _))
      (let-match erased (elt-fn flag-w cs n x (Zero) ex z0) (Refl _ _))
      (bsp-zz 3))
    ((CaL _ _ c _ _ _ y b _)
      (let-match erased (elt-fn flag-w cs n x c ex y) (Refl _ _))
      (let-match erased b (MkB3 _ _ _ _ _ _ _ cb _ _ _ _ _ _))
      cb)))

(def-fns _ $ (erased r4g-top-lt : (erased (Bstack) bs) (erased (Nat) t) (erased (TopN bs t) tn) -> (erased (Lt t (Succ (Succ (Succ (Zero))))) l))
  (match erased tn _ ((TnE) (LtZ _)) ((Tn0 _) (LtS _ _ (LtZ _))) ((Tn1 _) (LtS _ _ (LtS _ _ (LtZ _))))))

; v is red4's ghit entry for the symbols m under the stack bs against the trie bits x.
(def-adts $ (GhAt : ((Nat) m) ((Bstack) bs) ((Nat) x) ((Nat) v) -> Type)
  enum
  (many MkGhAt : (erased (Nat) m x v i tm t) (erased (Bstack) bs) (erased (TopN bs t) tn) (erased (Bsp 3 i x tm) p) (erased (Bsp 2 tm t m) q) (erased (GHitE i v) ge)
      -> (GhAt m bs x v)))

(let ((many r4g-v512) (erased r4g-m648)) (mul 64 r4c-v8))
(comptime-match many (nat-eq r4g-v512 512) (Equal _ _ _))

; red4's ghits ca o m p bs: the symbols of m that, under the stack bs, reach from the node o + p of the last level of the ctr trie a trace of ctr.
(def-fns _ $ (many r4-ghits : (erased (List (U8)) cs) (unique (Bytes cs) ca) (erased (Nat) len) (erased (Sz flag-w cs len) z) (many (Nat) o m p b) (erased (Lt m 16) ml)
    (erased (Bstack) bs) (erased (Bn bs b) bn) (erased (Lt b u62-modulus) bb) (erased (Nat) n) (erased (Add o p n) an) (erased (Lt n len) nl) (erased (Ctree) t)
    (erased (Ca cs (Zero) n t) f) -> (unique ca is ca2 at ca) (many (Nat) v) (erased (Nat) x) (erased (Elt flag-w cs n x) ex) (erased (GhAt m bs x v) ga) (erased (Lt v 16) vl))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let ((erased lb)) (sz-u62 flag-w cs len z))
  (let ((erased mb)) (lt-trans m 16 u62-modulus ml r4-16-u62))
  (let ((many tv) (erased tn)) (r4-top b bs bn bb))
  (let ((erased tl)) (r4g-top-lt bs tv tn))
  (let ((erased m4) (erased mm4)) (mul m 4))
  (let ((erased tm) (erased atm)) (add m4 tv))
  (let ((erased tml)) (digit-lt 4 16 64 tv m m4 tm (lt-weaken tv 3 tl) ml mm4 atm r4-pm64))
  (let ((erased m4l)) (lt-le-trans m4 (Succ tm) 64 (add-le-left m4 tv tm atm) (LtS tm 64 tml)))
  (let ((many m4v)) (u62-shl m 2 r4-two-lt 4 r4-p4 m4 mm4 (lt-trans m4 64 u62-modulus m4l r4-64-u62)))
  (let ((many tmv)) (u62-add m4v tv tm atm (lt-trans tm 64 u62-modulus tml r4-64-u62)))
  (let ((erased j8) (erased mm8)) (mul tm r4c-v8))
  (let ((erased jb)) (lt-trans n len u62-modulus nl lb))
  (let ((many j)) (u62-add o p n an jb))
  (let ((erased x0) (erased ex)) (elt-exists flag-w cs len n z nl))
  (let ((unique ca2) (many x)) (r4-gb cs ca j x0 ex))
  (let ((erased xc)) (r4g-ca-leaf cs n x t f ex))
  (let ((erased xl)) (bsp-lt 3 x x (Zero) r4c-v8 xc r4c-p8))
  (let ((erased i) (erased aj)) (add j8 x))
  (let ((erased il)) (digit-lt r4c-v8 64 512 x tm j8 i xl tml mm8 aj r4g-m648))
  (let ((erased ib)) (lt-trans i 512 u62-modulus il r4g-512-u62))
  (let ((many i8v)) (u62-shl tmv 3 r4c-3-63 r4c-v8 r4c-p8 j8 mm8 (le-u62 j8 i (add-le-left j8 x i aj) ib)))
  (let ((many iv)) (u62-add i8v x i aj ib))
  (let ((erased c) (erased nth)) (nth-exists _ r4-ghit-l 512 i r4-ghit-n il))
  (let-match many (array-get-many _ _ r4-ghit iv c nth) (MkCopy _ v))
  (let ((erased v2) (erased evg) (erased ge)) (tab-get GHitE 512 i r4-ghit-l c r4-ghit-t nth il))
  (let-match erased evg (Refl _ _))
  (let ((erased vl)) (match erased ge (((Lt v 16) l)) ((GheOk _ _ _ _ _ _ _ _ _ _ _ _ vl0 _ _ _ _ _ _ _ _) vl0) ((GheT3 _ _ _ _ _ _ _ vl0) vl0)))
  (values ca2 v x ex
    (MkGhAt m x v i tm tv bs tn (bsp-of 3 r4c-v8 tm j8 x i r4c-p8 mm8 aj xl) (bsp-of 2 4 m m4 tv tm r4-p4 mm4 atm (lt-weaken tv 3 tl)) ge) vl))

; Node n, o + p, of level h of the ctr trie holds t, the subtree of ctr at the colours pre of the prefix p.
(def-fns _ $ (erased r4g-leaf-ca : (erased (List (U8)) cs) (erased (Nat) h o p n) (erased (Ctree) ctr t) (erased (List (Col)) pre) (erased (Ca cs h (Zero) ctr) f)
    (erased (RIdx pre p) ri) (erased (Length (Col) pre h) le) (erased (CtAt ctr pre t) ct) (erased (Offs h o) of) (erased (Add o p n) an) -> (erased (Ca cs (Zero) n t) ft))
  (r4c-ca-at cs (Zero) n h h ctr t pre f (hidx-offs p h o n pre ri le of an) ct le (add-zero-right h)))

(comptime-match many (r4-eq-pf 16 (Succ 15)) (ESome _ r4g-e16))

(def-fns _ $ (erased r4g-nwd-fu : (erased (Nat) w b cm f u b2 cm2 f2 u2) (erased (NWd w b cm f u) d) (erased (NWd w b2 cm2 f2 u2) d2) -> (erased (Eq (Nat) u u2) e))
  (let-match erased d (MkNWd _ _ _ _ _ y1 _ p1 _ _))
  (let-match erased d2 (MkNWd _ _ _ _ _ z1 _ q1 _ _))
  (let ((erased e) (erased _)) (bsp-fn 4 w u y1 u2 z1 p1 q1))
  e)

(def-fns _ $ (erased r4g-bit-lo : (erased (Nat) s bm m v d) (erased (Bit) x) (erased (Bsp s bm m v) p) (erased (BitIs m d x) bi) (erased (Lt d s) l) -> (erased (BitIs bm d x) r))
  (let ((erased lo) (erased y) (erased y1) (erased _) (erased b) (erased q) (erased c) (erased _) (erased _)) (bsp-bit d bm))
  (let ((erased x2) (erased z1) (erased bi2) (erased c2)) (bsp-bitis d s bm lo y m v q p l))
  (let-match erased (bitis-fn m d x2 x bi2 bi) (Refl _ _))
  (let ((erased _) (erased e)) (bitcons-fn z1 x y1 b y c2 c))
  (let-match erased e (Refl _ _))
  (MkBitIs bm d lo y y1 x q c))

(def-fns _ $ (erased r4g-bit-hi : (erased (Nat) s bm m v) (erased (Bit) x) (erased (Bsp s bm m v) p) (erased (BitV x v) bv) -> (erased (BitIs bm s x) r))
  (MkBitIs bm s m v (Zero) x p (match erased bv (((BitCons (Zero) x v) c)) ((BV0) (BC0 (Zero) (Zero) (D0))) ((BV1) (BC1 (Zero) (Zero) (D0))))))

(def-fns _ $ (erased r4g-ones-bit : (erased (Nat) k m d) (subterm erased (Ones k m) o) (erased (Lt d k) l) -> (erased (BitIs m d (Bit1)) r))
  (let-match erased o (OnS k1 m1 _ o1 c) (absurd (OnZ) l))
  (let-match erased d (Succ d1) ((Zero) (MkBitIs m (Zero) (Zero) m m1 (Bit1) (BspZ m) c)))
  (let-match erased l (LtS _ _ l1))
  (r4c-bitis-up m m1 d1 (Bit1) (Bit1) (r4g-ones-bit k1 m1 d1 o1 l1) c))

; The bits of a 4-bit number m held as by Ac.
(def-fns _ $ (erased r4g-ac4-bits : (erased (Bit) x0 x1 x2 x3) (erased (Nat) m) (erased (Ac (Cons (Bit) x3 (Cons (Bit) x2 (Cons (Bit) x1 (Cons (Bit) x0 (Nil (Bit)))))) 4 m) a)
    -> (erased (BitIs m (Zero) x0) b0) (erased (BitIs m (Succ (Zero)) x1) b1) (erased (BitIs m (Succ (Succ (Zero))) x2) b2) (erased (BitIs m (Succ (Succ (Succ (Zero)))) x3) b3))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased a (AcS _ _ m3 _ v3 _ a3 bv3 p3))
  (let-match erased a3 (AcS _ _ m2 _ v2 _ a2 bv2 p2))
  (let-match erased a2 (AcS _ _ m1 _ v1 _ a1 bv1 p1))
  (let-match erased a1 (AcS _ _ m0 _ v0 _ a0 bv0 q0))
  (let ((erased z) (erased o)) (values (Zero) (Succ (Zero))))
  (let ((erased l12) (erased l13) (erased l23)) (values (LtS z o (LtZ z)) (LtS z (Succ o) (LtZ o)) (LtS o (Succ o) (LtS z o (LtZ z)))))
  (let ((erased c0)) (r4g-bit-hi (Zero) m1 m0 v0 x0 q0 bv0))
  (let ((erased c1)) (r4g-bit-hi _ m2 m1 v1 x1 p1 bv1))
  (let ((erased c2)) (r4g-bit-hi _ m3 m2 v2 x2 p2 bv2))
  (values (r4g-bit-lo _ m m3 v3 z x0 p3 (r4g-bit-lo _ m3 m2 v2 z x0 p2 (r4g-bit-lo _ m2 m1 v1 z x0 p1 c0 (LtZ z)) (LtZ o)) (LtZ (Succ o)))
    (r4g-bit-lo _ m m3 v3 o x1 p3 (r4g-bit-lo _ m3 m2 v2 o x1 p2 c1 l12) l13)
    (r4g-bit-lo _ m m3 v3 _ x2 p3 c2 l23)
    (r4g-bit-hi _ m m3 v3 x3 p3 bv3)))

; The leaf t with the symbols b0 to b3 has the word m, below 16, whose bits are those symbols.
(def-fns _ $ (erased r4g-leafm-of : (erased (Gtree) t) (erased (Bool) b0 b1 b2 b3) (erased (Bit) x0 x1 x2 x3) (erased (Nat) m) (erased (LeafSet t (MkBits b0 b1 b2 b3)) ls)
    (erased (BoolBit b0 x0) e0) (erased (BoolBit b1 x1) e1) (erased (BoolBit b2 x2) e2) (erased (BoolBit b3 x3) e3) (erased (BitIs m (Zero) x0) k0)
    (erased (BitIs m (Succ (Zero)) x1) k1) (erased (BitIs m (Succ (Succ (Zero))) x2) k2) (erased (BitIs m (Succ (Succ (Succ (Zero)))) x3) k3) (erased (Lt m 16) ml)
    -> (erased (LeafM t m) r))
  (let ((erased c0) (erased c1) (erased c2) (erased c3) (erased y0) (erased y1) (erased y2) (erased y3) (erased f0) (erased f1) (erased f2) (erased f3) (erased a)) (r4-bit4 m ml))
  (let ((erased j0) (erased j1) (erased j2) (erased j3)) (r4g-ac4-bits y0 y1 y2 y3 m a))
  (let-match erased (bitis-fn m (Zero) y0 x0 j0 k0) (Refl _ _))
  (let-match erased (bitis-fn m (Succ (Zero)) y1 x1 j1 k1) (Refl _ _))
  (let-match erased (bitis-fn m (Succ (Succ (Zero))) y2 x2 j2 k2) (Refl _ _))
  (let-match erased (bitis-fn m (Succ (Succ (Succ (Zero)))) y3 x3 j3 k3) (Refl _ _))
  (MkLeafM t m b0 b1 b2 b3 x0 x1 x2 x3 ls e0 e1 e2 e3 a))

; a lies in u: a's symbols at each leaf are some of u's.
(def-adts $ (GSub : ((Gtree) u) ((Gtree) a) -> Type)
  enum
  (many GsbE : (erased (Gtree) u) -> (GSub u (GEmpty)))
  (many GsbN : (erased (Gtree) u0 u1 u2 u3 a0 a1 a2 a3) (erased (GSub u0 a0) s0) (erased (GSub u1 a1) s1) (erased (GSub u2 a2) s2) (erased (GSub u3 a3) s3)
      -> (GSub (GNode u0 u1 u2 u3) (GNode a0 a1 a2 a3)))
  (many GsbL : (erased (Gtree) u a) (erased (Bool) u0 u1 u2 u3 a0 a1 a2 a3 y0 y1 y2 y3) (erased (LeafSet u (MkBits u0 u1 u2 u3)) lu) (erased (LeafSet a (MkBits a0 a1 a2 a3)) la)
      (erased (BitPart u0 a0 y0) q0) (erased (BitPart u1 a1 y1) q1) (erased (BitPart u2 a2 y2) q2) (erased (BitPart u3 a3 y3) q3) -> (GSub u a)))

(def-fns _ $ (erased r4g-bp-out : (erased (Bool) u a) -> (erased (Bool) y) (erased (BitPart u (BFalse) y) q))
  (match erased u _ ((BTrue) (values (BTrue) (BPR))) ((BFalse) (values (BFalse) (BPN)))))

; At a leaf u, a's symbols, each with u's and the rest of u's.
(def-fns _ $ (erased r4g-gsub-lf : (erased (Gtree) u a) (erased (Bool) u0 u1 u2 u3) (erased (GSub u a) gs) (erased (LeafSet u (MkBits u0 u1 u2 u3)) lu)
    -> (erased (Bool) a0 a1 a2 a3 y0 y1 y2 y3) (erased (LeafSet a (MkBits a0 a1 a2 a3)) la) (erased (BitPart u0 a0 y0) q0) (erased (BitPart u1 a1 y1) q1)
    (erased (BitPart u2 a2 y2) q2) (erased (BitPart u3 a3 y3) q3))
  (match erased gs _
    ((GsbE _)
      (let ((erased y0) (erased q0)) (r4g-bp-out u0 (BFalse)))
      (let ((erased y1) (erased q1)) (r4g-bp-out u1 (BFalse)))
      (let ((erased y2) (erased q2)) (r4g-bp-out u2 (BFalse)))
      (let ((erased y3) (erased q3)) (r4g-bp-out u3 (BFalse)))
      (values (BFalse) (BFalse) (BFalse) (BFalse) y0 y1 y2 y3 (LSE) q0 q1 q2 q3))
    (absurd (GsbN _ _ _ _ _ _ _ _ _ _ _ _) lu)
    ((GsbL _ _ v0 v1 v2 v3 a0 a1 a2 a3 y0 y1 y2 y3 lv la q0 q1 q2 q3)
      (let-match erased (leafset-fn u _ _ lv lu) (Refl _ _))
      (values a0 a1 a2 a3 y0 y1 y2 y3 la q0 q1 q2 q3))))

; The bit of u less a, for a within u.
(def-fns _ $ (erased r4g-bp-bit : (erased (Bool) u a y) (erased (Bit) xu xa c d) (erased (BitPart u a y) q) (erased (BoolBit u xu) eu) (erased (BoolBit a xa) ea)
    (erased (BitApply xor-op xa (Bit1) c) px) (erased (BitApply and-op xu c d) pa) -> (erased (BoolBit y d) r))
  (match erased q _
    ((BPL) (let-match erased eu (BBT)) (let-match erased ea (BBT)) (let-match erased px (Ap11 _ _ _)) (let-match erased pa (Ap10 _ _ _)) (BBF))
    ((BPR) (let-match erased eu (BBT)) (let-match erased ea (BBF)) (let-match erased px (Ap01 _ _ _)) (let-match erased pa (Ap11 _ _ _)) (BBT))
    ((BPN) (let-match erased eu (BBF)) (let-match erased ea (BBF)) (let-match erased px (Ap01 _ _ _)) (let-match erased pa (Ap01 _ _ _)) (BBF))))

; LeafM's bits one by one.
(def-fns _ $ (erased r4g-lm-bits : (erased (Gtree) t) (erased (Nat) m) (erased (LeafM t m) lm) -> (erased (Bool) b0 b1 b2 b3) (erased (Bit) x0 x1 x2 x3)
    (erased (LeafSet t (MkBits b0 b1 b2 b3)) ls) (erased (BoolBit b0 x0) e0) (erased (BoolBit b1 x1) e1) (erased (BoolBit b2 x2) e2) (erased (BoolBit b3 x3) e3)
    (erased (BitIs m (Zero) x0) k0) (erased (BitIs m (Succ (Zero)) x1) k1) (erased (BitIs m (Succ (Succ (Zero))) x2) k2) (erased (BitIs m (Succ (Succ (Succ (Zero)))) x3) k3))
  (let-match erased lm (MkLeafM _ _ b0 b1 b2 b3 x0 x1 x2 x3 ls e0 e1 e2 e3 a))
  (let ((erased k0) (erased k1) (erased k2) (erased k3)) (r4g-ac4-bits x0 x1 x2 x3 m a))
  (values b0 b1 b2 b3 x0 x1 x2 x3 ls e0 e1 e2 e3 k0 k1 k2 k3))

; One bit of red4's ((w lsr 4) lxor 15) land w at the leaf.
(def-fns _ $ (erased r4g-upd-bit : (erased (Nat) fu ftr zl m d) (erased (Bool) u a y) (erased (Bit) xu xa) (erased (BitPart u a y) q) (erased (BoolBit u xu) eu)
    (erased (BoolBit a xa) ea) (erased (BitIs fu d xu) iu) (erased (BitIs ftr d xa) ia) (erased (Bitwise xor-op ftr 15 zl) ox) (erased (Bitwise and-op fu zl m) oa)
    (erased (Lt d 4) dl) -> (erased (Bit) c) (erased (BoolBit y c) e) (erased (BitIs m d c) i))
  (let ((erased c1) (erased p1)) (bit-apply xor-op xa (Bit1)))
  (let ((erased c) (erased p2)) (bit-apply and-op xu c1))
  (values c (r4g-bp-bit u a y xu xa c1 c q eu ea p1 p2)
    (r4c-bw-bitis and-op fu zl m d xu c1 c oa iu (r4c-bw-bitis xor-op ftr 15 zl d xa (Bit1) c1 ox ia (r4g-ones-bit 4 15 d r4-o15 dl) p1) p2)))

; red4's ((w lsr 4) lxor 15) land w land 15 at a leaf, its parts u of gu and a of gtr, a within u: the leaf of u less a.
(def-fns _ $ (erased r4g-upd-lf : (erased (Nat) w b cm ftr fu t1 v mm r t2 t3 m) (erased (NWd w b cm ftr fu) d) (erased (Pow2 4 v) pv) (erased (Mul t1 v mm) mx) (erased (Add mm r w) ad)
    (erased (Lt r v) rl) (erased (Bitwise xor-op t1 15 t2) ox) (erased (Bitwise and-op w t2 t3) oa) (erased (Bitwise and-op t3 15 m) om) (erased (Gtree) u a)
    (erased (LeafM u fu) lu) (erased (LeafM a ftr) la) (erased (GSub u a) gs) -> (erased (Gtree) bt) (erased (LeafM bt m) lb) (erased (GPart (GSG u) (GSG a) (GSG bt)) p)
    (erased (Lt m 16) ml))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4g-e16 (Refl _ _))
  (let-match erased d (MkNWd _ _ _ _ _ wy1 wy2 p1 p2 p3))
  (let-match erased (pow2-fn 4 v 16 pv r4-p16) (Refl _ _))
  (let ((erased e1) (erased e2)) (bsp-fn 4 w fu wy1 r t1 p1 (bsp-of 4 16 t1 mm r w r4-p16 mx ad rl)))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased zl) (erased zh) (erased pz) (erased bl) (erased _))
    (r4g-bw-bsp xor-op 4 t1 15 t2 ftr wy2 15 (Zero) p2 (bsp-of 4 16 (Zero) (Zero) 15 15 r4-p16 (MulZero 16) (AddZero 15) (lt-succ 15)) ox))
  (let ((erased zl2) (erased zh2) (erased pz2) (erased ca) (erased _)) (r4g-bw-bsp and-op 4 w t2 t3 fu wy1 zl zh p1 pz oa))
  (let-match erased (bitwise-fn and-op t3 15 m zl2 om (and-low 4 t3 zl2 zh2 15 pz2 r4-o15)) (Refl _ _))
  (let ((erased u0) (erased u1) (erased u2) (erased u3) (erased xu0) (erased xu1) (erased xu2) (erased xu3) (erased lsu) (erased eu0) (erased eu1) (erased eu2) (erased eu3)
        (erased iu0) (erased iu1) (erased iu2) (erased iu3)) (r4g-lm-bits u fu lu))
  (let ((erased a0) (erased a1) (erased a2) (erased a3) (erased y0) (erased y1) (erased y2) (erased y3) (erased lsa) (erased q0) (erased q1) (erased q2) (erased q3))
    (r4g-gsub-lf u a u0 u1 u2 u3 gs lsu))
  (let ((erased c0) (erased c1) (erased c2) (erased c3) (erased xa0) (erased xa1) (erased xa2) (erased xa3) (erased lsa2) (erased ea0) (erased ea1) (erased ea2) (erased ea3)
        (erased ia0) (erased ia1) (erased ia2) (erased ia3)) (r4g-lm-bits a ftr la))
  (let-match erased (leafset-fn a _ _ lsa2 lsa) (Refl _ _))
  (let ((erased z) (erased o)) (values (Zero) (Succ (Zero))))
  (let ((erased l3)) (LtS (Succ (Succ z)) (Succ (Succ (Succ z))) (LtS (Succ z) (Succ (Succ z)) (LtS z (Succ z) (LtZ z)))))
  (let ((erased l2)) (lt-succ-left _ _ l3))
  (let ((erased l1)) (lt-succ-left _ _ l2))
  (let ((erased k0) (erased f0) (erased j0)) (r4g-upd-bit fu ftr zl zl2 z u0 a0 y0 xu0 xa0 q0 eu0 ea0 iu0 ia0 bl ca (lt-succ-left _ _ l1)))
  (let ((erased k1) (erased f1) (erased j1)) (r4g-upd-bit fu ftr zl zl2 o u1 a1 y1 xu1 xa1 q1 eu1 ea1 iu1 ia1 bl ca l1))
  (let ((erased k2) (erased f2) (erased j2)) (r4g-upd-bit fu ftr zl zl2 _ u2 a2 y2 xu2 xa2 q2 eu2 ea2 iu2 ia2 bl ca l2))
  (let ((erased k3) (erased f3) (erased j3)) (r4g-upd-bit fu ftr zl zl2 _ u3 a3 y3 xu3 xa3 q3 eu3 ea3 iu3 ia3 bl ca l3))
  (let ((erased ml)) (bsp-lt 4 t3 zl2 zh2 16 pz2 r4-p16))
  (let ((erased bt) (erased lsb)) (leaf-sub u u0 u1 u2 u3 y0 y1 y2 y3 a0 a1 a2 a3 lsu (bp-sym _ _ _ q0) (bp-sym _ _ _ q1) (bp-sym _ _ _ q2) (bp-sym _ _ _ q3)))
  (values bt (r4g-leafm-of bt y0 y1 y2 y3 k0 k1 k2 k3 zl2 lsb f0 f1 f2 f3 j0 j1 j2 j3 ml)
    (leaf-part u a bt u0 u1 u2 u3 a0 a1 a2 a3 y0 y1 y2 y3 lsu lsa lsb q0 q1 q2 q3) ml))

; Two words of node g, laid out, have the same fields.
(def-fns _ $ (erased r4g-wd-eq : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b cm ftr fu w2 b2 cm2 ftr2 fu2) (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d)
    (erased (WElt xs g w2) x2) (erased (NWd w2 b2 cm2 ftr2 fu2) d2) -> (erased (Eq (Nat) ftr ftr2) ef) (erased (Eq (Nat) b b2) eb) (erased (Eq (Nat) cm cm2) ec) (erased (Eq (Nat) fu fu2) eu))
  (let-match erased (welt-fn xs g w w2 x x2) (Refl _ _))
  (let ((erased ef) (erased eb) (erased ec)) (nwd-fn w b cm ftr fu b2 cm2 ftr2 fu2 d d2))
  (values ef eb ec (r4g-nwd-fu w b cm ftr fu b2 cm2 ftr2 fu2 d d2)))

(def-fns _ $ (erased r4g-fld-fn : (erased (Bool) sel) (erased (Nat) ftr fu f f2) (erased (Fld sel ftr fu f) p) (erased (Fld sel ftr fu f2) q) -> (erased (Eq (Nat) f f2) e))
  (match erased p _ ((FdU _ _) (let-match erased q (FdU _ _)) (Refl _ f)) ((FdT _ _) (let-match erased q (FdT _ _)) (Refl _ f))))

(def-fns _ $ (erased r4g-lm-zero : (erased (Nat) f) (erased (LeafM (GEmpty) f) lm) -> (erased (Eq (Nat) f (Zero)) e))
  (let-match erased lm (MkLeafM _ _ _ _ _ _ x0 x1 x2 x3 ls e0 e1 e2 e3 a))
  (let-match erased ls (LSE))
  (let-match erased e0 (BBF))
  (let-match erased e1 (BBF))
  (let-match erased e2 (BBF))
  (let-match erased e3 (BBF))
  (let-match erased a (AcS _ _ m3 _ _ _ a3 bv3 p3))
  (let-match erased a3 (AcS _ _ m2 _ _ _ a2 bv2 p2))
  (let-match erased a2 (AcS _ _ m1 _ _ _ a1 bv1 p1))
  (let-match erased a1 (AcS _ _ m0 _ _ _ a0 bv0 p0))
  (let-match erased bv3 (BV0))
  (let-match erased bv2 (BV0))
  (let-match erased bv1 (BV0))
  (let-match erased bv0 (BV0))
  (let-match erased a0 (AcZ))
  (let-match erased (bsp-zero-hi _ f m3 p3) (Refl _ _))
  (let-match erased (bsp-zero-hi _ m3 m2 p2) (Refl _ _))
  (let-match erased (bsp-zero-hi _ m2 m1 p1) (Refl _ _))
  (bsp-zero-hi _ m1 m0 p0))

(def-fns _ $ (erased r4g-lm-pres : (erased (Gtree) t) (erased (Nat) f) (erased (LeafM t f) lm) (erased (Apart (Nat) Lt f (Zero)) ap) -> (erased (GPres t (BTrue)) r))
  (let-match erased lm (MkLeafM _ _ _ _ _ _ _ _ _ _ ls _ _ _ _ _))
  (match erased ls _
    ((LS0) (GP0)) ((LS1) (GP1)) ((LS2) (GP2)) ((LS3) (GP3)) ((LS01) (GP01)) ((LS12) (GP12)) ((LS13) (GP13)) ((LS23) (GP23))
    (absurd (LSE) (let-match erased (r4g-lm-zero f lm) (Refl _ _)) (apart-irrefl (Zero) ap))))

; The tree NPart reads at node g is empty when the part is 0, and present otherwise.
(def-fns _ $ (erased r4g-np-zero : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) s0 t) (erased (Bool) sel) (erased (NPart xs j g s0 sel t) np)
    (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu (Zero)) fd) -> (erased (GPres t (BFalse)) r))
  (match erased np _
    ((NpE _ _ _ _ _ _ _ _ _ _ _ _ _) (GpE))
    ((NpL _ _ wa ba ma fa ua va _ _ _ xa da fa1 lm)
      (let ((erased ef) (erased _) (erased _) (erased eu)) (r4g-wd-eq xs g wa ba ma fa ua w b cm ftr fu xa da x d))
      (let-match erased ef (Refl _ _))
      (let-match erased eu (Refl _ _))
      (let-match erased (r4g-fld-fn sel ftr fu va (Zero) fa1 fd) (Refl _ _))
      (let-match erased (leafm0 t lm) (Refl _ _))
      (GpE))
    (absurd (NpN _ _ _ wa ba ma fa ua _ _ _ _ _ _ _ _ _ xa da fa1 _ _ _ _)
      (let ((erased ef) (erased _) (erased _) (erased eu)) (r4g-wd-eq xs g wa ba ma fa ua w b cm ftr fu xa da x d))
      (let-match erased ef (Refl _ _))
      (let-match erased eu (Refl _ _))
      (r4g-fld-fn sel ftr fu (Succ (Zero)) (Zero) fa1 fd))))

(def-fns _ $ (erased r4g-np-pres : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu f) (erased (Gtree) s0 t) (erased (Bool) sel) (erased (NPart xs j g s0 sel t) np)
    (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu f) fd) (erased (Apart (Nat) Lt f (Zero)) ap) -> (erased (GPres t (BTrue)) r))
  (match erased np _
    (absurd (NpE _ _ _ wa ba ma fa ua _ _ xa da fa1)
      (let ((erased ef) (erased _) (erased _) (erased eu)) (r4g-wd-eq xs g wa ba ma fa ua w b cm ftr fu xa da x d))
      (let-match erased ef (Refl _ _))
      (let-match erased eu (Refl _ _))
      (let-match erased (r4g-fld-fn sel ftr fu (Zero) f fa1 fd) (Refl _ _))
      (apart-irrefl (Zero) ap))
    ((NpL _ _ wa ba ma fa ua va _ _ _ xa da fa1 lm)
      (let ((erased ef) (erased _) (erased _) (erased eu)) (r4g-wd-eq xs g wa ba ma fa ua w b cm ftr fu xa da x d))
      (let-match erased ef (Refl _ _))
      (let-match erased eu (Refl _ _))
      (let-match erased (r4g-fld-fn sel ftr fu va f fa1 fd) (Refl _ _))
      (r4g-lm-pres t f lm ap))
    ((NpN _ _ _ _ _ _ _ _ c0 c1 c2 c3 t0 t1 t2 t3 _ _ _ _ _ _ _ _) (GpN t0 t1 t2 t3))))

; The kids, from the symbol s on, of a node of child mask cm with children from b: the trees ts of s0, with tf in gu and tt in gtr, each below bn,
; the nodes below each in a cell, the cells taking lo to hi in turn.
(def-adts $ (KdL : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Nat) bn) ((Nat) s) ((Nat) lo) ((Nat) hi) ((Bool) z) ((List (Gtree)) ts) ((List (Gtree)) tf)
    ((List (Gtree)) tt) -> Type)
  enum
  (many KdNil : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm bn hi) (erased (Bool) z) -> (KdL xs j b cm bn 4 hi hi z (Nil (Gtree)) (Nil (Gtree)) (Nil (Gtree))))
  (many KdCons : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm bn s lo hc hi) (erased (Bool) z) (erased (Gtree) c f t) (erased (List (Gtree)) ts tf tt)
      (erased (NIvK xs j b cm s c bn lo hc z) iv) (erased (NPartK xs j b cm s c (BFalse) f) pf) (erased (NPartK xs j b cm s c (BTrue) t) pt)
      (erased (KdL xs j b cm bn (Succ s) hc hi z ts tf tt) r) -> (KdL xs j b cm bn s lo hi z (Cons (Gtree) c ts) (Cons (Gtree) f tf) (Cons (Gtree) t tt))))

(def-fns _ $ (erased r4g-kd-le : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm bn s lo hi) (erased (Bool) z) (erased (List (Gtree)) ts tf tt)
    (subterm erased (KdL xs j b cm bn s lo hi z ts tf tt) k) -> (erased (Lt lo (Succ hi)) r))
  (let-match erased k (KdCons _ _ _ _ _ _ _ hc _ _ c _ _ ts1 tf1 tt1 iv _ _ k1) ((KdNil _ _ _ _ _ _ _) (lt-succ hi)))
  (le-trans lo hc hi (r4g-nivk-le xs j b cm s bn lo hc c z iv) (r4g-kd-le xs j b cm bn (Succ s) hc hi z ts1 tf1 tt1 k1)))

; Writes at an earlier kid's nodes keep the kids from s on.
(def-fns _ $ (erased r4g-kd-away : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b cm bn s lo hi) (erased (Bool) z) (erased (List (Gtree)) ts tf tt)
    (subterm erased (KdL xs j b cm bn s lo hi z ts tf tt) k) (erased (Nat) g2 lo2 hi2 s2 v2) (erased (BitIs cm s2 (Bit1)) bi) (erased (Rk s2 cm v2) rk) (erased (Add b v2 g2) a)
    (erased (Lt s2 s) l) (erased (Lt g2 bn) gn) (erased (Lt bn (Succ lo)) bl) (erased (Lt bn (Succ lo2)) bl2) (erased (Lt hi2 (Succ lo)) hl) (erased (NIn xs ys (RgOne g2 lo2 hi2)) w)
    -> (erased (KdL ys j b cm bn s lo hi z ts tf tt) r))
  (let-match erased k (KdCons _ _ _ _ _ _ _ hc _ _ c f t ts1 tf1 tt1 iv pf pt k1) ((KdNil _ _ _ _ _ _ _) (KdNil ys j b cm bn hi z)))
  (let ((erased ko)) (KoA g2 lo2 hi2 b cm s bn lo hc s2 v2 bi rk a l gn bl bl2 hl))
  (let ((erased iv2) (erased pf2)) (r4g-nin-kid xs ys j b cm s bn lo hc c f (BFalse) z (RgOne g2 lo2 hi2) iv pf w ko))
  (let ((erased _) (erased pt2)) (r4g-nin-kid xs ys j b cm s bn lo hc c t (BTrue) z (RgOne g2 lo2 hi2) iv pt w ko))
  (let ((erased lh)) (r4g-nivk-le xs j b cm s bn lo hc c z iv))
  (KdCons ys j b cm bn s lo hc hi z c f t ts1 tf1 tt1 iv2 pf2 pt2
    (r4g-kd-away xs ys j b cm bn (Succ s) hc hi z ts1 tf1 tt1 k1 g2 lo2 hi2 s2 v2 bi rk a (lt-weaken s2 s l) gn (le-trans bn lo hc bl lh) bl2 (le-trans hi2 lo hc hl lh) w)))

; A write at i, outside [b, hp), keeps the kids from s on.
