    (let ((many w2) (erased po)) (u62-or a m (lt-le-trans a (Succ wv) u62-modulus (and-le wv r4g-k15 a pa) (LtS wv u62-modulus wb)) (lt-trans m 16 u62-modulus ml r4-16-u62)))
