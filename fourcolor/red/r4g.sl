    (r4g-npk-set xs ys j b cm s bn lo hc hp i c f (BFalse) z y iv pf st o cl) (r4g-npk-set xs ys j b cm s bn lo hc hp i c t (BTrue) z y iv pt st o cl)
    (r4g-kd-set xs ys j b cm bn (Succ s) hc hi i hp z ts1 tf1 tt1 y k1 st o bb (le-trans bn lo hc bl lh) hh)))

; Each tree of as lies in that of us.
(def-adts $ (SubL : ((List (Gtree)) us) ((List (Gtree)) as) -> Type)
  enum
  (many SuNil : -> (SubL (Nil (Gtree)) (Nil (Gtree))))
  (many SuCons : (erased (Gtree) u a) (erased (List (Gtree)) us as) (erased (GSub u a) p) (erased (SubL us as) r) -> (SubL (Cons (Gtree) u us) (Cons (Gtree) a as))))

; Each tree of us is split into those of as and bs.
(def-adts $ (PartL : ((List (Gtree)) us) ((List (Gtree)) as) ((List (Gtree)) bs) -> Type)
  enum
  (many PtlNil : -> (PartL (Nil (Gtree)) (Nil (Gtree)) (Nil (Gtree))))
  (many PtlCons : (erased (Gtree) u a b) (erased (List (Gtree)) us as bs) (erased (GPart (GSG u) (GSG a) (GSG b)) p) (erased (PartL us as bs) r)
      -> (PartL (Cons (Gtree) u us) (Cons (Gtree) a as) (Cons (Gtree) b bs))))

; r is not 0, or it and a are 0 and every tree of bs is empty.
(def-adts $ (Zs : ((Nat) r) ((Nat) a) ((List (Gtree)) bs) -> Type)
