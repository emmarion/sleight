  (many UpwN : (erased (List (Copy (Nat))) ys) (erased (Nat) j g hi m b cm bn w fu) (erased (Gtree) c0 c1 c2 c3 u0 u1 u2 u3 a0 a1 a2 a3) (erased (List (Gtree)) bs)
      (erased (WElt ys g w) x) (erased (NWd w b cm (Succ (Zero)) fu) d) (erased (Lt g b) gb) (erased (Lt b (Succ bn)) bl) (erased (Lt m 2) ml)
