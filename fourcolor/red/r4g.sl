  (let-match erased l1 (SuCons _ _ _ _ g1 l2))
  (let-match erased l2 (SuCons _ _ _ _ g2 l3))
  (let-match erased l3 (SuCons _ _ _ _ g3 _))
  (GsbN u0 u1 u2 u3 a0 a1 a2 a3 g0 g1 g2 g3))

; A node of gu left unmarked, nothing of gtr below it.
(def-fns _ $ (erased r4g-gw-no : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0 u) (erased (NIv xs j g s0 lo hi (BTrue)) iv) ->
    (erased (NIn xs xs (RgOne g lo hi)) wn) (erased (NIv xs j g s0 lo hi (BFalse)) iv2) (erased (NPart xs j g s0 (BTrue) (GEmpty)) pa) (erased (GSub u (GEmpty)) gs)
    (erased (GPres (GEmpty) (BFalse)) gp))
  (values (NinNil xs _) (r4g-niv-f xs j g lo hi s0 (BTrue) iv) (r4g-niv-e xs j g lo hi s0 iv) (GsbE u) (GpE)))

; A leaf marked with the symbols rv, within its symbols in gu, its part of gtr having been 0.
(def-fns _ $ (erased r4g-gw-mk : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g lo w w2 b cm ftr fu ftr2 rv) (erased (Gtree) s0 u) (erased (NIv xs (Zero) g s0 lo lo (BTrue)) iv)
    (erased (NPart xs (Zero) g s0 (BFalse) u) pu) (erased (RIn rv fu) ri) (erased (SetNth (Copy (Nat)) xs g (MkCopy (Nat) w2) ys) st) (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d)
    (erased (NWd w2 b cm ftr2 fu) d2) (erased (Bitwise or-op ftr rv ftr2) o) (erased (Apart (Nat) Lt rv (Zero)) ap)
    (erased (List RC) rr) (erased (LHit rv rr) lh) ->
    (erased (Gtree) a) (erased (NIn xs ys (RgOne g lo lo)) wn) (erased (NIv ys (Zero) g s0 lo lo (BFalse)) iv2) (erased (NPart ys (Zero) g s0 (BFalse) u) pu2)
    (erased (NPart ys (Zero) g s0 (BTrue) a) pa) (erased (GSub u a) gs) (erased (GPres a (BTrue)) gp) (erased (GHit (GSG a) rr) gh))
