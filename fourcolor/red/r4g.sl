    (let ((many wv) (unique nd1)) (array-get _ _ nd g w0 nth0))
    (let ((erased wb)) (allcu-lt xs g w0 au nth0))
    (let ((erased ys1) (unique nd2) (erased lx2) (erased au2) (erased nk) (erased hl1) (many m) (erased ml) (erased wy) (erased fy) (erased uy) (erased xy) (erased dy))
      (match many (u62-eq k h (le-u62 k h kh hb17) hb17) (((List (Copy (Nat))) ys1) ((Array (Copy (Nat)) ys1) nd2 at nd) ((Length (Copy (Nat)) ys1 len) lx2) ((AllCu ys1) au2)
                                                       ((NKeep AnyFld xs ys1) nk) ((HAll ys1 (Zero) Hs) hl1) ((Nat) m) ((Lt m 16) ml) ((Nat) wy) ((Nat) fy) ((Nat) uy)
                                                       ((WElt ys1 g wy) xy) ((NWd wy b0 cm0 fy uy) dy))
        ((Equal _ _ _)
