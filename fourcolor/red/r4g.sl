    (let ((erased kh)) (add-le-left k j h akj))
    (let ((erased w0) (erased b0) (erased cm0) (erased f0) (erased u0) (erased x0) (erased d0))
      (match erased ly (((Nat) w0) ((Nat) b0) ((Nat) cm0) ((Nat) f0) ((Nat) u0) ((WElt xs g w0) x0) ((NWd w0 b0 cm0 f0 u0) d0))
        ((NlL _ _ wa ba ma fa ua _ xa da _) (values wa ba ma fa ua xa da))
        ((NlN _ _ _ wa ba ma fa ua _ _ _ _ xa da _ _ _ _ _) (values wa ba ma fa ua xa da))))
