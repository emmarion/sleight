  (let ((erased ftr) (erased y2) (erased p2)) (bsp-c 4 y1))
  (let ((erased cm) (erased b) (erased p3)) (bsp-c 4 y2))
  (values b cm ftr fu (MkNWd w b cm ftr fu y1 y2 p1 p2 p3)))

; The loop of red4's g_round over the hits buffer, from entry i on: each node's gtr part cleared.
(def-fns _ $ (many r4-gclr-go : (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) nd) (erased (Nat) len) (erased (Length (Copy (Nat)) xs len) lx) (erased (AllCu xs) au)
    (erased (List (Copy (Nat))) hx) (unique (Array (Copy (Nat)) hx) ha) (erased (Nat) cap) (erased (Length (Copy (Nat)) hx cap) lh) (erased (List (Nat)) Hs)
    (many (Nat) i n) (erased (Tbk hx n Hs) tb) (erased (AllLt Hs len) al) (erased (Lt n u62-modulus) nb) (erased (Lt n (Succ cap)) nc) (subterm erased (Nat) k) (erased (Add i k n) ad)
    (erased (List (Nat)) R) (erased (Fwd hx i n R) fw) (erased (HAll xs (Zero) R) hl) ->
    (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) nd2 at nd) (erased (Length (Copy (Nat)) ys len) lx2) (erased (AllCu ys) au2) (erased (NKeep KeepU xs ys) nk)
    (unique (Array (Copy (Nat)) hx) ha2 at ha) (erased (HAll ys (Zero) (Nil (Nat))) hl2))
  (let ((erased ib)) (lt-le-trans i (Succ n) u62-modulus (add-le-left i k n ad) (LtS n u62-modulus nb)))
  (let-match many (u62-lt-dec i n ib nb) (Yes _ _ _ _ il)
    ((No _ _ _ _ le)
      (let-match erased k (Zero) (absurd (Succ k0) (lt-irrefl i (lt-le-trans i n i (add-pos-lt i k n ad (LtZ k0)) (le-lt-succ n i le)))))
      (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _))
      (let-match erased fw (FwE _ _) (absurd (FwC _ _ _ _ _ _ f1) (lt-irrefl (Succ i) (r4c-fwd-le hx (Succ i) i _ f1))))
      (values xs nd lx au (NkNil KeepU xs) ha hl)))
  (let-match erased k (Succ k1) (absurd (Zero) (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _)) (lt-irrefl i il)))
  (let ((erased cv) (erased nth)) (nth-exists _ hx cap i lh (lt-le-trans i n cap il nc)))
  (let-match erased cv (MkCopy _ g0))
  (let ((many g) (unique ha1)) (array-get _ _ ha i g0 nth))
  (let-match erased fw (FwC _ _ _ x R1 wx fw1) (absurd (FwE _ _) (lt-irrefl i il)))
  (let-match erased (welt-fn hx i x g wx (MkWElt hx i g nth)) (Refl _ _))
  (let ((erased gl)) (r4c-alllt-in g len Hs al (r4c-tbk-at hx n i g Hs tb (MkWElt hx i g nth) il)))
  (let ((erased wc) (erased nw)) (nth-exists _ xs len g lx gl))
  (let-match erased wc (MkCopy _ w0))
  (let ((many w) (unique nd1)) (array-get _ _ nd g w0 nw))
  (let ((erased wb)) (allcu-lt xs g w au nw))
  (let ((many w2) (erased pa)) (u62-and w r4g-k240 wb r4g-k240-u62))
  (let ((erased b) (erased cm) (erased ftr) (erased fu) (erased d)) (r4g-nwd-ex w))
  (let ((erased d2) (erased w2b)) (r4g-clr-tr w b cm ftr fu w2 wb d pa))
  (let ((erased xs1) (unique nd2) (erased s)) (array-place-imm _ _ nd1 g (MkCopy _ w2) (MkCopy _ w) nw (allcu-nth xs g (MkCopy _ w) au nw) (imm-cu w2 w2b)))
  (let ((erased ys) (unique nd3) (erased lx3) (erased au3) (erased nk) (unique ha2) (erased hl2))
    (tail $ r4-gclr-go xs1 nd2 len (setnth-length _ xs g len _ xs1 s lx) (allcu-set xs xs1 g w2 w2b au s) hx ha1 cap lh Hs
      (u62-inc i (lt-le-trans (Succ i) (Succ n) u62-modulus (LtS i n il) (LtS n u62-modulus nb))) n tb al nb nc k1 (add-sh i k1 n ad) R1 fw1
      (r4g-hall-clr xs xs1 (Zero) g g w2 b cm fu R1 hl s (AddZero g) d2)))
  (values ys nd3 lx3 au3 (NkCons KeepU xs xs1 ys g w w2 b cm ftr fu (Zero) fu s (MkWElt xs g w nw) d d2 (MkKeepU ftr fu (Zero)) nk) ha2 hl2))

; Node g's word after a write at i that keeps the first child, child mask and gu part.
(def-fns _ $ (erased r4g-npu-word : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g i w w2 b cm f u f2 w1 b1 cm1 f1 u1) (erased (SetNth (Copy (Nat)) xs i (MkCopy (Nat) w2) ys) st)
    (erased (WElt xs i w) x) (erased (NWd w b cm f u) d) (erased (NWd w2 b cm f2 u) d2) (erased (WElt xs g w1) x1) (erased (NWd w1 b1 cm1 f1 u1) d1)
    -> (erased (Nat) w3 f3) (erased (WElt ys g w3) x3) (erased (NWd w3 b1 cm1 f3 u1) d3))
  (let-match erased (nat-eq g i) (Equal _ _ _) ((Unequal _ _ _ _ ap) (values w1 f1 (welt-set xs ys g w1 i _ x1 st (r4c-apart-sym g i ap)) d1)))
  (let-match erased (welt-fn xs g w1 w x1 x) (Refl _ _))
  (let ((erased _) (erased eb) (erased ec)) (nwd-fn w1 b1 cm1 f1 u1 b cm f u d1 d))
  (let-match erased eb (Refl _ _))
  (let-match erased ec (Refl _ _))
