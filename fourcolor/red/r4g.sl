(def-fns _ $ (erased r4g-niv-e : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (erased (NIv xs j g s0 lo hi (BTrue)) iv) -> (erased (NPart xs j g s0 (BTrue) (GEmpty)) r))
