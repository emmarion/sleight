      (r4g-hall-set ys1 ys2 (Zero) g g w2 b0 cm0 f0 m Hs hl1 s (AddZero g) d2 (r4g-hall-get xs (Zero) g g w0 b0 cm0 f0 u0 Hs hl nth0 (AddZero g) d0))
      (match many (u62-eq m 0 (lt-trans m 16 u62-modulus ml r4-16-u62) u62-modulus-pos) (((Bool) q)) ((Equal _ _ _) (BFalse)) ((Unequal _ _ _ _ _) (BTrue)))))
  ; red4's loop over the symbols of upd, from s on; any is 1 when a child so far stays in gu.
  ((many r4-upd-s : (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) nd) (many (Nat) h k s w) (erased (Lt (Succ h) 17) hk) (erased (Nat) len)
