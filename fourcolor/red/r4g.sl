  (let-match erased mi (Succ m1) (absurd (Zero) (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _)) (lt-irrefl i il)))
  (let ((unique lp1) (many pv)) (r4-rget rp lp k i xs ra xp p0 np))
  (let ((erased q0) (erased tq)) (thrice-exists p0))
  (let ((erased qw)) (thrice-lt p0 W q0 W2 pl tq tw))
  (let ((erased q3b)) (lt-le-trans (Succ (Succ (Succ q0))) (Succ W2) u62-modulus (LtS _ _ qw) (LtS W2 u62-modulus W2b)))
  (let ((erased q0b)) (lt-succ-left q0 u62-modulus (lt-succ-left (Succ q0) u62-modulus (lt-succ-left (Succ (Succ q0)) u62-modulus q3b))))
  (let ((many qv)) (r4-x3 pv q0 tq (lt-le-trans p0 (Succ q0) u62-modulus (thrice-le p0 q0 tq) (LtS q0 u62-modulus q0b)) q0b))
  (let ((unique lb1) (many bv)) (r4-rget rb lb k i ys rb0 xb b0 nb2))
  (let ((erased bb)) (bnb-lt (Succ jb) b0 bk))
  (let ((many pc) (erased xtp)) (r4-extp qv bv s p0 bs g tq bn bb sn q3b))
  (let ((many bc) (erased xtb) (erased bkc)) (r4-extb bv s jb bs g bn bk sn))
  (let ((erased nl1)) (lt-succ r4-none))
  (let ((erased pcl))
    (match erased xtp (((Lt pc (Succ r4-none)) z))
      ((XpPush _ _ _ _ l1) (lt-weaken _ _ l1)) ((XpSkip _ _ _ _ l1) (lt-weaken _ _ l1)) ((XpPop _ _ _ _ _ _ _ _ _ l1) (lt-weaken _ _ l1)) ((XpNone _ _ _) (lt-succ r4-none))))
  (let ((erased pcb)) (lt-le-trans pc (Succ r4-none) u62-modulus pcl (LtS _ _ nl1)))
  (let ((unique ca1) (many r1) (erased rl1))
    (match many (u62-lt-dec pc r4-none pcb nl1) (((Bytes cs) ca1 at ca) ((Nat) r1) ((Lt r1 16) rl1))
      ((No _ _ _ _ _) (values ca r rl))
