; len is m 3^j.
(def-adts $ (Pw3 : ((Nat) j) ((Nat) m) ((Nat) len) -> Type)
  enum
  (many PwZ : (erased (Nat) m) -> (Pw3 (Zero) m m))
  (many PwS : (erased (Nat) j m q len) (erased (Thrice m q) tq) (erased (Pw3 j q len) w) -> (Pw3 (Succ j) m len)))

(def-fns _ $ (many pw3-c : (subterm many (Nat) j) (many (Nat) m) -> (many (Nat) len) (erased (Pw3 j m len) w))
  (let-match many j (Succ j1) ((Zero) (values m (PwZ m))))
  (let ((many d) (erased ad)) (add m m))
  (let ((many q) (erased aq)) (add d m))
  (let ((many len) (erased w)) (tail $ pw3-c j1 q))
  (values len (PwS j1 m q len (adds-thrice m d q ad aq) w)))

(def-fns _ $ (erased pw3-le : (erased (Nat) j m len) (subterm erased (Pw3 j m len) w) -> (erased (Lt m (Succ len)) r))
  (match erased w _
    ((PwZ _) (lt-succ m))
    ((PwS j1 _ q _ tq w1) (lt-le-trans _ _ _ (thrice-le m q tq) (LtS _ _ (pw3-le j1 q len w1))))))

; The colours pre, last first, split ps0 down to ps.
(def-adts $ (SPath : ((List RS) ps0) ((List (Col)) pre) ((List RS) ps) -> Type)
  enum
  (many SPNil : (erased (List RS) ps0) -> (SPath ps0 (Nil (Col)) ps0))
  (many SPCons : (erased (List RS) ps0 ps1 ps) (erased (List (Col)) pre) (erased (Col) e) (erased (SPath ps0 pre ps1) sp)
      (erased (PSplitE e (Nil RS) ps1 ps) sl) -> (SPath ps0 (Cons (Col) e pre) ps)))

(def-fns _ $ (erased spath-cnt : (erased (List RS) ps0 ps) (erased (List (Col)) pre w et) (erased (Nat) n) (subterm erased (SPath ps0 pre ps) sp)
    (erased (RevApp (Col) pre w et) ra) (erased (PCnt ps w n) pc) -> (erased (PCnt ps0 et n) r))
  (match erased sp _
    ((SPNil _) (let-match erased ra (RANil _ _)) pc)
    ((SPCons _ ps1 _ pre1 e sp1 sl)
      (let-match erased ra (RACons _ _ _ _ _ ra1))
      (let ((erased n1) (erased pc1)) (pcnt-exists ps1 (Cons _ e w)))
      (let-match erased (add-fn n1 (Zero) n n1 (psplit-cnt e (Nil RS) ps1 ps w (Zero) n1 n sl (PCNil w) pc pc1) (add-zero-right n1)) (Refl _ _))
      (spath-cnt ps0 ps1 pre1 (Cons _ e w) et n sp1 ra1 pc1))))

(def-fns _ $ (erased mo-le : (erased (Nat) n k m) (subterm erased (Monus n k m) o) -> (erased (Lt m (Succ n)) r))
  (match erased o _
    ((MoZ _) (lt-succ n))
    ((MoE _) (LtZ (Zero)))
    ((MoS n1 k1 _ o1) (lt-weaken _ _ (mo-le n1 k1 m o1)))))

(def-fns _ $ (erased add-lcancel : (erased (Nat) a b c n) (subterm erased (Add a b n) p) (erased (Add a c n) q) -> (erased (Eq (Nat) b c) r))
  (match erased p _
    ((AddZero _) (let-match erased q (AddZero _)) (Refl _ b))
    ((AddSucc a1 _ n1 p1) (let-match erased q (AddSucc _ _ _ q1)) (add-lcancel a1 b c n1 p1 q1))))

(def-fns _ $ (erased kc-pcnt : (erased (Gtree) gtu) (erased (List RS) ps) (erased (List (Col)) pre et) (erased (Nat) a)
    (erased (SPath (Cons RS (MkRx (GSet) (BS0) (GSG gtu)) (Nil RS)) pre ps) sp) (erased (RevApp (Col) pre (Nil (Col)) et) ra)
    (erased (MC (GSG gtu) (BS0) et a) m) -> (erased (PCnt ps (Nil (Col)) a) r))
  (let ((erased x) (erased pc)) (pcnt-exists ps (Nil _)))
  (let-match erased (spath-cnt _ ps pre (Nil _) et x sp ra pc) (PCCons _ _ _ _ a2 _ _ m2 c2 ad))
  (let-match erased c2 (PCNil _))
  (let-match erased (mc-fn (GSG gtu) (BS0) et a2 a m2 m) (Refl _ _))
  (let-match erased (add-fn a (Zero) x a ad (add-zero-right a)) (Refl _ _))
  pc)

(def-adts $ (Lk : ((List RS) ps) ((ES) st) ((Nat) c) -> Type)
  enum
  (many LkOdd : (erased (List RS) ps) -> (Lk ps (ESOdd) (Zero)))
  (many LkEv : (erased (List RS) ps) (erased (ES) st) (erased (Nat) c) (erased (NotOdd st) no) (erased (PCnt ps (Nil (Col)) c) pc) -> (Lk ps st c)))

(def-fns _ $ (erased lk-ge : (erased (List RS) ps) (erased (ES) st) (erased (Nat) c) (erased (Ctree) t) (erased (Lk ps st c) lk) (erased (CtRoot t c) rt)
    (erased (CtH (Zero) t) kt) -> (erased (GE t ps st (Zero)) g) (erased (CEv t st) ce))
  (let-match erased lk (LkOdd _) ((LkEv _ _ _ no pc) (values (GENil t ps st c c rt pc (lt-succ c)) (leaf-cev st no t kt))))
  (let-match erased rt (RootE) (absurd (RootN _ _ _) kt))
  (values (GEOdd t ps (Zero)) (CEvE st)))

; x is hi 2^k + lo, lo below 2^k.
(def-adts $ (Bsp : ((Nat) k) ((Nat) x) ((Nat) lo) ((Nat) hi) -> Type)
  enum
  (many BspZ : (erased (Nat) x) -> (Bsp (Zero) x (Zero) x))
  (many BspS : (erased (Nat) k x x1 lo lo1 hi) (erased (Bit) b) (erased (Bsp k x1 lo1 hi) p) (erased (BitCons x1 b x) cx) (erased (BitCons lo1 b lo) cl)
      -> (Bsp (Succ k) x lo hi)))

; m is 2^k - 1.
(def-adts $ (Ones : ((Nat) k) ((Nat) m) -> Type)
  enum
  (many OnZ : -> (Ones (Zero) (Zero)))
  (many OnS : (erased (Nat) k m mq2) (erased (Ones k m) p) (erased (BitCons m (Bit1) mq2) c) -> (Ones (Succ k) mq2)))

; x written in binary, low bit first.
(def-adts $ (Bits2 : ((Nat) x) -> Type)
  enum
  (many B2Z : -> (Bits2 (Zero)))
  (many B2S : (erased (Nat) x1 x) (erased (Bit) b) (erased (Bits2 x1) p) (erased (BitCons x1 b x) c) (erased (Lt (Zero) x) pos) -> (Bits2 x)))

(def-fns _ $ (erased bits2-of : (subterm erased (Nat) x) -> (erased (Bits2 x) r))
  (let-match erased x (Succ x0) ((Zero) (B2Z)))
  (let ((erased x1) (erased b) (erased c)) (nat-bit x))
  (let ((erased sb)) (lt-subterm x1 x (bitcons-lt x1 b x c (LtZ x0))))
  (B2S x1 x b (bits2-of (subterm sb) x1) c (LtZ x0)))

(def-fns _ $ (erased bc-zero : (erased (Nat) m) (erased (Bit) b) (erased (BitCons m b (Zero)) c) -> (erased (Eq (Nat) m (Zero)) e) (erased (Eq (Bit) b (Bit0)) f))
  (let-match erased c (BC0 _ _ dd))
  (let-match erased dd (D0))
  (values (Refl _ m) (Refl _ b)))

(def-fns _ $ (erased bc-zz : -> (erased (BitCons (Zero) (Bit0) (Zero)) c))
  (BC0 (Zero) (Zero) (D0)))

(def-fns _ $ (erased and-zero : (erased (Nat) x) (subterm erased (Bits2 x) bs) -> (erased (Bitwise and-op x (Zero) (Zero)) p))
  (let-match erased bs (B2S x1 _ b bs1 c _) ((B2Z) (BwZero and-op)))
  (let ((erased ap)) (match erased b (((BitApply and-op b (Bit0) (Bit0)) ap0)) ((Bit0) (Ap00 and-op)) ((Bit1) (Ap10 (Bit0) (Bit0) (Bit1)))))
  (BwBit and-op x1 (Zero) (Zero) b (Bit0) (Bit0) x (Zero) (Zero) (and-zero x1 bs1) ap c (bc-zz) (bc-zz)))

(def-fns _ $ (erased or-zero-r : (erased (Nat) x) (subterm erased (Bits2 x) bs) -> (erased (Bitwise or-op x (Zero) x) p))
  (let-match erased bs (B2S x1 _ b bs1 c _) ((B2Z) (BwZero or-op)))
  (let ((erased ap)) (match erased b (((BitApply or-op b (Bit0) b) ap0)) ((Bit0) (Ap00 or-op)) ((Bit1) (Ap10 (Bit1) (Bit1) (Bit1)))))
  (BwBit or-op x1 (Zero) x1 b (Bit0) b x (Zero) x (or-zero-r x1 bs1) ap c (bc-zz) c))

(def-fns _ $ (erased bitcons-det : (erased (Nat) m n1 n2) (erased (Bit) b) (erased (BitCons m b n1) p) (erased (BitCons m b n2) q) -> (erased (Eq (Nat) n1 n2) e))
  (match erased p _
    ((BC0 _ _ d1) (let-match erased q (BC0 _ _ d2)) (let-match erased (double-fn m n1 n2 d1 d2) (Refl _ _)) (Refl _ n1))
    ((BC1 _ e1 d1) (let-match erased q (BC1 _ e2 d2)) (let-match erased (double-fn m e1 e2 d1 d2) (Refl _ _)) (Refl _ n1))))

(def-fns _ $ (erased bitapply-fn : (erased (BitOp) t) (erased (Bit) x y z1 z2) (erased (BitApply t x y z1) p) (erased (BitApply t x y z2) q) -> (erased (Eq (Bit) z1 z2) e))
  (match erased p _
    ((Ap00 _) (let-match erased q (Ap00 _)) (Refl _ z1))
    ((Ap01 _ _ _) (let-match erased q (Ap01 _ _ _)) (Refl _ z1))
    ((Ap10 _ _ _) (let-match erased q (Ap10 _ _ _)) (Refl _ z1))
    ((Ap11 _ _ _) (let-match erased q (Ap11 _ _ _)) (Refl _ z1))))

(def-fns _ $ (erased bw-zz : (erased (BitOp) t) (erased (Nat) c) (subterm erased (Bitwise t (Zero) (Zero) c) p) -> (erased (Eq (Nat) c (Zero)) e))
  (let-match erased p (BwBit _ a1 b1 c1 x y z _ _ _ p1 ap pa pb pc) ((BwZero _) (Refl _ c)))
  (let ((erased e1) (erased e2)) (bc-zero a1 x pa))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased e3) (erased e4)) (bc-zero b1 y pb))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (let-match erased ap (Ap00 _))
  (let-match erased (bw-zz t c1 p1) (Refl _ _))
  (bitcons-det (Zero) c (Zero) (Bit0) pc (bc-zz)))

(def-fns _ $ (erased bitwise-fn : (erased (BitOp) t) (erased (Nat) a b c1 c2) (subterm erased (Bitwise t a b c1) p) (erased (Bitwise t a b c2) q) -> (erased (Eq (Nat) c1 c2) e))
  (let-match erased p (BwBit _ a1 b1 d1 x y z _ _ _ p1 ap pa pb pc)
    ((BwZero _) (let-match erased (bw-zz t c2 q) (Refl _ _)) (Refl _ c1)))
  (let-match erased q (BwBit _ a2 b2 d2 x2 y2 z2 _ _ _ q1 aq qa qb qc)
    ((BwZero _) (let-match erased (bw-zz t c1 p) (Refl _ _)) (Refl _ c1)))
  (let ((erased e1) (erased e2)) (bitcons-fn a1 x a2 x2 a pa qa))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased e3) (erased e4)) (bitcons-fn b1 y b2 y2 b pb qb))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (let-match erased (bitapply-fn t x y z z2 ap aq) (Refl _ _))
  (let-match erased (bitwise-fn t a1 b1 d1 d2 p1 q1) (Refl _ _))
  (bitcons-det d1 c1 c2 z pc qc))

(def-fns _ $ (erased bsp-fn : (erased (Nat) k x lo hi lo2 hi2) (subterm erased (Bsp k x lo hi) p) (erased (Bsp k x lo2 hi2) q)
    -> (erased (Eq (Nat) lo lo2) e) (erased (Eq (Nat) hi hi2) f))
  (let-match erased p (BspS k1 _ x1 _ l1 _ b p1 cx cl) ((BspZ _) (let-match erased q (BspZ _)) (values (Refl _ lo) (Refl _ hi))))
  (let-match erased q (BspS _ _ x2 _ l2 _ b2 q1 cx2 cl2))
  (let ((erased e1) (erased e2)) (bitcons-fn x1 b x2 b2 x cx cx2))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased e3) (erased e4)) (bsp-fn k1 x1 l1 hi l2 hi2 p1 q1))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (values (bitcons-det l1 lo lo2 b cl cl2) (Refl _ hi)))

(def-fns _ $ (erased bc-new : (erased (Nat) m) (erased (Bit) b) -> (erased (Nat) n) (erased (BitCons m b n) c))
  (let ((erased d) (erased dd)) (double m))
  (match erased b (((Nat) n) ((BitCons m b n) c)) ((Bit0) (values d (BC0 m d dd))) ((Bit1) (values (Succ d) (BC1 m d dd)))))

; lo is lo2 2^a + lo1, the concatenation of two fields.
(def-fns _ $ (erased bsp-cat : (erased (Nat) a b x lo1 y lo2 z) (subterm erased (Bsp a x lo1 y) p) (erased (Bsp b y lo2 z) q)
    -> (erased (Nat) ab lo) (erased (Add a b ab) s) (erased (Bsp ab x lo z) r) (erased (Bsp a lo lo1 lo2) t))
  (let-match erased p (BspS a1 _ x1 _ l1 _ c p1 cx cl) ((BspZ _) (values b lo2 (AddZero b) q (BspZ lo2))))
  (let ((erased ab1) (erased lo3) (erased s1) (erased r1) (erased t1)) (bsp-cat a1 b x1 l1 y lo2 z p1 q))
  (let ((erased lo) (erased cl3)) (bc-new lo3 c))
  (values (Succ ab1) lo (AddSucc a1 b ab1 s1) (BspS ab1 x x1 lo lo3 z c r1 cx cl3) (BspS a1 lo lo3 lo1 l1 lo2 c t1 cl3 cl)))

(def-fns _ $ (erased bsp-split : (erased (Nat) a b ab x lo z) (subterm erased (Add a b ab) s) (erased (Bsp ab x lo z) r)
    -> (erased (Nat) lo1 y lo2) (erased (Bsp a x lo1 y) p) (erased (Bsp b y lo2 z) q) (erased (Bsp a lo lo1 lo2) t))
  (let-match erased s (AddSucc a1 _ ab1 s1) ((AddZero _) (values (Zero) x lo (BspZ x) r (BspZ lo))))
  (let-match erased r (BspS _ _ x1 _ l3 _ c r1 cx cl))
  (let ((erased lo1) (erased y) (erased lo2) (erased p1) (erased q1) (erased t1)) (bsp-split a1 b ab1 x1 l3 z s1 r1))
  (let ((erased lo4) (erased cl4)) (bc-new lo1 c))
  (values lo4 y lo2 (BspS a1 x x1 lo4 lo1 y c p1 cx cl4) q1 (BspS a1 lo l3 lo4 lo1 lo2 c t1 cl cl4)))

(def-fns _ $ (erased bc-le-d : (erased (Nat) m n e) (erased (Bit) b) (erased (BitCons m b n) c) (erased (Double m e) de) -> (erased (Lt e (Succ n)) r))
  (match erased c _
    ((BC0 _ d dd) (let-match erased (double-fn m e d de dd) (Refl _ _)) (lt-succ e))
    ((BC1 _ d dd) (let-match erased (double-fn m e d de dd) (Refl _ _)) (lt-weaken e (Succ e) (lt-succ e)))))

(def-fns _ $ (erased lt-half : (erased (Nat) lo v v1 lo1) (erased (Bit) b) (erased (Lt lo v) l) (erased (Double v1 v) dv) (erased (BitCons lo1 b lo) c)
    -> (erased (Lt lo1 v1) r))
  (let-match erased (lt-dec lo1 v1) (Yes _ _ _ _ r)
    (absurd (No _ _ _ _ le)
      (let ((erased e) (erased de)) (double lo1))
      (lt-irrefl lo (lt-le-trans lo v lo l (le-trans v e lo (le-lt-succ v e (le-double v1 lo1 v e le dv de)) (bc-le-d lo1 lo e b c de))))))
  r)

(def-fns _ $ (erased lt-twice : (erased (Nat) lo v v1 lo1) (erased (Bit) b) (erased (Lt lo1 v1) l) (erased (Double v1 v) dv) (erased (BitCons lo1 b lo) c)
    -> (erased (Lt lo v) r))
  (let-match erased dv (DS w d dd) (absurd (D0) l))
  (match erased c _
    ((BC0 _ e de) (lt-weaken e (Succ d) (double-le-mono lo1 w e d l de dd)))
    ((BC1 _ e de) (LtS e (Succ d) (double-le-mono lo1 w e d l de dd)))))

(def-fns _ $ (erased add-bc : (erased (Nat) m lo x m1 lo1 x1) (erased (Bit) b) (erased (Add m lo x) ad) (erased (Double m1 m) dm) (erased (BitCons lo1 b lo) c)
    (erased (Add m1 lo1 x1) ad1) -> (erased (BitCons x1 b x) r))
  (let ((erased dl) (erased ddl)) (double lo1))
  (let ((erased y) (erased dy)) (double x1))
  (let ((erased a2)) (add-doubles m1 lo1 x1 m dl y ad1 dm ddl dy))
  (match erased c _
    ((BC0 _ d dd) (let-match erased (double-fn lo1 d dl dd ddl) (Refl _ _)) (let-match erased (add-fn m lo x y ad a2) (Refl _ _)) (BC0 x1 y dy))
    ((BC1 _ d dd)
      (let-match erased (double-fn lo1 d dl dd ddl) (Refl _ _))
      (let-match erased (add-fn m lo x (Succ y) ad (add-succ-right m dl y a2)) (Refl _ _))
      (BC1 x1 y dy))))

(def-fns _ $ (erased bsp-arith : (erased (Nat) k x lo hi) (subterm erased (Bsp k x lo hi) p) ->
    (erased (Nat) v m) (erased (Pow2 k v) pv) (erased (Mul hi v m) mm) (erased (Add m lo x) ad) (erased (Lt lo v) l))
  (let-match erased p (BspS k1 _ x1 _ lo1 _ b p1 cx cl)
    ((BspZ _) (values (Succ (Zero)) hi (P0) (mul-one-right hi) (add-zero-right hi) (LtZ (Zero)))))
  (let ((erased v1) (erased m1) (erased pv1) (erased mm1) (erased ad1) (erased l1)) (bsp-arith k1 x1 lo1 hi p1))
  (let ((erased v) (erased dv)) (double v1))
  (let ((erased m) (erased dm)) (double m1))
  (let ((erased dl) (erased ddl)) (double lo1))
  (let ((erased dx) (erased ddx)) (double x1))
  (let ((erased a2)) (add-doubles m1 lo1 x1 m dl dx ad1 dm ddl ddx))
  (let ((erased ad))
    (match erased cl (((Add m lo x) a3))
      ((BC0 _ d dd)
        (let-match erased (double-fn lo1 d dl dd ddl) (Refl _ _))
        (let-match erased cx (BC0 _ e de))
        (let-match erased (double-fn x1 e dx de ddx) (Refl _ _))
        a2)
      ((BC1 _ d dd)
        (let-match erased (double-fn lo1 d dl dd ddl) (Refl _ _))
        (let-match erased cx (BC1 _ e de))
        (let-match erased (double-fn x1 e dx de ddx) (Refl _ _))
        (add-succ-right m dl dx a2))))
  (values v m (PS k1 v1 v pv1 dv) (mul-double-right hi v1 m1 v m mm1 dv dm) ad (lt-twice lo v v1 lo1 b l1 dv cl)))

(def-fns _ $ (erased bsp-of : (erased (Nat) k v hi m lo x) (subterm erased (Pow2 k v) pv) (erased (Mul hi v m) mm) (erased (Add m lo x) ad) (erased (Lt lo v) l)
    -> (erased (Bsp k x lo hi) r))
  (let-match erased pv (PS k1 v1 _ pv1 dv)
    ((P0)
      (let-match erased l (LtZ _) (absurd (LtS _ _ l0) l0))
      (let-match erased (mul-fn hi (Succ (Zero)) m hi mm (mul-one-right hi)) (Refl _ _))
      (let-match erased (add-fn m (Zero) x m ad (add-zero-right m)) (Refl _ _))
      (BspZ x)))
  (let ((erased lo1) (erased b) (erased cl)) (nat-bit lo))
  (let ((erased m1) (erased mm1)) (mul hi v1))
  (let ((erased mq2) (erased dm)) (double m1))
  (let-match erased (mul-fn hi v m mq2 mm (mul-double-right hi v1 m1 v mq2 mm1 dv dm)) (Refl _ _))
  (let ((erased x1) (erased ad1)) (add m1 lo1))
  (BspS k1 x x1 lo lo1 hi b (bsp-of k1 v1 hi m1 lo1 x1 pv1 mm1 ad1 (lt-half lo v v1 lo1 b l dv cl)) (add-bc m lo x m1 lo1 x1 b ad dm cl ad1) cl))

(def-fns _ $ (erased and-low : (erased (Nat) n y f a m) (subterm erased (Bsp n y f a) p) (erased (Ones n m) o) -> (erased (Bitwise and-op y m f) r))
  (let-match erased p (BspS n1 _ y1 _ f1 _ b p1 cy cf) ((BspZ _) (let-match erased o (OnZ)) (and-zero y (bits2-of y))))
  (let-match erased o (OnS _ m1 _ o1 cm))
  (let ((erased ap)) (match erased b (((BitApply and-op b (Bit1) b) ap0)) ((Bit0) (Ap01 (Bit0) (Bit0) (Bit1))) ((Bit1) (Ap11 (Bit0) (Bit0) (Bit1)))))
  (BwBit and-op y1 m1 f1 b (Bit1) b y m f (and-low n1 y1 f1 a m1 p1 o1) ap cy cm cf))

; x has the field f of n bits at bit k, and mk and fk are the mask of n ones and f, both shifted to bit k.
(def-fns _ $ (erased and-mask : (erased (Nat) k n x r y f a m mk fk) (subterm erased (Bsp k x r y) p) (erased (Bsp n y f a) q) (erased (Ones n m) o)
    (erased (Bsp k mk (Zero) m) pm) (erased (Bsp k fk (Zero) f) pf) -> (erased (Bitwise and-op x mk fk) res))
  (let-match erased p (BspS k1 _ x1 _ r1 _ b p1 cx cr)
    ((BspZ _) (let-match erased pm (BspZ _)) (let-match erased pf (BspZ _)) (and-low n y f a m q o)))
  (let-match erased pm (BspS _ _ m1 _ z1 _ bm pm1 cm cz))
  (let ((erased e1) (erased e2)) (bc-zero z1 bm cz))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased pf (BspS _ _ f1 _ z2 _ bf pf1 cf cz2))
  (let ((erased e3) (erased e4)) (bc-zero z2 bf cz2))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (let ((erased ap)) (match erased b (((BitApply and-op b (Bit0) (Bit0)) ap0)) ((Bit0) (Ap00 and-op)) ((Bit1) (Ap10 (Bit0) (Bit0) (Bit1)))))
  (BwBit and-op x1 m1 f1 b (Bit0) (Bit0) x mk fk (and-mask k1 n x1 r1 y f a m m1 f1 p1 q o pm1 pf1) ap cx cm cf))

; x is a 2^k + f, and ak is a 2^k.
(def-fns _ $ (erased or-split : (erased (Nat) k x f a ak) (subterm erased (Bsp k x f a) p) (erased (Bsp k ak (Zero) a) q) -> (erased (Bitwise or-op ak f x) r))
  (let-match erased p (BspS k1 _ x1 _ f1 _ b p1 cx cf) ((BspZ _) (let-match erased q (BspZ _)) (or-zero-r x (bits2-of x))))
  (let-match erased q (BspS _ _ a1 _ z1 _ bq q1 ca cz))
  (let ((erased e1) (erased e2)) (bc-zero z1 bq cz))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased ap)) (match erased b (((BitApply or-op (Bit0) b b) ap0)) ((Bit0) (Ap00 or-op)) ((Bit1) (Ap01 (Bit1) (Bit1) (Bit1)))))
  (BwBit or-op a1 f1 x1 (Bit0) b b ak f x (or-split k1 x1 f1 a a1 p1 q1) ap ca cf cx))

(def-fns _ $ (erased bsp-lo0 : (subterm erased (Nat) k) (erased (Nat) a) -> (erased (Nat) ak) (erased (Bsp k ak (Zero) a) p))
  (let-match erased k (Succ k1) ((Zero) (values a (BspZ a))))
  (let ((erased a1) (erased p1)) (bsp-lo0 k1 a))
  (let ((erased ak) (erased c)) (bc-new a1 (Bit0)))
  (values ak (BspS k1 ak a1 (Zero) (Zero) a (Bit0) p1 c (bc-zz))))

(def-fns _ $ (erased bsp-zero-hi : (erased (Nat) k x lo) (subterm erased (Bsp k x lo (Zero)) p) -> (erased (Eq (Nat) x lo) e))
  (let-match erased p (BspS k1 _ x1 _ lo1 _ b p1 cx cl) ((BspZ _) (Refl _ x)))
  (let-match erased (bsp-zero-hi k1 x1 lo1 p1) (Refl _ _))
  (bitcons-det x1 x lo b cx cl))

(def-fns _ $ (erased bsp-zero-x : (erased (Nat) k lo hi) (subterm erased (Bsp k (Zero) lo hi) p) -> (erased (Eq (Nat) hi (Zero)) e) (erased (Eq (Nat) lo (Zero)) f))
  (let-match erased p (BspS k1 _ x1 _ lo1 _ b p1 cx cl) ((BspZ _) (values (Refl _ hi) (Refl _ lo))))
  (let ((erased e1) (erased e2)) (bc-zero x1 b cx))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased e3) (erased e4)) (bsp-zero-x k1 lo1 hi p1))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (values (Refl _ hi) (bitcons-det (Zero) lo (Zero) (Bit0) cl (bc-zz))))

; Each entry i below n of xs is some v with R i v.
(def-adts $ (TabR : ((TyCtor ((Nat) i) ((Nat) v) -> Type) R) ((Nat) n) ((List (Copy (Nat))) xs) -> Type)
  enum
  (many TbZ : (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (erased (List (Copy (Nat))) xs) -> (TabR R (Zero) xs))
  (many TbS : (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (erased (Nat) j v) (erased (List (Copy (Nat))) xs) (erased (TabR R j xs) t)
      (erased (Nth (Copy (Nat)) xs j (MkCopy (Nat) v)) x) (erased (R j v) r) -> (TabR R (Succ j) xs)))

(def-fns _ $ (erased tab-get : (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (erased (Nat) n i) (erased (List (Copy (Nat))) xs) (erased (Copy (Nat)) c)
    (subterm erased (TabR R n xs) t) (erased (Nth (Copy (Nat)) xs i c) x) (erased (Lt i n) l) -> (erased (Nat) v) (erased (Eq (Copy (Nat)) c (MkCopy (Nat) v)) e) (erased (R i v) r))
  (let-match erased t (TbS _ j v _ t1 x1 r1) (absurd (TbZ _ _) l))
  (let-match erased (nat-eq i j) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values v (nth-fn _ xs i c (MkCopy (Nat) v) x x1) r1)))
  (let-match erased ap (ApLt _ _ _ _ lt) (absurd (ApGt _ _ _ _ gt) (lt-irrefl j (lt-le-trans j i j gt l))))
  (tab-get R j i xs c t1 x lt))

(def-fns _ $ (erased tab-set : (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (erased (Nat) n k) (erased (List (Copy (Nat))) xs ys) (erased (Copy (Nat)) y)
    (subterm erased (TabR R n xs) t) (erased (SetNth (Copy (Nat)) xs k y ys) s) (erased (Lt n (Succ k)) l) -> (erased (TabR R n ys) r))
  (let-match erased t (TbS _ j v _ t1 x1 r1) ((TbZ _ _) (TbZ R ys)))
  (let ((erased l1)) (lt-pred j k l))
  (TbS R j v ys (tab-set R j k xs ys y t1 s (lt-weaken j k l1)) (setnth-nth-lt _ xs k j y (MkCopy (Nat) v) ys s x1 l1) r1))

(def-fns _ $ (many tab-factory : (erased (Level) M) -> (erased (Level) L)
    (many (Fn L (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (many (Nat) n) (erased (Lt n u62-modulus) nb)
        (many (Fn M (many (Nat) i) (erased (Lt i n) il) -> (many (Nat) v) (erased (R i v) p) (erased (Lt v u62-modulus) vb)) f) ->
        (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (erased (TabR R n xs) t) (erased (Length (Copy (Nat)) xs n) l)
        (erased (AllCu xs) au)) tinit))
  (def-fns _ $ (many tab-fill : (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (many (Nat) n) (erased (Lt n u62-modulus) nb)
      (many (Fn M (many (Nat) i) (erased (Lt i n) il) -> (many (Nat) v) (erased (R i v) p) (erased (Lt v u62-modulus) vb)) f)
      (many (Nat) i) (subterm erased (Nat) k) (erased (Add i k n) ad) (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a)
      (erased (TabR R i xs) t) (erased (Length (Copy (Nat)) xs n) l) (erased (AllCu xs) au) ->
      (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) r at a) (erased (TabR R n ys) t2) (erased (Length (Copy (Nat)) ys n) l2)
      (erased (AllCu ys) au2))
    (let ((erased ib)) (lt-le-trans i (Succ n) u62-modulus (add-le-left i k n ad) (LtS n u62-modulus nb)))
    (let-match many (u62-lt-dec i n ib nb) (Yes _ _ _ _ il)
      ((No _ _ _ _ le)
        (let-match erased k (Zero) (absurd (Succ k0) (lt-irrefl i (lt-le-trans i n i (add-pos-lt i k n ad (LtZ k0)) (le-lt-succ n i le)))))
        (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _))
        (values xs a t l au)))
    (let ((many v) (erased p) (erased vb)) (f i il))
    (let ((erased m) (erased nth)) (nth-exists _ xs n i l il))
    (let ((erased ys) (unique a2) (erased s)) (array-place-imm _ _ a i (MkCopy _ v) m nth (allcu-nth xs i m au nth) (imm-cu v vb)))
    (let-match erased k (Succ k1) (absurd (Zero) (let-match erased (add-fn i (Zero) n i ad (add-zero-right i)) (Refl _ _)) (lt-irrefl i il)))
    (tail $ tab-fill R n nb f (u62-inc i (lt-le-trans (Succ i) (Succ n) u62-modulus (LtS i n il) (LtS n u62-modulus nb))) k1 (add-sh i k1 n ad) ys a2
      (TbS R i v ys (tab-set R i i xs ys (MkCopy _ v) t s (lt-succ i)) (setnth-nth _ xs i _ ys s) p) (setnth-length _ xs i n _ ys s l) (allcu-set xs ys i v vb au s)))
  (def-fns _ $ (many tinit : (erased (TyCtor ((Nat) i) ((Nat) v) -> Type) R) (many (Nat) n) (erased (Lt n u62-modulus) nb)
      (many (Fn M (many (Nat) i) (erased (Lt i n) il) -> (many (Nat) v) (erased (R i v) p) (erased (Lt v u62-modulus) vb)) f) ->
      (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (erased (TabR R n xs) t) (erased (Length (Copy (Nat)) xs n) l)
      (erased (AllCu xs) au))
    (let ((erased xs) (unique a) (erased rp)) (array-make (Nat) n (Zero)))
    (tab-fill R n nb f (Zero) n (AddZero n) xs a (TbZ R xs) (repeat-length _ n _ xs rp) (allcu-rep n xs rp)))
  (values (level-of tinit) tinit))

(def-adts $ (BitV : ((Bit) b) ((Nat) v) -> Type)
  enum
  (many BV0 : -> (BitV (Bit0) (Zero)))
  (many BV1 : -> (BitV (Bit1) (Succ (Zero)))))

; r of the low s bits of x are set.
(def-adts $ (Rk : ((Nat) s) ((Nat) x) ((Nat) r) -> Type)
  enum
  (many RkZ : (erased (Nat) x) -> (Rk (Zero) x (Zero)))
  (many RkS : (erased (Nat) s x x1 r1 v r) (erased (Bit) b) (erased (BitCons x1 b x) c) (erased (Rk s x1 r1) p) (erased (BitV b v) bv) (erased (Add v r1 r) a)
      -> (Rk (Succ s) x r)))

; Entry i of the rank table: the set bits of i / 4 below bit i mod 4.
(def-adts $ (RkE : ((Nat) i) ((Nat) v) -> Type)
  enum
  (many MkRkE : (erased (Nat) i s m v) (erased (Bsp 2 i s m) p) (erased (Rk s m v) r) -> (RkE i v)))

(def-fns _ $ (erased bc-one : (erased (Bit) b) -> (erased (Nat) v) (erased (BitCons (Zero) b v) c) (erased (BitV b v) bv))
  (match erased b (((Nat) v) ((BitCons (Zero) b v) c) ((BitV b v) bv))
    ((Bit0) (values (Zero) (bc-zz) (BV0)))
    ((Bit1) (values (Succ (Zero)) (BC1 (Zero) (Zero) (D0)) (BV1)))))

(def-fns _ $ (erased rk-step : (erased (Nat) j m lo y y1 r v r2) (erased (Bit) b) (subterm erased (Rk j m r) rk) (erased (Bsp j m lo y) p) (erased (BitCons y1 b y) c)
    (erased (BitV b v) bv) (erased (Add r v r2) a) -> (erased (Rk (Succ j) m r2) res))
  (let-match erased rk (RkS j1 _ m1 r1 v0 _ b0 c0 rk1 bv0 a0)
    ((RkZ _)
      (let-match erased p (BspZ _))
      (let-match erased a (AddZero _))
      (RkS (Zero) m y1 (Zero) v r2 b c (RkZ y1) bv (add-zero-right v))))
  (let-match erased p (BspS _ _ mq2 _ lo1 _ b2 p1 cm cl))
  (let ((erased e1) (erased e2)) (bitcons-fn m1 b0 mq2 b2 m c0 cm))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased r3) (erased a3)) (add r1 v))
  (let ((erased k) (erased q1) (erased q2)) (add-reassoc v0 r1 v r r2 a0 a))
  (let-match erased (add-fn r1 v k r3 q1 a3) (Refl _ _))
  (RkS (Succ j1) m m1 r3 v0 r2 b0 c0 (rk-step j1 m1 lo1 y y1 r1 v r3 b rk1 p1 c bv a3) bv0 q2))

(def-fns _ $ (erased rk-le : (erased (Nat) s x r) (subterm erased (Rk s x r) p) -> (erased (Lt r (Succ s)) l))
  (let-match erased p (RkS s1 _ _ r1 v _ _ _ p1 bv a) ((RkZ _) (LtZ (Zero))))
  (let ((erased l1)) (rk-le s1 _ r1 p1))
  (match erased bv _
    ((BV0) (let-match erased a (AddZero _)) (lt-weaken r (Succ s1) l1))
    ((BV1) (let-match erased a (AddSucc _ _ _ a0)) (let-match erased a0 (AddZero _)) (LtS r1 (Succ s1) l1))))

(def-fns _ $ (erased bit-split : (erased (Nat) y) -> (erased (Nat) y1 bv) (erased (Bit) b) (erased (BitCons y1 b y) c) (erased (BitV b bv) v)
    (erased (Bsp (Succ (Zero)) y bv y1) p))
  (let ((erased y1) (erased b) (erased c)) (nat-bit y))
  (let ((erased bv) (erased cb) (erased v)) (bc-one b))
  (values y1 bv b c v (BspS (Zero) y y1 bv (Zero) y1 b (BspZ y1) c cb)))

(def-fns _ $ (erased bsp-pow : (erased (Nat) j v) (erased (Pow2 j v) pv) -> (erased (Bsp j v (Zero) (Succ (Zero))) p))
  (bsp-of j v (Succ (Zero)) v (Zero) v pv (MulSucc (Zero) v (Zero) v (MulZero v) (AddZero v)) (add-zero-right v) (pow2-pos j v pv)))

(def-fns _ $ (many r4-eq-pf : (many (Nat) a b) -> (many (ErasedMaybe (Eq (Nat) a b)) r))
  (match many (nat-eq a b) _ ((Equal _ _ _) (ESome _ (Refl _ a))) ((Unequal _ _ _ _ _) (ENone _))))

(def-fns _ $ (many ones-c : (subterm many (Nat) k) -> (many (Nat) m) (erased (Ones k m) o))
  (let-match many k (Succ k1) ((Zero) (values (Zero) (OnZ))))
  (let ((many m1) (erased o1)) (notail $ ones-c k1))
  (let ((many m) (erased c)) (bit-snoc m1 (Bit1)))
  (values m (OnS k1 m1 m o1 c)))

(def-fns _ $ (many bsp-c : (subterm many (Nat) k) (many (Nat) x) -> (many (Nat) lo hi) (erased (Bsp k x lo hi) p))
  (let-match many k (Succ k1) ((Zero) (values (Zero) x (BspZ x))))
  (let ((many x1) (many b) (erased cx)) (nat-bit x))
  (let ((many lo1) (many hi) (erased p1)) (notail $ bsp-c k1 x1))
  (let ((many lo) (erased cl)) (bit-snoc lo1 b))
  (values lo hi (BspS k1 x x1 lo lo1 hi b p1 cx cl)))

(comptime-match many (r4-eq-pf 1 (Succ (Zero))) (ESome _ r4-one))
(let ((many r4-m3) (erased r4-o3)) (ones-c 2))
(comptime-match many (nat-eq r4-m3 3) (Equal _ _ _))
(let ((many r4-v4) (erased r4-p4) (erased _)) (pow2 2))
(comptime-match many (nat-eq r4-v4 4) (Equal _ _ _))
(comptime-match many (lt-dec 4 (Succ (sixty-two-many))) (Yes _ _ _ _ r4-four-lt))
(comptime-match many (lt-dec 4 flag-um) (Yes _ _ _ _ r4-four-u62))

(def-fns _ $ (erased bsp-bit : (erased (Nat) j m) -> (erased (Nat) lo y y1 bv) (erased (Bit) b) (erased (Bsp j m lo y) p) (erased (BitCons y1 b y) c)
    (erased (BitV b bv) v) (erased (Bsp (Succ (Zero)) y bv y1) q))
  (let ((erased lo) (erased y) (erased p)) (bsp-c j m))
  (let ((erased y1) (erased bv) (erased b) (erased c) (erased v) (erased q)) (bit-split y))
  (values lo y y1 bv b p c v q))

(def-fns _ $ (erased bitv-zero : (erased (Bit) b) (erased (Nat) j fk) (erased (BitV b fk) v) (erased (Bsp j (Zero) (Zero) fk) p) -> (erased (Eq (Bit) b (Bit0)) e))
  (let ((erased e1) (erased _)) (bsp-zero-x j (Zero) fk p))
  (let-match erased e1 (Refl _ _))
  (let-match erased v (BV0))
  (Refl _ b))

(def-fns _ $ (erased bit-shift-le : (erased (Bit) b) (erased (Nat) j fk bv w) (erased (BitV b bv) v) (erased (Bsp j fk (Zero) bv) p) (erased (Pow2 j w) pw)
    -> (erased (Lt fk (Succ w)) r))
  (let ((erased w2) (erased m) (erased pw2) (erased mm) (erased ad) (erased _)) (bsp-arith j fk (Zero) bv p))
  (let-match erased (pow2-fn j w w2 pw pw2) (Refl _ _))
  (let-match erased (add-fn m (Zero) fk m ad (add-zero-right m)) (Refl _ _))
  (match erased v _
    ((BV0) (let-match erased mm (MulZero _)) (LtZ w))
    ((BV1) (let-match erased mm (MulSucc _ _ m0 _ mm0 a0)) (let-match erased mm0 (MulZero _)) (let-match erased a0 (AddZero _)) (lt-succ w))))

(def-fns _ $ (many rank-loop : (many (Nat) m s j r) (erased (Lt m u62-modulus) mb) (erased (Lt s r4-v4) sb) (subterm erased (Nat) k) (erased (Add j k s) ad)
    (erased (Rk j m r) rk) (erased (Lt r (Succ j)) rl) -> (many (Nat) r2) (erased (Rk s m r2) rk2) (erased (Lt r2 (Succ s)) rl2))
  (let ((erased jb)) (lt-le-trans j (Succ s) r4-v4 (add-le-left j k s ad) (LtS s r4-v4 sb)))
  (let ((erased jb2)) (lt-trans j r4-v4 u62-modulus jb r4-four-u62))
  (let-match many (u62-lt-dec j s jb2 (lt-trans s r4-v4 u62-modulus sb r4-four-u62)) (Yes _ _ _ _ js)
    ((No _ _ _ _ le)
      (let-match erased k (Zero) (absurd (Succ k0) (lt-irrefl j (lt-le-trans j s j (add-pos-lt j k s ad (LtZ k0)) (le-lt-succ s j le)))))
      (let-match erased (add-fn j (Zero) s j ad (add-zero-right j)) (Refl _ _))
      (values r rk rl)))
  (let-match erased k (Succ k1) (absurd (Zero) (let-match erased (add-fn j (Zero) s j ad (add-zero-right j)) (Refl _ _)) (lt-irrefl j js)))
  (let ((erased sj)) (lt-le-trans (Succ j) (Succ s) u62-modulus (LtS j s js) (LtS s u62-modulus (lt-trans s r4-v4 u62-modulus sb r4-four-u62))))
  (let ((many j1)) (u62-inc j sj))
  (let ((erased jl)) (lt-trans j r4-v4 (Succ sixty-two) jb r4-four-lt))
  (let ((erased lo) (erased y) (erased y1) (erased bv) (erased b) (erased p) (erased c) (erased v) (erased q)) (bsp-bit j m))
  (let-match erased r4-one (Refl _ _))
  (let ((erased w) (erased pw) (erased _)) (pow2 j))
  (let ((erased wb)) (pow2-lt j sixty-two w u62-modulus (lt-le-trans j r4-v4 sixty-two jb r4-four-lt) pw u62-modulus-pow2))
  (let ((many mask)) (u62-shl 1 j jl w pw w (MulSucc (Zero) w (Zero) w (MulZero w) (AddZero w)) wb))
  (let ((erased fk) (erased pf)) (bsp-lo0 j bv))
  (let ((many x) (erased px)) (u62-and m mask mb wb))
  (let-match erased (bitwise-fn and-op m mask x fk px (and-mask j (Succ (Zero)) m lo y bv y1 (Succ (Zero)) mask fk p q (OnS (Zero) (Zero) (Succ (Zero)) (OnZ) (BC1 (Zero) (Zero) (D0))) (bsp-pow j w pw) pf)) (Refl _ _))
  (let ((erased ad1)) (add-sh j k1 s ad))
  (match many (u62-eq x (Zero) (lt-le-trans fk (Succ w) u62-modulus (bit-shift-le b j fk bv w v pf pw) (LtS w u62-modulus wb)) u62-modulus-pos) _
    ((Equal _ _ _)
      (let-match erased (bitv-zero b j bv v pf) (Refl _ _))
      (let-match erased v (BV0))
      (tail $ rank-loop m s j1 r mb sb k1 ad1 (rk-step j m lo y y1 r (Zero) r b rk p c v (add-zero-right r)) (lt-weaken r (Succ j) rl)))
    ((Unequal _ _ _ _ ap)
      (let-match erased v (BV1)
        (absurd (BV0) (let-match erased (bsp-zero-hi j fk (Zero) pf) (Refl _ _)) (match erased ap _ (absurd (ApLt _ _ _ _ l) l) (absurd (ApGt _ _ _ _ l) l))))
      (tail $ rank-loop m s j1 (u62-inc r (lt-le-trans (Succ r) (Succ (Succ j)) u62-modulus (LtS r (Succ j) rl) (LtS (Succ j) u62-modulus sj))) mb sb k1 ad1 (rk-step j m lo y y1 r (Succ (Zero)) (Succ r) b rk p c v (add-succ-right r (Zero) r (add-zero-right r))) (LtS r (Succ j) rl)))))

(comptime-match many (lt-dec 2 (Succ (sixty-two-many))) (Yes _ _ _ _ r4-two-lt))
(comptime-match many (lt-dec 64 flag-um) (Yes _ _ _ _ r4-64-u62))
(comptime-match many (lt-dec 3 flag-um) (Yes _ _ _ _ r4-three-u62))

(def-fns _ $ (erased offs-fn : (erased (Nat) d o1 o2) (subterm erased (Offs d o1) p) (erased (Offs d o2) q) -> (erased (Eq (Nat) o1 o2) e))
  (let-match erased p (OfS d1 a1 q1 p1 t1) ((OfZ) (let-match erased q (OfZ)) (Refl _ o1)))
  (let-match erased q (OfS _ a2 q2 p2 t2))
  (let-match erased (offs-fn d1 a1 a2 p1 p2) (Refl _ _))
  (let-match erased (thrice-fn a1 q1 q2 t1 t2) (Refl _ _))
  (Refl _ o1))

(def-fns _ $ (erased offs-mono : (erased (Nat) i v j w) (erased (Offs i v) p) (subterm erased (Offs j w) q) (erased (Lt i (Succ j)) l) -> (erased (Lt v (Succ w)) r))
  (let-match erased q (OfS j1 w1 q1 q0 t1)
    ((OfZ) (let-match erased l (LtZ _) (absurd (LtS _ _ l0) l0)) (let-match erased p (OfZ)) (LtZ (Zero))))
  (let ((erased le)) (thrice-le w1 q1 t1))
  (match erased (nat-eq i (Succ j1)) _
    ((Equal _ _ _) (let-match erased (offs-fn i v w p q) (Refl _ _)) (lt-succ w))
    ((Unequal _ _ _ _ ap)
      (let-match erased ap (ApLt _ _ _ _ lt) (absurd (ApGt _ _ _ _ gt) (lt-irrefl (Succ j1) (lt-le-trans (Succ j1) i (Succ j1) gt l))))
      (le-trans v w1 w (offs-mono i v j1 w1 p q0 lt) (lt-weaken w1 w le)))))

(let ((many r4-o16) (erased r4-of16)) (offs-c 16))
(comptime-match many (lt-dec r4-o16 flag-um) (Yes _ _ _ _ r4-o16-u62))
(comptime-match many (r4-eq-pf 17 (Succ 16)) (ESome _ r4-e17))

(def-fns _
  ((many offs-at : (many (Nat) i) (erased (Lt i 17) il) -> (many (Nat) v) (erased (Offs i v) p) (erased (Lt v u62-modulus) vb))
