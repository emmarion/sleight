  (Some _ (MkNodes h gtu ys (share r) n l2 au2 (flb-lay ys h (Zero) _ _ gtu f) (flb-part ys h (Zero) _ _ gtu f) (flb-tr ys h (Zero) _ _ gtu f) _ _ (flb-iv ys h (Zero) _ _ gtu f)
    (lt-trans n (Succ n) u62-modulus (lt-succ n) (ncap-len n (MkNCap n L4 ml lb))) gz)))

; v is 0 for the empty tree and 1 otherwise.
(def-adts $ (Nz : ((Ctree) t) ((Nat) v) -> Type)
  enum
  (many NzE : -> (Nz (CEmpty) (Zero)))
  (many NzL : (erased (Ctree) lf) -> (Nz (CLeaf lf) (Succ (Zero))))
  (many NzN : (erased (Ctree) t1 t2 t3) -> (Nz (CNode t1 t2 t3) (Succ (Zero)))))

(def-adts
  ; Trie node n, whose children are 3n + 1 to 3n + 3, holds t, of j + 1 more colours: its entry is the number of nonempty children of t,
  ; and each child above the traces is held the same way.
  ((Lc : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many LcE : (erased (List (U8)) us) (erased (Nat) j n) (erased (Elt flag-w us n (Zero)) x) -> (Lc us j n (CEmpty)))
    (many LcN : (erased (List (U8)) us) (erased (Nat) j n q c a1 a2 a3 c12) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n c) x) (erased (Thrice n q) tq)
        (erased (Nz t1 a1) z1) (erased (Nz t2 a2) z2) (erased (Nz t3 a3) z3) (erased (Add a1 a2 c12) s1) (erased (Add c12 a3 c) s2)
        (erased (LcK us j (Succ q) t1) k1) (erased (LcK us j (Succ (Succ q)) t2) k2) (erased (LcK us j (Succ (Succ (Succ q))) t3) k3)
        -> (Lc us j n (CNode t1 t2 t3))))
  ((LcK : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many LkZ : (erased (List (U8)) us) (erased (Nat) n) (erased (Ctree) t) -> (LcK us (Zero) n t))
    (many LkS : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) t) (erased (Lc us j n t) l) -> (LcK us (Succ j) n t))))

; A pair of the walk: a trace prefix p with its bit stack bs.
(def-adts $ (WP : -> Type)
  enum
  (many MkWP : (erased (Nat) p) (erased (Bstack) bs) -> (WP)))

; k counts, over the pairs of P at the prefix q, the chromograms of gs that match rest from their stacks.
(def-adts $ (WCt : ((List (WP)) P) ((GSet) gs) ((Nat) q) ((List (Col)) rest) ((Nat) k) -> Type)
  enum
  (many WcNil : (erased (GSet) gs) (erased (Nat) q) (erased (List (Col)) rest) -> (WCt (Nil (WP)) gs q rest (Zero)))
  (many WcHit : (erased (Nat) q a c k) (erased (Bstack) bs) (erased (List (WP)) P) (erased (GSet) gs) (erased (List (Col)) rest)
      (erased (MC gs bs rest a) m) (erased (WCt P gs q rest c) pc) (erased (Add a c k) ad) -> (WCt (Cons (WP) (MkWP q bs) P) gs q rest k))
  (many WcMiss : (erased (Nat) p q k) (erased (Bstack) bs) (erased (List (WP)) P) (erased (GSet) gs) (erased (List (Col)) rest)
      (erased (Apart (Nat) Lt p q) ap) (erased (WCt P gs q rest k) pc) -> (WCt (Cons (WP) (MkWP p bs) P) gs q rest k)))

; Q is the pairs that x steps to under the symbol s, then Q0.
(def-adts $ (WCh : ((Gsym) s) ((WP) x) ((List (WP)) Q0) ((List (WP)) Q) -> Type)
  enum
  (many WhSkip : (erased (Nat) p q) (erased (Bstack) bs) (erased (Kid p (C1) q) k) (erased (List (WP)) Q0)
      -> (WCh (GSkip) (MkWP p bs) Q0 (Cons (WP) (MkWP q bs) Q0)))
  (many WhPush : (erased (Nat) p q2 q3) (erased (Bstack) bs) (erased (Kid p (C2) q2) k2) (erased (Kid p (C3) q3) k3) (erased (List (WP)) Q0)
      -> (WCh (GPush) (MkWP p bs) Q0 (Cons (WP) (MkWP q2 (BP0 bs)) (Cons (WP) (MkWP q3 (BP1 bs)) Q0))))
  (many WhPop : (erased (Nat) p q) (erased (Gsym) s) (erased (Col) e) (erased (Bstack) bs b) (erased (Popped bs b) pp) (erased (Sym s bs e b) y)
      (erased (Kid p e q) k) (erased (List (WP)) Q0) -> (WCh s (MkWP p bs) Q0 (Cons (WP) (MkWP q b) Q0)))
  (many WhNone : (erased (Nat) p) (erased (Gsym) s) (erased (IsPop s) ip) (erased (List (WP)) Q0) -> (WCh s (MkWP p (BS0)) Q0 Q0)))

; Q holds, in order, the pairs that those of P step to under s.
(def-adts $ (WStp : ((Gsym) s) ((List (WP)) P) ((List (WP)) Q) -> Type)
  enum
  (many WtNil : (erased (Gsym) s) -> (WStp s (Nil (WP)) (Nil (WP))))
  (many WtCons : (erased (Gsym) s) (erased (WP) x) (erased (List (WP)) P Q0 Q) (erased (WStp s P Q0) st) (erased (WCh s x Q0 Q) ch)
      -> (WStp s (Cons (WP) x P) Q)))

(def-fns _ $ (erased wct-hit : (erased (Nat) q r) (erased (Bstack) bs) (erased (List (WP)) Q0) (erased (GSet) gs) (erased (List (Col)) rest)
    (erased (WCt Q0 gs q rest r) pc) -> (erased (Nat) a k) (erased (MC gs bs rest a) m) (erased (Add a r k) ad) (erased (WCt (Cons (WP) (MkWP q bs) Q0) gs q rest k) pk))
  (let ((erased a) (erased m)) (mc-exists gs bs rest))
  (let ((erased k) (erased ad)) (add a r))
  (values a k m ad (WcHit q a r k bs Q0 gs rest m pc ad)))

(def-fns _ $ (erased wch-symc : (erased (Nat) p q r) (erased (Gsym) s) (erased (Bstack) bs) (erased (List (WP)) Q0 Q) (erased (GSet) gs) (erased (Col) e)
    (erased (List (Col)) rest) (erased (WCh s (MkWP p bs) Q0 Q) ch) (erased (Kid p e q) kq) (erased (WCt Q0 gs q rest r) pc) ->
    (erased (Nat) c k) (erased (SymC s bs e gs rest c) sc) (erased (Add c r k) ad) (erased (WCt Q gs q rest k) pk))
