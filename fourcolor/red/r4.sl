; red4's ev and es tables of make_eng, for the trie of depths 0 to h + 1, of e nodes.
(def-fns _ $ (many r4-tabs : (many (Nat) h) (erased (Lt (Succ h) 17) hl) (many (Nat) e) (erased (Offs (Succ (Succ h)) e) oe) (erased (Lt e u62-modulus) eb) ->
    (erased (List (U8)) us vs) (unique (Bytes vs) evt) (erased (Sz flag-w vs e) zv) (erased (NBl us vs e) nb))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e5 (Refl _ _))
  (let-match erased oe (OfS _ o1 q of1 tq))
  (let ((erased vs) (unique evt) (erased rv)) (bytes-make e (MkU8 1 r4-1-u8)))
  (let ((erased us) (unique es) (erased ru)) (bytes-make e (MkU8 3 r4-3-u8)))
  (let ((erased zv)) (sz-made flag-w e e _ vs rv (LtZ _) (mul-one-right e) eb))
  (let ((erased zs)) (sz-made flag-w e e _ us ru (LtZ _) (mul-one-right e) eb))
  (let ((erased fv)) (fill-flag e 1 r4-1-u8 vs rv))
  (let ((erased fs)) (fill-flag e 3 r4-3-u8 us ru))
  (let ((erased nk)) (NokL us vs (Zero) 3 1 (ESStart) (HxZ) (EscS) (LtS _ _ (LtS _ _ (LtS _ _ (LtZ _)))) (fill-elt flag-w us e 3 (Zero) fs zs (LtZ q))
    (fill-elt flag-w vs e 1 (Zero) fv zv (LtZ q)) (ApGt (Nat) Lt 1 (Zero) (LtZ (Zero)))))
  (let ((erased us2) (erased _) (erased vs2) (unique ev2) (erased _) (erased zv2) (erased nb) (erased _))
    (r4-es-k us es vs evt e zs zv h 0 hl 1 e (OfS (Zero) (Zero) (Zero) (OfZ) (TZ)) oe (lt-succ e) (Succ h) (AddZero (Succ h)) (NbS us vs (Zero) (NbZ us vs) nk)
      (evone-fill vs e 1 fv zv q (AddSucc (Zero) q q (AddZero q)))))
  (values us2 vs2 ev2 zv2 nb))

(def-fns _ $ (erased kid-par : (erased (Nat) m m2 x) (erased (Col) e e2) (erased (Kid m e x) k) (erased (Kid m2 e2 x) k2) -> (erased (Eq (Nat) m m2) a) (erased (Eq (Col) e e2) b))
  (let-match erased (nat-eq m m2) (Equal _ _ _) (absurd (Unequal _ _ _ _ ap) (apart-irrefl x (kid-apart m m2 x x e e2 ap k k2))))
  (let-match erased (kid-dec m x x e e2 k k2) (KcSame _ _) (absurd (KcNe _ _ _ _ _ ap) (apart-irrefl x ap)))
  (values (Refl _ m) (Refl _ e)))

(def-fns _ $ (erased hst-fn : (erased (Nat) n) (erased (ES) s1 s2) (subterm erased (HSt n s1) p) (erased (HSt n s2) q) -> (erased (Eq (ES) s1 s2) e))
  (let-match erased p (HxS m x e st0 _ p1 k sp) ((HxZ) (let-match erased q (HxZ)) (Refl _ s1)))
  (let-match erased q (HxS m2 _ e2 st2 _ q1 k2 sp2))
  (let ((erased a) (erased b)) (kid-par m m2 x e e2 k k2))
  (let-match erased a (Refl _ _))
  (let-match erased b (Refl _ _))
  (let-match erased (hst-fn m st0 st2 p1 q1) (Refl _ _))
  (esstep-fn st0 s1 s2 e sp sp2))

; The child of colour e of the node at the prefix q of depth k, heap m, is the heap node n.
(def-fns _ $ (erased heap-kid : (erased (Nat) k o q m q2 o1 n) (erased (Col) e) (erased (Offs k o) of) (erased (Add o q m) am) (erased (Kid q e q2) kq)
    (erased (Offs (Succ k) o1) of1) (erased (Add o1 q2 n) an) -> (erased (Nat) x) (erased (Eq (Nat) n (Succ x)) ex) (erased (Kid m e x) km))
  (let-match erased of1 (OfS _ o2 oq of2 to))
  (let-match erased (offs-fn k o2 o of2 of) (Refl _ _))
  (let ((erased tm) (erased ttm)) (thrice-exists m))
  (match erased kq _
    ((Ki1 _ t tq)
      (let ((erased aq)) (thrice-add o q m oq t tm to tq ttm am))
      (let-match erased (add-fn (Succ oq) t n (Succ tm) an (AddSucc oq t tm aq)) (Refl _ _))
      (values tm (Refl _ n) (Ki1 m tm ttm)))
    ((Ki2 _ t tq)
      (let ((erased aq)) (thrice-add o q m oq t tm to tq ttm am))
      (let-match erased (add-fn (Succ oq) (Succ t) n (Succ (Succ tm)) an (AddSucc oq (Succ t) (Succ tm) (add-succ-right oq t tm aq))) (Refl _ _))
      (values (Succ tm) (Refl _ n) (Ki2 m tm ttm)))
    ((Ki3 _ t tq)
      (let ((erased aq)) (thrice-add o q m oq t tm to tq ttm am))
      (let-match erased (add-fn (Succ oq) (Succ (Succ t)) n (Succ (Succ (Succ tm))) an
        (AddSucc oq (Succ (Succ t)) (Succ (Succ tm)) (add-succ-right oq (Succ t) (Succ tm) (add-succ-right oq t tm aq)))) (Refl _ _))
      (values (Succ (Succ tm)) (Refl _ n) (Ki3 m tm ttm)))))

(def-fns _ $ (erased kid-cd : (erased (Nat) p q) (erased (Col) e) (erased (Kid p e q) k) -> (erased (Nat) d) (erased (CD d e) cd))
  (match erased k _ ((Ki1 _ _ _) (values (Zero) (Cd0))) ((Ki2 _ _ _) (values (Succ (Zero)) (Cd1))) ((Ki3 _ _ _) (values (Succ (Succ (Zero))) (Cd2)))))

(def-fns _ $ (erased esend-ok : (erased (ES) st) (erased (Nat) c) (erased (ESc st c) sc) (erased (Lt c 5) cl) -> (erased (ESEnd st (BTrue)) r))
  (match erased sc _ ((EscS) (EESt)) ((Esc1) (EETl _)) ((Esc2) (EETl _)) ((Esc3) (EETl _)) ((EscE) (EEEv)) (absurd (EscO) (lt-irrefl c cl))))

; The trace t's leaf entry in vs is not 0 when b and bf are BTrue, 0 when b is BTrue and bf BFalse, and anything when b is BFalse.
(def-adts $ (TLf : ((List (U8)) vs) ((Nat) h) ((Nat) t) ((Bool) b) ((Bool) bf) -> Type)
  enum
  (many TlLive : (erased (List (U8)) vs) (erased (Nat) h t o n v) (erased (Offs (Succ h) o) of) (erased (Add o t n) ad) (erased (Elt flag-w vs n v) x)
      (erased (Apart (Nat) Lt v (Zero)) nz) -> (TLf vs h t (BTrue) (BTrue)))
  (many TlLeaf : (erased (List (U8)) vs) (erased (Nat) h t o n) (erased (Offs (Succ h) o) of) (erased (Add o t n) ad) (erased (Elt flag-w vs n (Zero)) x)
      -> (TLf vs h t (BTrue) (BFalse)))
  (many TlZero : (erased (List (U8)) vs) (erased (Nat) h t) -> (TLf vs h t (BFalse) (BFalse))))

; The path from the node at the prefix q of depth k, heap m, whose state st is not odd, to the trace t: its zeros in vs, the end of its run, and t's leaf entry.
(def-fns _ $ (erased tr-pz : (erased (List (U8)) us vs) (erased (Nat) h E k j o o1 q m c t) (erased (ES) st) (erased (NBl us vs E) nb) (erased (Offs (Succ (Succ h)) E) oE)
    (erased (Offs k o) of) (erased (Offs (Succ k) o1) of1) (erased (Add o q m) am) (erased (Lt m o1) ml) (erased (HSt m st) hs) (erased (ESc st c) sc) (erased (Lt c 5) cl)
    (subterm erased (List (Col)) rest) (erased (Length (Col) rest (Succ j)) le) (erased (Add k (Succ j) (Succ h)) kj) (erased (TIdx q rest t) ti) ->
    (erased (Bool) b bf) (erased (WPz vs k q rest b) pz) (erased (ERun st rest bf) er) (erased (TLf vs h t b bf) tl))
  (let-match erased le (LengthCons _ e rest1 _ le1))
  (let-match erased ti (TICons _ q2 _ _ _ kq ti1))
  (let ((erased oo) (erased of2)) (offs-c (Succ (Succ k))))
  (let ((erased n) (erased an)) (add o1 q2))
  (let ((erased x) (erased ex) (erased km)) (heap-kid k o q m q2 o1 n e of am kq of1 an))
  (let-match erased ex (Refl _ _))
  (let-match erased of2 (OfS _ o3 t1 of3 tt1))
  (let-match erased (offs-fn (Succ k) o3 o1 of3 of1) (Refl _ _))
  (let ((erased q0) (erased tq0) (erased hi) (erased _)) (kid-base m x e km))
  (let ((erased xo)) (LtS x t1 (lt-le-trans x (Succ (Succ (Succ q0))) t1 hi (LtS (Succ (Succ q0)) t1 (thrice-lt m o1 q0 t1 ml tq0 tt1)))))
  (let ((erased kh)) (add-pos-lt k (Succ j) (Succ h) kj (LtZ j)))
  (let ((erased nE)) (lt-le-trans (Succ x) oo E xo (offs-mono (Succ (Succ k)) oo (Succ (Succ h)) E of2 oE (LtS (Succ k) (Succ (Succ h)) (LtS k (Succ h) kh)))))
  (let ((erased d) (erased cd)) (kid-cd q q2 e kq))
  (let ((erased st2) (erased sp)) (esstep-exists st d e cd))
  (match erased (nbl-get us vs E (Succ x) nb nE) _
    ((NokL _ _ _ c2 v st3 hs2 sc2 cl2 _ y nz)
      (let-match erased (hst-fn (Succ x) st3 st2 hs2 (HxS m x e st st2 hs km sp)) (Refl _ _))
      (match erased rest1 _
        ((Nil _)
          (let-match erased le1 (LengthNil _))
          (let-match erased ti1 (TINil _))
          (let-match erased (add-fn k (Succ (Zero)) (Succ h) (Succ k) kj (add-one-r k)) (Refl _ _))
          (values (BTrue) (BTrue) (WpzLeaf vs k q e) (ERCons st st2 e (Nil _) (BTrue) sp (ERNil st2 (BTrue) (esend-ok st2 c2 sc2 cl2))) (TlLive vs h t o1 (Succ x) v of1 an y nz)))
        ((Cons _ e2 rest2)
          (let-match erased le1 (LengthCons _ _ _ j1 le2))
          (let ((erased b) (erased bf) (erased pz) (erased er) (erased tl))
            (tr-pz us vs h E (Succ k) j1 o1 oo q2 (Succ x) c2 t st2 nb oE of1 of2 an xo hs2 sc2 cl2 rest1 le1 (add-sh k (Succ j1) (Succ h) kj) ti1))
          (values b bf (WpzNz vs k q q2 o1 (Succ x) v e e2 rest2 b kq of1 an y nz pz) (ERCons st st2 e rest1 bf sp er) tl))))
    ((NokD _ _ m0 _ _ e0 st0 hs0 _ _ kd0 sp0 y)
      (let ((erased a1) (erased a2)) (kid-par m0 m x e0 e kd0 km))
      (let-match erased a1 (Refl _ _))
      (let-match erased a2 (Refl _ _))
      (let-match erased (hst-fn m st0 st hs0 hs) (Refl _ _))
      (let-match erased rest1 (Nil _)
        ((Cons _ e2 rest2)
          (values (BFalse) (BFalse) (WpzZero vs k q q2 o1 (Succ x) e e2 rest2 kq of1 an y) (ERCons st (ESOdd) e rest1 (BFalse) sp0 (run-odd rest1)) (TlZero vs h t))))
      (let-match erased le1 (LengthNil _))
      (let-match erased ti1 (TINil _))
      (let-match erased (add-fn k (Succ (Zero)) (Succ h) (Succ k) kj (add-one-r k)) (Refl _ _))
      (values (BTrue) (BFalse) (WpzLeaf vs k q e) (ERCons st (ESOdd) e (Nil _) (BFalse) sp0 (ERNil (ESOdd) (BFalse) (EEOd))) (TlLeaf vs h t o1 (Succ x) of1 an y)))
    (absurd (NokO _ _ m0 _ e0 hs0 kd0)
      (let ((erased a1) (erased _)) (kid-par m0 m x e0 e kd0 km))
      (let-match erased a1 (Refl _ _))
      (let-match erased (hst-fn m st (ESOdd) hs hs0) (Refl _ _))
      (let-match erased r4-e5 (Refl _ _))
      (let-match erased sc (EscO))
      (lt-irrefl c cl))))

(def-fns _ $ (erased tidx-pre : (erased (Nat) q q2 i j) (erased (List (Col)) rest rest2) (erased (TIdx q rest i) a) (erased (TIdx q2 rest2 i) b)
    (erased (Length (Col) rest j) la) (erased (Length (Col) rest2 j) lb) -> (erased (Eq (Nat) q q2) e))
  (let-match erased (nat-eq q q2) (Equal _ _ _)
    (absurd (Unequal _ _ _ _ ap)
      (match erased ap _
        (absurd (ApLt _ _ _ _ l) (lt-irrefl i (tidx-lt q q2 i i j rest rest2 l a b la lb)))
        (absurd (ApGt _ _ _ _ l) (lt-irrefl i (tidx-lt q2 q i i j rest2 rest l b a lb la))))))
  (Refl _ q))

(def-fns _ $ (erased wsm-fn : (erased (List (WEv)) E) (erased (Nat) i c c2) (erased (Bool) d d2) (subterm erased (WSm E i c d) p) (erased (WSm E i c2 d2) q)
    -> (erased (Eq (Nat) c c2) e) (erased (Eq (Bool) d d2) f))
  (match erased p _
    ((WmNil _) (let-match erased q (WmNil _)) (values (Refl _ c) (Refl _ d)))
    ((WmHit E1 _ a c1 _ _ p1 ad)
      (let-match erased q (WmHit _ _ _ c3 _ _ q1 ad2) (absurd (WmHitO _ _ _ _ _ _ _ ap) (apart-irrefl i ap)))
      (let ((erased e1) (erased f1)) (wsm-fn E1 i c1 c3 d d2 p1 q1))
      (let-match erased e1 (Refl _ _))
      (let-match erased f1 (Refl _ _))
      (values (add-fn c1 a c c2 ad ad2) (Refl _ d)))
    ((WmHitO E1 _ _ _ _ _ p1 ap)
      (let-match erased q (WmHitO _ _ _ _ _ _ q1 _) (absurd (WmHit _ _ _ _ _ _ _ _) (apart-irrefl i ap)))
      (wsm-fn E1 i c c2 d d2 p1 q1))
    ((WmIn E1 _ _ j qd _ _ _ _ dp _ _ _ rest p1 ti le)
      (let-match erased q (WmIn _ _ _ _ _ _ _ _ _ d3 _ _ _ _ q1 _ _)
        (absurd (WmOut _ _ _ _ _ _ _ _ _ q2 _ _ _ _ rest2 _ ti2 le2 ap) (let-match erased (tidx-pre qd q2 i j rest rest2 ti ti2 le le2) (Refl _ _)) (apart-irrefl qd ap)))
      (let ((erased e1) (erased _)) (wsm-fn E1 i c c2 dp d3 p1 q1))
      (values e1 (Refl _ d)))
    ((WmOut E1 _ _ j qd _ _ _ _ q2 _ _ _ _ rest p1 ti le ap)
      (let-match erased q (WmOut _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ q1 _ _ _)
        (absurd (WmIn _ _ _ _ _ _ _ _ _ _ _ _ _ rest3 _ ti3 le3) (let-match erased (tidx-pre qd q2 i j rest3 rest ti3 ti le3 le) (Refl _ _)) (apart-irrefl qd ap)))
      (wsm-fn E1 i c c2 d d2 p1 q1))))

(def-fns _ $ (erased cntr-get : (erased (List (Copy (Nat))) cs) (erased (List (U8)) us) (erased (Nat) o n t) (erased (List (WEv)) E) (subterm erased (CntR cs us o E n) r)
    (erased (Lt t n) l) -> (erased (Nat) c x v) (erased (WElt cs t c) w) (erased (Add o t x) ad) (erased (Elt flag-w us x v) e) (erased (TrC v c E t) ce))
  (let-match erased r (CrS _ _ _ m c x v _ r1 w ad e ce) (absurd (CrZ _ _ _ _) l))
  (let-match erased (nat-eq t m) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values c x v w ad e ce)))
  (let-match erased ap (ApLt _ _ _ _ lt) (absurd (ApGt _ _ _ _ gt) (lt-asym m t gt l)))
  (cntr-get cs us o m t E r1 lt))

; The count c of the trace of colours et, made from the chromograms gs: those of gs matching et from the empty stack when et's run ends not odd, 0 otherwise.
(def-adts $ (CtT : ((GSet) gs) ((List (Col)) et) ((Bool) bf) ((Nat) c) -> Type)
  enum
  (many CtLive : (erased (GSet) gs) (erased (List (Col)) et) (erased (Nat) c) (erased (MC gs (BS0) et c) m) -> (CtT gs et (BTrue) c))
  (many CtOdd : (erased (GSet) gs) (erased (List (Col)) et) -> (CtT gs et (BFalse) (Zero))))

; The count of the trace t of colours et after red4's count 0 0 on the tables of r4-tabs.
(def-fns _ $ (erased r4-cnt-tr : (erased (List (Copy (Nat))) cs) (erased (List (U8)) es us) (erased (Nat) h o e N t) (erased (Gtree) gtu) (erased (List (WEv)) E)
    (erased (WWk (Zero) (Succ h) (GSG gtu) (Cons (WP) (MkWP (Zero) (BS0)) (Nil (WP))) (Nil (WEv)) E) wk)
    (erased (WkU us (Zero) (Succ h) (GSG gtu) (Cons (WP) (MkWP (Zero) (BS0)) (Nil (WP))) (Nil (WEv)) E wk) wu) (erased (CntR cs us o E N) r)
    (erased (NBl es us e) nb) (erased (Offs (Succ h) o) of) (erased (Offs (Succ (Succ h)) e) oe) (erased (List (Col)) et) (erased (TIdx (Zero) et t) ti)
    (erased (Length (Col) et (Succ h)) le) (erased (Lt t N) tl) -> (erased (Nat) c) (erased (Bool) bf) (erased (WElt cs t c) w) (erased (ERun (ESStart) et bf) er)
    (erased (CtT (GSG gtu) et bf c) ct))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e5 (Refl _ _))
  (let ((erased P)) (Cons (WP) (MkWP (Zero) (BS0)) (Nil (WP))))
  (let ((erased b) (erased bf) (erased pz) (erased er) (erased tf))
    (tr-pz es us h e (Zero) h (Zero) 1 (Zero) (Zero) 3 t (ESStart) nb oe (OfZ) (OfS (Zero) (Zero) (Zero) (OfZ) (TZ)) (AddZero (Zero)) (LtZ (Zero)) (HxZ) (EscS)
      (LtS _ _ (LtS _ _ (LtS _ _ (LtZ _)))) et le (AddZero (Succ h)) ti))
  (let ((erased c1) (erased d1) (erased sm1) (erased pr)) (ww-pz us (Zero) (Succ h) (Zero) t (Zero) b (BFalse) (GSG gtu) P (Nil _) E et wk wu ti le pz (WmNil t)))
  (let ((erased c) (erased x) (erased v) (erased w) (erased ad) (erased xe) (erased ce)) (cntr-get cs us o N t E r tl))
  (match erased tf _
    ((TlLive _ _ _ o2 n v2 of2 ad2 y nz)
      (let-match erased pr (WprT _ _ _))
      (let-match erased (offs-fn (Succ h) o2 o of2 of) (Refl _ _))
      (let-match erased (add-fn o t n x ad2 ad) (Refl _ _))
      (let-match erased (elt-fn flag-w us x v2 v y xe) (Refl _ _))
      (let-match erased ce (TrH _ _ _ _ hs) (absurd (TrZ _ _) (apart-irrefl (Zero) nz)))
      (let-match erased (hsum-fn E t c c1 hs (wsm-hsum E t c1 d1 sm1)) (Refl _ _))
      (let ((erased a) (erased m)) (mc-exists (GSG gtu) (BS0) et))
      (let ((erased c2) (erased d2) (erased sm2) (erased g))
        (ww-trace (Zero) (Succ h) (Zero) a t (Zero) (BFalse) (GSG gtu) P (Nil _) E et wk ti le
          (WcHit (Zero) a (Zero) a (BS0) (Nil _) (GSG gtu) et m (WcNil (GSG gtu) (Zero) et) (add-zero-right a)) (WmNil t)))
      (let ((erased e1) (erased e2)) (wsm-fn E t c c2 (BFalse) d2 sm1 sm2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let-match erased g (WgF _ _ _ ag))
      (let-match erased (add-fn (Zero) a c a ag (AddZero a)) (Refl _ _))
      (values c (BTrue) w er (CtLive (GSG gtu) et c m)))
    ((TlLeaf _ _ _ o2 n of2 ad2 y)
      (let-match erased (offs-fn (Succ h) o2 o of2 of) (Refl _ _))
      (let-match erased (add-fn o t n x ad2 ad) (Refl _ _))
      (let-match erased (elt-fn flag-w us x (Zero) v y xe) (Refl _ _))
      (let-match erased ce (TrZ _ _))
      (values (Zero) (BFalse) w er (CtOdd (GSG gtu) et)))
    ((TlZero _ _ _)
      (let-match erased pr (WprF _ _ _))
      (let ((erased e0)) (match erased ce (((Eq (Nat) c (Zero)) q)) ((TrZ _ _) (Refl _ c)) ((TrH _ _ _ _ hs) (hsum-fn E t c (Zero) hs (wsm-hsum E t (Zero) d1 sm1)))))
      (let-match erased e0 (Refl _ _))
      (values (Zero) (BFalse) w er (CtOdd (GSG gtu) et)))))

; t2 is t with its child at the colour e replaced by u.
(def-adts $ (Up3 : ((Col) e) ((Ctree) t) ((Ctree) u) ((Ctree) t2) -> Type)
  enum
  (many UpA : (erased (Ctree) t u a2 a3) (erased (CtSel t (C2) a2) s2) (erased (CtSel t (C3) a3) s3) -> (Up3 (C1) t u (CNode u a2 a3)))
  (many UpB : (erased (Ctree) t u a1 a3) (erased (CtSel t (C1) a1) s1) (erased (CtSel t (C3) a3) s3) -> (Up3 (C2) t u (CNode a1 u a3)))
  (many UpC : (erased (Ctree) t u a1 a2) (erased (CtSel t (C1) a1) s1) (erased (CtSel t (C2) a2) s2) -> (Up3 (C3) t u (CNode a1 a2 u))))

; t2 is top with its subtree at the reversed prefix pre replaced by s.
(def-adts $ (Rp : ((Ctree) top) ((List (Col)) pre) ((Ctree) s) ((Ctree) t2) -> Type)
  enum
  (many RpNil : (erased (Ctree) top s) -> (Rp top (Nil (Col)) s s))
  (many RpCons : (erased (Ctree) top u u2 s t2) (erased (List (Col)) pre) (erased (Col) e) (erased (CtAt top pre u) a) (erased (Up3 e u s u2) up)
      (erased (Rp top pre u2 t2) r) -> (Rp top (Cons (Col) e pre) s t2)))

(def-fns _ $ (erased up3-c : (erased (Nat) p q) (erased (Col) e) (erased (Kid p e q) k) (erased (Ctree) t u) -> (erased (Ctree) t2) (erased (Up3 e t u t2) r))
  (let ((erased a1) (erased s1)) (sel-exists t (C1)))
  (let ((erased a2) (erased s2)) (sel-exists t (C2)))
  (let ((erased a3) (erased s3)) (sel-exists t (C3)))
  (match erased k (((Ctree) t2) ((Up3 e t u t2) r))
    ((Ki1 _ _ _) (values (CNode u a2 a3) (UpA t u a2 a3 s2 s3)))
    ((Ki2 _ _ _) (values (CNode a1 u a3) (UpB t u a1 a3 s1 s3)))
    ((Ki3 _ _ _) (values (CNode a1 a2 u) (UpC t u a1 a2 s1 s2)))))

(def-fns _ $ (erased rp-c : (erased (Ctree) top s) (subterm erased (List (Col)) pre) (erased (Nat) p) (erased (RIdx pre p) ri) -> (erased (Ctree) t2) (erased (Rp top pre s t2) r))
  (let-match erased ri (RICons pre1 p1 _ e ri1 k) ((RINil) (values s (RpNil top s))))
  (let ((erased u) (erased a)) (ctat-exists top pre1))
  (let ((erased u2) (erased up)) (up3-c p1 p e k u s))
  (let ((erased t2) (erased r)) (rp-c top u2 pre1 p1 ri1))
  (values t2 (RpCons top u u2 s t2 pre1 e a up r)))

(def-fns _ $ (erased up3-occ : (erased (Col) e) (erased (Ctree) t u t2) (erased (Up3 e t u t2) up) -> (erased (Occ t2) o))
  (match erased up _ ((UpA _ _ a2 a3 _ _) (OccN u a2 a3)) ((UpB _ _ a1 a3 _ _) (OccN a1 u a3)) ((UpC _ _ a1 a2 _ _) (OccN a1 a2 u))))

(def-fns _ $ (erased tally-at : (erased (List Cnt) us) (erased (Nat) j p d H) (erased (Ctree) top t) (subterm erased (List (Col)) pre)
    (erased (Tally us H (Zero) top) b) (erased (RIdx pre p) ri) (erased (CtAt top pre t) pt) (erased (Length (Col) pre d) le) (erased (Add d j H) ad)
    -> (erased (Tally us j p t) r))
  (match erased pre _
    ((Nil _) (let-match erased ri (RINil)) (let-match erased pt (AtNil _)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) b)
    ((Cons _ e pre1)
      (let-match erased ri (RICons _ p1 _ _ ri1 k))
      (let-match erased pt (AtCons _ u _ _ _ at1 s))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Hq ad1))
      (let ((erased u2) (erased c) (erased s2)) (tally-down us j p1 p u e (tally-at us (Succ j) p1 d1 H top u pre1 b ri1 at1 le1 (add-succ-right d1 j Hq ad1)) k))
      (let-match erased (sel-fn u t u2 e s s2) (Refl _ _))
      c)))

(def-fns _ $ (erased up3-cn : (erased (Col) e) (erased (Ctree) u s u2) (erased (Up3 e u s u2) up) (erased (Occ s) o) ->
    (erased (Ctree) w1 w2 w3) (erased (Up3 e u s (CNode w1 w2 w3)) up2) (erased (Cn w1 w2 w3 u2) cn))
  (match erased up _
    ((UpA _ _ a2 a3 _ _) (values s a2 a3 up (CnN s a2 a3 (Occ1 s a2 a3 o))))
    ((UpB _ _ a1 a3 _ _) (values a1 s a3 up (CnN a1 s a3 (Occ2 a1 s a3 o))))
    ((UpC _ _ a1 a2 _ _) (values a1 a2 s up (CnN a1 a2 s (Occ3c a1 a2 s o))))))

(def-fns _ $ (erased tally-up : (erased (List Cnt) us vs) (erased (Nat) j p c i x) (erased (Col) e) (erased (Ctree) u s w1 w2 w3 u2) (erased (List (Col)) rest)
    (erased (Tally us (Succ j) p u) b) (erased (Kid p e c) k) (erased (Tally vs j c s) bs) (erased (Put cnt-w us i x vs) w) (erased (TIdx c rest i) ti)
    (erased (Length (Col) rest j) le) (erased (Up3 e u s (CNode w1 w2 w3)) up) (erased (Cn w1 w2 w3 u2) cn2) -> (erased (Tally vs (Succ j) p u2) r))
  (let-match erased b (TaN _ _ _ q t1 t2 t3 _ tq b1 b2 b3 cn))
  (let ((erased s1) (erased s2) (erased s3)) (cn-sel t1 t2 t3 u cn))
  (let ((erased q1) (erased q2)) (values (Succ q) (Succ (Succ q))))
  (let ((erased l01)) (lt-succ q))
  (let ((erased l12)) (lt-succ q1))
  (let ((erased l02)) (lt-weaken _ _ l01))
  (match erased up _
    ((UpA _ _ a2 a3 x2 x3)
      (let-match erased k (Ki1 _ _ tk))
      (let-match erased (thrice-fn p q c tq tk) (Refl _ _))
      (let-match erased (sel-fn u a2 t2 (C2) x2 s2) (Refl _ _))
      (let-match erased (sel-fn u a3 t3 (C3) x3 s3) (Refl _ _))
      (TaN vs j p q s t2 t3 u2 tq bs (tally-set us vs j q1 q i x rest t2 b2 w ti le (ApGt (Nat) Lt q1 q l01))
        (tally-set us vs j q2 q i x rest t3 b3 w ti le (ApGt (Nat) Lt q2 q l02)) cn2))
    ((UpB _ _ a1 a3 x1 x3)
      (let-match erased k (Ki2 _ _ tk))
      (let-match erased (thrice-fn p q _ tq tk) (Refl _ _))
      (let-match erased (sel-fn u a1 t1 (C1) x1 s1) (Refl _ _))
      (let-match erased (sel-fn u a3 t3 (C3) x3 s3) (Refl _ _))
      (TaN vs j p q t1 s t3 u2 tq (tally-set us vs j q q1 i x rest t1 b1 w ti le (ApLt (Nat) Lt q q1 l01)) bs
        (tally-set us vs j q2 q1 i x rest t3 b3 w ti le (ApGt (Nat) Lt q2 q1 l12)) cn2))
    ((UpC _ _ a1 a2 x1 x2)
      (let-match erased k (Ki3 _ _ tk))
      (let-match erased (thrice-fn p q _ tq tk) (Refl _ _))
      (let-match erased (sel-fn u a1 t1 (C1) x1 s1) (Refl _ _))
      (let-match erased (sel-fn u a2 t2 (C2) x2 s2) (Refl _ _))
      (TaN vs j p q t1 t2 s u2 tq (tally-set us vs j q q2 i x rest t1 b1 w ti le (ApLt (Nat) Lt q q2 l02))
        (tally-set us vs j q1 q2 i x rest t2 b2 w ti le (ApLt (Nat) Lt q1 q2 l12)) bs cn2))))

(def-fns _ $ (erased tally-ins : (erased (List Cnt) us vs) (erased (Nat) H d j c i x) (erased (Ctree) top s t2) (subterm erased (List (Col)) pre) (erased (List (Col)) rest)
    (erased (Tally us H (Zero) top) b) (erased (Rp top pre s t2) rp) (erased (RIdx pre c) ri) (erased (Length (Col) pre d) le) (erased (Add d j H) ad)
    (erased (Tally vs j c s) bs) (erased (Put cnt-w us i x vs) w) (erased (TIdx c rest i) ti) (erased (Length (Col) rest j) lr) (erased (Occ s) o)
    -> (erased (Tally vs H (Zero) t2) r))
  (match erased pre _
    ((Nil _) (let-match erased rp (RpNil _ _)) (let-match erased ri (RINil)) (let-match erased le (LengthNil _)) (let-match erased ad (AddZero _)) bs)
    ((Cons _ e pre1)
      (let-match erased rp (RpCons _ u u2 _ _ _ _ au up rp1))
      (let-match erased ri (RICons _ p _ _ ri1 k))
      (let-match erased le (LengthCons _ _ _ d1 le1))
      (let-match erased ad (AddSucc _ _ Hq ad1))
      (let ((erased ad2)) (add-succ-right d1 j Hq ad1))
      (let ((erased bu)) (tally-at us (Succ j) p d1 H top u pre1 b ri1 au le1 ad2))
      (let ((erased w1) (erased w2) (erased w3) (erased up2) (erased cn2)) (up3-cn e u s u2 up o))
      (tally-ins us vs H d1 (Succ j) p i x top u2 t2 pre1 (Cons _ e rest) b rp1 ri1 le1 ad2 (tally-up us vs j p c i x e u s w1 w2 w3 u2 rest bu k bs w ti lr up2 cn2) w
        (TICons p c i e rest k ti) (LengthCons _ e rest j lr) (up3-occ e u s u2 up)))))

(def-adts
  ; Every entry of us at the trie node n and in the j levels below it is 0.
  ((Zr : ((List (U8)) us) ((Nat) j) ((Nat) n) -> Type)
    enum
    (many MkZr : (erased (List (U8)) us) (erased (Nat) j n q) (erased (Elt flag-w us n (Zero)) x) (erased (Thrice n q) tq) (erased (ZrK us j (Succ q)) k1)
        (erased (ZrK us j (Succ (Succ q))) k2) (erased (ZrK us j (Succ (Succ (Succ q)))) k3) -> (Zr us j n)))
  ((ZrK : ((List (U8)) us) ((Nat) j) ((Nat) n) -> Type)
    enum
    (many ZkZ : (erased (List (U8)) us) (erased (Nat) n) -> (ZrK us (Zero) n))
    (many ZkS : (erased (List (U8)) us) (erased (Nat) j n) (erased (Zr us j n) z) -> (ZrK us (Succ j) n))))

(def-adts
  ; Lc us j n t, every entry below an empty subtree of t being 0.
  ((Lz : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many LzE : (erased (List (U8)) us) (erased (Nat) j n) (erased (Zr us j n) z) -> (Lz us j n (CEmpty)))
    (many LzN : (erased (List (U8)) us) (erased (Nat) j n c) (erased (Ctree) t) (erased (Elt flag-w us n c) x) (erased (LzI us j n c t) i) -> (Lz us j n t)))
  ; Lz us j n t but for the entry at n, which is to be c.
  ((LzI : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Nat) c) ((Ctree) t) -> Type)
    enum
    (many MkLzI : (erased (List (U8)) us) (erased (Nat) j n q c a1 a2 a3 c12) (erased (Ctree) t1 t2 t3) (erased (Thrice n q) tq)
        (erased (Nz t1 a1) z1) (erased (Nz t2 a2) z2) (erased (Nz t3 a3) z3) (erased (Add a1 a2 c12) s1) (erased (Add c12 a3 c) s2)
        (erased (LzK us j (Succ q) t1) k1) (erased (LzK us j (Succ (Succ q)) t2) k2) (erased (LzK us j (Succ (Succ (Succ q))) t3) k3)
        -> (LzI us j n c (CNode t1 t2 t3))))
  ((LzK : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many LzkZ : (erased (List (U8)) us) (erased (Nat) n) (erased (Ctree) t) -> (LzK us (Zero) n t))
    (many LzkS : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) t) (erased (Lz us j n t) l) -> (LzK us (Succ j) n t))))

(def-fns _
  ((erased zr-below : (erased (List (U8)) us vs) (erased (Nat) j n i x) (subterm erased (Zr us j n) z) (erased (Put flag-w us i x vs) s) (erased (Lt i n) l)
      -> (erased (Zr vs j n) r))
    (let-match erased z (MkZr _ _ _ q y tq k1 k2 k3))
    (let ((erased l1)) (lt-le-trans _ _ _ l (lt-weaken _ _ (thrice-le n q tq))))
    (let ((erased l2)) (lt-weaken _ _ l1))
    (MkZr vs j n q (put-other flag-w us vs i x n _ s (ApLt (Nat) Lt i n l) y) tq (zrk-below us vs j (Succ q) i x k1 s l1) (zrk-below us vs j (Succ (Succ q)) i x k2 s l2)
      (zrk-below us vs j (Succ (Succ (Succ q))) i x k3 s (lt-weaken _ _ l2))))
  ((erased zrk-below : (erased (List (U8)) us vs) (erased (Nat) j n i x) (subterm erased (ZrK us j n) z) (erased (Put flag-w us i x vs) s) (erased (Lt i n) l)
      -> (erased (ZrK vs j n) r))
    (let-match erased z (ZkS _ j1 _ z1) ((ZkZ _ _) (ZkZ vs n)))
    (ZkS vs j1 n (zr-below us vs j1 n i x z1 s l))))

(def-fns _
  ((erased zr-apart : (erased (List (U8)) us vs) (erased (Nat) j n m q i x) (subterm erased (Zr us j n) z) (erased (Put flag-w us i x vs) s) (erased (HDesc m i) d)
      (erased (Lt n m) nm) (erased (Thrice n q) tq) (erased (Lt m (Succ q)) mq) -> (erased (Zr vs j n) r))
