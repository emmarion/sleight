    (LzkS vs j1 n t (lz-below us vs j1 n i x t f s l))))

(def-fns _
  ((erased lz-apart : (erased (List (U8)) us vs) (erased (Nat) j n m q i x) (erased (Ctree) t) (subterm erased (Lz us j n t) f) (erased (Put flag-w us i x vs) s)
