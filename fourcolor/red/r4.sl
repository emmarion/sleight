; Each row of rs from k to 16 is a word array of 2^k entries below 2^62.
(def-adts $ (WRws : ((List (MaybeUninit (WRow))) rs) ((Nat) k) -> Type)
  enum
  (many WrwEnd : (erased (List (MaybeUninit (WRow))) rs) -> (WRws rs 17))
  (many WrwS : (erased (List (MaybeUninit (WRow))) rs) (erased (Nat) k w) (erased (List (Copy (Nat))) xs) (erased (Array (Copy (Nat)) xs) a)
      (erased (Nth (MaybeUninit (WRow)) rs k (Init (WRow) (MkWRow xs a))) x) (erased (Length (Copy (Nat)) xs w) l) (erased (Pow2 k w) pw) (erased (AllCu xs) au)
      (erased (WRws rs (Succ k)) r) -> (WRws rs k)))

(def-fns _ $ (erased wrws-get : (erased (List (MaybeUninit (WRow))) rs) (erased (Nat) m k) (subterm erased (WRws rs m) r) (erased (Lt k 17) kl) (erased (Lt m (Succ k)) mk)
    -> (erased (List (Copy (Nat))) xs) (erased (Array (Copy (Nat)) xs) a) (erased (Nat) w) (erased (Nth (MaybeUninit (WRow)) rs k (Init (WRow) (MkWRow xs a))) x)
    (erased (Length (Copy (Nat)) xs w) l) (erased (Pow2 k w) pw) (erased (AllCu xs) au))
  (let-match erased r (WrwS _ _ w xs a x l pw au r1) (absurd (WrwEnd _) (lt-irrefl k (lt-le-trans k 17 k kl mk))))
  (let-match erased (nat-eq m k) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values xs a w x l pw au)))
  (let-match erased ap (ApLt _ _ _ _ lt) (absurd (ApGt _ _ _ _ gt) (lt-irrefl k (lt-le-trans k m k gt mk))))
  (wrws-get rs (Succ m) k r1 kl (LtS m k lt)))

