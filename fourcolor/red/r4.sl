; red4's make_eng; None where red4 would fail an assertion or an index check.
(def-fns _ $ (many r4-make-eng : (many (Nat) h-m) (erased (List (MaybeUninit (WRow))) rp-m rb-m) (erased (List (Copy (Nat))) ns-m) (unique (Array (MaybeUninit (WRow)) rp-m) lp-m)
    (unique (Array (MaybeUninit (WRow)) rb-m) lb-m) (unique (Array (Copy (Nat)) ns-m) ln-m) (erased (WSt rp-m rb-m ns-m) st-m) ->
    (erased (List (MaybeUninit (WRow))) rp2 rb2) (erased (List (Copy (Nat))) ns2) (unique (Array (MaybeUninit (WRow)) rp2) lp2 at lp-m)
    (unique (Array (MaybeUninit (WRow)) rb2) lb2 at lb-m) (unique (Array (Copy (Nat)) ns2) ln2 at ln-m) (erased (WSt rp2 rb2 ns2) st2) (many (Maybe (Eng h-m)) r-m))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e2 (Refl _ _))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e17 (Refl _ _))
  (let-match many (lt-dec (Succ (Succ h-m)) 17) (Yes _ _ _ _ h2l) ((No _ _ _ _ _) (values rp-m rb-m ns-m lp-m lb-m ln-m st-m (None _))))
  (let ((erased hl-m)) (lt-trans (Succ h-m) (Succ (Succ h-m)) 17 (lt-succ _) h2l))
  (let ((erased hb1)) (lt-trans (Succ h-m) 17 u62-modulus hl-m r4-17-u62))
  (let ((erased hb2)) (lt-trans (Succ (Succ h-m)) 17 u62-modulus h2l r4-17-u62))
  (let ((many gtu) (erased gc-m) (erased gsh) (erased ne)) (gtree-full h-m))
  (let-match many (r4-nodes h-m gtu gsh ne) (Some _ nd-m) ((None _) (values rp-m rb-m ns-m lp-m lb-m ln-m st-m (None _))))
  (let ((many h1)) (u62-inc h-m hb1))
  (let ((many o-m) (erased of-m) (erased ob)) (r4-oget h1 hl-m))
  (let ((many e-m) (erased oe-m) (erased eb)) (r4-oget (u62-inc h1 hb2) h2l))
  (let ((many N-m) (erased ae-m) (erased _)) (u62-sub e-m o-m eb (offs-mono (Succ h-m) o-m (Succ (Succ h-m)) e-m of-m oe-m (lt-weaken _ _ (lt-succ (Succ h-m))))))
  (let ((erased cs-m) (unique cn-m) (erased rz)) (array-make (Nat) N-m 0))
  (let ((erased es) (erased evs) (unique evb-m) (erased zev) (erased nb-m)) (r4-tabs h-m hl-m e-m oe-m eb))
  (let-match many nd-m (MkNodes _ _ xs-m na len-m lx ax ly-m pu-m pt ilo ihi iv-m lnb-m gz-m))
  (def-fns r4-lm0
    ; red4's count: the walk below node g, at depth k, of the pairs P of level k, adding their hits to the counts.
    ((many r4-count : (erased (List (Copy (Nat))) cs) (unique (Array (Copy (Nat)) cs) cn at cn-m) (erased (Nat) N) (erased (Length (Copy (Nat)) cs N) lc)
        (erased (List (U8)) us) (unique (Bytes us) evb at evb-m) (erased (Nat) len) (erased (Sz flag-w us len) z) (many (Nat) h at h-m) (erased (Lt (Succ h) 17) hl) (erased (Nat) o e)
        (erased (Offs (Succ h) o) of) (erased (Offs (Succ (Succ h)) e) oe) (erased (Add o N e) ae) (erased (Lt e (Succ len)) el)
        (erased (List (Copy (Nat))) xs) (many (Array (Copy (Nat)) xs) nd at na) (erased (AllCu xs) au)
        (erased (List (MaybeUninit (WRow))) rp rb) (erased (List (Copy (Nat))) ns) (unique (Array (MaybeUninit (WRow)) rp) lp at lp-m) (unique (Array (MaybeUninit (WRow)) rb) lb at lb-m)
        (unique (Array (Copy (Nat)) ns) ln at ln-m) (erased (WSt rp rb ns) st)
        (many (Nat) k g) (subterm erased (Nat) j) (subterm erased (Gtree) s0) (erased (NLay xs j g s0) ly) (erased (Add k j h) akj)
        (erased (List (WP)) P) (erased (WLv rp rb ns k P) lv) (erased (List (WEv)) E0) (erased (CntR cs us o E0 N) r) (erased (Nat) B F F2 D) (erased (CuLe cs B) al) (erased (Bud B F r4-g15) bd) (erased (DlR j D) dl) (erased (Trp D F2 F) tp) ->
        (erased (List (Copy (Nat))) cs2) (unique (Array (Copy (Nat)) cs2) cn2 at cn) (erased (Length (Copy (Nat)) cs2 N) lc2) (unique evb is ev2 at evb)
        (erased (List (MaybeUninit (WRow))) rp2 rb2) (erased (List (Copy (Nat))) ns2) (unique (Array (MaybeUninit (WRow)) rp2) lp2 at lp)
        (unique (Array (MaybeUninit (WRow)) rb2) lb2 at lb) (unique (Array (Copy (Nat)) ns2) ln2 at ln) (erased (WSt rp2 rb2 ns2) st2)
        (erased (Agr (MaybeUninit (WRow)) (Succ k) rp rp2) fp) (erased (Agr (MaybeUninit (WRow)) (Succ k) rb rb2) fb) (erased (Agr (Copy (Nat)) (Succ k) ns ns2) fn)
        (erased (List (WEv)) E) (erased (WWk k (Succ j) (GSG s0) P E0 E) wk) (erased (WkU us k (Succ j) (GSG s0) P E0 E wk) wu) (erased (CntR cs2 us o E N) r2) (erased (Nat) Bo) (erased (CuLe cs2 Bo) al2) (erased (Bud Bo F2 r4-g15) bd2))
      (let-match erased r4-e0 (Refl _ _))
      (let-match erased r4-one (Refl _ _))
      (let-match erased r4-e2 (Refl _ _))
      (let-match erased r4-e3 (Refl _ _))
      (let-match erased r4-e4s (Refl _ _))
      (let ((erased hb)) (lt-trans h 17 u62-modulus (lt-succ-left h 17 hl) r4-17-u62))
      (let ((erased kl17)) (lt-le-trans k (Succ h) 17 (add-le-left k j h akj) (lt-weaken (Succ h) 17 hl)))
      (match many (u62-eq k h (le-u62 k h (add-le-left k j h akj) hb) hb) _
        ((Equal _ _ _)
          (let-match erased (add-cancel k j (Zero) k akj (add-zero-right k)) (Refl _ _))
          (let-match erased ly (NlL _ _ w b m ftr fu _ x d lm))
          (let-match erased x (MkWElt _ _ _ nw))
          (let-match many (array-get-many _ _ nd g _ nw) (MkCopy _ wv))
          (let-match erased lv (MkWLv _ _ _ _ _ xs1 ys1 ra rb0 n wd o1 o2 W jb xp xb xn nw1 pw of1 of2 aw ak ps))
          (let-match erased st (MkWSt _ _ _ wp wbr lns uns))
          (let ((many nv) (unique ln1)) (array-get _ _ ln k n xn))
          (let-match erased (offs-fn (Succ k) o2 o of2 of) (Refl _ _))
          (let ((erased W3) (erased tw)) (thrice-exists W))
          (let-match erased (add-cancel o N W3 e ae (offs-step k o1 o e W W3 of2 oe of1 aw tw)) (Refl _ _))
          (let-match erased dl (DlZ))
          (let-match erased r4-e17 (Refl _ _))
          (let ((erased nkp)) (lt-le-trans n (Succ wd) r4-kp nw1 (LtS wd r4-kp (pow2-lt k 17 wd r4-kp (add-le-left k jb 16 ak) pw r4-pkp))))
          (let ((erased rr) (erased ar)) (sub r4-kp n (lt-weaken n r4-kp nkp)))
          (let ((erased F1) (erased tp1) (erased tp2)) (trp-split n rr r4-kp F2 F ar tp))
          (let ((erased cs2) (unique cn2) (erased lc2) (unique ev2) (unique lp2) (unique lb2) (erased E) (erased lf) (erased r2) (erased Bc) (erased alc) (erased bdc))
            (r4-cnt-lf cs cn N lc us evb len z h hl o e of ae el wv (allcu-lt xs g w au nw) b m ftr fu d s0 lm rp rb lp lb k xs1 ys1 ra rb0 xp xb W jb tw
              0 nv (allcu-lt ns k n uns xn) nv (AddZero nv) P ps E0 r B F F1 al bd tp1))
          (let ((erased fp) (erased fb) (erased fn)) (wst-agr rp rb ns st k kl17))
          (let ((erased Bo) (erased al2) (erased bd2)) (bud-trp cs2 Bc F1 r4-g15 rr F2 alc bdc tp2))
          (values cs2 cn2 lc2 ev2 rp rb ns lp2 lb2 ln1 st fp fb fn E (WwLeaf k (GSG s0) P E0 E lf) (WkuLeaf us k (GSG s0) P E0 E lf) r2 Bo al2 bd2))
        ((Unequal _ _ _ _ ap)
          (let-match erased j (Succ j1) (absurd (Zero) (let-match erased (add-fn k (Zero) h k akj (add-zero-right k)) (Refl _ _)) (apart-irrefl k ap)))
          (let-match erased ly (NlN _ _ _ w b cm ftr fu c0 c1 c2 c3 x d bb k0 k1 k2 k3))
          (let-match erased x (MkWElt _ _ _ nw))
          (let-match many (array-get-many _ _ nd g _ nw) (MkCopy _ wv))
          (let ((erased t)) (GNode c0 c1 c2 c3))
          (let ((erased nl))
            (NlsCons xs j1 b cm (Zero) t c0 _ (GPush) (LtZ _) (SnPush) (GSelN c0 c1 c2 c3 c0 (GPush) (PkPush _ c0 c1 c2 c3)) k0
              $ NlsCons xs j1 b cm (Succ (Zero)) t c1 _ (GSkip) (LtS _ _ (LtZ _)) (SnSkip) (GSelN c0 c1 c2 c3 c1 (GSkip) (PkSkip _ c0 c1 c2 c3)) k1
              $ NlsCons xs j1 b cm (Succ (Succ (Zero))) t c2 _ (GPop0) (LtS _ _ (LtS _ _ (LtZ _))) (SnPop0) (GSelN c0 c1 c2 c3 c2 (GPop0) (PkPop0 _ c0 c1 c2 c3)) k2
              $ NlsCons xs j1 b cm (Succ (Succ (Succ (Zero)))) t c3 _ (GPop1) (LtS _ _ (LtS _ _ (LtS _ _ (LtZ _)))) (SnPop1) (GSelN c0 c1 c2 c3 c3 (GPop1) (PkPop1 _ c0 c1 c2 c3)) k3
              $ NlsNil xs j1 b cm t))
