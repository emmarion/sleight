  (let ((erased t12)) (add-lt-mono 8 s 4 t 12 a8 r4-a8412 sl))
  (let ((many tv)) (u62-add 8 s t a8 (lt-trans t 12 u62-modulus t12 r4-12-u62)))
  (let ((many z) (erased v1) (erased pv1) (erased m1) (erased r1) (erased mm1) (erased ad1) (erased rl1) (erased zb)) (u62-shr w tv wb (lt-trans t 12 (Succ sixty-two) t12 r4-twelve-lt)))
  (let ((erased lo1) (erased y) (erased lo2) (erased q1) (erased q2) (erased _)) (bsp-split 8 s t w r1 z a8 (bsp-of t v1 z m1 r1 w pv1 mm1 ad1 rl1)))
  (let ((erased _) (erased ey)) (bsp-fn 8 w lo1 y lo8 y2 q1 q8))
  (let-match erased ey (Refl _ _))
  (let ((erased x) (erased z1) (erased bi) (erased c)) (bsp-bitis s 4 y2 lo2 z cm b q2 p3 sl))
  (let ((many v) (erased pa)) (u62-and z 1 zb r4-1-u62))
  (values v x bi (and1-bit z v z1 x pa c)))

; ts are the children of t from the symbol numbered s on, each laid out as the child of a node of xs whose children cm start at b.
(def-adts $ (NLs : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Gtree) t) ((Nat) s) ((List (Gtree)) ts) -> Type)
  enum
  (many NlsNil : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm) (erased (Gtree) t) -> (NLs xs j b cm t 4 (Nil (Gtree))))
  (many NlsCons : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s) (erased (Gtree) t c) (erased (List (Gtree)) ts) (erased (Gsym) g) (erased (Lt s 4) l)
      (erased (SymN s g) sn) (erased (GSel (GSG t) g (GSG c)) sl) (erased (NLayK xs j b cm s c) k) (erased (NLs xs j b cm t (Succ s) ts) r)
      -> (NLs xs j b cm t s (Cons (Gtree) c ts))))

(def-adts
  ; Every filter of the walk w reads us.
  ((WkU : ((List (U8)) us) ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((List (WEv)) E0) ((List (WEv)) E) ((WWk k j gs P E0 E) w) -> Type)
    enum
    (many WkuNil : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs) (erased (List (WEv)) E0) -> (WkU us k j gs (Nil (WP)) E0 E0 (WwNil k j gs E0)))
    (many WkuZero : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0) (erased (NoMC gs j) z)
        -> (WkU us k j gs P E0 E0 (WwZero k j gs P E0 z)))
    (many WkuLeaf : (erased (List (U8)) us) (erased (Nat) k) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E) (erased (WLf gs P E0 E) l)
        -> (WkU us k (Succ (Zero)) gs P E0 E (WwLeaf k gs P E0 E l)))
    (many WkuStep : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs g0 g1 g2 g3) (erased (List (WP)) P Q0 Q1 Q2 Q3) (erased (List (WEv)) E0 E1 E2 E3 E4)
        (erased (WSy k j gs P (GPush) g0 Q0 E0 E1) y0) (erased (WSy k j gs P (GSkip) g1 Q1 E1 E2) y1) (erased (WSy k j gs P (GPop0) g2 Q2 E2 E3) y2)
        (erased (WSy k j gs P (GPop1) g3 Q3 E3 E4) y3) (erased (WyU us k j gs P (GPush) g0 Q0 E0 E1 y0) u0) (erased (WyU us k j gs P (GSkip) g1 Q1 E1 E2 y1) u1)
        (erased (WyU us k j gs P (GPop0) g2 Q2 E2 E3 y2) u2) (erased (WyU us k j gs P (GPop1) g3 Q3 E3 E4 y3) u3)
        -> (WkU us k (Succ (Succ j)) gs P E0 E4 (WwStep k j gs g0 g1 g2 g3 P Q0 Q1 Q2 Q3 E0 E1 E2 E3 E4 y0 y1 y2 y3))))
  ((WyU : ((List (U8)) us) ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((Gsym) s) ((GSet) g1) ((List (WP)) Q) ((List (WEv)) E0) ((List (WEv)) E)
      ((WSy k j gs P s g1 Q E0 E) y) -> Type)
    enum
    (many WyuNone : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0)
        (erased (GSel gs s g1) sl) (erased (WStp s P Q) st) (erased (NoMC g1 (Succ j)) z) -> (WyU us k j gs P s g1 Q E0 E0 (WyNone k j gs g1 P Q s E0 sl st z)))
    (many WyuGo : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q R) (erased (Gsym) s) (erased (List (WEv)) E0 E1 E)
        (erased (GSel gs s g1) sl) (erased (WStp s P Q) st) (erased (WFlt us (Succ k) (Succ j) Q R E0 E1) f) (erased (WWk (Succ k) (Succ j) g1 R E1 E) w)
        (erased (WkU us (Succ k) (Succ j) g1 R E1 E w) u) -> (WyU us k j gs P s g1 Q E0 E (WyGo us k j gs g1 P Q R s E0 E1 E sl st f w)))))

; The walk's parts for the symbols numbered from s on make E from E0, each filter reading us.
(def-adts $ (WSs : ((List (U8)) us) ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((Nat) s) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many WssNil : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0) -> (WSs us k j gs P 4 E0 E0))
  (many WssCons : (erased (List (U8)) us) (erased (Nat) k j s) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) g) (erased (List (WEv)) E0 E1 E)
      (erased (SymN s g) sn) (erased (WSy k j gs P g g1 Q E0 E1) y) (erased (WyU us k j gs P g g1 Q E0 E1 y) u) (erased (WSs us k j gs P (Succ s) E1 E) r)
      -> (WSs us k j gs P s E0 E)))

(def-fns _ $ (erased wss-wwk : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E)
    (erased (WSs us k j gs P (Zero) E0 E) ws) -> (erased (WWk k (Succ (Succ j)) gs P E0 E) w) (erased (WkU us k (Succ (Succ j)) gs P E0 E w) u))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased ws (WssCons _ _ _ _ _ g0 _ Q0 _ _ E1 _ sn0 y0 u0 w1))
  (let-match erased sn0 (SnPush))
  (let-match erased w1 (WssCons _ _ _ _ _ g1 _ Q1 _ _ E2 _ sn1 y1 u1 w2))
  (let-match erased sn1 (SnSkip))
  (let-match erased w2 (WssCons _ _ _ _ _ g2 _ Q2 _ _ E3 _ sn2 y2 u2 w3))
  (let-match erased sn2 (SnPop0))
  (let-match erased w3 (WssCons _ _ _ _ _ g3 _ Q3 _ _ E4 _ sn3 y3 u3 w4))
  (let-match erased sn3 (SnPop1))
  (let-match erased w4 (WssNil _ _ _ _ _ _) (absurd (WssCons _ _ _ _ _ _ _ _ _ _ _ _ sn4 _ _ _) sn4))
  (values (WwStep k j gs g0 g1 g2 g3 P Q0 Q1 Q2 Q3 E0 E1 E2 E3 E y0 y1 y2 y3) (WkuStep us k j gs g0 g1 g2 g3 P Q0 Q1 Q2 Q3 E0 E1 E2 E3 E y0 y1 y2 y3 u0 u1 u2 u3)))

(def-fns _ $ (erased agr-nth-refl : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x) (subterm erased (Nth A xs i x) n) -> (erased (Agr A (Succ i) xs xs) r))
  (match erased n _
    ((NthHere _ _ xs1) (AgS _ (Zero) x xs1 xs1 (AgZ _ xs1 xs1)))
    ((NthThere _ y xs1 m1 _ n1) (AgS _ (Succ m1) y xs1 xs1 (agr-nth-refl _ xs1 m1 x n1)))))

(def-fns _ $ (erased wst-agr : (erased (List (MaybeUninit (WRow))) rp rb) (erased (List (Copy (Nat))) ns) (erased (WSt rp rb ns) st) (erased (Nat) k) (erased (Lt k 17) kl)
    -> (erased (Agr (MaybeUninit (WRow)) (Succ k) rp rp) fp) (erased (Agr (MaybeUninit (WRow)) (Succ k) rb rb) fb) (erased (Agr (Copy (Nat)) (Succ k) ns ns) fn))
  (let-match erased st (MkWSt _ _ _ wp wb lns _))
  (let ((erased _) (erased _) (erased _) (erased xp) (erased _) (erased _) (erased _)) (wrws-get rp (Zero) k wp kl (LtZ k)))
  (let ((erased _) (erased _) (erased _) (erased xb) (erased _) (erased _) (erased _)) (wrws-get rb (Zero) k wb kl (LtZ k)))
  (values (agr-nth-refl _ rp k _ xp) (agr-nth-refl _ rb k _ xb) (agr-refl _ (Succ k) ns 17 lns (LtS k 17 kl))))

(def-fns _ $ (erased agr-step : (erased Type A) (erased (Nat) k) (erased (List A) xs ys zs) (erased (Agr A (Succ k) xs ys) g) (erased (Agr A (Succ (Succ k)) ys zs) h)
    -> (erased (Agr A (Succ k) xs zs) r))
  (agr-trans _ (Succ k) xs ys zs g (agr-mono _ (Succ (Succ k)) (Succ k) ys zs h (lt-weaken (Succ k) (Succ (Succ k)) (lt-succ (Succ k))))))



; From the node at the prefix q of depth k, the path along rest to its trace meets a trie node of us with entry 0 above the trace when b is
; BFalse, and none when b is BTrue.
(def-adts $ (WPz : ((List (U8)) us) ((Nat) k) ((Nat) q) ((List (Col)) rest) ((Bool) b) -> Type)
  enum
  (many WpzLeaf : (erased (List (U8)) us) (erased (Nat) k q) (erased (Col) e) -> (WPz us k q (Cons (Col) e (Nil (Col))) (BTrue)))
  (many WpzZero : (erased (List (U8)) us) (erased (Nat) k q q2 o n) (erased (Col) e e2) (erased (List (Col)) rest) (erased (Kid q e q2) kq) (erased (Offs (Succ k) o) of)
      (erased (Add o q2 n) ad) (erased (Elt flag-w us n (Zero)) z) -> (WPz us k q (Cons (Col) e (Cons (Col) e2 rest)) (BFalse)))
  (many WpzNz : (erased (List (U8)) us) (erased (Nat) k q q2 o n v) (erased (Col) e e2) (erased (List (Col)) rest) (erased (Bool) b) (erased (Kid q e q2) kq)
      (erased (Offs (Succ k) o) of) (erased (Add o q2 n) ad) (erased (Elt flag-w us n v) x) (erased (Apart (Nat) Lt v (Zero)) nz)
      (erased (WPz us (Succ k) q2 (Cons (Col) e2 rest) b) p) -> (WPz us k q (Cons (Col) e (Cons (Col) e2 rest)) b)))

; The hits c0 and cover d0 become c and d, with the cover kept when b is BTrue and the hits kept when b is BFalse.
(def-adts $ (WPr : ((Bool) b) ((Nat) c0) ((Bool) d0) ((Nat) c) ((Bool) d) -> Type)
  enum
  (many WprT : (erased (Nat) c0 c) (erased (Bool) d) -> (WPr (BTrue) c0 d c d))
  (many WprF : (erased (Nat) c) (erased (Bool) d0 d) -> (WPr (BFalse) c d0 c d)))

(def-fns _ $ (erased wpr-refl : (erased (Bool) b) (erased (Nat) c) (erased (Bool) d) -> (erased (WPr b c d c d) r))
  (match erased b _ ((BTrue) (WprT c c d)) ((BFalse) (WprF c d d))))

(def-fns _ $ (erased wpr-trans : (erased (Bool) b d0 d1 d2) (erased (Nat) c0 c1 c2) (erased (WPr b c0 d0 c1 d1) p) (erased (WPr b c1 d1 c2 d2) q) -> (erased (WPr b c0 d0 c2 d2) r))
  (match erased p _
    ((WprT _ _ _) (let-match erased q (WprT _ _ _)) (WprT c0 c2 d0))
    ((WprF _ _ _) (let-match erased q (WprF _ _ _)) (WprF c0 d0 d2))))

(def-fns _ $ (erased wgr-zero : (erased (Nat) c0 c) (erased (Bool) d0 d) (erased (WGr c0 d0 (Zero) c d) g) -> (erased (Eq (Nat) c c0) e))
  (let ((erased m) (erased a) (erased l) (erased l0)) (wgr-le c0 (Zero) c d0 d g))
  (let-match erased (add-fn c0 (Zero) m c0 a (add-zero-right c0)) (Refl _ _))
  (let-match erased (nat-eq c c0) (Unequal _ _ _ _ ap) ((Equal _ _ _) (Refl _ c)))
  (match erased ap _ (absurd (ApLt _ _ _ _ q) (lt-asym c c0 q l0)) (absurd (ApGt _ _ _ _ q) (lt-asym c0 c q l))))

(def-fns _ $ (erased wct-exists : (subterm erased (List (WP)) P) (erased (GSet) gs) (erased (Nat) q) (erased (List (Col)) rest) -> (erased (Nat) c) (erased (WCt P gs q rest c) pc))
  (let-match erased P (Cons _ x P1) ((Nil _) (values (Zero) (WcNil gs q rest))))
  (let-match erased x (MkWP p bs))
  (let ((erased c1) (erased pc1)) (wct-exists P1 gs q rest))
  (let-match erased (nat-eq p q) (Equal _ _ _) ((Unequal _ _ _ _ ap) (values c1 (WcMiss p q c1 bs P1 gs rest ap pc1))))
  (let ((erased _) (erased k) (erased _) (erased _) (erased pk)) (wct-hit q c1 bs P1 gs rest pc1))
  (values k pk))

(def-fns _ $ (erased apart-flip : (erased (Nat) a b) (erased (Apart (Nat) Lt a b) p) -> (erased (Apart (Nat) Lt b a) q))
  (match erased p _ ((ApLt _ _ _ _ l) (ApGt (Nat) Lt b a l)) ((ApGt _ _ _ _ l) (ApLt (Nat) Lt b a l))))

; Two trie nodes of depth k with different entries have different prefixes.
(def-fns _ $ (erased node-ap : (erased (List (U8)) us) (erased (Nat) k q1 o1 n1 v1 q o n v) (erased (Offs k o1) of1) (erased (Add o1 q1 n1) ad1) (erased (Elt flag-w us n1 v1) e1)
    (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n v) e) (erased (Apart (Nat) Lt v1 v) nv) -> (erased (Apart (Nat) Lt q1 q) r))
  (match erased (nat-eq q1 q) _
    (absurd (Equal _ _ _)
      (let-match erased (offs-fn k o1 o of1 of) (Refl _ _))
      (let-match erased (add-fn o q n1 n ad1 ad) (Refl _ _))
      (let-match erased (elt-fn flag-w us n v1 v e1 e) (Refl _ _))
      (apart-irrefl v nv))
