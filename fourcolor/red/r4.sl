  enum
  (many EaNil : -> (EsAt (Nil (Col)) (ESStart)))
  (many EaCons : (erased (List (Col)) pre) (erased (ES) st st2) (erased (Col) e) (erased (EsAt pre st) a) (erased (ESStep st e st2) s) -> (EsAt (Cons (Col) e pre) st2)))

(def-fns _ $ (erased erun-shift : (erased (List (Col)) w et) (erased (ES) st) (erased (Bool) b) (subterm erased (List (Col)) pre) (erased (EsAt pre st) a)
    (erased (RevApp (Col) pre w et) ra) (erased (ERun (ESStart) et b) er) -> (erased (ERun st w b) r))
  (match erased pre _
    ((Nil _) (let-match erased a (EaNil)) (let-match erased ra (RANil _ _)) er)
    ((Cons _ e pre1)
      (let-match erased a (EaCons _ s0 _ _ a1 sp))
      (let-match erased ra (RACons _ _ _ _ _ ra1))
      (let-match erased (erun-shift (Cons _ e w) et s0 b pre1 a1 ra1 er) (ERCons _ s2 _ _ _ sp2 r2))
      (let-match erased (esstep-fn s0 st s2 e sp sp2) (Refl _ _))
      r2)))

(def-fns _ $ (erased uca-get : (erased (List Cnt) us) (erased (List (Copy (Nat))) cs) (erased (Nat) n i) (subterm erased (UcA us cs n) a) (erased (Lt i n) l)
    -> (erased (Nat) c) (erased (WElt cs i c) w) (erased (Elt cnt-w us i c) x))
  (let-match erased a (UaS _ _ n1 c1 a1 w1 x1) (absurd (UaZ _ _) l))
  (let-match erased (nat-eq i n1) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values c1 w1 x1)))
  (let-match erased ap (ApLt _ _ _ _ lt) (absurd (ApGt _ _ _ _ gt) (lt-asym n1 i gt l)))
  (uca-get us cs n1 i a1 lt))

; GE, CEv and CtH for the subtree t at the prefix p of the colours pre of the counts vs that make_eng builds.
(def-fns _ $ (erased r4-bridge : (erased (List (Copy (Nat))) cs) (erased (List (U8)) es evs) (erased (List Cnt) vs) (erased (Nat) h o e N) (erased (Gtree) gtu)
