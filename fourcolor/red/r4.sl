(def-fns _ $ (erased skip-subt : (erased (Nat) cm s s2) (erased (List (Gtree)) ts ts3) (erased (Gtree) t) (subterm erased (KSkip cm s ts s2 (Cons (Gtree) t ts3)) sk)
