  (many XbPush : (erased (Bstack) bs) (erased (Nat) b2) (erased (Bn (BP0 bs) b2) bn) -> (XtB bs (GPush) b2))
  (many XbSkip : (erased (Bstack) bs) (erased (Nat) b2) (erased (Bn bs b2) bn) -> (XtB bs (GSkip) b2))
  (many XbPop : (erased (Bstack) bs c) (erased (Gsym) g) (erased (Nat) b2) (erased (IsPop g) ip) (erased (Popped bs c) pp) (erased (Bn c b2) bn) -> (XtB bs g b2))
  (many XbNone : (erased (Gsym) g) (erased (Nat) b2) (erased (IsPop g) ip) -> (XtB (BS0) g b2)))

