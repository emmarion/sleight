      (let-match erased pc (BC0 _ dc ddc))
      (double-le-mono c1 a1 dc da l1 ddc dda))
    ((Ap01 _ _ _)
      (let-match erased pa (BC0 _ da dda))
      (let-match erased pc (BC0 _ dc ddc))
      (double-le-mono c1 a1 dc da l1 ddc dda))
    ((Ap10 _ _ _)
      (let-match erased pa (BC1 _ da dda))
      (let-match erased pc (BC0 _ dc ddc))
      (lt-weaken c (Succ da) (double-le-mono c1 a1 dc da l1 ddc dda)))
    ((Ap11 _ _ _)
      (let-match erased pa (BC1 _ da dda))
      (let-match erased pc (BC1 _ dc ddc))
      (LtS dc (Succ da) (double-le-mono c1 a1 dc da l1 ddc dda)))))

(def-fns _ $ (many r4-in-gu : (many (Nat) w) (erased (Lt w u62-modulus) wb) (erased (Nat) b cm ftr fu) (erased (NWd w b cm ftr fu) d) -> (many fu is x) (erased (Lt x u62-modulus) xb))
