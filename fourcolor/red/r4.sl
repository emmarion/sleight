(def-fns _ $ (erased wflt-z : (erased (List (U8)) us) (erased (Nat) k j q o n) (erased (GSet) g) (erased (List (Col)) rest) (erased (List (WP)) Q R) (erased (List (WEv)) E0 E1)
    (subterm erased (WFlt us k j Q R E0 E1) f) (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z) -> (erased (WCt R g q rest (Zero)) pc))
  (match erased f _
    ((WfNil _ _ _ _) (WcNil g q rest))
    ((WfKeep _ _ _ q1 o1 n1 v1 bs Q1 R1 _ _ of1 ad1 e1 nz f1)
      (WcMiss q1 q (Zero) bs R1 g rest (node-ap us k q1 o1 n1 v1 q o n (Zero) of1 ad1 e1 of ad z nz) (wflt-z us k j q o n g rest Q1 R1 E0 E1 f1 of ad z)))
    ((WfDrop _ _ _ _ _ _ _ Q1 _ _ _ _ _ _ f1) (wflt-z us k j q o n g rest Q1 R _ E1 f1 of ad z))))

(def-fns _ $ (erased wflt-nz : (erased (List (U8)) us) (erased (Nat) k j q o n v i c) (erased (Bool) d) (erased (List (Col)) rest) (erased (List (WP)) Q R)
    (erased (List (WEv)) E0 E1) (subterm erased (WFlt us k j Q R E0 E1) f) (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n v) x)
    (erased (Apart (Nat) Lt v (Zero)) nz) (erased (TIdx q rest i) ti) (erased (Length (Col) rest j) le) (erased (WSm E0 i c d) sm) -> (erased (WSm E1 i c d) sm1))
  (match erased f _
    ((WfNil _ _ _ _) sm)
    ((WfKeep _ _ _ _ _ _ _ _ Q1 R1 _ _ _ _ _ _ f1) (wflt-nz us k j q o n v i c d rest Q1 R1 E0 E1 f1 of ad x nz ti le sm))
    ((WfDrop _ _ _ q1 o1 n1 _ Q1 _ _ _ of1 ad1 z1 f1)
      (wflt-nz us k j q o n v i c d rest Q1 R _ E1 f1 of ad x nz ti le
        (WmOut E0 us k j q1 o1 n1 i c q d of1 ad1 z1 rest sm ti le (node-ap us k q1 o1 n1 (Zero) q o n v of1 ad1 z1 of ad x (apart-flip v (Zero) nz)))))))

(def-fns _
  ((erased ww-pz : (erased (List (U8)) us) (erased (Nat) k j q i c0) (erased (Bool) b d0) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E)
      (erased (List (Col)) rest) (subterm erased (WWk k j gs P E0 E) w) (erased (WkU us k j gs P E0 E w) u) (erased (TIdx q rest i) ti) (erased (Length (Col) rest j) le)
      (erased (WPz us k q rest b) pz) (erased (WSm E0 i c0 d0) sm) -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WPr b c0 d0 c1 d1) pr))
    (match erased w _
      ((WwNil _ _ _ _) (values c0 d0 sm (wpr-refl b c0 d0)))
      ((WwZero _ _ _ _ _ _) (values c0 d0 sm (wpr-refl b c0 d0)))
      ((WwLeaf _ _ _ _ _ l)
        (let-match erased le (LengthCons _ e r1 _ le1))
        (let-match erased le1 (LengthNil _))
        (let-match erased ti (TICons _ iq _ _ _ ke ti1))
        (let-match erased ti1 (TINil _))
        (let-match erased pz (WpzLeaf _ _ _ _))
        (let ((erased c) (erased pc)) (wct-exists P gs q rest))
        (let ((erased c1) (erased sm1) (erased _)) (wlf-trace gs P E0 E q i c c0 d0 e l pc ke sm))
        (values c1 d0 sm1 (WprT c0 c1 d0)))
      ((WwStep _ j1 _ g0 g1 g2 g3 _ Q0 Q1 Q2 Q3 _ E1 E2 E3 _ y0 y1 y2 y3)
        (let-match erased u (WkuStep _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ u0 u1 u2 u3))
        (let-match erased le (LengthCons _ e rest1 _ le1))
        (let-match erased ti (TICons _ q2 _ _ _ kq ti1))
        (let ((erased ca) (erased da) (erased ma) (erased pa)) (wy-pz us k j1 q q2 i c0 b d0 gs g0 P Q0 (GPush) E0 E1 e rest1 y0 u0 kq ti1 le1 pz sm))
        (let ((erased cb) (erased db) (erased mb) (erased pb)) (wy-pz us k j1 q q2 i ca b da gs g1 P Q1 (GSkip) E1 E2 e rest1 y1 u1 kq ti1 le1 pz ma))
        (let ((erased cz) (erased dc) (erased mc) (erased pcc)) (wy-pz us k j1 q q2 i cb b db gs g2 P Q2 (GPop0) E2 E3 e rest1 y2 u2 kq ti1 le1 pz mb))
        (let ((erased cd) (erased dd) (erased md) (erased pd)) (wy-pz us k j1 q q2 i cz b dc gs g3 P Q3 (GPop1) E3 E e rest1 y3 u3 kq ti1 le1 pz mc))
        (values cd dd md (wpr-trans b d0 da dd c0 ca cd pa (wpr-trans b da db dd ca cb cd pb (wpr-trans b db dc dd cb cz cd pcc pd)))))))
  ((erased wy-pz : (erased (List (U8)) us) (erased (Nat) k j q q2 i c0) (erased (Bool) b d0) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s)
      (erased (List (WEv)) E0 E) (erased (Col) e) (erased (List (Col)) rest) (subterm erased (WSy k j gs P s g1 Q E0 E) y) (erased (WyU us k j gs P s g1 Q E0 E y) u)
      (erased (Kid q e q2) kq) (erased (TIdx q2 rest i) ti) (erased (Length (Col) rest (Succ j)) le) (erased (WPz us k q (Cons (Col) e rest) b) pz)
      (erased (WSm E0 i c0 d0) sm) -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WPr b c0 d0 c1 d1) pr))
    (let-match erased y (WyGo _ _ _ _ _ _ _ R _ _ E1 _ _ _ f w) ((WyNone _ _ _ _ _ _ _ _ _ _ _) (values c0 d0 sm (wpr-refl b c0 d0))))
    (let-match erased u (WyuGo _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ wu))
    (match erased pz _
      (absurd (WpzLeaf _ _ _ _) le)
      ((WpzZero _ _ _ q3 o n _ _ _ kq3 of ad z)
        (let-match erased (kid-dec q q3 q2 e e kq3 kq) (KcSame _ _) (absurd (KcNe _ _ _ _ ne _) ne))
        (let ((erased k1) (erased pc)) (wct-exists Q g1 q2 rest))
        (let ((erased _) (erased d1) (erased _) (erased sm1) (erased _)) (wflt-ct us (Succ k) (Succ j) q2 k1 i c0 d0 g1 rest Q R E0 E1 f pc ti le sm))
        (let ((erased c1) (erased d2) (erased sm2) (erased g))
          (ww-trace (Succ k) (Succ j) q2 (Zero) i c0 d1 g1 R E1 E rest w ti le (wflt-z us (Succ k) (Succ j) q2 o n g1 rest Q R E0 E1 f of ad z) sm1))
        (let-match erased (wgr-zero c0 c1 d1 d2 g) (Refl _ _))
        (values c1 d2 sm2 (WprF c0 d0 d2)))
      ((WpzNz _ _ _ q3 o n v _ _ _ _ kq3 of ad x nz pz1)
        (let-match erased (kid-dec q q3 q2 e e kq3 kq) (KcSame _ _) (absurd (KcNe _ _ _ _ ne _) ne))
        (ww-pz us (Succ k) (Succ j) q2 i c0 b d0 g1 R E1 E rest w wu ti le pz1 (wflt-nz us (Succ k) (Succ j) q2 o n v i c0 d0 rest Q R E0 E1 f of ad x nz ti le sm))))))

(comptime-match many (r4-eq-pf 5 (Succ 4)) (ESome _ r4-e5))
(comptime-match many (lt-dec 5 flag-u8m) (Yes _ _ _ _ r4-5-u8))

; c is red4's es code of the state st: 3 at the start, the digit of the first colour in a tail, 4 even, 5 odd.
(def-adts $ (ESc : ((ES) st) ((Nat) c) -> Type)
  enum
  (many EscS : -> (ESc (ESStart) 3))
  (many Esc1 : -> (ESc (ESTail p123) (Zero)))
  (many Esc2 : -> (ESc (ESTail p312) (Succ (Zero))))
  (many Esc3 : -> (ESc (ESTail p231) (Succ (Succ (Zero)))))
  (many EscE : -> (ESc (ESEven) 4))
  (many EscO : -> (ESc (ESOdd) 5)))

; e2 is red4's es code for the child at the digit d of a node whose code is e.
(def-adts $ (ERs : ((Nat) e) ((Nat) d) ((Nat) e2) -> Type)
  enum
  (many RsS : (erased (Nat) d) -> (ERs 3 d d))
  (many RsE : (erased (Nat) d) -> (ERs 4 d 4))
  (many RsD : (erased (Nat) d) -> (ERs d d d))
  (many RsN : (erased (Nat) e d) (erased (Apart (Nat) Lt e 3) a3) (erased (Apart (Nat) Lt e 4) a4) (erased (Apart (Nat) Lt e d) ad) (erased (Mod (Succ e) 3 d) md)
      -> (ERs e d 4))
  (many RsO : (erased (Nat) e d r) (erased (Apart (Nat) Lt e 3) a3) (erased (Apart (Nat) Lt e 4) a4) (erased (Apart (Nat) Lt e d) ad) (erased (Mod (Succ e) 3 r) md)
      (erased (Apart (Nat) Lt d r) ar) -> (ERs e d 5)))

; The digit d is the colour c less one.
(def-adts $ (CD : ((Nat) d) ((Col) c) -> Type)
  enum
  (many Cd0 : -> (CD (Zero) (C1)))
  (many Cd1 : -> (CD (Succ (Zero)) (C2)))
  (many Cd2 : -> (CD (Succ (Succ (Zero))) (C3))))

; red4's es step: if e = 3 then d else if e = 4 || e = d then e else if d = (e + 1) mod 3 then 4 else 5.
(def-fns _ $ (many r4-esn : (many (Nat) e d) (erased (Lt e u8-modulus) eb) (erased (Lt d 3) dl) -> (many (Nat) e2) (erased (ERs e d e2) r) (erased (Lt e2 u8-modulus) e2b))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e5 (Refl _ _))
  (let ((erased e62)) (lt-trans e u8-modulus u62-modulus eb r4-u8-u62))
  (let ((erased l5)) (lt-le-trans 4 5 u8-modulus (lt-succ 4) (lt-weaken 5 u8-modulus r4-5-u8)))
  (let ((erased db)) (lt-trans d 3 u8-modulus dl (lt-trans 3 4 u8-modulus (lt-succ 3) l5)))
  (let-match many (u62-eq e 3 e62 r4-three-u62) (Unequal _ _ _ _ a3) ((Equal _ _ _) (values d (RsS d) db)))
  (let-match many (u62-eq e 4 e62 r4-four-u62) (Unequal _ _ _ _ a4) ((Equal _ _ _) (values e (RsE d) eb)))
  (let-match many (u62-eq e d e62 (lt-trans d u8-modulus u62-modulus db r4-u8-u62)) (Unequal _ _ _ _ ad) ((Equal _ _ _) (values e (RsD e) eb)))
  (let ((many r) (erased _) (erased md) (erased rb)) (u62-mod (u62-inc e (le-u62 (Succ e) u8-modulus (LtS e u8-modulus eb) r4-u8-u62)) 3 (le-u62 (Succ e) u8-modulus (LtS e u8-modulus eb) r4-u8-u62) r4-three-u62 (LtZ _)))
  (match many (u62-eq d r (lt-trans d u8-modulus u62-modulus db r4-u8-u62) rb) _
    ((Equal _ _ _) (values 4 (RsN e d a3 a4 ad md) l5))
    ((Unequal _ _ _ _ ar) (values 5 (RsO e d r a3 a4 ad md ar) r4-5-u8))))

(def-fns _ $ (erased mod-small : (erased (Nat) s c r) (erased (Mod s c r) m) (erased (Lt s c) l) -> (erased (Eq (Nat) r s) e))
  (match erased m _
    ((ModLt _ _ _) (Refl _ r))
    (absurd (ModSub s1 _ _ _ a _) (lt-irrefl s (lt-le-trans s c s l (add-le-left c s1 s a))))))

(def-fns _ $ (erased mod-self : (erased (Nat) c r) (erased (Mod c c r) m) (erased (Lt (Zero) c) cp) -> (erased (Eq (Nat) r (Zero)) e))
  (let-match erased m (ModSub s1 _ _ _ a m1) (absurd (ModLt _ _ l) (lt-irrefl c l)))
  (let-match erased (add-cancel c s1 (Zero) c a (add-zero-right c)) (Refl _ _))
  (mod-small (Zero) c r m1 cp))

; The code of the step of st, of the code e and not odd, by the colour c of the digit d is red4's.
(def-fns _ $ (erased rs-step : (erased (ES) st st2) (erased (Nat) e d e2) (erased (Col) c) (erased (ESc st e) sc) (erased (Lt e 5) el) (erased (CD d c) cd)
    (erased (ESStep st c st2) sp) (erased (ERs e d e2) rs) -> (erased (ESc st2 e2) r))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e5 (Refl _ _))
  (let ((erased l1) (erased l2) (erased l3)) (values (LtS _ _ (LtZ (Succ (Zero)))) (LtS _ _ (LtS _ _ (LtZ (Zero)))) (LtZ (Succ (Succ (Zero))))))
  (match erased sc _
    ((EscS)
      (let-match erased rs (RsS _) (absurd (RsD _) cd) (absurd (RsN _ _ a _ _ _) (apart-irrefl e a)) (absurd (RsO _ _ _ a _ _ _ _) (apart-irrefl e a)))
      (match erased cd _ ((Cd0) (let-match erased sp (EStS1)) (Esc1)) ((Cd1) (let-match erased sp (EStS2)) (Esc2)) ((Cd2) (let-match erased sp (EStS3)) (Esc3))))
    ((Esc1)
      (match erased cd _
        ((Cd0)
          (let-match erased rs (RsD _) (absurd (RsN _ _ _ _ a _) (apart-irrefl e a)) (absurd (RsO _ _ _ _ _ a _ _) (apart-irrefl e a)))
          (let-match erased sp (EStT1 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT2 _ _ p) p) (absurd (EStT3 _ _ p) p))
          (Esc1))
        ((Cd1)
          (let-match erased rs (RsN _ _ _ _ _ _) (absurd (RsO _ _ r _ _ _ md ar) (let-match erased (mod-small _ 3 r md l1) (Refl _ _)) (apart-irrefl d ar)))
          (let-match erased sp (EStT2 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT1 _ _ p) p) (absurd (EStT3 _ _ p) p))
          (EscE))
        ((Cd2)
          (let-match erased rs (RsO _ _ _ _ _ _ _ _) (absurd (RsN _ _ _ _ _ md) (mod-small _ 3 d md l1)))
          (let-match erased sp (EStT3 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT1 _ _ p) p) (absurd (EStT2 _ _ p) p))
          (EscO))))
    ((Esc2)
      (match erased cd _
        ((Cd0)
          (let-match erased rs (RsO _ _ _ _ _ _ _ _) (absurd (RsN _ _ _ _ _ md) (mod-small _ 3 d md l2)))
          (let-match erased sp (EStT3 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT1 _ _ p) p) (absurd (EStT2 _ _ p) p))
          (EscO))
        ((Cd1)
          (let-match erased rs (RsD _) (absurd (RsN _ _ _ _ a _) (apart-irrefl e a)) (absurd (RsO _ _ _ _ _ a _ _) (apart-irrefl e a)))
          (let-match erased sp (EStT1 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT2 _ _ p) p) (absurd (EStT3 _ _ p) p))
          (Esc2))
        ((Cd2)
          (let-match erased rs (RsN _ _ _ _ _ _) (absurd (RsO _ _ r _ _ _ md ar) (let-match erased (mod-small _ 3 r md l2) (Refl _ _)) (apart-irrefl d ar)))
          (let-match erased sp (EStT2 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT1 _ _ p) p) (absurd (EStT3 _ _ p) p))
          (EscE))))
    ((Esc3)
      (match erased cd _
        ((Cd0)
          (let-match erased rs (RsN _ _ _ _ _ _) (absurd (RsO _ _ r _ _ _ md ar) (let-match erased (mod-self 3 r md l3) (Refl _ _)) (apart-irrefl d ar)))
          (let-match erased sp (EStT2 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT1 _ _ p) p) (absurd (EStT3 _ _ p) p))
          (EscE))
        ((Cd1)
          (let-match erased rs (RsO _ _ _ _ _ _ _ _) (absurd (RsN _ _ _ _ _ md) (mod-self 3 d md l3)))
          (let-match erased sp (EStT3 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT1 _ _ p) p) (absurd (EStT2 _ _ p) p))
          (EscO))
        ((Cd2)
          (let-match erased rs (RsD _) (absurd (RsN _ _ _ _ a _) (apart-irrefl e a)) (absurd (RsO _ _ _ _ _ a _ _) (apart-irrefl e a)))
          (let-match erased sp (EStT1 _ _ _) (absurd (EStT0 _ _ p) p) (absurd (EStT2 _ _ p) p) (absurd (EStT3 _ _ p) p))
          (Esc3))))
    ((EscE) (let-match erased rs (RsE _) (absurd (RsD _) cd) (absurd (RsN _ _ _ a _ _) (apart-irrefl e a)) (absurd (RsO _ _ _ _ a _ _ _) (apart-irrefl e a))) (let-match erased sp (EStE _)) (EscE))
    (absurd (EscO) (lt-irrefl e el))))

; st is the state of ES over the colours of the path to the heap node n of the trie.
(def-adts $ (HSt : ((Nat) n) ((ES) st) -> Type)
  enum
  (many HxZ : -> (HSt (Zero) (ESStart)))
  (many HxS : (erased (Nat) m x) (erased (Col) e) (erased (ES) st st2) (erased (HSt m st) h) (erased (Kid m e x) k) (erased (ESStep st e st2) sp) -> (HSt (Succ x) st2)))

; The es and ev entries of the heap node n: es the code of its state and ev not 0 when the state is not odd; ev 0 when the state becomes odd at n.
(def-adts $ (NOk : ((List (U8)) es) ((List (U8)) evt) ((Nat) n) -> Type)
  enum
  (many NokL : (erased (List (U8)) es evt) (erased (Nat) n c v) (erased (ES) st) (erased (HSt n st) hs) (erased (ESc st c) sc) (erased (Lt c 5) cl)
      (erased (Elt flag-w es n c) x) (erased (Elt flag-w evt n v) y) (erased (Apart (Nat) Lt v (Zero)) nz) -> (NOk es evt n))
  (many NokD : (erased (List (U8)) es evt) (erased (Nat) m x c) (erased (Col) e) (erased (ES) st) (erased (HSt m st) hs) (erased (ESc st c) sc) (erased (Lt c 5) cl)
      (erased (Kid m e x) kd) (erased (ESStep st e (ESOdd)) sp) (erased (Elt flag-w evt (Succ x) (Zero)) y) -> (NOk es evt (Succ x)))
  (many NokO : (erased (List (U8)) es evt) (erased (Nat) m x) (erased (Col) e) (erased (HSt m (ESOdd)) hs) (erased (Kid m e x) kd) -> (NOk es evt (Succ x))))

; The heap nodes below m are as NOk says.
(def-adts $ (NBl : ((List (U8)) es) ((List (U8)) evt) ((Nat) m) -> Type)
  enum
  (many NbZ : (erased (List (U8)) es evt) -> (NBl es evt (Zero)))
  (many NbS : (erased (List (U8)) es evt) (erased (Nat) m) (erased (NBl es evt m) r) (erased (NOk es evt m) k) -> (NBl es evt (Succ m))))

; The entries m to len of ev are 1.
(def-adts $ (EvOne : ((List (U8)) evt) ((Nat) m) ((Nat) len) -> Type)
  enum
  (many EoEnd : (erased (List (U8)) evt) (erased (Nat) len) -> (EvOne evt len len))
  (many EoCons : (erased (List (U8)) evt) (erased (Nat) m len) (erased (Elt flag-w evt m 1) x) (erased (EvOne evt (Succ m) len) r) -> (EvOne evt m len)))

; v is what red4 leaves in ev for the code e: 0 for 5, otherwise 1.
(def-adts $ (EvW : ((Nat) e) ((Nat) v) -> Type)
  enum
  (many EwO : -> (EvW 5 (Zero)))
  (many EwL : (erased (Nat) e) (erased (Apart (Nat) Lt e 5) a) -> (EvW e 1)))

(def-fns _ $ (erased esc-odd : (erased (ES) st) (erased (ESc st 5) sc) -> (erased (Eq (ES) st (ESOdd)) e))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e5 (Refl _ _))
  (let-match erased sc (EscO))
  (Refl _ st))

(def-fns _ $ (erased esc-lt : (erased (ES) st) (erased (Nat) c) (erased (ESc st c) sc) (erased (Apart (Nat) Lt c 5) a) -> (erased (Lt c 5) l))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased r4-e5 (Refl _ _))
  (match erased sc _
    ((EscS) (LtS _ _ (LtS _ _ (LtS _ _ (LtZ _)))))
    ((Esc1) (LtZ _))
    ((Esc2) (LtS _ _ (LtZ _)))
    ((Esc3) (LtS _ _ (LtS _ _ (LtZ _))))
    ((EscE) (lt-succ 4))
    (absurd (EscO) (apart-irrefl c a))))

(def-fns _ $ (erased esstep-exists : (erased (ES) st) (erased (Nat) d) (erased (Col) c) (erased (CD d c) cd) -> (erased (ES) st2) (erased (ESStep st c st2) sp))
  (match erased st _
    ((ESStart) (match erased cd _ ((Cd0) (values (ESTail p123) (EStS1))) ((Cd1) (values (ESTail p312) (EStS2))) ((Cd2) (values (ESTail p231) (EStS3)))))
    ((ESTail g)
      (let-match erased g (MkPerm p1 p2 p3))
      (let ((erased x) (erased pc)) (match erased cd (((Col) x) ((PermC g c x) pc)) ((Cd0) (values p1 (PC1 p1 p2 p3))) ((Cd1) (values p2 (PC2 p1 p2 p3))) ((Cd2) (values p3 (PC3 p1 p2 p3)))))
      (match erased x (((ES) st2) ((ESStep st c st2) sp))
        ((C0) (values (ESTail g) (EStT0 g c pc)))
        ((C1) (values (ESTail g) (EStT1 g c pc)))
        ((C2) (values (ESEven) (EStT2 g c pc)))
        ((C3) (values (ESOdd) (EStT3 g c pc)))))
    ((ESEven) (values (ESEven) (EStE c)))
    ((ESOdd) (values (ESOdd) (EStO c)))))

; The heap child x + 1 of m, x being 3 m + d, is m's child of the colour of the digit d.
(def-fns _ $ (erased kid-dg : (erased (Nat) m t d x) (erased (Thrice m t) tm) (erased (Add t d x) a) (erased (Lt d 3) dl) -> (erased (Col) c) (erased (CD d c) cd) (erased (Kid m c x) k))
  (let-match erased r4-e3 (Refl _ _))
  (let ((erased a0)) (add-zero-right t))
  (let ((erased a1)) (add-succ-right t (Zero) t a0))
  (match erased d (((Col) c) ((CD d c) cd) ((Kid m c x) k))
    ((Zero) (let-match erased (add-fn t (Zero) x t a a0) (Refl _ _)) (values (C1) (Cd0) (Ki1 m t tm)))
    ((Succ d1)
      (match erased d1 (((Col) c) ((CD (Succ d1) c) cd) ((Kid m c x) k))
        ((Zero) (let-match erased (add-fn t (Succ (Zero)) x (Succ t) a a1) (Refl _ _)) (values (C2) (Cd1) (Ki2 m t tm)))
        ((Succ d2)
          (let-match erased d2 (Zero)
            (absurd (Succ d3) (let-match erased dl (LtS _ _ q1)) (let-match erased q1 (LtS _ _ q2)) (let-match erased q2 (LtS _ _ q3)) q3))
          (let-match erased (add-fn t (Succ (Succ (Zero))) x (Succ (Succ t)) a (add-succ-right t (Succ (Zero)) (Succ t) a1)) (Refl _ _))
          (values (C3) (Cd2) (Ki3 m t tm)))))))

