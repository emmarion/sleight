    (r4-fill xs a n (repeat-length _ n _ xs rp) (allcu-rep n xs rp) (gz-rep n xs rp) (MkNCap n L4 ml lb) h gtu gsh 1 0 c1 n gn (AddSucc (Zero) c1 c1 (AddZero c1))
      (lt-succ n) (LtZ (Zero))))
