      (erased (Length (Copy (Nat)) ns 17) l) (erased (AllCu ns) au) -> (WSt rp rb ns)))

; Level k of the pair arrays holds P: rows k of rp and rb hold it from 0 to n, its length n at entry k of ns; its prefixes are below W, the width
