      (many (Fn M (many (Nat) i) (erased (Lt i n) il) -> (many (Nat) v) (erased (R i v) p) (erased (Lt v u62-modulus) vb)) f) ->
      (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (erased (TabR R n xs) t) (erased (Length (Copy (Nat)) xs n) l)
