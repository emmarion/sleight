  (let-match erased r4-e4s (Refl _ _))
  (let ((erased s) (erased ms)) (mul 2 d))
  (let ((erased sl) (erased dl) (erased su))
    (match erased dg (((Lt s (Succ sixty-two)) l) ((Lt d (Succ 2)) l2) ((Lt s u62-modulus) l4))
      ((Dg30 _ _ _)
        (let-match erased (mul-fn 2 (Zero) s (Zero) ms (MulSucc _ _ _ _ (MulSucc _ _ _ _ (MulZero (Zero)) (AddZero (Zero))) (AddZero (Zero)))) (Refl _ _))
        (values (lt-trans (Zero) 4 (Succ sixty-two) (LtZ _) r4-four-lt) (LtZ _) (lt-trans (Zero) 4 u62-modulus (LtZ _) r4-four-u62)))
      ((Dg31 _ _ _)
        (let-match erased (mul-fn 2 (Succ (Zero)) s 2 ms (mul-one-right 2)) (Refl _ _))
