; Each tree of ts, from position s, is empty with its bit of cm clear, or is the kid i onwards of ch with its bit set and i below it.
(def-adts $ (KS : ((Nat) cm) ((Nat) s) ((List (Gtree)) ts) ((List (KidP)) ch) ((Nat) i) -> Type)
  enum
  (many KsNil : (erased (Nat) cm s i) -> (KS cm s (Nil (Gtree)) (Nil (KidP)) i))
  (many KsE : (erased (Nat) cm s i) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (erased (BitIs cm s (Bit0)) b) (erased (KS cm (Succ s) ts ch i) k)
      -> (KS cm s (Cons (Gtree) (GEmpty) ts) ch i))
  (many KsP : (erased (Nat) cm s i) (erased (Gtree) t) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (erased (BitIs cm s (Bit1)) b) (erased (Rk s cm i) r)
      (erased (KS cm (Succ s) ts ch (Succ i)) k) -> (KS cm s (Cons (Gtree) t ts) (Cons (KidP) (MkKidP s t) ch) i)))

(def-fns _ $ (erased add-one-r : (erased (Nat) s) -> (erased (Add s (Succ (Zero)) (Succ s)) a))
  (add-succ-right s (Zero) s (add-zero-right s)))

(def-fns _ $ (erased bitv-fn : (erased (Bit) x) (erased (Nat) u v) (erased (BitV x u) p) (erased (BitV x v) q) -> (erased (Eq (Nat) u v) e))
  (match erased p _ ((BV0) (let-match erased q (BV0)) (Refl _ u)) ((BV1) (let-match erased q (BV1)) (Refl _ u))))

(def-fns _ $ (erased bit-at : (erased (Nat) s cm m1 y m v) (erased (Bit) x) (erased (Bsp (Succ s) cm m1 y) p) (erased (Bsp s m1 m v) q) (erased (BitV x v) bv)
    -> (erased (Nat) z) (erased (Bsp s cm m z) r) (erased (BitCons y x z) c))
  (let ((erased lo1) (erased z) (erased lo2) (erased p1) (erased p2) (erased p3)) (bsp-split s (Succ (Zero)) (Succ s) cm m1 y (add-one-r s) p))
  (let ((erased e1) (erased e2)) (bsp-fn s m1 lo1 lo2 m v p3 q))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased p2 (BspS _ _ z1 _ l0 _ b p0 cz cl))
  (let-match erased p0 (BspZ _))
  (let ((erased v2) (erased c2) (erased bv2)) (bc-one x))
  (let-match erased (bitv-fn x v v2 bv bv2) (Refl _ _))
  (let ((erased _) (erased eb)) (bitcons-fn (Zero) b (Zero) x v cl c2))
  (let-match erased eb (Refl _ _))
  (values z p1 cz))

(def-fns _ $ (erased fold-ks : (erased (List (Bit)) xs) (erased (Nat) s m cm i) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (erased (Ac xs s m) a)
    (subterm erased (Kl s ts ch) kl) (erased (FoldM ch m cm) f) (erased (Rk s m i) rk) ->
    (erased (List (Bit)) xs2) (erased (Nat) s2 y) (erased (Ac xs2 s2 cm) a2) (erased (Bsp s cm m y) p) (erased (KS cm s ts ch i) ks))
  (let ((erased lo)) (ac-low xs s m a))
  (match erased kl _
    ((KlNil _) (let-match erased f (FmNil _)) (values xs s (Zero) a lo (KsNil cm s i)))
    ((KlE _ ts1 _ kl1)
      (let ((erased a1)) (AcS xs s m m (Zero) (Bit0) a (BV0) lo))
      (let ((erased rk1)) (rk-step s m m (Zero) (Zero) i (Zero) i (Bit0) rk lo (bc-zz) (BV0) (add-zero-right i)))
      (let ((erased xs2) (erased s2) (erased y) (erased a2) (erased p) (erased ks)) (fold-ks (Cons _ (Bit0) xs) (Succ s) m cm i ts1 ch a1 kl1 f rk1))
      (let ((erased z) (erased pz) (erased cz)) (bit-at s cm m y m (Zero) (Bit0) p lo (BV0)))
      (values xs2 s2 z a2 pz (KsE cm s i ts1 ch (MkBitIs cm s m z y (Bit0) pz cz) ks)))
    ((KlP _ t ts1 ch1 g kl1)
      (let-match erased f (FmCons _ _ m1 _ v _ _ pv o f1))
      (let ((erased a1) (erased q)) (or-acc xs s m v (Succ (Zero)) m1 (Bit1) a (bsp-pow s v pv) (BV1) o))
      (let ((erased rk0)) (rk-low s m m1 m (Zero) (Succ (Zero)) i rk lo q))
      (let ((erased rk1)) (rk-step s m1 m (Succ (Zero)) (Zero) i (Succ (Zero)) (Succ i) (Bit1) rk0 q (BC1 (Zero) (Zero) (D0)) (BV1) (add-one-r i)))
      (let ((erased xs2) (erased s2) (erased y) (erased a2) (erased p) (erased ks)) (fold-ks (Cons _ (Bit1) xs) (Succ s) m1 cm (Succ i) ts1 ch1 a1 kl1 f1 rk1))
      (let ((erased z) (erased pz) (erased cz)) (bit-at s cm m1 y m (Succ (Zero)) (Bit1) p q (BV1)))
      (values xs2 s2 z a2 pz (KsP cm s i t ts1 ch1 (MkBitIs cm s m z y (Bit1) pz cz) (rk-low s m cm m (Zero) z i rk lo pz) ks)))))

(def-adts
  ; t has c nodes.
  ((GCt : ((Gtree) t) ((Nat) c) -> Type)
    enum
    (many GcE : -> (GCt (GEmpty) (Zero)))
    (many GcL : (erased (Gtree) t) (erased (Bits) q) (erased (LeafSet t q) l) (erased (GPres t (BTrue)) g) -> (GCt t (Succ (Zero))))
    (many GcN : (erased (Gtree) t0 t1 t2 t3) (erased (Nat) z)
        (erased (SumAcc (Cons (Gtree) t0 (Cons (Gtree) t1 (Cons (Gtree) t2 (Cons (Gtree) t3 (Nil (Gtree)))))) (Succ (Zero)) z) sa)
        -> (GCt (GNode t0 t1 t2 t3) z)))
  ; z is acc plus the node counts of ts, added in order.
  ((SumAcc : ((List (Gtree)) ts) ((Nat) acc) ((Nat) z) -> Type)
    enum
    (many SaNil : (erased (Nat) acc) -> (SumAcc (Nil (Gtree)) acc acc))
    (many SaCons : (erased (Gtree) t) (erased (List (Gtree)) ts) (erased (Nat) acc c acc2 z) (erased (GCt t c) g) (erased (Add acc c acc2) a)
        (erased (SumAcc ts acc2 z) s) -> (SumAcc (Cons (Gtree) t ts) acc z))))

(def-fns _ $ (many r4-cnt : (subterm many (Gtree) t) -> (many (Nat) c) (erased (GCt t c) p))
  (let-match erased r4-one (Refl _ _))
  (let-match many t (GNode a b c d)
    ((GEmpty) (values (Zero) (GcE)))
    ((GL0) (values 1 (GcL t _ (LS0) (GP0))))
    ((GL1) (values 1 (GcL t _ (LS1) (GP1))))
    ((GL2) (values 1 (GcL t _ (LS2) (GP2))))
    ((GL3) (values 1 (GcL t _ (LS3) (GP3))))
    ((GL01) (values 1 (GcL t _ (LS01) (GP01))))
    ((GL12) (values 1 (GcL t _ (LS12) (GP12))))
    ((GL13) (values 1 (GcL t _ (LS13) (GP13))))
    ((GL23) (values 1 (GcL t _ (LS23) (GP23)))))
  (let ((many ca) (erased pa)) (notail $ r4-cnt a))
  (let ((many cb) (erased pb)) (notail $ r4-cnt b))
  (let ((many ccn) (erased pc)) (notail $ r4-cnt c))
  (let ((many cd) (erased pd)) (notail $ r4-cnt d))
  (let ((many x0) (erased q0)) (add 1 ca))
  (let ((many x1) (erased q1)) (add x0 cb))
  (let ((many x2) (erased q2)) (add x1 ccn))
  (let ((many x3) (erased q3)) (add x2 cd))
  (values x3 (GcN a b c d x3 (SaCons a _ 1 ca x0 x3 pa q0 $ SaCons b _ x0 cb x1 x3 pb q1 $ SaCons c _ x1 ccn x2 x3 pc q2 $ SaCons d _ x2 cd x3 x3 pd q3 $ SaNil x3))))

; ch has n kids, whose node counts less one each add up to r.
(def-adts $ (CtL : ((List (KidP)) ch) ((Nat) n) ((Nat) r) -> Type)
  enum
  (many CtlNil : -> (CtL (Nil (KidP)) (Zero) (Zero)))
  (many CtlCons : (erased (Nat) s c1 n1 r1 r) (erased (Gtree) t) (erased (List (KidP)) rest) (erased (GCt t (Succ c1)) g) (erased (CtL rest n1 r1) l)
      (erased (Add c1 r1 r) a) -> (CtL (Cons (KidP) (MkKidP s t) rest) (Succ n1) r)))

(def-fns _ $ (erased gct-empty : (erased (Gtree) t) (erased (Nat) c) (erased (GCt t c) g) (erased (GPres t (BFalse)) p) -> (erased (Eq (Nat) c (Zero)) e))
  (let-match erased p (GpE))
  (let-match erased g (GcE) (absurd (GcL _ _ _ gp) gp))
  (Refl _ c))

(def-fns _ $ (erased sumacc-ge : (erased (List (Gtree)) ts) (erased (Nat) acc z) (subterm erased (SumAcc ts acc z) s) -> (erased (Lt acc (Succ z)) r))
  (let-match erased s (SaCons _ ts1 _ c acc2 _ _ a s1) ((SaNil _) (lt-succ acc)))
  (le-trans acc acc2 z (add-le-left acc c acc2 a) (sumacc-ge ts1 acc2 z s1)))

(def-fns _ $ (erased gct-pos : (erased (Gtree) t) (erased (Nat) c) (erased (GCt t c) g) (erased (GPres t (BTrue)) p) -> (erased (Nat) c1) (erased (Eq (Nat) c (Succ c1)) e))
  (let-match erased g (GcN _ _ _ _ _ sa) (absurd (GcE) p) ((GcL _ _ _ _) (values (Zero) (Refl _ c))))
  (let-match erased (sumacc-ge _ (Succ (Zero)) c sa) (LtS _ _ l))
  (let-match erased l (LtZ c1))
  (values c1 (Refl _ c)))

(def-fns _ $ (erased sum-kids : (erased (Nat) s acc z) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (subterm erased (Kl s ts ch) kl) (erased (SumAcc ts acc z) sa)
    -> (erased (Nat) n r nr) (erased (CtL ch n r) cl) (erased (Add n r nr) a1) (erased (Add acc nr z) a2))
  (match erased kl _
    ((KlNil _) (let-match erased sa (SaNil _)) (values (Zero) (Zero) (Zero) (CtlNil) (AddZero (Zero)) (add-zero-right acc)))
    ((KlE _ ts1 _ kl1)
      (let-match erased sa (SaCons _ _ _ c acc2 _ g a sa1))
      (let-match erased (gct-empty (GEmpty) c g (GpE)) (Refl _ _))
      (let-match erased (add-fn acc (Zero) acc2 acc a (add-zero-right acc)) (Refl _ _))
      (sum-kids (Succ s) acc z ts1 ch kl1 sa1))
    ((KlP _ t ts1 ch1 gp kl1)
      (let-match erased sa (SaCons _ _ _ c acc2 _ g a sa1))
      (let ((erased c1) (erased ec)) (gct-pos t c g gp))
      (let-match erased ec (Refl _ _))
      (let ((erased n1) (erased r1) (erased nr1) (erased cl1) (erased b1) (erased b2)) (sum-kids (Succ s) acc2 z ts1 ch1 kl1 sa1))
      (let ((erased q) (erased q1) (erased q2)) (add-assoc acc c nr1 acc2 z a b2))
      (let-match erased q1 (AddSucc _ _ q0 q3))
      (let ((erased ab) (erased d1) (erased d2)) (add-assoc-back c1 n1 r1 nr1 q0 q3 b1))
      (let ((erased r) (erased e1) (erased e2)) (add-assoc n1 c1 r1 ab q0 (add-comm c1 n1 ab d1) d2))
      (values (Succ n1) r q (CtlCons s c1 n1 r1 r t ch1 g cl1 e1) (AddSucc n1 r q0 e2) q2))))

(def-adts $ (BoolBit : ((Bool) p) ((Bit) x) -> Type)
  enum
  (many BBT : -> (BoolBit (BTrue) (Bit1)))
  (many BBF : -> (BoolBit (BFalse) (Bit0))))

; m holds the symbols of the leaf s0, Push as bit 0 to Pop1 as bit 3.
(def-adts $ (LeafM : ((Gtree) s0) ((Nat) m) -> Type)
  enum
  (many MkLeafM : (erased (Gtree) s0) (erased (Nat) m) (erased (Bool) b0 b1 b2 b3) (erased (Bit) x0 x1 x2 x3) (erased (LeafSet s0 (MkBits b0 b1 b2 b3)) l)
      (erased (BoolBit b0 x0) e0) (erased (BoolBit b1 x1) e1) (erased (BoolBit b2 x2) e2) (erased (BoolBit b3 x3) e3)
      (erased (Ac (Cons (Bit) x3 (Cons (Bit) x2 (Cons (Bit) x1 (Cons (Bit) x0 (Nil (Bit)))))) (Succ (Succ (Succ (Succ (Zero))))) m) a) -> (LeafM s0 m)))

(def-adts
  ; Node g of xs lays out s0 as fill does, j levels above the leaves, with all of s0 in gu and nothing in gtr; the nodes below g are in [lo, hi), and g is not;
  ; the kids are below bn, and the nodes below the kids of the symbols 0 to 3 in [bn, m1), [m1, m2), [m2, m3) and [m3, hi).
  ((FlB : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) g) ((Gtree) s0) ((Nat) lo) ((Nat) hi) -> Type)
    enum
    (many FbL : (erased (List (Copy (Nat))) xs) (erased (Nat) g m w lo) (erased (Gtree) s0) (erased (WElt xs g w) x) (erased (NWd w (Zero) m (Zero) m) d)
        (erased (LeafM s0 m) lm) -> (FlB xs (Zero) g s0 lo lo))
    (many FbN : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm hi bn m1 m2 m3) (erased (Gtree) c0 c1 c2 c3) (erased (WElt xs g w) x)
        (erased (NWd w b cm (Zero) (Succ (Zero))) d) (erased (Lt g b) gb) (erased (Lt (Succ (Succ (Succ b))) u62-modulus) bb) (erased (Lt b (Succ bn)) bl)
        (erased (KF xs j b hi cm (Zero) c0 bn bn m1) k0) (erased (KF xs j b hi cm (Succ (Zero)) c1 bn m1 m2) k1) (erased (KF xs j b hi cm (Succ (Succ (Zero))) c2 bn m2 m3) k2)
        (erased (KF xs j b hi cm (Succ (Succ (Succ (Zero)))) c3 bn m3 hi) k3) -> (FlB xs (Succ j) g (GNode c0 c1 c2 c3) b hi)))
  ; The kid of symbol s of a node whose children start at b and whose nodes below end at hi: below bn, its nodes below in [lo, hc).
  ((KF : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) hi) ((Nat) cm) ((Nat) s) ((Gtree) c) ((Nat) bn) ((Nat) lo) ((Nat) hc) -> Type)
    enum
    (many KfE : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s bn lo hc) (erased (BitIs cm s (Bit0)) bi) (erased (Lt lo (Succ hc)) lh)
        -> (KF xs j b hi cm s (GEmpty) bn lo hc))
    (many KfP : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s v g lo2 hi2 bn lo hc) (erased (Gtree) c) (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) r)
        (erased (Add b v g) a) (erased (Lt g hi) gh) (erased (Lt b (Succ lo2)) l2) (erased (Lt hi2 (Succ hi)) h2) (erased (FlB xs j g c lo2 hi2) f)
        (erased (Lt g bn) gn) (erased (Lt lo (Succ lo2)) ll) (erased (Lt hi2 (Succ hc)) lh) -> (KF xs j b hi cm s c bn lo hc))))

(def-adts $ (OutS : ((Nat) k) ((Nat) lo) ((Nat) hi) -> Type)
  enum
  (many OsL : (erased (Nat) k lo hi) (erased (Lt k lo) l) -> (OutS k lo hi))
  (many OsR : (erased (Nat) k lo hi) (erased (Lt hi (Succ k)) l) -> (OutS k lo hi)))

(def-fns _ $ (erased welt-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g w k) (erased (Copy (Nat)) y) (erased (WElt xs g w) x)
    (erased (SetNth (Copy (Nat)) xs k y ys) s) (erased (Apart (Nat) Lt k g) ap) -> (erased (WElt ys g w) r))
  (let-match erased x (MkWElt _ _ _ n))
  (match erased ap _
    ((ApLt _ _ _ _ l) (MkWElt ys g w (setnth-nth-gt _ xs k g y _ ys s n l)))
    ((ApGt _ _ _ _ l) (MkWElt ys g w (setnth-nth-lt _ xs k g y _ ys s n l)))))

(def-fns _ $ (erased add-ge : (erased (Nat) b v g) (erased (Add b v g) a) -> (erased (Lt b (Succ g)) r))
  (add-le-left b v g a))

(def-fns _
  ((erased flb-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo hi k) (erased (Gtree) s0) (erased (Copy (Nat)) y) (subterm erased (FlB xs j g s0 lo hi) f)
      (erased (SetNth (Copy (Nat)) xs k y ys) s) (erased (Apart (Nat) Lt k g) ap) (erased (OutS k lo hi) o) -> (erased (FlB ys j g s0 lo hi) r))
    (match erased f _
      ((FbL _ _ m w _ _ x d lm) (FbL ys g m w lo s0 (welt-set xs ys g w k y x s ap) d lm))
      ((FbN _ j1 _ w b cm _ bn m1 m2 m3 c0 c1 c2 c3 x d gb bb bl k0 k1 k2 k3)
        (FbN ys j1 g w b cm hi bn m1 m2 m3 c0 c1 c2 c3 (welt-set xs ys g w k y x s ap) d gb bb bl
          (kf-set xs ys j1 b hi cm (Zero) k bn bn m1 c0 y k0 s o) (kf-set xs ys j1 b hi cm (Succ (Zero)) k bn m1 m2 c1 y k1 s o)
          (kf-set xs ys j1 b hi cm (Succ (Succ (Zero))) k bn m2 m3 c2 y k2 s o) (kf-set xs ys j1 b hi cm (Succ (Succ (Succ (Zero)))) k bn m3 hi c3 y k3 s o)))))
  ((erased kf-set : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j b hi cm sy k bn lo hc) (erased (Gtree) c) (erased (Copy (Nat)) y) (subterm erased (KF xs j b hi cm sy c bn lo hc) kf)
      (erased (SetNth (Copy (Nat)) xs k y ys) s) (erased (OutS k b hi) o) -> (erased (KF ys j b hi cm sy c bn lo hc) r))
    (let-match erased kf (KfP _ _ _ _ _ _ v g lo2 hi2 _ _ _ _ bi rk a gh l2 h2 f gn ll lh) ((KfE _ _ _ _ _ _ _ _ _ bi lh) (KfE ys j b hi cm sy bn lo hc bi lh)))
    (let ((erased ap) (erased o2))
      (match erased o (((Apart (Nat) Lt k g) ap0) ((OutS k lo2 hi2) o0))
        ((OsL _ _ _ l) (values (ApLt (Nat) Lt k g (lt-le-trans k b g l (add-ge b v g a))) (OsL k lo2 hi2 (lt-le-trans k b lo2 l l2))))
        ((OsR _ _ _ l) (values (ApGt (Nat) Lt k g (lt-le-trans g hi k gh l)) (OsR k lo2 hi2 (le-trans hi2 hi k h2 l))))))
    (KfP ys j b hi cm sy v g lo2 hi2 bn lo hc c bi rk a gh l2 h2 (flb-set xs ys j g lo2 hi2 k c y f s ap o2) gn ll lh)))

(def-adts $ (WIdx : ((Nat) k) ((Nat) l1) ((Nat) h1) ((Nat) l2) ((Nat) h2) -> Type)
  enum
  (many WiA : (erased (Nat) k l1 h1 l2 h2) (erased (Lt l1 (Succ k)) a) (erased (Lt k h1) b) -> (WIdx k l1 h1 l2 h2))
  (many WiB : (erased (Nat) k l1 h1 l2 h2) (erased (Lt l2 (Succ k)) a) (erased (Lt k h2) b) -> (WIdx k l1 h1 l2 h2)))

; ys is xs after writes at indices in [l1, h1) or [l2, h2).
(def-adts $ (Ws : ((List (Copy (Nat))) xs) ((List (Copy (Nat))) ys) ((Nat) l1) ((Nat) h1) ((Nat) l2) ((Nat) h2) -> Type)
  enum
  (many WsNil : (erased (List (Copy (Nat))) xs) (erased (Nat) l1 h1 l2 h2) -> (Ws xs xs l1 h1 l2 h2))
  (many WsCons : (erased (List (Copy (Nat))) xs xs1 ys) (erased (Nat) k l1 h1 l2 h2) (erased (Copy (Nat)) y) (erased (SetNth (Copy (Nat)) xs k y xs1) s)
      (erased (WIdx k l1 h1 l2 h2) i) (erased (Ws xs1 ys l1 h1 l2 h2) w) -> (Ws xs ys l1 h1 l2 h2)))

(def-fns _ $ (erased w-cat : (erased (List (Copy (Nat))) xs ys zs) (erased (Nat) l1 h1 l2 h2) (subterm erased (Ws xs ys l1 h1 l2 h2) p) (erased (Ws ys zs l1 h1 l2 h2) q)
    -> (erased (Ws xs zs l1 h1 l2 h2) r))
  (let-match erased p (WsCons _ xs1 _ k _ _ _ _ y s i p1) ((WsNil _ _ _ _ _) q))
  (WsCons xs xs1 zs k l1 h1 l2 h2 y s i (w-cat xs1 ys zs l1 h1 l2 h2 p1 q)))

; [l, h) lies in [l1, h1) or in [l2, h2).
(def-adts $ (SubIv : ((Nat) l) ((Nat) h) ((Nat) l1) ((Nat) h1) ((Nat) l2) ((Nat) h2) -> Type)
  enum
  (many SivA : (erased (Nat) l h l1 h1 l2 h2) (erased (Lt l1 (Succ l)) a) (erased (Lt h (Succ h1)) b) -> (SubIv l h l1 h1 l2 h2))
  (many SivB : (erased (Nat) l h l1 h1 l2 h2) (erased (Lt l2 (Succ l)) a) (erased (Lt h (Succ h2)) b) -> (SubIv l h l1 h1 l2 h2)))

(def-fns _ $ (erased in-sub : (erased (Nat) k l h l1 h1 l2 h2) (erased (Lt l (Succ k)) a) (erased (Lt k h) b) (erased (SubIv l h l1 h1 l2 h2) s) -> (erased (WIdx k l1 h1 l2 h2) r))
  (match erased s _
    ((SivA _ _ _ _ _ _ c d) (WiA k l1 h1 l2 h2 (le-trans l1 l k c a) (lt-le-trans k h h1 b d)))
    ((SivB _ _ _ _ _ _ c d) (WiB k l1 h1 l2 h2 (le-trans l2 l k c a) (lt-le-trans k h h2 b d)))))

(def-fns _ $ (erased w-mono : (erased (List (Copy (Nat))) xs ys) (erased (Nat) l1 h1 l2 h2 m1 n1 mq2 n2) (subterm erased (Ws xs ys l1 h1 l2 h2) p)
    (erased (SubIv l1 h1 m1 n1 mq2 n2) s1) (erased (SubIv l2 h2 m1 n1 mq2 n2) s2) -> (erased (Ws xs ys m1 n1 mq2 n2) r))
  (let-match erased p (WsCons _ xs1 _ k _ _ _ _ y s i p1) ((WsNil _ _ _ _ _) (WsNil xs m1 n1 mq2 n2)))
  (let ((erased bi2))
    (match erased i (((WIdx k m1 n1 mq2 n2) bi0))
      ((WiA _ _ _ _ _ a b) (in-sub k l1 h1 m1 n1 mq2 n2 a b s1))
      ((WiB _ _ _ _ _ a b) (in-sub k l2 h2 m1 n1 mq2 n2 a b s2))))
  (WsCons xs xs1 ys k m1 n1 mq2 n2 y s bi2 (w-mono xs1 ys l1 h1 l2 h2 m1 n1 mq2 n2 p1 s1 s2)))

(def-fns _ $ (erased w-len : (erased (List (Copy (Nat))) xs ys) (erased (Nat) l1 h1 l2 h2 n) (subterm erased (Ws xs ys l1 h1 l2 h2) p) (erased (Length (Copy (Nat)) xs n) l)
    -> (erased (Length (Copy (Nat)) ys n) r))
  (let-match erased p (WsCons _ xs1 _ k _ _ _ _ y s i p1) ((WsNil _ _ _ _ _) l))
  (w-len xs1 ys l1 h1 l2 h2 n p1 (setnth-length _ xs k n y xs1 s l)))

; Every index in [l1, h1) or [l2, h2) is above g, and lies below lo or from hi on.
(def-adts $ (Clear : ((Nat) g) ((Nat) lo) ((Nat) hi) ((Nat) l1) ((Nat) h1) ((Nat) l2) ((Nat) h2) -> Type)
  enum
  (many MkClear : (erased (Nat) g lo hi l1 h1 l2 h2) (erased (Lt g l1) a1) (erased (Lt h1 (Succ lo)) b1) (erased (Lt g l2) a2) (erased (Lt hi (Succ l2)) b2)
      -> (Clear g lo hi l1 h1 l2 h2)))

(def-fns _ $ (erased clear-in : (erased (Nat) g lo hi l1 h1 l2 h2 k) (erased (Clear g lo hi l1 h1 l2 h2) c) (erased (WIdx k l1 h1 l2 h2) i)
    -> (erased (Apart (Nat) Lt k g) ap) (erased (OutS k lo hi) o))
  (let-match erased c (MkClear _ _ _ _ _ _ _ a1 b1 a2 b2))
  (match erased i _
    ((WiA _ _ _ _ _ a b) (values (ApGt (Nat) Lt k g (lt-le-trans g l1 k a1 a)) (OsL k lo hi (lt-le-trans k h1 lo b b1))))
    ((WiB _ _ _ _ _ a b) (values (ApGt (Nat) Lt k g (lt-le-trans g l2 k a2 a)) (OsR k lo hi (le-trans hi l2 k b2 a))))))

(def-fns _ $ (erased flb-w : (erased (List (Copy (Nat))) xs ys) (erased (Nat) j g lo hi l1 h1 l2 h2) (erased (Gtree) s0) (erased (FlB xs j g s0 lo hi) f)
    (subterm erased (Ws xs ys l1 h1 l2 h2) p) (erased (Clear g lo hi l1 h1 l2 h2) c) -> (erased (FlB ys j g s0 lo hi) r))
  (let-match erased p (WsCons _ xs1 _ k _ _ _ _ y s i p1) ((WsNil _ _ _ _ _) f))
  (let ((erased ap) (erased o)) (clear-in g lo hi l1 h1 l2 h2 k c i))
  (flb-w xs1 ys j g lo hi l1 h1 l2 h2 s0 (flb-set xs xs1 j g lo hi k s0 y f s ap o) p1 c))

(def-fns _ $ (erased welt-w : (erased (List (Copy (Nat))) xs ys) (erased (Nat) g w l1 h1 l2 h2) (erased (WElt xs g w) x) (subterm erased (Ws xs ys l1 h1 l2 h2) p)
    (erased (Lt g l1) a1) (erased (Lt g l2) a2) -> (erased (WElt ys g w) r))
  (let-match erased p (WsCons _ xs1 _ k _ _ _ _ y s i p1) ((WsNil _ _ _ _ _) x))
  (let ((erased ap))
    (match erased i (((Apart (Nat) Lt k g) ap0))
      ((WiA _ _ _ _ _ a _) (ApGt (Nat) Lt k g (lt-le-trans g l1 k a1 a)))
      ((WiB _ _ _ _ _ a _) (ApGt (Nat) Lt k g (lt-le-trans g l2 k a2 a)))))
  (welt-w xs1 ys g w l1 h1 l2 h2 (welt-set xs xs1 g w k y x s ap) p1 a1 a2))

(def-fns _ $ (erased or-lt : (erased (Nat) k a b c) (subterm erased (Bsp k a a (Zero)) pa) (erased (Bsp k b b (Zero)) pb) (erased (Bitwise or-op a b c) o)
    -> (erased (Bsp k c c (Zero)) r))
  (let-match erased pa (BspS k1 _ a1 _ a2 _ x pa1 ca ca2)
    ((BspZ _) (let-match erased pb (BspZ _)) (let-match erased (bw-zz or-op c o) (Refl _ _)) (BspZ (Zero))))
  (let ((erased f1) (erased _)) (bitcons-fn a2 x a1 x a ca2 ca))
  (let-match erased f1 (Refl _ _))
  (let-match erased pb (BspS _ _ b1 _ b2 _ y pb1 cb cb2))
  (let ((erased f2) (erased _)) (bitcons-fn b2 y b1 y b cb2 cb))
  (let-match erased f2 (Refl _ _))
  (let-match erased o (BwBit _ a3 b3 c3 x3 y3 z _ _ _ o1 e oa ob oc)
    ((BwZero _)
      (let ((erased e1) (erased e2)) (bc-zero a1 x ca))
      (let-match erased e1 (Refl _ _))
      (let ((erased e3) (erased e4)) (bc-zero b1 y cb))
      (let-match erased e3 (Refl _ _))
      (BspS k1 (Zero) (Zero) (Zero) (Zero) (Zero) (Bit0) (or-lt k1 (Zero) (Zero) (Zero) pa1 pb1 (BwZero or-op)) (bc-zz) (bc-zz))))
  (let ((erased e1) (erased e2)) (bitcons-fn a3 x3 a1 x a oa ca))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased e3) (erased e4)) (bitcons-fn b3 y3 b1 y b ob cb))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (BspS k1 c c3 c c3 (Zero) z (or-lt k1 a1 b1 c3 pa1 pb1 o1) oc oc))

; l lists the trees ts, each with its position, counting from s.
(def-adts $ (KPos : ((Nat) s) ((List (Gtree)) ts) ((List (KidP)) l) -> Type)
  enum
  (many KpNil : (erased (Nat) s) -> (KPos s (Nil (Gtree)) (Nil (KidP))))
  (many KpCons : (erased (Nat) s) (erased (Gtree) t) (erased (List (Gtree)) ts) (erased (List (KidP)) l) (erased (KPos (Succ s) ts l) p)
      -> (KPos s (Cons (Gtree) t ts) (Cons (KidP) (MkKidP s t) l))))

(def-fns _ $ (many r4-kfilter : (erased (Nat) s) (erased (List (Gtree)) ts) (subterm many (List (KidP)) l) (erased (KPos s ts l) p) -> (many (List (KidP)) ch) (erased (Kl s ts ch) k))
  (let-match many l (Cons _ x rest) ((Nil _) (let-match erased p (KpNil _)) (values (Nil _) (KlNil s))))
  (let-match many x (MkKidP s1 t))
  (let-match erased p (KpCons _ _ ts1 _ p1))
  (let ((many r) (erased k)) (notail $ r4-kfilter (Succ s) ts1 rest p1))
  (let ((many e) (erased pr) (erased n) (erased g)) (r4-gempty t))
  (match many e _
    ((BTrue) (let-match erased n (NotT)) (let-match erased g (GpE)) (values r (KlE s ts1 r k)))
    ((BFalse) (let-match erased n (NotF)) (values (Cons _ x r) (KlP s t ts1 r g k)))))

; Every position in ch is below e.
(def-adts $ (PosB : ((Nat) e) ((List (KidP)) ch) -> Type)
  enum
  (many PbNil : (erased (Nat) e) -> (PosB e (Nil (KidP))))
  (many PbCons : (erased (Nat) e s) (erased (Gtree) t) (erased (List (KidP)) ch) (erased (Lt s e) l) (erased (PosB e ch) p) -> (PosB e (Cons (KidP) (MkKidP s t) ch))))

(def-fns _ $ (many r4-kmask : (subterm many (List (KidP)) ch) (many (Nat) m) (erased (PosB 4 ch) pb) (erased (Bsp 4 m m (Zero)) mb) -> (many (Nat) r) (erased (FoldM ch m r) f)
    (erased (Bsp 4 r r (Zero)) rb))
  (let-match many ch (Cons _ x rest) ((Nil _) (values m (FmNil m) mb)))
  (let-match many x (MkKidP s t))
  (let-match erased pb (PbCons _ _ _ _ sl pb1))
  (let ((erased v) (erased pv) (erased _)) (pow2 s))
  (let ((erased vl)) (pow2-lt s 4 v 16 sl pv r4-p16))
  (let ((erased vb)) (lt-trans v 16 u62-modulus vl r4-16-u62))
  (let ((erased mb2)) (lt-trans m 16 u62-modulus (bsp-lt 4 m m (Zero) 16 mb r4-p16) r4-16-u62))
  (let ((many y)) (u62-shl 1 s (lt-trans s 4 (Succ sixty-two) sl r4-four-lt) v pv v (r4-one-mul v) vb))
  (let ((many mq2) (erased o)) (u62-or m y mb2 vb))
  (let ((erased vb4)) (bsp-of 4 16 (Zero) (Zero) v v r4-p16 (MulZero 16) (AddZero v) vl))
  (let ((many r) (erased f) (erased rb)) (tail $ r4-kmask rest mq2 pb1 (or-lt 4 m y mq2 mb vb4 o)))
  (values r (FmCons s m mq2 r v t rest pv o f) rb))

(def-adts $ (KFs : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) hi) ((Nat) cm) ((Nat) s) ((List (Gtree)) ts) ((Nat) bn) ((Nat) lo) ((Nat) hc) -> Type)
  enum
  (many KFsNil : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s bn lo) -> (KFs xs j b hi cm s (Nil (Gtree)) bn lo lo))
  (many KFsCons : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s bn lo m hc) (erased (Gtree) t) (erased (List (Gtree)) ts) (erased (KF xs j b hi cm s t bn lo m) k)
      (erased (KFs xs j b hi cm (Succ s) ts bn m hc) r) -> (KFs xs j b hi cm s (Cons (Gtree) t ts) bn lo hc)))

; ts begins with empty trees, their bits of cm clear, up to position s2, where ts2 begins.
(def-adts $ (KSkip : ((Nat) cm) ((Nat) s) ((List (Gtree)) ts) ((Nat) s2) ((List (Gtree)) ts2) -> Type)
  enum
  (many KskZ : (erased (Nat) cm s) (erased (List (Gtree)) ts) -> (KSkip cm s ts s ts))
  (many KskE : (erased (Nat) cm s s2) (erased (List (Gtree)) ts ts2) (erased (BitIs cm s (Bit0)) b) (erased (KSkip cm (Succ s) ts s2 ts2) k)
      -> (KSkip cm s (Cons (Gtree) (GEmpty) ts) s2 ts2)))

; KS at a kid: ts and ch are both empty, or both begin with the kid i at position s.
(def-adts $ (KsHd : ((Nat) cm) ((Nat) s) ((List (Gtree)) ts) ((List (KidP)) ch) ((Nat) i) -> Type)
  enum
  (many KhNil : (erased (Nat) cm s i) -> (KsHd cm s (Nil (Gtree)) (Nil (KidP)) i))
  (many KhP : (erased (Nat) cm s i) (erased (Gtree) t) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (erased (BitIs cm s (Bit1)) b) (erased (Rk s cm i) r)
      (erased (KS cm (Succ s) ts ch (Succ i)) k) -> (KsHd cm s (Cons (Gtree) t ts) (Cons (KidP) (MkKidP s t) ch) i)))

(def-fns _ $ (erased ks-next : (erased (Nat) cm s i) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (subterm erased (KS cm s ts ch i) k)
    -> (erased (Nat) s2) (erased (List (Gtree)) ts2) (erased (KSkip cm s ts s2 ts2) sk) (erased (KsHd cm s2 ts2 ch i) hd))
  (let-match erased k (KsE _ _ _ ts1 _ b k1)
    ((KsNil _ _ _) (values s (Nil _) (KskZ cm s (Nil _)) (KhNil cm s i)))
    ((KsP _ _ _ t ts1 ch1 b r k1) (values s ts (KskZ cm s ts) (KhP cm s i t ts1 ch1 b r k1))))
  (let ((erased s2) (erased ts2) (erased sk) (erased hd)) (ks-next cm (Succ s) i ts1 ch k1))
  (values s2 ts2 (KskE cm s s2 ts1 ts2 b sk) hd))

(def-fns _ $ (erased skip-kfs : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s s2 bn lo hc) (erased (List (Gtree)) ts ts2) (subterm erased (KSkip cm s ts s2 ts2) sk)
    (erased (KFs xs j b hi cm s2 ts2 bn lo hc) k) -> (erased (KFs xs j b hi cm s ts bn lo hc) r))
  (let-match erased sk (KskE _ _ _ ts1 _ bi sk1) ((KskZ _ _ _) k))
  (KFsCons xs j b hi cm s bn lo lo hc (GEmpty) ts1 (KfE xs j b hi cm s bn lo lo bi (lt-succ lo)) (skip-kfs xs j b hi cm (Succ s) s2 bn lo hc ts1 ts2 sk1 k)))

(def-fns _ $ (erased ctl-len : (erased (List (KidP)) ch) (erased (Nat) n r) (subterm erased (CtL ch n r) c) -> (erased (Length (KidP) ch n) l))
  (let-match erased c (CtlCons s _ n1 _ _ t rest _ c1 _) ((CtlNil) (LengthNil _)))
  (LengthCons _ (MkKidP s t) rest n1 (ctl-len rest n1 _ c1)))

(def-fns _ $ (erased bsp-zz : (subterm erased (Nat) k) -> (erased (Bsp k (Zero) (Zero) (Zero)) p))
  (let-match erased k (Succ k1) ((Zero) (BspZ (Zero))))
  (BspS k1 (Zero) (Zero) (Zero) (Zero) (Zero) (Bit0) (bsp-zz k1) (bc-zz) (bc-zz)))

; ch's positions, from s, are below s + n.
(def-fns _ $ (erased kl-posb : (erased (Nat) s n) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (subterm erased (Kl s ts ch) k) (erased (Length (Gtree) ts n) l)
    (erased (Nat) e) (erased (Add s n e) a) -> (erased (PosB e ch) r))
  (match erased k _
    ((KlNil _) (PbNil e))
    ((KlE _ ts1 _ k1) (let-match erased l (LengthCons _ _ _ n1 l1)) (kl-posb (Succ s) n1 ts1 ch k1 l1 e (add-sh s n1 e a)))
    ((KlP _ t ts1 ch1 _ k1)
      (let-match erased l (LengthCons _ _ _ n1 l1))
      (PbCons e s t ch1 (lt-le-trans s (Succ s) e (lt-succ s) (add-le-left (Succ s) n1 e (add-sh s n1 e a))) (kl-posb (Succ s) n1 ts1 ch1 k1 l1 e (add-sh s n1 e a))))))

(comptime-match many (r4-eq-pf 0 (Zero)) (ESome _ r4-e0))
(comptime-match many (r4-eq-pf 2 (Succ (Succ (Zero)))) (ESome _ r4-e2))
(comptime-match many (r4-eq-pf 3 (Succ (Succ (Succ (Zero))))) (ESome _ r4-e3))
(comptime-match many (bsp-chk (Succ (Zero)) 2 (Zero) (Succ (Zero))) (ESome _ r4-b2))
(comptime-match many (bsp-chk (Succ (Succ (Zero))) 4 (Zero) (Succ (Zero))) (ESome _ r4-b4))
(comptime-match many (bsp-chk (Succ (Succ (Succ (Zero)))) 8 (Zero) (Succ (Zero))) (ESome _ r4-b8))
(comptime-match many (bsp-chk 4 1 1 (Zero)) (ESome _ r4-b1))
(let ((many r4-v256) (erased r4-p8) (erased _)) (pow2 8))
(comptime-match many (nat-eq r4-v256 256) (Equal _ _ _))
(let ((many r4-v4096) (erased r4-p12) (erased _)) (pow2 12))
(comptime-match many (nat-eq r4-v4096 4096) (Equal _ _ _))
(comptime-match many (lt-dec 16 256) (Yes _ _ _ _ r4-16-256))
(let ((many r4-v4096b) (erased r4-m4096)) (mul 16 256))
(comptime-match many (nat-eq r4-v4096b 4096) (Equal _ _ _))
(comptime-match many (lt-dec 1 256) (Yes _ _ _ _ r4-1-256))
(comptime-match many (lt-dec 1 flag-um) (Yes _ _ _ _ r4-1-u62))
(comptime-match many (lt-dec 4096 flag-um) (Yes _ _ _ _ r4-4096-u62))
(comptime-match many (lt-dec 8 (Succ (sixty-two-many))) (Yes _ _ _ _ r4-eight-lt))
(comptime-match many (lt-dec 8 flag-um) (Yes _ _ _ _ r4-8-u62))

(def-fns _ $ (many r4-bv : (many (Bool) b) (many (Nat) y) (erased (Nat) s) (erased (Bsp s y (Zero) (Succ (Zero))) p) ->
    (many (Nat) x) (erased (Bit) bit) (erased (Nat) v) (erased (BoolBit b bit) bb) (erased (BitV bit v) bv) (erased (Bsp s x (Zero) v) q) (erased (Lt x (Succ y)) xl))
  (let-match many b (BTrue) ((BFalse) (let-match erased r4-e0 (Refl _ _)) (values 0 (Bit0) (Zero) (BBF) (BV0) (bsp-zz s) (LtZ y))))
  (values y (Bit1) (Succ (Zero)) (BBT) (BV1) p (lt-succ y)))


; The word of a leaf with the symbols m: m in its part of gu and as its symbol set.
(def-fns _ $ (many r4-leaf-word : (many (Nat) m) (erased (Lt m 16) ml) -> (many (Nat) w) (erased (NWd w (Zero) m (Zero) m) d) (erased (Lt w 4096) wl))
  (let ((erased ml256)) (lt-trans m 16 256 ml r4-16-256))
  (let ((erased t) (erased mt)) (mul m 256))
  (let ((erased wv) (erased aw)) (add t m))
  (let ((erased pw)) (bsp-of 8 256 m t m wv r4-p8 mt aw ml256))
  (let ((erased p8)) (bsp-of 8 256 m t (Zero) t r4-p8 mt (add-zero-right t) (pow2-pos 8 256 r4-p8)))
  (let ((erased wl)) (digit-lt 256 16 4096 m m t wv ml256 ml mt aw r4-m4096))
  (let ((erased tb)) (lt-trans t 4096 u62-modulus (lt-le-trans t (Succ wv) 4096 (add-le-left t m wv aw) (LtS wv 4096 wl)) r4-4096-u62))
  (let ((many x8)) (u62-shl m 8 r4-eight-lt 256 r4-p8 t mt tb))
  (let ((many w) (erased o)) (u62-or x8 m tb (lt-trans m 16 u62-modulus ml r4-16-u62)))
  (let-match erased (bitwise-fn or-op t m w wv o (or-split 8 wv m m t pw p8)) (Refl _ _))
  (let ((erased lo1) (erased z) (erased lo2) (erased q1) (erased q2) (erased q3)) (bsp-split 4 4 8 w m m r4-a448 pw))
  (let ((erased m16)) (bsp-of 4 16 (Zero) (Zero) m m r4-p16 (MulZero 16) (AddZero m) ml))
  (let ((erased e1) (erased e2)) (bsp-fn 4 m lo1 lo2 m (Zero) q3 m16))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (values w (MkNWd w (Zero) m (Zero) m z m q1 q2 m16) wl))

; The word of an internal node whose children are cm, the first at b.
(def-fns _ $ (many r4-node-word : (many (Nat) b cm) (erased (Lt cm 16) cl) (erased (Nat) n L4) (erased (Lt b (Succ n)) bn) (erased (Mul (Succ n) 4096 L4) ml)
    (erased (Lt L4 u62-modulus) lb) -> (many (Nat) w) (erased (NWd w b cm (Zero) (Succ (Zero))) d) (erased (Lt w L4) wl))
  (let-match erased r4-one (Refl _ _))
  (let ((erased t12) (erased m12)) (mul b 4096))
  (let ((erased t8) (erased m8)) (mul cm 256))
  (let ((erased xv) (erased ax)) (add t12 t8))
  (let ((erased wv) (erased aw)) (add xv 1))
  (let ((erased p12)) (bsp-of 12 4096 b t12 (Zero) t12 r4-p12 m12 (add-zero-right t12) (pow2-pos 12 4096 r4-p12)))
  (let ((erased p8)) (bsp-of 8 256 cm t8 (Zero) t8 r4-p8 m8 (add-zero-right t8) (pow2-pos 8 256 r4-p8)))
  (let ((erased t8l)) (digit-lt 256 16 4096 (Zero) cm t8 t8 (pow2-pos 8 256 r4-p8) cl m8 (add-zero-right t8) r4-m4096))
  (let ((erased px)) (bsp-of 12 4096 b t12 t8 xv r4-p12 m12 ax t8l))
  (let ((erased lo1) (erased z) (erased lo2) (erased q1) (erased q2) (erased q3)) (bsp-split 8 4 12 xv t8 b r4-a8412 px))
  (let ((erased e1) (erased e2)) (bsp-fn 8 t8 lo1 lo2 (Zero) cm q3 p8))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased pw)) (bsp-add 8 xv z 1 wv 256 q1 aw r4-p8 r4-1-256))
  (let ((erased lo3) (erased z2) (erased lo4) (erased r1) (erased r2) (erased r3)) (bsp-split 4 4 8 wv 1 z r4-a448 pw))
  (let ((erased e3) (erased e4)) (bsp-fn 4 1 lo3 lo4 1 (Zero) r3 r4-b1))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (let ((erased ac) (erased lo12) (erased s12) (erased q12) (erased _)) (bsp-cat 8 4 wv 1 z cm b pw q2))
  (let-match erased (add-fn 8 4 ac 12 s12 r4-a8412) (Refl _ _))
  (let ((erased v12) (erased t2) (erased pv12) (erased mm2) (erased ad2) (erased ll2)) (bsp-arith 12 wv lo12 b q12))
  (let-match erased (pow2-fn 12 v12 4096 pv12 r4-p12) (Refl _ _))
  (let ((erased wl)) (digit-lt 4096 (Succ n) L4 lo12 b t2 wv ll2 bn mm2 ad2 ml))
  (let ((erased wb)) (lt-trans wv L4 u62-modulus wl lb))
  (let ((erased xb)) (lt-le-trans xv (Succ wv) u62-modulus (add-le-left xv 1 wv aw) (LtS wv u62-modulus wb)))
  (let ((erased tb)) (lt-le-trans t12 (Succ xv) u62-modulus (add-le-left t12 t8 xv ax) (LtS xv u62-modulus xb)))
  (let ((many x12)) (u62-shl b 12 r4-twelve-lt 4096 r4-p12 t12 m12 tb))
  (let ((many x8)) (u62-shl cm 8 r4-eight-lt 256 r4-p8 t8 m8 (lt-trans t8 4096 u62-modulus t8l r4-4096-u62)))
  (let ((many x) (erased o1)) (u62-or x12 x8 tb (lt-trans t8 4096 u62-modulus t8l r4-4096-u62)))
  (let-match erased (bitwise-fn or-op t12 t8 x xv o1 (or-split 12 xv t8 b t12 px p12)) (Refl _ _))
  (let ((many w) (erased o2)) (u62-or x 1 xb r4-1-u62))
  (let-match erased (bitwise-fn or-op xv 1 w wv o2 (or-split 8 wv 1 z xv pw q1)) (Refl _ _))
  (values w (MkNWd w b cm (Zero) (Succ (Zero)) z2 z r1 r2 q2) wl))

(comptime-match many (lt-dec 2 flag-um) (Yes _ _ _ _ r4-2-u62))

(def-fns _ $ (erased ac-u62 : (erased (List (Bit)) xs) (erased (Nat) s m) (erased (Ac xs s m) a) (erased (Lt s 4) sl) -> (erased (Lt m u62-modulus) r))
