        ((KcSame _ _)
          (let-match erased (kid-dec p q4 q (C3) (C2) k4 kq) (KcNe _ _ _ _ _ ap4))
          (let ((erased a) (erased k) (erased m) (erased ad) (erased pk)) (wct-hit q r (BP0 bs) _ gs rest (WcMiss q4 q r (BP1 bs) Q0 gs rest ap4 pc)))
          (values a k (ScY (GPush) bs (BP0 bs) (C2) gs rest a (SPush2 bs) m) ad pk))
        ((KcNe _ _ _ _ ne3 ap3)
          (match erased (kid-dec p q4 q (C3) e k4 kq) _
            ((KcSame _ _)
              (let ((erased a) (erased k) (erased m) (erased ad) (erased pk)) (wct-hit q r (BP1 bs) Q0 gs rest pc))
              (values a k (ScY (GPush) bs (BP1 bs) (C3) gs rest a (SPush3 bs) m) ad (WcMiss q3 q k (BP0 bs) _ gs rest ap3 pk)))
            ((KcNe _ _ _ _ ne4 ap4)
              (let-match erased ne3 (N21) (absurd (N23) ne4))
              (values (Zero) r (ScN (GPush) bs (C1) gs rest (NsPu1 bs)) (AddZero r)
                (WcMiss q3 q r (BP0 bs) _ gs rest ap3 (WcMiss q4 q r (BP1 bs) Q0 gs rest ap4 pc))))))))
    ((WhPop _ q1 _ e2 _ b1 pp y k1 _)
      (let-match erased (kid-dec p q1 q e2 e k1 kq) (KcSame _ _)
        ((KcNe _ _ _ _ ne ap)
          (values (Zero) r (ScN s bs e gs rest (pop-nosym s bs b1 e2 e pp y ne)) (AddZero r) (WcMiss q1 q r b1 Q0 gs rest ap pc))))
      (let ((erased a) (erased k) (erased m) (erased ad) (erased pk)) (wct-hit q r b1 Q0 gs rest pc))
      (values a k (ScY s bs b1 e gs rest a y m) ad pk))
    ((WhNone _ _ ip _)
      (values (Zero) r (ScN s bs e gs rest (match erased ip _ ((IP0) (NsP0E e)) ((IP1) (NsP1E e)))) (AddZero r) pc))))

(def-fns _ $ (erased wch-miss : (erased (Nat) p q q2 r) (erased (Gsym) s) (erased (Bstack) bs) (erased (List (WP)) Q0 Q) (erased (GSet) gs) (erased (Col) e)
    (erased (List (Col)) rest) (erased (WCh s (MkWP p bs) Q0 Q) ch) (erased (Apart (Nat) Lt p q) ap) (erased (Kid q e q2) kq)
    (erased (WCt Q0 gs q2 rest r) pc) -> (erased (WCt Q gs q2 rest r) pk))
