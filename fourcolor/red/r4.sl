; p2 is the prefix that the pair at the prefix p with the stack bs takes under the symbol g, below r4-none: for Push its colour-2 child; r4-none when g
; pops an empty stack.
(def-adts $ (XtP : ((Nat) p) ((Bstack) bs) ((Gsym) g) ((Nat) p2) -> Type)
  enum
