(def-adts
  ; Node g of xs lays out s0, a subtree of the initial chromogram tree, j levels above the leaves: a leaf's symbols, or which children are
  ; present and where they are.
  ((NLay : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) g) ((Gtree) s0) -> Type)
    enum
    (many NlL : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b m ftr fu) (erased (Gtree) s0) (erased (WElt xs g w) x) (erased (NWd w b m ftr fu) d)
        (erased (LeafM s0 m) lm) -> (NLay xs (Zero) g s0))
    (many NlN : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) c0 c1 c2 c3) (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d)
        (erased (Lt (Succ (Succ (Succ b))) u62-modulus) bb) (erased (NLayK xs j b cm (Zero) c0) k0) (erased (NLayK xs j b cm (Succ (Zero)) c1) k1)
        (erased (NLayK xs j b cm (Succ (Succ (Zero))) c2) k2) (erased (NLayK xs j b cm (Succ (Succ (Succ (Zero)))) c3) k3) -> (NLay xs (Succ j) g (GNode c0 c1 c2 c3))))
  ; The child of symbol s of a node whose children start at b.
  ((NLayK : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Nat) s) ((Gtree) c) -> Type)
    enum
    (many NlkE : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s) (erased (BitIs cm s (Bit0)) bi) -> (NLayK xs j b cm s (GEmpty)))
    (many NlkP : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s v g) (erased (Gtree) c) (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) r)
        (erased (Add b v g) a) (erased (NLay xs j g c) l) -> (NLayK xs j b cm s c))))

; f is the part of a word that sel picks: its part of gtr when sel is BTrue, of gu otherwise.
(def-adts $ (Fld : ((Bool) sel) ((Nat) ftr) ((Nat) fu) ((Nat) f) -> Type)
  enum
  (many FdU : (erased (Nat) ftr fu) -> (Fld (BFalse) ftr fu fu))
  (many FdT : (erased (Nat) ftr fu) -> (Fld (BTrue) ftr fu ftr)))

(def-adts
  ; The parts sel of node g of xs and of the nodes below it hold t, within s0: 0 at an empty node, 1 at a nonempty internal one, the symbols
  ; at a leaf.
  ((NPart : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) g) ((Gtree) s0) ((Bool) sel) ((Gtree) t) -> Type)
    enum
    (many NpE : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) s0) (erased (Bool) sel) (erased (WElt xs g w) x)
        (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu (Zero)) fd) -> (NPart xs j g s0 sel (GEmpty)))
    (many NpL : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b cm ftr fu f) (erased (Gtree) s0 t) (erased (Bool) sel) (erased (WElt xs g w) x)
        (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu f) fd) (erased (LeafM t f) lm) -> (NPart xs (Zero) g s0 sel t))
    (many NpN : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) c0 c1 c2 c3 t0 t1 t2 t3) (erased (Bool) sel)
        (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu (Succ (Zero))) fd) (erased (NPartK xs j b cm (Zero) c0 sel t0) k0)
        (erased (NPartK xs j b cm (Succ (Zero)) c1 sel t1) k1) (erased (NPartK xs j b cm (Succ (Succ (Zero))) c2 sel t2) k2)
        (erased (NPartK xs j b cm (Succ (Succ (Succ (Zero)))) c3 sel t3) k3) -> (NPart xs (Succ j) g (GNode c0 c1 c2 c3) sel (GNode t0 t1 t2 t3))))
  ((NPartK : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Nat) s) ((Gtree) c) ((Bool) sel) ((Gtree) t) -> Type)
    enum
    (many NpkE : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s) (erased (Bool) sel) -> (NPartK xs j b cm s (GEmpty) sel (GEmpty)))
    (many NpkP : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s v g) (erased (Gtree) c t) (erased (Bool) sel) (erased (Rk s cm v) r) (erased (Add b v g) a)
        (erased (NPart xs j g c sel t) p) -> (NPartK xs j b cm s c sel t))))

(def-fns _
  ((erased flb-lay : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (subterm erased (FlB xs j g s0 lo hi) f) -> (erased (NLay xs j g s0) r))
    (match erased f _
      ((FbL _ _ m w _ _ x d lm) (NlL xs g w (Zero) m (Zero) m s0 x d lm))
      ((FbN _ j1 _ w b cm _ c0 c1 c2 c3 x d _ bb k0 k1 k2 k3)
        (NlN xs j1 g w b cm (Zero) (Succ (Zero)) c0 c1 c2 c3 x d bb (kf-lay xs j1 b hi cm (Zero) c0 k0) (kf-lay xs j1 b hi cm (Succ (Zero)) c1 k1)
          (kf-lay xs j1 b hi cm (Succ (Succ (Zero))) c2 k2) (kf-lay xs j1 b hi cm (Succ (Succ (Succ (Zero)))) c3 k3)))))
  ((erased kf-lay : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s) (erased (Gtree) c) (subterm erased (KF xs j b hi cm s c) k) -> (erased (NLayK xs j b cm s c) r))
    (let-match erased k (KfP _ _ _ _ _ _ v g lo2 hi2 _ bi rk a _ _ _ f) ((KfE _ _ _ _ _ _ bi) (NlkE xs j b cm s bi)))
    (NlkP xs j b cm s v g c bi rk a (flb-lay xs j g lo2 hi2 c f))))

(def-fns _
  ((erased flb-part : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (subterm erased (FlB xs j g s0 lo hi) f)
      -> (erased (NPart xs j g s0 (BFalse) s0) r))
    (match erased f _
      ((FbL _ _ m w _ _ x d lm) (NpL xs g w (Zero) m (Zero) m m s0 s0 (BFalse) x d (FdU (Zero) m) lm))
      ((FbN _ j1 _ w b cm _ c0 c1 c2 c3 x d _ _ k0 k1 k2 k3)
        (NpN xs j1 g w b cm (Zero) (Succ (Zero)) c0 c1 c2 c3 c0 c1 c2 c3 (BFalse) x d (FdU (Zero) (Succ (Zero)))
          (kf-part xs j1 b hi cm (Zero) c0 k0) (kf-part xs j1 b hi cm (Succ (Zero)) c1 k1)
          (kf-part xs j1 b hi cm (Succ (Succ (Zero))) c2 k2) (kf-part xs j1 b hi cm (Succ (Succ (Succ (Zero)))) c3 k3)))))
  ((erased kf-part : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s) (erased (Gtree) c) (subterm erased (KF xs j b hi cm s c) k)
      -> (erased (NPartK xs j b cm s c (BFalse) c) r))
    (let-match erased k (KfP _ _ _ _ _ _ v g lo2 hi2 _ _ rk a _ _ _ f) ((KfE _ _ _ _ _ _ _) (NpkE xs j b cm s (BFalse))))
    (NpkP xs j b cm s v g c c (BFalse) rk a (flb-part xs j g lo2 hi2 c f))))

(def-fns _ $ (erased flb-tr : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (erased (FlB xs j g s0 lo hi) f)
    -> (erased (NPart xs j g s0 (BTrue) (GEmpty)) r))
  (match erased f _
    ((FbL _ _ m w _ _ x d _) (NpE xs (Zero) g w (Zero) m (Zero) m s0 (BTrue) x d (FdT (Zero) m)))
    ((FbN _ j1 _ w b cm _ _ _ _ _ x d _ _ _ _ _ _) (NpE xs j g w b cm (Zero) (Succ (Zero)) s0 (BTrue) x d (FdT (Zero) (Succ (Zero)))))))

; The buffer holds T, the last first: its array a, of capacity cap, holds the first n entries.
(def-adts $ (Buf : ((List (Nat)) T) -> Type)
  enum
  (many MkBuf : (erased (List (Nat)) T) (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (many (Nat) n) (erased (Nat) cap)
      (erased (Length (Copy (Nat)) xs cap) l) (erased (Lt (Zero) cap) cp) (erased (AllCu xs) au) (erased (Lt n (Succ cap)) nc) (erased (Tbk xs n T) tb) -> (Buf T)))

(comptime-match many (lt-dec 0 1024) (Yes _ _ _ _ r4-buf-cp))

(def-fns _ $ (many r4-newbuf : -> (unique (Buf (Nil (Nat))) b))
  (let ((erased xs) (unique a) (erased rp)) (array-make (Nat) 1024 0))
  (let-match erased r4-e0 (Refl _ _))
  (MkBuf (Nil _) xs a 0 1024 (repeat-length _ 1024 _ xs rp) r4-buf-cp (allcu-rep 1024 xs rp) (LtZ 1024) (TbkNil xs)))

(def-fns _ $ (erased splice-nth-in : (erased Type A) (erased (List A) xs ys zs) (erased (Nat) n k) (erased A y) (subterm erased (Splice A xs (Zero) n ys zs) p)
    (erased (Nth A ys k y) q) -> (erased (Nth A zs k y) r))
  (let-match erased p (SpliceHere _ _ y0 xs1 n1 ys1 zs1 p1) (absurd (SpliceNil _ _) q))
  (let-match erased q (NthThere _ _ _ k1 _ q1) ((NthHere _ _ _) (NthHere A y zs1)))
  (NthThere A y0 zs1 k1 y (splice-nth-in A xs1 ys1 zs1 n1 k1 y p1 q1)))

(def-fns _ $ (erased tbk-splice : (erased (List (Copy (Nat))) xs ws zs) (erased (Nat) k n) (erased (List (Nat)) T) (subterm erased (Tbk xs k T) t)
    (erased (Splice (Copy (Nat)) ws (Zero) n xs zs) s) -> (erased (Tbk zs k T) r))
  (let-match erased t (TbkCons _ k1 i T1 t1 x) ((TbkNil _) (TbkNil zs)))
  (let-match erased x (MkWElt _ _ _ nth))
  (TbkCons zs k1 i T1 (tbk-splice xs ws zs k1 n T1 t1 s) (MkWElt zs k1 i (splice-nth-in _ ws xs zs n k1 _ s nth))))

(def-fns _ $ (erased allcu-splice : (erased (List (Copy (Nat))) ws ys zs) (erased (Nat) i n) (subterm erased (Splice (Copy (Nat)) ws i n ys zs) s) (erased (AllCu ws) aw)
    (erased (AllCu ys) ay) -> (erased (AllCu zs) r))
  (match erased s _
    ((SpliceNil _ _) aw)
    ((SpliceHere _ _ y ws1 n1 ys1 zs1 s1)
      (let-match erased aw (CuCons _ _ _ aw1))
      (let-match erased ay (CuCons v b _ ay1))
      (CuCons v b zs1 (allcu-splice ws1 ys1 zs1 (Zero) n1 s1 aw1 ay1)))
    ((SpliceThere _ x ws1 k1 _ _ zs1 s1)
      (let-match erased aw (CuCons v b _ aw1))
      (CuCons v b zs1 (allcu-splice ws1 ys zs1 k1 n s1 aw1 ay)))))

(def-fns _ $ (many r4-bgrow : (erased (List (Nat)) T) (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (many (Nat) n c2) (erased (Add n n c2) ac)
    (erased (Length (Copy (Nat)) xs n) l) (erased (Lt (Zero) n) cp) (erased (AllCu xs) au) (erased (Tbk xs n T) tb) (unique (Cell MkBuf (slot-of a) (slot-of n)) u) ->
    (erased (List (Copy (Nat))) zs) (unique (Array (Copy (Nat)) zs) a3) (unique (Cell MkBuf (slot-of a3) (slot-of n)) u3 at u) (erased (Length (Copy (Nat)) zs c2) l2)
    (erased (Lt (Zero) c2) cp2) (erased (Lt n c2) nl) (erased (AllCu zs) au2) (erased (Tbk zs n T) tb2))
  (let ((erased ws) (unique a2) (erased rp)) (array-make (Nat) c2 0))
  (let-match erased r4-e0 (Refl _ _))
  (let ((erased lw)) (repeat-length _ c2 _ ws rp))
  (let ((erased nn)) (le-trans n n c2 (lt-succ n) (add-le-right n n c2 ac)))
  (let ((erased old) (erased to)) (splice-range _ ws c2 lw (Zero) n n (AddZero n) nn))
  (let ((erased zs) (unique a3) (unique _) (erased sp)) (array-blit _ xs ws xs old a 0 a2 0 n (splice-whole _ xs n l) to))
  (values zs a3 (cell-write unique u (MkBuf (slot-of a3) _)) (splice-length _ ws xs zs (Zero) n c2 sp lw) (lt-le-trans (Zero) n c2 cp nn)
    (add-pos-lt n n c2 ac cp) (allcu-splice ws xs zs (Zero) n sp (allcu-rep c2 ws rp) au) (tbk-splice xs ws zs n n T tb sp)))

(def-fns _ $ (many r4-bput : (erased (List (Nat)) T) (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) a) (many (Nat) n)
    (unique (Cell MkBuf (slot-of a) (slot-of n)) u) (many (Nat) n1) (erased (Eq (Nat) n1 (Succ n)) e) (many (Nat) x) (erased (Lt x u62-modulus) xb) (erased (Nat) cap)
    (erased (Length (Copy (Nat)) ys cap) l) (erased (Lt (Zero) cap) cp) (erased (Lt n cap) nl) (erased (AllCu ys) au) (erased (Tbk ys n T) tb)
    -> (unique (Buf (Cons (Nat) x T)) b2 at u))
  (let-match erased e (Refl _ _))
  (let ((erased m) (erased nth)) (nth-exists _ ys cap n l nl))
  (let ((erased ys2) (unique a2) (erased s)) (array-place-imm _ _ a n (MkCopy _ x) m nth (allcu-nth ys n m au nth) (imm-cu x xb)))
  (u (Cons _ x T) ys2 (at) a2 n1 cap (setnth-length _ ys n cap _ ys2 s l) cp (allcu-set ys ys2 n x xb au s) (LtS n cap nl)
    (TbkCons ys2 n x T (tbk-set ys ys2 n n x T tb (MkWPut ys ys2 n x s) (lt-succ n)) (MkWElt ys2 n x (setnth-nth _ ys n _ ys2 s)))))

(def-fns _ $ (erased buf-room : (erased (Nat) n cap) (erased (Lt n (Succ cap)) nc) (erased (Apart (Nat) Lt n cap) ap) -> (erased (Lt n cap) r))
  (match erased ap _ ((ApLt _ _ _ _ q) q) (absurd (ApGt _ _ _ _ q) (lt-irrefl cap (lt-le-trans cap n cap q nc)))))

(def-fns _ $ (erased mul-two-add : (erased (Nat) n c) (erased (Mul 2 n c) m) -> (erased (Add n n c) a))
  (let-match erased r4-e2 (Refl _ _))
  (let-match erased m (MulSucc _ _ c1 _ m1 ac))
  (let-match erased m1 (MulSucc _ _ c0 _ m0 a0))
  (let-match erased m0 (MulZero _))
  (let-match erased a0 (AddZero _))
  ac)

(def-fns _ $ (many r4-bpush-nat : (erased (List (Nat)) T) (unique (Buf T) b) (many (Nat) x) (erased (Lt x u62-modulus) xb) -> (unique (Buf (Cons (Nat) x T)) b2 at b))
  (let-match unique b (MkBuf _ xs a n cap l cp au nc tb u))
  (let ((many len) (erased ll) (unique a1)) (array-length _ _ a))
  (let-match erased (length-fn _ xs len cap ll l) (Refl _ _))
  (let-match many (nat-eq n len) (Equal _ _ _) ((Unequal _ _ _ _ ap) (tail $ r4-bput T xs a1 n u (Succ n) (Refl _ _) x xb cap l cp (buf-room n cap nc ap) au tb)))
  (let ((many c2) (erased m2c)) (mul 2 n))
  (let ((erased zs) (unique a3) (unique u3) (erased l2) (erased cp2) (erased nl) (erased au2) (erased tb2)) (r4-bgrow T xs a1 n c2 (mul-two-add n c2 m2c) l cp au tb u))
  (tail $ r4-bput T zs a3 n u3 (Succ n) (Refl _ _) x xb c2 l2 cp2 nl au2 tb2))

(comptime-match many (lt-dec (Succ fifty-four) (sixty-two-many)) (Yes _ _ _ _ r4-55-lt))

(def-fns _ $ (erased r4-lim2 : -> (erased (Nat) c) (erased (Add array-limit array-limit c) a) (erased (Lt c u62-modulus) b))
  (let ((erased c) (erased dc)) (double array-limit))
  (values c (bn-dadd array-limit c dc) (pow2-lt (Succ fifty-four) sixty-two c u62-modulus r4-55-lt (PS fifty-four array-limit c array-limit-pow2 dc) u62-modulus-pow2)))

(def-fns _ $ (many r4-bpush : (erased (List (Nat)) T) (unique (Buf T) b) (many (Nat) x) (erased (Lt x u62-modulus) xb) -> (unique (Buf (Cons (Nat) x T)) b2 at b))
  (let-match unique b (MkBuf _ xs a n cap l cp au nc tb u))
  (let ((many len) (erased ll) (unique a1)) (array-length _ _ a))
  (let-match erased (length-fn _ xs len cap ll l) (Refl _ _))
  (let ((erased _) (erased ll2) (many d) (unique a2)) (array-length-dec _ _ a1))
  (let-match many d (Yes _ _ _ _ lim) ((No _ _ _ _ _) (tail $ r4-bpush-nat T (at unique (u T xs a2 n cap l cp au nc tb)) x xb)))
  (let-match erased (length-fn _ xs _ cap ll2 l) (Refl _ _))
  (let ((erased cb)) (lt-trans cap array-limit u62-modulus lim array-limit-below-u62))
  (let ((erased nb)) (le-u62 n cap nc cb))
  (match many (u62-eq n len nb cb) _
    ((Equal _ _ _)
      (let ((erased c2v) (erased m2c)) (mul 2 n))
      (let ((erased ac)) (mul-two-add n c2v m2c))
      (let ((erased lL) (erased aL) (erased bL)) (r4-lim2))
      (let ((erased nL) (erased anL)) (add n array-limit))
      (let ((erased c2b)) (lt-trans c2v lL u62-modulus (lt-trans c2v nL lL (add-lt-mono n n array-limit c2v nL ac anL lim)
        (add-lt-mono array-limit n array-limit nL lL (add-comm n array-limit nL anL) aL lim)) bL))
      (let ((many c2)) (u62-mul 2 n r4-2-u62 nb c2v m2c c2b))
      (let ((erased zs) (unique a3) (unique u3) (erased l2) (erased cp2) (erased nl) (erased au2) (erased tb2)) (r4-bgrow T xs a2 n c2 ac l cp au tb u))
      (tail $ r4-bput T zs a3 n u3 (u62-inc n (lt-le-trans (Succ n) (Succ c2) u62-modulus (LtS n c2 nl) (LtS c2 u62-modulus c2b))) (Refl _ _) x xb c2 l2 cp2 nl au2 tb2))
    ((Unequal _ _ _ _ ap)
      (let ((erased nl)) (buf-room n cap nc ap))
      (tail $ r4-bput T xs a2 n u (u62-inc n (lt-le-trans (Succ n) (Succ cap) u62-modulus (LtS n cap nl) (LtS cap u62-modulus cb))) (Refl _ _) x xb cap l cp nl au tb))))

(def-fns _ $ (many r4-gb : (erased (List (U8)) us) (unique (Bytes us) b) (many (Nat) i) (erased (Nat) v) (erased (Elt flag-w us i v) x) -> (unique b is b2 at b) (many v is r))
  (let-match erased x (MkElt _ _ _ q _ m ds s le))
  (let-match erased (mul-flag i q m) (Refl _ _))
  (let ((erased vb) (erased s1)) (byte-of us ds us i q v m s le))
  (let ((many c) (unique b2)) (bytes-get _ b i (MkU8 v vb) (splice-nth _ us (Nil (U8)) us i (Zero) _ s1)))
  (let-match many c (MkU8 r _))
  (values b2 r))

(def-fns _ $ (many r4-sb : (erased (List (U8)) us) (unique (Bytes us) b) (many (Nat) i v) (erased (Nat) len) (erased (Sz flag-w us len) z) (erased (Lt i len) il)
    (erased (Lt v u8-modulus) vb) -> (erased (List (U8)) vs) (unique (Bytes vs) b2 at b) (erased (Put flag-w us i v vs) u) (erased (Sz flag-w vs len) z2))
  (let ((erased m) (erased nth)) (nth-exists _ us len i (flag-length us len z) il))
  (let ((erased vs) (unique b2) (erased s)) (bytes-set _ b i (MkU8 v vb) m nth))
  (let ((erased u)) (flag-put us vs i v vb s))
  (values vs b2 u (put-sz flag-w us vs i v len u z)))

; The node words of gtu, as make_eng fills them: its layout, all of it in gu, nothing in gtr.
(def-adts $ (Nodes : ((Nat) h) ((Gtree) gtu) -> Type)
  enum
  (many MkNodes : (erased (Nat) h) (erased (Gtree) gtu) (erased (List (Copy (Nat))) xs) (many (Array (Copy (Nat)) xs) ns) (many (Nat) len)
      (erased (Length (Copy (Nat)) xs len) l) (erased (AllCu xs) au) (erased (NLay xs h (Zero) gtu) ly) (erased (NPart xs h (Zero) gtu (BFalse) gtu) pu)
      (erased (NPart xs h (Zero) gtu (BTrue) (GEmpty)) pt) -> (Nodes h gtu)))

(def-fns _ $ (many r4-nodes : (erased (Nat) h) (many (Gtree) gtu) (erased (GShp (Succ h) gtu) gsh) (erased (GPres gtu (BTrue)) ne) -> (many (Maybe (Nodes h gtu)) r))
  (let ((many n) (erased gn)) (r4-cnt gtu))
  (let ((erased c1) (erased ec)) (gct-pos gtu n gn ne))
  (let-match erased ec (Refl _ _))
  (let ((many L4) (erased ml)) (mul (Succ n) 4096))
  (let-match many (nat-fits-u62 L4) (Yes _ _ _ _ lb) ((No _ _ _ _ _) (None _)))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let ((erased xs) (unique a) (erased rp)) (array-make (Nat) n 0))
  (let ((erased ys) (unique r) (many _) (erased fo))
    (r4-fill xs a n (repeat-length _ n _ xs rp) (allcu-rep n xs rp) (MkNCap n L4 ml lb) h gtu gsh 1 0 c1 n gn (AddSucc (Zero) c1 c1 (AddZero c1))
      (lt-succ n) (LtZ (Zero))))
  (let-match erased fo (MkFillOk _ _ _ _ _ _ _ _ _ _ f _ l2 au2))
  (Some _ (MkNodes h gtu ys (share r) n l2 au2 (flb-lay ys h (Zero) _ _ gtu f) (flb-part ys h (Zero) _ _ gtu f) (flb-tr ys h (Zero) _ _ gtu f))))

; v is 0 for the empty tree and 1 otherwise.
(def-adts $ (Nz : ((Ctree) t) ((Nat) v) -> Type)
  enum
  (many NzE : -> (Nz (CEmpty) (Zero)))
  (many NzL : (erased (Ctree) lf) -> (Nz (CLeaf lf) (Succ (Zero))))
  (many NzN : (erased (Ctree) t1 t2 t3) -> (Nz (CNode t1 t2 t3) (Succ (Zero)))))

(def-adts
  ; Trie node n, whose children are 3n + 1 to 3n + 3, holds t, of j + 1 more colours: its entry is the number of nonempty children of t,
  ; and each child above the traces is held the same way.
  ((Lc : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many LcE : (erased (List (U8)) us) (erased (Nat) j n) (erased (Elt flag-w us n (Zero)) x) -> (Lc us j n (CEmpty)))
    (many LcN : (erased (List (U8)) us) (erased (Nat) j n q c a1 a2 a3 c12) (erased (Ctree) t1 t2 t3) (erased (Elt flag-w us n c) x) (erased (Thrice n q) tq)
        (erased (Nz t1 a1) z1) (erased (Nz t2 a2) z2) (erased (Nz t3 a3) z3) (erased (Add a1 a2 c12) s1) (erased (Add c12 a3 c) s2)
        (erased (LcK us j (Succ q) t1) k1) (erased (LcK us j (Succ (Succ q)) t2) k2) (erased (LcK us j (Succ (Succ (Succ q))) t3) k3)
        -> (Lc us j n (CNode t1 t2 t3))))
  ((LcK : ((List (U8)) us) ((Nat) j) ((Nat) n) ((Ctree) t) -> Type)
    enum
    (many LkZ : (erased (List (U8)) us) (erased (Nat) n) (erased (Ctree) t) -> (LcK us (Zero) n t))
    (many LkS : (erased (List (U8)) us) (erased (Nat) j n) (erased (Ctree) t) (erased (Lc us j n t) l) -> (LcK us (Succ j) n t))))
