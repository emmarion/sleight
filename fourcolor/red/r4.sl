  (values (u62-add o q n ad (lt-trans n len u62-modulus nl (sz-u62 flag-w us len z))) ad nl))

; j plus twice m is at most wd.
(def-adts $ (Rmd : ((Nat) j) ((Nat) m) ((Nat) wd) -> Type)
  enum
