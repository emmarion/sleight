  (let ((many h6) (erased v2) (erased pv2) (erased mq2) (erased r2) (erased mm2) (erased ad2) (erased rl2) (erased h6b)) (u62-shr w 6 wb r4-six-lt))
  (let ((erased _) (erased e6)) (bsp-fn 6 w r2 h6 lo6 y6 (bsp-of 6 v2 h6 mq2 r2 w pv2 mm2 ad2 rl2) q6))
  (let-match erased e6 (Refl _ _))
