    (let ((many d) (erased dl) (erased md) (erased _)) (u62-mod t 3 tb r4-three-u62 (LtZ _)))
    (let ((erased sv) (erased as)) (add d r))
    (let ((erased two)) (Succ (Succ (Zero))))
    (let ((erased svb)) (lt-trans sv (Succ (Succ (Succ (Succ (Succ (Zero)))))) u62-modulus
      (add-le2 d r sv two two (Succ (Succ two)) as dl rl (AddSucc (Succ (Zero)) two (Succ two) (AddSucc (Zero) two two (AddZero two)))) r4-s5-u62))
    (let ((many s)) (u62-add d r sv as svb))
