    (let ((erased vb)) (lt-trans v M u62-modulus vl Mu))
    (let ((erased m) (erased nth)) (nth-exists _ xs M i l il))
    (let ((erased ys) (unique a2) (erased s)) (array-place-imm _ _ a i (MkCopy _ v) m nth (allcu-nth xs i m au nth) (imm-cu v vb)))
    (let-match erased kk (Succ k1) (absurd (Zero) (let-match erased (add-fn i (Zero) M i ad (add-zero-right i)) (Refl _ _)) (lt-irrefl i il)))
    (tail $ fill ys a2 (u62-inc i (lt-le-trans (Succ i) (Succ M) u62-modulus (LtS i M il) (LtS M u62-modulus Mu))) k1 (add-sh i k1 M ad) (setnth-length _ xs i M _ ys s l)
      (RtS r n i v ys (rt-set r n i i xs ys (MkCopy _ v) rt s (lt-succ i)) (MkWElt ys i v (setnth-nth _ xs i _ ys s)) g) (allcu-set xs ys i v vb au s)))
  (let ((erased xs) (unique a) (erased rp)) (array-make (Nat) M 0))
  (let ((erased ys) (unique a2) (erased l2) (erased rt2) (erased au2)) (fill xs a 0 M (AddZero M) (repeat-length _ M _ xs rp) (RtZ r n xs) (allcu-rep M xs rp)))
  (values M pm ys a2 l2 rt2 au2))

