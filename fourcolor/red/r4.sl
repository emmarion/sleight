  (let ((erased c4) (erased pc4)) (bsp-lo0 2 cm))
  (let-match erased (bitwise-fn and-op h6 60 x c4 px (and-mask 2 4 h6 lo2 y2 cm b 15 60 c4 q2 p3 r4-o15 r4-b60 pc4)) (Refl _ _))
  (let ((erased xb)) (lt-le-trans x (Succ h6) u62-modulus (and-le h6 60 x px) (LtS h6 u62-modulus h6b)))
