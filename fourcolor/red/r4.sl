    ((WhPop _ q1 _ e2 _ b1 _ _ k1 _) (WcMiss q1 q2 r b1 Q0 gs rest (kid-apart p q q1 q2 e2 e ap k1 kq) pc))
    ((WhNone _ _ _ _) pc)))

