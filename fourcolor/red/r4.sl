(def-fns _ $ (erased ks-next : (erased (Nat) cm s i) (erased (List (Gtree)) ts) (erased (List (KidP)) ch) (subterm erased (KS cm s ts ch i) k)
    -> (erased (Nat) s2) (erased (List (Gtree)) ts2) (erased (KSkip cm s ts s2 ts2) sk) (erased (KsHd cm s2 ts2 ch i) hd))
