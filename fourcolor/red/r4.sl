      (erased (Length (Copy (Nat)) xs M) l) (erased (Pw3 n (Succ (Zero)) M) pm) (erased (RotTab r n M xs) rt) (erased (AllCu xs) au)
      (erased (Nth (Copy (RRow)) rs i (MkCopy (RRow) (MkRRow r n M xs a l rt au))) nth) -> (RowAt rs i r n)))

; red4's eng for h: the node words of gtu, the live children ul0 and the trace counts uc0 of the tree ctu, lo and the rotation tables.
(def-adts $ (Eng : ((Nat) h) -> Type)
  enum
  (many MkEng : (many (Nat) h) (erased (Gtree) gtu) (erased (List (Copy (Nat))) xs) (many (Array (Copy (Nat)) xs) nodes0) (erased (List (U8)) us) (many (Bytes us) ul0)
      (erased (List Cnt) vs) (many (Bytes vs) uc0) (many (Nat) lo) (erased (List (Copy (RRow))) rs) (many (Array (Copy (RRow)) rs) rtab)
      (erased (Nat) len o N ld hd) (erased (Length (Copy (Nat)) xs len) lx) (erased (AllCu xs) ax) (erased (NLay xs h (Zero) gtu) ly)
      (erased (NPart xs h (Zero) gtu (BFalse) gtu) pu) (erased (NPart xs h (Zero) gtu (BTrue) (GEmpty)) pt) (erased (GCov (GSG gtu) (Zero) (BFalse) (Succ h)) gc)
      (erased (Offs (Succ h) o) of) (erased (Sz flag-w us o) zu) (erased (Sz cnt-w vs N) zv) (erased (Pw3 (Succ h) (Succ (Zero)) N) pw)
      (erased (Ctree) ctu) (erased (Tally vs (Succ h) (Zero) ctu) tb) (erased (Lc us h (Zero) ctu) lc)
      (erased (Add ld hd (Succ h)) ad) (erased (Pw3 ld (Succ (Zero)) lo) pl) (erased (RowAt rs (Zero) (Succ (Zero)) ld) r0)
      (erased (RowAt rs (Succ (Zero)) (Succ (Zero)) hd) r1) (erased (RowAt rs (Succ (Succ (Zero))) (Succ (Succ (Zero))) ld) r2)
      (erased (RowAt rs (Succ (Succ (Succ (Zero)))) (Succ (Succ (Zero))) hd) r3) (erased (CEv ctu (ESStart)) ce)
      (erased (GE ctu (Cons RS (MkRx (GSet) (BS0) (GSG gtu)) (Nil RS)) (ESStart) (Succ h)) ge) (erased (CtH (Succ h) ctu) hc)
      (erased (Nat) ilo ihi) (erased (NIv xs h (Zero) gtu ilo ihi (BTrue)) iv) (erased (Lt (Succ h) 17) hl) (erased (Lt len u62-modulus) lnb) (erased (GzA xs) gz) -> (Eng h)))

