      (erased (Kid p e q) k) (erased (Lt q r4-none) l) -> (XtP p bs g q))
  (many XpNone : (erased (Nat) p) (erased (Gsym) g) (erased (IsPop g) ip) -> (XtP p (BS0) g r4-none)))

; b2 is the stack word that the stack bs becomes under the symbol g: for Push the colour-2 child's.
(def-adts $ (XtB : ((Bstack) bs) ((Gsym) g) ((Nat) b2) -> Type)
