(def-adts $ (FoldM : ((List (KidP)) ch) ((Nat) m0) ((Nat) m) -> Type)
  enum
  (many FmNil : (erased (Nat) m) -> (FoldM (Nil (KidP)) m m))
  (many FmCons : (erased (Nat) s m0 m1 m v) (erased (Gtree) t) (erased (List (KidP)) rest) (erased (Pow2 s v) pv) (erased (Bitwise or-op m0 v m1) o)
      (erased (FoldM rest m1 m) f) -> (FoldM (Cons (KidP) (MkKidP s t) rest) m0 m)))

; Bit s of m is x.
(def-adts $ (BitIs : ((Nat) m) ((Nat) s) ((Bit) x) -> Type)
