          (let ((erased Fb) (erased t2) (erased t3)) (trp-split D1 D1 d2 F2 Fm a2 tB))
          (let ((erased qb)) (QbCons (Zero) D1 F2 Fa F (LtZ _) t0 $ QbCons (Succ (Zero)) D1 F2 Fm Fa (LtS _ _ (LtZ _)) t1
