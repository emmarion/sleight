(comptime-match many (lt-dec 256 flag-um) (Yes _ _ _ _ r4-256-u62))

(def-fns _ $ (many sdig-at : (many (Nat) i) (erased (Lt i 64) il) -> (many (Nat) v) (erased (SDigE i v) p) (erased (Lt v u62-modulus) vb))
  (let-match erased r4-e0 (Refl _ _))
  (let-match erased r4-one (Refl _ _))
  (let-match erased r4-e2 (Refl _ _))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let ((many t) (many m) (erased p)) (bsp-c 2 i))
  (let ((erased w) (erased mq) (erased pw) (erased mm) (erased ad) (erased tl)) (bsp-arith 2 i t m p))
  (let-match erased (pow2-fn 2 w 4 pw r4-p4) (Refl _ _))
  (let-match many (lt-dec m 16) (Yes _ _ _ _ ml)
    (absurd (No _ _ _ _ le) (lt-irrefl i (lt-le-trans i 64 i il (le-trans 64 mq i (mul-le-mono 16 m 4 64 mq (le-lt-succ 16 m le) r4-pm64 mm) (add-le-left mq t i ad))))))
  (let ((many b0) (many b1) (many b2) (many b3) (erased x0) (erased x1) (erased x2) (erased x3) (erased e0) (erased e1) (erased e2) (erased e3) (erased ac)) (r4-bit4 m ml))
  (let ((many a0) (erased n0)) (r4-b01 b0))
  (let ((many a1) (erased n1)) (r4-b01 b1))
  (let ((many a2) (erased n2)) (r4-b01 b2))
  (let ((many a3) (erased n3)) (r4-b01 b3))
  (let ((erased l0)) (b01-le b0 a0 n0))
  (let ((erased l1)) (b01-le b1 a1 n1))
  (let ((many f1) (erased s1)) (add a0 a2))
  (let ((many f2) (erased s2)) (add a0 a3))
  (let ((many g1) (erased u1)) (add a0 a3))
  (let ((many g2) (erased u2)) (add a0 a2))
  (let ((erased lf1) (erased lf2) (erased lg1) (erased lg2)) (values (b01-sum b0 b2 a0 a2 f1 n0 n2 s1) (b01-sum b0 b3 a0 a3 f2 n0 n3 s2) (b01-sum b0 b3 a0 a3 g1 n0 n3 u1) (b01-sum b0 b2 a0 a2 g2 n0 n2 u2)))
  (let-match many (nat-eq t 3) (Unequal _ _ _ _ ap3)
    ((Equal _ _ _)
      (let ((many h0) (erased s0)) (add a1 a3))
      (let ((many y3) (erased _) (erased _) (erased m3) (erased d3)) (r4-bsp2 a0 a2 (lt-weaken a0 _ l0)))
      (let ((many y2) (erased _) (erased _) (erased m2) (erased d2)) (r4-bsp2 a0 y3 (lt-weaken a0 _ l0)))
      (let ((many v) (erased _) (erased _) (erased m1) (erased d1)) (r4-bsp2 h0 y2 (lt-weaken h0 _ (b01-sum b1 b3 a1 a3 h0 n1 n3 s0))))
      (let ((erased l3)) (digit-lt 4 4 16 a0 a2 _ y3 (lt-weaken a0 _ l0) (lt-weaken a2 _ (b01-le b2 a2 n2)) m3 d3 r4-m44))
      (let ((erased l2)) (digit-lt 4 16 64 a0 y3 _ y2 (lt-weaken a0 _ l0) l3 m2 d2 r4-pm64))
      (values v (SdT3 i m v p) (lt-trans v 256 u62-modulus (digit-lt 4 64 256 h0 y2 _ v (lt-weaken h0 _ (b01-sum b1 b3 a1 a3 h0 n1 n3 s0)) l2 m1 d1 r4-m644) r4-256-u62))))
  (let ((many c1) (many c2) (erased dg) (erased k1) (erased k2))
    (match many t (((Nat) c1) ((Nat) c2) ((DgC b0 b1 b2 b3 t a1 c1 c2) dg) ((Lt c1 4) k1) ((Lt c2 4) k2))
      ((Zero) (values a0 a0 (DgT0 b0 b1 b2 b3 a0 a1 n0 n1) (lt-weaken a0 _ l0) (lt-weaken a0 _ l0)))
      ((Succ t1)
        (let-match many t1 (Succ t2) ((Zero) (values f1 f2 (DgT1 b0 b1 b2 b3 a0 a1 a2 a3 f1 f2 n0 n1 n2 n3 s1 s2) (lt-weaken f1 _ lf1) (lt-weaken f2 _ lf2))))
        (let-match many t2 (Zero)
          (absurd (Succ t3)
            (let-match erased t3 (Zero) (absurd (Succ t4) (let-match erased tl (LtS _ _ q1)) (let-match erased q1 (LtS _ _ q2)) (let-match erased q2 (LtS _ _ q3)) (let-match erased q3 (LtS _ _ q4)) q4))
            (apart-irrefl t ap3)))
        (values g1 g2 (DgT2 b0 b1 b2 b3 a0 a1 a2 a3 g1 g2 n0 n1 n2 n3 u1 u2) (lt-weaken g1 _ lg1) (lt-weaken g2 _ lg2)))))
  (let ((many y) (erased ty) (erased q2) (erased my) (erased ay)) (r4-bsp2 c1 c2 k1))
  (let ((many v) (erased tv) (erased q1) (erased mv) (erased av)) (r4-bsp2 a1 y (lt-weaken a1 _ l1)))
  (let ((erased yl)) (digit-lt 4 4 16 c1 c2 ty y k1 k2 my ay r4-m44))
  (let ((erased vl)) (digit-lt 4 16 64 a1 y tv v (lt-weaken a1 _ l1) yl mv av r4-pm64))
  (values v (SdOk i t m v a1 c1 c2 y b0 b1 b2 b3 x0 x1 x2 x3 p e0 e1 e2 e3 ac dg q1 q2) (lt-trans v 64 u62-modulus vl r4-64-u62)))

(let ((erased r4-sdl) (many r4-stab)) (tab-factory (level-of sdig-at)))
(let ((erased r4-sdig-l) (unique r4-sdig0) (erased r4-sdig-t) (erased r4-sdig-n) (erased r4-sdig-a)) (r4-stab SDigE 64 r4-64-u62 sdig-at))
(let ((many r4-sdig)) (share r4-sdig0))

(def-fns _ $ (erased bset-root : (erased (Bool) b) (erased (GSet) g) (erased (Nat) a) (erased (BSet b g) q) (erased (B01 b a) n) -> (erased (GRoot g a) r))
  (match erased q _ ((BSetT) (let-match erased n (B01T)) (GROne)) ((BSetF) (let-match erased n (B01F)) (GRG (GEmpty)))))

(def-fns _ $ (erased leaf-one : (erased (Gtree) l) (erased (Bool) b0 b1 b2 b3 b) (erased (LeafSet l (MkBits b0 b1 b2 b3)) ls) (erased (Gsym) s)
    (erased (Pick4 (Bool) s b0 b1 b2 b3 b) pk) (erased (Nat) a) (erased (B01 b a) n) (erased (Bstack) bs) -> (erased (GSet) g) (erased (GSel (GSG l) s g) sl)
    (erased (MC g bs (Nil (Col)) a) m))
  (let ((erased g) (erased q)) (bset-exists b))
  (values g (GSelL l b0 b1 b2 b3 b s g ls pk q) (MCNil g bs a (bset-root b g a q n))))

; The chromograms of the leaf l matching each colour from the stack bs.
(def-fns _ $ (erased leaf-mc : (erased (Gtree) l) (erased (Bool) b0 b1 b2 b3) (erased (LeafSet l (MkBits b0 b1 b2 b3)) ls) (erased (Bstack) bs) (erased (Nat) t f0 f1 f2)
    (erased (TopN bs t) tn) (erased (DgC b0 b1 b2 b3 t f0 f1 f2) dg) -> (erased (MC (GSG l) bs (Cons (Col) (C1) (Nil (Col))) f0) m1)
    (erased (MC (GSG l) bs (Cons (Col) (C2) (Nil (Col))) f1) m2) (erased (MC (GSG l) bs (Cons (Col) (C3) (Nil (Col))) f2) m3))
  (let ((erased gs)) (GSG l))
  (match erased dg _
    ((DgT0 _ _ _ _ a0 a1 n0 n1)
      (let-match erased tn (TnE))
      (let ((erased gk) (erased sk) (erased mk)) (leaf-one l b0 b1 b2 b3 b1 ls (GSkip) (PkSkip _ b0 b1 b2 b3) a1 n1 bs))
      (let ((erased g2) (erased s2) (erased k2)) (leaf-one l b0 b1 b2 b3 b0 ls (GPush) (PkPush _ b0 b1 b2 b3) a0 n0 (BP0 bs)))
      (let ((erased g3) (erased s3) (erased k3)) (leaf-one l b0 b1 b2 b3 b0 ls (GPush) (PkPush _ b0 b1 b2 b3) a0 n0 (BP1 bs)))
      (values (MCSkip gs gk bs _ a1 sk mk) (MCPush gs g2 (BP0 bs) (C2) _ a0 (SPush2 bs) s2 k2) (MCPush gs g3 (BP1 bs) (C3) _ a0 (SPush3 bs) s3 k3)))
    ((DgT1 _ _ _ _ a0 a1 a2 a3 _ _ n0 n1 n2 n3 u1 u2)
      (let-match erased tn (Tn0 c))
      (let ((erased gk) (erased sk) (erased mk)) (leaf-one l b0 b1 b2 b3 b1 ls (GSkip) (PkSkip _ b0 b1 b2 b3) a1 n1 bs))
      (let ((erased g2) (erased s2) (erased k2)) (leaf-one l b0 b1 b2 b3 b0 ls (GPush) (PkPush _ b0 b1 b2 b3) a0 n0 (BP0 bs)))
      (let ((erased g3) (erased s3) (erased k3)) (leaf-one l b0 b1 b2 b3 b0 ls (GPush) (PkPush _ b0 b1 b2 b3) a0 n0 (BP1 bs)))
      (let ((erased h2) (erased t2) (erased j2)) (leaf-one l b0 b1 b2 b3 b2 ls (GPop0) (PkPop0 _ b0 b1 b2 b3) a2 n2 c))
      (let ((erased h3) (erased t3) (erased j3)) (leaf-one l b0 b1 b2 b3 b3 ls (GPop1) (PkPop1 _ b0 b1 b2 b3) a3 n3 c))
      (values (MCSkip gs gk bs _ a1 sk mk)
        (MCPP gs g2 h2 bs c (BP0 bs) (GPop0) (C2) _ a0 a2 f1 (Popped0 c) (SPush2 bs) s2 k2 (SPop02 c) t2 j2 u1)
        (MCPP gs g3 h3 bs c (BP1 bs) (GPop1) (C3) _ a0 a3 f2 (Popped0 c) (SPush3 bs) s3 k3 (SPop13 c) t3 j3 u2)))
    ((DgT2 _ _ _ _ a0 a1 a2 a3 _ _ n0 n1 n2 n3 u1 u2)
      (let-match erased tn (Tn1 c))
      (let ((erased gk) (erased sk) (erased mk)) (leaf-one l b0 b1 b2 b3 b1 ls (GSkip) (PkSkip _ b0 b1 b2 b3) a1 n1 bs))
      (let ((erased g2) (erased s2) (erased k2)) (leaf-one l b0 b1 b2 b3 b0 ls (GPush) (PkPush _ b0 b1 b2 b3) a0 n0 (BP0 bs)))
      (let ((erased g3) (erased s3) (erased k3)) (leaf-one l b0 b1 b2 b3 b0 ls (GPush) (PkPush _ b0 b1 b2 b3) a0 n0 (BP1 bs)))
      (let ((erased h2) (erased t2) (erased j2)) (leaf-one l b0 b1 b2 b3 b2 ls (GPop0) (PkPop0 _ b0 b1 b2 b3) a2 n2 c))
      (let ((erased h3) (erased t3) (erased j3)) (leaf-one l b0 b1 b2 b3 b3 ls (GPop1) (PkPop1 _ b0 b1 b2 b3) a3 n3 c))
      (values (MCSkip gs gk bs _ a1 sk mk)
        (MCPP gs g2 h3 bs c (BP0 bs) (GPop1) (C2) _ a0 a3 f1 (Popped1 c) (SPush2 bs) s2 k2 (SPop12 c) t3 j3 u1)
        (MCPP gs g3 h2 bs c (BP1 bs) (GPop0) (C3) _ a0 a2 f2 (Popped1 c) (SPush3 bs) s3 k3 (SPop03 c) t2 j2 u2)))))

(def-fns _ $ (erased bitv-inv : (erased (Bit) x y) (erased (Nat) v) (erased (BitV x v) p) (erased (BitV y v) q) -> (erased (Eq (Bit) x y) e))
  (match erased p _ ((BV0) (let-match erased q (BV0)) (Refl _ x)) ((BV1) (let-match erased q (BV1)) (Refl _ x))))

(def-fns _ $ (erased bb-inv : (erased (Bool) b c) (erased (Bit) x) (erased (BoolBit b x) p) (erased (BoolBit c x) q) -> (erased (Eq (Bool) b c) e))
  (match erased p _ ((BBT) (let-match erased q (BBT)) (Refl _ b)) ((BBF) (let-match erased q (BBF)) (Refl _ b))))

(def-fns _ $ (erased ac-fn : (erased (List (Bit)) xs ys) (erased (Nat) s m) (subterm erased (Ac xs s m) a) (erased (Ac ys s m) b) -> (erased (Eq (List (Bit)) xs ys) e))
  (match erased a _
    ((AcZ) (let-match erased b (AcZ)) (Refl _ xs))
    ((AcS xs1 s1 m1 _ v x a1 bv p)
      (let-match erased b (AcS ys1 _ m2 _ v2 y b1 bv2 p2))
      (let ((erased e1) (erased e2)) (bsp-fn s1 m m1 v m2 v2 p p2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let-match erased (bitv-inv x y v bv bv2) (Refl _ _))
      (let-match erased (ac-fn xs1 ys1 s1 m1 a1 b1) (Refl _ _))
      (Refl _ xs))))

; The sdig entry v at the symbols m of the leaf l and the top t of bs: the chromograms of l matching each colour from bs, two bits each.
(def-fns _ $ (erased sdig-mc : (erased (Nat) i v t m) (erased (Gtree) l) (erased (Bstack) bs) (erased (SDigE i v) sd) (erased (Bsp 2 i t m) p) (erased (TopN bs t) tn)
    (erased (LeafM l m) lm) -> (erased (Nat) f0 f1 f2 y) (erased (Bsp 2 v f0 y) q1) (erased (Bsp 2 y f1 f2) q2)
    (erased (MC (GSG l) bs (Cons (Col) (C1) (Nil (Col))) f0) m1) (erased (MC (GSG l) bs (Cons (Col) (C2) (Nil (Col))) f1) m2)
    (erased (MC (GSG l) bs (Cons (Col) (C3) (Nil (Col))) f2) m3) (erased (Lt f2 4) l2))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e4s (Refl _ _))
  (let-match erased sd (SdOk _ t2 m2 _ f0 f1 f2 y c0 c1 c2 c3 z0 z1 z2 z3 p2 g0 g1 g2 g3 a dg q1 q2)
    (absurd (SdT3 _ m3 _ p3)
      (let ((erased e1) (erased _)) (bsp-fn 2 i t m 3 m3 p p3))
      (let-match erased e1 (Refl _ _))
      (match erased tn _ (absurd TnE) (absurd Tn0) (absurd Tn1))))
  (let ((erased e1) (erased e2)) (bsp-fn 2 i t m t2 m2 p p2))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased lm (MkLeafM _ _ d0 d1 d2 d3 w0 w1 w2 w3 ls h0 h1 h2 h3 a2))
  (let-match erased (ac-fn _ _ 4 m a a2) (Refl _ _))
  (let-match erased (bb-inv c0 d0 z0 g0 h0) (Refl _ _))
  (let-match erased (bb-inv c1 d1 z1 g1 h1) (Refl _ _))
  (let-match erased (bb-inv c2 d2 z2 g2 h2) (Refl _ _))
  (let-match erased (bb-inv c3 d3 z3 g3 h3) (Refl _ _))
  (let ((erased k1) (erased k2) (erased k3)) (leaf-mc l c0 c1 c2 c3 ls bs t f0 f1 f2 tn dg))
  (let ((erased l2))
    (match erased dg (((Lt f2 4) lz))
      ((DgT0 _ _ _ _ a0 _ n0 _) (lt-weaken a0 _ (b01-le _ a0 n0)))
      ((DgT1 _ _ _ _ a0 _ _ a3 _ _ n0 _ _ n3 _ u2) (lt-weaken f2 _ (b01-sum _ _ a0 a3 f2 n0 n3 u2)))
      ((DgT2 _ _ _ _ a0 _ ax2 _ _ _ n0 _ n2 _ _ u2) (lt-weaken f2 _ (b01-sum _ _ a0 ax2 f2 n0 n2 u2)))))
  (values f0 f1 f2 y q1 q2 k1 k2 k3 l2))

; c is the sum of the hits on the trace t over the events E.
(def-adts $ (HSum : ((List (WEv)) E) ((Nat) t) ((Nat) c) -> Type)
  enum
  (many HsNil : (erased (Nat) t) -> (HSum (Nil (WEv)) t (Zero)))
  (many HsHit : (erased (List (WEv)) E) (erased (Nat) t a c c2) (erased (HSum E t c) h) (erased (Add c a c2) ad) -> (HSum (Cons (WEv) (WHit t a) E) t c2))
  (many HsOth : (erased (List (WEv)) E) (erased (Nat) t t2 a c) (erased (HSum E t c) h) (erased (Apart (Nat) Lt t2 t) ap) -> (HSum (Cons (WEv) (WHit t2 a) E) t c))
  (many HsDrop : (erased (List (WEv)) E) (erased (List (U8)) us) (erased (Nat) k j q o n t c) (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z)
      (erased (HSum E t c) h) -> (HSum (Cons (WEv) (WDrop us k j q o n of ad z) E) t c)))

(def-fns _ $ (erased wsm-hsum : (erased (List (WEv)) E) (erased (Nat) t c) (erased (Bool) d) (subterm erased (WSm E t c d) m) -> (erased (HSum E t c) h))
  (match erased m _
    ((WmNil _) (HsNil t))
    ((WmHit E1 _ a c1 _ _ m1 ad) (HsHit E1 t a c1 c (wsm-hsum E1 t c1 _ m1) ad))
    ((WmHitO E1 _ t2 a _ _ m1 ap) (HsOth E1 t t2 a c (wsm-hsum E1 t c _ m1) ap))
    ((WmIn E1 us k j q o n _ _ _ of ad z _ m1 _ _) (HsDrop E1 us k j q o n t c of ad z (wsm-hsum E1 t c _ m1)))
    ((WmOut E1 us k j q o n _ _ _ _ of ad z _ m1 _ _ _) (HsDrop E1 us k j q o n t c of ad z (wsm-hsum E1 t c _ m1)))))

(def-fns _ $ (erased hsum-fn : (erased (List (WEv)) E) (erased (Nat) t c c2) (subterm erased (HSum E t c) h) (erased (HSum E t c2) g) -> (erased (Eq (Nat) c c2) e))
  (match erased h _
    ((HsNil _) (let-match erased g (HsNil _)) (Refl _ c))
    ((HsHit E1 _ a c1 _ h1 ad)
      (let-match erased g (HsHit _ _ _ c3 _ g1 ad2) (absurd (HsOth _ _ _ _ _ _ ap) (apart-irrefl t ap)))
      (let-match erased (hsum-fn E1 t c1 c3 h1 g1) (Refl _ _))
      (add-fn c1 a c c2 ad ad2))
    ((HsOth E1 _ t2 a _ h1 ap)
      (let-match erased g (HsOth _ _ _ _ _ g1 _) (absurd (HsHit _ _ _ _ _ _ _) (apart-irrefl t ap)))
      (hsum-fn E1 t c c2 h1 g1))
    ((HsDrop E1 _ _ _ _ _ _ _ _ _ _ _ h1) (let-match erased g (HsDrop _ _ _ _ _ _ _ _ _ _ _ _ g1)) (hsum-fn E1 t c c2 h1 g1))))

; The count c of the trace t, whose leaf entry is v: 0 when v is 0, the hits on t over E otherwise.
(def-adts $ (TrC : ((Nat) v) ((Nat) c) ((List (WEv)) E) ((Nat) t) -> Type)
  enum
  (many TrZ : (erased (List (WEv)) E) (erased (Nat) t) -> (TrC (Zero) (Zero) E t))
  (many TrH : (erased (Nat) v c t) (erased (List (WEv)) E) (erased (HSum E t c) h) -> (TrC (Succ v) c E t)))

; The traces below n have their counts in cs, as TrC gives them from their leaf entries in us from o on.
(def-adts $ (CntR : ((List (Copy (Nat))) cs) ((List (U8)) us) ((Nat) o) ((List (WEv)) E) ((Nat) n) -> Type)
  enum
  (many CrZ : (erased (List (Copy (Nat))) cs) (erased (List (U8)) us) (erased (Nat) o) (erased (List (WEv)) E) -> (CntR cs us o E (Zero)))
  (many CrS : (erased (List (Copy (Nat))) cs) (erased (List (U8)) us) (erased (Nat) o n c x v) (erased (List (WEv)) E) (erased (CntR cs us o E n) r)
      (erased (WElt cs n c) w) (erased (Add o n x) ad) (erased (Elt flag-w us x v) e) (erased (TrC v c E n) ce) -> (CntR cs us o E (Succ n))))

(def-fns _ $ (erased welt-fn : (erased (List (Copy (Nat))) cs) (erased (Nat) i a b) (erased (WElt cs i a) p) (erased (WElt cs i b) q) -> (erased (Eq (Nat) a b) e))
  (let-match erased p (MkWElt _ _ _ np))
  (let-match erased q (MkWElt _ _ _ nq))
  (let-match erased (nth-fn _ cs i _ _ np nq) (Refl _ _))
  (Refl _ a))

(def-fns _ $ (erased evx-fn : (erased (List (U8)) us) (erased (Nat) o t x y v w) (erased (Add o t x) a) (erased (Elt flag-w us x v) e) (erased (Add o t y) b)
    (erased (Elt flag-w us y w) f) -> (erased (Eq (Nat) v w) r))
  (let-match erased (add-fn o t x y a b) (Refl _ _))
  (elt-fn flag-w us x v w e f))

; The count of the trace t, at the leaf entry v, takes the hit a: written to cs2 when v is not 0, dropped otherwise.
(def-adts $ (CnW : ((List (Copy (Nat))) cs) ((List (Copy (Nat))) cs2) ((Nat) t) ((Nat) v) ((Nat) a) -> Type)
  enum
  (many CwSkip : (erased (List (Copy (Nat))) cs) (erased (Nat) t a) -> (CnW cs cs t (Zero) a))
  (many CwPut : (erased (List (Copy (Nat))) cs cs2) (erased (Nat) t v a c c2) (erased (WElt cs t c) w) (erased (Add c a c2) ad)
      (erased (SetNth (Copy (Nat)) cs t (MkCopy (Nat) c2) cs2) s) -> (CnW cs cs2 t (Succ v) a)))

(def-fns _ $ (erased cntr-hit : (erased (List (Copy (Nat))) cs cs2) (erased (List (U8)) us) (erased (Nat) o t a n x v) (erased (List (WEv)) E)
    (subterm erased (CntR cs us o E n) r) (erased (Add o t x) atx) (erased (Elt flag-w us x v) evb) (erased (CnW cs cs2 t v a) cw)
    -> (erased (CntR cs2 us o (Cons (WEv) (WHit t a) E) n) r2))
  (let-match erased r (CrS _ _ _ m c y u _ r1 w ad e ce) ((CrZ _ _ _ _) (CrZ cs2 us o _)))
  (let ((erased r3)) (cntr-hit cs cs2 us o t a m x v E r1 atx evb cw))
  (match erased (nat-eq t m) _
    ((Equal _ _ _)
      (let-match erased (evx-fn us o t x y v u atx evb ad e) (Refl _ _))
      (match erased cw _
        ((CwSkip _ _ _) (let-match erased ce (TrZ _ _)) (CrS cs2 us o m c y v _ r3 w ad e (TrZ _ m)))
        ((CwPut _ _ _ v1 _ c1 c2 w1 ad1 s)
          (let-match erased ce (TrH _ _ _ _ h))
          (let-match erased (welt-fn cs m c c1 w w1) (Refl _ _))
          (CrS cs2 us o m c2 y v _ r3 (MkWElt cs2 m c2 (setnth-nth _ cs m _ cs2 s)) ad e (TrH v1 c2 m _ (HsHit E m a c c2 h ad1))))))
    ((Unequal _ _ _ _ ap)
      (let ((erased w2))
        (match erased cw (((WElt cs2 m c) w3)) ((CwSkip _ _ _) w) ((CwPut _ _ _ _ _ _ _ _ _ s) (welt-set cs cs2 m c t _ w s ap))))
      (let ((erased ce2))
        (match erased ce (((TrC u c (Cons (WEv) (WHit t a) E) m) c3)) ((TrZ _ _) (TrZ _ m)) ((TrH u1 _ _ _ h) (TrH u1 c m _ (HsOth E m t a c h ap)))))
      (CrS cs2 us o m c y u _ r3 w2 ad e ce2))))

(def-fns _ $ (erased cntr-drop : (erased (List (Copy (Nat))) cs) (erased (List (U8)) us) (erased (Nat) o n) (erased (List (WEv)) E) (erased (WEv) evb)
    (erased (List (U8)) ws) (erased (Nat) k j q o2 g) (erased (Offs k o2) of) (erased (Add o2 q g) ad2) (erased (Elt flag-w ws g (Zero)) z)
    (subterm erased (CntR cs us o E n) r) -> (erased (CntR cs us o (Cons (WEv) (WDrop ws k j q o2 g of ad2 z) E) n) r2))
  (let-match erased r (CrS _ _ _ m c y u _ r1 w ad e ce) ((CrZ _ _ _ _) (CrZ cs us o _)))
  (CrS cs us o m c y u _ (cntr-drop cs us o m E evb ws k j q o2 g of ad2 z r1) w ad e
    (match erased ce (((TrC u c (Cons (WEv) (WDrop ws k j q o2 g of ad2 z) E) m) c3)) ((TrZ _ _) (TrZ _ m)) ((TrH u1 _ _ _ h) (TrH u1 c m _ (HsDrop E ws k j q o2 g m c of ad2 z h))))))

(def-fns _ $ (erased cntr-flt : (erased (List (Copy (Nat))) cs) (erased (List (U8)) us ws) (erased (Nat) o n k j) (erased (List (WP)) Q R) (erased (List (WEv)) E0 E1)
    (subterm erased (WFlt ws k j Q R E0 E1) f) (erased (CntR cs us o E0 n) r) -> (erased (CntR cs us o E1 n) r2))
  (match erased f _
    ((WfNil _ _ _ _) r)
    ((WfKeep _ _ _ _ _ _ _ _ Q1 R1 _ _ _ _ _ _ f1) (cntr-flt cs us ws o n k j Q1 R1 E0 E1 f1 r))
    ((WfDrop _ _ _ q o2 g _ Q1 _ _ _ of ad z f1)
      (cntr-flt cs us ws o n k j Q1 R _ E1 f1 (cntr-drop cs us o n E0 (WHit (Zero) (Zero)) ws k j q o2 g of ad z r)))))

(def-fns _ $ (erased cntr-init : (erased (List (Copy (Nat))) cs) (erased (List (U8)) us) (erased (Nat) o) (subterm erased (Nat) n) (erased (Nat) m len) (erased (Repeat (Copy (Nat)) m (MkCopy (Nat) (Zero)) cs) rp)
    (erased (Sz flag-w us len) z) (erased (Nat) e) (erased (Add o n e) ae) (erased (Lt e (Succ len)) el) (erased (Lt n (Succ m)) nm) -> (erased (CntR cs us o (Nil (WEv)) n) r))
  (let-match erased n (Succ n1) ((Zero) (CrZ cs us o _)))
  (let-match erased nm (LtS _ _ nm1))
  (let ((erased x) (erased ax)) (add o n1))
  (let ((erased xl)) (lt-le-trans x e len (add-lt-mono o n1 n x e ax ae (lt-succ n1)) el))
  (let ((erased v) (erased evb)) (elt-exists flag-w us len x z xl))
  (let ((erased r1)) (cntr-init cs us o n1 m len rp z x ax (lt-weaken x len xl) (lt-weaken n1 m nm1)))
  (let ((erased w)) (MkWElt cs n1 (Zero) (repeat-nth _ m n1 _ cs rp nm1)))
  (match erased v _
    ((Zero) (CrS cs us o n1 (Zero) x (Zero) _ r1 w ax evb (TrZ _ n1)))
    ((Succ v1) (CrS cs us o n1 (Zero) x (Succ v1) _ r1 w ax evb (TrH v1 (Zero) n1 _ (HsNil n1))))))

; Every element of cs is at most B.
(def-adts $ (CuLe : ((List (Copy (Nat))) cs) ((Nat) B) -> Type)
  enum
  (many CleNil : (erased (Nat) B) -> (CuLe (Nil (Copy (Nat))) B))
  (many CleCons : (erased (Nat) B c) (erased (List (Copy (Nat))) cs) (erased (Lt c (Succ B)) l) (erased (CuLe cs B) a)
      -> (CuLe (Cons (Copy (Nat)) (MkCopy (Nat) c) cs) B)))

(def-fns _ $ (erased cule-nth : (erased (List (Copy (Nat))) cs) (erased (Nat) B i c) (subterm erased (CuLe cs B) a) (erased (Nth (Copy (Nat)) cs i (MkCopy (Nat) c)) n)
    -> (erased (Lt c (Succ B)) l))
  (let-match erased a (CleCons _ c1 cs1 l a1) (absurd (CleNil _) n))
  (let-match erased n (NthThere _ _ _ ix _ n1) ((NthHere _ _ _) l))
  (cule-nth cs1 B ix c a1 n1))

(def-fns _ $ (erased cule-set : (erased (List (Copy (Nat))) cs cs2) (erased (Nat) B i c) (subterm erased (CuLe cs B) a)
    (erased (SetNth (Copy (Nat)) cs i (MkCopy (Nat) c) cs2) s) (erased (Lt c (Succ B)) l) -> (erased (CuLe cs2 B) r))
  (let-match erased a (CleCons _ c1 cs1 l1 a1) (absurd (CleNil _) s))
  (match erased s _
    ((SetHere _ _ _ _) (CleCons B c cs1 l a1))
    ((SetThere _ _ _ k _ rest2 s1) (CleCons B c1 rest2 l1 (cule-set cs1 rest2 B k c a1 s1 l)))))

(def-fns _ $ (erased cule-mono : (erased (List (Copy (Nat))) cs) (erased (Nat) B Bx) (subterm erased (CuLe cs B) a) (erased (Lt B (Succ Bx)) l) -> (erased (CuLe cs Bx) r))
  (let-match erased a (CleCons _ c cs1 l1 a1) ((CleNil _) (CleNil Bx)))
  (CleCons Bx c cs1 (le-trans c B Bx l1 l) (cule-mono cs1 B Bx a1 l)))

(def-fns _ $ (erased cule-rep : (erased (Nat) n B) (erased (List (Copy (Nat))) cs) (subterm erased (Repeat (Copy (Nat)) n (MkCopy (Nat) (Zero)) cs) p) -> (erased (CuLe cs B) r))
  (let-match erased p (RepeatCons _ n1 _ cs1 p1) ((RepeatNil _ _) (CleNil B)))
  (CleCons B (Zero) cs1 (LtZ B) (cule-rep n1 B cs1 p1)))

; F is three times m plus F2.
(def-adts $ (Trp : ((Nat) m) ((Nat) F2) ((Nat) F) -> Type)
  enum
  (many TrpZ : (erased (Nat) F2) -> (Trp (Zero) F2 F2))
  (many TrpS : (erased (Nat) m F2 F) (erased (Trp m F2 F) t) -> (Trp (Succ m) F2 (Succ (Succ (Succ F))))))

; B plus three times F is at most Cap.
(def-adts $ (Bud : ((Nat) B) ((Nat) F) ((Nat) Cap) -> Type)
  enum
  (many BudZ : (erased (Nat) B Cap) (erased (Lt B (Succ Cap)) l) -> (Bud B (Zero) Cap))
  (many BudS : (erased (Nat) B F Cap) (erased (Bud (Succ (Succ (Succ B))) F Cap) b) -> (Bud B (Succ F) Cap)))

(def-fns _ $ (erased bud-le : (erased (Nat) B F Cap) (subterm erased (Bud B F Cap) b) -> (erased (Lt B (Succ Cap)) l))
  (let-match erased b (BudS _ F1 _ b1) ((BudZ _ _ l) l))
  (lt-succ-left B (Succ Cap) (lt-succ-left (Succ B) (Succ Cap) (lt-succ-left (Succ (Succ B)) (Succ Cap) (bud-le (Succ (Succ (Succ B))) F1 Cap b1)))))

(def-fns _ $ (erased le-three : (erased (Nat) B) -> (erased (Lt B (Succ (Succ (Succ (Succ B))))) l))
  (lt-weaken B (Succ (Succ (Succ B))) (lt-weaken B (Succ (Succ B)) (lt-weaken B (Succ B) (lt-succ B)))))

(def-fns _ $ (erased add-three : (erased (Nat) t) -> (erased (Add t 3 (Succ (Succ (Succ t)))) a))
  (let-match erased r4-e3 (Refl _ _))
  (add-succ-right t (Succ (Succ (Zero))) (Succ (Succ t)) (add-succ-right t (Succ (Zero)) (Succ t) (add-succ-right t (Zero) t (add-zero-right t)))))

; Leaving the 3 m of F unspent.
(def-fns _ $ (erased bud-trp : (erased (List (Copy (Nat))) cs) (erased (Nat) B F Cap m F2) (erased (CuLe cs B) a) (erased (Bud B F Cap) b) (subterm erased (Trp m F2 F) t)
    -> (erased (Nat) Bx) (erased (CuLe cs Bx) a2) (erased (Bud Bx F2 Cap) b2))
  (let-match erased t (TrpS m1 _ F1 t1) ((TrpZ _) (values B a b)))
  (let-match erased b (BudS _ _ _ b1))
  (let-match erased b1 (BudS _ _ _ b2))
  (let-match erased b2 (BudS _ _ _ b3))
  (let ((erased B3) (erased B6)) (values (Succ (Succ (Succ B))) (Succ (Succ (Succ (Succ (Succ (Succ B))))))))
  (bud-trp cs (Succ (Succ (Succ B6))) F1 Cap m1 F2
    (cule-mono cs B (Succ (Succ (Succ B6))) a (le-trans B B3 (Succ (Succ (Succ B6))) (le-three B) (le-trans B3 B6 (Succ (Succ (Succ B6))) (le-three B3) (le-three B6)))) b3 t1))

(def-fns _ $ (erased trp-split : (erased (Nat) n r nr F2 F) (subterm erased (Add n r nr) a) (erased (Trp nr F2 F) t) -> (erased (Nat) F1) (erased (Trp n F1 F) t1) (erased (Trp r F2 F1) t2))
  (let-match erased a (AddSucc n1 _ nr1 a1) ((AddZero _) (values F (TrpZ F) t)))
  (let-match erased t (TrpS _ _ Fa ta))
  (let ((erased F1) (erased t1) (erased t2)) (trp-split n1 r nr1 F2 Fa a1 ta))
  (values F1 (TrpS n1 F1 Fa t1) t2))

(def-fns _ $ (erased trp-exists : (subterm erased (Nat) m) (erased (Nat) F2) -> (erased (Nat) F) (erased (Trp m F2 F) t))
  (let-match erased m (Succ m1) ((Zero) (values F2 (TrpZ F2))))
  (let ((erased F) (erased t)) (trp-exists m1 F2))
  (values (Succ (Succ (Succ F))) (TrpS m1 F2 F t)))

(def-fns _ $ (erased mul-trp : (erased (Nat) m F) (subterm erased (Mul m 3 F) p) -> (erased (Trp m (Zero) F) t))
  (let-match erased r4-e3 (Refl _ _))
  (let-match erased p (MulSucc m1 _ F1 _ p1 a) ((MulZero _) (TrpZ (Zero))))
  (let-match erased (add-fn F1 3 F (Succ (Succ (Succ F1))) a (add-three F1)) (Refl _ _))
  (TrpS m1 (Zero) F1 (mul-trp m1 F1 p1)))

(def-fns _ $ (erased trp-mono : (erased (Nat) a b x y) (subterm erased (Trp a (Zero) x) p) (erased (Trp b (Zero) y) q) (erased (Lt a (Succ b)) l) -> (erased (Lt x (Succ y)) r))
  (let-match erased p (TrpS a1 _ x1 p1) ((TrpZ _) (LtZ y)))
  (let-match erased q (TrpS b1 _ y1 q1) (absurd (TrpZ _) (let-match erased l (LtS _ _ l1)) l1))
  (let-match erased l (LtS _ _ l1))
  (LtS _ _ (LtS _ _ (LtS _ _ (trp-mono a1 b1 x1 y1 p1 q1 l1)))))

(def-fns _ $ (erased trp-shift : (erased (Nat) m B G) (subterm erased (Trp m B G) t) -> (erased (Trp m (Succ (Succ (Succ B))) (Succ (Succ (Succ G)))) r))
  (let-match erased t (TrpS m1 _ G1 t1) ((TrpZ _) (TrpZ (Succ (Succ (Succ B))))))
  (TrpS m1 (Succ (Succ (Succ B))) (Succ (Succ (Succ G1))) (trp-shift m1 B G1 t1)))

(def-fns _ $ (erased bud-of : (subterm erased (Nat) F) (erased (Nat) B G Cap) (erased (Trp F B G) t) (erased (Lt G (Succ Cap)) l) -> (erased (Bud B F Cap) b))
  (let-match erased t (TrpS m1 _ G1 t1) ((TrpZ _) (BudZ B Cap l)))
  (BudS B m1 Cap (bud-of m1 (Succ (Succ (Succ B))) (Succ (Succ (Succ G1))) Cap (trp-shift m1 B G1 t1) l)))

(let ((many r4-kp) (erased r4-pkp) (erased _)) (pow2 17))

; D bounds the pairs that count meets at the leaves of a node j levels above them: 2^17 at a leaf, and four times a child's above.
(def-adts $ (DlR : ((Nat) j) ((Nat) D) -> Type)
  enum
  (many DlZ : -> (DlR (Zero) r4-kp))
  (many DlS : (erased (Nat) j D d2 D4) (erased (DlR j D) p) (erased (Add D D d2) a2) (erased (Add d2 d2 D4) a4) -> (DlR (Succ j) D4)))

(def-fns _ $ (many dl-c : (subterm many (Nat) j) -> (many (Nat) D) (erased (DlR j D) p))
  (let-match many j (Succ j1) ((Zero) (values r4-kp (DlZ))))
  (let ((many D) (erased p)) (notail $ dl-c j1))
  (let ((many d2) (erased a2)) (add D D))
  (let ((many D4) (erased a4)) (add d2 d2))
  (values D4 (DlS j1 D d2 D4 p a2 a4)))

(def-fns _ $ (erased dl-fn : (erased (Nat) j D E) (subterm erased (DlR j D) p) (erased (DlR j E) q) -> (erased (Eq (Nat) D E) e))
  (let-match erased p (DlS j1 D1 x1 _ p1 a1 b1) ((DlZ) (let-match erased q (DlZ)) (Refl _ D)))
  (let-match erased q (DlS _ E1 y1 _ q1 a2 b2))
  (let-match erased (dl-fn j1 D1 E1 p1 q1) (Refl _ _))
  (let-match erased (add-fn D1 D1 x1 y1 a1 a2) (Refl _ _))
  (add-fn x1 x1 D E b1 b2))

(def-fns _ $ (erased dl-mono : (erased (Nat) j k D E) (erased (DlR j D) p) (subterm erased (DlR k E) q) (erased (Lt j (Succ k)) l) -> (erased (Lt D (Succ E)) r))
  (let-match erased (nat-eq j k) (Unequal _ _ _ _ ap) ((Equal _ _ _) (let-match erased (dl-fn j D E p q) (Refl _ _)) (lt-succ D)))
  (let-match erased ap (ApLt _ _ _ _ jk) (absurd (ApGt _ _ _ _ kj) (lt-asym k j kj l)))
  (let-match erased q (DlS k1 E1 x1 _ q1 a1 b1) (absurd (DlZ) jk))
  (le-trans D E1 E (dl-mono j k1 D E1 p q1 jk) (le-trans E1 x1 E (add-le-left E1 E1 x1 a1) (add-le-left x1 x1 E b1))))

(let ((many r4-d15) (erased r4-dl15)) (dl-c 15))
(let ((many r4-f15) (erased r4-mf15)) (mul r4-d15 3))
(let ((many r4-g15) (erased r4-mg15)) (mul r4-f15 3))
(comptime-match many (lt-dec r4-g15 flag-um) (Yes _ _ _ _ r4-g15-u62))
(comptime-match many (r4-eq-pf 16 (Succ 15)) (ESome _ r4-e1615))

; The budget of the walk from the root for h at most 15: D pairs at most, F units of three, within r4-g15.
(def-fns _ $ (erased r4-bud0 : (erased (Nat) h) (erased (Lt (Succ h) 17) hl) -> (erased (Nat) D F) (erased (DlR h D) p) (erased (Trp D (Zero) F) t) (erased (Bud (Zero) F r4-g15) b))
  (let-match erased r4-e17 (Refl _ _))
  (let-match erased r4-e1615 (Refl _ _))
  (let-match erased hl (LtS _ _ hl1))
  (let ((erased D) (erased p)) (dl-c h))
  (let ((erased F) (erased t)) (trp-exists D (Zero)))
  (let ((erased G) (erased tg)) (trp-exists F (Zero)))
  (let ((erased lF)) (trp-mono D r4-d15 F r4-f15 t (mul-trp r4-d15 r4-f15 r4-mf15) (dl-mono h 15 D r4-d15 p r4-dl15 hl1)))
  (values D F p t (bud-of F (Zero) G r4-g15 tg (trp-mono F r4-f15 G r4-g15 tg (mul-trp r4-f15 r4-g15 r4-mg15) lF))))

; F is the budgets D of the symbols numbered s to 3 plus F2.
(def-adts $ (QB : ((Nat) s) ((Nat) D) ((Nat) F2) ((Nat) F) -> Type)
  enum
  (many QbEnd : (erased (Nat) D F2) -> (QB 4 D F2 F2))
  (many QbCons : (erased (Nat) s D F2 F1 F) (erased (Lt s 4) l) (erased (Trp D F1 F) t) (erased (QB (Succ s) D F2 F1) q) -> (QB s D F2 F)))

; f is a1, a2 or a3 for the digit d of 0, 1 or 2.
(def-adts $ (Dg3 : ((Nat) d) ((Nat) a1) ((Nat) a2) ((Nat) a3) ((Nat) f) -> Type)
  enum
  (many Dg30 : (erased (Nat) a1 a2 a3) -> (Dg3 (Zero) a1 a2 a3 a1))
  (many Dg31 : (erased (Nat) a1 a2 a3) -> (Dg3 (Succ (Zero)) a1 a2 a3 a2))
  (many Dg32 : (erased (Nat) a1 a2 a3) -> (Dg3 (Succ (Succ (Zero))) a1 a2 a3 a3)))

; The two bits of x at bit 2 d: a1, a2 or a3, x being a1 + 4 a2 + 16 a3.
(def-fns _ $ (many r4-fld : (many (Nat) x d) (erased (Lt x u62-modulus) xb) (erased (Nat) a1 a2 a3 y f) (erased (Bsp 2 x a1 y) q1) (erased (Bsp 2 y a2 a3) q2)
    (erased (Lt a3 4) l3) (erased (Dg3 d a1 a2 a3 f) dg) -> (many f is r))
