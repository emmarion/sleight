  (def-fns r4-lg2 $ (many fill : (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (many (Nat) i) (subterm erased (Nat) kk) (erased (Add i kk M) ad)
      (erased (Length (Copy (Nat)) xs M) l) (erased (RotTab r n i xs) rt) (erased (AllCu xs) au) ->
      (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) a2 at a) (erased (Length (Copy (Nat)) ys M) l2) (erased (RotTab r n M ys) rt2) (erased (AllCu ys) au2))
    (let ((erased ib)) (lt-le-trans i (Succ M) u62-modulus (add-le-left i kk M ad) (LtS M u62-modulus Mu)))
