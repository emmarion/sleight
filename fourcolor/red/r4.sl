  (let-match erased r4-e3 (Refl _ _))
  (let-match erased r4-e16 (Refl _ _))
  (let ((erased p1)) (PS (Zero) _ _ (P0) (DS _ _ (D0))))
  (let ((erased p2)) (PS _ _ _ p1 (DS _ _ (DS _ _ (D0)))))
  (let ((erased p3)) (PS _ _ _ p2 (DS _ _ (DS _ _ (DS _ _ (DS _ _ (D0)))))))
  (let ((many l3) (many b3) (erased x3) (erased v3) (erased e3) (erased bv3) (erased q3) (erased ll3)) (r4-tbit 3 m _ _ p3 (DS _ _ (DS _ _ (DS _ _ (DS _ _ (DS _ _ (DS _ _ (DS _ _ (DS _ _ (D0))))))))) ml))
  (let ((many l2) (many b2) (erased x2) (erased v2) (erased e2) (erased bv2) (erased q2) (erased ll2)) (r4-tbit 2 l3 _ _ p2 (DS _ _ (DS _ _ (DS _ _ (DS _ _ (D0))))) ll3))
  (let ((many l1) (many b1) (erased x1) (erased v1) (erased e1) (erased bv1) (erased q1) (erased ll1)) (r4-tbit 1 l2 _ _ p1 (DS _ _ (DS _ _ (D0))) ll2))
  (let ((many l0) (many b0) (erased x0) (erased v0) (erased e0) (erased bv0) (erased q0) (erased ll0)) (r4-tbit 0 l1 _ _ (P0) (DS _ _ (D0)) ll1))
  (let-match erased ll0 (LtZ _) (absurd (LtS _ _ l) l))
  (let ((erased a0)) (AcS (Nil _) (Zero) (Zero) l1 v0 x0 (AcZ) bv0 q0))
  (let ((erased a1)) (AcS _ _ l1 l2 v1 x1 a0 bv1 q1))
  (let ((erased a2)) (AcS _ _ l2 l3 v2 x2 a1 bv2 q2))
  (values b0 b1 b2 b3 x0 x1 x2 x3 e0 e1 e2 e3 (AcS _ _ l3 m v3 x3 a2 bv3 q3)))

(def-fns _ $ (many r4-b01 : (many (Bool) b) -> (many (Nat) a) (erased (B01 b a) n))
  (match many b _ ((BTrue) (values (Succ (Zero)) (B01T))) ((BFalse) (values (Zero) (B01F)))))

(def-fns _ $ (erased b01-sum : (erased (Bool) b c) (erased (Nat) x y z) (erased (B01 b x) n1) (erased (B01 c y) n2) (erased (Add x y z) ad)
    -> (erased (Lt z (Succ (Succ (Succ (Zero))))) l))
  (match erased n1 _
    ((B01F) (let-match erased ad (AddZero _)) (match erased n2 _ ((B01F) (LtZ _)) ((B01T) (LtS _ _ (LtZ _)))))
    ((B01T) (let-match erased ad (AddSucc _ _ _ ad1)) (let-match erased ad1 (AddZero _)) (match erased n2 _ ((B01F) (LtS _ _ (LtZ _))) ((B01T) (LtS _ _ (LtS _ _ (LtZ _))))))))

(def-fns _ $ (erased b01-le : (erased (Bool) b) (erased (Nat) x) (erased (B01 b x) n) -> (erased (Lt x (Succ (Succ (Succ (Zero))))) l))
  (b01-sum b (BFalse) x (Zero) x n (B01F) (add-zero-right x)))

; v is 4 hi + lo.
(def-fns _ $ (many r4-bsp2 : (many (Nat) lo hi) (erased (Lt lo 4) l) -> (many (Nat) v) (erased (Nat) t) (erased (Bsp 2 v lo hi) p) (erased (Mul hi 4 t) mm) (erased (Add t lo v) ad))
  (let ((many t) (erased mm)) (mul hi 4))
  (let ((many v) (erased ad)) (add t lo))
  (values v t (bsp-of 2 4 hi t lo v r4-p4 mm ad l) mm ad))

(let ((many r4-v16b) (erased r4-m44)) (mul 4 4))
(comptime-match many (nat-eq r4-v16b 16) (Equal _ _ _))
(let ((many r4-v256b) (erased r4-m644)) (mul 64 4))
