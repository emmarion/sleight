  (values r (FmCons s m mq2 r v t rest pv o f) rb))

(def-adts $ (KFs : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) hi) ((Nat) cm) ((Nat) s) ((List (Gtree)) ts) -> Type)
  enum
