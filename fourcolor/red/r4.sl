      (values g ce kt))
    ((TaN _ j1 _ q t1 t2 t3 _ tq b1 b2 b3 cn)
      (let ((erased ad1)) (add-sh d j1 (Succ h) ad))
      (let ((erased k1) (erased k2) (erased k3)) (values (Ki1 p q tq) (Ki2 p q tq) (Ki3 p q tq)))
      (let ((erased s1) (erased e1)) (esstep-c st (C1)))
      (let ((erased s2) (erased e2)) (esstep-c st (C2)))
      (let ((erased s3) (erased e3)) (esstep-c st (C3)))
      (let ((erased p1) (erased x1) (erased sp1)) (psplit-c (C1) (Nil _) (RxNil _) ps pl))
      (let ((erased p2) (erased x2) (erased sp2)) (psplit-c (C2) (Nil _) (RxNil _) ps pl))
      (let ((erased p3) (erased x3) (erased sp3)) (psplit-c (C3) (Nil _) (RxNil _) ps pl))
      (let ((erased g1) (erased c1) (erased h1))
        (r4-bridge cs es evs vs h o e N gtu E wk wu cr nb of oe ua zv j1 q (Succ d) (Cons _ (C1) pre) (RICons pre p q (C1) ri k1) (LengthCons _ (C1) pre d lp) ad1
          p1 x1 (SPCons _ ps p1 pre (C1) sp sp1) s1 (EaCons pre st s1 (C1) ea e1) t1 b1))
      (let ((erased g2) (erased c2) (erased h2))
