    (let ((erased s2) (erased ts2) (erased sk) (erased hd)) (ks-next cm s i ts ch ks))
    (let-match many ch (Cons _ x rest)
      ((Nil _)
        (let-match erased hd (KhNil _ _ _))
        (let-match erased cl (CtlNil))
        (let-match erased (add-fn bi (Zero) bn bi abn (add-zero-right bi)) (Refl _ _))
        (let-match erased (add-fn nx (Zero) e nx ae (add-zero-right nx)) (Refl _ _))
        (values xs a nx (MkKidsOk xs xs len j b nx cm s ts bi bi nx nx (Refl _ nx) (skip-kfs xs j b nx cm s s2 bn nx nx ts (Nil _) sk (KFsNil xs j b nx cm s2 bn nx))
          (WsNil xs bi bi nx nx) l au gz))))
    (let-match many x (MkKidP s1 t))
    (let-match erased hd (KhP _ _ _ _ ts3 _ bit rk ks3))
    (let-match erased cl (CtlCons _ c1 nr1 r1 _ _ _ g cl1 ar))
    (let ((erased et) (erased aet) (erased ate)) (add-assoc-back nx c1 r1 rr e ae ar))
    (let ((erased nxe)) (add-le-left nx rr e ae))
    (let ((erased etl)) (le-trans et e len (add-le-left et r1 e ate) el))
    (let ((erased bil)) (lt-le-trans bi bn nx (add-pos-lt bi (Succ nr1) bn abn (LtZ nr1)) bnx))
    (let ((erased bilen)) (lt-le-trans bi nx len bil (le-trans nx e len nxe el)))
    (let ((erased sbib)) (lt-trans (Succ bi) (Succ len) u62-modulus (LtS bi len bilen) (ncap-len len nc)))
    (let ((erased bib)) (lt-trans bi (Succ bi) u62-modulus (lt-succ bi) sbib))
    (let ((many id)) (u62-add b i bi abi bib))
    (let ((erased pt) (erased pts)) (skip-subt cm s s1 ts ts3 t sk))
    (let ((erased st) (erased ss3)) (shps-skip (Succ j) cm s s1 ts ts3 t sk ss))
    (let ((erased ys1) (unique a1) (many nx1) (erased fo)) (notail $ r4-fill xs a len l au gz nc j (subterm pt) t st nx id c1 et g aet etl bil))
    (let-match erased fo (MkFillOk _ _ _ _ _ _ _ _ _ q1 fb w1 l1 au1 gz1))
    (let-match erased q1 (Refl _ _))
    (let ((erased ib)) (le-u62 i bi (add-le-right b i bi abi) bib))
    (let ((many bi1)) (u62-inc i (le-u62 (Succ i) (Succ bi) (LtS i (Succ bi) (add-le-right b i bi abi)) sbib)))
    (let ((erased bnet)) (le-trans bn nx et bnx (add-le-left nx c1 et aet)))
    (let ((erased ys) (unique r) (many nx2) (erased ko))
      (tail $ r4-fill-kids ys1 a1 len l1 au1 gz1 nc j (subterm pts) ts3 ss3 b bi1 (Succ bi) bn (add-succ-right b i bi abi) rest (Succ s1) cm ks3 nr1 r1 cl1
        (add-sh bi nr1 bn abn) nx1 bnet e ate el))
    (let-match erased ko (MkKidsOk _ _ _ _ _ _ _ _ _ _ _ _ _ q2 kfs w2 l2 au2 gz2))
    (let ((erased bie)) (lt-le-trans bi nx e bil nxe))
    (let ((erased kf)) (KfP ys j b e cm s1 i bi nx et bn nx et t bit rk abi bie (le-trans b bi nx (add-le-left b i bi abi) (lt-weaken bi nx bil)) (add-le-left et r1 e ate)
      (flb-w ys1 ys j bi nx et (Succ bi) bn et e t fb w2 (MkClear bi nx et (Succ bi) bn et e (lt-succ bi) bnx (lt-le-trans bi nx et bil (add-le-left nx c1 et aet)) (lt-succ et)))
      (add-pos-lt bi (Succ nr1) bn abn (LtZ nr1)) (lt-succ nx) (lt-succ et)))
    (let ((erased wa)) (w-mono xs ys1 bi (Succ bi) nx et bi bn nx e w1 (SivA bi (Succ bi) bi bn nx e (lt-succ bi) (add-pos-lt-s bi nr1 bn abn))
      (SivB nx et bi bn nx e (lt-succ nx) (add-le-left et r1 e ate))))
    (let ((erased wb)) (w-mono ys1 ys (Succ bi) bn et e bi bn nx e w2 (SivA (Succ bi) bn bi bn nx e (lt-weaken bi (Succ bi) (lt-succ bi)) (lt-succ bn))
      (SivB et e bi bn nx e (add-le-left nx c1 et aet) (lt-succ e))))
    (values ys r nx2 (MkKidsOk xs ys len j b e cm s ts bi bn nx nx2 q2 (skip-kfs ys j b e cm s s1 bn nx e ts (Cons _ t ts3) sk (KFsCons ys j b e cm s1 bn nx et e t ts3 kf kfs))
      (w-cat xs ys1 ys bi bn nx e wa wb) l2 au2 gz2))))

(def-adts
  ; Node g of xs lays out s0, a subtree of the initial chromogram tree, j levels above the leaves: a leaf's symbols, or which children are
  ; present and where they are.
  ((NLay : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) g) ((Gtree) s0) -> Type)
    enum
    (many NlL : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b m ftr fu) (erased (Gtree) s0) (erased (WElt xs g w) x) (erased (NWd w b m ftr fu) d)
        (erased (LeafM s0 m) lm) -> (NLay xs (Zero) g s0))
    (many NlN : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) c0 c1 c2 c3) (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d)
        (erased (Lt (Succ (Succ (Succ b))) u62-modulus) bb) (erased (NLayK xs j b cm (Zero) c0) k0) (erased (NLayK xs j b cm (Succ (Zero)) c1) k1)
        (erased (NLayK xs j b cm (Succ (Succ (Zero))) c2) k2) (erased (NLayK xs j b cm (Succ (Succ (Succ (Zero)))) c3) k3) -> (NLay xs (Succ j) g (GNode c0 c1 c2 c3))))
  ; The child of symbol s of a node whose children start at b.
  ((NLayK : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Nat) s) ((Gtree) c) -> Type)
    enum
    (many NlkE : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s) (erased (BitIs cm s (Bit0)) bi) -> (NLayK xs j b cm s (GEmpty)))
    (many NlkP : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s v g) (erased (Gtree) c) (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) r)
        (erased (Add b v g) a) (erased (NLay xs j g c) l) -> (NLayK xs j b cm s c))))

; f is 0 when z is BTrue.
(def-adts $ (Zf : ((Bool) z) ((Nat) f) -> Type)
  enum
  (many ZfA : (erased (Nat) f) -> (Zf (BFalse) f))
  (many ZfZ : -> (Zf (BTrue) (Zero))))

(def-adts
  ; Node g of xs lays out s0 j levels above the leaves, its nodes below in [lo, hi), and g not; the kids are below bn, and the nodes below the kids of
  ; the symbols 0 to 3 in [bn, m1), [m1, m2), [m2, m3) and [m3, hi); when z is BTrue, no node of it has a part of gtr.
  ((NIv : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) g) ((Gtree) s0) ((Nat) lo) ((Nat) hi) ((Bool) z) -> Type)
    enum
    (many NivL : (erased (List (Copy (Nat))) xs) (erased (Nat) g lo w b cm ftr fu) (erased (Gtree) s0) (erased (Bool) z) (erased (WElt xs g w) x)
        (erased (NWd w b cm ftr fu) d) (erased (Zf z ftr) zf) -> (NIv xs (Zero) g s0 lo lo z))
    (many NivN : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu hi bn m1 m2 m3) (erased (Gtree) c0 c1 c2 c3) (erased (Bool) z) (erased (WElt xs g w) x)
        (erased (NWd w b cm ftr fu) d) (erased (Zf z ftr) zf) (erased (Lt g b) gb) (erased (Lt b (Succ bn)) bl) (erased (NIvK xs j b cm (Zero) c0 bn bn m1 z) k0)
        (erased (NIvK xs j b cm (Succ (Zero)) c1 bn m1 m2 z) k1) (erased (NIvK xs j b cm (Succ (Succ (Zero))) c2 bn m2 m3 z) k2)
        (erased (NIvK xs j b cm (Succ (Succ (Succ (Zero)))) c3 bn m3 hi z) k3) -> (NIv xs (Succ j) g (GNode c0 c1 c2 c3) b hi z)))
  ; The kid of symbol s of a node whose children start at b: below bn, its nodes below in [lo, hc).
  ((NIvK : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Nat) s) ((Gtree) c) ((Nat) bn) ((Nat) lo) ((Nat) hc) ((Bool) z) -> Type)
    enum
    (many NivkE : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s bn lo hc) (erased (Bool) z) (erased (BitIs cm s (Bit0)) bi) (erased (Lt lo (Succ hc)) lh)
        -> (NIvK xs j b cm s (GEmpty) bn lo hc z))
    (many NivkP : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s v g lo2 hi2 bn lo hc) (erased (Gtree) c) (erased (Bool) z) (erased (BitIs cm s (Bit1)) bi)
        (erased (Rk s cm v) r) (erased (Add b v g) a) (erased (Lt g bn) gn) (erased (Lt lo (Succ lo2)) ll) (erased (Lt hi2 (Succ hc)) lh) (erased (NIv xs j g c lo2 hi2 z) p)
        -> (NIvK xs j b cm s c bn lo hc z))))

; f is the part of a word that sel picks: its part of gtr when sel is BTrue, of gu otherwise.
(def-adts $ (Fld : ((Bool) sel) ((Nat) ftr) ((Nat) fu) ((Nat) f) -> Type)
  enum
  (many FdU : (erased (Nat) ftr fu) -> (Fld (BFalse) ftr fu fu))
  (many FdT : (erased (Nat) ftr fu) -> (Fld (BTrue) ftr fu ftr)))

(def-adts
  ; The parts sel of node g of xs and of the nodes below it hold t, within s0: 0 at an empty node, 1 at a nonempty internal one, the symbols
  ; at a leaf.
  ((NPart : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) g) ((Gtree) s0) ((Bool) sel) ((Gtree) t) -> Type)
    enum
    (many NpE : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) s0) (erased (Bool) sel) (erased (WElt xs g w) x)
        (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu (Zero)) fd) -> (NPart xs j g s0 sel (GEmpty)))
    (many NpL : (erased (List (Copy (Nat))) xs) (erased (Nat) g w b cm ftr fu f) (erased (Gtree) s0 t) (erased (Bool) sel) (erased (WElt xs g w) x)
        (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu f) fd) (erased (LeafM t f) lm) -> (NPart xs (Zero) g s0 sel t))
    (many NpN : (erased (List (Copy (Nat))) xs) (erased (Nat) j g w b cm ftr fu) (erased (Gtree) c0 c1 c2 c3 t0 t1 t2 t3) (erased (Bool) sel)
        (erased (WElt xs g w) x) (erased (NWd w b cm ftr fu) d) (erased (Fld sel ftr fu (Succ (Zero))) fd) (erased (NPartK xs j b cm (Zero) c0 sel t0) k0)
        (erased (NPartK xs j b cm (Succ (Zero)) c1 sel t1) k1) (erased (NPartK xs j b cm (Succ (Succ (Zero))) c2 sel t2) k2)
        (erased (NPartK xs j b cm (Succ (Succ (Succ (Zero)))) c3 sel t3) k3) -> (NPart xs (Succ j) g (GNode c0 c1 c2 c3) sel (GNode t0 t1 t2 t3))))
  ((NPartK : ((List (Copy (Nat))) xs) ((Nat) j) ((Nat) b) ((Nat) cm) ((Nat) s) ((Gtree) c) ((Bool) sel) ((Gtree) t) -> Type)
    enum
    (many NpkE : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s) (erased (Bool) sel) (erased (BitIs cm s (Bit0)) bi) -> (NPartK xs j b cm s (GEmpty) sel (GEmpty)))
    (many NpkP : (erased (List (Copy (Nat))) xs) (erased (Nat) j b cm s v g) (erased (Gtree) c t) (erased (Bool) sel) (erased (BitIs cm s (Bit1)) bi) (erased (Rk s cm v) r) (erased (Add b v g) a)
        (erased (NPart xs j g c sel t) p) -> (NPartK xs j b cm s c sel t))))

(def-fns _
  ((erased flb-lay : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (subterm erased (FlB xs j g s0 lo hi) f) -> (erased (NLay xs j g s0) r))
    (match erased f _
      ((FbL _ _ m w _ _ x d lm) (NlL xs g w (Zero) m (Zero) m s0 x d lm))
      ((FbN _ j1 _ w b cm _ bn m1 m2 m3 c0 c1 c2 c3 x d _ bb _ k0 k1 k2 k3)
        (NlN xs j1 g w b cm (Zero) (Succ (Zero)) c0 c1 c2 c3 x d bb (kf-lay xs j1 b hi cm (Zero) bn bn m1 c0 k0) (kf-lay xs j1 b hi cm (Succ (Zero)) bn m1 m2 c1 k1)
          (kf-lay xs j1 b hi cm (Succ (Succ (Zero))) bn m2 m3 c2 k2) (kf-lay xs j1 b hi cm (Succ (Succ (Succ (Zero)))) bn m3 hi c3 k3)))))
  ((erased kf-lay : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s bn lo hc) (erased (Gtree) c) (subterm erased (KF xs j b hi cm s c bn lo hc) k) -> (erased (NLayK xs j b cm s c) r))
    (let-match erased k (KfP _ _ _ _ _ _ v g lo2 hi2 _ _ _ _ bi rk a _ _ _ f _ _ _) ((KfE _ _ _ _ _ _ _ _ _ bi _) (NlkE xs j b cm s bi)))
    (NlkP xs j b cm s v g c bi rk a (flb-lay xs j g lo2 hi2 c f))))

(def-fns _
  ((erased flb-iv : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (subterm erased (FlB xs j g s0 lo hi) f) -> (erased (NIv xs j g s0 lo hi (BTrue)) r))
    (match erased f _
      ((FbL _ _ m w _ _ x d lm) (NivL xs g lo w (Zero) m (Zero) m s0 (BTrue) x d (ZfZ)))
      ((FbN _ j1 _ w b cm _ bn m1 m2 m3 c0 c1 c2 c3 x d gb _ bl k0 k1 k2 k3)
        (NivN xs j1 g w b cm (Zero) (Succ (Zero)) hi bn m1 m2 m3 c0 c1 c2 c3 (BTrue) x d (ZfZ) gb bl (kf-iv xs j1 b hi cm (Zero) bn bn m1 c0 k0)
          (kf-iv xs j1 b hi cm (Succ (Zero)) bn m1 m2 c1 k1) (kf-iv xs j1 b hi cm (Succ (Succ (Zero))) bn m2 m3 c2 k2)
          (kf-iv xs j1 b hi cm (Succ (Succ (Succ (Zero)))) bn m3 hi c3 k3)))))
  ((erased kf-iv : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s bn lo hc) (erased (Gtree) c) (subterm erased (KF xs j b hi cm s c bn lo hc) k)
      -> (erased (NIvK xs j b cm s c bn lo hc (BTrue)) r))
    (let-match erased k (KfP _ _ _ _ _ _ v g lo2 hi2 _ _ _ _ bi rk a _ _ _ f gn ll lh) ((KfE _ _ _ _ _ _ _ _ _ bi lh) (NivkE xs j b cm s bn lo hc (BTrue) bi lh)))
    (NivkP xs j b cm s v g lo2 hi2 bn lo hc c (BTrue) bi rk a gn ll lh (flb-iv xs j g lo2 hi2 c f))))

(def-fns _
  ((erased flb-part : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (subterm erased (FlB xs j g s0 lo hi) f)
      -> (erased (NPart xs j g s0 (BFalse) s0) r))
    (match erased f _
      ((FbL _ _ m w _ _ x d lm) (NpL xs g w (Zero) m (Zero) m m s0 s0 (BFalse) x d (FdU (Zero) m) lm))
      ((FbN _ j1 _ w b cm _ bn m1 m2 m3 c0 c1 c2 c3 x d _ _ _ k0 k1 k2 k3)
        (NpN xs j1 g w b cm (Zero) (Succ (Zero)) c0 c1 c2 c3 c0 c1 c2 c3 (BFalse) x d (FdU (Zero) (Succ (Zero)))
          (kf-part xs j1 b hi cm (Zero) bn bn m1 c0 k0) (kf-part xs j1 b hi cm (Succ (Zero)) bn m1 m2 c1 k1)
          (kf-part xs j1 b hi cm (Succ (Succ (Zero))) bn m2 m3 c2 k2) (kf-part xs j1 b hi cm (Succ (Succ (Succ (Zero)))) bn m3 hi c3 k3)))))
  ((erased kf-part : (erased (List (Copy (Nat))) xs) (erased (Nat) j b hi cm s bn lo hc) (erased (Gtree) c) (subterm erased (KF xs j b hi cm s c bn lo hc) k)
      -> (erased (NPartK xs j b cm s c (BFalse) c) r))
    (let-match erased k (KfP _ _ _ _ _ _ v g lo2 hi2 _ _ _ _ bi rk a _ _ _ f _ _ _) ((KfE _ _ _ _ _ _ _ _ _ bi _) (NpkE xs j b cm s (BFalse) bi)))
    (NpkP xs j b cm s v g c c (BFalse) bi rk a (flb-part xs j g lo2 hi2 c f))))

(def-fns _ $ (erased flb-tr : (erased (List (Copy (Nat))) xs) (erased (Nat) j g lo hi) (erased (Gtree) s0) (erased (FlB xs j g s0 lo hi) f)
    -> (erased (NPart xs j g s0 (BTrue) (GEmpty)) r))
  (match erased f _
    ((FbL _ _ m w _ _ x d _) (NpE xs (Zero) g w (Zero) m (Zero) m s0 (BTrue) x d (FdT (Zero) m)))
    ((FbN _ j1 _ w b cm _ _ _ _ _ _ _ _ _ x d _ _ _ _ _ _ _) (NpE xs j g w b cm (Zero) (Succ (Zero)) s0 (BTrue) x d (FdT (Zero) (Succ (Zero)))))))

; The buffer holds T, the last first: its array a, of capacity cap, holds the first n entries.
(def-adts $ (Buf : ((List (Nat)) T) -> Type)
  enum
  (many MkBuf : (erased (List (Nat)) T) (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (many (Nat) n) (erased (Nat) cap)
      (erased (Length (Copy (Nat)) xs cap) l) (erased (Lt (Zero) cap) cp) (erased (AllCu xs) au) (erased (Lt n (Succ cap)) nc) (erased (Tbk xs n T) tb) -> (Buf T)))

(comptime-match many (lt-dec 0 1024) (Yes _ _ _ _ r4-buf-cp))

(def-fns _ $ (many r4-newbuf : -> (unique (Buf (Nil (Nat))) b))
  (let ((erased xs) (unique a) (erased rp)) (array-make (Nat) 1024 0))
  (let-match erased r4-e0 (Refl _ _))
  (MkBuf (Nil _) xs a 0 1024 (repeat-length _ 1024 _ xs rp) r4-buf-cp (allcu-rep 1024 xs rp) (LtZ 1024) (TbkNil xs)))

(def-fns _ $ (erased splice-nth-in : (erased Type A) (erased (List A) xs ys zs) (erased (Nat) n k) (erased A y) (subterm erased (Splice A xs (Zero) n ys zs) p)
    (erased (Nth A ys k y) q) -> (erased (Nth A zs k y) r))
  (let-match erased p (SpliceHere _ _ y0 xs1 n1 ys1 zs1 p1) (absurd (SpliceNil _ _) q))
  (let-match erased q (NthThere _ _ _ k1 _ q1) ((NthHere _ _ _) (NthHere A y zs1)))
  (NthThere A y0 zs1 k1 y (splice-nth-in A xs1 ys1 zs1 n1 k1 y p1 q1)))

(def-fns _ $ (erased tbk-splice : (erased (List (Copy (Nat))) xs ws zs) (erased (Nat) k n) (erased (List (Nat)) T) (subterm erased (Tbk xs k T) t)
    (erased (Splice (Copy (Nat)) ws (Zero) n xs zs) s) -> (erased (Tbk zs k T) r))
  (let-match erased t (TbkCons _ k1 i T1 t1 x) ((TbkNil _) (TbkNil zs)))
  (let-match erased x (MkWElt _ _ _ nth))
  (TbkCons zs k1 i T1 (tbk-splice xs ws zs k1 n T1 t1 s) (MkWElt zs k1 i (splice-nth-in _ ws xs zs n k1 _ s nth))))

(def-fns _ $ (erased allcu-splice : (erased (List (Copy (Nat))) ws ys zs) (erased (Nat) i n) (subterm erased (Splice (Copy (Nat)) ws i n ys zs) s) (erased (AllCu ws) aw)
    (erased (AllCu ys) ay) -> (erased (AllCu zs) r))
  (match erased s _
    ((SpliceNil _ _) aw)
    ((SpliceHere _ _ y ws1 n1 ys1 zs1 s1)
      (let-match erased aw (CuCons _ _ _ aw1))
      (let-match erased ay (CuCons v b _ ay1))
      (CuCons v b zs1 (allcu-splice ws1 ys1 zs1 (Zero) n1 s1 aw1 ay1)))
    ((SpliceThere _ x ws1 k1 _ _ zs1 s1)
      (let-match erased aw (CuCons v b _ aw1))
      (CuCons v b zs1 (allcu-splice ws1 ys zs1 k1 n s1 aw1 ay)))))

(def-fns _ $ (many r4-bgrow : (erased (List (Nat)) T) (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) (many (Nat) n c2) (erased (Add n n c2) ac)
    (erased (Length (Copy (Nat)) xs n) l) (erased (Lt (Zero) n) cp) (erased (AllCu xs) au) (erased (Tbk xs n T) tb) (unique (Cell MkBuf (slot-of a) (slot-of n)) u) ->
    (erased (List (Copy (Nat))) zs) (unique (Array (Copy (Nat)) zs) a3) (unique (Cell MkBuf (slot-of a3) (slot-of n)) u3 at u) (erased (Length (Copy (Nat)) zs c2) l2)
    (erased (Lt (Zero) c2) cp2) (erased (Lt n c2) nl) (erased (AllCu zs) au2) (erased (Tbk zs n T) tb2))
  (let ((erased ws) (unique a2) (erased rp)) (array-make (Nat) c2 0))
  (let-match erased r4-e0 (Refl _ _))
  (let ((erased lw)) (repeat-length _ c2 _ ws rp))
  (let ((erased nn)) (le-trans n n c2 (lt-succ n) (add-le-right n n c2 ac)))
  (let ((erased old) (erased to)) (splice-range _ ws c2 lw (Zero) n n (AddZero n) nn))
  (let ((erased zs) (unique a3) (unique _) (erased sp)) (array-blit _ xs ws xs old a 0 a2 0 n (splice-whole _ xs n l) to))
  (values zs a3 (cell-write unique u (MkBuf (slot-of a3) _)) (splice-length _ ws xs zs (Zero) n c2 sp lw) (lt-le-trans (Zero) n c2 cp nn)
    (add-pos-lt n n c2 ac cp) (allcu-splice ws xs zs (Zero) n sp (allcu-rep c2 ws rp) au) (tbk-splice xs ws zs n n T tb sp)))

(def-fns _ $ (many r4-bput : (erased (List (Nat)) T) (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) a) (many (Nat) n)
