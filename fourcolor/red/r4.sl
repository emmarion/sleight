(def-fns _ $ (erased bsp-add : (erased (Nat) k x hi lo y v) (erased (Bsp k x (Zero) hi) p) (erased (Add x lo y) ad) (erased (Pow2 k v) pv) (erased (Lt lo v) l)
    -> (erased (Bsp k y lo hi) r))
