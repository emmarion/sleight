      (erased (Nth (Copy (Nat)) ns k (MkCopy (Nat) n)) xn) (erased (Lt n (Succ w)) nw) (erased (Pow2 k w) pw) (erased (Offs k o) of) (erased (Offs (Succ k) o2) of2)
      (erased (Add o W o2) aw) (erased (Add k jb 16) ak) (erased (WPs xs ys W jb (Zero) n P) ps) -> (WLv rp rb ns k P)))

