(def-fns _ $ (many r4-child : (many (Nat) w s) (erased (Lt w u62-modulus) wb) (erased (Lt s 4) sl) (erased (Nat) b cm ftr fu) (erased (NWd w b cm ftr fu) d)
    (erased (Lt (Succ (Succ (Succ b))) u62-modulus) bb) -> (many (Nat) c) (erased (Nat) v) (erased (Rk s cm v) rk) (erased (Add b v c) ad))
  (let-match erased d (MkNWd _ _ _ _ _ y1 y2 p1 p2 p3))
  (let ((erased ab) (erased lo8) (erased s8) (erased q8) (erased _)) (bsp-cat 4 4 w fu y1 ftr y2 p1 p2))
  (let-match erased (add-fn 4 4 ab 8 s8 r4-a448) (Refl _ _))
