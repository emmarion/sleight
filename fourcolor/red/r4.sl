  (let ((erased cs1) (unique cn1) (erased lc1) (unique ev1) (erased r1) (erased Bk) (erased al1) (erased bd1))
    (r4-cnt-d cs cn N lc us evb len z h hl o e of ae el x qv 0 xb2 f0 f1 f2 y q1 q2 l3 qn 3 (AddZero 3) E0 E1 (Dz0 q f0 f1 f2 E0) r B F F1 al bd
