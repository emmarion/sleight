  (let-match erased e1 (Refl _ _))
  (let ((erased t2) (erased e2) (erased a2)) (add-succ-right-inv j r1 t1 a1))
  (let-match erased e2 (Refl _ _))
  (lt-le-trans (Succ j) (Succ (Succ t2)) wd (LtS j (Succ t2) (add-le-left j r1 t2 a2)) l))

