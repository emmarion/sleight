      (let ((erased r0) (erased r1) (erased r2) (erased r3) (erased w0) (erased w1) (erased w2) (erased w3) (erased sr))
        (wct-split q q2 cr Pt gs g0 g1 g2 g3 s0 s1 s2 s3 e rest kq R0 R1 R2 R3 u0 u1 u2 u3 pc1))
      (let ((erased c0) (erased k0) (erased y0) (erased d0) (erased v0)) (wch-symc q q2 r0 (GPush) bs R0 Q0 g0 e rest h0 kq w0))
      (let ((erased c1) (erased k1) (erased y1) (erased d1) (erased v1)) (wch-symc q q2 r1 (GSkip) bs R1 Q1 g1 e rest h1 kq w1))
      (let ((erased c2) (erased k2) (erased y2) (erased d2) (erased v2)) (wch-symc q q2 r2 (GPop0) bs R2 Q2 g2 e rest h2 kq w2))
      (let ((erased c3) (erased k3) (erased y3) (erased d3) (erased v3)) (wch-symc q q2 r3 (GPop1) bs R3 Q3 g3 e rest h3 kq w3))
      (let ((erased n4) (erased sc) (erased mn)) (mc-sum gs g0 g1 g2 g3 bs e rest c0 c1 c2 c3 q q2 kq s0 s1 s2 s3 y0 y1 y2 y3))
      (let-match erased (mc-fn gs bs (Cons _ e rest) n4 a mn m) (Refl _ _))
      (values k0 k1 k2 k3 v0 v1 v2 v3 (sum4-add c0 c1 c2 c3 r0 r1 r2 r3 k0 k1 k2 k3 n4 cr c d0 d1 d2 d3 sc sr ad)))
    ((WcMiss p _ _ bs _ _ _ ap pc1)
      (let ((erased r0) (erased r1) (erased r2) (erased r3) (erased w0) (erased w1) (erased w2) (erased w3) (erased sr))
        (wct-split q q2 c Pt gs g0 g1 g2 g3 s0 s1 s2 s3 e rest kq R0 R1 R2 R3 u0 u1 u2 u3 pc1))
      (values r0 r1 r2 r3 (wch-miss p q q2 r0 (GPush) bs R0 Q0 g0 e rest h0 ap kq w0) (wch-miss p q q2 r1 (GSkip) bs R1 Q1 g1 e rest h1 ap kq w1)
        (wch-miss p q q2 r2 (GPop0) bs R2 Q2 g2 e rest h2 ap kq w2) (wch-miss p q q2 r3 (GPop1) bs R3 Q3 g3 e rest h3 ap kq w3) sr))))

(def-fns _ $ (erased wct-zero : (erased (Nat) j q c) (erased (List (WP)) P) (erased (GSet) gs) (erased (List (Col)) rest) (erased (NoMC gs j) z)
    (erased (Length (Col) rest j) le) (subterm erased (WCt P gs q rest c) pc) -> (erased (Eq (Nat) c (Zero)) r))
  (let-match erased pc (WcHit _ a c1 _ bs Pt _ _ m pc1 ad)
    ((WcNil _ _ _) (Refl _ c))
    ((WcMiss _ _ _ _ Pt _ _ _ pc1) (wct-zero j q c Pt gs rest z le pc1)))
  (let-match erased (nomc-mc gs j a bs rest z le m) (Refl _ _))
  (let-match erased (wct-zero j q c1 Pt gs rest z le pc1) (Refl _ _))
  (let-match erased ad (AddZero _))
  (Refl _ c))

; One event of a walk: c chromograms hit the trace i, or the pair at the prefix q, of trie node n of us at depth k, is dropped with j colours to go.
(def-adts $ (WEv : -> Type)
  enum
  (many WHit : (erased (Nat) i c) -> (WEv))
  (many WDrop : (erased (List (U8)) us) (erased (Nat) k j q o n) (erased (Offs k o) of) (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z) -> (WEv)))

; R is Q less the pairs whose trie node of depth k in us is 0; E is E0 after their drops.
(def-adts $ (WFlt : ((List (U8)) us) ((Nat) k) ((Nat) j) ((List (WP)) Q) ((List (WP)) R) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many WfNil : (erased (List (U8)) us) (erased (Nat) k j) (erased (List (WEv)) E0) -> (WFlt us k j (Nil (WP)) (Nil (WP)) E0 E0))
  (many WfKeep : (erased (List (U8)) us) (erased (Nat) k j q o n v) (erased (Bstack) bs) (erased (List (WP)) Q R) (erased (List (WEv)) E0 E) (erased (Offs k o) of)
      (erased (Add o q n) ad) (erased (Elt flag-w us n v) e) (erased (Apart (Nat) Lt v (Zero)) nz) (erased (WFlt us k j Q R E0 E) f)
      -> (WFlt us k j (Cons (WP) (MkWP q bs) Q) (Cons (WP) (MkWP q bs) R) E0 E))
  (many WfDrop : (erased (List (U8)) us) (erased (Nat) k j q o n) (erased (Bstack) bs) (erased (List (WP)) Q R) (erased (List (WEv)) E0 E) (erased (Offs k o) of)
      (erased (Add o q n) ad) (erased (Elt flag-w us n (Zero)) z) (erased (WFlt us k j Q R (Cons (WEv) (WDrop us k j q o n of ad z) E0) E) f)
      -> (WFlt us k j (Cons (WP) (MkWP q bs) Q) R E0 E)))

; E is E0 after the hits of the pairs P at the leaf gs: per pair and colour, its trace and the chromograms of gs matching the colour.
(def-adts $ (WLf : ((GSet) gs) ((List (WP)) P) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
  enum
  (many WlNil : (erased (GSet) gs) (erased (List (WEv)) E0) -> (WLf gs (Nil (WP)) E0 E0))
  (many WlCons : (erased (GSet) gs) (erased (Nat) p t1 t2 t3 a1 a2 a3) (erased (Bstack) bs) (erased (List (WP)) P) (erased (List (WEv)) E0 E)
      (erased (Kid p (C1) t1) k1) (erased (Kid p (C2) t2) k2) (erased (Kid p (C3) t3) k3) (erased (MC gs bs (Cons (Col) (C1) (Nil (Col))) a1) m1)
      (erased (MC gs bs (Cons (Col) (C2) (Nil (Col))) a2) m2) (erased (MC gs bs (Cons (Col) (C3) (Nil (Col))) a3) m3)
      (erased (WLf gs P (Cons (WEv) (WHit t3 a3) (Cons (WEv) (WHit t2 a2) (Cons (WEv) (WHit t1 a1) E0))) E) l) -> (WLf gs (Cons (WP) (MkWP p bs) P) E0 E)))

(def-adts
  ; The walk of the pairs P, at depth k, down gs, for traces of j more colours, makes E from E0.
  ((WWk : ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
    enum
    (many WwNil : (erased (Nat) k j) (erased (GSet) gs) (erased (List (WEv)) E0) -> (WWk k j gs (Nil (WP)) E0 E0))
    (many WwZero : (erased (Nat) k j) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0) (erased (NoMC gs j) z) -> (WWk k j gs P E0 E0))
    (many WwLeaf : (erased (Nat) k) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E) (erased (WLf gs P E0 E) l) -> (WWk k (Succ (Zero)) gs P E0 E))
    (many WwStep : (erased (Nat) k j) (erased (GSet) gs g0 g1 g2 g3) (erased (List (WP)) P Q0 Q1 Q2 Q3) (erased (List (WEv)) E0 E1 E2 E3 E4)
        (erased (WSy k j gs P (GPush) g0 Q0 E0 E1) y0) (erased (WSy k j gs P (GSkip) g1 Q1 E1 E2) y1) (erased (WSy k j gs P (GPop0) g2 Q2 E2 E3) y2)
        (erased (WSy k j gs P (GPop1) g3 Q3 E3 E4) y3) -> (WWk k (Succ (Succ j)) gs P E0 E4)))
  ; The walk's part for the symbol s, whose child g1 the pairs Q reach.
  ((WSy : ((Nat) k) ((Nat) j) ((GSet) gs) ((List (WP)) P) ((Gsym) s) ((GSet) g1) ((List (WP)) Q) ((List (WEv)) E0) ((List (WEv)) E) -> Type)
    enum
    (many WyNone : (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0) (erased (GSel gs s g1) sl)
        (erased (WStp s P Q) st) (erased (NoMC g1 (Succ j)) z) -> (WSy k j gs P s g1 Q E0 E0))
    (many WyGo : (erased (List (U8)) us) (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q R) (erased (Gsym) s) (erased (List (WEv)) E0 E1 E)
        (erased (GSel gs s g1) sl) (erased (WStp s P Q) st) (erased (WFlt us (Succ k) (Succ j) Q R E0 E1) f) (erased (WWk (Succ k) (Succ j) g1 R E1 E) w)
        -> (WSy k j gs P s g1 Q E0 E))))

; Over the events E, the hits on the trace i add up to c, and d says whether a drop covers it.
(def-adts $ (WSm : ((List (WEv)) E) ((Nat) i) ((Nat) c) ((Bool) d) -> Type)
  enum
  (many WmNil : (erased (Nat) i) -> (WSm (Nil (WEv)) i (Zero) (BFalse)))
  (many WmHit : (erased (List (WEv)) E) (erased (Nat) i a c c2) (erased (Bool) d) (erased (WSm E i c d) m) (erased (Add c a c2) ad)
      -> (WSm (Cons (WEv) (WHit i a) E) i c2 d))
  (many WmHitO : (erased (List (WEv)) E) (erased (Nat) i ih a c) (erased (Bool) d) (erased (WSm E i c d) m) (erased (Apart (Nat) Lt ih i) ap)
      -> (WSm (Cons (WEv) (WHit ih a) E) i c d))
  (many WmIn : (erased (List (WEv)) E) (erased (List (U8)) us) (erased (Nat) k j q o n i c) (erased (Bool) d) (erased (Offs k o) of) (erased (Add o q n) ad)
      (erased (Elt flag-w us n (Zero)) z) (erased (List (Col)) rest) (erased (WSm E i c d) m) (erased (TIdx q rest i) ti) (erased (Length (Col) rest j) le)
      -> (WSm (Cons (WEv) (WDrop us k j q o n of ad z) E) i c (BTrue)))
  (many WmOut : (erased (List (WEv)) E) (erased (List (U8)) us) (erased (Nat) k j q o n i c q2) (erased (Bool) d) (erased (Offs k o) of) (erased (Add o q n) ad)
      (erased (Elt flag-w us n (Zero)) z) (erased (List (Col)) rest) (erased (WSm E i c d) m) (erased (TIdx q2 rest i) ti) (erased (Length (Col) rest j) le)
      (erased (Apart (Nat) Lt q q2) ap) -> (WSm (Cons (WEv) (WDrop us k j q o n of ad z) E) i c d)))

; From the hits c0 and cover d0, events owing k leave the hits c and cover d: c0 + k hits when nothing covers, at most that otherwise.
(def-adts $ (WGr : ((Nat) c0) ((Bool) d0) ((Nat) k) ((Nat) c) ((Bool) d) -> Type)
  enum
  (many WgF : (erased (Nat) c0 k c) (erased (Add c0 k c) a) -> (WGr c0 (BFalse) k c (BFalse)))
  (many WgT : (erased (Nat) c0 k c m) (erased (Bool) d0) (erased (Add c0 k m) a) (erased (Lt c (Succ m)) l) (erased (Lt c0 (Succ c)) l0)
      -> (WGr c0 d0 k c (BTrue))))

; A filter that owed k and now owes k2: the same, or it covered the trace and owes at most k.
(def-adts $ (WLs : ((Bool) d0) ((Nat) k) ((Bool) d) ((Nat) k2) -> Type)
  enum
  (many WlsSame : (erased (Bool) d) (erased (Nat) k) -> (WLs d k d k))
  (many WlsCov : (erased (Bool) d0) (erased (Nat) k k2) (erased (Lt k2 (Succ k)) l) -> (WLs d0 k (BTrue) k2)))

(def-fns _ $ (erased wgr-exact : (erased (Nat) c0 k c) (erased (Bool) d) (erased (Add c0 k c) a) -> (erased (WGr c0 d k c d) g))
  (match erased d _
    ((BFalse) (WgF c0 k c a))
    ((BTrue) (WgT c0 k c c (BTrue) a (lt-succ c) (add-le-left c0 k c a)))))

(def-fns _ $ (erased wgr-le : (erased (Nat) c0 k c) (erased (Bool) d0 d) (erased (WGr c0 d0 k c d) g) -> (erased (Nat) m) (erased (Add c0 k m) a) (erased (Lt c (Succ m)) l)
    (erased (Lt c0 (Succ c)) l0))
  (match erased g _
    ((WgF _ _ _ a) (values c a (lt-succ c) (add-le-left c0 k c a)))
    ((WgT _ _ _ m _ a l l0) (values m a l l0))))

(def-fns _ $ (erased wgr-cat : (erased (Nat) c0 k1 c1 k2 c2 k) (erased (Bool) d0 d1 d2) (erased (WGr c0 d0 k1 c1 d1) g1) (erased (WGr c1 d1 k2 c2 d2) g2)
    (erased (Add k1 k2 k) a) -> (erased (WGr c0 d0 k c2 d2) g))
  (let ((erased m1) (erased a1) (erased l1) (erased l01)) (wgr-le c0 k1 c1 d0 d1 g1))
  (let ((erased m2) (erased a2) (erased l2) (erased l02)) (wgr-le c1 k2 c2 d1 d2 g2))
  (let ((erased m3) (erased a3)) (add m1 k2))
  (let ((erased m) (erased b1) (erased b2)) (add-assoc c0 k1 k2 m1 m3 a1 a3))
  (let-match erased (add-fn k1 k2 m k b1 a) (Refl _ _))
  (let ((erased l)) (le-trans c2 m2 m3 l2 (add-le-l c1 m1 k2 m2 m3 a2 a3 l1)))
  (let ((erased gt)) (WgT c0 k c2 m3 d0 b2 l (le-trans c0 c1 c2 l01 l02)))
  (match erased g1 _
    ((WgF _ _ _ x1)
      (let-match erased g2 (WgF _ _ _ x2) ((WgT _ _ _ _ _ _ _ _) gt))
      (let ((erased m4) (erased b3) (erased b4)) (add-assoc c0 k1 k2 c1 c2 x1 x2))
      (let-match erased (add-fn k1 k2 m4 k b3 a) (Refl _ _))
      (WgF c0 k c2 b4))
    ((WgT _ _ _ _ _ _ _ _) (let-match erased g2 (WgT _ _ _ _ _ _ _ _)) gt)))

(def-fns _ $ (erased wls-gr : (erased (Nat) c0 k k2 c) (erased (Bool) d0 d1 d) (erased (WLs d0 k d1 k2) ls) (erased (WGr c0 d1 k2 c d) g) -> (erased (WGr c0 d0 k c d) r))
  (let-match erased ls (WlsCov _ _ _ l) ((WlsSame _ _) g))
  (let-match erased g (WgT _ _ _ m _ a lm l0))
  (let ((erased m2) (erased a2)) (add c0 k))
  (WgT c0 k c m2 d0 a2 (le-trans c m m2 lm (add-le-l k2 k c0 m m2 (add-comm c0 k2 m a) (add-comm c0 k m2 a2) l)) l0))

(def-fns _ $ (erased wls-add : (erased (Nat) a k k2 ka ka2) (erased (Bool) d0 d) (erased (WLs d0 k d k2) ls) (erased (Add a k ka) p) (erased (Add a k2 ka2) q)
    -> (erased (WLs d0 ka d ka2) r))
  (let-match erased ls (WlsSame _ _) ((WlsCov _ _ _ l) (WlsCov d0 ka ka2 (add-le-l k2 k a ka2 ka (add-comm a k2 ka2 q) (add-comm a k ka p) l))))
  (let-match erased (add-fn a k ka ka2 p q) (Refl _ _))
  (WlsSame d0 ka))

(def-fns _ $ (erased wflt-ct : (erased (List (U8)) us) (erased (Nat) k j q2 k1 i c0) (erased (Bool) d0) (erased (GSet) g) (erased (List (Col)) rest)
    (erased (List (WP)) Q R) (erased (List (WEv)) E0 E1) (subterm erased (WFlt us k j Q R E0 E1) f) (erased (WCt Q g q2 rest k1) pc) (erased (TIdx q2 rest i) ti)
    (erased (Length (Col) rest j) le) (erased (WSm E0 i c0 d0) sm) -> (erased (Nat) k2) (erased (Bool) d1) (erased (WCt R g q2 rest k2) pr) (erased (WSm E1 i c0 d1) sm1)
    (erased (WLs d0 k1 d1 k2) ls))
  (match erased f _
    ((WfNil _ _ _ _) (values k1 d0 pc sm (WlsSame d0 k1)))
    ((WfKeep _ _ _ _ _ _ _ _ Q1 R1 _ _ _ _ _ _ f1)
      (match erased pc _
        ((WcHit _ a c _ bs _ _ _ m pc1 ad)
          (let ((erased c2) (erased d1) (erased pr1) (erased sm1) (erased ls1)) (wflt-ct us k j q2 c i c0 d0 g rest Q1 R1 E0 E1 f1 pc1 ti le sm))
          (let ((erased k2) (erased ad2)) (add a c2))
          (values k2 d1 (WcHit q2 a c2 k2 bs R1 g rest m pr1 ad2) sm1 (wls-add a c c2 k1 k2 d0 d1 ls1 ad ad2)))
        ((WcMiss p _ _ bs _ _ _ ap pc1)
          (let ((erased c2) (erased d1) (erased pr1) (erased sm1) (erased ls1)) (wflt-ct us k j q2 k1 i c0 d0 g rest Q1 R1 E0 E1 f1 pc1 ti le sm))
          (values c2 d1 (WcMiss p q2 c2 bs R1 g rest ap pr1) sm1 ls1))))
    ((WfDrop _ _ _ q o n _ Q1 _ _ _ of ad z f1)
      (let-match erased pc (WcHit _ a c _ _ _ _ _ _ pc1 adc)
        ((WcMiss _ _ _ _ _ _ _ ap pc1)
          (wflt-ct us k j q2 k1 i c0 d0 g rest Q1 R (Cons _ (WDrop us k j q o n of ad z) E0) E1 f1 pc1 ti le (WmOut E0 us k j q o n i c0 q2 d0 of ad z rest sm ti le ap))))
      (let ((erased smd)) (WmIn E0 us k j q2 o n i c0 d0 of ad z rest sm ti le))
      (let ((erased c2) (erased d1) (erased pr1) (erased sm1) (erased ls1)) (wflt-ct us k j q2 c i c0 (BTrue) g rest Q1 R _ E1 f1 pc1 ti le smd))
      (let-match erased ls1 (WlsSame _ _) ((WlsCov _ _ _ l) (values c2 (BTrue) pr1 sm1 (WlsCov d0 k1 c2 (le-trans c2 c k1 l (add-le-right a c k1 adc))))))
      (values c2 (BTrue) pr1 sm1 (WlsCov d0 k1 c (add-le-right a c k1 adc))))))

; c2 is c, plus a when the colours x and e are one.
(def-adts $ (CHx : ((Col) x) ((Col) e) ((Nat) a) ((Nat) c) ((Nat) c2) -> Type)
  enum
  (many HxE : (erased (Col) e) (erased (Nat) a c c2) (erased (Add c a c2) ad) -> (CHx e e a c c2))
  (many HxN : (erased (Col) x e) (erased (Nat) a c) (erased (ColNe x e) ne) -> (CHx x e a c c)))

(def-fns _ $ (erased wm-hit : (erased (List (WEv)) E) (erased (Nat) q t i a ax c) (erased (Bool) d) (erased (Col) x e) (erased (GSet) gs) (erased (Bstack) bs)
    (erased (Kid q x t) kx) (erased (Kid q e i) ke) (erased (MC gs bs (Cons (Col) x (Nil (Col))) ax) mx) (erased (MC gs bs (Cons (Col) e (Nil (Col))) a) m)
    (erased (WSm E i c d) sm) -> (erased (Nat) c2) (erased (WSm (Cons (WEv) (WHit t ax) E) i c2 d) sm2) (erased (CHx x e a c c2) hx))
  (let-match erased (kid-dec q t i x e kx ke) (KcSame _ _) ((KcNe _ _ _ _ ne ap) (values c (WmHitO E i t ax c d sm ap) (HxN x e a c ne))))
  (let-match erased (mc-fn gs bs (Cons _ e (Nil _)) ax a mx m) (Refl _ _))
  (let ((erased c2) (erased ad)) (add c a))
  (values c2 (WmHit E i a c c2 d sm ad) (HxE e a c c2 ad)))

(def-fns _ $ (erased chx3 : (erased (Col) e) (erased (Nat) p i a c c1 c2 c3) (erased (Kid p e i) ke) (erased (CHx (C1) e a c c1) h1) (erased (CHx (C2) e a c1 c2) h2)
    (erased (CHx (C3) e a c2 c3) h3) -> (erased (Add c a c3) r))
  (match erased e _
    (absurd (C0) ke)
    ((C1)
      (let-match erased h1 (HxE _ _ _ _ ad) (absurd (HxN _ _ _ _ ne) ne))
      (let-match erased h2 (HxN _ _ _ _ _))
      (let-match erased h3 (HxN _ _ _ _ _))
      ad)
    ((C2)
      (let-match erased h1 (HxN _ _ _ _ _))
      (let-match erased h2 (HxE _ _ _ _ ad) (absurd (HxN _ _ _ _ ne) ne))
      (let-match erased h3 (HxN _ _ _ _ _))
      ad)
    ((C3)
      (let-match erased h1 (HxN _ _ _ _ _))
      (let-match erased h2 (HxN _ _ _ _ _))
      (let-match erased h3 (HxE _ _ _ _ ad) (absurd (HxN _ _ _ _ ne) ne))
      ad)))

(def-fns _ $ (erased wlf-trace : (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E) (erased (Nat) q i c c0) (erased (Bool) d) (erased (Col) e)
    (subterm erased (WLf gs P E0 E) l) (erased (WCt P gs q (Cons (Col) e (Nil (Col))) c) pc) (erased (Kid q e i) ke) (erased (WSm E0 i c0 d) sm)
    -> (erased (Nat) c1) (erased (WSm E i c1 d) sm1) (erased (Add c0 c c1) ad))
  (let-match erased l (WlCons _ p t1 t2 t3 a1 a2 a3 bs P1 _ _ k1 k2 k3 m1 m2 m3 l1)
    ((WlNil _ _) (let-match erased pc (WcNil _ _ _)) (values c0 sm (add-zero-right c0))))
  (match erased pc _
    ((WcHit _ a c' _ _ _ _ _ m pc1 ad)
      (let ((erased x1) (erased s1) (erased h1)) (wm-hit E0 q t1 i a a1 c0 d (C1) e gs bs k1 ke m1 m sm))
      (let ((erased x2) (erased s2) (erased h2)) (wm-hit _ q t2 i a a2 x1 d (C2) e gs bs k2 ke m2 m s1))
      (let ((erased x3) (erased s3) (erased h3)) (wm-hit _ q t3 i a a3 x2 d (C3) e gs bs k3 ke m3 m s2))
      (let ((erased c1) (erased s4) (erased b1)) (wlf-trace gs P1 _ E q i c' x3 d e l1 pc1 ke s3))
      (let ((erased y) (erased b2) (erased b3)) (add-assoc c0 a c' x3 c1 (chx3 e q i a c0 x1 x2 x3 ke h1 h2 h3) b1))
      (let-match erased (add-fn a c' y c b2 ad) (Refl _ _))
      (values c1 s4 b3))
    ((WcMiss _ _ _ _ _ _ _ ap pc1)
      (let ((erased s1)) (WmHitO E0 i t1 a1 c0 d sm (kid-apart p q t1 i (C1) e ap k1 ke)))
      (let ((erased s2)) (WmHitO _ i t2 a2 c0 d s1 (kid-apart p q t2 i (C2) e ap k2 ke)))
      (let ((erased s3)) (WmHitO _ i t3 a3 c0 d s2 (kid-apart p q t3 i (C3) e ap k3 ke)))
      (wlf-trace gs P1 _ E q i c c0 d e l1 pc1 ke s3))))

(def-fns _ $ (erased wsy-parts : (erased (Nat) k j) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0 E)
    (erased (WSy k j gs P s g1 Q E0 E) y) -> (erased (GSel gs s g1) sl) (erased (WStp s P Q) st))
  (match erased y _
    ((WyNone _ _ _ _ _ _ _ _ sl st _) (values sl st))
    ((WyGo _ _ _ _ _ _ _ _ _ _ _ _ sl st _ _) (values sl st))))

(def-fns _ $ (erased wgr-sum : (erased (Nat) c0 k0 k1 k2 k3 c ca cb cz cd) (erased (Bool) d0 da db dc dd) (erased (WGr c0 d0 k0 ca da) g0) (erased (WGr ca da k1 cb db) g1)
    (erased (WGr cb db k2 cz dc) g2) (erased (WGr cz dc k3 cd dd) g3) (erased (Sum4 k0 k1 k2 k3 c) sm) -> (erased (WGr c0 d0 c cd dd) g))
  (let-match erased sm (MkSum4 _ _ _ _ _ x y a1 a2 a3))
  (wgr-cat c0 y cz k3 cd c d0 dc dd (wgr-cat c0 x cb k2 cz y d0 db dc (wgr-cat c0 k0 ca k1 cb x d0 da db g0 g1 a1) g2 a2) g3 a3))

(def-fns _
  ((erased ww-trace : (erased (Nat) k j q c i c0) (erased (Bool) d0) (erased (GSet) gs) (erased (List (WP)) P) (erased (List (WEv)) E0 E) (erased (List (Col)) rest)
      (subterm erased (WWk k j gs P E0 E) w) (erased (TIdx q rest i) ti) (erased (Length (Col) rest j) le) (erased (WCt P gs q rest c) pc) (erased (WSm E0 i c0 d0) sm)
      -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WGr c0 d0 c c1 d1) g))
    (match erased w _
      ((WwNil _ _ _ _) (let-match erased pc (WcNil _ _ _)) (values c0 d0 sm (wgr-exact c0 (Zero) c0 d0 (add-zero-right c0))))
      ((WwZero _ _ _ _ _ z) (let-match erased (wct-zero j q c P gs rest z le pc) (Refl _ _)) (values c0 d0 sm (wgr-exact c0 (Zero) c0 d0 (add-zero-right c0))))
      ((WwLeaf _ _ _ _ _ l)
        (let-match erased le (LengthCons _ e r1 _ le1))
        (let-match erased le1 (LengthNil _))
        (let-match erased ti (TICons _ iq _ _ _ ke ti1))
        (let-match erased ti1 (TINil _))
        (let ((erased c1) (erased sm1) (erased ad)) (wlf-trace gs P E0 E q i c c0 d0 e l pc ke sm))
        (values c1 d0 sm1 (wgr-exact c0 c c1 d0 ad)))
      ((WwStep _ j1 _ g0 g1 g2 g3 _ Q0 Q1 Q2 Q3 _ E1 E2 E3 _ y0 y1 y2 y3)
        (let-match erased le (LengthCons _ e rest1 _ le1))
        (let-match erased ti (TICons _ q2 _ _ _ kq ti1))
        (let ((erased s0) (erased t0)) (wsy-parts k j1 gs g0 P Q0 (GPush) E0 E1 y0))
        (let ((erased s1) (erased t1)) (wsy-parts k j1 gs g1 P Q1 (GSkip) E1 E2 y1))
        (let ((erased s2) (erased t2)) (wsy-parts k j1 gs g2 P Q2 (GPop0) E2 E3 y2))
        (let ((erased s3) (erased t3)) (wsy-parts k j1 gs g3 P Q3 (GPop1) E3 E y3))
        (let ((erased k0) (erased k1) (erased k2) (erased k3) (erased p0) (erased p1) (erased p2) (erased p3) (erased sm4))
          (wct-split q q2 c P gs g0 g1 g2 g3 s0 s1 s2 s3 e rest1 kq Q0 Q1 Q2 Q3 t0 t1 t2 t3 pc))
        (let ((erased ca) (erased da) (erased ma) (erased ga)) (wy-trace k j1 q2 k0 i c0 d0 gs g0 P Q0 (GPush) E0 E1 rest1 y0 ti1 le1 p0 sm))
        (let ((erased cb) (erased db) (erased mb) (erased gb)) (wy-trace k j1 q2 k1 i ca da gs g1 P Q1 (GSkip) E1 E2 rest1 y1 ti1 le1 p1 ma))
        (let ((erased cz) (erased dc) (erased mc) (erased gc)) (wy-trace k j1 q2 k2 i cb db gs g2 P Q2 (GPop0) E2 E3 rest1 y2 ti1 le1 p2 mb))
        (let ((erased cd) (erased dd) (erased md) (erased gd)) (wy-trace k j1 q2 k3 i cz dc gs g3 P Q3 (GPop1) E3 E rest1 y3 ti1 le1 p3 mc))
        (values cd dd md (wgr-sum c0 k0 k1 k2 k3 c ca cb cz cd d0 da db dc dd ga gb gc gd sm4)))))
  ((erased wy-trace : (erased (Nat) k j q2 ks i c0) (erased (Bool) d0) (erased (GSet) gs g1) (erased (List (WP)) P Q) (erased (Gsym) s) (erased (List (WEv)) E0 E)
      (erased (List (Col)) rest) (subterm erased (WSy k j gs P s g1 Q E0 E) y) (erased (TIdx q2 rest i) ti) (erased (Length (Col) rest (Succ j)) le)
      (erased (WCt Q g1 q2 rest ks) pc) (erased (WSm E0 i c0 d0) sm) -> (erased (Nat) c1) (erased (Bool) d1) (erased (WSm E i c1 d1) sm1) (erased (WGr c0 d0 ks c1 d1) g))
    (match erased y _
      ((WyNone _ _ _ _ _ _ _ _ _ _ z)
        (let-match erased (wct-zero (Succ j) q2 ks Q g1 rest z le pc) (Refl _ _))
        (values c0 d0 sm (wgr-exact c0 (Zero) c0 d0 (add-zero-right c0))))
      ((WyGo us _ _ _ _ _ _ R _ _ E1 _ _ _ f w)
        (let ((erased k2) (erased d1) (erased pr) (erased sm1) (erased ls)) (wflt-ct us (Succ k) (Succ j) q2 ks i c0 d0 g1 rest Q R E0 E1 f pc ti le sm))
        (let ((erased c1) (erased d2) (erased sm2) (erased g)) (ww-trace (Succ k) (Succ j) q2 k2 i c0 d1 g1 R E1 E rest w ti le pr sm1))
        (values c1 d2 sm2 (wls-gr c0 ks k2 c1 d0 d1 d2 ls g))))))

(def-fns _ $ (erased wch-exists : (erased (Gsym) s) (erased (WP) x) (erased (List (WP)) Q0) -> (erased (List (WP)) Q) (erased (WCh s x Q0 Q) ch))
  (let-match erased x (MkWP p bs))
  (let ((erased q) (erased t)) (thrice-exists p))
  (match erased s _
    ((GSkip) (values (Cons _ (MkWP q bs) Q0) (WhSkip p q bs (Ki1 p q t) Q0)))
    ((GPush) (values (Cons _ (MkWP (Succ q) (BP0 bs)) (Cons _ (MkWP (Succ (Succ q)) (BP1 bs)) Q0)) (WhPush p (Succ q) (Succ (Succ q)) bs (Ki2 p q t) (Ki3 p q t) Q0)))
    ((GPop0)
      (match erased bs _
        ((BS0) (values Q0 (WhNone p s (IP0) Q0)))
        ((BP0 b) (values (Cons _ (MkWP (Succ q) b) Q0) (WhPop p (Succ q) s (C2) bs b (Popped0 b) (SPop02 b) (Ki2 p q t) Q0)))
        ((BP1 b) (values (Cons _ (MkWP (Succ (Succ q)) b) Q0) (WhPop p (Succ (Succ q)) s (C3) bs b (Popped1 b) (SPop03 b) (Ki3 p q t) Q0)))))
    ((GPop1)
      (match erased bs _
        ((BS0) (values Q0 (WhNone p s (IP1) Q0)))
        ((BP0 b) (values (Cons _ (MkWP (Succ (Succ q)) b) Q0) (WhPop p (Succ (Succ q)) s (C3) bs b (Popped0 b) (SPop13 b) (Ki3 p q t) Q0)))
        ((BP1 b) (values (Cons _ (MkWP (Succ q) b) Q0) (WhPop p (Succ q) s (C2) bs b (Popped1 b) (SPop12 b) (Ki2 p q t) Q0)))))))

(def-fns _ $ (erased wstp-exists : (erased (Gsym) s) (subterm erased (List (WP)) P) -> (erased (List (WP)) Q) (erased (WStp s P Q) st))
  (let-match erased P (Cons _ x P1) ((Nil _) (values (Nil _) (WtNil s))))
  (let ((erased Q0) (erased st1)) (wstp-exists s P1))
  (let ((erased Q) (erased ch)) (wch-exists s x Q0))
  (values Q (WtCons s x P1 Q0 Q st1 ch)))

; xs and ys have the same first m elements.
(def-adts $ (Agr : (Type A) ((Nat) m) ((List A) xs) ((List A) ys) -> Type)
  enum
  (many AgZ : (erased Type A) (erased (List A) xs ys) -> (Agr A (Zero) xs ys))
  (many AgS : (erased Type A) (erased (Nat) m) (erased A x) (erased (List A) xs ys) (erased (Agr A m xs ys) g) -> (Agr A (Succ m) (Cons A x xs) (Cons A x ys))))

(def-fns _ $ (erased agr-nth : (erased Type A) (erased (Nat) m i) (erased A x) (erased (List A) xs ys) (subterm erased (Agr A m xs ys) g) (erased (Nth A xs i x) n)
    (erased (Lt i m) l) -> (erased (Nth A ys i x) r))
  (let-match erased g (AgS _ m1 y xs1 ys1 g1) (absurd (AgZ _ _ _) l))
  (let-match erased n (NthThere _ _ _ iq _ n1) ((NthHere _ _ _) (NthHere _ x ys1)))
  (let-match erased l (LtS _ _ l1))
  (NthThere _ y ys1 iq x (agr-nth _ m1 iq x xs1 ys1 g1 n1 l1)))

(def-fns _ $ (erased agr-set : (erased Type A) (erased (Nat) m i) (erased A y) (erased (List A) xs ys) (subterm erased (SetNth A xs i y ys) s)
    (erased (Lt m (Succ i)) l) -> (erased (Agr A m xs ys) g))
  (let-match erased m (Succ m1) ((Zero) (AgZ _ xs ys)))
  (let-match erased l (LtS _ _ l1))
  (let-match erased s (SetThere _ a rest k _ rest2 s1) (absurd (SetHere _ _ _ _) l1))
  (AgS _ m1 a rest rest2 (agr-set _ m1 k y rest rest2 s1 l1)))

(def-fns _ $ (erased agr-trans : (erased Type A) (erased (Nat) m) (erased (List A) xs ys zs) (subterm erased (Agr A m xs ys) g) (erased (Agr A m ys zs) h)
    -> (erased (Agr A m xs zs) r))
  (let-match erased g (AgS _ m1 x xs1 ys1 g1) ((AgZ _ _ _) (AgZ _ xs zs)))
  (let-match erased h (AgS _ _ _ _ zs1 h1))
  (AgS _ m1 x xs1 zs1 (agr-trans _ m1 xs1 ys1 zs1 g1 h1)))

(def-fns _ $ (erased agr-mono : (erased Type A) (erased (Nat) m m2) (erased (List A) xs ys) (subterm erased (Agr A m xs ys) g) (erased (Lt m2 (Succ m)) l)
    -> (erased (Agr A m2 xs ys) r))
  (let-match erased m2 (Succ m3) ((Zero) (AgZ _ xs ys)))
  (let-match erased l (LtS _ _ l1))
  (let-match erased g (AgS _ m1 x xs1 ys1 g1) (absurd (AgZ _ _ _) l1))
  (AgS _ m3 x xs1 ys1 (agr-mono _ m1 m3 xs1 ys1 g1 l1)))

(def-fns _ $ (erased agr-ext : (erased Type A) (erased (Nat) m) (erased A x) (erased (List A) xs ys) (subterm erased (Agr A m xs ys) g) (erased (Nth A xs m x) p)
    (erased (Nth A ys m x) q) -> (erased (Agr A (Succ m) xs ys) r))
  (match erased g _
    ((AgZ _ _ _) (let-match erased p (NthHere _ _ xs1)) (let-match erased q (NthHere _ _ ys1)) (AgS _ (Zero) x xs1 ys1 (AgZ _ xs1 ys1)))
    ((AgS _ m1 y xs1 ys1 g1)
      (let-match erased p (NthThere _ _ _ _ _ p1))
      (let-match erased q (NthThere _ _ _ _ _ q1))
      (AgS _ m y xs1 ys1 (agr-ext _ m1 x xs1 ys1 g1 p1 q1)))))

(def-fns _ $ (erased agr-refl : (erased Type A) (subterm erased (Nat) m) (erased (List A) xs) (erased (Nat) n) (erased (Length A xs n) le) (erased (Lt m (Succ n)) l)
    -> (erased (Agr A m xs xs) r))
  (let-match erased m (Succ m1) ((Zero) (AgZ _ xs xs)))
  (let-match erased l (LtS _ _ l1))
  (let-match erased le (LengthCons _ x xs1 n1 le1) (absurd (LengthNil _) l1))
  (AgS _ m1 x xs1 xs1 (agr-refl _ m1 xs1 n1 le1 l1)))

; Entries i to n of the prefix row xs and the stack row ys hold the pairs P in order, their prefixes below W and stacks below 2^62 through jb more pushes.
(def-adts $ (WPs : ((List (Copy (Nat))) xs) ((List (Copy (Nat))) ys) ((Nat) W) ((Nat) jb) ((Nat) i) ((Nat) n) ((List (WP)) P) -> Type)
  enum
  (many WpsNil : (erased (List (Copy (Nat))) xs ys) (erased (Nat) W jb n) -> (WPs xs ys W jb n n (Nil (WP))))
  (many WpsCons : (erased (List (Copy (Nat))) xs ys) (erased (Nat) W jb i n p b) (erased (Bstack) bs) (erased (List (WP)) P) (erased (WElt xs i p) xp)
      (erased (WElt ys i b) xb) (erased (Bn bs b) bn) (erased (BnB jb b) bk) (erased (Lt p W) pl) (erased (WPs xs ys W jb (Succ i) n P) r)
      -> (WPs xs ys W jb i n (Cons (WP) (MkWP p bs) P))))

(def-fns _ $ (erased wps-le : (erased (List (Copy (Nat))) xs ys) (erased (Nat) W jb i n) (erased (List (WP)) P) (subterm erased (WPs xs ys W jb i n P) w)
    -> (erased (Lt i (Succ n)) l))
  (let-match erased w (WpsCons _ _ _ _ _ _ _ _ _ P1 _ _ _ _ _ w1) ((WpsNil _ _ _ _ _) (lt-succ n)))
  (lt-weaken i n (lt-le-trans i (Succ i) n (lt-succ i) (wps-le xs ys W jb (Succ i) n P1 w1))))

(def-fns _ $ (erased wps-agr : (erased (List (Copy (Nat))) xs ys xs2 ys2) (erased (Nat) W jb i n) (erased (List (WP)) P) (subterm erased (WPs xs ys W jb i n P) w)
    (erased (Agr (Copy (Nat)) n xs xs2) gx) (erased (Agr (Copy (Nat)) n ys ys2) gy) -> (erased (WPs xs2 ys2 W jb i n P) r))
  (let-match erased w (WpsCons _ _ _ _ _ _ p b bs P1 xp xb bn bk pl w1) ((WpsNil _ _ _ _ _) (WpsNil xs2 ys2 W jb n)))
  (let-match erased xp (MkWElt _ _ _ np))
  (let-match erased xb (MkWElt _ _ _ nb))
  (let ((erased il)) (lt-le-trans i (Succ i) n (lt-succ i) (wps-le xs ys W jb (Succ i) n P1 w1)))
  (WpsCons xs2 ys2 W jb i n p b bs P1 (MkWElt xs2 i p (agr-nth _ n i _ xs xs2 gx np il)) (MkWElt ys2 i b (agr-nth _ n i _ ys ys2 gy nb il)) bn bk pl
    (wps-agr xs ys xs2 ys2 W jb (Succ i) n P1 w1 gx gy)))

(def-fns _ $ (erased wps-len : (erased (List (Copy (Nat))) xs ys) (erased (Nat) W jb i n) (erased (List (WP)) P) (subterm erased (WPs xs ys W jb i n P) w)
    -> (erased (Nat) c) (erased (Length (WP) P c) le) (erased (Add i c n) ad))
  (let-match erased w (WpsCons _ _ _ _ _ _ p _ bs P1 _ _ _ _ _ w1) ((WpsNil _ _ _ _ _) (values (Zero) (LengthNil _) (add-zero-right n))))
  (let ((erased c) (erased le) (erased ad)) (wps-len xs ys W jb (Succ i) n P1 w1))
  (let-match erased ad (AddSucc _ _ n1 ad1))
  (values (Succ c) (LengthCons _ (MkWP p bs) P1 c le) (add-succ-right i c n1 ad1)))

(def-fns _ $ (erased wps-push : (erased (List (Copy (Nat))) xd yd xd1 yd1 xf yf) (erased (Nat) W jb j n q b) (erased (Bstack) bs) (erased (List (WP)) R)
    (erased (SetNth (Copy (Nat)) xd j (MkCopy (Nat) q) xd1) sx) (erased (SetNth (Copy (Nat)) yd j (MkCopy (Nat) b) yd1) sy)
    (erased (Agr (Copy (Nat)) (Succ j) xd1 xf) gx) (erased (Agr (Copy (Nat)) (Succ j) yd1 yf) gy) (erased (WPs xf yf W jb (Succ j) n R) w)
    (erased (Bn bs b) bn) (erased (BnB jb b) bk) (erased (Lt q W) ql) ->
    (erased (WPs xf yf W jb j n (Cons (WP) (MkWP q bs) R)) r) (erased (Agr (Copy (Nat)) j xd xf) hx) (erased (Agr (Copy (Nat)) j yd yf) hy))
  (values (WpsCons xf yf W jb j n q b bs R (MkWElt xf j q (agr-nth _ (Succ j) j _ xd1 xf gx (setnth-nth _ xd j _ xd1 sx) (lt-succ j)))
      (MkWElt yf j b (agr-nth _ (Succ j) j _ yd1 yf gy (setnth-nth _ yd j _ yd1 sy) (lt-succ j))) bn bk ql w)
    (agr-trans _ j xd xd1 xf (agr-set _ j j _ xd xd1 sx (lt-succ j)) (agr-mono _ (Succ j) j xd1 xf gx (lt-weaken j (Succ j) (lt-succ j))))
    (agr-trans _ j yd yd1 yf (agr-set _ j j _ yd yd1 sy (lt-succ j)) (agr-mono _ (Succ j) j yd1 yf gy (lt-weaken j (Succ j) (lt-succ j))))))


; A row of the pair arrays.
(def-adts $ (WRow : -> Type)
  enum newtype
  (many MkWRow : (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) a) -> (WRow)))

(comptime-match many (lt-dec flag-u8m flag-um) (Yes _ _ _ _ r4-u8-u62))

(def-fns _ $ (erased thrice-mul : (erased (Nat) p q) (subterm erased (Thrice p q) t) -> (erased (Mul p (Succ (Succ (Succ (Zero)))) q) m))
  (let-match erased t (TS p1 q1 t1) ((TZ) (MulZero _)))
  (MulSucc p1 _ q1 _ (thrice-mul p1 q1 t1) (add-succ-right q1 _ _ (add-succ-right q1 _ _ (add-succ-right q1 _ _ (add-zero-right q1))))))

(def-fns _ $ (many r4-x3 : (many (Nat) p) (erased (Nat) q) (erased (Thrice p q) t) (erased (Lt p u62-modulus) pb) (erased (Lt q u62-modulus) qb) -> (many q is r))
  (let-match erased r4-e3 (Refl _ _))
  (u62-mul 3 p r4-three-u62 pb q (mul-comm p 3 q (thrice-mul p q t)) qb))

(def-fns _ $ (many r4-flag : (erased (List (U8)) us) (unique (Bytes us) a) (erased (Nat) len) (erased (Sz flag-w us len) z) (many (Nat) i) (erased (Lt i len) il)
    -> (unique a is a2 at a) (many (Nat) v) (erased (Elt flag-w us i v) x) (erased (Lt v u62-modulus) vb))
  (let ((erased v0) (erased x)) (elt-exists flag-w us len i z il))
  (let ((unique a2) (many v)) (r4-gb us a i v0 x))
  (let ((erased vb8) (erased _)) (flag-nth us i v0 x))
  (values a2 v x (lt-trans v u8-modulus u62-modulus vb8 r4-u8-u62)))

; Extending pairs of depth k, their prefixes below W, into the trie level at heap o of us: its prefixes are below W2, 3W, its nodes below o3, within len.
(def-adts $ (XG : ((List (U8)) us) ((Nat) k) ((Nat) o) ((Nat) W) ((Nat) W2) ((Nat) len) -> Type)
  enum
  (many MkXG : (erased (List (U8)) us) (erased (Nat) k o W W2 len o3) (erased (Sz flag-w us len) z) (erased (Offs (Succ k) o) of) (erased (Thrice W W2) tw)
      (erased (Add o W2 o3) ad) (erased (Lt o3 (Succ len)) ol) -> (XG us k o W W2 len)))

; The destination rows: xd and yd, of wd entries below 2^62.
(def-adts $ (XD : ((List (Copy (Nat))) xd) ((List (Copy (Nat))) yd) ((Nat) wd) -> Type)
  enum
  (many MkXD : (erased (List (Copy (Nat))) xd yd) (erased (Nat) wd) (erased (Length (Copy (Nat)) xd wd) lx) (erased (Length (Copy (Nat)) yd wd) ly)
      (erased (AllCu xd) ux) (erased (AllCu yd) uy) (erased (Lt wd u62-modulus) wb) -> (XD xd yd wd)))

(def-fns _ $ (many r4-put2 : (erased (List (Copy (Nat))) xd yd) (unique (Array (Copy (Nat)) xd) dp) (unique (Array (Copy (Nat)) yd) db) (erased (Nat) wd)
    (erased (XD xd yd wd) xdd) (many (Nat) j q b) (erased (Lt j wd) jl) (erased (Lt q u62-modulus) qb) (erased (Lt b u62-modulus) bb) ->
    (erased (List (Copy (Nat))) xd1 yd1) (unique (Array (Copy (Nat)) xd1) dp1 at dp) (unique (Array (Copy (Nat)) yd1) db1 at db)
    (erased (SetNth (Copy (Nat)) xd j (MkCopy (Nat) q) xd1) sx) (erased (SetNth (Copy (Nat)) yd j (MkCopy (Nat) b) yd1) sy) (erased (XD xd1 yd1 wd) xdd1))
  (let-match erased xdd (MkXD _ _ _ lx ly ux uy wb))
  (let ((erased mx) (erased nx)) (nth-exists _ xd wd j lx jl))
  (let ((erased xd1) (unique dp1) (erased sx)) (array-place-imm _ _ dp j (MkCopy _ q) mx nx (allcu-nth xd j mx ux nx) (imm-cu q qb)))
  (let ((erased my) (erased ny)) (nth-exists _ yd wd j ly jl))
  (let ((erased yd1) (unique db1) (erased sy)) (array-place-imm _ _ db j (MkCopy _ b) my ny (allcu-nth yd j my uy ny) (imm-cu b bb)))
  (values xd1 yd1 dp1 db1 sx sy (MkXD xd1 yd1 wd (setnth-length _ xd j wd _ xd1 sx lx) (setnth-length _ yd j wd _ yd1 sy ly) (allcu-set xd xd1 j q qb ux sx)
    (allcu-set yd yd1 j b bb uy sy) wb)))

(def-fns _ $ (many r4-xnode : (erased (List (U8)) us) (erased (Nat) k W W2 len) (many (Nat) o q) (erased (XG us k o W W2 len) xg) (erased (Lt q W2) ql)
