; The pair arrays: rows of 2^k entries in rp and rb, and 17 counts in ns, all below 2^62.
(def-adts $ (WSt : ((List (MaybeUninit (WRow))) rp) ((List (MaybeUninit (WRow))) rb) ((List (Copy (Nat))) ns) -> Type)
  enum
