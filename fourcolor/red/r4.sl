    (tail $ r4-cnt-lf cs1 cn1 N lc1 us ev1 len z h hl o e of ae el w wb b cm ftr fu wd s0 lm rp rb lp1 lb1 k xs ys ra rb0 xp xb W jb tw
      (u62-inc i (lt-le-trans (Succ i) (Succ n) u62-modulus (LtS i n il) (LtS n u62-modulus nb))) n nb m1 (add-sh i m1 n ad) P1 ps1 E1 r1 Bk F1 F2 al1 bd1 tp1))
  (values cs2 cn2 lc2 ev2 lp2 lb2 E (WlCons (GSG s0) p q (Succ q) (Succ (Succ q)) f0 f1 f2 bs P1 E0 E (Ki1 p q tq) (Ki2 p q tq) (Ki3 p q tq) m1c m2c m3c lf) r2 Bo al2 bd2))

(def-fns _ $ (erased rk-fn : (erased (Nat) s x r r2) (subterm erased (Rk s x r) p) (erased (Rk s x r2) q) -> (erased (Eq (Nat) r r2) e))
  (let-match erased p (RkS s1 _ x1 r1 v _ b c p1 bv a) ((RkZ _) (let-match erased q (RkZ _)) (Refl _ r)))
  (let-match erased q (RkS _ _ x2 r3 v2 _ b2 c2 q1 bv2 a2))
