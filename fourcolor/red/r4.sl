  (let-match erased sk (KskE _ _ _ ts1 _ _ sk1) ((KskZ _ _ _) (values (prove-subterm t ts) (prove-subterm ts3 ts))))
  (let ((erased p1) (erased q1)) (skip-subt cm (Succ s) s2 ts1 ts3 t sk1))
  (values (subterm-trans p1 (prove-subterm ts1 ts)) (subterm-trans q1 (prove-subterm ts1 ts))))

; Each tree of ts has the shape of n symbols.
(def-adts $ (GShps : ((Nat) n) ((List (Gtree)) ts) -> Type)
  enum
  (many GssNil : (erased (Nat) n) -> (GShps n (Nil (Gtree))))
  (many GssCons : (erased (Nat) n) (erased (Gtree) t) (erased (List (Gtree)) ts) (erased (GShp n t) p) (erased (GShps n ts) q) -> (GShps n (Cons (Gtree) t ts))))

(def-fns _ $ (erased shps-skip : (erased (Nat) n cm s s2) (erased (List (Gtree)) ts ts3) (erased (Gtree) t) (subterm erased (KSkip cm s ts s2 (Cons (Gtree) t ts3)) sk)
    (erased (GShps n ts) ss) -> (erased (GShp n t) p) (erased (GShps n ts3) q))
  (let-match erased sk (KskE _ _ _ ts1 _ _ sk1) ((KskZ _ _ _) (let-match erased ss (GssCons _ _ _ p1 q1)) (values p1 q1)))
  (let-match erased ss (GssCons _ _ _ _ q1))
  (shps-skip n cm (Succ s) s2 ts1 ts3 t sk1 q1))

