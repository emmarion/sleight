  e3)

; Bit s of m is x, the low bit of z, when y holds m in its low n bits and z is y shifted down by s, below n.
(def-fns _ $ (erased bsp-bitis : (erased (Nat) s n y lo z m b) (subterm erased (Bsp s y lo z) p) (erased (Bsp n y m b) q) (erased (Lt s n) l)
    -> (erased (Bit) x) (erased (Nat) z1) (erased (BitIs m s x) bi) (erased (BitCons z1 x z) c))
  (let-match erased q (BspS n1 _ y1 _ m1 _ x q1 cy cm) (absurd (BspZ _) l))
  (let-match erased p (BspS s1 _ y2 _ lo1 _ x2 p1 cy2 cl)
    ((BspZ _) (values x y1 (MkBitIs m (Zero) (Zero) m m1 x (BspZ m) cm) cy)))
  (let ((erased e1) (erased e2)) (bitcons-fn y1 x y2 x2 y cy cy2))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased l (LtS _ _ l1))
  (let ((erased x3) (erased z1) (erased bi) (erased c)) (bsp-bitis s1 n1 y1 lo1 z m1 b p1 q1 l1))
  (let-match erased bi (MkBitIs _ _ lo3 w w1 _ r1 cw))
  (let ((erased lo4) (erased cl4)) (bc-new lo3 x))
  (values x3 z1 (MkBitIs m (Succ s1) lo4 w w1 x3 (BspS s1 m m1 lo4 lo3 w x r1 cm cl4) cw) c))

(comptime-match many (lt-dec 12 flag-um) (Yes _ _ _ _ r4-12-u62))

; red4's (w lsr (8 + s)) land 1: bit s of the children present.
(def-fns _ $ (many r4-kbit : (many (Nat) w s) (erased (Lt w u62-modulus) wb) (erased (Lt s 4) sl) (erased (Nat) b cm ftr fu) (erased (NWd w b cm ftr fu) d)
    -> (many (Nat) v) (erased (Bit) x) (erased (BitIs cm s x) bi) (erased (BitV x v) bv))
