; red4's module-level hits, gone and celems buffers, pair rows lp, lb, ln and fcache, created once as the locals r4-hits, r4-gone,
; r4-celems, r4-lp, r4-lb, r4-ln and r4-fcache; the functions that use them are nested here and take them at these locals.
(def-fns _ $ (many r4-run : (many (R4Job) r4-job) -> (many (R4Res r4-job) r))
  (let ((erased r4-rp) (unique r4-lp) (erased r4-rb) (unique r4-lb) (erased r4-ns) (unique r4-ln) (erased r4-st)) (r4-pairs))
  (let ((unique r4-hits)) (r4-newbuf))
  (let ((unique r4-gone)) (r4-newbuf))
  (let ((unique r4-celems)) (r4-newbuf))
  (let ((unique r4-fcache)) (MkR4St (Nil _)))
  (def-fns r4-start-lv $ (many r4-start : (erased (List (MaybeUninit (WRow))) rp rb) (erased (List (Copy (Nat))) ns) (unique (Array (MaybeUninit (WRow)) rp) lp at r4-lp)
      (unique (Array (MaybeUninit (WRow)) rb) lb at r4-lb) (unique (Array (Copy (Nat)) ns) ln at r4-ln) (erased (WSt rp rb ns) st) (erased (List (U8)) us) (unique (Bytes us) a)
      (erased (Nat) len) (erased (Sz flag-w us len) z) (erased (Lt (Zero) len) lp0) ->
      (erased (List (MaybeUninit (WRow))) rp2 rb2) (erased (List (Copy (Nat))) ns2) (unique (Array (MaybeUninit (WRow)) rp2) lp2 at lp)
      (unique (Array (MaybeUninit (WRow)) rb2) lb2 at lb) (unique (Array (Copy (Nat)) ns2) ln2 at ln) (unique a is a2 at a) (erased (Nat) v) (erased (Elt flag-w us (Zero) v) x)
      (erased (WSt rp2 rb2 ns2) st2) (erased (WLv rp2 rb2 ns2 (Zero) (Cons (WP) (MkWP (Zero) (BS0)) (Nil (WP)))) lv) (many (EqDec (Nat) Lt v (Zero)) r))
    (let-match erased r4-e0 (Refl _ _))
    (let-match erased r4-one (Refl _ _))
    (let-match erased st (MkWSt _ _ _ wp wb ln0 un0))
    (let-match erased r4-e17 (Refl _ _))
    (let ((erased rp2) (unique lp2) (erased xs) (erased ra) (erased sp) (erased ep) (erased wp2)) (r4-rset rp lp wp 0 0 0 (LtZ 16) 1 (P0) (LtZ (Zero)) u62-modulus-pos))
    (let ((erased rb2) (unique lb2) (erased ys) (erased rb0) (erased sb) (erased eb) (erased wb2)) (r4-rset rb lb wb 0 0 1 (LtZ 16) 1 (P0) (LtZ (Zero)) r4-1-u62))
    (let ((erased m0) (erased n0)) (nth-exists _ ns 17 (Zero) ln0 (LtZ 16)))
    (let ((erased ns2) (unique ln2) (erased sn)) (array-place-imm _ _ ln 0 (MkCopy _ 1) m0 n0 (allcu-nth ns (Zero) m0 un0 n0) (imm-cu 1 r4-1-u62)))
    (let ((unique a2) (many v) (erased x) (erased vb)) (r4-flag us a len z 0 lp0))
    (let ((many r)) (u62-eq v (Zero) vb u62-modulus-pos))
    (values rp2 rb2 ns2 lp2 lb2 ln2 a2 v x (MkWSt rp2 rb2 ns2 wp2 wb2 (setnth-length _ ns (Zero) 17 _ ns2 sn ln0) (allcu-set ns ns2 (Zero) 1 r4-1-u62 un0 sn))
      (MkWLv rp2 rb2 ns2 (Zero) _ xs ys ra rb0 1 1 (Zero) 1 1 16 (setnth-nth _ rp (Zero) _ rp2 sp) (setnth-nth _ rb (Zero) _ rb2 sb) (setnth-nth _ ns (Zero) _ ns2 sn)
        (lt-succ 1) (P0) (OfZ) (OfS (Zero) (Zero) (Zero) (OfZ) (TZ)) (AddZero 1) (AddZero 16)
        (WpsCons xs ys 1 16 (Zero) 1 (Zero) 1 (BS0) (Nil _) ep eb (BnE) r4-bnb16 (LtZ (Zero)) (WpsNil xs ys 1 16 1)))
      r))

  (def-fns r4-extend-lv $ (many r4-extend : (erased (List (MaybeUninit (WRow))) rp rb) (erased (List (Copy (Nat))) ns) (unique (Array (MaybeUninit (WRow)) rp) lp at r4-lp)
      (unique (Array (MaybeUninit (WRow)) rb) lb at r4-lb) (unique (Array (Copy (Nat)) ns) ln at r4-ln) (erased (List (U8)) us) (unique (Bytes us) a) (many (Nat) k s) (erased (Gsym) g)
