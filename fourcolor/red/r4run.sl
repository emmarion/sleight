; What r4-run is asked to check, and its answer.
(def-adts $ (R4Job : -> Type)
  enum
  (many RjRed : (many (List (Config)) cfs) -> (R4Job))
  (many RjBirk : (many (Nat) h m n) (many (List (List (Step))) cps) -> (R4Job)))

(def-adts $ (R4Res : ((R4Job) j) -> Type)
  enum
  (many RrRed : (erased (List (Config)) cfs) (many (ErasedMaybe (AllRed CRX cfs)) r) -> (R4Res (RjRed cfs)))
  (many RrBirk : (erased (Nat) h m n) (erased (List (List (Step))) cps) (many (ErasedMaybe (BirkhoffCheck h m)) r) -> (R4Res (RjBirk h m n cps))))

