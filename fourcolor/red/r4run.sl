            (let-match erased lv (MkWLv _ _ _ _ _ xs1 ys1 ra rb0 n wd o1 o2 W jb xp xb xn nw1 pw of1 of2 aw ak ps))
            (let-match erased st (MkWSt _ _ _ wp wbr lns uns))
            (let ((many nv) (unique ln1)) (array-get _ _ ln k n xn))
            (let-match erased (offs-fn (Succ k) o2 o of2 of) (Refl _ _))
            (let ((erased W3) (erased tw)) (thrice-exists W))
            (let-match erased (add-cancel o N W3 e ae (offs-step k o1 o e W W3 of2 oe of1 aw tw)) (Refl _ _))
