    (values us2 ca2 zs2 T2 cel2 c2 f2 ss mi am dt))

  ; red4's ktc d with the closures of kempe_flat it uses, rot, s_round, g_round and finished, nested here over its arrays and engine.
  (def-fns r4k-loop-lv $ (many r4k-loop : (many (Nat) d-k) (erased (Lt d-k u62-modulus) db-k) (many (Nat) h-k) (erased (Lt (Succ h-k) 17) hl-k) (many (Eng h-k) e-k)
