      (erased (Lt o3 (Succ len)) ol) (erased (Lt (Succ k) 17) kl) (erased (WSt rp rb ns) st) (erased (WLv rp rb ns k P) lv) ->
      (unique a is a2 at a) (many (Nat) n2) (erased (List (MaybeUninit (WRow))) rp2 rb2) (erased (List (Copy (Nat))) ns2)
      (unique (Array (MaybeUninit (WRow)) rp2) lp2 at lp) (unique (Array (MaybeUninit (WRow)) rb2) lb2 at lb) (unique (Array (Copy (Nat)) ns2) ln2 at ln)
      (erased (List (WP)) Q R) (erased (List (WEv)) E) (erased (WStp g P Q) stp) (erased (WFlt us (Succ k) J Q R E0 E) f) (erased (WSt rp2 rb2 ns2) st2)
      (erased (WLv rp2 rb2 ns2 (Succ k) R) lv2) (erased (Agr (MaybeUninit (WRow)) (Succ k) rp rp2) fp) (erased (Agr (MaybeUninit (WRow)) (Succ k) rb rb2) fb)
