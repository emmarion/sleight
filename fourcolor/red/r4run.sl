  ; red4's g_round loop clearing gtr: the gtr part of each node of the hits buffer cleared, the buffer emptied.
  (def-fns r4-gclr-lv $ (many r4-gclr : (erased (List (Copy (Nat))) xs) (unique (Array (Copy (Nat)) xs) nd) (erased (Nat) len) (erased (Length (Copy (Nat)) xs len) lx)
      (erased (Lt len u62-modulus) lnb) (erased (AllCu xs) au) (erased (List (Nat)) Hs) (unique (Buf Hs) hb at r4-hits) (erased (Under Hs len) al) (erased (Distinct Hs) dt)
      (erased (HAll xs (Zero) Hs) hl) ->
      (erased (List (Copy (Nat))) ys) (unique (Array (Copy (Nat)) ys) nd2 at nd) (erased (Length (Copy (Nat)) ys len) lx2) (erased (AllCu ys) au2) (erased (NKeep KeepU xs ys) nk)
      (unique (Buf (Nil (Nat))) hb2 at hb) (erased (HOk ys len (Nil (Nat))) hk2))
    (let-match erased r4-e0 (Refl _ _))
    (let-match unique hb (MkBuf _ hx ha n cap lh cp hau nc tb u))
    (let ((erased k) (erased lk) (erased kl)) (r4c-pigeon len Hs dt al))
    (let-match erased (length-fn _ Hs n k (r4c-tbk-len hx n Hs tb) lk) (Refl _ _))
    (let ((erased R0) (erased fw0)) (r4c-fwd-ex hx (Zero) n cap n (AddZero n) lh hau nc))
    (let ((erased ys) (unique nd2) (erased lx2) (erased au2) (erased nk) (unique ha2) (erased hl2))
      (r4-gclr-go xs nd len lx au hx ha cap lh Hs 0 n tb al (lt-le-trans n (Succ len) u62-modulus kl (LtS len u62-modulus lnb)) nc n (AddZero n) R0 fw0
        (r4g-hall-mono xs (Zero) Hs R0 hl (r4g-hsub-tf hx n n Hs R0 tb fw0 (lt-succ n)))))
    (let ((unique hb2)) (r4-bclr Hs (at unique (u Hs hx ha2 n cap lh cp hau nc tb))))
    (values ys nd2 lx2 au2 nk hb2 (MkHOk ys len (Nil _) (UnderNil len) (DistNil) (HnNil ys) hl2)))

  ; red4's ctree_iter f k p y, f being red4's assert (k = h + 1); cadd ca h p.
  (def-fns r4k-iter-lv $ (many r4k-iter : (erased (List (U8)) us) (unique (Bytes us) ca) (erased (Nat) len) (erased (Sz flag-w us len) zs) (erased (List (Nat)) T) (unique (Buf T) cel at r4-celems)
      (many (Nat) h) (erased (Lt (Succ h) 17) hl) (erased (Nat) N) (erased (Pw3 (Succ h) (Succ (Zero)) N) pw) (erased (Ctree) ctr c) (erased (Ca us h (Zero) c) f)
      (many (Nat) k p) (subterm many (Ctree) y) (erased (Nat) j) (erased (CtH j y) hy) (erased (Add k j (Succ h)) ad) (erased (List (Col)) pre) (erased (RIdx pre p) ri)
      (erased (Length (Col) pre k) le) (erased (CtAt ctr pre y) a) ->
      (erased (List (U8)) us2) (unique (Bytes us2) ca2 at ca) (erased (Sz flag-w us2 len) zs2) (erased (List (Nat)) T2) (unique (Buf T2) cel2 at cel) (erased (Ctree) c2)
      (erased (Ca us2 h (Zero) c2) f2) (erased (LW h ctr y pre p c T c2 T2) w))
    (let-match erased r4-e2 (Refl _ _))
    (let ((erased hb)) (lt-trans (Succ h) 17 u62-modulus hl r4-17-u62))
    (let ((erased kb)) (lt-le-trans k (Succ (Succ h)) u62-modulus (add-le-left k j (Succ h) ad) (LtS _ _ hb)))
    (let ((erased Nb)) (lt-le-trans N (Succ r4-m16) u62-modulus (pw3-bound (Succ h) N pw hl) (LtS r4-m16 u62-modulus r4-m16-u62)))
    (match many y _
      ((CEmpty) (values us ca zs T cel c f (LwE h ctr pre p c T)))
      ((CLeaf lf)
        (let-match erased hy (HL _ _))
        (let-match many (u62-eq k (u62-inc h hb) kb hb) (Equal _ _ _)
          (absurd (Unequal _ _ _ _ ap) (let-match erased (add-fn k (Zero) (Succ h) k ad (add-zero-right k)) (Refl _ _)) (apart-irrefl k ap)))
        (let ((erased us2) (unique ca2) (erased zs2) (erased T2) (unique cel2) (erased c2) (erased f2) (erased d))
          (r4-cadd us ca len zs T cel h p hl N pw (r4c-ridx-lt p (Succ h) N pre ri le pw) c f pre ri le))
        (values us2 ca2 zs2 T2 cel2 c2 f2 (LwL h ctr lf pre p c c2 T T2 ri le a d)))
      ((CNode y1 y2 y3)
        (let-match erased hy (HN j1 _ _ _ h1 h2 h3))
        (let ((erased ad1)) (add-shift k j1 (Succ h) ad))
        (let ((erased k1b)) (lt-le-trans (Succ k) (Succ (Succ h)) u62-modulus (add-le-left (Succ k) j1 (Succ h) ad1) (LtS _ _ hb)))
        (let ((erased q) (erased tq)) (thrice-exists p))
        (let ((erased p1) (erased p2) (erased p3)) (values (Cons _ (C1) pre) (Cons _ (C2) pre) (Cons _ (C3) pre)))
        (let ((erased ri1) (erased ri2) (erased ri3))
          (values (RICons pre p q (C1) ri (Ki1 p q tq)) (RICons pre p (Succ q) (C2) ri (Ki2 p q tq)) (RICons pre p (Succ (Succ q)) (C3) ri (Ki3 p q tq))))
        (let ((erased le1) (erased le2) (erased le3)) (values (LengthCons _ (C1) pre k le) (LengthCons _ (C2) pre k le) (LengthCons _ (C3) pre k le)))
        (let ((erased pb)) (lt-trans p N u62-modulus (r4k-ix-lt h N p k j pre ri le ad pw) Nb))
        (let ((erased b3)) (lt-trans (Succ (Succ q)) N u62-modulus (r4k-ix-lt h N (Succ (Succ q)) (Succ k) j1 p3 ri3 le3 ad1 pw) Nb))
        (let ((erased qb)) (lt-trans q (Succ (Succ q)) u62-modulus (lt-weaken q (Succ q) (lt-succ q)) b3))
        (let ((erased b2)) (lt-trans (Succ q) (Succ (Succ q)) u62-modulus (lt-succ (Succ q)) b3))
        (let ((erased usa) (unique caa) (erased zsa) (erased Ta) (unique cela) (erased ca1) (erased fa) (erased w1))
          (notail $ r4k-iter us ca len zs T cel h hl N pw ctr c f (u62-inc k k1b) (r4-x3 p q tq pb qb) y1 j1 h1 ad1 p1 ri1 le1 (AtCons ctr y y1 pre (C1) a (SelN1 y1 y2 y3))))
        (let ((erased usb) (unique cab) (erased zsb) (erased Tb) (unique celb) (erased cb1) (erased fb) (erased w2))
          (notail $ r4k-iter usa caa len zsa Ta cela h hl N pw ctr ca1 fa (u62-inc k k1b) (u62-inc (r4-x3 p q tq pb qb) b2) y2 j1 h2 ad1 p2 ri2 le2
            (AtCons ctr y y2 pre (C2) a (SelN2 y1 y2 y3))))
        (let ((erased us3) (unique ca3) (erased zs3) (erased T3) (unique cel3) (erased c3) (erased f3) (erased w3))
          (tail $ r4k-iter usb cab len zsb Tb celb h hl N pw ctr cb1 fb (u62-inc k k1b)
            (u62-add (r4-x3 p q tq pb qb) 2 (Succ (Succ q)) (add-succ-right q _ _ (add-succ-right q _ _ (add-zero-right q))) b3) y3 j1 h3 ad1 p3 ri3 le3
            (AtCons ctr y y3 pre (C3) a (SelN3 y1 y2 y3))))
        (values us3 ca3 zs3 T3 cel3 c3 f3 (LwN h ctr y1 y2 y3 pre p q tq c ca1 cb1 c3 T Ta Tb T3 w1 w2 w3)))))

