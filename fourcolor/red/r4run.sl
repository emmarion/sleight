    (let ((unique m1) (erased l1) (erased pk1) (erased rp1) (unique lp1) (erased s1)) (array-pluck _ _ lp k _ xp))
    (let-match erased pk1 (PluckInit _ sl1 x1 q1))
    (let-match unique m1 (Init _ r1))
    (let-match unique r1 (MkWRow _ sp))
    (let ((many k1)) (u62-inc k (lt-trans (Succ k) 17 u62-modulus kl r4-17-u62)))
    (let ((unique m2) (erased l2) (erased pk2) (erased rp2) (unique lp2) (erased s2)) (array-pluck _ _ lp1 k1 _ (setnth-nth-gt _ rp k (Succ k) _ _ rp1 s1 nd (lt-succ k))))
    (let-match erased pk2 (PluckInit _ sl2 x2 q2))
    (let-match unique m2 (Init _ r2))
    (let-match unique r2 (MkWRow _ dp))
    (let ((unique m3) (erased l3) (erased pk3) (erased rb1) (unique lb1) (erased s3)) (array-pluck _ _ lb k _ xb))
    (let-match erased pk3 (PluckInit _ sl3 x3 q3))
    (let-match unique m3 (Init _ r3))
    (let-match unique r3 (MkWRow _ sb))
    (let ((unique m4) (erased l4) (erased pk4) (erased rb2) (unique lb2) (erased s4)) (array-pluck _ _ lb1 k1 _ (setnth-nth-gt _ rb k (Succ k) _ _ rb1 s3 nd2 (lt-succ k))))
    (let-match erased pk4 (PluckInit _ sl4 x4 q4))
    (let-match unique m4 (Init _ r4))
    (let-match unique r4 (MkWRow _ db))
    (let ((erased c) (erased nc)) (nth-exists _ r4-offs-l 17 (Succ k) r4-offs-n kl))
    (let-match many (array-get-many _ _ r4-offs k1 c nc) (MkCopy _ o2v))
