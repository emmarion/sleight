    (let ((erased xg)) (MkXG us k o2 W W2 len o3 z of2 tw (offs-step k o o2 o3 W W2 of2 of3 of aw tw) ol))
    (let ((unique sp2) (unique sb2) (erased xf) (erased yf) (unique dp2) (unique db2) (unique a2) (many n2) (erased Q) (erased R) (erased E) (erased stp) (erased f)
