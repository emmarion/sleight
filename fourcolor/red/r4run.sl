    (let-match erased (pow2-fn (Succ k) wd wd2 pwd pwd2) (Refl _ _))
    (let-match erased pwd (PS _ w1 _ pw1 dw))
    (let-match erased (pow2-fn k w1 w pw1 pw) (Refl _ _))
    (let ((erased wdb)) (pow2-u62 (Succ k) wd pwd (lt-weaken (Succ k) 17 kl)))
