      (agr-set _ (Succ k) (Succ k) _ ns ns2 sn2 (lt-succ (Succ k))) (setnth-nth _ ns (Succ k) _ ns2 sn2)))

  ; red4's make_eng; None where red4 would fail an assertion or an index check.
  (def-fns r4-make-eng-lv $ (many r4-make-eng : (many (Nat) h-m) (erased (List (MaybeUninit (WRow))) rp-m rb-m) (erased (List (Copy (Nat))) ns-m) (unique (Array (MaybeUninit (WRow)) rp-m) lp-m at r4-lp)
      (unique (Array (MaybeUninit (WRow)) rb-m) lb-m at r4-lb) (unique (Array (Copy (Nat)) ns-m) ln-m at r4-ln) (erased (WSt rp-m rb-m ns-m) st-m) ->
      (erased (List (MaybeUninit (WRow))) rp2 rb2) (erased (List (Copy (Nat))) ns2) (unique (Array (MaybeUninit (WRow)) rp2) lp2 at lp-m)
      (unique (Array (MaybeUninit (WRow)) rb2) lb2 at lb-m) (unique (Array (Copy (Nat)) ns2) ln2 at ln-m) (erased (WSt rp2 rb2 ns2) st2) (many (Maybe (Eng h-m)) r-m))
