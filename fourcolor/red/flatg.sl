  (TcN (Zero) g0 g1 g2 g3 (GSG x) (GTL x b0 b1 b2 b3 g0 g1 g2 g3 l q0 q1 q2 q3)))

(def-fns _ $ (many hm-top : (erased (Nat) j) (erased (GSet) a0 a1 a2 a3 b0 b1 b2 b3) (erased (Gtree) a b) (many (TopC j a0 a1 a2 a3 (GSG a)) ca)
    (many (TopC j b0 b1 b2 b3 (GSG b)) cb) -> (many (HM a b) c))
  (match many ca _
    ((TcE _ _ _ _ _) (match many cb _ ((TcE _ _ _ _ _) (HMNone)) ((TcN _ _ _ _ _ _ _) (HMMiss b))))
    ((TcN _ _ _ _ _ _ _) (match many cb _ ((TcE _ _ _ _ _) (HMHit a)) ((TcN _ _ _ _ _ _ _) (HMBoth a b))))))

