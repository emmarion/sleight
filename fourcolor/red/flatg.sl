(def-fns _ $ (many top-l : (erased (Gtree) x) (erased (Bool) b0 b1 b2 b3) (erased (GSet) g0 g1 g2 g3) (erased (LeafSet x (MkBits b0 b1 b2 b3)) l)
    (erased (BSet b0 g0) q0) (erased (BSet b1 g1) q1) (erased (BSet b2 g2) q2) (erased (BSet b3 g3) q3) (many (Any4 b0 b1 b2 b3) y) ->
    (many (TopC (Zero) g0 g1 g2 g3 (GSG x)) c))
