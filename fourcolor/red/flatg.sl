    ((H1No _ _ _) (tail $ fmatch s ms m1 fit j rr rest tl (SufNext RC x rest rr sf)))))

(def-fns _ $ (many fbit : (many (Bool) b) (many (Gsym) s) (erased (List Cnt) ms) (unique (Array Cnt ms) m) (erased (Fit ms) fit) (many (Nat) j)
