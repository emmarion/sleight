    (unique m is m2 at m) (many (Gtree) hit miss) (erased (GPart (GSG t) (GSG hit) (GSG miss)) p) (erased (GHit (GSG hit) r) h))
  (let ((many l0) (many l1) (many l2) (many l3) (erased gb)) (gbits-c t))
  (let-match erased gb (GBLeaf _ _ ll) (absurd (GBNode _ _ _ _) lt))
