  (let ((unique m2) (many a1) (many c1) (erased p1) (erased h1)) (fbit l1 (GSkip) ms m1 fit j r rl))
  (let ((unique m3) (many a2) (many c2) (erased p2) (erased h2)) (fbit l2 (GPop0) ms m2 fit j r rl))
  (let ((unique m4) (many a3) (many c3) (erased p3) (erased h3)) (fbit l3 (GPop1) ms m3 fit j r rl))
  (let ((many hit) (many th)) (bits-leaf a0 a1 a2 a3))
  (let ((many miss) (many tm)) (bits-leaf c0 c1 c2 c3))
