(def-fns _ $ (many bits-leaf : (many (Bool) b0 b1 b2 b3) -> (many (Gtree) g) (many (Try (LeafSet g (MkBits b0 b1 b2 b3))) l))
  (match many b0 _
    ((BTrue)
      (let-match many b2 (BFalse) ((BTrue) (values (GEmpty) (TryNo _))))
      (let-match many b3 (BFalse) ((BTrue) (values (GEmpty) (TryNo _))))
      (match many b1 _ ((BTrue) (values (GL01) (TryOk _ (LS01)))) ((BFalse) (values (GL0) (TryOk _ (LS0))))))
    ((BFalse)
      (match many b1 _
        ((BTrue)
          (match many b2 _
            ((BTrue) (let-match many b3 (BFalse) ((BTrue) (values (GEmpty) (TryNo _)))) (values (GL12) (TryOk _ (LS12))))
            ((BFalse) (match many b3 _ ((BTrue) (values (GL13) (TryOk _ (LS13)))) ((BFalse) (values (GL1) (TryOk _ (LS1))))))))
        ((BFalse)
          (match many b2 _
            ((BTrue) (match many b3 _ ((BTrue) (values (GL23) (TryOk _ (LS23)))) ((BFalse) (values (GL2) (TryOk _ (LS2))))))
            ((BFalse) (match many b3 _ ((BTrue) (values (GL3) (TryOk _ (LS3)))) ((BFalse) (values (GEmpty) (TryOk _ (LSE))))))))))))

(def-fns _ $ (many fleaf-restrict : (many (Gtree) t) (erased (Bits) qb) (erased (LeafSet t qb) lt) (erased (List Cnt) ms) (unique (Array Cnt ms) m)
