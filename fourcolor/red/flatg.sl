(def-fns _ $ (many fsplit-top : (many (Bool) w0 w1 w2 w3) (erased (List Cnt) ms) (unique (Array Cnt ms) m) (erased (Fit ms) fit) (many (Nat) j)
    (erased (List RC) r) (many (FxL ms j r) rl) ->
