    (erased (List (U8)) ms) (unique (Bytes ms) m) (erased (Length (U8) ms len) l) (erased (TrieFit len j n) hf) ->
    (erased (List (U8)) ms2) (unique (Bytes ms2) m2 at m) (erased (SetsBelow ms ms2 n) w) (erased (Length (U8) ms2 len) l2) (many (ErasedMaybe (Flags ms2 j n t)) f))
