          ((SameN _ _) (values (cell z0 z1 z2 z3) (UGN z0 z1 z2 z3 b0 b1 b2 b3 v0 v1 v2 v3)))
          ((SameY _)
            (let-match many (gk-in b1 _ _ e1) (SameY _) ((SameN _ _) (values (cell z0 z1 z2 z3) (UGN z0 z1 z2 z3 b0 b1 b2 b3 v0 v1 v2 v3))))
            (let-match many (gk-in b2 _ _ e2) (SameY _) ((SameN _ _) (values (cell z0 z1 z2 z3) (UGN z0 z1 z2 z3 b0 b1 b2 b3 v0 v1 v2 v3))))
            (let-match many (gk-in b3 _ _ e3) (SameY _) ((SameN _ _) (values (cell z0 z1 z2 z3) (UGN z0 z1 z2 z3 b0 b1 b2 b3 v0 v1 v2 v3))))
            (values (at unique (cell z0 z1 z2 z3)) (UGN z0 z1 z2 z3 b0 b1 b2 b3 v0 v1 v2 v3)))))
      (let-match many (gtree-empty4 a0 a1 a2 a3) (E4No _ _ _ _)
        ((E4Yes) (values m5 (GEmpty) nu g mg (part-hit-e (GSG t) _ pt) (GHE r) (GKALive g (slot-of nu)))))
      (let ((erased hs)) (node-ghit a0 a1 a2 a3 r r0 r1 r2 r3 k0 k1 k2 k3 h0 h1 h2 h3))
      (let-match many (gkeep4 b0 b1 b2 b3 (gk-drop b0 _ _ e0) (gk-drop b1 _ _ e1) (gk-drop b2 _ _ e2) (gk-drop b3 _ _ e3)) (E4No _ _ _ _)
        ((E4Yes) (let ((unique ue)) (UGEmpty))
          (values m5 (GNode a0 a1 a2 a3) ue (GEmpty) (UGE) (part-sym (GSG t) _ _ (part-hit-e (GSG t) _ (part-sym (GSG t) _ _ pt))) hs
            (GKAGone (slot-of ue) (slot-of u)))))
      (values m5 (GNode a0 a1 a2 a3) nu g mg pt hs (GKALive g (slot-of nu))))))

(def-fns _ $ (many ctr-gsplit : (unique (UGtree) u) (erased (Gtree) t) (erased (UG u t) ut) (many (Nat) h) (erased (List Cnt) ms) (unique (Array Cnt ms) m)
    (erased (Fit ms) fit) (erased (Ctree) ctr) (erased (Flags ms (Succ h) (Zero) ctr) f) ->
    (unique m is m2 at m) (many (Gtree) hit) (unique (UGtree) mu) (erased (Gtree) miss) (erased (UG mu miss) um)
    (erased (GPart (GSG t) (GSG hit) (GSG miss)) p) (erased (GHit (GSG hit) (Cons RC (MkRx (Ctree) (BS0) ctr) (Nil RC))) hs)
    (many (GKeepAt miss (slot-of mu) (slot-of u)) e))
