(def-fns _ $ (many fgtree-restrict-u : (subterm unique (UGtree) u) (erased (Gtree) t) (erased (UG u t) ut) (erased (List Cnt) ms) (unique (Array Cnt ms) m)
    (erased (Fit ms) fit) (many (Nat) j) (erased (List RC) r) (many (FxL ms j r) rl) ->
    (unique m is m2 at m) (many (Gtree) hit) (unique (UGtree) mu) (erased (Gtree) miss) (erased (UG mu miss) um)
    (erased (GPart (GSG t) (GSG hit) (GSG miss)) p) (erased (GHit (GSG hit) r) h) (many (GKeepAt miss (slot-of mu) (slot-of u)) e))
  (match unique u _
    ((UGEmpty cell) (let-match erased ut (UGE)) (let ((unique mu)) (at unique (cell)))
      (values m (GEmpty) mu (GEmpty) (UGE) (part-r t) (GHE r) (GKAEmpty (slot-of mu))))
    ((UGLeaf g cell)
      (let-match erased ut (UGL _))
      (let ((unique m2) (many a) (many b) (erased p) (erased h)) (fgtree-restrict-c g ms m fit j r rl))
      (let ((unique mu)) (cell b))
      (values m2 a mu b (UGL b) p h (gk-at b (slot-of mu))))
    ((UGNode x0 x1 x2 x3 cell)
      (let-match erased ut (UGN _ _ _ _ t0 t1 t2 t3 q0 q1 q2 q3))
      (let-match many rl (FxCons _ _ _ _ _ _ _ _ _)
        ((FxNil _ _) (let ((unique mu)) (at unique (cell x0 x1 x2 x3))) (values m (GEmpty) mu t ut (part-r t) (GHE r) (GKALive t (slot-of mu)))))
      (let ((unique y0) (many w0)) (ug-live x0))
      (let ((unique y1) (many w1)) (ug-live x1))
      (let ((unique y2) (many w2)) (ug-live x2))
      (let ((unique y3) (many w3)) (ug-live x3))
      (let ((unique m1) (many j1) (erased r0) (erased r1) (erased r2) (erased r3) (many l0) (many l1) (many l2) (many l3) (erased k0) (erased k1)
          (erased k2) (erased k3))
        (fsplit-top w0 w1 w2 w3 ms m fit j r rl))
      (let ((unique m2) (many a0) (unique z0) (erased b0) (erased v0) (erased p0) (erased h0) (many e0)) (notail $ fgtree-restrict-u y0 t0 q0 ms m1 fit j1 r0 l0))
      (let ((unique m3) (many a1) (unique z1) (erased b1) (erased v1) (erased p1) (erased h1) (many e1)) (notail $ fgtree-restrict-u y1 t1 q1 ms m2 fit j1 r1 l1))
      (let ((unique m4) (many a2) (unique z2) (erased b2) (erased v2) (erased p2) (erased h2) (many e2)) (notail $ fgtree-restrict-u y2 t2 q2 ms m3 fit j1 r2 l2))
      (let ((unique m5) (many a3) (unique z3) (erased b3) (erased v3) (erased p3) (erased h3) (many e3)) (notail $ fgtree-restrict-u y3 t3 q3 ms m4 fit j1 r3 l3))
      (let ((erased pt)) (node-part t0 t1 t2 t3 a0 a1 a2 a3 b0 b1 b2 b3 p0 p1 p2 p3))
      (let ((erased g)) (GNode b0 b1 b2 b3))
      (let ((unique nu) (erased mg))
