  (let ((unique m2) (many a0) (many b0) (erased p0) (erased h0)) (notail $ fgtree-restrict-c t0 ms m1 fit j1 r0 l0))
  (let ((unique m3) (many a1) (many b1) (erased p1) (erased h1)) (notail $ fgtree-restrict-c t1 ms m2 fit j1 r1 l1))
  (let ((unique m4) (many a2) (many b2) (erased p2) (erased h2)) (notail $ fgtree-restrict-c t2 ms m3 fit j1 r2 l2))
  (let ((unique m5) (many a3) (many b3) (erased p3) (erased h3)) (notail $ fgtree-restrict-c t3 ms m4 fit j1 r3 l3))
  (let-match many (gtree-empty4 a0 a1 a2 a3) (E4No _ _ _ _) ((E4Yes) (values m5 (GEmpty) t (part-r t) (GHE r))))
  (let-match many (gtree-empty4 b0 b1 b2 b3) (E4No _ _ _ _)
