  (let-match many d (OdY _ o) ((OdE) (values ms3 m3 w l3 (ENone _))))
  (let-match erased c (CnN _ _ _ _) (absurd (CnE) o))
  (let ((erased ms4) (unique m4) (erased w4) (erased l4) (erased f)) (put-node n v vb j len t ms ms3 m3 w l3 nl fi))
  (values ms4 m4 w4 l4 (ESome _ f)))

