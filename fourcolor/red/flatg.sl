      (let ((unique ga1) (many k)) (fent-at us ga i v xe))
      (let ((erased w0)) (WrN us i (Succ i)))
      (let-match many (nat-zero-dec k) (IsSucc k1)
        ((IsZero)
          (let-match erased (gm-zero-o us (Zero) i go mo xe) (Refl _ _))
