  (let-match erased f (FlN _ _ _ q t1 t2 t3 _ _ tq f1 f2 f3 _) (absurd (FlE _ _ _ _ _) o))
  (let ((many c1) (erased c2-bd) (erased c3-bd)) (node-kids n q tq (flags-u62 ms (Zero) _ t3 f3 fit)))
  (let ((many c2)) (u62-inc c1 c2-bd))
  (let ((many c3)) (u62-inc c2 c3-bd))
  (match many s _
    ((GPush)
      (let ((unique m2) (many h)) (fleaf-hit1 bs (BP0 bs) t s (C2) ms m c2 t2 f2 (SelN2 t1 t2 t3) (SPush2 bs)))
      (let-match many h (H1No _ _ _) ((H1Yes _ _ _ et mm mt) (values m2 (H1Yes bs t s et mm mt))))
      (fleaf-hit1 bs (BP1 bs) t s (C3) ms m2 c3 t3 f3 (SelN3 t1 t2 t3) (SPush3 bs)))
    ((GSkip) (fleaf-hit1 bs bs t s (C1) ms m c1 t1 f1 (SelN1 t1 t2 t3) (SSkip bs)))
    ((GPop0)
      (match many bs _
        ((BS0) (values m (H1No bs t s)))
        ((BP0 b) (fleaf-hit1 bs b t s (C2) ms m c2 t2 f2 (SelN2 t1 t2 t3) (SPop02 b)))
        ((BP1 b) (fleaf-hit1 bs b t s (C3) ms m c3 t3 f3 (SelN3 t1 t2 t3) (SPop03 b)))))
    ((GPop1)
      (match many bs _
        ((BS0) (values m (H1No bs t s)))
        ((BP0 b) (fleaf-hit1 bs b t s (C3) ms m c3 t3 f3 (SelN3 t1 t2 t3) (SPop13 b)))
        ((BP1 b) (fleaf-hit1 bs b t s (C2) ms m c2 t2 f2 (SelN2 t1 t2 t3) (SPop12 b)))))))

(def-fns _ $ (many fmatch : (many (Gsym) s) (erased (List (U8)) ms) (unique (Bytes ms) m) (erased (FitF ms) fit) (many (Nat) j) (erased (List RC) rr r)
    (subterm many (FxL ms j r) rl) (erased (Suffix RC r rr) sf) -> (unique m is m2 at m) (many (HitRes rr s) res))
  (let-match many rl (FxCons _ _ bs n t f o rest tl) ((FxNil _ _) (values m (HNo rr s))))
  (let ((erased x)) (MkRx (Ctree) bs t))
  (let ((unique m1) (many h)) (fsym-hit s bs ms m fit j n t f o))
  (match many h _
    ((H1Yes _ _ _ et mm mt) (values m1 (HYes rr s (MkHits rr (Cons _ s (Nil _)) bs t et (suffix-elem RC x r rr sf (ElHere RC x rest)) mm mt))))
    ((H1No _ _ _) (tail $ fmatch s ms m1 fit j rr rest tl (SufNext RC x rest rr sf)))))

; Whether the hit and miss parts are empty.
(def-adts $ (HM : ((Gtree) a) ((Gtree) b) -> Type)
  enum
  (many HMNone : -> (HM (GEmpty) (GEmpty)))
  (many HMHit : (erased (Gtree) a) -> (HM a (GEmpty)))
  (many HMMiss : (erased (Gtree) b) -> (HM (GEmpty) b))
  (many HMBoth : (erased (Gtree) a b) -> (HM a b)))

; gs is empty, or the set whose selections are a0 to a3.
(def-adts $ (TopC : ((Nat) j) ((GSet) a0) ((GSet) a1) ((GSet) a2) ((GSet) a3) ((GSet) gs) -> Type)
  enum
  (many TcE : (erased (Nat) j) (erased (GSet) a0 a1 a2 a3) -> (TopC j a0 a1 a2 a3 (GSG (GEmpty))))
  (many TcN : (erased (Nat) j) (erased (GSet) a0 a1 a2 a3 gs) (erased (GTop j a0 a1 a2 a3 gs) tp) -> (TopC j a0 a1 a2 a3 gs)))

; a is the node of a0 to a3, or empty when all four are.
(def-adts $ (GCn : ((Gtree) a0) ((Gtree) a1) ((Gtree) a2) ((Gtree) a3) ((Gtree) a) -> Type)
  enum
  (many GCnE : -> (GCn (GEmpty) (GEmpty) (GEmpty) (GEmpty) (GEmpty)))
  (many GCnN : (erased (Gtree) a0 a1 a2 a3) -> (GCn a0 a1 a2 a3 (GNode a0 a1 a2 a3))))

(def-adts $ (Any4 : ((Bool) b0) ((Bool) b1) ((Bool) b2) ((Bool) b3) -> Type)
  enum
  (many A4No : -> (Any4 (BFalse) (BFalse) (BFalse) (BFalse)))
  (many A4Yes : (erased (Bool) b0 b1 b2 b3) -> (Any4 b0 b1 b2 b3)))

(def-fns _ $ (many any4 : (many (Bool) b0 b1 b2 b3) -> (many (Any4 b0 b1 b2 b3) r))
  (let-match many b0 (BFalse) ((BTrue) (A4Yes b0 b1 b2 b3)))
  (let-match many b1 (BFalse) ((BTrue) (A4Yes b0 b1 b2 b3)))
  (let-match many b2 (BFalse) ((BTrue) (A4Yes b0 b1 b2 b3)))
  (let-match many b3 (BFalse) ((BTrue) (A4Yes b0 b1 b2 b3)))
  (A4No))

(def-fns _ $ (many bp-x : (erased (Bool) l x y) (many (BitPart l x y) p) -> (many x is b))
  (match many p _ ((BPL) (BTrue)) ((BPR) (BFalse)) ((BPN) (BFalse))))

(def-fns _ $ (many bp-y : (erased (Bool) l x y) (many (BitPart l x y) p) -> (many y is b))
  (match many p _ ((BPL) (BFalse)) ((BPR) (BTrue)) ((BPN) (BFalse))))

(def-fns _ $ (erased bp-sym : (erased (Bool) l x y) (erased (BitPart l x y) p) -> (erased (BitPart l y x) q))
  (match erased p _ ((BPL) (BPR)) ((BPR) (BPL)) ((BPN) (BPN))))

(def-fns _ $ (erased leaf-sub : (erased (Gtree) l) (erased (Bool) l0 l1 l2 l3 x0 x1 x2 x3 y0 y1 y2 y3) (erased (LeafSet l (MkBits l0 l1 l2 l3)) ll)
    (erased (BitPart l0 x0 y0) q0) (erased (BitPart l1 x1 y1) q1) (erased (BitPart l2 x2 y2) q2) (erased (BitPart l3 x3 y3) q3) ->
    (erased (Gtree) g) (erased (LeafSet g (MkBits x0 x1 x2 x3)) lg))
  (match erased ll _
    ((LSE) (let-match erased q0 (BPN)) (let-match erased q1 (BPN)) (let-match erased q2 (BPN)) (let-match erased q3 (BPN)) (values (GEmpty) (LSE)))
    ((LS0) (let-match erased q1 (BPN)) (let-match erased q2 (BPN)) (let-match erased q3 (BPN))
      (match erased q0 _ ((BPL) (values (GL0) (LS0))) ((BPR) (values (GEmpty) (LSE)))))
    ((LS1) (let-match erased q0 (BPN)) (let-match erased q2 (BPN)) (let-match erased q3 (BPN))
      (match erased q1 _ ((BPL) (values (GL1) (LS1))) ((BPR) (values (GEmpty) (LSE)))))
    ((LS2) (let-match erased q0 (BPN)) (let-match erased q1 (BPN)) (let-match erased q3 (BPN))
      (match erased q2 _ ((BPL) (values (GL2) (LS2))) ((BPR) (values (GEmpty) (LSE)))))
    ((LS3) (let-match erased q0 (BPN)) (let-match erased q1 (BPN)) (let-match erased q2 (BPN))
      (match erased q3 _ ((BPL) (values (GL3) (LS3))) ((BPR) (values (GEmpty) (LSE)))))
    ((LS01) (let-match erased q2 (BPN)) (let-match erased q3 (BPN))
      (match erased q0 _
        ((BPL) (match erased q1 _ ((BPL) (values (GL01) (LS01))) ((BPR) (values (GL0) (LS0)))))
        ((BPR) (match erased q1 _ ((BPL) (values (GL1) (LS1))) ((BPR) (values (GEmpty) (LSE)))))))
    ((LS12) (let-match erased q0 (BPN)) (let-match erased q3 (BPN))
      (match erased q1 _
        ((BPL) (match erased q2 _ ((BPL) (values (GL12) (LS12))) ((BPR) (values (GL1) (LS1)))))
        ((BPR) (match erased q2 _ ((BPL) (values (GL2) (LS2))) ((BPR) (values (GEmpty) (LSE)))))))
    ((LS13) (let-match erased q0 (BPN)) (let-match erased q2 (BPN))
      (match erased q1 _
        ((BPL) (match erased q3 _ ((BPL) (values (GL13) (LS13))) ((BPR) (values (GL1) (LS1)))))
        ((BPR) (match erased q3 _ ((BPL) (values (GL3) (LS3))) ((BPR) (values (GEmpty) (LSE)))))))
    ((LS23) (let-match erased q0 (BPN)) (let-match erased q1 (BPN))
      (match erased q2 _
        ((BPL) (match erased q3 _ ((BPL) (values (GL23) (LS23))) ((BPR) (values (GL2) (LS2)))))
        ((BPR) (match erased q3 _ ((BPL) (values (GL3) (LS3))) ((BPR) (values (GEmpty) (LSE)))))))))

(def-fns _ $ (many hm-a : (erased (Gtree) a b) (many (HM a b) c) -> (many (GKeep a) e))
  (match many c _ ((HMNone) (GKEmpty)) ((HMMiss _) (GKEmpty)) (else (GKLive a))))

(def-fns _ $ (many hm-b : (erased (Gtree) a b) (many (HM a b) c) -> (many (GKeep b) e))
  (match many c _ ((HMNone) (GKEmpty)) ((HMHit _) (GKEmpty)) (else (GKLive b))))

(def-fns _ $ (many top-n : (erased (Nat) j) (erased (Gtree) a0 a1 a2 a3) (many (Empty4 a0 a1 a2 a3) z) ->
    (erased (Gtree) a) (erased (GCn a0 a1 a2 a3 a) cn) (many (TopC (Succ j) (GSG a0) (GSG a1) (GSG a2) (GSG a3) (GSG a)) c))
