  (let-match many tm (TryOk _ lm) ((TryNo _) (values m4 (GEmpty) t (part-r t) (GHE r))))
  (values m4 hit miss (leaf-part t hit miss l0 l1 l2 l3 a0 a1 a2 a3 c0 c1 c2 c3 ll lh lm p0 p1 p2 p3) (leaf-hit hit a0 a1 a2 a3 r lh h0 h1 h2 h3)))

(def-fns _ $ (many fgtree-restrict-c : (subterm many (Gtree) t) (erased (List Cnt) ms) (unique (Array Cnt ms) m) (erased (Fit ms) fit) (many (Nat) j)
