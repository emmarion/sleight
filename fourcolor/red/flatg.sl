  (let ((many nl)) (FxNil ms j1))
  (let ((unique m2) (erased r0) (erased r1) (erased r2) (erased r3) (many l0) (many l1) (many l2) (many l3) (erased y0) (erased y1) (erased y2) (erased y3))
    (fsplit w0 w1 w2 w3 ms m fit j1 r e e e e nl nl nl nl r rl (SufHere RC r) (RJNil (GPush) r) (RJNil (GSkip) r) (RJNil (GPop0) r) (RJNil (GPop1) r)))
  (values m2 j1 r0 r1 r2 r3 l0 l1 l2 l3 y0 y1 y2 y3))

(def-fns _ $ (many fleaf-hit1 : (erased (Bstack) bs bs2) (erased (Ctree) t) (erased (Gsym) s) (erased (Col) e) (erased (List Cnt) ms) (unique (Array Cnt ms) m)
