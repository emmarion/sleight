    (gm-wr u3 u4 j h2 h3 h3 h4 t2 a2 m2 s2 w3 (DisL h2 h3 h3 h4 (lt-succ h3)))))

(def-fns _ $ (erased wr4 : (erased (List (U8)) u0 u1 u2 u3 u4 u5) (erased (Nat) i h1 h2 h3 h4 v) (erased (Sx) t0 t1 t2 t3)
