  (let-match erased (nth-fn _ posf a qfa qb pqfa (respects-at pos f posf a b qb rpf pab pqb)) (Refl _ _))
  (let-match erased (in-dec a s) (OrR _ _ oa)
    ((OrL _ _ ia)
