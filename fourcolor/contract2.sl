; The contraction of contract_coloring of contract.v, with minimality as data. Load after contract.sl and birkhoff2.sl.

; WalkupF at the live dart z: z cut out of e and n, and added to the dead darts.
(def-fns _ $ (erased walk-dead-f : (erased (Nat) d m z) (erased (List (Nat)) e n f s) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (Dead d e n f s m) dd) (erased (Lt z d) lz) (erased (NotIn z s) out)
    -> (erased (List (Nat)) e2 n2 f2) (erased (Nat) m1) (erased (Skip e z e2) ske) (erased (Skip n z n2) skn) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Genus d e2 n2 f2 (Zero)) g2) (erased (Eq (Nat) m (Succ m1)) em) (erased (Dead d e2 n2 f2 (Cons (Nat) z s) m1) dd2))
  (let ((erased hr) (erased gr)) (genus-rot2 d (Zero) e n f h g))
  (let ((erased f2) (erased e2) (erased n2) (erased m1) (erased ske) (erased skn) (erased h2) (erased g2) (erased em) (erased dd2))
    (walk-dead d m z f e n s hr gr (dead-rot d m n f e s (dead-rot d m e n f s dd)) lz out))
  (values e2 n2 f2 m1 ske skn (hyper-rot d f2 e2 n2 h2) (genus-rot d (Zero) f2 e2 n2 h2 g2) em (dead-rot d m1 f2 e2 n2 _ dd2)))

(def-fns _ $ (erased fixed-out : (erased (Nat) d x y) (erased (List (Nat)) p q s) (erased (HPerm d p q) pm) (erased (FixedIn p s) fx) (erased (Nth (Nat) p x y) px)
    (erased (NotIn x s) out) -> (erased (NotIn y s) r))
  (let-match erased (in-dec y s) (OrR _ _ r)
    (absurd (OrL _ _ iy)
      (let-match erased (perm-inj d x y y p q pm px (fixed-at p s y fx iy)) (Refl _ _))
      (apart-irrefl x (notin-in x x s out iy))))
  r)

; The contraction of the edge x, ex: WalkupF at x, then at ex, both kept as dead darts. The faces of x and ex merge.
(def-fns _ $ (erased contract-dead : (erased (Nat) d m x ex) (erased (List (Nat)) e n f s) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (Dead d e n f s m) dd) (erased (Lt x d) lx) (erased (NotIn x s) out) (erased (Nth (Nat) e x ex) pex) (erased (Apart (Nat) Lt ex x) nex)
    -> (erased (List (Nat)) e1 n1 f1 e2 n2 f2) (erased (Nat) m2) (erased (Skip e x e1) ske1) (erased (Skip n x n1) skn1) (erased (Skip e1 ex e2) ske2)
    (erased (Skip n1 ex n2) skn2) (erased (Hypermap d e1 n1 f1) h1) (erased (Hypermap d e2 n2 f2) h2) (erased (Genus d e2 n2 f2 (Zero)) g2)
    (erased (Eq (Nat) m (Succ (Succ m2))) em) (erased (Dead d e2 n2 f2 (Cons (Nat) ex (Cons (Nat) x s)) m2) dd2))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased dd (MkDead _ _ k _ _ _ _ fe fn ff ds ls us a))
  (let ((erased oex)) (fixed-out d x ex e nf s pe fe pex out))
  (let ((erased e1) (erased n1) (erased f1) (erased m1) (erased ske1) (erased skn1) (erased h1) (erased g1) (erased em1) (erased dd1))
    (walk-dead-f d m x e n f s h g dd lx out))
  (let ((erased e2) (erased n2) (erased f2) (erased m2) (erased ske2) (erased skn2) (erased h2) (erased g2) (erased em2) (erased dd2))
    (walk-dead-f d m1 ex e1 n1 f1 (Cons _ x s) h1 g1 dd1 (perm-val d x ex e nf pe pex) (NotInCons ex x s nex oex)))
  (let-match erased em1 (Refl _ _))
  (let-match erased em2 (Refl _ _))
  (values e1 n1 f1 e2 n2 f2 m2 ske1 skn1 ske2 skn2 h1 h2 g2 (Refl _ m) dd2))

; After WalkupF at z, a face step a -> c with neither e^-1 a nor a nor c at z is kept.
(def-fns _ $ (erased wf-keep : (erased (Nat) d z a b c) (erased (List (Nat)) e n f e2 n2 f2) (erased (Hypermap d e n f) h) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Skip e z e2) ske) (erased (Skip n z n2) skn) (erased (Nth (Nat) e b a) pb) (erased (Apart (Nat) Lt b z) nb) (erased (Apart (Nat) Lt a z) na)
    (erased (Nth (Nat) f a c) pa) (erased (Apart (Nat) Lt c z) nc) -> (erased (Nth (Nat) f2 a c) r))
  (hyper-third d a b c e2 n2 f2 h2 (skip-keep z b a e e2 ske pb nb na) (skip-keep z c b n n2 skn (hyper-node d c a b e n f h pa pb) nc nb)))

; After WalkupF at z, a face step a -> z continues to f (e z).
(def-fns _ $ (erased wf-jump : (erased (Nat) d z a b ez w) (erased (List (Nat)) e n f e2 n2 f2) (erased (Hypermap d e n f) h) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Skip e z e2) ske) (erased (Skip n z n2) skn) (erased (Nth (Nat) e b a) pb) (erased (Apart (Nat) Lt b z) nb) (erased (Apart (Nat) Lt a z) na)
    (erased (Nth (Nat) f a z) pa) (erased (Nth (Nat) e z ez) pz) (erased (Nth (Nat) f ez w) pw) -> (erased (Nth (Nat) f2 a w) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased nzb)) (hyper-node d z a b e n f h pa pb))
  (let ((erased nwz)) (hyper-node d w ez z e n f h pw pz))
  (let-match erased (nat-eq w z) (Unequal _ _ _ _ nwz2)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ n z z b nwz nzb) (Refl _ _)) (apart-irrefl b nb)))
  (hyper-third d a b w e2 n2 f2 h2 (skip-keep z b a e e2 ske pb nb na) (skip-cut-at d z w b n ni n2 pn skn nwz nzb nwz2)))

; Where ez steps after WalkupF at z: to u = f z, or to v = f ez when f z = z.
(def-adts $ (Jump1 : ((Nat) z u v j) -> Type)
  enum
  (many J1Keep : (erased (Nat) z u v) (erased (Apart (Nat) Lt u z) nu) -> (Jump1 z u v u))
  (many J1Loop : (erased (Nat) z v) -> (Jump1 z z v v)))

; After WalkupF at z, with ez = e z and z = e ez, ez steps to f z, or to f ez when z is alone on its face.
(def-fns _ $ (erased wf-partner : (erased (Nat) d z ez u v) (erased (List (Nat)) e n f e2 n2 f2) (erased (Hypermap d e n f) h) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Skip e z e2) ske) (erased (Skip n z n2) skn) (erased (Nth (Nat) e z ez) pz) (erased (Nth (Nat) e ez z) pez) (erased (Apart (Nat) Lt ez z) nez)
    (erased (Nth (Nat) f z u) pu) (erased (Nth (Nat) f ez v) pv) -> (erased (Nat) j) (erased (Nth (Nat) f2 ez j) r) (erased (Jump1 z u v j) jp))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased e2z)) (skip-cut-at d z ez ez e nf e2 pe ske pez pz nez))
  (let-match erased (nat-eq u z) (Unequal _ _ _ _ nuz)
    ((Equal _ _ _)
      (let ((erased nvz)) (hyper-node d v ez z e n f h pv pz))
      (let ((erased nzz)) (hyper-node d z z ez e n f h pu pez))
      (let-match erased (nat-eq v z) (Unequal _ _ _ _ nvz2)
        (absurd (Equal _ _ _) (let-match erased (nth-fn _ n z z ez nvz nzz) (Refl _ _)) (apart-irrefl z nez)))
      (values v (hyper-third d ez ez v e2 n2 f2 h2 e2z (skip-cut-at d z v ez n ni n2 pn skn nvz nzz nvz2)) (J1Loop z v))))
  (values u (hyper-third d ez ez u e2 n2 f2 h2 e2z (skip-keep z u ez n n2 skn (hyper-node d u z ez e n f h pu pez) nuz nez)) (J1Keep z u v nuz)))

; Where a face step a -> c goes after contracting x, ex (u = f x, v = f ex): it is kept off x and ex, and otherwise jumps
; to the other face, or stays on its own when the other face is a single dart.
(def-adts $ (Jump : ((Nat) x ex u v c j) -> Type)
  enum
  (many JKeep : (erased (Nat) x ex u v c) (erased (Apart (Nat) Lt c x) nx) (erased (Apart (Nat) Lt c ex) ne) -> (Jump x ex u v c c))
  (many JX : (erased (Nat) x ex u v) (erased (Apart (Nat) Lt v ex) nv) -> (Jump x ex u v x v))
  (many JXL : (erased (Nat) x ex u) (erased (Apart (Nat) Lt u x) nu) -> (Jump x ex u ex x u))
  (many JE : (erased (Nat) x ex u v) (erased (Apart (Nat) Lt u x) nu) -> (Jump x ex u v ex u))
  (many JEL : (erased (Nat) x ex v) -> (Jump x ex x v ex v)))

(def-fns _ $ (erased cf-face : (erased (Nat) d x ex u v a b c) (erased (List (Nat)) e n f e1 n1 f1 e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Hypermap d e1 n1 f1) h1) (erased (Hypermap d e2 n2 f2) h2) (erased (Skip e x e1) ske1) (erased (Skip n x n1) skn1) (erased (Skip e1 ex e2) ske2)
    (erased (Skip n1 ex n2) skn2) (erased (Nth (Nat) e x ex) pex) (erased (Nth (Nat) e ex x) pxe) (erased (Apart (Nat) Lt ex x) nex)
    (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Nth (Nat) e b a) pb) (erased (Apart (Nat) Lt b x) nbx) (erased (Apart (Nat) Lt b ex) nbe)
    (erased (Apart (Nat) Lt a x) nax) (erased (Apart (Nat) Lt a ex) nae) (erased (Nth (Nat) f a c) pa)
    -> (erased (Nat) j) (erased (Nth (Nat) f2 a j) r) (erased (Jump x ex u v c j) jp))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased pb1)) (skip-keep x b a e e1 ske1 pb nbx nax))
  (let ((erased e1x)) (skip-cut-at d x ex ex e nf e1 pe ske1 pxe pex nex))
  (let ((erased j1) (erased p1) (erased jp1)) (wf-partner d x ex u v e n f e1 n1 f1 h h1 ske1 skn1 pex pxe nex pu pv))
  (let-match erased (nat-eq c x) (Unequal _ _ _ _ ncx)
    ((Equal _ _ _)
      (let-match erased (nat-eq u x) (Unequal _ _ _ _ nux)
        (absurd (Equal _ _ _) (let-match erased (perm-inj d a x x f fi pf pa pu) (Refl _ _)) (apart-irrefl a nax)))
      (let ((erased qa)) (wf-jump d x a b ex v e n f e1 n1 f1 h h1 ske1 skn1 pb nbx nax pa pex pv))
      (let-match erased (nat-eq v ex) (Unequal _ _ _ _ nve)
        ((Equal _ _ _)
          (let-match erased jp1 (J1Keep _ _ _ _) (absurd (J1Loop _ _) (apart-irrefl x nux)))
          (values u (wf-jump d ex a b ex u e1 n1 f1 e2 n2 f2 h1 h2 ske2 skn2 pb1 nbe nae qa e1x p1) (JXL x ex u nux))))
      (values v (wf-keep d ex a b v e1 n1 f1 e2 n2 f2 h1 h2 ske2 skn2 pb1 nbe nae qa nve) (JX x ex u v nve))))
  (let ((erased qa)) (wf-keep d x a b c e n f e1 n1 f1 h h1 ske1 skn1 pb nbx nax pa ncx))
  (let-match erased (nat-eq c ex) (Unequal _ _ _ _ nce)
    ((Equal _ _ _)
      (let ((erased r2)) (wf-jump d ex a b ex j1 e1 n1 f1 e2 n2 f2 h1 h2 ske2 skn2 pb1 nbe nae qa e1x p1))
      (match erased jp1 (((Nat) j) ((Nth (Nat) f2 a j) r) ((Jump x ex u v c j) jp))
        ((J1Keep _ _ _ nux) (values u r2 (JE x ex u v nux)))
        ((J1Loop _ _) (values v r2 (JEL x ex v))))))
  (values c (wf-keep d ex a b c e1 n1 f1 e2 n2 f2 h1 h2 ske2 skn2 pb1 nbe nae qa nce) (JKeep x ex u v c ncx nce)))

(def-fns _ $ (erased absurd seps-path : (erased (Nat) a b) (erased (List (Nat)) f s xs) (erased (Seps f a b) sp) (erased (Path f s a b xs) w) -> (erased (False) r))
  (let-match erased sp (MkSeps _ lab _ _ se))
  (let-match erased se (MkSeparates _ _ _ _ l1 l2 rf p1 p2 ne))
  (let-match erased (nth-fn _ lab b l1 l2 (path-col lab f s xs a b l1 rf w p1) p2) (Refl _ _))
  (apart-irrefl l1 ne))

; A walk from a fixed dart stays there.
(def-fns _ $ (erased fixed-stay : (erased (Nat) c y) (erased (List (Nat)) f s t xs) (erased (FixedIn f s) fx) (erased (In c s) ic)
    (subterm erased (Path f t c y xs) w) -> (erased (Eq (Nat) c y) r))
  (let-match erased w (PathStep _ _ xs1 _ z _ pz _ w1) ((PathHere _ _ _) (Refl _ c)))
  (let-match erased (nth-fn _ f c z c pz (fixed-at f s c fx ic)) (Refl _ _))
  (fixed-stay c y f s t xs1 fx ic w1))

; q agrees with p off the darts s, each step of the history cutting an edge pair x, y of the current permutation.
(def-adts $ (EAgree : ((Nat) d) ((List (Nat)) p q s) -> Type)
  enum
  (many EAgNil : (erased (Nat) d) (erased (List (Nat)) p) -> (EAgree d p p (Nil (Nat))))
  (many EAgStep : (erased (Nat) d x y) (erased (List (Nat)) p q qi q1 q2 s) (erased (EAgree d p q s) ag) (erased (HPerm d q qi) pm) (erased (Skip q x q1) sk1)
      (erased (Skip q1 y q2) sk2) (erased (Nth (Nat) q x y) pxy) (erased (Nth (Nat) q y x) pyx) -> (EAgree d p q2 (Cons (Nat) y (Cons (Nat) x s)))))

(def-fns _ $ (erased agree-at : (erased (Nat) d a b) (erased (List (Nat)) p q s) (subterm erased (EAgree d p q s) ag) (erased (NotIn a s) out) (erased (Nth (Nat) p a b) pa)
    -> (erased (Nth (Nat) q a b) r))
  (let-match erased ag (EAgStep _ x y _ q0 qi q1 _ s1 ag1 pm sk1 sk2 pxy pyx) ((EAgNil _ _) pa))
  (let-match erased out (NotInCons _ _ _ nay out1))
  (let-match erased out1 (NotInCons _ _ _ nax out2))
  (let ((erased qa)) (agree-at d a b p q0 s1 ag1 out2 pa))
  (let-match erased (nat-eq b x) (Unequal _ _ _ _ nbx)
    (absurd (Equal _ _ _) (let-match erased (perm-inj d a y x q0 qi pm qa pyx) (Refl _ _)) (apart-irrefl a nay)))
  (let-match erased (nat-eq b y) (Unequal _ _ _ _ nby)
    (absurd (Equal _ _ _) (let-match erased (perm-inj d a x y q0 qi pm qa pxy) (Refl _ _)) (apart-irrefl a nax)))
  (skip-keep y a b q1 q sk2 (skip-keep x a b q0 q1 sk1 qa nax nbx) nay nby))

; e is the plain e0 off the dead darts s.
(def-adts $ (LPlain : ((Nat) d) ((List (Nat)) e s) -> Type)
  enum
  (many MkLPlain : (erased (Nat) d) (erased (List (Nat)) e0 e ei s) (erased (AllOrder d e0 (Succ (Succ (Zero)))) pl) (erased (EAgree d e0 e s) ag)
      (erased (HPerm d e ei) pm) (erased (FixedIn e s) fx) (erased (Length (Nat) e0 d) le) -> (LPlain d e s)))

(def-fns _ $ (erased lp-at : (erased (Nat) d a) (erased (List (Nat)) e s) (erased (LPlain d e s) lp) (erased (Lt a d) la) (erased (NotIn a s) out)
    -> (erased (Nat) b) (erased (Nth (Nat) e a b) pa) (erased (Nth (Nat) e b a) pb) (erased (Apart (Nat) Lt b a) ne) (erased (NotIn b s) ob))
  (let-match erased lp (MkLPlain _ e0 _ ei _ pl ag pm fx le))
  (let ((erased b) (erased p0)) (nth-exists _ e0 d a le la))
  (let ((erased q0) (erased ne)) (plain-eq d a b e0 pl la p0))
  (let ((erased pa)) (agree-at d a b e0 e s ag out p0))
  (let ((erased ob)) (fixed-out d a b e ei s pm fx pa out))
  (values b pa (agree-at d b a e0 e s ag ob q0) ne ob))

(def-fns _ $ (erased absurd seps-back : (erased (Nat) a b) (erased (List (Nat)) f s xs) (erased (Seps f a b) sp) (erased (Path f s b a xs) w) -> (erased (False) r))
  (let-match erased sp (MkSeps _ lab _ _ se))
  (let-match erased se (MkSeparates _ _ _ _ l1 l2 rf p1 p2 ne))
  (let-match erased (nth-fn _ lab a l2 l1 (path-col lab f s xs b a l2 rf w p2) p1) (Refl _ _))
  (apart-irrefl l1 ne))

; The contraction of the edge x, ex of a map with dead darts s, whose e is plain off s, with u = f x, v = f ex and x and ex
; told apart along the faces.
(def-adts $ (CStep : ((Nat) d x ex) ((List (Nat)) e n f s e2 n2 f2) -> Type)
  enum
  (many MkCStep : (erased (Nat) d x ex m m2 u v) (erased (List (Nat)) e n f s e1 n1 f1 e2 n2 f2) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
      (erased (Dead d e n f s m) dd) (erased (LPlain d e s) lp) (erased (Lt x d) lx) (erased (NotIn x s) out) (erased (Nth (Nat) e x ex) pex)
      (erased (Nth (Nat) e ex x) pxe) (erased (Apart (Nat) Lt ex x) nex) (erased (NotIn ex s) oex) (erased (Skip e x e1) ske1) (erased (Skip n x n1) skn1)
      (erased (Skip e1 ex e2) ske2) (erased (Skip n1 ex n2) skn2) (erased (Hypermap d e1 n1 f1) h1) (erased (Hypermap d e2 n2 f2) h2)
      (erased (Genus d e2 n2 f2 (Zero)) g2) (erased (Eq (Nat) m (Succ (Succ m2))) em) (erased (Dead d e2 n2 f2 (Cons (Nat) ex (Cons (Nat) x s)) m2) dd2)
      (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Seps f x ex) nb) -> (CStep d x ex e n f s e2 n2 f2)))

(def-fns _ $ (erased cstep-make : (erased (Nat) d m x) (erased (List (Nat)) e n f s) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (Dead d e n f s m) dd) (erased (LPlain d e s) lp) (erased (Lt x d) lx) (erased (NotIn x s) out) (erased (Nat) ex) (erased (Nth (Nat) e x ex) pex)
    (erased (Seps f x ex) nb) -> (erased (List (Nat)) e2 n2 f2) (erased (Nat) m2) (erased (Eq (Nat) m (Succ (Succ m2))) em)
    (erased (Dead d e2 n2 f2 (Cons (Nat) ex (Cons (Nat) x s)) m2) dd2) (erased (CStep d x ex e n f s e2 n2 f2) cs))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased ex2) (erased pex2) (erased pxe) (erased nex) (erased oex)) (lp-at d x e s lp lx out))
  (let-match erased (nth-fn _ e x ex ex2 pex pex2) (Refl _ _))
  (let ((erased e1) (erased n1) (erased f1) (erased e2) (erased n2) (erased f2) (erased m2) (erased ske1) (erased skn1) (erased ske2) (erased skn2)
      (erased h1) (erased h2) (erased g2) (erased em) (erased dd2))
    (contract-dead d m x ex e n f s h g dd lx out pex nex))
  (let ((erased u) (erased pu) (erased _)) (perm-nth d x f fi pf lx))
  (let ((erased v) (erased pv) (erased _)) (perm-nth d ex f fi pf (perm-val d x ex e nf pe pex)))
  (values e2 n2 f2 m2 em dd2
    (MkCStep d x ex m m2 u v e n f s e1 n1 f1 e2 n2 f2 h g dd lp lx out pex pxe nex oex ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 pu pv nb)))

; Where a live dart's face step goes in the contraction.
(def-fns _ $ (erased cs-face : (erased (Nat) d x ex a c) (erased (List (Nat)) e n f s e2 n2 f2) (erased (CStep d x ex e n f s e2 n2 f2) cs) (erased (Lt a d) la)
    (erased (NotIn a (Cons (Nat) ex (Cons (Nat) x s))) oa) (erased (Nth (Nat) f a c) pa)
    -> (erased (Nat) u v j) (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Nth (Nat) f2 a j) r) (erased (Jump x ex u v c j) jp))
  (let-match erased cs (MkCStep _ _ _ m m2 u v _ _ _ _ e1 n1 f1 _ _ _ h g dd lp lx out pex pxe nex oex ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 pu pv nb))
  (let-match erased oa (NotInCons _ _ _ nae oa1))
  (let-match erased oa1 (NotInCons _ _ _ nax oa2))
  (let ((erased b) (erased pab) (erased pb) (erased _) (erased _)) (lp-at d a e s lp la oa2))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased (nat-eq b x) (Unequal _ _ _ _ nbx)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ e x a ex pb pex) (Refl _ _)) (apart-irrefl a nae)))
  (let-match erased (nat-eq b ex) (Unequal _ _ _ _ nbe)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ e ex a x pb pxe) (Refl _ _)) (apart-irrefl a nax)))
  (let ((erased j) (erased r) (erased jp)) (cf-face d x ex u v a b c e n f e1 n1 f1 e2 n2 f2 h h1 h2 ske1 skn1 ske2 skn2 pex pxe nex pu pv pb nbx nbe nax nae pa))
  (values u v j pu pv r jp))

(def-fns _ $ (erased cs-live-f : (erased (Nat) d x ex a c) (erased (List (Nat)) e n f s e2 n2 f2) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    (erased (NotIn a s) oa) (erased (Nth (Nat) f a c) pa) -> (erased (NotIn c s) r) (erased (Lt c d) lc))
  (let-match erased cs (MkCStep _ _ _ m m2 u v _ _ _ _ e1 n1 f1 _ _ _ h g dd lp lx out pex pxe nex oex ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 pu pv nb))
  (let-match erased dd (MkDead _ _ k _ _ _ _ fe fn ff ds ls us a2))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (values (fixed-out d a c f fi s pf ff pa oa) (perm-val d a c f fi pf pa)))

; Along the face of ex from a live dart c, the contraction reaches u = f x (when f x is not x).
(def-fns _ $ (erased walk-ex : (erased (Nat) d x ex c u) (erased (List (Nat)) e n f s e2 n2 f2 xs) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    (subterm erased (Path f (Cons (Nat) ex (Nil (Nat))) c ex xs) w) (erased (Lt c d) lc) (erased (NotIn c (Cons (Nat) ex (Cons (Nat) x s))) oc)
    (erased (Nth (Nat) f x u) pu) (erased (Apart (Nat) Lt u x) nux) -> (erased (SomePath f2 (Nil (Nat)) c u) r))
  (let-match erased w (PathStep _ _ xs1 _ c1 _ pc _ w1)
    (absurd (PathHere _ _ _) (let-match erased oc (NotInCons _ _ _ ne _)) (apart-irrefl c ne)))
  (let ((erased u2) (erased v) (erased j) (erased pu2) (erased pv) (erased r) (erased jp)) (cs-face d x ex c c1 e n f s e2 n2 f2 cs lc oc pc))
  (let-match erased (nth-fn _ f x u u2 pu pu2) (Refl _ _))
  (let-match erased cs (MkCStep _ _ _ m m2 _ _ _ _ _ _ e1 n1 f1 _ _ _ h g dd lp lx out pex pxe nex oex ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 _ _ nb))
  (let-match erased jp (JKeep _ _ _ _ _ ncx nce)
    (absurd (JX _ _ _ _ _) (seps-path x ex f _ xs1 nb w1))
    (absurd (JXL _ _ _ _) (seps-path x ex f _ xs1 nb w1))
    ((JE _ _ _ _ _) (some-step f2 c u r))
    (absurd (JEL _ _ _) (apart-irrefl x nux)))
  (let-match erased oc (NotInCons _ _ _ _ oc1))
  (let-match erased oc1 (NotInCons _ _ _ _ oc2))
  (let ((erased os) (erased lc1)) (cs-live-f d x ex c c1 e n f s e2 n2 f2 cs oc2 pc))
  (some-cat f2 c c1 u (some-step f2 c c1 r) (walk-ex d x ex c1 u e n f s e2 n2 f2 xs1 cs w1 lc1 (NotInCons c1 ex _ nce (NotInCons c1 x s ncx os)) pu nux)))

; Along the face of x from a live dart c, the contraction reaches v = f ex (when f ex is not ex).
(def-fns _ $ (erased walk-x : (erased (Nat) d x ex c v) (erased (List (Nat)) e n f s e2 n2 f2 xs) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    (subterm erased (Path f (Cons (Nat) x (Nil (Nat))) c x xs) w) (erased (Lt c d) lc) (erased (NotIn c (Cons (Nat) ex (Cons (Nat) x s))) oc)
    (erased (Nth (Nat) f ex v) pv) (erased (Apart (Nat) Lt v ex) nve) -> (erased (SomePath f2 (Nil (Nat)) c v) r))
  (let-match erased w (PathStep _ _ xs1 _ c1 _ pc _ w1)
    (absurd (PathHere _ _ _) (let-match erased oc (NotInCons _ _ _ _ oc1)) (let-match erased oc1 (NotInCons _ _ _ ne _)) (apart-irrefl c ne)))
  (let ((erased u) (erased v2) (erased j) (erased pu) (erased pv2) (erased r) (erased jp)) (cs-face d x ex c c1 e n f s e2 n2 f2 cs lc oc pc))
  (let-match erased (nth-fn _ f ex v v2 pv pv2) (Refl _ _))
  (let-match erased cs (MkCStep _ _ _ m m2 _ _ _ _ _ _ e1 n1 f1 _ _ _ h g dd lp lx out pex pxe nex oex ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 _ _ nb))
  (let-match erased jp (JKeep _ _ _ _ _ ncx nce)
    ((JX _ _ _ _ _) (some-step f2 c v r))
    (absurd (JXL _ _ _ _) (apart-irrefl ex nve))
    (absurd (JE _ _ _ _ _) (seps-back x ex f _ xs1 nb w1))
    (absurd (JEL _ _ _) (seps-back x ex f _ xs1 nb w1)))
  (let-match erased oc (NotInCons _ _ _ _ oc1))
  (let-match erased oc1 (NotInCons _ _ _ _ oc2))
  (let ((erased os) (erased lc1)) (cs-live-f d x ex c c1 e n f s e2 n2 f2 cs oc2 pc))
  (some-cat f2 c c1 v (some-step f2 c c1 r) (walk-x d x ex c1 v e n f s e2 n2 f2 xs1 cs w1 lc1 (NotInCons c1 ex _ nce (NotInCons c1 x s ncx os)) pv nve)))

; q sends x and ex to r and fixes every other dart below d.
(def-adts $ (QMap : ((Nat) d x ex r) ((List (Nat)) q) -> Type)
  enum
  (many MkQMap : (erased (Nat) d x ex r) (erased (List (Nat)) ids q) (erased (Iota d ids) io) (erased (Upd2 ids x r ex r q) up) -> (QMap d x ex r q)))

(def-fns _ $ (erased qmap-exists : (erased (Nat) d x ex r) (erased (Lt x d) lx) (erased (Lt ex d) lxe) (erased (Apart (Nat) Lt x ex) ne)
    -> (erased (List (Nat)) q) (erased (QMap d x ex r q) qm))
  (let ((erased ids) (erased io)) (iota-exists d))
  (let ((erased q) (erased up)) (upd2-exists ids x r ex r d (iota-length d ids io) lx lxe ne))
  (values q (MkQMap d x ex r ids q io up)))

(def-fns _ $ (erased qmap-x : (erased (Nat) d x ex r) (erased (List (Nat)) q) (erased (QMap d x ex r q) qm) -> (erased (Nth (Nat) q x r) a) (erased (Nth (Nat) q ex r) b))
  (let-match erased qm (MkQMap _ _ _ _ ids _ io up))
  (values (upd2-a ids q x r ex r up) (upd2-b ids q x r ex r up)))

(def-fns _ $ (erased qmap-other : (erased (Nat) d x ex r a) (erased (List (Nat)) q) (erased (QMap d x ex r q) qm) (erased (Lt a d) la)
    (erased (Apart (Nat) Lt a x) nx) (erased (Apart (Nat) Lt a ex) ne) -> (erased (Nth (Nat) q a a) r2))
  (let-match erased qm (MkQMap _ _ _ _ ids _ io up))
  (upd2-other ids q x r ex r a a up (iota-nth d a ids io la) nx ne))

(def-fns _ $ (erased qmap-length : (erased (Nat) d x ex r) (erased (List (Nat)) q) (erased (QMap d x ex r q) qm) -> (erased (Length (Nat) q d) l))
  (let-match erased qm (MkQMap _ _ _ _ ids _ io up))
  (upd2-length ids q x r ex r d up (iota-length d ids io)))

; The dart of the merged face that x and ex are sent to: u = f x, or v = f ex when f x = x, or any live y when both are alone.
(def-adts $ (Rep : ((Nat) x ex u v r) -> Type)
  enum
  (many RepU : (erased (Nat) x ex u v) (erased (Apart (Nat) Lt u x) nu) -> (Rep x ex u v u))
  (many RepV : (erased (Nat) x ex v) (erased (Apart (Nat) Lt v ex) nv) -> (Rep x ex x v v))
  (many RepY : (erased (Nat) x ex y) -> (Rep x ex x ex y)))

(def-fns _ $ (erased rep-of : (erased (Nat) x ex u v y) -> (erased (Nat) r) (erased (Rep x ex u v r) rp))
  (let-match erased (nat-eq u x) (Unequal _ _ _ _ nu) ((Equal _ _ _)
    (let-match erased (nat-eq v ex) (Unequal _ _ _ _ nv) ((Equal _ _ _) (values y (RepY x ex y))))
    (values v (RepV x ex v nv))))
  (values u (RepU x ex u v nu)))

(def-fns _ $ (erased some-here : (erased (List (Nat)) f) (erased (Nat) a) -> (erased (SomePath f (Nil (Nat)) a a) r))
  (MkSomePath f _ (Nil _) a a (PathHere f _ a)))

(def-fns _ $ (erased cs-uv : (erased (Nat) d x ex) (erased (List (Nat)) e n f s e2 n2 f2) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    -> (erased (Nat) u v) (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Lt x d) lx) (erased (Lt ex d) lxe)
    (erased (Apart (Nat) Lt ex x) nex) (erased (NotIn x s) out) (erased (NotIn ex s) oex) (erased (Seps f x ex) nb) (erased (List (Nat)) fi)
    (erased (HPerm d f fi) pf))
  (let-match erased cs (MkCStep _ _ _ m m2 u v _ _ _ _ e1 n1 f1 _ _ _ h g dd lp lx out pex pxe nex oex ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 pu pv nb))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (values u v pu pv lx (perm-val d x ex e nf pe pex) nex out oex nb fi pf))

(def-fns _ $ (erased perm-inj-apart : (erased (Nat) d a b c) (erased (List (Nat)) p q) (erased (HPerm d p q) pm) (erased (Nth (Nat) p a c) pa)
    (erased (Nth (Nat) p b c) pb) (erased (Apart (Nat) Lt a b) ne) -> (erased (Apart (Nat) Lt a a) r))
  (let-match erased (perm-inj d a b c p q pm pa pb) (Refl _ _))
  ne)

; A walk along f from a's image back to a, leaving a only at the end.
(def-fns _ $ (erased back-walk : (erased (Nat) d a b) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (erased (Nth (Nat) f a b) pa) (erased (Lt a d) la)
    -> (erased (List (Nat)) xs) (erased (Path f (Cons (Nat) a (Nil (Nat))) b a xs) r))
  (let ((erased xs) (erased w)) (cycle d a b f fi pf pa la))
  (cut-first f (Nil _) xs b a w))

; The contraction sends each face step a -> f a, read through q, along a face.
(def-fns _ $ (erased qreach-at : (erased (Nat) d x ex r a c qa qc u v) (erased (List (Nat)) e n f s e2 n2 f2 q) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Rep x ex u v r) rp) (erased (QMap d x ex r q) qm) (erased (Lt a d) la)
    (erased (Nth (Nat) f a c) pa) (erased (Nth (Nat) q a qa) pqa) (erased (Nth (Nat) q c qc) pqc) -> (erased (SomePath f2 (Nil (Nat)) qa qc) res))
  (let ((erased u1) (erased v1) (erased pu1) (erased pv1) (erased lx) (erased lxe) (erased nex) (erased out) (erased oex) (erased nb) (erased fi) (erased pf))
    (cs-uv d x ex e n f s e2 n2 f2 cs))
  (let-match erased (nth-fn _ f x u u1 pu pu1) (Refl _ _))
  (let-match erased (nth-fn _ f ex v v1 pv pv1) (Refl _ _))
  (let ((erased qx) (erased qex)) (qmap-x d x ex r q qm))
  (let ((erased lc)) (perm-val d a c f fi pf pa))
  (let-match erased (nat-eq c a) (Unequal _ _ _ _ nca) ((Equal _ _ _) (let-match erased (nth-fn _ q a qa qc pqa pqc) (Refl _ _)) (some-here f2 qa)))
  (let-match erased (nat-eq u ex) (Unequal _ _ _ _ nue) (absurd (Equal _ _ _) (seps-path x ex f _ _ nb (PathStep f _ _ x ex ex pu (NotInNil x) (PathHere f _ ex)))))
  (let-match erased (nat-eq v x) (Unequal _ _ _ _ nvx) (absurd (Equal _ _ _) (seps-back x ex f _ _ nb (PathStep f _ _ ex x x pv (NotInNil ex) (PathHere f _ x)))))
  (let ((erased ou) (erased lu)) (cs-live-f d x ex x u e n f s e2 n2 f2 cs out pu))
  (let ((erased ov) (erased lv)) (cs-live-f d x ex ex v e n f s e2 n2 f2 cs oex pv))
  (let-match erased (nat-eq a x) (Unequal _ _ _ _ nax)
    ((Equal _ _ _)
      (let-match erased (nth-fn _ f x c u pa pu) (Refl _ _))
      (let-match erased (nth-fn _ q x qa r pqa qx) (Refl _ _))
      (let-match erased rp (RepU _ _ _ _ nu) (absurd (RepV _ _ _ _) (apart-irrefl x nca)) (absurd (RepY _ _ _) (apart-irrefl x nca)))
      (let-match erased (nth-fn _ q u qc u pqc (qmap-other d x ex r u q qm lu nu nue)) (Refl _ _))
      (some-here f2 qa)))
  (let-match erased (nat-eq a ex) (Unequal _ _ _ _ nae)
    ((Equal _ _ _)
      (let-match erased (nth-fn _ f ex c v pa pv) (Refl _ _))
      (let-match erased (nth-fn _ q ex qa r pqa qex) (Refl _ _))
      (let-match erased (nth-fn _ q v qc v pqc (qmap-other d x ex r v q qm lv nvx nca)) (Refl _ _))
      (let-match erased rp (RepU _ _ _ _ nu) ((RepV _ _ _ _) (some-here f2 qa)) (absurd (RepY _ _ _) (apart-irrefl ex nca)))
      (let ((erased xs) (erased w)) (back-walk d x u f fi pf pu lx))
      (walk-x d x ex u v e n f s e2 n2 f2 xs cs w lu (NotInCons u ex _ nue (NotInCons u x s nu ou)) pv nca)))
  (let-match erased (in-dec a s) (OrR _ _ oa)
    (absurd (OrL _ _ ia)
      (let-match erased cs (MkCStep _ _ _ m m2 _ _ _ _ _ _ e1 n1 f1 _ _ _ h g dd lp _ _ pex pxe _ _ ske1 skn1 ske2 skn2 h1 h2 g2 em dd2 _ _ _))
      (let-match erased dd (MkDead _ _ k _ _ _ _ fe fn ff ds ls us a2))
      (let-match erased (nth-fn _ f a c a pa (fixed-at f s a ff ia)) (Refl _ _))
      (apart-irrefl a nca)))
  (let ((erased oa3)) (NotInCons a ex _ nae (NotInCons a x s nax oa)))
  (let-match erased (nth-fn _ q a qa a pqa (qmap-other d x ex r a q qm la nax nae)) (Refl _ _))
  (let ((erased u2) (erased v2) (erased j) (erased pu2) (erased pv2) (erased pj) (erased jp)) (cs-face d x ex a c e n f s e2 n2 f2 cs la oa3 pa))
  (let-match erased (nth-fn _ f x u u2 pu pu2) (Refl _ _))
  (let-match erased (nth-fn _ f ex v v2 pv pv2) (Refl _ _))
  (match erased jp _
    ((JKeep _ _ _ _ _ ncx nce) (let-match erased (nth-fn _ q c qc c pqc (qmap-other d x ex r c q qm lc ncx nce)) (Refl _ _)) (some-step f2 a c pj))
    ((JX _ _ _ _ nve)
      (let-match erased (nth-fn _ q x qc r pqc qx) (Refl _ _))
      (let-match erased rp (RepU _ _ _ _ nu)
        (absurd (RepV _ _ _ _) (apart-irrefl a (perm-inj-apart d a x x f fi pf pa pu nax)))
        (absurd (RepY _ _ _) (apart-irrefl a (perm-inj-apart d a x x f fi pf pa pu nax))))
      (let ((erased xs) (erased w)) (back-walk d ex v f fi pf pv lxe))
      (some-cat f2 a v u (some-step f2 a v pj) (walk-ex d x ex v u e n f s e2 n2 f2 xs cs w lv (NotInCons v ex _ nve (NotInCons v x s nvx ov)) pu nu)))
    ((JXL _ _ _ nu)
      (let-match erased (nth-fn _ q x qc r pqc qx) (Refl _ _))
      (match erased rp _ ((RepU _ _ _ _ _) (some-step f2 a u pj)) (absurd (RepV _ _ _ _) (apart-irrefl x nu)) (absurd (RepY _ _ _) (apart-irrefl x nu))))
    ((JE _ _ _ _ nu)
      (let-match erased (nth-fn _ q ex qc r pqc qex) (Refl _ _))
      (match erased rp _ ((RepU _ _ _ _ _) (some-step f2 a u pj)) (absurd (RepV _ _ _ _) (apart-irrefl x nu)) (absurd (RepY _ _ _) (apart-irrefl x nu))))
    ((JEL _ _ _)
      (let-match erased (nth-fn _ q ex qc r pqc qex) (Refl _ _))
      (match erased rp _
        (absurd (RepU _ _ _ _ nu) (apart-irrefl x nu))
        ((RepV _ _ _ _) (some-step f2 a v pj))
        (absurd (RepY _ _ _) (apart-irrefl a (perm-inj-apart d a ex ex f fi pf pa pv nae)))))))

(def-fns _ $ (erased iota-under : (erased (Nat) d) (erased (List (Nat)) ids) (subterm erased (Iota d ids) io) -> (erased (Under ids d) r))
  (let-match erased io (IotaS n ids1 _ io1 sn) ((IotaZ) (UnderNil (Zero))))
  (under-snoc-add ids1 ids n (Succ n) sn (under-le ids1 n (Succ n) (iota-under n ids1 io1) (lt-weaken n (Succ n) (lt-succ n))) (lt-succ n)))

(def-fns _ $ (erased qreach-go : (erased (Nat) d x ex r u v) (erased (List (Nat)) e n f s e2 n2 f2 q qf xs A B) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Rep x ex u v r) rp) (erased (QMap d x ex r q) qm) (erased (Respects q f qf) rqf)
    (erased (Length (Nat) f d) lf) (erased (Under f d) uf) (erased (Under xs d) ux) (subterm erased (Respects q xs A) ra) (erased (Respects qf xs B) rb)
    -> (erased (Reach f2 A B) res))
  (let-match erased ra (RespCons _ xs1 A1 a qa pqa ra1) ((RespNil _) (let-match erased rb (RespNil _)) (ReachNil f2)))
  (let-match erased rb (RespCons _ _ Bt _ qfa pqfa rb1))
  (let-match erased ux (UnderCons _ _ _ la ux1))
  (let ((erased c) (erased pc)) (nth-exists _ f d a lf la))
  (let ((erased qc) (erased pqc)) (nth-exists _ q d c (qmap-length d x ex r q qm) (under-nth f a c d uf pc)))
  (let-match erased (nth-fn _ qf a qfa qc pqfa (respects-at q f qf a c qc rqf pc pqc)) (Refl _ _))
  (ReachCons f2 A1 Bt qa qc (qreach-at d x ex r a c qa qc u v e n f s e2 n2 f2 q cs pu pv rp qm la pc pqa pqc)
    (qreach-go d x ex r u v e n f s e2 n2 f2 q qf xs1 A1 Bt cs pu pv rp qm rqf lf uf ux1 ra1 rb1)))

; Every face step a -> f a of the map, read through q, is a walk along the faces of the contraction.
(def-fns _ $ (erased cs-qreach : (erased (Nat) d x ex r u v) (erased (List (Nat)) e n f s e2 n2 f2 q) (erased (CStep d x ex e n f s e2 n2 f2) cs)
    (erased (Nth (Nat) f x u) pu) (erased (Nth (Nat) f ex v) pv) (erased (Rep x ex u v r) rp) (erased (QMap d x ex r q) qm)
    -> (erased (List (Nat)) qf) (erased (Respects q f qf) rqf) (erased (Reach f2 q qf) rc))
  (let ((erased u1) (erased v1) (erased pu1) (erased pv1) (erased lx) (erased lxe) (erased nex) (erased out) (erased oex) (erased nb) (erased fi) (erased pf))
    (cs-uv d x ex e n f s e2 n2 f2 cs))
  (let ((erased lf)) (perm-length d f fi pf))
  (let ((erased lq)) (qmap-length d x ex r q qm))
  (let ((erased qf) (erased rqf)) (respects-exists q f d (perm-under d f fi pf) lq))
  (let ((erased ids) (erased io)) (iota-exists d))
  (values qf rqf (qreach-go d x ex r u v e n f s e2 n2 f2 q qf ids q qf cs pu pv rp qm rqf lf (perm-under d f fi pf) (iota-under d ids io) (respects-id-right d ids q io lq)
    (respects-id-right d ids qf io (respects-length q f qf d rqf lf)))))

(def-fns _ $ (erased reach-nth : (erased (Nat) i a b) (erased (List (Nat)) f A B) (subterm erased (Reach f A B) rc) (erased (Nth (Nat) A i a) pa)
    (erased (Nth (Nat) B i b) pb) -> (erased (SomePath f (Nil (Nat)) a b) r))
  (let-match erased rc (ReachCons _ A1 Bs a0 b0 w rc1) (absurd (ReachNil _) pa))
  (let-match erased pa (NthThere _ _ _ j1 _ pa1) ((NthHere _ _ _) (let-match erased pb (NthHere _ _ _)) w))
  (let-match erased pb (NthThere _ _ _ _ _ pb1))
  (reach-nth j1 a b f A1 Bs rc1 pa1 pb1))

; A walk along f, read through q, is a walk along f2, when q sends each face step along f2.
(def-fns _ $ (erased path-map : (erased (Nat) d a b qa qb) (erased (List (Nat)) f f2 q qf t xs) (erased (Reach f2 q qf) rq) (erased (Respects q f qf) rqf)
    (erased (Length (Nat) q d) lq) (erased (Under f d) uf) (subterm erased (Path f t a b xs) w) (erased (Lt a d) la) (erased (Nth (Nat) q a qa) pqa)
    (erased (Nth (Nat) q b qb) pqb) -> (erased (SomePath f2 (Nil (Nat)) qa qb) r))
  (let-match erased w (PathStep _ _ xs1 _ a1 _ pa _ w1) ((PathHere _ _ _) (let-match erased (nth-fn _ q a qa qb pqa pqb) (Refl _ _)) (some-here f2 qa)))
  (let ((erased la1)) (under-nth f a a1 d uf pa))
  (let ((erased qa1) (erased pqa1)) (nth-exists _ q d a1 lq la1))
  (some-cat f2 qa qa1 qb (reach-nth a qa qa1 f2 q qf rq pqa (respects-at q f qf a a1 qa1 rqf pa pqa1))
    (path-map d a1 b qa1 qb f f2 q qf t xs1 rq rqf lq uf w1 la1 pqa1 pqb)))

; Pairs along faces of f stay so through q.
(def-fns _ $ (erased reach-map : (erased (Nat) d) (erased (List (Nat)) f f2 q qf X Y X2 Y2) (erased (Reach f2 q qf) rq) (erased (Respects q f qf) rqf)
    (erased (Length (Nat) q d) lq) (erased (Under f d) uf) (subterm erased (Reach f X Y) rc) (erased (Under X d) ux) (erased (Respects q X X2) rx)
    (erased (Respects q Y Y2) ry) -> (erased (Reach f2 X2 Y2) r))
  (let-match erased rc (ReachCons _ X1 Y1 a b w rc1) ((ReachNil _) (let-match erased rx (RespNil _)) (let-match erased ry (RespNil _)) (ReachNil f2)))
  (let-match erased rx (RespCons _ _ X3 _ qa pqa rx1))
  (let-match erased ry (RespCons _ _ Y3 _ qb pqb ry1))
  (let-match erased ux (UnderCons _ _ _ la ux1))
  (let-match erased w (MkSomePath _ _ xs _ _ w1))
  (ReachCons f2 X3 Y3 qa qb (path-map d a b qa qb f f2 q qf (Nil _) xs rq rqf lq uf w1 la pqa pqb) (reach-map d f f2 q qf X1 Y1 X3 Y3 rq rqf lq uf rc1 ux1 rx1 ry1)))

(def-fns _ $ (erased order1 : (erased (List (Nat)) p) (erased (Nat) y) (erased (Nth (Nat) p y y) py) -> (erased (Order p y (Succ (Zero))) r))
  (MkOrder p (Nil _) y y (Zero) py (PathHere p _ y) (LengthNil _)))

(def-fns _ $ (erased order2 : (erased (List (Nat)) p) (erased (Nat) y a) (erased (Nth (Nat) p y a) py) (erased (Nth (Nat) p a y) pa)
    (erased (Apart (Nat) Lt a y) ne) -> (erased (Order p y (Succ (Succ (Zero)))) r))
  (MkOrder p (Cons _ a (Nil _)) y a (Succ (Zero)) py (PathStep p _ (Nil _) a y y pa (NotInCons a y (Nil _) ne (NotInNil a)) (PathHere p _ y))
    (LengthCons _ a (Nil _) (Zero) (LengthNil _))))

; Cutting z out of p keeps an order below 4 below 4.
(def-fns _ $ (erased order-skip : (erased (Nat) d y z k) (erased (List (Nat)) p q p2) (erased (HPerm d p q) pm) (erased (Skip p z p2) sk)
    (erased (Order p y k) o) (erased (Lt k (Succ (Succ (Succ (Succ (Zero)))))) lk) -> (erased (Nat) k2) (erased (Order p2 y k2) r)
    (erased (Lt k2 (Succ (Succ (Succ (Succ (Zero)))))) lk2))
  (let ((erased o0)) o)
  (let-match erased o0 (MkOrder _ xs _ y1 k0 py w l))
  (let ((erased one) (erased two) (erased three)) (values (Succ (Zero)) (Succ (Succ (Zero))) (Succ (Succ (Succ (Zero))))))
  (let ((erased l1) (erased l2) (erased l3)) (values (LtS _ _ (LtZ two)) (LtS _ _ (LtS _ _ (LtZ one))) (LtS _ _ (LtS _ _ (LtS _ _ (LtZ (Zero)))))))
  (let-match erased (nat-eq y z) (Unequal _ _ _ _ nyz) ((Equal _ _ _) (values one (order1 p2 z (skip-fixed p p2 z sk)) l1)))
  (let-match erased k0 (Succ k1)
    ((Zero)
      (let-match erased l (LengthNil _))
      (let-match erased w (PathHere _ _ _))
      (values one (order1 p2 y (skip-keep z y y p p2 sk py nyz nyz)) l1)))
  (let-match erased k1 (Succ k2)
    ((Zero)
      (let ((erased py1) (erased n1)) (order-two p y y1 o py))
      (let-match erased (nat-eq y1 z) (Unequal _ _ _ _ n1z) ((Equal _ _ _) (values one (order1 p2 y (skip-cut-at d z y y p q p2 pm sk py py1 nyz)) l1)))
      (values two (order2 p2 y y1 (skip-keep z y y1 p p2 sk py nyz n1z) (skip-keep z y1 y p p2 sk py1 n1z nyz) n1) l2)))
  (let-match erased k2 (Zero) (absurd (Succ k3) (let-match erased lk (LtS _ _ lk1)) (let-match erased lk1 (LtS _ _ lk2)) (let-match erased lk2 (LtS _ _ lk3))
    (let-match erased lk3 (LtS _ _ lk4)) lk4))
  (let ((erased b) (erased py1) (erased pb) (erased n1) (erased nb)) (order-three p y y1 o py))
  (let-match erased (nat-eq b y1) (Unequal _ _ _ _ nb1)
    (absurd (Equal _ _ _) (let-match erased (perm-inj d y y1 y1 p q pm py py1) (Refl _ _)) (apart-irrefl y n1)))
  (let-match erased (nat-eq y1 z) (Unequal _ _ _ _ n1z)
    ((Equal _ _ _) (values two (order2 p2 y b (skip-cut-at d z y b p q p2 pm sk py py1 nyz) (skip-keep z b y p p2 sk pb nb1 nyz) nb) l2)))
  (let-match erased (nat-eq b z) (Unequal _ _ _ _ nbz)
    ((Equal _ _ _) (values two (order2 p2 y y1 (skip-keep z y y1 p p2 sk py nyz n1z) (skip-cut-at d z y1 y p q p2 pm sk py1 pb n1z) n1) l2)))
  (values three (mk-order3 p2 y y1 b (skip-keep z y y1 p p2 sk py nyz n1z) (skip-keep z y1 b p p2 sk py1 n1z nbz) (skip-keep z b y p p2 sk pb nbz nyz) n1 nb) l3))

(def-fns _ $ (erased orders-skip : (erased (Nat) d z) (erased (List (Nat)) p q p2 xs ks) (erased (HPerm d p q) pm) (erased (Skip p z p2) sk)
    (subterm erased (Orders p xs ks) os) (erased (Under ks (Succ (Succ (Succ (Succ (Zero)))))) u)
    -> (erased (List (Nat)) ks2) (erased (Orders p2 xs ks2) r) (erased (Under ks2 (Succ (Succ (Succ (Succ (Zero)))))) u2))
  (let-match erased os (OrdCons _ xs1 ks1 y k o os1) ((OrdNil _) (values (Nil _) (OrdNil p2) (UnderNil _))))
  (let-match erased u (UnderCons _ _ _ lk u1))
  (let ((erased k2) (erased o2) (erased lk2)) (order-skip d y z k p q p2 pm sk o lk))
  (let ((erased ks3) (erased os3) (erased u3)) (orders-skip d z p q p2 xs1 ks1 pm sk os1 u1))
  (values (Cons _ k2 ks3) (OrdCons p2 xs1 ks3 y k2 o2 os3) (UnderCons ks3 k2 _ lk2 u3)))

(def-fns _ $ (erased precubic-skip : (erased (Nat) d z) (erased (List (Nat)) p q p2) (erased (HPerm d p q) pm) (erased (Skip p z p2) sk) (erased (Precubic d p) pc)
    -> (erased (Precubic d p2) r))
  (let-match erased pc (MkPrecubic _ _ ks ol u))
  (let-match erased ol (MkOrderList _ _ ids _ io os))
  (let ((erased ks2) (erased os2) (erased u2)) (orders-skip d z p q p2 ids ks pm sk os u))
  (MkPrecubic d p2 ks2 (MkOrderList d p2 ids ks2 io os2) u2))

; Each bond x-y of g from a dart x off s has its ends told apart along f.
(def-adts $ (SepsOff : ((List (Nat)) f s) ((List (Bond)) g) -> Type)
  enum
  (many SONil : (erased (List (Nat)) f s) -> (SepsOff f s (Nil (Bond))))
  (many SODead : (erased (List (Nat)) f s) (erased (List (Bond)) g) (erased (Nat) x y) (erased (In x s) ix) (erased (SepsOff f s g) rest)
      -> (SepsOff f s (Cons (Bond) (MkBond x y) g)))
  (many SOLive : (erased (List (Nat)) f s) (erased (List (Bond)) g) (erased (Nat) x y) (erased (Seps f x y) sp) (erased (SepsOff f s g) rest)
      -> (SepsOff f s (Cons (Bond) (MkBond x y) g))))

; Bridgeless off the dead darts s.
(def-adts $ (LBridgeless : ((Nat) d) ((List (Nat)) e f s) -> Type)
  enum
  (many MkLB : (erased (Nat) d) (erased (List (Nat)) e f s) (erased (List (Bond)) ge) (erased (Graph d e ge) gr) (erased (SepsOff f s ge) so)
      -> (LBridgeless d e f s)))

; A live dart x on the face of its edge image.
(def-adts $ (LBridge : ((Nat) d) ((List (Nat)) e f s) -> Type)
  enum
  (many MkLBr : (erased (Nat) d x y) (erased (List (Nat)) e f s) (erased (Lt x d) lx) (erased (NotIn x s) out) (erased (Nth (Nat) e x y) pxy)
      (erased (SomePath f (Nil (Nat)) x y) w) -> (LBridge d e f s)))

(def-fns _ $ (erased lb-go : (erased (Nat) d k) (erased (List (Nat)) e ei f fi s xs ys) (erased (List (Bond)) g) (erased (HPerm d e ei) pe) (erased (HPerm d f fi) pf)
    (erased (Orbits d f k) of) (subterm erased (Zip xs ys g) z) (erased (Respects e xs ys) rp) (erased (Under xs d) ux)
    -> (erased (HOr (SepsOff f s g) (LBridge d e f s)) r))
  (let-match erased z (ZipCons xs1 ys1 g1 x y z1) ((ZipNil) (OrL _ _ (SONil f s))))
  (let-match erased rp (RespCons _ _ _ _ _ pxy rp1))
  (let-match erased ux (UnderCons _ _ _ lx ux1))
  (let-match erased (lb-go d k e ei f fi s xs1 ys1 g1 pe pf of z1 rp1 ux1) (OrL _ _ so) ((OrR _ _ br) (OrR _ _ br)))
  (let-match erased (in-dec x s) (OrR _ _ out) ((OrL _ _ ix) (OrL _ _ (SODead f s g1 x y ix so))))
  (let-match erased (orbits-dec d k x y f fi pf of lx (perm-val d x y e ei pe pxy)) (OrR _ _ sp) ((OrL _ _ w) (OrR _ _ (MkLBr d x y e f s lx out pxy w))))
  (OrL _ _ (SOLive f s g1 x y sp so)))

; A map is bridgeless off s, or has a live bridge.
(def-fns _ $ (erased lb-dec : (erased (Nat) d) (erased (List (Nat)) e n f s) (erased (Hypermap d e n f) h) -> (erased (HOr (LBridgeless d e f s) (LBridge d e f s)) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased ge) (erased gr)) (perm-graph d e nf pe))
  (let ((erased k) (erased of)) (orbits-exists d f fi pf))
  (let ((erased gr2)) gr)
  (let-match erased gr2 (MkGraph _ _ ids _ io le z))
  (let-match erased (lb-go d k e nf f fi s ids e ge pe pf of z (respects-id-right d ids e io le) (iota-under d ids io)) (OrL _ _ so) ((OrR _ _ br) (OrR _ _ br)))
  (OrL _ _ (MkLB d e f s ge gr so)))

(def-fns _ $ (erased seps-sym : (erased (Nat) a b) (erased (List (Nat)) f) (erased (Seps f a b) sp) -> (erased (Seps f b a) r))
  (let-match erased sp (MkSeps _ lab _ _ se))
  (let-match erased se (MkSeparates _ _ _ _ l1 l2 rf p1 p2 ne))
  (MkSeps f lab b a (MkSeparates lab f b a l2 l1 rf p2 p1 (apart-sym l1 l2 ne))))

(def-fns _ $ (erased so-adj : (erased (Nat) x y) (erased (List (Nat)) f s) (erased (List (Bond)) g) (subterm erased (SepsOff f s g) so) (erased (Adj g x y) a)
    (erased (NotIn x s) ox) (erased (NotIn y s) oy) -> (erased (Seps f x y) r))
  (match erased so _
    (absurd (SONil _ _) a)
    ((SODead _ _ g1 x0 y0 ix so1)
      (match erased a _
        (absurd (AdjFwd _ _ _) (apart-irrefl x (notin-in x x s ox ix)))
        (absurd (AdjBwd _ _ _) (apart-irrefl y (notin-in y y s oy ix)))
        ((AdjThere _ _ _ _ a1) (so-adj x y f s g1 so1 a1 ox oy))))
    ((SOLive _ _ g1 x0 y0 sp so1)
      (match erased a _
        ((AdjFwd _ _ _) sp)
        ((AdjBwd _ _ _) (seps-sym y x f sp))
        ((AdjThere _ _ _ _ a1) (so-adj x y f s g1 so1 a1 ox oy))))))

(def-fns _ $ (erased lb-at : (erased (Nat) d x y) (erased (List (Nat)) e ei f s) (erased (LBridgeless d e f s) lb) (erased (HPerm d e ei) pe) (erased (FixedIn e s) fx)
    (erased (Nth (Nat) e x y) pxy) (erased (NotIn x s) ox) -> (erased (Seps f x y) r))
  (let-match erased lb (MkLB _ _ _ _ ge gr so))
  (so-adj x y f s ge so (graph-adj d x y e ge gr pxy) ox (fixed-out d x y e ei s pe fx pxy ox)))
