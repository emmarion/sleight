  (let ((erased L1) (erased m1)) (merge-exists lab1 a b))
  (let-match erased (nat-eq l a) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values (Cons _ b L1) (MLHit lab1 L1 a b m1))))
  (values (Cons _ l L1) (MLMiss lab1 L1 l a b ne m1)))

