  (let-match erased (nat-eq b y1) (Unequal _ _ _ _ nb1)
    (absurd (Equal _ _ _) (let-match erased (perm-inj d y y1 y1 p q pm py py1) (Refl _ _)) (apart-irrefl y n1)))
  (let-match erased (nat-eq y1 z) (Unequal _ _ _ _ n1z)
    ((Equal _ _ _) (values two (order2 p2 y b (skip-cut-at d z y b p q p2 pm sk py py1 nyz) (skip-keep z b y p p2 sk pb nb1 nyz) nb) l2)))
