    -> (erased (Nat) i) (erased (Nth (Nat) hd i a) pi) (erased (Nth (Nat) pos a i) qa) (erased (Lt i dl) li))
  (let ((erased i) (erased pi) (erased li)) (lp-in d dl a e n f s el nl fl hd lp la oa))
