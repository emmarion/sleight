; The Birkhoff theorem of birkhoff.v: Birkhoff_valid, from the certified check of red/bcheck.sl, and its use for rings of
; at most five faces. Load after cpgeom.sl and ringdec.sl, in the order of PLAN.md.

; A trace from c0, read up to its last entry, is a ctrace from c0 + c.
(def-fns _ $ (erased tracefrom-ctr : (erased (Col) c0 c s) (erased (List (Col)) lc et) (subterm erased (TraceFrom c0 c lc et) t) (erased (AddK c0 c s) a)
    -> (erased (List (Col)) et1) (erased (Ctr s et1 et) r))
  (match erased t _
    ((TFEnd _ _ s1 a1) (let-match erased (addc-fn c0 c s s1 a (addc-comm c c0 s1 a1)) (Refl _ _)) (values (Nil _) (CtrNil s)))
    ((TFCons _ _ c2 s1 lc1 et2 a1 t1)
      (let ((erased s2) (erased a2)) (addc-total c0 c2))
      (let ((erased et3) (erased r)) (tracefrom-ctr c0 c2 s2 lc1 et2 t1 a2))
      (values (Cons _ s1 et3) (CtrCons s s1 s2 et3 et2 (addc-tri c0 c c2 s s1 s2 a a1 a2) r)))))

(def-fns _ $ (erased ctr-length : (erased (Col) s) (erased (List (Col)) et1 et) (erased (Nat) k) (subterm erased (Ctr s et1 et) c)
    (erased (Length (Col) et (Succ k)) l) -> (erased (Length (Col) et1 k) r))
  (match erased c _
    ((CtrNil _) (let-match erased l (LengthCons _ _ _ _ l1)) (let-match erased l1 (LengthNil _)) (LengthNil _))
    ((CtrCons _ x s2 et2 ct a c1)
      (let-match erased l (LengthCons _ _ _ _ l1))
      (let-match erased l1 (LengthCons _ _ _ k1 _) (absurd (LengthNil _) (match erased c1 _)))
      (LengthCons _ x et2 k1 (ctr-length s2 et2 ct k1 c1 l1)))))

(def-fns _ $ (erased tracefrom-length : (erased (Col) c0 c) (erased (List (Col)) lc et) (erased (Nat) k) (subterm erased (TraceFrom c0 c lc et) t)
    (erased (Length (Col) lc k) l) -> (erased (Length (Col) et (Succ k)) r))
  (match erased t _
    ((TFEnd _ _ s _) (let-match erased l (LengthNil _)) (LengthCons _ s _ _ (LengthNil _)))
    ((TFCons _ _ c2 s lc1 et1 _ t1)
      (let-match erased l (LengthCons _ _ _ k1 l1))
      (LengthCons _ s et1 k (tracefrom-length c0 c2 lc1 et1 k1 t1 l1)))))

; The ring trace of a ring of k + 1 darts is the ctrace of k colours.
(def-fns _ $ (erased rt-ctr : (erased (List (Nat)) e f r) (erased (List (Col)) et) (erased (Nat) k) (erased (RingTrace e f r et) rt)
    (erased (Length (Nat) r (Succ k)) lr) -> (erased (List (Col)) et1) (erased (Ctr (C0) et1 et) c) (erased (Length (Col) et1 k) l))
  (let-match erased rt (MkRingTrace _ _ _ ks lc cs _ col rl co t))
  (let ((erased lcs)) (all2-length (Nat) (Col) ColOf lc cs (Succ k) co (respects-length ks r lc (Succ k) rl lr)))
  (let-match erased lcs (LengthCons _ c cs1 _ lcs1))
  (let-match erased t (TrCons _ _ _ tf))
  (let ((erased et1) (erased cr)) (tracefrom-ctr c c (C0) cs1 et tf (ASame c)))
  (values et1 cr (ctr-length (C0) et1 et k cr (tracefrom-length c c cs1 et k tf lcs1))))

(def-fns _ $ (erased notin-revapp : (erased (Nat) a) (erased (List (Nat)) p w q) (subterm erased (RevApp (Nat) p w q) ra) (erased (NotIn a p) o)
    (erased (NotIn a w) ow) -> (erased (NotIn a q) r))
  (let-match erased ra (RACons _ s p1 _ _ ra1) ((RANil _ _) ow))
  (let-match erased o (NotInCons _ _ _ ne o1))
  (notin-revapp a p1 (Cons _ s w) q ra1 o1 (NotInCons a s w ne ow)))

(def-fns _ $ (erased rpath-br : (erased (List (Nat)) n p) (erased (Nat) a y) (erased (CRPath n a p y) rp) (erased (Nth (Nat) n a y) back)
    -> (erased (List (Nat)) q) (erased (RevApp (Nat) p (Nil (Nat)) q) ra) (erased (NCyc n (Cons (Nat) a q)) nc))
  (let-match erased rp (CRPCons _ p1 _ z1 _ pz rp1) ((CRPNil _ _) (values (Nil _) (RANil _ (Nil _)) (NCCons n (Nil _) a a (FPNil n a) back))))
  (let ((erased B) (erased fp) (erased ra1)) (rpath-fpath n p1 (Nil _) z1 y z1 rp1 (FPNil n z1)))
  (values (Cons _ y B) ra1 (NCCons n (Cons _ y B) a z1 (FPCons n B a y z1 back fp) pz)))

; The ring a :: p of a configuration map, read as the node cycle a :: rev p (Coq's rotr 1 (rev (cpring G))).
(def-fns _ $ (erased cpring-br : (erased (List (Nat)) n r) (erased (Cpring n r) cr)
    -> (erased (Nat) a) (erased (List (Nat)) p q) (erased (Eq (List (Nat)) r (Cons (Nat) a p)) eq) (erased (RevApp (Nat) p (Nil (Nat)) q) ra)
    (erased (NCyc n (Cons (Nat) a q)) nc) (erased (Distinct (Cons (Nat) a q)) dq))
  (let-match erased cr (MkCpring _ p a y rp back dp))
  (let-match erased dp (DistCons _ _ o dp1))
  (let ((erased q) (erased ra) (erased nc)) (rpath-br n p a y rp back))
  (values a p q (Refl _ r) ra nc
    (DistCons a q (notin-revapp a p (Nil _) q ra o (NotInNil a)) (revapp-distinct p (Nil _) q ra dp1 (DistNil) (off-nil p)))))

; Node order 3 off the ring a :: p, read off the node cycle a :: rev p.
(def-fns _ $ (erased cubics-turn : (erased (List (Nat)) n p q xs) (erased (Nat) a) (subterm erased (Cubics n (Cons (Nat) a p) xs) cs)
    (erased (RevApp (Nat) p (Nil (Nat)) q) ra) -> (erased (OrdersOff n 3 (Cons (Nat) a q) xs) res))
  (unary 3)
  (let-match erased cs (CubsCons _ _ xs1 x c cs1) ((CubsNil _ _) (OONil n _ 3)))
  (let ((erased rest)) (cubics-turn n p q xs1 a cs1 ra))
  (match erased c _
    ((CubOn _ _ _ i)
      (OOSkip n _ xs1 3 x (match erased i (((In x (Cons (Nat) a q)) res))
        ((InHere _ _) (InHere a q))
        ((InThere _ _ _ i1) (InThere x a q (revapp-in p (Nil _) q x ra (OrL _ _ i1))))) rest))
    ((CubThree _ _ _ o) (OOAt n _ xs1 3 x o rest))))

(def-fns _ $ (erased rotrev-sym : (erased (List (Col)) a b) (erased (RotRev a b) rr) -> (erased (RotRev b a) r))
  (let-match erased rr (RRCons _ E1 _ c ra sn) ((RRNil) (RRNil)))
  (let ((erased R1) (erased r1)) (revapp-exists (Col) E1 (Nil _)))
  (let ((erased rb)) (revapp-snoc-l (Col) c E1 b (Nil _) R1 sn r1))
  (let ((erased ra2)) (revapp-flip (Col) a (Nil _) (Cons _ c E1) a ra (RANil _ a)))
  (let-match erased ra2 (RACons _ _ _ _ _ ra3))
  (let ((erased A2) (erased ra4)) (revapp-exists (Col) E1 (Cons _ c (Nil _))))
  (let-match erased (revapp-fn (Col) E1 (Cons _ c (Nil _)) a A2 ra3 ra4) (Refl _ _))
  (RRCons b R1 a c rb (revapp-snoc (Col) c E1 (Nil _) (Cons _ c (Nil _)) R1 a r1 (SnocNil _ c) ra4)))

; From a ring trace et2 = rot 1 (rev et) of a :: rev p to the ring trace rotr 1 et of a :: p.
(def-fns _ $ (erased rt-revtail : (erased (List (Nat)) e f p q) (erased (Nat) a) (erased (List (Col)) et et2) (erased (RevApp (Nat) p (Nil (Nat)) q) ra)
    (erased (RingTrace e f (Cons (Nat) a q) et2) rt) (erased (RotRev et et2) rr)
    -> (erased (Col) s) (erased (List (Col)) E) (erased (HSnoc (Col) E s et) se) (erased (RingTrace e f (Cons (Nat) a p) (Cons (Col) s E)) r))
  (let-match erased rt (MkRingTrace _ _ _ ks lc cs _ col rl co t))
  (let-match erased rl (RespCons _ _ lq _ la pa rlq))
  (let-match erased co (All2Cons _ _ _ _ ca _ csq pca coq))
  (let ((erased lp) (erased rlp) (erased rpl))
    (respects-revapp ks q (Nil _) p lq (Nil _) rlq (RespNil ks) (revapp-flip (Nat) p (Nil _) q p ra (RANil _ p))))
  (let ((erased csp) (erased rcs) (erased cop)) (all2-revapp (Nat) (Col) ColOf lq (Nil _) lp csq (Nil _) coq (All2Nil _ _ ColOf) rlp))
  (let ((erased lc2) (erased r2)) (revapp-exists (Col) csq (Cons _ ca (Nil _))))
  (let ((erased sn)) (revapp-snoc (Col) ca csq (Nil _) (Cons _ ca (Nil _)) csp lc2 rcs (SnocNil _ ca) r2))
  (let ((erased t2)) (trace-rev (Cons _ ca csq) lc2 et2 et t (RACons _ ca csq (Nil _) lc2 r2) (rotrev-sym et et2 rr)))
  (let ((erased et4) (erased t4)) (trace-exists (Cons _ ca csp)))
  (let ((erased s) (erased E) (erased et5) (erased eq) (erased se) (erased t5)) (trace-rot ca csp lc2 et4 t4 sn))
  (let-match erased (trace-fn lc2 et5 et t5 t2) (Refl _ _))
  (let-match erased eq (Refl _ _))
  (values s E se (MkRingTrace e f _ ks (Cons _ la lp) (Cons _ ca csp) et4 col (RespCons ks p lp a la pa rpl) (All2Cons _ _ ColOf la ca lp csp pca cop) t4)))

(def-fns _ $ (erased ncols-of : (erased (List (Nat)) lc) (erased (List (Col)) cs) (subterm erased (All2 (Nat) (Col) ColOf lc cs) co) -> (erased (NCols lc cs) r))
  (let-match erased co (All2Cons _ _ _ k c lc1 cs1 p co1) ((All2Nil _ _ _) (NCsNil)))
  (NCsCons k c lc1 cs1 (match erased p (((NCol k c) res)) ((CO0) (NC0)) ((CO1) (NC1)) ((CO2) (NC2)) ((CO3) (NC3))) (ncols-of lc1 cs1 co1)))

(def-fns _ $ (erased k-addc : (erased (Col) a b c) (erased (AddK a b c) p) -> (erased (AddC a b c) q))
  (let ((erased c2) (erased q)) (addc-c a b))
  (let-match erased (addc-fn a b c c2 p (addc-k a b c2 q)) (Refl _ _))
  q)

(def-fns _ $ (erased ctr-of-tf : (erased (Col) c0 c) (erased (List (Col)) lc et) (subterm erased (TraceFrom c0 c lc et) t) -> (erased (CTr c0 c lc et) r))
  (match erased t _
    ((TFEnd _ _ s a) (CTLast c0 c s (k-addc c c0 s a)))
    ((TFCons _ _ c2 s lc1 et1 a t1) (CTStep c0 c c2 s lc1 et1 (k-addc c c2 s a) (ctr-of-tf c0 c2 lc1 et1 t1)))))

; A ring trace of the map of cp, on its own ring, is a CpCol of cp.
(def-fns _ $ (erased cpcol-of : (erased (List (Step)) cp) (erased (Nat) d a) (erased (List (Nat)) e f p) (erased (List (Col)) et)
    (erased (Cpmap cp d e f (Cons (Nat) a p)) cm) (erased (RingTrace e f (Cons (Nat) a p) et) rt) -> (erased (CpCol cp et) r))
  (let-match erased rt (MkRingTrace _ _ _ ks lc cs _ col rl co t))
  (let-match erased rl (RespCons _ _ lp _ la pa rlp))
  (let-match erased co (All2Cons _ _ _ _ c _ cs1 pc co1))
  (let-match erased t (TrCons _ _ _ tf))
  (MkCpCol cp d e f _ ks lc cs et cm col rl (ncols-of lc cs co) (MkTrace c cs1 et (ctr-of-tf c c cs1 et tf))))

(def-fns _ $ (erased band-in : (erased (List (Nat)) f t xs o i) (erased (Nat) x) (subterm erased (BandSplit f t xs o i) bs) (erased (In x xs) ix)
    (erased (Fband f t x) fb) -> (erased (In x o) r))
  (match erased bs _
    (absurd (BSNil _ _) ix)
    ((BSIn _ _ xs1 o1 i1 y p rest)
      (match erased ix _ ((InHere _ _) (InHere x o1)) ((InThere _ _ _ ix1) (InThere x y o1 (band-in f t xs1 o1 i1 x rest ix1 fb)))))
    ((BSOut _ _ xs1 o1 i1 y k rest)
      (match erased ix _ (absurd (InHere _ _) (fband-kernel f t x fb k)) ((InThere _ _ _ ix1) (band-in f t xs1 o1 i1 x rest ix1 fb))))))

(def-fns _ $ (erased sub-band : (erased (Nat) d) (erased (List (Nat)) f t ids o i m) (subterm erased (Sub m t) sb) (erased (Under t d) ut) (erased (Iota d ids) io)
    (erased (BandSplit f t ids o i) bs) -> (erased (Sub m o) r))
  (let-match erased sb (HSubCons x m1 _ ix sb1) ((HSubNil _) (HSubNil o)))
  (HSubCons x m1 o (band-in f t ids o i x bs (iota-in d x ids io (under-in t x d ut ix)) (MkFband f t x x ix (MkSomePath f (Nil _) (Nil _) x x (PathHere f (Nil _) x))))
    (sub-band d f t ids o i m1 sb1 ut io bs)))

(def-fns _ $ (erased sub-revapp : (erased (List (Nat)) pre w r m) (erased (RevApp (Nat) pre w r) ra) (subterm erased (Sub m pre) sb) -> (erased (Sub m r) res))
  (let-match erased sb (HSubCons x m1 _ ix sb1) ((HSubNil _) (HSubNil r)))
  (HSubCons x m1 r (revapp-in pre w r x ra (OrL _ _ ix)) (sub-revapp pre w r m1 ra sb1)))

; The darts ys, on distinct faces off r, then r, on distinct faces, are told apart by g.
(def-fns _ $ (erased ps-scatter : (erased (List (Bond)) g) (erased (List (Nat)) lab ys lx r lr) (erased (Const lab g) cl) (subterm erased (Respects lab ys lx) rx)
    (erased (Distinct lx) dx) (erased (Disj lx lr) dj) (erased (Respects lab r lr) rr) (erased (PairSep g r) pr)
    -> (erased (List (Nat)) L) (erased (AppN ys r L) ap) (erased (PairSep g L) ps))
  (let-match erased rx (RespCons _ ys1 lx1 y ly py rx1) ((RespNil _) (values r (AppNil r) pr)))
  (let-match erased dx (DistCons _ _ o dx1))
  (let-match erased dj (DisjCons _ _ _ out dj1))
  (let ((erased L1) (erased ap1) (erased ps1)) (ps-scatter g lab ys1 lx1 r lr cl rx1 dx1 dj1 rr pr))
  (values (Cons _ y L1) (AppCons ys1 r L1 y ap1)
    (PrCons g y L1 (sepall-app g y ys1 r L1 ap1 (label-sepall g lab ys1 lx1 y ly cl py o rx1) (label-sepall g lab r lr y ly cl py out rr)) ps1)))

; The faces that meet hr number at least k + m + 1: those of the k darts of the ring r and of m + 1 darts ys off its faces.
(def-fns _ $ (erased outer-count : (erased (Nat) d k m kf x0) (erased (List (Nat)) e f p ys zs RV hr ids outer inner) (erased (List (Bond)) gf)
    (erased (Graph d f gf) grf) (erased (Length (Nat) f d) lf) (erased (Ring e f x0 p) rg) (erased (Length (Nat) (Cons (Nat) x0 p) k) lk)
    (erased (Scattered f (Cons (Nat) x0 p) ys) sc) (erased (Length (Nat) ys (Succ m)) ly) (erased (Sub ys zs) sy)
    (erased (RevApp (Nat) (Cons (Nat) x0 p) (Nil (Nat)) RV) rv) (erased (AppN RV zs hr) ap) (erased (Under hr d) uh) (erased (Iota d ids) io)
    (erased (BandSplit f hr ids outer inner) bs) (erased (ClassesOn gf outer kf) co)
    -> (erased (Nat) K) (erased (Add (Succ m) k K) a) (erased (Lt K (Succ kf)) r))
  (let ((erased r0)) (Cons (Nat) x0 p))
  (let-match erased rg (MkRing _ _ _ _ _ _ _ _ _ sm))
  (let-match erased sm (MkSimple _ _ lab2 ls2 rf2 rp2 dl2))
  (let-match erased sc (MkScattered _ _ _ lab lr lx rf rr rx dx dj))
  (let ((erased fn)) (graph-fun d f gf grf))
  (let ((erased cl)) (resp-const d lab f gf fn rf (respects-length lab f lab d rf lf)))
  (let ((erased cl2)) (resp-const d lab2 f gf fn rf2 (respects-length lab2 f lab2 d rf2 lf)))
  (let ((erased L) (erased apL) (erased ps)) (ps-scatter gf lab ys lx r0 lr cl rx dx dj rr (labels-pairsep gf lab2 r0 ls2 cl2 rp2 dl2)))
  (let ((erased so)) (sub-band d f hr ids outer inner hr (sub-refl hr) uh io bs))
  (let ((erased sz)) (app-sub-r RV zs hr zs ap (sub-refl zs)))
  (let ((erased sr)) (app-sub-l RV zs hr r0 ap (sub-revapp r0 (Nil _) RV r0 rv (sub-refl r0))))
  (let ((erased sl)) (app-sub ys r0 L outer apL (sub-trans ys hr outer (sub-trans ys zs hr sy sz) so) (sub-trans r0 hr outer sr so)))
  (let ((erased K) (erased a)) (add (Succ m) k))
  (let ((erased lL)) (app-length ys r0 L (Succ m) k K apL ly lk a))
  (let-match erased co (MkClassesOn _ _ rs _ lrs srs prs cvs))
  (let ((erased ims) (erased si) (erased jn)) (covers-image gf rs outer L cvs sl))
  (values K a (pigeonhole ims rs K kf (joined-distinct gf L ims ps jn) si (joined-length gf L ims K jn lL) lrs)))

(def-fns _ $ (erased mul-mono : (erased (Nat) a b c x y) (erased (Lt a (Succ b)) l) (subterm erased (Mul a c x) mx) (erased (Mul b c y) my)
    -> (erased (Lt x (Succ y)) r))
  (let-match erased mx (MulSucc a1 _ x1 _ mx1 px) ((MulZero _) (LtZ y)))
  (let-match erased l (LtS _ _ l1))
  (let-match erased my (MulSucc b1 _ y1 _ my1 py) (absurd (MulZero _) (match erased l1 _)))
  (add-mono-le c x1 y1 x y (mul-mono a1 b1 c x1 y1 l1 mx1 my1) (add-comm x1 c x px) (add-comm y1 c y py)))

(def-fns _ $ (erased add-cancel-le : (erased (Nat) a b c x y) (erased (Add a b x) p) (erased (Add a c y) q) (erased (Lt x (Succ y)) l)
    -> (erased (Lt b (Succ c)) r))
  (match erased (lt-dec c b) _
    ((No _ _ _ _ le) (le-lt-succ b c le))
    (absurd (Yes _ _ _ _ cb) (lt-asym y x (add-mono-lt c b a y x cb (add-comm a c y q) (add-comm a b x p)) l))))

(let ((many bk-l)) (EMul (EAdd (EAdd (EVar (Succ (Zero))) (ENum 1)) (EAdd (EVar (Zero)) (ENum 2))) (ENum 6)))
(let ((many bk-r)) (EAdd (EAdd (EMul (EAdd (EVar (Zero)) (ENum 2)) (ENum 2)) (ENum 6))
  (EAdd (EAdd (EMul (ENum 6) (EVar (Succ (Zero)))) (EMul (ENum 4) (EAdd (EVar (Zero)) (ENum 1)))) (ENum 4))))
(comptime-match many (ring-check bk-l bk-r) (Some _ bk-eq))
(let ((many bk-fl)) (EAdd (EMul (EAdd (EVar (Zero)) (ENum 2)) (ENum 2)) (EAdd (EVar (Succ (Succ (Zero)))) (ENum 6))))
(let ((many bk-fr)) (EAdd (EAdd (EMul (EAdd (EVar (Zero)) (ENum 2)) (ENum 2)) (ENum 6)) (EVar (Succ (Succ (Zero))))))
(comptime-match many (ring-check bk-fl bk-fr) (Some _ bk-eq2))

; The size bound of Birkhoff_valid: with k + m + 1 faces meeting the remainder of a ring of h + 2 darts, which has dr darts,
; quasicubic_Euler leaves dr above the size bound of a basis program, whose map has kc darts.
(def-fns _ $ (erased birkhoff-size : (erased (Nat) h m kc dr kf K f6 m2 u x y b0) (erased (Add (Succ m) (Succ (Succ h)) K) aK)
    (erased (Lt K (Succ kf)) lK) (erased (Mul kf 6 f6) mf) (erased (Mul (Succ (Succ h)) 2 m2) mm) (erased (Add dr 6 u) du) (erased (Add m2 u f6) af)
    (erased (Mul 6 m x) mx) (erased (Mul 4 (Succ h) y) my) (erased (Add x y b0) xy) (erased (Lt (Succ kc) b0) lt) -> (erased (Lt kc dr) r))
  (unary 1)
  (unary 2)
  (let ((erased env)) (Cons (Nat) h $ Cons (Nat) m $ Cons (Nat) dr $ Nil (Nat)))
  (let ((erased v0)) (EvVar env (Zero) h (NthHere _ h _)))
  (let ((erased v1)) (EvVar env (Succ (Zero)) m (NthThere _ h _ _ m $ NthHere _ m _)))
  (let ((erased v2)) (EvVar env (Succ (Succ (Zero))) dr (NthThere _ h _ _ dr $ NthThere _ m _ _ dr $ NthHere _ dr _)))
  (let ((erased ek)) (EvAdd env _ _ h 2 (Succ (Succ h)) v0 (EvNum env 2)
    (add-succ-right h (Succ (Zero)) (Succ h) (add-succ-right h (Zero) h (add-zero-right h)))))
  (let ((erased em1)) (EvAdd env _ _ m 1 (Succ m) v1 (EvNum env 1) (add-succ-right m (Zero) m (add-zero-right m))))
  (let ((erased eh1)) (EvAdd env _ _ h 1 (Succ h) v0 (EvNum env 1) (add-succ-right h (Zero) h (add-zero-right h))))
  (let ((erased F) (erased mF)) (mul K 6))
  (let ((erased eF)) (EvMul env _ _ K 6 F (EvAdd env _ _ (Succ m) (Succ (Succ h)) K em1 ek aK) (EvNum env 6) mF))
  (let ((erased em2)) (EvMul env _ _ (Succ (Succ h)) 2 m2 ek (EvNum env 2) mm))
  (let ((erased z1) (erased az1)) (add m2 6))
  (let ((erased ez1)) (EvAdd env _ _ m2 6 z1 em2 (EvNum env 6) az1))
  (let ((erased W) (erased aW)) (add b0 4))
  (let ((erased eW)) (EvAdd env _ _ b0 4 W (EvAdd env _ _ x y b0 (EvMul env _ _ 6 m x (EvNum env 6) v1 mx) (EvMul env _ _ 4 (Succ h) y (EvNum env 4) eh1 my) xy)
    (EvNum env 4) aW))
  (let ((erased R) (erased aR)) (add z1 W))
  (let-match erased (ring-sound env bk-l bk-r F R bk-eq eF (EvAdd env _ _ z1 W R ez1 eW aR)) (Refl _ _))
  (let ((erased f7) (erased a7)) (add z1 dr))
  (let-match erased (ring-sound env bk-fl bk-fr f6 f7 bk-eq2 (EvAdd env _ _ m2 u f6 em2 (EvAdd env _ _ dr 6 u v2 (EvNum env 6) du) af)
    (EvAdd env _ _ z1 dr f7 ez1 v2 a7)) (Refl _ _))
  (let ((erased wd)) (add-cancel-le z1 W dr F f6 aR a7 (mul-mono K kf 6 F f6 lK mF mf)))
  (lt-le-trans kc W dr (lt-le-trans kc b0 W (lt-succ-left kc b0 lt) (add-le-left b0 4 W aW)) wd))

(def-fns _ $ (erased fpath-under : (erased (List (Nat)) n q) (erased (Nat) x y d) (subterm erased (FPath n x q y) fp) (erased (Under n d) un)
    -> (erased (Under q d) r))
  (let-match erased fp (FPCons _ q1 _ z _ pz fp1) ((FPNil _ _) (UnderNil d)))
  (UnderCons q1 z d (under-nth n x z d un pz) (fpath-under n q1 z y d fp1 un)))

(def-fns _ $ (erased ncyc-under : (erased (List (Nat)) n r) (erased (Nat) d) (erased (NCyc n r) nc) (erased (Under n d) un) -> (erased (Under r d) u))
  (let-match erased nc (NCCons _ q x y fp back) ((NCNil _) (UnderNil d)))
  (UnderCons q x d (under-nth n y x d un back) (fpath-under n q x y d fp un)))

; The map of a cubic program has cpcard darts (card_cpmap).
(def-fns _ $ (erased cpcard-of : (erased (List (Step)) cp) (erased (Nat) d k) (erased (List (Nat)) e f r) (subterm erased (Cpmap cp d e f r) c)
    (erased (Cpcard cp k) cc) -> (erased (Eq (Nat) d k) q))
  (match erased c _
    ((CmNil) (let-match erased cc (CcNil)) (Refl _ d))
    ((CmR _ _ cp1 _ _ r1 _ c1 _) (let-match erased cc (CcR _ _ _ cc1)) (cpcard-of cp1 d k e f r1 c1 cc1))
    (absurd (CmRr _ _ _ _ _ _ _ _ _ _) cc)
    (absurd (CmK _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) cc)
    ((CmU d0 cp1 e0 f0 r0 _ _ _ c1 _)
      (let-match erased cc (CcU k0 _ cc1))
      (let-match erased (cpcard-of cp1 d0 k0 e0 f0 r0 c1 cc1) (Refl _ _))
      (Refl _ d))
    ((CmY d0 cp1 e0 f0 r0 _ _ _ _ _ _ c1 _ _)
      (let-match erased cc (CcY k0 _ cc1))
      (let-match erased (cpcard-of cp1 d0 k0 e0 f0 r0 c1 cc1) (Refl _ _))
      (Refl _ d))
    ((CmH d0 cp1 e0 f0 r0 _ _ _ _ _ _ _ _ _ c1 _ _ _)
      (let-match erased cc (CcH k0 _ cc1))
      (let-match erased (cpcard-of cp1 d0 k0 e0 f0 r0 c1 cc1) (Refl _ _))
      (Refl _ d))))

(def-fns _ $ (erased cprsize-fn : (erased (List (Step)) cp) (erased (Nat) k k2) (subterm erased (CubicProg cp) cq) (erased (Cprsize cp k) c1)
    (erased (Cprsize cp k2) c2) -> (erased (Eq (Nat) k k2) q))
  (match erased cq _
    ((CubNil) (let-match erased c1 (CsNil)) (let-match erased c2 (CsNil)) (Refl _ k))
    ((CubR j cp1 cq1) (let-match erased c1 (CsR _ _ _ d1)) (let-match erased c2 (CsR _ _ _ d2)) (cprsize-fn cp1 k k2 cq1 d1 d2))
    ((CubH cp1 cq1) (let-match erased c1 (CsH _ _ d1)) (let-match erased c2 (CsH _ _ d2)) (cprsize-fn cp1 k k2 cq1 d1 d2))
    ((CubY cp1 cq1)
      (let-match erased c1 (CsY j1 _ d1))
      (let-match erased c2 (CsY j2 _ d2))
      (let-match erased (cprsize-fn cp1 j1 j2 cq1 d1 d2) (Refl _ _))
      (Refl _ k))
    ((CubU cp1 cq1)
      (let-match erased c1 (CsU j1 _ d1))
      (let-match erased c2 (CsU j2 _ d2))
      (let-match erased (cprsize-fn cp1 j1 j2 cq1 d1 d2) (Refl _ _))
      (Refl _ k))))

; The darts off diskN of one DiskSplit of a ring are off it in any other.
(def-fns _ $ (erased sub-ds : (erased (Nat) d x0) (erased (List (Nat)) e n f p hdA zsA hd zs ys) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f x0 p) rg) (erased (DiskSplit d e n (Cons (Nat) x0 p) hdA zsA) dsA) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds)
    (subterm erased (Sub ys zsA) sy) -> (erased (Sub ys zs) r))
  (let-match erased sy (HSubCons y ys1 _ iy sy1) ((HSubNil _) (HSubNil zs)))
  (HSubCons y ys1 zs (ds-off d y x0 e n f p hdA zsA hd zs h gen rg (ring-under d x0 e n f p h rg) dsA ds (ds-notin d y e n _ hdA zsA dsA iy)
      (ds-lt d y e n _ hdA zsA dsA (OrR _ _ iy)))
    (sub-ds d x0 e n f p hdA zsA hd zs ys1 h gen rg dsA ds sy1)))

(def-fns _ $ (erased add-lt-cancel : (erased (Nat) b x y s1 s2) (erased (Add b x s1) p) (erased (Add b y s2) q) (erased (Lt s1 s2) l) -> (erased (Lt x y) r))
  (match erased (lt-dec x y) _
    ((Yes _ _ _ _ r) r)
    (absurd (No _ _ _ _ le) (lt-asym s1 s2 l (add-mono-le b y x s2 s1 (le-lt-succ y x le) q p)))))

(def-fns _ $ (erased ctr-snoc : (erased (Col) s) (erased (List (Col)) et1 et) (subterm erased (Ctr s et1 et) c) -> (erased (Col) x) (erased (HSnoc (Col) et1 x et) sn))
  (match erased c _
    ((CtrNil _) (values s (SnocNil _ s)))
    ((CtrCons _ e s2 et2 ct a c1)
      (let ((erased x) (erased sn)) (ctr-snoc s2 et2 ct c1))
      (values x (SnocCons _ e x et2 ct sn)))))

; The map that chkbP of Birkhoff_valid glues from the disk map of a ring, on bd, and the map of a basis program, on its ring
; a :: p read as the node cycle a :: q.
(def-adts $ (SewSide : ((Nat) d2 dd) ((List (Nat)) e2 n2 f2 ed nd fd bd) ((List (Step)) cp) -> Type)
  enum
  (many MkSewSide : (erased (Nat) d2 dd dc a) (erased (List (Nat)) e2 n2 f2 ed nd fd ec nc fc bd p q hd2 hr2) (erased (List (Step)) cp)
      (erased (Patch d2 dd dc e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd (Cons (Nat) a q)) pt2) (erased (Cpmap cp dc ec fc (Cons (Nat) a p)) cm)
      (erased (RevApp (Nat) p (Nil (Nat)) q) ra) -> (SewSide d2 dd e2 n2 f2 ed nd fd bd cp)))

; A four-colouring of that map gives the trace that chkbP asks for: a ring trace of the disk map whose even normal form, without
; its last entry, is in the tree of the basis program.
(def-fns _ $ (erased side-trace : (erased (Nat) h m d2 dd) (erased (List (Nat)) e2 n2 f2 ed nd fd bd ks) (erased (List (Step)) cp) (erased (Ctree) t)
    (erased (SewSide d2 dd e2 n2 f2 ed nd fd bd cp) ss) (erased (BkProg h m cp t) bp) (erased (Length (Nat) bd (Succ (Succ h))) lbd)
    (erased (FourColoring e2 f2 ks) c)
    -> (erased (List (Col)) et et2 ct) (erased (Length (Col) et (Succ h)) len) (erased (ETrace et et2) e) (erased (CtMem t et2) mt) (erased (Ctr (C0) et ct) cr)
    (erased (Holds (MkPred (RArgs) (MkRArgs dd ed nd fd bd) RTP) ct) p))
  (let-match erased ss (MkSewSide _ _ dc a _ _ _ _ _ _ ec nc fc _ p q hd2 hr2 _ pt2 cm ra))
  (let ((erased etd) (erased et2) (erased td) (erased rr) (erased tr)) (colorable-patch d2 dd dc e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd _ ks pt2 c))
  (let ((erased s) (erased E) (erased se) (erased rtc)) (rt-revtail ec fc p q a etd et2 ra tr rr))
  (let ((erased ev2) (erased ev)) (etrace-c E))
  (let ((erased mt)) (bkprog-hit h m cp t bp s E ev2 (cpcol-of cp dc a ec fc p (Cons _ s E) cm rtc) ev))
  (let ((erased et1) (erased cr) (erased len)) (rt-ctr ed fd bd etd (Succ h) td lbd))
  (let ((erased x) (erased sn)) (ctr-snoc (C0) et1 etd cr))
  (let-match erased (snoc-inj (Col) E et1 etd s x se sn) (Refl _ _))
  (values E ev2 etd len ev mt cr (MkHolds (RArgs) (MkRArgs dd ed nd fd bd) RTP etd (MkRTP dd ed nd fd bd etd td))))

; The map of chkbP for one side of a ring r of a planar bridgeless plain cubic connected map, with the disk map patch pt, and a
; basis program cp of the check: planar, plain, precubic and smaller than the map, and bridgeless unless bd has a chord.
(def-fns _ $ (erased side-map : (erased (Nat) d h m x0 dd dr) (erased (List (Nat)) e n f p ed nd fd er nr fr hd hr bd br zs RV) (erased (List (Step)) cp)
    (erased (Ctree) t) (erased (Hypermap d e n f) hm) (erased (Genus d e n f (Zero)) gen) (erased (Bridgeless d e n f) bl)
    (erased (AllOrder d e (Succ (Succ (Zero)))) pl) (erased (AllOrder d n (Succ (Succ (Succ (Zero))))) cu) (erased (Connected d e n f) cn)
    (erased (Ring e f x0 p) rg) (erased (Length (Nat) (Cons (Nat) x0 p) (Succ (Succ h))) lr) (erased (NonTrivial d e n f (Cons (Nat) x0 p) m) nt)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects hd bd (Cons (Nat) x0 p)) rb)
    (erased (RevApp (Nat) (Cons (Nat) x0 p) (Nil (Nat)) RV) rv) (erased (Respects hr br RV) rbr) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds)
    (erased (AppN RV zs hr) ap) (erased (BkProg h m cp t) bp)
    -> (erased (Nat) d2) (erased (List (Nat)) e2 n2 f2) (erased (Hypermap d2 e2 n2 f2) h2) (erased (Genus d2 e2 n2 f2 (Zero)) g2)
    (erased (AllOrder d2 e2 (Succ (Succ (Zero)))) pl2) (erased (Precubic d2 n2) pc2) (erased (Lt d2 d) lt2)
    (erased (HOr (Bridgeless d2 e2 n2 f2) (Chord ed fd bd)) bo) (erased (SewSide d2 dd e2 n2 f2 ed nd fd bd cp) ss))
  (unary 3)
  (let ((erased r0)) (Cons (Nat) x0 p))
  (let ((erased pt0)) pt)
  (let-match erased pt0
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr hG hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr2 rv0 pp med mnd mer mnr))
  (let-match erased bp (MkBkProg _ _ _ _ kc x y b0 cq na cs cpc mx my xy lt ht rt cm0))
  (let ((erased dc) (erased ec) (erased fc) (erased rc) (erased cmap)) (cpmap-c cp na))
  (let ((erased nc) (erased pm) (erased qc)) (cpmap-cubic cp dc ec fc rc cmap cq))
  (let ((erased ccc) (erased blc) (erased gnc)) (cpmap-geom cp dc ec nc fc rc cmap pm cq))
  (let ((erased pm2)) pm)
  (let-match erased pm2 (MkPointedMap _ _ _ _ _ hc cr))
  (let ((erased a) (erased p1) (erased q) (erased eq) (erased ra) (erased ncb) (erased dq)) (cpring-br nc rc cr))
  (let-match erased eq (Refl _ _))
  (let ((erased kr) (erased lrc) (erased csr)) (cpmap-size cp dc ec fc rc cmap))
  (let-match erased (cprsize-fn cp kr (Succ (Succ h)) cq csr cs) (Refl _ _))
  (let-match erased lrc (LengthCons _ _ _ _ lp1))
  (let ((erased lq)) (revapp-length p1 (Nil _) q (Succ h) (Zero) (Succ h) ra lp1 (LengthNil _) (add-zero-right (Succ h))))
  (let ((erased br2)) (Cons (Nat) a q))
  (let ((erased nfc) (erased nic) (erased fic) (erased rnfc) (erased pec) (erased pnc) (erased pfc)) (hyper-core dc ec nc fc hc))
  (let ((erased kb) (erased lb)) (length-exists (Nat) bd))
  (let-match erased (length-fn (Nat) r0 kb (Succ (Succ h)) (respects-length hd bd r0 kb rb lb) lr) (Refl _ _))
  (let ((erased d2) (erased e2) (erased n2) (erased f2) (erased hd2) (erased hr2) (erased pt2))
    (sew-exists dd dc (Succ (Succ h)) ed nd fd ec nc fc bd br2 hdm hc cyd sd ncb dq (respects-under hd bd bG dd rbd lhd)
      (ncyc-under nc br2 dc ncb (perm-under dc nc nic pnc)) lb (LengthCons _ a q _ lq)))
  (let ((erased pt3)) pt2)
  (let-match erased pt3
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids2 idd2 idr2 bG2 bGr2 h2 hdm2 hrm2 io2 iod2 ior2 lhd2 lhr2 dhd2 dhr2 uhd2 uhr2 cyd2 sd2 cyr2 dbr2 rbd3 rbr3 rv3 pp2
      med2 mnd2 mer2 mnr2))
  (let ((erased gd) (erased gr)) (patch-parts-planar d dd dr e n f ed nd fd er nr fr hd hr bd br pt gen))
  (let ((erased g2) (erased pg2)) (even-genus d2 e2 n2 f2 h2))
  (let-match erased (genus-patch d2 dd dc g2 (Zero) (Zero) e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd br2 pt2 pg2 gd gnc) (AddZero _))
  (let ((erased od) (erased ar)) (edge-order-patch d dd dr (Succ (Succ (Zero))) e n f ed nd fd er nr fr hd hr bd br pt pl idd iod))
  (let ((erased pl2))
    (order-edge-patch d2 dd dc (Succ (Succ (Zero))) e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd br2 pt2 idd iod od (plain-order dc ec (cpmap-plain cp dc ec fc rc cmap))))
  (let ((erased ad) (erased orr)) (node-order-patch d dd dr 3 e n f ed nd fd er nr fr hd hr bd br pt cu idr ior))
  (let-match erased qc (CMkQuasiCubic _ _ _ idc ioc cubs))
  (let ((erased cu2)) (order-node-patch d2 dd dc 3 e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd br2 pt2 idc ioc ad (cubics-turn nc p1 q idc a cubs ra)))
  (let ((erased bld) (erased blr)) (patch-bridgeless d dd dr e n f ed nd fd er nr fr hd hr bd br pt bl))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f hm))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f hm))
  (let ((erased gf) (erased grf)) (perm-graph d f fi pmf))
  (let ((erased kbr) (erased lbr0)) (length-exists (Nat) br))
  (let ((erased lRV)) (revapp-length r0 (Nil _) RV (Succ (Succ h)) (Zero) (Succ (Succ h)) rv lr (LengthNil _) (add-zero-right (Succ (Succ h)))))
  (let-match erased (length-fn (Nat) RV kbr (Succ (Succ h)) (respects-length hr br RV kbr rbr lbr0) lRV) (Refl _ _))
  (let-match erased lbr0 (LengthCons _ b1 q1 _ lq1))
  (let ((erased lb1)) (under-in br b1 dr (respects-under hr br bGr dr rbr2 lhr) (InHere b1 q1)))
  (let ((erased cnr)) (patch-connected-r d dd dr e n f ed nd fd er nr fr hd hr bd br pt cn (lt-le-trans (Zero) (Succ b1) dr (LtZ b1) (LtS b1 dr lb1))))
  (let ((erased gr2)) gr)
  (let-match erased gr2 (MkGenus _ _ _ _ kfr _ _ _ _ _ _ _ _ _ _ _ _ ofr _ _ _ _ _ _ _ _))
  (let ((erased f6) (erased m2) (erased u) (erased mf) (erased mm) (erased du) (erased qe))
    (quasicubic-planar dr (Succ h) b1 kfr er nr fr q1 idr hrm ar cyr dbr lq1 orr ior cnr gr ofr))
  (let ((erased outer) (erased inner) (erased bs) (erased co)) (patch-fcard-face-r d dd dr kfr e n f ed nd fd er nr fr hd hr bd br ids gf pt io grf ofr))
  (let-match erased nt (MkNonTrivial _ _ _ _ _ _ hdA zsA xs ys dsA lx ly sx sy px py))
  (let ((erased K) (erased aK) (erased lK)) (outer-count d (Succ (Succ h)) m kfr x0 e f p ys zs RV hr ids outer inner gf grf lf rg lr py ly
    (sub-ds d x0 e n f p hdA zsA hd zs ys hm gen rg dsA ds sy) rv ap uhr io bs co))
  (let-match erased (cpcard-of cp dc kc ec fc rc cmap cpc) (Refl _ _))
  (let ((erased ltd)) (birkhoff-size h m dc dr kfr K f6 m2 u x y b0 aK lK mf mm du qe mx my xy lt))
  (let ((erased b) (erased s) (erased lbd) (erased a1) (erased a2)) (card-patch d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased b2) (erased s2) (erased lbd2) (erased a3) (erased a4)) (card-patch d2 dd dc e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd br2 pt2))
  (let-match erased (length-fn (Nat) bd b2 b lbd2 lbd) (Refl _ _))
  (values d2 e2 n2 f2 h2 pg2 pl2 (cubic-precubic d2 n2 cu2)
    (add-lt-cancel b d2 d s2 s a4 a2 (add-mono-lt dc dr dd s2 s ltd (add-comm dd dc s2 a3) (add-comm dd dr s a1)))
    (bridgeless-patch d2 dd dc e2 n2 f2 ed nd fd ec nc fc hd2 hr2 bd br2 pt2 bld blc)
    (MkSewSide d2 dd dc a e2 n2 f2 ed nd fd ec nc fc bd p1 q hd2 hr2 cp pt2 cmap ra)))
