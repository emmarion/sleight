; For each step t of cs and each item s it closes, the map joins labels s and t.
(def-adts $ (AllClosed : ((List (Nat)) e) ((List (Nat)) pl) ((List (Closed)) cs) -> Type)
  enum
  (many ACNil : (erased (List (Nat)) e pl) -> (AllClosed e pl (Nil (Closed))))
  (many ACCons : (erased (List (Nat)) e pl r) (erased (List (Closed)) cs) (erased (Nat) t) (erased (AllJoined e pl r t) j)
      (erased (AllClosed e pl cs) rest) -> (AllClosed e pl (Cons (Closed) (MkClosed t r) cs))))

(def-adts $ (Built : ((List (Closed)) cs) -> Type)
  enum
  (many MkBuilt : (erased (List (Closed)) cs) (erased (List (Nat)) e nd pl rep) (erased (PlaneMap e nd) pm)
      (erased (Respects pl nd pl) rp) (erased (Reps nd rep (Zero) pl) rs) (erased (AllClosed e pl cs) ac) -> (Built cs)))

(def-fns _ $ (erased run-trace : (erased (Nat) t) (erased (List (Nat)) e nd pl rep fl xs) (erased (List (Group)) gs) (erased (List (Closed)) cs)
    (erased (State t e nd pl rep gs fl) st) (erased (Rot (Nat) fl xs) ro) (subterm erased (Trace t xs cs) tr) ->
    (erased (List (Nat)) e3 nd3 pl3 rep3) (erased (PlaneMap e3 nd3) pm) (erased (Respects pl3 nd3 pl3) rp) (erased (Reps nd3 rep3 (Zero) pl3) rs)
    (erased (AllClosed e3 pl3 cs) ac) (erased (Agree e e3 (Nil (Nat))) ge) (erased (Agree pl pl3 (Nil (Nat))) gp))
  (match erased tr _
    ((TrDone _)
      (let-match erased st (MkState _ _ _ _ _ _ _ _ _ _ _ pm _ _ _ _ _ _ _ rp _ _ _ rs))
      (values e nd pl rep pm rp rs (ACNil e pl) (AgRefl e (Nil _)) (AgRefl pl (Nil _))))
    ((TrStep _ k _ p r q pr ns pn ys cs1 a1 a2 dr rk a3 a4 rest)
      (let ((erased e2) (erased nd2) (erased pl2) (erased rep2) (erased fl2) (erased gs2) (erased st2) (erased ro2) (erased j) (erased ge) (erased gp))
        (sweep-step t k e nd pl rep fl xs p r q pr ns pn ys gs st ro a1 a2 dr rk a3 a4))
      (let ((erased e3) (erased nd3) (erased pl3) (erased rep3) (erased pm) (erased rp) (erased rs) (erased ac) (erased ge3) (erased gp3))
        (run-trace (Succ t) e2 nd2 pl2 rep2 fl2 ys gs2 cs1 st2 ro2 rest))
      (values e3 nd3 pl3 rep3 pm rp rs (ACCons e3 pl3 r cs1 t (alljoined-grow e2 pl2 e3 pl3 r t j ge3 gp3) ac)
        (AgTrans e e2 e3 (Nil _) ge ge3) (AgTrans pl pl2 pl3 (Nil _) gp gp3)))))

(def-fns _ $ (erased first-state : (erased (Nat) k) (erased (List (Nat)) ns) (erased (Repeat (Nat) k (Succ (Zero)) ns) rk) ->
    (erased (State (Succ (Succ (Zero))) (Cons (Nat) (Succ (Zero)) $ Cons (Nat) (Zero) $ Nil (Nat)) (Cons (Nat) (Zero) $ Cons (Nat) (Succ (Zero)) $ Nil (Nat))
      (Cons (Nat) (Zero) $ Cons (Nat) (Succ (Zero)) $ Nil (Nat)) (Cons (Nat) (Zero) $ Cons (Nat) (Succ (Zero)) $ Nil (Nat))
      (Cons (Group) (MkGroup (Succ (Zero)) ns) (Nil (Group))) ns) st))
  (let ((erased z)) (Zero))
  (let ((erased o)) (Succ z))
  (let ((erased tw)) (Succ o))
  (let ((erased N)) (Nil (Nat)))
  (let ((erased e)) (Cons (Nat) o $ Cons (Nat) z N))
  (let ((erased nd)) (Cons (Nat) z $ Cons (Nat) o N))
  (let ((erased s)) (Cons (Nat) o N))
  (let ((erased e0)) (NthHere _ z N))
  (let ((erased n0)) (NthHere _ z (Cons _ o N)))
  (let ((erased e1)) (NthThere _ o (Cons _ z N) z z e0))
  (let ((erased n1)) (NthThere _ z (Cons _ o N) z o (NthHere _ o N)))
  (let ((erased pm)) (PMIsolated N N e (Cons (Nat) z N) nd z (PMNil)
    (MkEdgeGrow N (Cons (Nat) o N) e z (LengthNil _) (SnocNil _ o) (SnocCons _ o z N (Cons (Nat) z N) (SnocNil _ z)))
    (SnocNil _ z) (SnocCons _ z o N (Cons (Nat) o N) (SnocNil _ o))))
  (let ((erased l2)) (LengthCons _ z _ o (LengthCons _ o N z (LengthNil _))))
  (let ((erased l2e)) (LengthCons _ o _ o (LengthCons _ z N z (LengthNil _))))
  (let ((erased w)) (WalkStep e nd s o z z z e1 n0 (NotInCons z o N (ApLt _ _ z o (LtZ z)) (NotInNil z)) (WalkHere e nd s z)))
  (MkState tw tw o e nd nd nd s ns ns (Nil _) pm l2e l2 l2 l2 (DartsCons o ns N (Nil _) (DartsNil)) (DistCons o N (NotInNil o) (DistNil))
    (ChainOne e nd s ns o o (MkLink e nd s o o o z n1 e1 w))
    (RespCons nd _ _ z z n0 (RespCons nd _ _ o o n1 (RespNil nd)))
    (ALCons z tw _ (LtZ o) (ALCons o tw _ (LtS z o (LtZ z)) (ALNil tw)))
    (GLCons nd ns o o _ n1 (repeat-allis k o ns rk) (GLNil nd))
    (GFlatCons o ns N ns _ (lapp-nil _ ns) (GFlatNil))
    (RepsCons nd nd _ z z z n0 (NRHere nd z) (RepsCons nd nd _ o o o n1 (NRHere nd o) (RepsNil nd nd tw)))))

(def-fns _ $ (erased build : (erased (List (Closed)) cs) (erased (Trace (Succ (Zero)) (Nil (Nat)) cs) tr) -> (erased (Built cs) b))
  (let-match erased tr (TrStep _ k _ p r q pr ns pn ys cs1 a1 a2 dr rk a3 a4 rest)
    ((TrDone _) (MkBuilt cs (Nil _) (Nil _) (Nil _) (Nil _) (PMNil) (RespNil _) (RepsNil _ _ _) (ACNil _ _))))
  (let-match erased a2 (LAppNil _ _))
  (let-match erased a1 (LAppNil _ _))
  (let-match erased a3 (LAppNil _ _))
  (let-match erased (lapp-fn _ ns (Nil _) ys ns a4 (lapp-nil _ ns)) (Refl _ _))
  (let ((erased e3) (erased nd3) (erased pl3) (erased rep3) (erased pm) (erased rp) (erased rs) (erased ac) (erased ge3) (erased gp3))
    (run-trace (Succ (Succ (Zero))) _ _ _ _ ns ns _ cs1 (first-state k ns rk) (rot-refl _ ns) rest))
  (MkBuilt cs e3 nd3 pl3 rep3 pm rp rs (ACCons e3 pl3 (Nil _) cs1 (Succ (Zero)) (AJNil e3 pl3 (Succ (Zero))) ac)))
