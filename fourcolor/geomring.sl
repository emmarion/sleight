  (let ((erased d3) (erased pd3)) (mul d three))
  (let ((erased d2) (erased pd2)) (mul d two))
  (let ((erased e6) (erased pe6)) (mul ke six))
  (let ((erased i6) (erased pi6)) (mul i six))
