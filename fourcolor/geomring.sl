  (let ((erased z) (erased pz1) (erased pz2)) (add-assoc d3 t2 f6b s6 dd6 sum2 sum1))
  (let ((erased w) (erased pw1) (erased pw2)) (add-assoc d3 d3 six d6 dd6 a3d ad6))
