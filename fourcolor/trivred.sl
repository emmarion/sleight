          (let-match erased rq (RPCons _ _ _ _ ehx _ _ pehx sa _))
          (let-match erased (nth-fn _ em hx ehx en2 pehx pen2) (Refl _ _))
          (let-match erased (simple-cface fm _ ha1 hz smR (InThere ha1 hx _ (InHere ha1 hp1)) (InThere hz hx _ (app-in-r _ _ _ hz ahp (InHere hz hB)))
              (some-cat fm ha1 en2 hz (some-sym dm en2 ha1 fm fim qfm sa len2) (some-cat fm en2 nhw hz (some-step fm en2 nhw pfen2) snz))) (Refl _ _))
          (let ((erased oa) (erased ob)) (app-mid-notin hB hp hA hz ahp dhp))
          (in-notin hz hA (InHere hz hA1) oa)))
      (let-match erased r1 (RPNil _ _ _))
      (let-match erased (some-cat fc cc z enny spc szenny) (MkSomePath _ _ ws3 _ _ pth3))
      (let ((erased icc)) (ker-path-inv dc dm cc enny ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws3 en iennya pth3))
      (let ((erased v3) (erased pv3) (erased pmv3)) (functor-at ec em as hl as x cc hx fu ixa pc icc phx))
      (let-match erased (nth-fn _ em hx v3 en2 pmv3 pen2) (Refl _ _))
      (let-match erased (cface-inj dc dm cc enny en2 ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws3 en icc pth3 pv3 phenny) (Refl _ _))
      (let-match erased (perm-inj dc x nny cc ec nfc qe pc penny) (Refl _ _))
      (MkSomePath fc (Nil _) (Nil _) x x (PathHere fc (Nil _) x)))
    ((OrR _ _ on2)
      (let ((erased dn2)) (disk-node dm nhw n2 nm nim fm _ qnm dnh pn2))
      (let ((erased den) (erased oen)) (disk-edge dm n2 en2 hx em nm fm hp h gen rg dn2 on2 pen2))
      (let ((erased L2) (erased aL2)) (app-exists (Cons _ hz hB) (Cons _ hx hA)))
      (let ((erased aR)) (AppCons hA _ hp hx ahp))
      (let ((erased dxA) (erased dzB2)) (app-parts _ _ _ aR dR))
      (let ((erased djR)) (app-disj _ _ _ aR dR))
      (let ((erased dL2)) (app-distinct _ _ L2 aL2 dzB2 dxA (disj-sym _ _ djR _ (sub-refl _))))
      (let ((erased pz2) (erased _)) (plain-eq dm n2 en2 em pl ln2 pen2))
      (let ((erased cc3)) (mk-chords hx hz hx en2 n2 hw ehw hc1 ehc em nm fm hp hB hA L2 rg (app-swap-sub _ _ L2 _ aL2 aR) (app-swap-sub _ _ _ L2 aR aL2) dL2 aL2
        rBm pehw shw rAm pehc shc pz2 (some-cat fm hz nhw en2 (some-sym dm nhw hz fm fim qfm snz lnh) sen2) sn2x den oen dn2 on2))
      (let ((erased cc4)) (chords-swap dm hx hz hx en2 n2 em nm fm hp hB hA h pl cc3))
      (let ((erased hd0) (erased zs0) (erased d0)) (rds-make dm hx em nm fm hp h gen pl rg (proper-mid em hB1 hp hx hz hb hA ahp)))
      (let ((erased cr3)) (chord-ring hx hz hx en2 n2 em nm fm hp hB hA cc3))
      (let ((erased hd1) (erased zs1) (erased d1)) (rds-make dm en2 em nm fm (Cons _ hx hA) h gen pl cr3 (chord-proper hx hz hx en2 n2 em nm fm hp hB hA cc3)))
      (let ((erased hd2) (erased zs2) (erased d2)) (rds-make dm n2 em nm fm (Cons _ hz hB) h gen pl (chord-ring hx hx hz n2 en2 em nm fm hp hA hB cc4)
        (chord-proper hx hx hz n2 en2 em nm fm hp hA hB cc4)))
      (let ((erased fe2)) (fe-chord dm hx hz hx en2 n2 em nm fm lab hp hB hA hd0 zs0 hd1 zs1 hd2 zs2 cc3 d0 d1 d2 cn2 fl fm0))
      (let ((erased hq2) (erased apq2) (erased rgq2)) (ring-rot1 em fm hA en2 hx cr3))
      (let ((erased t3) (erased t4)) (sub-rot (Cons _ hx hA) (Cons _ hx hq2) en2 (AppCons hA _ hq2 hx apq2)))
      (let ((erased feq2)) (fe-move dm em nm fm lab _ _ fe2 t3 t4))
      (let ((erased q2) (erased rq2) (erased apq2c)) (rpath-join ec fc (Nil _) A x c cc enny enny r1 pc (some-cat fc cc z enny spc szenny) (RPNil ec fc enny)))
      (let ((erased wq2)) (within-app _ q2 as A apq2c wA (WCons as enny (Nil _) iennya (WNil as))))
      (let ((erased lq2) (erased rlq2) (erased alq2)) (resp-app hl _ q2 _ A apq2c hA rA (RespCons hl (Nil _) (Nil _) enny en2 phenny (RespNil hl))))
      (let-match erased (app-fn _ lq2 hq2 hA alq2 apq2) (Refl _ _))
      (let ((erased kq2) (erased lkq2) (erased ltq2)) (snoc-lt B1 p q2 z b enny k A ap apq2c lk))
      (let ((erased e2) (erased pe2) (erased se2)) (triv-hom dc dm ec nc fc ksc rc em nm fm ksm as hl fe lab cx bd1 x enny hx kq2 q2 hq2 rq2 (WCons as x q2 ixa wq2) (RespCons hl q2 hq2 x hx phx rlq2) rgq2 lkq2
        (lt-ls kq2 k bd1 ltq2 lb) feq2))
      (let-match erased (nth-fn _ ec enny e2 nny pe2 (gc-ee dc dm nny enny ec nc fc ksc rc em nm fm ksm as hl fe lab cx penny)) (Refl _ _))
      se2)))
  (values ey pey (some-cat fc ey nny x (some-step fc ey nny (hyper-third dc ey y nny ec nc fc hc pey pnny2)) snx)))

(def-fns _ $ (erased spk-of : (erased (Nat) d) (erased (List (Nat)) e n f lab) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Bridgeless d e n f) bl) (erased (AllOrder d e (Succ (Succ (Zero)))) pl) (erased (AllOrder d n (Succ (Succ (Succ (Zero))))) cu) (erased (FaceLab d f lab) fl)
    -> (erased (List (Nat)) fe) (erased (Spk d e n f fe lab) c))
  (let ((erased h2)) h)
  (let-match erased h2 (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let ((erased nf2) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ fi2 _ ids2 rs gf pf gr io2 ro cl ll))
  (values fe (MkSpk d e n f fe lab ids h gen bl pl cu cfe ke io (respects-under-vals f e fe d cfe (perm-under d f fi pmf))
    (respects-length f e fe d cfe le) fl (graph-resp d f lab gf gr cl ll))))

; The edge image of y is on the face of x: rlink y x.
(def-adts $ (Closes : ((List (Nat)) ec fc) ((Nat) y x) -> Type)
  enum
  (many MkCloses : (erased (List (Nat)) ec fc) (erased (Nat) y x ey) (erased (Nth (Nat) ec y ey) pe) (erased (SomePath fc (Nil (Nat)) ey x) sp) -> (Closes ec fc y x)))

; The case of a HomTrivial that trivial_hom_ring does not settle: a hom ring x :: p of five darts that does not close, one side of
; which, its diskN part hd, meets exactly one face off the ring, that of y (labels lab).
(def-adts $ (HomFive : ((Nat) dm) ((List (Nat)) ec fc em nm fm as hl) -> Type)
  enum
  (many MkHomFive : (erased (Nat) dm) (erased (List (Nat)) ec fc em nm fm as hl p hp hd zs lab lr) (erased (Nat) x z hx ez y l) (erased (RPath ec fc x p z) rp)
      (erased (Within (Cons (Nat) x p) as) wp) (erased (Respects hl (Cons (Nat) x p) (Cons (Nat) hx hp)) rh) (erased (Ring em fm hx hp) rg)
      (erased (Length (Nat) (Cons (Nat) x p) (Succ (Succ (Succ (Succ (Succ (Zero))))))) lk) (erased (Nth (Nat) ec z ez) pez) (erased (Kernel fc (Cons (Nat) x (Nil (Nat))) ez) nr)
      (erased (DiskSplit dm em nm (Cons (Nat) hx hp) hd zs) ds) (erased (FaceLab dm fm lab) fl) (erased (Respects lab (Cons (Nat) hx hp) lr) rl)
      (erased (In y hd) iy) (erased (Nth (Nat) lab y l) pl) (erased (NotIn l lr) ol) (erased (AllLab lab (Cons (Nat) l lr) hd) al) -> (HomFive dm ec fc em nm fm as hl)))

; A hom ring whose diskN side is trivial in the sense of TrivSide closes (trivial_hom_ring), or it is a HomFive.
(def-fns _ $ (erased side-hd : (erased (Nat) dc dm) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl fe lab) (erased (TCx dc ec nc fc ksc rc dm em nm fm ksm as hl fe lab) cx)
    (erased (Nat) x z hx ez k m) (erased (List (Nat)) p hp hd zs lr) (erased (RPath ec fc x p z) rp) (erased (Within (Cons (Nat) x p) as) wp)
    (erased (Respects hl (Cons (Nat) x p) (Cons (Nat) hx hp)) rh) (erased (Ring em fm hx hp) rg) (erased (Length (Nat) (Cons (Nat) x p) k) lk) (erased (BkMode k m) md)
    (erased (Nth (Nat) ec z ez) pez) (erased (Kernel fc (Cons (Nat) x (Nil (Nat))) ez) nr) (erased (DiskSplit dm em nm (Cons (Nat) hx hp) hd zs) ds)
    (erased (Respects lab (Cons (Nat) hx hp) lr) rl) (erased (TrivSide lab lr hd m) ts) -> (erased (Or (Closes ec fc z x) (HomFive dm ec fc em nm fm as hl)) r))
  (let ((erased h) (erased gen) (erased bl) (erased pl) (erased cu) (erased fl) (erased cn2) (erased nfm) (erased nim) (erased fim) (erased qem) (erased qnm) (erased qfm))
    (tm dc dm ec nc fc ksc rc em nm fm ksm as hl fe lab cx))
  (match erased ts _
    ((TsZero _ _ _ _ al)
      (let-match erased lk (LengthCons _ _ _ k1 lk1))
      (let ((erased sr)) (sub-refl (Cons _ hx hp)))
      (let ((erased ey) (erased pey) (erased sp)) (triv-hom dc dm ec nc fc ksc rc em nm fm ksm as hl fe lab cx (Succ k1) x z hx k1 p hp rp wp rh rg lk1 (lt-succ k1)
        (MkFEmpty dm hx em nm fm lab _ hp hd zs lr rg sr sr ds rl al)))
      (OrL _ _ (MkCloses ec fc z x ey pey sp)))
    ((TsOne _ _ _ y l iy pl ol al)
      (let-match erased md (BMFive))
      (OrR _ _ (MkHomFive dm ec fc em nm fm as hl p hp hd zs lab lr x z hx ez y l rp wp rh rg lk pez nr ds fl rl iy pl ol al)))))

(def-fns _ $ (erased rev-ex : (subterm erased (List (Nat)) pre) (erased (List (Nat)) w) -> (erased (List (Nat)) r) (erased (RevApp (Nat) pre w r) ra))
  (let-match erased pre (Cons _ s pre1) ((Nil _) (values w (RANil _ w))))
  (let ((erased r) (erased ra)) (rev-ex pre1 (Cons _ s w)))
  (values r (RACons _ s pre1 w r ra)))

(def-fns _ $ (erased revapp-app : (erased (List (Nat)) X acc R W acc2) (subterm erased (RevApp (Nat) X acc R) ra) (erased (AppN acc W acc2) ap)
    -> (erased (List (Nat)) R2) (erased (RevApp (Nat) X acc2 R2) rb) (erased (AppN R W R2) ar))
  (let-match erased ra (RACons _ s X1 _ _ ra1) ((RANil _ _) (values acc2 (RANil _ acc2) ap)))
  (let ((erased R2) (erased rb) (erased ar)) (revapp-app X1 (Cons _ s acc) R W (Cons _ s acc2) ra1 (AppCons acc W acc2 s ap)))
  (values R2 (RACons _ s X1 acc2 R2 rb) ar))

(def-fns _ $ (erased revapp-snoc : (erased (List (Nat)) Y acc RR) (erased (Nat) a) (subterm erased (List (Nat)) X) (erased (AppN X (Cons (Nat) a (Nil (Nat))) Y) ap)
    (erased (RevApp (Nat) Y acc RR) ra) -> (erased (List (Nat)) R1) (erased (Eq (List (Nat)) RR (Cons (Nat) a R1)) eq) (erased (RevApp (Nat) X acc R1) rb))
  (let-match erased ap (AppCons X1 _ Y1 b ap1)
    ((AppNil _) (let-match erased ra (RACons _ _ _ _ _ ra1)) (let-match erased ra1 (RANil _ _)) (values acc (Refl _ RR) (RANil _ acc))))
  (let-match erased ra (RACons _ _ _ _ _ ra1))
  (let ((erased R1) (erased eq) (erased rb)) (revapp-snoc Y1 (Cons _ b acc) RR a X1 ap1 ra1))
  (values R1 eq (RACons _ b X1 acc R1 rb)))

(def-fns _ $ (erased rev-cons : (erased (List (Nat)) acc R) (erased (Nat) s) (subterm erased (List (Nat)) X) (erased (RevApp (Nat) X (Cons (Nat) s acc) R) ra)
    -> (erased (Nat) q0) (erased (List (Nat)) Q) (erased (Eq (List (Nat)) R (Cons (Nat) q0 Q)) eq))
  (let-match erased ra (RACons _ t X1 _ _ ra1) ((RANil _ _) (values s acc (Refl _ R))))
  (rev-cons (Cons _ s acc) R t X1 ra1))

(def-fns _ $ (erased resp-revapp : (erased (List (Nat)) hl acc hacc R HX HR) (subterm erased (List (Nat)) X) (erased (Respects hl X HX) rx) (erased (RevApp (Nat) X acc R) ra)
    (erased (RevApp (Nat) HX hacc HR) rb) (erased (Respects hl acc hacc) rc) -> (erased (Respects hl R HR) r))
  (let-match erased ra (RACons _ s X1 _ _ ra1) ((RANil _ _) (let-match erased rx (RespNil _)) (let-match erased rb (RANil _ _)) rc))
  (let-match erased rx (RespCons _ _ HX1 _ hs ps rx1))
  (let-match erased rb (RACons _ _ _ _ _ rb1))
  (resp-revapp hl (Cons _ s acc) (Cons _ hs hacc) R HX1 HR X1 rx1 ra1 rb1 (RespCons hl acc hacc s hs ps rc)))

(def-fns _ $ (erased within-revapp : (erased (List (Nat)) acc R as) (subterm erased (List (Nat)) X) (erased (RevApp (Nat) X acc R) ra) (erased (Within X as) wx)
    (erased (Within acc as) wa) -> (erased (Within R as) r))
  (let-match erased ra (RACons _ s X1 _ _ ra1) ((RANil _ _) wa))
  (let-match erased wx (WCons _ _ _ is wx1))
  (within-revapp (Cons _ s acc) R as X1 ra1 wx1 (WCons as s acc is wa)))

(def-fns _ $ (erased resp-fn : (erased (List (Nat)) lab ls ls2) (subterm erased (List (Nat)) xs) (erased (Respects lab xs ls) a) (erased (Respects lab xs ls2) b)
    -> (erased (Eq (List (Nat)) ls ls2) r))
  (let-match erased a (RespCons _ xs1 ls1 j l pl a1) ((RespNil _) (let-match erased b (RespNil _)) (Refl _ ls)))
  (let-match erased b (RespCons _ _ ls3 _ l2 pl2 b1))
  (let-match erased (nth-fn _ lab j l l2 pl pl2) (Refl _ _))
  (let-match erased (resp-fn lab ls1 ls3 xs1 a1 b1) (Refl _ _))
  (Refl _ ls))

; The edge images E of the darts of an rlink walk of kernel darts whose last step leads into the kernel, with their images EH.
(def-fns _ $ (erased edges-h : (erased (Nat) dc dm a b eb t ha) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl fe lab H) (erased (TCx dc ec nc fc ksc rc dm em nm fm ksm as hl fe lab) cx)
    (subterm erased (List (Nat)) P) (erased (RPath ec fc a P b) rp) (erased (Within (Cons (Nat) a P) as) wp) (erased (Nth (Nat) ec b eb) pb) (erased (SomePath fc (Nil (Nat)) eb t) sp)
    (erased (In t as) it) (erased (Respects hl (Cons (Nat) a P) (Cons (Nat) ha H)) rh)
    -> (erased (List (Nat)) E EH) (erased (Respects ec (Cons (Nat) a P) E) re) (erased (Within E as) we) (erased (Respects hl E EH) rhe) (erased (Respects em (Cons (Nat) ha H) EH) rme))
  (let-match erased cx (MkTCx _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ en ok fu sp0 cn))
  (let-match erased wp (WCons _ _ _ ia wp1))
  (let-match erased rh (RespCons _ _ _ _ _ pha rh1))
  (let-match erased rp (RPCons _ _ P1 _ ea a2 _ pea spa rp1)
    ((RPNil _ _ _)
      (let-match erased rh1 (RespNil _))
      (let-match erased sp (MkSomePath _ _ ws _ _ pth))
      (let ((erased ieb)) (ker-path-inv dc dm eb t ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws en it pth))
      (let ((erased v) (erased pv) (erased pmv)) (functor-at ec em as hl as a eb ha fu ia pb ieb pha))
      (values (Cons _ eb (Nil _)) (Cons _ v (Nil _)) (RespCons ec (Nil _) (Nil _) a eb pb (RespNil ec)) (WCons as eb (Nil _) ieb (WNil as))
        (RespCons hl (Nil _) (Nil _) eb v pv (RespNil hl)) (RespCons em (Nil _) (Nil _) ha v pmv (RespNil em)))))
  (let-match erased wp1 (WCons _ _ _ ia2 _))
  (let-match erased rh1 (RespCons _ _ H1 _ ha2 pha2 _))
  (let-match erased spa (MkSomePath _ _ ws _ _ pth))
  (let ((erased iea)) (ker-path-inv dc dm ea a2 ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws en ia2 pth))
  (let ((erased v) (erased pv) (erased pmv)) (functor-at ec em as hl as a ea ha fu ia pea iea pha))
  (let ((erased E1) (erased EH1) (erased re) (erased we) (erased rhe) (erased rme)) (edges-h dc dm a2 b eb t ha2 ec nc fc ksc rc em nm fm ksm as hl fe lab H1 cx P1 rp1 wp1 pb sp it rh1))
  (values (Cons _ ea E1) (Cons _ v EH1) (RespCons ec _ E1 a ea pea re) (WCons as ea E1 iea we) (RespCons hl E1 EH1 ea v pv rhe) (RespCons em _ EH1 ha v pmv rme)))

; rpath-rev of revsnip.sl on the configuration map, with its edge an involution read off GcOK.
(def-fns _ $ (erased rpath-rev-c : (erased (Nat) dc dm c b ec0 ea) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl fe lab mP Acc RR) (erased (TCx dc ec nc fc ksc rc dm em nm fm ksm as hl fe lab) cx)
    (subterm erased (List (Nat)) P) (erased (RPath ec fc c P b) rp) (erased (Respects ec P mP) rm) (erased (Nth (Nat) ec c ec0) pc)
    (erased (RevApp (Nat) (Cons (Nat) ec0 mP) Acc RR) ra) (erased (RPath ec fc ec0 Acc ea) racc)
    -> (erased (Nat) eb) (erased (List (Nat)) Q) (erased (Nth (Nat) ec b eb) pb) (erased (Eq (List (Nat)) RR (Cons (Nat) eb Q)) eq) (erased (RPath ec fc eb Q ea) rq))
  (let-match erased cx (MkTCx _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ en ok fu sp0 cn))
  (let ((erased nfc) (erased nic) (erased fic) (erased nfm) (erased nim) (erased fim) (erased qe) (erased qn) (erased qf) (erased qem) (erased qnm) (erased qfm))
    (hc-perms dc dm ec nc fc ksc rc em nm fm ksm as hl en))
  (let-match erased rp (RPCons _ _ P1 _ ec2 z _ pc2 sp rp1)
    ((RPNil _ _ _) (let-match erased rm (RespNil _)) (let-match erased ra (RACons _ _ _ _ _ ra1)) (let-match erased ra1 (RANil _ _))
      (values ec0 Acc pc (Refl _ RR) racc)))
  (let-match erased (nth-fn _ ec c ec0 ec2 pc pc2) (Refl _ _))
  (let-match erased rm (RespCons _ _ mP1 _ ez pz rm1))
  (let-match erased ra (RACons _ _ _ _ _ ra1))
  (rpath-rev-c dc dm z b ez ea ec nc fc ksc rc em nm fm ksm as hl fe lab mP1 (Cons _ ec0 Acc) RR cx P1 rp1 rm1 pz ra1
    (RPCons ec fc Acc ez z ec0 ea (gc-ee dc dm z ez ec nc fc ksc rc em nm fm ksm as hl fe lab cx pz) (some-sym dc ec0 z fc fic qf sp (perm-val dc c ec0 ec nfc qe pc)) racc)))

(def-fns _ $ (erased al-sub : (erased (List (Nat)) lab L L2 S) (subterm erased (List (Nat)) S2) (erased (AllLab lab L S) al) (erased (WSub S2 S) s) (erased (WSub L L2) sl)
    -> (erased (AllLab lab L2 S2) r))
  (let-match erased s (HSubCons t S3 _ it s1) ((HSubNil _) (AlNil lab L2)))
  (let ((erased l) (erased pl) (erased il)) (allab-in lab L t S al it))
  (AlCons lab L2 S3 t l pl (sub-in L L2 l sl il) (al-sub lab L L2 S S3 al s1 sl)))

(def-fns _ $ (erased facesub-to : (erased (List (Nat)) f B C) (subterm erased (List (Nat)) A) (erased (FaceSub f A B) fs) (erased (WSub B C) s) -> (erased (FaceSub f A C) r))
  (let-match erased fs (FSCons _ A1 _ a b ib sp fs1) ((FSNil _ _) (FSNil f C)))
  (FSCons f A1 C a b (sub-in B C b s ib) sp (facesub-to f B C A1 fs1 s)))

; The labels of A are labels of B when each dart of A is on a face of B.
(def-fns _ $ (erased labs-in : (erased (Nat) d) (erased (List (Nat)) f lab B la lb) (subterm erased (List (Nat)) A) (erased (FaceLab d f lab) fl) (erased (FaceSub f A B) fs)
