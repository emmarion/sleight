; fullred.sl's TrivRed: trivial_hom_ring of embed.v, its use on the reversed ring, and the five-dart case. Load after fullred.sl,
; in its chain. That these statements match Coq's has been checked only by reading.

; What the lemmas here read off the two maps: embed3.sl's EEnv with GcOK and FunctorAll, and the map as Spk of minarity.sl.
(def-adts $ (TCx : ((Nat) dc) ((List (Nat)) ec nc fc ksc rc) ((Nat) dm) ((List (Nat)) em nm fm ksm as hl fe lab) -> Type)
  enum
  (many MkTCx : (erased (Nat) dc) (erased (List (Nat)) ec nc fc ksc rc) (erased (Nat) dm) (erased (List (Nat)) em nm fm ksm as hl fe lab)
      (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en) (erased (GcOK dc ec nc rc as) ok) (erased (FunctorAll ec em as hl as) fu)
      (erased (Spk dm em nm fm fe lab) sp) (erased (Connected dm em nm fm) cn) -> (TCx dc ec nc fc ksc rc dm em nm fm ksm as hl fe lab)))

(def-fns _ $ (erased tm : (erased (Nat) dc dm) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl fe lab) (erased (TCx dc ec nc fc ksc rc dm em nm fm ksm as hl fe lab) cx)
    -> (erased (Hypermap dm em nm fm) h) (erased (Genus dm em nm fm (Zero)) gen) (erased (Bridgeless dm em nm fm) bl) (erased (AllOrder dm em (Succ (Succ (Zero)))) pl)
    (erased (AllOrder dm nm (Succ (Succ (Succ (Zero))))) cu) (erased (FaceLab dm fm lab) fl) (erased (Connected dm em nm fm) cn)
    (erased (List (Nat)) nfm nim fim) (erased (HPerm dm em nfm) qem) (erased (HPerm dm nm nim) qnm) (erased (HPerm dm fm fim) qfm))
  (let-match erased cx (MkTCx _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ en ok fu sp cn))
  (let-match erased sp (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
  (let ((erased nfm) (erased nim) (erased fim) (erased rnf) (erased qem) (erased qnm) (erased qfm)) (hyper-core dm em nm fm h))
  (values h gen bl pl cu fl cn nfm nim fim qem qnm qfm))

(def-fns _ $ (erased allab-in : (erased (List (Nat)) lab L) (erased (Nat) x) (subterm erased (List (Nat)) xs) (erased (AllLab lab L xs) al) (erased (In x xs) ix)
    -> (erased (Nat) l) (erased (Nth (Nat) lab x l) pl) (erased (In l L) il))
  (let-match erased al (AlCons _ _ xs1 y l pl il al1) (absurd (AlNil _ _) ix))
  (match erased ix _ ((InHere _ _) (values l pl il)) ((InThere _ _ _ ix1) (allab-in lab L x xs1 al1 ix1))))

; t is on a face of R or on none, told apart by the labels.
(def-fns _ $ (erased lab-dec : (erased (Nat) d t) (erased (List (Nat)) f lab R lr) (erased (FaceLab d f lab) fl) (erased (Respects lab R lr) rl) (erased (Lt t d) lt)
    -> (erased (Or (Fband f R t) (Kernel f R t)) r))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ fi _ ids rs gf pf gr io ro cl ll))
  (let ((erased l) (erased pl)) (nth-exists _ lab d t ll lt))
  (match erased (in-dec l lr) _
    ((OrL _ _ il)
      (let ((erased j) (erased ij) (erased pj)) (respects-in lab R lr l rl il))
      (OrL _ _ (MkFband f R t j ij (facelab-same d t j l f lab fl pl pj))))
    ((OrR _ _ ol) (OrR _ _ (MkKernel f R lab lr t l (facelab-rf d f lab fl) rl pl ol)))))

(def-fns _ $ (erased rp-unsnoc : (erased (List (Nat)) e f P) (erased (Nat) x a y) (subterm erased (RPath e f x (Cons (Nat) a P) y) rp)
    -> (erased (List (Nat)) Q) (erased (Nat) c ec) (erased (RPath e f x Q c) r1) (erased (Nth (Nat) e c ec) pc) (erased (SomePath f (Nil (Nat)) ec y) sc)
    (erased (AppN Q (Cons (Nat) y (Nil (Nat))) (Cons (Nat) a P)) ap))
  (let-match erased rp (RPCons _ _ _ _ ex _ _ pe sp rp1))
  (let-match erased rp1 (RPCons _ _ P1 _ ea b _ pa sa rp2) ((RPNil _ _ _) (values (Nil _) x ex (RPNil e f x) pe sp (AppNil _))))
  (let ((erased Q1) (erased c) (erased ec) (erased r1) (erased pc) (erased sc) (erased ap1)) (rp-unsnoc e f P1 a b y rp1))
  (values (Cons _ a Q1) c ec (RPCons e f Q1 x ex a c pe sp r1) pc sc (AppCons Q1 _ _ a ap1)))

(def-fns _ $ (erased resp-end : (erased (List (Nat)) ec fc em fm hl hp) (erased (Nat) x y hx w) (subterm erased (List (Nat)) p) (erased (RPath ec fc x p y) rp)
    (erased (RPath em fm hx hp w) rq) (erased (Respects hl (Cons (Nat) x p) (Cons (Nat) hx hp)) rh) -> (erased (Nth (Nat) hl y w) r))
  (let-match erased rh (RespCons _ _ _ _ _ px rh1))
  (let-match erased rp (RPCons _ _ p1 _ ex z _ pe sp rp1)
    ((RPNil _ _ _) (let-match erased rh1 (RespNil _)) (let-match erased rq (RPNil _ _ _)) px))
  (let-match erased rh1 (RespCons _ _ hp1 _ hz pz rh2))
  (let-match erased rq (RPCons _ _ _ _ eh _ _ _ _ rq1))
  (resp-end ec fc em fm hl hp1 z y hz w p1 rp1 rq1 rh1))

(def-fns _ $ (erased sub-rot : (erased (List (Nat)) X Y) (erased (Nat) a) (erased (AppN X (Cons (Nat) a (Nil (Nat))) Y) ap)
    -> (erased (WSub (Cons (Nat) a X) Y) s1) (erased (WSub Y (Cons (Nat) a X)) s2))
  (values (HSubCons a X Y (app-in-r X _ Y a ap (InHere a (Nil _))) (app-sub-l X _ Y X ap (sub-refl X)))
    (app-sub X _ Y (Cons _ a X) ap (sub-cons a X X (sub-refl X)) (HSubCons a (Nil _) (Cons _ a X) (InHere a X) (HSubNil _)))))

(def-fns _ $ (erased dist-unrot : (erased (List (Nat)) X Y) (erased (Nat) a) (erased (AppN X (Cons (Nat) a (Nil (Nat))) Y) ap) (erased (Distinct Y) dy)
    -> (erased (Distinct (Cons (Nat) a X)) r))
  (let ((erased oa) (erased ob)) (app-mid-notin (Nil _) Y X a ap dy))
  (let ((erased dx) (erased da)) (app-parts _ Y X ap dy))
  (DistCons a X oa dx))

(def-fns _ $ (erased dist-rot : (erased (List (Nat)) X Y) (erased (Nat) a) (erased (AppN X (Cons (Nat) a (Nil (Nat))) Y) ap) (erased (Distinct (Cons (Nat) a X)) da)
    -> (erased (Distinct Y) r))
  (let-match erased da (DistCons _ _ oa dx))
  (app-distinct X _ Y ap dx (DistCons a (Nil _) (NotInNil a) (DistNil)) (disj-one a X oa)))

; A ring a :: b :: P read from b.
(def-fns _ $ (erased ring-rot1 : (erased (List (Nat)) e f P) (erased (Nat) a b) (erased (Ring e f a (Cons (Nat) b P)) rg)
    -> (erased (List (Nat)) Q) (erased (AppN P (Cons (Nat) a (Nil (Nat))) Q) ap) (erased (Ring e f b Q) r))
  (let-match erased rg (MkRing _ _ _ _ w ew rp pw sw sm))
  (let-match erased rp (RPCons _ _ _ _ ea _ _ pa sa rp1))
  (let ((erased Q) (erased rq) (erased ap)) (rpath-join e f (Nil _) P b w ew a a rp1 pw sw (RPNil e f a)))
  (let-match erased sm (MkSimple _ _ lab ls rf rl dl))
  (let-match erased rl (RespCons _ _ ls1 _ la pla rl1))
  (let-match erased rl1 (RespCons _ _ lP _ lb plb rlP))
  (let ((erased LQ) (erased rLQ) (erased al)) (resp-app lab _ Q _ P ap lP rlP (RespCons lab (Nil _) (Nil _) a la pla (RespNil lab))))
  (values Q ap (MkRing e f Q b a ea rq pa sa (MkSimple f (Cons _ b Q) lab (Cons _ lb LQ) rf (RespCons lab Q LQ b lb plb rLQ)
    (dist-rot (Cons _ lb lP) (Cons _ lb LQ) la (AppCons lP _ LQ lb al) dl)))))

; diskF S is empty: every dart of diskN S is on a face of S, read off a ring S0 with the darts of S.
(def-adts $ (FEmpty : ((Nat) d) ((List (Nat)) e n f lab S) -> Type)
  enum
  (many MkFEmpty : (erased (Nat) d x0) (erased (List (Nat)) e n f lab S p hd zs lr) (erased (Ring e f x0 p) rg) (erased (WSub S (Cons (Nat) x0 p)) s1)
      (erased (WSub (Cons (Nat) x0 p) S) s2) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds) (erased (Respects lab (Cons (Nat) x0 p) lr) rl)
      (erased (AllLab lab lr hd) al) -> (FEmpty d e n f lab S)))

(def-fns _ $ (erased fe-band : (erased (Nat) d t) (erased (List (Nat)) e n f lab S) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (FaceLab d f lab) fl) (erased (FEmpty d e n f lab S) fm) (erased (DiskN n f S t) dn) (erased (Lt t d) lt) -> (erased (Fband f S t) r))
  (let-match erased fm (MkFEmpty _ x0 _ _ _ _ _ p hd zs lr rg s1 s2 ds rl al))
  (let ((erased dn0)) (disk-move n f S (Cons _ x0 p) t dn s1 s2))
  (let ((erased it)) (ds-mem d t x0 e n f p hd zs h gen rg (ring-under d x0 e n f p h rg) ds dn0 lt))
  (let ((erased l) (erased pl) (erased il)) (allab-in lab lr t hd al it))
  (let ((erased j) (erased ij) (erased pj)) (respects-in lab (Cons _ x0 p) lr l rl il))
  (fband-move f (Cons _ x0 p) S t (MkFband f _ t j ij (facelab-same d t j l f lab fl pl pj)) s2))

(def-fns _ $ (erased fe-move : (erased (Nat) d) (erased (List (Nat)) e n f lab S S2) (erased (FEmpty d e n f lab S) fm) (erased (WSub S S2) a) (erased (WSub S2 S) b)
    -> (erased (FEmpty d e n f lab S2) r))
  (let-match erased fm (MkFEmpty _ x0 _ _ _ _ _ p hd zs lr rg s1 s2 ds rl al))
  (MkFEmpty d x0 e n f lab S2 p hd zs lr rg (sub-trans S2 S _ b s1) (sub-trans _ S S2 s2 a) ds rl al))

; A Chords of the ring x0 :: p read as L = x1 :: A ++ x2 :: B, its labels taken from the ring's.
(def-fns _ $ (erased mk-chords : (erased (Nat) x0 x1 x2 z ez c ec w ew) (erased (List (Nat)) e n f p A B L) (erased (Ring e f x0 p) rg)
    (erased (WSub L (Cons (Nat) x0 p)) s1) (erased (WSub (Cons (Nat) x0 p) L) s2) (erased (Distinct L) dL) (erased (AppN (Cons (Nat) x1 A) (Cons (Nat) x2 B) L) ap)
    (erased (RPath e f x1 A c) ra) (erased (Nth (Nat) e c ec) pc) (erased (SomePath f (Nil (Nat)) ec x2) sc)
    (erased (RPath e f x2 B w) rb) (erased (Nth (Nat) e w ew) pw) (erased (SomePath f (Nil (Nat)) ew x1) sw)
    (erased (Nth (Nat) e z ez) pz) (erased (SomePath f (Nil (Nat)) x1 z) sz) (erased (SomePath f (Nil (Nat)) ez x2) sez)
    (erased (DiskN n f (Cons (Nat) x0 p) z) dz) (erased (NotIn z (Cons (Nat) x0 p)) oz) (erased (DiskN n f (Cons (Nat) x0 p) ez) dez) (erased (NotIn ez (Cons (Nat) x0 p)) oez)
    -> (erased (Chords e n f x0 p x1 A x2 B z ez) r))
  (let-match erased rg (MkRing _ _ _ _ y ey rp pe sp sm))
  (let-match erased sm (MkSimple _ _ lab ls rf rl dl))
  (let ((erased lsL) (erased rpL) (erased dlL)) (sub-labs lab _ ls rl dl L s1 dL))
  (let ((erased lsA) (erased lsB) (erased la) (erased lb) (erased al)) (resp-split lab _ L lsL _ ap rpL))
  (let ((erased da) (erased db)) (app-parts lsB lsL lsA al dlL))
  (MkChords e n f p A B L lab lsA lsB x0 x1 x2 z ez c ec w ew ap s1 s2 ra pc sc rb pw sw pz sz sez dz oz dez oez rf la lb da db
    (app-disj lsB lsL lsA al dlL) (app-disj _ L _ ap dL)))

(def-fns _ $ (erased rds-in : (erased (Nat) d x) (erased (List (Nat)) e n f S hd zs) (erased (RingDS d e n f S hd zs) rd) (erased (In x hd) ix)
    -> (erased (DiskN n f S x) dx) (erased (Lt x d) lx))
  (let-match erased rd (MkRingDS _ x0 _ _ _ p _ _ h gen pl rg pr ds))
  (values (ds-in d x x0 e n f p hd zs h gen rg (ring-under d x0 e n f p h rg) ds ix) (ds-lt d x e n _ hd zs ds (OrL _ _ ix))))

(def-fns _ $ (erased rds-mem : (erased (Nat) d x) (erased (List (Nat)) e n f S hd zs) (erased (RingDS d e n f S hd zs) rd) (erased (DiskN n f S x) dx) (erased (Lt x d) lx)
    -> (erased (In x hd) ix))
  (let-match erased rd (MkRingDS _ x0 _ _ _ p _ _ h gen pl rg pr ds))
  (ds-mem d x x0 e n f p hd zs h gen rg (ring-under d x0 e n f p h rg) ds dx lx))

; diskF_chord_ring, the direction trivial_hom_ring uses: a dart of diskN of the chord ring on none of its faces is in diskF R.
(def-fns _ $ (erased absurd fc-bad : (erased (Nat) d x0 x1 x2 z ez t) (erased (List (Nat)) e n f lab p A B hd zs hd1 zs1 hd2 zs2) (erased (Chords e n f x0 p x1 A x2 B z ez) cc)
    (erased (RingDS d e n f (Cons (Nat) x0 p) hd zs) d0) (erased (RingDS d e n f (Cons (Nat) z (Cons (Nat) x2 B)) hd1 zs1) d1)
    (erased (RingDS d e n f (Cons (Nat) ez (Cons (Nat) x1 A)) hd2 zs2) d2) (erased (Connected d e n f) cn) (erased (FaceLab d f lab) fl)
    (erased (FEmpty d e n f lab (Cons (Nat) x0 p)) fm) (erased (In t hd1) it) (erased (Kernel f (Cons (Nat) z (Cons (Nat) x2 B)) t) k) -> (erased (False) r))
  (let ((erased h) (erased gen) (erased pl)) (rds-map d e n f _ hd zs d0))
  (let ((erased dn1) (erased lt)) (rds-in d t e n f _ hd1 zs1 d1 it))
  (let-match erased (three-all d x0 x1 x2 z ez e n f p A B hd zs hd1 zs1 hd2 zs2 cc d0 d1 d2 cn t lt) (Th1 _ _ _ _ _ _ _ _ _ a b c)
    (absurd (Th2 _ _ _ _ _ _ _ _ _ a b c) (in-notin t hd1 it c))
    (absurd (Th0 _ _ _ _ _ _ _ _ _ a b c) (in-notin t hd1 it b)))
  (let-match erased (fe-band d t e n f lab _ h gen fl fm a lt) (MkFband _ _ _ w iw sp))
  (let-match erased sp (MkSomePath _ _ ws _ _ pth))
  (let-match erased (diskf-walk n f _ (Nil _) ws t w pth (MkDiskF n f _ t dn1 k)) (MkDiskF _ _ _ _ dnw kw))
  (let-match erased cc (MkChords _ _ _ _ _ _ L lb lsA lsB _ _ _ _ _ c ec wb ewb ap s1 s2 ra pc sc rb pw sw pz sz sez dz oz dez oez rf la lbb da db dj dd))
  (let ((erased d0c)) d0)
  (let-match erased d0c (MkRingDS _ _ _ _ _ _ _ _ _ _ _ rg0 pr0 ds0))
  (let ((erased lw)) (under-in _ w d (ring-under d x0 e n f p h rg0) iw))
  (match erased (app-in-inv _ _ L w ap (sub-in _ L w s2 iw)) _
    (absurd (OrL _ _ iA)
      (let ((erased iw2)) (rds-mem d w e n f _ hd2 zs2 d2 (rds-ring d w e n f _ hd2 zs2 d2 (InThere w ez _ iA) lw) lw))
      (let ((erased iw1)) (rds-mem d w e n f _ hd1 zs1 d1 dnw lw))
      (match erased (three-all d x0 x1 x2 z ez e n f p A B hd zs hd1 zs1 hd2 zs2 cc d0 d1 d2 cn w lw) _
        (absurd (Th1 _ _ _ _ _ _ _ _ _ a2 b2 c2) (in-notin w hd2 iw2 c2))
        (absurd (Th2 _ _ _ _ _ _ _ _ _ a2 b2 c2) (in-notin w hd1 iw1 c2))
        (absurd (Th0 _ _ _ _ _ _ _ _ _ a2 b2 c2) (in-notin w hd1 iw1 b2))))
    (absurd (OrR _ _ iB) (kernel-fband w w f _ kw (MkSomePath f (Nil _) (Nil _) w w (PathHere f (Nil _) w)) (InThere w z _ iB)))))

(def-fns _ $ (erased fc-all : (erased (Nat) d x0 x1 x2 z ez) (erased (List (Nat)) e n f lab p A B hd zs hd1 zs1 hd2 zs2 lr1) (erased (Chords e n f x0 p x1 A x2 B z ez) cc)
    (erased (RingDS d e n f (Cons (Nat) x0 p) hd zs) d0) (erased (RingDS d e n f (Cons (Nat) z (Cons (Nat) x2 B)) hd1 zs1) d1)
    (erased (RingDS d e n f (Cons (Nat) ez (Cons (Nat) x1 A)) hd2 zs2) d2) (erased (Connected d e n f) cn) (erased (FaceLab d f lab) fl)
    (erased (FEmpty d e n f lab (Cons (Nat) x0 p)) fm) (erased (Respects lab (Cons (Nat) z (Cons (Nat) x2 B)) lr1) rl1) (subterm erased (List (Nat)) xs)
    (erased (WSub xs hd1) sb) -> (erased (AllLab lab lr1 xs) r))
  (let-match erased sb (HSubCons t xs1 _ it sb1) ((HSubNil _) (AlNil lab lr1)))
  (let ((erased dn1) (erased lt)) (rds-in d t e n f _ hd1 zs1 d1 it))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ fi _ ids rs gf pf gr io ro cl ll))
  (let ((erased rest)) (fc-all d x0 x1 x2 z ez e n f lab p A B hd zs hd1 zs1 hd2 zs2 lr1 cc d0 d1 d2 cn fl fm rl1 xs1 sb1))
  (match erased (lab-dec d t f lab _ lr1 fl rl1 lt) _
    ((OrL _ _ fb)
      (let-match erased fb (MkFband _ _ _ w iw sp))
      (let-match erased sp (MkSomePath _ _ ws _ _ pth))
      (let ((erased l) (erased pl)) (nth-exists _ lab d t ll lt))
      (AlCons lab lr1 xs1 t l pl (in-map lab _ lr1 w l iw rl1 (path-label f lab (Nil _) ws t w l pth (facelab-rf d f lab fl) pl)) rest))
    (absurd (OrR _ _ k) (fc-bad d x0 x1 x2 z ez t e n f lab p A B hd zs hd1 zs1 hd2 zs2 cc d0 d1 d2 cn fl fm it k))))

(def-fns _ $ (erased fe-chord : (erased (Nat) d x0 x1 x2 z ez) (erased (List (Nat)) e n f lab p A B hd zs hd1 zs1 hd2 zs2) (erased (Chords e n f x0 p x1 A x2 B z ez) cc)
    (erased (RingDS d e n f (Cons (Nat) x0 p) hd zs) d0) (erased (RingDS d e n f (Cons (Nat) z (Cons (Nat) x2 B)) hd1 zs1) d1)
    (erased (RingDS d e n f (Cons (Nat) ez (Cons (Nat) x1 A)) hd2 zs2) d2) (erased (Connected d e n f) cn) (erased (FaceLab d f lab) fl)
    (erased (FEmpty d e n f lab (Cons (Nat) x0 p)) fm) -> (erased (FEmpty d e n f lab (Cons (Nat) z (Cons (Nat) x2 B))) r))
  (let ((erased d1c)) d1)
  (let-match erased d1c (MkRingDS _ _ _ _ _ _ _ _ h gen pl rg1 pr1 ds1))
  (let ((erased fl2)) fl)
  (let-match erased fl2 (MkFaceLab _ k _ fi _ ids rs gf pf gr io ro cl ll))
  (let ((erased lr1) (erased rl1)) (respects-exists lab _ d (ring-under d z e n f _ h rg1) ll))
  (let ((erased sr)) (sub-refl (Cons _ z (Cons _ x2 B))))
  (MkFEmpty d z e n f lab _ (Cons _ x2 B) hd1 zs1 lr1 rg1 sr sr ds1 rl1
    (fc-all d x0 x1 x2 z ez e n f lab p A B hd zs hd1 zs1 hd2 zs2 lr1 cc d0 d1 d2 cn fl fm rl1 hd1 (sub-refl hd1))))

(def-fns _ $ (erased app-fn : (erased (List (Nat)) ys zs zs2) (subterm erased (List (Nat)) xs) (erased (AppN xs ys zs) a) (erased (AppN xs ys zs2) b)
    -> (erased (Eq (List (Nat)) zs zs2) r))
  (let-match erased a (AppCons xs1 _ zs1 x a1) ((AppNil _) (let-match erased b (AppNil _)) (Refl _ zs)))
  (let-match erased b (AppCons _ _ zs3 _ b1))
  (let-match erased (app-fn ys zs1 zs3 xs1 a1 b1) (Refl _ _))
  (Refl _ zs))

(def-fns _ $ (erased app-assoc : (erased (List (Nat)) Y Z Y1 W) (subterm erased (List (Nat)) X) (erased (AppN X Y Z) a) (erased (AppN Y1 W Y) b)
    -> (erased (List (Nat)) M) (erased (AppN X Y1 M) c) (erased (AppN M W Z) d))
  (let-match erased a (AppCons X1 _ Z1 x a1) ((AppNil _) (values Y1 (AppNil Y1) b)))
  (let ((erased M1) (erased c1) (erased d1)) (app-assoc Y Z1 Y1 W X1 a1 b))
  (values (Cons _ x M1) (AppCons X1 Y1 M1 x c1) (AppCons M1 W Z1 x d1)))

(def-fns _ $ (erased rp-end-in : (erased (List (Nat)) e f) (erased (Nat) x y) (subterm erased (List (Nat)) p) (erased (RPath e f x p y) rp) -> (erased (In y (Cons (Nat) x p)) r))
  (let-match erased rp (RPCons _ _ p1 _ ex z _ pe sp rp1) ((RPNil _ _ _) (InHere x (Nil _))))
  (InThere y x _ (rp-end-in e f z y p1 rp1)))

(def-fns _ $ (erased snoc-lt : (erased (List (Nat)) Y Zl Wl) (erased (Nat) y b y2 n) (subterm erased (List (Nat)) X) (erased (AppN X (Cons (Nat) y (Cons (Nat) b Y)) Zl) ap)
    (erased (AppN X (Cons (Nat) y2 (Nil (Nat))) Wl) aw) (erased (Length (Nat) Zl n) lz) -> (erased (Nat) m) (erased (Length (Nat) Wl m) lw) (erased (Lt m n) lt))
  (let-match erased ap (AppCons X1 _ Z1 a ap1)
    ((AppNil _) (let-match erased aw (AppNil _)) (let-match erased lz (LengthCons _ _ _ n1 lz1)) (let-match erased lz1 (LengthCons _ _ _ n2 _))
      (values (Succ (Zero)) (LengthCons _ y2 (Nil _) (Zero) (LengthNil _)) (LtS (Zero) (Succ n2) (LtZ n2)))))
  (let-match erased aw (AppCons _ _ Wl1 _ aw1))
