      ((Add31) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add12))
      ((Add32) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add13))
      ((Add33) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC0 _)) (Add11))))
    ((IP312) (match erased p _
      ((Add00) (let-match erased pa (PC0 _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC0 _)) (Add00))
      ((Add01) (let-match erased pa (PC0 _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add03))
      ((Add02) (let-match erased pa (PC0 _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add01))
      ((Add03) (let-match erased pa (PC0 _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC3 _ _ _)) (Add02))
      ((Add10) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC1 _ _ _)) (Add30))
      ((Add11) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC0 _)) (Add33))
      ((Add12) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC3 _ _ _)) (Add31))
      ((Add13) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add32))
      ((Add20) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC2 _ _ _)) (Add10))
      ((Add21) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC3 _ _ _)) (Add13))
      ((Add22) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC0 _)) (Add11))
      ((Add23) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add12))
      ((Add30) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC3 _ _ _)) (Add20))
      ((Add31) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add23))
      ((Add32) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add21))
      ((Add33) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC0 _)) (Add22))))
    ((IP321) (match erased p _
      ((Add00) (let-match erased pa (PC0 _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC0 _)) (Add00))
      ((Add01) (let-match erased pa (PC0 _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add03))
      ((Add02) (let-match erased pa (PC0 _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add02))
      ((Add03) (let-match erased pa (PC0 _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC3 _ _ _)) (Add01))
      ((Add10) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC1 _ _ _)) (Add30))
      ((Add11) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC0 _)) (Add33))
      ((Add12) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC3 _ _ _)) (Add32))
      ((Add13) (let-match erased pa (PC1 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add31))
      ((Add20) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC2 _ _ _)) (Add20))
      ((Add21) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC3 _ _ _)) (Add23))
      ((Add22) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC0 _)) (Add22))
      ((Add23) (let-match erased pa (PC2 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add21))
      ((Add30) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC0 _)) (let-match erased pc (PC3 _ _ _)) (Add10))
      ((Add31) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC1 _ _ _)) (let-match erased pc (PC2 _ _ _)) (Add13))
      ((Add32) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC2 _ _ _)) (let-match erased pc (PC1 _ _ _)) (Add12))
      ((Add33) (let-match erased pa (PC3 _ _ _)) (let-match erased pb (PC3 _ _ _)) (let-match erased pc (PC0 _)) (Add11))))))

(def-fns _ $ (erased permc-inj : (erased (Perm) g) (erased (Col) a b c) (erased (IsPerm g) ip) (erased (PermC g a c) pa) (erased (PermC g b c) pb)
    -> (erased (Eq (Col) a b) e))
  (match erased ip _
    ((IP123) (match erased pa _ ((PC0 _) (let-match erased pb (PC0 _)) (Refl _ a)) ((PC1 _ _ _) (let-match erased pb (PC1 _ _ _)) (Refl _ a)) ((PC2 _ _ _) (let-match erased pb (PC2 _ _ _)) (Refl _ a)) ((PC3 _ _ _) (let-match erased pb (PC3 _ _ _)) (Refl _ a))))
    ((IP132) (match erased pa _ ((PC0 _) (let-match erased pb (PC0 _)) (Refl _ a)) ((PC1 _ _ _) (let-match erased pb (PC1 _ _ _)) (Refl _ a)) ((PC2 _ _ _) (let-match erased pb (PC2 _ _ _)) (Refl _ a)) ((PC3 _ _ _) (let-match erased pb (PC3 _ _ _)) (Refl _ a))))
    ((IP213) (match erased pa _ ((PC0 _) (let-match erased pb (PC0 _)) (Refl _ a)) ((PC1 _ _ _) (let-match erased pb (PC1 _ _ _)) (Refl _ a)) ((PC2 _ _ _) (let-match erased pb (PC2 _ _ _)) (Refl _ a)) ((PC3 _ _ _) (let-match erased pb (PC3 _ _ _)) (Refl _ a))))
    ((IP231) (match erased pa _ ((PC0 _) (let-match erased pb (PC0 _)) (Refl _ a)) ((PC1 _ _ _) (let-match erased pb (PC1 _ _ _)) (Refl _ a)) ((PC2 _ _ _) (let-match erased pb (PC2 _ _ _)) (Refl _ a)) ((PC3 _ _ _) (let-match erased pb (PC3 _ _ _)) (Refl _ a))))
    ((IP312) (match erased pa _ ((PC0 _) (let-match erased pb (PC0 _)) (Refl _ a)) ((PC1 _ _ _) (let-match erased pb (PC1 _ _ _)) (Refl _ a)) ((PC2 _ _ _) (let-match erased pb (PC2 _ _ _)) (Refl _ a)) ((PC3 _ _ _) (let-match erased pb (PC3 _ _ _)) (Refl _ a))))
    ((IP321) (match erased pa _ ((PC0 _) (let-match erased pb (PC0 _)) (Refl _ a)) ((PC1 _ _ _) (let-match erased pb (PC1 _ _ _)) (Refl _ a)) ((PC2 _ _ _) (let-match erased pb (PC2 _ _ _)) (Refl _ a)) ((PC3 _ _ _) (let-match erased pb (PC3 _ _ _)) (Refl _ a))))))

(def-fns _ $ (erased permc-fn : (erased (Perm) g) (erased (Col) c d d2) (erased (PermC g c d) p) (erased (PermC g c d2) q) -> (erased (Eq (Col) d d2) e))
  (match erased p _
    ((PC0 _) (let-match erased q (PC0 _)) (Refl _ d))
    ((PC1 _ _ _) (let-match erased q (PC1 _ _ _)) (Refl _ d))
    ((PC2 _ _ _) (let-match erased q (PC2 _ _ _)) (Refl _ d))
    ((PC3 _ _ _) (let-match erased q (PC3 _ _ _)) (Refl _ d))))

; k2 numbers the image under g of the colour numbered k.
(def-adts $ (NPerm : ((Perm) g) ((Nat) k k2) -> Type)
  enum
  (many MkNPerm : (erased (Perm) g) (erased (Nat) k k2) (erased (Col) c c2) (erased (NCol k c) p) (erased (PermC g c c2) q) (erased (NCol k2 c2) p2)
      -> (NPerm g k k2)))

(def-adts $ (NPermL : ((Perm) g) ((List (Nat)) ks ks2) -> Type)
  enum
  (many NPLNil : (erased (Perm) g) -> (NPermL g (Nil (Nat)) (Nil (Nat))))
  (many NPLCons : (erased (Perm) g) (erased (Nat) k k2) (erased (List (Nat)) ks ks2) (erased (NPerm g k k2) p) (erased (NPermL g ks ks2) rest)
      -> (NPermL g (Cons (Nat) k ks) (Cons (Nat) k2 ks2))))

(def-fns _ $ (erased nperm-fn : (erased (Perm) g) (erased (Nat) k k2 k3) (erased (NPerm g k k2) p) (erased (NPerm g k k3) q) -> (erased (Eq (Nat) k2 k3) e))
  (let-match erased p (MkNPerm _ _ _ c c2 pc qc pc2))
  (let-match erased q (MkNPerm _ _ _ c3 c4 pc3 qc3 pc4))
  (let-match erased (ncol-fn k c c3 pc pc3) (Refl _ _))
  (let-match erased (permc-fn g c c2 c4 qc qc3) (Refl _ _))
  (ncol-inj k2 k3 c2 pc2 pc4))

(def-fns _ $ (erased npl-fn : (erased (Perm) g) (erased (List (Nat)) ks a b) (subterm erased (NPermL g ks a) p) (erased (NPermL g ks b) q)
    -> (erased (Eq (List (Nat)) a b) e))
  (let-match erased p (NPLCons _ k k2 ks1 a1 pk p1) ((NPLNil _) (let-match erased q (NPLNil _)) (Refl _ a)))
  (let-match erased q (NPLCons _ _ k3 _ b1 qk q1))
  (let-match erased (nperm-fn g k k2 k3 pk qk) (Refl _ _))
  (let-match erased (npl-fn g ks1 a1 b1 p1 q1) (Refl _ _))
  (Refl _ a))

(def-fns _ $ (erased npl-ex : (erased (Perm) g) (erased (List (Nat)) ks) (erased (IsPerm g) ip) (subterm erased (Under ks 4) u)
    -> (erased (List (Nat)) ks2) (erased (NPermL g ks ks2) r))
  (let-match erased u (UnderCons ks1 k _ lk u1) ((UnderNil _) (values (Nil (Nat)) (NPLNil g))))
  (let ((erased c) (erased pc)) (ncol-ex k lk))
  (let ((erased c2) (erased qc)) (permc-ex g c ip))
  (let ((erased k2) (erased _) (erased pc2)) (ncol-num c2))
  (let ((erased ks2) (erased r)) (npl-ex g ks1 ip u1))
  (values (Cons (Nat) k2 ks2) (NPLCons g k k2 ks1 ks2 (MkNPerm g k k2 c c2 pc qc pc2) r)))

(def-fns _ $ (erased npl-nth : (erased (Perm) g) (erased (List (Nat)) ks ks2) (erased (Nat) j l) (subterm erased (NPermL g ks ks2) np) (erased (Nth (Nat) ks j l) p)
    -> (erased (Nat) l2) (erased (Nth (Nat) ks2 j l2) q) (erased (NPerm g l l2) r))
  (let-match erased np (NPLCons _ k k2 ks1 ks3 pk np1) (absurd (NPLNil _) p))
  (let-match erased p (NthThere _ _ _ j1 _ p1) ((NthHere _ _ _) (values k2 (NthHere _ k2 ks3) pk)))
  (let ((erased l2) (erased q) (erased r)) (npl-nth g ks1 ks3 j1 l np1 p1))
  (values l2 (NthThere _ k2 ks3 j1 l2 q) r))

(def-fns _ $ (erased respects-perm : (erased (Perm) g) (erased (List (Nat)) ks ks2 xs ls) (subterm erased (Respects ks xs ls) rp) (erased (NPermL g ks ks2) np)
    -> (erased (List (Nat)) ls2) (erased (Respects ks2 xs ls2) r) (erased (NPermL g ls ls2) nq))
  (let-match erased rp (RespCons _ xs1 ls1 j l p rp1) ((RespNil _) (values (Nil (Nat)) (RespNil ks2) (NPLNil g))))
  (let ((erased l2) (erased q) (erased pl)) (npl-nth g ks ks2 j l np p))
  (let ((erased ls2) (erased r) (erased nq)) (respects-perm g ks ks2 xs1 ls1 rp1 np))
  (values (Cons (Nat) l2 ls2) (RespCons ks2 xs1 ls2 j l2 q r) (NPLCons g l l2 ls1 ls2 pl nq)))

(def-fns _ $ (erased differ-perm : (erased (Perm) g) (erased (List (Nat)) xs ys xs2 ys2) (erased (IsPerm g) ip) (subterm erased (Differ xs ys) df)
    (erased (NPermL g xs xs2) px) (erased (NPermL g ys ys2) py) -> (erased (Differ xs2 ys2) r))
  (let-match erased df (DifferCons xs1 ys1 x y ne df1) ((DifferNil) (let-match erased px (NPLNil _)) (let-match erased py (NPLNil _)) (DifferNil)))
  (let-match erased px (NPLCons _ _ x2 _ xs3 qx px1))
  (let-match erased py (NPLCons _ _ y2 _ ys3 qy py1))
  (let-match erased qx (MkNPerm _ _ _ cx cx2 nx gx nx2))
  (let-match erased qy (MkNPerm _ _ _ cy cy2 ny gy ny2))
  (let ((erased ne2)) (let-match erased (nat-eq x2 y2) (Unequal _ _ _ _ q)
    (absurd (Equal _ _ _) (let-match erased (ncol-fn x2 cx2 cy2 nx2 ny2) (Refl _ _)) (let-match erased (permc-inj g cx cy cx2 ip gx gy) (Refl _ _))
      (let-match erased (ncol-inj x y cx nx ny) (Refl _ _)) (apart-irrefl x ne))) q)
  (DifferCons xs3 ys3 x2 y2 ne2 (differ-perm g xs1 ys1 xs3 ys3 ip df1 px1 py1)))

(def-fns _ $ (erased under-perm : (erased (Perm) g) (erased (List (Nat)) ks ks2) (subterm erased (NPermL g ks ks2) np) -> (erased (Under ks2 4) u))
  (let-match erased np (NPLCons _ _ k2 ks1 ks3 pk np1) ((NPLNil _) (UnderNil 4)))
  (let-match erased pk (MkNPerm _ _ _ _ c2 _ _ pc2))
  (let ((erased k3) (erased lk) (erased pc3)) (ncol-num c2))
  (let-match erased (ncol-inj k2 k3 c2 pc2 pc3) (Refl _ _))
  (UnderCons ks3 k2 4 lk (under-perm g ks1 ks3 np1)))

(def-fns _ $ (erased ncols-perm : (erased (Perm) g) (erased (List (Nat)) ns ns2) (erased (List (Col)) cs) (subterm erased (NCols ns cs) nc) (erased (NPermL g ns ns2) np)
    -> (erased (List (Col)) cs2) (erased (NCols ns2 cs2) nc2) (erased (PermT g cs cs2) pt))
  (let-match erased nc (NCsCons k c ns1 cs1 pk nc1) ((NCsNil) (let-match erased np (NPLNil _)) (values (Nil (Col)) (NCsNil) (PTNil g))))
  (let-match erased np (NPLCons _ _ k2 _ ns3 q np1))
  (let-match erased q (MkNPerm _ _ _ c0 c2 p0 gc pc2))
  (let-match erased (ncol-fn k c c0 pk p0) (Refl _ _))
  (let ((erased cs2) (erased nc2) (erased pt)) (ncols-perm g ns1 ns3 cs1 nc1 np1))
  (values (Cons (Col) c2 cs2) (NCsCons k2 c2 ns3 cs2 pc2 nc2) (PTCons g c c2 cs1 cs2 gc pt)))

(def-fns _ $ (erased ctr-perm : (erased (Perm) g) (erased (Col) c0 x c02 x2) (erased (List (Col)) cs cs2 et) (erased (IsPerm g) ip) (subterm erased (CTr c0 x cs et) ct)
    (erased (PermC g c0 c02) p0) (erased (PermC g x x2) px) (erased (PermT g cs cs2) pt) -> (erased (List (Col)) et2) (erased (CTr c02 x2 cs2 et2) ct2)
    (erased (PermT g et et2) pe))
  (match erased ct _
    ((CTLast _ _ t p)
      (let-match erased pt (PTNil _))
      (let ((erased t2) (erased pq)) (permc-ex g t ip))
      (values (Cons (Col) t2 (Nil (Col))) (CTLast c02 x2 t2 (permc-add g x c0 t x2 c02 t2 ip p px p0 pq)) (PTCons g t t2 (Nil (Col)) (Nil (Col)) pq (PTNil g))))
    ((CTStep _ _ y t cs1 et1 p ct1)
      (let-match erased pt (PTCons _ _ y2 _ cs3 py pt1))
      (let ((erased t2) (erased pq)) (permc-ex g t ip))
      (let ((erased et3) (erased ct3) (erased pe1)) (ctr-perm g c0 y c02 y2 cs1 cs3 et1 ip ct1 p0 py pt1))
      (values (Cons (Col) t2 et3) (CTStep c02 x2 y2 t2 cs3 et3 (permc-add g x y t x2 y2 t2 ip p px py pq) ct3) (PTCons g t t2 et1 et3 pq pe1)))))

(def-fns _ $ (erased permt-fn : (erased (Perm) g) (erased (List (Col)) et et2 et3) (subterm erased (PermT g et et2) p) (erased (PermT g et et3) q)
    -> (erased (Eq (List (Col)) et2 et3) e))
  (let-match erased p (PTCons _ c d et1 et4 pc p1) ((PTNil _) (let-match erased q (PTNil _)) (Refl _ et2)))
  (let-match erased q (PTCons _ _ d2 _ et5 qc q1))
  (let-match erased (permc-fn g c d d2 pc qc) (Refl _ _))
  (let-match erased (permt-fn g et1 et4 et5 p1 q1) (Refl _ _))
  (Refl _ et2))

; A colour permutation of a ring trace is a ring trace (gcol_perm).
(def-fns _ $ (erased cpcol-perm : (erased (List (Step)) cp) (erased (List (Col)) et et2) (erased (Perm) g) (erased (CpCol cp et) cc) (erased (IsPerm g) ip)
    (erased (PermT g et et2) pt) -> (erased (CpCol cp et2) res))
  (let-match erased cc (MkCpCol _ d e f r ks rc cs _ cm col rr nc tr))
  (let-match erased col (MkFourColoring _ _ _ ke face ce edge four))
  (let ((erased ks2) (erased np)) (npl-ex g ks ip four))
  (let ((erased ks3) (erased face2) (erased nf)) (respects-perm g ks ks2 f ks face np))
  (let-match erased (npl-fn g ks ks3 ks2 nf np) (Refl _ _))
  (let ((erased ke2) (erased ce2) (erased ne)) (respects-perm g ks ks2 e ke ce np))
  (let ((erased rc2) (erased rr2) (erased nr)) (respects-perm g ks ks2 r rc rr np))
  (let ((erased cs2) (erased nc2) (erased pcs)) (ncols-perm g rc rc2 cs nc nr))
  (let-match erased tr (MkTrace c cs1 _ ct))
  (let-match erased pcs (PTCons _ _ c2 _ cs3 pc pcs1))
  (let ((erased et3) (erased ct3) (erased pe)) (ctr-perm g c c c2 c2 cs1 cs3 et ip ct pc pc pcs1))
  (let-match erased (permt-fn g et et3 et2 pe pt) (Refl _ _))
  (MkCpCol cp d e f r ks2 rc2 cs2 et2 cm (MkFourColoring e f ks2 ke2 face2 ce2 (differ-perm g ke ks ke2 ks2 ip edge ne np) (under-perm g ks ks2 np)) rr2 nc2
    (MkTrace c2 cs3 et2 ct3)))

; g2 undoes g.
(def-adts $ (PermInv : ((Perm) g g2) -> Type)
  enum
  (many PI123 : -> (PermInv (MkPerm (C1) (C2) (C3)) (MkPerm (C1) (C2) (C3))))
  (many PI132 : -> (PermInv (MkPerm (C1) (C3) (C2)) (MkPerm (C1) (C3) (C2))))
  (many PI213 : -> (PermInv (MkPerm (C2) (C1) (C3)) (MkPerm (C2) (C1) (C3))))
  (many PI231 : -> (PermInv (MkPerm (C2) (C3) (C1)) (MkPerm (C3) (C1) (C2))))
  (many PI312 : -> (PermInv (MkPerm (C3) (C1) (C2)) (MkPerm (C2) (C3) (C1))))
  (many PI321 : -> (PermInv (MkPerm (C3) (C2) (C1)) (MkPerm (C3) (C2) (C1)))))

(def-fns _ $ (erased perminv-ex : (erased (Perm) g) (erased (IsPerm g) ip) -> (erased (Perm) g2) (erased (PermInv g g2) pi) (erased (IsPerm g2) ip2))
  (match erased ip _
    ((IP123) (values (MkPerm (C1) (C2) (C3)) (PI123) (IP123)))
    ((IP132) (values (MkPerm (C1) (C3) (C2)) (PI132) (IP132)))
    ((IP213) (values (MkPerm (C2) (C1) (C3)) (PI213) (IP213)))
    ((IP231) (values (MkPerm (C3) (C1) (C2)) (PI231) (IP312)))
    ((IP312) (values (MkPerm (C2) (C3) (C1)) (PI312) (IP231)))
    ((IP321) (values (MkPerm (C3) (C2) (C1)) (PI321) (IP321)))))

(def-fns _ $ (erased permc-invert : (erased (Perm) g g2) (erased (Col) c d) (erased (PermInv g g2) pi) (erased (PermC g c d) p) -> (erased (PermC g2 d c) r))
  (match erased pi _
    ((PI123) (match erased p _ ((PC0 _) (PC0 (MkPerm (C1) (C2) (C3)))) ((PC1 _ _ _) (PC1 (C1) (C2) (C3))) ((PC2 _ _ _) (PC2 (C1) (C2) (C3))) ((PC3 _ _ _) (PC3 (C1) (C2) (C3)))))
    ((PI132) (match erased p _ ((PC0 _) (PC0 (MkPerm (C1) (C3) (C2)))) ((PC1 _ _ _) (PC1 (C1) (C3) (C2))) ((PC2 _ _ _) (PC3 (C1) (C3) (C2))) ((PC3 _ _ _) (PC2 (C1) (C3) (C2)))))
    ((PI213) (match erased p _ ((PC0 _) (PC0 (MkPerm (C2) (C1) (C3)))) ((PC1 _ _ _) (PC2 (C2) (C1) (C3))) ((PC2 _ _ _) (PC1 (C2) (C1) (C3))) ((PC3 _ _ _) (PC3 (C2) (C1) (C3)))))
    ((PI231) (match erased p _ ((PC0 _) (PC0 (MkPerm (C3) (C1) (C2)))) ((PC1 _ _ _) (PC2 (C3) (C1) (C2))) ((PC2 _ _ _) (PC3 (C3) (C1) (C2))) ((PC3 _ _ _) (PC1 (C3) (C1) (C2)))))
    ((PI312) (match erased p _ ((PC0 _) (PC0 (MkPerm (C2) (C3) (C1)))) ((PC1 _ _ _) (PC3 (C2) (C3) (C1))) ((PC2 _ _ _) (PC1 (C2) (C3) (C1))) ((PC3 _ _ _) (PC2 (C2) (C3) (C1)))))
    ((PI321) (match erased p _ ((PC0 _) (PC0 (MkPerm (C3) (C2) (C1)))) ((PC1 _ _ _) (PC3 (C3) (C2) (C1))) ((PC2 _ _ _) (PC2 (C3) (C2) (C1))) ((PC3 _ _ _) (PC1 (C3) (C2) (C1)))))))

; h is p132 after g.
(def-adts $ (P132Comp : ((Perm) g h) -> Type)
  enum
  (many PK123 : -> (P132Comp (MkPerm (C1) (C2) (C3)) (MkPerm (C1) (C3) (C2))))
  (many PK132 : -> (P132Comp (MkPerm (C1) (C3) (C2)) (MkPerm (C1) (C2) (C3))))
  (many PK213 : -> (P132Comp (MkPerm (C2) (C1) (C3)) (MkPerm (C3) (C1) (C2))))
