  (let-match erased (nat-eq x ez) (Unequal _ _ _ _ nx)
    ((Equal _ _ _) (let-match erased (nth-fn _ f2 ez c ez px (fixed-at f2 s2 ez ff2 (InHere ez _))) (Refl _ _)) pl))
  (let ((erased c0) (erased p0) (erased _)) (perm-nth d x f fi pf lx))
