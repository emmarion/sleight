(def-fns _ $ (erased lift-edge : (erased (Nat) d z ez cz cez) (erased (List (Nat)) e n f s k1 k0 e2 n2 f2) (erased (List (Bond)) g)
    (erased (Hypermap d e n f) h) (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (LiveColoring d (Cons (Nat) ez (Cons (Nat) z s)) e2 f2 k1) lc1)
    (erased (Set2 k1 z cz ez cez k0) st) (erased (Apart (Nat) Lt cz cez) nzc) (erased (Length (Nat) e d) le) (subterm erased (Fun e g) fg)
    -> (erased (EdgeLive s k0 g) r))
  (let-match erased fg (FunCons _ g1 x y px fg1) ((FunNil _) (ELNil s k0)))
  (let ((erased rest)) (lift-edge d z ez cz cez e n f s k1 k0 e2 n2 f2 g1 h ct lc1 st nzc le fg1))
  (let-match erased (in-dec x s) (OrR _ _ out) ((OrL _ _ ins) (ELDead s k0 g1 x y ins rest)))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased ct (MkCut2 _ _ _ fz fez _ _ _ e1 n1 f1 _ _ _ h1 ske skf skn skf2 h2 pez pze ne pfz nfz pfez nfez))
  (let ((erased k0z)) (set2-z k1 k0 z cz ez cez st))
  (let ((erased k0ez)) (set2-ez k1 k0 z cz ez cez st))
  (let-match erased (nat-eq x z) (Unequal _ _ _ _ nxz)
    ((Equal _ _ _) (let-match erased (nth-fn _ e z y ez px pez) (Refl _ _)) (ELLive s k0 g1 x y cz cez out k0z k0ez nzc rest)))
  (let-match erased (nat-eq x ez) (Unequal _ _ _ _ nx)
    ((Equal _ _ _) (let-match erased (nth-fn _ e ez y z px pze) (Refl _ _)) (ELLive s k0 g1 x y cez cz out k0ez k0z (apart-sym cz cez nzc) rest)))
  (let ((erased lx)) (nth-lt-length _ e x d y px le))
  (let ((erased ly)) (perm-val d x y e nf pe px))
  (let ((erased s2)) (Cons (Nat) ez (Cons (Nat) z s)))
  (let ((erased a) (erased pa)) (lc-col d x s2 e2 f2 k1 lc1 lx))
  (let ((erased b) (erased pb)) (lc-col d y s2 e2 f2 k1 lc1 ly))
  (let ((erased nyz)) (img-apart d x ez y z e nf pe px pze nx))
  (let ((erased ny)) (img-apart d x z y ez e nf pe px pez nxz))
  (ELLive s k0 g1 x y a b out (set2-other k1 k0 z cz ez cez x a st pa nxz nx) (set2-other k1 k0 z cz ez cez y b st pb nyz ny)
    (lc-edge d x y a b s2 e2 f2 k1 lc1 lx (NotInCons x ez _ nx (NotInCons x z s nxz out)) (cut-e2 d z ez x y e n f e2 n2 f2 h ct px nxz nx) pa pb) rest))

; invh_col_s of Kempe_map: a colouring k1 of the contraction gives one of the map, with z coloured cz and ez the colour of
; its face.
(def-fns _ $ (erased cut-lift : (erased (Nat) d z ez fz fez cz cez) (erased (List (Nat)) e n f s k1 e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (LiveColoring d (Cons (Nat) ez (Cons (Nat) z s)) e2 f2 k1) lc1)
    (erased (Nth (Nat) f z fz) pfz) (erased (Nth (Nat) f ez fez) pfez) (erased (Or (Eq (Nat) fz z) (Nth (Nat) k1 fz cz)) hz)
    (erased (Nth (Nat) k1 fez cez) hez) (erased (Lt cz 4) lcz) (erased (Apart (Nat) Lt cz cez) nzc)
    -> (erased (List (Nat)) k0) (erased (LiveColoring d s e f k0) lc0) (erased (Set2 k1 z cz ez cez k0) st))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased ct (MkCut2 _ _ _ _ _ _ _ _ e1 n1 f1 _ _ _ h1 ske skf skn skf2 h2 pez pze ne _ _ _ _))
  (let-match erased lc1 (MkLC _ _ _ _ _ ge2 gr2 rf2 el2 u1 lk1))
  (let ((erased lz)) (nth-lt-length _ e z d ez pez le))
  (let ((erased lez)) (perm-val d z ez e nf pe pez))
  (let ((erased k0) (erased st)) (set2-exists d k1 z cz ez cez lk1 lz lez ne))
  (let-match erased st (MkSet2 _ k _ _ _ _ _ s1 s2 _))
  (let ((erased lk0)) (setnth-length _ k ez d cez k0 s2 (setnth-length _ k1 z d cz k s1 lk1)))
  (let ((erased u0)) (under-setnth k k0 ez cez 4 (under-setnth k1 k z cz 4 u1 s1 lcz) s2 (under-nth k1 fez cez 4 u1 hez)))
  (let ((erased gf) (erased grf)) (graph-exists d f lf))
  (let ((erased ge) (erased gre)) (graph-exists d e le))
  (values k0
    (MkLC d s e f k0 ge gre
      (graph-resp d f k0 gf grf (lift-const d z ez fz fez cz cez e n f s k1 k0 e2 n2 f2 gf h ct lc1 st pfz pfez hz hez lf (graph-fun d f gf grf)) lk0)
      (lift-edge d z ez cz cez e n f s k1 k0 e2 n2 f2 ge h ct lc1 st nzc le (graph-fun d e ge gre)) u0 lk0)
    st))

(def-fns _ $ (erased addc-comm : (erased (Col) a b c) (erased (AddK a b c) p) -> (erased (AddK b a c) q))
  (match erased p _ ((AZL _) (AZR c)) ((AZR _) (AZL c)) ((ASame _) (ASame a)) ((AThird _ _ _ t) (AThird b a c (third-12 a b c t)))))

(def-fns _ $ (erased xor-fn : (erased (Bool) a b c c2) (erased (Xor a b c) p) (erased (Xor a b c2) q) -> (erased (Eq (Bool) c c2) e))
  (match erased p _
    ((XFF) (let-match erased q (XFF)) (Refl _ c))
    ((XFT) (let-match erased q (XFT)) (Refl _ c))
    ((XTF) (let-match erased q (XTF)) (Refl _ c))
    ((XTT) (let-match erased q (XTT)) (Refl _ c))))

(def-fns _ $ (erased xor-assoc : (erased (Bool) a b c ab abc bc abc2) (erased (Xor a b ab) p1) (erased (Xor ab c abc) p2) (erased (Xor b c bc) p3)
    (erased (Xor a bc abc2) p4) -> (erased (Eq (Bool) abc abc2) e))
  (match erased p1 _
    ((XFF) (match erased p3 _
      ((XFF) (let-match erased p2 (XFF)) (let-match erased p4 (XFF)) (Refl _ abc))
      ((XFT) (let-match erased p2 (XFT)) (let-match erased p4 (XFT)) (Refl _ abc))))
    ((XFT) (match erased p3 _
      ((XTF) (let-match erased p2 (XTF)) (let-match erased p4 (XFT)) (Refl _ abc))
      ((XTT) (let-match erased p2 (XTT)) (let-match erased p4 (XFF)) (Refl _ abc))))
    ((XTF) (match erased p3 _
      ((XFF) (let-match erased p2 (XTF)) (let-match erased p4 (XTF)) (Refl _ abc))
      ((XFT) (let-match erased p2 (XTT)) (let-match erased p4 (XTT)) (Refl _ abc))))
    ((XTT) (match erased p3 _
      ((XTF) (let-match erased p2 (XFF)) (let-match erased p4 (XTT)) (Refl _ abc))
      ((XTT) (let-match erased p2 (XFT)) (let-match erased p4 (XTF)) (Refl _ abc))))))

(def-fns _ $ (erased cb-inj : (erased (Col) c c2) (erased (Bool) x y) (erased (CB c x y) p) (erased (CB c2 x y) q) -> (erased (Eq (Col) c c2) e))
  (match erased p _
    ((CB0) (let-match erased q (CB0)) (Refl _ c))
    ((CB1) (let-match erased q (CB1)) (Refl _ c))
    ((CB2) (let-match erased q (CB2)) (Refl _ c))
    ((CB3) (let-match erased q (CB3)) (Refl _ c))))

(def-fns _ $ (erased addc-assoc : (erased (Col) a b c ab abc bc abc2) (erased (AddK a b ab) p1) (erased (AddK ab c abc) p2) (erased (AddK b c bc) p3)
    (erased (AddK a bc abc2) p4) -> (erased (Eq (Col) abc abc2) e))
  (let ((erased xa) (erased ya) (erased qa)) (cb-exists a))
  (let ((erased xb) (erased yb) (erased qb)) (cb-exists b))
  (let ((erased xc) (erased yc) (erased qc)) (cb-exists c))
  (let ((erased x1) (erased y1) (erased r1) (erased s1) (erased q1)) (addc-bits a b ab xa ya xb yb p1 qa qb))
  (let ((erased x2) (erased y2) (erased r2) (erased s2) (erased q2)) (addc-bits ab c abc x1 y1 xc yc p2 q1 qc))
  (let ((erased x3) (erased y3) (erased r3) (erased s3) (erased q3)) (addc-bits b c bc xb yb xc yc p3 qb qc))
  (let ((erased x4) (erased y4) (erased r4) (erased s4) (erased q4)) (addc-bits a bc abc2 xa ya x3 y3 p4 qa q3))
  (let-match erased (xor-assoc xa xb xc x1 x2 x3 x4 r1 r2 r3 r4) (Refl _ _))
  (let-match erased (xor-assoc ya yb yc y1 y2 y3 y4 s1 s2 s3 s4) (Refl _ _))
  (cb-inj abc abc2 x2 y2 q2 q4))

; (l + b) + (b + a) = l + a.
(def-fns _ $ (erased addc-tri : (erased (Col) l b a u v t) (erased (AddK l b u) p) (erased (AddK b a v) q) (erased (AddK l a t) r) -> (erased (AddK u v t) s))
  (let ((erased w) (erased pw)) (addc-total u v))
  (let ((erased bb) (erased pbb)) (addc-total b b))
  (let-match erased (addc-fn b b bb (C0) pbb (ASame b)) (Refl _ _))
  (let ((erased ba) (erased pba)) (addc-total (C0) a))
  (let-match erased (addc-fn (C0) a ba a pba (AZL a)) (Refl _ _))
  (let ((erased bba) (erased pbba)) (addc-total b v))
  (let-match erased (addc-assoc b b a (C0) a v bba pbb pba q pbba) (Refl _ _))
  (let-match erased (addc-assoc l b v u w a t p pw pbba r) (Refl _ _))
  pw)

(def-fns _ $ (erased addc-zero : (erased (Col) a b) (erased (AddK a b (C0)) p) -> (erased (Eq (Col) a b) e))
  (match erased p _ ((AZL _) (Refl _ a)) ((AZR _) (Refl _ a)) ((ASame _) (Refl _ a)) (absurd (AThird _ _ _ t) t)))

; pairmap addc p lc = et.
(def-adts $ (PairFrom : ((Col) p) ((List (Col)) lc et) -> Type)
  enum
  (many PFNil : (erased (Col) p) -> (PairFrom p (Nil (Col)) (Nil (Col))))
  (many PFCons : (erased (Col) p c s) (erased (List (Col)) lc et) (erased (AddK p c s) a) (erased (PairFrom c lc et) t)
      -> (PairFrom p (Cons (Col) c lc) (Cons (Col) s et))))

; l is the last of p :: lc.
(def-adts $ (LastFrom : (Type A) (A p) ((List A) lc) (A l) -> Type)
  enum
  (many LFNil : (erased Type A) (erased A p) -> (LastFrom A p (Nil A) p))
  (many LFCons : (erased Type A) (erased A p c l) (erased (List A) lc) (erased (LastFrom A c lc l) t) -> (LastFrom A p (Cons A c lc) l)))

; Gonthier's urtrace: et lists the sums of consecutive colours of lc, the first with the last.
(def-adts $ (UTr : ((List (Col)) lc et) -> Type)
  enum
  (many UTNil : -> (UTr (Nil (Col)) (Nil (Col))))
  (many UTCons : (erased (Col) c l) (erased (List (Col)) lc et) (erased (LastFrom (Col) c lc l) lt) (erased (PairFrom l (Cons (Col) c lc) et) pf)
      -> (UTr (Cons (Col) c lc) et)))

(def-fns _ $ (erased pairfrom-exists : (erased (Col) p) (subterm erased (List (Col)) lc) -> (erased (List (Col)) et) (erased (PairFrom p lc et) r))
  (let-match erased lc (Cons _ c lc1) ((Nil _) (values (Nil _) (PFNil p))))
  (let ((erased s) (erased a)) (addc-total p c))
  (let ((erased et) (erased t)) (pairfrom-exists c lc1))
  (values (Cons _ s et) (PFCons p c s lc1 et a t)))

(def-fns _ $ (erased pairfrom-fn : (erased (Col) p) (erased (List (Col)) lc et et2) (subterm erased (PairFrom p lc et) a) (erased (PairFrom p lc et2) b)
    -> (erased (Eq (List (Col)) et et2) e))
  (let-match erased a (PFCons _ c s lc1 et1 ad a1) ((PFNil _) (let-match erased b (PFNil _)) (Refl _ et)))
  (let-match erased b (PFCons _ _ s2 _ et3 ad2 b1))
  (let-match erased (addc-fn p c s s2 ad ad2) (Refl _ _))
  (let-match erased (pairfrom-fn c lc1 et1 et3 a1 b1) (Refl _ _))
  (Refl _ et))

(def-fns _ $ (erased lastfrom-exists : (erased Type A) (erased A p) (subterm erased (List A) lc) -> (erased A l) (erased (LastFrom A p lc l) r))
  (let-match erased lc (Cons _ c lc1) ((Nil _) (values p (LFNil A p))))
  (let ((erased l) (erased t)) (lastfrom-exists A c lc1))
  (values l (LFCons A p c l lc1 t)))

(def-fns _ $ (erased lastfrom-fn : (erased Type A) (erased A p l l2) (erased (List A) lc) (subterm erased (LastFrom A p lc l) a) (erased (LastFrom A p lc l2) b)
    -> (erased (Eq A l l2) e))
  (let-match erased a (LFCons _ _ c _ lc1 a1) ((LFNil _ _) (let-match erased b (LFNil _ _)) (Refl _ l)))
  (let-match erased b (LFCons _ _ _ _ _ b1))
  (lastfrom-fn A c l l2 lc1 a1 b1))

(def-fns _ $ (erased utr-exists : (erased (List (Col)) lc) -> (erased (List (Col)) et) (erased (UTr lc et) r))
  (let-match erased lc (Cons _ c lc1) ((Nil _) (values (Nil _) (UTNil))))
  (let ((erased l) (erased lt)) (lastfrom-exists (Col) c lc1))
  (let ((erased et) (erased pf)) (pairfrom-exists l lc))
  (values et (UTCons c l lc1 et lt pf)))

(def-fns _ $ (erased utr-fn : (erased (List (Col)) lc et et2) (erased (UTr lc et) a) (erased (UTr lc et2) b) -> (erased (Eq (List (Col)) et et2) e))
  (let-match erased a (UTCons c l lc1 _ lt pf) ((UTNil) (let-match erased b (UTNil)) (Refl _ et)))
  (let-match erased b (UTCons _ l2 _ _ lt2 pf2))
  (let-match erased (lastfrom-fn (Col) c l l2 lc1 lt lt2) (Refl _ _))
  (pairfrom-fn l lc et et2 pf pf2))

(def-fns _ $ (erased lastfrom-snoc : (erased Type A) (erased A p l) (erased (List A) lc init) (subterm erased (HSnoc A init l (Cons A p lc)) sn)
    -> (erased (LastFrom A p lc l) r))
  (match erased sn _
    ((SnocNil _ _) (LFNil A p))
    ((SnocCons _ _ _ init1 _ sn1)
      (let-match erased lc (Cons _ c lc1) (absurd (Nil _) sn1))
      (LFCons A p c l lc1 (lastfrom-snoc A c l lc1 init1 sn1)))))

(def-fns _ $ (erased pairfrom-snoc : (erased (Col) p l c s) (erased (List (Col)) lc lc2 et) (subterm erased (PairFrom p lc et) pf)
    (erased (LastFrom (Col) p lc l) lt) (erased (HSnoc (Col) lc c lc2) sn) (erased (AddK l c s) a)
    -> (erased (List (Col)) et2) (erased (HSnoc (Col) et s et2) se) (erased (PairFrom p lc2 et2) r))
  (match erased pf _
    ((PFNil _)
      (let-match erased lt (LFNil _ _))
      (let-match erased sn (SnocNil _ _))
      (values (Cons _ s (Nil _)) (SnocNil _ s) (PFCons p c s (Nil _) (Nil _) a (PFNil c))))
    ((PFCons _ c1 s1 lc1 et1 a1 pf1)
      (let-match erased lt (LFCons _ _ _ _ _ lt1))
      (let-match erased sn (SnocCons _ _ _ _ lc3 sn1))
      (let ((erased et3) (erased se1) (erased r1)) (pairfrom-snoc c1 l c s lc1 lc3 et1 pf1 lt1 sn1 a))
      (values (Cons _ s1 et3) (SnocCons _ s1 s et1 et3 se1) (PFCons p c1 s1 lc3 et3 a1 r1)))))

; urtrace_rot: rotating the colours rotates the urtrace.
(def-fns _ $ (erased utr-rot : (erased (Col) c e) (erased (List (Col)) lc lc2 et1) (erased (UTr (Cons (Col) c lc) (Cons (Col) e et1)) u)
    (erased (HSnoc (Col) lc c lc2) sn) -> (erased (List (Col)) et2) (erased (HSnoc (Col) et1 e et2) se) (erased (UTr lc2 et2) r))
  (let-match erased u (UTCons _ l _ _ lt pf))
  (let-match erased pf (PFCons _ _ _ _ _ a pf1))
  (let ((erased et2) (erased se) (erased r)) (pairfrom-snoc c l c e lc lc2 et1 pf1 lt sn a))
  (let-match erased sn (SnocCons _ _ _ _ _ _) ((SnocNil _ _) (values et2 se (UTCons c c (Nil _) et2 (LFNil _ c) r))))
  (let-match erased lc2 (Cons _ c2 lc3))
  (values et2 se (UTCons c2 c lc3 et2 (lastfrom-snoc (Col) c2 c lc3 lc sn) r)))

(def-adts $ (NonZero : ((Col) c) -> Type)
  enum
  (many NZ1 : -> (NonZero (C1)))
  (many NZ2 : -> (NonZero (C2)))
  (many NZ3 : -> (NonZero (C3))))

(def-fns _ $ (erased sym-nz : (erased (Gsym) s) (erased (Bstack) bs bs2) (erased (Col) e) (erased (Sym s bs e bs2) y) -> (erased (NonZero e) r))
  (match erased y _
    ((SSkip _) (NZ1)) ((SPush2 _) (NZ2)) ((SPush3 _) (NZ3)) ((SPop02 _) (NZ2)) ((SPop12 _) (NZ2)) ((SPop03 _) (NZ3)) ((SPop13 _) (NZ3))))

(def-fns _ $ (erased addc-cancel : (erased (Col) a b c d) (erased (AddK a b c) p) (erased (AddK a c d) q) -> (erased (Eq (Col) d b) e))
  (let ((erased aa) (erased paa)) (addc-total a a))
  (let-match erased (addc-fn a a aa (C0) paa (ASame a)) (Refl _ _))
  (let-match erased (addc-assoc a a b (C0) b c d paa (AZL b) p q) (Refl _ _))
  (Refl _ d))

(def-fns _ $ (erased addc-swap : (erased (Col) a b c) (erased (AddK a b c) p) -> (erased (AddK a c b) q))
  (let ((erased d) (erased q)) (addc-total a c))
  (let-match erased (addc-cancel a b c d p q) (Refl _ _))
  q)

(def-fns _ $ (erased absurd addc-unit : (erased (Col) a b) (erased (AddK a b a) p) (erased (NonZero b) nz) -> (erased (False) r))
  (let-match erased (addc-cancel a b a (C0) p (ASame a)) (Refl _ _))
  nz)

(def-fns _ $ (erased lastfrom-head : (erased Type A) (erased A a b c l) (erased (List A) cs) (erased (LastFrom A a (Cons A c cs) l) lt)
    -> (erased (LastFrom A b (Cons A c cs) l) r))
  (let-match erased lt (LFCons _ _ _ _ _ lt1))
  (LFCons A b c l cs lt1))

(def-fns _ $ (erased lastfrom-in : (erased (Nat) a l) (erased (List (Nat)) cs) (subterm erased (LastFrom (Nat) a cs l) lt) -> (erased (In l (Cons (Nat) a cs)) r))
  (let-match erased lt (LFCons _ _ c _ cs1 lt1) ((LFNil _ _) (InHere a cs)))
  (InThere l a cs (lastfrom-in c l cs1 lt1)))

(def-fns _ $ (erased lastfrom-resp : (erased (List (Nat)) k xs ls) (erased (Nat) x y a b) (subterm erased (LastFrom (Nat) x xs y) lt)
    (erased (Respects k (Cons (Nat) x xs) (Cons (Nat) a ls)) rp) (erased (Nth (Nat) k y b) pb) -> (erased (LastFrom (Nat) a ls b) r))
  (let-match erased rp (RespCons _ _ _ _ _ pa rp1))
  (match erased lt _
    ((LFNil _ _) (let-match erased rp1 (RespNil _)) (let-match erased (nth-fn _ k x a b pa pb) (Refl _ _)) (LFNil _ a))
    ((LFCons _ _ c _ xs1 lt1)
      (let-match erased rp1 (RespCons _ _ ls1 _ a1 pa1 rp2))
      (LFCons _ a a1 b ls1 (lastfrom-resp k xs1 ls1 c y a1 b lt1 (RespCons k xs1 ls1 c a1 pa1 rp2) pb)))))

(def-fns _ $ (erased lastfrom-cols : (erased (List (Nat)) ls) (erased (List (Col)) cs) (erased (Nat) a b) (erased (Col) c cb)
    (subterm erased (LastFrom (Nat) a ls b) lt) (erased (All2 (Nat) (Col) ColOf (Cons (Nat) a ls) (Cons (Col) c cs)) al) (erased (ColOf b cb) pb)
    -> (erased (LastFrom (Col) c cs cb) r))
  (let-match erased al (All2Cons _ _ _ _ _ _ _ pa al1))
  (match erased lt _
    ((LFNil _ _) (let-match erased al1 (All2Nil _ _ _)) (let-match erased (colof-fn a c cb pa pb) (Refl _ _)) (LFNil _ c))
    ((LFCons _ _ a1 _ ls1 lt1)
      (let-match erased al1 (All2Cons _ _ _ _ c1 _ cs1 pa1 al2))
      (LFCons _ c c1 cb cs1 (lastfrom-cols ls1 cs1 a1 b c1 cb lt1 (All2Cons _ _ ColOf a1 c1 ls1 cs1 pa1 al2) pb)))))

(def-fns _ $ (erased cols-snoc : (erased (List (Nat)) lc lc2) (erased (List (Col)) cs) (erased (Nat) l) (erased (Col) c)
    (subterm erased (All2 (Nat) (Col) ColOf lc cs) al) (erased (HSnoc (Nat) lc l lc2) sn) (erased (ColOf l c) pc)
    -> (erased (List (Col)) cs2) (erased (HSnoc (Col) cs c cs2) sc) (erased (All2 (Nat) (Col) ColOf lc2 cs2) r))
  (let-match erased al (All2Cons _ _ _ a b lc1 cs1 p al1)
    ((All2Nil _ _ _) (let-match erased sn (SnocNil _ _)) (values (Cons _ c (Nil _)) (SnocNil _ c) (All2Cons _ _ ColOf l c (Nil _) (Nil _) pc (All2Nil _ _ ColOf)))))
  (let-match erased sn (SnocCons _ _ _ _ lc3 sn1))
  (let ((erased cs3) (erased sc1) (erased r1)) (cols-snoc lc1 lc3 cs1 l c al1 sn1 pc))
  (values (Cons _ b cs3) (SnocCons _ b c cs1 cs3 sc1) (All2Cons _ _ ColOf a b lc3 cs3 p r1)))

; et is the urtrace of the colours of the darts R under a live colouring (ring_trace of kempe.v, on rot 1 r).
(def-adts $ (LRT : ((Nat) d) ((List (Nat)) s e f R) ((List (Col)) et) -> Type)
  enum
  (many MkLRT : (erased (Nat) d) (erased (List (Nat)) s e f R ks lc) (erased (List (Col)) cs et) (erased (LiveColoring d s e f ks) lc0)
      (erased (Respects ks R lc) rp) (erased (All2 (Nat) (Col) ColOf lc cs) co) (erased (UTr cs et) ut) -> (LRT d s e f R et)))

(def-fns _ $ (erased lrt-rot : (erased (Nat) d x) (erased (List (Nat)) s e f R0 R2) (erased (List (Col)) et et2) (erased (Col) c)
    (erased (LRT d s e f (Cons (Nat) x R0) (Cons (Col) c et)) rt) (erased (HSnoc (Nat) R0 x R2) sn) (erased (HSnoc (Col) et c et2) se)
    -> (erased (LRT d s e f R2 et2) r))
  (let-match erased rt (MkLRT _ _ _ _ _ ks lc cs _ lc0 rp co ut))
  (let-match erased rp (RespCons _ _ lc1 _ l pl rp1))
  (let-match erased co (All2Cons _ _ _ _ c0 _ cs1 pc0 co1))
  (let ((erased lc2) (erased s2)) (snoc-exists _ lc1 l))
  (let ((erased cs2) (erased sc) (erased co2)) (cols-snoc lc1 lc2 cs1 l c0 co1 s2 pc0))
  (let ((erased et3) (erased se3) (erased ut2)) (utr-rot c0 c cs1 cs2 et ut sc))
  (let-match erased (hsnoc-fn _ et et3 et2 c se3 se) (Refl _ _))
  (MkLRT d s e f R2 ks lc2 cs2 et2 lc0 (respects-snoc ks R0 R2 lc1 lc2 x l rp1 pl sn s2) co2 ut2))

(def-fns _ $ (erased absurd lrt-nil : (erased (Nat) d x) (erased (List (Nat)) s e f R0) (erased (LRT d s e f (Cons (Nat) x R0) (Nil (Col))) rt) -> (erased (False) r))
  (let-match erased rt (MkLRT _ _ _ _ _ ks lc cs _ lc0 rp co ut))
  (let-match erased rp (RespCons _ _ _ _ _ _ _))
  (let-match erased co (All2Cons _ _ _ _ _ _ _ _ _))
  (let-match erased ut (UTCons _ _ _ _ _ pf))
  pf)

; The chromogram w built from wH, that of the contraction, when f z = z: Gskip :: Gskip :: w or Gpush :: Gpop0 :: w.
(def-adts $ (AStep : ((List (Gsym)) wH w) -> Type)
  enum
  (many ASS : (erased (List (Gsym)) wH) -> (AStep wH (Cons (Gsym) (GSkip) (Cons (Gsym) (GSkip) wH))))
  (many APP : (erased (List (Gsym)) wH) -> (AStep wH (Cons (Gsym) (GPush) (Cons (Gsym) (GPop0) wH)))))

; The chromogram w built from wH = s1 :: s2 :: w1 when f z is off the ring: Gpush :: gram_neg w1 if Gskip is s1 or s2,
; otherwise Gskip :: gram_flip w1 if s2 is Gpush, and Gskip :: w1 if not.
(def-adts $ (BStep : ((List (Gsym)) wH w) -> Type)
  enum
  (many BSP : (erased (List (Gsym)) w1 w2) (erased (GNeg (Zero) w1 w2) g)
      -> (BStep (Cons (Gsym) (GSkip) (Cons (Gsym) (GPush) w1)) (Cons (Gsym) (GPush) w2)))
  (many BPS : (erased (List (Gsym)) w1 w2) (erased (GNeg (Zero) w1 w2) g)
      -> (BStep (Cons (Gsym) (GPush) (Cons (Gsym) (GSkip) w1)) (Cons (Gsym) (GPush) w2)))
  (many BPP : (erased (List (Gsym)) w1 w2) (erased (Flip (Zero) w1 w2) fl)
      -> (BStep (Cons (Gsym) (GPush) (Cons (Gsym) (GPush) w1)) (Cons (Gsym) (GSkip) w2)))
  (many BPQ : (erased (List (Gsym)) w1) -> (BStep (Cons (Gsym) (GPush) (Cons (Gsym) (GPop1) w1)) (Cons (Gsym) (GSkip) w1))))

(def-fns _ $ (erased astep-sound : (erased (List (Gsym)) wH w) (erased (List (Col)) et) (erased (AStep wH w) st) (erased (MatchG (BS0) et w) m)
    -> (erased (Col) c) (erased (List (Col)) X) (erased (Eq (List (Col)) et (Cons (Col) c (Cons (Col) c X))) eq) (erased (MatchG (BS0) X wH) mx)
    (erased (NonZero c) nz))
  (match erased st _
    ((ASS _)
      (let-match erased m (MGCons _ b1 c _ et1 _ y1 m1))
      (let-match erased m1 (MGCons _ b2 c2 _ X _ y2 m2))
      (let-match erased y1 (SSkip _)) (let-match erased y2 (SSkip _)) (values c X (Refl _ et) m2 (NZ1)))
    ((APP _)
      (let-match erased m (MGCons _ b1 c _ et1 _ y1 m1))
      (let-match erased m1 (MGCons _ b2 c2 _ X _ y2 m2))
      (match erased y1 _
        ((SPush2 _) (let-match erased y2 (SPop02 _)) (values c X (Refl _ et) m2 (NZ2)))
        ((SPush3 _) (let-match erased y2 (SPop03 _)) (values c X (Refl _ et) m2 (NZ3)))))))

(def-fns _ $ (erased bstep-sound : (erased (List (Gsym)) wH w) (erased (Col) e) (erased (List (Col)) X) (erased (BStep wH w) st)
    (erased (MatchG (BS0) (Cons (Col) e X) w) m)
    -> (erased (Col) e0 v) (erased (AddK e0 e v) a) (erased (MatchG (BS0) (Cons (Col) e0 (Cons (Col) v X)) wH) mh) (erased (NonZero e) nz))
  (let-match erased m (MGCons _ b1 _ _ _ _ y m1))
  (let ((erased nz)) (sym-nz _ (BS0) b1 e y))
  (match erased st _
    ((BSP w1 w2 g)
      (match erased y _
        ((SPush2 _) (values (C1) (C3) (AThird (C1) (C2) (C3) (T123))
          (MGCons (BS0) (BS0) (C1) (GSkip) _ _ (SSkip (BS0)) (MGCons (BS0) (BP1 (BS0)) (C3) (GPush) X w1 (SPush3 (BS0))
            (mg-neg (BS0) (BP0 (BS0)) (BP1 (BS0)) (Zero) (BFalse) (BTrue) w1 w2 X (DpZ) g (BotF) (BotT) (NotF) m1))) nz))
        ((SPush3 _) (values (C1) (C2) (AThird (C1) (C3) (C2) (T132))
          (MGCons (BS0) (BS0) (C1) (GSkip) _ _ (SSkip (BS0)) (MGCons (BS0) (BP0 (BS0)) (C2) (GPush) X w1 (SPush2 (BS0))
            (mg-neg (BS0) (BP1 (BS0)) (BP0 (BS0)) (Zero) (BTrue) (BFalse) w1 w2 X (DpZ) g (BotT) (BotF) (NotT) m1))) nz))))
    ((BPS w1 w2 g)
      (match erased y _
        ((SPush2 _) (values (C3) (C1) (AThird (C3) (C2) (C1) (T321))
          (MGCons (BS0) (BP1 (BS0)) (C3) (GPush) _ _ (SPush3 (BS0)) (MGCons (BP1 (BS0)) (BP1 (BS0)) (C1) (GSkip) X w1 (SSkip (BP1 (BS0)))
            (mg-neg (BS0) (BP0 (BS0)) (BP1 (BS0)) (Zero) (BFalse) (BTrue) w1 w2 X (DpZ) g (BotF) (BotT) (NotF) m1))) nz))
        ((SPush3 _) (values (C2) (C1) (AThird (C2) (C3) (C1) (T231))
          (MGCons (BS0) (BP0 (BS0)) (C2) (GPush) _ _ (SPush2 (BS0)) (MGCons (BP0 (BS0)) (BP0 (BS0)) (C1) (GSkip) X w1 (SSkip (BP0 (BS0)))
            (mg-neg (BS0) (BP1 (BS0)) (BP0 (BS0)) (Zero) (BTrue) (BFalse) w1 w2 X (DpZ) g (BotT) (BotF) (NotT) m1))) nz))))
    ((BPP w1 w2 fl)
      (let-match erased y (SSkip _))
      (let ((erased A)) (BP1 (BP0 (BS0))))
      (let ((erased B)) (BP0 (BP1 (BS0))))
      (match erased (flip-fwd (BS0) A B (Zero) w1 w2 X (DpZ) fl (MkBot2 (BS0) (BP1 (BS0)) A (BTrue) (BFalse) (BotT) (Bot1 (BS0) (BP0 (BS0)) (BFalse) (BotF)))
          (MkBot2 (BS0) (BP0 (BS0)) B (BFalse) (BTrue) (BotF) (Bot0 (BS0) (BP1 (BS0)) (BTrue) (BotT))) m1) _
        ((InL _ _ ma) (values (C2) (C3) (AThird (C2) (C1) (C3) (T213))
          (MGCons (BS0) (BP0 (BS0)) (C2) (GPush) _ _ (SPush2 (BS0)) (MGCons (BP0 (BS0)) A (C3) (GPush) X w1 (SPush3 (BP0 (BS0))) ma)) nz))
        ((InR _ _ mb) (values (C3) (C2) (AThird (C3) (C1) (C2) (T312))
          (MGCons (BS0) (BP1 (BS0)) (C3) (GPush) _ _ (SPush3 (BS0)) (MGCons (BP1 (BS0)) B (C2) (GPush) X w1 (SPush2 (BP1 (BS0))) mb)) nz))))
    ((BPQ w1)
      (let-match erased y (SSkip _))
      (values (C2) (C3) (AThird (C2) (C1) (C3) (T213))
        (MGCons (BS0) (BP0 (BS0)) (C2) (GPush) _ _ (SPush2 (BS0)) (MGCons (BP0 (BS0)) (BS0) (C3) (GPop1) X w1 (SPop13 (BS0)) m1)) nz))))

(def-fns _ $ (erased lc-colc : (erased (Nat) d x) (erased (List (Nat)) s e f ks) (erased (LiveColoring d s e f ks) lc) (erased (Lt x d) lx)
    -> (erased (Nat) a) (erased (Nth (Nat) ks x a) pa) (erased (Col) c) (erased (ColOf a c) pc))
  (let-match erased lc (MkLC _ _ _ _ _ ge gr rf el u lk))
  (let ((erased a) (erased pa)) (nth-exists _ ks d x lk lx))
  (let ((erased c) (erased pc)) (colof-exists a (under-nth ks x a 4 u pa)))
  (values a pa c pc))

; A certificate, built with a chromogram w by Kempe_map's induction, that every trace matching w is a ring trace on R:
; the empty ring, a rotation by gram_rot, or one of the two contractions of the edge z, e z.
(def-adts $ (KGood : ((Nat) d) ((List (Nat)) e n f s R) ((List (Gsym)) w) -> Type)
  enum
  (many KGNil : (erased (Nat) d) (erased (List (Nat)) e n f s ks) (erased (LiveColoring d s e f ks) lc) -> (KGood d e n f s (Nil (Nat)) (Nil (Gsym))))
  (many KGRot : (erased (Nat) d x) (erased (List (Nat)) e n f s R0 R2) (erased (List (Gsym)) w w2) (erased (Bool) b)
      (erased (HSnoc (Nat) R0 x R2) sn) (erased (Bal (Zero) b w) bl) (erased (GRot w w2) gr) (erased (KGood d e n f s (Cons (Nat) x R0) w) k)
      -> (KGood d e n f s R2 w2))
  (many KGA : (erased (Nat) d z ez fez) (erased (List (Nat)) e n f s p1 e2 n2 f2) (erased (List (Gsym)) wH w) (erased (Hypermap d e n f) h)
      (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Nth (Nat) f z z) pfz) (erased (Nth (Nat) f ez fez) pfez) (erased (Apart (Nat) Lt fez z) nfez)
      (erased (LastFrom (Nat) z (Cons (Nat) ez p1) fez) lt) (erased (NotIn z p1) oz) (erased (NotIn ez p1) oe)
      (erased (KGood d e2 n2 f2 (Cons (Nat) ez (Cons (Nat) z s)) p1 wH) k) (erased (AStep wH w) st)
      -> (KGood d e n f s (Cons (Nat) z (Cons (Nat) ez p1)) w))
  (many KGB : (erased (Nat) d z ez fz fez nez) (erased (List (Nat)) e n f s p e2 n2 f2) (erased (List (Gsym)) wH w) (erased (Hypermap d e n f) h)
      (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Nth (Nat) f z fz) pfz) (erased (Nth (Nat) f ez fez) pfez) (erased (Apart (Nat) Lt fez z) nfez)
      (erased (LastFrom (Nat) z p fez) lt) (erased (NotIn z p) oz) (erased (NotIn ez p) oe)
      (erased (KGood d e2 n2 f2 (Cons (Nat) ez (Cons (Nat) z s)) (Cons (Nat) nez (Cons (Nat) fz p)) wH) k) (erased (BStep wH w) st)
      -> (KGood d e n f s (Cons (Nat) z p) w)))

; The second half of Kempe_closed (ring_trace r): every trace matching the chromogram of a certificate is a ring trace.
(def-fns _ $ (erased kgood-sound : (erased (Nat) d) (erased (List (Nat)) e n f s R) (erased (List (Gsym)) w) (erased (List (Col)) et)
    (subterm erased (KGood d e n f s R w) k) (erased (MatchG (BS0) et w) m) -> (erased (LRT d s e f R et) r))
  (match erased k _
    ((KGNil _ _ _ _ _ ks lc)
      (let-match erased m (MGNil))
      (MkLRT d s e f (Nil _) ks (Nil _) (Nil _) (Nil _) lc (RespNil ks) (All2Nil _ _ ColOf) (UTNil)))
    ((KGRot _ x _ _ _ _ R0 R2 w1 _ b sn bl gr k1)
      (let-match erased et (Cons _ c et1)
        (absurd (Nil _)
          (let-match erased m (MGNil))
          (let-match erased gr (GRNil) (absurd (GRPush _ _ _ _ fl) fl) (absurd (GRSkip _ _ sn2) sn2))
          (lrt-nil d x s e f R0 (kgood-sound d e n f s (Cons _ x R0) w1 (Nil _) k1 (MGNil)))))
      (let ((erased init) (erased l) (erased se)) (unsnoc-exists (Col) c et1))
      (lrt-rot d x s e f R0 R2 init et l (kgood-sound d e n f s (Cons _ x R0) w1 (Cons _ l init) k1 (rot-bwd b w1 w l init et bl gr m se)) sn se))
    ((KGA _ z ez fez _ _ _ _ p1 e2 n2 f2 wH _ h ct pfz pfez nfez lt oz oe k1 st)
      (let ((erased s2)) (Cons (Nat) ez (Cons (Nat) z s)))
      (let ((erased E) (erased X) (erased eq) (erased mx) (erased nz)) (astep-sound wH w et st m))
      (let-match erased eq (Refl _ _))
      (let-match erased (kgood-sound d e2 n2 f2 s2 p1 wH X k1 mx) (MkLRT _ _ _ _ _ k1s lc1 cs1 _ lcol1 rp1 co1 ut1))
      (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
      (let ((erased lfez)) (perm-val d ez fez f fi pf pfez))
      (let ((erased cez) (erased pcez) (erased Cez) (erased oez)) (lc-colc d fez s2 e2 f2 k1s lcol1 lfez))
      (let ((erased Cz) (erased az)) (addc-total Cez E))
      (let ((erased cz) (erased ocz)) (natof-exists Cz))
      (let-match erased (nat-eq cz cez) (Unequal _ _ _ _ nzc)
        (absurd (Equal _ _ _) (let-match erased (colof-fn cz Cz Cez ocz oez) (Refl _ _)) (addc-unit Cez E az nz)))
      (let ((erased k0) (erased lc0) (erased st2)) (cut-lift d z ez z fez cz cez e n f s k1s e2 n2 f2 h ct lcol1 pfz pfez (InL _ _ (Refl _ z)) pcez
        (colof-lt cz Cz ocz) nzc))
      (let ((erased k0z)) (set2-z k1s k0 z cz ez cez st2))
      (let ((erased k0ez)) (set2-ez k1s k0 z cz ez cez st2))
      (let ((erased rp0)) (RespCons k0 _ _ z cz k0z (RespCons k0 p1 lc1 ez cez k0ez (set2-respects k1s k0 p1 lc1 z cz ez cez st2 rp1 oz oe))))
      (let ((erased co0)) (All2Cons _ _ ColOf cz Cz _ _ ocz (All2Cons _ _ ColOf cez Cez lc1 cs1 oez co1)))
      (let ((erased kf0)) (match erased (nat-eq fez ez) (((Nth (Nat) k0 fez cez) r))
        ((Equal _ _ _) k0ez)
        ((Unequal _ _ _ _ ne) (set2-other k1s k0 z cz ez cez fez cez st2 pcez nfez ne))))
      (let ((erased ltc)) (lastfrom-cols (Cons _ cez lc1) (Cons _ Cez cs1) cz cez Cz Cez
        (lastfrom-resp k0 (Cons _ ez p1) (Cons _ cez lc1) z fez cz cez lt rp0 kf0) co0 oez))
      (let ((erased pf1)) (match erased ut1 (((PairFrom Cez cs1 X) r))
        ((UTNil) (PFNil Cez))
        ((UTCons c1 l1 cs1b _ lt1 pf1b)
          (let-match erased ltc (LFCons _ _ _ _ _ ltc1))
          (let-match erased ltc1 (LFCons _ _ _ _ _ ltc2))
          (let-match erased (lastfrom-fn (Col) c1 l1 Cez cs1b lt1 ltc2) (Refl _ _))
          pf1b)))
      (let ((erased a1)) (addc-swap Cez E Cz az))
      (MkLRT d s e f _ k0 _ _ _ lc0 rp0 co0 (UTCons Cz Cez (Cons _ Cez cs1) _ ltc (PFCons Cez Cz E _ _ a1 (PFCons Cz Cez E cs1 X (addc-comm Cez Cz E a1) pf1)))))
    ((KGB _ z ez fz fez nez _ _ _ _ p e2 n2 f2 wH _ h ct pfz pfez nfez lt0 oz oe k1 st)
      (let ((erased s2)) (Cons (Nat) ez (Cons (Nat) z s)))
      (let-match erased et (Cons _ e0 X) (absurd (Nil _) (let-match erased m (MGNil)) st))
      (let ((erased c0) (erased v) (erased ad) (erased mh) (erased nz)) (bstep-sound wH w e0 X st m))
      (let-match erased (kgood-sound d e2 n2 f2 s2 (Cons _ nez (Cons _ fz p)) wH (Cons _ c0 (Cons _ v X)) k1 mh)
        (MkLRT _ _ _ _ _ k1s lc1 cs1 _ lcol1 rp1 co1 ut1))
      (let-match erased rp1 (RespCons _ _ _ _ knez pknez rp1a))
      (let-match erased rp1a (RespCons _ _ lcp _ kfz pkfz rpp))
      (let-match erased co1 (All2Cons _ _ _ _ Cnez _ _ ocnez co1a))
      (let-match erased co1a (All2Cons _ _ _ _ Cfz _ csp ocfz cop))
      (let-match erased ut1 (UTCons _ L _ _ lt1 pf1))
      (let-match erased pf1 (PFCons _ _ _ _ _ a1 pf1a))
      (let-match erased pf1a (PFCons _ _ _ _ _ a2 pfp))
      (let-match erased p (Cons _ q p2) (absurd (Nil _) (let-match erased lt0 (LFNil _ _)) (apart-irrefl fez nfez)))
      (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
      (let ((erased lfez)) (perm-val d ez fez f fi pf pfez))
      (let ((erased cez) (erased pcez) (erased Cez) (erased oez)) (lc-colc d fez s2 e2 f2 k1s lcol1 lfez))
      (let ((erased ltH)) (LFCons _ nez fz fez p (lastfrom-head (Nat) z fz q fez p2 lt0)))
      (let ((erased ltHc)) (lastfrom-cols (Cons _ kfz lcp) (Cons _ Cfz csp) knez cez Cnez Cez
        (lastfrom-resp k1s (Cons _ fz p) (Cons _ kfz lcp) nez fez knez cez ltH (RespCons k1s _ _ nez knez pknez (RespCons k1s p lcp fz kfz pkfz rpp)) pcez)
        (All2Cons _ _ ColOf knez Cnez _ _ ocnez (All2Cons _ _ ColOf kfz Cfz lcp csp ocfz cop)) oez))
      (let-match erased (lastfrom-fn (Col) Cnez L Cez (Cons _ Cfz csp) lt1 ltHc) (Refl _ _))
      (let-match erased (nat-eq kfz cez) (Unequal _ _ _ _ nzc)
        (absurd (Equal _ _ _)
          (let-match erased (colof-fn kfz Cfz Cez ocfz oez) (Refl _ _))
          (let-match erased (addc-fn Cnez Cfz v c0 a2 (addc-comm Cfz Cnez c0 a1)) (Refl _ _))
          (addc-unit c0 e0 ad nz)))
      (let ((erased k0) (erased lc0) (erased st2)) (cut-lift d z ez fz fez kfz cez e n f s k1s e2 n2 f2 h ct lcol1 pfz pfez (InR _ _ pkfz) pcez
        (colof-lt kfz Cfz ocfz) nzc))
      (let ((erased rp0)) (RespCons k0 p lcp z kfz (set2-z k1s k0 z kfz ez cez st2) (set2-respects k1s k0 p lcp z kfz ez cez st2 rpp oz oe)))
      (let ((erased co0)) (All2Cons _ _ ColOf kfz Cfz lcp csp ocfz cop))
      (let ((erased infez)) (match erased (lastfrom-in z fez p lt0) (((In fez p) r))
        (absurd (InHere _ _) (apart-irrefl fez nfez))
        ((InThere _ _ _ r) r)))
      (let ((erased kf0)) (set2-other k1s k0 z kfz ez cez fez cez st2 pcez nfez (apart-sym ez fez (notin-in ez fez p oe infez))))
      (let ((erased ltc)) (lastfrom-cols lcp csp kfz cez Cfz Cez (lastfrom-resp k0 p lcp z fez kfz cez lt0 rp0 kf0) co0 oez))
      (let ((erased t) (erased ats)) (addc-total Cez Cfz))
      (let-match erased (addc-cancel c0 e0 v t ad (addc-tri Cez Cnez Cfz c0 v t a1 a2 ats)) (Refl _ _))
      (MkLRT d s e f _ k0 _ _ _ lc0 rp0 co0 (UTCons Cfz Cez csp _ ltc (PFCons Cez Cfz e0 csp X ats pfp))))))

; R is a cycle of n (Gonthier's fcycle node), or empty.
(def-adts $ (NCyc : ((List (Nat)) n R) -> Type)
  enum
  (many NCNil : (erased (List (Nat)) n) -> (NCyc n (Nil (Nat))))
  (many NCCons : (erased (List (Nat)) n xs) (erased (Nat) x y) (erased (FPath n x xs y) fp) (erased (Nth (Nat) n y x) back) -> (NCyc n (Cons (Nat) x xs))))

; No dart of R is in s.
(def-adts $ (Off : ((List (Nat)) s R) -> Type)
  enum
  (many OffNil : (erased (List (Nat)) s) -> (Off s (Nil (Nat))))
  (many OffCons : (erased (List (Nat)) s R) (erased (Nat) x) (erased (NotIn x s) px) (erased (Off s R) rest) -> (Off s (Cons (Nat) x R))))

; Every dart of xs is in R or on a cycle of n of at most three darts (quasicubic r, read on the darts xs).
(def-adts $ (QCubic : ((List (Nat)) n R xs) -> Type)
  enum
  (many QCNil : (erased (List (Nat)) n R) -> (QCubic n R (Nil (Nat))))
  (many QCIn : (erased (List (Nat)) n R xs) (erased (Nat) x) (erased (In x R) px) (erased (QCubic n R xs) rest) -> (QCubic n R (Cons (Nat) x xs)))
  (many QCOut : (erased (List (Nat)) n R xs) (erased (Nat) x a b) (erased (Nth (Nat) n x a) pa) (erased (Nth (Nat) n a b) pb) (erased (Nth (Nat) n b x) px)
      (erased (QCubic n R xs) rest) -> (QCubic n R (Cons (Nat) x xs))))

(def-adts $ (Cyc3 : ((List (Nat)) n) ((Nat) x) -> Type)
  enum
  (many MkCyc3 : (erased (List (Nat)) n) (erased (Nat) x a b) (erased (Nth (Nat) n x a) pa) (erased (Nth (Nat) n a b) pb) (erased (Nth (Nat) n b x) px)
      -> (Cyc3 n x)))

(def-fns _ $ (erased qc-at : (erased (List (Nat)) n R xs) (erased (Nat) x) (subterm erased (QCubic n R xs) q) (erased (In x xs) ix)
    -> (erased (Or (In x R) (Cyc3 n x)) r))
  (match erased q _
    (absurd (QCNil _ _) ix)
    ((QCIn _ _ xs1 y py q1) (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) (InL _ _ py))) (qc-at n R xs1 x q1 ix1))
    ((QCOut _ _ xs1 y a b pa pb px q1)
      (let-match erased ix (InThere _ _ _ ix1) ((InHere _ _) (InR _ _ (MkCyc3 n x a b pa pb px))))
      (qc-at n R xs1 x q1 ix1))))

; The ring data kempe.v keeps along its induction: a duplicate-free node cycle of live darts, off which the map is cubic.
(def-adts $ (RingOK : ((List (Nat)) n s R ids) -> Type)
  enum
  (many MkRingOK : (erased (List (Nat)) n s R ids) (erased (NCyc n R) nc) (erased (Distinct R) ds) (erased (Off s R) av) (erased (QCubic n R ids) qc)
      -> (RingOK n s R ids)))

(def-fns _ $ (erased fpath-snoc : (erased (List (Nat)) r q q2) (erased (Nat) a b c) (subterm erased (FPath r a q b) fp) (erased (Nth (Nat) r b c) pc)
    (erased (HSnoc (Nat) q c q2) sn) -> (erased (FPath r a q2 c) res))
  (let-match erased fp (FPCons _ q1 _ x _ px fp1)
    ((FPNil _ _) (let-match erased sn (SnocNil _ _)) (FPCons r (Nil _) a c c pc (FPNil r c))))
  (let-match erased sn (SnocCons _ _ _ _ q3 sn1))
  (FPCons r q3 a x c px (fpath-snoc r q1 q3 x b c fp1 pc sn1)))

(def-fns _ $ (erased fpath-last : (erased (List (Nat)) r q) (erased (Nat) a b) (subterm erased (FPath r a q b) fp) -> (erased (LastFrom (Nat) a q b) res))
  (let-match erased fp (FPCons _ q1 _ x _ px fp1) ((FPNil _ _) (LFNil _ a)))
  (LFCons _ a x b q1 (fpath-last r q1 x b fp1)))

(def-fns _ $ (erased in-snoc : (erased (Nat) x y) (erased (List (Nat)) R0 R2) (subterm erased (HSnoc (Nat) R0 y R2) sn) (erased (In x (Cons (Nat) y R0)) ix)
    -> (erased (In x R2) r))
  (match erased sn _
    ((SnocNil _ _) ix)
    ((SnocCons _ a _ R1 R3 sn1)
      (match erased ix _
        ((InHere _ _) (InThere x a R3 (in-snoc x y R1 R3 sn1 (InHere y R1))))
        ((InThere _ _ _ ix1) (match erased ix1 _
          ((InHere _ _) (InHere x R3))
          ((InThere _ _ _ ix2) (InThere x a R3 (in-snoc x y R1 R3 sn1 (InThere x y R1 ix2))))))))))

(def-fns _ $ (erased qc-rot : (erased (List (Nat)) n R0 R2 xs) (erased (Nat) y) (subterm erased (QCubic n (Cons (Nat) y R0) xs) q) (erased (HSnoc (Nat) R0 y R2) sn)
    -> (erased (QCubic n R2 xs) r))
  (match erased q _
    ((QCNil _ _) (QCNil n R2))
    ((QCIn _ _ xs1 x px q1) (QCIn n R2 xs1 x (in-snoc x y R0 R2 sn px) (qc-rot n R0 R2 xs1 y q1 sn)))
    ((QCOut _ _ xs1 x a b pa pb px q1) (QCOut n R2 xs1 x a b pa pb px (qc-rot n R0 R2 xs1 y q1 sn)))))

(def-fns _ $ (erased off-snoc : (erased (List (Nat)) s R0 R2) (erased (Nat) x) (erased (NotIn x s) px) (subterm erased (Off s R0) av)
    (erased (HSnoc (Nat) R0 x R2) sn) -> (erased (Off s R2) r))
  (let-match erased sn (SnocCons _ a _ R1 R3 sn1) ((SnocNil _ _) (OffCons s (Nil _) x px (OffNil s))))
  (let-match erased av (OffCons _ _ _ pa av1))
  (OffCons s R3 a pa (off-snoc s R1 R3 x px av1 sn1)))

(def-fns _ $ (erased ring-rot : (erased (List (Nat)) n s R0 R2 ids) (erased (Nat) x) (erased (RingOK n s (Cons (Nat) x R0) ids) ro)
    (erased (HSnoc (Nat) R0 x R2) sn) -> (erased (RingOK n s R2 ids) r))
  (let-match erased ro (MkRingOK _ _ _ _ nc ds av qc))
  (let-match erased nc (NCCons _ _ _ y fp back))
  (let-match erased av (OffCons _ _ _ px av1))
  (let ((erased nc2)) (match erased fp (((NCyc n R2) r))
    ((FPNil _ _) (let-match erased sn (SnocNil _ _)) (NCCons n (Nil _) x x (FPNil n x) back))
    ((FPCons _ q1 _ r1 _ pr fp1)
      (let-match erased sn (SnocCons _ _ _ _ q3 sn1))
      (NCCons n q3 r1 x (fpath-snoc n q1 q3 r1 y x fp1 back sn1) pr))))
  (MkRingOK n s R2 ids nc2 (distinct-snoc-cons x R0 R2 sn ds) (off-snoc s R0 R2 x px av1 sn) (qc-rot n R0 R2 ids x qc sn)))

(def-fns _ $ (erased join-snoc-r : (erased (List (Nat)) a b ab b2 ab2) (erased (Nat) c) (subterm erased (Join a b ab) j) (erased (HSnoc (Nat) b c b2) sb)
    (erased (HSnoc (Nat) ab c ab2) sab) -> (erased (Join a b2 ab2) r))
  (let-match erased j (JoinCons a1 _ ab1 x j1)
    ((JoinNil _) (let-match erased (hsnoc-fn _ b b2 ab2 c sb sab) (Refl _ _)) (JoinNil b2)))
  (let-match erased sab (SnocCons _ _ _ _ ab3 sab1))
  (JoinCons a1 b2 ab3 x (join-snoc-r a1 b ab1 b2 ab3 c j1 sb sab1)))

; Rotating R = X ++ Y left by the length of X, to Y ++ X, keeps the ring data.
(def-fns _ $ (erased ring-turn : (erased (List (Nat)) n s) (subterm erased (List (Nat)) X) (erased (List (Nat)) Y R R2 ids) (erased (Join X Y R) j) (erased (Join Y X R2) j2)
    (erased (RingOK n s R ids) ro) -> (erased (RingOK n s R2 ids) r))
  (let-match erased j (JoinCons X1 _ R1 x j1)
    ((JoinNil _) (let-match erased (join-nil-r Y R2 j2) (Refl _ _)) ro))
  (let ((erased R3) (erased s3)) (snoc-exists _ R1 x))
  (let ((erased Y2) (erased sy)) (snoc-exists _ Y x))
  (ring-turn n s X1 Y2 R3 R2 ids (join-snoc-r X1 Y R1 Y2 R3 x j1 sy s3) (join-snoc Y X1 R2 Y2 x j2 sy) (ring-rot n s R1 R3 ids x ro s3)))

; The trace et of ks on R, a chromogram w matching it, and a certificate for w.
(def-adts $ (KMatch : ((Nat) d) ((List (Nat)) e n f s ks R) -> Type)
  enum
  (many MkKMatch : (erased (Nat) d) (erased (List (Nat)) e n f s ks R lc) (erased (List (Col)) cs et) (erased (List (Gsym)) w)
      (erased (Respects ks R lc) rp) (erased (All2 (Nat) (Col) ColOf lc cs) co) (erased (UTr cs et) ut) (erased (MatchG (BS0) et w) m)
      (erased (KGood d e n f s R w) kg) -> (KMatch d e n f s ks R)))

(def-fns _ $ (erased km-rot : (erased (Nat) d x) (erased (List (Nat)) e n f s ks R0 R2) (erased (KMatch d e n f s ks (Cons (Nat) x R0)) km)
    (erased (HSnoc (Nat) R0 x R2) sn) -> (erased (KMatch d e n f s ks R2) r))
  (let-match erased km (MkKMatch _ _ _ _ _ _ _ lc cs et w rp co ut m kg))
  (let-match erased rp (RespCons _ _ lc0 _ l pl rp1))
  (let-match erased co (All2Cons _ _ _ _ C _ cs0 pc co1))
  (let-match erased ut (UTCons _ L _ _ lt pf))
  (let-match erased pf (PFCons _ _ e0 _ et1 a pf1))
  (let ((erased lc2) (erased s2)) (snoc-exists _ lc0 l))
  (let ((erased cs2) (erased sc) (erased co2)) (cols-snoc lc0 lc2 cs0 l C co1 s2 pc))
  (let ((erased et2) (erased se) (erased ut2)) (utr-rot C e0 cs0 cs2 et1 ut sc))
  (let ((erased b) (erased bl)) (mg-bal et w m))
  (let ((erased w2) (erased gr)) (grot-exists b w bl))
  (MkKMatch d e n f s ks R2 lc2 cs2 et2 w2 (respects-snoc ks R0 R2 lc0 lc2 x l rp1 pl sn s2) co2 ut2 (rot-fwd b w w2 e0 et1 et2 gr m se)
    (KGRot d x e n f s R0 R2 w w2 b sn bl gr kg)))

(def-fns _ $ (erased km-turn : (erased (Nat) d) (erased (List (Nat)) e n f s ks) (subterm erased (List (Nat)) X) (erased (List (Nat)) Y R R2)
    (erased (Join X Y R) j) (erased (Join Y X R2) j2) (erased (KMatch d e n f s ks R) km) -> (erased (KMatch d e n f s ks R2) r))
  (let-match erased j (JoinCons X1 _ R1 x j1)
    ((JoinNil _) (let-match erased (join-nil-r Y R2 j2) (Refl _ _)) km))
  (let ((erased R3) (erased s3)) (snoc-exists _ R1 x))
  (let ((erased Y2) (erased sy)) (snoc-exists _ Y x))
  (km-turn d e n f s ks X1 Y2 R3 R2 (join-snoc-r X1 Y R1 Y2 R3 x j1 sy s3) (join-snoc Y X1 R2 Y2 x j2 sy) (km-rot d x e n f s ks R1 R3 km s3)))

; Each bond x-y of g has e y = x.
(def-adts $ (InvB : ((List (Nat)) e) ((List (Bond)) g) -> Type)
  enum
  (many IBNil : (erased (List (Nat)) e) -> (InvB e (Nil (Bond))))
  (many IBCons : (erased (List (Nat)) e) (erased (List (Bond)) g) (erased (Nat) x y) (erased (Nth (Nat) e y x) p) (erased (InvB e g) rest)
      -> (InvB e (Cons (Bond) (MkBond x y) g))))

; e is an involution (plain_eq, with the fixed points of the dead darts allowed).
(def-adts $ (Plain : ((Nat) d) ((List (Nat)) e) -> Type)
  enum
  (many MkPlain : (erased (Nat) d) (erased (List (Nat)) e) (erased (List (Bond)) g) (erased (Graph d e g) gr) (erased (InvB e g) iv) -> (Plain d e)))

(def-fns _ $ (erased invb-at : (erased (List (Nat)) e xs ys) (erased (List (Bond)) g) (erased (Nat) j x y) (subterm erased (Zip xs ys g) z)
    (erased (InvB e g) iv) (erased (Nth (Nat) xs j x) px) (erased (Nth (Nat) ys j y) py) -> (erased (Nth (Nat) e y x) r))
  (let-match erased z (ZipCons xs1 ys1 g1 x0 y0 z1) (absurd (ZipNil) px))
  (let-match erased iv (IBCons _ _ _ _ q iv1))
  (match erased px _
    ((NthHere _ _ _) (let-match erased py (NthHere _ _ _)) q)
    ((NthThere _ _ _ j1 _ px1) (let-match erased py (NthThere _ _ _ _ _ py1)) (invb-at e xs1 ys1 g1 j1 x y z1 iv1 px1 py1))))

(def-fns _ $ (erased plain-at : (erased (Nat) d x y) (erased (List (Nat)) e) (erased (Plain d e) pl) (erased (Lt x d) lx) (erased (Nth (Nat) e x y) px)
    -> (erased (Nth (Nat) e y x) r))
  (let-match erased pl (MkPlain _ _ g gr iv))
  (let ((erased ids) (erased io)) (iota-exists d))
  (invb-at e ids e g x x y (graph-zip d e ids g gr io) iv (iota-nth d x ids io lx) px))

(def-fns _ $ (erased cut-plain-b : (erased (Nat) d z ez) (erased (List (Nat)) e n f s e2 n2 f2) (erased (List (Bond)) g) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Plain d e) pl) (erased (FixedIn e2 (Cons (Nat) ez (Cons (Nat) z s))) fe2)
    (erased (Length (Nat) e2 d) le2) (subterm erased (Fun e2 g) fg) -> (erased (InvB e2 g) r))
  (let-match erased fg (FunCons _ g1 x y px fg1) ((FunNil _) (IBNil e2)))
  (let ((erased rest)) (cut-plain-b d z ez e n f s e2 n2 f2 g1 h ct pl fe2 le2 fg1))
  (let ((erased s2)) (Cons (Nat) ez (Cons (Nat) z s)))
  (let-match erased (nat-eq x z) (Unequal _ _ _ _ nxz)
    ((Equal _ _ _) (let-match erased (nth-fn _ e2 z y z px (fixed-at e2 s2 z fe2 (InThere z ez _ (InHere z s)))) (Refl _ _)) (IBCons e2 g1 x y px rest)))
  (let-match erased (nat-eq x ez) (Unequal _ _ _ _ nx)
    ((Equal _ _ _) (let-match erased (nth-fn _ e2 ez y ez px (fixed-at e2 s2 ez fe2 (InHere ez _))) (Refl _ _)) (IBCons e2 g1 x y px rest)))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased ct (MkCut2 _ _ _ fz fez _ _ _ e1 n1 f1 _ _ _ h1 ske skf skn skf2 h2 pez pze ne pfz nfz pfez nfez))
  (let ((erased lx)) (nth-lt-length _ e2 x d y px le2))
  (let ((erased c) (erased pc) (erased _)) (perm-nth d x e nf pe lx))
  (let-match erased (nth-fn _ e2 x y c px (cut-e2 d z ez x c e n f e2 n2 f2 h ct pc nxz nx)) (Refl _ _))
  (let ((erased pcx)) (plain-at d x c e pl lx pc))
  (IBCons e2 g1 x y (cut-e2 d z ez c x e n f e2 n2 f2 h ct pcx (img-apart d x ez c z e nf pe pc pze nx) (img-apart d x z c ez e nf pe pc pez nxz)) rest))

; The contraction is plain.
(def-fns _ $ (erased cut-plain : (erased (Nat) d z ez) (erased (List (Nat)) e n f s e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Hypermap d e2 n2 f2) h2) (erased (Plain d e) pl)
    (erased (FixedIn e2 (Cons (Nat) ez (Cons (Nat) z s))) fe2) -> (erased (Plain d e2) r))
  (let ((erased le2) (erased ln2) (erased lf2)) (hyper-lengths d e2 n2 f2 h2))
  (let ((erased g) (erased gr)) (graph-exists d e2 le2))
  (MkPlain d e2 g gr (cut-plain-b d z ez e n f s e2 n2 f2 g h ct pl fe2 le2 (graph-fun d e2 g gr))))

(def-fns _ $ (erased fpath-next : (erased (List (Nat)) n q) (erased (Nat) a b x y) (subterm erased (FPath n a q b) fp) (erased (In x (Cons (Nat) a q)) ix)
    (erased (Nth (Nat) n x y) px) -> (erased (Or (Eq (Nat) x b) (In y q)) r))
  (match erased fp _
    ((FPNil _ _) (let-match erased ix (InHere _ _) (absurd (InThere _ _ _ i) i)) (InL _ _ (Refl _ x)))
    ((FPCons _ q1 _ a1 _ pa fp1)
      (match erased ix _
        ((InHere _ _) (let-match erased (nth-fn _ n x y a1 px pa) (Refl _ _)) (InR _ _ (InHere y q1)))
        ((InThere _ _ _ ix1) (match erased (fpath-next n q1 a1 b x y fp1 ix1 px) _
          ((InL _ _ eq) (InL _ _ eq))
          ((InR _ _ iy) (InR _ _ (InThere y a1 q1 iy)))))))))

; A node cycle is closed under n.
(def-fns _ $ (erased ncyc-next : (erased (List (Nat)) n R) (erased (Nat) x y) (erased (NCyc n R) nc) (erased (In x R) ix) (erased (Nth (Nat) n x y) px)
    -> (erased (In y R) r))
  (let-match erased nc (NCCons _ q x0 yl fp back) (absurd (NCNil _) ix))
  (match erased (fpath-next n q x0 yl x y fp ix px) _
    ((InL _ _ eq) (let-match erased eq (Refl _ _)) (let-match erased (nth-fn _ n x y x0 px back) (Refl _ _)) (InHere y q))
    ((InR _ _ iy) (InThere y x0 q iy))))

(def-fns _ $ (erased fpath-prev : (erased (Nat) d) (erased (List (Nat)) n ni q) (erased (Nat) a b x y) (erased (HPerm d n ni) pm)
    (subterm erased (FPath n a q b) fp) (erased (In y q) iy) (erased (Nth (Nat) n x y) px) -> (erased (In x (Cons (Nat) a q)) r))
  (let-match erased fp (FPCons _ q1 _ a1 _ pa fp1) (absurd (FPNil _ _) iy))
  (match erased iy _
    ((InHere _ _) (let-match erased (perm-inj d x a y n ni pm px pa) (Refl _ _)) (InHere x q))
    ((InThere _ _ _ iy1) (InThere x a q (fpath-prev d n ni q1 a1 b x y pm fp1 iy1 px)))))

; ... and under its inverse.
(def-fns _ $ (erased ncyc-prev : (erased (Nat) d) (erased (List (Nat)) n ni R) (erased (Nat) x y) (erased (HPerm d n ni) pm) (erased (NCyc n R) nc)
    (erased (In y R) iy) (erased (Nth (Nat) n x y) px) -> (erased (In x R) r))
  (let-match erased nc (NCCons _ q x0 yl fp back) (absurd (NCNil _) iy))
  (match erased iy _
    ((InHere _ _) (let-match erased (perm-inj d x yl y n ni pm px back) (Refl _ _)) (lastfrom-in x0 x q (fpath-last n q x0 x fp)))
    ((InThere _ _ _ iy1) (fpath-prev d n ni q x0 yl x y pm fp iy1 px))))

(def-fns _ $ (erased fpath-lab : (erased (List (Nat)) n lab q) (erased (Nat) a b l x) (subterm erased (FPath n a q b) fp) (erased (Respects lab n lab) rl)
    (erased (Nth (Nat) lab a l) pl) (erased (In x (Cons (Nat) a q)) ix) -> (erased (Nth (Nat) lab x l) r))
  (match erased ix _
    ((InHere _ _) pl)
    ((InThere _ _ _ ix1)
      (let-match erased fp (FPCons _ q1 _ a1 _ pa fp1) (absurd (FPNil _ _) ix1))
      (fpath-lab n lab q1 a1 b l x fp1 rl (respects-nth lab n lab a a1 l rl pa pl) ix1))))

; Separated from a dart of a node cycle, as LeafCut of euler-tree gives, a dart is off the cycle.
(def-fns _ $ (erased seps-notin : (erased (Nat) d) (erased (List (Nat)) n ni R) (erased (Nat) z z2) (erased (HPerm d n ni) pm) (erased (NCyc n R) nc)
    (erased (In z R) iz) (erased (Seps n z z2) sp) -> (erased (NotIn z2 R) r))
  (let-match erased sp (MkSeps _ lab _ _ sep))
  (let-match erased sep (MkSeparates _ _ _ _ l1 l2 rl p1 p2 dif))
  (let-match erased nc (NCCons _ q x0 yl fp back) ((NCNil _) (NotInNil z2)))
  (let ((erased ll)) (respects-length lab n lab d rl (perm-length d n ni pm)))
  (let ((erased l0) (erased p0)) (nth-exists _ lab d x0 ll (perm-val d yl x0 n ni pm back)))
  (let-match erased (nth-fn _ lab z l1 l0 p1 (fpath-lab n lab q x0 yl l0 z fp rl p0 iz)) (Refl _ _))
  (let-match erased (in-dec z2 (Cons _ x0 q)) (OrR _ _ out)
    (absurd (OrL _ _ i2) (let-match erased (nth-fn _ lab z2 l2 l1 p2 (fpath-lab n lab q x0 yl l1 z2 fp rl p0 i2)) (Refl _ _)) (apart-irrefl l1 dif)))
  out)

(def-fns _ $ (erased path-ncyc : (erased (List (Nat)) n R xs) (erased (Nat) x y) (subterm erased (Path n (Nil (Nat)) x y xs) w) (erased (NCyc n R) nc)
    (erased (In x R) ix) -> (erased (In y R) r))
  (let-match erased w (PathStep _ _ xs1 _ x1 _ px _ w1) ((PathHere _ _ _) ix))
  (path-ncyc n R xs1 x1 y w1 nc (ncyc-next n R x x1 nc ix px)))

; A node path whose darts avoid z and ez is one of the contraction.
(def-fns _ $ (erased fpath-n2 : (erased (Nat) d z ez a b) (erased (List (Nat)) e n f e2 n2 f2 q) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (subterm erased (FPath n a q b) fp) (erased (NotIn z (Cons (Nat) a q)) oz)
    (erased (NotIn ez (Cons (Nat) a q)) oe) -> (erased (FPath n2 a q b) r))
  (let-match erased fp (FPCons _ q1 _ a1 _ pa fp1) ((FPNil _ _) (FPNil n2 a)))
  (let-match erased oz (NotInCons _ _ _ za oz1))
  (let-match erased oe (NotInCons _ _ _ ea oe1))
  (let-match erased oz1 (NotInCons _ _ _ za1 _))
  (let-match erased oe1 (NotInCons _ _ _ ea1 _))
  (FPCons n2 q1 a a1 b (cut-n2 d z ez a a1 e n f e2 n2 f2 h ct pa (apart-sym z a za) (apart-sym ez a ea) (apart-sym z a1 za1) (apart-sym ez a1 ea1))
    (fpath-n2 d z ez a1 b e n f e2 n2 f2 q1 h ct fp1 oz1 oe1)))

(def-fns _ $ (erased off-extend : (erased (List (Nat)) s R) (erased (Nat) a b) (subterm erased (Off s R) av) (erased (NotIn a R) oa) (erased (NotIn b R) ob)
    -> (erased (Off (Cons (Nat) b (Cons (Nat) a s)) R) r))
  (let-match erased av (OffCons _ R1 x px av1) ((OffNil _) (OffNil _)))
  (let-match erased oa (NotInCons _ _ _ na oa1))
  (let-match erased ob (NotInCons _ _ _ nb ob1))
  (OffCons _ R1 x (NotInCons x b _ (apart-sym b x nb) (NotInCons x a s (apart-sym a x na) px)) (off-extend s R1 a b av1 oa1 ob1)))

(def-fns _ $ (erased fixed-cyc3 : (erased (List (Nat)) n s) (erased (Nat) x) (erased (FixedIn n s) fx) (erased (In x s) ix) -> (erased (Cyc3 n x) r))
  (let ((erased p)) (fixed-at n s x fx ix))
  (MkCyc3 n x x x p p p))

; The node cycle of a dart off a node cycle R avoids R.
(def-fns _ $ (erased cyc3-off : (erased (Nat) d x a b) (erased (List (Nat)) n ni R) (erased (HPerm d n ni) pm) (erased (NCyc n R) nc) (erased (NotIn x R) ox)
    (erased (Nth (Nat) n x a) pa) (erased (Nth (Nat) n a b) pb) -> (erased (NotIn a R) oa) (erased (NotIn b R) ob))
  (let-match erased (in-dec a R) (OrR _ _ oa)
