        (let ((erased w2) (erased fl)) (flip-exists (Zero) w1))
        (values (Cons (Gsym) (GSkip) w2) (BPP w1 w2 fl) (MGCons (BS0) (BS0) e1 (GSkip) X w2 (SSkip (BS0))
          (flip-bwd (BS0) (BP0 (BP1 (BS0))) (Zero) (BFalse) (BTrue) w1 w2 X (DpZ) fl
            (MkBot2 (BS0) (BP0 (BS0)) (BP0 (BP1 (BS0))) (BFalse) (BTrue) (BotF) (Bot0 (BS0) (BP1 (BS0)) (BTrue) (BotT))) (NotF) m2))))
      (absurd (SPush3 _) (addc-unit (C3) e1 ad nz))
      (absurd (SPop03 _) (addc-unit (C3) e1 ad nz))
      ((SPop12 _)
        (let-match erased ad (AThird _ _ _ t)) (let-match erased t (T312))
        (values (Cons (Gsym) (GSkip) w1) (BPQ w1) (MGCons (BS0) (BS0) e1 (GSkip) X w1 (SSkip (BS0)) m2)))))))

; The sum of the colours of the two ends of a live edge is not Color0.
(def-fns _ $ (erased edge-nz : (erased (Nat) ka kb) (erased (Col) a b c) (erased (AddK a b c) ad) (erased (ColOf ka a) pa) (erased (ColOf kb b) pb)
    (erased (Apart (Nat) Lt ka kb) ne) -> (erased (NonZero c) r))
  (match erased c _
    (absurd (C0) (let-match erased (addc-zero a b ad) (Refl _ _)) (colof-apart ka kb a ne pa pb))
    ((C1) (NZ1)) ((C2) (NZ2)) ((C3) (NZ3))))

(def-fns _ $ (erased lastfrom-tail : (erased (Col) c0 c1 l) (erased (List (Col)) cs et) (erased (LastFrom (Col) c0 (Cons (Col) c1 cs) l) lt) (erased (UTr cs et) ut)
    -> (erased (PairFrom l cs et) r))
  (match erased ut _
    ((UTNil) (PFNil l))
    ((UTCons c l1 cs1 _ lt1 pf1)
      (let-match erased lt (LFCons _ _ _ _ _ lta))
      (let-match erased lta (LFCons _ _ _ _ _ ltb))
      (let-match erased (lastfrom-fn (Col) c l1 l cs1 lt1 ltb) (Refl _ _))
      pf1)))

; The step of Kempe_map when f z = z: the chromogram of the contraction, with Gskip :: Gskip or Gpush :: Gpop0 in front.
(def-fns _ $ (erased step-a : (erased (Nat) d z ez fez) (erased (List (Nat)) e n f s ks e2 n2 f2 p1) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (LiveColoring d s e f ks) lc) (erased (Lt z d) lz) (erased (NotIn z s) zs)
    (erased (Nth (Nat) e z ez) pez) (erased (Nth (Nat) f z z) pfz) (erased (Nth (Nat) f ez fez) pfez) (erased (Apart (Nat) Lt fez z) nfez)
    (erased (LastFrom (Nat) z (Cons (Nat) ez p1) fez) lt) (erased (NotIn z p1) oz) (erased (NotIn ez p1) oe)
    (erased (KMatch d e2 n2 f2 (Cons (Nat) ez (Cons (Nat) z s)) ks p1) km) -> (erased (KMatch d e n f s ks (Cons (Nat) z (Cons (Nat) ez p1))) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased km (MkKMatch _ _ _ _ _ _ _ lc1 cs1 etH wH rp1 co1 ut1 mH kgH))
  (let ((erased kz) (erased pkz) (erased Cz) (erased ocz)) (lc-colc d z s e f ks lc lz))
  (let ((erased kez) (erased pkez) (erased Cez) (erased ocez)) (lc-colc d ez s e f ks lc (perm-val d z ez e nf pe pez)))
  (let ((erased rp0)) (RespCons ks _ _ z kz pkz (RespCons ks p1 lc1 ez kez pkez rp1)))
  (let ((erased co0)) (All2Cons _ _ ColOf kz Cz _ _ ocz (All2Cons _ _ ColOf kez Cez lc1 cs1 ocez co1)))
  (let ((erased ltc)) (lastfrom-cols (Cons _ kez lc1) (Cons _ Cez cs1) kz kez Cz Cez
    (lastfrom-resp ks (Cons _ ez p1) (Cons _ kez lc1) z fez kz kez lt rp0 (lc-face d ez fez kez s e f ks lc pfez pkez)) co0 ocez))
  (let ((erased E) (erased aE)) (addc-total Cez Cz))
  (let ((erased nz)) (edge-nz kez kz Cez Cz E aE ocez ocz (apart-sym kz kez (lc-edge d z ez kz kez s e f ks lc lz zs pez pkz pkez))))
  (let ((erased w) (erased st) (erased m)) (astep-build E etH wH nz mH))
  (MkKMatch d e n f s ks _ _ _ _ w rp0 co0
    (UTCons Cz Cez (Cons _ Cez cs1) _ ltc (PFCons Cez Cz E _ _ aE (PFCons Cz Cez E cs1 etH (addc-comm Cez Cz E aE) (lastfrom-tail Cz Cez Cez cs1 etH ltc ut1))))
    m (KGA d z ez fez e n f s p1 e2 n2 f2 wH w h ct pfz pfez nfez lt oz oe kgH st)))

; The step of Kempe_map when f z is off the ring z :: p.
(def-fns _ $ (erased step-b : (erased (Nat) d z ez fz fez nez) (erased (List (Nat)) e n f s ks e2 n2 f2 p) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (LiveColoring d s e f ks) lc) (erased (Lt z d) lz) (erased (NotIn z s) zs)
    (erased (Nth (Nat) e z ez) pez) (erased (Nth (Nat) f z fz) pfz) (erased (Nth (Nat) f ez fez) pfez) (erased (Apart (Nat) Lt fez z) nfez)
    (erased (LastFrom (Nat) z p fez) lt) (erased (NotIn z p) oz) (erased (NotIn ez p) oe)
    (erased (KMatch d e2 n2 f2 (Cons (Nat) ez (Cons (Nat) z s)) ks (Cons (Nat) nez (Cons (Nat) fz p))) km) -> (erased (KMatch d e n f s ks (Cons (Nat) z p)) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased km (MkKMatch _ _ _ _ _ _ _ lc1 cs1 etH wH rp1 co1 ut1 mH kgH))
  (let-match erased rp1 (RespCons _ _ _ _ knez pknez rp1a))
  (let-match erased rp1a (RespCons _ _ lcp _ kfz pkfz rpp))
  (let-match erased co1 (All2Cons _ _ _ _ Cnez _ _ ocnez co1a))
  (let-match erased co1a (All2Cons _ _ _ _ Cfz _ csp ocfz cop))
  (let-match erased ut1 (UTCons _ L _ _ lt1 pf1))
  (let-match erased pf1 (PFCons _ _ c2 _ _ a1 pf1a))
  (let-match erased pf1a (PFCons _ _ v _ X a2 pfp))
  (let ((erased kz) (erased pkz) (erased Cz) (erased ocz)) (lc-colc d z s e f ks lc lz))
  (let-match erased (nth-fn _ ks fz kfz kz pkfz (lc-face d z fz kz s e f ks lc pfz pkz)) (Refl _ _))
  (let-match erased (colof-fn kz Cfz Cz ocfz ocz) (Refl _ _))
  (let ((erased kez) (erased pkez) (erased Cez) (erased ocez)) (lc-colc d ez s e f ks lc (perm-val d z ez e nf pe pez)))
  (let ((erased pkfez)) (lc-face d ez fez kez s e f ks lc pfez pkez))
  (let-match erased p (Cons _ q p2) (absurd (Nil _) (let-match erased lt (LFNil _ _)) (apart-irrefl fez nfez)))
  (let ((erased ltH)) (LFCons _ nez fz fez p (lastfrom-head (Nat) z fz q fez p2 lt)))
  (let-match erased (lastfrom-fn (Col) Cnez L Cez (Cons _ Cz csp) lt1
      (lastfrom-cols (Cons _ kz lcp) (Cons _ Cz csp) knez kez Cnez Cez
        (lastfrom-resp ks (Cons _ fz p) (Cons _ kz lcp) nez fez knez kez ltH (RespCons ks _ _ nez knez pknez (RespCons ks p lcp fz kz pkfz rpp)) pkfez)
        (All2Cons _ _ ColOf knez Cnez _ _ ocnez (All2Cons _ _ ColOf kz Cz lcp csp ocz cop)) ocez))
    (Refl _ _))
  (let ((erased e1) (erased ae1)) (addc-total Cez Cz))
  (let ((erased nz)) (edge-nz kez kz Cez Cz e1 ae1 ocez ocz (apart-sym kz kez (lc-edge d z ez kz kez s e f ks lc lz zs pez pkz pkez))))
  (let ((erased w) (erased st) (erased m)) (bstep-build c2 e1 v X wH mH (addc-tri Cnez Cez Cz c2 e1 v (addc-comm Cez Cnez c2 a1) ae1 a2) nz))
  (let ((erased rp0)) (RespCons ks p lcp z kz pkz rpp))
  (let ((erased co0)) (All2Cons _ _ ColOf kz Cz lcp csp ocz cop))
  (let ((erased ltc)) (lastfrom-cols lcp csp kz kez Cz Cez (lastfrom-resp ks p lcp z fez kz kez lt rp0 pkfez) co0 ocez))
  (MkKMatch d e n f s ks _ _ _ _ w rp0 co0 (UTCons Cz Cez csp _ ltc (PFCons Cez Cz e1 csp X ae1 pfp)) m
    (KGB d z ez fz fez nez e n f s p e2 n2 f2 wH w h ct pfz pfez nfez lt oz oe kgH st)))

(def-fns _ $ (erased in-split : (erased (Nat) z) (erased (List (Nat)) R) (subterm erased (In z R) iz)
    -> (erased (List (Nat)) A B) (erased (Join A (Cons (Nat) z B) R) j))
  (match erased iz _
    ((InHere _ B) (values (Nil _) B (JoinNil _)))
    ((InThere _ y R1 iz1)
      (let ((erased A) (erased B) (erased j)) (in-split z R1 iz1))
      (values (Cons _ y A) B (JoinCons A _ R1 y j)))))

; A dart z of the ring, with f z = z or f z off the ring (Euler_tree, on permN).
(def-adts $ (KLeaf : ((List (Nat)) f R) -> Type)
  enum
  (many KLA : (erased (List (Nat)) f R) (erased (Nat) z) (erased (In z R) iz) (erased (Nth (Nat) f z z) pz) -> (KLeaf f R))
  (many KLB : (erased (List (Nat)) f R) (erased (Nat) z fz) (erased (In z R) iz) (erased (Nth (Nat) f z fz) pz) (erased (NotIn fz R) ofz) -> (KLeaf f R)))

(def-fns _ $ (erased off-at : (erased (List (Nat)) s R) (erased (Nat) z) (subterm erased (Off s R) av) (erased (In z R) iz) -> (erased (NotIn z s) r))
  (let-match erased av (OffCons _ R1 x px av1) (absurd (OffNil _) iz))
  (let-match erased iz (InThere _ _ _ iz1) ((InHere _ _) px))
  (off-at s R1 z av1 iz1))

(def-fns _ $ (erased kleaf : (erased (Nat) d x0) (erased (List (Nat)) e n f s ks xs ids) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (RingOK n s (Cons (Nat) x0 xs) ids) ro) (erased (LiveColoring d s e f ks) lc) -> (erased (KLeaf f (Cons (Nat) x0 xs)) r))
  (let ((erased R)) (Cons (Nat) x0 xs))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pm) (erased pf)) (hyper-core d e n f h))
  (let-match erased ro (MkRingOK _ _ _ _ nc ds av qc))
  (let-match erased nc (NCCons _ _ _ y fp back))
  (let ((erased lx0)) (perm-val d y x0 n ni pm back))
  (let ((erased ix0)) (InHere x0 xs))
  (match erased (euler-tree d x0 n f e (hyper-rot d e n f h) (genus-rot d (Zero) e n f h g) lx0) _
    ((LeafNode _ _ _ _ z wp pz) (let-match erased wp (MkSomePath _ _ zs _ _ w)) (KLA f R z (path-ncyc n R zs x0 z w nc ix0) pz))
    (absurd (LeafFace _ _ _ _ z wp pz)
      (let-match erased wp (MkSomePath _ _ zs _ _ w))
      (let ((erased iz)) (path-ncyc n R zs x0 z w nc ix0))
      (let ((erased lz)) (perm-val d z z e nf pe pz))
      (let ((erased kz) (erased pkz)) (lc-col d z s e f ks lc lz))
      (let ((erased oz)) (off-at s R z av iz))
      (apart-irrefl kz (lc-edge d z z kz kz s e f ks lc lz oz pz pkz pkz)))
    ((LeafCut _ _ _ _ z z2 wp pz sp)
      (let-match erased wp (MkSomePath _ _ zs _ _ w))
      (let ((erased iz)) (path-ncyc n R zs x0 z w nc ix0))
      (KLB f R z z2 iz pz (seps-notin d n ni R z z2 pm nc iz sp)))))

(def-fns _ $ (erased notin-join-inv : (erased (Nat) x) (erased (List (Nat)) A C R) (subterm erased (Join A C R) j) (erased (NotIn x R) ox)
    -> (erased (NotIn x A) oa) (erased (NotIn x C) oc))
  (let-match erased j (JoinCons A1 _ R1 y j1) ((JoinNil _) (values (NotInNil x) ox)))
  (let-match erased ox (NotInCons _ _ _ ne ox1))
  (let ((erased oa) (erased oc)) (notin-join-inv x A1 C R1 j1 ox1))
  (values (NotInCons x y A1 ne oa) oc))

; What the two steps of Kempe_map share: the contraction of the edge z, e z of the ring z :: p, and its colouring.
(def-fns _ $ (erased kprep : (erased (Nat) N1 d m z) (erased (List (Nat)) e n f s ks p ids) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (Dead d e n f s m) dd) (erased (Lt m (Succ N1)) lm) (erased (Plain d e) pl) (erased (RingOK n s (Cons (Nat) z p) ids) ro)
    (erased (LiveColoring d s e f ks) lc) (erased (Lt z d) lz)
    -> (erased (Nat) ez fez m2) (erased (List (Nat)) e2 n2 f2) (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Genus d e2 n2 f2 (Zero)) g2) (erased (Dead d e2 n2 f2 (Cons (Nat) ez (Cons (Nat) z s)) m2) dd2) (erased (Lt m2 N1) lm2)
    (erased (Plain d e2) pl2) (erased (LiveColoring d (Cons (Nat) ez (Cons (Nat) z s)) e2 f2 ks) lcH)
    (erased (FixedIn n2 (Cons (Nat) ez (Cons (Nat) z s))) fn2) (erased (NotIn z s) zs) (erased (NotIn ez s) oute)
    (erased (Nth (Nat) e z ez) pez) (erased (Nth (Nat) e ez z) pze) (erased (Nth (Nat) f ez fez) pfez) (erased (Apart (Nat) Lt fez z) nfez)
    (erased (LastFrom (Nat) z p fez) lt) (erased (NotIn z p) oz))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pm) (erased pf)) (hyper-core d e n f h))
  (let-match erased ro (MkRingOK _ _ _ _ nc ds av qc))
  (let-match erased nc (NCCons _ _ _ y fp back))
  (let-match erased ds (DistCons _ _ oz dsp))
  (let-match erased av (OffCons _ _ _ zs avp))
  (let ((erased ez) (erased pez) (erased _)) (perm-nth d z e nf pe lz))
  (let ((erased pze)) (plain-at d z ez e pl lz pez))
  (let ((erased e2) (erased n2) (erased f2) (erased m2) (erased ct) (erased h2) (erased g2) (erased em) (erased dd2) (erased ne) (erased oute))
    (kempe-cut d m z ez e n f s ks h g dd lc lz zs pez pze))
  (let-match erased em (Refl _ _))
  (let ((erased lm2)) (lt-succ-left m2 N1 (lt-pred (Succ m2) N1 lm)))
  (let-match erased dd2 (MkDead _ _ k2 _ _ _ _ fe2 fn2 ff2 ds2 ls2 us2 a2))
  (let-match erased ct (MkCut2 _ _ _ fz0 fez _ _ _ e1 n1 f1 _ _ _ h1 ske skf skn skf2 h3 pez1 pze1 ne1 pfz0 nfz pfez nfez))
  (let-match erased (perm-inj d y fez z n ni pm back (hyper-node d fez ez z e n f h pfez pez)) (Refl _ _))
  (values ez fez m2 e2 n2 f2 ct h2 g2 dd2 lm2 (cut-plain d z ez e n f s e2 n2 f2 h ct h2 pl fe2) (cut-proj d z ez e n f s ks e2 n2 f2 h ct h2 ff2 lc)
    fn2 zs oute pez pze pfez nfez (fpath-last n p z fez fp) oz))

; Kempe_map's induction, on the number of live darts: a chromogram matching the trace of a colouring on the ring, and a
; certificate for it.
(def-fns _ $ (erased kempe-build : (subterm erased (Nat) N) (erased (Nat) d m) (erased (List (Nat)) e n f s ks R ids)
    (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g) (erased (Dead d e n f s m) dd) (erased (Lt m N) lm)
    (erased (Plain d e) pl) (erased (Iota d ids) io) (erased (RingOK n s R ids) ro) (erased (LiveColoring d s e f ks) lc)
    -> (erased (KMatch d e n f s ks R) r))
  (let-match erased N (Succ N1) (absurd (Zero) lm))
  (let-match erased R (Cons _ x0 xs)
    ((Nil _) (MkKMatch d e n f s ks (Nil _) (Nil _) (Nil _) (Nil _) (Nil _) (RespNil ks) (All2Nil _ _ ColOf) (UTNil) (MGNil) (KGNil d e n f s ks lc))))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pm) (erased pf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (match erased (kleaf d x0 e n f s ks xs ids h g ro lc) _
    ((KLA _ _ z iz pfz)
      (let ((erased A) (erased B) (erased j)) (in-split z R iz))
      (let ((erased R2) (erased j2)) (join-exists (Cons _ z B) A))
      (let-match erased j2 (JoinCons _ _ p _ j3))
      (let ((erased ro2)) (ring-turn n s A (Cons _ z B) R R2 ids j (JoinCons B A p z j3) ro))
      (let ((erased lz)) (nth-lt-length _ f z d z pfz lf))
      (let ((erased ez) (erased fez) (erased m2) (erased e2) (erased n2) (erased f2) (erased ct) (erased h2) (erased g2) (erased dd2) (erased lm2)
          (erased pl2) (erased lcH) (erased fn2) (erased zs) (erased oute) (erased pez) (erased pze) (erased pfez) (erased nfez) (erased lt) (erased oz))
        (kprep N1 d m z e n f s ks p ids h g dd lm pl ro2 lc lz))
      (let-match erased ro2 (MkRingOK _ _ _ _ nc ds av qc))
      (let-match erased nc (NCCons _ _ _ y fp back))
      (let-match erased fp (FPCons _ p1 _ q _ pq fp1) (absurd (FPNil _ _) (lc-node d z s e n f ks h lc lz zs back)))
      (let-match erased (nth-fn _ n z q ez pq (hyper-node d z z ez e n f h pfz pze)) (Refl _ _))
      (let-match erased ds (DistCons _ _ _ ds1))
      (let-match erased ds1 (DistCons _ _ oe _))
      (let-match erased oz (NotInCons _ _ _ _ ozp1))
      (let ((erased roH)) (ringok-a d z ez e n f s e2 n2 f2 p1 ids h ct fn2 ro2 io))
      (km-turn d e n f s ks (Cons _ z B) A R2 R (JoinCons B A p z j3) j
        (step-a d z ez fez e n f s ks e2 n2 f2 p1 h ct lc lz zs pez pfz pfez nfez lt ozp1 oe
          (kempe-build N1 d m2 e2 n2 f2 _ ks p1 ids h2 g2 dd2 lm2 pl2 io roH lcH))))
    ((KLB _ _ z fz iz pfz ofz)
      (let ((erased A) (erased B) (erased j)) (in-split z R iz))
      (let ((erased R2) (erased j2)) (join-exists (Cons _ z B) A))
      (let-match erased j2 (JoinCons _ _ p _ j3))
      (let ((erased ro2)) (ring-turn n s A (Cons _ z B) R R2 ids j (JoinCons B A p z j3) ro))
      (let ((erased lz)) (nth-lt-length _ f z d fz pfz lf))
      (let ((erased ez) (erased fez) (erased m2) (erased e2) (erased n2) (erased f2) (erased ct) (erased h2) (erased g2) (erased dd2) (erased lm2)
          (erased pl2) (erased lcH) (erased fn2) (erased zs) (erased oute) (erased pez) (erased pze) (erased pfez) (erased nfez) (erased lt) (erased oz))
        (kprep N1 d m z e n f s ks p ids h g dd lm pl ro2 lc lz))
      (let ((erased oa) (erased oc)) (notin-join-inv fz A (Cons _ z B) R j ofz))
      (let ((erased ofz2)) (notin-join fz (Cons _ z B) A R2 (JoinCons B A p z j3) oc oa))
      (let ((erased nez) (erased pnez) (erased _)) (perm-nth d ez n ni pm (perm-val d z ez e nf pe pez)))
      (let-match erased ro2 (MkRingOK _ _ _ _ nc ds av qc))
      (let-match erased (in-dec ez R2) (OrR _ _ oeR)
        (absurd (OrL _ _ ie) (apart-irrefl fz (notin-in fz fz R2 ofz2 (ncyc-prev d n ni R2 fz ez pm nc ie (hyper-node d fz z ez e n f h pfz pze))))))
      (let-match erased oeR (NotInCons _ _ _ _ oe))
      (let ((erased roH)) (ringok-b d m z ez fz nez e n f s ks e2 n2 f2 p ids h ct fn2 dd lc ro2 io pfz ofz2 pnez oute))
      (km-turn d e n f s ks (Cons _ z B) A R2 R (JoinCons B A p z j3) j
        (step-b d z ez fz fez nez e n f s ks e2 n2 f2 p h ct lc lz zs pez pfz pfez nfez lt oz oe
          (kempe-build N1 d m2 e2 n2 f2 _ ks (Cons _ nez (Cons _ fz p)) ids h2 g2 dd2 lm2 pl2 io roH lcH))))))

(def-fns _ $ (erased proper-live : (erased (List (Nat)) ks) (erased (List (Bond)) g) (subterm erased (Proper ks g) pr) -> (erased (EdgeLive (Nil (Nat)) ks g) r))
  (let-match erased pr (ProperCons _ g1 x y l1 l2 p1 p2 ne pr1) ((ProperNil _) (ELNil _ ks)))
  (ELLive _ ks g1 x y l1 l2 (NotInNil x) p1 p2 ne (proper-live ks g1 pr1)))

(def-fns _ $ (erased live-proper : (erased (List (Nat)) ks) (erased (List (Bond)) g) (subterm erased (EdgeLive (Nil (Nat)) ks g) el) -> (erased (Proper ks g) r))
  (match erased el _
    ((ELNil _ _) (ProperNil ks))
    (absurd (ELDead _ _ _ _ _ ix _) ix)
    ((ELLive _ _ g1 x y l1 l2 _ p1 p2 ne el1) (ProperCons ks g1 x y l1 l2 p1 p2 ne (live-proper ks g1 el1)))))

(def-fns _ $ (erased four-live : (erased (Nat) d) (erased (List (Nat)) e n f ks) (erased (Hypermap d e n f) h) (erased (FourColoring e f ks) c)
    -> (erased (LiveColoring d (Nil (Nat)) e f ks) r))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased ids) (erased io)) (iota-exists d))
  (let ((erased ge) (erased gr)) (graph-exists d e le))
  (let-match erased c (MkFourColoring _ _ _ ke rf re df u))
  (let ((erased lk)) (respects-length ks f ks d rf lf))
  (MkLC d _ e f ks ge gr rf (proper-live ks ge (coloring-proper d e f ks ids ge c gr io lk)) u lk))

(def-fns _ $ (erased live-four : (erased (Nat) d) (erased (List (Nat)) e n f ks) (erased (Hypermap d e n f) h) (erased (LiveColoring d (Nil (Nat)) e f ks) lc)
    -> (erased (FourColoring e f ks) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased ids) (erased io)) (iota-exists d))
  (let-match erased lc (MkLC _ _ _ _ _ ge gr rf el u lk))
  (proper-coloring d e f ks ids ge (live-proper ks ge el) gr io rf u lk (perm-under d e nf pe)))

(def-fns _ $ (erased invb-order : (erased (Nat) d) (erased (List (Nat)) e) (erased (List (Bond)) g) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Length (Nat) e d) le) (subterm erased (Fun e g) fg) -> (erased (InvB e g) r))
  (let-match erased fg (FunCons _ g1 x y px fg1) ((FunNil _) (IBNil e)))
  (let ((erased q) (erased _)) (plain-eq d x y e pl (nth-lt-length _ e x d y px le) px))
  (IBCons e g1 x y q (invb-order d e g1 pl le fg1)))

(def-fns _ $ (erased plain-of : (erased (Nat) d) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    -> (erased (Plain d e) r))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased g) (erased gr)) (graph-exists d e le))
  (MkPlain d e g gr (invb-order d e g pl le (graph-fun d e g gr))))

; trace (c0 :: lc) is urtrace (lc ++ [c0]).
(def-fns _ $ (erased tracefrom-pair : (erased (Col) c0 c) (erased (List (Col)) lc lc2 et) (subterm erased (TraceFrom c0 c lc et) t) (erased (HSnoc (Col) lc c0 lc2) sn)
    -> (erased (PairFrom c lc2 et) r))
  (match erased t _
    ((TFEnd _ _ s a) (let-match erased sn (SnocNil _ _)) (PFCons c c0 s (Nil _) (Nil _) a (PFNil c0)))
    ((TFCons _ _ c2 s lc1 et1 a t1)
      (let-match erased sn (SnocCons _ _ _ _ lc3 sn1))
      (PFCons c c2 s lc3 et1 a (tracefrom-pair c0 c2 lc1 lc3 et1 t1 sn1)))))

(def-fns _ $ (erased pair-tracefrom : (erased (Col) c0 c) (erased (List (Col)) lc lc2 et) (subterm erased (HSnoc (Col) lc c0 lc2) sn) (erased (PairFrom c lc2 et) pf)
    -> (erased (TraceFrom c0 c lc et) r))
  (match erased sn _
    ((SnocNil _ _) (let-match erased pf (PFCons _ _ s _ _ a pf1)) (let-match erased pf1 (PFNil _)) (TFEnd c0 c s a))
    ((SnocCons _ c2 _ lc1 lc3 sn1)
      (let-match erased pf (PFCons _ _ s _ et1 a pf1))
      (TFCons c0 c c2 s lc1 et1 a (pair-tracefrom c0 c2 lc1 lc3 et1 sn1 pf1)))))

(def-fns _ $ (erased trace-utr : (erased (Col) c) (erased (List (Col)) lc lc2 et) (erased (Trace (Cons (Col) c lc) et) t) (erased (HSnoc (Col) lc c lc2) sn)
    -> (erased (UTr lc2 et) r))
  (let-match erased t (TrCons _ _ _ t1))
  (let ((erased pf)) (tracefrom-pair c c lc lc2 et t1 sn))
  (match erased sn _
    ((SnocNil _ _) (UTCons c c (Nil _) et (LFNil _ c) pf))
    ((SnocCons _ c1 _ lc1 lc3 sn1) (UTCons c1 c lc3 et (lastfrom-snoc (Col) c1 c lc3 lc sn) pf))))

(def-fns _ $ (erased utr-trace : (erased (Col) c) (erased (List (Col)) lc lc2 et) (erased (UTr lc2 et) u) (erased (HSnoc (Col) lc c lc2) sn)
    -> (erased (Trace (Cons (Col) c lc) et) r))
  (let-match erased u (UTCons c1 l lc3 _ lt pf) (absurd (UTNil) sn))
  (let-match erased (lastfrom-fn (Col) c1 l c lc3 lt (lastfrom-snoc (Col) c1 c lc3 lc sn)) (Refl _ _))
  (TrCons c lc et (pair-tracefrom c c lc lc2 et sn pf)))

(def-fns _ $ (erased off-nil : (subterm erased (List (Nat)) r) -> (erased (Off (Nil (Nat)) r) a))
  (let-match erased r (Cons _ x r1) ((Nil _) (OffNil _)))
  (OffCons _ r1 x (NotInNil x) (off-nil r1)))

(def-fns _ $ (erased respects-unsnoc : (erased (List (Nat)) k r0 R lcR) (erased (Nat) x) (subterm erased (HSnoc (Nat) r0 x R) sn) (erased (Respects k R lcR) rp)
    -> (erased (List (Nat)) lc0) (erased (Nat) l) (erased (HSnoc (Nat) lc0 l lcR) sl) (erased (Respects k r0 lc0) r) (erased (Nth (Nat) k x l) pl))
  (match erased sn _
    ((SnocNil _ _) (let-match erased rp (RespCons _ _ _ _ l pl rp1)) (let-match erased rp1 (RespNil _)) (values (Nil _) l (SnocNil _ l) (RespNil k) pl))
    ((SnocCons _ a _ r1 R1 sn1)
      (let-match erased rp (RespCons _ _ lc1 _ la pa rp1))
      (let ((erased lc0) (erased l) (erased sl) (erased r) (erased pl)) (respects-unsnoc k r1 R1 lc1 x sn1 rp1))
      (values (Cons _ la lc0) l (SnocCons _ la l lc0 lc1 sl) (RespCons k r1 lc0 a la pa r) pl))))

(def-fns _ $ (erased cols-unsnoc : (erased (List (Nat)) lc0 lc) (erased (List (Col)) cs) (erased (Nat) l) (subterm erased (HSnoc (Nat) lc0 l lc) sn)
    (erased (All2 (Nat) (Col) ColOf lc cs) co) -> (erased (List (Col)) cs0) (erased (Col) c) (erased (HSnoc (Col) cs0 c cs) sc)
    (erased (All2 (Nat) (Col) ColOf lc0 cs0) r) (erased (ColOf l c) pc))
  (match erased sn _
    ((SnocNil _ _) (let-match erased co (All2Cons _ _ _ _ c _ _ pc co1)) (let-match erased co1 (All2Nil _ _ _))
      (values (Nil _) c (SnocNil _ c) (All2Nil _ _ ColOf) pc))
    ((SnocCons _ a _ lc1 lc2 sn1)
      (let-match erased co (All2Cons _ _ _ _ b _ cs1 pb co1))
      (let ((erased cs0) (erased c) (erased sc) (erased r) (erased pc)) (cols-unsnoc lc1 lc2 cs1 l sn1 co1))
      (values (Cons _ b cs0) c (SnocCons _ b c cs0 cs1 sc) (All2Cons _ _ ColOf a b lc1 cs0 pb r) pc))))

; The ring of Kempe_map is cubic off r: every dart of 0..d-1 not in r has n (n (n x)) = x.
(def-adts $ (QuasiCubic : ((Nat) d) ((List (Nat)) n r) -> Type)
  enum
  (many MkQuasiCubic : (erased (Nat) d) (erased (List (Nat)) n r ids) (erased (Iota d ids) io) (erased (QCubic n r ids) qc) -> (QuasiCubic d n r)))

; The certificate of Kempe_map for the ring r and the chromogram w, on the rotation of r that urtrace reads.
(def-adts $ (KRing : ((Nat) d) ((List (Nat)) e n f r) ((List (Gsym)) w) -> Type)
  enum
  (many KRNil : (erased (Nat) d) (erased (List (Nat)) e n f ks) (erased (FourColoring e f ks) c) -> (KRing d e n f (Nil (Nat)) (Nil (Gsym))))
  (many KRCons : (erased (Nat) d x) (erased (List (Nat)) e n f r0 R) (erased (List (Gsym)) w) (erased (Hypermap d e n f) h)
      (erased (HSnoc (Nat) r0 x R) sn) (erased (KGood d e n f (Nil (Nat)) R w) kg) -> (KRing d e n f (Cons (Nat) x r0) w)))

; Kempe_map, the second half of Kempe_closed (ring_trace r) for a ring r of a planar plain map cubic off r: each ring trace
; matches a chromogram w with a certificate ...
(def-fns _ $ (erased kempe-map : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (List (Col)) et) (erased (Hypermap d e n f) h)
    (erased (Genus d e n f (Zero)) g) (erased (AllOrder d e (Succ (Succ (Zero)))) pl) (erased (QuasiCubic d n r) qc) (erased (NCyc n r) nc)
    (erased (Distinct r) ds) (erased (RingTrace e f r et) rt) -> (erased (List (Gsym)) w) (erased (MatchG (BS0) et w) m) (erased (KRing d e n f r w) kr))
  (let-match erased rt (MkRingTrace _ _ _ ks lc cs _ c rl co t))
  (let-match erased r (Cons _ x r0)
    ((Nil _) (let-match erased rl (RespNil _)) (let-match erased co (All2Nil _ _ _)) (let-match erased t (TrNil)) (values (Nil _) (MGNil) (KRNil d e n f ks c))))
  (let-match erased qc (MkQuasiCubic _ _ _ ids io qc1))
  (let ((erased R) (erased sn)) (snoc-exists _ r0 x))
  (let ((erased ro)) (ring-rot n (Nil _) r0 R ids x (MkRingOK n (Nil _) r ids nc ds (off-nil r) qc1) sn))
  (let ((erased lc0)) (four-live d e n f ks h c))
  (let ((erased dd)) (MkDead d d (Zero) e n f (Nil _) (FixNil e) (FixNil n) (FixNil f) (DistNil) (LengthNil _) (UnderNil d) (AddZero d)))
  (let-match erased (kempe-build (Succ d) d d e n f (Nil _) ks R ids h g dd (lt-succ d) (plain-of d e n f h pl) io ro lc0)
    (MkKMatch _ _ _ _ _ _ _ lcR csR etR w rpR coR utR m kg))
  (let-match erased rl (RespCons _ _ lc1 _ l pl0 rl1))
  (let ((erased lc2) (erased sl)) (snoc-exists _ lc1 l))
  (let-match erased (respects-fn ks R lcR lc2 rpR (respects-snoc ks r0 R lc1 lc2 x l rl1 pl0 sn sl)) (Refl _ _))
  (let-match erased co (All2Cons _ _ _ _ c0 _ cs1 pc0 co1))
  (let ((erased cs2) (erased sc) (erased co2)) (cols-snoc lc1 lcR cs1 l c0 co1 sl pc0))
  (let-match erased (cols-fn lcR csR cs2 coR co2) (Refl _ _))
  (let-match erased (utr-fn csR etR et utR (trace-utr c0 cs1 csR et t sc)) (Refl _ _))
  (values w m (KRCons d x e n f r0 R w h sn kg)))

; ... every trace matching which is a ring trace.
(def-fns _ $ (erased kempe-map-sound : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (List (Gsym)) w) (erased (List (Col)) et)
    (erased (KRing d e n f r w) kr) (erased (MatchG (BS0) et w) m) -> (erased (RingTrace e f r et) rt))
  (match erased kr _
    ((KRNil _ _ _ _ ks c) (let-match erased m (MGNil)) (MkRingTrace e f _ ks (Nil _) (Nil _) (Nil _) c (RespNil ks) (All2Nil _ _ ColOf) (TrNil)))
    ((KRCons _ x _ _ _ r0 R _ h sn kg)
      (let-match erased (kgood-sound d e n f (Nil _) R w et kg m) (MkLRT _ _ _ _ _ ks lcR csR _ lc rpR coR utR))
      (let ((erased lc0) (erased l) (erased sl) (erased rp0) (erased pl)) (respects-unsnoc ks r0 R lcR x sn rpR))
      (let ((erased cs0) (erased c) (erased sc) (erased co0) (erased pc)) (cols-unsnoc lc0 lcR csR l sl coR))
      (MkRingTrace e f _ ks _ _ et (live-four d e n f ks h lc) (RespCons ks r0 lc0 x l pl rp0) (All2Cons _ _ ColOf l c lc0 cs0 pc co0)
        (utr-trace c cs0 csR et utR sc)))))

; The hypotheses of Kempe_map (ucycle_planar_plain_quasicubic r).
(def-adts $ (KempeRing : ((Nat) d) ((List (Nat)) e n f r) -> Type)
  enum
  (many MkKempeRing : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
      (erased (AllOrder d e (Succ (Succ (Zero)))) pl) (erased (QuasiCubic d n r) qc) (erased (NCyc n r) nc) (erased (Distinct r) ds)
      -> (KempeRing d e n f r)))

; After kcc-coclosure of red/bridge.sl, for the ring traces of r, which Kempe_map makes Kempe-closed, with its certificates
; in place of KClosed's functions: a trace of the co-closure KCC of Q that is a ring trace of r leads to a trace of Q that
; is a ring trace of r.
(def-fns _
  ((erased kcc-kempe : (erased Pred Q) (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (KempeRing d e n f r) kr) (erased (List (Col)) ct)
      (subterm erased (KCC Q ct) k) (erased (RingTrace e f r ct) p) -> (erased (List (Col)) ct2) (erased (Holds Q ct2) q) (erased (RingTrace e f r ct2) p2))
    (let-match erased k (KCGram _ _ a)
      ((KCIn _ _ q) (values ct q p))
      ((KCPerm _ _ ct2 gp ip pt k2) (kcc-kempe Q d e n f r kr ct2 k2 (ring-trace-perm e f r ct ct2 gp ip pt p))))
    (let-match erased kr (MkKempeRing _ _ _ _ _ h g pl qc nc ds))
    (let ((erased w) (erased m) (erased kg)) (kempe-map d e n f r ct h g pl qc nc ds p))
    (amc-kempe Q d e n f r kr ct w kg (BS0) ct (Nil _) w a m (RANil _ w)))
  ((erased amc-kempe : (erased Pred Q) (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (KempeRing d e n f r) kr) (erased (List (Col)) ct0)
      (erased (List (Gsym)) w0) (erased (KRing d e n f r w0) kg) (erased (Bstack) bs) (erased (List (Col)) ct) (erased (List (Gsym)) pre u)
      (subterm erased (AMC Q bs ct pre) a) (erased (MatchG bs ct u) m) (erased (RevApp (Gsym) pre u w0) ra)
      -> (erased (List (Col)) ct2) (erased (Holds Q ct2) q) (erased (RingTrace e f r ct2) p2))
    (match erased m _
      ((MGNil)
        (let-match erased a (AMCEnd _ _ w2 ra2 wt) (absurd (AMCOpen _ _ _ pp _) pp))
        (let-match erased (revapp-fn (Gsym) pre u w0 w2 ra ra2) (Refl _ _))
        (let-match erased wt (MkWitC _ _ ct2 m2 k2))
        (kcc-kempe Q d e n f r kr ct2 k2 (kempe-map-sound d e n f r w0 ct2 kg m2)))
      ((MGCons _ bs2 c s ct1 u1 y m1)
        (let ((erased ra1)) (RACons (Gsym) s pre u1 w0 ra))
        (match erased (sym-cls s bs bs2 c y) _
          ((SCSkip _)
            (let-match erased a (AMC1 _ _ _ _ a1) (absurd (AMC23 _ _ _ _ _ _ y1 _ _) y1))
            (amc-kempe Q d e n f r kr ct0 w0 kg bs ct1 (Cons _ (GSkip) pre) u1 a1 m1 ra1))
          ((SCPush _ _ _ _)
            (let-match erased a (AMC23 _ _ bs1 _ _ _ y1 a1 _) (absurd (AMC0 _ _ _ _) y) (absurd (AMC1 _ _ _ _ _) y))
            (let-match erased (sym-fn (GPush) bs bs2 bs1 c y y1) (Refl _ _))
            (amc-kempe Q d e n f r kr ct0 w0 kg bs2 ct1 (Cons _ (GPush) pre) u1 a1 m1 ra1))
          ((SCPop _ _ _ _ pp _)
            (let-match erased a (AMC23 _ _ _ _ _ _ _ _ ap) (absurd (AMC0 _ _ _ _) y) (absurd (AMC1 _ _ _ _ _) (let-match erased y (SSkip _)) pp))
            (let-match erased ap (APCSome _ _ b0 t _ _ _ pp2 z a1) (absurd (APCNone _ _ _ _) pp))
            (let-match erased (popped-fn bs bs2 b0 pp pp2) (Refl _ _))
            (let-match erased (pop-fn s t bs bs2 c pp y z) (Refl _ _))
            (amc-kempe Q d e n f r kr ct0 w0 kg bs2 ct1 (Cons _ s pre) u1 a1 m1 ra1)))))))

(def-adts $ (RArgs : -> Type)
  enum
  (many MkRArgs : (erased (Nat) d) (erased (List (Nat)) e n f r) -> (RArgs)))

; The ring traces of r, and the chromograms of Kempe_map's certificates, as red/'s predicates with a parameter.
(def-adts $ (RTP : ((RArgs) a) ((List (Col)) et) -> Type)
  enum
  (many MkRTP : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (List (Col)) et) (erased (RingTrace e f r et) p) -> (RTP (MkRArgs d e n f r) et)))

(def-adts $ (RKP : ((RArgs) a) ((List (Col)) et) ((List (Gsym)) w) -> Type)
  enum
  (many MkRKP : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (List (Col)) et) (erased (List (Gsym)) w) (erased (KRing d e n f r w) p)
      -> (RKP (MkRArgs d e n f r) et w)))

; Kempe_map as red/bridge.sl's KClosed: the ring traces of r are Kempe-closed, by functions at a level L it returns.
(def-fns _ $ (erased kempe-closed : (erased (Nat) d) (erased (List (Nat)) e n f r) (erased (KempeRing d e n f r) kr)
    -> (erased (Level) L) (erased (KClosed L (MkPred (RArgs) (MkRArgs d e n f r) RTP) (MkRel (RArgs) (MkRArgs d e n f r) RKP)) cl))
  (let ((erased a)) (MkRArgs d e n f r))
  (let ((erased P2)) (MkPred (RArgs) a RTP))
  (let ((erased R)) (MkRel (RArgs) a RKP))
  (let-match erased kr (MkKempeRing _ _ _ _ _ h g pl qc nc ds))
  (def-fns _
    ((erased cp : (erased (List (Col)) ct ct2) (erased (Perm) gp) (erased (IsPerm gp) ip) (erased (PermT gp ct ct2) pt) (erased (Holds P2 ct) p)
        -> (erased (Holds P2 ct2) q))
      (let-match erased p (MkHolds _ _ _ _ h0))
      (let-match erased h0 (MkRTP _ _ _ _ _ _ rt))
      (MkHolds (RArgs) a RTP ct2 (MkRTP d e n f r ct2 (ring-trace-perm e f r ct ct2 gp ip pt rt))))
    ((erased cg : (erased (List (Col)) ct) (erased (Holds P2 ct) p) -> (erased (List (Gsym)) w) (erased (MatchG (BS0) ct w) m) (erased (HoldsR R ct w) q))
      (let-match erased p (MkHolds _ _ _ _ h0))
      (let-match erased h0 (MkRTP _ _ _ _ _ _ rt))
      (let ((erased w) (erased m) (erased kg)) (kempe-map d e n f r ct h g pl qc nc ds rt))
      (values w m (MkHoldsR (RArgs) a RKP ct w (MkRKP d e n f r ct w kg))))
    ((erased cm : (erased (List (Col)) ct ct2) (erased (List (Gsym)) w) (erased (HoldsR R ct w) q) (erased (MatchG (BS0) ct2 w) m) -> (erased (Holds P2 ct2) p))
      (let-match erased q (MkHoldsR _ _ _ _ _ h0))
      (let-match erased h0 (MkRKP _ _ _ _ _ _ _ kg))
      (MkHolds (RArgs) a RTP ct2 (MkRTP d e n f r ct2 (kempe-map-sound d e n f r w ct2 kg m)))))
  (values (level-of cp) (MkKClosed (level-of cp) P2 R cp cg cm)))
