      (let-match erased (nat-eq fz z) (Unequal _ _ _ _ nfzz) ((Equal _ _ _) (values cz k0z k0z)))
      (let-match erased hz (InR _ _ pk) (absurd (InL _ _ eq) (let-match erased eq (Refl _ _)) (apart-irrefl fz nfzz)))
      (values cz k0z (set2-other k1 k0 z cz ez cez fz cz st pk nfzz nfz))))
  (let-match erased (nat-eq x ez) (Unequal _ _ _ _ nx)
    ((Equal _ _ _)
      (let-match erased (nth-fn _ f ez c fez px pfez) (Refl _ _))
      (let-match erased (nat-eq fez ez) (Unequal _ _ _ _ nfee) ((Equal _ _ _) (values cez k0ez k0ez)))
      (values cez k0ez (set2-other k1 k0 z cz ez cez fez cez st hez nfez nfee))))
  (let ((erased l) (erased pl)) (lc-col d x s2 e2 f2 k1 lc1 lx))
  (let ((erased k0x)) (set2-other k1 k0 z cz ez cez x l st pl nxz nx))
  (let-match erased (nat-eq c z) (Unequal _ _ _ _ ncz)
    ((Equal _ _ _)
      (let ((erased nfzz)) (apart-sym z fz (img-apart d x z z fz f fi pf px pfz nxz)))
      (let ((erased q)) (lc-face d x fz l s2 e2 f2 k1 lc1 (cut-f2-z d z ez x fz e n f e2 n2 f2 h ct px pfz nxz nx nfz) pl))
      (let-match erased hz (InR _ _ pk) (absurd (InL _ _ eq) (let-match erased eq (Refl _ _)) (apart-irrefl fz nfzz)))
      (let-match erased (nth-fn _ k1 fz l cz q pk) (Refl _ _))
      (values l k0x k0z)))
  (let-match erased (nat-eq c ez) (Unequal _ _ _ _ nc)
    ((Equal _ _ _)
      (let ((erased q)) (lc-face d x fez l s2 e2 f2 k1 lc1 (cut-f2-ez d z ez x fez e n f e2 n2 f2 h ct px pfez nxz nx nfez) pl))
      (let-match erased (nth-fn _ k1 fez l cez q hez) (Refl _ _))
      (values l k0x k0ez)))
  (values l k0x (set2-other k1 k0 z cz ez cez c l st (lc-face d x c l s2 e2 f2 k1 lc1 (cut-f2 d z ez x c e n f e2 n2 f2 h ct px nxz nx ncz nc) pl) ncz nc)))

(def-fns _ $ (erased lift-const : (erased (Nat) d z ez fz fez cz cez) (erased (List (Nat)) e n f s k1 k0 e2 n2 f2) (erased (List (Bond)) g)
    (erased (Hypermap d e n f) h) (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (LiveColoring d (Cons (Nat) ez (Cons (Nat) z s)) e2 f2 k1) lc1)
