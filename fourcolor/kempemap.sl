  (ConstCons ks g1 x y l pl (proj-face-at d z ez x y l e n f s ks e2 n2 f2 h ct ff2 lc lx px pl) (proj-const d z ez e n f s ks e2 n2 f2 g1 h ct ff2 lc lf2 fg1)))

(def-fns _ $ (erased proj-edge : (erased (Nat) d z ez) (erased (List (Nat)) e n f s ks e2 n2 f2) (erased (List (Bond)) g) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (LiveColoring d s e f ks) lc) (erased (Length (Nat) e2 d) le2) (subterm erased (Fun e2 g) fg)
