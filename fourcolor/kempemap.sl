    (erased (LiveColoring d s e f ks) lc) (erased (Lt x d) lx) (erased (NotIn x s) out) (erased (Nth (Nat) n x x) px) -> (erased (False) r))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased a) (erased pa) (erased la)) (perm-nth d x e nf pe lx))
  (let ((erased c) (erased pc)) (lc-col d x s e f ks lc lx))
  (let ((erased c2) (erased pc2)) (lc-col d a s e f ks lc la))
  (let-match erased (nth-fn _ ks x c2 c (lc-face d a x c2 s e f ks lc (hyper-third d a x x e n f h pa px) pc2) pc) (Refl _ _))
  (apart-irrefl c (lc-edge d x a c c s e f ks lc lx out pa pc pc2)))

(def-fns _ $ (erased kempe-cut : (erased (Nat) d m z ez) (erased (List (Nat)) e n f s ks) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) g)
    (erased (Dead d e n f s m) dd) (erased (LiveColoring d s e f ks) lc) (erased (Lt z d) lz) (erased (NotIn z s) out) (erased (Nth (Nat) e z ez) pez)
    (erased (Nth (Nat) e ez z) pze)
    -> (erased (List (Nat)) e2 n2 f2) (erased (Nat) m2) (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Hypermap d e2 n2 f2) h2)
    (erased (Genus d e2 n2 f2 (Zero)) g2) (erased (Eq (Nat) m (Succ (Succ m2))) em) (erased (Dead d e2 n2 f2 (Cons (Nat) ez (Cons (Nat) z s)) m2) dd2)
    (erased (Apart (Nat) Lt ez z) ne) (erased (NotIn ez s) oute))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased lez)) (perm-val d z ez e nf pe pez))
  (let ((erased kz) (erased pkz)) (lc-col d z s e f ks lc lz))
  (let ((erased kez) (erased pkez)) (lc-col d ez s e f ks lc lez))
  (let-match erased (nat-eq ez z) (Unequal _ _ _ _ ne)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ ks z kz kez pkz pkez) (Refl _ _)) (apart-irrefl kz (lc-edge d z ez kz kz s e f ks lc lz out pez pkz pkez))))
  (let-match erased dd (MkDead _ _ k _ _ _ _ fe fn ff ds ls us a))
  (let-match erased (in-dec ez s) (OrR _ _ oute)
    (absurd (OrL _ _ ins) (let-match erased (nth-fn _ e ez z ez pze (fixed-at e s ez fe ins)) (Refl _ _)) (apart-irrefl ez ne)))
  (let ((erased fz) (erased pfz) (erased _)) (perm-nth d z f fi pf lz))
  (let ((erased fez) (erased pfez) (erased _)) (perm-nth d ez f fi pf lez))
  (let-match erased (nat-eq fz ez) (Unequal _ _ _ _ nfz)
    (absurd (Equal _ _ _) (lc-node d ez s e n f ks h lc lez oute (hyper-node d ez z ez e n f h pfz pze))))
  (let-match erased (nat-eq fez z) (Unequal _ _ _ _ nfez)
    (absurd (Equal _ _ _) (lc-node d z s e n f ks h lc lz out (hyper-node d z ez z e n f h pfez pez))))
  (let ((erased e1) (erased n1) (erased f1) (erased m1) (erased skf) (erased ske) (erased h1) (erased g1) (erased em1) (erased dd1))
    (walk-dead-n d m z e n f s h g dd lz out))
  (let ((erased e2) (erased n2) (erased f2) (erased m2) (erased skn) (erased skf2) (erased h2) (erased g2) (erased em2) (erased dd2))
    (walk-dead d m1 ez e1 n1 f1 (Cons _ z s) h1 g1 dd1 lez (NotInCons ez z s ne oute)))
  (let-match erased em1 (Refl _ _))
  (let-match erased em2 (Refl _ _))
  (values e2 n2 f2 m2 (MkCut2 d z ez fz fez e n f e1 n1 f1 e2 n2 f2 h1 ske skf skn skf2 h2 pez pze ne pfz nfz pfez nfez) h2 g2 (Refl _ m) dd2 ne oute))

