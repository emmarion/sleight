  (ELLive s2 ks g1 x y a b out pa pb (lc-edge d x y a b s e f ks lc lx out2 pc pa pb) rest))

; The colouring k of the map is one of the contraction (coloring (k \o h) in Kempe_map).
(def-fns _ $ (erased cut-proj : (erased (Nat) d z ez) (erased (List (Nat)) e n f s ks e2 n2 f2) (erased (Hypermap d e n f) h)
    (erased (Cut2 d e n f z ez e2 n2 f2) ct) (erased (Hypermap d e2 n2 f2) h2) (erased (FixedIn f2 (Cons (Nat) ez (Cons (Nat) z s))) ff2)
    (erased (LiveColoring d s e f ks) lc) -> (erased (LiveColoring d (Cons (Nat) ez (Cons (Nat) z s)) e2 f2 ks) r))
  (let ((erased le2) (erased ln2) (erased lf2)) (hyper-lengths d e2 n2 f2 h2))
  (let-match erased lc (MkLC _ _ _ _ _ ge gr rf el u lk))
  (let ((erased gf2) (erased grf2)) (graph-exists d f2 lf2))
  (let ((erased ge2) (erased gre2)) (graph-exists d e2 le2))
  (MkLC d _ e2 f2 ks ge2 gre2
    (graph-resp d f2 ks gf2 grf2 (proj-const d z ez e n f s ks e2 n2 f2 gf2 h ct ff2 lc lf2 (graph-fun d f2 gf2 grf2)) lk)
    (proj-edge d z ez e n f s ks e2 n2 f2 ge2 h ct lc le2 (graph-fun d e2 ge2 gre2)) u lk))

(def-fns _ $ (erased under-setnth : (erased (List (Nat)) xs ys) (erased (Nat) i v b) (erased (Under xs b) u) (subterm erased (SetNth (Nat) xs i v ys) st)
    (erased (Lt v b) lv) -> (erased (Under ys b) r))
  (let-match erased u (UnderCons xs1 x _ lx u1) (absurd (UnderNil _) st))
  (match erased st _
    ((SetHere _ _ _ _) (UnderCons xs1 v b lv u1))
    ((SetThere _ _ _ i1 _ ys1 st1) (UnderCons ys1 x b lx (under-setnth xs1 ys1 i1 v b u1 st1 lv)))))

(def-fns _ $ (erased respects-set : (erased (List (Nat)) lab lab2 xs ls) (erased (Nat) i v) (subterm erased (Respects lab xs ls) rp)
    (erased (SetNth (Nat) lab i v lab2) st) (erased (NotIn i xs) out) -> (erased (Respects lab2 xs ls) r))
  (let-match erased rp (RespCons _ xs1 ls1 j l p rp1) ((RespNil _) (RespNil lab2)))
  (let-match erased out (NotInCons _ _ _ ne out1))
  (RespCons lab2 xs1 ls1 j l (setnth-keep lab lab2 i j v l st p (apart-sym i j ne)) (respects-set lab lab2 xs1 ls1 i v rp1 st out1)))

; k1 with z coloured cz and ez coloured cez.
(def-adts $ (Set2 : ((List (Nat)) k1) ((Nat) z cz ez cez) ((List (Nat)) k0) -> Type)
  enum
  (many MkSet2 : (erased (List (Nat)) k1 k k0) (erased (Nat) z cz ez cez) (erased (SetNth (Nat) k1 z cz k) s1) (erased (SetNth (Nat) k ez cez k0) s2)
      (erased (Apart (Nat) Lt ez z) ne) -> (Set2 k1 z cz ez cez k0)))

(def-fns _ $ (erased set2-z : (erased (List (Nat)) k1 k0) (erased (Nat) z cz ez cez) (erased (Set2 k1 z cz ez cez k0) st) -> (erased (Nth (Nat) k0 z cz) r))
  (let-match erased st (MkSet2 _ k _ _ _ _ _ s1 s2 ne))
  (setnth-keep k k0 ez z cez cz s2 (setnth-nth _ k1 z cz k s1) (apart-sym ez z ne)))

(def-fns _ $ (erased set2-ez : (erased (List (Nat)) k1 k0) (erased (Nat) z cz ez cez) (erased (Set2 k1 z cz ez cez k0) st) -> (erased (Nth (Nat) k0 ez cez) r))
