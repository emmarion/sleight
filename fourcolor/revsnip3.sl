    -> (erased (Three n f R C2 C1 hd hd2 hd1 y) r))
  (match erased t _
    ((Th1 _ _ _ _ _ _ _ _ _ a b c) (Th2 n f R C2 C1 hd hd2 hd1 y a b c))
    ((Th2 _ _ _ _ _ _ _ _ _ a b c) (Th1 n f R C2 C1 hd hd2 hd1 y a b c))
    ((Th0 _ _ _ _ _ _ _ _ _ a b c) (Th0 n f R C2 C1 hd hd2 hd1 y a c b))))

