(def-fns _ $ (erased ring-from : (erased (List (Nat)) e f p) (erased (Nat) x y) (erased (Ring e f x p) rg) (erased (In y (Cons (Nat) x p)) iy)
    -> (erased (List (Nat)) q) (erased (Ring e f y q) rq) (erased (Sub (Cons (Nat) x p) (Cons (Nat) y q)) s1) (erased (Sub (Cons (Nat) y q) (Cons (Nat) x p)) s2))
  (let ((erased rg1)) rg)
  (let-match erased rg1 (MkRing _ _ _ _ w ew rp pw sw sm))
  (let-match erased sm (MkSimple _ _ lab ls rf rpl dl))
  (let ((erased dr)) (distinct-back lab (Cons _ x p) ls dl rpl))
  (let-match erased dr (DistCons _ _ ox dp))
  (let ((erased sr)) (sub-refl (Cons _ x p)))
  (let-match erased iy (InThere _ _ _ iy1) ((InHere _ _) (values p rg sr sr)))
  (let ((erased A) (erased B) (erased c) (erased ec) (erased r1) (erased pc) (erased spc) (erased r2) (erased ap)) (rpath-split e f p x w y rp iy1))
  (let ((erased q) (erased rq) (erased aq)) (rpath-join e f A B y w ew x c r2 pw sw r1))
  (let ((erased da) (erased dyb)) (app-parts (Cons _ y B) p A ap dp))
  (let-match erased dyb (DistCons _ _ oyb db))
  (let ((erased sB)) (sub-cons y B B (sub-refl B)))
  (let ((erased sA)) (sub-cons x A A (sub-refl A)))
  (let ((erased dj)) (app-disj (Cons _ y B) p A ap dp))
  (let ((erased oxB)) (notin-sub x B p (app-sub-r A (Cons _ y B) p B ap sB) ox))
  (let ((erased oxA)) (notin-sub x A p (app-sub-l A (Cons _ y B) p A ap (sub-refl A)) ox))
  (let ((erased oyA)) (disj-at A y (Cons _ y B) (disj-sym A (Cons _ y B) dj (Cons _ y B) (sub-refl _)) (InHere y B)))
  (let ((erased nyx)) (apart-sym x y (notin-in x y p ox (app-in-r A (Cons _ y B) p y ap (InHere y B)))))
  (let ((erased dyq)) (DistCons y q (notin-app B (Cons _ x A) q y aq oyb (NotInCons y x A nyx oyA))
    (app-distinct B (Cons _ x A) q aq db (DistCons x A oxA da) (disj-cons-r A x B (disj-sym A (Cons _ y B) dj B sB) oxB))))
  (let ((erased s1)) (HSubCons x p (Cons _ y q) (InThere x y q (app-in-r B (Cons _ x A) q x aq (InHere x A)))
    (app-sub A (Cons _ y B) p (Cons _ y q) ap (sub-cons y A q (app-sub-r B (Cons _ x A) q A aq sA))
      (HSubCons y B (Cons _ y q) (InHere y q) (sub-cons y B q (app-sub-l B (Cons _ x A) q B aq (sub-refl B)))))))
  (let ((erased s2)) (HSubCons y q (Cons _ x p) (InThere y x p iy1)
    (app-sub B (Cons _ x A) q (Cons _ x p) aq (sub-cons x B p (app-sub-r A (Cons _ y B) p B ap sB))
      (HSubCons x A (Cons _ x p) (InHere x p) (sub-cons x A p (app-sub-l A (Cons _ y B) p A ap (sub-refl A)))))))
  (let ((erased ls2) (erased rl2) (erased dl2)) (sub-labs lab (Cons _ x p) ls rpl dl (Cons _ y q) s2 dyq))
  (values q (MkRing e f q y c ec rq pc spc (MkSimple f _ lab ls2 rf rl2 dl2)) s1 s2))

; A ring R = x0 :: p read as x1 :: A ++ x2 :: B, with a dart z of diskN R off R on the face of x1, whose edge image ez is on the face
; of x2.
(def-adts $ (Chords : ((List (Nat)) e n f) ((Nat) x0) ((List (Nat)) p) ((Nat) x1) ((List (Nat)) A) ((Nat) x2) ((List (Nat)) B) ((Nat) z ez) -> Type)
  enum
  (many MkChords : (erased (List (Nat)) e n f p A B L lab lsA lsB) (erased (Nat) x0 x1 x2 z ez c ec w ew)
      (erased (AppN (Cons (Nat) x1 A) (Cons (Nat) x2 B) L) ap) (erased (Sub L (Cons (Nat) x0 p)) s1) (erased (Sub (Cons (Nat) x0 p) L) s2)
