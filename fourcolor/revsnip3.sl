(def-lvl RDC)

(def-fns _ $ (erased ring-disk-closed : (erased (Level) L) (erased (Predates (Level) RDC L) prd) (erased (Nat) d dd dr dd2 dr2)
    (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects hd bd r) rb) (erased (DiskSplit d e n r hd zs) ds1)
    (erased (RevCtx d e n f r RR hdA hdB) cx) (erased (Connected d e n f) cn) (erased (Patch d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2) pt2)
    (erased (RevApp (Nat) RR (Nil (Nat)) RV2) rv2) (erased (Respects hr2 br2 RV2) rbr2) (erased (DiskSplit d e n RR hd2 zs2) ds2) (erased (AppN RV2 zs2 hr2) ap2)
    (erased (AllOrder d n (Succ (Succ (Succ (Zero))))) cu)
    -> (erased (RelC) R) (erased (KClosed L (MkPred (RArgs) (MkRArgs dd ed nd fd bd) RTP) R) cl))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er0 hdc zsc hd2c zs2c h gen pl rg pr ur dsc rm ra rg2 pr2 ur2 dsc2))
  (let ((erased pt3)) pt2)
  (let-match erased pt3
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h2 hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased gd) (erased gr)) (patch-parts-planar d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 pt2 gen))
  (let ((erased od) (erased plr)) (edge-order-patch d dd2 dr2 (Succ (Succ (Zero))) e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 pt2 pl idd iod))
  (let ((erased an) (erased onr)) (node-order-patch d dd2 dr2 (Succ (Succ (Succ (Zero)))) e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 pt2 cu idr ior))
  (let ((erased iy)) (revapp-in RR (Nil _) RV2 y0 rv2 (OrL _ _ (InHere y0 Q))))
  (let-match erased RV2 (Cons _ v0 RV1) (absurd (Nil _) iy))
  (let-match erased rbr2 (RespCons _ B _ b0 _ _ _))
  (let ((erased init) (erased l) (erased sn)) (unsnoc-exists (Nat) b0 B))
  (let ((erased R1)) (Cons (Nat) l init))
  (let ((erased ii) (erased j0)) (join-exists init (Nil _)))
  (let-match erased (join-nil-r init ii j0) (Refl _ _))
  (let-match erased (ring-turn nr2 (Nil _) init (Cons _ l (Nil _)) br2 R1 idr (join-snoc-r init (Nil _) init (Cons _ l (Nil _)) br2 l j0 (SnocNil _ l) sn)
      (JoinCons (Nil _) init init l (JoinNil init)) (MkRingOK nr2 (Nil _) br2 idr cyr dbr (off-nil br2) (oo-qcubic nr2 br2 br2 idr onr (sub-refl br2))))
    (MkRingOK _ _ _ _ nc1 ds3 av1 qc1))
  (let ((erased qc)) (MkQuasiCubic dr2 nr2 R1 idr ior qc1))
  (let ((erased a)) (MkRArgs dd ed nd fd bd))
  (let ((erased P2)) (MkPred (RArgs) a RTP))
  (let ((erased R)) (MkRel (RArgs) (MkRArgs dr2 er2 nr2 fr2 R1) RKP))
  (let ((erased q1)) (predates-trans (prove-predates (level-of ring-trace-perm) RDC) prd))
  (let ((erased q2)) (predates-trans (prove-predates (level-of cotrace) RDC) prd))
  (let ((erased q3)) (predates-trans (prove-predates (level-of rt-unrot) RDC) prd))
  (let ((erased q4)) (predates-trans (prove-predates (level-of snoc-inj) RDC) prd))
  (let ((erased q5)) (predates-trans (prove-predates (level-of kempe-map) RDC) prd))
  (let ((erased q6)) (predates-trans (prove-predates (level-of rt-rot) RDC) prd))
  (let ((erased q7)) (predates-trans (prove-predates (level-of kempe-map-sound) RDC) prd))
  (let ((erased q8)) (predates-trans (prove-predates (level-of cotrace-back) RDC) prd))
  (def-fns L
    ((erased cp : (erased (List (Col)) ct ct2) (erased (Perm) gp) (erased (IsPerm gp) ip) (erased (PermT gp ct ct2) pt0) (erased (Holds P2 ct) q0)
        -> (erased (Holds P2 ct2) q))
      (let-match erased q0 (MkHolds _ _ _ _ h0))
      (let-match erased h0 (MkRTP _ _ _ _ _ _ rt))
      (MkHolds (RArgs) a RTP ct2 (MkRTP dd ed nd fd bd ct2 (ring-trace-perm (predates q1) ed fd bd ct ct2 gp ip pt0 rt))))
    ((erased cg : (erased (List (Col)) ct) (erased (Holds P2 ct) q0) -> (erased (List (Gsym)) w) (erased (MatchG (BS0) ct w) m) (erased (HoldsR R ct w) q))
      (let-match erased q0 (MkHolds _ _ _ _ h0))
      (let-match erased h0 (MkRTP _ _ _ _ _ _ rt))
      (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased tr))
        (cotrace (predates q2) d dd dr dd2 dr2 e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2 ct pt rb ds1 cx cn pt2 rv2
          rbr2 ds2 ap2 rt))
      (let ((erased s2) (erased E2) (erased se2) (erased rt2)) (rt-unrot (predates q3) er2 fr2 init br2 l et2 sn tr))
      (let-match erased eq (Refl _ _))
      (let-match erased (snoc-inj (predates q4) (Col) E E2 et2 s s2 se se2) (Refl _ _))
      (let ((erased w) (erased m) (erased kg)) (kempe-map (predates q5) dr2 er2 nr2 fr2 R1 ct hrm gr plr qc nc1 ds3 rt2))
      (values w m (MkHoldsR (RArgs) (MkRArgs dr2 er2 nr2 fr2 R1) RKP ct w (MkRKP dr2 er2 nr2 fr2 R1 ct w kg))))
    ((erased cm : (erased (List (Col)) ct ct2) (erased (List (Gsym)) w) (erased (HoldsR R ct w) q0) (erased (MatchG (BS0) ct2 w) m) -> (erased (Holds P2 ct2) q))
      (let-match erased q0 (MkHoldsR _ _ _ _ _ h0))
      (let-match erased h0 (MkRKP _ _ _ _ _ _ _ kg))
      (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased rt2)) (rt-rot (predates q6) er2 fr2 init br2 l ct2 sn (kempe-map-sound (predates q7) dr2 er2 nr2 fr2 R1 w ct2 kg m)))
      (let ((erased s2) (erased E2) (erased se2) (erased td))
        (cotrace-back (predates q8) d dd dr dd2 dr2 e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2 et2 pt rb ds1 cx cn pt2 rv2
          rbr2 ds2 ap2 rt2))
      (let-match erased eq (Refl _ _))
      (let-match erased (snoc-inj (predates q4) (Col) E2 E et2 s2 s se2 se) (Refl _ _))
      (MkHolds (RArgs) a RTP ct2 (MkRTP dd ed nd fd bd ct2 td))))
  (values R (MkKClosed L P2 R cp cg cm)))

(def-fns _ $ (erased app-parts : (erased (List (Nat)) C p) (subterm erased (List (Nat)) A) (erased (AppN A C p) ap) (erased (Distinct p) dp)
    -> (erased (Distinct A) da) (erased (Distinct C) dc))
  (let-match erased ap (AppCons A1 _ p1 a ap1) ((AppNil _) (values (DistNil) dp)))
  (let-match erased dp (DistCons _ _ o dp1))
  (let ((erased da1) (erased dc)) (app-parts C p1 A1 ap1 dp1))
  (values (DistCons a A1 (notin-sub a A1 p1 (app-sub-l A1 C p1 A1 ap1 (sub-refl A1)) o) da1) dc))

(def-fns _ $ (erased sub-labs : (erased (List (Nat)) lab r ls) (erased (Respects lab r ls) rl) (erased (Distinct ls) dl) (subterm erased (List (Nat)) B)
    (erased (Sub B r) sb) (erased (Distinct B) db) -> (erased (List (Nat)) lsB) (erased (Respects lab B lsB) rp) (erased (Distinct lsB) res))
  (let-match erased sb (HSubCons b B1 _ ib sb1) ((HSubNil _) (values (Nil _) (RespNil lab) (DistNil))))
  (let-match erased db (DistCons _ _ ob db1))
  (let ((erased lsB1) (erased rp1) (erased d1)) (sub-labs lab r ls rl dl B1 sb1 db1))
  (let ((erased l) (erased pl) (erased il)) (respects-val lab r ls b rl ib))
  (values (Cons _ l lsB1) (RespCons lab B1 lsB1 b l pl rp1)
    (DistCons l lsB1
      (match erased (in-dec l lsB1) (((NotIn l lsB1) res))
        (absurd (OrL _ _ i)
          (let ((erased b2) (erased ib2) (erased pb2)) (respects-in lab B1 lsB1 l rp1 i))
          (let-match erased (simple-inj lab r ls b b2 l rl dl ib (sub-in B1 r b2 sb1 ib2) pl pb2) (Refl _ _))
          (apart-irrefl b (notin-in b b B1 ob ib2)))
        ((OrR _ _ o) o))
      d1)))

(def-fns _ $ (erased resp-split : (erased (List (Nat)) lab Y Z lz) (subterm erased (List (Nat)) X) (erased (AppN X Y Z) ap) (erased (Respects lab Z lz) rp)
