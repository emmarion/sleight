    ((Th0 _ _ _ _ _ _ _ _ _ a b c)
      (Th0 n f R C1 C2 hd hd1 hd2 x (rds-node-off d x y e n f R hd zs d0 pn a) (rds-node-off d x y e n f C1 hd1 zs1 d1 pn b) (rds-node-off d x y e n f C2 hd2 zs2 d2 pn c)))))

