; y is in diskN R and in exactly one of diskN C1 and diskN C2, or in none of the three.
(def-adts $ (Three : ((List (Nat)) n f R C1 C2 hd hd1 hd2) ((Nat) y) -> Type)
  enum
  (many Th1 : (erased (List (Nat)) n f R C1 C2 hd hd1 hd2) (erased (Nat) y) (erased (DiskN n f R y) a) (erased (DiskN n f C1 y) b) (erased (NotIn y hd2) c)
      -> (Three n f R C1 C2 hd hd1 hd2 y))
  (many Th2 : (erased (List (Nat)) n f R C1 C2 hd hd1 hd2) (erased (Nat) y) (erased (DiskN n f R y) a) (erased (DiskN n f C2 y) b) (erased (NotIn y hd1) c)
      -> (Three n f R C1 C2 hd hd1 hd2 y))
  (many Th0 : (erased (List (Nat)) n f R C1 C2 hd hd1 hd2) (erased (Nat) y) (erased (NotIn y hd) a) (erased (NotIn y hd1) b) (erased (NotIn y hd2) c)
      -> (Three n f R C1 C2 hd hd1 hd2 y)))

