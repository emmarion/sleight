; More of revsnip.v, for plain maps: nontrivial0P, ring_disk_closed, the chord rings and ring_disk_chord. Load after revsnip2.sl.

(def-fns _ $ (erased scattered-kernel : (erased (List (Nat)) f r xs) (erased (Nat) x) (erased (Scattered f r xs) sc) (erased (In x xs) ix)
    -> (erased (Kernel f r x) k))
  (let-match erased sc (MkScattered _ _ _ lab lr lx rf rr rx dx dj))
  (let ((erased l) (erased px) (erased il)) (respects-val lab xs lx x rx ix))
  (MkKernel f r lab lr x l rf rr px (disj-at lr l lx dj il)))

(def-fns _ $ (erased kernel-scattered : (erased (List (Nat)) f r) (erased (Nat) x) (erased (Kernel f r x) k) -> (erased (Scattered f r (Cons (Nat) x (Nil (Nat)))) sc))
  (let-match erased k (MkKernel _ _ lab ls _ l rf rp px out))
  (MkScattered f r _ lab ls (Cons _ l (Nil _)) rf rp (RespCons lab (Nil _) (Nil _) x l px (RespNil lab)) (DistCons l (Nil _) (NotInNil l) (DistNil))
    (DisjCons l (Nil _) ls out (DisjNil ls))))

(def-fns _ $ (erased ds-notin : (erased (Nat) d x) (erased (List (Nat)) e n r hd zs) (erased (DiskSplit d e n r hd zs) ds) (erased (In x zs) iz)
    -> (erased (NotIn x hd) o))
  (let ((erased ids) (erased io) (erased sp)) (ds-split d e n r hd zs ds))
  (disj-at hd x zs (split-disj hd ids hd zs sp) iz))

(def-fns _ $ (erased nontrivial-pick : (erased (Nat) d x0 m) (erased (List (Nat)) e n f p hd zs) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f x0 p) rg) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds) (erased (NonTrivial d e n f (Cons (Nat) x0 p) m) nt)
    -> (erased (Nat) x y) (erased (DiskF n f (Cons (Nat) x0 p) x) dx) (erased (In y zs) iy) (erased (Kernel f (Cons (Nat) x0 p) y) ky))
  (let-match erased nt (MkNonTrivial _ _ _ _ _ _ hdA zsA xs ys dsA lx ly sx sy px py))
  (let-match erased lx (LengthCons _ x xs1 _ lx1))
  (let-match erased ly (LengthCons _ y ys1 _ ly1))
  (let ((erased ur)) (ring-under d x0 e n f p h rg))
  (let ((erased ix)) (sub-in xs hdA x sx (InHere x xs1)))
  (let ((erased iy)) (sub-in ys zsA y sy (InHere y ys1)))
  (values x y (MkDiskF n f _ x (ds-in d x x0 e n f p hdA zsA h gen rg ur dsA ix) (scattered-kernel f _ xs x px (InHere x xs1)))
    (ds-off d y x0 e n f p hdA zsA hd zs h gen rg ur dsA ds (ds-notin d y e n _ hdA zsA dsA iy) (ds-lt d y e n _ hdA zsA dsA (OrR _ _ iy)))
    (scattered-kernel f _ ys y py (InHere y ys1))))

(def-fns _ $ (erased nontrivial0 : (erased (Nat) d x0 x y) (erased (List (Nat)) e n f p hd zs) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f x0 p) rg) (erased (DiskSplit d e n (Cons (Nat) x0 p) hd zs) ds) (erased (DiskF n f (Cons (Nat) x0 p) x) dx) (erased (In y zs) iy)
    (erased (Kernel f (Cons (Nat) x0 p) y) ky) -> (erased (NonTrivial d e n f (Cons (Nat) x0 p) (Zero)) nt))
  (let-match erased dx (MkDiskF _ _ _ _ dn kx))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased kx2)) kx)
  (let-match erased kx2 (MkKernel _ _ lab ls _ l rf rp px out))
  (let ((erased lx)) (nth-lt-length _ lab x d l px (respects-length lab f lab d rf lf)))
  (MkNonTrivial d (Zero) e n f _ hd zs (Cons _ x (Nil _)) (Cons _ y (Nil _)) ds (LengthCons _ x (Nil _) _ (LengthNil _)) (LengthCons _ y (Nil _) _ (LengthNil _))
    (HSubCons x (Nil _) hd (ds-mem d x x0 e n f p hd zs h gen rg (ring-under d x0 e n f p h rg) ds dn lx) (HSubNil hd)) (HSubCons y (Nil _) zs iy (HSubNil zs))
    (kernel-scattered f _ x kx) (kernel-scattered f _ y ky)))

(def-fns _ $ (erased rt-rot : (erased (List (Nat)) e f r0 R) (erased (Nat) x) (erased (List (Col)) et) (erased (HSnoc (Nat) r0 x R) sn)
    (erased (RingTrace e f (Cons (Nat) x r0) et) rt)
    -> (erased (Col) s) (erased (List (Col)) E et2) (erased (Eq (List (Col)) et (Cons (Col) s E)) eq) (erased (HSnoc (Col) E s et2) se) (erased (RingTrace e f R et2) r))
  (let-match erased rt (MkRingTrace _ _ _ ks lc cs _ c rl co t))
  (let-match erased rl (RespCons _ _ lc1 _ l pl rl1))
  (let-match erased co (All2Cons _ _ _ _ c0 _ cs1 pc co1))
  (let ((erased lc2) (erased sl)) (snoc-exists _ lc1 l))
  (let ((erased cs2) (erased sc) (erased co2)) (cols-snoc lc1 lc2 cs1 l c0 co1 sl pc))
  (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased t2)) (trace-rot c0 cs1 cs2 et t sc))
  (values s E et2 eq se (MkRingTrace e f R ks lc2 cs2 et2 c (respects-snoc ks r0 R lc1 lc2 x l rl1 pl sn sl) co2 t2)))

(def-fns _ $ (erased rt-unrot : (erased (List (Nat)) e f r0 R) (erased (Nat) x) (erased (List (Col)) et2) (erased (HSnoc (Nat) r0 x R) sn)
    (erased (RingTrace e f R et2) rt)
    -> (erased (Col) s) (erased (List (Col)) E) (erased (HSnoc (Col) E s et2) se) (erased (RingTrace e f (Cons (Nat) x r0) (Cons (Col) s E)) r))
  (let-match erased rt (MkRingTrace _ _ _ ks lc cs _ c rl co t))
  (let ((erased lc0) (erased l) (erased sl) (erased rp0) (erased pl)) (respects-unsnoc ks r0 R lc x sn rl))
  (let ((erased cs0) (erased c0) (erased sc) (erased co0) (erased pc)) (cols-unsnoc lc0 lc cs l sl co))
  (let ((erased et) (erased t0)) (trace-exists (Cons _ c0 cs0)))
  (let ((erased s) (erased E) (erased et3) (erased eq) (erased se) (erased t3)) (trace-rot c0 cs0 cs et t0 sc))
  (let-match erased (trace-fn cs et3 et2 t3 t) (Refl _ _))
  (let-match erased eq (Refl _ _))
  (values s E se (MkRingTrace e f _ ks _ _ _ c (RespCons ks r0 lc0 x l pl rp0) (All2Cons _ _ ColOf l c0 lc0 cs0 pc co0) t0)))

(def-fns _ $ (erased oo-qcubic : (erased (List (Nat)) n b R) (subterm erased (List (Nat)) xs) (erased (OrdersOff n (Succ (Succ (Succ (Zero)))) b xs) oo)
    (erased (Sub b R) sb) -> (erased (QCubic n R xs) q))
  (let-match erased oo (OOAt _ _ xs1 _ x o oo1)
    ((OONil _ _ _) (QCNil n R))
    ((OOSkip _ _ xs1 _ x ib oo1) (QCIn n R xs1 x (sub-in b R x sb ib) (oo-qcubic n b R xs1 oo1 sb))))
  (let-match erased o (MkOrder _ ys _ a _ pa w l))
  (let-match erased l (LengthCons _ _ _ _ l1))
  (let-match erased l1 (LengthCons _ _ _ _ l2))
  (let-match erased l2 (LengthNil _))
  (let-match erased w (PathStep _ _ _ _ b1 _ pb _ w1))
  (let-match erased w1 (PathStep _ _ _ _ c _ pc _ w2))
  (let-match erased w2 (PathHere _ _ _))
  (QCOut n R xs1 x a b1 pa pb pc (oo-qcubic n b R xs1 oo1 sb)))

(def-fns _ $ (erased ring-disk-closed : (erased (Nat) d dd dr dd2 dr2)
    (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects hd bd r) rb) (erased (DiskSplit d e n r hd zs) ds1)
    (erased (RevCtx d e n f r RR hdA hdB) cx) (erased (Connected d e n f) cn) (erased (Patch d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2) pt2)
    (erased (RevApp (Nat) RR (Nil (Nat)) RV2) rv2) (erased (Respects hr2 br2 RV2) rbr2) (erased (DiskSplit d e n RR hd2 zs2) ds2) (erased (AppN RV2 zs2 hr2) ap2)
    (erased (AllOrder d n (Succ (Succ (Succ (Zero))))) cu)
    -> (erased (Level) L) (erased (RelC) R) (erased (KClosed L (MkPred (RArgs) (MkRArgs dd ed nd fd bd) RTP) R) cl))
  (let ((erased cx2)) cx)
  (let-match erased cx2 (MkRevCtx _ x0 y0 _ _ _ p Q er0 hdc zsc hd2c zs2c h gen pl rg pr ur dsc rm ra rg2 pr2 ur2 dsc2))
  (let ((erased pt3)) pt2)
  (let-match erased pt3
    (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h2 hdm hrm io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased gd) (erased gr)) (patch-parts-planar d dd2 dr2 e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 pt2 gen))
  (let ((erased od) (erased plr)) (edge-order-patch d dd2 dr2 (Succ (Succ (Zero))) e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 pt2 pl idd iod))
  (let ((erased an) (erased onr)) (node-order-patch d dd2 dr2 (Succ (Succ (Succ (Zero)))) e n f ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 pt2 cu idr ior))
  (let ((erased iy)) (revapp-in RR (Nil _) RV2 y0 rv2 (OrL _ _ (InHere y0 Q))))
  (let-match erased RV2 (Cons _ v0 RV1) (absurd (Nil _) iy))
  (let-match erased rbr2 (RespCons _ B _ b0 _ _ _))
  (let ((erased init) (erased l) (erased sn)) (unsnoc-exists (Nat) b0 B))
  (let ((erased R1)) (Cons (Nat) l init))
  (let ((erased ii) (erased j0)) (join-exists init (Nil _)))
  (let-match erased (join-nil-r init ii j0) (Refl _ _))
  (let-match erased (ring-turn nr2 (Nil _) init (Cons _ l (Nil _)) br2 R1 idr (join-snoc-r init (Nil _) init (Cons _ l (Nil _)) br2 l j0 (SnocNil _ l) sn)
      (JoinCons (Nil _) init init l (JoinNil init)) (MkRingOK nr2 (Nil _) br2 idr cyr dbr (off-nil br2) (oo-qcubic nr2 br2 br2 idr onr (sub-refl br2))))
    (MkRingOK _ _ _ _ nc1 ds3 av1 qc1))
  (let ((erased qc)) (MkQuasiCubic dr2 nr2 R1 idr ior qc1))
  (let ((erased a)) (MkRArgs dd ed nd fd bd))
  (let ((erased P2)) (MkPred (RArgs) a RTP))
  (let ((erased R)) (MkRel (RArgs) (MkRArgs dr2 er2 nr2 fr2 R1) RKP))
  (def-fns _
    ((erased cp : (erased (List (Col)) ct ct2) (erased (Perm) gp) (erased (IsPerm gp) ip) (erased (PermT gp ct ct2) pt0) (erased (Holds P2 ct) q0)
        -> (erased (Holds P2 ct2) q))
      (let-match erased q0 (MkHolds _ _ _ _ h0))
      (let-match erased h0 (MkRTP _ _ _ _ _ _ rt))
      (MkHolds (RArgs) a RTP ct2 (MkRTP dd ed nd fd bd ct2 (ring-trace-perm ed fd bd ct ct2 gp ip pt0 rt))))
    ((erased cg : (erased (List (Col)) ct) (erased (Holds P2 ct) q0) -> (erased (List (Gsym)) w) (erased (MatchG (BS0) ct w) m) (erased (HoldsR R ct w) q))
      (let-match erased q0 (MkHolds _ _ _ _ h0))
      (let-match erased h0 (MkRTP _ _ _ _ _ _ rt))
      (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased tr))
        (cotrace d dd dr dd2 dr2 e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2 ct pt rb ds1 cx cn pt2 rv2
          rbr2 ds2 ap2 rt))
      (let ((erased s2) (erased E2) (erased se2) (erased rt2)) (rt-unrot er2 fr2 init br2 l et2 sn tr))
      (let-match erased eq (Refl _ _))
      (let-match erased (snoc-inj (Col) E E2 et2 s s2 se se2) (Refl _ _))
      (let ((erased w) (erased m) (erased kg)) (kempe-map dr2 er2 nr2 fr2 R1 ct hrm gr plr qc nc1 ds3 rt2))
      (values w m (MkHoldsR (RArgs) (MkRArgs dr2 er2 nr2 fr2 R1) RKP ct w (MkRKP dr2 er2 nr2 fr2 R1 ct w kg))))
    ((erased cm : (erased (List (Col)) ct ct2) (erased (List (Gsym)) w) (erased (HoldsR R ct w) q0) (erased (MatchG (BS0) ct2 w) m) -> (erased (Holds P2 ct2) q))
      (let-match erased q0 (MkHoldsR _ _ _ _ _ h0))
      (let-match erased h0 (MkRKP _ _ _ _ _ _ _ kg))
      (let ((erased s) (erased E) (erased et2) (erased eq) (erased se) (erased rt2)) (rt-rot er2 fr2 init br2 l ct2 sn (kempe-map-sound dr2 er2 nr2 fr2 R1 w ct2 kg m)))
      (let ((erased s2) (erased E2) (erased se2) (erased td))
        (cotrace-back d dd dr dd2 dr2 e n f ed nd fd er nr fr hd hr bd br ed2 nd2 fd2 er2 nr2 fr2 hd2 hr2 bd2 br2 r RR hdA hdB zs zs2 RV2 et2 pt rb ds1 cx cn pt2 rv2
          rbr2 ds2 ap2 rt2))
      (let-match erased eq (Refl _ _))
      (let-match erased (snoc-inj (Col) E2 E et2 s2 s se2 se) (Refl _ _))
      (MkHolds (RArgs) a RTP ct2 (MkRTP dd ed nd fd bd ct2 td))))
  (values (level-of cp) R (MkKClosed (level-of cp) P2 R cp cg cm)))
