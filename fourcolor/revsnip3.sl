(def-fns _ $ (erased edge-gen : (erased (Nat) d x0 x1 x2 z ez) (erased (List (Nat)) e n f p A B hd zs hd1 zs1 hd2 zs2) (erased (Chords e n f x0 p x1 A x2 B z ez) cc)
