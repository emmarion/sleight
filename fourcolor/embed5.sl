(def-fns _ $ (erased hemb-fn : (erased (List (Nat)) ec nc em nm fm as hl) (erased (Nat) x u v) (erased (HEmb ec nc em nm fm as hl x u) hu)
    (erased (HEmb ec nc em nm fm as hl x v) hv) -> (erased (Eq (Nat) u v) r))
  (match erased hu _
    ((HeK _ _ _ _ _ _ _ _ _ ix pu)
      (let-match erased hv (HeK _ _ _ _ _ _ _ _ _ _ pv)
        (absurd (HeE _ _ _ _ _ _ _ _ _ _ _ ox _ _ _ _) (in-notin x as ix ox))
        (absurd (HeN _ _ _ _ _ _ _ _ _ _ _ _ _ ox _ _ _ _ _ _ _) (in-notin x as ix ox))
        (absurd (HeEN _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ox _ _ _ _ _ _ _ _ _ _) (in-notin x as ix ox)))
      (nth-fn _ hl x u v pu pv))
    ((HeE _ _ _ _ _ _ _ _ _ y w ox py iy pw pu)
      (let-match erased hv (HeE _ _ _ _ _ _ _ _ _ y2 w2 _ py2 _ pw2 pv)
        (absurd (HeK _ _ _ _ _ _ _ _ _ ix _) (in-notin x as ix ox))
        (absurd (HeN _ _ _ _ _ _ _ _ _ y2 _ _ _ _ py2 oy _ _ _ _ _)
          (let-match erased (nth-fn _ ec x y y2 py py2) (Refl _ _)) (in-notin y as iy oy))
        (absurd (HeEN _ _ _ _ _ _ _ _ _ y2 _ _ _ _ _ _ py2 oy _ _ _ _ _ _ _ _)
          (let-match erased (nth-fn _ ec x y y2 py py2) (Refl _ _)) (in-notin y as iy oy)))
      (let-match erased (nth-fn _ ec x y y2 py py2) (Refl _ _))
      (let-match erased (nth-fn _ hl y w w2 pw pw2) (Refl _ _))
      (nth-fn _ em w u v pu pv))
    ((HeN _ _ _ _ _ _ _ _ _ y z w a ox py oy pz iz pw pa pu)
      (let-match erased hv (HeN _ _ _ _ _ _ _ _ _ _ z2 w2 a2 _ _ _ pz2 _ pw2 pa2 pv)
        (absurd (HeK _ _ _ _ _ _ _ _ _ ix _) (in-notin x as ix ox))
        (absurd (HeE _ _ _ _ _ _ _ _ _ y2 _ _ py2 iy _ _)
          (let-match erased (nth-fn _ ec x y y2 py py2) (Refl _ _)) (in-notin y as iy oy))
        (absurd (HeEN _ _ _ _ _ _ _ _ _ _ z2 _ _ _ _ _ _ _ pz2 oz _ _ _ _ _ _)
          (let-match erased (nth-fn _ nc x z z2 pz pz2) (Refl _ _)) (in-notin z as iz oz)))
      (let-match erased (nth-fn _ nc x z z2 pz pz2) (Refl _ _))
      (let-match erased (nth-fn _ hl z w w2 pw pw2) (Refl _ _))
      (let-match erased (nth-fn _ em w a a2 pa pa2) (Refl _ _))
      (nth-fn _ fm a u v pu pv))
    ((HeEN _ _ _ _ _ _ _ _ _ y z t w w1 w2 ox py oy pz oz pt it pw p1 p2 pu)
      (let-match erased hv (HeEN _ _ _ _ _ _ _ _ _ y3 _ t3 w3 w4 w5 _ py3 _ _ _ pt3 _ pw3 p3 p4 pv)
        (absurd (HeK _ _ _ _ _ _ _ _ _ ix _) (in-notin x as ix ox))
        (absurd (HeE _ _ _ _ _ _ _ _ _ y2 _ _ py2 iy _ _)
          (let-match erased (nth-fn _ ec x y y2 py py2) (Refl _ _)) (in-notin y as iy oy))
        (absurd (HeN _ _ _ _ _ _ _ _ _ _ z2 _ _ _ _ _ pz2 iz _ _ _)
          (let-match erased (nth-fn _ nc x z z2 pz pz2) (Refl _ _)) (in-notin z as iz oz)))
      (let-match erased (nth-fn _ ec x y y3 py py3) (Refl _ _))
      (let-match erased (nth-fn _ nc y t t3 pt pt3) (Refl _ _))
      (let-match erased (nth-fn _ hl t w w3 pw pw3) (Refl _ _))
      (let-match erased (nth-fn _ nm w w1 w4 p1 p3) (Refl _ _))
      (let-match erased (nth-fn _ nm w1 w2 w5 p2 p4) (Refl _ _))
      (nth-fn _ em w2 u v pu pv))))

(def-fns _ $ (erased ker-path : (erased (Nat) dc dm x y) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl s xs)
    (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en) (erased (In x as) ix) (subterm erased (Path fc s x y xs) p) -> (erased (In y as) r))
