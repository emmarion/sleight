      ((RPLast _ _ _ _ _ _ _ l)
        (let-match erased l (MkRlink _ _ _ _ t pt w4))
        (let-match erased (nth-fn _ ec z x t ez pt) (Refl _ _))
        w4)
      ((RPStep _ _ _ _ _ p1 _ z1 _ l iz1 cz1 rp1)
        (let-match erased l (MkRlink _ _ _ _ t pt w4))
        (let-match erased (nth-fn _ ec z x t ez pt) (Refl _ _))
        (let-match erased w4 (MkSomePath _ _ ws _ _ pth))
        (let ((erased v) (erased pv) (erased spm)) (face-h dc dm x z1 w ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws en ix pth pw))
        (let-match erased spm (MkSomePath _ _ us _ _ pthm))
        (let ((erased t2) (erased sy) (erased pt2)) (h-face-back dc dm y w v ec nc fc ksc rc em nm fm ksm as hl (Nil _) us en iy pw2 pthm))
        (let-match erased sy (MkSomePath _ _ ys _ _ pthy))
        (let ((erased it2)) (ker-path dc dm y t2 ec nc fc ksc rc em nm fm ksm as hl (Nil _) ys en iy pthy))
        (let ((erased e1) (erased pe1) (erased ie1)) (rl-first ec fc em hl as p1 dc dm z1 y nc ksc rc nm fm ksm en rp1 iy))
        (let-match erased cz1 (MkCentral _ _ _ _ e2 v2 v3 pe2 pv2 pv3 pm3))
