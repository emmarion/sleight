  (ker-path dc dm z y ec nc fc ksc rc em nm fm ksm as hl s xs1 en (ker-face dc dm x z ec nc fc ksc rc em nm fm ksm as hl en ix pz) p1))

(def-fns _ $ (erased ker-path-inv : (erased (Nat) dc dm x y) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl s xs)
    (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en) (erased (In y as) iy) (subterm erased (Path fc s x y xs) p) -> (erased (In x as) r))
  (let-match erased p (PathStep _ _ xs1 _ z _ pz _ p1) ((PathHere _ _ _) iy))
  (ker-face-inv dc dm x z ec nc fc ksc rc em nm fm ksm as hl en (ker-path-inv dc dm z y ec nc fc ksc rc em nm fm ksm as hl s xs1 en iy p1) pz))

(def-adts $ (FullPair : ((List (Nat)) ec em hl) ((Nat) x1 x2) -> Type)
  enum
  (many FpEdge : (erased (List (Nat)) ec em hl) (erased (Nat) x1 x2) (erased (Nth (Nat) ec x1 x2) p) -> (FullPair ec em hl x1 x2))
  (many FpApart : (erased (List (Nat)) ec em hl) (erased (Nat) x1 x2 w u v) (erased (Nth (Nat) hl x1 w) pw) (erased (Nth (Nat) em w u) pu)
      (erased (Nth (Nat) hl x2 v) pv) (erased (Apart (Nat) Lt u v) ne) -> (FullPair ec em hl x1 x2)))

(def-adts $ (FullRow : ((List (Nat)) ec em hl) ((Nat) x1) ((List (Nat)) xs) -> Type)
  enum
  (many FrNil : (erased (List (Nat)) ec em hl) (erased (Nat) x1) -> (FullRow ec em hl x1 (Nil (Nat))))
  (many FrCons : (erased (List (Nat)) ec em hl xs) (erased (Nat) x1 x2) (erased (FullPair ec em hl x1 x2) p) (erased (FullRow ec em hl x1 xs) rest)
      -> (FullRow ec em hl x1 (Cons (Nat) x2 xs))))

(def-adts $ (FullAll : ((List (Nat)) ec em hl as xs) -> Type)
  enum
  (many FuNil : (erased (List (Nat)) ec em hl as) -> (FullAll ec em hl as (Nil (Nat))))
  (many FuCons : (erased (List (Nat)) ec em hl as xs) (erased (Nat) x1) (erased (FullRow ec em hl x1 as) p) (erased (FullAll ec em hl as xs) rest)
      -> (FullAll ec em hl as (Cons (Nat) x1 xs))))

(def-fns _ $ (erased full-row : (erased (List (Nat)) ec em hl xs) (erased (Nat) x1 x2 w u) (subterm erased (FullRow ec em hl x1 xs) fr) (erased (In x2 xs) i2)
    (erased (Nth (Nat) hl x1 w) pw) (erased (Nth (Nat) em w u) pu) (erased (Nth (Nat) hl x2 u) pv) -> (erased (Nth (Nat) ec x1 x2) r))
  (let-match erased fr (FrCons _ _ _ xs1 _ y p fr1) (absurd (FrNil _ _ _ _) i2))
  (let-match erased i2 (InHere _ _) ((InThere _ _ _ i3) (full-row ec em hl xs1 x1 x2 w u fr1 i3 pw pu pv)))
  (let-match erased p (FpEdge _ _ _ _ _ q)
    (absurd (FpApart _ _ _ _ _ w2 u2 v2 pw2 pu2 pv2 ne)
      (let-match erased (nth-fn _ hl x1 w w2 pw pw2) (Refl _ _))
      (let-match erased (nth-fn _ em w u u2 pu pu2) (Refl _ _))
      (let-match erased (nth-fn _ hl x2 u v2 pv pv2) (Refl _ _))
      (apart-irrefl u ne)))
  q)

(def-fns _ $ (erased full-at : (erased (List (Nat)) ec em hl as xs) (erased (Nat) x1 x2 w u) (subterm erased (FullAll ec em hl as xs) fa) (erased (In x1 xs) i1)
    (erased (In x2 as) i2) (erased (Nth (Nat) hl x1 w) pw) (erased (Nth (Nat) em w u) pu) (erased (Nth (Nat) hl x2 u) pv) -> (erased (Nth (Nat) ec x1 x2) r))
  (let-match erased fa (FuCons _ _ _ _ xs1 _ fr fa1) (absurd (FuNil _ _ _ _) i1))
  (let-match erased i1 (InHere _ _) ((InThere _ _ _ i3) (full-at ec em hl as xs1 x1 x2 w u fa1 i3 i2 pw pu pv)))
  (full-row ec em hl as x1 x2 w u fr i2 pw pu pv))

(def-fns _ $ (erased gc-hyper : (erased (Nat) dc dm) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm as hl) (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en)
