(def-fns _ $ (erased edge-nf : (erased (Nat) d x x1 z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Nth (Nat) f x x1) px)
    (erased (Nth (Nat) n x1 z) pz) -> (erased (Nth (Nat) e z x) r))
