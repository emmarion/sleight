(def-fns _ $ (erased rl-first : (erased (List (Nat)) ec fc em hl as p) (erased (Nat) dc dm z y) (erased (List (Nat)) nc ksc rc nm fm ksm)
    (erased (EEnv dc ec nc fc ksc rc dm em nm fm ksm as hl) en) (erased (RlPath ec fc em hl as z p y) rp) (erased (In y as) iy)
    -> (erased (Nat) t) (erased (Nth (Nat) ec z t) pt) (erased (In t as) it))
  (let ((erased q) (erased l) (erased iq))
    (match erased rp (((Nat) q) ((Rlink ec fc z q) l) ((In q as) iq))
      ((RPLast _ _ _ _ _ _ _ l) (values y l iy))
      ((RPStep _ _ _ _ _ _ _ z2 _ l iz _ _) (values z2 l iz))))
  (let-match erased l (MkRlink _ _ _ _ t pt w))
  (let-match erased w (MkSomePath _ _ ws _ _ pth))
  (values t pt (ker-path-inv dc dm t q ec nc fc ksc rc em nm fm ksm as hl (Nil _) ws en iq pth)))

(def-fns _ $ (erased rlto-at : (erased (List (Nat)) ec fc em hl as ys) (erased (Nat) x y) (subterm erased (RlTo ec fc em hl as x ys) rt) (erased (In y ys) iy)
    -> (erased (List (Nat)) p) (erased (RlPath ec fc em hl as x p y) rp))
