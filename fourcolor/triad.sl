; triad_valid of contract.v with minimality as data, and the parts of birkhoff.v's SpokeRing section it uses, for faces of any
; size: the face of a dart read with the labels of its spokes, chordless_spoke_ring, adj12_edge and fcard_adj_max. Load after
; contract3.sl, in its chain. Faces are read through a FaceLab labelling throughout. That these statements match Coq's has been
; checked only by reading.

(def-fns _ $ (erased orbit-walk : (erased (Nat) x a b) (erased (List (Nat)) f os s ws) (erased (Orbit f x os) o) (subterm erased (Path f s a b ws) w)
    (erased (In a os) ia) -> (erased (In b os) r))
  (let-match erased w (PathStep _ _ ws1 _ a1 _ pa _ w1) ((PathHere _ _ _) ia))
  (let ((erased o2)) o)
  (let-match erased o2 (MkOrbit _ xs _ y px wo))
  (orbit-walk x a1 b f os s ws1 o w1 (match erased ia (((In a1 os) r))
    ((InHere _ _) (let-match erased (nth-fn _ f x y a1 px pa) (Refl _ _)) (path-start-in f _ xs y x wo))
    ((InThere _ _ _ ia1) (path-next f _ xs y x a a1 wo ia1 pa)))))

; Every dart on the face of x is on its orbit.
(def-fns _ $ (erased orbit-in : (erased (Nat) x u) (erased (List (Nat)) f os) (erased (Orbit f x os) o) (erased (SomePath f (Nil (Nat)) x u) sp)
    -> (erased (In u os) r))
  (let ((erased o2)) o)
  (let-match erased o2 (MkOrbit _ xs _ y px wo))
  (let-match erased sp (MkSomePath _ _ ws _ _ w))
  (orbit-walk x x u f os (Nil _) ws o w (InHere x xs)))

(def-fns _ $ (erased orbit-lab : (erased (Nat) x l) (erased (List (Nat)) f lab os) (erased (Orbit f x os) o) (erased (Respects lab f lab) rf)
    (erased (Nth (Nat) lab x l) pl) -> (erased (LabAll lab l os) r))
  (let-match erased o (MkOrbit _ xs _ y px w))
  (LabCons lab xs l x pl (walk-laball y x l f lab _ xs w rf (respects-nth lab f lab x y l rf px pl))))

; The face of x, of label lx and k darts: its orbit Vs from x, and ls the labels of the faces of its spokes, distinct.
(def-adts $ (FRec : ((Nat) d) ((List (Nat)) e n f fe lab) ((Nat) x lx k) ((List (Nat)) Vs ls) -> Type)
  enum
  (many MkFRec : (erased (Nat) d x lx k) (erased (List (Nat)) e n f fe lab Vs Rs ls) (erased (Orbit f x Vs) o) (erased (Length (Nat) Vs k) lv)
      (erased (Distinct Vs) dv) (erased (LabAll lab lx Vs) al) (erased (Respects fe Vs Rs) rv) (erased (Respects lab Rs ls) rl) (erased (Distinct ls) dl)
      (erased (Nth (Nat) lab x lx) plx) -> (FRec d e n f fe lab x lx k Vs ls)))

; The face of x read with its spokes, or a reduction from double-dart (scycle_spoke_ring for a face of any size).
(def-fns _ $ (erased fr-make : (erased (Level) B) (erased (Nat) d x k) (erased (List (Nat)) e n f fe lab) (erased (MinCx B d e n f fe lab) m)
    (erased (Order f x k) o) -> (erased (Nat) lx) (erased (List (Nat)) Vs ls) (erased (HOr (FRec d e n f fe lab x lx k Vs ls) (Reduces B d e n f)) r))
  (let ((erased m2)) m)
  (let-match erased m2 (MkMinCx _ _ _ _ _ _ _ pb bks c cn nc))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased ll)) (respects-length lab f lab d rl lf))
  (let-match erased o (MkOrder _ xs _ y k1 py w lxs))
  (let ((erased lx) (erased ly)) (values (pre-lt d x y f fi pmf py) (perm-val d x y f fi pmf py)))
  (let ((erased uxs) (erased _)) (path-under d y x f fi _ xs pmf w ly))
  (let ((erased Vs)) (Cons _ x xs))
  (let ((erased Rs) (erased rv)) (respects-exists fe Vs d (UnderCons xs x d lx uxs) lfe))
  (let ((erased l) (erased plx)) (nth-exists _ lab d x ll lx))
  (let ((erased ls) (erased rls)) (respects-exists lab Rs d (respects-under-vals fe Vs Rs d rv ufe) ll))
  (let ((erased ob)) (MkOrbit f xs x y py w))
  (let ((erased al)) (orbit-lab x l f lab Vs ob rl plx))
  (let ((erased dv)) (DistCons x xs (path-avoid f _ xs y x x w (InHere x _)) (walk-distinct f (Nil _) xs y x w)))
  (let-match erased (spokes-simple B d l e n f fe lab Vs Rs ls m rv rls dv al) (OrL _ _ dl) ((OrR _ _ r) (values l Vs ls (OrR _ _ r))))
  (values l Vs ls (OrL _ _ (MkFRec d x l k e n f fe lab Vs Rs ls ob (LengthCons _ x xs k1 lxs) dv al rv rls dl plx))))

; A dart u on the face of x has the label of the face of its edge image in ls.
(def-fns _ $ (erased fr-hit : (erased (Nat) d x lx k u eu l) (erased (List (Nat)) e n f fe lab Vs ls) (erased (FRec d e n f fe lab x lx k Vs ls) fr)
    (erased (Spk d e n f fe lab) c) (erased (Nth (Nat) lab u lx) pu) (erased (Nth (Nat) e u eu) pe) (erased (Nth (Nat) lab eu l) pl) -> (erased (In l ls) r))
  (let-match erased fr (MkFRec _ _ _ _ _ _ _ _ _ _ Rs _ o lv dv al rv rl dl plx))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl0 cu rfe kfe io ufe lfe fl rlf))
  (let ((erased s) (erased ps) (erased is)) (respects-val fe Vs Rs u rv (orbit-in x u f Vs o (facelab-same d x u lx f lab fl plx pu))))
  (let ((erased eu2) (erased pe2) (erased pf)) (fe-split d u s e n f fe lab c ps))
  (let-match erased (nth-fn _ e u eu eu2 pe pe2) (Refl _ _))
  (in-map lab Rs ls s l is rl (respects-nth lab f lab eu s l rlf pf pl)))

; A label l of ls is that of the face of the edge image of a dart u of the face.
(def-fns _ $ (erased fr-wit : (erased (Nat) d x lx k l) (erased (List (Nat)) e n f fe lab Vs ls) (erased (FRec d e n f fe lab x lx k Vs ls) fr)
    (erased (Spk d e n f fe lab) c) (erased (In l ls) il) -> (erased (Nat) u eu) (erased (In u Vs) iu) (erased (Nth (Nat) lab u lx) pu)
    (erased (Nth (Nat) e u eu) pe) (erased (Nth (Nat) lab eu l) pl))
  (let-match erased fr (MkFRec _ _ _ _ _ _ _ _ _ _ Rs _ o lv dv al rv rl dl plx))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl0 cu rfe kfe io ufe lfe fl rlf))
  (let ((erased s) (erased is) (erased ps)) (respects-in lab Rs ls l rl il))
  (let ((erased u) (erased iu) (erased pu)) (respects-in fe Vs Rs s rv is))
  (let ((erased eu) (erased pe) (erased pf)) (fe-split d u s e n f fe lab c pu))
  (values u eu iu (laball-in lx u lab Vs al iu) pe (respects-at lab f lab eu s l rlf pf ps)))

; A dart fixed by f is alone on its face.
(def-fns _ $ (erased fix-path : (erased (Nat) u v) (erased (List (Nat)) f s xs) (erased (Nth (Nat) f u u) pu) (subterm erased (Path f s u v xs) w)
    -> (erased (Eq (Nat) u v) r))
  (let-match erased w (PathStep _ _ xs1 _ z _ pz _ w1) ((PathHere _ _ _) (Refl _ u)))
  (let-match erased (nth-fn _ f u u z pu pz) (Refl _ _))
  (fix-path u v f s xs1 pu w1))

(def-fns _ $ (erased fix-same : (erased (Nat) d u v l) (erased (List (Nat)) f lab) (erased (FaceLab d f lab) fl) (erased (Nth (Nat) f u u) pf)
    (erased (Nth (Nat) lab u l) pu) (erased (Nth (Nat) lab v l) pv) -> (erased (Eq (Nat) u v) r))
  (let-match erased (facelab-same d u v l f lab fl pu pv) (MkSomePath _ _ ws _ _ w))
  (fix-path u v f (Nil _) ws pf w))

; A dart and its edge image are on different faces.
(def-fns _ $ (erased edge-apart : (erased (Nat) d u eu l l2) (erased (List (Nat)) e n f fe lab) (erased (Spk d e n f fe lab) c) (erased (Nth (Nat) e u eu) pe)
    (erased (Nth (Nat) lab u l) pu) (erased (Nth (Nat) lab eu l2) pl) -> (erased (Apart (Nat) Lt l l2) r))
  (let-match erased c (MkSpk _ _ _ _ _ _ ids h gen bl pl0 cu rfe kfe io ufe lfe fl rl))
  (let-match erased (nat-eq l l2) (Unequal _ _ _ _ ne)
    (absurd (Equal _ _ _)
      (let-match erased (facelab-same d u eu l f lab fl pu pl) (MkSomePath _ _ ws _ _ wp))
      (bridgeless-face d u eu e n f (Nil _) ws bl pe wp)))
  ne)

; chordless_spoke_ring for a face of any size: distinct darts u and v of one face, neither the face image of the other, with the
; faces of their edge images adjacent through z, give the ring v :: e z :: e u of three darts, nontrivial for 0.
(def-fns _ $ (erased chord-gen : (erased (Level) B) (erased (Nat) d u v fu fv eu ev z ez lx lu lv) (erased (List (Nat)) e n f fe lab)
    (erased (MinCx B d e n f fe lab) m) (erased (Nth (Nat) lab u lx) pu) (erased (Nth (Nat) lab v lx) pv) (erased (Apart (Nat) Lt u v) nuv)
    (erased (Nth (Nat) f u fu) pfu) (erased (Apart (Nat) Lt fu v) nfu) (erased (Nth (Nat) f v fv) pfv) (erased (Apart (Nat) Lt fv u) nfv)
    (erased (Nth (Nat) e u eu) peu) (erased (Nth (Nat) lab eu lu) plu) (erased (Nth (Nat) e v ev) pev) (erased (Nth (Nat) lab ev lv) plv)
    (erased (Nth (Nat) lab z lu) pz) (erased (Nth (Nat) e z ez) pez) (erased (Nth (Nat) lab ez lv) plz) -> (erased (Reduces B d e n f) r))
  (let ((erased m2)) m)
  (let-match erased m2 (MkMinCx _ _ _ _ _ _ _ pb bks c cn nc))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased ll)) (respects-length lab f lab d rl lf))
  (let-match erased (nat-eq lu lv) (Unequal _ _ _ _ nuv2) ((Equal _ _ _) (cx-dd B d u v eu ev lx lu e n f fe lab m peu pev pu pv plu plv nuv)))
  (let ((erased pze) (erased _)) (plain-eq d z ez e pl (pre-lt d z ez e nf pme pez) pez))
  (let ((erased pue) (erased _)) (plain-eq d u eu e pl (pre-lt d u eu e nf pme peu) peu))
  (let ((erased p)) (Cons _ ez (Cons _ eu (Nil _))))
  (let ((erased q)) (Cons _ v p))
  (let ((erased lq)) (Cons _ lx (Cons _ lv (Cons _ lu (Nil _)))))
  (let ((erased rlq)) (RespCons lab _ _ v lx pv (RespCons lab _ _ ez lv plz (RespCons lab _ _ eu lu plu (RespNil lab)))))
  (let ((erased nxv) (erased nxu)) (values (edge-apart d v ev lx lv e n f fe lab c pev pv plv) (edge-apart d u eu lx lu e n f fe lab c peu pu plu)))
  (let ((erased rg)) (MkRing e f p v eu u
    (RPCons e f (Cons _ eu (Nil _)) v ev ez eu pev (facelab-same d ev ez lv f lab fl plv plz)
      (RPCons e f (Nil _) ez z eu eu pze (facelab-same d z eu lu f lab fl pz plu) (RPNil e f eu)))
    pue (facelab-same d u v lx f lab fl pu pv)
    (MkSimple f q lab lq rl rlq (DistCons lx _ (NotInCons lx lv _ nxv (NotInCons lx lu _ nxu (NotInNil lx)))
      (DistCons lv _ (NotInCons lv lu _ (apart-sym lu lv nuv2) (NotInNil lv)) (DistCons lu _ (NotInNil lu) (DistNil)))))))
  (let ((erased ieu)) (InThere eu v _ (InThere eu ez _ (InHere eu (Nil (Nat))))))
  (let ((erased ur)) (ring-under d v e n f p h rg))
  (let ((erased hd) (erased zs) (erased ds)) (ds-exists d e n f q h ur))
  (let ((erased nuu)) (match erased (nat-eq fu u) (((Apart (Nat) Lt fu u) r))
    ((Unequal _ _ _ _ ne) ne)
    (absurd (Equal _ _ _) (let-match erased (fix-same d u v lx f lab fl pfu pu pv) (Refl _ _)) (apart-irrefl u nuv))))
  (let ((erased lfu)) (perm-val d u fu f fi pmf pfu))
  (let ((erased t) (erased pt)) (nth-exists _ fe d fu lfe lfu))
  (let ((erased efu) (erased pefu) (erased pft)) (fe-split d fu t e n f fe lab c pt))
  (let ((erased lt) (erased plt)) (nth-exists _ lab d t ll (under-nth fe fu t d ufe pt)))
  (let ((erased plefu)) (respects-at lab f lab efu t lt rl pft plt))
  (let ((erased plfu)) (respects-nth lab f lab u fu lx rl pfu pu))
  (let-match erased (nat-eq lt lv) (Unequal _ _ _ _ ntv) ((Equal _ _ _) (cx-dd B d fu v efu ev lx lv e n f fe lab m pefu pev plfu pv plefu plv nfu)))
  (let-match erased (nat-eq lt lu) (Unequal _ _ _ _ ntu) ((Equal _ _ _) (cx-dd B d fu u efu eu lx lu e n f fe lab m pefu peu plfu pu plefu plu nuu)))
  (let ((erased dt)) (MkDiskF n f q t
    (disk-node d eu t n ni f q pmn (disk-ring d eu n ni f q pmn ieu (perm-val d u eu e nf pme peu)) (node-edge d u eu fu t e n f fe lab c pfu peu pt))
    (MkKernel f q lab lq t lt rl rlq plt (NotInCons lt lx _ (apart-sym lx lt (edge-apart d fu efu lx lt e n f fe lab c pefu plfu plefu))
      (NotInCons lt lv _ ntv (NotInCons lt lu _ ntu (NotInNil lt)))))))
  (let ((erased a) (erased pia) (erased _)) (perm-nth d u fi f (perm-sym d f fi pmf) (pre-lt d u fu f fi pmf pfu)))
  (let ((erased pfa)) (perm-inv d u a fi f (perm-sym d f fi pmf) pia))
  (let ((erased ea) (erased pea) (erased pnu)) (node-face d a u e n f fe lab c pfa))
  (let ((erased la) (erased pla)) (nth-exists _ lab d ea ll (perm-val d a ea e nf pme pea)))
  (let ((erased plaa)) (respects-at lab f lab a u lx rl pfa pu))
  (let ((erased nav)) (match erased (nat-eq a v) (((Apart (Nat) Lt a v) r))
    ((Unequal _ _ _ _ ne) ne)
    (absurd (Equal _ _ _) (let-match erased (nth-fn _ f v u fv pfa pfv) (Refl _ _)) (apart-irrefl u nfv))))
  (let ((erased nau)) (match erased (nat-eq a u) (((Apart (Nat) Lt a u) r))
    ((Unequal _ _ _ _ ne) ne)
    (absurd (Equal _ _ _) (let-match erased (fix-same d u v lx f lab fl pfa pu pv) (Refl _ _)) (apart-irrefl u nuv))))
  (let-match erased (nat-eq la lv) (Unequal _ _ _ _ nlv) ((Equal _ _ _) (cx-dd B d a v ea ev lx lv e n f fe lab m pea pev plaa pv pla plv nav)))
  (let-match erased (nat-eq la lu) (Unequal _ _ _ _ nlu) ((Equal _ _ _) (cx-dd B d a u ea eu lx lu e n f fe lab m pea peu plaa pu pla plu nau)))
  (let ((erased lea)) (perm-val d a ea e nf pme pea))
  (let ((erased iz)) (match erased (in-dec ea hd) (((In ea zs) r))
    (absurd (OrL _ _ ih)
      (disk-edge-ring d eu u v e n f p h gen pl rg (ProperBig e (Nil _) v ez eu) ieu pue
        (disk-pre n f q ea u (ds-in d ea v e n f p hd zs h gen rg ur ds ih) pnu)))
    ((OrR _ _ o) (ds-off d ea v e n f p hd zs hd zs h gen rg ur ds ds o lea))))
  (let ((erased ky)) (MkKernel f q lab lq ea la rl rlq pla (NotInCons la lx _ (apart-sym lx la (edge-apart d a ea lx la e n f fe lab c pea plaa pla))
    (NotInCons la lv _ nlv (NotInCons la lu _ nlu (NotInNil la))))))
  (cx-ring B d v (Succ (Succ (Succ (Zero)))) e n f fe lab p m rg (LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthNil _)
    (LtS _ _ $ LtS _ _ $ LtS _ _ $ LtZ _) (nontrivial0 d v t ea e n f p hd zs h gen rg ds dt iz ky)))
