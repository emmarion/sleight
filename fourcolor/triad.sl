; Three darts of a face of more than four darts, each the face image of the one before, are not a whole face.
(def-fns _ $ (erased absurd tri : (erased (Nat) d x lx k a b c) (erased (List (Nat)) e n f fe lab Vs ls) (erased (FRec d e n f fe lab x lx k Vs ls) fr)
    (erased (FaceLab d f lab) fl) (erased (Lt 4 k) l4) (erased (Nth (Nat) lab a lx) pa) (erased (Nth (Nat) f a b) pab) (erased (Nth (Nat) f b c) pbc)
    (erased (Nth (Nat) f c a) pca) (erased (Apart (Nat) Lt b a) nba) (erased (Apart (Nat) Lt c a) nca) -> (erased (False) r))
  (let-match erased fr (MkFRec _ _ _ _ _ _ _ _ _ _ Rs _ o lv dv al rv rl dl plx))
  (let ((erased os)) (Cons _ a (Cons _ b (Cons _ c (Nil _)))))
  (let ((erased ob)) (MkOrbit f (Cons _ b (Cons _ c (Nil _))) a b pab
    (PathStep f _ (Cons _ c (Nil _)) b c a pbc (NotInCons b a _ nba (NotInNil b))
      (PathStep f _ (Nil _) c a a pca (NotInCons c a _ nca (NotInNil c)) (PathHere f _ a)))))
  (unary 4)
  (lt-irrefl 4 (lt-le-trans 4 k 4 l4 (lt-weaken k 4 (pigeonhole Vs os k 3 dv (lab-sub d a lx f lab os fl ob pa Vs al) lv
    (LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthNil _))))))

(def-fns _ $ (erased absurd fan-or : (erased (Nat) d u0 u1 u2 u3) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pm)
    (erased (HOr (Nth (Nat) f u0 u1) (Nth (Nat) f u1 u0)) o1) (erased (HOr (Nth (Nat) f u0 u2) (Nth (Nat) f u2 u0)) o2)
    (erased (HOr (Nth (Nat) f u0 u3) (Nth (Nat) f u3 u0)) o3) (erased (Apart (Nat) Lt u1 u2) a12) (erased (Apart (Nat) Lt u1 u3) a13)
    (erased (Apart (Nat) Lt u2 u3) a23) -> (erased (False) r))
  (match erased o1 _
    (absurd (OrL _ _ p1) (match erased o2 _
      (absurd (OrL _ _ p2) (same-out u0 u1 u2 f p1 p2 a12))
      (absurd (OrR _ _ q2) (match erased o3 _
        (absurd (OrL _ _ p3) (same-out u0 u1 u3 f p1 p3 a13))
        (absurd (OrR _ _ q3) (same-in d u0 u2 u3 f fi pm q2 q3 a23))))))
    (absurd (OrR _ _ q1) (match erased o2 _
      (absurd (OrR _ _ q2) (same-in d u0 u1 u2 f fi pm q1 q2 a12))
      (absurd (OrL _ _ p2) (match erased o3 _
        (absurd (OrL _ _ p3) (same-out u0 u2 u3 f p2 p3 a23))
        (absurd (OrR _ _ q3) (same-in d u0 u1 u3 f fi pm q1 q3 a13))))))))

(def-fns _ $ (erased absurd tri-or : (erased (Nat) d x lx k u1 u2 u3) (erased (List (Nat)) e n f fe lab Vs ls) (erased (FRec d e n f fe lab x lx k Vs ls) fr)
    (erased (FaceLab d f lab) fl) (erased (Lt 4 k) l4) (erased (Nth (Nat) lab u1 lx) pu1)
    (erased (HOr (Nth (Nat) f u1 u2) (Nth (Nat) f u2 u1)) o12) (erased (HOr (Nth (Nat) f u1 u3) (Nth (Nat) f u3 u1)) o13)
    (erased (HOr (Nth (Nat) f u2 u3) (Nth (Nat) f u3 u2)) o23) (erased (Apart (Nat) Lt u1 u2) a12) (erased (Apart (Nat) Lt u1 u3) a13)
    (erased (Apart (Nat) Lt u2 u3) a23) -> (erased (False) r))
  (match erased o12 _
    (absurd (OrL _ _ p12) (match erased o13 _
      (absurd (OrL _ _ p13) (same-out u1 u2 u3 f p12 p13 a23))
      (absurd (OrR _ _ q13) (match erased o23 _
        (absurd (OrL _ _ p23) (tri d x lx k u1 u2 u3 e n f fe lab Vs ls fr fl l4 pu1 p12 p23 q13 (apart-sym u1 u2 a12) (apart-sym u1 u3 a13)))
        (absurd (OrR _ _ q23) (same-out u3 u1 u2 f q13 q23 a12))))))
    (absurd (OrR _ _ q12) (match erased o13 _
      (absurd (OrL _ _ p13) (match erased o23 _
        (absurd (OrL _ _ p23) (same-out u2 u1 u3 f q12 p23 a13))
        (absurd (OrR _ _ q23) (tri d x lx k u1 u3 u2 e n f fe lab Vs ls fr fl l4 pu1 p13 q23 q12 (apart-sym u1 u3 a13) (apart-sym u1 u2 a12)))))
      (absurd (OrR _ _ q13) (match erased o23 _
        (absurd (OrL _ _ p23) (same-out u2 u1 u3 f q12 p23 a13))
        (absurd (OrR _ _ q23) (same-out u3 u1 u2 f q13 q23 a12))))))))

; cross_adj: faces ti and tj adjacent to lx through ui and uj and to lh through wi and wj, with lx not adjacent to lh, are
; adjacent (adj12), so ui and uj follow one another on their face (consec), or the map reduces.
(def-fns _ $ (erased cross : (erased (Level) B) (erased (Nat) d ui eui uj euj wi ewi wj ewj ti tj lx lh xr kx) (erased (List (Nat)) e n f fe lab Vx lsx)
    (erased (MinCx B d e n f fe lab) m) (erased (FRec d e n f fe lab xr lx kx Vx lsx) fx)
    (erased (Nth (Nat) lab ui lx) pui) (erased (Nth (Nat) e ui eui) peui) (erased (Nth (Nat) lab eui ti) plui)
    (erased (Nth (Nat) lab uj lx) puj) (erased (Nth (Nat) e uj euj) peuj) (erased (Nth (Nat) lab euj tj) pluj)
    (erased (Nth (Nat) lab wi lh) pwi) (erased (Nth (Nat) e wi ewi) pewi) (erased (Nth (Nat) lab ewi ti) plwi)
    (erased (Nth (Nat) lab wj lh) pwj) (erased (Nth (Nat) e wj ewj) pewj) (erased (Nth (Nat) lab ewj tj) plwj)
    (erased (Apart (Nat) Lt ti tj) nij) (erased (Apart (Nat) Lt lx lh) nxh) (erased (NotIn lh lsx) ox) (erased (Apart (Nat) Lt ui uj) aij)
    -> (erased (HOr (HOr (Nth (Nat) f ui uj) (Nth (Nat) f uj ui)) (Reduces B d e n f)) r))
  (let ((erased m2)) m)
  (let-match erased m2 (MkMinCx _ _ _ _ _ _ _ pb bks c cn nc))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased k) (erased o)) (order-at d eui f fi pmf (perm-val d ui eui e nf pme peui)))
  (let ((erased lz) (erased Vz) (erased lsz) (erased fo)) (fr-make B d eui k e n f fe lab m o))
  (let-match erased fo (OrL _ _ fz) ((OrR _ _ r) (OrR _ _ r)))
  (let ((erased fz2)) fz)
  (let-match erased fz2 (MkFRec _ _ _ _ _ _ _ _ _ _ Rs _ oz lv dv al rv rlz dl plx))
  (let-match erased (nth-fn _ lab eui lz ti plx plui) (Refl _ _))
  (match erased (in-dec tj lsz) _
    ((OrL _ _ iz)
      (let ((erased z) (erased ez) (erased _) (erased pz) (erased pez) (erased plz)) (fr-wit d eui ti k tj e n f fe lab Vz lsz fz c iz))
      (consec B d ui uj eui euj z ez lx ti tj e n f fe lab m pui puj aij peui plui peuj pluj pz pez plz))
    ((OrR _ _ oz2)
      (let ((erased pwj2) (erased _)) (plain-eq d wj ewj e pl (pre-lt d wj ewj e nf pme pewj) pewj))
      (let ((erased pwi2) (erased _)) (plain-eq d wi ewi e pl (pre-lt d wi ewi e nf pme pewi) pewi))
      (OrR _ _ (adj12 B d uj euj ewj wj ewi wi ui eui lx tj lh ti xr kx eui k e n f fe lab Vx lsx Vz lsz m fx fz
        puj peuj pluj plwj pwj2 pwj plwi pwi2 pwi pui peui plui nij oz2 nxh ox)))))

; fcard_adj_max: with the faces lx and lh apart and the first of more than four darts, three distinct faces adjacent to both
; make the map reduce.
(def-fns _ $ (erased adj-max : (erased (Level) B) (erased (Nat) d xr lx kx hr lh kh t1 t2 t3) (erased (List (Nat)) e n f fe lab Vx lsx Vh lsh)
    (erased (MinCx B d e n f fe lab) m) (erased (FRec d e n f fe lab xr lx kx Vx lsx) fx) (erased (FRec d e n f fe lab hr lh kh Vh lsh) fh)
    (erased (Lt 4 kx) l4) (erased (Apart (Nat) Lt lx lh) nxh) (erased (Apart (Nat) Lt t1 t2) n12) (erased (Apart (Nat) Lt t1 t3) n13)
    (erased (Apart (Nat) Lt t2 t3) n23) (erased (In t1 lsx) x1) (erased (In t2 lsx) x2) (erased (In t3 lsx) x3) (erased (In t1 lsh) h1)
    (erased (In t2 lsh) h2) (erased (In t3 lsh) h3) -> (erased (Reduces B d e n f) r))
  (let ((erased m2)) m)
  (let-match erased m2 (MkMinCx _ _ _ _ _ _ _ pb bks c cn nc))
  (let ((erased c2)) c)
  (let-match erased c2 (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased u1) (erased eu1) (erased _) (erased pu1) (erased peu1) (erased plu1)) (fr-wit d xr lx kx t1 e n f fe lab Vx lsx fx c x1))
  (let ((erased u2) (erased eu2) (erased _) (erased pu2) (erased peu2) (erased plu2)) (fr-wit d xr lx kx t2 e n f fe lab Vx lsx fx c x2))
  (let ((erased u3) (erased eu3) (erased _) (erased pu3) (erased peu3) (erased plu3)) (fr-wit d xr lx kx t3 e n f fe lab Vx lsx fx c x3))
  (let ((erased w1) (erased ew1) (erased _) (erased pw1) (erased pew1) (erased plw1)) (fr-wit d hr lh kh t1 e n f fe lab Vh lsh fh c h1))
  (let ((erased w2) (erased ew2) (erased _) (erased pw2) (erased pew2) (erased plw2)) (fr-wit d hr lh kh t2 e n f fe lab Vh lsh fh c h2))
  (let ((erased w3) (erased ew3) (erased _) (erased pw3) (erased pew3) (erased plw3)) (fr-wit d hr lh kh t3 e n f fe lab Vh lsh fh c h3))
  (let ((erased a12) (erased a13) (erased a23)) (values (u-apart u1 u2 eu1 eu2 t1 t2 e lab n12 peu1 peu2 plu1 plu2)
    (u-apart u1 u3 eu1 eu3 t1 t3 e lab n13 peu1 peu3 plu1 plu3) (u-apart u2 u3 eu2 eu3 t2 t3 e lab n23 peu2 peu3 plu2 plu3)))
  (match erased (in-dec lh lsx) _
    ((OrL _ _ ih)
      (let ((erased u0) (erased eu0) (erased _) (erased pu0) (erased peu0) (erased plu0)) (fr-wit d xr lx kx lh e n f fe lab Vx lsx fx c ih))
      (let ((erased a01) (erased a02) (erased a03)) (values
        (u-apart u0 u1 eu0 eu1 lh t1 e lab (edge-apart d w1 ew1 lh t1 e n f fe lab c pew1 pw1 plw1) peu0 peu1 plu0 plu1)
        (u-apart u0 u2 eu0 eu2 lh t2 e lab (edge-apart d w2 ew2 lh t2 e n f fe lab c pew2 pw2 plw2) peu0 peu2 plu0 plu2)
        (u-apart u0 u3 eu0 eu3 lh t3 e lab (edge-apart d w3 ew3 lh t3 e n f fe lab c pew3 pw3 plw3) peu0 peu3 plu0 plu3)))
      (let-match erased (consec B d u0 u1 eu0 eu1 w1 ew1 lx lh t1 e n f fe lab m pu0 pu1 a01 peu0 plu0 peu1 plu1 pw1 pew1 plw1) (OrL _ _ o1) ((OrR _ _ r) r))
      (let-match erased (consec B d u0 u2 eu0 eu2 w2 ew2 lx lh t2 e n f fe lab m pu0 pu2 a02 peu0 plu0 peu2 plu2 pw2 pew2 plw2) (OrL _ _ o2) ((OrR _ _ r) r))
      (let-match erased (consec B d u0 u3 eu0 eu3 w3 ew3 lx lh t3 e n f fe lab m pu0 pu3 a03 peu0 plu0 peu3 plu3 pw3 pew3 plw3) (OrL _ _ o3) ((OrR _ _ r) r))
      (match erased (fan-or d u0 u1 u2 u3 f fi pmf o1 o2 o3 a12 a13 a23) _))
    ((OrR _ _ ox)
      (let-match erased (cross B d u1 eu1 u2 eu2 w1 ew1 w2 ew2 t1 t2 lx lh xr kx e n f fe lab Vx lsx m fx pu1 peu1 plu1 pu2 peu2 plu2
        pw1 pew1 plw1 pw2 pew2 plw2 n12 nxh ox a12) (OrL _ _ o12) ((OrR _ _ r) r))
      (let-match erased (cross B d u1 eu1 u3 eu3 w1 ew1 w3 ew3 t1 t3 lx lh xr kx e n f fe lab Vx lsx m fx pu1 peu1 plu1 pu3 peu3 plu3
        pw1 pew1 plw1 pw3 pew3 plw3 n13 nxh ox a13) (OrL _ _ o13) ((OrR _ _ r) r))
      (let-match erased (cross B d u2 eu2 u3 eu3 w2 ew2 w3 ew3 t2 t3 lx lh xr kx e n f fe lab Vx lsx m fx pu2 peu2 plu2 pu3 peu3 plu3
        pw2 pew2 plw2 pw3 pew3 plw3 n23 nxh ox a23) (OrL _ _ o23) ((OrR _ _ r) r))
      (match erased (tri-or d xr lx kx u1 u2 u3 e n f fe lab Vx lsx fx fl l4 pu1 o12 o13 o23 a12 a13 a23) _))))

(def-adts $ (SubD : ((List (Nat)) xs ys) -> Type)
  enum
  (many SDYes : (erased (List (Nat)) xs ys) (erased (WSub xs ys) sb) -> (SubD xs ys))
  (many SDNo : (erased (List (Nat)) xs ys) (erased (Nat) l) (erased (In l xs) il) (erased (NotIn l ys) ol) -> (SubD xs ys)))

(def-fns _ $ (erased sub-dec : (subterm erased (List (Nat)) xs) (erased (List (Nat)) ys) -> (erased (SubD xs ys) r))
  (let-match erased xs (Cons _ x xs1) ((Nil _) (SDYes _ ys (HSubNil ys))))
  (match erased (sub-dec xs1 ys) _
    ((SDNo _ _ l il ol) (SDNo xs ys l (InThere l x xs1 il) ol))
    ((SDYes _ _ sb)
      (match erased (in-dec x ys) _
        ((OrL _ _ ix) (SDYes xs ys (HSubCons x xs1 ys ix sb)))
        ((OrR _ _ ox) (SDNo xs ys x (InHere x xs1) ox))))))

; A dart off the faces of r has a FaceLab label off those of r.
(def-fns _ $ (erased kernel-fl : (erased (Nat) d x l) (erased (List (Nat)) f lab r lr) (erased (FaceLab d f lab) fl) (erased (Kernel f r x) k)
    (erased (Respects lab r lr) rr) (erased (Nth (Nat) lab x l) px) -> (erased (NotIn l lr) o))
  (match erased (in-dec l lr) _
    ((OrR _ _ o) o)
    (absurd (OrL _ _ il)
      (let ((erased j) (erased ij) (erased pj)) (respects-in lab r lr l rr il))
      (kernel-fband x j f r k (facelab-same d x j l f lab fl px pj) ij))))

; The darts of a list on distinct faces have distinct FaceLab labels.
(def-fns _ $ (erased simple-go : (erased (Nat) d) (erased (List (Nat)) f lab lab2 r lr ls) (erased (FaceLab d f lab) fl) (erased (Respects lab2 f lab2) rf)
    (subterm erased (Respects lab r lr) rr) (erased (Respects lab2 r ls) r2) (erased (Distinct ls) dl) -> (erased (Distinct lr) res))
  (let-match erased rr (RespCons _ r1 lr1 x l px rr1) ((RespNil _) (DistNil)))
  (let-match erased r2 (RespCons _ _ ls1 _ l2 px2 r21))
  (let-match erased dl (DistCons _ _ o2 dl1))
  (DistCons l lr1 (match erased (in-dec l lr1) (((NotIn l lr1) res))
      ((OrR _ _ o) o)
      (absurd (OrL _ _ il)
        (let ((erased j) (erased ij) (erased pj)) (respects-in lab r1 lr1 l rr1 il))
        (let-match erased (facelab-same d x j l f lab fl px pj) (MkSomePath _ _ ws _ _ w))
        (apart-irrefl l2 (notin-in l2 l2 ls1 o2 (in-map lab2 r1 ls1 j l2 ij r21 (path-label f lab2 _ ws x j l2 w rf px2))))))
    (simple-go d f lab lab2 r1 lr1 ls1 fl rf rr1 r21 dl1)))

(def-fns _ $ (erased simple-fl : (erased (Nat) d) (erased (List (Nat)) f lab r lr) (erased (FaceLab d f lab) fl) (erased (Simple f r) s)
    (erased (Respects lab r lr) rr) -> (erased (Distinct lr) res))
  (let-match erased s (MkSimple _ _ lab2 ls rf rp dl))
  (simple-go d f lab lab2 r lr ls fl rf rr rp dl))

(def-adts $ (RLink : ((List (Nat)) f) ((Nat) x) ((List (Nat)) ps) -> Type)
  enum
  (many MkRLink : (erased (List (Nat)) f) (erased (Nat) x) (erased (List (Nat)) ps) (erased (Nat) q) (erased (In q ps) iq) (erased (SomePath f (Nil (Nat)) x q) sq)
      -> (RLink f x ps)))

; The face image of the last dart's edge image of a ring path, and of every other dart, is on the face of a later dart, or
; the dart is the last.
(def-fns _ $ (erased rp-succ : (erased (List (Nat)) e f ps) (erased (Nat) x y t et) (subterm erased (RPath e f x ps y) rp) (erased (In t (Cons (Nat) x ps)) it)
    (erased (Nth (Nat) e t et) pt) -> (erased (HOr (Eq (Nat) t y) (RLink f et ps)) r))
  (let-match erased rp (RPCons _ _ p1 _ ex z _ pe w rest) ((RPNil _ _ _) (let-match erased it (InHere _ _) (absurd (InThere _ _ _ i) i)) (OrL _ _ (Refl _ t))))
  (match erased it _
    ((InHere _ _) (let-match erased (nth-fn _ e x et ex pt pe) (Refl _ _)) (OrR _ _ (MkRLink f et ps z (InHere z p1) w)))
    ((InThere _ _ _ it1)
      (match erased (rp-succ e f p1 z y t et rest it1 pt) _
        ((OrL _ _ eq) (OrL _ _ eq))
        ((OrR _ _ rl) (let-match erased rl (MkRLink _ _ _ q iq sq)) (OrR _ _ (MkRLink f et ps q (InThere q z p1 iq) sq)))))))

; The edge image of a dart of a ring is on a face of the ring.
(def-fns _ $ (erased ring-elab : (erased (Nat) d w t et l) (erased (List (Nat)) e f lab Bs lp) (erased (FaceLab d f lab) fl) (erased (Ring e f w Bs) rg)
    (erased (Respects lab (Cons (Nat) w Bs) lp) rr) (erased (In t (Cons (Nat) w Bs)) it) (erased (Nth (Nat) e t et) pt) (erased (Nth (Nat) lab et l) pl)
    -> (erased (In l lp) r))
  (let-match erased rg (MkRing _ _ _ _ y ey rp pe sw s))
  (match erased (rp-succ e f Bs w y t et rp it pt) _
    ((OrL _ _ eq) (let-match erased eq (Refl _ _)) (let-match erased (nth-fn _ e t et ey pt pe) (Refl _ _))
      (in-map lab _ lp w l (InHere w Bs) rr (facelab-path d et w l f lab fl sw pl)))
    ((OrR _ _ rl) (let-match erased rl (MkRLink _ _ _ q iq sq)) (in-map lab _ lp q l (InThere q w Bs iq) rr (facelab-path d et q l f lab fl sq pl)))))

; cx without one dart z, with insertE inside z :: e z :: ins2.
(def-fns _ $ (erased ie-drop : (erased (List (Nat)) e cx ins) (erased (Nat) z k) (subterm erased (InsertE e cx ins) ie) (erased (In z cx) iz)
    (erased (Length (Nat) cx (Succ k)) lc) -> (erased (List (Nat)) cx2 ins2) (erased (Nat) ez) (erased (InsertE e cx2 ins2) ie2) (erased (Length (Nat) cx2 k) lc2)
    (erased (Nth (Nat) e z ez) pz) (erased (WSub ins (Cons (Nat) z (Cons (Nat) ez ins2))) sb))
  (let-match erased ie (IECons _ cx1 ins1 x y px ie1) (absurd (IENil _) iz))
  (let-match erased lc (LengthCons _ _ _ _ lc1))
  (match erased iz (((List (Nat)) cx2 ins2) ((Nat) ez) ((InsertE e cx2 ins2) ie2) ((Length (Nat) cx2 k) lc2) ((Nth (Nat) e z ez) pz)
      ((WSub ins (Cons (Nat) z (Cons (Nat) ez ins2))) sb))
    ((InHere _ _) (values cx1 ins1 y ie1 lc1 px (sub-refl (Cons _ x (Cons _ y ins1)))))
    ((InThere _ _ _ iz1)
      (let-match erased lc1 (LengthCons _ _ _ k2 lc3) (absurd (LengthNil _) iz1))
      (let ((erased cx3) (erased ins3) (erased ez) (erased ie3) (erased lc4) (erased pz) (erased s3)) (ie-drop e cx1 ins1 z k2 ie1 iz1 lc1))
      (let ((erased T)) (Cons _ z (Cons _ ez (Cons _ x (Cons _ y ins3)))))
      (values (Cons _ x cx3) (Cons _ x (Cons _ y ins3)) ez (IECons e cx3 ins3 x y px ie3) (LengthCons _ x cx3 k2 lc4) pz
        (HSubCons x _ T (InThere x z _ (InThere x ez _ (InHere x _))) (HSubCons y ins1 T (InThere y z _ (InThere y ez _ (InThere y x _ (InHere y ins3))))
          (sub-trans ins1 (Cons _ z (Cons _ ez ins3)) T s3
            (HSubCons z _ T (InHere z _) (HSubCons ez ins3 T (InThere ez z _ (InHere ez _))
              (sub-cons z ins3 _ (sub-cons ez ins3 _ (sub-cons x ins3 _ (sub-cons y ins3 ins3 (sub-refl ins3))))))))))))))

; A dart t of the ring that is z or e z, with z in cx: the dart c of insertE that came from z, on no face of the ring, would be
; t or its edge image, which are.
(def-fns _ $ (erased absurd t-ok : (erased (Nat) d w t z ez c lc) (erased (List (Nat)) e n f fe lab Bs lp) (erased (Spk d e n f fe lab) cs) (erased (Ring e f w Bs) rg)
    (erased (Respects lab (Cons (Nat) w Bs) lp) rr) (erased (In t (Cons (Nat) w Bs)) it) (erased (HOr (Eq (Nat) t z) (Eq (Nat) t ez)) ot)
    (erased (Nth (Nat) e z ez) pz) (erased (HOr (Eq (Nat) c z) (Nth (Nat) e z c)) oc) (erased (Nth (Nat) lab c lc) plc) (erased (NotIn lc lp) o)
    -> (erased (False) r))
  (let-match erased cs (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased le) (erased ln) (erased lf)) (hyper-lengths d e n f h))
  (let ((erased ll)) (respects-length lab f lab d rl lf))
  (let ((erased lt)) (under-in _ t d (ring-under d w e n f Bs h rg) it))
  (let ((erased et) (erased pet) (erased lte)) (perm-nth d t e nf pme lt))
  (let ((erased l1) (erased pl1)) (nth-exists _ lab d t ll lt))
  (let ((erased l2) (erased pl2)) (nth-exists _ lab d et ll lte))
  (let ((erased i1) (erased i2)) (values (in-map lab _ lp t l1 it rr pl1) (ring-elab d w t et l2 e f lab Bs lp fl rg rr it pet pl2)))
  (let ((erased pzz) (erased _)) (plain-eq d z ez e pl (pre-lt d z ez e nf pme pz) pz))
  (match erased ot _
    (absurd (OrL _ _ eq) (let-match erased eq (Refl _ _))
      (match erased oc _
        (absurd (OrL _ _ eq2) (let-match erased eq2 (Refl _ _)) (let-match erased (nth-fn _ lab t l1 lc pl1 plc) (Refl _ _)) (apart-irrefl lc (notin-in lc lc lp o i1)))
        (absurd (OrR _ _ pc) (let-match erased (nth-fn _ e t et c pet pc) (Refl _ _)) (let-match erased (nth-fn _ lab et l2 lc pl2 plc) (Refl _ _))
          (apart-irrefl lc (notin-in lc lc lp o i2)))))
    (absurd (OrR _ _ eq) (let-match erased eq (Refl _ _))
      (match erased oc _
        (absurd (OrL _ _ eq2) (let-match erased eq2 (Refl _ _)) (let-match erased (nth-fn _ e t et c pet pzz) (Refl _ _))
          (let-match erased (nth-fn _ lab et l2 lc pl2 plc) (Refl _ _)) (apart-irrefl lc (notin-in lc lc lp o i2)))
        (absurd (OrR _ _ pc) (let-match erased (nth-fn _ e z t c pz pc) (Refl _ _)) (let-match erased (nth-fn _ lab t l1 lc pl1 plc) (Refl _ _))
          (apart-irrefl lc (notin-in lc lc lp o i1)))))))

(def-fns _ $ (erased bs-sub : (erased (Nat) d w z ez c lc) (erased (List (Nat)) e n f fe lab Bs lp ins ins2) (erased (Spk d e n f fe lab) cs) (erased (Ring e f w Bs) rg)
    (erased (Respects lab (Cons (Nat) w Bs) lp) rr) (subterm erased (List (Nat)) X) (erased (WSub X Bs) sx) (erased (WSub Bs ins) sb)
    (erased (WSub ins (Cons (Nat) z (Cons (Nat) ez ins2))) s2) (erased (Nth (Nat) e z ez) pz) (erased (HOr (Eq (Nat) c z) (Nth (Nat) e z c)) oc)
    (erased (Nth (Nat) lab c lc) plc) (erased (NotIn lc lp) o) -> (erased (WSub X ins2) r))
  (let-match erased sx (HSubCons t X1 _ it sx1) ((HSubNil _) (HSubNil ins2)))
  (let ((erased itp)) (InThere t w Bs it))
  (HSubCons t X1 ins2
    (match erased (sub-in ins _ t s2 (sub-in Bs ins t sb it)) (((In t ins2) r))
      (absurd (InHere _ _) (t-ok d w t z ez c lc e n f fe lab Bs lp cs rg rr itp (OrL _ _ (Refl _ t)) pz oc plc o))
      ((InThere _ _ _ i1)
        (match erased i1 (((In t ins2) r))
          (absurd (InHere _ _) (t-ok d w t z ez c lc e n f fe lab Bs lp cs rg rr itp (OrR _ _ (Refl _ t)) pz oc plc o))
          ((InThere _ _ _ i2) i2))))
    (bs-sub d w z ez c lc e n f fe lab Bs lp ins ins2 cs rg rr X1 sx1 sb s2 pz oc plc o)))

; The faces of insertE are faces of a contract ring w :: Bs of five darts, Bs in insertE of four darts: otherwise the ring is
; one of the contract without the dart behind one off its faces, of three darts, against contract_ring_max.
(def-fns _ $ (erased ins-band : (erased (Nat) d w c lc) (erased (List (Nat)) e n f fe lab cx ins Bs lp) (erased (Spk d e n f fe lab) cs)
    (erased (Ring e f w Bs) rg) (erased (Proper e (Cons (Nat) w Bs)) pr) (erased (WSub Bs ins) sb) (erased (InsertE e cx ins) ie) (erased (Length (Nat) cx 4) l)
    (erased (Length (Nat) Bs 4) lb) (erased (Respects lab (Cons (Nat) w Bs) lp) rr) (erased (In c ins) ic) (erased (Nth (Nat) lab c lc) plc) -> (erased (In lc lp) r))
  (unary 4)
  (match erased (in-dec lc lp) _
    ((OrL _ _ i) i)
    (absurd (OrR _ _ o)
      (let-match erased cs (MkSpk _ _ _ _ _ _ ids h gen bl pl cu rfe kfe io ufe lfe fl rl))
      (let ((erased z) (erased iz) (erased oc)) (ins-pick e cx ins c ie ic))
      (let ((erased cx2) (erased ins2) (erased ez) (erased ie2) (erased lc2) (erased pz) (erased s2)) (ie-drop e cx ins z (Succ (Succ (Succ (Zero)))) ie iz l))
      (lt-irrefl 4 (ring-max d w 4 (Succ (Succ (Succ (Zero)))) e n f cx2 ins2 Bs h gen pl rg pr
        (bs-sub d w z ez c lc e n f fe lab Bs lp ins ins2 cs rg rr Bs (sub-refl Bs) sb s2 pz oc plc o) ie2 lb lc2)))))

; A dart y of more than four darts on its face: every spoke of its face on a face of lp, or a dart u of the face whose edge image
; is on none, or a reduction.
(def-adts $ (HubD : ((Level) B) ((Nat) d) ((List (Nat)) e n f fe lab lp) ((Nat) y ly) -> Type)
  enum
  (many HDHub : (erased (Level) B) (erased (Nat) d) (erased (List (Nat)) e n f fe lab lp) (erased (Nat) y ly k) (erased (List (Nat)) Vs ls)
      (erased (FRec d e n f fe lab y ly k Vs ls) fr) (erased (WSub ls lp) sb) (erased (Lt 4 k) l4) -> (HubD B d e n f fe lab lp y ly))
  (many HDOut : (erased (Level) B) (erased (Nat) d) (erased (List (Nat)) e n f fe lab lp) (erased (Nat) y ly u eu l) (erased (Nth (Nat) lab y ly) py)
      (erased (Nth (Nat) lab u ly) pu) (erased (Nth (Nat) e u eu) pe) (erased (Nth (Nat) lab eu l) pl) (erased (NotIn l lp) o) -> (HubD B d e n f fe lab lp y ly))
  (many HDRed : (erased (Level) B) (erased (Nat) d) (erased (List (Nat)) e n f fe lab lp) (erased (Nat) y ly) (erased (Reduces B d e n f) r)
      -> (HubD B d e n f fe lab lp y ly)))

(def-fns _ $ (erased hub-dec : (erased (Level) B) (erased (Nat) d y) (erased (List (Nat)) e n f fe lab ks lp) (erased (MinCx B d e n f fe lab) m)
    (erased (OrderList d f ks) ol) (erased (Above ks 4) ab) (erased (Lt y d) lyd) -> (erased (Nat) ly) (erased (HubD B d e n f fe lab lp y ly) r))
  (let ((erased m2)) m)
  (let-match erased m2 (MkMinCx _ _ _ _ _ _ _ pb bks c cn nc))
  (let ((erased k) (erased o) (erased l4)) (pent-at d y f ks ol ab lyd))
  (let ((erased ly) (erased Vs) (erased ls) (erased fo)) (fr-make B d y k e n f fe lab m o))
  (let-match erased fo (OrL _ _ fr) ((OrR _ _ r) (values ly (HDRed B d e n f fe lab lp y ly r))))
  (let ((erased fr2)) fr)
  (let-match erased fr2 (MkFRec _ _ _ _ _ _ _ _ _ _ Rs _ ob lv dv al rv rl dl plx))
  (match erased (sub-dec ls lp) _
    ((SDYes _ _ sb) (values ly (HDHub B d e n f fe lab lp y ly k Vs ls fr sb l4)))
    ((SDNo _ _ l il ol2)
      (let ((erased u) (erased eu) (erased _) (erased pu) (erased pe) (erased pl)) (fr-wit d y ly k l e n f fe lab Vs ls fr c il))
      (values ly (HDOut B d e n f fe lab lp y ly u eu l plx pu pe pl ol2)))))

(def-fns _ $ (erased zs-walk : (erased (Nat) d w a b) (erased (List (Nat)) e n f Bs hd zs s xs) (erased (Hypermap d e n f) h) (erased (Genus d e n f (Zero)) gen)
    (erased (Ring e f w Bs) rg) (erased (DiskSplit d e n (Cons (Nat) w Bs) hd zs) ds) (subterm erased (Path f s a b xs) pw) (erased (In a zs) ia)
    (erased (Kernel f (Cons (Nat) w Bs) a) ka) -> (erased (In b zs) ib) (erased (Kernel f (Cons (Nat) w Bs) b) kb))
  (let-match erased pw (PathStep _ _ xs1 _ a1 _ pa _ pw1) ((PathHere _ _ _) (values ia ka)))
  (let ((erased ia1) (erased ka1)) (diskfc-face d a a1 w e n f Bs hd zs h gen rg ds ia ka pa))
  (zs-walk d w a1 b e n f Bs hd zs s xs1 h gen rg ds pw1 ia1 ka1))

; nontrivial_ring 1 from a dart y0 of diskF and a dart y1 of diskFC, each with a dart of its face whose edge image is on no face
; of the ring: the face images of those edge images are a second dart of each side.
(def-fns _ $ (erased nt1 : (erased (Nat) d w y0 ly0 u0 eu0 l0 y1 ly1 u1 eu1 l1) (erased (List (Nat)) e n f fe lab Bs lp hd zs) (erased (Spk d e n f fe lab) c)
    (erased (Ring e f w Bs) rg) (erased (DiskSplit d e n (Cons (Nat) w Bs) hd zs) ds) (erased (Respects lab (Cons (Nat) w Bs) lp) rr)
