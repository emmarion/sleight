  (let ((erased fh2)) fh)
  (let-match erased fh2 (MkFRec _ _ _ _ _ _ _ _ _ _ Rh _ oh lvh dvh alh rvh rlh dlh plh))
  (let ((erased cov)) (cover kh lsh lp lp (sub-refl lp) dlh shp (respects-length lab Rh lsh kh rlh (respects-length fe Vh Rh kh rvh lvh)) l5 l4h))
  (let-match erased t (MkTriad _ _ _ os _ y1 y2 y3 y o i1 i2 i3 dy b1 b2 b3 iy na))
  (let ((erased o2)) o)
  (let-match erased o2 (MkOrbit _ xs _ yy px wo))
  (let ((erased lx0) (erased plx0)) (nth-exists _ lab d x0 ll (pre-lt d x0 yy f fi pmf px)))
  (let ((erased al0)) (orbit-lab x0 lx0 f lab os o rl plx0))
  (let ((erased py1) (erased py2) (erased py3)) (values (laball-in lx0 y1 lab os al0 i1) (laball-in lx0 y2 lab os al0 i2) (laball-in lx0 y3 lab os al0 i3)))
  (let ((erased z1) (erased t1) (erased pz1) (erased pt1) (erased it1)) (tri-face d w y1 lx0 e n f fe lab cx ins Bs lp c rg pr sb ie l lb rr b1))
  (let ((erased z2) (erased t2) (erased pz2) (erased pt2) (erased it2)) (tri-face d w y2 lx0 e n f fe lab cx ins Bs lp c rg pr sb ie l lb rr b2))
  (let ((erased z3) (erased t3) (erased pz3) (erased pt3) (erased it3)) (tri-face d w y3 lx0 e n f fe lab cx ins Bs lp c rg pr sb ie l lb rr b3))
  (let-match erased dy (DistCons _ _ oy1 dy1))
  (let-match erased oy1 (NotInCons _ _ _ a12 oy12))
  (let-match erased oy12 (NotInCons _ _ _ a13 _))
  (let-match erased dy1 (DistCons _ _ oy2 _))
  (let-match erased oy2 (NotInCons _ _ _ a23 _))
  (let-match erased (nat-eq t1 t2) (Unequal _ _ _ _ n12) ((Equal _ _ _) (cx-dd B d y1 y2 z1 z2 lx0 t1 e n f fe lab m pz1 pz2 py1 py2 pt1 pt2 a12)))
  (let-match erased (nat-eq t1 t3) (Unequal _ _ _ _ n13) ((Equal _ _ _) (cx-dd B d y1 y3 z1 z3 lx0 t1 e n f fe lab m pz1 pz3 py1 py3 pt1 pt3 a13)))
  (let-match erased (nat-eq t2 t3) (Unequal _ _ _ _ n23) ((Equal _ _ _) (cx-dd B d y2 y3 z2 z3 lx0 t2 e n f fe lab m pz2 pz3 py2 py3 pt2 pt3 a23)))
  (let-match erased (nat-eq lx0 lh) (Unequal _ _ _ _ nxh)
