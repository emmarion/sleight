; More of patch.v: outer_hd, patch_face_d, bridgeless_patch, patch_connected_r, patch_fcard_face_r, patch_gcomp and
; minimal_counter_example_is_connected. Load after patch.sl.

; A dart below dd is on the face of a dart of bd, or on no such face.
(def-fns _ $ (erased band-dec : (erased (Nat) dd xd) (erased (List (Nat)) fd fdi bd) (erased (List (Bond)) gfd) (erased (HPerm dd fd fdi) pm)
    (erased (Graph dd fd gfd) gr) (erased (Under bd dd) ub) (erased (Lt xd dd) lx) -> (erased (HOr (Fband fd bd xd) (Kernel fd bd xd)) r))
  (let ((erased k) (erased cs)) (classes-exists gfd dd (graph-below dd fd fdi gfd (graph-fun dd fd gfd gr) pm)))
  (let-match erased cs (MkClasses _ _ _ idd lab rs io ll lr dr fix cl ro))
  (let ((erased rf)) (const-respects lab idd fd lab gfd (graph-zip dd fd idd gfd gr io) cl (respects-id-right dd idd lab io ll)))
  (let ((erased ls) (erased rp)) (respects-exists lab bd dd ub ll))
  (let ((erased l) (erased pl)) (nth-exists _ lab dd xd ll lx))
  (match erased (in-dec l ls) _
    ((OrL _ _ il)
      (let ((erased b) (erased ib) (erased pb)) (respects-in lab bd ls l rp il))
      (let ((erased ws) (erased w)) (conn-path dd xd b fd fdi gfd pm gr (same-root gfd dd xd b l idd lab rs io ro pl pb lx (under-in bd b dd ub ib))))
      (OrL _ _ (MkFband fd bd xd b ib (MkSomePath fd (Nil _) ws xd b w))))
    ((OrR _ _ o) (OrR _ _ (MkKernel fd bd lab ls xd l rf rp pl o)))))

; A face walk of the whole map from the image of a disk dart labelled off the labels of bd, under a labelling constant along fd, is
; the image of a face walk of the disk map, ending at a dart of that label.
(def-fns _ $ (erased kernel-lift : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br lab ls s xs)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Respects lab fd lab) rf) (erased (Respects lab bd ls) rp) (erased (Nat) x y xd l)
    (subterm erased (Path f s x y xs) w) (erased (Nth (Nat) hd xd x) hx) (erased (Nth (Nat) lab xd l) pl) (erased (NotIn l ls) out)
    -> (erased (Nat) yd) (erased (List (Nat)) ys) (erased (Nth (Nat) hd yd y) hy) (erased (Nth (Nat) lab yd l) py) (erased (Path fd (Nil (Nat)) xd yd ys) r))
  (let-match erased w (PathStep _ _ xs1 _ z _ pz ns w1) ((PathHere _ _ _) (values xd (Nil _) hx pl (PathHere fd _ xd))))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hd2))
  (let ((erased zd) (erased pzd) (erased lzd)) (perm-nth dd xd fd fdi pmfd (nth-lt-length _ hd xd dd x hx lhd)))
  (let ((erased z2) (erased hz2)) (nth-exists _ hd dd zd lhd lzd))
  (let ((erased oxd)) (match erased (in-dec xd bd) (((NotIn xd bd) r))
    (absurd (OrL _ _ ib) (apart-irrefl l (notin-in l l ls out (in-map lab bd ls xd l ib rp pl))))
    ((OrR _ _ o) o)))
  (let-match erased (nth-fn _ f x z2 z (patch-face-d d dd dr e n f ed nd fd er nr fr hd hr bd br pt xd zd x z2 oxd pzd hx hz2) pz) (Refl _ _))
  (let ((erased yd) (erased ys) (erased hy) (erased py) (erased w2))
    (kernel-lift d dd dr e n f ed nd fd er nr fr hd hr bd br lab ls s xs1 pt rf rp z y zd l w1 hz2 (respects-nth lab fd lab xd zd l rf pzd pl) out))
  (values yd (Cons _ xd ys) hy py (PathStep fd _ ys xd zd yd pzd (NotInNil xd) w2)))

; patch_face_d, the direction patch_face_d' leaves: off the outer faces, darts of the disk map whose images are on one face are on one
; face. The hypothesis is read through outer_hd: the face of xd misses bd.
(def-fns _ $ (erased patch-face-d-pull : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br) (erased (List (Bond)) gf gfd)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Graph d f gf) grf) (erased (Graph dd fd gfd) grfd) (erased (Nat) xd yd x y)
    (erased (Kernel fd bd xd) kx) (erased (Conn gf x y) c) (erased (Nth (Nat) hd xd x) hx) (erased (Nth (Nat) hd yd y) hy) -> (erased (Conn gfd xd yd) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let-match erased kx (MkKernel _ _ lab ls _ l rf rp pl out))
  (let ((erased ws) (erased w)) (conn-path d x y f fi gf pmf grf c))
  (let ((erased yd2) (erased ys) (erased hy2) (erased py) (erased w2)) (kernel-lift d dd dr e n f ed nd fd er nr fr hd hr bd br lab ls (Nil _) ws pt rf rp x y xd l w hx pl out))
  (let-match erased (distinct-nth hd yd2 yd y dhd hy2 hy) (Refl _ _))
  (path-graph-conn dd xd yd fd (Nil _) ys gfd w2 grfd))

; outer_hd, one direction: the image of a disk dart on the face of a dart of bd is on the face of an image of the remainder map.
(def-fns _ $ (erased outer-hd-in : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br) (erased (List (Bond)) gf)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Graph d f gf) grf) (erased (Nat) xd x) (erased (Fband fd bd xd) fb)
    (erased (Nth (Nat) hd xd x) hx) -> (erased (Nat) y yr) (erased (Nth (Nat) hr yr y) hy) (erased (Conn gf x y) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hd2))
  (let-match erased fb (MkFband _ _ _ b ib sp))
  (let-match erased sp (MkSomePath _ _ ws _ _ w))
  (let ((erased zd) (erased fh)) (first-hit fd (Nil _) bd ws xd b w ib))
  (let-match erased fh (MkFirstHit _ _ ws2 _ _ w2 izd))
  (let ((erased mo)) (morph-face-d d dd dr e n f ed nd fd er nr fr hd hr bd br fdi idd pt pmfd lhd (perm-under dd idd idd (perm-id dd idd iod))))
  (let ((erased z2) (erased ws3) (erased hz) (erased w3) (erased rx)) (path-push2 dd xd zd x hd fd fdi f bd idd bd bG ws2 pmfd mo iod dhd rbd (sub-refl bd) w2 hx))
  (let ((erased jr) (erased ijr) (erased pjr)) (respects-in hr br bGr z2 rbr (revapp-in bG (Nil _) bGr z2 rv (OrL _ _ (in-map hd bd bG zd z2 izd rbd hz)))))
  (values z2 jr pjr (path-graph-conn d x z2 f bG ws3 gf w3 grf)))

; outer_hd, the other direction: a disk dart whose image is on the face of an image of the remainder map is on the face of a dart of bd.
(def-fns _ $ (erased outer-hd-out : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br) (erased (List (Bond)) gf)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Graph d f gf) grf) (erased (Nat) xd x y yr) (erased (Conn gf x y) c)
    (erased (Nth (Nat) hd xd x) hx) (erased (Nth (Nat) hr yr y) hy) -> (erased (Fband fd bd xd) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hd2))
  (let ((erased gfd) (erased grfd)) (perm-graph dd fd fdi pmfd))
  (let-match erased (band-dec dd xd fd fdi bd gfd pmfd grfd (respects-under hd bd bG dd rbd lhd) (nth-lt-length _ hd xd dd x hx lhd)) (OrL _ _ fb)
    (absurd (OrR _ _ kx)
      (let-match erased kx (MkKernel _ _ lab ls _ l rf rp pl out))
      (let ((erased ws) (erased w)) (conn-path d x y f fi gf pmf grf c))
      (let ((erased yd) (erased ys) (erased hyd) (erased py) (erased w2)) (kernel-lift d dd dr e n f ed nd fd er nr fr hd hr bd br lab ls (Nil _) ws pt rf rp x y xd l w hx pl out))
      (let ((erased oyd)) (match erased (in-dec yd bd) (((NotIn yd bd) r))
        (absurd (OrL _ _ ib) (apart-irrefl l (notin-in l l ls out (in-map lab bd ls yd l ib rp py))))
        ((OrR _ _ o) o)))
      (apart-irrefl y (notin-in y y hr (disk-notin-r d yd y hd hr bd ids pp io dhd uhd hyd oyd) (nth-in hr yr y hy)))))
  fb)

; x and y on the edge cycle r are not neighbours on it (y is not e x and x is not e y), and from a dart on the face of x an edge step
; reaches the face of y: a chord of r (Gonthier's ~~ chordless r, for r an edge cycle, where next r x is e x).
(def-adts $ (Chord : ((List (Nat)) e f r) -> Type)
  enum
  (many MkChord : (erased (List (Nat)) e f r) (erased (Nat) x y z w ex ey) (erased (In x r) ix) (erased (In y r) iy)
      (erased (SomePath f (Nil (Nat)) x z) fz) (erased (Nth (Nat) e z w) ez) (erased (SomePath f (Nil (Nat)) w y) fy)
      (erased (Nth (Nat) e x ex) px) (erased (Nth (Nat) e y ey) py) (erased (Apart (Nat) Lt y ex) n1) (erased (Apart (Nat) Lt x ey) n2)
      -> (Chord e f r)))

; No dart of the remainder map is on the face of its edge image when the remainder map is bridgeless: an edge step from an image of
; hr does not stay on its face.
(def-fns _ $ (erased absurd r-nobridge : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br) (erased (List (Bond)) gf)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Bridgeless dr er nr fr) blr) (erased (Graph d f gf) grf) (erased (Nat) xr x y)
    (erased (Nth (Nat) hr xr x) hx) (erased (Nth (Nat) e x y) pe) (erased (Conn gf x y) c) -> (erased (False) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nfr) (erased nri) (erased fri) (erased rnfr) (erased pmer) (erased pmnr) (erased pmfr)) (hyper-core dr er nr fr hr2))
  (let-match erased blr (MkBridgeless _ _ _ _ ger gfr per pfr spr))
  (let ((erased lxr)) (nth-lt-length _ hr xr dr x hx lhr))
  (let ((erased exr) (erased pexr) (erased lexr)) (perm-nth dr xr er nfr pmer lxr))
  (let ((erased w) (erased hw) (erased pew)) (morph hr er e (Nil _) idr dr xr exr x mer ior lxr (NotInNil xr) pexr hx))
  (let-match erased (nth-fn _ e x w y pew pe) (Refl _ _))
  (sep-conn gfr xr exr (allsep-adj gfr ger xr exr (graph-adj dr xr exr er ger per pexr) spr)
    (patch-face-r-pull d dd dr e n f ed nd fd er nr fr hd hr bd br gf gfr pt grf pfr xr exr x y c hx hw)))

; Two consecutive darts a, e a = b of bd have their images on different faces when the remainder map is bridgeless: with hd b = hr u
; and hd a = hr (n u), u and its node step are on one face of the remainder map, so n u is on the face of its edge image.
(def-fns _ $ (erased absurd ring-nobridge : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br) (erased (List (Bond)) gf)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Bridgeless dr er nr fr) blr) (erased (Graph d f gf) grf) (erased (Nat) a b va vb)
    (erased (In b bd) ib) (erased (Nth (Nat) ed a b) pab) (erased (Nth (Nat) hd a va) ha) (erased (Nth (Nat) hd b vb) hb) (erased (Conn gf va vb) c)
    -> (erased (False) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hd2))
  (let ((erased nfr) (erased nri) (erased fri) (erased rnfr) (erased pmer) (erased pmnr) (erased pmfr)) (hyper-core dr er nr fr hr2))
  (let-match erased blr (MkBridgeless _ _ _ _ ger gfr per pfr spr))
  (let ((erased ur) (erased iur) (erased pur)) (respects-in hr br bGr vb rbr (revapp-in bG (Nil _) bGr vb rv (OrL _ _ (in-map hd bd bG b vb ib rbd hb)))))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth dr ur nr nri pmnr (nth-lt-length _ hr ur dr vb pur lhr)))
  (let ((erased v) (erased hv)) (nth-exists _ hr dr u lhr lu))
  (let ((erased a2) (erased b2) (erased pe2) (erased hb2) (erased ha2)) (ring-pair ur u vb v hd hr ed nr bd br bG bGr cyd cyr rbd rbr rv iur pu pur hv))
  (let-match erased (distinct-nth hd b2 b vb dhd hb2 hb) (Refl _ _))
  (let-match erased (perm-inj dd a2 a b ed nfd pmed pe2 pab) (Refl _ _))
  (let-match erased (nth-fn _ hd a v va ha2 ha) (Refl _ _))
  (let ((erased eu) (erased peu) (erased leu)) (perm-nth dr u er nfr pmer lu))
  (sep-conn gfr u eu (allsep-adj gfr ger u eu (graph-adj dr u eu er ger per peu) spr)
    (conn-cat gfr u ur eu (patch-face-r-pull d dd dr e n f ed nd fd er nr fr hd hr bd br gf gfr pt grf pfr u ur va vb c hv pur)
      (conn-sym gfr eu ur (conn-adj gfr eu ur (graph-adj dr eu ur fr gfr pfr (hyper-third dr eu u ur er nr fr hr2 peu pu)))))))

; An edge step x, y of the whole map that stays on its face gives a chord of bd, when both parts are bridgeless.
(def-fns _ $ (erased bridge-chord : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br) (erased (List (Bond)) gf)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Bridgeless dd ed nd fd) bld) (erased (Bridgeless dr er nr fr) blr)
    (erased (Graph d f gf) grf) (erased (Nat) x y) (erased (Lt x d) lx) (erased (Nth (Nat) e x y) pe) (erased (Conn gf x y) c) -> (erased (Chord ed fd bd) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hd2))
  (let-match erased (parts-at hd hr bd ids x pp (iota-in d x ids io lx)) (PtDisk _ _ _ _ xd px out outr)
    (absurd (PtRing _ _ _ _ xd xr px pin pr) (r-nobridge d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt blr grf xr x y pr pe c))
    (absurd (PtRest _ _ _ _ xr pr outd) (r-nobridge d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt blr grf xr x y pr pe c)))
  (let-match erased bld (MkBridgeless _ _ _ _ ged gfd ped pfd spd))
  (let ((erased lxd)) (nth-lt-length _ hd xd dd x px lhd))
  (let ((erased exd) (erased pexd) (erased lexd)) (perm-nth dd xd ed nfd pmed lxd))
  (let ((erased w) (erased hw) (erased pew)) (morph hd ed e bd idd dd xd exd x med iod lxd out pexd px))
  (let-match erased (nth-fn _ e x w y pew pe) (Refl _ _))
  (let ((erased ubd)) (respects-under hd bd bG dd rbd lhd))
  (let-match erased (band-dec dd xd fd fdi bd gfd pmfd pfd ubd lxd) (OrL _ _ fb)
    (absurd (OrR _ _ kx)
      (sep-conn gfd xd exd (allsep-adj gfd ged xd exd (graph-adj dd xd exd ed ged ped pexd) spd)
        (patch-face-d-pull d dd dr e n f ed nd fd er nr fr hd hr bd br gf gfd pt grf pfd xd exd x y kx c px hw))))
  (let ((erased v) (erased vr) (erased hv) (erased cv)) (outer-hd-in d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt grf xd x fb px))
  (let ((erased fb2)) (outer-hd-out d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt grf exd y v vr (conn-cat gf y x v (conn-sym gf x y c) cv) hw hv))
  (let-match erased fb (MkFband _ _ _ yd iyd sp1))
  (let-match erased fb2 (MkFband _ _ _ zd izd sp2))
  (let-match erased sp1 (MkSomePath _ _ ws1 _ _ w1))
  (let-match erased sp2 (MkSomePath _ _ ws2 _ _ w2))
  (let ((erased c1)) (path-graph-conn dd xd yd fd (Nil _) ws1 gfd w1 pfd))
  (let ((erased ws3) (erased w3)) (conn-path dd yd xd fd fdi gfd pmfd pfd (conn-sym gfd xd yd c1)))
  (let ((erased vy) (erased hvy) (erased cy)) (face-push-d d dd dr e n f ed nd fd er nr fr hd hr bd br fdi gf gfd pt pmfd grf pfd lhd xd yd x c1 px))
  (let ((erased vz) (erased hvz) (erased cz))
    (face-push-d d dd dr e n f ed nd fd er nr fr hd hr bd br fdi gf gfd pt pmfd grf pfd lhd exd zd y (path-graph-conn dd exd zd fd (Nil _) ws2 gfd w2 pfd) hw))
  (let ((erased cyz)) (conn-cat gf vy x vz (conn-sym gf x vy cy) (conn-cat gf x y vz c cz)))
  (let ((erased eyd) (erased peyd) (erased leyd)) (perm-nth dd yd ed nfd pmed (under-in bd yd dd ubd iyd)))
  (let ((erased ezd) (erased pezd) (erased lezd)) (perm-nth dd zd ed nfd pmed (under-in bd zd dd ubd izd)))
  (let-match erased (nat-eq zd eyd) (Unequal _ _ _ _ n1)
    (absurd (Equal _ _ _) (ring-nobridge d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt blr grf yd zd vy vz izd peyd hvy hvz cyz)))
  (let-match erased (nat-eq yd ezd) (Unequal _ _ _ _ n2)
    (absurd (Equal _ _ _) (ring-nobridge d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt blr grf zd yd vz vy iyd pezd hvz hvy (conn-sym gf vy vz cyz))))
  (MkChord ed fd bd yd zd xd exd eyd ezd iyd izd (MkSomePath fd (Nil _) ws3 yd xd w3) pexd sp2 peyd pezd n1 n2))

(def-fns _ $ (erased allsep-patch : (erased (Nat) d dd dr kf) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br nf) (erased (List (Bond)) gf g)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Bridgeless dd ed nd fd) bld) (erased (Bridgeless dr er nr fr) blr)
    (erased (Graph d f gf) grf) (erased (Classes gf d kf) cs) (erased (HPerm d e nf) pme) (subterm erased (Fun e g) fn)
    -> (erased (HOr (AllSep gf g) (Chord ed fd bd)) r))
  (let-match erased fn (FunCons _ g1 x y px fn1) ((FunNil _) (OrL _ _ (AllSepNil gf))))
  (let-match erased (allsep-patch d dd dr kf e n f ed nd fd er nr fr hd hr bd br nf gf g1 pt bld blr grf cs pme fn1) (OrL _ _ sp1)
    ((OrR _ _ ch) (OrR _ _ ch)))
  (let ((erased lx)) (pre-lt d x y e nf pme px))
  (let-match erased (classes-dec gf d kf x y cs lx (perm-val d x y e nf pme px)) (OrR _ _ s)
    ((OrL _ _ c) (OrR _ _ (bridge-chord d dd dr e n f ed nd fd er nr fr hd hr bd br gf pt bld blr grf x y lx px c))))
  (OrL _ _ (AllSepCons gf g1 x y s sp1)))

; bridgeless_patch, read constructively: when both parts are bridgeless, the whole map is bridgeless or bd has a chord.
(def-fns _ $ (erased bridgeless-patch : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Bridgeless dd ed nd fd) bld) (erased (Bridgeless dr er nr fr) blr)
    -> (erased (HOr (Bridgeless d e n f) (Chord ed fd bd)) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased ge) (erased pe)) (perm-graph d e nf pme))
  (let ((erased gf) (erased grf)) (perm-graph d f fi pmf))
  (let ((erased kf) (erased cs)) (classes-exists gf d (graph-below d f fi gf (graph-fun d f gf grf) pmf)))
  (let-match erased (allsep-patch d dd dr kf e n f ed nd fd er nr fr hd hr bd br nf gf ge pt bld blr grf cs pme (graph-fun d e ge pe)) (OrL _ _ sp)
    ((OrR _ _ ch) (OrR _ _ ch)))
  (OrL _ _ (MkBridgeless d e n f ge gf pe grf sp)))

; A map with a dart has a class.
(def-fns _ $ (erased classes-pos : (erased (List (Bond)) g) (erased (Nat) d k) (erased (Classes g (Succ d) k) cs) -> (erased (Nat) k1) (erased (Eq (Nat) k (Succ k1)) r))
  (let-match erased cs (MkClasses _ _ _ ids lab rs io ll lr dr fix cl ro))
  (let-match erased io (IotaS _ ids1 _ io1 s))
  (let ((erased x) (erased xs) (erased ex)) (snoc-cons (Nat) d ids1 ids s))
  (let-match erased ex (Refl _ _))
  (let-match erased ro (RootedCons _ _ _ _ _ r pin c rest))
  (let-match erased lr (LengthCons _ _ _ k1 _) (absurd (LengthNil _) pin))
  (values k1 (Refl _ k)))

; patch_connected_r: the remainder map of a connected map is connected, if it has a dart.
(def-fns _ $ (erased patch-connected-r : (erased (Nat) d dd dr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Connected d e n f) cc) (erased (Lt (Zero) dr) lr0) -> (erased (Connected dr er nr fr) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids idd idr bG bGr h hd2 hr2 io iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let-match erased cc (MkConnected _ _ _ _ g gl cs))
  (let ((erased nfd) (erased ndi) (erased fdi) (erased rnfd) (erased pmed) (erased pmnd) (erased pmfd)) (hyper-core dd ed nd fd hd2))
  (let ((erased nfr) (erased nri) (erased fri) (erased rnfr) (erased pmer) (erased pmnr) (erased pmfr)) (hyper-core dr er nr fr hr2))
  (let ((erased ged) (erased pde)) (perm-graph dd ed nfd pmed))
  (let ((erased gnd) (erased pdn)) (perm-graph dd nd ndi pmnd))
  (let ((erased gfd) (erased pdf)) (perm-graph dd fd fdi pmfd))
  (let ((erased ger) (erased pre)) (perm-graph dr er nfr pmer))
  (let ((erased gnr) (erased prn)) (perm-graph dr nr nri pmnr))
  (let ((erased gfr) (erased prf)) (perm-graph dr fr fri pmfr))
  (let ((erased gd) (erased gld)) (glink-exists dd ed nd fd ged gnd gfd pde pdn pdf))
  (let ((erased gr) (erased glr)) (glink-exists dr er nr fr ger gnr gfr pre prn prf))
  (let ((erased kcd) (erased csd)) (classes-exists gd dd (glink-below dd ed nd fd gd hd2 gld)))
  (let ((erased kcr) (erased csr)) (classes-exists gr dr (glink-below dr er nr fr gr hr2 glr)))
  (let ((erased eb) (erased nnd) (erased nnr)) (ring-nonnil d dd dr e n f ed nd fd er nr fr hd hr bd br pt))
  (let ((erased s) (erased a1) (erased a2)) (glink-patch d dd dr (Succ (Zero)) kcd kcr eb e n f ed nd fd er nr fr hd hr bd br g gd gr pt gl cs gld csd glr csr nnd))
  (let-match erased lr0 (LtZ dr1))
  (let ((erased k1) (erased ek1)) (classes-pos gr dr1 kcr csr))
  (let-match erased ek1 (Refl _ _))
  (let-match erased a1 (AddSucc _ _ s1 a0))
  (match erased nnd (((Connected dr er nr fr) r))
    ((NNNil)
      (let-match erased a0 (AddZero _))
      (let-match erased a2 (AddZero _) (absurd (AddSucc _ _ _ a3) (match erased a3 _)))
      (MkConnected dr er nr fr gr glr csr))
    ((NNCons x bd1)
      (let-match erased a0 (AddZero _))
      (let-match erased (respects-under hd bd bG dd rbd lhd) (UnderCons _ _ _ lx _))
      (let ((erased dd1) (erased edd)) (lt-pos x dd lx))
      (let-match erased edd (Refl _ _))
      (let ((erased k2) (erased ek2)) (classes-pos gd dd1 kcd csd))
      (let-match erased ek2 (Refl _ _))
      (let-match erased a2 (AddSucc _ _ _ a3))
      (let-match erased a3 (AddZero _) (absurd (AddSucc _ _ _ a4) (match erased a4 _)))
      (MkConnected dr er nr fr gr glr csr))))

; o and i list, in order, the darts of xs on the face of a dart of t and the others (Gonthier's fband t and its complement, on xs).
(def-adts $ (BandSplit : ((List (Nat)) f t xs o i) -> Type)
  enum
  (many BSNil : (erased (List (Nat)) f t) -> (BandSplit f t (Nil (Nat)) (Nil (Nat)) (Nil (Nat))))
  (many BSIn : (erased (List (Nat)) f t xs o i) (erased (Nat) x) (erased (Fband f t x) p) (erased (BandSplit f t xs o i) rest)
      -> (BandSplit f t (Cons (Nat) x xs) (Cons (Nat) x o) i))
  (many BSOut : (erased (List (Nat)) f t xs o i) (erased (Nat) x) (erased (Kernel f t x) p) (erased (BandSplit f t xs o i) rest)
      -> (BandSplit f t (Cons (Nat) x xs) o (Cons (Nat) x i))))

; No dart is both on the face of a dart of t and on no such face.
(def-fns _ $ (erased absurd fband-kernel : (erased (List (Nat)) f t) (erased (Nat) x) (erased (Fband f t x) fb) (erased (Kernel f t x) kx) -> (erased (False) r))
  (let-match erased fb (MkFband _ _ _ y iy sp))
  (let-match erased sp (MkSomePath _ _ ws _ _ w))
  (let-match erased kx (MkKernel _ _ lab ls _ l rf rp pl out))
  (apart-irrefl l (notin-in l l ls out (in-map lab t ls y l iy rp (path-label f lab (Nil _) ws x y l w rf pl)))))

(def-fns _ $ (erased band-split-fn : (erased (List (Nat)) f t xs o i o2 i2) (subterm erased (BandSplit f t xs o i) b) (erased (BandSplit f t xs o2 i2) b2)
    -> (erased (Eq (List (Nat)) o o2) eo) (erased (Eq (List (Nat)) i i2) ei))
  (match erased b _
    ((BSNil _ _) (let-match erased b2 (BSNil _ _)) (values (Refl _ o) (Refl _ i)))
    ((BSIn _ _ xs1 o1 i1 x p rest)
      (let-match erased b2 (BSIn _ _ _ o3 _ _ p2 rest2) (absurd (BSOut _ _ _ _ i3 _ k2 rest2) (fband-kernel f t x p k2)))
      (let ((erased eo) (erased ei)) (band-split-fn f t xs1 o1 i1 o3 i2 rest rest2))
      (let-match erased eo (Refl _ _))
      (values (Refl _ o) ei))
    ((BSOut _ _ xs1 o1 i1 x p rest)
      (let-match erased b2 (BSOut _ _ _ _ i3 _ p2 rest2) (absurd (BSIn _ _ _ o3 _ _ f2 rest2) (fband-kernel f t x f2 p)))
      (let ((erased eo) (erased ei)) (band-split-fn f t xs1 o1 i1 o2 i3 rest rest2))
      (let-match erased ei (Refl _ _))
      (values eo (Refl _ i)))))

; A split by face classes labelled lab, by whether the class meets t, is a BandSplit.
(def-fns _ $ (erased band-of-sb : (erased (Nat) d) (erased (List (Nat)) f fi t lab rs ids LT xs o i) (erased (List (Bond)) gf) (erased (HPerm d f fi) pm)
    (erased (Graph d f gf) gr) (erased (Iota d ids) io) (erased (Rooted gf rs ids lab) ro) (erased (Respects lab f lab) rf) (erased (Under t d) ut)
    (erased (Respects lab t LT) rt) (erased (Under xs d) ux) (subterm erased (SplitBy lab LT xs o i) sp) -> (erased (BandSplit f t xs o i) r))
  (match erased sp _
    ((SBNil _ _) (BSNil f t))
    ((SBIn _ _ xs1 o1 i1 x l px il sp1)
      (let-match erased ux (UnderCons _ _ _ lx ux1))
      (let ((erased y) (erased iy) (erased py)) (respects-in lab t LT l rt il))
      (let ((erased ws) (erased w)) (conn-path d x y f fi gf pm gr (same-root gf d x y l ids lab rs io ro px py lx (under-in t y d ut iy))))
      (BSIn f t xs1 o1 i1 x (MkFband f t x y iy (MkSomePath f (Nil _) ws x y w)) (band-of-sb d f fi t lab rs ids LT xs1 o1 i1 gf pm gr io ro rf ut rt ux1 sp1)))
    ((SBOut _ _ xs1 o1 i1 x l px o sp1)
      (let-match erased ux (UnderCons _ _ _ lx ux1))
      (BSOut f t xs1 o1 i1 x (MkKernel f t lab LT x l rf rt px o) (band-of-sb d f fi t lab rs ids LT xs1 o1 i1 gf pm gr io ro rf ut rt ux1 sp1)))))

; patch_fcard_face_r: the faces of the remainder map are the faces of the whole map that meet the image of hr, outer, which lists the
; darts 0..d-1 on such faces.
(def-fns _ $ (erased patch-fcard-face-r : (erased (Nat) d dd dr kfr) (erased (List (Nat)) e n f ed nd fd er nr fr hd hr bd br ids) (erased (List (Bond)) gf)
    (erased (Patch d dd dr e n f ed nd fd er nr fr hd hr bd br) pt) (erased (Iota d ids) io) (erased (Graph d f gf) grf) (erased (Orbits dr fr kfr) orr)
    -> (erased (List (Nat)) outer inner) (erased (BandSplit f hr ids outer inner) bs) (erased (ClassesOn gf outer kfr) r))
  (let ((erased pt2)) pt)
  (let-match erased pt2 (MkPatch _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids2 idd idr bG bGr h hd2 hr2 io2 iod ior lhd lhr dhd dhr uhd uhr cyd sd cyr dbr rbd rbr rv pp med mnd mer mnr))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f h))
  (let ((erased nfr) (erased nri) (erased fri) (erased rnfr) (erased pmer) (erased pmnr) (erased pmfr)) (hyper-core dr er nr fr hr2))
  (let-match erased orr (MkOrbits _ _ _ gfr grfr csfr))
  (let ((erased kf) (erased csf)) (classes-exists gf d (graph-below d f fi gf (graph-fun d f gf grf) pmf)))
  (let-match erased csf (MkClasses _ _ _ ids3 labf rsf io3 llf lrf drf fixf clf rof))
  (let-match erased (iota-fn d ids ids3 io io3) (Refl _ _))
  (let ((erased uids)) (perm-under d ids ids (perm-id d ids io)))
  (let ((erased uidr)) (perm-under dr idr idr (perm-id dr idr ior)))
  (let ((erased LH) (erased rlh)) (respects-exists labf hr d uhr llf))
  (let ((erased outer) (erased inner) (erased spo)) (sb-exists labf LH d llf ids uids))
  (let ((erased so)) (sb-split labf LH ids outer inner ids outer inner spo spo (sub-refl outer)))
  (let ((erased souter) (erased sinner)) (split-sub outer ids outer inner so))
  (let ((erased uo)) (sub-under outer ids d souter uids))
  (let ((erased L) (erased hv)) (outer-hitinv d f fi hr labf rsf ids LH outer inner ids gf pmf grf io rof uhr rlh spo uids))
  (let ((erased rff)) (const-respects labf ids f labf gf (graph-zip d f ids gf grf io) clf (respects-id-right d ids labf io llf)))
  (values outer inner (band-of-sb d f fi hr labf rsf ids LH ids outer inner gf pmf grf io rof rff uhr rlh uids spo)
    (co-map gfr gf idr outer hr L kfr d kf (co-of-classes gfr dr kfr idr csfr ior)
      (outer-lift-r d dr f hr L labf ids idr LH outer inner idr gfr hv io llf dhr lhr uhr rlh spo uidr (sub-refl idr))
      (outer-lift-g d dr f fi hr L labf rsf ids idr LH outer inner outer gf hv pmf grf io ior rof dhr lhr uhr rlh spo uo (sub-refl outer))
      (outer-moves-r d dd dr e n f ed nd fd er nr fr hd hr bd br fi fri idr gfr gf pt pmf pmfr grf ior lhr uhr (graph-fun dr fr gfr grfr))
      (outer-moves-g d dd dr e n f ed nd fd er nr fr hd hr bd br fi fri L labf rsf ids LH outer inner gf gf gfr pt hv pmf pmfr grf grfr io rof clf llf dhr lhr uhr rlh spo
        (graph-fun d f gf grf))
      (MkClasses gf d kf ids labf rsf io llf lrf drf fixf clf rof) uo)))

; patch_gcomp: a map is patched, along empty rings, from the darts h of a set closed under its permutations and the others, each
; renumbered by its position in its list.

(def-fns _ $ (erased app-nth : (erased (List (Nat)) pre ys zs) (erased (Nat) y j) (subterm erased (AppN pre (Cons (Nat) y ys) zs) ap) (erased (Length (Nat) pre j) l)
    -> (erased (Nth (Nat) zs j y) r))
  (let-match erased ap (AppCons pre1 _ zs1 a ap1) ((AppNil _) (let-match erased l (LengthNil _)) (NthHere _ y ys)))
  (let-match erased l (LengthCons _ _ _ j1 l1))
  (NthThere _ a zs1 j1 y (app-nth pre1 ys zs1 y j1 ap1 l1)))

(def-fns _ $ (erased app-step : (erased (List (Nat)) pre ys zs) (erased (Nat) y) (subterm erased (AppN pre (Cons (Nat) y ys) zs) ap)
    -> (erased (List (Nat)) pre2) (erased (HSnoc (Nat) pre y pre2) s) (erased (AppN pre2 ys zs) r))
  (let-match erased ap (AppCons pre1 _ zs1 a ap1) ((AppNil _) (values (Cons _ y (Nil _)) (SnocNil _ y) (AppCons (Nil _) ys ys y (AppNil ys)))))
  (let ((erased pre3) (erased s1) (erased r1)) (app-step pre1 ys zs1 y ap1))
  (values (Cons _ a pre3) (SnocCons _ a y pre1 pre3 s1) (AppCons pre3 ys zs1 a r1)))

; pos sends the darts of h to their positions in h: pos . h = 0..k-1, read from the position j of the suffix rest of h.
(def-fns _ $ (erased inv-iota : (erased (Nat) d k j m) (erased (List (Nat)) h ids pos idk pre rest P S) (erased (InvL h ids pos) iv) (erased (Distinct h) dh)
    (erased (Iota d ids) io) (erased (Under h d) uh) (erased (Iota k idk) iok) (erased (AppN pre rest h) ap) (erased (Length (Nat) pre j) lp)
    (erased (AppN P S idk) aq) (erased (Length (Nat) P j) lq) (subterm erased (Length (Nat) rest m) lr) (erased (Length (Nat) S m) ls)
    -> (erased (Respects pos rest S) r))
  (let-match erased lr (LengthCons _ x rest1 m1 lr1) ((LengthNil _) (let-match erased ls (LengthNil _)) (RespNil pos)))
  (let-match erased ls (LengthCons _ s S1 _ ls1))
  (let ((erased px)) (app-nth pre rest1 h x j ap lp))
  (let-match erased (iota-at k j s idk iok (app-nth P S1 idk s j aq lq)) (Refl _ _))
  (let ((erased pre2) (erased sp) (erased ap2)) (app-step pre rest1 h x ap))
  (let ((erased P2) (erased sq) (erased aq2)) (app-step P S1 idk j aq))
  (RespCons pos rest1 S1 x j (inv-nth h ids pos x x j iv dh (iota-nth d x ids io (under-nth h j x d uh px)) px)
    (inv-iota d k (Succ j) m1 h ids pos idk pre2 rest1 P2 S1 iv dh io uh iok ap2 (snoc-length _ pre pre2 x j sp lp) aq2 (snoc-length _ P P2 j j sq lq) lr1 ls1)))

; h . pos is the identity on the darts of h.
(def-fns _ $ (erased inv-back : (erased (Nat) d) (erased (List (Nat)) h ids pos xs ys) (erased (InvL h ids pos) iv) (erased (Distinct h) dh) (erased (Iota d ids) io)
    (erased (Under h d) uh) (erased (Sub xs h) sx) (subterm erased (Respects pos xs ys) rp) -> (erased (Respects h ys xs) r))
  (let-match erased rp (RespCons _ xs1 ys1 w j pw rp1) ((RespNil _) (RespNil h)))
  (let-match erased sx (HSubCons _ _ _ iw sx1))
  (let ((erased j2) (erased hw)) (in-nth w h iw))
  (let-match erased (nth-fn _ pos w j j2 pw (inv-nth h ids pos w w j2 iv dh (iota-nth d w ids io (under-nth h j2 w d uh hw)) hw)) (Refl _ _))
  (RespCons h ys1 xs1 j w hw (inv-back d h ids pos xs1 ys1 iv dh io uh sx1 rp1)))

; p sends the darts of xs, in h, into h when h is shut under the bonds of p.
(def-fns _ $ (erased resp-shut : (erased (Nat) d) (erased (List (Nat)) p h xs ys) (erased (List (Bond)) gp) (erased (Graph d p gp) gr) (erased (Shut h gp) sh)
    (erased (Sub xs h) sx) (subterm erased (Respects p xs ys) rp) -> (erased (Sub ys h) r))
  (let-match erased rp (RespCons _ xs1 ys1 x y px rp1) ((RespNil _) (HSubNil h)))
  (let-match erased sx (HSubCons _ _ _ ix sx1))
  (HSubCons y ys1 h (shut-adj-in h gp x y (graph-adj d x y p gp gr px) sh ix) (resp-shut d p h xs1 ys1 gp gr sh sx1 rp1)))

; A set shut under the bonds of a permutation is shut under those of its inverse.
(def-fns _ $ (erased shut-inv : (erased (Nat) d) (erased (List (Nat)) p q h) (erased (List (Bond)) gp g) (erased (HPerm d p q) pm) (erased (Graph d p gp) gr)
    (erased (Shut h gp) sh) (subterm erased (Fun q g) fn) -> (erased (Shut h g) r))
  (let-match erased fn (FunCons _ g1 x y qx fn1) ((FunNil _) (ShutNil h)))
  (let ((erased rest)) (shut-inv d p q h gp g1 pm gr sh fn1))
  (let ((erased a)) (adj-sym gp y x (graph-adj d y x p gp gr (perm-inv d x y q p (perm-sym d p q pm) qx))))
  (match erased (in-dec x h) _
    ((OrL _ _ ix) (ShutIn h g1 x y ix (shut-adj-in h gp x y a sh ix) rest))
    ((OrR _ _ ox) (ShutOut h g1 x y ox (shut-adj-out h gp x y a sh ox) rest))))

(def-fns _ $ (erased morph-of : (erased (Nat) d k) (erased (List (Nat)) h p q pk ph m) (erased (HPerm d p q) pm) (erased (Length (Nat) h k) lh) (erased (Length (Nat) pk k) lk)
    (erased (Under h d) uh) (erased (Respects p h ph) rph) (erased (Respects h pk ph) rk) (subterm erased (Under m k) u) -> (erased (MorphOff h pk p (Nil (Nat)) m) r))
  (let-match erased u (UnderCons m1 i _ li u1) ((UnderNil _) (MONil h pk p (Nil _))))
  (let ((erased z) (erased hz)) (nth-exists _ h k i lh li))
  (let ((erased w) (erased pz) (erased lw)) (perm-nth d z p q pm (under-nth h i z d uh hz)))
  (let ((erased j) (erased pj)) (nth-exists _ pk k i lk li))
  (MOAt h pk p (Nil _) m1 i j z w pj hz (respects-nth h pk ph i j w rk pj (respects-at p h ph i z w rph hz pz)) pz
    (morph-of d k h p q pk ph m1 pm lh lk uh rph rk u1)))

; The restriction pk of a permutation p of 0..d-1 to the darts h, shut under p, renumbered by their positions pos in h, is a
; permutation of 0..k-1 with h (pk i) = p (h i).
(def-fns _ $ (erased sub-perm : (erased (Nat) d k) (erased (List (Nat)) p q h ids pos idk) (erased (List (Bond)) gp gq) (erased (HPerm d p q) pm)
    (erased (Graph d p gp) grp) (erased (Graph d q gq) grq) (erased (Shut h gp) shp) (erased (Shut h gq) shq) (erased (Iota d ids) io) (erased (Iota k idk) iok)
    (erased (Distinct h) dh) (erased (Length (Nat) h k) lh) (erased (Under h d) uh) (erased (InvL h ids pos) iv) (erased (Length (Nat) pos d) lpos)
    -> (erased (List (Nat)) pk qk) (erased (HPerm k pk qk) pmk) (erased (MorphOff h pk p (Nil (Nat)) idk) mp) (erased (MorphOff h qk q (Nil (Nat)) idk) mq))
  (let ((erased pmq)) (perm-sym d p q pm))
  (let-match erased pm (HMkPerm _ _ _ ids2 io2 lp qp pq))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased lq)) (perm-length d q p pmq))
  (let ((erased ph) (erased rph)) (respects-exists p h d uh lp))
  (let ((erased qh) (erased rqh)) (respects-exists q h d uh lq))
  (let ((erased pk) (erased rpk)) (respects-exists pos ph d (respects-under-vals p h ph d rph (perm-under d p q pm)) lpos))
  (let ((erased qk) (erased rqk)) (respects-exists pos qh d (respects-under-vals q h qh d rqh (perm-under d q p pmq)) lpos))
  (let ((erased lph)) (respects-length p h ph k rph lh))
  (let ((erased lqh)) (respects-length q h qh k rqh lh))
  (let ((erased lpk)) (respects-length pos ph pk k rpk lph))
  (let ((erased lqk)) (respects-length pos qh qk k rqk lqh))
  (let ((erased shh)) (sub-refl h))
  (let ((erased ak)) (inv-back d h ids pos ph pk iv dh io uh (resp-shut d p h h ph gp grp shp shh rph) rpk))
  (let ((erased bk)) (inv-back d h ids pos qh qk iv dh io uh (resp-shut d q h h qh gq grq shq shh rqh) rqk))
  (let ((erased idh)) (respects-id-left d ids h io uh))
  (let ((erased ph-h)) (respects-assoc-inv h p q ph ids h rph idh qp))
  (let ((erased qh-h)) (respects-assoc-inv h q p qh ids h rqh idh pq))
  (let ((erased posh)) (inv-iota d k (Zero) k h ids pos idk (Nil _) h (Nil _) idk iv dh io uh iok (AppNil h) (LengthNil _) (AppNil idk) (LengthNil _) lh (iota-length k idk iok)))
  (let ((erased qkpk)) (respects-assoc pk qh pos h qk idk k (respects-assoc pk h q ph qh h k ak ph-h rqh lqh lh) posh rqk lqk lqh))
  (let ((erased pkqk)) (respects-assoc qk ph pos h pk idk k (respects-assoc qk h p qh ph h k bk qh-h rph lph lh) posh rpk lpk lph))
  (let ((erased uidk)) (perm-under k idk idk (perm-id k idk iok)))
  (values pk qk (HMkPerm k pk qk idk iok lpk qkpk pkqk)
    (morph-of d k h p q pk ph idk pm lh lpk uh rph ak uidk) (morph-of d k h q p qk qh idk pmq lh lqk uh rqh bk uidk)))

(def-fns _ $ (erased morph-e : (erased (Nat) d k) (erased (List (Nat)) e n f h ek nk fk nfk fki idk m) (erased (Hypermap d e n f) hm) (erased (Hypermap k ek nk fk) hk)
    (erased (HPerm k ek nfk) pmek) (erased (HPerm k fk fki) pmfk) (erased (Iota k idk) iok) (erased (Length (Nat) h k) lh)
    (erased (MorphOff h nk n (Nil (Nat)) idk) mn) (erased (MorphOff h fk f (Nil (Nat)) idk) mf) (subterm erased (Under m k) u) -> (erased (MorphOff h ek e (Nil (Nat)) m) r))
  (let-match erased u (UnderCons m1 i _ li u1) ((UnderNil _) (MONil h ek e (Nil _))))
  (let ((erased y) (erased pey) (erased ly)) (perm-nth k i ek nfk pmek li))
  (let ((erased a) (erased pfa) (erased la)) (perm-nth k y fk fki pmfk ly))
  (let ((erased hy) (erased hhy)) (nth-exists _ h k y lh ly))
  (let ((erased w) (erased hw) (erased pfw)) (morph h fk f (Nil _) idk k y a hy mf iok ly (NotInNil y) pfa hhy))
  (let ((erased w2) (erased hw2) (erased pnw)) (morph h nk n (Nil _) idk k a i w mn iok la (NotInNil a) (hyper-node k a y i ek nk fk hk pfa pey) hw))
  (MOAt h ek e (Nil _) m1 i y w2 hy pey hw2 hhy (hyper-edge d w2 w hy e n f hm pnw pfw)
    (morph-e d k e n f h ek nk fk nfk fki idk m1 hm hk pmek pmfk iok lh mn mf u1)))

; The darts h of a set shut under the node and face permutations, renumbered by their positions in h, carry a hypermap whose
; permutations h sends to those of the whole map.
(def-fns _ $ (erased sub-map : (erased (Nat) d k) (erased (List (Nat)) e n f h ids pos idk) (erased (List (Bond)) gn gf) (erased (Hypermap d e n f) hm)
    (erased (Graph d n gn) grn) (erased (Graph d f gf) grf) (erased (Shut h gn) shn) (erased (Shut h gf) shf) (erased (Iota d ids) io) (erased (Iota k idk) iok)
    (erased (Distinct h) dh) (erased (Length (Nat) h k) lh) (erased (Under h d) uh) (erased (InvL h ids pos) iv) (erased (Length (Nat) pos d) lpos)
    -> (erased (List (Nat)) ek nk fk) (erased (Hypermap k ek nk fk) hk) (erased (MorphOff h ek e (Nil (Nat)) idk) me) (erased (MorphOff h nk n (Nil (Nat)) idk) mn))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pme) (erased pmn) (erased pmf)) (hyper-core d e n f hm))
  (let ((erased gni) (erased grni)) (perm-graph d ni n (perm-sym d n ni pmn)))
  (let ((erased gfi) (erased grfi)) (perm-graph d fi f (perm-sym d f fi pmf)))
  (let ((erased nk) (erased nki) (erased pmnk) (erased mn) (erased mni))
    (sub-perm d k n ni h ids pos idk gn gni pmn grn grni shn (shut-inv d n ni h gn gni pmn grn shn (graph-fun d ni gni grni)) io iok dh lh uh iv lpos))
  (let ((erased fk) (erased fki) (erased pmfk) (erased mf) (erased mfi))
    (sub-perm d k f fi h ids pos idk gf gfi pmf grf grfi shf (shut-inv d f fi h gf gfi pmf grf shf (graph-fun d fi gfi grfi)) io iok dh lh uh iv lpos))
  (let ((erased ek) (erased hk)) (hyper-mk k nk nki fk fki pmnk pmfk))
  (let ((erased nfk) (erased nik) (erased fik) (erased rnfk) (erased pmek) (erased pmnk2) (erased pmfk2)) (hyper-core k ek nk fk hk))
  (values ek nk fk hk (morph-e d k e n f h ek nk fk nfk fki idk idk hm hk pmek pmfk iok lh mn mf (perm-under k idk idk (perm-id k idk iok))) mn))
