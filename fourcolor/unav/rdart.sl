; Darts around a hub named by their face and their place on it, for the certified redpart of redc.sl. The face of a
; name is the hub, a spoke, a hat or a fan face of a sector; a place counts steps of face from that face's base dart
; (DF) or back to it (DB). Edge is read off a table of base darts, or through e = f e f e f and e = f' e f' e f' with
; f' the inverse of face, which plain cubic maps appear to satisfy. Load after qfit.sl.

(def-fns _ $ (erased f-pre : (erased (Nat) d y) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt y d) ly)
    -> (erased (Nat) u) (erased (Nth (Nat) f u y) pu) (erased (Lt u d) lu))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth d y fi f (perm-sym d f fi pf) ly))
  (values u (perm-inv d y u fi f (perm-sym d f fi pf) pu) lu))

(def-fns _ $ (erased n-ef : (erased (Nat) d u y v) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt u d) lu)
    (erased (Nth (Nat) f u y) pf) (erased (Nth (Nat) e u v) pe) -> (erased (Nth (Nat) n y v) r))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (let ((erased pv) (erased _)) (plain-eq d u v e pl lu pe))
  (nfe d v u y e n f h (img-lt d u v e nf qe lu pe) pv pf))

(def-fns _ $ (erased e-rot-a : (erased (Nat) d y y1 a a1 b r) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt y d) ly)
    (erased (Nth (Nat) f y y1) p1) (erased (Nth (Nat) e y1 a) p2) (erased (Nth (Nat) f a a1) p3) (erased (Nth (Nat) e a1 b) p4)
    (erased (Nth (Nat) f b r) p5) -> (erased (Nth (Nat) e y r) q))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (let ((erased l1)) (img-lt d y y1 f fi qf ly p1))
  (let ((erased l2)) (img-lt d y1 a e nf qe l1 p2))
  (let ((erased l3)) (img-lt d a a1 f fi qf l2 p3))
  (let ((erased l4)) (img-lt d a1 b e nf qe l3 p4))
  (let ((erased l5)) (img-lt d b r f fi qf l4 p5))
  (let ((erased n1)) (nfe d y1 a a1 e n f h l1 p2 p3))
  (let ((erased n2)) (nfe d a1 b r e n f h l3 p4 p5))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d r a1 n cu l5 n2))
  (let-match erased (nth-fn _ n a1 y1 z n1 pz) (Refl _ _))
  (let ((erased q) (erased _)) (plain-eq d r y e pl l5 (enf d y y1 r e n f h ly p1 pz2)))
  q)

(def-fns _ $ (erased e-rot-b : (erased (Nat) d y y1 a a1 b r) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt y d) ly)
    (erased (Nth (Nat) f y1 y) p1) (erased (Nth (Nat) e y1 a) p2) (erased (Nth (Nat) f a1 a) p3) (erased (Nth (Nat) e a1 b) p4)
    (erased (Nth (Nat) f r b) p5) -> (erased (Nth (Nat) e y r) q))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (let ((erased l1)) (img-lt-inv d y1 y f fi qf ly p1))
  (let ((erased l2)) (img-lt d y1 a e nf qe l1 p2))
  (let ((erased l3)) (img-lt-inv d a1 a f fi qf l2 p3))
  (let ((erased l4)) (img-lt d a1 b e nf qe l3 p4))
  (let ((erased l5)) (img-lt-inv d r b f fi qf l4 p5))
  (let ((erased c) (erased pc) (erased _)) (perm-nth d r e nf qe l5))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d y a n cu ly (n-ef d y1 y a e n f ks g l1 p1 p2)))
  (let-match erased (nth-fn _ n a b z (n-ef d a1 a b e n f ks g l3 p3 p4) pz) (Refl _ _))
  (let-match erased (nth-fn _ n b c y (n-ef d r b c e n f ks g l5 p5 pc) pz2) (Refl _ _))
  (let ((erased q) (erased _)) (plain-eq d r y e pl l5 pc))
  q)

(def-fns _ $ (erased iter-ex : (erased (Nat) d x) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (subterm erased (Nat) k) (erased (Lt x d) lx)
    -> (erased (Nat) y) (erased (Iter f k x y) it) (erased (Lt y d) ly))
  (let-match erased k (Succ k1) ((Zero) (values x (ItZ f x) lx)))
  (let ((erased x1) (erased p1) (erased l1)) (perm-nth d x f fi pf lx))
  (let ((erased y) (erased it) (erased ly)) (iter-ex d x1 f fi pf k1 l1))
  (values y (ItS f k1 x x1 y p1 it) ly))

(def-fns _ $ (erased iter-back : (erased (Nat) d b) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (subterm erased (Nat) k) (erased (Lt b d) lb)
    -> (erased (Nat) y) (erased (Iter f k y b) it) (erased (Lt y d) ly))
  (let-match erased k (Succ k1) ((Zero) (values b (ItZ f b) lb)))
  (let ((erased y1) (erased it1) (erased l1)) (iter-back d b f fi pf k1 lb))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth d y1 fi f (perm-sym d f fi pf) l1))
  (values u (ItS f k1 u y1 b (perm-inv d y1 u fi f (perm-sym d f fi pf) pu) it1) lu))

(def-adts $ (RFace : -> Type)
  enum
  (many FH : -> (RFace))
  (many FS : (many (Nat) j) -> (RFace))
  (many FT : (many (Nat) j) -> (RFace))
  (many FF : (many (Nat) j k) -> (RFace)))

(def-adts $ (RDart : -> Type)
  enum
  (many DF : (many (RFace) i) (many (Nat) k) -> (RDart))
  (many DB : (many (RFace) i) (many (Nat) k) -> (RDart)))

(def-adts $ (RBase : ((List (Nat)) e f) ((Nat) x0) ((RFace) i) ((Nat) b) -> Type)
  enum
  (many RBH : (erased (List (Nat)) e f) (erased (Nat) x0) -> (RBase e f x0 (FH) x0))
  (many RBS : (erased (List (Nat)) e f) (erased (Nat) x0 j y s) (erased (Iter f j x0 y) it) (erased (Nth (Nat) e y s) ps)
      -> (RBase e f x0 (FS j) s))
  (many RBT : (erased (List (Nat)) e f) (erased (Nat) x0 j s w u) (erased (RBase e f x0 (FS j) s) bs) (erased (Iter f 2 s w) it)
      (erased (Nth (Nat) e w u) pu) -> (RBase e f x0 (FT j) u))
  (many RBF : (erased (List (Nat)) e f) (erased (Nat) x0 j k s z u) (erased (RBase e f x0 (FS j) s) bs)
      (erased (Iter f (Succ (Succ (Succ k))) s z) it) (erased (Nth (Nat) e z u) pu) -> (RBase e f x0 (FF j k) u)))

(def-adts $ (RSem : ((List (Nat)) e f) ((Nat) x0) ((RDart) t) ((Nat) y) -> Type)
  enum
  (many RSF : (erased (List (Nat)) e f) (erased (Nat) x0 k b y) (erased (RFace) i) (erased (RBase e f x0 i b) bb) (erased (Iter f k b y) it)
      -> (RSem e f x0 (DF i k) y))
  (many RSB : (erased (List (Nat)) e f) (erased (Nat) x0 k b y) (erased (RFace) i) (erased (RBase e f x0 i b) bb) (erased (Iter f k y b) it)
      -> (RSem e f x0 (DB i k) y)))

(def-fns _ $ (erased spoke-ex : (erased (Nat) d x0 j) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x0 d) lx)
    -> (erased (Nat) s) (erased (RBase e f x0 (FS j) s) r) (erased (Lt s d) ls))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (let ((erased y) (erased it) (erased ly)) (iter-ex d x0 f fi qf j lx))
  (let ((erased s) (erased ps) (erased ls)) (perm-nth d y e nf qe ly))
  (values s (RBS e f x0 j y s it ps) ls))

(def-fns _ $ (erased rbase-ex : (erased (Nat) d x0) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x0 d) lx) (erased (RFace) i)
    -> (erased (Nat) b) (erased (RBase e f x0 i b) r) (erased (Lt b d) lb))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (match erased i _
    ((FH) (values x0 (RBH e f x0) lx))
    ((FS j) (spoke-ex d x0 j e n f h lx))
    ((FT j)
      (let ((erased s) (erased bs) (erased ls)) (spoke-ex d x0 j e n f h lx))
      (let ((erased w) (erased it) (erased lw)) (iter-ex d s f fi qf 2 ls))
      (let ((erased u) (erased pu) (erased lu)) (perm-nth d w e nf qe lw))
      (values u (RBT e f x0 j s w u bs it pu) lu))
    ((FF j k)
      (let ((erased s) (erased bs) (erased ls)) (spoke-ex d x0 j e n f h lx))
      (let ((erased z) (erased it) (erased lz)) (iter-ex d s f fi qf (Succ (Succ (Succ k))) ls))
      (let ((erased u) (erased pu) (erased lu)) (perm-nth d z e nf qe lz))
      (values u (RBF e f x0 j k s z u bs it pu) lu))))

(def-fns _ $ (erased rsem-ex : (erased (Nat) d x0) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x0 d) lx) (erased (RDart) t)
    -> (erased (Nat) y) (erased (RSem e f x0 t y) r) (erased (Lt y d) ly))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (match erased t _
    ((DF i k)
      (let ((erased b) (erased bb) (erased lb)) (rbase-ex d x0 e n f h lx i))
      (let ((erased y) (erased it) (erased ly)) (iter-ex d b f fi qf k lb))
      (values y (RSF e f x0 k b y i bb it) ly))
    ((DB i k)
      (let ((erased b) (erased bb) (erased lb)) (rbase-ex d x0 e n f h lx i))
      (let ((erased y) (erased it) (erased ly)) (iter-back d b f fi qf k lb))
      (values y (RSB e f x0 k b y i bb it) ly))))

(def-adts $ (RFs : ((RDart) t u) -> Type)
  enum
  (many FsF : (erased (RFace) i) (erased (Nat) k) -> (RFs (DF i k) (DF i (Succ k))))
  (many FsB : (erased (RFace) i) (erased (Nat) k) -> (RFs (DB i (Succ k)) (DB i k)))
  (many FsZ : (erased (RFace) i) -> (RFs (DB i (Zero)) (DF i 1))))

(def-adts $ (RFi : ((RDart) t u) -> Type)
  enum
  (many FiF : (erased (RFace) i) (erased (Nat) k) -> (RFi (DF i (Succ k)) (DF i k)))
  (many FiZ : (erased (RFace) i) -> (RFi (DF i (Zero)) (DB i 1)))
  (many FiB : (erased (RFace) i) (erased (Nat) k) -> (RFi (DB i k) (DB i (Succ k)))))

(def-fns _ $ (many dfs : (many (RDart) t) -> (many (RDart) u) (erased (RFs t u) w))
  (match many t _
    ((DF i k) (values (DF i (Succ k)) (FsF i k)))
    ((DB i k) (match many k _ ((Zero) (values (DF i 1) (FsZ i))) ((Succ k1) (values (DB i k1) (FsB i k1)))))))

(def-fns _ $ (many dfi : (many (RDart) t) -> (many (RDart) u) (erased (RFi t u) w))
  (match many t _
    ((DF i k) (match many k _ ((Zero) (values (DB i 1) (FiZ i))) ((Succ k1) (values (DF i k1) (FiF i k1)))))
    ((DB i k) (values (DB i (Succ k)) (FiB i k)))))

(def-fns _ $ (erased rfs-sound : (erased (List (Nat)) e f) (erased (Nat) x0 y y1) (erased (RDart) t u) (erased (RSem e f x0 t y) s)
    (erased (Nth (Nat) f y y1) py) (erased (RFs t u) r) -> (erased (RSem e f x0 u y1) q))
  (match erased r _
    ((FsF i k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (RSF e f x0 (Succ k) b y1 i bb (iter-add f k 1 (Succ k) b y y1 it (one-step f y y1 py) (add-succ-right k (Zero) k (add-zero-right k)))))
    ((FsB i k)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (let-match erased it (ItS _ _ _ z _ pz it1))
      (let-match erased (nth-fn _ f y y1 z py pz) (Refl _ _))
      (RSB e f x0 k b y1 i bb it1))
    ((FsZ i)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (RSF e f x0 1 b y1 i bb (one-step f y y1 py)))))

(def-fns _ $ (erased rfi-sound : (erased (Nat) d) (erased (List (Nat)) e f fi) (erased (HPerm d f fi) pf) (erased (Nat) x0 y y0) (erased (RDart) t u)
    (erased (RSem e f x0 t y) s) (erased (Nth (Nat) f y0 y) py) (erased (RFi t u) r) -> (erased (RSem e f x0 u y0) q))
  (match erased r _
    ((FiF i k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let ((erased w) (erased i1) (erased i2)) (iter-split f k 1 (Succ k) b y (add-succ-right k (Zero) k (add-zero-right k)) it))
      (let-match erased i2 (ItS _ _ _ w1 _ pw i3))
      (let-match erased i3 (ItZ _ _))
      (let-match erased (perm-inj d w y0 y f fi pf pw py) (Refl _ _))
      (RSF e f x0 k b w i bb i1))
    ((FiZ i)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (RSB e f x0 1 b y0 i bb (one-step f y0 y py)))
    ((FiB i k)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (RSB e f x0 (Succ k) b y0 i bb (ItS f k y0 y b py it)))))

(def-adts $ (RTab : ((RDart) t u) -> Type)
  enum
  (many THS : (erased (Nat) j) -> (RTab (DF (FH) j) (DF (FS j) (Zero))))
  (many TSH : (erased (Nat) j) -> (RTab (DF (FS j) (Zero)) (DF (FH) j)))
  (many TST : (erased (Nat) j) -> (RTab (DF (FS j) 2) (DF (FT j) (Zero))))
  (many TTS : (erased (Nat) j) -> (RTab (DF (FT j) (Zero)) (DF (FS j) 2)))
  (many TSF : (erased (Nat) j k) -> (RTab (DF (FS j) (Succ (Succ (Succ k)))) (DF (FF j k) (Zero))))
  (many TFS : (erased (Nat) j k) -> (RTab (DF (FF j k) (Zero)) (DF (FS j) (Succ (Succ (Succ k)))))))

(def-fns _ $ (erased rtab-sound : (erased (Nat) d x0 y y2) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (RDart) t u)
    (erased (RSem e f x0 t y) s) (erased (Lt y d) ly) (erased (Nth (Nat) e y y2) py) (erased (RTab t u) r) -> (erased (RSem e f x0 u y2) q))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased qe) (erased qn) (erased qf)) (hyper-core d e n f h))
  (let ((erased py2) (erased _)) (plain-eq d y y2 e pl ly py))
  (match erased r _
    ((THS j)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let-match erased bb (RBH _ _ _))
      (RSF e f x0 (Zero) y2 y2 (FS j) (RBS e f x0 j y y2 it py) (ItZ f y2)))
    ((TSH j)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (let-match erased bb (RBS _ _ _ _ y0 _ it0 p0))
      (let-match erased (perm-inj d y2 y0 y e nf qe py2 p0) (Refl _ _))
      (RSF e f x0 j x0 y2 (FH) (RBH e f x0) it0))
    ((TST j)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (RSF e f x0 (Zero) y2 y2 (FT j) (RBT e f x0 j b y y2 bb it py) (ItZ f y2)))
    ((TTS j)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (let-match erased bb (RBT _ _ _ _ s1 w _ bs it2 pu))
      (let-match erased (perm-inj d y2 w y e nf qe py2 pu) (Refl _ _))
      (RSF e f x0 2 s1 y2 (FS j) bs it2))
    ((TSF j k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (RSF e f x0 (Zero) y2 y2 (FF j k) (RBF e f x0 j k b y y2 bb it py) (ItZ f y2)))
    ((TFS j k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (let-match erased bb (RBF _ _ _ _ _ s1 z _ bs it2 pu))
      (let-match erased (perm-inj d y2 z y e nf qe py2 pu) (Refl _ _))
      (RSF e f x0 (Succ (Succ (Succ k))) s1 y2 (FS j) bs it2))))
