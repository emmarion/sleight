(def-fns _ $ (erased f-pre : (erased (Nat) d y) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt y d) ly)
    -> (erased (Nat) u) (erased (Nth (Nat) f u y) pu) (erased (Lt u d) lu))
  (let ((erased _) (erased _) (erased fi) (erased _) (erased _) (erased _) (erased pf)) (hyper-core d e n f h))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth d y fi f (perm-sym d f fi pf) ly))
  (values u (perm-inv d y u fi f (perm-sym d f fi pf) pu) lu))

(def-fns _ $ (erased n-ef : (erased (Nat) d u y v) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt u d) lu)
    (erased (Nth (Nat) f u y) pf) (erased (Nth (Nat) e u v) pe) -> (erased (Nth (Nat) n y v) r))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased _) (erased _) (erased _) (erased qe) (erased _) (erased _)) (hyper-core d e n f h))
  (let ((erased pv) (erased _)) (plain-eq d u v e pl lu pe))
  (nfe d v u y e n f h (img-lt d u v e nf qe lu pe) pv pf))

(def-fns _ $ (erased e-rot-a : (erased (Nat) d y y1 a a1 b r) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt y d) ly)
    (erased (Nth (Nat) f y y1) p1) (erased (Nth (Nat) e y1 a) p2) (erased (Nth (Nat) f a a1) p3) (erased (Nth (Nat) e a1 b) p4)
    (erased (Nth (Nat) f b r) p5) -> (erased (Nth (Nat) e y r) q))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased qe) (erased _) (erased qf)) (hyper-core d e n f h))
  (let ((erased l1)) (img-lt d y y1 f fi qf ly p1))
  (let ((erased l2)) (img-lt d y1 a e nf qe l1 p2))
  (let ((erased l3)) (img-lt d a a1 f fi qf l2 p3))
  (let ((erased l4)) (img-lt d a1 b e nf qe l3 p4))
  (let ((erased l5)) (img-lt d b r f fi qf l4 p5))
  (let ((erased n1)) (nfe d y1 a a1 e n f h l1 p2 p3))
  (let ((erased n2)) (nfe d a1 b r e n f h l3 p4 p5))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d r a1 n cu l5 n2))
  (let-match erased (nth-fn _ n a1 y1 z n1 pz) (Refl _ _))
  (let ((erased q) (erased _)) (plain-eq d r y e pl l5 (enf d y y1 r e n f h ly p1 pz2)))
  q)

(def-fns _ $ (erased e-rot-b : (erased (Nat) d y y1 a a1 b r) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt y d) ly)
    (erased (Nth (Nat) f y1 y) p1) (erased (Nth (Nat) e y1 a) p2) (erased (Nth (Nat) f a1 a) p3) (erased (Nth (Nat) e a1 b) p4)
    (erased (Nth (Nat) f r b) p5) -> (erased (Nth (Nat) e y r) q))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased qe) (erased _) (erased qf)) (hyper-core d e n f h))
  (let ((erased l1)) (img-lt-inv d y1 y f fi qf ly p1))
  (let ((erased l2)) (img-lt d y1 a e nf qe l1 p2))
  (let ((erased l3)) (img-lt-inv d a1 a f fi qf l2 p3))
  (let ((erased l4)) (img-lt d a1 b e nf qe l3 p4))
  (let ((erased l5)) (img-lt-inv d r b f fi qf l4 p5))
  (let ((erased c) (erased pc) (erased _)) (perm-nth d r e nf qe l5))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d y a n cu ly (n-ef d y1 y a e n f ks g l1 p1 p2)))
  (let-match erased (nth-fn _ n a b z (n-ef d a1 a b e n f ks g l3 p3 p4) pz) (Refl _ _))
  (let-match erased (nth-fn _ n b c y (n-ef d r b c e n f ks g l5 p5 pc) pz2) (Refl _ _))
  (let ((erased q) (erased _)) (plain-eq d r y e pl l5 pc))
  q)

(def-fns _ $ (erased iter-ex : (erased (Nat) d x) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (subterm erased (Nat) k) (erased (Lt x d) lx)
    -> (erased (Nat) y) (erased (Iter f k x y) it) (erased (Lt y d) ly))
  (let-match erased k (Succ k1) ((Zero) (values x (ItZ f x) lx)))
  (let ((erased x1) (erased p1) (erased l1)) (perm-nth d x f fi pf lx))
  (let ((erased y) (erased it) (erased ly)) (iter-ex d x1 f fi pf k1 l1))
  (values y (ItS f k1 x x1 y p1 it) ly))

(def-fns _ $ (erased iter-back : (erased (Nat) d b) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (subterm erased (Nat) k) (erased (Lt b d) lb)
    -> (erased (Nat) y) (erased (Iter f k y b) it) (erased (Lt y d) ly))
  (let-match erased k (Succ k1) ((Zero) (values b (ItZ f b) lb)))
  (let ((erased y1) (erased it1) (erased l1)) (iter-back d b f fi pf k1 lb))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth d y1 fi f (perm-sym d f fi pf) l1))
  (values u (ItS f k1 u y1 b (perm-inv d y1 u fi f (perm-sym d f fi pf) pu) it1) lu))

(def-adts $ (RFace : -> Type)
  enum
  (many FH : -> (RFace))
  (many FS : (many (Nat) j) -> (RFace))
  (many FT : (many (Nat) j) -> (RFace))
  (many FF : (many (Nat) j k) -> (RFace)))

(def-adts $ (RDart : -> Type)
  enum
  (many DF : (many (RFace) i) (many (Nat) k) -> (RDart))
  (many DB : (many (RFace) i) (many (Nat) k) -> (RDart)))

(def-adts $ (RBase : ((List (Nat)) e f) ((Nat) x0) ((RFace) i) ((Nat) b) -> Type)
  enum
  (many RBH : (erased (List (Nat)) e f) (erased (Nat) x0) -> (RBase e f x0 (FH) x0))
  (many RBS : (erased (List (Nat)) e f) (erased (Nat) x0 j y s) (erased (Iter f j x0 y) it) (erased (Nth (Nat) e y s) ps)
      -> (RBase e f x0 (FS j) s))
  (many RBT : (erased (List (Nat)) e f) (erased (Nat) x0 j s w u) (erased (RBase e f x0 (FS j) s) bs) (erased (Iter f 2 s w) it)
      (erased (Nth (Nat) e w u) pu) -> (RBase e f x0 (FT j) u))
  (many RBF : (erased (List (Nat)) e f) (erased (Nat) x0 j k s z u) (erased (RBase e f x0 (FS j) s) bs)
      (erased (Iter f (Succ (Succ (Succ k))) s z) it) (erased (Nth (Nat) e z u) pu) -> (RBase e f x0 (FF j k) u)))

(def-adts $ (RSem : ((List (Nat)) e f) ((Nat) x0) ((RDart) t) ((Nat) y) -> Type)
  enum
  (many RSF : (erased (List (Nat)) e f) (erased (Nat) x0 k b y) (erased (RFace) i) (erased (RBase e f x0 i b) bb) (erased (Iter f k b y) it)
      -> (RSem e f x0 (DF i k) y))
  (many RSB : (erased (List (Nat)) e f) (erased (Nat) x0 k b y) (erased (RFace) i) (erased (RBase e f x0 i b) bb) (erased (Iter f k y b) it)
      -> (RSem e f x0 (DB i k) y)))

(def-fns _ $ (erased spoke-ex : (erased (Nat) d x0 j) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x0 d) lx)
    -> (erased (Nat) s) (erased (RBase e f x0 (FS j) s) r) (erased (Lt s d) ls))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased qe) (erased _) (erased qf)) (hyper-core d e n f h))
  (let ((erased y) (erased it) (erased ly)) (iter-ex d x0 f fi qf j lx))
  (let ((erased s) (erased ps) (erased ls)) (perm-nth d y e nf qe ly))
  (values s (RBS e f x0 j y s it ps) ls))

(def-fns _ $ (erased rbase-ex : (erased (Nat) d x0) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x0 d) lx) (erased (RFace) i)
    -> (erased (Nat) b) (erased (RBase e f x0 i b) r) (erased (Lt b d) lb))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased qe) (erased _) (erased qf)) (hyper-core d e n f h))
  (match erased i _
    ((FH) (values x0 (RBH e f x0) lx))
    ((FS j) (spoke-ex d x0 j e n f h lx))
    ((FT j)
      (let ((erased s) (erased bs) (erased ls)) (spoke-ex d x0 j e n f h lx))
      (let ((erased w) (erased it) (erased lw)) (iter-ex d s f fi qf 2 ls))
      (let ((erased u) (erased pu) (erased lu)) (perm-nth d w e nf qe lw))
      (values u (RBT e f x0 j s w u bs it pu) lu))
    ((FF j k)
      (let ((erased s) (erased bs) (erased ls)) (spoke-ex d x0 j e n f h lx))
      (let ((erased z) (erased it) (erased lz)) (iter-ex d s f fi qf (Succ (Succ (Succ k))) ls))
      (let ((erased u) (erased pu) (erased lu)) (perm-nth d z e nf qe lz))
      (values u (RBF e f x0 j k s z u bs it pu) lu))))

(def-fns _ $ (erased rsem-ex : (erased (Nat) d x0) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x0 d) lx) (erased (RDart) t)
    -> (erased (Nat) y) (erased (RSem e f x0 t y) r) (erased (Lt y d) ly))
  (let ((erased _) (erased _) (erased fi) (erased _) (erased _) (erased _) (erased qf)) (hyper-core d e n f h))
  (match erased t _
    ((DF i k)
      (let ((erased b) (erased bb) (erased lb)) (rbase-ex d x0 e n f h lx i))
      (let ((erased y) (erased it) (erased ly)) (iter-ex d b f fi qf k lb))
      (values y (RSF e f x0 k b y i bb it) ly))
    ((DB i k)
      (let ((erased b) (erased bb) (erased lb)) (rbase-ex d x0 e n f h lx i))
      (let ((erased y) (erased it) (erased ly)) (iter-back d b f fi qf k lb))
      (values y (RSB e f x0 k b y i bb it) ly))))

(def-adts $ (RFs : ((RDart) t u) -> Type)
  enum
  (many FsF : (erased (RFace) i) (erased (Nat) k) -> (RFs (DF i k) (DF i (Succ k))))
  (many FsB : (erased (RFace) i) (erased (Nat) k) -> (RFs (DB i (Succ (Succ k))) (DB i (Succ k))))
  (many FsOne : (erased (RFace) i) -> (RFs (DB i 1) (DF i (Zero))))
  (many FsZ : (erased (RFace) i) -> (RFs (DB i (Zero)) (DF i 1))))

(def-adts $ (RFi : ((RDart) t u) -> Type)
  enum
  (many FiF : (erased (RFace) i) (erased (Nat) k) -> (RFi (DF i (Succ k)) (DF i k)))
  (many FiZ : (erased (RFace) i) -> (RFi (DF i (Zero)) (DB i 1)))
  (many FiB : (erased (RFace) i) (erased (Nat) k) -> (RFi (DB i k) (DB i (Succ k)))))

(def-fns _ $ (many dfs : (many (RDart) t) -> (many (RDart) u) (erased (RFs t u) w))
  (let-match many t (DB i k)
    ((DF i k) (values (DF i (Succ k)) (FsF i k))))
  (let-match many k (Succ k1) ((Zero) (values (DF i 1) (FsZ i))))
  (match many k1 _ ((Zero) (values (DF i (Zero)) (FsOne i))) ((Succ k2) (values (DB i k1) (FsB i k2)))))

(def-fns _ $ (many dfi : (many (RDart) t) -> (many (RDart) u) (erased (RFi t u) w))
  (let-match many t (DF i k)
    ((DB i k) (values (DB i (Succ k)) (FiB i k))))
  (match many k _ ((Zero) (values (DB i 1) (FiZ i))) ((Succ k1) (values (DF i k1) (FiF i k1)))))

(def-fns _ $ (erased rfs-sound : (erased (List (Nat)) e f) (erased (Nat) x0 y y1) (erased (RDart) t u) (erased (RSem e f x0 t y) s)
    (erased (Nth (Nat) f y y1) py) (erased (RFs t u) r) -> (erased (RSem e f x0 u y1) q))
  (match erased r _
    ((FsF i k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (RSF e f x0 (Succ k) b y1 i bb (iter-add f k 1 (Succ k) b y y1 it (one-step f y y1 py) (add-succ-right k (Zero) k (add-zero-right k)))))
    ((FsB i k)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (let-match erased it (ItS _ _ _ z _ pz it1))
      (let-match erased (nth-fn _ f y y1 z py pz) (Refl _ _))
      (RSB e f x0 (Succ k) b y1 i bb it1))
    ((FsOne i)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (let-match erased it (ItS _ _ _ z _ pz it1))
      (let-match erased it1 (ItZ _ _))
      (let-match erased (nth-fn _ f y y1 z py pz) (Refl _ _))
      (RSF e f x0 (Zero) b y1 i bb (ItZ f y1)))
    ((FsZ i)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (RSF e f x0 1 b y1 i bb (one-step f y y1 py)))))

(def-fns _ $ (erased rfi-sound : (erased (Nat) d) (erased (List (Nat)) e f fi) (erased (HPerm d f fi) pf) (erased (Nat) x0 y y0) (erased (RDart) t u)
    (erased (RSem e f x0 t y) s) (erased (Nth (Nat) f y0 y) py) (erased (RFi t u) r) -> (erased (RSem e f x0 u y0) q))
  (match erased r _
    ((FiF i k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let ((erased w) (erased i1) (erased i2)) (iter-split f k 1 (Succ k) b y (add-succ-right k (Zero) k (add-zero-right k)) it))
      (let-match erased i2 (ItS _ _ _ _ _ pw i3))
      (let-match erased i3 (ItZ _ _))
      (let-match erased (perm-inj d w y0 y f fi pf pw py) (Refl _ _))
      (RSF e f x0 k b w i bb i1))
    ((FiZ i)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let-match erased it (ItZ _ _))
      (RSB e f x0 1 b y0 i bb (one-step f y0 y py)))
    ((FiB i k)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (RSB e f x0 (Succ k) b y0 i bb (ItS f k y0 y b py it)))))

(def-adts $ (RTab : ((RDart) t u) -> Type)
  enum
  (many THS : (erased (Nat) j) -> (RTab (DF (FH) j) (DF (FS j) (Zero))))
  (many TSH : (erased (Nat) j) -> (RTab (DF (FS j) (Zero)) (DF (FH) j)))
  (many TST : (erased (Nat) j) -> (RTab (DF (FS j) 2) (DF (FT j) (Zero))))
  (many TTS : (erased (Nat) j) -> (RTab (DF (FT j) (Zero)) (DF (FS j) 2)))
  (many TSF : (erased (Nat) j k) -> (RTab (DF (FS j) (Succ (Succ (Succ k)))) (DF (FF j k) (Zero))))
  (many TFS : (erased (Nat) j k) -> (RTab (DF (FF j k) (Zero)) (DF (FS j) (Succ (Succ (Succ k)))))))

(def-fns _ $ (erased rtab-sound : (erased (Nat) d x0 y y2) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (RDart) t u)
    (erased (RSem e f x0 t y) s) (erased (Lt y d) ly) (erased (Nth (Nat) e y y2) py) (erased (RTab t u) r) -> (erased (RSem e f x0 u y2) q))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased _) (erased _) (erased _) (erased qe) (erased _) (erased _)) (hyper-core d e n f h))
  (let ((erased py2) (erased _)) (plain-eq d y y2 e pl ly py))
  (match erased r _
    ((THS j)
      (let-match erased s (RSF _ _ _ _ _ _ _ bb it))
      (let-match erased bb (RBH _ _ _))
      (RSF e f x0 (Zero) y2 y2 (FS j) (RBS e f x0 j y y2 it py) (ItZ f y2)))
    ((TSH j)
      (let-match erased s (RSF _ _ _ _ _ _ _ bb it))
      (let-match erased it (ItZ _ _))
      (let-match erased bb (RBS _ _ _ _ y0 _ it0 p0))
      (let-match erased (perm-inj d y2 y0 y e nf qe py2 p0) (Refl _ _))
      (RSF e f x0 j x0 y2 (FH) (RBH e f x0) it0))
    ((TST j)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (RSF e f x0 (Zero) y2 y2 (FT j) (RBT e f x0 j b y y2 bb it py) (ItZ f y2)))
    ((TTS j)
      (let-match erased s (RSF _ _ _ _ _ _ _ bb it))
      (let-match erased it (ItZ _ _))
      (let-match erased bb (RBT _ _ _ _ s1 w _ bs it2 pu))
      (let-match erased (perm-inj d y2 w y e nf qe py2 pu) (Refl _ _))
      (RSF e f x0 2 s1 y2 (FS j) bs it2))
    ((TSF j k)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (RSF e f x0 (Zero) y2 y2 (FF j k) (RBF e f x0 j k b y y2 bb it py) (ItZ f y2)))
    ((TFS j k)
      (let-match erased s (RSF _ _ _ _ _ _ _ bb it))
      (let-match erased it (ItZ _ _))
      (let-match erased bb (RBF _ _ _ _ _ s1 z _ bs it2 pu))
      (let-match erased (perm-inj d y2 z y e nf qe py2 pu) (Refl _ _))
      (RSF e f x0 (Succ (Succ (Succ k))) s1 y2 (FS j) bs it2))))

(def-adts $ (SecOf : ((RFace) i) ((Nat) j) -> Type)
  enum
  (many SOS : (erased (Nat) j) -> (SecOf (FS j) j))
  (many SOT : (erased (Nat) j) -> (SecOf (FT j) j))
  (many SOF : (erased (Nat) j k) -> (SecOf (FF j k) j)))

(def-adts $ (SubAt : ((RFace) i) ((Sub) x) ((Rg) r) -> Type)
  enum
  (many SAS : (erased (Nat) j) (erased (Rg) s h) (erased (List (Rg)) fs) -> (SubAt (FS j) (MkSub s h fs) s))
  (many SAT : (erased (Nat) j) (erased (Rg) s h) (erased (List (Rg)) fs) -> (SubAt (FT j) (MkSub s h fs) h))
  (many SAF : (erased (Nat) j k) (erased (Rg) s h r) (erased (List (Rg)) fs) (erased (Nth (Rg) fs k r) p) -> (SubAt (FF j k) (MkSub s h fs) r)))

(def-adts $ (SubSet : ((RFace) i) ((Sub) x) ((Rg) r) ((Sub) y) -> Type)
  enum
  (many SSS : (erased (Nat) j) (erased (Rg) s h r) (erased (List (Rg)) fs) -> (SubSet (FS j) (MkSub s h fs) r (MkSub r h fs)))
  (many SST : (erased (Nat) j) (erased (Rg) s h r) (erased (List (Rg)) fs) -> (SubSet (FT j) (MkSub s h fs) r (MkSub s r fs)))
  (many SSF : (erased (Nat) j k) (erased (Rg) s h r) (erased (List (Rg)) fs fs2) (erased (SetNth (Rg) fs k r fs2) p)
      -> (SubSet (FF j k) (MkSub s h fs) r (MkSub s h fs2))))

(def-adts $ (SecComp : ((RFace) i) ((Sec) o) ((Nat) c) -> Type)
  enum
  (many SCS : (erased (Nat) j a h) (erased (List (Nat)) as) -> (SecComp (FS j) (MkSec a h as) a))
  (many SCT : (erased (Nat) j a h) (erased (List (Nat)) as) -> (SecComp (FT j) (MkSec a h as) h))
  (many SCF : (erased (Nat) j k a h c) (erased (List (Nat)) as) (erased (Nth (Nat) as k c) p) -> (SecComp (FF j k) (MkSec a h as) c)))

(def-adts $ (RRange : ((List (Sub)) p) ((RFace) i) ((Rg) r) -> Type)
  enum
  (many MkRRange : (erased (List (Sub)) p) (erased (RFace) i) (erased (Nat) j) (erased (Sub) x) (erased (Rg) r) (erased (SecOf i j) so)
      (erased (Nth (Sub) p j x) px) (erased (SubAt i x r) sa) -> (RRange p i r)))

(def-adts $ (RNarrow : ((List (Sub)) p) ((RFace) i) ((Rg) r) ((List (Sub)) p2) -> Type)
  enum
  (many MkRNarrow : (erased (List (Sub)) p p2) (erased (RFace) i) (erased (Nat) j) (erased (Sub) x y) (erased (Rg) r) (erased (SecOf i j) so)
      (erased (Nth (Sub) p j x) px) (erased (SubSet i x r y) ss) (erased (SetNth (Sub) p j y p2) sp) -> (RNarrow p i r p2)))

(def-adts $ (RKnown : ((List (Sub)) p) ((RFace) i) ((Nat) a) -> Type)
  enum
  (many KnH : (erased (List (Sub)) p) (erased (Nat) a) (erased (Length (Sub) p a) l) -> (RKnown p (FH) a))
  (many KnR : (erased (List (Sub)) p) (erased (RFace) i) (erased (Nat) a) (erased (RRange p i (MkRg a a)) r) (erased (Lt a 9) l) -> (RKnown p i a)))

(def-fns _ $ (erased pw-back : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) (erased (List A) xs) (erased (List B) ys) (erased (Nat) j)
    (erased B y) (subterm erased (Pw A B R xs ys) w) (erased (Nth B ys j y) py) -> (erased A x) (erased (Nth A xs j x) px) (erased (R x y) r))
  (let-match erased w (PwCons _ _ _ x1 _ xs1 ys1 r1 w1) (absurd (PwNil _ _ _ _) py))
  (let-match erased py (NthThere _ _ _ j1 _ py1) ((NthHere _ _ _) (values x1 (NthHere A x1 xs1) r1)))
  (let ((erased x) (erased px) (erased r)) (pw-back A B R xs1 ys1 j1 y w1 py1))
  (values x (NthThere A x1 xs1 j1 x px) r))

(def-fns _ $ (erased pw-set : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) (erased (List A) xs) (erased (List B) ys ys2) (erased (Nat) j)
    (erased A x) (erased B y) (subterm erased (Pw A B R xs ys) w) (erased (SetNth B ys j y ys2) sp) (erased (Nth A xs j x) px) (erased (R x y) r)
    -> (erased (Pw A B R xs ys2) q))
  (let-match erased w (PwCons _ _ _ x1 y1 xs1 ys1 r1 w1) (absurd (PwNil _ _ _ _) sp))
  (match erased sp _
    ((SetHere _ _ _ _) (let-match erased px (NthHere _ _ _)) (PwCons A B R x1 y xs1 ys1 r w1))
    ((SetThere _ _ _ j1 _ ys3 sp1)
      (let-match erased px (NthThere _ _ _ _ _ px1))
      (PwCons A B R x1 y1 xs1 ys3 r1 (pw-set A B R xs1 ys1 ys3 j1 x y w1 sp1 px1 r)))))

(def-fns _ $ (erased setnth-old : (erased Type A) (erased (List A) xs ys) (erased (Nat) i) (erased A y) (subterm erased (SetNth A xs i y ys) p)
    -> (erased A x) (erased (Nth A xs i x) q))
  (let-match erased p (SetThere _ x0 rest i1 _ rest2 p1)
    ((SetHere _ x _ rest) (values x (NthHere A x rest))))
  (let ((erased x) (erased q)) (setnth-old A rest rest2 i1 y p1))
  (values x (NthThere A x0 rest i1 x q)))

(def-fns _ $ (erased obs-nth : (erased (List (Nat)) e f ks) (erased (Nat) y na j) (erased (List (Sec)) os) (erased (Sec) o)
    (subterm erased (ObsAt e f ks y na os) ob) (erased (Nth (Sec) os j o) po) -> (erased (Nat) z) (erased (Iter f j y z) it) (erased (SecAt e f ks z o) so))
  (let-match erased ob (OACons _ _ _ _ y1 n1 _ os1 so1 py ob1) (absurd (OANil _ _ _ _) po))
  (let-match erased po (NthThere _ _ _ j1 _ po1) ((NthHere _ _ _) (values y (ItZ f y) so1)))
  (let ((erased z) (erased it) (erased so)) (obs-nth e f ks y1 n1 j1 os1 o ob1 po1))
  (values z (ItS f j1 y y1 z py it) so))

(def-fns _ $ (erased fans-nth : (erased (List (Nat)) e f ks fs) (erased (Nat) z m k a) (subterm erased (FansAt e f ks z m fs) fa)
    (erased (Nth (Nat) fs k a) pk) -> (erased (Nat) w u) (erased (Iter f k z w) it) (erased (Nth (Nat) e w u) pu) (erased (Nth (Nat) ks u a) pa))
  (let-match erased fa (FAS _ _ _ _ u1 _ z1 m1 fs1 pu1 pa1 pz fa1) (absurd (FAZ _ _ _ _) pk))
  (let-match erased pk (NthThere _ _ _ k1 _ pk1) ((NthHere _ _ _) (values z u1 (ItZ f z) pu1 pa1)))
  (let ((erased w) (erased u) (erased it) (erased pu) (erased pa)) (fans-nth e f ks fs1 z1 m1 k1 a fa1 pk1))
  (values w u (ItS f k1 z z1 w pz it) pu pa))

(def-fns _ $ (erased spoke-link : (erased (List (Nat)) e f) (erased (Nat) x0 j y s z1) (erased (Iter f j x0 y) it) (erased (Nth (Nat) e y z1) pz)
    (erased (RBase e f x0 (FS j) s) bs) -> (erased (Eq (Nat) s z1) r))
  (let-match erased bs (RBS _ _ _ _ y1 _ it1 ps))
  (let-match erased (iter-fn f j x0 y y1 it it1) (Refl _ _))
  (nth-fn _ e y s z1 ps pz))

(def-fns _ $ (erased face-link : (erased (Nat) x0 na j b c) (erased (List (Nat)) e f ks) (erased (List (Sec)) os) (erased (Sec) o) (erased (Sub) x)
    (erased (Rg) r) (erased (RFace) i) (erased (ObsAt e f ks x0 na os) ob) (erased (Nth (Sec) os j o) po) (erased (FitSec o x) fo)
    (erased (SecOf i j) so) (erased (SubAt i x r) sa) (erased (RBase e f x0 i b) bb) (erased (Nth (Nat) ks b c) pc) -> (erased (SecComp i o c) sc))
  (let ((erased y) (erased it) (erased sat)) (obs-nth e f ks x0 na j os o ob po))
  (let-match erased sat (MkSecAt _ _ _ _ z1 a w u h z3 m fs pz pa pw pu ph p3 _ pfs))
  (match erased so _
    ((SOS _)
      (let-match erased (spoke-link e f x0 j y b z1 it pz bb) (Refl _ _))
      (let-match erased (nth-fn _ ks b c a pc pa) (Refl _ _))
      (SCS j a h fs))
    ((SOT _)
      (let-match erased bb (RBT _ _ _ _ s1 w1 _ bs it2 pu1))
      (let-match erased (spoke-link e f x0 j y s1 z1 it pz bs) (Refl _ _))
      (let-match erased (iter-fn f 2 s1 w1 w it2 pw) (Refl _ _))
      (let-match erased (nth-fn _ e w1 b u pu1 pu) (Refl _ _))
      (let-match erased (nth-fn _ ks b c h pc ph) (Refl _ _))
      (SCT j a h fs))
    ((SOF _ k)
      (let-match erased bb (RBF _ _ _ _ _ s1 z2 _ bs it3 pu1))
      (let-match erased (spoke-link e f x0 j y s1 z1 it pz bs) (Refl _ _))
      (let-match erased fo (MkFitSec _ _ _ _ _ fr _ _ p3f))
      (let-match erased sa (SAF _ _ _ _ r1 _ prk))
      (let ((erased c1) (erased pc1) (erased _)) (pw-back (Nat) (Rg) InRg fs fr k r1 p3f prk))
      (let ((erased ww) (erased uu) (erased itw) (erased puu) (erased pac)) (fans-nth e f ks fs z3 m k c1 pfs pc1))
      (let ((erased it4)) (iter-add f 3 k (Succ (Succ (Succ k))) s1 z3 ww p3 itw
        (AddSucc 2 k (Succ (Succ k)) (AddSucc 1 k (Succ k) (AddSucc (Zero) k k (AddZero k))))))
      (let-match erased (iter-fn f (Succ (Succ (Succ k))) s1 z2 ww it3 it4) (Refl _ _))
      (let-match erased (nth-fn _ e z2 b uu pu1 puu) (Refl _ _))
      (let-match erased (nth-fn _ ks b c c1 pc pac) (Refl _ _))
      (SCF j k a h c fs pc1))))

(def-fns _ $ (erased fitsec-get : (erased (Sec) o) (erased (Sub) x) (erased (Rg) r) (erased (RFace) i) (erased (Nat) c) (erased (FitSec o x) fo)
    (erased (SecComp i o c) sc) (erased (SubAt i x r) sa) -> (erased (InRg c r) q))
  (let-match erased fo (MkFitSec _ _ as _ _ fs p1 p2 p3))
  (match erased sa _
    ((SAS _ _ _ _) (let-match erased sc (SCS _ _ _ _)) p1)
    ((SAT _ _ _ _) (let-match erased sc (SCT _ _ _ _)) p2)
    ((SAF _ k _ _ _ _ prk)
      (let-match erased sc (SCF _ _ _ _ _ _ pck))
      (let ((erased c1) (erased pc1) (erased q1)) (pw-back (Nat) (Rg) InRg as fs k r p3 prk))
      (let-match erased (nth-fn _ as k c c1 pck pc1) (Refl _ _))
      q1)))

(def-fns _ $ (erased fitsec-set : (erased (Sec) o) (erased (Sub) x y) (erased (Rg) r) (erased (RFace) i) (erased (Nat) c) (erased (FitSec o x) fo)
    (erased (SecComp i o c) sc) (erased (SubSet i x r y) ss) (erased (InRg c r) ic) -> (erased (FitSec o y) q))
  (let-match erased fo (MkFitSec a h as s hr fs p1 p2 p3))
  (match erased ss _
    ((SSS _ _ _ _ _) (let-match erased sc (SCS _ _ _ _)) (MkFitSec a h as r hr fs ic p2 p3))
    ((SST _ _ _ _ _) (let-match erased sc (SCT _ _ _ _)) (MkFitSec a h as s r fs p1 ic p3))
    ((SSF _ k _ _ _ _ fs2 sp)
      (let-match erased sc (SCF _ _ _ _ _ _ pck))
      (MkFitSec a h as s hr fs2 p1 p2 (pw-set (Nat) (Rg) InRg as fs fs2 k c r p3 sp pck ic)))))

(def-fns _ $ (erased subset-at : (erased (Sub) x y) (erased (Rg) r) (erased (RFace) i) (erased (SubSet i x r y) ss) -> (erased (Rg) r0) (erased (SubAt i x r0) sa))
  (let-match erased ss (SSF j k s h _ fs fs2 sp)
    ((SSS j s h _ fs) (values s (SAS j s h fs)))
    ((SST j s h _ fs) (values h (SAT j s h fs))))
  (let ((erased r0) (erased p0)) (setnth-old (Rg) fs fs2 k r sp))
  (values r0 (SAF j k s h r0 fs p0)))

(def-fns _ $ (erased face-fit : (erased (Nat) x0 j b c) (erased (List (Nat)) e f ks) (erased (List (Sub)) p) (erased (ExactAt e f ks x0 p) ex)
    (erased (RFace) i) (erased (Sub) x) (erased (Rg) r) (erased (SecOf i j) so) (erased (Nth (Sub) p j x) px) (erased (SubAt i x r) sa)
    (erased (RBase e f x0 i b) bb) (erased (Nth (Nat) ks b c) pc) -> (erased (InRg c r) q))
  (let-match erased ex (MkExactAt _ _ _ _ na os _ _ ob xx))
  (let-match erased xx (MkExact _ _ _ pw _ _))
  (let ((erased o) (erased po) (erased fo)) (pw-back (Sec) (Sub) FitSec os p j x pw px))
  (fitsec-get o x r i c fo (face-link x0 na j b c e f ks os o x r i ob po fo so sa bb pc) sa))

(def-fns _ $ (erased rrange-sound : (erased (Nat) x0 b c) (erased (List (Nat)) e f ks) (erased (List (Sub)) p) (erased (ExactAt e f ks x0 p) ex)
    (erased (RFace) i) (erased (Rg) r) (erased (RRange p i r) rr) (erased (RBase e f x0 i b) bb) (erased (Nth (Nat) ks b c) pc) -> (erased (InRg c r) q))
  (let-match erased rr (MkRRange _ _ j x _ so px sa))
  (face-fit x0 j b c e f ks p ex i x r so px sa bb pc))

(def-fns _ $ (erased rnarrow-sound : (erased (Nat) x0 b c) (erased (List (Nat)) e f ks) (erased (List (Sub)) p p2) (erased (ExactAt e f ks x0 p) ex)
    (erased (RFace) i) (erased (Rg) r) (erased (RNarrow p i r p2) nw) (erased (RBase e f x0 i b) bb) (erased (Nth (Nat) ks b c) pc) (erased (InRg c r) ic)
    -> (erased (ExactAt e f ks x0 p2) q))
  (let-match erased nw (MkRNarrow _ _ _ j x y _ so px ss sp))
  (let-match erased ex (MkExactAt _ _ _ _ na os _ pn ob xx))
  (let-match erased xx (MkExact _ _ nx pw lo lp))
  (let ((erased o) (erased po) (erased fo)) (pw-back (Sec) (Sub) FitSec os p j x pw px))
  (let ((erased r0) (erased sa)) (subset-at x y r i ss))
  (let ((erased fo2)) (fitsec-set o x y r i c fo (face-link x0 na j b c e f ks os o x r0 i ob po fo so sa bb pc) ss ic))
  (MkExactAt e f ks x0 na os p2 pn ob (MkExact os p2 nx (pw-set (Sec) (Sub) FitSec os p p2 j o y pw sp po fo2) lo (setnth-length _ p j nx y p2 sp lp))))

(def-fns _ $ (erased in-single : (erased (Nat) c a) (erased (InRg c (MkRg a a)) ic) (erased (Lt a 9) l) -> (erased (Eq (Nat) c a) r))
  (let-match erased ic (MkInRg _ m _ _ cl l1 u1))
  (let-match erased (le-antisym m a u1 l1) (Refl _ _))
  (match erased cl _
    ((ClLo _ _) (Refl _ c))
    (absurd (ClHi _ _) (lt-irrefl 9 l))))

(def-fns _ $ (erased rknown-sound : (erased (Nat) d x0 b a) (erased (List (Nat)) e n f ks) (erased (List (Sub)) p) (erased (Geo d e n f ks) g)
    (erased (ExactAt e f ks x0 p) ex) (erased (RFace) i) (erased (RKnown p i a) kn) (erased (RBase e f x0 i b) bb) (erased (Lt b d) lb)
    -> (erased (Nth (Nat) ks b a) q))
  (let-match erased g (MkGeo _ _ _ _ _ _ _ _ ol _))
  (match erased kn _
    ((KnH _ _ l)
      (let-match erased bb (RBH _ _ _))
      (let-match erased ex (MkExactAt _ _ _ _ na os _ pn ob xx))
      (let-match erased xx (MkExact _ _ nx _ lo lp))
      (let-match erased (length-fn _ os na nx (obs-len e f ks x0 na os ob) lo) (Refl _ _))
      (let-match erased (length-fn _ p a na l lp) (Refl _ _))
      pn)
    ((KnR _ _ _ rr l)
      (let ((erased c) (erased pc) (erased _)) (arity-at d b f ks ol lb))
      (let-match erased (in-single c a (rrange-sound x0 b c e f ks p ex i (MkRg a a) rr bb pc) l) (Refl _ _))
      pc)))

(def-adts $ (RNorm : ((List (Sub)) p) ((RDart) t u) -> Type)
  enum
  (many NmDB : (erased (List (Sub)) p) (erased (RFace) i) (erased (Nat) a k m) (erased (RKnown p i a) kn) (erased (Add k m a) ad)
      -> (RNorm p (DB i k) (DF i m)))
  (many NmDF : (erased (List (Sub)) p) (erased (RFace) i) (erased (Nat) a k m) (erased (RKnown p i a) kn) (erased (Add a m k) ad)
      -> (RNorm p (DF i k) (DF i m)))
  (many NmFB : (erased (List (Sub)) p) (erased (RFace) i) (erased (Nat) a k m) (erased (RKnown p i a) kn) (erased (Add k m a) ad)
      -> (RNorm p (DF i k) (DB i m))))

(def-fns _ $ (erased rnorm-sound : (erased (Nat) d x0 y) (erased (List (Nat)) e n f ks) (erased (List (Sub)) p) (erased (Geo d e n f ks) g)
    (erased (ExactAt e f ks x0 p) ex) (erased (RDart) t u) (erased (RNorm p t u) nm) (erased (RSem e f x0 t y) s) (erased (Lt y d) ly)
    -> (erased (RSem e f x0 u y) q))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (let ((erased _) (erased _) (erased fi) (erased _) (erased _) (erased _) (erased qf)) (hyper-core d e n f h))
  (match erased nm _
    ((NmDB _ i a k m kn ad)
      (let-match erased s (RSB _ _ _ _ b _ _ bb it))
      (let ((erased lb)) (iter-lt d k y b f fi qf ly it))
      (let ((erased pb)) (rknown-sound d x0 b a e n f ks p g ex i kn bb lb))
      (let ((erased ay) (erased pay) (erased _)) (arity-at d y f ks ol ly))
      (let-match erased (arity-same d y b k ay a e n f ks g ly pay it pb) (Refl _ _))
      (let ((erased w) (erased i1) (erased i2)) (iter-split f k m a y y ad (face-cycle d y a f ks ol ly pay)))
      (let-match erased (iter-fn f k y w b i1 it) (Refl _ _))
      (RSF e f x0 m b y i bb i2))
    ((NmDF _ i a k m kn ad)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let ((erased lb)) (iter-lt-inv d k b y f fi qf ly it))
      (let ((erased w) (erased i1) (erased i2)) (iter-split f a m k b y ad it))
      (let-match erased (iter-fn f a b w b i1 (face-cycle d b a f ks ol lb (rknown-sound d x0 b a e n f ks p g ex i kn bb lb))) (Refl _ _))
      (RSF e f x0 m b y i bb i2))
    ((NmFB _ i a k m kn ad)
      (let-match erased s (RSF _ _ _ _ b _ _ bb it))
      (let ((erased lb)) (iter-lt-inv d k b y f fi qf ly it))
      (let ((erased w) (erased i1) (erased i2)) (iter-split f k m a b b ad (face-cycle d b a f ks ol lb (rknown-sound d x0 b a e n f ks p g ex i kn bb lb))))
      (let-match erased (iter-fn f k b w y i1 it) (Refl _ _))
      (RSB e f x0 m b y i bb i2))))

(def-adts $ (REst : ((List (Sub)) p) ((RDart) t u) -> Type)
  enum
  (many ETab : (erased (List (Sub)) p) (erased (RDart) t u) (erased (RTab t u) r) -> (REst p t u))
  (many ENorm : (erased (List (Sub)) p) (erased (RDart) t t2 u) (erased (RNorm p t t2) nm) (erased (REst p t2 u) r) -> (REst p t u))
  (many EA : (erased (List (Sub)) p) (erased (RDart) t t1 a a1 b u) (erased (RFs t t1) s1) (erased (REst p t1 a) r1) (erased (RFs a a1) s2)
      (erased (REst p a1 b) r2) (erased (RFs b u) s3) -> (REst p t u))
  (many EB : (erased (List (Sub)) p) (erased (RDart) t t1 a a1 b u) (erased (RFi t t1) s1) (erased (REst p t1 a) r1) (erased (RFi a a1) s2)
      (erased (REst p a1 b) r2) (erased (RFi b u) s3) -> (REst p t u)))

(def-fns _ $ (erased rest-sound : (erased (Nat) d x0 y y2) (erased (List (Nat)) e n f ks) (erased (List (Sub)) p) (erased (Geo d e n f ks) g)
    (erased (ExactAt e f ks x0 p) ex) (erased (RDart) t u) (subterm erased (REst p t u) r) (erased (RSem e f x0 t y) s) (erased (Lt y d) ly)
    (erased (Nth (Nat) e y y2) py) -> (erased (RSem e f x0 u y2) q))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased qe) (erased _) (erased qf)) (hyper-core d e n f h))
  (match erased r _
    ((ETab _ _ _ tb) (rtab-sound d x0 y y2 e n f ks g t u s ly py tb))
    ((ENorm _ _ t2 _ nm r1) (rest-sound d x0 y y2 e n f ks p g ex t2 u r1 (rnorm-sound d x0 y e n f ks p g ex t t2 nm s ly) ly py))
    ((EA _ _ t1 a a1 b _ s1 r1 s2 r2 s3)
      (let ((erased y1) (erased p1) (erased l1)) (perm-nth d y f fi qf ly))
      (let ((erased ya) (erased pa) (erased la)) (perm-nth d y1 e nf qe l1))
      (let ((erased sa)) (rest-sound d x0 y1 ya e n f ks p g ex t1 a r1 (rfs-sound e f x0 y y1 t t1 s p1 s1) l1 pa))
      (let ((erased ya1) (erased pa1) (erased la1)) (perm-nth d ya f fi qf la))
      (let ((erased yb) (erased pb) (erased lb)) (perm-nth d ya1 e nf qe la1))
      (let ((erased sb)) (rest-sound d x0 ya1 yb e n f ks p g ex a1 b r2 (rfs-sound e f x0 ya ya1 a a1 sa pa1 s2) la1 pb))
      (let ((erased yr) (erased pr) (erased _)) (perm-nth d yb f fi qf lb))
      (let-match erased (nth-fn _ e y y2 yr py (e-rot-a d y y1 ya ya1 yb yr e n f ks g ly p1 pa pa1 pb pr)) (Refl _ _))
      (rfs-sound e f x0 yb yr b u sb pr s3))
    ((EB _ _ t1 a a1 b _ s1 r1 s2 r2 s3)
      (let ((erased y1) (erased p1) (erased l1)) (f-pre d y e n f h ly))
      (let ((erased ya) (erased pa) (erased la)) (perm-nth d y1 e nf qe l1))
      (let ((erased sa)) (rest-sound d x0 y1 ya e n f ks p g ex t1 a r1 (rfi-sound d e f fi qf x0 y y1 t t1 s p1 s1) l1 pa))
      (let ((erased ya1) (erased pa1) (erased la1)) (f-pre d ya e n f h la))
      (let ((erased yb) (erased pb) (erased lb)) (perm-nth d ya1 e nf qe la1))
      (let ((erased sb)) (rest-sound d x0 ya1 yb e n f ks p g ex a1 b r2 (rfi-sound d e f fi qf x0 ya ya1 a a1 sa pa1 s2) la1 pb))
      (let ((erased yr) (erased pr) (erased _)) (f-pre d yb e n f h lb))
      (let-match erased (nth-fn _ e y y2 yr py (e-rot-b d y y1 ya ya1 yb yr e n f ks g ly p1 pa pa1 pb pr)) (Refl _ _))
      (rfi-sound d e f fi qf x0 yb yr b u sb pr s3))))
