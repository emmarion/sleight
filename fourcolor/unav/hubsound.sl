; hubcap_fit_bound of hubcap.v at a dart of a hypermap: the sector lists of hubcapc.sl's Fam and Counts read off the
; face of a hub dart y, and the hub's bound set against its dscore. The transfers into the hub are bounded through
; TgtAll, a hypothesis over the darts that conv.sl is meant to discharge. Load after pwalk.sl.

(def-fns _ $ (erased iter-inj : (erased (Nat) d k a b z) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (subterm erased (Iter f k a z) p)
    (erased (Iter f k b z) q) -> (erased (Eq (Nat) a b) e))
  (let-match erased p (ItS _ k1 _ a1 _ pa p1) ((ItZ _ _) (let-match erased q (ItZ _ _)) (Refl _ a)))
  (let-match erased q (ItS _ _ _ b1 _ pb q1))
  (let-match erased (iter-inj d k1 a1 b1 z f fi pf p1 q1) (Refl _ _))
  (perm-inj d a b a1 f fi pf pa pb))

(def-fns _ $ (erased iter-comm : (erased (List (Nat)) f) (erased (Nat) a b x y z) (erased (Iter f a x y) p) (erased (Iter f b y z) q)
    -> (erased (Nat) u) (erased (Iter f b x u) r) (erased (Iter f a u z) s))
  (let ((erased c) (erased ac)) (add a b))
  (iter-split f b a c x z (add-comm a b c ac) (iter-add f a b c x y z p q ac)))

(def-fns _ $ (erased iter-snoc : (erased (List (Nat)) f) (erased (Nat) j y z z1) (erased (Iter f j y z) p) (erased (Nth (Nat) f z z1) pz)
    -> (erased (Iter f (Succ j) y z1) r))
  (iter-add f j (Succ (Zero)) (Succ j) y z z1 p (ItS f (Zero) z z1 z1 pz (ItZ f z1)) (add-succ-right j (Zero) j (add-zero-right j))))

; Along a cycle of length n through y, f^a y = f^b y when a = b + n.
(def-fns _ $ (erased iter-mod : (erased (List (Nat)) f) (erased (Nat) n a b y u v) (erased (Iter f n y y) cy) (erased (Iter f a y u) p)
    (erased (Iter f b y v) q) (erased (Add b n a) e) -> (erased (Eq (Nat) u v) r))
  (let ((erased m) (erased p1) (erased p2)) (iter-split f n b a y u (add-comm b n a e) p))
  (let-match erased (iter-fn f n y y m cy p1) (Refl _ _))
  (iter-fn f b y u v p2 q))

(def-fns _ $ (erased monus-add : (erased (Nat) a b r) (erased (Monus a b r) mo) (erased (Lt b (Succ a)) le) -> (erased (Add b r a) e))
  (match erased mo _ ((MoAdd _ _ _ p) p) (absurd (MoNeg _ _ l) (lt-le-absurd a b l le))))

(def-fns _ $ (erased lt-two : (erased (Nat) j) (erased (Lt j 2) l) -> (erased (Or (Eq (Nat) j (Zero)) (Eq (Nat) j 1)) r))
  (let-match erased j (Succ j1) ((Zero) (OrL _ _ (Refl _ (Zero)))))
  (let-match erased l (LtS _ _ l1))
  (let-match erased j1 (Zero) (absurd (Succ j2) (let-match erased l1 (LtS _ _ l2)) l2))
  (OrR _ _ (Refl _ 1)))

; The dart w that the j-th constraint is read at (f^k y, k = j - 2 mod nhub) has f^2 w = f^j y.
(def-fns _ $ (erased shift-f2 : (erased (List (Nat)) f) (erased (Nat) nhub j k y w v z) (erased (Shift nhub j k) sh) (erased (Lt 1 nhub) ln)
    (erased (Iter f nhub y y) cy) (erased (Iter f k y w) pk) (erased (Iter f 2 w v) p2) (erased (Iter f j y z) pj) -> (erased (Eq (Nat) v z) r))
  (match erased sh _
    ((ShLo _ _ _ l mo)
      (let ((erased a)) (monus-add j 2 k mo (LtS 1 j l)))
      (iter-fn f j y v z (iter-add f k 2 j y w v pk p2 (add-comm 2 k j a)) pj))
    ((ShHi _ _ t _ l at mo)
      (let ((erased le)) (le-tr 2 nhub t (LtS 1 nhub ln) (add-le-left nhub j t at)))
      (let ((erased a)) (monus-add t 2 k mo le))
      (iter-mod f nhub t j y v z cy (iter-add f k 2 t y w v pk p2 (add-comm 2 k t a)) pj (add-comm nhub j t at)))))

(def-fns _ $ (erased shift-le : (erased (Nat) nhub j k) (erased (Shift nhub j k) sh) (erased (Lt 1 nhub) ln) (erased (Lt j nhub) lj)
    -> (erased (Lt k (Succ nhub)) r))
  (match erased sh _
    ((ShLo _ _ _ l mo)
      (let ((erased a)) (monus-add j 2 k mo (LtS 1 j l)))
      (lt-weaken k nhub (lt-le-trans k (Succ j) nhub (add-le-right 2 k j a) (LtS j nhub lj))))
    ((ShHi _ _ t _ l at mo)
      (let ((erased a)) (monus-add t 2 k mo (le-tr 2 nhub t (LtS 1 nhub ln) (add-le-left nhub j t at))))
      (let ((erased l1)) (add-lt-left k 2 t (add-comm 2 k t a) (lt-succ 1)))
      (let ((erased t1) (erased a1)) (add nhub 1))
      (let ((erased l2)) (add-le-r nhub j t 1 t1 at a1 l))
      (let-match erased (add-fn nhub 1 t1 (Succ nhub) a1 (add-succ-right nhub (Zero) nhub (add-zero-right nhub))) (Refl _ _))
      (lt-weaken k nhub (lt-pred k nhub (lt-le-trans (Succ k) t (Succ nhub) l1 l2))))))

; oss lists, for j = j0 .. j0 + m - 1, the sector list os rotated by j - 2 mod nhub.
(def-adts $ (OssFrom : ((Nat) nhub) ((List (Sec)) os) ((Nat) j m) ((List (List (Sec))) oss) -> Type)
  enum
  (many OFNil : (erased (Nat) nhub) (erased (List (Sec)) os) (erased (Nat) j) -> (OssFrom nhub os j (Zero) (Nil (List (Sec)))))
  (many OFCons : (erased (Nat) nhub j m k) (erased (List (Sec)) os o) (erased (List (List (Sec))) oss) (erased (Shift nhub j k) sh)
      (erased (Rot (Sec) k os o) ro) (erased (OssFrom nhub os (Succ j) m oss) rest) -> (OssFrom nhub os j (Succ m) (Cons (List (Sec)) o oss))))

(def-fns _ $ (erased oss-exists : (erased (Nat) nhub j) (erased (List (Sec)) os) (subterm erased (Nat) m)
    -> (erased (List (List (Sec))) oss) (erased (OssFrom nhub os j m oss) r))
  (let-match erased m (Succ m1) ((Zero) (values (Nil _) (OFNil nhub os j))))
  (let ((erased k) (erased sh)) (shift-c nhub j))
  (let ((erased o) (erased ro)) (rot-c _ k os))
  (let ((erased oss) (erased r)) (oss-exists nhub (Succ j) os m1))
  (values (Cons _ o oss) (OFCons nhub j m1 k os o oss sh ro r)))

(def-fns _ $ (erased oss-len : (erased (Nat) nhub j m) (erased (List (Sec)) os) (erased (List (List (Sec))) oss) (subterm erased (OssFrom nhub os j m oss) w)
    -> (erased (Length (List (Sec)) oss m) r))
  (let-match erased w (OFCons _ _ m1 _ _ o oss1 _ _ w1) ((OFNil _ _ _) (LengthNil _)))
  (LengthCons _ o oss1 m1 (oss-len nhub (Succ j) m1 os oss1 w1)))

(def-fns _ $ (erased oss-nth : (erased (Nat) nhub j m i) (erased (List (Sec)) os o) (erased (List (List (Sec))) oss) (subterm erased (OssFrom nhub os j m oss) w)
    (erased (Nth (List (Sec)) oss i o) no) -> (erased (Nat) c k) (erased (Add i j c) a) (erased (Shift nhub c k) sh) (erased (Rot (Sec) k os o) ro))
  (let-match erased w (OFCons _ _ m1 k0 _ o0 oss1 sh0 ro0 w1) (absurd (OFNil _ _ _) no))
  (let-match erased no (NthThere _ _ _ i1 _ no1) ((NthHere _ _ _) (values j k0 (AddZero j) sh0 ro0)))
  (let ((erased c) (erased k) (erased a) (erased sh) (erased ro)) (oss-nth nhub (Succ j) m1 i1 os o oss1 w1 no1))
  (values c k (add-shift i1 j c a) sh ro))

; The dart w the sector list o of index j is read at, and z = f^j y = f^2 w.
(def-fns _ $ (erased oss-dart : (erased (Nat) d y nhub j k) (erased (List (Nat)) e n f ks) (erased (List (Sec)) os o) (erased (Geo d e n f ks) g)
    (erased (Lt y d) ly) (erased (Nth (Nat) ks y nhub) pa) (erased (ObsAt e f ks y nhub os) ob) (erased (Lt 1 nhub) ln) (erased (Lt j nhub) lj)
    (erased (Shift nhub j k) sh) (erased (Rot (Sec) k os o) ro)
    -> (erased (Nat) w z) (erased (Iter f k y w) pk) (erased (Lt w d) lw) (erased (Nth (Nat) ks w nhub) pw) (erased (ObsAt e f ks w nhub o) ow)
    (erased (Iter f j y z) pj) (erased (Iter f 2 w z) p2))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased cy)) (face-cycle d y nhub f ks ol ly pa))
  (let ((erased w) (erased pk) (erased ow)) (obs-rot e f ks y nhub k os o ob cy ro (shift-le nhub j k sh ln lj)))
  (let ((erased w2) (erased pk2) (erased lw) (erased pw)) (face-walk d y nhub e n f ks h ol k ly pa))
  (let-match erased (iter-fn f k y w2 w pk2 pk) (Refl _ _))
  (let ((erased z) (erased pj) (erased _)) (iter-exists d y f fi pf j ly))
  (let ((erased v) (erased p2) (erased _)) (iter-exists d w f fi pf 2 lw))
  (let-match erased (shift-f2 f nhub j k y w v z sh ln cy pk p2 pj) (Refl _ _))
  (values w z pk lw pw ow pj p2))

; Two such darts: f^i w1 = w2 when j1 + i = j2 mod nhub.
(def-fns _ $ (erased dart-step : (erased (Nat) d y nhub j1 j2 i c w1 w2 z1 z2) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf)
    (erased (Iter f nhub y y) cy) (erased (Lt w1 d) lw) (erased (Iter f 2 w1 z1) q1) (erased (Iter f j1 y z1) r1) (erased (Iter f 2 w2 z2) q2)
    (erased (Iter f j2 y z2) r2) (erased (Add j1 i c) a) (erased (Or (Eq (Nat) c j2) (Add j2 nhub c)) md) -> (erased (Iter f i w1 w2) r))
  (let ((erased v) (erased pv) (erased lv)) (iter-exists d w1 f fi pf i lw))
  (let ((erased u) (erased pu) (erased _)) (iter-exists d v f fi pf 2 lv))
  (let ((erased u1) (erased s1) (erased s2)) (iter-comm f i 2 w1 v u pv pu))
  (let-match erased (iter-fn f 2 w1 u1 z1 s1 q1) (Refl _ _))
  (let ((erased pc)) (iter-add f j1 i c y z1 u r1 s2 a))
  (let ((erased (Eq (Nat) u z2) eu))
    (match erased md _
      ((OrL _ _ ec) (let-match erased ec (Refl _ _)) (iter-fn f j2 y u z2 pc r2))
      ((OrR _ _ ad) (iter-mod f nhub c j2 y u z2 cy pc r2 ad))))
  (let-match erased eu (Refl _ _))
  (let-match erased (iter-inj d 2 v w2 z2 f fi pf pu q2) (Refl _ _))
  pv)

(def-fns _ $ (erased rot-at : (erased (Nat) d w1 w2 nhub i) (erased (List (Nat)) e n f ks) (erased (List (Sec)) o1 o2) (erased (Geo d e n f ks) g)
    (erased (Lt w1 d) lw) (erased (Nth (Nat) ks w1 nhub) pw) (erased (ObsAt e f ks w1 nhub o1) ob1) (erased (ObsAt e f ks w2 nhub o2) ob2)
    (erased (Iter f i w1 w2) it) (erased (Lt i (Succ nhub)) li) -> (erased (Rot (Sec) i o1 o2) r))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (let ((erased o3) (erased ro)) (rot-c _ i o1))
  (let ((erased z) (erased pz) (erased ob3)) (obs-rot e f ks w1 nhub i o1 o3 ob1 (face-cycle d w1 nhub f ks ol lw pw) ro li))
  (let-match erased (iter-fn f i w1 z w2 pz it) (Refl _ _))
  (let-match erased (obs-fn e f ks w2 nhub o3 o2 ob3 ob2) (Refl _ _))
  ro)

(def-fns _ $ (erased subn-fwd : (erased (Nat) nhub j1 j2 i) (erased (HubSubn nhub j2 j1 i) hs) (erased (Lt j1 nhub) l1)
    -> (erased (Nat) c) (erased (Add j1 i c) a) (erased (Or (Eq (Nat) c j2) (Add j2 nhub c)) md))
  (match erased hs _
    ((HSLe _ _ _ _ l mo) (values j2 (monus-add j2 j1 i mo l) (OrL _ _ (Refl _ j2))))
    ((HSGt _ _ _ t _ l at mo)
      (values t (monus-add t j1 i mo (lt-weaken j1 t (lt-le-trans j1 nhub t l1 (add-le-right j2 nhub t at)))) (OrR _ _ at)))))

(def-fns _ $ (erased subn-le : (erased (Nat) nhub j1 j2 i) (erased (HubSubn nhub j2 j1 i) hs) (erased (Lt j1 nhub) l1) (erased (Lt j2 nhub) l2)
    -> (erased (Lt i (Succ nhub)) r))
  (let-match erased hs (HSGt _ _ _ t _ l at mo)
    ((HSLe _ _ _ _ l mo) (lt-weaken i nhub (lt-le-trans i (Succ j2) nhub (add-le-right j1 i j2 (monus-add j2 j1 i mo l)) (LtS j2 nhub l2)))))
  (let ((erased a)) (monus-add t j1 i mo (lt-weaken j1 t (lt-le-trans j1 nhub t l1 (add-le-right j2 nhub t at)))))
  (match erased (le-dec i nhub) _
    ((LeY _ _ k) k)
    (absurd (LeN _ _ k) (lt-asym j2 j1 l (lt-weaken j1 j2 (add-cancel-lt j2 nhub j1 i t at a k))))))

(def-fns _ $ (erased subn-back : (erased (Nat) nhub j1 j2 i i2) (erased (HubSubn nhub j2 j1 i) hs) (erased (Lt j1 nhub) l1) (erased (Add i i2 nhub) ai)
    -> (erased (Nat) c) (erased (Add j2 i2 c) a) (erased (Or (Eq (Nat) c j1) (Add j1 nhub c)) md))
  (match erased hs _
    ((HSLe _ _ _ _ l mo)
      (let ((erased c) (erased a)) (add j2 i2))
      (let ((erased bc) (erased b1) (erased b2)) (plus-assoc j1 i i2 j2 c (monus-add j2 j1 i mo l) a))
      (let-match erased (add-fn i i2 bc nhub b1 ai) (Refl _ _))
      (values c a (OrR _ _ b2)))
    ((HSGt _ _ _ t _ l at mo)
      (let ((erased a)) (monus-add t j1 i mo (lt-weaken j1 t (lt-le-trans j1 nhub t l1 (add-le-right j2 nhub t at)))))
      (let ((erased ab) (erased b1) (erased b2)) (plus-assoc-r j2 i2 i nhub t at (add-comm i i2 nhub ai)))
      (let-match erased (add-inj i ab t j1 (add-comm ab i t b2) (add-comm j1 i t a)) (Refl _ _))
      (values ab b1 (OrL _ _ (Refl _ ab))))))

(def-fns _ $ (erased fam-build : (erased (Nat) d y nhub) (erased (List (Nat)) e n f ks) (erased (List (Sec)) os) (erased (List (List (Sec))) oss)
    (erased (List (Hc)) hc) (erased (Geo d e n f ks) g) (erased (Lt y d) ly) (erased (Nth (Nat) ks y nhub) pa) (erased (ObsAt e f ks y nhub os) ob)
    (erased (Lt 1 nhub) ln) (erased (OssFrom nhub os (Zero) nhub oss) w) (subterm erased (HcIdx nhub hc) ix) -> (erased (Fam os nhub oss hc) r))
  (let ((erased lo)) (oss-len nhub (Zero) nhub os oss w))
  (match erased ix _
    ((HINil _) (FamNil os nhub oss))
    ((HIOne _ j b hc1 lj ix1)
      (let ((erased o) (erased no)) (nth-exists _ oss nhub j lo lj))
      (let ((erased c) (erased k) (erased a) (erased sh) (erased ro)) (oss-nth nhub (Zero) nhub j os o oss w no))
      (let-match erased (add-fn j (Zero) c j a (add-zero-right j)) (Refl _ _))
      (FamOne os o nhub j k b oss hc1 sh ro no (fam-build d y nhub e n f ks os oss hc1 g ly pa ob ln w ix1)))
    ((HITwo _ j1 j2 b hc1 l1 l2 ix1)
      (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
      (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
      (let ((erased cy)) (face-cycle d y nhub f ks ol ly pa))
      (let ((erased o1) (erased no1)) (nth-exists _ oss nhub j1 lo l1))
      (let ((erased c1) (erased k1) (erased a1) (erased sh1) (erased ro1)) (oss-nth nhub (Zero) nhub j1 os o1 oss w no1))
      (let-match erased (add-fn j1 (Zero) c1 j1 a1 (add-zero-right j1)) (Refl _ _))
      (let ((erased o2) (erased no2)) (nth-exists _ oss nhub j2 lo l2))
      (let ((erased c2) (erased k2) (erased a2) (erased sh2) (erased ro2)) (oss-nth nhub (Zero) nhub j2 os o2 oss w no2))
      (let-match erased (add-fn j2 (Zero) c2 j2 a2 (add-zero-right j2)) (Refl _ _))
      (let ((erased w1) (erased z1) (erased _) (erased lw1) (erased pw1) (erased ow1) (erased r1) (erased q1))
        (oss-dart d y nhub j1 k1 e n f ks os o1 g ly pa ob ln l1 sh1 ro1))
      (let ((erased w2) (erased z2) (erased _) (erased lw2) (erased pw2) (erased ow2) (erased r2) (erased q2))
        (oss-dart d y nhub j2 k2 e n f ks os o2 g ly pa ob ln l2 sh2 ro2))
      (let ((erased i) (erased hs)) (hub-subn-c nhub j2 j1))
      (let ((erased li)) (subn-le nhub j1 j2 i hs l1 l2))
      (let ((erased i2) (erased mo)) (monus-c nhub i))
      (let ((erased ai)) (monus-add nhub i i2 mo li))
      (let ((erased cf) (erased af) (erased mf)) (subn-fwd nhub j1 j2 i hs l1))
      (let ((erased cb) (erased ab) (erased mb)) (subn-back nhub j1 j2 i i2 hs l1 ai))
      (let ((erased it12)) (dart-step d y nhub j1 j2 i cf w1 w2 z1 z2 f fi pf cy lw1 q1 r1 q2 r2 af mf))
      (let ((erased it21)) (dart-step d y nhub j2 j1 i2 cb w2 w1 z2 z1 f fi pf cy lw2 q2 r2 q1 r1 ab mb))
      (let ((erased li2)) (add-le-right i i2 nhub ai))
      (FamTwo os o1 o2 nhub j1 j2 k1 i i2 b oss hc1 sh1 ro1 no1 no2 hs
        (rot-at d w1 w2 nhub i e n f ks o1 o2 g lw1 pw1 ow1 ow2 it12 li) (rot-at d w2 w1 nhub i2 e n f ks o2 o1 g lw2 pw2 ow2 ow1 it21 li2) ai
        (fam-build d y nhub e n f ks os oss hc1 g ly pa ob ln w ix1)))))

(def-adts $ (MapHit : ((Nat) d) ((List (Nat)) e f ks) ((List (List (Sub))) obl) -> Type)
  enum
  (many MkMapHit : (erased (Nat) d z) (erased (List (Nat)) e f ks) (erased (List (Sub)) q) (erased (List (List (Sub))) obl) (erased (Lt z d) lz)
      (erased (Mem (List (Sub)) q obl) m) (erased (ExactAt e f ks z q) x) -> (MapHit d e f ks obl)))

; The bound on the transfers into the face of a dart w of arity nhub: dscore1 (edge (face^2 w)) is at most the number
; of target rules rt that fit w.
(def-adts $ (TgtAt : ((List (Nat)) e n f ks) ((List (List (Sub))) drs rt) ((Nat) nhub w) -> Type)
  enum
  (many MkTgtAt : (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs rt) (erased (Nat) nhub w u v c t) (erased (List (Sec)) os)
      (erased (Iter f 2 w u) pu) (erased (Nth (Nat) e u v) pv) (erased (DScore1 e n f ks drs v c) ds) (erased (ObsAt e f ks w nhub os) ob)
      (erased (Count os rt t) k) (erased (Lt c (Succ t)) le) -> (TgtAt e n f ks drs rt nhub w)))

(def-adts $ (TgtAll : ((List (Nat)) e n f ks) ((List (List (Sub))) drs rt) ((Nat) nhub) ((List (Nat)) ws) -> Type)
  enum
  (many TANil : (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs rt) (erased (Nat) nhub) -> (TgtAll e n f ks drs rt nhub (Nil (Nat))))
  (many TACons : (erased (List (Nat)) e n f ks ws) (erased (List (List (Sub))) drs rt) (erased (Nat) nhub w a) (erased (Nth (Nat) ks w a) pa)
      (erased (Or (Apart (Nat) Lt a nhub) (TgtAt e n f ks drs rt nhub w)) t) (erased (TgtAll e n f ks drs rt nhub ws) rest)
      -> (TgtAll e n f ks drs rt nhub (Cons (Nat) w ws))))

(def-fns _ $ (erased tgt-at : (erased (List (Nat)) e n f ks ws) (erased (List (List (Sub))) drs rt) (erased (Nat) nhub i w)
    (subterm erased (TgtAll e n f ks drs rt nhub ws) ta) (erased (Nth (Nat) ws i w) pw) (erased (Nth (Nat) ks w nhub) pa) -> (erased (TgtAt e n f ks drs rt nhub w) r))
  (let-match erased ta (TACons _ _ _ _ ws1 _ _ _ w0 a pa0 t rest) (absurd (TANil _ _ _ _ _ _ _) pw))
  (let-match erased pw (NthThere _ _ _ i1 _ pw1)
    ((NthHere _ _ _)
      (let-match erased (nth-fn _ ks w a nhub pa0 pa) (Refl _ _))
      (match erased t _ ((OrR _ _ x) x) (absurd (OrL _ _ ne) (apart-irrefl nhub ne)))))
  (tgt-at e n f ks ws1 drs rt nhub i1 w rest pw1 pa))

(def-fns _ $ (erased hit-mem : (erased (List (Sec)) os) (erased (List (List (Sub))) obl) (subterm erased (Hit os obl) h)
    -> (erased (List (Sub)) q) (erased (Mem (List (Sub)) q obl) m) (erased (Exact os q) x))
  (let-match erased h (HitThere _ q0 obl1 h1)
    ((HitHere _ q obl1 x) (values q (MemHere _ q obl1) x)))
  (let ((erased q) (erased m) (erased x)) (hit-mem os obl1 h1))
  (values q (MemThere _ q q0 obl1 m) x))

(def-fns _ $ (erased counts-exists : (erased (List (List (Sub))) rt rs) (subterm erased (List (List (Sec))) oss)
    -> (erased (List (Nat)) ct cs) (erased (Counts oss rt rs ct cs) r))
  (let-match erased oss (Cons _ o oss1) ((Nil _) (values (Nil _) (Nil _) (CsNil rt rs))))
  (let ((erased t) (erased kt)) (count-exists o rt))
  (let ((erased s) (erased ks)) (count-exists o rs))
  (let ((erased ct) (erased cs) (erased k)) (counts-exists rt rs oss1))
  (values (Cons _ t ct) (Cons _ s cs) (CsCons o oss1 rt rs t s ct cs kt ks k)))

(def-fns _ $ (erased counts-len : (erased (List (List (Sec))) oss) (erased (List (List (Sub))) rt rs) (erased (List (Nat)) ct cs) (erased (Nat) m)
    (subterm erased (Counts oss rt rs ct cs) k) (erased (Length (List (Sec)) oss m) l) -> (erased (Length (Nat) ct m) lt) (erased (Length (Nat) cs m) ls))
  (let-match erased k (CsCons o oss1 _ _ t s ct1 cs1 _ _ k1) ((CsNil _ _) (let-match erased l (LengthNil _)) (values (LengthNil _) (LengthNil _))))
  (let-match erased l (LengthCons _ _ _ m1 l1))
  (let ((erased lt) (erased ls)) (counts-len oss1 rt rs ct1 cs1 m1 k1 l1))
  (values (LengthCons _ t ct1 m1 lt) (LengthCons _ s cs1 m1 ls)))

(def-fns _ $ (erased sum-exists : (subterm erased (List (Nat)) xs) -> (erased (Nat) s) (erased (Sum xs s) r))
  (let-match erased xs (Cons _ x xs1) ((Nil _) (values (Zero) (SumNil))))
  (let ((erased s1) (erased r1)) (sum-exists xs1))
  (let ((erased s) (erased a)) (add x s1))
  (values s (SumCons x s1 s xs1 r1 a)))

(def-fns _ $ (erased sum-fn : (erased (List (Nat)) xs) (erased (Nat) s t) (subterm erased (Sum xs s) p) (erased (Sum xs t) q) -> (erased (Eq (Nat) s t) e))
  (let-match erased p (SumCons x s1 _ xs1 p1 a) ((SumNil) (let-match erased q (SumNil)) (Refl _ s)))
  (let-match erased q (SumCons _ t1 _ _ q1 a2))
  (let-match erased (sum-fn xs1 s1 t1 p1 q1) (Refl _ _))
  (add-fn x s1 s t a a2))

(def-fns _ $ (erased dscore1-fn : (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs) (erased (Nat) y c1 c2)
    (erased (DScore1 e n f ks drs y c1) p) (erased (DScore1 e n f ks drs y c2) q) -> (erased (Eq (Nat) c1 c2) r))
  (let-match erased p (MkDScore1 _ _ _ _ _ qs _ z a _ os iv pa ob sz k))
  (let-match erased q (MkDScore1 _ _ _ _ _ qs2 _ z2 a2 _ os2 iv2 pa2 ob2 sz2 k2))
  (let-match erased (invf2-fn e n y z z2 iv iv2) (Refl _ _))
  (let-match erased (nth-fn _ ks z a a2 pa pa2) (Refl _ _))
  (let-match erased (obs-fn e f ks z a os os2 ob ob2) (Refl _ _))
  (let-match erased (of-size-fn a drs qs qs2 sz sz2) (Refl _ _))
  (count-fn os qs c1 c2 k k2))

(def-fns _ $ (erased obs-len : (erased (List (Nat)) e f ks) (erased (Nat) y m) (erased (List (Sec)) os) (subterm erased (ObsAt e f ks y m os) ob)
    -> (erased (Length (Sec) os m) r))
  (let-match erased ob (OACons _ _ _ _ y1 m1 o os1 _ _ ob1) ((OANil _ _ _ _) (LengthNil _)))
  (LengthCons _ o os1 m1 (obs-len e f ks y1 m1 os1 ob1)))

(def-fns _ $ (erased hitsome-map : (erased (Nat) d y nhub j m) (erased (List (Nat)) e n f ks) (erased (List (Sec)) os) (erased (List (List (Sec))) oss)
    (erased (List (List (Sub))) obl) (erased (Geo d e n f ks) g) (erased (Lt y d) ly) (erased (Nth (Nat) ks y nhub) pa) (erased (ObsAt e f ks y nhub os) ob)
    (erased (Lt 1 nhub) ln) (erased (Add j m nhub) jm) (subterm erased (OssFrom nhub os j m oss) w) (erased (HitSome oss obl) hs)
    -> (erased (MapHit d e f ks obl) r))
  (let-match erased w (OFCons _ _ m1 k _ o oss1 sh ro w1) (absurd (OFNil _ _ _) hs))
  (let ((erased lj)) (add-pos-lt j (Succ m1) nhub jm (LtZ m1)))
  (let-match erased hs (HSHere _ _ _ h)
    ((HSThere _ _ _ h1) (hitsome-map d y nhub (Succ j) m1 e n f ks os oss1 obl g ly pa ob ln (add-shift j m1 nhub jm) w1 h1)))
  (let ((erased wd) (erased _) (erased _) (erased lw) (erased pw) (erased ow) (erased _) (erased _)) (oss-dart d y nhub j k e n f ks os o g ly pa ob ln lj sh ro))
  (let ((erased q) (erased m) (erased x)) (hit-mem o obl h))
  (MkMapHit d wd e f ks q obl lw m (MkExactAt e f ks wd nhub o q pw ow x)))

; Along the face of y from z = f^j y: the source counts are the dscore1 values of the face darts, and the target
; counts bound those of their edges.
(def-fns _ $ (erased face-bound : (erased (Nat) d y nhub j m z) (erased (List (Nat)) e n f ks ids csl csel ws) (erased (List (List (Sub))) drs rt rs)
    (erased (List (Sec)) os) (erased (List (List (Sec))) oss) (erased (List (Nat)) ct cs)
    (erased (Geo d e n f ks) g) (erased (Lt y d) ly) (erased (Nth (Nat) ks y nhub) pa) (erased (ObsAt e f ks y nhub os) ob) (erased (Lt 1 nhub) ln)
    (erased (Iota d ids) io) (erased (DsList e n f ks drs ids csl) dl) (erased (Respects csl e csel) rc) (erased (OfSize nhub drs rs) sz)
    (erased (Iota d ws) iw) (erased (TgtAll e n f ks drs rt nhub ws) ta)
    (erased (Add j m nhub) jm) (erased (Iter f j y z) pj) (subterm erased (OssFrom nhub os j m oss) w) (erased (Counts oss rt rs ct cs) k)
    -> (erased (Nat) sn sp st) (erased (FSum f csl z m sn) f1) (erased (Sum cs sn) s1) (erased (FSum f csel z m sp) f2) (erased (Sum ct st) s2)
    (erased (Lt sp (Succ st)) le))
  (let-match erased w (OFCons _ _ m1 kk _ o oss1 sh ro w1)
    ((OFNil _ _ _) (let-match erased k (CsNil _ _)) (values (Zero) (Zero) (Zero) (FSZ f csl z) (SumNil) (FSZ f csel z) (SumNil) (LtZ (Zero)))))
  (let-match erased k (CsCons _ _ _ _ t s ct1 cs1 kt ks1 k1))
  (let ((erased lj)) (add-pos-lt j (Succ m1) nhub jm (LtZ m1)))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (let ((erased wd) (erased z2) (erased _) (erased lw) (erased pw) (erased ow) (erased pj2) (erased p2)) (oss-dart d y nhub j kk e n f ks os o g ly pa ob ln lj sh ro))
  (let-match erased (iter-fn f j y z2 z pj2 pj) (Refl _ _))
  (let ((erased z3) (erased pj3) (erased lz) (erased _)) (face-walk d y nhub e n f ks h ol j ly pa))
  (let-match erased (iter-fn f j y z3 z pj3 pj) (Refl _ _))
  (let ((erased lcs)) (dslist-length e n f ks ids csl drs d dl (iota-length d ids io)))
  (let ((erased c) (erased pc)) (nth-exists _ csl d z lcs lz))
  (let ((erased ds)) (dslist-nth e n f ks ids csl drs z z c dl (iota-nth d z ids io lz) pc))
  (let-match erased (dbound1-eq d wd nhub z c s e n f ks drs rs o g lw pw ow p2 ds sz ks1) (Refl _ _))
  (let ((erased tg)) (tgt-at e n f ks ws drs rt nhub wd wd ta (iota-nth d wd ws iw lw) pw))
  (let-match erased tg (MkTgtAt _ _ _ _ _ _ _ _ u v c2 t2 os2 pu pv ds2 ob2 kt2 le2))
  (let-match erased (iter-fn f 2 wd u z pu p2) (Refl _ _))
  (let-match erased (obs-fn e f ks wd nhub os2 o ob2 ow) (Refl _ _))
  (let-match erased (count-fn o rt t2 t kt2 kt) (Refl _ _))
  (let ((erased le0) (erased _) (erased _)) (hyper-lengths d e n f h))
  (let ((erased ye) (erased _) (erased z1) (erased pe) (erased lye) (erased _) (erased _) (erased pz1) (erased _)) (hyper-step d z e n f h lz))
  (let-match erased (nth-fn _ e z v ye pv pe) (Refl _ _))
  (let ((erased c3) (erased pc3)) (nth-exists _ csel d z (respects-length csl e csel d rc le0) lz))
  (let ((erased ds3)) (dslist-nth e n f ks ids csl drs v v c3 dl (iota-nth d v ids io lye) (respects-nth csl e csel z v c3 rc pv pc3)))
  (let-match erased (dscore1-fn e n f ks drs v c2 c3 ds2 ds3) (Refl _ _))
  (let ((erased sn1) (erased sp1) (erased st1) (erased f1) (erased s1) (erased f2) (erased s2) (erased le1))
    (face-bound d y nhub (Succ j) m1 z1 e n f ks ids csl csel ws drs rt rs os oss1 ct1 cs1 g ly pa ob ln io dl rc sz iw ta (add-shift j m1 nhub jm)
      (iter-snoc f j y z z1 pj pz1) w1 k1))
  (let ((erased sn) (erased a1)) (add c sn1))
  (let ((erased sp) (erased a2)) (add c2 sp1))
  (let ((erased st) (erased a3)) (add t st1))
  (values sn sp st (FSS f csl z z1 m1 c sn1 sn pc pz1 f1 a1) (SumCons c sn1 sn cs1 s1 a1) (FSS f csel z z1 m1 c2 sp1 sp pc3 pz1 f2 a2)
    (SumCons t st1 st ct1 s2 a3) (le-sum c2 t sp1 st1 sp st le2 le1 a2 a3)))

(def-fns _ $ (erased add-lt-cancel : (erased (Nat) a x y u v) (subterm erased (Add a x u) p) (erased (Add a y v) q) (erased (Lt u v) l) -> (erased (Lt x y) r))
  (let-match erased p (AddSucc a1 _ u1 p1) ((AddZero _) (let-match erased q (AddZero _)) l))
  (let-match erased q (AddSucc _ _ v1 q1))
  (add-lt-cancel a1 x y u1 v1 p1 q1 (lt-pred u1 v1 l)))

; A positive dscore, 60 + sp > 10 a + sn, against the hub's bound kp + st <= kn + sn with K = kp - kn = 60 - 10 a and sp <= st.
(def-fns _ $ (erased absurd hub-arith : (erased (Nat) a c60 t sp sn pos neg kp kn st l r)
    (erased (Mul 6 10 c60) m60) (erased (Mul a 10 t) mt) (erased (Add c60 sp pos) ap) (erased (Add t sn neg) an) (erased (Lt neg pos) lt)
    (erased (DbK a kp kn) dk) (erased (Add kp st l) al) (erased (Add kn sn r) ar) (erased (Lt l (Succ r)) le) (erased (Lt sp (Succ st)) lst)
    (erased (Lt 4 a) l4) -> (erased (False) f))
  (match erased dk _
    (absurd (DbKLo _ mo)
      (let-match erased mo (MoAdd _ _ _ a5) (absurd (MoNeg _ _ l5) (lt-le-absurd 4 a l4 l5)))
      (let-match erased (add-fn 5 (Zero) a 5 a5 (add-zero-right 5)) (Refl _ _))
      (let-match erased m60 (MulSucc _ _ t1 _ m5 a10))
      (let-match erased (mul-fn 5 10 t1 t m5 mt) (Refl _ _))
      (let ((erased b) (erased ab) (erased apb)) (plus-assoc t 10 sp c60 pos a10 ap))
      (let ((erased l1)) (add-lt-cancel t sn b neg pos an apb lt))
      (let-match erased ar (AddZero _))
      (lt-le-absurd sn l (lt-le-trans sn b l l1 (add-le-r 10 sp b st l ab al lst)) le))
    (absurd (DbKHi _ k m mo pm)
      (let-match erased mo (MoAdd _ _ _ a5))
      (let ((erased e1)) (mul-distr 6 k a 10 c60 m t (add-shift 5 k a a5) m60 pm mt))
      (let ((erased bc) (erased q1) (erased q2)) (plus-assoc c60 m sn t neg e1 an))
      (let ((erased l1)) (add-lt-cancel c60 bc sp neg pos q2 ap lt))
      (let-match erased al (AddZero _))
      (let-match erased (add-fn m sn r bc ar q1) (Refl _ _))
      (lt-le-absurd bc l (lt-le-trans bc sp l l1 lst) le))))

; hubcap_fit_bound at a hub dart y of arity nhub with positive dscore: some obligation of out fits exactly somewhere.
(def-fns _ $ (erased hub-sound : (erased (Nat) d y nhub pos neg) (erased (List (Nat)) e n f ks ws) (erased (List (List (Sub))) drs rt rs acc out)
    (erased (List (Sub)) p) (erased (List (Hc)) hc) (erased (Geo d e n f ks) g) (erased (Lt y d) ly) (erased (DScore d e n f ks drs y pos neg) dsc)
    (erased (Lt neg pos) lt) (erased (ExactAt e f ks y p) x) (erased (Length (Sub) p nhub) lp) (erased (OfSize nhub drs rs) sz) (erased (Iota d ws) iw)
    (erased (TgtAll e n f ks drs rt nhub ws) ta) (erased (CoverOk nhub hc) cov) (erased (HcIdx nhub hc) ix) (erased (HFit nhub p rt rs hc acc out) hf)
    -> (erased (MapHit d e f ks out) r))
  (let-match erased x (MkExactAt _ _ _ _ a os _ pa ob ex))
  (let-match erased ex (MkExact _ _ m fo lo lp2))
  (let-match erased (length-fn _ p m nhub lp2 lp) (Refl _ _))
  (let-match erased (length-fn _ os a m (obs-len e f ks y a os ob) lo) (Refl _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol ab))
  (let ((erased l4)) (above-nth ks 4 y a ab pa))
  (let ((erased ln)) (lt-trans 1 4 a (lit-lt-1-4) l4))
  (let ((erased oss) (erased w)) (oss-exists a (Zero) os a))
  (let ((erased fam)) (fam-build d y a e n f ks os oss hc g ly pa ob ln w ix))
  (let ((erased ct) (erased cs) (erased k)) (counts-exists rt rs oss))
  (let ((erased lct) (erased lcs)) (counts-len oss rt rs ct cs a k (oss-len a (Zero) a os oss w)))
  (let ((erased st) (erased pst)) (sum-exists ct))
  (let ((erased ss) (erased pss)) (sum-exists cs))
  (match erased (hfit-sound a os p rt rs acc out hc oss ct cs ex hf fam k) _
    ((OrR _ _ hs) (hitsome-map d y a (Zero) a e n f ks os oss out g ly pa ob ln (AddZero a) w hs))
    (absurd (OrL _ _ sat)
      (let ((erased kp) (erased kn) (erased l) (erased r) (erased dk) (erased al) (erased ar) (erased le)) (cover-sound a st ss hc ct cs cov sat lct lcs pst pss))
      (let-match erased dsc (MkDScore _ _ a2 t c60 sp sn _ _ _ _ _ _ ids csl csel _ io dl rc pa2 fp fn m60 mt ap an))
      (let-match erased (nth-fn _ ks y a a2 pa pa2) (Refl _ _))
      (let ((erased sn1) (erased sp1) (erased st1) (erased f1) (erased s1) (erased f2) (erased s2) (erased lst))
        (face-bound d y a (Zero) a y e n f ks ids csl csel ws drs rt rs os oss ct cs g ly pa ob ln io dl rc sz iw ta (AddZero a) (ItZ f y) w k))
      (let-match erased (fsum-fn f csl y a sn1 sn f1 fn) (Refl _ _))
      (let-match erased (fsum-fn f csel y a sp1 sp f2 fp) (Refl _ _))
      (let-match erased (sum-fn cs sn ss s1 pss) (Refl _ _))
      (let-match erased (sum-fn ct st1 st s2 pst) (Refl _ _))
      (hub-arith a c60 t sp sn pos neg kp kn st l r m60 mt ap an lt dk al ar le lst l4))))
