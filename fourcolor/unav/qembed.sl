      (let-match erased rs (RespCons _ _ _ _ _ _ rs1))
      (let-match erased ak (AKCons _ _ _ _ ak1))
      (walk-drop e n ks e2 n2 ks2 s1 t as1 at s3 t2 as3 at2 hl st y y2 q1 w1 w3 rs1 ak1))
    ((WSR _ _ _ s1 _ as1 _ _ _ y q1 _ _ w1)
      (let-match erased w2 (WSR _ _ _ s3 _ as3 _ _ _ y2 _ _ _ w3))
      (let-match erased rs (RespCons _ _ _ _ _ _ rs1))
      (let-match erased ak (AKCons _ _ _ _ ak1))
      (walk-drop e n ks e2 n2 ks2 s1 t as1 at s3 t2 as3 at2 hl st y y2 q1 w1 w3 rs1 ak1))
    ((WSLR _ _ _ s1 u _ as1 au _ _ _ yl yr ql qr _ _ wl _ wr)
      (let-match erased w2 (WSLR _ _ _ s3 u3 _ as3 au3 _ _ _ yl3 yr3 _ _ _ _ wl3 _ wr3))
      (let-match erased rs (RespCons _ _ _ _ _ _ rs1))
      (let-match erased ak (AKCons _ _ _ _ ak1))
      (let ((erased rs2) (erased ak2)) (walk-drop e n ks e2 n2 ks2 s1 u as1 au s3 u3 as3 au3 hl st yl yl3 ql wl wl3 rs1 ak1))
      (walk-drop e n ks e2 n2 ks2 u t au at u3 t2 au3 at2 hl st yr yr3 qr wr wr3 rs2 ak2))
    ((WSLL _ _ _ s1 _ as1 _ _ _ _ _ _ y q1 _ _ _ _ _ w1)
      (let-match erased w2 (WSLL _ _ _ s3 _ as3 _ _ _ _ _ _ y2 _ _ _ _ _ _ w3))
      (let-match erased rs (RespCons _ _ _ _ _ _ rs1))
      (let-match erased ak (AKCons _ _ _ _ ak1))
      (walk-drop e n ks e2 n2 ks2 s1 t as1 at s3 t2 as3 at2 hl st y y2 q1 w1 w3 rs1 ak1))
    ((WSRR _ _ _ s1 _ as1 _ _ _ _ y q1 _ _ _ w1)
      (let-match erased w2 (WSRR _ _ _ s3 _ as3 _ _ _ _ y2 _ _ _ _ w3))
      (let-match erased rs (RespCons _ _ _ _ _ _ rs1))
      (let-match erased ak (AKCons _ _ _ _ ak1))
      (walk-drop e n ks e2 n2 ks2 s1 t as1 at s3 t2 as3 at2 hl st y y2 q1 w1 w3 rs1 ak1))))

(def-fns _ $ (erased walk-central : (erased (Nat) dc dm x0c x0m a0 a1) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl asc asm) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Qn) q01 q10)
    (erased (WalkZ ec nc ksc x0c (MkQuiz (QaskR a0 q01) (QaskR a1 q10)) s0c asc) wc) (erased (WalkZ em nm ksm x0m (MkQuiz (QaskR a0 q01) (QaskR a1 q10)) s0m asm) wm)
    (erased (Respects hl s0c s0m) rs) (erased (AllKin st s0c) ak) -> (erased (AllCenD ec em hl s0c (Nil (Nat))) r))
  (let ((erased _) (erased g) (erased uh) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let-match erased g (MkGeo _ _ _ _ _ _ plm _ _ _))
  (let-match erased wc (MkWalkZ _ _ _ _ u _ au _ x1 _ _ w0 px w1))
  (let-match erased w0 (WSR _ _ _ s1 _ as1 _ _ _ y _ _ sp wk))
  (let-match erased sp (MkQStepR _ _ _ t _ pt pty))
  (let-match erased (nth-fn (Nat) ec x0c x1 t px pt) (Refl _ _))
  (let-match erased w1 (WSR _ _ _ s2 _ as2 _ _ _ y2 _ _ sp2 wk2))
  (let-match erased sp2 (MkQStepR _ _ _ t2 _ pt2 pty2))
  (let-match erased wm (MkWalkZ _ _ _ _ um _ aum _ x1m _ _ w0m pxm w1m))
  (let-match erased w0m (WSR _ _ _ sm1 _ asm1 _ _ _ ym _ _ spm wkm))
  (let-match erased spm (MkQStepR _ _ _ tm _ ptm ptym))
  (let-match erased (nth-fn (Nat) em x0m x1m tm pxm ptm) (Refl _ _))
  (let-match erased w1m (WSR _ _ _ sm2 _ asm2 _ _ _ ym2 _ _ spm2 wkm2))
  (let-match erased spm2 (MkQStepR _ _ _ tm2 _ ptm2 ptym2))
  (let-match erased rs (RespCons _ _ _ _ _ hx0 rs1))
  (let-match erased ak (AKCons _ _ _ kx0 ak1))
  (let ((erased rsu) (erased aku)) (walk-drop ec nc ksc em nm ksm s1 u as1 au sm1 um asm1 aum hl st y ym q01 wk wkm rs1 ak1))
  (let-match erased rsu (RespCons _ _ _ _ _ hx1 rs2))
  (let-match erased aku (AKCons _ _ _ kx1 ak2))
  (let ((erased px1)) (kin-plain dc dm x0c x1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kx0 px))
  (let-match erased (nth-fn (Nat) ec x1 x0c t2 px1 pt2) (Refl _ _))
  (let ((erased pxm1) (erased _)) (plain-eq dm x0m x1m em plm (under-nth hl x0c x0m dm uh hx0) pxm))
  (let-match erased (nth-fn (Nat) em x1m x0m tm2 pxm1 ptm2) (Refl _ _))
  (let ((erased cx0)) (MkCentral ec em hl x0c x1 x0m x1m px hx0 hx1 pxm))
  (let ((erased cx1)) (cen-edge dc dm x0c x1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kx0 cx0 px))
  (let ((erased r1) (erased _) (erased _))
    (hc-walk dc dm x1 x0c x1m y ym ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 u as1 au sm1 um asm1 aum st en q01 kx1 kx0 px1 cx1 hx1 pty ptym wk wkm rs1 ak1))
  (let ((erased r2) (erased _) (erased _))
    (hc-walk dc dm x0c x1 x0m y2 ym2 ec nc fc ksc rc s0c em nm fm ksm s0m hl s2 (Nil _) as2 (Nil _) sm2 (Nil _) asm2 (Nil _) st en q10 kx0 kx1 px cx0 hx0 pty2 ptym2
      wk2 wkm2 rs2 ak2))
  (CenCons ec em hl s1 (Nil _) x0c cx0 (acd-trans ec em hl s1 u (Nil _) r1 (CenCons ec em hl s2 (Nil _) x1 cx1 r2))))

(def-fns _ $ (erased iter-path : (erased (List (Nat)) f) (erased (Nat) k x y) (subterm erased (Iter f k x y) it)
    -> (erased (List (Nat)) xs) (erased (Path f (Nil (Nat)) x y xs) w))
  (let-match erased it (ItS _ k1 _ z _ pz it1) ((ItZ _ _) (values (Nil _) (PathHere f (Nil _) x))))
  (let ((erased xs1) (erased w1)) (iter-path f k1 z y it1))
  (values (Cons _ x xs1) (PathStep f (Nil _) xs1 x z y pz (NotInNil x) w1)))

(def-fns _ $ (erased lt-split : (erased (Nat) j a) (subterm erased (Lt j a) l) -> (erased (Nat) m) (erased (Add j m a) p))
  (let-match erased l (LtS j1 a1 l1) ((LtZ _) (values a (AddZero a))))
  (let ((erased m) (erased p)) (lt-split j1 a1 l1))
  (values m (AddSucc j1 m a1 p)))

(def-fns _ $ (erased acd-nth : (erased (List (Nat)) ec em hl s) (erased (Nat) i c) (subterm erased (AllCenD ec em hl s (Nil (Nat))) a) (erased (Nth (Nat) s i c) p)
    -> (erased (Central ec em hl c) r))
  (let-match erased a (CenCons _ _ _ s1 _ _ cx a1) (absurd (CenNil _ _ _ _) p))
  (let-match erased p (NthThere _ _ _ i1 _ p1) ((NthHere _ _ _) cx))
  (acd-nth ec em hl s1 i1 c a1 p1))

(def-fns _ $ (erased allkin-nth : (erased (List (KSt)) st) (erased (List (Nat)) s) (erased (Nat) i c) (subterm erased (AllKin st s) a) (erased (Nth (Nat) s i c) p)
    -> (erased (Kin st c) r))
  (let-match erased a (AKCons _ _ s1 kx a1) (absurd (AKNil _) p))
  (let-match erased p (NthThere _ _ _ i1 _ p1) ((NthHere _ _ _) kx))
  (allkin-nth st s1 i1 c a1 p1))

(def-fns _ $ (erased iter-arity : (erased (Nat) d j v w a) (erased (List (Nat)) e n f ks) (erased (Hypermap d e n f) h) (erased (OrderList d f ks) ol)
    (subterm erased (Iter f j v w) it) (erased (Lt v d) lv) (erased (Nth (Nat) ks v a) pa) -> (erased (Nth (Nat) ks w a) r))
  (let-match erased it (ItS _ j1 _ z _ pz it1) ((ItZ _ _) pa))
  (let ((erased y1) (erased py) (erased ly1) (erased pa1)) (face-step d v a e n f ks h ol lv pa))
  (let-match erased (nth-fn (Nat) f v z y1 pz py) (Refl _ _))
  (iter-arity d j1 z w a e n f ks h ol it1 ly1 pa1))

(def-fns _ $ (erased kin-anchor : (erased (Nat) dc dm x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k)
    -> (erased (Nat) i j c a) (erased (Nth (KSt) st x (StIn i j)) ps) (erased (Nth (Nat) s0c i c) pc) (erased (Iter fc j c x) it) (erased (Nth (Nat) ksc c a) pa)
    (erased (Lt j a) lj) (erased (Nth (Nat) ksc x a) pxa) (erased (Nth (KSt) st c (StIn i (Zero))) pc0) (erased (Kernel fc rc x) kx))
  (let-match erased k (MkKin _ _ i0 j0 p))
  (match erased (env-dart dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (kin-lt dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k)) _
    (absurd (DOut _ _ _ _ _ _ _ _ _ ps _ _ _) (nth-fn (KSt) st x (StIn i0 j0) (StOut) p ps))
    ((DIn _ _ _ _ _ _ _ _ i j c a _ _ _ _ _ ps pc it pa lj pxa _ _ _ _ _ _ _ _ pc0 kx) (values i j c a ps pc it pa lj pxa pc0 kx))))

(def-fns _ $ (erased coord-path : (erased (Nat) dc dm x y i j k) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Nth (KSt) st x (StIn i j)) px) (erased (Nth (KSt) st y (StIn i k)) py)
    -> (erased (SomePath fc (Nil (Nat)) x y) r))
  (let ((erased i1) (erased j1) (erased c) (erased a) (erased ps) (erased pc) (erased it) (erased pa) (erased lj) (erased _) (erased pc0) (erased _))
    (kin-anchor dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (MkKin st x i j px)))
  (let-match erased (nth-fn (KSt) st x (StIn i j) (StIn i1 j1) px ps) (Refl _ _))
  (let ((erased i2) (erased k2) (erased c2) (erased _) (erased ps2) (erased pc2) (erased it2) (erased _) (erased _) (erased _) (erased _) (erased _))
    (kin-anchor dc dm y ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (MkKin st y i k py)))
  (let-match erased (nth-fn (KSt) st y (StIn i k) (StIn i2 k2) py ps2) (Refl _ _))
  (let-match erased (nth-fn (Nat) s0c i c c2 pc pc2) (Refl _ _))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ olc _ _ _ _ _ _ _ _ _))
  (let ((erased cyc)) (face-cycle dc c a fc ksc olc (kin-lt dc dm c ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (MkKin st c i (Zero) pc0)) pa))
  (let ((erased m) (erased pm)) (lt-split j a lj))
  (let ((erased x2) (erased itx) (erased itm)) (iter-split fc j m a c c pm cyc))
  (let-match erased (iter-fn fc j c x x2 it itx) (Refl _ _))
  (let ((erased t) (erased pt)) (add-ex m k))
  (let ((erased xs) (erased w)) (iter-path fc t x y (iter-add fc m k t x c y itm it2 pt)))
  (MkSomePath fc (Nil _) xs x y w))

; s: the darts at the places k, k + 1, ..., each 0 face steps on.
(def-adts $ (WPos : ((List (KSt)) st) ((List (Nat)) s) ((Nat) k) -> Type)
  enum
  (many WPNil : (erased (List (KSt)) st) (erased (Nat) k) -> (WPos st (Nil (Nat)) k))
  (many WPCons : (erased (List (KSt)) st) (erased (List (Nat)) s) (erased (Nat) c k) (erased (Nth (KSt) st c (StIn k (Zero))) p) (erased (WPos st s (Succ k)) rest)
      -> (WPos st (Cons (Nat) c s) k)))

(def-fns _ $ (erased app-nth0 : (erased (List (Nat)) pre ys zs) (erased (Nat) y j) (subterm erased (AppN pre (Cons (Nat) y ys) zs) ap) (erased (Length (Nat) pre j) l)
    -> (erased (Nth (Nat) zs j y) r))
  (let-match erased ap (AppCons xs1 _ zs1 x ap1) ((AppNil _) (let-match erased l (LengthNil _)) (NthHere _ y ys)))
  (let-match erased l (LengthCons _ _ _ j1 l1))
  (NthThere _ x zs1 j1 y (app-nth0 xs1 ys zs1 y j1 ap1 l1)))

(def-fns _ $ (erased app-shift : (erased (List (Nat)) pre ys zs) (erased (Nat) y) (subterm erased (AppN pre (Cons (Nat) y ys) zs) ap)
    -> (erased (List (Nat)) pre2) (erased (AppN pre2 ys zs) r) (erased (Snoc (Nat) pre y pre2) s))
  (let-match erased ap (AppCons xs1 _ zs1 x ap1)
    ((AppNil _) (values (Cons _ y (Nil _)) (AppCons (Nil _) ys ys y (AppNil ys)) (SnocNil _ y))))
  (let ((erased p2) (erased r) (erased s)) (app-shift xs1 ys zs1 y ap1))
  (values (Cons _ x p2) (AppCons p2 ys zs1 x r) (SnocCons _ x y xs1 p2 s)))

(def-fns _ $ (erased wpos-resp : (erased (Nat) dc dm k n) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl s sm pre) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (subterm erased (WPos st s k) wp) (erased (AppN pre sm s0m) ap) (erased (Length (Nat) pre k) lp)
    (erased (Length (Nat) s n) ls) (erased (Length (Nat) sm n) lsm) -> (erased (Respects hl s sm) r))
  (let-match erased wp (WPCons _ s1 c _ pc wp1) ((WPNil _ _) (let-match erased ls (LengthNil _)) (let-match erased lsm (LengthNil _)) (RespNil hl)))
  (let-match erased ls (LengthCons _ _ _ n1 ls1))
  (let-match erased lsm (LengthCons _ v sm1 _ lsm1))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ lst _ _ hr _ _ _ _))
  (let ((erased w) (erased pw)) (nth-exists (Nat) hl dc c (hl-length st s0m fm hl dc hr lst) (nth-lt-length (KSt) st c dc (StIn k (Zero)) pc lst)))
  (let ((erased _) (erased pv2) (erased it)) (hl-at st s0m fm hl c k (Zero) w hr pc pw))
  (let-match erased it (ItZ _ _))
  (let-match erased (nth-fn (Nat) s0m k v w (app-nth0 pre sm1 s0m v k ap lp) pv2) (Refl _ _))
  (let ((erased pre2) (erased ap2) (erased sn)) (app-shift pre sm1 s0m v ap))
  (RespCons hl s1 sm1 c v pw (wpos-resp dc dm (Succ k) n1 ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 sm1 pre2 st en wp1 ap2 (snoc-length (Nat) pre pre2 v k sn lp)
    ls1 lsm1)))

(def-fns _ $ (erased wpos-kin : (erased (List (KSt)) st) (erased (List (Nat)) s) (erased (Nat) k) (subterm erased (WPos st s k) wp) -> (erased (AllKin st s) r))
  (let-match erased wp (WPCons _ s1 c _ pc wp1) ((WPNil _ _) (AKNil st)))
  (AKCons st c s1 (MkKin st c k (Zero) pc) (wpos-kin st s1 (Succ k) wp1)))

(def-adts $ (StIx : ((List (KSt)) st) ((Nat) k) -> Type)
  enum
  (many StxNil : (erased (Nat) k) -> (StIx (Nil (KSt)) k))
  (many StxOut : (erased (List (KSt)) st) (erased (Nat) k) (erased (StIx st k) rest) -> (StIx (Cons (KSt) (StOut) st) k))
  (many StxIn : (erased (List (KSt)) st) (erased (Nat) i j k) (erased (Lt i k) li) (erased (StIx st k) rest) -> (StIx (Cons (KSt) (StIn i j) st) k)))

(def-fns _ $ (erased hl-exists : (erased (Nat) dm k x0m) (erased (List (Nat)) s0m fm fi) (erased (List (KSt)) st) (subterm erased (StIx st k) sx)
    (erased (Length (Nat) s0m k) ls) (erased (Under s0m dm) us) (erased (HPerm dm fm fi) pf) (erased (Lt x0m dm) lx0)
    -> (erased (List (Nat)) hl) (erased (HlRel st s0m fm hl) hr) (erased (Under hl dm) uh))
  (match erased sx _
    ((StxNil _) (values (Nil _) (HRNil s0m fm) (UnderNil dm)))
    ((StxOut st1 _ sx1)
      (let ((erased hl) (erased hr) (erased uh)) (hl-exists dm k x0m s0m fm fi st1 sx1 ls us pf lx0))
      (values (Cons _ x0m hl) (HROut st1 s0m fm hl x0m hr) (UnderCons hl x0m dm lx0 uh)))
    ((StxIn st1 i j _ li sx1)
      (let ((erased hl) (erased hr) (erased uh)) (hl-exists dm k x0m s0m fm fi st1 sx1 ls us pf lx0))
      (let ((erased v) (erased pv)) (nth-exists (Nat) s0m k i ls li))
      (let ((erased w) (erased it) (erased lw)) (iter-ex dm v fm fi pf j (under-nth s0m i v dm us pv)))
      (values (Cons _ w hl) (HRIn st1 s0m fm hl i j v w pv it hr) (UnderCons hl w dm lw uh)))))

(def-fns _ $ (erased walk-under : (erased (Nat) d x) (erased (List (Nat)) e n ks s t as at ei ni) (erased (Qn) q) (erased (HPerm d e ei) pe) (erased (HPerm d n ni) pn)
    (subterm erased (WalkS e n ks x q s t as at) w) (erased (Lt x d) lx) (erased (Under t d) ut) -> (erased (Under s d) r))
  (match erased w _
    ((WS0 _ _ _ _ _ _) ut)
    ((WS1 _ _ _ _ _ _ _ _) (UnderCons t x d lx ut))
    ((WSL _ _ _ s1 _ as1 _ _ _ y q1 _ sp w1)
      (let-match erased sp (MkQStepL _ _ _ a b _ pa pb py))
      (UnderCons s1 x d lx (walk-under d y e n ks s1 t as1 at ei ni q1 pe pn w1 (img-lt d b y n ni pn (img-lt d a b e ei pe (img-lt d x a n ni pn lx pa) pb) py) ut)))
    ((WSR _ _ _ s1 _ as1 _ _ _ y q1 _ sp w1)
      (let-match erased sp (MkQStepR _ _ _ a _ pa py))
      (UnderCons s1 x d lx (walk-under d y e n ks s1 t as1 at ei ni q1 pe pn w1 (img-lt d a y n ni pn (img-lt d x a e ei pe lx pa) py) ut)))
    ((WSLR _ _ _ s1 u _ as1 au _ _ _ yl yr ql qr _ sl wl sr wr)
      (let-match erased sl (MkQStepL _ _ _ a b _ pa pb py))
      (let-match erased sr (MkQStepR _ _ _ a2 _ pa2 py2))
      (UnderCons s1 x d lx (walk-under d yl e n ks s1 u as1 au ei ni ql pe pn wl
        (img-lt d b yl n ni pn (img-lt d a b e ei pe (img-lt d x a n ni pn lx pa) pb) py)
        (walk-under d yr e n ks u t au at ei ni qr pe pn wr (img-lt d a2 yr n ni pn (img-lt d x a2 e ei pe lx pa2) py2) ut))))
    ((WSLL _ _ _ s1 _ as1 _ _ _ xl c c2 y q1 sa pc pc2 _ sb w1)
      (let-match erased sa (MkQStepL _ _ _ a b _ pa pb pxl))
      (let-match erased sb (MkQStepL _ _ _ c3 c4 _ pc3 pc4 py))
      (let ((erased lxl)) (img-lt d b xl n ni pn (img-lt d a b e ei pe (img-lt d x a n ni pn lx pa) pb) pxl))
      (let ((erased lc2)) (img-lt d c c2 e ei pe (img-lt d xl c n ni pn lxl pc) pc2))
      (let ((erased lc4)) (img-lt d c3 c4 e ei pe (img-lt d xl c3 n ni pn lxl pc3) pc4))
      (UnderCons s1 c2 d lc2 (walk-under d y e n ks s1 t as1 at ei ni q1 pe pn w1 (img-lt d c4 y n ni pn lc4 py) ut)))
    ((WSRR _ _ _ s1 _ as1 _ _ _ xr y q1 sa _ sb w1)
      (let-match erased sa (MkQStepR _ _ _ a _ pa pxr))
      (let-match erased sb (MkQStepR _ _ _ a2 _ pa2 py))
      (let ((erased lxr)) (img-lt d a xr n ni pn (img-lt d x a e ei pe lx pa) pxr))
      (UnderCons s1 xr d lxr (walk-under d y e n ks s1 t as1 at ei ni q1 pe pn w1 (img-lt d a2 y n ni pn (img-lt d xr a2 e ei pe lxr pa2) py) ut)))))

(def-fns _ $ (erased walkz-under : (erased (Nat) d x) (erased (List (Nat)) e n ks s as ei ni) (erased (Quiz) qz) (erased (HPerm d e ei) pe) (erased (HPerm d n ni) pn)
    (erased (WalkZ e n ks x qz s as) w) (erased (Lt x d) lx) -> (erased (Under s d) r))
  (let-match erased w (MkWalkZ _ _ _ _ u _ au _ x1 q0 q1 w0 px w1))
  (walk-under d x e n ks s u as au ei ni q0 pe pn w0 lx
    (walk-under d x1 e n ks u (Nil _) au (Nil _) ei ni q1 pe pn w1 (img-lt d x x1 e ei pe lx px) (UnderNil d))))

; y is on the face of edge x.
(def-adts $ (Rlink : ((List (Nat)) e f) ((Nat) x y) -> Type)
  enum
  (many MkRlink : (erased (List (Nat)) e f) (erased (Nat) x y z) (erased (Nth (Nat) e x z) pz) (erased (SomePath f (Nil (Nat)) z y) w) -> (Rlink e f x y)))

; A path of rlink steps from x through p to y, the darts of p in as and central.
(def-adts $ (RlPath : ((List (Nat)) ec fc em hl as) ((Nat) x) ((List (Nat)) p) ((Nat) y) -> Type)
  enum
  (many RPLast : (erased (List (Nat)) ec fc em hl as) (erased (Nat) x y) (erased (Rlink ec fc x y) l) -> (RlPath ec fc em hl as x (Nil (Nat)) y))
  (many RPStep : (erased (List (Nat)) ec fc em hl as p) (erased (Nat) x z y) (erased (Rlink ec fc x z) l) (erased (In z as) iz) (erased (Central ec em hl z) cz)
      (erased (RlPath ec fc em hl as z p y) rest) -> (RlPath ec fc em hl as x (Cons (Nat) z p) y)))

(def-adts $ (RlTo : ((List (Nat)) ec fc em hl as) ((Nat) x) ((List (Nat)) ys) -> Type)
  enum
  (many RTNil : (erased (List (Nat)) ec fc em hl as) (erased (Nat) x) -> (RlTo ec fc em hl as x (Nil (Nat))))
  (many RTCons : (erased (List (Nat)) ec fc em hl as ys p) (erased (Nat) x y) (erased (RlPath ec fc em hl as x p y) rp) (erased (RlTo ec fc em hl as x ys) rest)
      -> (RlTo ec fc em hl as x (Cons (Nat) y ys))))

; At x: h (face x) = face (h x), h keeps the arity, some dart of the face of x is central, and node (face x) is joined to every dart of as by a path of central darts of as.
(def-adts $ (PeAt : ((List (Nat)) ec nc fc ksc em fm ksm as hl) ((Nat) x) -> Type)
  enum
  (many MkPeAt : (erased (List (Nat)) ec nc fc ksc em fm ksm as hl) (erased (Nat) x x1 w w1 a y z)
      (erased (Nth (Nat) fc x x1) px) (erased (Nth (Nat) hl x w) pw) (erased (Nth (Nat) hl x1 w1) pw1) (erased (Nth (Nat) fm w w1) pf)
      (erased (Nth (Nat) ksc x a) pa) (erased (Nth (Nat) ksm w a) pma) (erased (SomePath fc (Nil (Nat)) x y) py) (erased (Central ec em hl y) cy)
      (erased (Nth (Nat) nc x1 z) pz) (erased (RlTo ec fc em hl as z as) rl) -> (PeAt ec nc fc ksc em fm ksm as hl x)))

(def-adts $ (PeAll : ((List (Nat)) ec nc fc ksc em fm ksm as hl xs) -> Type)
  enum
  (many PeNil : (erased (List (Nat)) ec nc fc ksc em fm ksm as hl) -> (PeAll ec nc fc ksc em fm ksm as hl (Nil (Nat))))
  (many PeCons : (erased (List (Nat)) ec nc fc ksc em fm ksm as hl xs) (erased (Nat) x) (erased (PeAt ec nc fc ksc em fm ksm as hl x) p)
      (erased (PeAll ec nc fc ksc em fm ksm as hl xs) rest) -> (PeAll ec nc fc ksc em fm ksm as hl (Cons (Nat) x xs))))

(def-adts $ (Preembedding : ((List (Nat)) ec nc fc ksc em fm ksm as hl) -> Type)
  enum
  (many MkPreembedding : (erased (List (Nat)) ec nc fc ksc em fm ksm as hl) (erased (PeAll ec nc fc ksc em fm ksm as hl as) pa)
      -> (Preembedding ec nc fc ksc em fm ksm as hl)))

; as: the kernel of the ring r.
(def-adts $ (KerAll : ((List (Nat)) f r as) -> Type)
  enum
  (many KANil : (erased (List (Nat)) f r) -> (KerAll f r (Nil (Nat))))
  (many KACons : (erased (List (Nat)) f r as) (erased (Nat) x) (erased (Kernel f r x) k) (erased (KerAll f r as) rest) -> (KerAll f r (Cons (Nat) x as))))

(def-adts $ (KerCover : ((List (Nat)) f r as xs) -> Type)
  enum
  (many KvNil : (erased (List (Nat)) f r as) -> (KerCover f r as (Nil (Nat))))
  (many KvIn : (erased (List (Nat)) f r as xs) (erased (Nat) x) (erased (In x as) i) (erased (KerCover f r as xs) rest) -> (KerCover f r as (Cons (Nat) x xs)))
  (many KvBand : (erased (List (Nat)) f r as xs) (erased (Nat) x) (erased (Fband f r x) b) (erased (KerCover f r as xs) rest) -> (KerCover f r as (Cons (Nat) x xs))))

(def-adts $ (KernelList : ((Nat) d) ((List (Nat)) f r as) -> Type)
  enum
  (many MkKernelList : (erased (Nat) d) (erased (List (Nat)) f r as ids) (erased (Iota d ids) io) (erased (KerAll f r as) ka) (erased (KerCover f r as ids) cv)
      -> (KernelList d f r as)))

(def-adts $ (KinList : ((List (KSt)) st) ((List (Nat)) xs as) -> Type)
  enum
  (many KLNil : (erased (List (KSt)) st) -> (KinList st (Nil (Nat)) (Nil (Nat))))
  (many KLIn : (erased (List (KSt)) st) (erased (List (Nat)) xs as) (erased (Nat) x i j) (erased (Nth (KSt) st x (StIn i j)) p) (erased (KinList st xs as) rest)
      -> (KinList st (Cons (Nat) x xs) (Cons (Nat) x as)))
  (many KLOut : (erased (List (KSt)) st) (erased (List (Nat)) xs as) (erased (Nat) x) (erased (Nth (KSt) st x (StOut)) p) (erased (KinList st xs as) rest)
      -> (KinList st (Cons (Nat) x xs) as)))

(def-fns _ $ (erased covered-cons : (erased (List (Nat)) f r as ys) (erased (Nat) x) (subterm erased (KerCover f r as ys) cv) -> (erased (KerCover f r (Cons (Nat) x as) ys) r))
  (match erased cv _
    ((KvNil _ _ _) (KvNil f r (Cons _ x as)))
    ((KvIn _ _ _ ys1 y i cv1) (KvIn f r (Cons _ x as) ys1 y (InThere y x as i) (covered-cons f r as ys1 x cv1)))
    ((KvBand _ _ _ ys1 y b cv1) (KvBand f r (Cons _ x as) ys1 y b (covered-cons f r as ys1 x cv1)))))

(def-fns _ $ (erased kin-split : (erased (List (Nat)) ec nc fc ksc rc s0c ys) (erased (List (KSt)) st) (subterm erased (DartsOK ec nc fc ksc rc s0c st ys) dk)
    -> (erased (List (Nat)) as) (erased (AllKin st as) ak) (erased (KerAll fc rc as) ka) (erased (KerCover fc rc as ys) cv) (erased (KinList st ys as) kl))
  (let-match erased dk (DKCons _ _ _ _ _ _ ys1 _ x d dk1) ((DKNil _ _ _ _ _ _ _) (values (Nil _) (AKNil st) (KANil fc rc) (KvNil fc rc (Nil _)) (KLNil st))))
  (let ((erased as) (erased ak) (erased ka) (erased cv) (erased kl)) (kin-split ec nc fc ksc rc s0c ys1 st dk1))
  (match erased d _
    ((DOut _ _ _ _ _ _ _ _ _ ps fb _ _) (values as ak ka (KvBand fc rc as ys1 x fb cv) (KLOut st ys1 as x ps kl)))
    ((DIn _ _ _ _ _ _ _ _ i j _ _ _ _ _ _ _ ps _ _ _ _ _ _ _ _ _ _ _ _ _ _ kx)
      (values (Cons _ x as) (AKCons st x as (MkKin st x i j ps) ak) (KACons fc rc as x kx ka)
        (KvIn fc rc (Cons _ x as) ys1 x (InHere x as) (covered-cons fc rc as ys1 x cv)) (KLIn st ys1 as x i j ps kl)))))

(def-fns _ $ (erased kl-in : (erased (List (KSt)) st) (erased (List (Nat)) xs as) (erased (Nat) y i j) (subterm erased (KinList st xs as) kl) (erased (In y xs) iy)
    (erased (Nth (KSt) st y (StIn i j)) py) -> (erased (In y as) r))
  (match erased kl _
    (absurd (KLNil _) iy)
    ((KLIn _ xs1 as1 x _ _ _ kl1)
      (match erased iy _ ((InHere _ _) (InHere y as1)) ((InThere _ _ _ iy1) (InThere y x as1 (kl-in st xs1 as1 y i j kl1 iy1 py)))))
    ((KLOut _ xs1 _ _ px kl1)
      (match erased iy _
        (absurd (InHere _ _) (nth-fn (KSt) st y (StIn i j) (StOut) py px))
        ((InThere _ _ _ iy1) (kl-in st xs1 as y i j kl1 iy1 py))))))

; p: a walk dart or its edge image.
(def-adts $ (CenOK : ((List (Nat)) ec s0c) ((Nat) p) -> Type)
  enum
  (many COWalk : (erased (List (Nat)) ec s0c) (erased (Nat) k p) (erased (Nth (Nat) s0c k p) pk) -> (CenOK ec s0c p))
  (many COEdge : (erased (List (Nat)) ec s0c) (erased (Nat) k c p) (erased (Nth (Nat) s0c k c) pk) (erased (Nth (Nat) ec c p) pe) -> (CenOK ec s0c p)))

; p: a path from the walk face i to the walk face j.
(def-adts $ (DPath : ((List (Nat)) ec s0c) ((List (KSt)) st) ((Nat) i) ((List (Nat)) p) ((Nat) j) -> Type)
  enum
  (many DPNil : (erased (List (Nat)) ec s0c) (erased (List (KSt)) st) (erased (Nat) i) -> (DPath ec s0c st i (Nil (Nat)) i))
  (many DPCons : (erased (List (Nat)) ec s0c ps) (erased (List (KSt)) st) (erased (Nat) i p j jp q i2 jq) (erased (Nth (KSt) st p (StIn i jp)) psp)
      (erased (Nth (Nat) ec p q) pq) (erased (Nth (KSt) st q (StIn i2 jq)) psq) (erased (CenOK ec s0c p) co) (erased (DPath ec s0c st i2 ps j) rest)
      -> (DPath ec s0c st i (Cons (Nat) p ps) j)))

; Paths from each walk face of ixs to face 0 and back.
(def-adts $ (Spokes : ((List (Nat)) ec s0c) ((List (KSt)) st) ((List (Nat)) ixs) -> Type)
  enum
  (many SpkNil : (erased (List (Nat)) ec s0c) (erased (List (KSt)) st) -> (Spokes ec s0c st (Nil (Nat))))
  (many SpkCons : (erased (List (Nat)) ec s0c ixs p p2) (erased (List (KSt)) st) (erased (Nat) i) (erased (DPath ec s0c st i p (Zero)) d1)
      (erased (DPath ec s0c st (Zero) p2 i) d2) (erased (Spokes ec s0c st ixs) rest) -> (Spokes ec s0c st (Cons (Nat) i ixs))))

(def-fns _ $ (erased spoke-get : (erased (List (Nat)) ec s0c ixs) (erased (List (KSt)) st) (erased (Nat) i) (subterm erased (Spokes ec s0c st ixs) sp) (erased (In i ixs) ii)
    -> (erased (List (Nat)) p p2) (erased (DPath ec s0c st i p (Zero)) d1) (erased (DPath ec s0c st (Zero) p2 i) d2))
  (let-match erased sp (SpkCons _ _ ixs1 p p2 _ _ d1 d2 sp1) (absurd (SpkNil _ _ _) ii))
  (match erased ii _ ((InHere _ _) (values p p2 d1 d2)) ((InThere _ _ _ ii1) (spoke-get ec s0c ixs1 st i sp1 ii1))))

(def-fns _ $ (erased dp-app : (erased (List (Nat)) ec s0c p p2 ps) (erased (List (KSt)) st) (erased (Nat) i m j) (subterm erased (DPath ec s0c st i p m) d1)
    (erased (DPath ec s0c st m p2 j) d2) (erased (AppN p p2 ps) ap) -> (erased (DPath ec s0c st i ps j) r))
  (match erased d1 _
    ((DPNil _ _ _ _) (let-match erased ap (AppNil _)) d2)
    ((DPCons _ _ p1 _ _ q _ jp q2 i2 jq psp pq psq co d11)
      (let-match erased ap (AppCons _ _ ps1 _ ap1))
      (DPCons ec s0c ps1 st i q j jp q2 i2 jq psp pq psq co (dp-app ec s0c p1 p2 ps1 st i2 m j d11 d2 ap1)))))

(def-fns _ $ (erased cen-ok : (erased (Nat) dc dm p) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (AllCenD ec em hl s0c (Nil (Nat))) acd) (erased (AllKin st s0c) aks)
    (erased (CenOK ec s0c p) co) -> (erased (Central ec em hl p) r))
  (match erased co _
    ((COWalk _ _ k _ pk) (acd-nth ec em hl s0c k p acd pk))
    ((COEdge _ _ k c _ pk pe)
      (cen-edge dc dm c p ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (allkin-nth st s0c k c aks pk) (acd-nth ec em hl s0c k c acd pk) pe))))

(def-fns _ $ (erased dp-rl : (erased (Nat) dc dm z w i jw j jy y) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl as ids p) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (AllCenD ec em hl s0c (Nil (Nat))) acd) (erased (AllKin st s0c) aks)
    (erased (KinList st ids as) kl) (erased (Iota dc ids) io) (subterm erased (DPath ec s0c st i p j) dp) (erased (Nth (Nat) ec z w) pzw)
    (erased (Nth (KSt) st w (StIn i jw)) pw) (erased (Nth (KSt) st y (StIn j jy)) py) -> (erased (RlPath ec fc em hl as z p y) r))
  (let-match erased dp (DPCons _ _ ps _ _ q _ jp q2 i2 jq psp pq psq co dp1)
    ((DPNil _ _ _ _) (RPLast ec fc em hl as z y (MkRlink ec fc z y w pzw (coord-path dc dm w y i jw jy ec nc fc ksc rc s0c em nm fm ksm s0m hl st en pw py)))))
  (let ((erased lq)) (kin-lt dc dm q ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (MkKin st q i jp psp)))
  (RPStep ec fc em hl as ps z q y (MkRlink ec fc z q w pzw (coord-path dc dm w q i jw jp ec nc fc ksc rc s0c em nm fm ksm s0m hl st en pw psp))
    (kl-in st ids as q i jp kl (iota-in dc q ids io lq) psp) (cen-ok dc dm q ec nc fc ksc rc s0c em nm fm ksm s0m hl st en acd aks co)
    (dp-rl dc dm q q2 i2 jq j jy y ec nc fc ksc rc s0c em nm fm ksm s0m hl as ids ps st en acd aks kl io dp1 pq psq py)))

(def-adts $ (PEnv : ((Nat) dc) ((List (Nat)) ec nc fc ksc rc s0c) ((List (KSt)) st) ((Nat) dm) ((List (Nat)) em nm fm ksm s0m hl as) -> Type)
  enum
  (many MkPEnv : (erased (Nat) dc dm k) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl as ids ixs) (erased (List (KSt)) st)
      (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (AllCenD ec em hl s0c (Nil (Nat))) acd) (erased (AllKin st s0c) aks)
      (erased (KinList st ids as) kl) (erased (Iota dc ids) io) (erased (Length (Nat) s0c k) ls) (erased (Iota k ixs) iok) (erased (Spokes ec s0c st ixs) ra)
      -> (PEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl as)))

(def-fns _ $ (erased rl-to : (erased (Nat) dc dm z x i jx) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl as ys) (erased (List (KSt)) st)
    (erased (PEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl as) pv) (subterm erased (AllKin st ys) ak) (erased (Nth (Nat) ec z x) pzx)
    (erased (Nth (KSt) st x (StIn i jx)) px) -> (erased (RlTo ec fc em hl as z ys) r))
  (let-match erased ak (AKCons _ y ys1 ky ak1) ((AKNil _) (RTNil ec fc em hl as z)))
  (let-match erased pv (MkPEnv _ _ k _ _ _ _ _ _ _ _ _ _ _ _ _ ids ixs _ en acd aks kl io ls iok ra))
  (let ((erased i1) (erased _) (erased c) (erased _) (erased ps) (erased pc) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _))
    (kin-anchor dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (MkKin st x i jx px)))
  (let-match erased (nth-fn (KSt) st x (StIn i jx) (StIn i1 _) px ps) (Refl _ _))
  (let ((erased j) (erased jy) (erased cy) (erased _) (erased psy) (erased pcy) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _))
    (kin-anchor dc dm y ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ky))
  (let ((erased p1) (erased _) (erased d1) (erased _)) (spoke-get ec s0c ixs st i ra (iota-in k i ixs iok (nth-lt-length (Nat) s0c i k c pc ls))))
  (let ((erased _) (erased p2) (erased _) (erased d2)) (spoke-get ec s0c ixs st j ra (iota-in k j ixs iok (nth-lt-length (Nat) s0c j k cy pcy ls))))
  (let ((erased p) (erased ap)) (app-exists p1 p2))
  (let ((erased dp)) (dp-app ec s0c p1 p2 p st i (Zero) j d1 d2 ap))
  (RTCons ec fc em hl as ys1 p z y (dp-rl dc dm z x i jx j jy y ec nc fc ksc rc s0c em nm fm ksm s0m hl as ids p st en acd aks kl io dp pzx px psy)
    (rl-to dc dm z x i jx ec nc fc ksc rc s0c em nm fm ksm s0m hl as ys1 st pv ak1 pzx px)))

(def-fns _ $ (erased pe-at : (erased (Nat) dc dm x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl as) (erased (List (KSt)) st)
    (erased (PEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl as) pv) (erased (AllKin st as) aka) (erased (Kin st x) kx)
    -> (erased (PeAt ec nc fc ksc em fm ksm as hl x) r))
  (let-match erased pv (MkPEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ en acd _ _ _ _ _ _))
  (let ((erased w) (erased x1) (erased w1) (erased pw) (erased px) (erased _) (erased pw1) (erased pf)) (kin-face dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kx))
  (let ((erased i) (erased j) (erased c) (erased a) (erased ps) (erased pc) (erased _) (erased pa) (erased _) (erased pxa) (erased pc0) (erased _))
    (kin-anchor dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kx))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ as0 _ hc _ _ _ _ g hr _ us rac ram))
  (let-match erased g (MkGeo _ _ _ _ _ hm _ _ olm _))
  (let ((erased v) (erased pv0) (erased itw)) (hl-at st s0m fm hl x i j w hr ps pw))
  (let ((erased l) (erased pl) (erased qc)) (resp-at ksc s0c as0 i c rac pc))
  (let-match erased (nth-fn (Nat) ksc c a l pa qc) (Refl _ _))
  (let ((erased l2) (erased pl2) (erased qm)) (resp-at ksm s0m as0 i v ram pv0))
  (let-match erased (nth-fn (Nat) as0 i a l2 pl pl2) (Refl _ _))
  (let ((erased pma)) (iter-arity dm j v w a em nm fm ksm hm olm itw (under-nth s0m i v dm us pv0) qm))
  (let ((erased cnf) (erased cni) (erased cfi) (erased _) (erased cpe) (erased cpn) (erased cpf)) (hyper-core dc ec nc fc hc))
  (let ((erased lx1)) (img-lt dc x x1 fc cfi cpf (kin-lt dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kx) px))
  (let ((erased z) (erased pz) (erased lz)) (perm-nth dc x1 nc cni cpn lx1))
  (let ((erased w2) (erased pw2) (erased _)) (perm-nth dc z ec cnf cpe lz))
  (let-match erased (perm-inj dc w2 x x1 fc cfi cpf (fen dc x1 z w2 ec nc fc hc lx1 pz pw2) px) (Refl _ _))
  (MkPeAt ec nc fc ksc em fm ksm as hl x x1 w w1 a c z px pw pw1 pf pxa pma
    (coord-path dc dm x c i j (Zero) ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ps pc0) (acd-nth ec em hl s0c i c acd pc) pz
    (rl-to dc dm z x i j ec nc fc ksc rc s0c em nm fm ksm s0m hl as as st pv aka pw2 ps)))

(def-fns _ $ (erased pe-all : (erased (Nat) dc dm) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl as xs) (erased (List (KSt)) st)
    (erased (PEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl as) pv) (erased (AllKin st as) aka) (subterm erased (AllKin st xs) ak)
    -> (erased (PeAll ec nc fc ksc em fm ksm as hl xs) r))
  (let-match erased ak (AKCons _ x xs1 kx ak1) ((AKNil _) (PeNil ec nc fc ksc em fm ksm as hl)))
  (PeCons ec nc fc ksc em fm ksm as hl xs1 x (pe-at dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl as st pv aka kx)
    (pe-all dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl as xs1 st pv aka ak1)))

; The place of each dart, the walk of qz at x0c with its arities, and paths between the walk faces through face 0.
(def-adts $ (QzCert : ((Nat) dc) ((List (Nat)) ec nc fc ksc rc) ((Quiz) qz) ((Nat) x0c) -> Type)
  enum
  (many MkQzCert : (erased (Nat) dc k x0c a0 a1) (erased (List (Nat)) ec nc fc ksc rc s0c asc ids ixs) (erased (List (KSt)) st) (erased (Qn) q01 q10)
      (erased (Hypermap dc ec nc fc) hc) (erased (OrderList dc fc ksc) olc) (erased (Iota dc ids) io) (erased (Length (KSt) st dc) lst)
      (erased (DartsOK ec nc fc ksc rc s0c st ids) dk) (erased (StIx st k) sx) (erased (WalkZ ec nc ksc x0c (MkQuiz (QaskR a0 q01) (QaskR a1 q10)) s0c asc) wz)
      (erased (WPos st s0c (Zero)) wp) (erased (Length (Nat) s0c k) ls) (erased (Iota k ixs) iok) (erased (Spokes ec s0c st ixs) ra)
      -> (QzCert dc ec nc fc ksc rc (MkQuiz (QaskR a0 q01) (QaskR a1 q10)) x0c)))

(def-fns _ $ (erased quiz-preembedding : (erased (Nat) dc x0c dm x0m) (erased (List (Nat)) ec nc fc ksc rc em nm fm ksm) (erased (Quiz) qz)
    (erased (QzCert dc ec nc fc ksc rc qz x0c) cert) (erased (Geo dm em nm fm ksm) g) (erased (Lt x0m dm) lx0) (erased (FitZ em nm ksm x0m qz) fz)
    -> (erased (List (Nat)) as hl) (erased (KernelList dc fc rc as) kls) (erased (Preembedding ec nc fc ksc em fm ksm as hl) pe) (erased (Nth (Nat) hl x0c x0m) h0))
  (let-match erased cert (MkQzCert _ k _ a0 a1 _ _ _ _ _ s0c asc ids ixs st q01 q10 hc olc io lst dk sx wz wp ls iok ra))
  (let-match erased g (MkGeo _ _ _ _ _ hm _ _ _ _))
  (let ((erased mnf) (erased mni) (erased mfi) (erased _) (erased mpe) (erased mpn) (erased mpf)) (hyper-core dm em nm fm hm))
  (let ((erased s0m) (erased asm) (erased wzm)) (fitz-walk em nm ksm x0m qz fz))
  (let-match erased (walkz-as ec nc ksc em nm ksm s0c asc s0m asm x0c x0m qz wz wzm) (Refl _ _))
  (let ((erased rac)) (walkz-arity ec nc ksc s0c asc x0c qz wz))
  (let ((erased ram)) (walkz-arity em nm ksm s0m asc x0m qz wzm))
