; The QuizEmbedding section of quiz.v: a quiz that tests for a configuration map Gc and fits a plain cubic map Gm at
; x0m gives a preembedding of the kernel of Gc into Gm (quiz_preembedding). Gc is described by a certificate QzCert, which
; a run decides on the concrete map; the darts of its kernel are named by a face of the walk of the quiz and a number of
; face steps from that walk dart, and the map h of embedqz sends such a dart to as many face steps from the matching walk
; dart of Gm. Load after qwalk.sl.

; A dart of Gc off the kernel, or in it at j face steps from the walk dart i.
(def-adts $ (KSt : -> Type)
  enum
  (many KOut : -> (KSt))
  (many KIn : (many (Nat) i j) -> (KSt)))

; j1 is the place after j on a face of a darts.
(def-adts $ (NextIx : ((Nat) j a j1) -> Type)
  enum
  (many NxStep : (erased (Nat) j a) -> (NextIx j a (Succ j)))
  (many NxWrap : (erased (Nat) j) -> (NextIx j (Succ j) (Zero))))

; What the certificate says of a dart x: off the kernel, on the face band of the ring, as is face x; or in it, with its
; place i, j, its arity, the place of face x, and edge and node of order 2 and 3 at x.
(def-adts $ (DartOK : ((List (Nat)) ec nc fc ksc rc s0c) ((List (KSt)) st) ((Nat) x) -> Type)
  enum
  (many DOut : (erased (List (Nat)) ec nc fc ksc rc s0c) (erased (List (KSt)) st) (erased (Nat) x x1) (erased (Nth (KSt) st x (KOut)) ps)
      (erased (Fband fc rc x) fb) (erased (Nth (Nat) fc x x1) px) (erased (Nth (KSt) st x1 (KOut)) ps1) -> (DartOK ec nc fc ksc rc s0c st x))
  (many DIn : (erased (List (Nat)) ec nc fc ksc rc s0c) (erased (List (KSt)) st) (erased (Nat) x i j c a x1 j1 y u1 u2)
      (erased (Nth (KSt) st x (KIn i j)) ps) (erased (Nth (Nat) s0c i c) pc) (erased (Iter fc j c x) it) (erased (Nth (Nat) ksc c a) pa) (erased (Lt j a) lj)
      (erased (Nth (Nat) ksc x a) pxa) (erased (Nth (Nat) fc x x1) px) (erased (Nth (KSt) st x1 (KIn i j1)) ps1) (erased (NextIx j a j1) nx)
      (erased (Nth (Nat) ec x y) pe) (erased (Nth (Nat) ec y x) pe2) (erased (Nth (Nat) nc x u1) pn1) (erased (Nth (Nat) nc u1 u2) pn2)
      (erased (Nth (Nat) nc u2 x) pn3) -> (DartOK ec nc fc ksc rc s0c st x)))

(def-adts $ (DartsOK : ((List (Nat)) ec nc fc ksc rc s0c) ((List (KSt)) st) ((List (Nat)) xs) -> Type)
  enum
  (many DKNil : (erased (List (Nat)) ec nc fc ksc rc s0c) (erased (List (KSt)) st) -> (DartsOK ec nc fc ksc rc s0c st (Nil (Nat))))
  (many DKCons : (erased (List (Nat)) ec nc fc ksc rc s0c xs) (erased (List (KSt)) st) (erased (Nat) x) (erased (DartOK ec nc fc ksc rc s0c st x) d)
      (erased (DartsOK ec nc fc ksc rc s0c st xs) rest) -> (DartsOK ec nc fc ksc rc s0c st (Cons (Nat) x xs))))

; hl lists h: a kernel dart at place i, j goes to j face steps from the walk dart i of Gm.
(def-adts $ (HlRel : ((List (KSt)) st) ((List (Nat)) s0m fm hl) -> Type)
  enum
  (many HRNil : (erased (List (Nat)) s0m fm) -> (HlRel (Nil (KSt)) s0m fm (Nil (Nat))))
  (many HROut : (erased (List (KSt)) st) (erased (List (Nat)) s0m fm hl) (erased (Nat) w) (erased (HlRel st s0m fm hl) rest)
      -> (HlRel (Cons (KSt) (KOut) st) s0m fm (Cons (Nat) w hl)))
  (many HRIn : (erased (List (KSt)) st) (erased (List (Nat)) s0m fm hl) (erased (Nat) i j v w) (erased (Nth (Nat) s0m i v) pv)
      (erased (Iter fm j v w) it) (erased (HlRel st s0m fm hl) rest) -> (HlRel (Cons (KSt) (KIn i j) st) s0m fm (Cons (Nat) w hl))))

; Everything the proof reads off Gc, Gm and h; the walks of the quiz in both maps ask the arities as0.
(def-adts $ (QEnv : ((Nat) dc) ((List (Nat)) ec nc fc ksc rc s0c) ((List (KSt)) st) ((Nat) dm) ((List (Nat)) em nm fm ksm s0m hl) -> Type)
  enum
  (many MkQEnv : (erased (Nat) dc dm) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl ids as0) (erased (List (KSt)) st)
      (erased (Hypermap dc ec nc fc) hc) (erased (Iota dc ids) io) (erased (Length (KSt) st dc) lst) (erased (DartsOK ec nc fc ksc rc s0c st ids) dk)
      (erased (Geo dm em nm fm ksm) g) (erased (HlRel st s0m fm hl) hr) (erased (Under hl dm) uh) (erased (Under s0m dm) us) (erased (Respects ksc s0c as0) rac)
      (erased (Respects ksm s0m as0) ram) -> (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl)))

(def-adts $ (Kin : ((List (KSt)) st) ((Nat) x) -> Type)
  enum
  (many MkKin : (erased (List (KSt)) st) (erased (Nat) x i j) (erased (Nth (KSt) st x (KIn i j)) p) -> (Kin st x)))

(def-adts $ (AllKin : ((List (KSt)) st) ((List (Nat)) xs) -> Type)
  enum
  (many AKNil : (erased (List (KSt)) st) -> (AllKin st (Nil (Nat))))
  (many AKCons : (erased (List (KSt)) st) (erased (Nat) x) (erased (List (Nat)) xs) (erased (Kin st x) k) (erased (AllKin st xs) rest)
      -> (AllKin st (Cons (Nat) x xs))))

; h (edge x) = edge (h x), hl listing h (Gonthier's edge_central).
(def-adts $ (Central : ((List (Nat)) ec em hl) ((Nat) x) -> Type)
  enum
  (many MkCentral : (erased (List (Nat)) ec em hl) (erased (Nat) x y w v) (erased (Nth (Nat) ec x y) py) (erased (Nth (Nat) hl x w) pw)
      (erased (Nth (Nat) hl y v) pv) (erased (Nth (Nat) em w v) pm) -> (Central ec em hl x)))

; Every dart of s before t is central.
(def-adts $ (AllCenD : ((List (Nat)) ec em hl s t) -> Type)
  enum
  (many ACNil : (erased (List (Nat)) ec em hl t) -> (AllCenD ec em hl t t))
  (many ACCons : (erased (List (Nat)) ec em hl s t) (erased (Nat) x) (erased (Central ec em hl x) c) (erased (AllCenD ec em hl s t) rest)
      -> (AllCenD ec em hl (Cons (Nat) x s) t)))

(def-fns _ $ (erased acd-trans : (erased (List (Nat)) ec em hl s u t) (subterm erased (AllCenD ec em hl s u) a) (erased (AllCenD ec em hl u t) b)
    -> (erased (AllCenD ec em hl s t) r))
  (let-match erased a (ACCons _ _ _ s1 _ x c a1) ((ACNil _ _ _ _) b))
  (ACCons ec em hl s1 t x c (acd-trans ec em hl s1 u t a1 b)))

(def-fns _ $ (erased iter-last : (erased (List (Nat)) f) (erased (Nat) j v w) (subterm erased (Iter f (Succ j) v w) it)
    -> (erased (Nat) u) (erased (Iter f j v u) r) (erased (Nth (Nat) f u w) pu))
  (let-match erased it (ItS _ _ _ z _ pz it1))
  (let-match erased j (Succ j1) ((Zero) (let-match erased it1 (ItZ _ _)) (values v (ItZ f v) pz)))
  (let ((erased u) (erased r) (erased pu)) (iter-last f j1 z w it1))
  (values u (ItS f j1 v z u pz r) pu))

(def-fns _ $ (erased resp-at : (erased (List (Nat)) lab xs ls) (erased (Nat) i x) (subterm erased (Respects lab xs ls) rp) (erased (Nth (Nat) xs i x) px)
    -> (erased (Nat) l) (erased (Nth (Nat) ls i l) pl) (erased (Nth (Nat) lab x l) q))
  (let-match erased rp (RespCons _ xs1 ls1 j l p rp1) (absurd (RespNil _) px))
  (let-match erased px (NthThere _ _ _ i1 _ px1) ((NthHere _ _ _) (values l (NthHere _ l ls1) p)))
  (let ((erased l2) (erased pl) (erased q)) (resp-at lab xs1 ls1 i1 x rp1 px1))
  (values l2 (NthThere _ l ls1 i1 l2 pl) q))

(def-fns _ $ (erased hl-at : (erased (List (KSt)) st) (erased (List (Nat)) s0m fm hl) (erased (Nat) x i j w) (subterm erased (HlRel st s0m fm hl) hr)
    (erased (Nth (KSt) st x (KIn i j)) ps) (erased (Nth (Nat) hl x w) pw) -> (erased (Nat) v) (erased (Nth (Nat) s0m i v) pv) (erased (Iter fm j v w) it))
  (match erased hr _
    (absurd (HRNil _ _) ps)
    ((HROut st1 _ _ hl1 w0 hr1)
      (let-match erased ps (NthThere _ _ _ x1 _ ps1))
      (let-match erased pw (NthThere _ _ _ _ _ pw1))
      (hl-at st1 s0m fm hl1 x1 i j w hr1 ps1 pw1))
    ((HRIn st1 _ _ hl1 i0 j0 v0 w0 pv0 it0 hr1)
      (match erased ps _
        ((NthHere _ _ _) (let-match erased pw (NthHere _ _ _)) (values v0 pv0 it0))
        ((NthThere _ _ _ x1 _ ps1) (let-match erased pw (NthThere _ _ _ _ _ pw1)) (hl-at st1 s0m fm hl1 x1 i j w hr1 ps1 pw1))))))

(def-fns _ $ (erased hl-length : (erased (List (KSt)) st) (erased (List (Nat)) s0m fm hl) (erased (Nat) k) (subterm erased (HlRel st s0m fm hl) hr)
    (erased (Length (KSt) st k) l) -> (erased (Length (Nat) hl k) r))
  (match erased hr _
    ((HRNil _ _) (let-match erased l (LengthNil _)) (LengthNil _))
    ((HROut st1 _ _ hl1 w hr1) (let-match erased l (LengthCons _ _ _ k1 l1)) (LengthCons _ w hl1 k1 (hl-length st1 s0m fm hl1 k1 hr1 l1)))
    ((HRIn st1 _ _ hl1 _ _ _ w _ _ hr1) (let-match erased l (LengthCons _ _ _ k1 l1)) (LengthCons _ w hl1 k1 (hl-length st1 s0m fm hl1 k1 hr1 l1)))))

(def-fns _ $ (erased darts-ok-nth : (erased (List (Nat)) ec nc fc ksc rc s0c xs) (erased (List (KSt)) st) (erased (Nat) j x)
    (subterm erased (DartsOK ec nc fc ksc rc s0c st xs) dk) (erased (Nth (Nat) xs j x) px) -> (erased (DartOK ec nc fc ksc rc s0c st x) r))
  (let-match erased dk (DKCons _ _ _ _ _ _ xs1 _ y d dk1) (absurd (DKNil _ _ _ _ _ _ _) px))
  (let-match erased px (NthThere _ _ _ j1 _ px1) ((NthHere _ _ _) d))
  (darts-ok-nth ec nc fc ksc rc s0c xs1 st j1 x dk1 px1))

(def-fns _ $ (erased env-dart : (erased (Nat) dc dm x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Lt x dc) lx) -> (erased (DartOK ec nc fc ksc rc s0c st x) r))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids _ _ hc io lst dk g hr uh us rac ram))
  (darts-ok-nth ec nc fc ksc rc s0c ids st x x dk (iota-nth dc x ids io lx)))

(def-fns _ $ (erased kin-lt : (erased (Nat) dc dm x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k) -> (erased (Lt x dc) r))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids _ _ hc io lst dk g hr uh us rac ram))
  (let-match erased k (MkKin _ _ i j p))
  (nth-lt-length (KSt) st x dc (KIn i j) p lst))

; The fields of a kernel dart.
(def-fns _ $ (erased kin-ok : (erased (Nat) dc dm x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k)
    -> (erased (Nat) i j c a x1 j1 y u1 u2) (erased (Nth (KSt) st x (KIn i j)) ps) (erased (Nth (Nat) s0c i c) pc) (erased (Iter fc j c x) it)
    (erased (Nth (Nat) ksc c a) pa) (erased (Lt j a) lj) (erased (Nth (Nat) ksc x a) pxa) (erased (Nth (Nat) fc x x1) px)
    (erased (Nth (KSt) st x1 (KIn i j1)) ps1) (erased (NextIx j a j1) nx) (erased (Nth (Nat) ec x y) pe) (erased (Nth (Nat) ec y x) pe2)
    (erased (Nth (Nat) nc x u1) pn1) (erased (Nth (Nat) nc u1 u2) pn2) (erased (Nth (Nat) nc u2 x) pn3))
  (let-match erased k (MkKin _ _ i0 j0 p))
  (match erased (env-dart dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (kin-lt dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k)) _
    (absurd (DOut _ _ _ _ _ _ _ _ x1 ps fb px ps1) (nth-fn (KSt) st x (KIn i0 j0) (KOut) p ps))
    ((DIn _ _ _ _ _ _ _ _ i j c a x1 j1 y u1 u2 ps pc it pa lj pxa px ps1 nx pe pe2 pn1 pn2 pn3)
      (values i j c a x1 j1 y u1 u2 ps pc it pa lj pxa px ps1 nx pe pe2 pn1 pn2 pn3))))

(def-fns _ $ (erased env-maps : (erased (Nat) dc dm) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en)
    -> (erased (Hypermap dc ec nc fc) hc) (erased (Geo dm em nm fm ksm) g) (erased (Under hl dm) uh) (erased (Under s0m dm) us))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids _ _ hc io lst dk g hr uh us rac ram))
  (values hc g uh us))

; h (face x) = face (h x) on the kernel, which face keeps.
(def-fns _ $ (erased kin-face : (erased (Nat) dc dm x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k)
    -> (erased (Nat) w x1 w1) (erased (Nth (Nat) hl x w) pw) (erased (Nth (Nat) fc x x1) px) (erased (Kin st x1) k1) (erased (Nth (Nat) hl x1 w1) pw1)
    (erased (Nth (Nat) fm w w1) pf))
  (let ((erased i) (erased j) (erased c) (erased a) (erased x1) (erased j1) (erased _) (erased _) (erased _) (erased ps) (erased pc) (erased _) (erased pa)
        (erased _) (erased _) (erased px) (erased ps1) (erased nx) (erased _) (erased _) (erased _) (erased _) (erased _))
    (kin-ok dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k))
  (let-match erased en (MkQEnv _ _ _ _ _ _ _ _ _ _ _ _ _ _ ids as0 _ hc io lst dk g hr uh us rac ram))
  (let ((erased lhl)) (hl-length st s0m fm hl dc hr lst))
  (let ((erased w) (erased pw)) (nth-exists (Nat) hl dc x lhl (nth-lt-length (KSt) st x dc (KIn i j) ps lst)))
  (let ((erased w1) (erased pw1)) (nth-exists (Nat) hl dc x1 lhl (nth-lt-length (KSt) st x1 dc (KIn i j1) ps1 lst)))
  (let ((erased v) (erased pv) (erased itw)) (hl-at st s0m fm hl x i j w hr ps pw))
  (let ((erased v1) (erased pv1) (erased itw1)) (hl-at st s0m fm hl x1 i j1 w1 hr ps1 pw1))
  (let-match erased (nth-fn (Nat) s0m i v v1 pv pv1) (Refl _ _))
  (let ((erased k1)) (MkKin st x1 i j1 ps1))
  (match erased nx _
    ((NxStep _ _)
      (let ((erased u) (erased itu) (erased pu)) (iter-last fm j v w1 itw1))
      (let-match erased (iter-fn fm j v w u itw itu) (Refl _ _))
      (values w x1 w1 pw px k1 pw1 pu))
    ((NxWrap _)
      (let-match erased itw1 (ItZ _ _))
      (let ((erased l) (erased pl) (erased qc)) (resp-at ksc s0c as0 i c rac pc))
      (let-match erased (nth-fn (Nat) ksc c a l pa qc) (Refl _ _))
      (let ((erased l2) (erased pl2) (erased qm)) (resp-at ksm s0m as0 i v ram pv))
      (let-match erased (nth-fn (Nat) as0 i l l2 pl pl2) (Refl _ _))
      (let-match erased g (MkGeo _ _ _ _ _ hm plm cum olm _))
      (let ((erased u) (erased itu) (erased pu)) (iter-last fm j v v (face-cycle dm v a fm ksm olm (under-nth s0m i v dm us pv) qm)))
      (let-match erased (iter-fn fm j v w u itw itu) (Refl _ _))
      (values w x1 v pw px k1 pw1 pu))))

(def-fns _ $ (erased kin-plain : (erased (Nat) dc dm x y) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k) (erased (Nth (Nat) ec x y) py) -> (erased (Nth (Nat) ec y x) r))
  (let ((erased _) (erased _) (erased _) (erased _) (erased _) (erased _) (erased y2) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _)
        (erased _) (erased _) (erased _) (erased _) (erased _) (erased pe) (erased pe2) (erased _) (erased _) (erased _))
    (kin-ok dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k))
  (let-match erased (nth-fn (Nat) ec x y y2 py pe) (Refl _ _))
  pe2)

; The node cycles of kernel darts have three darts.
(def-fns _ $ (erased kin-cubic : (erased (Nat) dc dm x y z) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k) (erased (Nth (Nat) nc x y) py) (erased (Nth (Nat) nc y z) pz)
    -> (erased (Nth (Nat) nc z x) r))
  (let ((erased _) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _) (erased u1) (erased u2) (erased _) (erased _) (erased _) (erased _)
        (erased _) (erased _) (erased _) (erased _) (erased _) (erased _) (erased _) (erased pn1) (erased pn2) (erased pn3))
    (kin-ok dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k))
  (let-match erased (nth-fn (Nat) nc x y u1 py pn1) (Refl _ _))
  (let-match erased (nth-fn (Nat) nc y z u2 pz pn2) (Refl _ _))
  pn3)

; A dart whose face successor is in the kernel is in it.
(def-fns _ $ (erased kin-fpre : (erased (Nat) dc dm u x) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Nth (Nat) fc u x) pu) (erased (Kin st x) k) -> (erased (Kin st u) r))
  (let ((erased hc) (erased _) (erased _) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let ((erased cnf) (erased cni) (erased cfi) (erased _) (erased _) (erased _) (erased cpf)) (hyper-core dc ec nc fc hc))
  (let ((erased lu)) (img-lt-inv dc u x fc cfi cpf (kin-lt dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k) pu))
  (let-match erased k (MkKin _ _ i0 j0 p))
  (match erased (env-dart dc dm u ec nc fc ksc rc s0c em nm fm ksm s0m hl st en lu) _
    (absurd (DOut _ _ _ _ _ _ _ _ u1 ps fb px ps1)
      (let-match erased (nth-fn (Nat) fc u x u1 pu px) (Refl _ _))
      (nth-fn (KSt) st x (KIn i0 j0) (KOut) p ps1))
    ((DIn _ _ _ _ _ _ _ _ i j _ _ _ _ _ _ _ ps _ _ _ _ _ _ _ _ _ _ _ _ _) (MkKin st u i j ps))))

; The kernel dart before x goes to the dart um before h x.
(def-fns _ $ (erased kin-fmi : (erased (Nat) dc dm u x w um) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Nth (Nat) fc u x) pu) (erased (Kin st x) k) (erased (Nth (Nat) hl x w) pw)
    (erased (Nth (Nat) fm um w) pm) -> (erased (Kin st u) ku) (erased (Nth (Nat) hl u um) r))
  (let ((erased ku)) (kin-fpre dc dm u x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en pu k))
  (let ((erased w0) (erased u1) (erased w1) (erased pw0) (erased pu1) (erased _) (erased pw1) (erased pf))
    (kin-face dc dm u ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ku))
  (let-match erased (nth-fn (Nat) fc u x u1 pu pu1) (Refl _ _))
  (let-match erased (nth-fn (Nat) hl x w w1 pw pw1) (Refl _ _))
  (let ((erased _) (erased g) (erased _) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let-match erased g (MkGeo _ _ _ _ _ hm _ _ _ _))
  (let ((erased mnf) (erased mni) (erased mfi) (erased _) (erased _) (erased _) (erased mpf)) (hyper-core dm em nm fm hm))
  (let-match erased (perm-inj dm w0 um w fm mfi mpf pf pm) (Refl _ _))
  (values ku pw0))

; If h (node x) = node (h x) then node x is central (hc_nx of quiz.v).
(def-fns _ $ (erased cen-node : (erased (Nat) dc dm x y w ym) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k) (erased (Nth (Nat) nc x y) py) (erased (Nth (Nat) hl x w) pw)
    (erased (Nth (Nat) nm w ym) pym) (erased (Nth (Nat) hl y ym) hy) -> (erased (Central ec em hl y) r))
  (let ((erased hc) (erased g) (erased uh) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let-match erased g (MkGeo _ _ _ _ _ hm _ _ _ _))
  (let ((erased cnf) (erased cni) (erased _) (erased _) (erased cpe) (erased cpn) (erased _)) (hyper-core dc ec nc fc hc))
  (let ((erased mnf) (erased mni) (erased _) (erased _) (erased mpe) (erased mpn) (erased _)) (hyper-core dm em nm fm hm))
  (let ((erased lx)) (kin-lt dc dm x ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k))
  (let ((erased u) (erased pu) (erased _)) (perm-nth dc y ec cnf cpe (img-lt dc x y nc cni cpn lx py)))
  (let ((erased lw)) (under-nth hl x w dm uh pw))
  (let ((erased v) (erased pv) (erased _)) (perm-nth dm ym em mnf mpe (img-lt dm w ym nm mni mpn lw pym)))
  (let ((erased _) (erased hu)) (kin-fmi dc dm u x w v ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc x y u ec nc fc hc lx py pu) k pw
    (fen dm w ym v em nm fm hm lw pym pv)))
  (MkCentral ec em hl y u ym v pu hy hu pv))

; edge_central is shut under edge.
(def-fns _ $ (erased cen-edge : (erased (Nat) dc dm x y) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st x) k) (erased (Central ec em hl x) c) (erased (Nth (Nat) ec x y) py)
    -> (erased (Central ec em hl y) r))
  (let-match erased c (MkCentral _ _ _ _ y2 w v p1 p2 p3 p4))
  (let-match erased (nth-fn (Nat) ec x y y2 py p1) (Refl _ _))
  (let ((erased _) (erased g) (erased uh) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let-match erased g (MkGeo _ _ _ _ _ hm plm _ _ _))
  (let ((erased q) (erased _)) (plain-eq dm w v em plm (under-nth hl x w dm uh p2) p4))
  (MkCentral ec em hl y x v w (kin-plain dc dm x y ec nc fc ksc rc s0c em nm fm ksm s0m hl st en k py) p3 p2 q))

; With p central, n (n p) = face (edge p) is in the kernel and goes to n (n (h p)).
(def-fns _ $ (erased node2 : (erased (Nat) dc dm p pe pm y ym a1 am) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl) (erased (List (KSt)) st)
    (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Kin st p) kp) (erased (Kin st pe) kpe) (erased (Nth (Nat) ec p pe) ppe)
    (erased (Central ec em hl p) cp) (erased (Nth (Nat) hl p pm) hp) (erased (Nth (Nat) nc p y) py) (erased (Nth (Nat) nc y a1) pa1)
    (erased (Nth (Nat) nm pm ym) pym) (erased (Nth (Nat) nm ym am) pam) -> (erased (Kin st a1) ka) (erased (Nth (Nat) hl a1 am) ha) (erased (Nth (Nat) fc pe a1) fa))
  (let ((erased hc) (erased g) (erased uh) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let-match erased g (MkGeo _ _ _ _ _ hm _ cum _ _))
  (let ((erased _) (erased cni) (erased _) (erased _) (erased _) (erased cpn) (erased _)) (hyper-core dc ec nc fc hc))
  (let ((erased _) (erased mni) (erased _) (erased _) (erased _) (erased mpn) (erased _)) (hyper-core dm em nm fm hm))
  (let ((erased na1)) (kin-cubic dc dm p y a1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp py pa1))
  (let-match erased cp (MkCentral _ _ _ _ pe2 pm2 pem p1 p2 p3 p4))
  (let-match erased (nth-fn (Nat) ec p pe pe2 ppe p1) (Refl _ _))
  (let-match erased (nth-fn (Nat) hl p pm pm2 hp p2) (Refl _ _))
  (let ((erased w0) (erased z) (erased w1) (erased hw0) (erased pz) (erased kz) (erased hz) (erased fz))
    (kin-face dc dm pe ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kpe))
  (let-match erased (nth-fn (Nat) hl pe pem w0 p3 hw0) (Refl _ _))
  (let ((erased lp)) (kin-lt dc dm p ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp))
  (let-match erased (perm-inj dc a1 z p nc cni cpn na1 (nfe dc p pe z ec nc fc hc lp ppe pz)) (Refl _ _))
  (let ((erased lpm)) (under-nth hl p pm dm uh hp))
  (let ((erased z2) (erased pz2) (erased pz3) (erased _) (erased _)) (cubic-eq dm pm ym nm cum lpm pym))
  (let-match erased (nth-fn (Nat) nm ym am z2 pam pz2) (Refl _ _))
  (let-match erased (perm-inj dm am w1 pm nm mni mpn pz3 (nfe dm pm pem w1 em nm fm hm lpm p4 fz)) (Refl _ _))
  (values kz hz pz))

; The walk of q from node p, with p and edge p in the kernel and p central, matched dart by dart with that from node (h p) in
; Gm, visits central darts (hc_walk in embedqz_central of quiz.v).
(def-fns _ $ (erased hc-walk : (erased (Nat) dc dm p pe pm y ym) (erased (List (Nat)) ec nc fc ksc rc s0c em nm fm ksm s0m hl sc tc asc atc sm tm asm atm)
    (erased (List (KSt)) st) (erased (QEnv dc ec nc fc ksc rc s0c st dm em nm fm ksm s0m hl) en) (erased (Qn) q) (erased (Kin st p) kp) (erased (Kin st pe) kpe)
    (erased (Nth (Nat) ec p pe) ppe) (erased (Central ec em hl p) cp) (erased (Nth (Nat) hl p pm) hp) (erased (Nth (Nat) nc p y) py) (erased (Nth (Nat) nm pm ym) pym)
    (subterm erased (WalkS ec nc ksc y q sc tc asc atc) wc) (erased (WalkS em nm ksm ym q sm tm asm atm) wm) (erased (Respects hl sc sm) rs) (erased (AllKin st sc) ak)
    -> (erased (AllCenD ec em hl sc tc) r) (erased (Respects hl tc tm) rt) (erased (AllKin st tc) akt))
  (let ((erased hc) (erased g) (erased uh) (erased _)) (env-maps dc dm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en))
  (let-match erased g (MkGeo _ _ _ _ _ hm plm cum _ _))
  (let ((erased cnf) (erased cni) (erased _) (erased _) (erased cpe) (erased cpn) (erased _)) (hyper-core dc ec nc fc hc))
  (let ((erased mnf) (erased mni) (erased _) (erased _) (erased mpe) (erased mpn) (erased _)) (hyper-core dm em nm fm hm))
  (let ((erased lp)) (kin-lt dc dm p ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp))
  (let ((erased ly)) (img-lt dc p y nc cni cpn lp py))
  (let ((erased lpm)) (under-nth hl p pm dm uh hp))
  (let ((erased lym)) (img-lt dm pm ym nm mni mpn lpm pym))
  (match erased wc _
    ((WS0 _ _ _ _ _ _) (let-match erased wm (WS0 _ _ _ _ _ _)) (values (ACNil ec em hl tc) rs ak))
    ((WS1 _ _ _ _ _ _ _ _)
      (let-match erased wm (WS1 _ _ _ _ _ _ _ _))
      (let-match erased rs (RespCons _ _ _ _ _ hy rs1))
      (let-match erased ak (AKCons _ _ _ ky ak1))
      (values (ACCons ec em hl tc tc y (cen-node dc dm p y pm ym ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp py hp pym hy) (ACNil ec em hl tc)) rs1 ak1))
    ((WSR _ _ _ s1 _ as1 _ _ _ y2 q1 _ sp wk1)
      (let-match erased wm (WSR _ _ _ sm1 _ asm1 _ _ _ ym2 _ _ spm wm1))
      (let-match erased sp (MkQStepR _ _ _ ue _ pue py2))
      (let-match erased spm (MkQStepR _ _ _ uem _ puem pym2))
      (let-match erased rs (RespCons _ _ _ _ _ hy rs1))
      (let-match erased ak (AKCons _ _ _ ky ak1))
      (let ((erased cy)) (cen-node dc dm p y pm ym ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp py hp pym hy))
      (let-match erased cy (MkCentral _ _ _ _ ue2 ym2b v q1a q2a q3a q4a))
      (let-match erased (nth-fn (Nat) ec y ue ue2 pue q1a) (Refl _ _))
      (let-match erased (nth-fn (Nat) hl y ym ym2b hy q2a) (Refl _ _))
      (let-match erased (nth-fn (Nat) em ym uem v puem q4a) (Refl _ _))
      (let ((erased kue)) (kin-fpre dc dm ue p ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc p y ue ec nc fc hc lp py pue) kp))
      (let ((erased r1) (erased rt1) (erased ak2))
        (hc-walk dc dm ue y uem y2 ym2 ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 tc as1 atc sm1 tm asm1 atm st en q1 kue ky
          (kin-plain dc dm y ue ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ky pue)
          (cen-edge dc dm y ue ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ky cy pue) q3a py2 pym2 wk1 wm1 rs1 ak1))
      (values (ACCons ec em hl s1 tc y cy r1) rt1 ak2))
    ((WSL _ _ _ s1 _ as1 _ _ _ y2 q1 _ sp wk1)
      (let-match erased wm (WSL _ _ _ sm1 _ asm1 _ _ _ ym2 _ _ spm wm1))
      (let-match erased sp (MkQStepL _ _ _ a1 b1 _ pa1 pb1 py2))
      (let-match erased spm (MkQStepL _ _ _ am bm _ pam pbm pym2))
      (let-match erased rs (RespCons _ _ _ _ _ hy rs1))
      (let-match erased ak (AKCons _ _ _ ky ak1))
      (let ((erased ka1) (erased ha1) (erased _)) (node2 dc dm p pe pm y ym a1 am ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp kpe ppe cp hp py pa1 pym pam))
      (let ((erased pb1a)) (kin-plain dc dm a1 b1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ka1 pb1))
      (let ((erased kb1) (erased hb1)) (kin-fmi dc dm b1 y ym bm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc y a1 b1 ec nc fc hc ly pa1 pb1) ky hy
        (fen dm ym am bm em nm fm hm lym pam pbm)))
      (let ((erased qbm) (erased _)) (plain-eq dm am bm em plm (img-lt dm ym am nm mni mpn lym pam) pbm))
      (let ((erased r1) (erased rt1) (erased ak2))
        (hc-walk dc dm b1 a1 bm y2 ym2 ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 tc as1 atc sm1 tm asm1 atm st en q1 kb1 ka1 pb1a
          (MkCentral ec em hl b1 a1 bm am pb1a hb1 ha1 qbm) hb1 py2 pym2 wk1 wm1 rs1 ak1))
      (values (ACCons ec em hl s1 tc y (cen-node dc dm p y pm ym ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp py hp pym hy) r1) rt1 ak2))
    ((WSLR _ _ _ s1 u _ as1 au _ _ _ yl yr ql qr _ sl wl sr wr)
      (let-match erased wm (WSLR _ _ _ sm1 um _ asm1 aum _ _ _ ylm yrm _ _ _ slm wlm srm wrm))
      (let-match erased rs (RespCons _ _ _ _ _ hy rs1))
      (let-match erased ak (AKCons _ _ _ ky ak1))
      (let ((erased cy)) (cen-node dc dm p y pm ym ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp py hp pym hy))
      (let-match erased sl (MkQStepL _ _ _ a1 b1 _ pa1 pb1 pyl))
      (let-match erased slm (MkQStepL _ _ _ am bm _ pam pbm pylm))
      (let ((erased ka1) (erased ha1) (erased _)) (node2 dc dm p pe pm y ym a1 am ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp kpe ppe cp hp py pa1 pym pam))
      (let ((erased pb1a)) (kin-plain dc dm a1 b1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ka1 pb1))
      (let ((erased kb1) (erased hb1)) (kin-fmi dc dm b1 y ym bm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc y a1 b1 ec nc fc hc ly pa1 pb1) ky hy
        (fen dm ym am bm em nm fm hm lym pam pbm)))
      (let ((erased qbm) (erased _)) (plain-eq dm am bm em plm (img-lt dm ym am nm mni mpn lym pam) pbm))
      (let ((erased r1) (erased rt1) (erased ak2))
        (hc-walk dc dm b1 a1 bm yl ylm ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 u as1 au sm1 um asm1 aum st en ql kb1 ka1 pb1a
          (MkCentral ec em hl b1 a1 bm am pb1a hb1 ha1 qbm) hb1 pyl pylm wl wlm rs1 ak1))
      (let-match erased sr (MkQStepR _ _ _ ue _ pue pyr))
      (let-match erased srm (MkQStepR _ _ _ uem _ puem pyrm))
      (let-match erased cy (MkCentral _ _ _ _ ue2 ym2b v q1a q2a q3a q4a))
      (let-match erased (nth-fn (Nat) ec y ue ue2 pue q1a) (Refl _ _))
      (let-match erased (nth-fn (Nat) hl y ym ym2b hy q2a) (Refl _ _))
      (let-match erased (nth-fn (Nat) em ym uem v puem q4a) (Refl _ _))
      (let ((erased kue)) (kin-fpre dc dm ue p ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc p y ue ec nc fc hc lp py pue) kp))
      (let ((erased r2) (erased rt2) (erased ak3))
        (hc-walk dc dm ue y uem yr yrm ec nc fc ksc rc s0c em nm fm ksm s0m hl u tc au atc um tm aum atm st en qr kue ky
          (kin-plain dc dm y ue ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ky pue)
          (cen-edge dc dm y ue ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ky cy pue) q3a pyr pyrm wr wrm rt1 ak2))
      (values (ACCons ec em hl s1 tc y cy (acd-trans ec em hl s1 u tc r1 r2)) rt2 ak3))
    ((WSLL _ _ _ s1 _ as1 _ _ _ xl c c2 y2 q1 sa pc pc2 _ sb wk1)
      (let-match erased wm (WSLL _ _ _ sm1 _ asm1 _ _ _ xlm cm c2m ym2 _ sam pcm pc2m _ sbm wm1))
      (let-match erased sa (MkQStepL _ _ _ a1 b1 _ pa1 pb1 pxl))
      (let-match erased sam (MkQStepL _ _ _ am bm _ pam pbm pxlm))
      (let-match erased sb (MkQStepL _ _ _ c3 c4 _ pc3 pc4 py2))
      (let-match erased sbm (MkQStepL _ _ _ cm3 cm4 _ pcm3 pcm4 pym2))
      (let-match erased (nth-fn (Nat) nc xl c c3 pc pc3) (Refl _ _))
      (let-match erased (nth-fn (Nat) ec c c2 c4 pc2 pc4) (Refl _ _))
      (let-match erased (nth-fn (Nat) nm xlm cm cm3 pcm pcm3) (Refl _ _))
      (let-match erased (nth-fn (Nat) em cm c2m cm4 pc2m pcm4) (Refl _ _))
      (let-match erased rs (RespCons _ _ _ _ _ hc2 rs1))
      (let-match erased ak (AKCons _ _ _ kc2 ak1))
      (let ((erased ka1) (erased ha1) (erased _)) (node2 dc dm p pe pm y ym a1 am ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kp kpe ppe cp hp py pa1 pym pam))
      (let ((erased w0) (erased z) (erased w1) (erased hw0) (erased paz) (erased kz) (erased hz) (erased fz))
        (kin-face dc dm a1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ka1))
      (let-match erased (nth-fn (Nat) hl a1 am w0 ha1 hw0) (Refl _ _))
      (let ((erased pb1a)) (kin-plain dc dm a1 b1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ka1 pb1))
      (let ((erased la1)) (kin-lt dc dm a1 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en ka1))
      (let ((erased nzb)) (nfe dc b1 a1 z ec nc fc hc (img-lt dc a1 b1 ec cnf cpe la1 pb1) pb1a paz))
      (let-match erased (nth-fn (Nat) nc xl c z pc (kin-cubic dc dm z b1 xl ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kz nzb pxl)) (Refl _ _))
      (let ((erased lam)) (img-lt dm ym am nm mni mpn lym pam))
      (let ((erased qbm) (erased _)) (plain-eq dm am bm em plm lam pbm))
      (let ((erased nwb)) (nfe dm bm am w1 em nm fm hm (img-lt dm am bm em mnf mpe lam pbm) qbm fz))
      (let ((erased lw1)) (under-nth hl c w1 dm uh hz))
      (let ((erased z2) (erased pz2) (erased pz3) (erased _) (erased _)) (cubic-eq dm w1 bm nm cum lw1 nwb))
      (let-match erased (nth-fn (Nat) nm bm xlm z2 pxlm pz2) (Refl _ _))
      (let-match erased (nth-fn (Nat) nm xlm cm w1 pcm pz3) (Refl _ _))
      (let ((erased pcc2)) (kin-plain dc dm c c2 ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kz pc2))
      (let ((erased qcm) (erased _)) (plain-eq dm cm c2m em plm lw1 pc2m))
      (let ((erased cc2)) (MkCentral ec em hl c2 c c2m cm pcc2 hc2 hz qcm))
      (let ((erased r1) (erased rt1) (erased ak2))
        (hc-walk dc dm c2 c c2m y2 ym2 ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 tc as1 atc sm1 tm asm1 atm st en q1 kc2 kz pcc2 cc2 hc2 py2 pym2 wk1 wm1 rs1 ak1))
      (values (ACCons ec em hl s1 tc c2 cc2 r1) rt1 ak2))
    ((WSRR _ _ _ s1 _ as1 _ _ _ xr y2 q1 sa _ sb wk1)
      (let-match erased wm (WSRR _ _ _ sm1 _ asm1 _ _ _ xrm ym2 _ sam _ sbm wm1))
      (let-match erased sa (MkQStepR _ _ _ ue _ pue pxr))
      (let-match erased sam (MkQStepR _ _ _ uem _ puem pxrm))
      (let-match erased sb (MkQStepR _ _ _ v _ pv py2))
      (let-match erased sbm (MkQStepR _ _ _ vm _ pvm pym2))
      (let-match erased rs (RespCons _ _ _ _ _ hxr rs1))
      (let-match erased ak (AKCons _ _ _ kxr ak1))
      (let ((erased kue) (erased hue)) (kin-fmi dc dm ue p pm uem ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc p y ue ec nc fc hc lp py pue) kp hp
        (fen dm pm ym uem em nm fm hm lpm pym puem)))
      (let ((erased lue)) (kin-lt dc dm ue ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kue))
      (let ((erased luem)) (img-lt dm ym uem em mnf mpe lym puem))
      (let ((erased kv) (erased hv)) (kin-fmi dc dm v ue uem vm ec nc fc ksc rc s0c em nm fm ksm s0m hl st en (fen dc ue xr v ec nc fc hc lue pxr pv) kue hue
        (fen dm uem xrm vm em nm fm hm luem pxrm pvm)))
      (let ((erased cxr)) (MkCentral ec em hl xr v xrm vm pv hxr hv pvm))
      (let ((erased r1) (erased rt1) (erased ak2))
        (hc-walk dc dm v xr vm y2 ym2 ec nc fc ksc rc s0c em nm fm ksm s0m hl s1 tc as1 atc sm1 tm asm1 atm st en q1 kv kxr
          (kin-plain dc dm xr v ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kxr pv)
          (cen-edge dc dm xr v ec nc fc ksc rc s0c em nm fm ksm s0m hl st en kxr cxr pv) hv py2 pym2 wk1 wm1 rs1 ak1))
      (values (ACCons ec em hl s1 tc xr cxr r1) rt1 ak2))))
