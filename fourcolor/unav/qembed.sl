    -> (erased (Respects hl t t2) r) (erased (AllKin st t) a))
  (match erased w _
    ((WS0 _ _ _ _ _ _) (let-match erased w2 (WS0 _ _ _ _ _ _)) (values rs ak))
    ((WS1 _ _ _ _ _ _ _ _)
