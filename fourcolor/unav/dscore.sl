; z = edge (node (edge (node y))).
(def-adts $ (InvF2 : ((List (Nat)) e n) ((Nat) y z) -> Type)
  enum
  (many MkInvF2 : (erased (List (Nat)) e n) (erased (Nat) y a1 a2 a3 z) (erased (Nth (Nat) n y a1) p1) (erased (Nth (Nat) e a1 a2) p2)
      (erased (Nth (Nat) n a2 a3) p3) (erased (Nth (Nat) e a3 z) p4) -> (InvF2 e n y z)))

; qs: the rules of rs with m subparts.
(def-adts $ (OfSize : ((Nat) m) ((List (List (Sub))) rs qs) -> Type)
  enum
  (many OSNil : (erased (Nat) m) -> (OfSize m (Nil (List (Sub))) (Nil (List (Sub)))))
  (many OSIn : (erased (Nat) m) (erased (List (Sub)) r) (erased (List (List (Sub))) rs qs) (erased (Length (Sub) r m) l) (erased (OfSize m rs qs) rest)
      -> (OfSize m (Cons (List (Sub)) r rs) (Cons (List (Sub)) r qs)))
  (many OSOut : (erased (Nat) m l) (erased (List (Sub)) r) (erased (List (List (Sub))) rs qs) (erased (Length (Sub) r l) pl) (erased (Apart (Nat) Lt l m) ne)
      (erased (OfSize m rs qs) rest) -> (OfSize m (Cons (List (Sub)) r rs) qs)))

; c rules of drs fit exactly at inv_face2 y.
(def-adts $ (DScore1 : ((List (Nat)) e n f ks) ((List (List (Sub))) drs) ((Nat) y c) -> Type)
  enum
  (many MkDScore1 : (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs qs) (erased (Nat) y z a c) (erased (List (Sec)) os)
      (erased (InvF2 e n y z) iv) (erased (Nth (Nat) ks z a) pa) (erased (ObsAt e f ks z a os) ob) (erased (OfSize a drs qs) sz) (erased (Count os qs c) k)
      -> (DScore1 e n f ks drs y c)))

(def-fns _ $ (many of-size-c : (many (Nat) m) (subterm many (List (List (Sub))) rs) -> (many (List (List (Sub))) qs) (erased (OfSize m rs qs) w))
  (let-match many rs (Cons _ r rest) ((Nil _) (values rs (OSNil m))))
  (let ((many qs) (erased w)) (notail $ of-size-c m rest))
  (let ((many l) (erased pl)) (list-count _ r))
  (match many (nat-eq l m) _
    ((Equal _ _ _) (values (Cons _ r qs) (OSIn m r rest qs pl w)))
    ((Unequal _ _ _ _ ne) (values qs (OSOut m l r rest qs pl ne w)))))

(def-fns _ $ (erased count-fn : (erased (List (Sec)) os) (erased (List (List (Sub))) rs) (erased (Nat) c1 c2) (subterm erased (Count os rs c1) k1)
    (erased (Count os rs c2) k2) -> (erased (Eq (Nat) c1 c2) e))
  (match erased k1 _
    ((CNil _) (let-match erased k2 (CNil _)) (Refl _ (Zero)))
    ((CYes _ r rs1 c3 f1 k3)
      (let-match erased k2 (CYes _ _ _ c4 _ k4) (absurd (CNo _ _ _ _ b _) (fit-bad os r f1 b)))
      (let-match erased (count-fn os rs1 c3 c4 k3 k4) (Refl _ _))
      (Refl _ c1))
    ((CNo _ r rs1 _ b k3)
      (let-match erased k2 (CNo _ _ _ _ _ k4) (absurd (CYes _ _ _ _ f2 _) (fit-bad os r f2 b)))
      (count-fn os rs1 c1 c2 k3 k4))))

(def-fns _ $ (erased length-fn2 : (erased (List (Sub)) r) (erased (Nat) a b) (erased (Length (Sub) r a) p) (erased (Length (Sub) r b) q) -> (erased (Eq (Nat) a b) e))
  (length-fn _ r a b p q))

(def-fns _ $ (erased of-size-fn : (erased (Nat) m) (erased (List (List (Sub))) rs qs qs2) (subterm erased (OfSize m rs qs) p) (erased (OfSize m rs qs2) q)
    -> (erased (Eq (List (List (Sub))) qs qs2) e))
  (match erased p _
    ((OSNil _) (let-match erased q (OSNil _)) (Refl _ qs))
    ((OSIn _ r rs1 qs1 l p1)
      (let-match erased q (OSIn _ _ _ qs3 _ q1)
        (absurd (OSOut _ l2 _ _ _ pl2 ne _) (let-match erased (length-fn2 r m l2 l pl2) (Refl _ _)) (apart-irrefl m ne)))
      (let-match erased (of-size-fn m rs1 qs1 qs3 p1 q1) (Refl _ _))
      (Refl _ qs))
    ((OSOut _ l r rs1 _ pl ne p1)
      (let-match erased q (OSOut _ _ _ _ _ _ _ q1)
        (absurd (OSIn _ _ _ _ l2 _) (let-match erased (length-fn2 r l m pl l2) (Refl _ _)) (apart-irrefl l ne)))
      (of-size-fn m rs1 qs qs2 p1 q1))))

(def-fns _ $ (erased fans-fn : (erased (List (Nat)) e f ks fs fs2) (erased (Nat) z m) (subterm erased (FansAt e f ks z m fs) p) (erased (FansAt e f ks z m fs2) q)
    -> (erased (Eq (List (Nat)) fs fs2) r))
  (let-match erased p (FAS _ _ _ _ u a z1 m1 fs1 pu pa pz p1) ((FAZ _ _ _ _) (let-match erased q (FAZ _ _ _ _)) (Refl _ fs)))
  (let-match erased q (FAS _ _ _ _ u2 a2 z2 _ fs3 pu2 pa2 pz2 q1))
  (let-match erased (nth-fn _ e z u u2 pu pu2) (Refl _ _))
  (let-match erased (nth-fn _ ks u a a2 pa pa2) (Refl _ _))
  (let-match erased (nth-fn _ f z z1 z2 pz pz2) (Refl _ _))
  (let-match erased (fans-fn e f ks fs1 fs3 z1 m1 p1 q1) (Refl _ _))
  (Refl _ fs))

(def-fns _ $ (erased sec-fn : (erased (List (Nat)) e f ks) (erased (Nat) y) (erased (Sec) o o2) (erased (SecAt e f ks y o) p) (erased (SecAt e f ks y o2) q)
    -> (erased (Eq (Sec) o o2) r))
  (let-match erased p (MkSecAt _ _ _ _ z a w u h z3 m fs pz pa pw pu ph p3 mo pfs))
  (let-match erased q (MkSecAt _ _ _ _ z2 a2 w2 u2 h2 z4 m2 fs2 pz2 pa2 pw2 pu2 ph2 p4 mo2 pfs2))
  (let-match erased (nth-fn _ e y z z2 pz pz2) (Refl _ _))
  (let-match erased (nth-fn _ ks z a a2 pa pa2) (Refl _ _))
  (let-match erased (iter-fn f 2 z w w2 pw pw2) (Refl _ _))
  (let-match erased (nth-fn _ e w u u2 pu pu2) (Refl _ _))
  (let-match erased (nth-fn _ ks u h h2 ph ph2) (Refl _ _))
  (let-match erased (iter-fn f 3 z z3 z4 p3 p4) (Refl _ _))
  (let-match erased (monus-fn a 5 m m2 mo mo2) (Refl _ _))
  (let-match erased (fans-fn e f ks fs fs2 z3 m pfs pfs2) (Refl _ _))
  (Refl _ o))

(def-fns _ $ (erased obs-fn : (erased (List (Nat)) e f ks) (erased (Nat) y n) (erased (List (Sec)) os os2) (subterm erased (ObsAt e f ks y n os) p)
    (erased (ObsAt e f ks y n os2) q) -> (erased (Eq (List (Sec)) os os2) r))
  (let-match erased p (OACons _ _ _ _ y1 n1 o os1 so py p1) ((OANil _ _ _ _) (let-match erased q (OANil _ _ _ _)) (Refl _ os)))
  (let-match erased q (OACons _ _ _ _ y2 _ o2 os3 so2 py2 q1))
  (let-match erased (nth-fn _ f y y1 y2 py py2) (Refl _ _))
  (let-match erased (sec-fn e f ks y o o2 so so2) (Refl _ _))
  (let-match erased (obs-fn e f ks y1 n1 os1 os3 p1 q1) (Refl _ _))
  (Refl _ os))

(def-fns _ $ (erased invf2-fn : (erased (List (Nat)) e n) (erased (Nat) y z z2) (erased (InvF2 e n y z) p) (erased (InvF2 e n y z2) q) -> (erased (Eq (Nat) z z2) r))
  (let-match erased p (MkInvF2 _ _ _ a1 a2 a3 _ p1 p2 p3 p4))
  (let-match erased q (MkInvF2 _ _ _ b1 b2 b3 _ q1 q2 q3 q4))
  (let-match erased (nth-fn _ n y a1 b1 p1 q1) (Refl _ _))
  (let-match erased (nth-fn _ e a1 a2 b2 p2 q2) (Refl _ _))
  (let-match erased (nth-fn _ n a2 a3 b3 p3 q3) (Refl _ _))
  (nth-fn _ e a3 z z2 p4 q4))

(def-fns _ $ (erased enf-cancel : (erased (Nat) d w w1) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt w d) lw) (erased (Nth (Nat) f w w1) pw)
    -> (erased (Nat) v) (erased (Nth (Nat) n w1 v) pn) (erased (Nth (Nat) e v w) pe))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let ((erased v) (erased pv)) (nth-exists _ nf d w (respects-length-inv e nf ids d kf (iota-length d ids io)) lw))
  (values v (respects-nth n f nf w w1 v cnf pw pv) (respects-nth e nf ids w v w kf pv (iota-nth d w ids io lw))))

(def-fns _ $ (erased invf2-face2 : (erased (Nat) d y z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt y d) ly) (erased (Iter f 2 y z) it)
    -> (erased (InvF2 e n z y) r))
  (let-match erased it (ItS _ _ _ y1 _ p1 it1))
  (let-match erased it1 (ItS _ _ _ z1 _ p2 it2))
  (let-match erased it2 (ItZ _ _))
  (let ((erased ye) (erased yn) (erased yf) (erased _) (erased _) (erased _) (erased _) (erased pyf) (erased lf)) (hyper-step d y e n f h ly))
  (let-match erased (nth-fn _ f y yf y1 pyf p1) (Refl _ _))
  (let ((erased v1) (erased q1) (erased q2)) (enf-cancel d y1 z e n f h lf p2))
  (let ((erased v0) (erased q3) (erased q4)) (enf-cancel d y y1 e n f h ly p1))
  (MkInvF2 e n z v1 y1 v0 y q1 q2 q3 q4))

(def-fns _ $ (erased dbound1-eq : (erased (Nat) d y a z c c2) (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs qs) (erased (List (Sec)) os)
    (erased (Geo d e n f ks) g) (erased (Lt y d) ly) (erased (Nth (Nat) ks y a) pa) (erased (ObsAt e f ks y a os) ob) (erased (Iter f 2 y z) it)
    (erased (DScore1 e n f ks drs z c) ds) (erased (OfSize a drs qs) sz) (erased (Count os qs c2) k) -> (erased (Eq (Nat) c c2) r))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let-match erased ds (MkDScore1 _ _ _ _ _ qs2 _ z2 a2 _ os2 iv pa2 ob2 sz2 k2))
  (let-match erased (invf2-fn e n z z2 y iv (invf2-face2 d y z e n f h ly it)) (Refl _ _))
  (let-match erased (nth-fn _ ks y a2 a pa2 pa) (Refl _ _))
  (let-match erased (obs-fn e f ks y a os2 os ob2 ob) (Refl _ _))
  (let-match erased (of-size-fn a drs qs2 qs sz2 sz) (Refl _ _))
  (count-fn os qs c c2 k2 k))
