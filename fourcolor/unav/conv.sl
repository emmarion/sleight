          (in-out nhub u iu o))))))

(def-fns _ $ (erased tgt-at-mk : (erased (Nat) d w nhub) (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs rt) (erased (Geo d e n f ks) g)
