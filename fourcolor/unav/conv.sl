; converse_part of part.v certified, and fitp_converse: a rule fitting exactly at a dart y makes its converse fit the
; dart t with face^2 t = edge (face^2 y), the hub across the third spoke; from it the target bound TgtAll of
; hubsound.sl. Load after pwsound.sl.

(unary 3 2)

; Through a composite: h (g (p x)) = x when gp = g . p and h . gp is the identity.
(def-fns _ $ (erased resp3 : (erased (Nat) d x a b) (erased (List (Nat)) g p h gp ids) (erased (Respects g p gp) r1) (erased (Respects h gp ids) r2)
    (erased (Iota d ids) io) (erased (Length (Nat) p d) lp) (erased (Lt x d) lx) (erased (Nth (Nat) p x a) pa) (erased (Nth (Nat) g a b) pb)
    -> (erased (Nth (Nat) h b x) r))
  (let ((erased b2) (erased pb2)) (nth-exists _ gp d x (respects-length g p gp d r1 lp) lx))
  (let-match erased (nth-fn _ g a b2 b (respects-nth g p gp x a b2 r1 pa pb2) pb) (Refl _ _))
  (respects-nth h gp ids x b x r2 pb2 (iota-nth d x ids io lx)))

(def-fns _ $ (erased nfe : (erased (Nat) d x a b) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x d) lx)
    (erased (Nth (Nat) e x a) pa) (erased (Nth (Nat) f a b) pb) -> (erased (Nth (Nat) n b x) r))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let ((erased le) (erased _) (erased _)) (hyper-lengths d e n f h))
  (resp3 d x a b f e n fe ids cfe ke io le lx pa pb))

(def-fns _ $ (erased fen : (erased (Nat) d x a b) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x d) lx)
    (erased (Nth (Nat) n x a) pa) (erased (Nth (Nat) e a b) pb) -> (erased (Nth (Nat) f b x) r))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let ((erased _) (erased ln) (erased _)) (hyper-lengths d e n f h))
  (resp3 d x a b e n f en ids cen kn io ln lx pa pb))

(def-fns _ $ (erased enf : (erased (Nat) d x a b) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Lt x d) lx)
    (erased (Nth (Nat) f x a) pa) (erased (Nth (Nat) n a b) pb) -> (erased (Nth (Nat) e b x) r))
  (let-match erased h (MkHypermap _ _ _ _ ids fe en nf io cfe ke cen kn cnf kf))
  (let ((erased _) (erased _) (erased lf)) (hyper-lengths d e n f h))
  (resp3 d x a b n f e nf ids cnf kf io lf lx pa pb))

(def-fns _ $ (erased img-lt : (erased (Nat) d x y) (erased (List (Nat)) p q) (erased (HPerm d p q) pm) (erased (Lt x d) lx) (erased (Nth (Nat) p x y) px)
    -> (erased (Lt y d) r))
  (let ((erased y2) (erased py2) (erased ly2)) (perm-nth d x p q pm lx))
  (let-match erased (nth-fn _ p x y y2 px py2) (Refl _ _))
  ly2)

(def-fns _ $ (erased img-lt-inv : (erased (Nat) d u s) (erased (List (Nat)) p q) (erased (HPerm d p q) pm) (erased (Lt s d) ls) (erased (Nth (Nat) p u s) pu)
    -> (erased (Lt u d) r))
  (img-lt d s u q p (perm-sym d p q pm) ls (perm-inv d u s p q pm pu)))

; The one local fact of plain cubic maps used here: for a hub dart x with spokes s = edge x and s1 = edge (face x),
; the dart u before s along its face has edge u = face s1.
(def-fns _ $ (erased g2 : (erased (Nat) d x x1 s s1 u) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt x d) lx)
    (erased (Nth (Nat) f x x1) p1) (erased (Nth (Nat) e x s) ps) (erased (Nth (Nat) e x1 s1) ps1) (erased (Nth (Nat) f u s) pu)
    -> (erased (Nat) v) (erased (Nth (Nat) e u v) r1) (erased (Nth (Nat) f s1 v) r2))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased lx1)) (img-lt d x x1 f fi pf lx p1))
  (let ((erased c) (erased pc) (erased lc)) (perm-nth d x1 n ni pn lx1))
  (let ((erased pc1) (erased _)) (plain-eq d c x e pl lc (enf d x x1 c e n f h lx p1 pc)))
  (let-match erased (nth-fn _ e x c s pc1 ps) (Refl _ _))
  (let ((erased c2) (erased pc2) (erased pc3) (erased _) (erased _)) (cubic-eq d x1 s n cu lx1 pc))
  (let ((erased ls)) (img-lt d x s e nf pe lx ps))
  (let ((erased lc2)) (img-lt d s c2 n ni pn ls pc2))
  (let ((erased b) (erased pb) (erased _)) (perm-nth d c2 e nf pe lc2))
  (let-match erased (perm-inj d b u s f fi pf (fen d s c2 b e n f h ls pc2 pb) pu) (Refl _ _))
  (let ((erased pu2) (erased _)) (plain-eq d c2 u e pl lc2 pb))
  (let ((erased ls1)) (img-lt d x1 s1 e nf pe lx1 ps1))
  (let ((erased gg) (erased pg) (erased _)) (perm-nth d s1 f fi pf ls1))
  (let-match erased (perm-inj d gg c2 x1 n ni pn (nfe d x1 s1 gg e n f h lx1 ps1 pg) pc3) (Refl _ _))
  (values c2 pu2 pg))

; Two steps back from the spoke s: edge t = face (edge (face^2 s1)).
(def-fns _ $ (erased g1 : (erased (Nat) d x x1 s s1 t u0) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt x d) lx)
    (erased (Nth (Nat) f x x1) p1) (erased (Nth (Nat) e x s) ps) (erased (Nth (Nat) e x1 s1) ps1) (erased (Nth (Nat) f t u0) pt) (erased (Nth (Nat) f u0 s) pu)
    -> (erased (Nat) a w v vv) (erased (Nth (Nat) f s1 a) r1) (erased (Nth (Nat) f a w) r2) (erased (Nth (Nat) e w v) r3) (erased (Nth (Nat) e t vv) r4)
    (erased (Nth (Nat) f v vv) r5))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased a) (erased q1) (erased q2)) (g2 d x x1 s s1 u0 e n f ks g lx p1 ps ps1 pu))
  (let ((erased lx1)) (img-lt d x x1 f fi pf lx p1))
  (let ((erased ls1)) (img-lt d x1 s1 e nf pe lx1 ps1))
  (let ((erased la)) (img-lt d s1 a f fi pf ls1 q2))
  (let ((erased w) (erased pw) (erased lw)) (perm-nth d a f fi pf la))
  (let ((erased v) (erased pv) (erased _)) (perm-nth d w e nf pe lw))
  (let ((erased q3) (erased _)) (plain-eq d u0 a e pl (img-lt-inv d u0 s f fi pf (img-lt d x s e nf pe lx ps) pu) q1))
  (let ((erased vv) (erased q4) (erased q5)) (g2 d a w u0 v t e n f ks g la pw q3 pv pt))
  (values a w v vv q2 pw pv q4 q5))

; One step on from the spoke s = edge x: face (edge (face s)) = edge v for the hub dart v before x.
(def-fns _ $ (erased g3 : (erased (Nat) d x s v0 w0) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt x d) lx)
    (erased (Nth (Nat) e x s) ps) (erased (Nth (Nat) f v0 x) pv) (erased (Nth (Nat) e v0 w0) pw)
    -> (erased (Nat) a c) (erased (Nth (Nat) f s a) r1) (erased (Nth (Nat) e a c) r2) (erased (Nth (Nat) f c w0) r3))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased lv)) (img-lt-inv d v0 x f fi pf lx pv))
  (let ((erased lw)) (img-lt d v0 w0 e nf pe lv pw))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth d w0 fi f (perm-sym d f fi pf) lw))
  (let ((erased pu2)) (perm-inv d w0 u fi f (perm-sym d f fi pf) pu))
  (let ((erased a) (erased q1) (erased q2)) (g2 d v0 x w0 s u e n f ks g lv pv pw ps pu2))
  (let ((erased q3) (erased _)) (plain-eq d u a e pl lu q1))
  (values a u q2 q3 pu2))

(def-fns _ $ (erased arity-same : (erased (Nat) d w v k a b) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt w d) lw)
    (erased (Nth (Nat) ks w a) pa) (erased (Iter f k w v) it) (erased (Nth (Nat) ks v b) pb) -> (erased (Eq (Nat) a b) r))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (let ((erased v2) (erased it2) (erased _) (erased pa2)) (face-walk d w a e n f ks h ol k lw pa))
  (let-match erased (iter-fn f k w v2 v it2 it) (Refl _ _))
  (nth-fn _ ks v a b pa2 pb))

(def-fns _ $ (erased one-step : (erased (List (Nat)) f) (erased (Nat) x y) (erased (Nth (Nat) f x y) p) -> (erased (Iter f 1 x y) r))
  (ItS f (Zero) x y y p (ItZ f y)))

(def-fns _ $ (erased cyc-back : (erased (Nat) d v z z2 k j a) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt v d) lv)
    (erased (Nth (Nat) ks v a) pa) (erased (Iter f k v z) p1) (erased (Iter f j z z2) p2) (erased (Add k j a) ad) -> (erased (Eq (Nat) z2 v) r))
  (let-match erased g (MkGeo _ _ _ _ _ _ _ _ ol _))
  (iter-fn f a v z2 v (iter-add f k j a v z z2 p1 p2 ad) (face-cycle d v a f ks ol lv pa)))

(def-fns _ $ (erased two-step : (erased (List (Nat)) f) (erased (Nat) x y z) (erased (Nth (Nat) f x y) p) (erased (Nth (Nat) f y z) q) -> (erased (Iter f 2 x z) r))
  (ItS f 1 x y z p (one-step f y z q)))

(def-fns _ $ (erased iter-lt : (erased (Nat) d k x z) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (erased (Lt x d) lx) (subterm erased (Iter f k x z) it)
    -> (erased (Lt z d) r))
  (let-match erased it (ItS _ k1 _ y _ py it1) ((ItZ _ _) lx))
  (iter-lt d k1 y z f fi pf (img-lt d x y f fi pf lx py) it1))

; A sector with its darts: spoke z = edge y, w = face^2 z, hat dart u = edge w, and z3 = face^3 z.
(def-adts $ (SecD : ((List (Nat)) e f ks) ((Nat) y z w u z3) ((Sec) o) -> Type)
  enum
  (many MkSecD : (erased (List (Nat)) e f ks) (erased (Nat) y z a w u h z3 m) (erased (List (Nat)) fs) (erased (Nth (Nat) e y z) pz)
      (erased (Nth (Nat) ks z a) pa) (erased (Iter f 2 z w) pw) (erased (Nth (Nat) e w u) pu) (erased (Nth (Nat) ks u h) ph) (erased (Iter f 3 z z3) p3)
      (erased (Monus a 5 m) mo) (erased (FansAt e f ks z3 m fs) pfs) -> (SecD e f ks y z w u z3 (MkSec a h fs))))

(def-fns _ $ (erased sec-d : (erased (List (Nat)) e f ks) (erased (Nat) y) (erased (Sec) o) (erased (SecAt e f ks y o) so)
    -> (erased (Nat) z w u z3) (erased (SecD e f ks y z w u z3 o) r))
  (let-match erased so (MkSecAt _ _ _ _ z a w u h z3 m fs pz pa pw pu ph p3 mo pfs))
  (values z w u z3 (MkSecD e f ks y z a w u h z3 m fs pz pa pw pu ph p3 mo pfs)))

(def-fns _ $ (erased iter3 : (erased (List (Nat)) f) (erased (Nat) x a c) (erased (Nth (Nat) f x a) p) (erased (Iter f 2 a c) q) -> (erased (Iter f 3 x c) r))
  (ItS f 2 x a c p q))

; face^3 z is the image of face^2 z.
(def-fns _ $ (erased f3-next : (erased (List (Nat)) f) (erased (Nat) z w z3) (erased (Iter f 2 z w) pw) (erased (Iter f 3 z z3) p3) -> (erased (Nth (Nat) f w z3) r))
  (let-match erased pw (ItS _ _ _ b1 _ pb1 pw1))
  (let-match erased pw1 (ItS _ _ _ b2 _ pb2 pw2))
  (let-match erased pw2 (ItZ _ _))
  (let-match erased p3 (ItS _ _ _ c1 _ pc1 p31))
  (let-match erased (nth-fn _ f z b1 c1 pb1 pc1) (Refl _ _))
  (let-match erased p31 (ItS _ _ _ c2 _ pc2 p32))
  (let-match erased (nth-fn _ f b1 b2 c2 pb2 pc2) (Refl _ _))
  (let-match erased p32 (ItS _ _ _ c3 _ pc3 p33))
  (let-match erased p33 (ItZ _ _))
  pc3)

; The target's first spoke: the hat face of the rule's fourth sector.
(def-fns _ $ (erased tsec0 : (erased (Nat) d y2 y3 s2 t t1 sg wt ut zt sp w3 hd z3 a0 h0 aa hh) (erased (List (Nat)) e n f ks fs0 ff) (erased (Geo d e n f ks) g)
    (erased (Lt y2 d) ly) (erased (Nth (Nat) f y2 y3) p23) (erased (Nth (Nat) e y2 s2) ps2) (erased (Nth (Nat) f t t1) pt) (erased (Nth (Nat) f t1 s2) pt1)
    (erased (SecD e f ks t sg wt ut zt (MkSec a0 h0 fs0)) st) (erased (SecD e f ks y3 sp w3 hd z3 (MkSec aa hh ff)) s3) -> (erased (Eq (Nat) hh a0) r))
  (let-match erased st (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psg pa0 _ _ _ _ _ _))
  (let-match erased s3 (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psp _ pw3 phd ph3 _ _ _))
  (let ((erased a) (erased w) (erased v) (erased vv) (erased q1) (erased q2) (erased q3) (erased q4) (erased q5)) (g1 d y2 y3 s2 sp t t1 e n f ks g ly p23 ps2 psp pt pt1))
  (let-match erased (iter-fn f 2 sp w w3 (two-step f sp a w q1 q2) pw3) (Refl _ _))
  (let-match erased (nth-fn _ e w v hd q3 phd) (Refl _ _))
  (let-match erased (nth-fn _ e t vv sg q4 psg) (Refl _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased lsp)) (img-lt d y3 sp e nf pe (img-lt d y2 y3 f fi pf ly p23) psp))
  (let ((erased lhd)) (img-lt d w v e nf pe (iter-lt d 2 sp w f fi pf lsp pw3) q3))
  (arity-same d v vv 1 hh a0 e n f ks g lhd ph3 (one-step f v vv q5) pa0))

; The target's second sector: its spoke face is the rule's fourth spoke face, entered one dart on; so its w is the
; rule's z3 there.
(def-fns _ $ (erased tsec1 : (erased (Nat) d y2 y3 s2 t1 sg wt ut zt sp w3 hd z3 a1 h1 aa hh) (erased (List (Nat)) e n f ks fs1 ff) (erased (Geo d e n f ks) g)
    (erased (Lt y2 d) ly) (erased (Nth (Nat) f y2 y3) p23) (erased (Nth (Nat) e y2 s2) ps2) (erased (Nth (Nat) f t1 s2) pt1)
    (erased (SecD e f ks t1 sg wt ut zt (MkSec a1 h1 fs1)) st) (erased (SecD e f ks y3 sp w3 hd z3 (MkSec aa hh ff)) s3)
    -> (erased (Eq (Nat) aa a1) r) (erased (Nth (Nat) f sp sg) q0) (erased (Eq (Nat) wt z3) q1) (erased (Nth (Nat) f z3 zt) q2))
  (let-match erased st (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psg pa1 pwt _ _ pzt _ _))
  (let-match erased s3 (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psp pa _ _ _ p3r _ _))
  (let ((erased v) (erased q1) (erased q2)) (g2 d y2 y3 s2 sp t1 e n f ks g ly p23 ps2 psp pt1))
  (let-match erased (nth-fn _ e t1 v sg q1 psg) (Refl _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased lsp)) (img-lt d y3 sp e nf pe (img-lt d y2 y3 f fi pf ly p23) psp))
  (let ((erased e1)) (arity-same d sp sg 1 aa a1 e n f ks g lsp pa (one-step f sp sg q2) pa1))
  (let-match erased (iter-fn f 3 sp wt z3 (iter3 f sp sg wt q2 pwt) p3r) (Refl _ _))
  (let ((erased q3)) (f3-next f sg wt zt pwt pzt))
  (values e1 q2 (Refl _ wt) q3))

; Two steps back from the rule's fourth spoke, in its face of k = j + 2 darts, edge (face^j sp) is next to the rule's
; fifth hat face.
(def-fns _ $ (erased back2 : (erased (Nat) d y3 y4 sp z q k j a4 h4 hq) (erased (List (Nat)) e n f ks fs4) (erased (Nat) sp4 w4 hd4 z34)
    (erased (Geo d e n f ks) g) (erased (Lt y3 d) ly) (erased (Nth (Nat) f y3 y4) p34) (erased (Nth (Nat) e y3 sp) psp) (erased (Nth (Nat) ks sp k) pk)
    (erased (Iter f j sp z) pz) (erased (Add j 2 k) a) (erased (Nth (Nat) e z q) pq) (erased (Nth (Nat) ks q hq) ph)
    (erased (SecD e f ks y4 sp4 w4 hd4 z34 (MkSec a4 h4 fs4)) s4) -> (erased (Eq (Nat) h4 hq) r))
  (let-match erased s4 (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psp4 _ pw4 phd4 ph4 _ _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased lsp)) (img-lt d y3 sp e nf pe ly psp))
  (let ((erased lz)) (iter-lt d j sp z f fi pf lsp pz))
  (let ((erased z1) (erased p1) (erased l1)) (perm-nth d z f fi pf lz))
  (let ((erased z2) (erased p2) (erased _)) (perm-nth d z1 f fi pf l1))
  (let-match erased (cyc-back d sp z z2 j 2 k e n f ks g lsp pk pz (two-step f z z1 z2 p1 p2) a) (Refl _ _))
  (let ((erased b) (erased w) (erased v) (erased vv) (erased q1) (erased q2) (erased q3) (erased q4) (erased q5)) (g1 d y3 y4 sp sp4 z z1 e n f ks g ly p34 psp psp4 p1 p2))
  (let-match erased (iter-fn f 2 sp4 w w4 (two-step f sp4 b w q1 q2) pw4) (Refl _ _))
  (let-match erased (nth-fn _ e w v hd4 q3 phd4) (Refl _ _))
  (let-match erased (nth-fn _ e z vv q q4 pq) (Refl _ _))
  (let ((erased lsp4)) (img-lt d y4 sp4 e nf pe (img-lt d y3 y4 f fi pf ly p34) psp4))
  (let ((erased lhd)) (img-lt d w v e nf pe (iter-lt d 2 sp4 w f fi pf lsp4 pw4) q3))
  (arity-same d v vv 1 h4 hq e n f ks g lhd ph4 (one-step f v vv q5) ph))

; The spoke arities of a sector list.
(def-adts $ (SpkL : ((List (Sec)) os) ((List (Nat)) fs) -> Type)
  enum
  (many SpkNil : -> (SpkL (Nil (Sec)) (Nil (Nat))))
  (many SpkCons : (erased (Nat) a h) (erased (List (Nat)) hf fs) (erased (List (Sec)) os) (erased (SpkL os fs) rest)
      -> (SpkL (Cons (Sec) (MkSec a h hf) os) (Cons (Nat) a fs))))

(def-fns _ $ (erased fans-spk : (erased (List (Nat)) e f ks fs) (erased (Nat) z m) (erased (List (Sec)) os) (subterm erased (ObsAt e f ks z m os) ob)
    (erased (FansAt e f ks z m fs) fa) -> (erased (SpkL os fs) r))
  (let-match erased ob (OACons _ _ _ _ z1 m1 o os1 so pz ob1) ((OANil _ _ _ _) (let-match erased fa (FAZ _ _ _ _)) (SpkNil)))
  (let-match erased fa (FAS _ _ _ _ u a z2 _ fs1 pu pa pz2 fa1))
  (let-match erased (nth-fn _ f z z1 z2 pz pz2) (Refl _ _))
  (let-match erased so (MkSecAt _ _ _ _ u2 _ _ _ h _ _ hf pu2 pa2 _ _ _ _ _ _))
  (let-match erased (nth-fn _ e z u u2 pu pu2) (Refl _ _))
  (let-match erased (nth-fn _ ks u a _ pa pa2) (Refl _ _))
  (SpkCons a h hf fs1 os1 (fans-spk e f ks fs1 z1 m1 os1 ob1 fa1)))

; The target's third sector is the rule's hub: arity n, hat the rule's fifth spoke, fans the rule's spokes from the sixth.
(def-fns _ $ (erased tsec2 : (erased (Nat) d y2 y3 y4 y5 s2 sg wt ut zt sp4 w4 hd4 z34 nn a2 h2 a4 h4 m5) (erased (List (Nat)) e n f ks fs2 fs4)
    (erased (List (Sec)) os5) (erased (Geo d e n f ks) g) (erased (Lt y2 d) ly) (erased (Nth (Nat) ks y2 nn) pnn)
    (erased (Nth (Nat) f y2 y3) p23) (erased (Nth (Nat) f y3 y4) p34) (erased (Nth (Nat) f y4 y5) p45) (erased (Nth (Nat) e y2 s2) ps2)
    (erased (SecD e f ks s2 sg wt ut zt (MkSec a2 h2 fs2)) st) (erased (SecD e f ks y4 sp4 w4 hd4 z34 (MkSec a4 h4 fs4)) s4)
    (erased (ObsAt e f ks y5 m5 os5) ob5) (erased (Monus nn 5 m5) mo5)
    -> (erased (Eq (Nat) a2 nn) r1) (erased (Eq (Nat) h2 a4) r2) (erased (SpkL os5 fs2) r3))
  (let-match erased st (MkSecD _ _ _ _ _ _ _ _ _ _ m _ psg pa2 pwt put ph2 pzt mo pfs))
  (let-match erased s4 (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psp4 pa4 _ _ _ _ _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased q1) (erased _)) (plain-eq d y2 s2 e pl ly ps2))
  (let-match erased (nth-fn _ e s2 sg y2 psg q1) (Refl _ _))
  (let-match erased (nth-fn _ ks y2 a2 nn pa2 pnn) (Refl _ _))
  (let-match erased (iter-fn f 2 y2 wt y4 pwt (two-step f y2 y3 y4 p23 p34)) (Refl _ _))
  (let-match erased (nth-fn _ e y4 ut sp4 put psp4) (Refl _ _))
  (let-match erased (nth-fn _ ks sp4 h2 a4 ph2 pa4) (Refl _ _))
  (let-match erased (nth-fn _ f y4 zt y5 (f3-next f y2 y4 zt pwt pzt) p45) (Refl _ _))
  (let-match erased (monus-fn nn 5 m m5 mo mo5) (Refl _ _))
  (values (Refl _ a2) (Refl _ h2) (fans-spk e f ks fs2 y5 m os5 ob5 pfs)))

; The target's fourth sector: the rule's second spoke face, its hat the rule's first spoke face; its z3 is the rule's
; w of the second sector.
(def-fns _ $ (erased tsec3 : (erased (Nat) d y0 y1 y2 s2 t3 sg wt ut zt sp1 w1 hd1 z31 sp0 w0 hd0 z30 a3 h3 a1 h1 a0 h0) (erased (List (Nat)) e n f ks fs3 fs1 fs0)
    (erased (Geo d e n f ks) g) (erased (Lt y0 d) ly) (erased (Nth (Nat) f y0 y1) p01) (erased (Nth (Nat) f y1 y2) p12) (erased (Nth (Nat) e y2 s2) ps2)
    (erased (Nth (Nat) f s2 t3) pt3) (erased (SecD e f ks t3 sg wt ut zt (MkSec a3 h3 fs3)) st) (erased (SecD e f ks y1 sp1 w1 hd1 z31 (MkSec a1 h1 fs1)) s1)
    (erased (SecD e f ks y0 sp0 w0 hd0 z30 (MkSec a0 h0 fs0)) s0)
    -> (erased (Eq (Nat) a3 a1) r1) (erased (Eq (Nat) h3 a0) r2) (erased (Nth (Nat) f sg sp1) r3) (erased (Eq (Nat) zt w1) r4))
  (let-match erased st (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psg pa3 pwt put ph3 pzt _ _))
  (let-match erased s1 (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psp1 pa1 pw1 _ _ _ _ _))
  (let-match erased s0 (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psp0 pa0 _ _ _ _ _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased ly1)) (img-lt d y0 y1 f fi pf ly p01))
  (let ((erased ly2)) (img-lt d y1 y2 f fi pf ly1 p12))
  (let ((erased a) (erased c) (erased q1) (erased q2) (erased q3)) (g3 d y2 s2 y1 sp1 e n f ks g ly2 ps2 p12 psp1))
  (let-match erased (nth-fn _ f s2 a t3 q1 pt3) (Refl _ _))
  (let-match erased (nth-fn _ e t3 c sg q2 psg) (Refl _ _))
  (let ((erased lsg)) (img-lt d t3 sg e nf pe (img-lt d s2 t3 f fi pf (img-lt d y2 s2 e nf pe ly2 ps2) pt3) psg))
  (let ((erased e1)) (arity-same d sg sp1 1 a3 a1 e n f ks g lsg pa3 (one-step f sg sp1 q3) pa1))
  (let-match erased pwt (ItS _ _ _ b1 _ pb1 pwt1))
  (let-match erased (nth-fn _ f sg b1 sp1 pb1 q3) (Refl _ _))
  (let-match erased pwt1 (ItS _ _ _ b2 _ pb2 pwt2))
  (let-match erased pwt2 (ItZ _ _))
  (let ((erased a') (erased c') (erased q4) (erased q5) (erased q6)) (g3 d y1 sp1 y0 sp0 e n f ks g ly1 psp1 p01 psp0))
  (let-match erased (nth-fn _ f sp1 a' wt q4 pb2) (Refl _ _))
  (let-match erased (nth-fn _ e wt c' ut q5 put) (Refl _ _))
  (let ((erased lsp1)) (img-lt d y1 sp1 e nf pe ly1 psp1))
  (let ((erased lut)) (img-lt d wt ut e nf pe (img-lt d sp1 wt f fi pf lsp1 q4) put))
  (let ((erased e2)) (arity-same d ut sp0 1 h3 a0 e n f ks g lut ph3 (one-step f ut sp0 q6) pa0))
  (values e1 e2 q3 (iter-fn f 3 sg zt w1 pzt (iter3 f sg sp1 w1 q3 pw1))))

; The target's fifth sector: the rule's third hat face; its hat dart lies just after edge v, where face^3 v is the rule's
; second spoke.
(def-fns _ $ (erased tsec4 : (erased (Nat) d y2 s2 t3 t4 sg3 sg wt ut zt w2 hd2 z32 sp1 a4 h4 a2 h2) (erased (List (Nat)) e n f ks fs4 fs2)
    (erased (Geo d e n f ks) g) (erased (Lt y2 d) ly) (erased (Nth (Nat) e y2 s2) ps2) (erased (Nth (Nat) f s2 t3) pt3) (erased (Nth (Nat) f t3 t4) pt4)
    (erased (Nth (Nat) e t3 sg3) ps3) (erased (Nth (Nat) f sg3 sp1) pq) (erased (SecD e f ks t4 sg wt ut zt (MkSec a4 h4 fs4)) st)
    (erased (SecD e f ks y2 s2 w2 hd2 z32 (MkSec a2 h2 fs2)) s2d)
    -> (erased (Eq (Nat) a4 h2) r1) (erased (Nat) v ev) (erased (Iter f 3 v sp1) r2) (erased (Nth (Nat) e v ev) r3) (erased (Nth (Nat) f ut ev) r4)
    (erased (Eq (Nat) t4 w2) r5))
  (let-match erased st (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ psg pa4 pwt put _ _ _ _))
  (let-match erased s2d (MkSecD _ _ _ _ _ _ _ _ _ _ _ _ _ _ pw2 phd2 ph2 _ _ _))
  (let-match erased g (MkGeo _ _ _ _ _ h pl _ _ _))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let-match erased (iter-fn f 2 s2 t4 w2 (two-step f s2 t3 t4 pt3 pt4) pw2) (Refl _ _))
  (let-match erased (nth-fn _ e t4 sg hd2 psg phd2) (Refl _ _))
  (let-match erased (nth-fn _ ks hd2 a4 h2 pa4 ph2) (Refl _ _))
  (let ((erased ls2)) (img-lt d y2 s2 e nf pe ly ps2))
  (let ((erased lt3)) (img-lt d s2 t3 f fi pf ls2 pt3))
  (let ((erased lt4)) (img-lt d t3 t4 f fi pf lt3 pt4))
  (let ((erased al) (erased be) (erased q1) (erased q2) (erased q3)) (g3 d t4 sg t3 sg3 e n f ks g lt4 psg pt4 ps3))
  (let-match erased pwt (ItS _ _ _ b1 _ pb1 pwt1))
  (let-match erased (nth-fn _ f sg b1 al pb1 q1) (Refl _ _))
  (let-match erased pwt1 (ItS _ _ _ b2 _ pb2 pwt2))
  (let-match erased pwt2 (ItZ _ _))
  (let ((erased lsg)) (img-lt d t4 sg e nf pe lt4 psg))
  (let ((erased lal)) (img-lt d sg al f fi pf lsg q1))
  (let ((erased lbe)) (img-lt d al be e nf pe lal q2))
  (let ((erased q4) (erased _)) (plain-eq d al be e pl lal q2))
  (let ((erased v) (erased pv) (erased lv)) (perm-nth d be fi f (perm-sym d f fi pf) lbe))
  (let ((erased pv2)) (perm-inv d be v fi f (perm-sym d f fi pf) pv))
  (let ((erased ev) (erased pev) (erased _)) (perm-nth d v e nf pe lv))
  (let ((erased a2') (erased c2) (erased q5) (erased q6) (erased q7)) (g3 d be al v ev e n f ks g lbe q4 pv2 pev))
  (let-match erased (nth-fn _ f al a2' wt q5 pb2) (Refl _ _))
  (let-match erased (nth-fn _ e wt c2 ut q6 put) (Refl _ _))
  (values (Refl _ a4) v ev (ItS f 2 v be sp1 pv2 (two-step f be sg3 sp1 q3 pq)) pev q7 (Refl _ t4)))

; converse_part's four pieces, case by case, over a rule's sectors 0 and 1 (C4), 2 (C5), 3 and 4 (C12) and 5 on (C3).
(def-adts $ (C4 : ((Sub) x0 x1) ((Rg) h45) ((Pc) o) -> Type)
  enum
  (many C4No : (erased (Sub) x0 x1) -> (C4 x0 x1 (MkRg 5 9) (PcNil)))
  (many C4A : (erased (Rg) h34 hx s4) -> (C4 (MkSub h34 hx (Nil (Rg))) (MkSub s4 (MkRg 5 9) (Nil (Rg))) (MkRg 5 9)
      (PcPre (Cons (Sub) (MkSub s4 h34 (Nil (Rg))) (Nil (Sub))))))
  (many C4B5 : (erased (Rg) h34 hx f41) -> (C4 (MkSub h34 hx (Nil (Rg))) (MkSub (MkRg 5 5) f41 (Nil (Rg))) f41
      (PcPre (Cons (Sub) (MkSub (MkRg 5 5) h34 (Nil (Rg))) (Nil (Sub))))))
  (many C4B6 : (erased (Rg) h34 hx f41) -> (C4 (MkSub h34 hx (Nil (Rg))) (MkSub (MkRg 6 6) f41 (Nil (Rg))) (MkRg 5 9)
      (PcPre (Cons (Sub) (MkSub (MkRg 6 6) h34 (Cons (Rg) f41 (Nil (Rg)))) (Nil (Sub))))))
  (many C4B7 : (erased (Rg) h34 hx f41) -> (C4 (MkSub h34 hx (Nil (Rg))) (MkSub (MkRg 7 7) f41 (Nil (Rg))) (MkRg 5 9)
      (PcPre (Cons (Sub) (MkSub (MkRg 7 7) h34 (Cons (Rg) f41 (Cons (Rg) (MkRg 5 9) (Nil (Rg))))) (Nil (Sub))))))
  (many C4F6 : (erased (Rg) h34 hx f41 g1) -> (C4 (MkSub h34 hx (Nil (Rg))) (MkSub (MkRg 6 6) f41 (Cons (Rg) g1 (Nil (Rg)))) g1
      (PcPre (Cons (Sub) (MkSub (MkRg 6 6) h34 (Cons (Rg) f41 (Nil (Rg)))) (Nil (Sub))))))
  (many C4F7 : (erased (Rg) h34 hx f41 g1 g2) -> (C4 (MkSub h34 hx (Nil (Rg))) (MkSub (MkRg 7 7) f41 (Cons (Rg) g1 (Cons (Rg) g2 (Nil (Rg))))) g2
      (PcPre (Cons (Sub) (MkSub (MkRg 7 7) h34 (Cons (Rg) f41 (Cons (Rg) g1 (Nil (Rg))))) (Nil (Sub)))))))

(def-adts $ (C5 : ((Sub) x2) ((Rg) h45 u) ((List (Sub)) q) -> Type)
  enum
  (many C5No : (erased (Sub) x2) (erased (Rg) h45) -> (C5 x2 h45 (MkRg 5 9) (Nil (Sub))))
  (many C5A : (erased (Rg) s s5 h45) -> (C5 (MkSub s s5 (Nil (Rg))) h45 s (Cons (Sub) (MkSub s5 h45 (Nil (Rg))) (Nil (Sub)))))
  (many C5B : (erased (Rg) s5 s6 s7 h45) -> (C5 (MkSub (MkRg 7 7) s5 (Cons (Rg) s6 (Cons (Rg) s7 (Nil (Rg))))) h45 (MkRg 7 7)
      (Cons (Sub) (MkSub s5 h45 (Nil (Rg))) (Cons (Sub) (MkSub s6 (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub s7 (MkRg 5 9) (Nil (Rg))) (Nil (Sub))))))))

(def-adts $ (C12 : ((Sub) x3 x4) ((Rg) h23) ((Pc) o) -> Type)
  enum
  (many C12No : (erased (Sub) x3 x4) -> (C12 x3 x4 (MkRg 5 9) (PcNil)))
  (many C12F6 : (erased (Rg) b x0 c d) -> (C12 (MkSub (MkRg 6 6) b (Cons (Rg) x0 (Nil (Rg)))) (MkSub c d (Nil (Rg))) c
      (PcPre (Cons (Sub) (MkSub b (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub (MkRg 6 6) x0 (Cons (Rg) d (Nil (Rg)))) (Nil (Sub)))))))
  (many C12F7 : (erased (Rg) b x0 x1 c d) -> (C12 (MkSub (MkRg 7 7) b (Cons (Rg) x0 (Cons (Rg) x1 (Nil (Rg))))) (MkSub c d (Nil (Rg))) c
      (PcPre (Cons (Sub) (MkSub b (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub (MkRg 7 7) x0 (Cons (Rg) x1 (Cons (Rg) d (Nil (Rg))))) (Nil (Sub)))))))
  (many C12P : (erased (Rg) a b c) -> (C12 (MkSub a b (Nil (Rg))) (MkSub c (MkRg 5 9) (Nil (Rg))) c
      (PcPre (Cons (Sub) (MkSub b (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub a (MkRg 5 9) (Nil (Rg))) (Nil (Sub)))))))
  (many C12P5 : (erased (Rg) b c d) -> (C12 (MkSub (MkRg 5 5) b (Nil (Rg))) (MkSub c d (Nil (Rg))) c
      (PcPre (Cons (Sub) (MkSub b (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub (MkRg 5 5) d (Nil (Rg))) (Nil (Sub)))))))
  (many C12P6 : (erased (Rg) b c d) -> (C12 (MkSub (MkRg 6 6) b (Nil (Rg))) (MkSub c d (Nil (Rg))) c
      (PcPre (Cons (Sub) (MkSub b (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub (MkRg 6 6) (MkRg 5 9) (Cons (Rg) d (Nil (Rg)))) (Nil (Sub)))))))
  (many C12P7 : (erased (Rg) b c d) -> (C12 (MkSub (MkRg 7 7) b (Nil (Rg))) (MkSub c d (Nil (Rg))) c
      (PcPre (Cons (Sub) (MkSub b (MkRg 5 9) (Nil (Rg))) (Cons (Sub) (MkSub (MkRg 7 7) (MkRg 5 9) (Cons (Rg) (MkRg 5 9) (Cons (Rg) d (Nil (Rg)))))
        (Nil (Sub))))))))

(def-adts $ (C3 : ((Rg) h23) ((List (Sub)) rest) ((Pc) o) -> Type)
  enum
  (many C3No : (erased (Rg) h23) (erased (List (Sub)) rest) -> (C3 h23 rest (PcNil)))
  (many C3N0 : (erased (Rg) h23) -> (C3 h23 (Nil (Sub)) (PcPre (Cons (Sub) (MkSub (MkRg 5 5) h23 (Nil (Rg))) (Nil (Sub))))))
  (many C3N1 : (erased (Rg) h23 s5 h5) -> (C3 h23 (Cons (Sub) (MkSub s5 h5 (Nil (Rg))) (Nil (Sub))) (PcPre (Cons (Sub) (MkSub (MkRg 6 6) h23 (Nil (Rg))) (Nil (Sub))))))
  (many C3N2a : (erased (Rg) h23 h5 h6) -> (C3 h23 (Cons (Sub) (MkSub (MkRg 5 9) h5 (Nil (Rg))) (Cons (Sub) (MkSub (MkRg 5 9) h6 (Nil (Rg))) (Nil (Sub))))
      (PcPre (Cons (Sub) (MkSub (MkRg 7 7) h23 (Nil (Rg))) (Nil (Sub))))))
  (many C3N2b : (erased (Rg) h23 s5 h5 s6 h6) -> (C3 h23 (Cons (Sub) (MkSub s5 h5 (Nil (Rg))) (Cons (Sub) (MkSub s6 h6 (Nil (Rg))) (Nil (Sub))))
      (PcPre (Cons (Sub) (MkSub (MkRg 7 7) h23 (Cons (Rg) s5 (Cons (Rg) s6 (Nil (Rg))))) (Nil (Sub))))))
  (many C3N3 : (erased (Rg) h23 s5 h5 s6 h6 s7 h7) -> (C3 h23 (Cons (Sub) (MkSub s5 h5 (Nil (Rg))) (Cons (Sub) (MkSub s6 h6 (Nil (Rg)))
      (Cons (Sub) (MkSub s7 h7 (Nil (Rg))) (Nil (Sub))))) (PcPre (Cons (Sub) (MkSub (MkRg 8 8) h23 (Cons (Rg) s5 (Cons (Rg) s6 (Cons (Rg) s7 (Nil (Rg))))))
      (Nil (Sub)))))))

(def-adts $ (PcA : ((Pc) c) ((List (Sub)) q r) -> Type)
  enum
  (many PcANil : (erased (List (Sub)) q) -> (PcA (PcNil) q (Nil (Sub))))
  (many PcAPre : (erased (List (Sub)) pre q r) (erased (LApp (Sub) pre q r) a) -> (PcA (PcPre pre) q r)))

(def-adts $ (ConvOk : ((List (Sub)) p) ((Rg) u) ((List (Sub)) r) -> Type)
  enum
  (many CvShort : (erased (List (Sub)) p) -> (ConvOk p (MkRg 5 9) (Nil (Sub))))
  (many CvOk : (erased (Sub) x0 x1 x2 x3 x4) (erased (List (Sub)) rest q5 r4 r3 r) (erased (Rg) h45 h23 u) (erased (Pc) o4 o12 o3)
      (erased (C4 x0 x1 h45 o4) c4) (erased (C5 x2 h45 u q5) c5) (erased (C12 x3 x4 h23 o12) c12) (erased (C3 h23 rest o3) c3)
      (erased (PcA o4 q5 r4) a4) (erased (PcA o3 r4 r3) a3) (erased (PcA o12 r3 r) a12)
      -> (ConvOk (Cons (Sub) x0 (Cons (Sub) x1 (Cons (Sub) x2 (Cons (Sub) x3 (Cons (Sub) x4 rest))))) u r)))

(def-fns _ $ (many rg-is : (many (Rg) r) (many (Nat) a b) -> (many (Bool) ok) (erased (IfT ok (Eq (Rg) r (MkRg a b))) w))
  (let-match many r (MkRg c dd))
  (let-match many (nat-eq c a) (Equal _ _ _) (else (values (BFalse) (IfF _))))
  (let-match many (nat-eq dd b) (Equal _ _ _) (else (values (BFalse) (IfF _))))
  (values (BTrue) (IfY _ (Refl _ r))))

(def-fns _ $ (many conv4-c : (many (Sub) x0 x1) -> (many (Rg) h45) (many (Pc) o) (erased (C4 x0 x1 h45 o) w))
  (let-match many x0 (MkSub h34 hx fx))
  (let-match many x1 (MkSub s4 f41 fb))
  (let-match many fx (Nil _) (else (values r59 (PcNil) (C4No x0 x1))))
  (match many fb _
    ((Cons _ g1 gs)
      (match many gs _
        ((Nil _)
          (let ((many ok) (erased w)) (rg-is s4 6 6))
          (let-match many ok (BTrue) ((BFalse) (values r59 (PcNil) (C4No x0 x1))))
          (let-match erased w (IfY _ e1))
          (let-match erased e1 (Refl _ _))
          (values g1 (PcPre $ Cons _ (MkSub (MkRg 6 6) h34 (Cons _ f41 (Nil _))) (Nil _)) (C4F6 h34 hx f41 g1)))
        ((Cons _ g2 gs2)
          (let-match many gs2 (Nil _) (else (values r59 (PcNil) (C4No x0 x1))))
          (let ((many ok) (erased w)) (rg-is s4 7 7))
          (let-match many ok (BTrue) ((BFalse) (values r59 (PcNil) (C4No x0 x1))))
          (let-match erased w (IfY _ e1))
          (let-match erased e1 (Refl _ _))
          (values g2 (PcPre $ Cons _ (MkSub (MkRg 7 7) h34 (Cons _ f41 (Cons _ g1 (Nil _)))) (Nil _)) (C4F7 h34 hx f41 g1 g2)))))
    ((Nil _)
      (let ((many ok0) (erased w0)) (rg-is f41 5 9))
      (match many ok0 _
        ((BTrue) (let-match erased w0 (IfY _ e0)) (let-match erased e0 (Refl _ _))
          (values r59 (PcPre $ Cons _ (MkSub s4 h34 (Nil _)) (Nil _)) (C4A h34 hx s4)))
        ((BFalse)
          (let ((many ok5) (erased w5)) (rg-is s4 5 5))
          (let-match many ok5 (BFalse) ((BTrue) (let-match erased w5 (IfY _ e5)) (let-match erased e5 (Refl _ _))
            (values f41 (PcPre $ Cons _ (MkSub (MkRg 5 5) h34 (Nil _)) (Nil _)) (C4B5 h34 hx f41))))
          (let ((many ok6) (erased w6)) (rg-is s4 6 6))
          (let-match many ok6 (BFalse) ((BTrue) (let-match erased w6 (IfY _ e6)) (let-match erased e6 (Refl _ _))
            (values r59 (PcPre $ Cons _ (MkSub (MkRg 6 6) h34 (Cons _ f41 (Nil _))) (Nil _)) (C4B6 h34 hx f41))))
          (let ((many ok7) (erased w7)) (rg-is s4 7 7))
          (let-match many ok7 (BTrue) ((BFalse) (values r59 (PcNil) (C4No x0 x1))))
          (let-match erased w7 (IfY _ e7))
          (let-match erased e7 (Refl _ _))
          (values r59 (PcPre $ Cons _ (MkSub (MkRg 7 7) h34 (Cons _ f41 (Cons _ r59 (Nil _)))) (Nil _)) (C4B7 h34 hx f41)))))))

(def-fns _ $ (many conv5-c : (many (Sub) x2) (many (Rg) h45) -> (many (Rg) u) (many (List (Sub)) q) (erased (C5 x2 h45 u q) w))
  (let-match many x2 (MkSub s s5 fs))
  (let-match many fs (Cons _ s6 r1) ((Nil _) (values s (Cons _ (MkSub s5 h45 (Nil _)) (Nil _)) (C5A s s5 h45))))
  (let-match many r1 (Cons _ s7 r2) ((Nil _) (values r59 (Nil _) (C5No x2 h45))))
  (let-match many r2 (Nil _) (else (values r59 (Nil _) (C5No x2 h45))))
  (let ((many ok) (erased w)) (rg-is s 7 7))
  (let-match many ok (BTrue) ((BFalse) (values r59 (Nil _) (C5No x2 h45))))
  (let-match erased w (IfY _ e1))
  (let-match erased e1 (Refl _ _))
  (values (MkRg 7 7) (Cons _ (MkSub s5 h45 (Nil _)) $ Cons _ (MkSub s6 r59 (Nil _)) $ Cons _ (MkSub s7 r59 (Nil _)) (Nil _)) (C5B s5 s6 s7 h45)))

(def-fns _ $ (many conv12-c : (many (Sub) x3 x4) -> (many (Rg) h23) (many (Pc) o) (erased (C12 x3 x4 h23 o) w))
  (let-match many x4 (MkSub c dd fy))
  (let-match many fy (Nil _) (else (values r59 (PcNil) (C12No x3 x4))))
  (let-match many x3 (MkSub a b fa))
