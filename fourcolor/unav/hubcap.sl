(def-adts $ (Pc : -> Type)
  enum
  (many PcPre : (many (List (Sub)) pre) -> (Pc))
  (many PcNil : -> (Pc)))

(def-adts $ (Ctx : -> Type)
  enum
  (many MkCtx : (many (Nat) nhub) (many (Qzt) qt) (many (List (List (Sub))) rs rt) -> (Ctx)))

(def-adts $ (Hc : -> Type)
  enum
  (many HC1 : (many (Nat) i) (many (Z) b) -> (Hc))
  (many HC2 : (many (Nat) i j) (many (Z) b) -> (Hc)))

(def-fns _ $ (many pc-apply : (many (Pc) c) (many (List (Sub)) q) -> (many (List (Sub)) r))
  (match many c _ ((PcPre pre) (cat _ pre q)) ((PcNil) (Nil _))))

(def-fns _ $ (many rg-eq : (many (Rg) r) (many (Nat) a b) -> (many (Bool) e))
  (let-match many r (MkRg c d))
  (andb (nat-eqb a c) (nat-eqb b d)))

(def-fns _ $ (many pcons-s : (many (Rg) s) -> (many (Sub) x))
  (pc s r59))

(def-fns _ $ (many one-sub : (many (Sub) x) -> (many (Pc) c))
  (PcPre $ Cons _ x $ Nil _))

(def-fns _ $ (many conv12 : (many (List (Sub)) p) -> (many (Rg) h23) (many (Pc) q))
  (let-match many p (Cons _ x p1) ((Nil _) (values r59 (PcNil))))
  (let-match many p1 (Cons _ y _) ((Nil _) (values r59 (PcNil))))
  (let-match many y (MkSub c d fy))
  (let-match many fy (Nil _) (else (values r59 (PcNil))))
  (let-match many x (MkSub a b fa))
  (let ((many pre)) (Cons _ (pcons-s b) $ Nil _))
  (let-match many fa (Nil _)
    ((Cons _ x0 ys)
      (let-match many (leb (size _ fa) 2) (BTrue) ((BFalse) (values r59 (PcNil))))
      (values c (PcPre $ cat _ pre $ Cons _ (pf x0 $ cat _ ys $ Cons _ d $ Nil _) $ Nil _))))
  (let-match many (rg-eq d 5 9) (BFalse) ((BTrue) (values c (PcPre $ cat _ pre $ Cons _ (pcons-s a) $ Nil _))))
  (let ((many last)) (bif _ (rg-eq a 5 5) (pc a d) (bif _ (rg-eq a 6 6) (pf r59 $ Cons _ d $ Nil _) (pf r59 $ Cons _ r59 $ Cons _ d $ Nil _))))
  (let-match many (orb (rg-eq a 5 5) (orb (rg-eq a 6 6) (rg-eq a 7 7))) (BTrue) ((BFalse) (values r59 (PcNil))))
  (values c (PcPre $ cat _ pre $ Cons _ last $ Nil _)))

(def-fns _ $ (many all-plain : (subterm many (List (Sub)) p) -> (many (Bool) b))
  (let-match many p (Cons _ x rest) ((Nil _) (BTrue)))
  (match many (nilp _ (get-fans p)) _ ((BTrue) (tail $ all-plain rest)) ((BFalse) (BFalse))))

(def-fns _ $ (many spokes : (subterm many (List (Sub)) p) -> (many (List (Rg)) ss))
  (let-match many p (Cons _ _ rest) ((Nil _) (Nil _)))
  (Cons _ (get-spoke p) $ notail $ spokes rest))

(def-fns _ $ (many conv3 : (many (Rg) h23) (many (List (Sub)) p) -> (many (Pc) q))
  (let ((many n) (many ss)) (values (size _ p) (spokes p)))
  (let-match many (andb (all-plain p) (leb n 3)) (BTrue) ((BFalse) (PcNil)))
  (let-match many n (Succ n1) ((Zero) (one-sub $ pc (MkRg 5 5) h23)))
  (let-match many n1 (Succ n2) ((Zero) (one-sub $ pc (MkRg 6 6) h23)))
  (let-match many n2 (Zero) ((Succ _) (one-sub $ pf h23 ss)))
  (let-match many ss (Cons _ f31 r1) ((Nil _) (PcNil)))
  (let-match many r1 (Cons _ f32 _) ((Nil _) (PcNil)))
  (one-sub $ bif _ (andb (rg-eq f31 5 9) (rg-eq f32 5 9)) (pc (MkRg 7 7) h23) (pf h23 ss)))

(def-fns _ $ (many conv4 : (many (List (Sub)) p) -> (many (Rg) h45) (many (Pc) q))
  (let-match many p (Cons _ x p1) ((Nil _) (values r59 (PcNil))))
  (let-match many p1 (Cons _ y _) ((Nil _) (values r59 (PcNil))))
  (let-match many x (MkSub h34 _ fx))
  (let-match many fx (Nil _) (else (values r59 (PcNil))))
  (let-match many y (MkSub s4 f41 fb))
  (let-match many fb (Nil _)
    ((Cons _ g gs)
      (let-match many gs (Nil _) ((Cons _ g2 gs2)
        (let-match many gs2 (Nil _) (else (values r59 (PcNil))))
        (values g2 (one-sub $ pf h34 $ Cons _ f41 $ Cons _ g $ Nil _))))
      (values g (one-sub $ pf h34 $ Cons _ f41 $ Nil _))))
  (let-match many (rg-eq f41 5 9) (BFalse) ((BTrue) (values r59 (one-sub $ pc s4 h34))))
  (let-match many (rg-eq s4 5 5) (BFalse) ((BTrue) (values f41 (one-sub $ pc s4 h34))))
  (let-match many (rg-eq s4 6 6) (BFalse) ((BTrue) (values r59 (one-sub $ pf h34 $ Cons _ f41 $ Nil _))))
  (let-match many (rg-eq s4 7 7) (BFalse) ((BTrue) (values r59 (one-sub $ pf h34 $ Cons _ f41 $ Cons _ r59 $ Nil _))))
  (values r59 (PcNil)))

(def-fns _ $ (many conv5 : (many (Rg) h45) (many (List (Sub)) p) -> (many (Rg) u) (many (List (Sub)) q))
  (let-match many p (Cons _ x _) ((Nil _) (values r59 (Nil _))))
  (let-match many x (MkSub s s5 fs))
  (let-match many fs (Cons _ s6 r1) ((Nil _) (values s (Cons _ (pc s5 h45) $ Nil _))))
  (let-match many r1 (Cons _ s7 r2) ((Nil _) (values r59 (Nil _))))
  (let-match many r2 (Nil _) (else (values r59 (Nil _))))
  (values (MkRg 7 7) (Cons _ (pc s5 h45) $ Cons _ (pcons-s s6) $ Cons _ (pcons-s s7) $ Nil _)))

(def-fns _ $ (many converse-part : (many (List (Sub)) p) -> (many (Rg) u) (many (List (Sub)) q))
  (let ((many h45) (many q4)) (conv4 p))
  (let ((many u) (many q5)) (conv5 h45 (drop _ 2 p)))
  (let ((many h23) (many q12)) (conv12 (drop _ 3 p)))
  (values u (pc-apply q12 $ pc-apply (conv3 h23 (drop _ 5 p)) $ pc-apply q4 q5)))

(def-fns _ $ (many iter-rot : (subterm many (Nat) k) (many (Nat) n) (many (List (Sub)) p) -> (many (List (Sub)) q))
  (let-match many k (Succ k1) ((Zero) p))
  (tail $ iter-rot k1 n (rot _ n p)))

(def-fns _ $ (many symmetrize : (subterm many (List (List (Sub))) rs) -> (many (List (List (Sub))) r))
  (let-match many rs (Cons _ p rest) ((Nil _) rs))
  (let ((many p1)) (iter-rot 5 (monus (size _ p) 1) (mirror-part p)))
  (let ((many psr)) (Cons _ p $ notail $ symmetrize rest))
  (bif _ (rel-sub (cmp-part p p1)) psr (Cons _ p1 psr)))

(def-fns _ $ (many pick-source : (many (Nat) n) (subterm many (List (List (Sub))) rs) -> (many (List (List (Sub))) r))
  (let-match many rs (Cons _ p rest) ((Nil _) rs))
  (let ((many tr)) (notail $ pick-source n rest))
  (bif _ (nat-eqb (size _ p) n) (Cons _ p tr) tr))

(def-fns _ $ (many pick-target : (many (Nat) n) (subterm many (List (List (Sub))) rs) -> (many (List (List (Sub))) r))
  (let-match many rs (Cons _ p rest) ((Nil _) rs))
  (let ((many u) (many p1)) (converse-part p))
  (let ((many tr)) (notail $ pick-target n rest))
  (bif _ (mem-rg u n) (Cons _ p1 tr) tr))

(def-fns _ $ (many make-ctx : (many (Nat) n) (many (Qzt) qt) (many (List (List (Sub))) base) -> (many (Ctx) c))
  (let ((many rs)) (symmetrize base))
  (MkCtx n qt (pick-source n rs) (pick-target n rs)))

(def-fns _ $ (many sort-rec : (many (List (Sub)) p) (many (Nat) n) (many (List (List (Sub))) acc) (subterm many (List (List (Sub))) rs) ->
    (many (Nat) m) (many (List (List (Sub))) out))
  (let-match many rs (Cons _ r rest) ((Nil _) (values n acc)))
  (match many (cmp-part p r) _
    ((PSub) (tail $ sort-rec p (Succ n) acc rest))
    ((PStr) (tail $ sort-rec p n (Cons _ r acc) rest))
    ((PDis) (tail $ sort-rec p n acc rest))))

(def-fns _ $ (many sort-drules : (many (List (Sub)) p) (many (List (List (Sub))) rs) -> (many (Nat) m) (many (List (List (Sub))) out))
  (sort-rec p 0 (Nil _) rs))

(def-fns _ $ (many redp : (many (Ctx) c) (many (List (Sub)) p) -> (many (Bool) b))
  (let-match many c (MkCtx _ qt _ _))
  (redpart qt p))

(def-fns _ $ (many cdb1 : (many (Ctx) c) (many (List (Sub)) p) (many (List (List (Sub))) rs) (many (Nat) ns) (subterm many (Nat) m) -> (many (Bool) b))
  (let-match many m (Succ m1) ((Zero) (BFalse)))
  (let-match many rs (Cons _ r rs1) ((Nil _) (BTrue)))
  (let-match many (nat-ltb (size _ rs1) ns) (BFalse) ((BTrue) (BTrue)))
  (let ((many p1)) (meet-part p r))
  (let ((many dns) (many rs2)) (sort-drules p1 rs1))
  (let ((many (Bool) ok)) (match many (monus ns dns) _ ((Succ ns1) (notail $ cdb1 c p1 rs2 ns1 m1)) ((Zero) (redp c p1))))
  (and ok (tail $ cdb1 c p rs1 ns m1)))

(def-fns _ $ (many check-dbound1 : (many (Ctx) c) (many (List (Sub)) p) (many (Nat) ns) -> (many (Bool) b))
  (let-match many c (MkCtx _ _ rs _))
  (cdb1 c p rs ns (Succ $ size _ rs)))

(def-fns _ $ (many check-unfit : (many (List (Sub)) p) (subterm many (List (List (Sub))) ru) -> (many (Bool) b))
  (let-match many ru (Cons _ r rest) ((Nil _) (BFalse)))
  (match many (rel-sub (cmp-part p r)) _ ((BTrue) (BTrue)) ((BFalse) (tail $ check-unfit p rest))))

(def-fns _ $ (many cdb2 : (many (Ctx) c) (many (List (Sub)) p) (many (List (List (Sub))) rt rs ru) (many (Nat) nt) (subterm many (Nat) m) -> (many (Bool) b))
  (let-match many m (Succ m1) ((Zero) (BFalse)))
  (let-match many rt (Cons _ r rt1) ((Nil _) (BTrue)))
  (let-match many (nat-ltb (size _ rt1) nt) (BFalse) ((BTrue) (BTrue)))
  (let ((many p1)) (meet-part p r))
  (let ((many (Bool) ok))
    (match many (check-unfit p1 ru) _
      ((BTrue) (BTrue))
      ((BFalse)
        (let ((many dnt) (many rt2)) (sort-drules p1 rt1))
        (let ((many dns) (many rs1)) (sort-drules p1 rs))
        (match many (monus (nat-add dns nt) dnt) _
          ((Succ nt1) (notail $ cdb2 c p1 rt2 rs1 ru nt1 m1))
          ((Zero) (redp c p1))))))
  (and ok (tail $ cdb2 c p rt1 rs (Cons _ r ru) nt m1)))

(def-fns _ $ (many check-dbound2 : (many (Ctx) c) (many (List (Sub)) p) (many (Z) b) -> (many (Bool) r))
  (let-match many c (MkCtx _ _ rs rt))
  (let ((many dnt) (many rt1)) (sort-drules p rt))
  (let ((many dns) (many rs1)) (sort-drules p rs))
  (let ((many ok) (many nt)) (z-nat $ z-add (MkZ dns dnt) b))
  (and ok (cdb2 c p rt1 rs1 (Nil _) nt (Succ $ Succ $ size _ rt1))))

(def-fns _ $ (many c2db2 : (many (Ctx) c) (many (List (Sub)) p1 p2) (many (List (List (Sub))) rt1 rs1 ru1 rt2 rs2 ru2) (many (Nat) i nt) (subterm many (Nat) m) -> (many (Bool) b))
  (let-match many m (Succ m1) ((Zero) (BFalse)))
  (let-match many c (MkCtx nhub _ _ _))
  (let-match many rt1 (Cons _ r rt3)
    ((Nil _) (match many rt2 _ ((Nil _) (BTrue)) (else (tail $ c2db2 c p2 p1 rt2 rs2 ru2 rt1 rs1 ru1 (monus nhub i) nt m1)))))
  (let-match many (nat-ltb (nat-add (size _ rt3) (size _ rt2)) nt) (BFalse) ((BTrue) (BTrue)))
  (let ((many q1)) (meet-part p1 r))
  (let ((many q2)) (rot _ i q1))
  (let ((many (Bool) ok))
    (match many (or (check-unfit q1 ru1) (check-unfit q2 ru2)) _
      ((BTrue) (BTrue))
      ((BFalse)
        (let ((many dnt1) (many rt4)) (sort-drules q1 rt3))
        (let ((many dns1) (many rs3)) (sort-drules q1 rs1))
        (let ((many dnt2) (many rt5)) (sort-drules q2 rt2))
        (let ((many dns2) (many rs4)) (sort-drules q2 rs2))
        (match many (monus (nat-add dns1 $ nat-add dns2 nt) (nat-add dnt1 dnt2)) _
          ((Succ nt1) (notail $ c2db2 c q1 q2 rt4 rs3 ru1 rt5 rs4 ru2 i nt1 m1))
          ((Zero) (redp c q1))))))
  (and ok (tail $ c2db2 c p1 p2 rt3 rs1 (Cons _ r ru1) rt2 rs2 ru2 i nt m1)))

(def-fns _ $ (many check-2dbound2 : (many (Ctx) c) (many (List (Sub)) p1) (many (Nat) i) (many (Z) b) -> (many (Bool) r))
  (let-match many c (MkCtx _ _ rs rt))
  (let ((many p2)) (rot _ i p1))
  (let ((many dnt1) (many rt1)) (sort-drules p1 rt))
  (let ((many dns1) (many rs1)) (sort-drules p1 rs))
  (let ((many dnt2) (many rt2)) (sort-drules p2 rt))
  (let ((many dns2) (many rs2)) (sort-drules p2 rs))
  (let ((many ok) (many nt)) (z-nat $ z-add (MkZ (nat-add dns1 dns2) (nat-add dnt1 dnt2)) b))
  (and ok (c2db2 c p1 p2 rt1 rs1 (Nil _) rt2 rs2 (Nil _) i nt (nat-add (size _ rt1) $ nat-add (size _ rt2) 3))))

(def-fns _ $ (many incr-nth : (many (List (Nat)) v) (subterm many (Nat) i) -> (many (List (Nat)) w))
  (match many v _
    ((Nil _) (match many i _ ((Zero) (Cons _ 1 $ Nil _)) ((Succ i1) (Cons _ 0 $ notail $ incr-nth (Nil _) i1))))
    ((Cons _ x v1) (match many i _ ((Zero) (Cons _ (Succ x) v1)) ((Succ i1) (Cons _ x $ notail $ incr-nth v1 i1))))))

(def-fns _ $ (many tally : (subterm many (List (Hc)) hc) -> (many (List (Nat)) v))
  (let-match many hc (Cons _ h rest) ((Nil _) (Nil _)))
  (let ((many v)) (notail $ tally rest))
  (let-match many h (HC2 i j _) ((HC1 i _) (incr-nth v i)))
  (incr-nth (incr-nth v i) j))

(def-fns _ $ (many nth-nat : (subterm many (Nat) i) (many (List (Nat)) xs) -> (many (Nat) x))
  (let-match many xs (Cons _ x rest) ((Nil _) 0))
  (let-match many i (Succ i1) ((Zero) x))
  (tail $ nth-nat i1 rest))

(def-fns _ $ (many z-scale : (many (Nat) k) (many (Z) a) -> (many (Z) b))
  (let-match many a (MkZ p n))
  (MkZ (nat-mul k p) (nat-mul k n)))

(def-fns _ $ (many cover-rec : (many (List (Nat)) v) (many (Z) b) (subterm many (List (Hc)) hc) -> (many (Bool) r))
  (let-match many hc (Cons _ h rest)
    ((Nil _) (let-match many b (MkZ p n)) (leb p n)))
  (let-match many h (HC2 i j b1) ((HC1 i b1) (and (nat-eqb (nth-nat i v) 1) (tail $ cover-rec v (z-add (z-scale 2 b1) b) rest))))
  (let ((many ni)) (nth-nat i v))
  (and (nat-eqb ni (nth-nat j v)) (leb ni 2) (tail $ cover-rec v (z-add (z-scale (bif _ (nat-eqb ni 1) 2 1) b1) b) rest)))

(def-fns _ $ (many dboundK : (many (Nat) n) -> (many (Z) k))
  (let-match many (monus n 5) (Succ k) ((Zero) (MkZ 10 0)))
  (MkZ 0 (nat-mul k 10)))

(def-fns _ $ (many hubcap-cover : (many (Ctx) c) (many (List (Hc)) hc) -> (many (Bool) r))
  (let-match many c (MkCtx nhub _ _ _))
  (let ((many v)) (tally hc))
  (and (nat-eqb (size _ v) nhub) (negb (mem-nat 0 v)) (cover-rec v (z-add (z-scale 2 (dboundK nhub)) (MkZ 0 1)) hc)))

(def-fns _ $ (many hubcap-rot : (many (Ctx) c) (many (Nat) j) (many (List (Sub)) p) -> (many (List (Sub)) q))
  (let-match many c (MkCtx nhub _ _ _))
  (rot _ (bif _ (nat-ltb 1 j) (monus j 2) (monus (nat-add nhub j) 2)) p))

(def-fns _ $ (many hub-subn : (many (Ctx) c) (many (Nat) i j) -> (many (Nat) k))
  (let-match many c (MkCtx nhub _ _ _))
  (monus (bif _ (leb j i) i (nat-add i nhub)) j))

(def-fns _ $ (many hc-fit : (many (Ctx) c) (many (List (Sub)) p) (many (Hc) h) -> (many (Bool) r))
  (let-match many h (HC2 j1 j2 b) ((HC1 j b) (check-dbound2 c (hubcap-rot c j p) b)))
  (check-2dbound2 c (hubcap-rot c j1 p) (hub-subn c j2 j1) b))

(def-fns _ $ (many hubcap-fit : (many (Ctx) c) (many (List (Sub)) p) (subterm many (List (Hc)) hc) -> (many (Bool) r))
  (let-match many hc (Cons _ h rest) ((Nil _) (BTrue)))
  (and (hc-fit c p h) (tail $ hubcap-fit c p rest)))
