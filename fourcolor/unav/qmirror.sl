; The mirror of a plain cubic map (edge f . n, node and face inverted, after hyper-mirror of hyprelabel.sl) is plain
; cubic with the same arities, and a mirror-image quiz fitting the map fits the mirror one face step on (fitqz_flip of
; quiz.v). Load after qtree.sl.

(def-fns _ $ (erased path-rev : (erased (Nat) d a b c y k) (erased (List (Nat)) p q s xs) (erased (HPerm d p q) pm) (subterm erased (Path p s a b xs) w)
    (erased (Nth (Nat) p c a) pc) (erased (Nth (Nat) q b y) pb) (erased (Length (Nat) xs k) l) -> (erased (List (Nat)) ys) (erased (Path q s y c ys) r)
    (erased (Length (Nat) ys k) ly))
  (match erased w _
    ((PathHere _ _ _)
      (let-match erased l (LengthNil _))
      (let-match erased (nth-fn (Nat) q a y c pb (perm-inv d c a p q pm pc)) (Refl _ _))
      (values (Nil _) (PathHere q s y) (LengthNil _)))
    ((PathStep _ _ xs1 _ z _ pz out w1)
      (let-match erased l (LengthCons _ _ _ k1 l1))
      (let ((erased ys1) (erased r1) (erased ly1)) (path-rev d z b a y k1 p q s xs1 pm w1 pz pb l1))
      (let ((erased ys) (erased sn) (erased r)) (path-snoc q s ys1 y a c r1 (perm-inv d c a p q pm pc) out))
      (values ys r (snoc-length (Nat) ys1 ys a k1 sn ly1)))))

(def-fns _ $ (erased order-inv : (erased (Nat) d x k) (erased (List (Nat)) p q) (erased (HPerm d p q) pm) (erased (Order p x k) o) -> (erased (Order q x k) r))
  (let-match erased o (MkOrder _ xs _ y k1 py w l))
  (let-match erased pm (HMkPerm _ _ _ ids io lp qp pq))
  (let ((erased y0) (erased py0) (erased _)) (perm-nth d x q p (perm-sym d p q pm) (nth-lt-length (Nat) p x d y py lp)))
  (let ((erased ys) (erased r) (erased ly)) (path-rev d y x x y0 k1 p q (Cons _ x (Nil _)) xs pm w py py0 l))
  (MkOrder q ys x y0 k1 py0 r ly))

(def-fns _ $ (erased orders-inv : (erased (Nat) d) (erased (List (Nat)) p q xs ks) (erased (HPerm d p q) pm) (subterm erased (Orders p xs ks) os)
    -> (erased (Orders q xs ks) r))
  (let-match erased os (OrdCons _ xs1 ks1 x k o os1) ((OrdNil _) (OrdNil q)))
  (OrdCons q xs1 ks1 x k (order-inv d x k p q pm o) (orders-inv d p q xs1 ks1 pm os1)))

(def-fns _ $ (erased order-fn2 : (erased (Nat) d x) (erased (List (Nat)) e n f fn) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Respects f n fn) rfn) (erased (Lt x d) lx) -> (erased (Order fn x (Succ (Succ (Zero)))) r))
  (let ((erased nf) (erased ni) (erased fi) (erased _) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased a) (erased pa) (erased la)) (perm-nth d x n ni pn lx))
  (let ((erased y) (erased py) (erased ly)) (perm-nth d a f fi pf la))
  (let ((erased l) (erased pl1) (erased pl2)) (resp-at f n fn x a rfn pa))
  (let-match erased (nth-fn (Nat) f a y l py pl2) (Refl _ _))
  (let ((erased w) (erased pw) (erased lw)) (perm-nth d a e nf pe la))
  (let ((erased fwx)) (fen d x a w e n f h lx pa pw))
  (let ((erased pwa) (erased nwa)) (plain-eq d a w e pl la pw))
  (let ((erased nyw)) (nfe d w a y e n f h lw pwa py))
  (let ((erased l3) (erased pl3) (erased pl4)) (resp-at f n fn y w rfn nyw))
  (let-match erased (nth-fn (Nat) f w x l3 fwx pl4) (Refl _ _))
  (let ((erased nyx))
    (match erased (nat-eq y x) (((Apart (Nat) Lt y x) ne))
      ((Unequal _ _ _ _ ne) ne)
      (absurd (Equal _ _ _) (let-match erased (perm-inj d w a y f fi pf fwx py) (Refl _ _)) (apart-irrefl a nwa))))
  (MkOrder fn (Cons _ y (Nil _)) x y (Succ (Zero)) pl1
    (PathStep fn (Cons _ x (Nil _)) (Nil _) y x x pl3 (NotInCons y x (Nil _) nyx (NotInNil y)) (PathHere fn _ x)) (LengthCons _ y (Nil _) (Zero) (LengthNil _))))

(def-fns _ $ (erased orders-fn2 : (erased (Nat) d m) (erased (List (Nat)) e n f fn ids) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Respects f n fn) rfn)
    (subterm erased (Iota m ids) io) (erased (Lt m (Succ d)) le)
    -> (erased (List (Nat)) ks2) (erased (Orders fn ids ks2) os) (erased (Repeat (Nat) m (Succ (Succ (Zero))) ks2) rk))
  (let-match erased io (IotaS m1 ids1 _ io1 s) ((IotaZ) (values (Nil (Nat)) (OrdNil fn) (RepeatNil _ (Succ (Succ (Zero)))))))
  (let ((erased lm)) (lt-pred m1 d le))
  (let ((erased ks1) (erased os1) (erased rk1)) (orders-fn2 d m1 e n f fn ids1 h pl rfn io1 (lt-weaken m1 d lm)))
  (let ((erased ks2) (erased sk)) (snoc-exists _ ks1 (Succ (Succ (Zero)))))
  (values ks2 (orders-snoc fn ids1 ids ks1 ks2 m1 (Succ (Succ (Zero))) os1 (order-fn2 d m1 e n f fn h pl rfn lm) s sk)
    (repeat-snoc m1 (Succ (Succ (Zero))) ks1 ks2 rk1 sk)))

(def-fns _ $ (erased plain-mirror : (erased (Nat) d) (erased (List (Nat)) e n f fn) (erased (Hypermap d e n f) h) (erased (AllOrder d e (Succ (Succ (Zero)))) pl)
    (erased (Respects f n fn) rfn) -> (erased (AllOrder d fn (Succ (Succ (Zero)))) r))
  (let-match erased h (MkHypermap _ _ _ _ ids _ _ _ io _ _ _ _ _ _))
  (let ((erased ks2) (erased os2) (erased rk2)) (orders-fn2 d d e n f fn ids h pl rfn io (lt-succ d)))
  (MkAllOrder d (Succ (Succ (Zero))) fn ks2 (MkOrderList d fn ids ks2 io os2) rk2))

(def-fns _ $ (erased geo-mirror : (erased (Nat) d) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g)
    -> (erased (List (Nat)) fn ni fi) (erased (Geo d fn ni fi ks) g2) (erased (Respects f n fn) rfn) (erased (HPerm d n ni) pn) (erased (HPerm d f fi) pf))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu ol ab))
  (let ((erased fn) (erased ni) (erased fi) (erased h2) (erased rfn) (erased pn) (erased pf)) (hyper-mirror d e n f h))
  (let-match erased cu (MkAllOrder _ _ _ ks3 ol3 rk3))
  (let-match erased ol3 (MkOrderList _ _ ids3 _ io3 os3))
  (let-match erased ol (MkOrderList _ _ ids _ io os))
  (values fn ni fi
    (MkGeo d fn ni fi ks h2 (plain-mirror d e n f fn h pl rfn)
      (MkAllOrder d (Succ (Succ (Succ (Zero)))) ni ks3 (MkOrderList d ni ids3 ks3 io3 (orders-inv d n ni ids3 ks3 pn os3)) rk3)
      (MkOrderList d fi ids ks io (orders-inv d f fi ids ks pf os)) ab)
    rfn pn pf))

; qstepR in the map is qstepL in the mirror, and the other way round.
(def-fns _ $ (erased step-rl : (erased (Nat) d x y) (erased (List (Nat)) e n f ks fn ni) (erased (Geo d e n f ks) g) (erased (Respects f n fn) rfn)
    (erased (HPerm d n ni) pn) (erased (Lt x d) lx) (erased (QStepR e n x y) sp) -> (erased (QStepL fn ni x y) r))
  (let-match erased sp (MkQStepR _ _ _ u _ pu py))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased pe) (erased _) (erased pf)) (hyper-core d e n f h))
  (let ((erased lu)) (img-lt d x u e nf pe lx pu))
  (let ((erased a) (erased pa) (erased _)) (perm-nth d x ni n (perm-sym d n ni pn) lx))
  (let ((erased nax)) (perm-inv d x a ni n (perm-sym d n ni pn) pa))
  (let ((erased b) (erased pb) (erased pb2)) (resp-at f n fn a x rfn nax))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d u y n cu lu py))
  (let ((erased pux) (erased _)) (plain-eq d x u e pl lx pu))
  (let-match erased (perm-inj d z b u n ni pn pz2 (nfe d u x b e n f h lu pux pb2)) (Refl _ _))
  (MkQStepL fn ni x a b y pa pb (perm-inv d y b n ni pn pz)))

(def-fns _ $ (erased step-lr : (erased (Nat) d x y) (erased (List (Nat)) e n f ks fn ni) (erased (Geo d e n f ks) g) (erased (Respects f n fn) rfn)
    (erased (HPerm d n ni) pn) (erased (Lt x d) lx) (erased (QStepL e n x y) sp) -> (erased (QStepR fn ni x y) r))
  (let-match erased sp (MkQStepL _ _ _ a b _ pa pb py))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu _ _))
  (let ((erased nf) (erased _) (erased _) (erased _) (erased pe) (erased _) (erased _)) (hyper-core d e n f h))
  (let ((erased la)) (img-lt d x a n ni pn lx pa))
  (let ((erased lb)) (img-lt d a b e nf pe la pb))
  (let ((erased c) (erased pc) (erased pc2)) (resp-at f n fn x a rfn pa))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d b y n cu lb py))
  (let ((erased pba) (erased _)) (plain-eq d a b e pl la pb))
  (let-match erased (perm-inj d z c b n ni pn pz2 (nfe d b a c e n f h lb pba pc2)) (Refl _ _))
  (MkQStepR fn ni x c y pc (perm-inv d y c n ni pn pz)))

(def-fns _ $ (erased step-lt : (erased (Nat) d x y) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt x d) lx) (erased (QStepR e n x y) sp)
    -> (erased (Lt y d) r))
  (let-match erased sp (MkQStepR _ _ _ u _ pu py))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased ni) (erased _) (erased _) (erased pe) (erased pn) (erased _)) (hyper-core d e n f h))
  (img-lt d u y n ni pn (img-lt d x u e nf pe lx pu) py))

(def-fns _ $ (erased stepl-lt : (erased (Nat) d x y) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt x d) lx) (erased (QStepL e n x y) sp)
    -> (erased (Lt y d) r))
  (let-match erased sp (MkQStepL _ _ _ a b _ pa pb py))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ _ _))
  (let ((erased nf) (erased ni) (erased _) (erased _) (erased pe) (erased pn) (erased _)) (hyper-core d e n f h))
  (img-lt d b y n ni pn (img-lt d a b e nf pe (img-lt d x a n ni pn lx pa) pb) py))

(def-fns _ $ (erased fit-flip : (erased (Nat) d x) (erased (List (Nat)) e n f ks fn ni) (erased (Qn) q r) (erased (Geo d e n f ks) g) (erased (Respects f n fn) rfn)
    (erased (HPerm d n ni) pn) (erased (Lt x d) lx) (subterm erased (FlipQ q r) fl) (erased (FitQ e n ks x r) fr) -> (erased (FitQ fn ni ks x q) res))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (match erased fl _
    ((FlQ0) (FQ0 fn ni ks x))
    ((FlQ1 a) (let-match erased fr (FQ1 _ _ _ _ _ pa)) (FQ1 fn ni ks x a pa))
    ((FlQL a q1 r1 p)
      (let-match erased fr (FQR _ _ _ _ _ y _ pa sp f1))
      (FQL fn ni ks x a y q1 pa (step-rl d x y e n f ks fn ni g rfn pn lx sp)
        (fit-flip d y e n f ks fn ni q1 r1 g rfn pn (step-lt d x y e n f ks g lx sp) p f1)))
    ((FlQR a q1 r1 p)
      (let-match erased fr (FQL _ _ _ _ _ y _ pa sp f1))
      (FQR fn ni ks x a y q1 pa (step-lr d x y e n f ks fn ni g rfn pn lx sp)
        (fit-flip d y e n f ks fn ni q1 r1 g rfn pn (stepl-lt d x y e n f ks g lx sp) p f1)))
    ((FlQLR a l r1 l2 r2 pl pr)
      (let-match erased fr (FQLR _ _ _ _ _ yl yr _ _ pa sl fl1 sr fr1))
      (FQLR fn ni ks x a yr yl l r1 pa (step-rl d x yr e n f ks fn ni g rfn pn lx sr)
        (fit-flip d yr e n f ks fn ni l l2 g rfn pn (step-lt d x yr e n f ks g lx sr) pl fr1) (step-lr d x yl e n f ks fn ni g rfn pn lx sl)
        (fit-flip d yl e n f ks fn ni r1 r2 g rfn pn (stepl-lt d x yl e n f ks g lx sl) pr fl1)))
    ((FlQLL a q1 r1 p)
      (let-match erased fr (FQRR _ _ _ _ _ xr y _ s1 pa s2 f1))
      (let ((erased lxr)) (step-lt d x xr e n f ks g lx s1))
      (let ((erased _) (erased ni2) (erased _) (erased _) (erased _) (erased pn2) (erased _)) (hyper-core d e n f h))
      (let ((erased c) (erased pc) (erased _)) (perm-nth d xr ni n (perm-sym d n ni pn) lxr))
      (let ((erased c2) (erased pc2) (erased pc3)) (resp-at f n fn c xr rfn (perm-inv d xr c ni n (perm-sym d n ni pn) pc)))
      (let ((erased y1) (erased py1) (erased _) (erased pa1)) (face-step d xr a e n f ks h ol lxr pa))
      (let-match erased (nth-fn (Nat) f xr c2 y1 pc3 py1) (Refl _ _))
      (FQLL fn ni ks x a xr c c2 y q1 (step-rl d x xr e n f ks fn ni g rfn pn lx s1) pc pc2 pa1 (step-rl d xr y e n f ks fn ni g rfn pn lxr s2)
        (fit-flip d y e n f ks fn ni q1 r1 g rfn pn (step-lt d xr y e n f ks g lxr s2) p f1)))
    ((FlQRR a q1 r1 p)
      (let-match erased fr (FQLL _ _ _ _ _ xl c c2 y _ s1 pc pc2 pa s2 f1))
      (let ((erased lxl)) (stepl-lt d x xl e n f ks g lx s1))
      (let ((erased nf2) (erased ni2) (erased _) (erased _) (erased pe2) (erased pn2) (erased _)) (hyper-core d e n f h))
      (let ((erased lc2)) (img-lt d c c2 e nf2 pe2 (img-lt d xl c n ni2 pn2 lxl pc) pc2))
      (let ((erased y1) (erased py1) (erased _) (erased pa1)) (face-step d c2 a e n f ks h ol lc2 pa))
      (let-match erased (nth-fn (Nat) f c2 xl y1 (fen d xl c c2 e n f h lxl pc pc2) py1) (Refl _ _))
      (FQRR fn ni ks x a xl y q1 (step-lr d x xl e n f ks fn ni g rfn pn lx s1) pa1 (step-lr d xl y e n f ks fn ni g rfn pn lxl s2)
        (fit-flip d y e n f ks fn ni q1 r1 g rfn pn (stepl-lt d xl y e n f ks g lxl s2) p f1)))))

; fitqz_flip: the mirror image of qz fitting at x gives qz fitting the mirror at face x.
(def-fns _ $ (erased fitz-flip : (erased (Nat) d x) (erased (List (Nat)) e n f ks fn ni) (erased (Quiz) qz qz2) (erased (Geo d e n f ks) g) (erased (Respects f n fn) rfn)
    (erased (HPerm d n ni) pn) (erased (Lt x d) lx) (erased (FlipQz qz qz2) fl) (erased (FitZ e n ks x qz2) fz)
    -> (erased (Nat) w) (erased (FitZ fn ni ks w qz) r) (erased (Lt w d) lw))
  (let-match erased fl (MkFlipQz a0 a1 q01 q10 r01 r10 p1 p2))
  (let-match erased fz (MkFitZ _ _ _ _ x1 _ _ f0 px f1))
  (let-match erased f0 (FQR _ _ _ _ _ y0 _ k0 s0 g0))
  (let-match erased f1 (FQR _ _ _ _ _ y1 _ k1 s1 g1))
  (let-match erased s0 (MkQStepR _ _ _ t0 _ pt0 py0))
  (let-match erased (nth-fn (Nat) e x x1 t0 px pt0) (Refl _ _))
  (let-match erased s1 (MkQStepR _ _ _ t1 _ pt1 py1))
  (let-match erased g (MkGeo _ _ _ _ _ h pl cu ol _))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased pe) (erased _) (erased pf)) (hyper-core d e n f h))
  (let ((erased lx1)) (img-lt d x x1 e nf pe lx px))
  (let ((erased px1) (erased _)) (plain-eq d x x1 e pl lx px))
  (let-match erased (nth-fn (Nat) e x1 x t1 px1 pt1) (Refl _ _))
  (let ((erased w) (erased pw) (erased _) (erased kw)) (face-step d x a0 e n f ks h ol lx k0))
  (let ((erased w1) (erased pw1) (erased lw1) (erased kw1)) (face-step d x1 a1 e n f ks h ol lx1 k1))
  (let ((erased lw)) (img-lt d x w f fi pf lx pw))
  (let ((erased nwx1)) (nfe d x1 x w e n f h lx1 px1 pw))
  (let ((erased nw1x)) (nfe d x x1 w1 e n f h lx px pw1))
  (let ((erased l) (erased pfw) (erased pl)) (resp-at f n fn w x1 rfn nwx1))
  (let-match erased (nth-fn (Nat) f x1 w1 l pw1 pl) (Refl _ _))
  (let ((erased l2) (erased pfw1) (erased pl2)) (resp-at f n fn w1 x rfn nw1x))
  (let-match erased (nth-fn (Nat) f x w l2 pw pl2) (Refl _ _))
  (let ((erased z) (erased pz) (erased pz2) (erased _) (erased _)) (cubic-eq d x y1 n cu lx py1))
  (let-match erased (perm-inj d z w1 x n _ pn pz2 nw1x) (Refl _ _))
  (let ((erased z2) (erased pz3) (erased pz4) (erased _) (erased _)) (cubic-eq d x1 y0 n cu lx1 py0))
  (let-match erased (perm-inj d z2 w x1 n _ pn pz4 nwx1) (Refl _ _))
  (let ((erased ly1)) (img-lt d x y1 n _ pn lx py1))
  (let ((erased ly0)) (img-lt d x1 y0 n _ pn lx1 py0))
  (values w (MkFitZ fn ni ks w w1 (QaskR a0 q01) (QaskR a1 q10)
    (FQR fn ni ks w a0 y1 q01 kw (MkQStepR fn ni w w1 y1 pfw (perm-inv d y1 w1 n ni pn pz)) (fit-flip d y1 e n f ks fn ni q01 r01 g rfn pn ly1 p1 g1))
    pfw (FQR fn ni ks w1 a1 y0 q10 kw1 (MkQStepR fn ni w1 w y0 pfw1 (perm-inv d y0 w n ni pn pz3)) (fit-flip d y0 e n f ks fn ni q10 r10 g rfn pn ly0 p2 g0)))
    lw))
