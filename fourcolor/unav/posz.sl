; cs lists dscore1 at the darts xs.
(def-adts $ (DsList : ((List (Nat)) e n f ks) ((List (List (Sub))) drs) ((List (Nat)) xs cs) -> Type)
  enum
  (many DLNil : (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs) -> (DsList e n f ks drs (Nil (Nat)) (Nil (Nat))))
  (many DLCons : (erased (List (Nat)) e n f ks xs cs) (erased (List (List (Sub))) drs) (erased (Nat) x c) (erased (DScore1 e n f ks drs x c) p)
      (erased (DsList e n f ks drs xs cs) rest) -> (DsList e n f ks drs (Cons (Nat) x xs) (Cons (Nat) c cs))))

(def-fns _ $ (erased dslist-exists : (erased (Nat) d) (erased (List (Nat)) e n f ks xs) (erased (List (List (Sub))) drs) (erased (Geo d e n f ks) g)
    (subterm erased (Under xs d) u) -> (erased (List (Nat)) cs) (erased (DsList e n f ks drs xs cs) r))
  (let-match erased u (UnderCons xs1 x _ lx u1) ((UnderNil _) (values (Nil _) (DLNil e n f ks drs))))
  (let ((erased c) (erased p)) (dscore1-exists d x e n f ks drs g lx))
  (let ((erased cs) (erased r)) (dslist-exists d e n f ks xs1 drs g u1))
  (values (Cons _ c cs) (DLCons e n f ks xs1 cs drs x c p r)))

(def-fns _ $ (erased dslist-nth : (erased (List (Nat)) e n f ks xs cs) (erased (List (List (Sub))) drs) (erased (Nat) j y c)
    (subterm erased (DsList e n f ks drs xs cs) dl) (erased (Nth (Nat) xs j y) py) (erased (Nth (Nat) cs j c) pc) -> (erased (DScore1 e n f ks drs y c) r))
  (let-match erased dl (DLCons _ _ _ _ xs1 cs1 _ _ _ p dl1) (absurd (DLNil _ _ _ _ _) py))
  (let-match erased py (NthThere _ _ _ j1 _ py1) ((NthHere _ _ _) (let-match erased pc (NthHere _ _ _)) p))
  (let-match erased pc (NthThere _ _ _ _ _ pc1))
  (dslist-nth e n f ks xs1 cs1 drs j1 y c dl1 py1 pc1))

(def-fns _ $ (erased dslist-length : (erased (List (Nat)) e n f ks xs cs) (erased (List (List (Sub))) drs) (erased (Nat) k)
    (subterm erased (DsList e n f ks drs xs cs) dl) (erased (Length (Nat) xs k) l) -> (erased (Length (Nat) cs k) r))
  (let-match erased dl (DLCons _ _ _ _ xs1 cs1 _ _ c _ dl1) ((DLNil _ _ _ _ _) (let-match erased l (LengthNil _)) (LengthNil _)))
  (let-match erased l (LengthCons _ _ _ k1 l1))
  (LengthCons _ c cs1 k1 (dslist-length e n f ks xs1 cs1 drs k1 dl1 l1)))

; The dscore at x is pos - neg; cs lists dscore1 at the darts 0..d-1, cse at their edges.
(def-adts $ (DScore : ((Nat) d) ((List (Nat)) e n f ks) ((List (List (Sub))) drs) ((Nat) x pos neg) -> Type)
  enum
  (many MkDScore : (erased (Nat) d x a t c60 sp sn pos neg) (erased (List (Nat)) e n f ks ids cs cse) (erased (List (List (Sub))) drs)
      (erased (Iota d ids) io) (erased (DsList e n f ks drs ids cs) dl) (erased (Respects cs e cse) rc) (erased (Nth (Nat) ks x a) pa)
      (erased (FSum f cse x a sp) fp) (erased (FSum f cs x a sn) fn) (erased (Mul 6 10 c60) m60) (erased (Mul a 10 t) mt)
      (erased (Add c60 sp pos) ap) (erased (Add t sn neg) an) -> (DScore d e n f ks drs x pos neg)))

(def-adts $ (DTot : ((Nat) d) ((List (Nat)) e n f ks) ((List (List (Sub))) drs) ((List (Nat)) rs) ((Nat) p q) -> Type)
  enum
  (many DTNil : (erased (Nat) d) (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs) -> (DTot d e n f ks drs (Nil (Nat)) (Zero) (Zero)))
  (many DTCons : (erased (Nat) d r pos neg p1 q1 p q) (erased (List (Nat)) e n f ks rs) (erased (List (List (Sub))) drs)
      (erased (DScore d e n f ks drs r pos neg) ds) (erased (DTot d e n f ks drs rs p1 q1) rest) (erased (Add pos p1 p) ap) (erased (Add neg q1 q) aq)
      -> (DTot d e n f ks drs (Cons (Nat) r rs) p q)))

(def-fns _ $ (erased find-pos : (erased (Nat) d p q) (erased (List (Nat)) e n f ks rs) (erased (List (List (Sub))) drs) (erased (Under rs d) u)
    (subterm erased (DTot d e n f ks drs rs p q) t) (erased (Lt q p) lt)
    -> (erased (Nat) x pos neg) (erased (Lt x d) lx) (erased (DScore d e n f ks drs x pos neg) ds) (erased (Lt neg pos) r))
  (let-match erased t (DTCons _ r pos neg p1 q1 _ _ _ _ _ _ rs1 _ ds t1 ap aq) (absurd (DTNil _ _ _ _ _ _ _) lt))
  (let-match erased u (UnderCons _ _ _ lr u1))
  (let-match erased (le-dec pos neg) (LeY _ _ l)
    ((LeN _ _ l) (values r pos neg lr ds l)))
  (let ((erased l1))
    (match erased (le-dec p1 q1) (((Lt q1 p1) l1))
      ((LeN _ _ k) k)
      (absurd (LeY _ _ k) (lt-le-absurd q p lt (le-sum pos neg p1 q1 p q l k ap aq)))))
  (find-pos d p1 q1 e n f ks rs1 drs u1 t1 l1))

(def-fns _ $ (erased dtot-build : (erased (Nat) d k c60 sp sn sa) (erased (List (Nat)) e n f ks ids cs cse os rs) (erased (List (List (Sub))) drs)
    (erased (Iota d ids) io) (erased (DsList e n f ks drs ids cs) dl) (erased (Respects cs e cse) rc) (erased (Repeat (Nat) d (Succ (Zero)) os) ro)
    (erased (Mul 6 10 c60) m60) (subterm erased (RSum f cse ks rs sp) r1) (erased (RSum f cs ks rs sn) r2) (erased (RSum f os ks rs sa) r3)
    (erased (Length (Nat) rs k) lk)
    -> (erased (Nat) p q m t) (erased (DTot d e n f ks drs rs p q) dt) (erased (Mul k c60 m) mm) (erased (Mul sa 10 t) mt) (erased (Add m sp p) ap)
    (erased (Add t sn q) aq))
  (let-match erased r1 (RSCons _ _ _ rs1 r a tp sp1 _ pa fp r11 ad1)
    ((RSNil _ _ _)
      (let-match erased r2 (RSNil _ _ _))
      (let-match erased r3 (RSNil _ _ _))
      (let-match erased lk (LengthNil _))
      (values (Zero) (Zero) (Zero) (Zero) (DTNil d e n f ks drs) (MulZero c60) (MulZero 10) (AddZero (Zero)) (AddZero (Zero)))))
  (let-match erased r2 (RSCons _ _ _ _ _ a2 tn sn1 _ pa2 fn r21 ad2))
  (let-match erased r3 (RSCons _ _ _ _ _ a3 ta sa1 _ pa3 fa r31 ad3))
  (let-match erased (nth-fn _ ks r a2 a pa2 pa) (Refl _ _))
  (let-match erased (nth-fn _ ks r a3 a pa3 pa) (Refl _ _))
  (let-match erased (fsum-ones d r a ta f os ro fa) (Refl _ _))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let ((erased p1) (erased q1) (erased m1) (erased t1) (erased dt1) (erased mm1) (erased mt1) (erased ap1) (erased aq1))
    (dtot-build d k1 c60 sp1 sn1 sa1 e n f ks ids cs cse os rs1 drs io dl rc ro m60 r11 r21 r31 lk1))
  (let ((erased tr) (erased mtr)) (mul a 10))
  (let ((erased pos) (erased apos)) (add c60 tp))
  (let ((erased neg) (erased aneg)) (add tr tn))
  (let ((erased p) (erased ap)) (add pos p1))
  (let ((erased q) (erased aq)) (add neg q1))
  (let ((erased m) (erased am)) (add m1 c60))
  (let ((erased t) (erased mt)) (mul sa 10))
  (let ((erased at)) (mul-distr a sa1 sa 10 tr t1 t ad3 mtr mt1 mt))
  (let ((erased x1) (erased y1) (erased e1) (erased e2) (erased e3)) (add-mid c60 tp m1 sp1 pos p1 p apos ap1 ap))
  (let-match erased (add-fn c60 m1 x1 m e1 (add-comm m1 c60 m am)) (Refl _ _))
  (let-match erased (add-fn tp sp1 y1 sp e2 ad1) (Refl _ _))
  (let ((erased x2) (erased y2) (erased f1) (erased f2) (erased f3)) (add-mid tr tn t1 sn1 neg q1 q aneg aq1 aq))
  (let-match erased (add-fn tr t1 x2 t f1 at) (Refl _ _))
  (let-match erased (add-fn tn sn1 y2 sn f2 ad2) (Refl _ _))
  (values p q m t
    (DTCons d r pos neg p1 q1 p q e n f ks rs1 drs (MkDScore d r a tr c60 tp tn pos neg e n f ks ids cs cse drs io dl rc pa fp fn m60 mtr apos aneg) dt1 ap aq)
    (MulSucc k1 c60 m1 m mm1 am) mt e3 f3))

(def-fns _ $ (erased posz-dscore : (erased (Nat) d) (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs) (erased (Geo d e n f ks) g)
    (erased (Connected d e n f) cc) (erased (Genus d e n f (Zero)) gen)
    -> (erased (Nat) x pos neg) (erased (Lt x d) lx) (erased (DScore d e n f ks drs x pos neg) ds) (erased (Lt neg pos) lt))
  (let-match erased g (MkGeo _ _ _ _ _ h pe2 cn ol _))
  (let ((erased nf) (erased _) (erased fi) (erased _) (erased pe) (erased _) (erased pf)) (hyper-core d e n f h))
  (let ((erased _) (erased _) (erased _) (erased kf) (erased _) (erased _) (erased _) (erased of) (erased _) (erased _) (erased _)) (genus-parts d (Zero) e n f gen))
  (let ((erased s6) (erased m6) (erased a12)) (cubic-planar d kf e n f h pe2 cn cc gen of))
  (let ((erased ids) (erased io)) (iota-exists d))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased le) (erased _) (erased _)) (hyper-lengths d e n f h))
  (let ((erased uid)) (respects-under e ids e d (respects-id-right d ids e io le) le))
  (let ((erased rs) (erased ls) (erased lr) (erased ur) (erased oc) (erased dls) (erased i1) (erased i2)) (face-roots d kf f fi ks ids pf of ol io))
  (let ((erased cs) (erased dl)) (dslist-exists d e n f ks ids drs g uid))
  (let ((erased lcs)) (dslist-length e n f ks ids cs drs d dl li))
  (let ((erased cse) (erased rc)) (respects-exists cs e d (perm-under d e nf pe) lcs))
  (let ((erased lcse)) (respects-length cs e cse d rc le))
  (let ((erased os) (erased ro)) (nseq-c _ d (Succ (Zero))))
  (let ((erased sp) (erased kp)) (sumat-exists d cse ids lcse uid))
  (let ((erased sn) (erased kn)) (sumat-exists d cs ids lcs uid))
  (let-match erased (sumat-fn cs ids sp sn (perm-total d sp cs e nf cse ids pe io rc kp) kn) (Refl _ _))
  (let ((erased sa) (erased ka)) (sumat-exists d os ids (repeat-length _ d _ os ro) uid))
  (let-match erased (length-fn _ ids d sa li (sumat-ones d sa os ids ro ka)) (Refl _ _))
  (let ((erased c60) (erased m60)) (mul 6 10))
  (let ((erased p) (erased q) (erased m) (erased t) (erased dt) (erased mm) (erased mt) (erased ap) (erased aq))
    (dtot-build d kf c60 sp sp d e n f ks ids cs cse os rs drs io dl rc ro m60
      (faces-sum d sp f cse ks rs ls ids ol io ur oc dls i1 i2 kp) (faces-sum d sp f cs ks rs ls ids ol io ur oc dls i1 i2 kn)
      (faces-sum d d f os ks rs ls ids ol io ur oc dls i1 i2 ka) lr))
  (let ((erased x) (erased mx)) (mul s6 10))
  (let-match erased (mul-fn kf c60 m x mm (mul-assoc kf 6 10 s6 x c60 m6 mx m60)) (Refl _ _))
  (let ((erased y) (erased my)) (mul 12 10))
  (let ((erased amx)) (mul-distr d 12 s6 10 t y m a12 mt my mx))
  (let-match erased my (MulSucc _ _ y1 _ _ ay))
  (let ((erased ly)) (lt-le-trans (Zero) 10 y (LtZ 9) (add-le-right y1 10 y ay)))
  (let ((erased ltm)) (add-lt-r t (Zero) t y m (add-zero-right t) amx ly))
  (find-pos d p q e n f ks rs drs ur dt (add-lt-r sp t q m p (add-comm t sp q aq) (add-comm m sp p ap) ltm)))
