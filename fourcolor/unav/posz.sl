(def-fns _ $ (erased dscore1-exists : (erased (Nat) d y) (erased (List (Nat)) e n f ks) (erased (List (List (Sub))) drs) (erased (Geo d e n f ks) g)
    (erased (Lt y d) ly) -> (erased (Nat) c) (erased (DScore1 e n f ks drs y c) r))
