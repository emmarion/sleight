  (let ((erased nf) (erased _) (erased fi) (erased _) (erased pe) (erased _) (erased pf)) (hyper-core d e n f h))
  (let ((erased z) (erased pz) (erased lz)) (perm-nth d y e nf pe ly))
  (let ((erased a) (erased pa) (erased _)) (arity-at d z f ks ol lz))
  (let ((erased w) (erased pw) (erased lw)) (iter-exists d z f fi pf 2 lz))
  (let ((erased u) (erased pu) (erased lu)) (perm-nth d w e nf pe lw))
  (let ((erased h2) (erased ph) (erased _)) (arity-at d u f ks ol lu))
  (let ((erased z3) (erased p3) (erased l3)) (iter-exists d z f fi pf 3 lz))
  (let ((erased m) (erased mo)) (monus-c a 5))
  (let ((erased fs) (erased pfs)) (fans-exists d z3 e n f ks g m l3))
  (values (MkSec a h2 fs) (MkSecAt e f ks y z a w u h2 z3 m fs pz pa pw pu ph p3 mo pfs)))

(def-fns _ $ (erased obs-exists : (erased (Nat) d y) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (subterm erased (Nat) k) (erased (Lt y d) ly)
    -> (erased (List (Sec)) os) (erased (ObsAt e f ks y k os) r))
