(let-match erased (unary-10-9) (Refl _ _))
(let-match erased (unary-12-10) (Refl _ _))

(def-fns _ $ (erased iter-exists : (erased (Nat) d x) (erased (List (Nat)) f fi) (erased (HPerm d f fi) pf) (subterm erased (Nat) k) (erased (Lt x d) lx)
    -> (erased (Nat) z) (erased (Iter f k x z) it) (erased (Lt z d) lz))
  (let-match erased k (Succ k1) ((Zero) (values x (ItZ f x) lx)))
  (let ((erased y) (erased py) (erased ly)) (perm-nth d x f fi pf lx))
  (let ((erased z) (erased it) (erased lz)) (iter-exists d y f fi pf k1 ly))
  (values z (ItS f k1 x y z py it) lz))

(def-fns _ $ (erased fans-exists : (erased (Nat) d z) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (subterm erased (Nat) m) (erased (Lt z d) lz)
    -> (erased (List (Nat)) fs) (erased (FansAt e f ks z m fs) r))
  (let-match erased m (Succ m1) ((Zero) (values (Nil _) (FAZ e f ks z))))
  (let-match erased g (MkGeo _ _ _ _ _ h _ _ ol _))
  (let ((erased u) (erased _) (erased z1) (erased pu) (erased lu) (erased _) (erased _) (erased pz) (erased lz1)) (hyper-step d z e n f h lz))
  (let ((erased a) (erased pa) (erased _)) (arity-at d u f ks ol lu))
  (let ((erased fs) (erased r)) (fans-exists d z1 e n f ks g m1 lz1))
  (values (Cons _ a fs) (FAS e f ks z u a z1 m1 fs pu pa pz r)))

(def-fns _ $ (erased sec-exists : (erased (Nat) d y) (erased (List (Nat)) e n f ks) (erased (Geo d e n f ks) g) (erased (Lt y d) ly)
    -> (erased (Sec) o) (erased (SecAt e f ks y o) r))
