(def-fns _ $ (many script-src : (many (Nat) a) -> (many (String) skel) (many (List (String)) cuts))
  (let-match many (nat-eqb a 5) (BFalse) ((BTrue) (values "" (Nil _))))
  (let-match many (nat-eqb a 6) (BFalse) ((BTrue) (values "" (Nil _))))
  (let-match many (nat-eqb a 7) (BFalse) ((BTrue) (values "AAAFBBAABFBBEAAGFBADAAGAACFBBEAAFFBADAAFAADFBBEAAEFBADAAEABDFBBEEE" (Cons _ "" $ Cons _ "" $ Cons _ "" $ Cons _ "" $ Cons _ "" $ Cons _ "" $ Nil _))))
  (let-match many (nat-eqb a 8) (BFalse) ((BTrue) (values "" (Cons _ "" $ Cons _ "" $ Cons _ "" $ Cons _ "" $ Cons _ "" $ Nil _))))
  (let-match many (nat-eqb a 9) (BFalse) ((BTrue) (values "AAIFBBAAHFBBAAGFBBEEEAAAFBADAABAABFBADAACAACFBADAADAADFBADAAEAAEFBADAAFAAFFBADAAGAAGFBADAAHAAHFBADAAICGBAEABBEABCEACDEGACFGGACHIGA" (Cons _ "" $ Cons _ "" $ Cons _ "" $ Nil _))))
  (let-match many (nat-eqb a 10) (BFalse) ((BTrue) (values "" (Nil _))))

  (values "" (Nil _)))
(def-fns _ $ (many script-by : (many (Nat) a) -> (many (Script) s)) (let ((many skel) (many cuts)) (script-src a)) (script-from skel cuts))
