; Certified rule counting and the dbound checks of discharge.v and hubcap.v, over the sector lists of fit.sl. In place
; of calling redp, a check returns the parts it would have handed to redp (its obligations); its evidence then gives
; either the bound or an obligation that fits the hub exactly.

(def-adts $ (IfT : ((Bool) b) (Type P) -> Type)
  enum
  (many IfY : (erased Type P) (erased P p) -> (IfT (BTrue) P))
  (many IfF : (erased Type P) -> (IfT (BFalse) P)))

(def-adts $ (LtT : ((Nat) a b) -> Type)
  enum
  (many LtYes : (erased (Nat) a b) (erased (Lt a b) p) -> (LtT a b))
  (many LtNo : (erased (Nat) a b) -> (LtT a b)))

(def-fns _ $ (many lt-test : (many (Nat) a b) -> (many (LtT a b) t))
  (match many (nat-cmp a b) _ ((CLt _ _ _ _ p) (LtYes a b p)) (else (LtNo a b))))

(def-fns _ $ (erased add-shift : (erased (Nat) a b c) (subterm erased (Add a (Succ b) c) p) -> (erased (Add (Succ a) b c) q))
  (let-match erased p (AddSucc a1 _ c1 p1) ((AddZero _) (AddSucc (Zero) b b (AddZero b))))
  (AddSucc (Succ a1) b c1 (add-shift a1 b c1 p1)))

(def-fns _ $ (erased plus-assoc : (erased (Nat) a b c ab abc) (subterm erased (Add a b ab) p) (erased (Add ab c abc) q) ->
    (erased (Nat) bc) (erased (Add b c bc) r) (erased (Add a bc abc) s))
  (let-match erased p (AddSucc a1 _ ab1 p1) ((AddZero _) (values abc q (AddZero abc))))
  (let-match erased q (AddSucc _ _ abc1 q1))
  (let ((erased bc) (erased r) (erased s)) (plus-assoc a1 b c ab1 abc1 p1 q1))
  (values bc r (AddSucc a1 bc abc1 s)))

(def-fns _ $ (erased plus-assoc-r : (erased (Nat) a b c bc abc) (subterm erased (Add a bc abc) p) (erased (Add b c bc) q) ->
    (erased (Nat) ab) (erased (Add a b ab) r) (erased (Add ab c abc) s))
  (let-match erased p (AddSucc a1 _ abc1 p1) ((AddZero _) (values b (AddZero b) q)))
  (let ((erased ab) (erased r) (erased s)) (plus-assoc-r a1 b c bc abc1 p1 q))
  (values (Succ ab) (AddSucc a1 b ab r) (AddSucc ab c abc1 s)))

(def-fns _ $ (erased plus-lcomm : (erased (Nat) a b c x y) (erased (Add b c x) p) (erased (Add a x y) q) ->
    (erased (Nat) z) (erased (Add a c z) r) (erased (Add b z y) s))
  (let ((erased ab) (erased r1) (erased s1)) (plus-assoc-r a b c x y q p))
  (plus-assoc b a c ab y (add-comm a b ab r1) s1))

(def-fns _ $ (erased add-lt-r : (erased (Nat) a b c d e) (subterm erased (Add a b c) p) (erased (Add a d e) q) (erased (Lt b d) l) -> (erased (Lt c e) r))
  (let-match erased p (AddSucc a1 _ c1 p1) ((AddZero _) (let-match erased q (AddZero _)) l))
  (let-match erased q (AddSucc _ _ e1 q1))
  (LtS c1 e1 (add-lt-r a1 b c1 d e1 p1 q1 l)))

(def-fns _ $ (erased add-le-r : (erased (Nat) a b c d e) (subterm erased (Add a b c) p) (erased (Add a d e) q) (erased (Lt b (Succ d)) l)
    -> (erased (Lt c (Succ e)) r))
  (add-lt-r a b c (Succ d) (Succ e) p (add-succ-right a d e q) l))

(def-fns _ $ (erased le-sum : (erased (Nat) a b c d x y) (erased (Lt a (Succ b)) l) (erased (Lt c (Succ d)) k) (erased (Add a c x) p)
    (erased (Add b d y) q) -> (erased (Lt x (Succ y)) r))
  (let ((erased z) (erased pz)) (add a d))
  (le-tr x z y (add-le-r a c x d z p pz k) (add-le-r d a z b y (add-comm a d z pz) (add-comm b d y q) l)))

(def-fns _ $ (erased add-eq : (erased (Nat) a b c d) (erased (Add a b c) p) (erased (Add a b d) q) -> (erased (Eq (Nat) c d) e))
  (add-fn a b c d p q))

; Deciding a fit.
(def-fns _ $ (erased rg-dec : (erased (Nat) a) (erased (Rg) r) -> (erased (Or (InRg a r) (OutRg a r)) o))
  (let-match erased r (MkRg lo hi))
  (let ((erased m) (erased c)) (clamp-exists a))
  (let-match erased (le-dec lo m) (LeY _ _ p) ((LeN _ _ p) (OrR _ _ (OutLo a m lo hi c p))))
  (match erased (le-dec m hi) _
    ((LeY _ _ q) (OrL _ _ (MkInRg a m lo hi c p q)))
    ((LeN _ _ q) (OrR _ _ (OutHi a m lo hi c q)))))

(def-fns _ $ (erased fans-dec : (erased (List (Nat)) as) (subterm erased (List (Rg)) fs)
    -> (erased (Or (Pw (Nat) (Rg) InRg as fs) (Bad (Nat) (Rg) OutRg as fs)) o))
  (let-match erased fs (Cons _ r fs1) ((Nil _) (OrL _ _ (PwNil _ _ InRg as))))
  (let-match erased as (Cons _ a as1) ((Nil _) (OrR _ _ (BadShort _ _ OutRg r fs1))))
  (let-match erased (rg-dec a r) (OrL _ _ i) ((OrR _ _ o) (OrR _ _ (BadHere _ _ OutRg a r as1 fs1 o))))
  (match erased (fans-dec as1 fs1) _
    ((OrL _ _ f) (OrL _ _ (PwCons _ _ InRg a r as1 fs1 i f)))
    ((OrR _ _ b) (OrR _ _ (BadThere _ _ OutRg a r as1 fs1 b)))))

(def-fns _ $ (erased sec-dec : (erased (Sec) o) (erased (Sub) x) -> (erased (Or (FitSec o x) (OutSec o x)) r))
  (let-match erased o (MkSec a h as))
  (let-match erased x (MkSub s hr fs))
  (let-match erased (rg-dec a s) (OrL _ _ i1) ((OrR _ _ q) (OrR _ _ (OSSpoke a h as s hr fs q))))
  (let-match erased (rg-dec h hr) (OrL _ _ i2) ((OrR _ _ q) (OrR _ _ (OSHat a h as s hr fs q))))
  (match erased (fans-dec as fs) _
    ((OrL _ _ f) (OrL _ _ (MkFitSec a h as s hr fs i1 i2 f)))
    ((OrR _ _ b) (OrR _ _ (OSFan a h as s hr fs b)))))

(def-fns _ $ (erased fit-dec : (erased (List (Sec)) os) (subterm erased (List (Sub)) p)
    -> (erased (Or (Pw (Sec) (Sub) FitSec os p) (Bad (Sec) (Sub) OutSec os p)) r))
  (let-match erased p (Cons _ x p1) ((Nil _) (OrL _ _ (PwNil _ _ FitSec os))))
  (let-match erased os (Cons _ o os1) ((Nil _) (OrR _ _ (BadShort _ _ OutSec x p1))))
  (let-match erased (sec-dec o x) (OrL _ _ i) ((OrR _ _ q) (OrR _ _ (BadHere _ _ OutSec o x os1 p1 q))))
  (match erased (fit-dec os1 p1) _
    ((OrL _ _ f) (OrL _ _ (PwCons _ _ FitSec o x os1 p1 i f)))
    ((OrR _ _ b) (OrR _ _ (BadThere _ _ OutSec o x os1 p1 b)))))

; c of the parts rs fit the sector list os.
(def-adts $ (Count : ((List (Sec)) os) ((List (List (Sub))) rs) ((Nat) c) -> Type)
  enum
  (many CNil : (erased (List (Sec)) os) -> (Count os (Nil (List (Sub))) (Zero)))
  (many CYes : (erased (List (Sec)) os) (erased (List (Sub)) r) (erased (List (List (Sub))) rs) (erased (Nat) c)
      (erased (Pw (Sec) (Sub) FitSec os r) f) (erased (Count os rs c) rest) -> (Count os (Cons (List (Sub)) r rs) (Succ c)))
  (many CNo : (erased (List (Sec)) os) (erased (List (Sub)) r) (erased (List (List (Sub))) rs) (erased (Nat) c)
      (erased (Bad (Sec) (Sub) OutSec os r) f) (erased (Count os rs c) rest) -> (Count os (Cons (List (Sub)) r rs) c)))

(def-fns _ $ (erased count-exists : (erased (List (Sec)) os) (subterm erased (List (List (Sub))) rs) -> (erased (Nat) c) (erased (Count os rs c) k))
  (let-match erased rs (Cons _ r rs1) ((Nil _) (values (Zero) (CNil os))))
  (let ((erased c) (erased k)) (count-exists os rs1))
  (match erased (fit-dec os r) _
    ((OrL _ _ f) (values (Succ c) (CYes os r rs1 c f k)))
    ((OrR _ _ b) (values c (CNo os r rs1 c b k)))))

(def-fns _ $ (erased count-le : (erased (List (Sec)) os) (erased (List (List (Sub))) rs) (erased (Nat) c l) (subterm erased (Count os rs c) k)
    (erased (Length (List (Sub)) rs l) pl) -> (erased (Lt c (Succ l)) r))
  (let-match erased pl (LengthCons _ _ rs1 l1 pl1) ((LengthNil _) (let-match erased k (CNil _)) (LtZ (Zero))))
  (match erased k _
    ((CYes _ _ _ c1 _ k1) (LtS c1 (Succ l1) (count-le os rs1 c1 l1 k1 pl1)))
    ((CNo _ _ _ _ _ k1) (lt-weaken c (Succ l1) (count-le os rs1 c l1 k1 pl1)))))

; sort_drules from the accumulators n and acc: m is n plus the rules of rs that p implies, and out is acc with the
; rules of rs that straddle p consed on in order.
(def-adts $ (Sr : ((List (Sub)) p) ((Nat) n) ((List (List (Sub))) acc rs) ((Nat) m) ((List (List (Sub))) out) -> Type)
  enum
  (many SrNil : (erased (List (Sub)) p) (erased (Nat) n) (erased (List (List (Sub))) acc) -> (Sr p n acc (Nil (List (Sub))) n acc))
  (many SrSub : (erased (List (Sub)) p r) (erased (Nat) n m) (erased (List (List (Sub))) acc rs out) (erased (Pw (Sub) (Sub) SubSub p r) s)
      (erased (Sr p (Succ n) acc rs m out) rest) -> (Sr p n acc (Cons (List (Sub)) r rs) m out))
  (many SrStr : (erased (List (Sub)) p r) (erased (Nat) n m) (erased (List (List (Sub))) acc rs out)
      (erased (Sr p n (Cons (List (Sub)) r acc) rs m out) rest) -> (Sr p n acc (Cons (List (Sub)) r rs) m out))
  (many SrDis : (erased (List (Sub)) p r) (erased (Nat) n m) (erased (List (List (Sub))) acc rs out) (erased (Ex (Sub) (Sub) SubDis p r) d)
      (erased (Sr p n acc rs m out) rest) -> (Sr p n acc (Cons (List (Sub)) r rs) m out)))

(def-fns _ $ (many sort-rec-c : (many (List (Sub)) p) (many (Nat) n) (many (List (List (Sub))) acc) (subterm many (List (List (Sub))) rs)
    -> (many (Nat) m) (many (List (List (Sub))) out) (erased (Sr p n acc rs m out) w))
  (let-match many rs (Cons _ r rest) ((Nil _) (values n acc (SrNil p n acc))))
  (let ((many k) (erased a)) (part-cmp p r))
  (match many k _
    ((PSub)
      (let-match erased a (AnsSub _ _ s))
      (let ((many m) (many out) (erased w)) (tail $ sort-rec-c p (Succ n) acc rest))
      (values m out (SrSub p r n m acc rest out s w)))
    ((PStr)
      (let ((many m) (many out) (erased w)) (tail $ sort-rec-c p n (Cons _ r acc) rest))
      (values m out (SrStr p r n m acc rest out w)))
    ((PDis)
      (let-match erased a (AnsDis _ _ d))
      (let ((many m) (many out) (erased w)) (tail $ sort-rec-c p n acc rest))
      (values m out (SrDis p r n m acc rest out d w)))))

(def-fns _ $ (many sort-drules-c : (many (List (Sub)) p) (many (List (List (Sub))) rs)
    -> (many (Nat) m) (many (List (List (Sub))) out) (erased (Sr p (Zero) (Nil (List (Sub))) rs m out) w))
  (sort-rec-c p (Zero) (Nil _) rs))

(def-fns _ $ (erased sr-count : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (Nat) n m ca c s1 s)
    (erased (List (List (Sub))) acc rs out) (erased (Pw (Sec) (Sub) FitSec os p) f) (subterm erased (Sr p n acc rs m out) w)
    (erased (Count os acc ca) ka) (erased (Count os rs c) kr) (erased (Add n ca s1) e1) (erased (Add s1 c s) e2)
    -> (erased (Nat) co) (erased (Count os out co) ko) (erased (Add m co s) e))
  (match erased w _
    ((SrNil _ _ _)
      (let-match erased kr (CNil _))
      (let-match erased (add-eq s1 (Zero) s s1 e2 (add-zero-right s1)) (Refl _ _))
      (values ca ka e1))
    ((SrSub _ r _ _ _ rs1 _ sb w1)
      (let-match erased kr (CYes _ _ _ c1 _ kr1) (absurd (CNo _ _ _ _ b _) (fit-bad os r (fit-sub os p r f sb) b)))
      (sr-count os p (Succ n) m ca c1 (Succ s1) s acc rs1 out f w1 ka kr1 (AddSucc n ca s1 e1) (add-shift s1 c1 s e2)))
    ((SrStr _ r _ _ _ rs1 _ w1)
      (match erased kr _
        ((CYes _ _ _ c1 fr kr1)
          (sr-count os p n m (Succ ca) c1 (Succ s1) s (Cons _ r acc) rs1 out f w1 (CYes os r acc ca fr ka) kr1
            (add-succ-right n ca s1 e1) (add-shift s1 c1 s e2)))
        ((CNo _ _ _ _ b kr1) (sr-count os p n m ca c s1 s (Cons _ r acc) rs1 out f w1 (CNo os r acc ca b ka) kr1 e1 e2))))
    ((SrDis _ r _ _ _ rs1 _ d w1)
      (let-match erased kr (CNo _ _ _ _ _ kr1) (absurd (CYes _ _ _ _ fr _) (fit-bad os r fr (fit-dis os p r f d))))
      (sr-count os p n m ca c s1 s acc rs1 out f w1 ka kr1 e1 e2))))

; Some rule of ru is implied by p.
(def-adts $ (Implied : ((List (Sub)) p) ((List (List (Sub))) ru) -> Type)
  enum
  (many ImHere : (erased (List (Sub)) p r) (erased (List (List (Sub))) ru) (erased (Pw (Sub) (Sub) SubSub p r) s) -> (Implied p (Cons (List (Sub)) r ru)))
  (many ImThere : (erased (List (Sub)) p r) (erased (List (List (Sub))) ru) (erased (Implied p ru) rest) -> (Implied p (Cons (List (Sub)) r ru))))

(def-fns _ $ (many check-unfit-c : (many (List (Sub)) p) (subterm many (List (List (Sub))) ru) -> (many (Bool) b) (erased (IfT b (Implied p ru)) w))
  (let-match many ru (Cons _ r rest) ((Nil _) (values (BFalse) (IfF _))))
  (let ((many k) (erased a)) (part-cmp p r))
  (let-match many k (PSub) (else
    (let ((many b) (erased w)) (tail $ check-unfit-c p rest))
    (values b (match erased w _ ((IfY _ i) (IfY _ (ImThere p r rest i))) ((IfF _) (IfF _))))))
  (let-match erased a (AnsSub _ _ s))
  (values (BTrue) (IfY _ (ImHere p r rest s))))

(def-fns _ $ (erased absurd unfit-sound : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (List (List (Sub))) ru)
    (subterm erased (Implied p ru) i) (erased (Pw (Sec) (Sub) FitSec os p) f) (erased (Count os ru (Zero)) k) -> (erased (False) r))
  (match erased i _
    (absurd (ImHere _ r _ s) (let-match erased k (CNo _ _ _ _ b _)) (fit-bad os r (fit-sub os p r f s) b))
    (absurd (ImThere _ _ ru1 i1) (let-match erased k (CNo _ _ _ _ _ k1)) (unfit-sound os p ru1 i1 f k1))))

; An exact fit, and an obligation that fits exactly.
(def-adts $ (Exact : ((List (Sec)) os) ((List (Sub)) p) -> Type)
  enum
  (many MkExact : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (Nat) n) (erased (Pw (Sec) (Sub) FitSec os p) f)
      (erased (Length (Sec) os n) lo) (erased (Length (Sub) p n) lp) -> (Exact os p)))

(def-adts $ (Hit : ((List (Sec)) os) ((List (List (Sub))) obl) -> Type)
  enum
  (many HitHere : (erased (List (Sec)) os) (erased (List (Sub)) q) (erased (List (List (Sub))) obl) (erased (Exact os q) x)
      -> (Hit os (Cons (List (Sub)) q obl)))
  (many HitThere : (erased (List (Sec)) os) (erased (List (Sub)) q) (erased (List (List (Sub))) obl) (erased (Hit os obl) h)
      -> (Hit os (Cons (List (Sub)) q obl))))

(def-adts $ (Ext : ((List (List (Sub))) acc out) -> Type)
  enum
  (many ExtRefl : (erased (List (List (Sub))) acc) -> (Ext acc acc))
  (many ExtCons : (erased (List (List (Sub))) acc out) (erased (List (Sub)) q) (erased (Ext acc out) e) -> (Ext acc (Cons (List (Sub)) q out))))

(def-fns _ $ (erased hit-ext : (erased (List (Sec)) os) (erased (List (List (Sub))) acc out) (erased (Hit os acc) h) (subterm erased (Ext acc out) e)
    -> (erased (Hit os out) r))
  (let-match erased e (ExtCons _ out1 q e1) ((ExtRefl _) h))
  (HitThere os q out1 (hit-ext os acc out1 h e1)))

(def-fns _ $ (erased ext-trans : (erased (List (List (Sub))) a b c) (erased (Ext a b) e) (subterm erased (Ext b c) e2) -> (erased (Ext a c) r))
  (let-match erased e2 (ExtCons _ c1 q e3) ((ExtRefl _) e))
  (ExtCons a c1 q (ext-trans a b c1 e e3)))

(def-fns _ $ (erased meet-len : (erased (List (Sub)) p q m) (erased (Nat) n) (subterm erased (PartMeet p q m) w) (erased (Length (Sub) p n) l)
    -> (erased (Length (Sub) m n) r))
  (let-match erased w (PMCons _ _ z p1 q1 m1 _ w1) ((PMKeep _ _) l))
  (let-match erased l (LengthCons _ _ _ n1 l1))
  (LengthCons _ z m1 n1 (meet-len p1 q1 m1 n1 w1 l1)))

(def-fns _ $ (erased exact-meet : (erased (List (Sec)) os) (erased (List (Sub)) p r m) (erased (Exact os p) x)
    (erased (Pw (Sec) (Sub) FitSec os r) fr) (erased (PartMeet p r m) w) -> (erased (Exact os m) y))
  (let-match erased x (MkExact _ _ n f lo lp))
  (MkExact os m n (fit-meet os p r m f fr w) lo (meet-len p r m n w lp)))

; A successful check_dbound1_rec from obligations acc to out.
(def-adts
  ((Db1 : ((List (Sub)) p) ((List (List (Sub))) rs) ((Nat) ns) ((List (List (Sub))) acc out) -> Type)
    enum
    (many D1Nil : (erased (List (Sub)) p) (erased (Nat) ns) (erased (List (List (Sub))) acc) -> (Db1 p (Nil (List (Sub))) ns acc acc))
    (many D1Small : (erased (List (Sub)) p r) (erased (List (List (Sub))) rs) (erased (Nat) ns l) (erased (List (List (Sub))) acc)
        (erased (Length (List (Sub)) rs l) pl) (erased (Lt l ns) lt) -> (Db1 p (Cons (List (Sub)) r rs) ns acc acc))
    (many D1Step : (erased (List (Sub)) p p1 r) (erased (List (List (Sub))) rs rs2) (erased (Nat) ns dns) (erased (List (List (Sub))) acc acc1 out)
        (erased (PartMeet p r p1) wm) (erased (Sr p1 (Zero) (Nil (List (Sub))) rs dns rs2) ws) (erased (Db1In p1 rs2 ns dns acc acc1) di)
        (erased (Db1 p rs ns acc1 out) dt) -> (Db1 p (Cons (List (Sub)) r rs) ns acc out)))
  ((Db1In : ((List (Sub)) p1) ((List (List (Sub))) rs2) ((Nat) ns dns) ((List (List (Sub))) acc acc1) -> Type)
    enum
    (many I1Rec : (erased (List (Sub)) p1) (erased (List (List (Sub))) rs2) (erased (Nat) ns dns ns1) (erased (List (List (Sub))) acc acc1)
        (erased (Monus ns dns (Succ ns1)) mo) (erased (Db1 p1 rs2 ns1 acc acc1) d) -> (Db1In p1 rs2 ns dns acc acc1))
    (many I1Red : (erased (List (Sub)) p1) (erased (List (List (Sub))) rs2) (erased (Nat) ns dns) (erased (List (List (Sub))) acc)
        (erased (Monus ns dns (Zero)) mo) -> (Db1In p1 rs2 ns dns acc (Cons (List (Sub)) p1 acc)))))

(def-fns _ $ (many cdb1-c : (many (List (Sub)) p) (many (List (List (Sub))) rs) (many (Nat) ns) (many (List (List (Sub))) acc) (subterm many (Nat) m)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (Db1 p rs ns acc out)) w))
  (let-match many m (Succ m1) ((Zero) (values (BFalse) acc (IfF _))))
  (let-match many rs (Cons _ r rs1) ((Nil _) (values (BTrue) acc (IfY _ (D1Nil p ns acc)))))
  (let ((many l) (erased pl)) (list-count _ rs1))
  (let-match many (lt-test l ns) (LtNo _ _) ((LtYes _ _ lt) (values (BTrue) acc (IfY _ (D1Small p r rs1 ns l acc pl lt)))))
  (let ((many p1) (erased wm)) (part-meet p r))
  (let ((many dns) (many rs2) (erased ws)) (sort-drules-c p1 rs1))
  (let ((many k) (erased mo)) (monus-c ns dns))
  (let ((many ok1) (many acc1) (erased w1))
    (match many k (((Bool) ok1) ((List (List (Sub))) acc1) ((IfT ok1 (Db1In p1 rs2 ns dns acc acc1)) w1))
      ((Succ ns1)
        (let ((many ok2) (many acc2) (erased w2)) (notail $ cdb1-c p1 rs2 ns1 acc m1))
        (values ok2 acc2 (match erased w2 _ ((IfY _ d) (IfY _ (I1Rec p1 rs2 ns dns ns1 acc acc2 mo d))) ((IfF _) (IfF _)))))
      ((Zero) (values (BTrue) (Cons _ p1 acc) (IfY _ (I1Red p1 rs2 ns dns acc mo))))))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc1 (IfF _))))
  (let-match erased w1 (IfY _ di))
  (let ((many ok) (many out) (erased w)) (tail $ cdb1-c p rs1 ns acc1 m1))
  (values ok out (match erased w _ ((IfY _ dt) (IfY _ (D1Step p p1 r rs1 rs2 ns dns acc acc1 out wm ws di dt))) ((IfF _) (IfF _)))))

(def-fns _ $ (erased db1-ext : (erased (List (Sub)) p) (erased (List (List (Sub))) rs) (erased (Nat) ns) (erased (List (List (Sub))) acc out)
    (subterm erased (Db1 p rs ns acc out) d) -> (erased (Ext acc out) e))
  (let-match erased d (D1Step _ p1 _ rs1 rs2 _ dns _ acc1 _ _ _ di dt) ((D1Nil _ _ _) (ExtRefl acc)) ((D1Small _ _ _ _ _ _ _ _) (ExtRefl acc)))
  (let ((erased (Ext acc acc1) e1))
    (match erased di _
      ((I1Rec _ _ _ _ ns1 _ _ _ d1) (db1-ext p1 rs2 ns1 acc acc1 d1))
      ((I1Red _ _ _ _ _ _) (ExtCons acc acc p1 (ExtRefl acc)))))
  (ext-trans acc acc1 out e1 (db1-ext p rs1 ns acc1 out dt)))

(def-fns _ $ (erased db1-sound : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (List (List (Sub))) rs) (erased (Nat) ns c)
    (erased (List (List (Sub))) acc out) (erased (Exact os p) x) (subterm erased (Db1 p rs ns acc out) d) (erased (Count os rs c) k)
    -> (erased (Or (Lt c (Succ ns)) (Hit os out)) r))
  (let-match erased d (D1Step _ p1 r rs1 rs2 _ dns _ acc1 _ wm ws di dt)
    ((D1Nil _ _ _) (let-match erased k (CNil _)) (OrL _ _ (LtZ ns)))
    ((D1Small _ r rs1 _ l _ pl lt)
      (OrL _ _ (le-tr c (Succ l) ns (count-le os rs c (Succ l) k (LengthCons _ r rs1 l pl)) (LtS l ns lt)))))
  (let-match erased k (CYes _ _ _ c1 fr k1) ((CNo _ _ _ _ _ k1) (db1-sound os p rs1 ns c acc1 out x dt k1)))
  (let ((erased x1)) (exact-meet os p r p1 x fr wm))
  (let-match erased x1 (MkExact _ _ _ f1 _ _))
  (let ((erased c2) (erased k2) (erased e))
    (sr-count os p1 (Zero) dns (Zero) c1 (Zero) c1 (Nil _) rs1 rs2 f1 ws (CNil os) k1 (AddZero (Zero)) (AddZero c1)))
  (let ((erased et)) (db1-ext p rs1 ns acc1 out dt))
  (let-match erased di (I1Rec _ _ _ _ ns1 _ _ mo d1) ((I1Red _ _ _ _ _ _) (OrR _ _ (hit-ext os acc1 out (HitHere os p1 acc x1) et))))
  (let-match erased mo (MoAdd _ _ _ ad))
  (match erased (db1-sound os p1 rs2 ns1 c2 acc acc1 x1 d1 k2) _
    ((OrL _ _ le) (OrL _ _ (LtS c1 ns (add-lt-r dns c2 c1 (Succ ns1) ns e ad le))))
    ((OrR _ _ h) (OrR _ _ (hit-ext os acc1 out h et)))))

(def-fns _ $ (many check-dbound1-c : (many (List (Sub)) p) (many (List (List (Sub))) rs) (many (Nat) ns) (many (List (List (Sub))) acc)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (Db1 p rs ns acc out)) w))
  (let ((many l) (erased _)) (list-count _ rs))
  (cdb1-c p rs ns acc (Succ l)))

; A successful check_dbound2_rec from obligations acc to out.
(def-adts
  ((Db2 : ((List (Sub)) p) ((List (List (Sub))) rt rs ru) ((Nat) nt) ((List (List (Sub))) acc out) -> Type)
    enum
    (many D2Nil : (erased (List (Sub)) p) (erased (List (List (Sub))) rs ru) (erased (Nat) nt) (erased (List (List (Sub))) acc)
        -> (Db2 p (Nil (List (Sub))) rs ru nt acc acc))
    (many D2Small : (erased (List (Sub)) p r) (erased (List (List (Sub))) rt rs ru) (erased (Nat) nt l) (erased (List (List (Sub))) acc)
        (erased (Length (List (Sub)) rt l) pl) (erased (Lt l nt) lt) -> (Db2 p (Cons (List (Sub)) r rt) rs ru nt acc acc))
    (many D2Step : (erased (List (Sub)) p p1 r) (erased (List (List (Sub))) rt rs ru) (erased (Nat) nt) (erased (List (List (Sub))) acc acc1 out)
        (erased (PartMeet p r p1) wm) (erased (Db2In p1 rt rs ru nt acc acc1) di) (erased (Db2 p rt rs (Cons (List (Sub)) r ru) nt acc1 out) dt)
        -> (Db2 p (Cons (List (Sub)) r rt) rs ru nt acc out)))
  ((Db2In : ((List (Sub)) p1) ((List (List (Sub))) rt rs ru) ((Nat) nt) ((List (List (Sub))) acc acc1) -> Type)
    enum
    (many I2Unfit : (erased (List (Sub)) p1) (erased (List (List (Sub))) rt rs ru) (erased (Nat) nt) (erased (List (List (Sub))) acc)
        (erased (Implied p1 ru) im) -> (Db2In p1 rt rs ru nt acc acc))
    (many I2Rec : (erased (List (Sub)) p1) (erased (List (List (Sub))) rt rs ru rt2 rs2) (erased (Nat) nt dnt dns u nt1)
        (erased (List (List (Sub))) acc acc1) (erased (Sr p1 (Zero) (Nil (List (Sub))) rt dnt rt2) wt) (erased (Sr p1 (Zero) (Nil (List (Sub))) rs dns rs2) ws)
        (erased (Add dns nt u) au) (erased (Monus u dnt (Succ nt1)) mo) (erased (Db2 p1 rt2 rs2 ru nt1 acc acc1) d) -> (Db2In p1 rt rs ru nt acc acc1))
    (many I2Red : (erased (List (Sub)) p1) (erased (List (List (Sub))) rt rs ru rt2 rs2) (erased (Nat) nt dnt dns u) (erased (List (List (Sub))) acc)
        (erased (Sr p1 (Zero) (Nil (List (Sub))) rt dnt rt2) wt) (erased (Sr p1 (Zero) (Nil (List (Sub))) rs dns rs2) ws)
        (erased (Add dns nt u) au) (erased (Monus u dnt (Zero)) mo) -> (Db2In p1 rt rs ru nt acc (Cons (List (Sub)) p1 acc)))))

(def-fns _ $ (many cdb2-c : (many (List (Sub)) p) (many (List (List (Sub))) rt rs ru) (many (Nat) nt) (many (List (List (Sub))) acc) (subterm many (Nat) m)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (Db2 p rt rs ru nt acc out)) w))
  (let-match many m (Succ m1) ((Zero) (values (BFalse) acc (IfF _))))
  (let-match many rt (Cons _ r rt1) ((Nil _) (values (BTrue) acc (IfY _ (D2Nil p rs ru nt acc)))))
  (let ((many l) (erased pl)) (list-count _ rt1))
  (let-match many (lt-test l nt) (LtNo _ _) ((LtYes _ _ lt) (values (BTrue) acc (IfY _ (D2Small p r rt1 rs ru nt l acc pl lt)))))
  (let ((many p1) (erased wm)) (part-meet p r))
  (let ((many ok1) (many acc1) (erased w1))
    (let ((many uf) (erased wu)) (check-unfit-c p1 ru))
    (match many uf (((Bool) ok1) ((List (List (Sub))) acc1) ((IfT ok1 (Db2In p1 rt1 rs ru nt acc acc1)) w1))
      ((BTrue) (let-match erased wu (IfY _ im)) (values (BTrue) acc (IfY _ (I2Unfit p1 rt1 rs ru nt acc im))))
      ((BFalse)
        (let ((many dnt) (many rt2) (erased wt)) (sort-drules-c p1 rt1))
        (let ((many dns) (many rs2) (erased ws)) (sort-drules-c p1 rs))
        (let ((many u) (erased au)) (add dns nt))
        (let ((many k) (erased mo)) (monus-c u dnt))
        (let-match many k (Succ nt1) ((Zero) (values (BTrue) (Cons _ p1 acc) (IfY _ (I2Red p1 rt1 rs ru rt2 rs2 nt dnt dns u acc wt ws au mo)))))
        (let ((many ok2) (many acc2) (erased w2)) (notail $ cdb2-c p1 rt2 rs2 ru nt1 acc m1))
        (values ok2 acc2 (match erased w2 _
          ((IfY _ d) (IfY _ (I2Rec p1 rt1 rs ru rt2 rs2 nt dnt dns u nt1 acc acc2 wt ws au mo d)))
          ((IfF _) (IfF _)))))))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc1 (IfF _))))
  (let-match erased w1 (IfY _ di))
  (let ((many ok) (many out) (erased w)) (tail $ cdb2-c p rt1 rs (Cons _ r ru) nt acc1 m1))
  (values ok out (match erased w _ ((IfY _ dt) (IfY _ (D2Step p p1 r rt1 rs ru nt acc acc1 out wm di dt))) ((IfF _) (IfF _)))))

(def-fns _ $ (erased db2-ext : (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs ru) (erased (Nat) nt) (erased (List (List (Sub))) acc out)
    (subterm erased (Db2 p rt rs ru nt acc out) d) -> (erased (Ext acc out) e))
  (let-match erased d (D2Step _ p1 r rt1 _ _ _ _ acc1 _ _ di dt) ((D2Nil _ _ _ _ _) (ExtRefl acc)) ((D2Small _ _ _ _ _ _ _ _ _ _) (ExtRefl acc)))
  (let ((erased (Ext acc acc1) e1))
    (match erased di _
      ((I2Unfit _ _ _ _ _ _ _) (ExtRefl acc))
      ((I2Rec _ _ _ _ rt2 rs2 _ _ _ _ nt1 _ _ _ _ _ _ d1) (db2-ext p1 rt2 rs2 ru nt1 acc acc1 d1))
      ((I2Red _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) (ExtCons acc acc p1 (ExtRefl acc)))))
  (ext-trans acc acc1 out e1 (db2-ext p rt1 rs (Cons _ r ru) nt acc1 out dt)))

; The arithmetic of a refined step: 1 + (dnt + c2) <= (dns + s2) + nt when dns + nt = dnt + (1 + nt1) and c2 <= s2 + nt1.
(def-fns _ $ (erased step-bound : (erased (Nat) dnt c2 c1 dns s2 cs nt u nt1 v w) (erased (Add dnt c2 c1) pa) (erased (Add dns s2 cs) pb)
    (erased (Add dns nt u) pcc) (erased (Add dnt (Succ nt1) u) pd) (erased (Add s2 nt1 v) pv) (erased (Lt c2 (Succ v)) le) (erased (Add cs nt w) pw)
    -> (erased (Lt (Succ c1) (Succ w)) r))
  (let ((erased y) (erased py)) (add dnt v))
  (let ((erased le1)) (add-le-r dnt c2 c1 v y pa py le))
  (let ((erased z) (erased pz) (erased pz2)) (plus-lcomm dnt s2 (Succ nt1) (Succ v) (Succ y) (add-succ-right s2 nt1 v pv) (add-succ-right dnt v y py)))
  (let-match erased (add-eq dnt (Succ nt1) z u pz pd) (Refl _ _))
  (let ((erased t) (erased pt) (erased pt2)) (plus-assoc dns s2 nt cs w pb pw))
  (let ((erased t2) (erased pq) (erased pq2)) (plus-lcomm s2 dns nt u (Succ y) pcc pz2))
  (let-match erased (add-eq s2 nt t2 t pq pt) (Refl _ _))
  (let-match erased (add-eq dns t (Succ y) w pq2 pt2) (Refl _ _))
  (LtS c1 w le1))

(def-fns _ $ (erased db2-sound : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs ru acc out) (erased (Nat) nt ct cs w)
    (erased (Exact os p) x) (subterm erased (Db2 p rt rs ru nt acc out) d) (erased (Count os rt ct) kt) (erased (Count os rs cs) ks)
    (erased (Count os ru (Zero)) ku) (erased (Add cs nt w) aw) -> (erased (Or (Lt ct (Succ w)) (Hit os out)) r))
  (let-match erased d (D2Step _ p1 r rt1 _ _ _ _ acc1 _ wm di dt)
    ((D2Nil _ _ _ _ _) (let-match erased kt (CNil _)) (OrL _ _ (LtZ w)))
    ((D2Small _ r rt1 _ _ _ l _ pl lt)
      (OrL _ _ (le-tr ct nt w (le-tr ct (Succ l) nt (count-le os rt ct (Succ l) kt (LengthCons _ r rt1 l pl)) (LtS l nt lt))
        (add-le-right cs nt w aw)))))
  (let-match erased kt (CYes _ _ _ c1 fr kt1)
    ((CNo _ _ _ _ b kt1) (db2-sound os p rt1 rs (Cons _ r ru) acc1 out nt ct cs w x dt kt1 ks (CNo os r ru (Zero) b ku) aw)))
  (let ((erased x1)) (exact-meet os p r p1 x fr wm))
  (let-match erased x1 (MkExact _ _ _ f1 _ _))
  (let ((erased et)) (db2-ext p rt1 rs (Cons _ r ru) nt acc1 out dt))
  (let-match erased di (I2Rec _ _ _ _ rt2 rs2 _ dnt dns u nt1 _ _ wt ws au mo d1)
    (absurd (I2Unfit _ _ _ _ _ _ im) (unfit-sound os p1 ru im f1 ku))
    ((I2Red _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) (OrR _ _ (hit-ext os acc1 out (HitHere os p1 acc x1) et))))
  (let-match erased mo (MoAdd _ _ _ ad))
  (let ((erased c2) (erased kt2) (erased e1))
    (sr-count os p1 (Zero) dnt (Zero) c1 (Zero) c1 (Nil _) rt1 rt2 f1 wt (CNil os) kt1 (AddZero (Zero)) (AddZero c1)))
  (let ((erased s2) (erased ks2) (erased e2))
    (sr-count os p1 (Zero) dns (Zero) cs (Zero) cs (Nil _) rs rs2 f1 ws (CNil os) ks (AddZero (Zero)) (AddZero cs)))
  (let ((erased v) (erased av)) (add s2 nt1))
  (match erased (db2-sound os p1 rt2 rs2 ru acc acc1 nt1 c2 s2 v x1 d1 kt2 ks2 ku av) _
    ((OrL _ _ le) (OrL _ _ (step-bound dnt c2 c1 dns s2 cs nt u nt1 v w e1 e2 au ad av le aw)))
    ((OrR _ _ h) (OrR _ _ (hit-ext os acc1 out h et)))))

; The arithmetic shared by the top-level checks: from c1 <= s1 + nt, with c = dn + c1, s = ds + s1 and dn + bn + nt = ds + bp,
; c + bn <= s + bp.
(def-fns _ $ (erased top-bound : (erased (Nat) dn c1 c ds s1 s bp bn x y nt w0 l r) (erased (Add dn c1 c) pcn) (erased (Add ds s1 s) ps)
    (erased (Add ds bp x) ax) (erased (Add dn bn y) ay) (erased (Add y nt x) an) (erased (Add s1 nt w0) aw) (erased (Lt c1 (Succ w0)) le)
    (erased (Add c bn l) al) (erased (Add s bp r) ar) -> (erased (Lt l (Succ r)) o))
  (let ((erased l2) (erased al2)) (add c1 y))
  (let ((erased r2) (erased ar2)) (add w0 y))
  (let ((erased le2)) (le-sum c1 w0 y y l2 r2 le (lt-succ y) al2 ar2))
  (let ((erased t1) (erased p1) (erased q1)) (plus-assoc dn c1 bn c l pcn al))
  (let ((erased z1) (erased p2) (erased q2)) (plus-lcomm c1 dn bn y l2 ay al2))
  (let-match erased (add-eq c1 bn z1 t1 p2 p1) (Refl _ _))
  (let-match erased (add-eq dn z1 l2 l q2 q1) (Refl _ _))
  (let ((erased t2) (erased p3) (erased q3)) (plus-assoc s1 nt y w0 r2 aw ar2))
  (let-match erased (add-eq y nt t2 x (add-comm nt y t2 p3) an) (Refl _ _))
  (let ((erased t3) (erased p4) (erased q4)) (plus-assoc ds s1 bp s r ps ar))
  (let ((erased z3) (erased p5) (erased q5)) (plus-lcomm s1 ds bp t2 r2 ax q3))
  (let-match erased (add-eq s1 bp z3 t3 p5 p4) (Refl _ _))
  (let-match erased (add-eq ds z3 r2 r q5 q4) (Refl _ _))
  le2)

(def-adts $ (Db2Top : ((List (Sub)) p) ((List (List (Sub))) rt rs) ((Z) b) ((List (List (Sub))) acc out) -> Type)
  enum
  (many MkDb2Top : (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs rt1 rs1 acc out) (erased (Nat) dnt dns bp bn x y nt)
      (erased (Sr p (Zero) (Nil (List (Sub))) rt dnt rt1) wt) (erased (Sr p (Zero) (Nil (List (Sub))) rs dns rs1) ws)
      (erased (Add dns bp x) ax) (erased (Add dnt bn y) ay) (erased (Add y nt x) an)
      (erased (Db2 p rt1 rs1 (Nil (List (Sub))) nt acc out) d) -> (Db2Top p rt rs (MkZ bp bn) acc out)))

(def-fns _ $ (many check-dbound2-c : (many (List (Sub)) p) (many (List (List (Sub))) rt rs) (many (Z) b) (many (List (List (Sub))) acc)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (Db2Top p rt rs b acc out)) w))
  (let-match many b (MkZ bp bn))
  (let ((many dnt) (many rt1) (erased wt)) (sort-drules-c p rt))
  (let ((many dns) (many rs1) (erased ws)) (sort-drules-c p rs))
  (let ((many x) (erased ax)) (add dns bp))
  (let ((many y) (erased ay)) (add dnt bn))
  (let-match many (le-dec y x) (LeY _ _ le) ((LeN _ _ _) (values (BFalse) acc (IfF _))))
  (let ((many nt) (erased mo)) (monus-c x y))
  (let-match erased mo (MoAdd _ _ _ an) (absurd (MoNeg _ _ l) (lt-le-absurd x y l le)))
  (let ((many l) (erased _)) (list-count _ rt1))
  (let ((many ok) (many out) (erased w)) (cdb2-c p rt1 rs1 (Nil _) nt acc (Succ $ Succ l)))
  (values ok out (match erased w _
    ((IfY _ d) (IfY _ (MkDb2Top p rt rs rt1 rs1 acc out dnt dns bp bn x y nt wt ws ax ay an d)))
    ((IfF _) (IfF _)))))

; The net transfer bound dbound2 <= b, read as ct + bn <= cs + bp for b = bp - bn.
(def-fns _ $ (erased db2-top-sound : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs acc out)
    (erased (Nat) bp bn ct cs l r) (erased (Exact os p) x) (erased (Db2Top p rt rs (MkZ bp bn) acc out) d) (erased (Count os rt ct) kt)
    (erased (Count os rs cs) ks) (erased (Add ct bn l) al) (erased (Add cs bp r) ar) -> (erased (Or (Lt l (Succ r)) (Hit os out)) o))
  (let-match erased d (MkDb2Top _ _ _ rt1 rs1 _ _ dnt dns _ _ sx y nt wt ws ax ay an d1))
  (let-match erased x (MkExact _ _ _ f _ _))
  (let ((erased ct1) (erased kt1) (erased et)) (sr-count os p (Zero) dnt (Zero) ct (Zero) ct (Nil _) rt rt1 f wt (CNil os) kt (AddZero (Zero)) (AddZero ct)))
  (let ((erased cs1) (erased ks1) (erased es)) (sr-count os p (Zero) dns (Zero) cs (Zero) cs (Nil _) rs rs1 f ws (CNil os) ks (AddZero (Zero)) (AddZero cs)))
  (let ((erased w0) (erased aw)) (add cs1 nt))
  (let-match erased (db2-sound os p rt1 rs1 (Nil _) acc out nt ct1 cs1 w0 x d1 kt1 ks1 (CNil os) aw) (OrL _ _ le) ((OrR _ _ h) (OrR _ _ h)))
  (OrL _ _ (top-bound dnt ct1 ct dns cs1 cs bp bn sx y nt w0 l r et es ax ay an aw le al ar)))

; (a + b) + (c + d) = (a + c) + (b + d).
(def-fns _ $ (erased add-mid : (erased (Nat) a b c d x y z) (erased (Add a b x) px) (erased (Add c d y) py) (erased (Add x y z) pz)
    -> (erased (Nat) ac bd) (erased (Add a c ac) p1) (erased (Add b d bd) p2) (erased (Add ac bd z) p3))
  (let ((erased by) (erased q1) (erased q2)) (plus-assoc a b y x z px pz))
  (let ((erased bd) (erased q3) (erased q4)) (plus-lcomm b c d y by py q1))
  (let ((erased ac) (erased q5) (erased q6)) (plus-assoc-r a c bd by z q2 q4))
  (values ac bd q5 q3 q6))

; Lists cut after n entries, appended, and rotated by n as rot of part.sl does.
(def-adts $ (CutAt : (Type A) ((Nat) n) ((List A) xs pre post) -> Type)
  enum
  (many CutAtZ : (erased Type A) (erased (List A) xs) -> (CutAt A (Zero) xs (Nil A) xs))
  (many CutAtNil : (erased Type A) (erased (Nat) n) -> (CutAt A (Succ n) (Nil A) (Nil A) (Nil A)))
  (many CutAtS : (erased Type A) (erased (Nat) n) (erased A x) (erased (List A) xs pre post) (erased (CutAt A n xs pre post) c)
      -> (CutAt A (Succ n) (Cons A x xs) (Cons A x pre) post)))

(def-adts $ (LApp : (Type A) ((List A) xs ys zs) -> Type)
  enum
  (many LAppNil : (erased Type A) (erased (List A) ys) -> (LApp A (Nil A) ys ys))
  (many LAppCons : (erased Type A) (erased A x) (erased (List A) xs ys zs) (erased (LApp A xs ys zs) a) -> (LApp A (Cons A x xs) ys (Cons A x zs))))

(def-adts $ (Rot : (Type A) ((Nat) n) ((List A) xs ys) -> Type)
  enum
  (many MkRot : (erased Type A) (erased (Nat) n) (erased (List A) xs ys pre post) (erased (CutAt A n xs pre post) c) (erased (LApp A post pre ys) a)
      -> (Rot A n xs ys)))

(def-fns _ $ (many cut-c : (erased Type A) (subterm many (Nat) n) (many (List A) xs) -> (many (List A) pre post) (erased (CutAt A n xs pre post) c))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs (CutAtZ _ xs))))
  (let-match many xs (Cons _ x rest) ((Nil _) (values (Nil _) (Nil _) (CutAtNil _ n1))))
  (let ((many pre) (many post) (erased c)) (notail $ cut-c _ n1 rest))
  (values (Cons _ x pre) post (CutAtS _ n1 x rest pre post c)))

(def-fns _ $ (many app-c : (erased Type A) (subterm many (List A) xs) (many (List A) ys) -> (many (List A) zs) (erased (LApp A xs ys zs) a))
  (let-match many xs (Cons _ x rest) ((Nil _) (values ys (LAppNil _ ys))))
  (let ((many zs) (erased a)) (notail $ app-c _ rest ys))
  (values (Cons _ x zs) (LAppCons _ x rest ys zs a)))

(def-fns _ $ (many rot-c : (erased Type A) (many (Nat) n) (many (List A) xs) -> (many (List A) ys) (erased (Rot A n xs ys) r))
  (let ((many pre) (many post) (erased c)) (cut-c _ n xs))
  (let ((many ys) (erased a)) (app-c _ post pre))
  (values ys (MkRot _ n xs ys pre post c a)))

; Lists of one length matched entry by entry.
(def-adts $ (PwE : (Type A) (Type B) ((TyCtor (A x) (B y) -> Type) R) ((List A) xs) ((List B) ys) -> Type)
  enum
  (many PwENil : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) -> (PwE A B R (Nil A) (Nil B)))
  (many PwECons : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) (erased A x) (erased B y) (erased (List A) xs)
      (erased (List B) ys) (erased (R x y) p) (erased (PwE A B R xs ys) rest) -> (PwE A B R (Cons A x xs) (Cons B y ys))))

(def-fns _ $ (erased pwe-cut : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) (erased (Nat) n) (erased (List A) xs a b)
    (erased (List B) ys c d) (subterm erased (PwE A B R xs ys) p) (erased (CutAt A n xs a b) cx) (erased (CutAt B n ys c d) cy)
    -> (erased (PwE A B R a c) r1) (erased (PwE A B R b d) r2))
  (match erased cx _
    ((CutAtZ _ _) (let-match erased cy (CutAtZ _ _)) (values (PwENil A B R) p))
    ((CutAtNil _ _) (let-match erased p (PwENil _ _ _)) (let-match erased cy (CutAtNil _ _)) (values (PwENil A B R) (PwENil A B R)))
    ((CutAtS _ n1 x xs1 a1 _ cx1)
      (let-match erased p (PwECons _ _ _ _ y _ ys1 rxy p1))
      (let-match erased cy (CutAtS _ _ _ _ c1 _ cy1))
      (let ((erased q1) (erased q2)) (pwe-cut A B R n1 xs1 a1 b ys1 c1 d p1 cx1 cy1))
      (values (PwECons A B R x y a1 c1 rxy q1) q2))))

(def-fns _ $ (erased pwe-app : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) (erased (List A) a b ab) (erased (List B) c d cd)
    (subterm erased (PwE A B R a c) p) (erased (PwE A B R b d) q) (erased (LApp A a b ab) pa) (erased (LApp B c d cd) pcd) -> (erased (PwE A B R ab cd) r))
  (let-match erased p (PwECons _ _ _ x y a1 c1 rxy p1)
    ((PwENil _ _ _) (let-match erased pa (LAppNil _ _)) (let-match erased pcd (LAppNil _ _)) q))
  (let-match erased pa (LAppCons _ _ _ _ ab1 pa1))
  (let-match erased pcd (LAppCons _ _ _ _ cd1 pc1))
  (PwECons A B R x y ab1 cd1 rxy (pwe-app A B R a1 b ab1 c1 d cd1 p1 q pa1 pc1)))

(def-fns _ $ (erased pwe-rot : (erased Type A B) (erased (TyCtor (A x) (B y) -> Type) R) (erased (Nat) n) (erased (List A) xs xs2) (erased (List B) ys ys2)
    (erased (PwE A B R xs ys) p) (erased (Rot A n xs xs2) rx) (erased (Rot B n ys ys2) ry) -> (erased (PwE A B R xs2 ys2) r))
  (let-match erased rx (MkRot _ _ _ _ a b cx ax))
  (let-match erased ry (MkRot _ _ _ _ c d cy ay))
  (let ((erased q1) (erased q2)) (pwe-cut A B R n xs a b ys c d p cx cy))
  (pwe-app A B R b a xs2 d c ys2 q2 q1 ax ay))

(def-fns _ $ (erased exact-pwe : (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (Nat) n) (subterm erased (Pw (Sec) (Sub) FitSec os p) f)
    (erased (Length (Sec) os n) lo) (erased (Length (Sub) p n) lp) -> (erased (PwE (Sec) (Sub) FitSec os p) r))
  (let-match erased f (PwCons _ _ _ o x os1 p1 fo f1)
    ((PwNil _ _ _ _) (let-match erased lp (LengthNil _)) (let-match erased lo (LengthNil _)) (PwENil _ _ FitSec)))
  (let-match erased lp (LengthCons _ _ _ n1 lp1))
  (let-match erased lo (LengthCons _ _ _ _ lo1))
  (PwECons _ _ FitSec o x os1 p1 fo (exact-pwe os1 p1 n1 f1 lo1 lp1)))

(def-fns _ $ (erased pwe-exact : (erased (List (Sec)) os) (erased (List (Sub)) p) (subterm erased (PwE (Sec) (Sub) FitSec os p) e)
    -> (erased (Exact os p) r))
  (let-match erased e (PwECons _ _ _ o x os1 p1 fo e1) ((PwENil _ _ _) (MkExact _ _ (Zero) (PwNil _ _ FitSec _) (LengthNil _) (LengthNil _))))
  (let-match erased (pwe-exact os1 p1 e1) (MkExact _ _ n f lo lp))
  (MkExact os p (Succ n) (PwCons _ _ FitSec o x os1 p1 fo f) (LengthCons _ o os1 n lo) (LengthCons _ x p1 n lp)))

(def-fns _ $ (erased exact-rot : (erased (List (Sec)) os os2) (erased (List (Sub)) p p2) (erased (Nat) i) (erased (Exact os p) x)
    (erased (Rot (Sec) i os os2) ro) (erased (Rot (Sub) i p p2) rp) -> (erased (Exact os2 p2) r))
  (let-match erased x (MkExact _ _ n f lo lp))
  (pwe-exact os2 p2 (pwe-rot _ _ FitSec i os os2 p p2 (exact-pwe os p n f lo lp) ro rp)))

; A successful check_2dbound2_rec: p2 is rotated by i from p1, and on a swap the index becomes nhub - i.
(def-adts
  ((Db22 : ((Nat) nhub) ((List (Sub)) p1 p2) ((List (List (Sub))) rt1 rs1 ru1 rt2 rs2 ru2) ((Nat) i nt) ((List (List (Sub))) acc out) -> Type)
    enum
    (many E2Done : (erased (Nat) nhub i nt) (erased (List (Sub)) p1 p2) (erased (List (List (Sub))) rs1 ru1 rs2 ru2 acc)
        -> (Db22 nhub p1 p2 (Nil (List (Sub))) rs1 ru1 (Nil (List (Sub))) rs2 ru2 i nt acc acc))
    (many E2Swap : (erased (Nat) nhub i j nt) (erased (List (Sub)) p1 p2 r) (erased (List (List (Sub))) rt2 rs1 ru1 rs2 ru2 acc out)
        (erased (Monus nhub i j) mo) (erased (Db22 nhub p2 p1 (Cons (List (Sub)) r rt2) rs2 ru2 (Nil (List (Sub))) rs1 ru1 j nt acc out) d)
        -> (Db22 nhub p1 p2 (Nil (List (Sub))) rs1 ru1 (Cons (List (Sub)) r rt2) rs2 ru2 i nt acc out))
    (many E2Small : (erased (Nat) nhub i nt l1 l2 l) (erased (List (Sub)) p1 p2 r) (erased (List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2 acc)
        (erased (Length (List (Sub)) rt3 l1) pl1) (erased (Length (List (Sub)) rt2 l2) pl2) (erased (Add l1 l2 l) al) (erased (Lt l nt) lt)
        -> (Db22 nhub p1 p2 (Cons (List (Sub)) r rt3) rs1 ru1 rt2 rs2 ru2 i nt acc acc))
    (many E2Step : (erased (Nat) nhub i nt) (erased (List (Sub)) p1 p2 r q1 q2) (erased (List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2 acc acc1 out)
        (erased (PartMeet p1 r q1) wm) (erased (Rot (Sub) i q1 q2) wr) (erased (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc acc1) di)
        (erased (Db22 nhub p1 p2 rt3 rs1 (Cons (List (Sub)) r ru1) rt2 rs2 ru2 i nt acc1 out) dt)
        -> (Db22 nhub p1 p2 (Cons (List (Sub)) r rt3) rs1 ru1 rt2 rs2 ru2 i nt acc out)))
  ((E2In : ((Nat) nhub) ((List (Sub)) q1 q2) ((List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2) ((Nat) i nt) ((List (List (Sub))) acc acc1) -> Type)
    enum
    (many J2Unfit1 : (erased (Nat) nhub i nt) (erased (List (Sub)) q1 q2) (erased (List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2 acc)
        (erased (Implied q1 ru1) im) -> (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc acc))
    (many J2Unfit2 : (erased (Nat) nhub i nt) (erased (List (Sub)) q1 q2) (erased (List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2 acc)
        (erased (Implied q2 ru2) im) -> (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc acc))
    (many J2Rec : (erased (Nat) nhub i nt dnt1 dns1 dnt2 dns2 u3 u dd nt1) (erased (List (Sub)) q1 q2)
        (erased (List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2 rt4 rs3 rt5 rs4 acc acc1)
        (erased (Sr q1 (Zero) (Nil (List (Sub))) rt3 dnt1 rt4) w1) (erased (Sr q1 (Zero) (Nil (List (Sub))) rs1 dns1 rs3) w2)
        (erased (Sr q2 (Zero) (Nil (List (Sub))) rt2 dnt2 rt5) w3) (erased (Sr q2 (Zero) (Nil (List (Sub))) rs2 dns2 rs4) w4)
        (erased (Add dns2 nt u3) a3) (erased (Add dns1 u3 u) a4) (erased (Add dnt1 dnt2 dd) a5) (erased (Monus u dd (Succ nt1)) mo)
        (erased (Db22 nhub q1 q2 rt4 rs3 ru1 rt5 rs4 ru2 i nt1 acc acc1) d) -> (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc acc1))
    (many J2Red : (erased (Nat) nhub i nt dnt1 dns1 dnt2 dns2 u3 u dd) (erased (List (Sub)) q1 q2)
        (erased (List (List (Sub))) rt3 rs1 ru1 rt2 rs2 ru2 rt4 rs3 rt5 rs4 acc)
        (erased (Sr q1 (Zero) (Nil (List (Sub))) rt3 dnt1 rt4) w1) (erased (Sr q1 (Zero) (Nil (List (Sub))) rs1 dns1 rs3) w2)
        (erased (Sr q2 (Zero) (Nil (List (Sub))) rt2 dnt2 rt5) w3) (erased (Sr q2 (Zero) (Nil (List (Sub))) rs2 dns2 rs4) w4)
        (erased (Add dns2 nt u3) a3) (erased (Add dns1 u3 u) a4) (erased (Add dnt1 dnt2 dd) a5) (erased (Monus u dd (Zero)) mo)
        -> (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc (Cons (List (Sub)) q1 acc)))))

(def-fns _ $ (many c2db2-c : (many (Nat) nhub) (many (List (Sub)) p1 p2) (many (List (List (Sub))) rt1 rs1 ru1 rt2 rs2 ru2) (many (Nat) i nt)
    (many (List (List (Sub))) acc) (subterm many (Nat) m)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (Db22 nhub p1 p2 rt1 rs1 ru1 rt2 rs2 ru2 i nt acc out)) w))
  (let-match many m (Succ m1) ((Zero) (values (BFalse) acc (IfF _))))
  (let-match many rt1 (Cons _ r rt3)
    ((Nil _)
      (let-match many rt2 (Cons _ r2 rt4) ((Nil _) (values (BTrue) acc (IfY _ (E2Done nhub i nt p1 p2 rs1 ru1 rs2 ru2 acc)))))
      (let ((many j) (erased mo)) (monus-c nhub i))
      (let ((many ok) (many out) (erased w)) (tail $ c2db2-c nhub p2 p1 rt2 rs2 ru2 rt1 rs1 ru1 j nt acc m1))
      (values ok out (match erased w _ ((IfY _ d) (IfY _ (E2Swap nhub i j nt p1 p2 r2 rt4 rs1 ru1 rs2 ru2 acc out mo d))) ((IfF _) (IfF _))))))
  (let ((many l1) (erased pl1)) (list-count _ rt3))
  (let ((many l2) (erased pl2)) (list-count _ rt2))
  (let ((many l) (erased al)) (add l1 l2))
  (let-match many (lt-test l nt) (LtNo _ _)
    ((LtYes _ _ lt) (values (BTrue) acc (IfY _ (E2Small nhub i nt l1 l2 l p1 p2 r rt3 rs1 ru1 rt2 rs2 ru2 acc pl1 pl2 al lt)))))
  (let ((many q1) (erased wm)) (part-meet p1 r))
  (let ((many q2) (erased wr)) (rot-c _ i q1))
  (let ((many ok1) (many acc1) (erased w1))
    (let ((many u1) (erased wu1)) (check-unfit-c q1 ru1))
    (match many u1 (((Bool) ok1) ((List (List (Sub))) acc1) ((IfT ok1 (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc acc1)) w1))
      ((BTrue) (let-match erased wu1 (IfY _ im)) (values (BTrue) acc (IfY _ (J2Unfit1 nhub i nt q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 acc im))))
      ((BFalse)
        (let ((many u2) (erased wu2)) (check-unfit-c q2 ru2))
        (match many u2 (((Bool) ok1) ((List (List (Sub))) acc1) ((IfT ok1 (E2In nhub q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 i nt acc acc1)) w1))
          ((BTrue) (let-match erased wu2 (IfY _ im)) (values (BTrue) acc (IfY _ (J2Unfit2 nhub i nt q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 acc im))))
          ((BFalse)
            (let ((many dnt1) (many rt4) (erased w1)) (sort-drules-c q1 rt3))
            (let ((many dns1) (many rs3) (erased w2)) (sort-drules-c q1 rs1))
            (let ((many dnt2) (many rt5) (erased w3)) (sort-drules-c q2 rt2))
            (let ((many dns2) (many rs4) (erased w4)) (sort-drules-c q2 rs2))
            (let ((many u3) (erased a3)) (add dns2 nt))
            (let ((many u) (erased a4)) (add dns1 u3))
            (let ((many dd) (erased a5)) (add dnt1 dnt2))
            (let ((many k) (erased mo)) (monus-c u dd))
            (let-match many k (Succ nt1)
              ((Zero) (values (BTrue) (Cons _ q1 acc) (IfY _ (J2Red nhub i nt dnt1 dns1 dnt2 dns2 u3 u dd q1 q2 rt3 rs1 ru1 rt2 rs2 ru2
                rt4 rs3 rt5 rs4 acc w1 w2 w3 w4 a3 a4 a5 mo)))))
            (let ((many ok2) (many acc2) (erased w5)) (notail $ c2db2-c nhub q1 q2 rt4 rs3 ru1 rt5 rs4 ru2 i nt1 acc m1))
            (values ok2 acc2 (match erased w5 _
              ((IfY _ d) (IfY _ (J2Rec nhub i nt dnt1 dns1 dnt2 dns2 u3 u dd nt1 q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 rt4 rs3 rt5 rs4 acc acc2
                w1 w2 w3 w4 a3 a4 a5 mo d)))
              ((IfF _) (IfF _)))))))))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc1 (IfF _))))
  (let-match erased w1 (IfY _ di))
  (let ((many ok) (many out) (erased w)) (tail $ c2db2-c nhub p1 p2 rt3 rs1 (Cons _ r ru1) rt2 rs2 ru2 i nt acc1 m1))
  (values ok out (match erased w _
    ((IfY _ dt) (IfY _ (E2Step nhub i nt p1 p2 r q1 q2 rt3 rs1 ru1 rt2 rs2 ru2 acc acc1 out wm wr di dt)))
    ((IfF _) (IfF _)))))

(def-fns _ $ (erased e2-ext : (erased (Nat) nhub i nt) (erased (List (Sub)) p1 p2) (erased (List (List (Sub))) rt1 rs1 ru1 rt2 rs2 ru2 acc out)
    (subterm erased (Db22 nhub p1 p2 rt1 rs1 ru1 rt2 rs2 ru2 i nt acc out) d) -> (erased (Ext acc out) e))
  (let-match erased d (E2Step _ _ _ _ _ r q1 q2 rt3 _ _ _ _ _ _ acc1 _ _ _ di dt)
    ((E2Done _ _ _ _ _ _ _ _ _ _) (ExtRefl acc))
    ((E2Swap _ _ j _ _ _ r rt4 _ _ _ _ _ _ _ d1) (e2-ext nhub j nt p2 p1 rt2 rs2 ru2 (Nil _) rs1 ru1 acc out d1))
    ((E2Small _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) (ExtRefl acc)))
  (let ((erased (Ext acc acc1) e1))
    (match erased di _
      ((J2Unfit1 _ _ _ _ _ _ _ _ _ _ _ _ _) (ExtRefl acc))
      ((J2Unfit2 _ _ _ _ _ _ _ _ _ _ _ _ _) (ExtRefl acc))
      ((J2Rec _ _ _ _ _ _ _ _ _ _ nt1 _ _ _ _ _ _ _ _ rt4 rs3 rt5 rs4 _ _ _ _ _ _ _ _ _ _ d1)
        (e2-ext nhub i nt1 q1 q2 rt4 rs3 ru1 rt5 rs4 ru2 acc acc1 d1))
      ((J2Red _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _) (ExtCons acc acc q1 (ExtRefl acc)))))
  (ext-trans acc acc1 out e1 (e2-ext nhub i nt p1 p2 rt3 rs1 (Cons _ r ru1) rt2 rs2 ru2 acc1 out dt)))

; The arithmetic of a refined step of the dual check.
(def-fns _ $ (erased step2-bound : (erased (Nat) c1 ct2 t0 dnt1 c4 dnt2 c5 dd t2 dns1 s3 cs1 dns2 s4 cs2 sc nt w u3 u nt1 s2 w2)
    (erased (Add c1 ct2 t0) at0) (erased (Add dnt1 c4 c1) b1) (erased (Add dnt2 c5 ct2) b2) (erased (Add dnt1 dnt2 dd) a5) (erased (Add c4 c5 t2) at2)
    (erased (Add dns1 s3 cs1) b3) (erased (Add dns2 s4 cs2) b4) (erased (Add cs1 cs2 sc) asc) (erased (Add sc nt w) aw)
    (erased (Add dns2 nt u3) a3) (erased (Add dns1 u3 u) a4) (erased (Add dd (Succ nt1) u) ad) (erased (Add s3 s4 s2) as2)
    (erased (Add s2 nt1 w2) aw2) (erased (Lt t2 (Succ w2)) le) -> (erased (Lt (Succ t0) (Succ w)) r))
  (let ((erased dd1) (erased t3) (erased q1) (erased q2) (erased q3)) (add-mid dnt1 c4 dnt2 c5 c1 ct2 t0 b1 b2 at0))
  (let-match erased (add-eq dnt1 dnt2 dd1 dd q1 a5) (Refl _ _))
  (let-match erased (add-eq c4 c5 t3 t2 q2 at2) (Refl _ _))
  (let ((erased dD) (erased sB) (erased r1) (erased r2) (erased r3)) (add-mid dns1 s3 dns2 s4 cs1 cs2 sc b3 b4 asc))
  (let-match erased (add-eq s3 s4 sB s2 r2 as2) (Refl _ _))
  (let ((erased bc) (erased r4) (erased r5)) (plus-assoc dD s2 nt sc w r3 aw))
  (let ((erased ab) (erased r6) (erased r7)) (plus-assoc-r dD nt s2 bc w r5 (add-comm s2 nt bc r4)))
  (let ((erased bc2) (erased r8) (erased r9)) (plus-assoc dns1 dns2 nt dD ab r1 r6))
  (let-match erased (add-eq dns2 nt bc2 u3 r8 a3) (Refl _ _))
  (let-match erased (add-eq dns1 u3 ab u r9 a4) (Refl _ _))
  (let ((erased e1) (erased r10) (erased r11)) (plus-assoc dd (Succ nt1) s2 u w ad r7))
  (let-match erased r10 (AddSucc _ _ e2 r12))
  (let-match erased (add-eq nt1 s2 e2 w2 r12 (add-comm s2 nt1 w2 aw2)) (Refl _ _))
  (let ((erased y) (erased py)) (add dd w2))
  (let-match erased (add-eq dd (Succ w2) w (Succ y) r11 (add-succ-right dd w2 y py)) (Refl _ _))
  (LtS t0 (Succ y) (add-le-r dd t2 t0 w2 y q3 py le)))

(def-fns _ $ (erased e2-sound : (erased (List (Sec)) os1 os2) (erased (Nat) nhub i j nt ct1 cs1 ct2 cs2 ts sc w) (erased (List (Sub)) p1 p2)
    (erased (List (List (Sub))) rt1 rs1 ru1 rt2 rs2 ru2 acc out) (erased (Rot (Sec) i os1 os2) ro12) (erased (Rot (Sec) j os2 os1) ro21)
    (erased (Add i j nhub) aij) (erased (Exact os1 p1) x1) (erased (Exact os2 p2) x2)
    (subterm erased (Db22 nhub p1 p2 rt1 rs1 ru1 rt2 rs2 ru2 i nt acc out) d)
    (erased (Count os1 rt1 ct1) kt1) (erased (Count os1 rs1 cs1) ks1) (erased (Count os1 ru1 (Zero)) ku1)
    (erased (Count os2 rt2 ct2) kt2) (erased (Count os2 rs2 cs2) ks2) (erased (Count os2 ru2 (Zero)) ku2)
    (erased (Add ct1 ct2 ts) ats) (erased (Add cs1 cs2 sc) asc) (erased (Add sc nt w) aw)
    -> (erased (Or (Lt ts (Succ w)) (Or (Hit os1 out) (Hit os2 out))) r))
  (match erased d _
    ((E2Done _ _ _ _ _ _ _ _ _ _)
      (let-match erased kt1 (CNil _))
      (let-match erased kt2 (CNil _))
      (let-match erased ats (AddZero _))
      (OrL _ _ (LtZ w)))
    ((E2Swap _ _ j2 _ _ _ r rt4 _ _ _ _ _ _ mo d1)
      (let-match erased mo (MoAdd _ _ _ a2) (absurd (MoNeg _ _ l) (lt-le-absurd nhub i l (add-le-left i j nhub aij))))
      (let-match erased (add-inj i j2 nhub j a2 aij) (Refl _ _))
      (match erased (e2-sound os2 os1 nhub j i nt ct2 cs2 ct1 cs1 ts sc w p2 p1 rt2 rs2 ru2 rt1 rs1 ru1 acc out ro21 ro12
          (add-comm i j nhub aij) x2 x1 d1 kt2 ks2 ku2 kt1 ks1 ku1 (add-comm ct1 ct2 ts ats) (add-comm cs1 cs2 sc asc) aw) _
        ((OrL _ _ le) (OrL _ _ le))
        ((OrR _ _ h) (OrR _ _ (match erased h _ ((OrL _ _ h2) (OrR _ _ h2)) ((OrR _ _ h1) (OrL _ _ h1)))))))
    ((E2Small _ _ _ l1 l2 l _ _ r rt3 _ _ _ _ _ _ pl1 pl2 al lt)
      (let ((erased le1)) (count-le os1 rt1 ct1 (Succ l1) kt1 (LengthCons _ r rt3 l1 pl1)))
      (let ((erased le2)) (count-le os2 rt2 ct2 l2 kt2 pl2))
      (let ((erased le3)) (le-sum ct1 (Succ l1) ct2 l2 ts (Succ l) le1 le2 ats (AddSucc l1 l2 l al)))
      (OrL _ _ (le-tr ts nt w (le-tr ts (Succ l) nt le3 (LtS l nt lt)) (add-le-right sc nt w aw))))
    ((E2Step _ _ _ _ _ r q1 q2 rt3 _ _ _ _ _ _ acc1 _ wm wr di dt)
      (let-match erased kt1 (CYes _ _ _ c1 fr kt3)
        ((CNo _ _ _ _ b kt3)
          (e2-sound os1 os2 nhub i j nt ct1 cs1 ct2 cs2 ts sc w p1 p2 rt3 rs1 (Cons _ r ru1) rt2 rs2 ru2 acc1 out ro12 ro21 aij x1 x2 dt
            kt3 ks1 (CNo os1 r ru1 (Zero) b ku1) kt2 ks2 ku2 ats asc aw)))
      (let ((erased y1)) (exact-meet os1 p1 r q1 x1 fr wm))
      (let ((erased y2)) (exact-rot os1 os2 q1 q2 i y1 ro12 wr))
      (let-match erased y1 (MkExact _ _ _ f1 _ _))
      (let-match erased y2 (MkExact _ _ _ f2 _ _))
      (let ((erased et)) (e2-ext nhub i nt p1 p2 rt3 rs1 (Cons _ r ru1) rt2 rs2 ru2 acc1 out dt))
      (let-match erased di (J2Rec _ _ _ dnt1 dns1 dnt2 dns2 u3 u dd nt1 _ _ _ _ _ _ _ _ rt4 rs3 rt5 rs4 _ _ w1 w2 w3 w4 a3 a4 a5 mo d1)
        (absurd (J2Unfit1 _ _ _ _ _ _ _ _ _ _ _ _ im) (unfit-sound os1 q1 ru1 im f1 ku1))
        (absurd (J2Unfit2 _ _ _ _ _ _ _ _ _ _ _ _ im) (unfit-sound os2 q2 ru2 im f2 ku2))
        ((J2Red _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _)
          (OrR _ _ (OrL _ _ (hit-ext os1 acc1 out (HitHere os1 q1 acc y1) et)))))
      (let-match erased mo (MoAdd _ _ _ ad))
      (let-match erased ats (AddSucc _ _ t0 at0))
      (let ((erased c4) (erased kt4) (erased b1)) (sr-count os1 q1 (Zero) dnt1 (Zero) c1 (Zero) c1 (Nil _) rt3 rt4 f1 w1 (CNil os1) kt3 (AddZero (Zero)) (AddZero c1)))
      (let ((erased s3) (erased ks3) (erased b3)) (sr-count os1 q1 (Zero) dns1 (Zero) cs1 (Zero) cs1 (Nil _) rs1 rs3 f1 w2 (CNil os1) ks1 (AddZero (Zero)) (AddZero cs1)))
      (let ((erased c5) (erased kt5) (erased b2)) (sr-count os2 q2 (Zero) dnt2 (Zero) ct2 (Zero) ct2 (Nil _) rt2 rt5 f2 w3 (CNil os2) kt2 (AddZero (Zero)) (AddZero ct2)))
      (let ((erased s4) (erased ks4) (erased b4)) (sr-count os2 q2 (Zero) dns2 (Zero) cs2 (Zero) cs2 (Nil _) rs2 rs4 f2 w4 (CNil os2) ks2 (AddZero (Zero)) (AddZero cs2)))
      (let ((erased t2) (erased at2)) (add c4 c5))
      (let ((erased s2) (erased as2)) (add s3 s4))
      (let ((erased wn2) (erased aw2)) (add s2 nt1))
      (match erased (e2-sound os1 os2 nhub i j nt1 c4 s3 c5 s4 t2 s2 wn2 q1 q2 rt4 rs3 ru1 rt5 rs4 ru2 acc acc1 ro12 ro21 aij y1 y2 d1
          kt4 ks3 ku1 kt5 ks4 ku2 at2 as2 aw2) _
        ((OrL _ _ le)
          (OrL _ _ (step2-bound c1 ct2 t0 dnt1 c4 dnt2 c5 dd t2 dns1 s3 cs1 dns2 s4 cs2 sc nt w u3 u nt1 s2 wn2
            at0 b1 b2 a5 at2 b3 b4 asc aw a3 a4 ad as2 aw2 le)))
        ((OrR _ _ h)
          (OrR _ _ (match erased h _
            ((OrL _ _ h1) (OrL _ _ (hit-ext os1 acc1 out h1 et)))
            ((OrR _ _ h2) (OrR _ _ (hit-ext os2 acc1 out h2 et))))))))))

(def-adts $ (E2Top : ((Nat) nhub) ((List (Sub)) p1) ((List (List (Sub))) rt rs) ((Nat) i) ((Z) b) ((List (List (Sub))) acc out) -> Type)
  enum
  (many MkE2Top : (erased (Nat) nhub i dnt1 dns1 dnt2 dns2 ds dn bp bn x y nt) (erased (List (Sub)) p1 p2)
      (erased (List (List (Sub))) rt rs rt1 rs1 rt2 rs2 acc out) (erased (Rot (Sub) i p1 p2) wr)
      (erased (Sr p1 (Zero) (Nil (List (Sub))) rt dnt1 rt1) w1) (erased (Sr p1 (Zero) (Nil (List (Sub))) rs dns1 rs1) w2)
      (erased (Sr p2 (Zero) (Nil (List (Sub))) rt dnt2 rt2) w3) (erased (Sr p2 (Zero) (Nil (List (Sub))) rs dns2 rs2) w4)
      (erased (Add dns1 dns2 ds) a1) (erased (Add dnt1 dnt2 dn) a2) (erased (Add ds bp x) ax) (erased (Add dn bn y) ay) (erased (Add y nt x) an)
      (erased (Db22 nhub p1 p2 rt1 rs1 (Nil (List (Sub))) rt2 rs2 (Nil (List (Sub))) i nt acc out) d) -> (E2Top nhub p1 rt rs i (MkZ bp bn) acc out)))

(def-fns _ $ (many check-2dbound2-c : (many (Nat) nhub) (many (List (Sub)) p1) (many (List (List (Sub))) rt rs) (many (Nat) i) (many (Z) b)
    (many (List (List (Sub))) acc) -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (E2Top nhub p1 rt rs i b acc out)) w))
  (let-match many b (MkZ bp bn))
  (let ((many p2) (erased wr)) (rot-c _ i p1))
  (let ((many dnt1) (many rt1) (erased w1)) (sort-drules-c p1 rt))
  (let ((many dns1) (many rs1) (erased w2)) (sort-drules-c p1 rs))
  (let ((many dnt2) (many rt2) (erased w3)) (sort-drules-c p2 rt))
  (let ((many dns2) (many rs2) (erased w4)) (sort-drules-c p2 rs))
  (let ((many ds) (erased a1)) (add dns1 dns2))
  (let ((many dn) (erased a2)) (add dnt1 dnt2))
  (let ((many x) (erased ax)) (add ds bp))
  (let ((many y) (erased ay)) (add dn bn))
  (let-match many (le-dec y x) (LeY _ _ le) ((LeN _ _ _) (values (BFalse) acc (IfF _))))
  (let ((many nt) (erased mo)) (monus-c x y))
  (let-match erased mo (MoAdd _ _ _ an) (absurd (MoNeg _ _ l) (lt-le-absurd x y l le)))
  (let ((many l1) (erased _)) (list-count _ rt1))
  (let ((many l2) (erased _)) (list-count _ rt2))
  (let ((many ok) (many out) (erased w)) (c2db2-c nhub p1 p2 rt1 rs1 (Nil _) rt2 rs2 (Nil _) i nt acc (nat-add l1 $ nat-add l2 3)))
  (values ok out (match erased w _
    ((IfY _ d) (IfY _ (MkE2Top nhub i dnt1 dns1 dnt2 dns2 ds dn bp bn x y nt p1 p2 rt rs rt1 rs1 rt2 rs2 acc out wr w1 w2 w3 w4 a1 a2 ax ay an d)))
    ((IfF _) (IfF _)))))

; The bound on the sum of two net transfers, read as ct1 + ct2 + bn <= cs1 + cs2 + bp for b = bp - bn.
(def-fns _ $ (erased e2-top-sound : (erased (List (Sec)) os1 os2) (erased (Nat) nhub i j bp bn ct1 cs1 ct2 cs2 ts ss l r) (erased (List (Sub)) p1)
    (erased (List (List (Sub))) rt rs acc out) (erased (Rot (Sec) i os1 os2) ro12) (erased (Rot (Sec) j os2 os1) ro21) (erased (Add i j nhub) aij)
    (erased (Exact os1 p1) x1) (erased (E2Top nhub p1 rt rs i (MkZ bp bn) acc out) d)
    (erased (Count os1 rt ct1) kt1) (erased (Count os1 rs cs1) ks1) (erased (Count os2 rt ct2) kt2) (erased (Count os2 rs cs2) ks2)
    (erased (Add ct1 ct2 ts) ats) (erased (Add cs1 cs2 ss) ass) (erased (Add ts bn l) al) (erased (Add ss bp r) ar)
    -> (erased (Or (Lt l (Succ r)) (Or (Hit os1 out) (Hit os2 out))) o))
  (let-match erased d (MkE2Top _ _ dnt1 dns1 dnt2 dns2 ds dn _ _ x y nt _ p2 _ _ rt1 rs1 rt2 rs2 _ _ wr w1 w2 w3 w4 a1 a2 ax ay an d1))
  (let ((erased x2)) (exact-rot os1 os2 p1 p2 i x1 ro12 wr))
  (let-match erased x1 (MkExact _ _ _ f1 _ _))
  (let-match erased x2 (MkExact _ _ _ f2 _ _))
  (let ((erased c1) (erased k1) (erased b1)) (sr-count os1 p1 (Zero) dnt1 (Zero) ct1 (Zero) ct1 (Nil _) rt rt1 f1 w1 (CNil os1) kt1 (AddZero (Zero)) (AddZero ct1)))
  (let ((erased s1) (erased k2) (erased b2)) (sr-count os1 p1 (Zero) dns1 (Zero) cs1 (Zero) cs1 (Nil _) rs rs1 f1 w2 (CNil os1) ks1 (AddZero (Zero)) (AddZero cs1)))
  (let ((erased c2) (erased k3) (erased b3)) (sr-count os2 p2 (Zero) dnt2 (Zero) ct2 (Zero) ct2 (Nil _) rt rt2 f2 w3 (CNil os2) kt2 (AddZero (Zero)) (AddZero ct2)))
  (let ((erased s2) (erased k4) (erased b4)) (sr-count os2 p2 (Zero) dns2 (Zero) cs2 (Zero) cs2 (Nil _) rs rs2 f2 w4 (CNil os2) ks2 (AddZero (Zero)) (AddZero cs2)))
  (let ((erased tc) (erased atc)) (add c1 c2))
  (let ((erased tsc) (erased atsc)) (add s1 s2))
  (let ((erased w0) (erased aw0)) (add tsc nt))
  (let-match erased (e2-sound os1 os2 nhub i j nt c1 s1 c2 s2 tc tsc w0 p1 p2 rt1 rs1 (Nil _) rt2 rs2 (Nil _) acc out ro12 ro21 aij x1 x2 d1
      k1 k2 (CNil os1) k3 k4 (CNil os2) atc atsc aw0) (OrL _ _ le) ((OrR _ _ h) (OrR _ _ h)))
  (let ((erased dn1) (erased tc1) (erased q1) (erased q2) (erased q3)) (add-mid dnt1 c1 dnt2 c2 ct1 ct2 ts b1 b3 ats))
  (let-match erased (add-eq dnt1 dnt2 dn1 dn q1 a2) (Refl _ _))
  (let-match erased (add-eq c1 c2 tc1 tc q2 atc) (Refl _ _))
  (let ((erased ds1) (erased sc1) (erased r1) (erased r2) (erased r3)) (add-mid dns1 s1 dns2 s2 cs1 cs2 ss b2 b4 ass))
  (let-match erased (add-eq dns1 dns2 ds1 ds r1 a1) (Refl _ _))
  (let-match erased (add-eq s1 s2 sc1 tsc r2 atsc) (Refl _ _))
  (OrL _ _ (top-bound dn tc ts ds tsc ss bp bn x y nt w0 l r q3 r3 ax ay an aw0 le al ar)))
