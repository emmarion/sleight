  (let-match many sm (BTrue) ((BFalse) (start-c p1 x)))
  (let-match erased se (IfY _ e))
  (let-match erased e (Refl _ _))
  st)

; The first walk of a quiz q starts with a test of question qa at z unless q is Qask0, QaskLL or QaskRR; a quiz whose qa
; is not the top tz there cannot pass, so it is not walked.
(def-fns _ $ (many walk-hope : (many (Qn) q) (erased (List (Sub)) p) (erased (RDart) x) (many (RStart p x) st) -> (many (Bool) b))
  (let-match many st (MkRStart _ _ okr _ _ otz tz))
  (match many q _
    ((Qask0) (BTrue))
    ((Qask1 qa) (andb okr (andb otz (nat-eqb qa tz))))
    ((QaskL qa _) (andb okr (andb otz (nat-eqb qa tz))))
    ((QaskR qa _) (andb okr (andb otz (nat-eqb qa tz))))
    ((QaskLR qa _ _) (andb okr (andb otz (nat-eqb qa tz))))
    (else okr)))

(def-fns _ $ (many qwalkr-c : (many (List (Sub)) p) (many (RDart) x) (many (Qn) q) (many (List (RPop)) acc) (many (RStart p x) st)
    -> (many (Bool) ok) (many (List (Sub)) p2) (many (List (RPop)) acc2) (erased (IfT ok (RWalkR p x q acc p2 acc2)) w)
    (many (Bool) sm) (erased (IfT sm (Eq (List (Sub)) p p2)) se))
  (let-match many (walk-hope q p x st) (BTrue) ((BFalse) (values (BFalse) p acc (IfF _) (BTrue) (IfY _ (Refl _ p)))))
  (let-match many q (Qask0) (else
    (let-match many st (MkRStart _ _ okr z wr _ _))
    (let-match many okr (BTrue) ((BFalse) (values (BFalse) p acc (IfF _) (BTrue) (IfY _ (Refl _ p)))))
    (let ((many ok) (many p2) (many acc2) (erased w) (many s) (erased e)) (qwalk-c p z q acc))
    (let-match many ok (BTrue) ((BFalse) (values (BFalse) p acc (IfF _) (BTrue) (IfY _ (Refl _ p)))))
    (let-match erased wr (IfY _ sr))
    (let-match erased w (IfY _ wq))
    (values (BTrue) p2 acc2 (IfY _ (WRS p p2 x z q acc acc2 sr wq)) s e)))
  (values (BTrue) p acc (IfY _ (WR0 p x acc)) (BTrue) (IfY _ (Refl _ p))))

(def-fns _ $ (many w3-c : (many (List (Sub)) p) (many (List (RPop)) acc) (many (RDart) x1 x2 x3) (many (Qn) q1 q2 q3)
    (many (RStart p x1) st1) (many (RStart p x2) st2) (many (RStart p x3) st3)
    -> (many (Bool) ok) (many (List (RPop)) acc2) (erased (IfT ok (RW3 p acc x1 x2 x3 q1 q2 q3 acc2)) w))
  (let ((many ok1) (many p4) (many c4) (erased w1) (many s1) (erased e1)) (qwalkr-c p x1 q1 acc st1))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc (IfF _))))
  (let ((many ok2) (many p5) (many c5) (erased w2) (many s2) (erased e2)) (qwalkr-c p4 x2 q2 c4 (start-at p p4 s1 e1 x2 st2)))
  (let-match many ok2 (BTrue) ((BFalse) (values (BFalse) acc (IfF _))))
  (let ((many sa) (erased ea)) (same-and p p4 p5 s1 e1 s2 e2))
  (let ((many ok3) (many p6) (many c6) (erased w3) (many _) (erased _)) (qwalkr-c p5 x3 q3 c5 (start-at p p5 sa ea x3 st3)))
  (let-match many ok3 (BTrue) ((BFalse) (values (BFalse) acc (IfF _))))
  (let-match erased w1 (IfY _ v1))
  (let-match erased w2 (IfY _ v2))
  (let-match erased w3 (IfY _ v3))
  (values (BTrue) c6 (IfY _ (MkRW3 p p4 p5 p6 acc c4 c5 c6 x1 x2 x3 q1 q2 q3 v1 v2 v3))))

(def-fns _ $ (many leaves-c : (many (List (Sub)) p) (many (List (RPop)) acc) (many (RDart) x1 x2 x3) (many (RStart p x1) st1) (many (RStart p x2) st2)
    (many (RStart p x3) st3) (subterm many (Qzt) t) -> (many (Bool) ok) (many (List (RPop)) acc2) (erased (IfT ok (RLeafs p acc x1 x2 x3 t acc2)) w))
  (let-match many t (QztLeaf q1 q2 q3 t1) (else (values (BFalse) acc (IfF _))))
  (let ((many ok) (many acc2) (erased w)) (w3-c p acc x1 x2 x3 q1 q2 q3 st1 st2 st3))
  (let-match many ok (BFalse) ((BTrue) (let-match erased w (IfY _ ws)) (values (BTrue) acc2 (IfY _ (MkRLeafs p acc acc2 x1 x2 x3 t q1 q2 q3 (QLHere q1 q2 q3 t1) ws)))))
  (let ((many okt) (many acc3) (erased wt)) (tail $ leaves-c p acc x1 x2 x3 st1 st2 st3 t1))
  (values okt acc3 (match erased wt _
    ((IfY _ lw)
      (let-match erased lw (MkRLeafs _ _ _ _ _ _ _ r1 r2 r3 lf ws))
      (IfY _ (MkRLeafs p acc acc3 x1 x2 x3 t r1 r2 r3 (QLThere r1 r2 r3 q1 q2 q3 t1 lf) ws)))
    ((IfF _) (IfF _)))))

(def-fns _ $ (many get-c : (many (Nat) a) (subterm many (Qzt) t) -> (many (Bool) ok) (many (Qzt) u) (erased (IfT ok (QGet a t u)) w))
  (match many t _
    ((QztNode t5 t6 t7 t8)
      (let-match many (nat-eq a 5) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t5 (IfY _ (QG5 t5 t6 t7 t8)))))
      (let-match many (nat-eq a 6) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t6 (IfY _ (QG6 t5 t6 t7 t8)))))
      (let-match many (nat-eq a 7) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t7 (IfY _ (QG7 t5 t6 t7 t8)))))
      (let-match many (nat-eq a 8) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t8 (IfY _ (QG8 t5 t6 t7 t8)))))
      (values (BFalse) t (IfF _)))
    ((QztHub t58 t9 t10 t11)
      (let-match many (nat-eq a 9) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t9 (IfY _ (QG9 t58 t9 t10 t11)))))
      (let-match many (nat-eq a 10) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t10 (IfY _ (QG10 t58 t9 t10 t11)))))
      (let-match many (nat-eq a 11) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) t11 (IfY _ (QG11 t58 t9 t10 t11)))))
      (let-match many (nat-cmp a 9) (CLt _ _ _ _ l) (else (values (BFalse) t (IfF _))))
      (let ((many ok) (many u) (erased w)) (notail $ get-c a t58))
      (let-match many ok (BTrue) ((BFalse) (values (BFalse) t (IfF _))))
      (let-match erased w (IfY _ g))
      (values (BTrue) u (IfY _ (QGLo a t58 t9 t10 t11 u l g))))
    (else (values (BFalse) t (IfF _)))))

(def-fns _ $ (many tri-c : (many (Qzt) qt) (many (List (Sub)) p) (many (RDart) x1) -> (many (Bool) ok) (many (List (RPop)) pops) (erased (IfT ok (RHit qt p pops)) w))
  (let ((many ok2) (many x2) (erased v2)) (ns-c p x1))
  (let-match many ok2 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many ok3) (many x3) (erased v3)) (ns-c p x2))
  (let-match many ok3 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many oa1) (many a1)) (top-c p x1))
  (let-match many oa1 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many oa2) (many a2)) (top-c p x2))
  (let-match many oa2 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many oa3) (many a3)) (top-c p x3))
  (let-match many oa3 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many og1) (many t1) (erased g1)) (get-c a1 qt))
  (let-match many og1 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many og2) (many t2) (erased g2)) (get-c a2 t1))
  (let-match many og2 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many og3) (many t3) (erased g3)) (get-c a3 t2))
  (let-match many og3 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let-match many t3 (QztLeaf _ _ _ _) (else (values (BFalse) (Nil _) (IfF _))))
  (let ((many os1) (many p1) (many c1) (erased s1) (many _) (erased _)) (test-c p x1 a1 (Nil _)))
  (let-match many os1 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many os2) (many p2) (many c2) (erased s2) (many _) (erased _)) (test-c p1 x2 a2 c1))
  (let-match many os2 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many os3) (many p3) (many c3) (erased s3) (many _) (erased _)) (test-c p2 x3 a3 c2))
  (let-match many os3 (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let ((many ol) (many pops) (erased wl)) (leaves-c p3 c3 x1 x2 x3 (start-c p3 x1) (start-c p3 x2) (start-c p3 x3) t3))
  (let-match many ol (BTrue) ((BFalse) (values (BFalse) (Nil _) (IfF _))))
  (let-match erased v2 (IfY _ n2))
  (let-match erased v3 (IfY _ n3))
  (let-match erased g1 (IfY _ h1))
  (let-match erased g2 (IfY _ h2))
  (let-match erased g3 (IfY _ h3))
  (let-match erased s1 (IfY _ u1))
  (let-match erased s2 (IfY _ u2))
  (let-match erased s3 (IfY _ u3))
  (let-match erased wl (IfY _ lw))
  (values (BTrue) pops (IfY _ (MkRHit qt t1 t2 t3 p p1 p2 p3 x1 x2 x3 a1 a2 a3 c1 c2 c3 pops n2 n3 u1 u2 u3 h1 h2 h3 lw))))

(def-fns _ $ (many first-c : (many (Qzt) qt) (many (List (Sub)) p) (subterm many (List (RDart)) ts) -> (many (Bool) ok) (many (List (RPop)) pops)
    (erased (IfT ok (RHit qt p pops)) w))
  (let-match many ts (Cons _ x rest) ((Nil _) (values (BFalse) (Nil _) (IfF _))))
  (let ((many ok) (many pops) (erased w)) (tri-c qt p x))
  (match many ok _
    ((BTrue) (values (BTrue) pops w))
    ((BFalse) (tail $ first-c qt p rest))))

(def-fns _ $ (many qfan-tries : (many (Nat) j) (subterm many (Nat) m) (many (Nat) k) -> (many (List (RDart)) ts))
  (let ((many t)) (DF (FS j) (Succ (Succ (Succ k)))))
  (let-match many m (Succ m1) ((Zero) (Cons _ t (Nil _))))
  (Cons _ t $ notail $ qfan-tries j m1 (Succ k)))

(def-fns _ $ (many tries-c : (many (List (Sub)) p) (many (Nat) j) -> (many (List (RDart)) ts))
  (let ((many base)) (Cons _ (DF (FH) j) $ Cons _ (DF (FS j) 2) $ Nil _))
  (let-match many (nth-r _ p j) (NthY _ _ _ x _) ((NthN _ _ _) base))
  (let-match many x (MkSub s _ fs))
  (let ((many m)) (size _ fs))
  (bif _ (orb (nat-ltb 0 m) (nat-eqb (rg-hi s) 5)) (cat _ base (qfan-tries j m (Zero))) base))

(def-fns _ $ (many search-c : (many (Qzt) qt) (many (List (Sub)) p) (many (Nat) n) (many (Nat) j) (subterm many (Nat) cnt)
    -> (many (Bool) ok) (many (List (RPop)) pops) (erased (IfT ok (RHit qt p pops)) w))
  (let-match many cnt (Succ c1) ((Zero) (values (BFalse) (Nil _) (IfF _))))
  (let ((many ok) (many pops) (erased w)) (first-c qt p (tries-c p j)))
  (match many ok _
    ((BTrue) (values (BTrue) pops w))
    ((BFalse) (tail $ search-c qt p n (bif _ (nat-eqb (Succ j) n) 0 (Succ j)) c1))))

(def-fns _ $ (many redp-all-c : (many (Qzt) qt) (subterm many (Nat) fuel) (subterm many (List (RPop)) pops) -> (many (Bool) ok) (erased (IfT ok (RedL qt pops)) w))
  (let-match many pops (Cons _ pp rest) ((Nil _) (values (BTrue) (IfY _ (RdNil qt)))))
  (let-match many fuel (Succ f1) ((Zero) (values (BFalse) (IfF _))))
  (let-match many pp (MkRPop p s))
  (let ((many n)) (size _ p))
  (let ((many okh) (many sub) (erased wh)) (search-c qt p n (bif _ (nat-eqb s 0) (monus n 1) (monus s 1)) n))
  (let-match many okh (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let ((many ok1) (erased w1)) (notail $ redp-all-c qt f1 sub))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let ((many ok2) (erased w2)) (notail $ redp-all-c qt fuel rest))
  (let-match many ok2 (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let-match erased wh (IfY _ hh))
  (let-match erased w1 (IfY _ l1))
  (let-match erased w2 (IfY _ l2))
  (values (BTrue) (IfY _ (RdCons qt p s rest (MkRedD qt p sub hh l1) l2))))

(def-fns _ $ (many redp-c : (many (Qzt) qt) (many (List (Sub)) p) -> (many (Bool) ok) (erased (IfT ok (RedD qt p)) w))
  (let ((many ok) (erased w)) (redp-all-c qt 128 (Cons _ (MkRPop p 0) $ Nil _)))
  (let-match many ok (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let-match erased w (IfY _ l))
  (let-match erased l (RdCons _ _ _ _ dd _))
  (values (BTrue) (IfY _ dd)))
