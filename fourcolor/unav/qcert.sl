(def-fns _ $ (many nat-at : (many (List (Nat)) xs) (many (Nat) i v) -> (many (ErasedMaybe (Nth (Nat) xs i v)) r))
  (let-match many (nth-q (Nat) xs i) (NthY _ _ _ y p) ((NthN _ _ _) (ENone _)))
  (let-match many (nat-eq y v) (Equal _ _ _) (else (ENone _)))
  (ESome _ p))

(def-fns _ $ (many resp-q : (many (List (Nat)) lab) (subterm many (List (Nat)) xs) -> (many (RespD lab xs) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (RsYes lab xs (Nil _) (RespNil lab))))
  (let-match many (nth-q (Nat) lab x) (NthY _ _ _ l p) ((NthN _ _ _) (RsNo lab xs)))
  (let-match many (notail $ resp-q lab rest) (RsYes _ _ ls q) ((RsNo _ _) (RsNo lab xs)))
  (RsYes lab xs (Cons _ l ls) (RespCons lab rest ls x l p q)))

(def-fns _ $ (many leq-q : (subterm many (List (Nat)) xs) (many (List (Nat)) ys) -> (many (ErasedMaybe (Eq (List (Nat)) xs ys)) r))
  (let-match many xs (Cons _ x xs1) ((Nil _) (match many ys _ ((Nil _) (ESome _ (Refl _ xs))) (else (ENone _)))))
  (let-match many ys (Cons _ y ys1) ((Nil _) (ENone _)))
  (let-match many (nat-eq x y) (Equal _ _ _) (else (ENone _)))
  (let-match many (notail $ leq-q xs1 ys1) (ESome _ q) ((ENone _) (ENone _)))
  (let-match erased q (Refl _ _))
  (ESome _ (Refl _ xs)))

(def-fns _ $ (many resp-to : (many (List (Nat)) lab xs ids) -> (many (ErasedMaybe (Respects lab xs ids)) r))
  (let-match many (resp-q lab xs) (RsYes _ _ ls p) ((RsNo _ _) (ENone _)))
  (let-match many (leq-q ls ids) (ESome _ q) ((ENone _) (ENone _)))
  (let-match erased q (Refl _ _))
  (ESome _ p))

(def-fns _ $ (many iota-c : (subterm many (Nat) n) -> (many (List (Nat)) ids) (erased (Iota n ids) io))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) (IotaZ))))
  (let ((many ids1) (erased io1)) (notail $ iota-c n1))
  (let ((many ids) (erased s)) (snoc-c _ ids1 n1))
  (values ids (IotaS n1 ids1 ids io1 s)))

(def-fns _ $ (many hyper-c : (erased (Nat) d) (many (List (Nat)) e n f ids) (erased (Iota d ids) io) -> (many (ErasedMaybe (Hypermap d e n f)) r))
  (let-match many (resp-q f e) (RsYes _ _ fe cfe) ((RsNo _ _) (ENone _)))
  (let-match many (resp-to n fe ids) (ESome _ ke) ((ENone _) (ENone _)))
  (let-match many (resp-q e n) (RsYes _ _ en cen) ((RsNo _ _) (ENone _)))
  (let-match many (resp-to f en ids) (ESome _ kn) ((ENone _) (ENone _)))
  (let-match many (resp-q n f) (RsYes _ _ nf cnf) ((RsNo _ _) (ENone _)))
  (let-match many (resp-to e nf ids) (ESome _ kf) ((ENone _) (ENone _)))
  (ESome _ (MkHypermap d e n f ids fe en nf io cfe ke cen kn cnf kf)))

(def-fns _ $ (many index-of : (many (Nat) x i) (subterm many (List (Nat)) p) -> (many (Nat) r))
  (let-match many p (Cons _ y rest) ((Nil _) i))
  (match many (nat-eqb x y) _ ((BTrue) i) ((BFalse) (tail $ index-of x (Succ i) rest))))

(def-fns _ $ (many inv-from : (many (List (Nat)) p) (many (Nat) x) (subterm many (Nat) k) -> (many (List (Nat)) q))
  (let-match many k (Succ k1) ((Zero) (Nil _)))
  (Cons _ (index-of x 0 p) (notail $ inv-from p (Succ x) k1)))

(def-fns _ $ (many path-c : (many (List (Nat)) p) (many (Nat) z x y) (subterm many (Nat) fuel) -> (many (WalkD p (Cons (Nat) z (Nil (Nat))) x y) r))
  (let-match many (nat-eq x y) (Unequal _ _ _ _ _) ((Equal _ _ _) (WkYes p _ x y (Nil _) (PathHere p _ x))))
  (let-match many fuel (Succ fuel1) ((Zero) (WkNo p _ x y)))
  (let-match many (nat-eq x z) (Unequal _ _ _ _ ne) ((Equal _ _ _) (WkNo p _ x y)))
  (let-match many (nth-q (Nat) p x) (NthY _ _ _ w pw) ((NthN _ _ _) (WkNo p _ x y)))
  (let-match many (notail $ path-c p z w y fuel1) (WkYes _ _ _ _ xs wk) ((WkNo _ _ _ _) (WkNo p _ x y)))
  (WkYes p _ x y (Cons _ x xs) (PathStep p _ xs x w y pw (NotInCons x z (Nil _) ne (NotInNil x)) wk)))

(def-fns _ $ (many order-c : (many (List (Nat)) p) (many (Nat) x d) -> (many (Nat) k) (many (ErasedMaybe (Order p x k)) r))
  (let-match many (nth-q (Nat) p x) (NthY _ _ _ y py) ((NthN _ _ _) (values 0 (ENone _))))
  (let-match many (path-c p x y x d) (WkYes _ _ _ _ xs w) ((WkNo _ _ _ _) (values 0 (ENone _))))
  (let ((many k) (erased l)) (size-c _ xs))
  (values (Succ k) (ESome _ (MkOrder p xs x y k py w l))))

(def-fns _ $ (many orders-c : (many (List (Nat)) p) (subterm many (List (Nat)) xs) (many (Nat) d) -> (many (List (Nat)) ks) (many (ErasedMaybe (Orders p xs ks)) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (values (Nil _) (ESome _ (OrdNil p)))))
  (let ((many k) (many c1)) (order-c p x d))
  (let ((many ks) (many c2)) (notail $ orders-c p rest d))
  (let-match many c1 (ESome _ o) ((ENone _) (values (Nil _) (ENone _))))
  (let-match many c2 (ESome _ os) ((ENone _) (values (Nil _) (ENone _))))
  (values (Cons _ k ks) (ESome _ (OrdCons p rest ks x k o os))))

(def-adts $ (QWalkD : ((List (Nat)) e n ks) ((Nat) x) ((Qn) q) ((List (Nat)) t at) -> Type)
  enum
  (many QWYes : (erased (List (Nat)) e n ks t at) (erased (Nat) x) (erased (Qn) q) (many (List (Nat)) s as) (erased (WalkS e n ks x q s t as at) w)
      -> (QWalkD e n ks x q t at))
  (many QWNo : (erased (List (Nat)) e n ks t at) (erased (Nat) x) (erased (Qn) q) -> (QWalkD e n ks x q t at)))

(def-fns _ $ (many qstepr-c : (many (List (Nat)) e n) (many (Nat) x) -> (many (Nat) y) (many (ErasedMaybe (QStepR e n x y)) r))
  (let-match many (nth-q (Nat) e x) (NthY _ _ _ a pa) ((NthN _ _ _) (values 0 (ENone _))))
  (let-match many (nth-q (Nat) n a) (NthY _ _ _ y py) ((NthN _ _ _) (values 0 (ENone _))))
  (values y (ESome _ (MkQStepR e n x a y pa py))))

(def-fns _ $ (many qstepl-c : (many (List (Nat)) e n) (many (Nat) x) -> (many (Nat) y) (many (ErasedMaybe (QStepL e n x y)) r))
  (let-match many (nth-q (Nat) n x) (NthY _ _ _ a pa) ((NthN _ _ _) (values 0 (ENone _))))
  (let-match many (nth-q (Nat) e a) (NthY _ _ _ b pb) ((NthN _ _ _) (values 0 (ENone _))))
  (let-match many (nth-q (Nat) n b) (NthY _ _ _ y py) ((NthN _ _ _) (values 0 (ENone _))))
  (values y (ESome _ (MkQStepL e n x a b y pa pb py))))

(def-fns _ $ (many qwalk-c : (many (List (Nat)) e n ks t at) (many (Nat) x) (subterm many (Qn) q) -> (many (QWalkD e n ks x q t at) r))
  (let ((many (QWalkD e n ks x q t at) no)) (QWNo e n ks t at x q))
  (match many q _
    ((Qask0) (QWYes e n ks t at x q t at (WS0 e n ks t at x)))
    ((Qask1 qa)
      (let-match many (nat-at ks x qa) (ESome _ pa) ((ENone _) no))
      (QWYes e n ks t at x q (Cons _ x t) (Cons _ qa at) (WS1 e n ks t at x qa pa)))
    ((QaskL qa q1)
      (let-match many (nat-at ks x qa) (ESome _ pa) ((ENone _) no))
      (let ((many y) (many cs)) (qstepl-c e n x))
      (let-match many cs (ESome _ sp) ((ENone _) no))
      (let-match many (notail $ qwalk-c e n ks t at y q1) (QWYes _ _ _ _ _ _ _ s as w) ((QWNo _ _ _ _ _ _ _) no))
      (QWYes e n ks t at x q (Cons _ x s) (Cons _ qa as) (WSL e n ks s t as at x qa y q1 pa sp w)))
    ((QaskR qa q1)
      (let-match many (nat-at ks x qa) (ESome _ pa) ((ENone _) no))
      (let ((many y) (many cs)) (qstepr-c e n x))
      (let-match many cs (ESome _ sp) ((ENone _) no))
      (let-match many (notail $ qwalk-c e n ks t at y q1) (QWYes _ _ _ _ _ _ _ s as w) ((QWNo _ _ _ _ _ _ _) no))
      (QWYes e n ks t at x q (Cons _ x s) (Cons _ qa as) (WSR e n ks s t as at x qa y q1 pa sp w)))
    ((QaskLR qa ql qr)
      (let-match many (nat-at ks x qa) (ESome _ pa) ((ENone _) no))
      (let ((many yl) (many cl)) (qstepl-c e n x))
      (let-match many cl (ESome _ sl) ((ENone _) no))
      (let ((many yr) (many cr)) (qstepr-c e n x))
      (let-match many cr (ESome _ sr) ((ENone _) no))
      (let-match many (notail $ qwalk-c e n ks t at yr qr) (QWYes _ _ _ _ _ _ _ u au wr) ((QWNo _ _ _ _ _ _ _) no))
      (let-match many (notail $ qwalk-c e n ks u au yl ql) (QWYes _ _ _ _ _ _ _ s as wl) ((QWNo _ _ _ _ _ _ _) no))
      (QWYes e n ks t at x q (Cons _ x s) (Cons _ qa as) (WSLR e n ks s u t as au at x qa yl yr ql qr pa sl wl sr wr)))
    ((QaskLL qa q1)
      (let ((many xl) (many c1)) (qstepl-c e n x))
      (let-match many c1 (ESome _ s1) ((ENone _) no))
      (let-match many (nth-q (Nat) n xl) (NthY _ _ _ c pc) ((NthN _ _ _) no))
      (let-match many (nth-q (Nat) e c) (NthY _ _ _ c2 pc2) ((NthN _ _ _) no))
      (let-match many (nat-at ks c2 qa) (ESome _ pa) ((ENone _) no))
      (let ((many y) (many c3)) (qstepl-c e n xl))
      (let-match many c3 (ESome _ s2) ((ENone _) no))
      (let-match many (notail $ qwalk-c e n ks t at y q1) (QWYes _ _ _ _ _ _ _ s as w) ((QWNo _ _ _ _ _ _ _) no))
      (QWYes e n ks t at x q (Cons _ c2 s) (Cons _ qa as) (WSLL e n ks s t as at x qa xl c c2 y q1 s1 pc pc2 pa s2 w)))
    ((QaskRR qa q1)
      (let ((many xr) (many c1)) (qstepr-c e n x))
      (let-match many c1 (ESome _ s1) ((ENone _) no))
      (let-match many (nat-at ks xr qa) (ESome _ pa) ((ENone _) no))
      (let ((many y) (many c3)) (qstepr-c e n xr))
      (let-match many c3 (ESome _ s2) ((ENone _) no))
      (let-match many (notail $ qwalk-c e n ks t at y q1) (QWYes _ _ _ _ _ _ _ s as w) ((QWNo _ _ _ _ _ _ _) no))
      (QWYes e n ks t at x q (Cons _ xr s) (Cons _ qa as) (WSRR e n ks s t as at x qa xr y q1 s1 pa s2 w)))))

(def-adts $ (WalkZD : ((List (Nat)) e n ks) ((Nat) x) ((Quiz) qz) -> Type)
  enum
  (many WZYes : (erased (List (Nat)) e n ks) (erased (Nat) x) (erased (Quiz) qz) (many (List (Nat)) s as) (erased (WalkZ e n ks x qz s as) w) -> (WalkZD e n ks x qz))
  (many WZNo : (erased (List (Nat)) e n ks) (erased (Nat) x) (erased (Quiz) qz) -> (WalkZD e n ks x qz)))

(def-fns _ $ (many walkz-c : (many (List (Nat)) e n ks) (many (Nat) x) (many (Quiz) qz) -> (many (WalkZD e n ks x qz) r))
  (let ((many (WalkZD e n ks x qz) no)) (WZNo e n ks x qz))
  (let-match many qz (MkQuiz q0 q1))
  (let-match many (nth-q (Nat) e x) (NthY _ _ _ x1 px) ((NthN _ _ _) no))
  (let-match many (qwalk-c e n ks (Nil _) (Nil _) x1 q1) (QWYes _ _ _ _ _ _ _ u au w1) ((QWNo _ _ _ _ _ _ _) no))
  (let-match many (qwalk-c e n ks u au x q0) (QWYes _ _ _ _ _ _ _ s as w0) ((QWNo _ _ _ _ _ _ _) no))
  (WZYes e n ks x qz s as (MkWalkZ e n ks s u as au x x1 q0 q1 w0 px w1)))

(def-fns _ $ (many set-at : (erased Type A) (subterm many (List A) xs) (many (Nat) i) (many A v) -> (many (List A) ys))
  (let-match many xs (Cons _ x rest) ((Nil _) xs))
  (let-match many i (Succ i1) ((Zero) (Cons _ v rest)))
  (Cons _ x (notail $ set-at _ rest i1 v)))

(def-fns _ $ (many get-at : (erased Type A) (subterm many (List A) xs) (many (Nat) i) (many A v) -> (many A r))
  (let-match many xs (Cons _ x rest) ((Nil _) v))
  (let-match many i (Succ i1) ((Zero) x))
  (tail $ get-at _ rest i1 v))

(def-fns _ $ (many mark-face : (many (List (Nat)) f) (many (List (KSt)) st) (many (Nat) i j y) (subterm many (Nat) left) -> (many (List (KSt)) st2))
  (let-match many left (Succ l1) ((Zero) st))
  (tail $ mark-face f (set-at _ st y (StIn i j)) i (Succ j) (get-at _ f y 0) l1))

(def-fns _ $ (many mark-all : (many (List (Nat)) f ks) (many (List (KSt)) st) (many (Nat) i) (subterm many (List (Nat)) s) -> (many (List (KSt)) st2))
  (let-match many s (Cons _ c rest) ((Nil _) st))
  (tail $ mark-all f ks (mark-face f st i 0 c (get-at _ ks c 0)) (Succ i) rest))

(def-fns _ $ (many kind-lab : (subterm many (List (KSt)) st) -> (many (List (Nat)) lab))
  (let-match many st (Cons _ s rest) ((Nil _) (Nil _)))
  (Cons _ (match many s _ ((StOut) (Zero)) (else (Succ (Zero)))) (notail $ kind-lab rest)))

(def-fns _ $ (many in-q : (many (Nat) x) (subterm many (List (Nat)) s) -> (many (InD x s) r))
  (let-match many s (Cons _ y rest) ((Nil _) (IDOut x s (NotInNil x))))
  (let-match many (nat-eq x y) (Unequal _ _ _ _ ne)
    ((Equal _ _ _) (IDIn x s (InHere x rest))))
  (match many (notail $ in-q x rest) _
    ((IDIn _ _ p) (IDIn x s (InThere x y rest p)))
    ((IDOut _ _ p) (IDOut x s (NotInCons x y rest ne p)))))

(def-fns _ $ (many fband-q : (many (List (Nat)) f p) (many (Nat) x) (subterm many (Nat) fuel) -> (many (ErasedMaybe (Fband f p x)) r))
  (let-match many (in-q x p) (IDOut _ _ _) ((IDIn _ _ i) (ESome _ (MkFband f p x x i (MkSomePath f (Nil _) (Nil _) x x (PathHere f (Nil _) x))))))
  (let-match many fuel (Succ fuel1) ((Zero) (ENone _)))
  (let-match many (nth-q (Nat) f x) (NthY _ _ _ z pz) ((NthN _ _ _) (ENone _)))
  (let-match many (notail $ fband-q f p z fuel1) (ESome _ fb) ((ENone _) (ENone _)))
  (let-match erased fb (MkFband _ _ _ y iy sp))
  (let-match erased sp (MkSomePath _ _ xs _ _ w))
  (ESome _ (MkFband f p x y iy (MkSomePath f (Nil _) (Cons _ x xs) x y (PathStep f (Nil _) xs x z y pz (NotInNil x) w)))))

(def-adts $ (IterD : ((List (Nat)) f) ((Nat) k x) -> Type)
  enum
  (many ItYes : (erased (List (Nat)) f) (erased (Nat) k x) (many (Nat) y) (erased (Iter f k x y) it) -> (IterD f k x))
  (many ItNo : (erased (List (Nat)) f) (erased (Nat) k x) -> (IterD f k x)))

(def-fns _ $ (many iter-c : (many (List (Nat)) f) (subterm many (Nat) k) (many (Nat) x) -> (many (IterD f k x) r))
  (let-match many k (Succ k1) ((Zero) (ItYes f k x x (ItZ f x))))
  (let-match many (nth-q (Nat) f x) (NthY _ _ _ z pz) ((NthN _ _ _) (ItNo f k x)))
  (let-match many (notail $ iter-c f k1 z) (ItYes _ _ _ y it) ((ItNo _ _ _) (ItNo f k x)))
  (ItYes f k x y (ItS f k1 x z y pz it)))

(def-fns _ $ (many dart-c : (many (Nat) d) (many (List (Nat)) ec nc fc ksc rc s0c lab) (erased (List (Nat)) lr) (many (List (KSt)) st) (erased (Respects lab fc lab) rf)
    (erased (Respects lab rc lr) rp) (erased (NotIn (Succ (Zero)) lr) out) (many (Nat) x) -> (many (ErasedMaybe (DartOK ec nc fc ksc rc s0c st x)) r))
  (let-match many (nth-q (Nat) fc x) (NthY _ _ _ x1 px) ((NthN _ _ _) (ENone _)))
  (let-match many (nth-q (KSt) st x) (NthY _ _ _ sx ps) ((NthN _ _ _) (ENone _)))
  (let-match many (nth-q (KSt) st x1) (NthY _ _ _ sx1 ps1) ((NthN _ _ _) (ENone _)))
  (match many sx _
    ((StOut)
      (let-match many sx1 (StOut) (else (ENone _)))
      (let-match many (fband-q fc rc x d) (ESome _ fb) ((ENone _) (ENone _)))
      (ESome _ (DOut ec nc fc ksc rc s0c st x x1 ps fb px ps1)))
    ((StIn i j)
      (let-match many sx1 (StIn i1 j1) (else (ENone _)))
      (let-match many (nat-eq i1 i) (Equal _ _ _) (else (ENone _)))
      (let-match many (nth-q (Nat) s0c i) (NthY _ _ _ c pc) ((NthN _ _ _) (ENone _)))
      (let-match many (iter-c fc j c) (ItYes _ _ _ y it) ((ItNo _ _ _) (ENone _)))
      (let-match many (nat-eq y x) (Equal _ _ _) (else (ENone _)))
      (let-match many (nth-q (Nat) ksc c) (NthY _ _ _ a pa) ((NthN _ _ _) (ENone _)))
      (let-match many (lt-dec j a) (Yes _ _ _ _ lj) (else (ENone _)))
      (let-match many (nat-at ksc x a) (ESome _ pxa) ((ENone _) (ENone _)))
      (let ((many (ErasedMaybe (NextIx j a j1)) nxc))
        (match many (nat-eq j1 (Succ j)) _
          ((Equal _ _ _) (ESome _ (NxStep j a)))
          (else
            (let-match many j1 (Zero) (else (ENone _)))
            (match many (nat-eq a (Succ j)) _ ((Equal _ _ _) (ESome _ (NxWrap j))) (else (ENone _))))))
      (let-match many nxc (ESome _ nx) ((ENone _) (ENone _)))
      (let-match many (nth-q (Nat) ec x) (NthY _ _ _ ye pe) ((NthN _ _ _) (ENone _)))
      (let-match many (nat-at ec ye x) (ESome _ pe2) ((ENone _) (ENone _)))
      (let-match many (nth-q (Nat) nc x) (NthY _ _ _ u1 pn1) ((NthN _ _ _) (ENone _)))
      (let-match many (nth-q (Nat) nc u1) (NthY _ _ _ u2 pn2) ((NthN _ _ _) (ENone _)))
      (let-match many (nat-at nc u2 x) (ESome _ pn3) ((ENone _) (ENone _)))
      (let-match many (nth-q (KSt) st c) (NthY _ _ _ sc pc0) ((NthN _ _ _) (ENone _)))
      (let-match many sc (StIn i2 j2) (else (ENone _)))
      (let-match many (nat-eq i2 i) (Equal _ _ _) (else (ENone _)))
      (let-match many j2 (Zero) (else (ENone _)))
      (let-match many (nat-at lab x (Succ (Zero))) (ESome _ plx) ((ENone _) (ENone _)))
      (ESome _ (DIn ec nc fc ksc rc s0c st x i j c a x1 j1 ye u1 u2 ps pc it pa lj pxa px ps1 nx pe pe2 pn1 pn2 pn3 pc0
        (MkKernel fc rc lab lr x (Succ (Zero)) rf rp plx out))))))

(def-fns _ $ (many darts-c : (many (Nat) d) (many (List (Nat)) ec nc fc ksc rc s0c lab lr) (many (List (KSt)) st) (erased (Respects lab fc lab) rf)
    (erased (Respects lab rc lr) rp) (erased (NotIn (Succ (Zero)) lr) out) (subterm many (List (Nat)) xs) -> (many (ErasedMaybe (DartsOK ec nc fc ksc rc s0c st xs)) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (ESome _ (DKNil ec nc fc ksc rc s0c st))))
  (let-match many (dart-c d ec nc fc ksc rc s0c lab lr st rf rp out x) (ESome _ dx) ((ENone _) (ENone _)))
  (let-match many (notail $ darts-c d ec nc fc ksc rc s0c lab lr st rf rp out rest) (ESome _ dr) ((ENone _) (ENone _)))
  (ESome _ (DKCons ec nc fc ksc rc s0c rest st x dx dr)))

(def-fns _ $ (many stix-c : (subterm many (List (KSt)) st) (many (Nat) k) -> (many (ErasedMaybe (StIx st k)) r))
  (let-match many st (Cons _ s rest) ((Nil _) (ESome _ (StxNil k))))
  (let-match many (notail $ stix-c rest k) (ESome _ sr) ((ENone _) (ENone _)))
  (let-match many s (StIn i j)
    ((StOut) (ESome _ (StxOut rest k sr))))
  (match many (lt-dec i k) _ ((Yes _ _ _ _ li) (ESome _ (StxIn rest i j k li sr))) (else (ENone _))))

(def-fns _ $ (many wpos-c : (many (List (KSt)) st) (subterm many (List (Nat)) s) (many (Nat) k) -> (many (ErasedMaybe (WPos st s k)) r))
  (let-match many s (Cons _ c rest) ((Nil _) (ESome _ (WPNil st k))))
  (let-match many (nth-q (KSt) st c) (NthY _ _ _ sc pc) ((NthN _ _ _) (ENone _)))
  (let-match many sc (StIn i j) (else (ENone _)))
  (let-match many (nat-eq i k) (Equal _ _ _) (else (ENone _)))
  (let-match many j (Zero) (else (ENone _)))
  (let-match many (notail $ wpos-c st rest (Succ k)) (ESome _ wr) ((ENone _) (ENone _)))
  (ESome _ (WPCons st rest c k pc wr)))

; The walk dart k, or its edge image when edge.
(def-adts $ (QCand : -> Type)
  enum
  (many MkQCand : (many (Nat) p k) (many (Bool) edge) -> (QCand)))

(def-fns _ $ (many dpath-c : (many (List (Nat)) ec s0c) (many (List (KSt)) st) (many (Nat) i j) (subterm many (List (QCand)) cs)
    -> (many (List (Nat)) p) (many (ErasedMaybe (DPath ec s0c st i p j)) r))
  (let-match many cs (Cons _ cd rest)
    ((Nil _) (match many (nat-eq i j) _ ((Equal _ _ _) (values (Nil _) (ESome _ (DPNil ec s0c st i)))) (else (values (Nil _) (ENone _))))))
  (let-match many cd (MkQCand p k edge))
  (let-match many (nth-q (KSt) st p) (NthY _ _ _ sp psp) ((NthN _ _ _) (values (Nil _) (ENone _))))
  (let-match many sp (StIn i1 jp) (else (values (Nil _) (ENone _))))
  (let-match many (nat-eq i1 i) (Equal _ _ _) (else (values (Nil _) (ENone _))))
  (let-match many (nth-q (Nat) ec p) (NthY _ _ _ q pq) ((NthN _ _ _) (values (Nil _) (ENone _))))
  (let-match many (nth-q (KSt) st q) (NthY _ _ _ sq psq) ((NthN _ _ _) (values (Nil _) (ENone _))))
  (let-match many sq (StIn i2 jq) (else (values (Nil _) (ENone _))))
  (let ((many (ErasedMaybe (CenOK ec s0c p)) coc))
    (match many edge _
      ((BFalse) (match many (nat-at s0c k p) _ ((ESome _ pk) (ESome _ (COWalk ec s0c k p pk))) ((ENone _) (ENone _))))
      ((BTrue)
        (let-match many (nth-q (Nat) s0c k) (NthY _ _ _ c pk)
          ((NthN _ _ _) (ENone _)))
        (match many (nat-at ec c p) _ ((ESome _ pe) (ESome _ (COEdge ec s0c k c p pk pe))) ((ENone _) (ENone _))))))
  (let-match many coc (ESome _ co) ((ENone _) (values (Nil _) (ENone _))))
  (let ((many ps) (many cr)) (notail $ dpath-c ec s0c st i2 j rest))
  (let-match many cr (ESome _ dp) ((ENone _) (values (Nil _) (ENone _))))
  (values (Cons _ p ps) (ESome _ (DPCons ec s0c ps st i p j jp q i2 jq psp pq psq co dp))))

(def-fns _ $ (many cands : (many (List (Nat)) ec) (subterm many (List (Nat)) s) (many (Nat) k) -> (many (List (QCand)) cs))
  (let-match many s (Cons _ c rest) ((Nil _) (Nil _)))
  (Cons _ (MkQCand c k (BFalse)) $ Cons _ (MkQCand (get-at _ ec c 0) k (BTrue)) $ notail $ cands ec rest (Succ k)))

(def-fns _ $ (many cand-face : (many (List (KSt)) st) (many (Nat) p) -> (many (Nat) i))
  (match many (get-at _ st p (StOut)) _ ((StIn i _) i) (else 1000000)))

(def-fns _ $ (many relax : (many (Bool) fwd) (many (List (Nat)) ec) (many (List (KSt)) st) (many (List (Maybe (List (QCand)))) ps) (subterm many (List (QCand)) cs)
    -> (many (List (Maybe (List (QCand)))) r))
  (let-match many cs (Cons _ cd rest) ((Nil _) ps))
  (let-match many cd (MkQCand p _ _))
  (let ((many a) (many b)) (values (cand-face st p) (cand-face st (get-at _ ec p 0))))
  (let ((many src) (many dst)) (match many fwd (((Nat) u) ((Nat) v)) ((BTrue) (values a b)) ((BFalse) (values b a))))
  (let ((many (List (Maybe (List (QCand)))) ps2))
    (match many (get-at _ ps src (None _)) _
      ((Some _ pa)
        (match many (get-at _ ps dst (None _)) _
          ((None _) (set-at _ ps dst (Some _ (bif _ fwd (cat _ pa (Cons _ cd (Nil _))) (Cons _ cd pa)))))
          (else ps)))
      (else ps)))
  (tail $ relax fwd ec st ps2 rest))

(def-fns _ $ (many relax-iter : (many (Bool) fwd) (many (List (Nat)) ec) (many (List (KSt)) st) (many (List (QCand)) cs) (many (List (Maybe (List (QCand)))) ps)
    (subterm many (Nat) n) -> (many (List (Maybe (List (QCand)))) r))
  (let-match many n (Succ n1) ((Zero) ps))
  (tail $ relax-iter fwd ec st cs (relax fwd ec st ps cs) n1))

(def-fns _ $ (many spokes-c : (many (List (Nat)) ec s0c) (many (List (KSt)) st) (many (List (Maybe (List (QCand)))) fw bw) (subterm many (List (Nat)) ixs)
    -> (many (ErasedMaybe (Spokes ec s0c st ixs)) r))
  (let-match many ixs (Cons _ i rest) ((Nil _) (ESome _ (SpkNil ec s0c st))))
  (let-match many (get-at _ bw i (None _)) (Some _ cb) (else (ENone _)))
  (let-match many (get-at _ fw i (None _)) (Some _ cf) (else (ENone _)))
  (let ((erased p) (many c1)) (dpath-c ec s0c st i (Zero) cb))
  (let-match many c1 (ESome _ d1) ((ENone _) (ENone _)))
  (let ((erased p2) (many c2)) (dpath-c ec s0c st (Zero) i cf))
  (let-match many c2 (ESome _ d2) ((ENone _) (ENone _)))
  (let-match many (notail $ spokes-c ec s0c st fw bw rest) (ESome _ sr) ((ENone _) (ENone _)))
  (ESome _ (SpkCons ec s0c rest p p2 st i d1 d2 sr)))

(def-fns _ $ (many qzcert-c : (many (Nat) dc) (many (List (Nat)) ec nc fc ksc rc ids) (erased (Hypermap dc ec nc fc) hc) (erased (OrderList dc fc ksc) olc)
    (erased (Iota dc ids) io) (many (Quiz) qz) (many (Nat) x0c) -> (many (ErasedMaybe (QzCert dc ec nc fc ksc rc qz x0c)) r))
  (let-match many qz (MkQuiz q0 q1))
  (let-match many q0 (QaskR a0 q01) (else (ENone _)))
  (let-match many q1 (QaskR a1 q10) (else (ENone _)))
  (let-match many (walkz-c ec nc ksc x0c qz) (WZYes _ _ _ _ _ s0c asc wz) ((WZNo _ _ _ _ _) (ENone _)))
  (let ((many st)) (mark-all fc ksc (nseq _ dc (StOut)) 0 s0c))
  (let ((many lab)) (kind-lab st))
  (let-match many (resp-to lab fc lab) (ESome _ rf) ((ENone _) (ENone _)))
  (let-match many (resp-q lab rc) (RsYes _ _ lr rp) ((RsNo _ _) (ENone _)))
  (let-match many (in-q (Succ (Zero)) lr) (IDOut _ _ out) ((IDIn _ _ _) (ENone _)))
  (let ((many dst) (erased lst)) (size-c _ st))
  (let-match many (nat-eq dst dc) (Equal _ _ _) (else (ENone _)))
  (let-match many (darts-c dc ec nc fc ksc rc s0c lab lr st rf rp out ids) (ESome _ dk) ((ENone _) (ENone _)))
  (let ((many k) (erased ls)) (size-c _ s0c))
  (let-match many (stix-c st k) (ESome _ sx) ((ENone _) (ENone _)))
  (let-match many (wpos-c st s0c (Zero)) (ESome _ wp) ((ENone _) (ENone _)))
  (let ((many ixs) (erased iok)) (iota-c k))
  (let ((many cs)) (cands ec s0c 0))
  (let ((many start)) (set-at _ (nseq _ k (None (List (QCand)))) 0 (Some _ (Nil _))))
  (let ((many fw) (many bw)) (values (relax-iter (BTrue) ec st cs start (Succ k)) (relax-iter (BFalse) ec st cs start (Succ k))))
  (let-match many (spokes-c ec s0c st fw bw ixs) (ESome _ ra) ((ENone _) (ENone _)))
  (ESome _ (MkQzCert dc k x0c a0 a1 ec nc fc ksc rc s0c asc ids ixs st q01 q10 hc olc io lst dk sx wz wp ls iok ra)))

; cf has a map and ring for which qz has a certificate at some dart.
(def-adts $ (CfQz : ((Config) cf) ((Quiz) qz) -> Type)
  enum
  (many MkCfQz : (erased (Bool) sym) (erased (List (Nat)) cci) (erased (List (Step)) cp) (erased (Nat) d x0c) (erased (List (Nat)) e n f r ks) (erased (Quiz) qz)
      (erased (Cpmap cp d e f r) c) (erased (PointedMap d e n f r) pm) (erased (QzCert d e n f ks r qz x0c) qc) -> (CfQz (MkConfig sym cci cp) qz)))

(def-fns _ $ (many find-x0 : (many (Nat) dc) (many (List (Nat)) ec nc fc ksc rc ids) (erased (Hypermap dc ec nc fc) hc) (erased (OrderList dc fc ksc) olc)
    (erased (Iota dc ids) io) (many (Quiz) qz) (many (Nat) x) (subterm many (Nat) left) -> (many (Nat) x0c) (many (ErasedMaybe (QzCert dc ec nc fc ksc rc qz x0c)) r))
  (let-match many left (Succ l1) ((Zero) (values 0 (ENone _))))
  (let-match many (qzcert-c dc ec nc fc ksc rc ids hc olc io qz x) (ESome _ qc)
    ((ENone _) (tail $ find-x0 dc ec nc fc ksc rc ids hc olc io qz (Succ x) l1)))
  (values x (ESome _ qc)))

(def-fns _ $ (many cfqz-c : (many (Config) cf) (many (Quiz) qz) -> (many (ErasedMaybe (CfQz cf qz)) r))
  (let-match many cf (MkConfig sym cci cp))
  (let-match many (noa-dec cp) (NoAYes _ na) ((NoANo _) (ENone _)))
  (let ((many d) (many e) (many f) (many r) (erased c)) (cpmap-c cp na))
  (let ((erased n0) (erased pm0)) (cpmap-map cp d e f r c))
  (let-match many (resp-q f e) (RsYes _ _ fe _) ((RsNo _ _) (ENone _)))
  (let ((many n)) (inv-from fe 0 d))
  (let ((many ids) (erased io)) (iota-c d))
  (let-match many (hyper-c d e n f ids io) (ESome _ hc) ((ENone _) (ENone _)))
  (let ((many ks) (many co)) (orders-c f ids d))
  (let-match many co (ESome _ os) ((ENone _) (ENone _)))
  (let ((erased olc)) (MkOrderList d f ids ks io os))
  (let ((erased x0c) (many cq)) (find-x0 d e n f ks r ids hc olc io qz 0 d))
  (let-match many cq (ESome _ qc) ((ENone _) (ENone _)))
  (let-match erased (hyper-node-unique d e n0 f n (pointed-hyper d e n0 f r pm0) hc) (Refl _ _))
  (ESome _ (MkCfQz sym cci cp d x0c e n f r ks qz c pm0 qc)))
