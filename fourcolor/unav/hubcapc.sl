(let-match erased (unary-1) (Refl _ _))
(let-match erased (unary-2-1) (Refl _ _))

(def-fns _ $ (erased add-rcomm : (erased (Nat) a b c x y) (erased (Add a b x) p) (erased (Add x c y) q)
    -> (erased (Nat) z) (erased (Add a c z) r) (erased (Add z b y) s))
  (let ((erased bc) (erased p1) (erased q1)) (plus-assoc a b c x y p q))
  (plus-assoc-r a c b bc y q1 (add-comm b c bc p1)))

(def-fns _ $ (erased mul-distr-r : (erased (Nat) w a b s x y z) (subterm erased (Mul w a x) p) (erased (Mul w b y) q) (erased (Add a b s) e)
    (erased (Mul w s z) r) -> (erased (Add x y z) o))
  (let-match erased p (MulSucc w1 _ x1 _ p1 pa)
    ((MulZero _) (let-match erased q (MulZero _)) (let-match erased r (MulZero _)) (AddZero (Zero))))
  (let-match erased q (MulSucc _ _ y1 _ q1 qa))
  (let-match erased r (MulSucc _ _ z1 _ r1 ra))
  (let ((erased o1)) (mul-distr-r w1 a b s x1 y1 z1 p1 q1 e r1))
  (let ((erased t) (erased pt)) (add x y))
  (let ((erased c1) (erased c2) (erased s1) (erased s2) (erased s3)) (add-mid x1 a y1 b x y t pa qa pt))
  (let-match erased (add-eq x1 y1 c1 z1 s1 o1) (Refl _ _))
  (let-match erased (add-eq a b c2 s s2 e) (Refl _ _))
  (let-match erased (add-eq z1 s t z s3 ra) (Refl _ _))
  pt)

(def-fns _ $ (erased mul-distr-l : (erased (Nat) a w a2 t m1 m m2) (subterm erased (Add a w a2) e) (erased (Mul a t m1) p) (erased (Mul w t m) q)
    (erased (Mul a2 t m2) r) -> (erased (Add m1 m m2) o))
  (let-match erased e (AddSucc a1 _ a3 e1)
    ((AddZero _) (let-match erased p (MulZero _)) (let-match erased (mul-fn w t m m2 q r) (Refl _ _)) (AddZero m)))
  (let-match erased p (MulSucc _ _ n1 _ p1 pa))
  (let-match erased r (MulSucc _ _ n2 _ r1 ra))
  (let ((erased o1)) (mul-distr-l a1 w a3 t n1 m n2 e1 p1 q r1))
  (let ((erased g) (erased pg)) (add m1 m))
  (let ((erased z) (erased s1) (erased s2)) (add-rcomm n1 t m m1 g pa pg))
  (let-match erased (add-eq n1 m z n2 s1 o1) (Refl _ _))
  (let-match erased (add-eq n2 t g m2 s2 ra) (Refl _ _))
  pg)

(def-fns _ $ (erased mul-mono : (erased (Nat) w a b x y) (subterm erased (Mul w a x) p) (erased (Mul w b y) q) (erased (Lt a (Succ b)) le)
    -> (erased (Lt x (Succ y)) r))
  (let-match erased p (MulSucc w1 _ x1 _ p1 pa) ((MulZero _) (let-match erased q (MulZero _)) (LtZ (Zero))))
  (let-match erased q (MulSucc _ _ y1 _ q1 qa))
  (le-sum x1 y1 a b x y (mul-mono w1 a b x1 y1 p1 q1 le) le pa qa))

(def-fns _ $ (erased add-le-cancel-l : (erased (Nat) l m ll r rr) (subterm erased (Add m l ll) p) (erased (Add m r rr) q) (erased (Lt ll (Succ rr)) le)
    -> (erased (Lt l (Succ r)) o))
  (let-match erased p (AddSucc m1 _ ll1 p1) ((AddZero _) (let-match erased q (AddZero _)) le))
  (let-match erased q (AddSucc _ _ rr1 q1))
  (add-le-cancel-l l m1 ll1 r rr1 p1 q1 (lt-pred ll1 (Succ rr1) le)))

(def-fns _ $ (erased finish : (erased (Nat) l mr l2 r ml r2) (erased (Add l mr l2) p) (erased (Add r ml r2) q) (erased (Lt l2 (Succ r2)) le)
    (erased (Lt ml (Succ mr)) lm) -> (erased (Lt l (Succ r)) o))
  (let ((erased r3) (erased q3)) (add r mr))
  (let ((erased le2)) (le-tr l2 r2 r3 le (add-le-r r ml r2 mr r3 q q3 lm)))
  (add-le-cancel-l l mr l2 r r3 (add-comm l mr l2 p) (add-comm r mr r3 q3) le2))

(def-fns _ $ (erased mix : (erased (Nat) d m d2 p x p2 s a l a2 l2 mm) (erased (Add d m d2) e1) (erased (Add p x p2) e2) (erased (Add m x mm) e3)
    (erased (Add d p a) pa) (erased (Add a s l) pl) (erased (Add d2 p2 a2) pa2) (erased (Add a2 s l2) pl2) -> (erased (Add l mm l2) o))
  (let ((erased ac) (erased bd) (erased q1) (erased q2) (erased q3)) (add-mid d m p x d2 p2 a2 e1 e2 pa2))
  (let-match erased (add-eq d p ac a q1 pa) (Refl _ _))
  (let-match erased (add-eq m x bd mm q2 e3) (Refl _ _))
  (let ((erased z) (erased q4) (erased q5)) (add-rcomm a mm s a2 l2 q3 pl2))
  (let-match erased (add-eq a s z l q4 pl) (Refl _ _))
  q5)

(def-adts $ (Sum : ((List (Nat)) xs) ((Nat) s) -> Type)
  enum
  (many SumNil : -> (Sum (Nil (Nat)) (Zero)))
  (many SumCons : (erased (Nat) x s1 s) (erased (List (Nat)) xs) (erased (Sum xs s1) p) (erased (Add x s1 s) a) -> (Sum (Cons (Nat) x xs) s)))

; d: the sum of the products of acc and ts, entry by entry.
(def-adts $ (Dot : ((List (Nat)) acc ts) ((Nat) d) -> Type)
  enum
  (many DotNil : -> (Dot (Nil (Nat)) (Nil (Nat)) (Zero)))
  (many DotCons : (erased (Nat) a t m d1 d) (erased (List (Nat)) acc ts) (erased (Mul a t m) pm) (erased (Dot acc ts d1) rest) (erased (Add m d1 d) pa)
      -> (Dot (Cons (Nat) a acc) (Cons (Nat) t ts) d)))

(def-adts $ (Incr : ((List (Nat)) acc) ((Nat) i w) ((List (Nat)) acc2) -> Type)
  enum
  (many IncHere : (erased (Nat) a w a2) (erased (List (Nat)) acc) (erased (Add a w a2) p) -> (Incr (Cons (Nat) a acc) (Zero) w (Cons (Nat) a2 acc)))
  (many IncThere : (erased (Nat) a i w) (erased (List (Nat)) acc acc2) (erased (Incr acc i w acc2) p)
      -> (Incr (Cons (Nat) a acc) (Succ i) w (Cons (Nat) a acc2))))

(def-adts $ (IsTwo : ((Nat) a) -> Type)
  enum
  (many MkIsTwo : -> (IsTwo 2)))

(def-fns _ $ (erased dot-incr : (erased (List (Nat)) acc acc2 ts) (erased (Nat) i w t m d) (subterm erased (Incr acc i w acc2) ic)
    (erased (Nth (Nat) ts i t) nt) (erased (Mul w t m) pm) (erased (Dot acc ts d) dt) -> (erased (Nat) d2) (erased (Dot acc2 ts d2) r) (erased (Add d m d2) e))
  (let-match erased dt (DotCons a t1 m1 d1 _ acc1 ts1 pm1 dt1 pa) (absurd (DotNil) ic))
  (match erased ic _
    ((IncHere _ _ a2 _ pw)
      (let-match erased nt (NthHere _ _ _))
      (let ((erased m2) (erased pm2)) (mul a2 t))
      (let ((erased e1)) (mul-distr-l a w a2 t m1 m m2 pw pm1 pm pm2))
      (let ((erased d2) (erased pd2)) (add m2 d1))
      (let ((erased z) (erased q1) (erased q2)) (add-rcomm m1 m d1 m2 d2 e1 pd2))
      (let-match erased (add-eq m1 d1 z d q1 pa) (Refl _ _))
      (values d2 (DotCons a2 t m2 d1 d2 acc1 ts1 pm2 dt1 pd2) q2))
    ((IncThere _ i1 _ _ acc3 ic1)
      (let-match erased nt (NthThere _ _ _ _ _ nt1))
      (let ((erased d3) (erased dt3) (erased e3)) (dot-incr acc1 acc3 ts1 i1 w t m d1 ic1 nt1 pm dt1))
      (let ((erased d2) (erased pd2)) (add m1 d3))
      (let ((erased ab) (erased q1) (erased q2)) (plus-assoc-r m1 d1 m d3 d2 pd2 e3))
      (let-match erased (add-eq m1 d1 ab d q1 pa) (Refl _ _))
      (values d2 (DotCons a t1 m1 d3 d2 acc3 ts1 pm1 dt3 pd2) q2))))

(def-fns _ $ (erased dot-zero : (erased (Nat) n) (erased (List (Nat)) acc ts) (subterm erased (Repeat (Nat) n (Zero) acc) rp)
    (erased (Length (Nat) ts n) l) -> (erased (Dot acc ts (Zero)) r))
  (let-match erased rp (RepeatCons _ n1 _ acc1 rp1) ((RepeatNil _ _) (let-match erased l (LengthNil _)) (DotNil)))
  (let-match erased l (LengthCons _ t ts1 _ l1))
  (DotCons (Zero) t (Zero) (Zero) (Zero) acc1 ts1 (MulZero t) (dot-zero n1 acc1 ts1 rp1 l1) (AddZero (Zero))))

(def-fns _ $ (erased dot-two : (erased (List (Nat)) acc ts) (erased (Nat) d s) (subterm erased (Dot acc ts d) dt) (erased (All (Nat) IsTwo acc) two)
    (erased (Sum ts s) ps) -> (erased (Add s s d) r))
  (let-match erased dt (DotCons _ t m d1 _ acc1 ts1 pm dt1 pa) ((DotNil) (let-match erased ps (SumNil)) (AddZero (Zero))))
  (let-match erased two (AllCons _ _ _ _ i2 two1))
  (let-match erased i2 (MkIsTwo))
  (let-match erased pm (MulSucc _ _ _ _ pm1 p1))
  (let-match erased pm1 (MulSucc _ _ _ _ pm0 p0))
  (let-match erased pm0 (MulZero _))
  (let-match erased p0 (AddZero _))
  (let-match erased ps (SumCons _ s1 _ _ ps1 as))
  (let ((erased ac) (erased bd) (erased q1) (erased q2) (erased q3)) (add-mid t t s1 s1 m d1 d p1 (dot-two acc1 ts1 d1 s1 dt1 two1 ps1) pa))
  (let-match erased (add-eq t s1 ac s q1 as) (Refl _ _))
  (let-match erased (add-eq t s1 bd s q2 as) (Refl _ _))
  q3)

; ct, cs: the counts of target and source rules at each sector.
(def-adts $ (Sat : ((List (Hc)) hc) ((List (Nat)) ct cs) -> Type)
  enum
  (many SatNil : (erased (List (Nat)) ct cs) -> (Sat (Nil (Hc)) ct cs))
  (many SatOne : (erased (Nat) i t s bp bn l r) (erased (List (Hc)) hc) (erased (List (Nat)) ct cs) (erased (Nth (Nat) ct i t) nt)
      (erased (Nth (Nat) cs i s) ns) (erased (Add t bn l) al) (erased (Add s bp r) ar) (erased (Lt l (Succ r)) le) (erased (Sat hc ct cs) rest)
      -> (Sat (Cons (Hc) (HC1 i (MkZ bp bn)) hc) ct cs))
  (many SatTwo : (erased (Nat) i j t1 t2 t s1 s2 s bp bn l r) (erased (List (Hc)) hc) (erased (List (Nat)) ct cs)
      (erased (Nth (Nat) ct i t1) nt1) (erased (Nth (Nat) ct j t2) nt2) (erased (Add t1 t2 t) atw) (erased (Nth (Nat) cs i s1) ns1)
      (erased (Nth (Nat) cs j s2) ns2) (erased (Add s1 s2 s) as) (erased (Add t bn l) al) (erased (Add s bp r) ar) (erased (Lt l (Succ r)) le)
      (erased (Sat hc ct cs) rest) -> (Sat (Cons (Hc) (HC2 i j (MkZ bp bn)) hc) ct cs)))

; acc: the weights on the sectors; bp - bn: the running bound.
(def-adts $ (Cov : ((List (Nat)) acc) ((Nat) bp bn) ((List (Hc)) hc) -> Type)
  enum
  (many CvNil : (erased (List (Nat)) acc) (erased (Nat) bp bn) (erased (All (Nat) IsTwo acc) two) (erased (Lt bp (Succ bn)) le)
      -> (Cov acc bp bn (Nil (Hc))))
  (many CvOne : (erased (List (Nat)) acc acc2) (erased (Nat) bp bn i w hp hn x y bp2 bn2) (erased (List (Hc)) hc) (erased (Incr acc i w acc2) ic)
      (erased (Mul w hp x) mx) (erased (Mul w hn y) my) (erased (Add x bp bp2) ax) (erased (Add y bn bn2) ay) (erased (Cov acc2 bp2 bn2 hc) rest)
      -> (Cov acc bp bn (Cons (Hc) (HC1 i (MkZ hp hn)) hc)))
  (many CvTwo : (erased (List (Nat)) acc acc1 acc2) (erased (Nat) bp bn i j w hp hn x y bp2 bn2) (erased (List (Hc)) hc)
      (erased (Incr acc i w acc1) ic) (erased (Incr acc1 j w acc2) jc) (erased (Mul w hp x) mx) (erased (Mul w hn y) my)
      (erased (Add x bp bp2) ax) (erased (Add y bn bn2) ay) (erased (Cov acc2 bp2 bn2 hc) rest)
      -> (Cov acc bp bn (Cons (Hc) (HC2 i j (MkZ hp hn)) hc))))

(def-adts $ (DbK : ((Nat) n kp kn) -> Type)
  enum
  (many DbKLo : (erased (Nat) n) (erased (Monus n 5 (Zero)) mo) -> (DbK n 10 (Zero)))
  (many DbKHi : (erased (Nat) n k m) (erased (Monus n 5 (Succ k)) mo) (erased (Mul k 10 m) pm) -> (DbK n (Zero) m)))

(def-adts $ (CoverOk : ((Nat) nhub) ((List (Hc)) hc) -> Type)
  enum
  (many MkCoverOk : (erased (Nat) nhub) (erased (List (Hc)) hc) (erased (Nat) kp kn) (erased (List (Nat)) acc0) (erased (Nat) bp0 bn1)
      (erased (DbK nhub kp kn) dk) (erased (Repeat (Nat) nhub (Zero) acc0) rp) (erased (Add kp kp bp0) a1) (erased (Add kn kn bn1) a2)
      (erased (Cov acc0 bp0 (Succ bn1) hc) cv) -> (CoverOk nhub hc)))

(def-fns _ $ (many incr-c : (subterm many (Nat) i) (many (Nat) w) (many (List (Nat)) acc)
    -> (many (Bool) ok) (many (List (Nat)) acc2) (erased (IfT ok (Incr acc i w acc2)) p))
  (let-match many acc (Cons _ a rest) ((Nil _) (values (BFalse) acc (IfF _))))
  (let-match many i (Succ i1)
    ((Zero) (let ((many a2) (erased pa)) (add a w)) (values (BTrue) (Cons _ a2 rest) (IfY _ (IncHere a w a2 rest pa)))))
  (let ((many ok) (many r2) (erased p)) (notail $ incr-c i1 w rest))
  (values ok (Cons _ a r2) (match erased p _ ((IfY _ q) (IfY _ (IncThere a i1 w rest r2 q))) ((IfF _) (IfF _)))))

(def-fns _ $ (many all-two-c : (subterm many (List (Nat)) acc) -> (many (Bool) ok) (erased (IfT ok (All (Nat) IsTwo acc)) p))
  (let-match many acc (Cons _ a rest) ((Nil _) (values (BTrue) (IfY _ (AllNil _ IsTwo)))))
  (let-match many a (Succ a1) ((Zero) (values (BFalse) (IfF _))))
  (let-match many a1 (Succ a2) ((Zero) (values (BFalse) (IfF _))))
  (let-match many a2 (Zero) ((Succ _) (values (BFalse) (IfF _))))
  (let ((many ok) (erased p)) (tail $ all-two-c rest))
  (values ok (match erased p _ ((IfY _ q) (IfY _ (AllCons _ IsTwo a rest (MkIsTwo) q))) ((IfF _) (IfF _)))))

(def-fns _ $ (many cover-rec-c : (many (List (Nat)) v acc) (many (Nat) bp bn) (subterm many (List (Hc)) hc)
    -> (many (Bool) ok) (erased (IfT ok (Cov acc bp bn hc)) w))
  (let-match many hc (Cons _ h rest)
    ((Nil _)
      (let-match many (le-dec bp bn) (LeY _ _ le) ((LeN _ _ _) (values (BFalse) (IfF _))))
      (let ((many ok) (erased p)) (all-two-c acc))
      (values ok (match erased p _ ((IfY _ q) (IfY _ (CvNil acc bp bn q le))) ((IfF _) (IfF _))))))
  (match many h _
    ((HC1 i b1)
      (let-match many (nat-eqb (nth-nat i v) 1) (BTrue) ((BFalse) (values (BFalse) (IfF _))))
      (let-match many b1 (MkZ hp hn))
      (let ((many x) (erased mx)) (mul 2 hp))
      (let ((many y) (erased my)) (mul 2 hn))
      (let ((many bp2) (erased ax)) (add x bp))
      (let ((many bn2) (erased ay)) (add y bn))
      (let ((many ok1) (many acc2) (erased pi)) (incr-c i 2 acc))
      (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) (IfF _))))
      (let-match erased pi (IfY _ ic))
      (let ((many ok) (erased p)) (tail $ cover-rec-c v acc2 bp2 bn2 rest))
      (values ok (match erased p _ ((IfY _ q) (IfY _ (CvOne acc acc2 bp bn i 2 hp hn x y bp2 bn2 rest ic mx my ax ay q))) ((IfF _) (IfF _)))))
    ((HC2 i j b1)
      (let ((many ni)) (nth-nat i v))
      (let-match many (and (nat-eqb ni (nth-nat j v)) (leb ni 2)) (BTrue) ((BFalse) (values (BFalse) (IfF _))))
      (let ((many w)) (bif _ (nat-eqb ni 1) 2 1))
      (let-match many b1 (MkZ hp hn))
      (let ((many x) (erased mx)) (mul w hp))
      (let ((many y) (erased my)) (mul w hn))
      (let ((many bp2) (erased ax)) (add x bp))
      (let ((many bn2) (erased ay)) (add y bn))
      (let ((many ok1) (many acc1) (erased pi)) (incr-c i w acc))
      (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) (IfF _))))
      (let-match erased pi (IfY _ ic))
      (let ((many ok2) (many acc2) (erased pj)) (incr-c j w acc1))
      (let-match many ok2 (BTrue) ((BFalse) (values (BFalse) (IfF _))))
      (let-match erased pj (IfY _ jc))
      (let ((many ok) (erased p)) (tail $ cover-rec-c v acc2 bp2 bn2 rest))
      (values ok (match erased p _
        ((IfY _ q) (IfY _ (CvTwo acc acc1 acc2 bp bn i j w hp hn x y bp2 bn2 rest ic jc mx my ax ay q)))
        ((IfF _) (IfF _)))))))

(def-fns _ $ (many dboundk-c : (many (Nat) n) -> (many (Nat) kp kn) (erased (DbK n kp kn) w))
  (let ((many k) (erased mo)) (monus-c n 5))
  (let-match many k (Succ k1) ((Zero) (values 10 (Zero) (DbKLo n mo))))
  (let ((many m) (erased pm)) (mul k1 10))
  (values (Zero) m (DbKHi n k1 m mo pm)))

(def-fns _ $ (many hubcap-cover-c : (many (Nat) nhub) (many (List (Hc)) hc) -> (many (Bool) ok) (erased (IfT ok (CoverOk nhub hc)) w))
  (let ((many v)) (tally hc))
  (let-match many (and (nat-eqb (size _ v) nhub) (negb (mem-nat 0 v))) (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let ((many kp) (many kn) (erased dk)) (dboundk-c nhub))
  (let ((many acc0) (erased rp)) (nseq-c _ nhub (Zero)))
  (let ((many bp0) (erased a1)) (add kp kp))
  (let ((many bn1) (erased a2)) (add kn kn))
  (let ((many ok) (erased w)) (cover-rec-c v acc0 bp0 (Succ bn1) hc))
  (values ok (match erased w _ ((IfY _ cv) (IfY _ (MkCoverOk nhub hc kp kn acc0 bp0 bn1 dk rp a1 a2 cv))) ((IfF _) (IfF _)))))

(def-fns _ $ (erased cover-step : (erased (Nat) w t s hp hn l1 r1 m1 m2 x y dt dt2 ds ds2 bp bn bp2 bn2 st2 ss2 a l b r a2 l2 b2 r2)
    (erased (Add t hn l1) al) (erased (Add s hp r1) ar) (erased (Lt l1 (Succ r1)) le) (erased (Mul w t m1) pm1) (erased (Mul w s m2) pm2)
    (erased (Mul w hp x) mx) (erased (Mul w hn y) my) (erased (Add dt m1 dt2) edt) (erased (Add ds m2 ds2) eds)
    (erased (Add x bp bp2) ax) (erased (Add y bn bn2) ay) (erased (Add ds bp a) pa) (erased (Add a st2 l) pl) (erased (Add dt bn b) pb)
    (erased (Add b ss2 r) pr) (erased (Add ds2 bp2 a2) pa2) (erased (Add a2 st2 l2) pl2) (erased (Add dt2 bn2 b2) pb2) (erased (Add b2 ss2 r2) pr2)
    (erased (Lt l2 (Succ r2)) ih) -> (erased (Lt l (Succ r)) o))
  (let ((erased ml) (erased pml)) (mul w l1))
  (let ((erased mr) (erased pmr)) (mul w r1))
  (let ((erased e3)) (mul-distr-r w t hn l1 m1 y ml pm1 my al pml))
  (let ((erased e4)) (mul-distr-r w s hp r1 m2 x mr pm2 mx ar pmr))
  (let ((erased fl)) (mix ds m2 ds2 bp x bp2 st2 a l a2 l2 mr eds (add-comm x bp bp2 ax) e4 pa pl pa2 pl2))
  (let ((erased fr)) (mix dt m1 dt2 bn y bn2 ss2 b r b2 r2 ml edt (add-comm y bn bn2 ay) e3 pb pr pb2 pr2))
  (finish l mr l2 r ml r2 fl fr ih (mul-mono w l1 r1 ml mr pml pmr le)))

(def-fns _ $ (erased cover-ind : (erased (List (Nat)) acc ct cs) (erased (Nat) bp bn dt ds st ss st2 ss2 a l b r) (erased (List (Hc)) hc)
    (subterm erased (Cov acc bp bn hc) cv) (erased (Sat hc ct cs) sat) (erased (Dot acc ct dt) pdt) (erased (Dot acc cs ds) pds)
    (erased (Sum ct st) pst) (erased (Sum cs ss) pss) (erased (Add st st st2) e1) (erased (Add ss ss ss2) e2)
    (erased (Add ds bp a) pa) (erased (Add a st2 l) pl) (erased (Add dt bn b) pb) (erased (Add b ss2 r) pr) -> (erased (Lt l (Succ r)) o))
  (match erased cv _
    ((CvNil _ _ _ two le)
      (let-match erased (add-eq st st dt st2 (dot-two acc ct dt st pdt two pst) e1) (Refl _ _))
      (let-match erased (add-eq ss ss ds ss2 (dot-two acc cs ds ss pds two pss) e2) (Refl _ _))
      (let ((erased z1) (erased q1) (erased q2)) (add-rcomm ds bp dt a l pa pl))
      (let ((erased z2) (erased q3) (erased q4)) (add-rcomm dt bn ds b r pb pr))
      (let-match erased (add-eq dt ds z2 z1 q3 (add-comm ds dt z1 q1)) (Refl _ _))
      (add-le-r z1 bp l bn r q2 q4 le))
    ((CvOne _ acc2 _ _ i w hp hn x y bp2 bn2 hc1 ic mx my ax ay cv1)
      (let-match erased sat (SatOne _ t s _ _ l1 r1 _ _ _ nt ns al ar le sat1))
      (let ((erased m1) (erased pm1)) (mul w t))
      (let ((erased m2) (erased pm2)) (mul w s))
      (let ((erased dt2) (erased pdt2) (erased edt)) (dot-incr acc acc2 ct i w t m1 dt ic nt pm1 pdt))
      (let ((erased ds2) (erased pds2) (erased eds)) (dot-incr acc acc2 cs i w s m2 ds ic ns pm2 pds))
      (let ((erased a2) (erased pa2)) (add ds2 bp2))
      (let ((erased l2) (erased pl2)) (add a2 st2))
      (let ((erased b2) (erased pb2)) (add dt2 bn2))
      (let ((erased r2) (erased pr2)) (add b2 ss2))
      (cover-step w t s hp hn l1 r1 m1 m2 x y dt dt2 ds ds2 bp bn bp2 bn2 st2 ss2 a l b r a2 l2 b2 r2 al ar le pm1 pm2 mx my edt eds ax ay
        pa pl pb pr pa2 pl2 pb2 pr2
        (cover-ind acc2 ct cs bp2 bn2 dt2 ds2 st ss st2 ss2 a2 l2 b2 r2 hc1 cv1 sat1 pdt2 pds2 pst pss e1 e2 pa2 pl2 pb2 pr2)))
    ((CvTwo _ acc1 acc2 _ _ i j w hp hn x y bp2 bn2 hc1 ic jc mx my ax ay cv1)
      (let-match erased sat (SatTwo _ _ t1 t2 t s1 s2 s _ _ l1 r1 _ _ _ nt1 nt2 atw ns1 ns2 as al ar le sat1))
      (let ((erased m1a) (erased pm1a)) (mul w t1))
      (let ((erased m1b) (erased pm1b)) (mul w t2))
      (let ((erased m2a) (erased pm2a)) (mul w s1))
      (let ((erased m2b) (erased pm2b)) (mul w s2))
      (let ((erased m1) (erased pm1)) (mul w t))
      (let ((erased m2) (erased pm2)) (mul w s))
      (let ((erased dt1) (erased pdt1) (erased edt1)) (dot-incr acc acc1 ct i w t1 m1a dt ic nt1 pm1a pdt))
      (let ((erased dt2) (erased pdt2) (erased edt2)) (dot-incr acc1 acc2 ct j w t2 m1b dt1 jc nt2 pm1b pdt1))
      (let ((erased ds1) (erased pds1) (erased eds1)) (dot-incr acc acc1 cs i w s1 m2a ds ic ns1 pm2a pds))
      (let ((erased ds2) (erased pds2) (erased eds2)) (dot-incr acc1 acc2 cs j w s2 m2b ds1 jc ns2 pm2b pds1))
      (let ((erased g1) (erased q1) (erased q2)) (plus-assoc dt m1a m1b dt1 dt2 edt1 edt2))
      (let-match erased (add-eq m1a m1b g1 m1 q1 (mul-distr-r w t1 t2 t m1a m1b m1 pm1a pm1b atw pm1)) (Refl _ _))
      (let ((erased g2) (erased q3) (erased q4)) (plus-assoc ds m2a m2b ds1 ds2 eds1 eds2))
      (let-match erased (add-eq m2a m2b g2 m2 q3 (mul-distr-r w s1 s2 s m2a m2b m2 pm2a pm2b as pm2)) (Refl _ _))
      (let ((erased a2) (erased pa2)) (add ds2 bp2))
      (let ((erased l2) (erased pl2)) (add a2 st2))
      (let ((erased b2) (erased pb2)) (add dt2 bn2))
      (let ((erased r2) (erased pr2)) (add b2 ss2))
      (cover-step w t s hp hn l1 r1 m1 m2 x y dt dt2 ds ds2 bp bn bp2 bn2 st2 ss2 a l b r a2 l2 b2 r2 al ar le pm1 pm2 mx my q2 q4 ax ay
        pa pl pb pr pa2 pl2 pb2 pr2
        (cover-ind acc2 ct cs bp2 bn2 dt2 ds2 st ss st2 ss2 a2 l2 b2 r2 hc1 cv1 sat1 pdt2 pds2 pst pss e1 e2 pa2 pl2 pb2 pr2)))))

(def-fns _ $ (erased half-le : (erased (Nat) l r ll rr) (erased (Add l l ll) p) (erased (Add r r rr) q) (erased (Lt ll (Succ (Succ rr))) le)
    -> (erased (Lt l (Succ r)) o))
  (match erased (le-dec l r) _
    ((LeY _ _ k) k)
    (absurd (LeN _ _ k)
      (lt-le-absurd ll (Succ (Succ rr)) le
        (le-sum (Succ r) l (Succ r) l (Succ (Succ rr)) ll (LtS r l k) (LtS r l k) (AddSucc r (Succ r) (Succ rr) (add-succ-right r r rr q)) p)))))

(def-fns _ $ (erased cover-sound : (erased (Nat) nhub st ss) (erased (List (Hc)) hc) (erased (List (Nat)) ct cs) (erased (CoverOk nhub hc) ok)
    (erased (Sat hc ct cs) sat) (erased (Length (Nat) ct nhub) lct) (erased (Length (Nat) cs nhub) lcs) (erased (Sum ct st) pst) (erased (Sum cs ss) pss)
    -> (erased (Nat) kp kn l r) (erased (DbK nhub kp kn) dk) (erased (Add kp st l) al) (erased (Add kn ss r) ar) (erased (Lt l (Succ r)) le))
  (let-match erased ok (MkCoverOk _ _ kp kn acc0 bp0 bn1 dk rp a1 a2 cv))
  (let ((erased st2) (erased e1)) (add st st))
  (let ((erased ss2) (erased e2)) (add ss ss))
  (let ((erased l2) (erased pl)) (add bp0 st2))
  (let ((erased r2) (erased pr)) (add (Succ bn1) ss2))
  (let ((erased le2)) (cover-ind acc0 ct cs bp0 (Succ bn1) (Zero) (Zero) st ss st2 ss2 bp0 l2 (Succ bn1) r2 hc cv sat
    (dot-zero nhub acc0 ct rp lct) (dot-zero nhub acc0 cs rp lcs) pst pss e1 e2 (AddZero bp0) pl (AddZero (Succ bn1)) pr))
  (let ((erased l) (erased al)) (add kp st))
  (let ((erased r) (erased ar)) (add kn ss))
  (let ((erased c1) (erased c2) (erased q1) (erased q2) (erased q3)) (add-mid kp kp st st bp0 st2 l2 a1 e1 pl))
  (let-match erased (add-eq kp st c1 l q1 al) (Refl _ _))
  (let-match erased (add-eq kp st c2 l q2 al) (Refl _ _))
  (let-match erased pr (AddSucc _ _ r3 pr1))
  (let ((erased c3) (erased c4) (erased q4) (erased q5) (erased q6)) (add-mid kn kn ss ss bn1 ss2 r3 a2 e2 pr1))
  (let-match erased (add-eq kn ss c3 r q4 ar) (Refl _ _))
  (let-match erased (add-eq kn ss c4 r q5 ar) (Refl _ _))
  (values kp kn l r dk al ar (half-le l r l2 r3 q3 q6 le2)))

; k: the rotation hubcap_rot uses at constraint index j.
(def-adts $ (Shift : ((Nat) nhub j k) -> Type)
  enum
  (many ShLo : (erased (Nat) nhub j k) (erased (Lt 1 j) l) (erased (Monus j 2 k) mo) -> (Shift nhub j k))
  (many ShHi : (erased (Nat) nhub j t k) (erased (Lt j 2) l) (erased (Add nhub j t) a) (erased (Monus t 2 k) mo) -> (Shift nhub j k)))

(def-adts $ (HubSubn : ((Nat) nhub i j k) -> Type)
  enum
  (many HSLe : (erased (Nat) nhub i j k) (erased (Lt j (Succ i)) l) (erased (Monus i j k) mo) -> (HubSubn nhub i j k))
  (many HSGt : (erased (Nat) nhub i j t k) (erased (Lt i j) l) (erased (Add i nhub t) a) (erased (Monus t j k) mo) -> (HubSubn nhub i j k)))

(def-fns _ $ (many shift-c : (many (Nat) nhub j) -> (many (Nat) k) (erased (Shift nhub j k) w))
  (match many (nat-cmp 1 j) _
    ((CLt _ _ _ _ l) (let ((many k) (erased mo)) (monus-c j 2)) (values k (ShLo nhub j k l mo)))
    ((CEq _ _ _) (let ((many t) (erased a)) (add nhub j)) (let ((many k) (erased mo)) (monus-c t 2)) (values k (ShHi nhub j t k (lt-succ 1) a mo)))
    ((CGt _ _ _ _ l)
      (let ((many t) (erased a)) (add nhub j))
      (let ((many k) (erased mo)) (monus-c t 2))
      (values k (ShHi nhub j t k (lt-weaken j 1 l) a mo)))))

(def-fns _ $ (many hub-subn-c : (many (Nat) nhub i j) -> (many (Nat) k) (erased (HubSubn nhub i j k) w))
  (match many (le-dec j i) _
    ((LeY _ _ l) (let ((many k) (erased mo)) (monus-c i j)) (values k (HSLe nhub i j k l mo)))
    ((LeN _ _ l) (let ((many t) (erased a)) (add i nhub)) (let ((many k) (erased mo)) (monus-c t j)) (values k (HSGt nhub i j t k l a mo)))))

; acc to out: the obligations of the checks on p, per constraint of hc.
(def-adts $ (HFit : ((Nat) nhub) ((List (Sub)) p) ((List (List (Sub))) rt rs) ((List (Hc)) hc) ((List (List (Sub))) acc out) -> Type)
  enum
  (many HFNil : (erased (Nat) nhub) (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs acc) -> (HFit nhub p rt rs (Nil (Hc)) acc acc))
  (many HFOne : (erased (Nat) nhub j k) (erased (Z) b) (erased (List (Sub)) p pj) (erased (List (List (Sub))) rt rs acc acc1 out) (erased (List (Hc)) hc)
      (erased (Shift nhub j k) sh) (erased (Rot (Sub) k p pj) ro) (erased (Db2Top pj rt rs b acc acc1) d) (erased (HFit nhub p rt rs hc acc1 out) rest)
      -> (HFit nhub p rt rs (Cons (Hc) (HC1 j b) hc) acc out))
  (many HFTwo : (erased (Nat) nhub j1 j2 k i) (erased (Z) b) (erased (List (Sub)) p pj) (erased (List (List (Sub))) rt rs acc acc1 out)
      (erased (List (Hc)) hc) (erased (Shift nhub j1 k) sh) (erased (Rot (Sub) k p pj) ro) (erased (HubSubn nhub j2 j1 i) hs)
      (erased (E2Top nhub pj rt rs i b acc acc1) d) (erased (HFit nhub p rt rs hc acc1 out) rest) -> (HFit nhub p rt rs (Cons (Hc) (HC2 j1 j2 b) hc) acc out)))

(def-fns _ $ (many hubcap-fit-c : (many (Nat) nhub) (many (List (Sub)) p) (many (List (List (Sub))) rt rs) (subterm many (List (Hc)) hc)
    (many (List (List (Sub))) acc) -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (HFit nhub p rt rs hc acc out)) w))
  (let-match many hc (Cons _ h rest) ((Nil _) (values (BTrue) acc (IfY _ (HFNil nhub p rt rs acc)))))
  (match many h _
    ((HC1 j b)
      (let ((many k) (erased sh)) (shift-c nhub j))
      (let ((many pj) (erased ro)) (rot-c _ k p))
      (let ((many ok1) (many acc1) (erased w1)) (check-dbound2-c pj rt rs b acc))
      (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc1 (IfF _))))
      (let-match erased w1 (IfY _ d))
      (let ((many ok) (many out) (erased w)) (tail $ hubcap-fit-c nhub p rt rs rest acc1))
      (values ok out (match erased w _ ((IfY _ q) (IfY _ (HFOne nhub j k b p pj rt rs acc acc1 out rest sh ro d q))) ((IfF _) (IfF _)))))
    ((HC2 j1 j2 b)
      (let ((many k) (erased sh)) (shift-c nhub j1))
      (let ((many pj) (erased ro)) (rot-c _ k p))
      (let ((many i) (erased hs)) (hub-subn-c nhub j2 j1))
      (let ((many ok1) (many acc1) (erased w1)) (check-2dbound2-c nhub pj rt rs i b acc))
      (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc1 (IfF _))))
      (let-match erased w1 (IfY _ d))
      (let ((many ok) (many out) (erased w)) (tail $ hubcap-fit-c nhub p rt rs rest acc1))
      (values ok out (match erased w _
        ((IfY _ q) (IfY _ (HFTwo nhub j1 j2 k i b p pj rt rs acc acc1 out rest sh ro hs d q)))
        ((IfF _) (IfF _)))))))

(def-fns _ $ (erased monus-fn : (erased (Nat) a b r1 r2) (erased (Monus a b r1) p) (erased (Monus a b r2) q) -> (erased (Eq (Nat) r1 r2) e))
  (match erased p _
    ((MoAdd _ _ _ pa)
      (match erased q _
        ((MoAdd _ _ _ qa) (add-inj b r1 a r2 pa qa))
        (absurd (MoNeg _ _ l) (lt-le-absurd a b l (add-le-left b r1 a pa)))))
    ((MoNeg _ _ l)
      (match erased q _
        (absurd (MoAdd _ _ _ qa) (lt-le-absurd a b l (add-le-left b r2 a qa)))
        ((MoNeg _ _ _) (Refl _ (Zero)))))))

(def-fns _ $ (erased shift-fn : (erased (Nat) nhub j k1 k2) (erased (Shift nhub j k1) p) (erased (Shift nhub j k2) q) -> (erased (Eq (Nat) k1 k2) e))
  (match erased p _
    ((ShLo _ _ _ l mo)
      (let-match erased q (ShLo _ _ _ _ mo2) (absurd (ShHi _ _ _ _ l2 _ _) (lt-le-absurd 1 j l l2)))
      (monus-fn j 2 k1 k2 mo mo2))
    ((ShHi _ _ t _ l a mo)
      (let-match erased q (ShHi _ _ t2 _ _ a2 mo2) (absurd (ShLo _ _ _ l2 _) (lt-le-absurd 1 j l2 l)))
      (let-match erased (add-eq nhub j t t2 a a2) (Refl _ _))
      (monus-fn t 2 k1 k2 mo mo2))))

(def-fns _ $ (erased hubsubn-fn : (erased (Nat) nhub i j k1 k2) (erased (HubSubn nhub i j k1) p) (erased (HubSubn nhub i j k2) q) -> (erased (Eq (Nat) k1 k2) e))
  (match erased p _
    ((HSLe _ _ _ _ l mo)
      (let-match erased q (HSLe _ _ _ _ _ mo2) (absurd (HSGt _ _ _ _ _ l2 _ _) (lt-le-absurd i j l2 l)))
      (monus-fn i j k1 k2 mo mo2))
    ((HSGt _ _ _ t _ l a mo)
      (let-match erased q (HSGt _ _ _ t2 _ _ a2 mo2) (absurd (HSLe _ _ _ _ l2 _) (lt-le-absurd i j l l2)))
      (let-match erased (add-eq i nhub t t2 a a2) (Refl _ _))
      (monus-fn t j k1 k2 mo mo2))))

; oss: per constraint, the rotation of os it fits at, and for a pair the two rotations between its sector lists.
(def-adts $ (Fam : ((List (Sec)) os) ((Nat) nhub) ((List (List (Sec))) oss) ((List (Hc)) hc) -> Type)
  enum
  (many FamNil : (erased (List (Sec)) os) (erased (Nat) nhub) (erased (List (List (Sec))) oss) -> (Fam os nhub oss (Nil (Hc))))
  (many FamOne : (erased (List (Sec)) os oj) (erased (Nat) nhub j k) (erased (Z) b) (erased (List (List (Sec))) oss) (erased (List (Hc)) hc)
      (erased (Shift nhub j k) sh) (erased (Rot (Sec) k os oj) ro) (erased (Nth (List (Sec)) oss j oj) no) (erased (Fam os nhub oss hc) rest)
      -> (Fam os nhub oss (Cons (Hc) (HC1 j b) hc)))
  (many FamTwo : (erased (List (Sec)) os o1 o2) (erased (Nat) nhub j1 j2 k i i2) (erased (Z) b) (erased (List (List (Sec))) oss) (erased (List (Hc)) hc)
      (erased (Shift nhub j1 k) sh) (erased (Rot (Sec) k os o1) ro) (erased (Nth (List (Sec)) oss j1 o1) n1) (erased (Nth (List (Sec)) oss j2 o2) n2)
      (erased (HubSubn nhub j2 j1 i) hs) (erased (Rot (Sec) i o1 o2) r12) (erased (Rot (Sec) i2 o2 o1) r21) (erased (Add i i2 nhub) ai)
      (erased (Fam os nhub oss hc) rest) -> (Fam os nhub oss (Cons (Hc) (HC2 j1 j2 b) hc))))

(def-adts $ (Counts : ((List (List (Sec))) oss) ((List (List (Sub))) rt rs) ((List (Nat)) ct cs) -> Type)
  enum
  (many CsNil : (erased (List (List (Sub))) rt rs) -> (Counts (Nil (List (Sec))) rt rs (Nil (Nat)) (Nil (Nat))))
  (many CsCons : (erased (List (Sec)) o) (erased (List (List (Sec))) oss) (erased (List (List (Sub))) rt rs) (erased (Nat) t s) (erased (List (Nat)) ct cs)
      (erased (Count o rt t) kt) (erased (Count o rs s) ks) (erased (Counts oss rt rs ct cs) rest)
      -> (Counts (Cons (List (Sec)) o oss) rt rs (Cons (Nat) t ct) (Cons (Nat) s cs))))

(def-adts $ (HitSome : ((List (List (Sec))) oss) ((List (List (Sub))) obl) -> Type)
  enum
  (many HSHere : (erased (List (Sec)) o) (erased (List (List (Sec))) oss) (erased (List (List (Sub))) obl) (erased (Hit o obl) h)
      -> (HitSome (Cons (List (Sec)) o oss) obl))
  (many HSThere : (erased (List (Sec)) o) (erased (List (List (Sec))) oss) (erased (List (List (Sub))) obl) (erased (HitSome oss obl) h)
      -> (HitSome (Cons (List (Sec)) o oss) obl)))

(def-fns _ $ (erased counts-nth : (erased (List (List (Sec))) oss) (erased (List (List (Sub))) rt rs) (erased (List (Nat)) ct cs) (erased (Nat) j)
    (erased (List (Sec)) o) (subterm erased (Counts oss rt rs ct cs) k) (erased (Nth (List (Sec)) oss j o) no)
    -> (erased (Nat) t s) (erased (Nth (Nat) ct j t) nt) (erased (Nth (Nat) cs j s) ns) (erased (Count o rt t) kt) (erased (Count o rs s) ks))
  (let-match erased k (CsCons _ oss1 _ _ t1 s1 ct1 cs1 kt1 ks1 k1) (absurd (CsNil _ _) no))
  (let-match erased no (NthThere _ _ _ j1 _ no1) ((NthHere _ _ _) (values t1 s1 (NthHere _ t1 ct1) (NthHere _ s1 cs1) kt1 ks1)))
  (let ((erased t) (erased s) (erased nt) (erased ns) (erased kt) (erased ks)) (counts-nth oss1 rt rs ct1 cs1 j1 o k1 no1))
  (values t s (NthThere _ t1 ct1 j1 t nt) (NthThere _ s1 cs1 j1 s ns) kt ks))

(def-fns _ $ (erased hit-some-nth : (erased (List (List (Sec))) oss) (erased (List (List (Sub))) obl) (erased (Nat) j) (erased (List (Sec)) o)
    (subterm erased (Nth (List (Sec)) oss j o) no) (erased (Hit o obl) h) -> (erased (HitSome oss obl) r))
  (match erased no _
    ((NthHere _ _ oss1) (HSHere o oss1 obl h))
    ((NthThere _ o1 oss1 j1 _ no1) (HSThere o1 oss1 obl (hit-some-nth oss1 obl j1 o no1 h)))))

(def-fns _ $ (erased hit-some-ext : (erased (List (List (Sec))) oss) (erased (List (List (Sub))) acc out) (subterm erased (HitSome oss acc) h)
    (erased (Ext acc out) e) -> (erased (HitSome oss out) r))
  (match erased h _
    ((HSHere o oss1 _ h1) (HSHere o oss1 out (hit-ext o acc out h1 e)))
    ((HSThere o oss1 _ h1) (HSThere o oss1 out (hit-some-ext oss1 acc out h1 e)))))

(def-fns _ $ (erased hfit-ext : (erased (Nat) nhub) (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs acc out) (erased (List (Hc)) hc)
    (subterm erased (HFit nhub p rt rs hc acc out) w) -> (erased (Ext acc out) e))
  (match erased w _
    ((HFNil _ _ _ _ _) (ExtRefl acc))
    ((HFOne _ _ _ _ _ pj _ _ _ acc1 _ hc1 _ _ d w1)
      (let-match erased d (MkDb2Top _ _ _ rt1 rs1 _ _ _ _ _ _ _ _ nt _ _ _ _ _ d1))
      (ext-trans acc acc1 out (db2-ext pj rt1 rs1 (Nil _) nt acc acc1 d1) (hfit-ext nhub p rt rs acc1 out hc1 w1)))
    ((HFTwo _ _ _ _ i _ _ pj _ _ _ acc1 _ hc1 _ _ _ d w1)
      (let-match erased d (MkE2Top _ _ _ _ _ _ _ _ _ _ _ _ nt _ p2 _ _ rt1 rs1 rt2 rs2 _ _ _ _ _ _ _ _ _ _ _ _ d1))
      (ext-trans acc acc1 out (e2-ext nhub i nt pj p2 rt1 rs1 (Nil _) rt2 rs2 (Nil _) acc acc1 d1) (hfit-ext nhub p rt rs acc1 out hc1 w1)))))

(def-fns _ $ (erased hfit-sound : (erased (Nat) nhub) (erased (List (Sec)) os) (erased (List (Sub)) p) (erased (List (List (Sub))) rt rs acc out)
    (erased (List (Hc)) hc) (erased (List (List (Sec))) oss) (erased (List (Nat)) ct cs) (erased (Exact os p) x)
    (subterm erased (HFit nhub p rt rs hc acc out) w) (erased (Fam os nhub oss hc) fam) (erased (Counts oss rt rs ct cs) cnt)
    -> (erased (Or (Sat hc ct cs) (HitSome oss out)) r))
  (match erased w _
    ((HFNil _ _ _ _ _) (OrL _ _ (SatNil ct cs)))
    ((HFOne _ j k _ _ pj _ _ _ acc1 _ hc1 sh ro d w1)
      (let-match erased fam (FamOne _ oj _ _ k2 _ _ _ sh2 ro2 no fam1))
      (let-match erased (shift-fn nhub j k2 k sh2 sh) (Refl _ _))
      (let-match erased d (MkDb2Top _ _ _ _ _ _ _ _ _ bp bn _ _ _ _ _ _ _ _ _))
      (let ((erased t) (erased s) (erased nt) (erased ns) (erased kt) (erased ks)) (counts-nth oss rt rs ct cs j oj cnt no))
      (let ((erased l) (erased al)) (add t bn))
      (let ((erased r) (erased ar)) (add s bp))
      (let ((erased e1)) (hfit-ext nhub p rt rs acc1 out hc1 w1))
      (let-match erased (db2-top-sound oj pj rt rs acc acc1 bp bn t s l r (exact-rot os oj p pj k x ro2 ro) d kt ks al ar) (OrL _ _ le)
        ((OrR _ _ h) (OrR _ _ (hit-some-ext oss acc1 out (hit-some-nth oss acc1 j oj no h) e1))))
      (match erased (hfit-sound nhub os p rt rs acc1 out hc1 oss ct cs x w1 fam1 cnt) _
        ((OrL _ _ sat) (OrL _ _ (SatOne j t s bp bn l r hc1 ct cs nt ns al ar le sat)))
        ((OrR _ _ h) (OrR _ _ h))))
    ((HFTwo _ j1 j2 k i _ _ pj _ _ _ acc1 _ hc1 sh ro hs d w1)
      (let-match erased fam (FamTwo _ o1 o2 _ _ _ k2 i3 i2 _ _ _ sh2 ro2 n1 n2 hs2 r12 r21 ai fam1))
      (let-match erased (shift-fn nhub j1 k2 k sh2 sh) (Refl _ _))
      (let-match erased (hubsubn-fn nhub j2 j1 i3 i hs2 hs) (Refl _ _))
      (let-match erased d (MkE2Top _ _ _ _ _ _ _ _ bp bn _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _))
      (let ((erased t1) (erased s1) (erased nt1) (erased ns1) (erased kt1) (erased ks1)) (counts-nth oss rt rs ct cs j1 o1 cnt n1))
      (let ((erased t2) (erased s2) (erased nt2) (erased ns2) (erased kt2) (erased ks2)) (counts-nth oss rt rs ct cs j2 o2 cnt n2))
      (let ((erased t) (erased atw)) (add t1 t2))
      (let ((erased s) (erased as)) (add s1 s2))
      (let ((erased l) (erased al)) (add t bn))
      (let ((erased r) (erased ar)) (add s bp))
      (let ((erased e1)) (hfit-ext nhub p rt rs acc1 out hc1 w1))
      (let-match erased (e2-top-sound o1 o2 nhub i i2 bp bn t1 s1 t2 s2 t s l r pj rt rs acc acc1 r12 r21 ai (exact-rot os o1 p pj k x ro2 ro) d
          kt1 ks1 kt2 ks2 atw as al ar) (OrL _ _ le)
        ((OrR _ _ h)
          (OrR _ _ (hit-some-ext oss acc1 out (match erased h _
            ((OrL _ _ h1) (hit-some-nth oss acc1 j1 o1 n1 h1))
            ((OrR _ _ h2) (hit-some-nth oss acc1 j2 o2 n2 h2))) e1))))
      (match erased (hfit-sound nhub os p rt rs acc1 out hc1 oss ct cs x w1 fam1 cnt) _
        ((OrL _ _ sat) (OrL _ _ (SatTwo j1 j2 t1 t2 t s1 s2 s bp bn l r hc1 ct cs nt1 nt2 atw ns1 ns2 as al ar le sat)))
        ((OrR _ _ h) (OrR _ _ h))))))
