; Face cycles of hypermap.sl: iterating a permutation, and the order of a dart along its face.

(def-adts $ (Iter : ((List (Nat)) f) ((Nat) k x y) -> Type)
  enum
  (many ItZ : (erased (List (Nat)) f) (erased (Nat) x) -> (Iter f (Zero) x x))
  (many ItS : (erased (List (Nat)) f) (erased (Nat) k x z y) (erased (Nth (Nat) f x z) p) (erased (Iter f k z y) rest) -> (Iter f (Succ k) x y)))

(def-fns _ $ (erased iter-fn : (erased (List (Nat)) f) (erased (Nat) k x y z) (subterm erased (Iter f k x y) p) (erased (Iter f k x z) q)
    -> (erased (Eq (Nat) y z) e))
  (let-match erased p (ItS _ k1 _ u _ px p1) ((ItZ _ _) (let-match erased q (ItZ _ _)) (Refl _ x)))
  (let-match erased q (ItS _ _ _ v _ qx q1))
  (let-match erased (nth-fn _ f x u v px qx) (Refl _ _))
  (iter-fn f k1 u y z p1 q1))

(def-fns _ $ (erased iter-add : (erased (List (Nat)) f) (erased (Nat) a b c x y z) (subterm erased (Iter f a x y) p) (erased (Iter f b y z) q)
    (erased (Add a b c) e) -> (erased (Iter f c x z) r))
  (let-match erased p (ItS _ a1 _ u _ px p1) ((ItZ _ _) (let-match erased e (AddZero _)) q))
  (let-match erased e (AddSucc _ _ c1 e1))
  (ItS f c1 x u z px (iter-add f a1 b c1 u y z p1 q e1)))

(def-fns _ $ (erased iter-split : (erased (List (Nat)) f) (erased (Nat) a b c x z) (subterm erased (Add a b c) e) (erased (Iter f c x z) p)
    -> (erased (Nat) y) (erased (Iter f a x y) q) (erased (Iter f b y z) r))
  (let-match erased e (AddSucc a1 _ c1 e1) ((AddZero _) (values x (ItZ f x) p)))
  (let-match erased p (ItS _ _ _ u _ px p1))
  (let ((erased y) (erased q) (erased r)) (iter-split f a1 b c1 u z e1 p1))
  (values y (ItS f a1 x u y px q) r))

(def-fns _ $ (erased path-iter : (erased (List (Nat)) p s xs) (erased (Nat) x y k) (subterm erased (Path p s x y xs) w) (erased (Length (Nat) xs k) l)
    -> (erased (Iter p k x y) r))
  (let-match erased w (PathStep _ _ xs1 _ z _ px _ w1) ((PathHere _ _ _) (let-match erased l (LengthNil _)) (ItZ p x)))
  (let-match erased l (LengthCons _ _ _ k1 l1))
  (ItS p k1 x z y px (path-iter p s xs1 z y k1 w1 l1)))

(def-fns _ $ (erased path-respect : (erased (List (Nat)) p s xs) (erased (Nat) x y u) (subterm erased (Path p s x y xs) w) (erased (NotIn u xs) nu)
    -> (erased (Path p (Cons (Nat) u (Nil (Nat))) x y xs) r))
  (let-match erased w (PathStep _ _ xs1 _ z _ px _ w1) ((PathHere _ _ _) (PathHere p _ x)))
  (let-match erased nu (NotInCons _ _ _ ne nu1))
  (PathStep p _ xs1 x z y px (NotInCons x u (Nil _) (apart-sym u x ne) (NotInNil x)) (path-respect p s xs1 z y u w1 nu1)))

; The face of y has a darts: f^a y = y, and the order of the next dart is a too.
(def-fns _ $ (erased order-iter : (erased (List (Nat)) f) (erased (Nat) y a) (erased (Order f y a) o) -> (erased (Iter f a y y) r))
  (let-match erased o (MkOrder _ xs _ y1 k py w l))
  (ItS f k y y1 y py (path-iter f _ xs y1 y k w l)))

(def-fns _ $ (erased order-next : (erased (Nat) d y y1 a) (erased (List (Nat)) f fi) (erased (Perm d f fi) pm) (erased (Order f y a) o)
    (erased (Nth (Nat) f y y1) py) -> (erased (Order f y1 a) r))
  (let-match erased o (MkOrder _ xs _ y2 k py2 w l))
  (let-match erased (nth-fn _ f y y1 y2 py py2) (Refl _ _))
  (let-match erased w (PathStep _ _ xs1 _ z _ pz out w1) ((PathHere _ _ _) o))
  (let-match erased out (NotInCons _ _ _ ne1 _))
  (let ((erased ny)) (path-avoid f (Cons _ y (Nil _)) xs1 z y y w1 (InHere y (Nil _))))
  (let ((erased n1))
    (match erased (in-dec y1 xs1) (((NotIn y1 xs1) n1))
      ((OrR _ _ q) q)
      (absurd (OrL _ _ q)
        (let-match erased (nat-eq y1 z) (Unequal _ _ _ _ nz)
          (absurd (Equal _ _ _) (let-match erased (perm-inj d y y1 y1 f fi pm py pz) (Refl _ _)) (apart-irrefl y ne1)))
        (let ((erased v) (erased pv) (erased pn)) (path-prev f (Cons _ y (Nil _)) xs1 z y y1 w1 (InThere y1 y xs1 q) nz))
        (let-match erased (perm-inj d v y y1 f fi pm pn py) (Refl _ _))
        (apart-irrefl y (notin-in y v xs1 ny pv)))))
  (let ((erased xs2) (erased sn) (erased w2))
    (path-snoc f (Cons _ y1 (Nil _)) xs1 z y y1 (path-respect f _ xs1 z y y1 w1 n1) py (NotInCons y y1 (Nil _) (apart-sym y1 y ne1) (NotInNil y))))
  (let-match erased l (LengthCons _ _ _ k1 l1))
  (MkOrder f xs2 y1 z (Succ k1) pz w2 (snoc-length _ xs1 xs2 y k1 sn l1)))
