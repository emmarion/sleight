(def-adts $ (Mem : (Type A) (A x) ((List A) xs) -> Type)
  enum
  (many MemHere : (erased Type A) (erased A x) (erased (List A) xs) -> (Mem A x (Cons A x xs)))
  (many MemThere : (erased Type A) (erased A x y) (erased (List A) xs) (erased (Mem A x xs) m) -> (Mem A x (Cons A y xs))))

(def-adts $ (Sel : ((List (Sub)) ql qh pl pr) -> Type)
  enum
  (many SelL : (erased (List (Sub)) ql qh) -> (Sel ql qh ql qh))
  (many SelR : (erased (List (Sub)) ql qh) -> (Sel ql qh qh ql)))

; Every constraint of hc names a sector below nhub.
(def-adts $ (HcIdx : ((Nat) nhub) ((List (Hc)) hc) -> Type)
  enum
  (many HINil : (erased (Nat) nhub) -> (HcIdx nhub (Nil (Hc))))
  (many HIOne : (erased (Nat) nhub j) (erased (Z) b) (erased (List (Hc)) hc) (erased (Lt j nhub) l) (erased (HcIdx nhub hc) rest)
      -> (HcIdx nhub (Cons (Hc) (HC1 j b) hc)))
  (many HITwo : (erased (Nat) nhub j1 j2) (erased (Z) b) (erased (List (Hc)) hc) (erased (Lt j1 nhub) l1) (erased (Lt j2 nhub) l2)
      (erased (HcIdx nhub hc) rest) -> (HcIdx nhub (Cons (Hc) (HC2 j1 j2 b) hc))))

; h: a part of ct containing p, both of length m.
(def-adts $ (CutAt : ((List (Sub)) p) ((List (List (Sub))) ct) -> Type)
  enum
  (many MkCutAt : (erased (List (Sub)) p h) (erased (List (List (Sub))) ct) (erased (Nat) m) (erased (Mem (List (Sub)) h ct) mh)
      (erased (Pw (Sub) (Sub) SubSub p h) sb) (erased (Length (Sub) p m) lp) (erased (Length (Sub) h m) lh) -> (CutAt p ct)))

(def-fns _ $ (many cut-find : (many (List (Sub)) p) (subterm many (List (List (Sub))) ct) -> (many (Bool) ok) (erased (IfT ok (CutAt p ct)) w))
  (let-match many ct (Cons _ h rest) ((Nil _) (values (BFalse) (IfF _))))
  (let ((many m) (erased lp)) (list-count _ p))
  (let ((many m2) (erased lh)) (list-count _ h))
  (let ((many c) (erased a)) (part-cmp p h))
  (match many (andb (nat-eqb m m2) (rel-sub c)) _
    ((BTrue)
      (let-match many (nat-eq m m2) (Equal _ _ _) (else (values (BFalse) (IfF _))))
      (let-match many c (PSub) (else (values (BFalse) (IfF _))))
      (let-match erased a (AnsSub _ _ sb))
      (values (BTrue) (IfY _ (MkCutAt p h ct m (MemHere _ h rest) sb lp lh))))
    ((BFalse)
      (let ((many ok) (erased w)) (tail $ cut-find p rest))
      (values ok (match erased w _
        ((IfY _ ca)
          (let-match erased ca (MkCutAt _ h2 _ m3 mh sb2 lp2 lh2))
          (IfY _ (MkCutAt p h2 ct m3 (MemThere _ h2 h rest mh) sb2 lp2 lh2)))
        ((IfF _) (IfF _)))))))

; ct: the cut list; out: the obligations; Forced p0 p o: a valid hub fitting p0 exactly fits p exactly, unless o holds of it.
(def-adts
  ((Pres : ((Nat) nhub) ((List (List (Sub))) rt rs ct) ((List (Sub)) p) ((List (List (Sub))) out) -> Type)
    enum
    (many PRed : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct out) (erased (List (Sub)) p) (erased (Mem (List (Sub)) p out) m)
        -> (Pres nhub rt rs ct p out))
    (many PCut : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct out) (erased (List (Sub)) p) (erased (CutAt p ct) c)
        -> (Pres nhub rt rs ct p out))
    (many PHub : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc o out) (erased (List (Sub)) p) (erased (List (Hc)) hc)
        (erased (Length (Sub) p nhub) l) (erased (CoverOk nhub hc) cv) (erased (HcIdx nhub hc) ix) (erased (HFit nhub p rt rs hc acc o) w)
        (erased (Ext o out) e) -> (Pres nhub rt rs ct p out))
    (many PSplit : (erased (Nat) nhub k) (erased (List (List (Sub))) rt rs ct o1 o2 out) (erased (List (Sub)) p ql qh pl pr)
        (erased (PartSplit k p ql qh) w) (erased (Sel ql qh pl pr) s) (erased (Pres nhub rt rs ct pl o1) dl) (erased (Pres nhub rt rs ct pr o2) dr)
        (erased (Ext o1 out) e1) (erased (Ext o2 out) e2) -> (Pres nhub rt rs ct p out))
    (many PSim : (erased (Nat) nhub k m) (erased (List (List (Sub))) rt rs ct o1 o2 out) (erased (List (Sub)) p p2 pe0 pe)
        (erased (Rot (Sub) k p p2) ro) (erased (Lt k (Succ m)) lk) (erased (Length (Sub) p m) lp) (erased (Length (Sub) pe0 m) le)
        (erased (Pw (Sub) (Sub) SubSub p2 pe0) sb) (erased (Forced nhub rt rs ct pe0 pe o1) fe) (erased (Pres nhub rt rs ct pe o2) de)
        (erased (Ext o1 out) e1) (erased (Ext o2 out) e2) -> (Pres nhub rt rs ct p out)))
  ((Forced : ((Nat) nhub) ((List (List (Sub))) rt rs ct) ((List (Sub)) p0 p) ((List (List (Sub))) o) -> Type)
    enum
    (many FRoot : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct o) (erased (List (Sub)) p) -> (Forced nhub rt rs ct p p o))
    (many FLeft : (erased (Nat) nhub k m) (erased (List (List (Sub))) rt rs ct o) (erased (List (Sub)) p0 p ql qh pl other cand)
        (erased (Forced nhub rt rs ct p0 p o) f) (erased (PartSplit k p ql qh) w) (erased (Sel ql qh pl other) s)
        (erased (Pw (Sub) (Sub) SubSub cand p0) sb) (erased (Ex (Sub) (Sub) SubDis cand other) dj) (erased (Length (Sub) cand m) lc)
        (erased (Length (Sub) p0 m) l0) -> (Forced nhub rt rs ct cand pl o))
    (many FRight : (erased (Nat) nhub k) (erased (List (List (Sub))) rt rs ct o ol) (erased (List (Sub)) p0 p ql qh pl pr)
        (erased (Forced nhub rt rs ct p0 p o) f) (erased (PartSplit k p ql qh) w) (erased (Sel ql qh pl pr) s) (erased (Pres nhub rt rs ct pl ol) dl)
        (erased (Ext ol o) e) -> (Forced nhub rt rs ct p0 pr o))))

(def-adts $ (Pr2 : -> Type)
  enum
  (many MkPr2 : (many (List (Sub)) a b) -> (Pr2)))

; env: the labelled parts of the walk so far, all reaching acc.
(def-adts $ (EnvE : ((Nat) nhub) ((List (List (Sub))) rt rs ct acc) ((List (Pr2)) env) -> Type)
  enum
  (many EENil : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc) -> (EnvE nhub rt rs ct acc (Nil (Pr2))))
  (many EECons : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc oa da ob db) (erased (List (Sub)) p0a pa p0b pb) (erased (List (Pr2)) env)
      (erased (Forced nhub rt rs ct p0a pa oa) fa) (erased (Pres nhub rt rs ct pa da) xa) (erased (Ext oa acc) ea) (erased (Ext da acc) ea2)
      (erased (Forced nhub rt rs ct p0b pb ob) fb) (erased (Pres nhub rt rs ct pb db) xb) (erased (Ext ob acc) eb) (erased (Ext db acc) eb2)
      (erased (EnvE nhub rt rs ct acc env) rest) -> (EnvE nhub rt rs ct acc (Cons (Pr2) (MkPr2 p0a p0b) env))))

(def-adts $ (W3 : ((Nat) nhub) ((List (List (Sub))) rt rs ct) ((List (Sub)) p mp) ((List (List (Sub))) acc out) -> Type)
  enum
  (many MkW3 : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc out) (erased (List (Sub)) p mp) (erased (Pres nhub rt rs ct p out) d0)
      (erased (Pres nhub rt rs ct mp out) d1) (erased (Ext acc out) e) -> (W3 nhub rt rs ct p mp acc out)))

; q and r: the parts of one side of a similarity step.
(def-adts $ (SimOk : ((List (Sub)) q r) -> Type)
  enum
  (many MkSimOk : (erased (List (Sub)) q r p2) (erased (Nat) m k) (erased (Length (Sub) q m) lq) (erased (Length (Sub) r m) lr)
      (erased (Rot (Sub) k q p2) ro) (erased (Lt k (Succ m)) lk) (erased (Pw (Sub) (Sub) SubSub p2 r) sb) -> (SimOk q r)))

; p0: one side's labelled part, read off an EnvE.
(def-adts $ (Entry : ((Nat) nhub) ((List (List (Sub))) rt rs ct acc) ((List (Sub)) p0) -> Type)
  enum
  (many MkEntry : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc o d) (erased (List (Sub)) p0 p) (erased (Forced nhub rt rs ct p0 p o) f)
      (erased (Pres nhub rt rs ct p d) x) (erased (Ext o acc) e) (erased (Ext d acc) e2) -> (Entry nhub rt rs ct acc p0)))

(def-fns _ $ (erased forced-ext : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct o o2) (erased (List (Sub)) p0 p)
    (subterm erased (Forced nhub rt rs ct p0 p o) f) (erased (Ext o o2) e) -> (erased (Forced nhub rt rs ct p0 p o2) r))
  (match erased f _
    ((FRoot _ _ _ _ _ _) (FRoot nhub rt rs ct o2 p))
    ((FLeft _ k m _ _ _ _ q0 q ql qh _ other _ f1 w s sb dj lc l0)
      (FLeft nhub k m rt rs ct o2 q0 q ql qh p other p0 (forced-ext nhub rt rs ct o o2 q0 q f1 e) w s sb dj lc l0))
    ((FRight _ k _ _ _ _ ol q0 q ql qh pl _ f1 w s dl e1)
      (FRight nhub k rt rs ct o2 ol q0 q ql qh pl p (forced-ext nhub rt rs ct o o2 q0 q f1 e) w s dl (ext-trans ol o o2 e1 e)))))

(def-fns _ $ (erased env-ext : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc acc2) (erased (List (Pr2)) env)
    (subterm erased (EnvE nhub rt rs ct acc env) ee) (erased (Ext acc acc2) e) -> (erased (EnvE nhub rt rs ct acc2 env) r))
  (match erased ee _
    ((EENil _ _ _ _ _) (EENil nhub rt rs ct acc2))
    ((EECons _ _ _ _ _ oa da ob db p0a pa p0b pb env1 fa xa ea ea2 fb xb eb eb2 rest)
      (EECons nhub rt rs ct acc2 oa da ob db p0a pa p0b pb env1 fa xa (ext-trans oa acc acc2 ea e) (ext-trans da acc acc2 ea2 e)
        fb xb (ext-trans ob acc acc2 eb e) (ext-trans db acc acc2 eb2 e) (env-ext nhub rt rs ct acc acc2 env1 rest e)))))

(def-fns _ $ (erased env-nth : (erased (Nat) nhub i) (erased (List (List (Sub))) rt rs ct acc) (erased (List (Pr2)) env) (erased (List (Sub)) a b)
    (subterm erased (EnvE nhub rt rs ct acc env) ee) (erased (Nth (Pr2) env i (MkPr2 a b)) nt)
    -> (erased (Entry nhub rt rs ct acc a) ra) (erased (Entry nhub rt rs ct acc b) rb))
  (let-match erased ee (EECons _ _ _ _ _ oa da ob db p0a pa p0b pb env1 fa xa ea ea2 fb xb eb eb2 rest) (absurd (EENil _ _ _ _ _) nt))
  (let-match erased nt (NthThere _ _ _ i1 _ nt1)
    ((NthHere _ _ _) (values (MkEntry nhub rt rs ct acc oa da a pa fa xa ea ea2) (MkEntry nhub rt rs ct acc ob db b pb fb xb eb eb2))))
  (env-nth nhub i1 rt rs ct acc env1 a b rest nt1))

(def-fns _ $ (erased mem-ext : (erased (List (Sub)) x) (erased (List (List (Sub))) o o2) (erased (Mem (List (Sub)) x o) m) (subterm erased (Ext o o2) e)
    -> (erased (Mem (List (Sub)) x o2) r))
  (let-match erased e (ExtCons _ o3 q e1) ((ExtRefl _) m))
  (MemThere _ x q o3 (mem-ext x o o3 m e1)))

(def-fns _ $ (erased pres-ext : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct) (erased (List (Sub)) p) (erased (List (List (Sub))) o o2)
    (erased (Pres nhub rt rs ct p o) d) (erased (Ext o o2) e) -> (erased (Pres nhub rt rs ct p o2) r))
  (match erased d _
    ((PRed _ _ _ _ _ _ m) (PRed nhub rt rs ct o2 p (mem-ext p o o2 m e)))
    ((PCut _ _ _ _ _ _ c) (PCut nhub rt rs ct o2 p c))
    ((PHub _ _ _ _ acc o1 _ _ hc l cv ix w e1) (PHub nhub rt rs ct acc o1 o2 p hc l cv ix w (ext-trans o1 o o2 e1 e)))
    ((PSplit _ k _ _ _ o1 o3 _ _ ql qh pl pr w s dl dr e1 e2)
      (PSplit nhub k rt rs ct o1 o3 o2 p ql qh pl pr w s dl dr (ext-trans o1 o o2 e1 e) (ext-trans o3 o o2 e2 e)))
    ((PSim _ k m _ _ _ o1 o3 _ _ p2 pe0 pe ro lk lp le sb fe de e1 e2)
      (PSim nhub k m rt rs ct o1 o3 o2 p p2 pe0 pe ro lk lp le sb fe de (ext-trans o1 o o2 e1 e) (ext-trans o3 o o2 e2 e)))))

(def-adts $ (PrAt : ((List (Pr2)) env) ((Nat) i) -> Type)
  enum
  (many PAHit : (erased (List (Pr2)) env) (erased (Nat) i) (many (List (Sub)) a b) (erased (Nth (Pr2) env i (MkPr2 a b)) p) -> (PrAt env i))
  (many PAMiss : (erased (List (Pr2)) env) (erased (Nat) i) -> (PrAt env i)))

(def-fns _ $ (many pr-at : (subterm many (Nat) i) (many (List (Pr2)) env) -> (many (PrAt env i) r))
  (let-match many env (Cons _ x rest) ((Nil _) (PAMiss env i)))
  (let-match many x (MkPr2 a b))
  (let-match many i (Succ i1) ((Zero) (PAHit env i a b (NthHere _ x rest))))
  (let-match many (notail $ pr-at i1 rest) (PAHit _ _ a2 b2 p) ((PAMiss _ _) (PAMiss env i)))
  (PAHit env i a2 b2 (NthThere _ x rest i1 (MkPr2 a2 b2) p)))

(def-fns _ $ (many hc-idx-c : (many (Nat) nhub) (subterm many (List (Hc)) hc) -> (many (Bool) ok) (erased (IfT ok (HcIdx nhub hc)) w))
  (let-match many hc (Cons _ h rest) ((Nil _) (values (BTrue) (IfY _ (HINil nhub)))))
  (let ((many ok1) (erased w1)) (notail $ hc-idx-c nhub rest))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let-match erased w1 (IfY _ ix))
  (match many h _
    ((HC1 j b)
      (let-match many (lt-test j nhub) (LtYes _ _ l) ((LtNo _ _) (values (BFalse) (IfF _))))
      (values (BTrue) (IfY _ (HIOne nhub j b rest l ix))))
    ((HC2 j1 j2 b)
      (let-match many (lt-test j1 nhub) (LtYes _ _ l1) ((LtNo _ _) (values (BFalse) (IfF _))))
      (let-match many (lt-test j2 nhub) (LtYes _ _ l2) ((LtNo _ _) (values (BFalse) (IfF _))))
      (values (BTrue) (IfY _ (HITwo nhub j1 j2 b rest l1 l2 ix))))))

(def-fns _ $ (many sim-rec : (many (List (Sub)) q r) (many (Nat) m) (erased (Length (Sub) q m) lq) (erased (Length (Sub) r m) lr)
    (subterm many (Nat) t) (erased (Lt t (Succ m)) lt) -> (many (Bool) ok) (erased (IfT ok (SimOk q r)) w))
  (let ((many p2) (erased ro)) (rot-c _ t q))
  (let ((many c) (erased a)) (part-cmp p2 r))
  (let-match many c (PSub) (else
    (let-match many t (Succ t1) ((Zero) (values (BFalse) (IfF _))))
    (tail $ sim-rec q r m lq lr t1 (lt-succ-left t1 (Succ m) lt))))
  (let-match erased a (AnsSub _ _ sb))
  (values (BTrue) (IfY _ (MkSimOk q r p2 m t lq lr ro lt sb))))

(def-fns _ $ (many mloc : (many (Loc) i) (many (Nat) j) (many (List (Sub)) mp) -> (many (Loc) i2) (many (Nat) j2))
  (let ((many n)) (size _ mp))
  (let-match many i (LFan k)
    ((LSpoke) (values (LSpoke) (monus n (Succ j))))
    ((LHat) (values (LHat) (bif _ (nat-eqb j 0) 0 (monus n j)))))
  (let ((many j2)) (monus n (Succ j)))
  (let-match many (drop _ j2 mp) (Cons _ x _) ((Nil _) (values i j2)))
  (values (LFan (monus (size _ (expand-fans x)) (Succ k))) j2))

(def-fns _ $ (many mj : (many (Nat) n c j) -> (many (Nat) r))
  (bif _ (nat-ltb c j) (monus (nat-add c n) j) (monus c j)))

(def-fns _ $ (many mhc : (many (Nat) n c) (subterm many (List (Hc)) hc) -> (many (List (Hc)) r))
  (let-match many hc (Cons _ h rest) ((Nil _) hc))
  (Cons _ (match many h _ ((HC1 i b) (HC1 (mj n c i) b)) ((HC2 i j b) (HC2 (mj n c i) (mj n c j) b))) (notail $ mhc n c rest)))

(def-fns _ $ (many sim-c : (many (List (Sub)) q r) -> (many (Bool) ok) (erased (IfT ok (SimOk q r)) w))
  (let ((many m) (erased lq)) (list-count _ q))
  (let ((many m2) (erased lr)) (list-count _ r))
  (let-match many (nat-eq m2 m) (Equal _ _ _) (else (values (BFalse) (IfF _))))
  (sim-rec q r m lq lr m (lt-succ m)))

(def-fns _ $ (many keep-c : (erased (Nat) nhub k) (erased (List (List (Sub))) rt rs ct o) (erased (List (Sub)) p ql qh) (many (List (Sub)) pl other)
    (many (List (Sub)) p0 cand) (many (Bool) good) (erased (Forced nhub rt rs ct p0 p o) f) (erased (PartSplit k p ql qh) w) (erased (Sel ql qh pl other) s)
    -> (many (List (Sub)) p0l) (erased (Forced nhub rt rs ct p0l pl o) r))
  (let-match many good (BTrue) ((BFalse) (values pl (FRoot nhub rt rs ct o pl))))
  (let ((many c1) (erased a1)) (part-cmp cand p0))
  (let-match many c1 (PSub) (else (values pl (FRoot nhub rt rs ct o pl))))
  (let ((many c2) (erased a2)) (part-cmp cand other))
  (let-match many c2 (PDis) (else (values pl (FRoot nhub rt rs ct o pl))))
  (let ((many m) (erased lc)) (list-count _ cand))
  (let ((many m0) (erased l0)) (list-count _ p0))
  (let-match many (nat-eq m0 m) (Equal _ _ _) (else (values pl (FRoot nhub rt rs ct o pl))))
  (let-match erased a1 (AnsSub _ _ sb))
  (let-match erased a2 (AnsDis _ _ dj))
  (values cand (FLeft nhub k m rt rs ct o p0 p ql qh pl other cand f w s sb dj lc l0)))

(def-fns _ $ (many side-split : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct o) (many (Loc) i) (many (Nat) j k) (many (Bool) lo)
    (many (List (Sub)) p0 p) (erased (Forced nhub rt rs ct p0 p o) f)
    -> (many (List (Sub)) pl pr p0l) (erased (List (Sub)) ql qh) (erased (PartSplit k p ql qh) w) (erased (Sel ql qh pl pr) s)
    (erased (Forced nhub rt rs ct p0l pl o) fl))
  (let ((many ql) (many qh) (erased w)) (split-both i j k p))
  (let ((many q0l) (many q0h) (erased _)) (split-both i j k p0))
  (let ((many pl) (many pr) (many cand) (erased s))
    (match many lo (((List (Sub)) pl) ((List (Sub)) pr) ((List (Sub)) cand) ((Sel ql qh pl pr) s))
      ((BTrue) (values ql qh q0l (SelL ql qh)))
      ((BFalse) (values qh ql q0h (SelR ql qh)))))
  (let ((many p0l) (erased fl)) (keep-c nhub k rt rs ct o p ql qh pl pr p0 cand (good-split i j k p0) f w s))
  (values pl pr p0l ql qh w s fl))

(def-fns _ $ (many hub-side : (many (Nat) nhub) (many (List (List (Sub))) rt rs ct acc) (many (List (Sub)) p) (many (List (Hc)) hc)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (Pres nhub rt rs ct p out)) w) (erased (Ext acc out) e))
  (let ((many ok1) (erased w1)) (hubcap-cover-c nhub hc))
  (let ((many ok2) (erased w2)) (hc-idx-c nhub hc))
  (let ((many m) (erased l)) (list-count _ p))
  (let-match many ok1 (BTrue) ((BFalse) (values (BFalse) acc (IfF _) (ExtRefl acc))))
  (let-match many ok2 (BTrue) ((BFalse) (values (BFalse) acc (IfF _) (ExtRefl acc))))
  (let-match many (nat-eq m nhub) (Equal _ _ _) (else (values (BFalse) acc (IfF _) (ExtRefl acc))))
  (let-match erased w1 (IfY _ cv))
  (let-match erased w2 (IfY _ ix))
  (let ((many ok3) (many out) (erased w3)) (hubcap-fit-c nhub p rt rs hc acc))
  (let-match many ok3 (BTrue) ((BFalse) (values (BFalse) acc (IfF _) (ExtRefl acc))))
  (let-match erased w3 (IfY _ hf))
  (values (BTrue) out (IfY _ (PHub nhub rt rs ct acc out out p hc l cv ix hf (ExtRefl out))) (hfit-ext nhub p rt rs acc out hc hf)))

(def-fns _ $ (many sim-side : (erased (Nat) nhub) (erased (List (List (Sub))) rt rs ct acc) (many (List (Sub)) p r) (erased (Entry nhub rt rs ct acc r) en)
    -> (many (Bool) ok) (erased (IfT ok (Pres nhub rt rs ct p acc)) w))
  (let-match erased en (MkEntry _ _ _ _ _ o d _ pe fe xe e1 e2))
  (let ((many ok) (erased w)) (sim-c p r))
  (let-match many ok (BTrue) ((BFalse) (values (BFalse) (IfF _))))
  (let-match erased w (IfY _ sm))
  (let-match erased sm (MkSimOk _ _ p2 m k lq lr ro lk sb))
  (values (BTrue) (IfY _ (PSim nhub k m rt rs ct o d acc p p2 r pe ro lk lq lr sb fe xe e1 e2))))

(def-fns _ $ (many check2-c : (many (Nat) nhub) (many (List (List (Sub))) rt rs ct acc) (many (List (Pr2)) env) (erased (EnvE nhub rt rs ct acc env) ee)
    (many (List (Sub)) p0 p mp0 mp) (erased (Forced nhub rt rs ct p0 p acc) f0) (erased (Forced nhub rt rs ct mp0 mp acc) f1) (subterm many (Script) s)
    -> (many (Bool) ok) (many (List (List (Sub))) out) (erased (IfT ok (W3 nhub rt rs ct p mp acc out)) w))
  (match many s _
    ((SSplit i j k lo lab l r)
      (let ((many i2) (many j2)) (mloc i j mp))
      (let ((many pl) (many pr) (many p0l) (erased ql) (erased qh) (erased w0) (erased s0) (erased fl0)) (side-split nhub rt rs ct acc i j k lo p0 p f0))
      (let ((many mpl) (many mpr) (many mp0l) (erased mql) (erased mqh) (erased w1) (erased s1) (erased fl1))
        (side-split nhub rt rs ct acc i2 j2 k lo mp0 mp f1))
