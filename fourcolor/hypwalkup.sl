; The Walkup transforms of walkup.v: a dart z is cut out of the node and face cycles, and the edge permutation follows.

; A hypermap from its node and face permutations.
(def-fns _ $ (erased hyper-mk : (erased (Nat) d) (erased (List (Nat)) n ni f fi) (erased (Perm d n ni) pn) (erased (Perm d f fi) pf)
    -> (erased (List (Nat)) e) (erased (Hypermap d e n f) h))
  (let ((erased c) (erased rc)) (respects-exists n f d (perm-under d f fi pf) (perm-length d n ni pn)))
  (let ((erased ci) (erased rci) (erased pc)) (perm-comp d n ni f fi c pn pf rc))
  (let-match erased pc (MkPerm _ _ _ ids io lc cic cci))
  (let-match erased pn (MkPerm _ _ _ ids2 io2 ln nin nni))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let-match erased pf (MkPerm _ _ _ ids3 io3 lf fif ffi))
  (let-match erased (iota-fn d ids ids3 io io3) (Refl _ _))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased lni)) (respects-length-inv n ni ids d nni li))
  (values ci (MkHypermap d ci n f ids ni fi c io
    (respects-assoc-inv ni fi f ci ids ni rci (respects-id-left d ids ni io (perm-under d ni n (perm-sym d n ni pn))) ffi) nni
    (respects-assoc n ni fi ids ci fi d nin (respects-id-right d ids fi io (respects-length-inv f fi ids d ffi li)) rci
      (respects-length fi ni ci d rci lni) lni)
    ffi rc cic)))

; p2 is p with z cut out of its cycle and fixed (Gonthier's skip, read on the whole dart set).
(def-adts $ (Skip : ((List (Nat)) p) ((Nat) z) ((List (Nat)) p2) -> Type)
  enum
  (many SkipFixed : (erased (List (Nat)) p) (erased (Nat) z) (erased (Nth (Nat) p z z) pz) -> (Skip p z p))
  (many SkipCut : (erased (List (Nat)) p p2) (erased (Nat) z w u) (erased (Nth (Nat) p w z) pw) (erased (Nth (Nat) p z u) pz)
      (erased (Apart (Nat) Lt w z) ne) (erased (Upd2 p w u z z p2) up) -> (Skip p z p2)))

(def-fns _ $ (erased step-le : (erased (Nat) a b) (erased (Or (Eq (Nat) a b) (Eq (Nat) a (Succ b))) o) -> (erased (Lt b (Succ a)) r))
  (match erased o _
    ((OrL _ _ e) (let-match erased e (Refl _ _)) (lt-succ a))
    ((OrR _ _ e) (let-match erased e (Refl _ _)) (lt-weaken b (Succ b) (lt-succ b)))))

(def-fns _ $ (erased le-trans : (erased (Nat) a b c) (erased (Lt a (Succ b)) p) (erased (Lt b (Succ c)) q) -> (erased (Lt a (Succ c)) r))
  (lt-le-trans a (Succ b) (Succ c) p (LtS b (Succ c) q)))

; Cutting z out of a face cycle: the genus is kept or drops by one.
(def-fns _ $ (erased walkup-face : (erased (Nat) d gen w z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Nth (Nat) f w z) pw) (erased (Apart (Nat) Lt w z) ne) (erased (Lt w d) lw)
    -> (erased (Nat) b2) (erased (List (Nat)) f2 e2) (erased (Nat) gen2) (erased (Nth (Nat) f z b2) pb) (erased (Upd2 f w b2 z z f2) up)
    (erased (Hypermap d e2 n f2) h2) (erased (Genus d e2 n f2 gen2) p2) (erased (Or (Eq (Nat) gen gen2) (Eq (Nat) gen (Succ gen2))) st))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf) (erased kx) (erased kn) (erased kf) (erased kc)
      (erased ox) (erased on) (erased of) (erased gn) (erased gf) (erased g) (erased grn) (erased grf) (erased cg) (erased cs) (erased es))
    (genus-core d gen e n f h p))
  (let ((erased b2) (erased f2) (erased fi2) (erased pb) (erased up) (erased pf2) (erased of2)) (split-fixed d kf w z f fi pf of pw ne lw))
  (let ((erased e2) (erased h2)) (hyper-mk d n ni f2 fi2 pn pf2))
  (let ((erased gen2) (erased p2)) (even-genus d e2 n f2 h2))
  (let ((erased nf2) (erased _) (erased _) (erased rnf2) (erased _) (erased _) (erased _) (erased kx2) (erased kn2) (erased kf2) (erased kc2)
      (erased ox2) (erased on2) (erased of3) (erased gn2) (erased gf2) (erased g2) (erased grn2) (erased grf2) (erased cg2) (erased cs2) (erased es2))
    (genus-core d gen2 e2 n f2 h2 p2))
  (let-match erased (graph-fn d n gn gn2 grn grn2) (Refl _ _))
  (let-match erased (orbits-unique d kn2 kn n on2 on) (Refl _ _))
  (let-match erased (orbits-unique d kf2 (Succ kf) f2 of3 of2) (Refl _ _))
  (let ((erased kc3) (erased gen3) (erased cs3) (erased es3) (erased st))
    (euler-step d kn kf kx kx2 kc2 gen2 w z b2 n ni f fi nf f2 fi2 nf2 gn gf g gf2 g2 pn pf pf2 rnf rnf2 ox ox2 grn grf grf2 cg cg2 pw pb up cs2 es2))
  (let-match erased (genus-unique d gen gen3 e n f p (core-genus d kx kn kf kc3 gen3 e n f nf ni fi gn gf g pe rnf pn pf ox on of grn grf cg cs3 es3))
    (Refl _ _))
  (values b2 f2 e2 gen2 pb up h2 p2 st))

(def-fns _ $ (erased perm-inv-unique : (erased (Nat) d) (erased (List (Nat)) p q1 q2) (erased (Perm d p q1) pm1) (erased (Perm d p q2) pm2)
    -> (erased (Eq (List (Nat)) q1 q2) r))
  (let-match erased pm1 (MkPerm _ _ _ ids io lp q1p pq1))
  (let-match erased pm2 (MkPerm _ _ _ ids2 io2 _ q2p pq2))
  (let-match erased (iota-fn d ids ids2 io io2) (Refl _ _))
  (let ((erased li)) (iota-length d ids io))
  (respects-fn ids q2 q1 q2
    (respects-assoc q2 p q1 ids ids q1 d pq2 (respects-id-right d ids q1 io (respects-length-inv p q1 ids d pq1 li)) q1p li lp)
    (respects-id-left d ids q2 io (perm-under d q2 p (perm-sym d p q2 pm2)))))

; Cutting z out of a node cycle, through the dual.
(def-fns _ $ (erased walkup-node : (erased (Nat) d gen w z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Nth (Nat) n w z) pw) (erased (Apart (Nat) Lt w z) ne) (erased (Lt w d) lw)
    -> (erased (Nat) b2) (erased (List (Nat)) n2 e2) (erased (Nat) gen2) (erased (Nth (Nat) n z b2) pb) (erased (Upd2 n w b2 z z n2) up)
    (erased (Hypermap d e2 n2 f) h2) (erased (Genus d e2 n2 f gen2) p2) (erased (Or (Eq (Nat) gen gen2) (Eq (Nat) gen (Succ gen2))) st))
  (let ((erased ei) (erased fi) (erased ni) (erased hd) (erased pe) (erased pf) (erased pn) (erased pd)) (genus-dual d gen e n f h p))
  (let ((erased lz)) (perm-val d w z n ni pn pw))
  (let ((erased b2) (erased pb) (erased lb2)) (perm-nth d z n ni pn lz))
  (let ((erased pbi)) (perm-inv d z b2 n ni pn pb))
  (let ((erased w2) (erased ni2) (erased e2) (erased gen2) (erased pw2) (erased ui) (erased h2) (erased p2) (erased st))
    (walkup-face d gen b2 z ei fi ni hd pd pbi (apart-sym z b2 (img-apart d w z z b2 n ni pn pw pb ne)) lb2))
  (let-match erased (nth-fn _ ni z w2 w pw2 (perm-inv d w z n ni pn pw)) (Refl _ _))
  (let ((erased n2) (erased un) (erased pn2)) (perm-swap d b2 z z w ni n ni2 (perm-sym d n ni pn) pbi pw2 ui))
  (let ((erased e3) (erased n3) (erased f3) (erased h3) (erased _) (erased pn3) (erased pf3) (erased p3)) (genus-dual d gen2 e2 fi ni2 h2 p2))
  (let-match erased (perm-inv-unique d ni2 n3 n2 pn3 pn2) (Refl _ _))
  (let-match erased (perm-inv-unique d fi f3 f pf3 (perm-sym d f fi pf)) (Refl _ _))
  (values b2 n3 e3 gen2 pb un h3 p3 st))

(def-fns _ $ (erased skip-face : (erased (Nat) d gen z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Lt z d) lz) -> (erased (List (Nat)) f2 e2) (erased (Nat) gen2) (erased (Skip f z f2) sk) (erased (Hypermap d e2 n f2) h2)
    (erased (Genus d e2 n f2 gen2) p2) (erased (Lt gen2 (Succ gen)) le))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased w) (erased pwi) (erased lw)) (perm-nth d z fi f (perm-sym d f fi pf) lz))
  (let ((erased pw)) (perm-inv d z w fi f (perm-sym d f fi pf) pwi))
  (let-match erased (nat-eq w z) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values f e gen (SkipFixed f z pw) h p (lt-succ gen))))
  (let ((erased b2) (erased f2) (erased e2) (erased gen2) (erased pb) (erased up) (erased h2) (erased p2) (erased st))
    (walkup-face d gen w z e n f h p pw ne lw))
  (values f2 e2 gen2 (SkipCut f f2 z w b2 pw pb ne up) h2 p2 (step-le gen gen2 st)))

(def-fns _ $ (erased skip-node : (erased (Nat) d gen z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Lt z d) lz) -> (erased (List (Nat)) n2 e2) (erased (Nat) gen2) (erased (Skip n z n2) sk) (erased (Hypermap d e2 n2 f) h2)
    (erased (Genus d e2 n2 f gen2) p2) (erased (Lt gen2 (Succ gen)) le))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf)) (hyper-core d e n f h))
  (let ((erased w) (erased pwi) (erased lw)) (perm-nth d z ni n (perm-sym d n ni pn) lz))
  (let ((erased pw)) (perm-inv d z w ni n (perm-sym d n ni pn) pwi))
  (let-match erased (nat-eq w z) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values n e gen (SkipFixed n z pw) h p (lt-succ gen))))
  (let ((erased b2) (erased n2) (erased e2) (erased gen2) (erased pb) (erased up) (erased h2) (erased p2) (erased st))
    (walkup-node d gen w z e n f h p pw ne lw))
  (values n2 e2 gen2 (SkipCut n n2 z w b2 pw pb ne up) h2 p2 (step-le gen gen2 st)))

; WalkupE with z kept as a dart fixed by all three permutations: the genus does not grow (le_genus_WalkupE).
(def-fns _ $ (erased walkup-iso : (erased (Nat) d gen z) (erased (List (Nat)) e n f) (erased (Hypermap d e n f) h) (erased (Genus d e n f gen) p)
    (erased (Lt z d) lz) -> (erased (List (Nat)) e2 n2 f2) (erased (Nat) gen2) (erased (Skip n z n2) skn) (erased (Skip f z f2) skf)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Genus d e2 n2 f2 gen2) p2) (erased (Lt gen2 (Succ gen)) le))
  (let ((erased f1) (erased e1) (erased gen1) (erased skf) (erased h1) (erased p1) (erased le1)) (skip-face d gen z e n f h p lz))
  (let ((erased n2) (erased e2) (erased gen2) (erased skn) (erased h2) (erased p2) (erased le2)) (skip-node d gen1 z e1 n f1 h1 p1 lz))
  (values e2 n2 f1 gen2 skn skf h2 p2 (le-trans gen2 gen1 gen le2 le1)))

(def-fns _ $ (erased skip-fixed : (erased (List (Nat)) p p2) (erased (Nat) z) (erased (Skip p z p2) sk) -> (erased (Nth (Nat) p2 z z) r))
  (match erased sk _
    ((SkipFixed _ _ pz) pz)
    ((SkipCut _ _ _ w u _ _ _ up) (upd2-b p p2 w u z z up))))

(def-fns _ $ (erased snoc-split : (erased Type A) (erased (List A) xs) (erased (Nat) k) (subterm erased (Length A xs (Succ k)) l)
    -> (erased (List A) xs0) (erased A x) (erased (Snoc A xs0 x xs) s) (erased (Length A xs0 k) l0))
  (let-match erased l (LengthCons _ y ys _ l1))
  (let-match erased k (Succ k1) ((Zero) (let-match erased l1 (LengthNil _)) (values (Nil _) y (SnocNil _ y) (LengthNil _))))
  (let ((erased ys0) (erased x) (erased s) (erased l0)) (snoc-split _ ys k1 l1))
  (values (Cons _ y ys0) x (SnocCons _ y x ys0 ys s) (LengthCons _ y ys0 k1 l0)))

; Dropping the last entry of lab, xs and ls keeps a composite, when xs stays below the shorter length.
(def-fns _ $ (erased unsnoc-respects : (erased (List (Nat)) lab lab0 xs xs0 ls ls0) (erased (Nat) a x l k) (erased (Respects lab xs ls) rp)
    (erased (Snoc (Nat) lab0 a lab) sl) (subterm erased (Snoc (Nat) xs0 x xs) sx) (erased (Snoc (Nat) ls0 l ls) ss) (erased (Length (Nat) lab0 k) ll)
    (erased (Under xs0 k) u) -> (erased (Respects lab0 xs0 ls0) r))
  (let-match erased sx (SnocCons _ j _ xs1 xs2 sx1)
    ((SnocNil _ _)
      (let-match erased rp (RespCons _ _ _ _ _ _ rp1))
      (let-match erased rp1 (RespNil _))
      (let-match erased ss (SnocNil _ _) (absurd (SnocCons _ _ _ _ _ s1) s1))
      (RespNil lab0)))
  (let-match erased rp (RespCons _ _ _ _ _ pj rp1))
  (let-match erased ss (SnocCons _ v _ ls1 ls2 ss1) (absurd (SnocNil _ _) (let-match erased rp1 (RespNil _)) sx1))
  (let-match erased u (UnderCons _ _ _ lj u1))
  (let-match erased (snoc-back _ lab0 lab a v j k sl ll pj) (OrL _ _ q)
    (absurd (OrR _ _ e) (let-match erased e (Refl _ _)) (lt-irrefl j lj)))
  (RespCons lab0 xs1 ls1 j v q (unsnoc-respects lab lab0 xs2 xs1 ls2 ls1 a x l k rp1 sl sx1 ss1 ll u1)))

(def-fns _ $ (erased under-snoc : (erased (List (Nat)) xs xs0) (erased (Nat) x k) (erased (Under xs k) u) (subterm erased (Snoc (Nat) xs0 x xs) s)
    -> (erased (Under xs0 k) r))
  (let-match erased s (SnocCons _ y _ xs1 xs2 s1) ((SnocNil _ _) (UnderNil k)))
  (let-match erased u (UnderCons _ _ _ ly u1))
  (UnderCons xs1 y k ly (under-snoc xs2 xs1 x k u1 s1)))

(def-fns _ $ (erased under-tighten : (erased (List (Nat)) xs) (erased (Nat) k) (subterm erased (Under xs (Succ k)) u) (erased (NotIn k xs) out)
    -> (erased (Under xs k) r))
  (let-match erased u (UnderCons xs1 y _ ly u1) ((UnderNil _) (UnderNil k)))
  (let-match erased out (NotInCons _ _ _ ne out1))
  (UnderCons xs1 y k (match erased ne _ (absurd (ApLt _ _ _ _ l) (lt-asym k y l ly)) ((ApGt _ _ _ _ l) l)) (under-tighten xs1 k u1 out1)))

(def-fns _ $ (erased in-nth : (erased (Nat) x) (erased (List (Nat)) xs) (subterm erased (In x xs) p) -> (erased (Nat) j) (erased (Nth (Nat) xs j x) r))
  (let-match erased p (InThere _ y xs1 p1) ((InHere _ xs1) (values (Zero) (NthHere _ x xs1))))
  (let ((erased j) (erased q)) (in-nth x xs1 p1))
  (values (Succ j) (NthThere _ y xs1 j x q)))

(def-fns _ $ (erased unsnoc-under : (erased (Nat) d) (erased (List (Nat)) p q p0) (erased (Perm (Succ d) p q) pm) (erased (Nth (Nat) p d d) pd)
    (erased (Snoc (Nat) p0 d p) sp) (erased (Length (Nat) p0 d) lp0) -> (erased (Under p0 d) r))
  (let-match erased (in-dec d p0) (OrR _ _ out)
    (absurd (OrL _ _ pin)
      (let ((erased j) (erased pj)) (in-nth d p0 pin))
      (let-match erased (perm-inj (Succ d) j d d p q pm (snoc-old _ p0 p d d j sp pj) pd) (Refl _ _))
      (lt-irrefl j (nth-lt-length _ p0 j j j pj lp0))))
  (under-tighten p0 d (under-snoc p p0 d (Succ d) (perm-under (Succ d) p q pm) sp) out))

; A permutation fixing its last dart d is one on 0..d-1 with d added.
(def-fns _ $ (erased unsnoc-perm : (erased (Nat) d) (erased (List (Nat)) p q) (erased (Perm (Succ d) p q) pm) (erased (Nth (Nat) p d d) pd)
    -> (erased (List (Nat)) p0 q0) (erased (Snoc (Nat) p0 d p) sp) (erased (Snoc (Nat) q0 d q) sq) (erased (Perm d p0 q0) r))
  (let ((erased qd)) (perm-inv (Succ d) d d p q pm pd))
  (let ((erased qm)) (perm-sym (Succ d) p q pm))
  (let-match erased pm (MkPerm _ _ _ ids io lp qp pq))
  (let-match erased io (IotaS _ ids0 _ io0 si))
  (let ((erased lq)) (respects-length-inv p q ids (Succ d) pq (iota-length (Succ d) ids io)))
  (let ((erased p0) (erased x) (erased sp) (erased lp0)) (snoc-split _ p d lp))
  (let-match erased (nth-fn _ p d x d (snoc-new _ p0 p x d sp lp0) pd) (Refl _ _))
  (let ((erased q0) (erased y) (erased sq) (erased lq0)) (snoc-split _ q d lq))
  (let-match erased (nth-fn _ q d y d (snoc-new _ q0 q y d sq lq0) qd) (Refl _ _))
  (values p0 q0 sp sq (MkPerm d p0 q0 ids0 io0 lp0
    (unsnoc-respects q q0 p p0 ids ids0 d d d d qp sq sp si lq0 (unsnoc-under d p q p0 pm pd sp lp0))
    (unsnoc-respects p p0 q q0 ids ids0 d d d d pq sp sq si lp0 (unsnoc-under d q p q0 qm qd sq lq0)))))

(def-fns _ $ (erased unsnoc-orbits : (erased (Nat) d k) (erased (List (Nat)) p q) (erased (Perm (Succ d) p q) pm) (erased (Nth (Nat) p d d) pd)
    (erased (Orbits (Succ d) p k) ob) -> (erased (List (Nat)) p0 q0) (erased (Snoc (Nat) p0 d p) sp) (erased (Snoc (Nat) q0 d q) sq) (erased (Perm d p0 q0) pm0)
    (erased (Nat) k0) (erased (Eq (Nat) k (Succ k0)) e) (erased (Orbits d p0 k0) r))
  (let ((erased p0) (erased q0) (erased sp) (erased sq) (erased pm0)) (unsnoc-perm d p q pm pd))
  (let ((erased k0) (erased ob0)) (orbits-exists d p0 q0 pm0))
  (values p0 q0 sp sq pm0 k0 (orbits-unique (Succ d) k (Succ k0) p ob (orbits-fix d k0 p0 p ob0 sp)) ob0))

(def-fns _ $ (erased es-drop : (erased (Nat) kc d k1 k2 k3 g) (erased (EulerSum (Succ kc) (Succ d) (Succ k1) (Succ k2) (Succ k3) g) es)
    -> (erased (EulerSum kc d k1 k2 k3 g) r))
  (let ((erased r0) (erased lhs) (erased a0) (erased r1) (erased a1) (erased c2) (erased g2) (erased dc) (erased al) (erased dg) (erased ag))
    (es-split (Succ kc) (Succ d) k1 (Succ k2) k3 g es))
  (let ((erased s0) (erased e0) (erased b0)) (add-succ-right-inv k1 k2 r0 a0))
  (let-match erased e0 (Refl _ _))
  (let-match erased a1 (AddSucc _ _ t1 b1))
  (let-match erased dc (DS _ c0 dc0))
  (let-match erased al (AddSucc _ _ l1 al1))
  (let-match erased al1 (AddSucc _ _ l2 al2))
  (let ((erased l0) (erased e1) (erased al0)) (add-succ-right-inv c0 d l2 al2))
  (let-match erased e1 (Refl _ _))
  (let ((erased m2) (erased f2) (erased ag2)) (add-succ-right-inv g2 (Succ (Succ t1)) (Succ (Succ (Succ l0))) ag))
  (let-match erased f2 (Refl _ _))
  (let ((erased m1) (erased f1) (erased ag1)) (add-succ-right-inv g2 (Succ t1) (Succ (Succ l0)) ag2))
  (let-match erased f1 (Refl _ _))
  (let ((erased m0) (erased f0) (erased ag0)) (add-succ-right-inv g2 t1 (Succ l0) ag1))
  (let-match erased f0 (Refl _ _))
  (MkEulerSum kc d k1 k2 k3 g c0 l0 s0 t1 g2 dc0 al0 b0 b1 dg ag0))

; A hypermap whose last dart d is fixed by all three permutations is one on 0..d-1 with d added, of the same genus.
(def-fns _ $ (erased drop-last : (erased (Nat) d gen) (erased (List (Nat)) e n f) (erased (Hypermap (Succ d) e n f) h) (erased (Genus (Succ d) e n f gen) p)
    (erased (Nth (Nat) n d d) pnd) (erased (Nth (Nat) f d d) pfd)
    -> (erased (List (Nat)) e0 n0 f0) (erased (Snoc (Nat) e0 d e) se) (erased (Snoc (Nat) n0 d n) sn) (erased (Snoc (Nat) f0 d f) sf)
    (erased (Hypermap d e0 n0 f0) h0) (erased (Genus d e0 n0 f0 gen) p0))
  (let ((erased nf) (erased ni) (erased fi) (erased rnf) (erased pe) (erased pn) (erased pf) (erased kx) (erased kn) (erased kf) (erased kc)
      (erased ox) (erased on) (erased of) (erased gn) (erased gf) (erased g) (erased grn) (erased grf) (erased cg) (erased cs) (erased es))
    (genus-core (Succ d) gen e n f h p))
  (let ((erased lnf)) (respects-length n f nf (Succ d) rnf (perm-length (Succ d) f fi pf)))
  (let ((erased v) (erased pv)) (nth-exists _ nf (Succ d) d lnf (lt-succ d)))
  (let-match erased (nth-fn _ n d d v pnd (respects-nth n f nf d d v rnf pfd pv)) (Refl _ _))
  (let ((erased n0) (erased ni0) (erased sn) (erased _) (erased pn0) (erased kn0) (erased en) (erased on0)) (unsnoc-orbits d kn n ni pn pnd on))
  (let ((erased f0) (erased fi0) (erased sf) (erased _) (erased pf0) (erased kf0) (erased ef) (erased of0)) (unsnoc-orbits d kf f fi pf pfd of))
  (let ((erased nf0) (erased e0) (erased snf) (erased se) (erased px0) (erased kx0) (erased ex) (erased ox0))
    (unsnoc-orbits d kx nf e (perm-sym (Succ d) e nf pe) pv ox))
  (let-match erased en (Refl _ _))
  (let-match erased ef (Refl _ _))
  (let-match erased ex (Refl _ _))
  (let ((erased rnf0)) (unsnoc-respects n n0 f f0 nf nf0 d d d d rnf sn sf snf (perm-length d n0 ni0 pn0) (perm-under d f0 fi0 pf0)))
  (let ((erased e1) (erased h0)) (hyper-mk d n0 ni0 f0 fi0 pn0 pf0))
  (let ((erased c1) (erased _) (erased _) (erased rc1) (erased pe1) (erased _) (erased _)) (hyper-core d e1 n0 f0 h0))
  (let-match erased (respects-fn n0 f0 c1 nf0 rc1 rnf0) (Refl _ _))
  (let-match erased (perm-inv-unique d nf0 e1 e0 (perm-sym d e1 nf0 pe1) px0) (Refl _ _))
  (let ((erased gn0) (erased grn0)) (graph-exists d n0 (perm-length d n0 ni0 pn0)))
  (let ((erased gf0) (erased grf0)) (graph-exists d f0 (perm-length d f0 fi0 pf0)))
  (let ((erased g0) (erased cg0)) (cat-exists gn0 gf0))
  (let ((erased kc0) (erased cs0)) (classes-exists g0 d
    (below-cat gn0 gf0 g0 d cg0 (graph-below d n0 ni0 gn0 (graph-fun d n0 gn0 grn0) pn0) (graph-below d f0 fi0 gf0 (graph-fun d f0 gf0 grf0) pf0))))
  (let ((erased gn1) (erased sgn) (erased grn1)) (graph-snoc d d n0 n gn0 grn0 sn))
  (let-match erased (graph-fn (Succ d) n gn gn1 grn grn1) (Refl _ _))
  (let ((erased gf1) (erased sgf) (erased grf1)) (graph-snoc d d f0 f gf0 grf0 sf))
  (let-match erased (graph-fn (Succ d) f gf gf1 grf grf1) (Refl _ _))
  (let-match erased (classes-unique g (Succ d) kc (Succ kc0) cs (classes-equiv g0 g (Succ d) (Succ kc0) (classes-grow g0 d kc0 cs0)
      (spans-cat g gn0 gf0 g0 cg0 (spans-lift-l gn gf g gn0 (spans-snoc gn0 gn gn0 _ (spans-self gn0) sgn) cg)
        (spans-lift-r gn gf g gf0 (spans-snoc gf0 gf gf0 _ (spans-self gf0) sgf) cg))
      (spans-cat g0 gn gf g cg (spans-snoc-inv g0 gn0 gn d d sgn (spans-lift-l gn0 gf0 g0 gn0 (spans-self gn0) cg0) (ConnHere g0 d))
        (spans-snoc-inv g0 gf0 gf d d sgf (spans-lift-r gn0 gf0 g0 gf0 (spans-self gf0) cg0) (ConnHere g0 d)))
      (below-cat gn gf g (Succ d) cg (graph-below (Succ d) n ni gn (graph-fun (Succ d) n gn grn) pn)
        (graph-below (Succ d) f fi gf (graph-fun (Succ d) f gf grf) pf))))
    (Refl _ _))
  (values e0 n0 f0 se sn sf h0
    (core-genus d kx0 kn0 kf0 kc0 gen e0 n0 f0 nf0 ni0 fi0 gn0 gf0 g0 (perm-sym d nf0 e0 px0) rnf0 pn0 pf0 ox0 on0 of0 grn0 grf0 cg0 cs0
      (es-drop kc0 d kx0 kn0 kf0 gen es))))

(def-fns _ $ (erased upd2-fn : (erased (List (Nat)) p x y) (erased (Nat) a u b v) (erased (Upd2 p a u b v x) px) (erased (Upd2 p a u b v y) py)
    -> (erased (Eq (List (Nat)) x y) e))
  (let-match erased px (MkUpd2 _ p1 _ _ _ _ _ _ s1 s2))
  (let-match erased py (MkUpd2 _ q1 _ _ _ _ _ _ t1 t2))
  (let-match erased (setnth-fn _ p a u p1 q1 s1 t1) (Refl _ _))
  (setnth-fn _ p1 b v x y s2 t2))

(def-fns _ $ (erased upd2-sym : (erased (List (Nat)) p p2) (erased (Nat) a u b v d) (erased (Upd2 p a u b v p2) up) (erased (Length (Nat) p d) lp)
    -> (erased (Upd2 p b v a u p2) r))
  (let-match erased up (MkUpd2 _ p1 _ _ _ _ _ ne s1 s2))
  (let ((erased lp1)) (setnth-length _ p a d u p1 s1 lp))
  (let ((erased q1) (erased t1)) (setnth-exists _ p d b v lp (nth-lt-length _ p2 b d v (setnth-nth _ p1 b v p2 s2) (setnth-length _ p1 b d v p2 s2 lp1))))
  (MkUpd2 p q1 p2 b v a u (apart-sym a b ne) t1 (setnth-reorder p p1 p2 q1 a b u v s1 s2 t1 ne)))

; s exchanges z and y and fixes every other dart.
(def-adts $ (Swap : ((Nat) d z y) ((List (Nat)) s) -> Type)
  enum
  (many MkSwap : (erased (Nat) d z y) (erased (List (Nat)) s) (erased (Perm d s s) ps) (erased (Nth (Nat) s z y) pz) (erased (Nth (Nat) s y z) py)
      -> (Swap d z y s)))

(def-fns _ $ (erased swap-exists : (erased (Nat) d z y) (erased (Lt z d) lz) (erased (Lt y d) ly) -> (erased (List (Nat)) s) (erased (Swap d z y s) r))
  (let ((erased ids) (erased io)) (iota-exists d))
  (let ((erased pm)) (perm-id d ids io))
  (let ((erased li)) (iota-length d ids io))
  (let ((erased pz)) (iota-nth d z ids io lz))
  (let ((erased py)) (iota-nth d y ids io ly))
  (let-match erased (nat-eq z y) (Unequal _ _ _ _ ne) ((Equal _ _ _) (values ids (MkSwap d z z ids pm pz pz))))
  (let ((erased s) (erased up)) (upd2-exists ids z y y z d li lz ly ne))
  (let ((erased q) (erased uq) (erased ps)) (perm-swap d z y z y ids ids s pm pz py up))
  (let-match erased (upd2-fn ids q s z y y z (upd2-sym ids q y z z y d uq li) up) (Refl _ _))
  (values s (MkSwap d z y s ps (upd2-a ids s z y y z up) (upd2-b ids s z y y z up))))

(def-fns _ $ (erased conj-fix : (erased (Nat) d y z) (erased (List (Nat)) s si p p2) (erased (Conj s si p p2) cj) (erased (Perm d s si) pm)
    (erased (Nth (Nat) si y z) pyz) (erased (Nth (Nat) p z z) pz) (erased (Nth (Nat) s z y) pzy) -> (erased (Nth (Nat) p2 y y) r))
  (let ((erased lp2) (erased _)) (conj-size d s si p p2 pm cj))
  (let-match erased cj (MkConj _ _ _ t _ rt rp2))
  (let ((erased ly)) (nth-lt-length _ si y d z pyz (perm-length d si s (perm-sym d s si pm))))
  (let ((erased v) (erased pv)) (nth-exists _ t d y (respects-length p si t d rt (perm-length d si s (perm-sym d s si pm))) ly))
  (let-match erased (nth-fn _ p z z v pz (respects-nth p si t y z v rt pyz pv)) (Refl _ _))
  (let ((erased w) (erased pw)) (nth-exists _ p2 d y lp2 ly))
  (let-match erased (nth-fn _ s z y w pzy (respects-nth s t p2 y z w rp2 pv pw)) (Refl _ _))
  pw)

; p2 is p with z cut out, the darts renamed by the swap s of z and d, and d dropped.
(def-adts $ (Cut : ((Nat) d z) ((List (Nat)) s p p2) -> Type)
  enum
  (many MkCut : (erased (Nat) d z) (erased (List (Nat)) s p p1 pb p2) (erased (Skip p z p1) sk) (erased (Conj s s p1 pb) cj)
      (erased (Snoc (Nat) p2 d pb) sn) -> (Cut d z s p p2)))

; WalkupE: the dart z removed, node and face cut, on d darts, of genus at most that of the map.
(def-fns _ $ (erased walkup-e : (erased (Nat) d gen z) (erased (List (Nat)) e n f) (erased (Hypermap (Succ d) e n f) h)
    (erased (Genus (Succ d) e n f gen) p) (erased (Lt z (Succ d)) lz)
    -> (erased (List (Nat)) s e2 n2 f2) (erased (Nat) gen2) (erased (Swap (Succ d) z d s) sw) (erased (Cut d z s n n2) cn) (erased (Cut d z s f f2) cf)
    (erased (Hypermap d e2 n2 f2) h2) (erased (Genus d e2 n2 f2 gen2) p2) (erased (Lt gen2 (Succ gen)) le))
  (let ((erased e1) (erased n1) (erased f1) (erased gen1) (erased skn) (erased skf) (erased h1) (erased p1) (erased le)) (walkup-iso (Succ d) gen z e n f h p lz))
  (let ((erased s) (erased sw)) (swap-exists (Succ d) z d lz (lt-succ d)))
  (let-match erased sw (MkSwap _ _ _ _ ps psz psd))
  (let ((erased eb) (erased nb) (erased fb) (erased ce) (erased cnb) (erased cfb) (erased hb) (erased pb)) (genus-relabel (Succ d) gen1 e1 n1 f1 s s h1 p1 ps))
  (let ((erased e2) (erased n2) (erased f2) (erased se) (erased sn) (erased sf) (erased h2) (erased p2))
    (drop-last d gen1 eb nb fb hb pb (conj-fix (Succ d) d z s s n1 nb cnb ps psd (skip-fixed n n1 z skn) psz)
      (conj-fix (Succ d) d z s s f1 fb cfb ps psd (skip-fixed f f1 z skf) psz)))
  (values s e2 n2 f2 gen1 sw (MkCut d z s n n1 nb n2 skn cnb sn) (MkCut d z s f f1 fb f2 skf cfb sf) h2 p2 le))

(def-fns _ $ (erased lt-one : (erased (Nat) a) (erased (Lt a (Succ (Zero))) l) -> (erased (Eq (Nat) a (Zero)) e))
  (match erased l _ ((LtZ _) (Refl _ (Zero))) (absurd (LtS _ _ l1) l1)))

(def-fns _ $ (erased skip-conn-back : (erased (Nat) d x y z) (erased (List (Nat)) p p2) (erased (List (Bond)) g g2) (erased (Skip p z p2) sk)
    (erased (Graph d p g) gr) (erased (Graph d p2 g2) gr2) (erased (Conn g2 x y) c) -> (erased (Conn g x y) r))
  (let-match erased sk (SkipCut _ _ _ w u pw pz nwz up) ((SkipFixed _ _ _) (let-match erased (graph-fn d p g g2 gr gr2) (Refl _ _)) c))
  (spans-conn g g2 x y c (spans-upd d w u z z p p2 g g2 g (graph-fun d p2 g2 gr2) up gr (spans-self g)
    (conn-cat g w z u (conn-adj g w z (graph-adj d w z p g gr pw)) (conn-adj g z u (graph-adj d z u p g gr pz))) (ConnHere g z))))
