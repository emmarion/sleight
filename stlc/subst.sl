(def-fns _ $ (erased shift-ex : (erased (Nat) k) (subterm erased (Term) t) -> (erased (Term) u) (erased (Shift k t u) p))
  (match erased t _
    ((Var i) (let ((erased j) (erased p)) (skip-ex k i)) (values (Var j) (ShVar k i j p)))
    ((Lam b) (let ((erased c) (erased p)) (shift-ex (Succ k) b)) (values (Lam c) (ShLam k b c p)))
    ((App f a)
      (let ((erased g) (erased p)) (shift-ex k f))
      (let ((erased b) (erased q)) (shift-ex k a))
      (values (App g b) (ShApp k f g a b p q)))))

(def-fns _ $ (erased shift-det : (erased (Nat) k) (erased (Term) t u1 u2) (subterm erased (Shift k t u1) p) (erased (Shift k t u2) q)
    -> (erased (Eq (Term) u1 u2) e))
  (match erased p _
    ((ShVar _ i j1 p1)
      (let-match erased q (ShVar _ _ j2 q1))
      (let-match erased (skip-det k i j1 j2 p1 q1) (Refl _ _))
      (Refl _ u1))
    ((ShLam _ b c1 p1)
      (let-match erased q (ShLam _ _ c2 q1))
      (let-match erased (shift-det (Succ k) b c1 c2 p1 q1) (Refl _ _))
      (Refl _ u1))
    ((ShApp _ f g1 a b1 p1 p2)
      (let-match erased q (ShApp _ _ g2 _ b2 q1 q2))
      (let-match erased (shift-det k f g1 g2 p1 q1) (Refl _ _))
      (let-match erased (shift-det k a b1 b2 p2 q2) (Refl _ _))
      (Refl _ u1))))

(def-fns _ $ (erased sub-ex : (erased (Nat) k) (erased (Term) u) (subterm erased (Term) t) -> (erased (Term) r) (erased (Sub k u t r) p))
  (match erased t _
    ((Var j) (match erased (view k j) _
      ((VHit _) (values u (SubHit k u)))
      ((VMiss _ i _ p) (values (Var i) (SubMiss k u i j p)))))
    ((Lam b)
      (let ((erased u1) (erased s)) (shift-ex (Zero) u))
      (let ((erased c) (erased p)) (sub-ex (Succ k) u1 b))
      (values (Lam c) (SubLam k u u1 b c s p)))
    ((App f a)
      (let ((erased g) (erased p)) (sub-ex k u f))
      (let ((erased b) (erased q)) (sub-ex k u a))
      (values (App g b) (SubApp k u f g a b p q)))))

(def-fns _ $ (erased sub-det : (erased (Nat) k) (erased (Term) u t r1 r2) (subterm erased (Sub k u t r1) p) (erased (Sub k u t r2) q)
    -> (erased (Eq (Term) r1 r2) e))
  (match erased p _
    ((SubHit _ _)
      (match erased q _
        ((SubHit _ _) (Refl _ u))
        (absurd (SubMiss _ _ i _ s) (skip-ne k i s))))
    ((SubMiss _ _ i1 j p1)
      (let-match erased q (SubMiss _ _ i2 _ q1) (absurd (SubHit _ _) (skip-ne k i1 p1)))
      (let-match erased (skip-inj k i1 i2 j p1 q1) (Refl _ _))
      (Refl _ r1))
    ((SubLam _ _ u1 b c1 s1 p1)
      (let-match erased q (SubLam _ _ u2 _ c2 s2 q1))
      (let-match erased (shift-det (Zero) u u1 u2 s1 s2) (Refl _ _))
      (let-match erased (sub-det (Succ k) u1 b c1 c2 p1 q1) (Refl _ _))
      (Refl _ r1))
    ((SubApp _ _ f g1 a b1 p1 p2)
      (let-match erased q (SubApp _ _ _ g2 _ b2 q1 q2))
      (let-match erased (sub-det k u f g1 g2 p1 q1) (Refl _ _))
      (let-match erased (sub-det k u a b1 b2 p2 q2) (Refl _ _))
      (Refl _ r1))))

(def-fns _ $ (erased shift-shift : (erased (Nat) i c) (erased (Term) t t1 t2 t3) (subterm erased (Shift i t t1) p)
    (erased (Shift (Succ c) t1 t2) q) (erased (Shift c t t3) r) (erased (Lt i (Succ c)) lt) -> (erased (Shift i t3 t2) s))
  (match erased p _
    ((ShVar _ x y p1)
      (let-match erased q (ShVar _ _ z q1))
      (let-match erased r (ShVar _ _ w r1))
      (ShVar i w z (skip-comm i x y c z w p1 q1 r1 lt)))
    ((ShLam _ b b1 p1)
      (let-match erased q (ShLam _ _ b2 q1))
      (let-match erased r (ShLam _ _ b3 r1))
      (ShLam i b3 b2 (shift-shift (Succ i) (Succ c) b b1 b2 b3 p1 q1 r1 (LtS _ _ lt))))
    ((ShApp _ f f1 a a1 p1 p2)
      (let-match erased q (ShApp _ _ f2 _ a2 q1 q2))
      (let-match erased r (ShApp _ _ f3 _ a3 r1 r2))
      (ShApp i f3 f2 a3 a2 (shift-shift i c f f1 f2 f3 p1 q1 r1 lt) (shift-shift i c a a1 a2 a3 p2 q2 r2 lt)))))

(def-fns _ $ (erased shift-sub : (erased (Nat) j c) (erased (Term) u b r b1 u1) (subterm erased (Sub j u b r) p)
    (erased (Shift (Succ c) b b1) q) (erased (Shift c u u1) s) (erased (Lt j (Succ c)) lt)
    -> (erased (Term) r1) (erased (Shift c r r1) e) (erased (Sub j u1 b1 r1) f))
  (match erased p _
    ((SubHit _ _)
      (let-match erased q (ShVar _ _ j1 q1))
      (let-match erased (skip-det (Succ c) j j1 j q1 (skip-lt j (Succ c) lt)) (Refl _ _))
      (values u1 s (SubHit j u1)))
    ((SubMiss _ _ x y p1)
      (let-match erased q (ShVar _ _ z q1))
      (let ((erased w) (erased r1)) (skip-ex c x))
      (values (Var w) (ShVar c x w r1) (SubMiss j u1 w z (skip-comm j x y c z w p1 q1 r1 lt))))
    ((SubLam _ _ u2 b2 r2 s2 p1)
      (let-match erased q (ShLam _ _ b3 q1))
      (let ((erased u3) (erased s3)) (shift-ex (Succ c) u2))
      (let ((erased r3) (erased e1) (erased f1)) (shift-sub (Succ j) (Succ c) u2 b2 r2 b3 u3 p1 q1 s3 (LtS _ _ lt)))
      (values (Lam r3) (ShLam c r2 r3 e1)
        (SubLam j u1 u3 b3 r3 (shift-shift (Zero) c u u2 u3 u1 s2 s3 s (LtZ c)) f1)))
    ((SubApp _ _ f2 g2 a2 h2 p1 p2)
      (let-match erased q (ShApp _ _ f3 _ a3 q1 q2))
      (let ((erased g3) (erased e1) (erased f1)) (shift-sub j c u f2 g2 f3 u1 p1 q1 s lt))
      (let ((erased h3) (erased e2) (erased f4)) (shift-sub j c u a2 h2 a3 u1 p2 q2 s lt))
      (values (App g3 h3) (ShApp c g2 g3 h2 h3 e1 e2) (SubApp j u1 f3 g3 a3 h3 f1 f4)))))

(def-fns _ $ (erased shift-sub-lo : (erased (Nat) j c) (erased (Term) u b r uc bc rc) (subterm erased (Sub j u b r) p)
    (erased (Shift c u uc) s) (erased (Shift c b bc) q) (erased (Shift c r rc) e) (erased (Lt c (Succ j)) lt)
    -> (erased (Sub (Succ j) uc bc rc) f))
  (match erased p _
    ((SubHit _ _)
      (let-match erased q (ShVar _ _ j1 q1))
      (let-match erased (skip-det c j j1 (Succ j) q1 (skip-ge c j lt)) (Refl _ _))
      (let-match erased (shift-det c u uc rc s e) (Refl _ _))
      (SubHit (Succ j) uc))
    ((SubMiss _ _ x y p1)
      (let-match erased q (ShVar _ _ y1 q1))
      (let-match erased e (ShVar _ _ x1 e1))
      (let ((erased z) (erased z1)) (skip-ex (Succ j) x1))
      (let-match erased (skip-det c y z y1 (skip-comm c x x1 j z y e1 z1 p1 lt) q1) (Refl _ _))
      (SubMiss (Succ j) uc x1 y1 z1))
    ((SubLam _ _ u0 b0 r0 s0 p1)
      (let-match erased q (ShLam _ _ b1 q1))
      (let-match erased e (ShLam _ _ r1 e1))
      (let ((erased u1) (erased s1)) (shift-ex (Succ c) u0))
      (SubLam (Succ j) uc u1 b1 r1 (shift-shift (Zero) c u u0 u1 uc s0 s1 s (LtZ c))
        (shift-sub-lo (Succ j) (Succ c) u0 b0 r0 u1 b1 r1 p1 s1 q1 e1 (LtS _ _ lt))))
    ((SubApp _ _ f0 g0 a0 h0 p1 p2)
      (let-match erased q (ShApp _ _ f1 _ a1 q1 q2))
      (let-match erased e (ShApp _ _ g1 _ h1 e1 e2))
      (SubApp (Succ j) uc f1 g1 a1 h1 (shift-sub-lo j c u f0 g0 uc f1 g1 p1 s q1 e1 lt)
        (shift-sub-lo j c u a0 h0 uc a1 h1 p2 s q2 e2 lt)))))

(def-fns _ $ (erased sub-shift : (erased (Nat) j) (erased (Term) s sj u) (subterm erased (Shift j s sj) p) -> (erased (Sub j u sj s) q))
  (match erased p _
    ((ShVar _ w z p1) (SubMiss j u w z p1))
    ((ShLam _ b b1 p1)
      (let ((erased u1) (erased s1)) (shift-ex (Zero) u))
      (SubLam j u u1 b1 b s1 (sub-shift (Succ j) b b1 u1 p1)))
    ((ShApp _ f f1 a a1 p1 p2) (SubApp j u f1 f a1 a (sub-shift j f f1 u p1) (sub-shift j a a1 u p2)))))

(def-fns _ $ (erased sub-sub : (erased (Nat) j x) (erased (Term) u b r s sj b1 u1) (subterm erased (Sub j u b r) p)
    (erased (Shift j s sj) h) (erased (Sub (Succ x) sj b b1) q) (erased (Sub x s u u1) e) (erased (Lt j (Succ x)) lt)
    -> (erased (Term) r1) (erased (Sub x s r r1) f) (erased (Sub j u1 b1 r1) g))
  (match erased p _
    ((SubHit _ _)
      (let-match erased q (SubMiss _ _ j0 _ q1) (absurd (SubHit _ _) (lt-irrefl _ lt)))
      (let-match erased (skip-inj (Succ x) j0 j j q1 (skip-lt j (Succ x) lt)) (Refl _ _))
      (values u1 e (SubHit j u1)))
    ((SubMiss _ _ z y p1)
      (match erased q _
        ((SubHit _ _)
          (let-match erased (skip-inj j z x (Succ x) p1 (skip-ge j x lt)) (Refl _ _))
          (values s (SubHit x s) (sub-shift j s sj u1 h)))
        ((SubMiss _ _ y0 _ q1)
          (let-match erased (view x z) (VMiss _ w _ v)
            (absurd (VHit _)
              (let-match erased (skip-det j x y (Succ x) p1 (skip-ge j x lt)) (Refl _ _))
              (skip-ne (Succ x) y0 q1)))
          (let ((erased y1) (erased a1)) (skip-ex j w))
          (let ((erased z2) (erased a2)) (skip-ex (Succ x) y1))
          (let-match erased (skip-det j z z2 y (skip-comm j w y1 x z2 z a1 a2 v lt) p1) (Refl _ _))
          (let-match erased (skip-inj (Succ x) y1 y0 y a2 q1) (Refl _ _))
          (values (Var w) (SubMiss x s w z v) (SubMiss j u1 w y0 a1)))))
    ((SubLam _ _ u2 b2 r2 s2 p1)
      (let-match erased q (SubLam _ _ sj2 _ b3 h2 q1))
      (let ((erased s3) (erased h3)) (shift-ex (Zero) s))
      (let ((erased t2) (erased h4)) (shift-ex (Succ j) s3))
      (let-match erased (shift-det (Zero) sj sj2 t2 h2 (shift-shift (Zero) j s s3 t2 sj h3 h4 h (LtZ j))) (Refl _ _))
      (let ((erased u3) (erased e3)) (shift-ex (Zero) u1))
      (let ((erased r3) (erased f1) (erased g1))
        (sub-sub (Succ j) (Succ x) u2 b2 r2 s3 sj2 b3 u3 p1 h4 q1
          (shift-sub-lo x (Zero) s u u1 s3 u2 u3 e h3 s2 e3 (LtZ x)) (LtS _ _ lt)))
      (values (Lam r3) (SubLam x s s3 r2 r3 h3 f1) (SubLam j u1 u3 b3 r3 e3 g1)))
    ((SubApp _ _ f2 g2 a2 c2 p1 p2)
      (let-match erased q (SubApp _ _ _ f3 _ a3 q1 q2))
      (let ((erased g3) (erased f1) (erased g1)) (sub-sub j x u f2 g2 s sj f3 u1 p1 h q1 e lt))
      (let ((erased c3) (erased f4) (erased g4)) (sub-sub j x u a2 c2 s sj a3 u1 p2 h q2 e lt))
      (values (App g3 c3) (SubApp x s g2 g3 c2 c3 f1 f4) (SubApp j u1 f3 g3 a3 c3 g1 g4)))))
