(def-fns _ $ (erased lam-walk : (erased (Term) b) (subterm erased (Sn b) d) (subterm erased (List (Term)) ls) (erased (AllStep (Lam b) ls) al)
    -> (erased (AllSn ls) e))
  (let-match erased ls (Cons _ x rest) ((Nil _) (ASNil)))
  (let-match erased al (ATCons _ _ _ s al1))
  (let-match erased s (StLam _ b1 s1))
  (let ((erased d1) (erased p)) (sn-step b b1 d s1))
  (let ((erased ls1) (erased r1)) (reducts-ex x))
  (ASCons x rest (MkSn x ls1 r1 (lam-walk b1 (subterm p) d1 ls1 (reducts-sound x ls1 r1))) (lam-walk b d rest al1)))

(def-fns _ $ (erased ne-walk : (erased (Term) m u) (erased (Neutral m) ne) (subterm erased (Sn m) dm) (subterm erased (Sn u) du)
    (subterm erased (List (Term)) ls) (erased (AllStep (App m u) ls) al) -> (erased (AllSn ls) e))
  (let-match erased ls (Cons _ x rest) ((Nil _) (ASNil)))
  (let-match erased al (ATCons _ _ _ s al1))
  (let ((erased ls1) (erased r1)) (reducts-ex x))
  (let ((erased al2)) (reducts-sound x ls1 r1))
  (let ((erased dx))
    (match erased s (((Sn x) dx))
      (absurd (StBeta _ _ _ _) ne)
      ((StAppL _ m1 _ s1)
        (let ((erased dm1) (erased p)) (sn-step m m1 dm s1))
        (MkSn x ls1 r1 (ne-walk m1 u (ne-step m m1 ne s1) (subterm p) dm1 du ls1 al2)))
      ((StAppR _ _ u1 s1)
        (let ((erased du1) (erased p)) (sn-step u u1 du s1))
        (MkSn x ls1 r1 (ne-walk m u1 ne dm (subterm p) du1 ls1 al2)))))
  (ASCons x rest dx (ne-walk m u ne dm du rest al1)))

(def-fns _ $ (erased exp-walk : (erased (Term) t r u) (erased (HeadRed t r u) hr) (subterm erased (Sn u) du) (subterm erased (Sn r) dr)
    (subterm erased (List (Term)) ls) (erased (AllStep t ls) al) -> (erased (AllSn ls) e))
  (let-match erased ls (Cons _ x rest) ((Nil _) (ASNil)))
  (let-match erased al (ATCons _ _ _ s al1))
  (let ((erased ls1) (erased r1)) (reducts-ex x))
  (let ((erased al2)) (reducts-sound x ls1 r1))
  (let ((erased dx))
    (match erased (head-step t r u x hr s) (((Sn x) dx))
      ((HSHead _ _) dr)
      ((HSIn _ _ _ r2 hr1 s1)
        (let ((erased dr1) (erased p)) (sn-step r r2 dr s1))
        (MkSn x ls1 r1 (exp-walk x r2 u hr1 du (subterm p) dr1 ls1 al2)))
      ((HSArg _ _ _ u1 r2 s1 hr1 ss)
        (let ((erased du1) (erased p)) (sn-step u u1 du s1))
        (MkSn x ls1 r1 (exp-walk x r2 u1 hr1 (subterm p) du1 (sn-steps r r2 dr ss) ls1 al2)))))
  (ASCons x rest dx (exp-walk t r u hr du dr rest al1)))

(def-fns _ $ (erased sn-intro-lam : (erased (Term) b) (erased (Sn b) d) -> (erased (Sn (Lam b)) e))
  (let ((erased ls) (erased r)) (reducts-ex (Lam b)))
  (MkSn (Lam b) ls r (lam-walk b d ls (reducts-sound (Lam b) ls r))))

(def-fns _ $ (erased sn-intro-ne : (erased (Term) m u) (erased (Neutral m) ne) (erased (Sn m) dm) (erased (Sn u) du) -> (erased (Sn (App m u)) e))
  (let ((erased ls) (erased r)) (reducts-ex (App m u)))
  (MkSn (App m u) ls r (ne-walk m u ne dm du ls (reducts-sound (App m u) ls r))))

(def-fns _ $ (erased sn-intro-exp : (erased (Term) t r u) (erased (HeadRed t r u) hr) (erased (Sn u) du) (erased (Sn r) dr) -> (erased (Sn t) e))
  (let ((erased ls) (erased rd)) (reducts-ex t))
  (MkSn t ls rd (exp-walk t r u hr du dr ls (reducts-sound t ls rd))))

(def-fns _
  ((erased sn-of : (erased (List (Ty)) g) (erased (Term) t) (erased (Ty) a) (subterm erased (SN g t a) d) -> (erased (Sn t) e))
    (match erased d _
      ((SNNe _ _ _ p) (let ((erased _) (erased e)) (ne-of g t a p)) e)
      ((SNLam _ b a1 c p) (sn-intro-lam b (sn-of (Cons _ a1 g) b c p)))
      ((SNExp _ _ r _ p q)
        (let ((erased u) (erased du) (erased hr)) (red-of g t r a p))
        (sn-intro-exp t r u hr du (sn-of g r a q)))))
  ((erased ne-of : (erased (List (Ty)) g) (erased (Term) t) (erased (Ty) a) (subterm erased (SNe g t a) d)
      -> (erased (Neutral t) ne) (erased (Sn t) e))
    (match erased d _
      ((NeVar _ i _ _) (values (NeV i) (MkSn t (Nil _) (RVar i) (ASNil))))
      ((NeApp _ n u a1 _ p q)
        (let ((erased ne) (erased dn)) (ne-of g n (Arr a1 a) p))
        (values (NeA n u ne) (sn-intro-ne n u ne dn (sn-of g u a1 q))))))
  ((erased red-of : (erased (List (Ty)) g) (erased (Term) t r) (erased (Ty) a) (subterm erased (SNRed g t r a) d)
      -> (erased (Term) u) (erased (Sn u) du) (erased (HeadRed t r u) hr))
    (match erased d _
      ((RdBeta _ b u _ a1 _ p q) (values u (sn-of g u a1 p) (HRBeta b u r q)))
      ((RdApp _ t0 r0 w a1 _ p)
        (let ((erased u) (erased du) (erased hr)) (red-of g t0 r0 (Arr a1 a) p))
        (values u du (HRApp t0 r0 w u hr))))))

(def-fns _
  ((erased typed-normalizes : (erased (List (Ty)) g) (erased (Term) t) (erased (Ty) a) (erased (Typed g t a) h) -> (erased (Sn t) d))
    (sn-of g t a (typed-sn g t a h)))
  ((erased sn-reduct : (erased (Term) t u) (erased (Sn t) d) (erased (Step t u) s) -> (erased (Sn u) e) (erased (Subterm (Sn u) e (Sn t) d) p))
    (sn-step t u d s)))
