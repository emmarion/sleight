(def-adts $ (MemIdx : ((List (Ty)) g) ((Ty) a) ((Mem g a) m) ((Nat) i) -> Type)
  enum
  (many MIHere : (erased (List (Ty)) g) (erased (Ty) a) -> (MemIdx (Cons (Ty) a g) a (Here g a) (Zero)))
  (many MIThere : (erased (List (Ty)) g) (erased (Ty) a b) (erased (Mem g a) m) (erased (Nat) i) (erased (MemIdx g a m i) p)
     -> (MemIdx (Cons (Ty) b g) a (There g a b m) (Succ i))))

(def-adts $ (InsIdx : ((Ty) b) ((List (Ty)) g h) ((Insert b g h) i) ((Nat) k) -> Type)
  enum
  (many IIHere : (erased (Ty) b) (erased (List (Ty)) g) -> (InsIdx b g (Cons (Ty) b g) (InsertHere b g) (Zero)))
  (many IIThere : (erased (Ty) b c) (erased (List (Ty)) g h) (erased (Insert b g h) i) (erased (Nat) k) (erased (InsIdx b g h i k) p)
     -> (InsIdx b (Cons (Ty) c g) (Cons (Ty) c h) (InsertThere b c g h i) (Succ k))))

(def-adts $ (Erase : ((List (Ty)) g) ((Ty) a) ((Term g a) t) ((CTerm) e) -> Type)
  enum
  (many EVar : (erased (List (Ty)) g) (erased (Ty) a) (erased (Mem g a) m) (erased (Nat) i) (erased (MemIdx g a m i) p)
     -> (Erase g a (Var g a m) (CVar i)))
  (many ELam : (erased (List (Ty)) g) (erased (Ty) a b) (erased (Term (Cons (Ty) a g) b) t) (erased (CTerm) e)
     (erased (Erase (Cons (Ty) a g) b t e) p) -> (Erase g (Arr a b) (Lam g a b t) (CLam e)))
  (many EApp : (erased (List (Ty)) g) (erased (Ty) a b) (erased (Term g (Arr a b)) f) (erased (Term g a) x) (erased (CTerm) ef ex)
     (erased (Erase g (Arr a b) f ef) p) (erased (Erase g a x ex) q) -> (Erase g b (App g a b f x) (CApp ef ex))))

(def-fns _ $ (erased memidx-ex : (erased (List (Ty)) g) (erased (Ty) a) (subterm erased (Mem g a) m) -> (erased (Nat) i) (erased (MemIdx g a m i) p))
  (match erased m _
    ((Here g1 _) (values (Zero) (MIHere g1 a)))
    ((There g1 _ b m1) (let ((erased i) (erased p)) (memidx-ex g1 a m1)) (values (Succ i) (MIThere g1 a b m1 i p)))))

(def-fns _ $ (erased memidx-det : (erased (List (Ty)) g) (erased (Ty) a) (erased (Mem g a) m) (erased (Nat) i j)
    (subterm erased (MemIdx g a m i) p) (erased (MemIdx g a m j) q) -> (erased (Eq (Nat) i j) e))
  (match erased p _
    ((MIHere _ _) (let-match erased q (MIHere _ _)) (Refl _ i))
    ((MIThere g1 _ b m1 i1 p1)
      (let-match erased q (MIThere _ _ _ _ j1 q1))
      (eq-cong-succ i1 j1 (memidx-det g1 a m1 i1 j1 p1 q1)))))

(def-fns _ $ (erased memidx-nth : (erased (List (Ty)) g) (erased (Ty) a) (erased (Mem g a) m) (erased (Nat) i) (subterm erased (MemIdx g a m i) p)
    -> (erased (Nth (Ty) g i a) n))
  (match erased p _
    ((MIHere g1 _) (NthHere _ a g1))
    ((MIThere g1 _ b m1 i1 p1) (NthThere _ b g1 i1 a (memidx-nth g1 a m1 i1 p1)))))

(def-fns _ $ (erased insidx-ex : (erased (Ty) b) (erased (List (Ty)) g h) (subterm erased (Insert b g h) i) -> (erased (Nat) k) (erased (InsIdx b g h i k) p))
  (match erased i _
    ((InsertHere _ _) (values (Zero) (IIHere b g)))
    ((InsertThere _ c g1 h1 i1) (let ((erased k) (erased p)) (insidx-ex b g1 h1 i1)) (values (Succ k) (IIThere b c g1 h1 i1 k p)))))

(def-fns _ $ (erased hole-idx : (erased (Ty) b) (erased (List (Ty)) g h) (erased (Insert b g h) i) (erased (Mem h b) m) (subterm erased (Hole b g h i m) p)
    (erased (Nat) k) (erased (InsIdx b g h i k) q) -> (erased (MemIdx h b m k) r))
  (match erased p _
    ((HoleHere _ _) (let-match erased q (IIHere _ _)) (MIHere g b))
    ((HoleThere _ c g1 h1 i1 m1 p1)
      (let-match erased q (IIThere _ _ _ _ _ k1 q1))
      (MIThere h1 b c m1 k1 (hole-idx b g1 h1 i1 m1 p1 k1 q1)))))

(def-fns _ $ (erased varshift-idx : (erased (Ty) b) (erased (List (Ty)) g h) (erased (Insert b g h) i) (erased (Ty) a) (erased (Mem g a) m) (erased (Mem h a) n)
    (subterm erased (VarShift b g h i a m n) p) (erased (Nat) k) (erased (InsIdx b g h i k) q) (erased (Nat) x) (erased (MemIdx g a m x) mx)
    -> (erased (Nat) y) (erased (MemIdx h a n y) my) (erased (Skip k x y) s))
  (match erased p _
    ((VarShiftHere _ _ _ _)
      (let-match erased q (IIHere _ _))
      (values (Succ x) (MIThere g a b m x mx) (SkipZ x)))
    ((VarShiftTop _ _ g1 h1 _)
      (let-match erased q (IIThere _ _ _ _ _ k1 _))
      (let-match erased mx (MIHere _ _))
      (values (Zero) (MIHere h1 a) (SkipLo k1)))
    ((VarShiftDown _ c g1 h1 i1 _ m1 n1 p1)
      (let-match erased q (IIThere _ _ _ _ _ k1 q1))
      (let-match erased mx (MIThere _ _ _ _ x1 mx1))
      (let ((erased y1) (erased my1) (erased s1)) (varshift-idx b g1 h1 i1 a m1 n1 p1 k1 q1 x1 mx1))
      (values (Succ y1) (MIThere h1 a c n1 y1 my1) (SkipHi k1 x1 y1 s1)))))

(def-fns _ $ (erased erase-ex : (erased (List (Ty)) g) (erased (Ty) a) (subterm erased (Term g a) t) -> (erased (CTerm) e) (erased (Erase g a t e) p))
  (match erased t _
    ((Var _ _ m) (let ((erased i) (erased p)) (memidx-ex g a m)) (values (CVar i) (EVar g a m i p)))
    ((Lam _ a1 b1 t1) (let ((erased e) (erased p)) (erase-ex (Cons _ a1 g) b1 t1)) (values (CLam e) (ELam g a1 b1 t1 e p)))
    ((App _ a1 _ f x)
      (let ((erased ef) (erased p)) (erase-ex g (Arr a1 a) f))
      (let ((erased ex) (erased q)) (erase-ex g a1 x))
      (values (CApp ef ex) (EApp g a1 a f x ef ex p q)))))

(def-fns _ $ (erased erase-typed : (erased (List (Ty)) g) (erased (Ty) a) (erased (Term g a) t) (erased (CTerm) e) (subterm erased (Erase g a t e) p)
    -> (erased (Typed g e a) h))
  (match erased p _
    ((EVar _ _ m i q) (TyVar g i a (memidx-nth g a m i q)))
    ((ELam _ a1 b1 t1 e1 q) (TyLam g e1 a1 b1 (erase-typed (Cons _ a1 g) b1 t1 e1 q)))
    ((EApp _ a1 _ f x ef ex q1 q2) (TyApp g ef ex a1 a (erase-typed g (Arr a1 a) f ef q1) (erase-typed g a1 x ex q2)))))

(def-fns _ $ (erased weaken-sim : (erased (Ty) b) (erased (List (Ty)) g h) (erased (Insert b g h) i) (erased (Ty) a) (erased (Term g a) t) (erased (Term h a) u)
    (subterm erased (Weaken b g h i a t u) w) (erased (Nat) k) (erased (InsIdx b g h i k) q) (erased (CTerm) e) (erased (Erase g a t e) er)
    -> (erased (CTerm) e2) (erased (Erase h a u e2) er2) (erased (Shift k e e2) sh))
  (match erased w _
    ((WeakenVar _ _ _ _ _ m n p)
      (let-match erased er (EVar _ _ _ x mx))
      (let ((erased y) (erased my) (erased s)) (varshift-idx b g h i a m n p k q x mx))
      (values (CVar y) (EVar h a n y my) (ShVar k x y s)))
    ((WeakenLam _ _ _ _ c a1 t1 u1 p)
      (let-match erased er (ELam _ _ _ _ e1 er1))
      (let ((erased e2) (erased er2) (erased sh))
        (weaken-sim b (Cons _ c g) (Cons _ c h) (InsertThere b c g h i) a1 t1 u1 p (Succ k) (IIThere b c g h i k q) e1 er1))
      (values (CLam e2) (ELam h c a1 u1 e2 er2) (ShLam k e1 e2 sh)))
    ((WeakenApp _ _ _ _ c _ f f2 x x2 p1 p2)
      (let-match erased er (EApp _ _ _ _ _ ef ex er1 er2))
      (let ((erased ef2) (erased erf) (erased sf)) (weaken-sim b g h i (Arr c a) f f2 p1 k q ef er1))
      (let ((erased ex2) (erased erx) (erased sx)) (weaken-sim b g h i c x x2 p2 k q ex er2))
      (values (CApp ef2 ex2) (EApp h c a f2 x2 ef2 ex2 erf erx) (ShApp k ef ef2 ex ex2 sf sx)))))

(def-fns _ $ (erased subst-sim : (erased (Ty) b) (erased (List (Ty)) g h) (erased (Insert b g h) i) (erased (Term g b) u) (erased (Ty) a)
    (erased (Term h a) t) (erased (Term g a) r) (subterm erased (Subst b g h i u a t r) sb) (erased (Nat) k) (erased (InsIdx b g h i k) q)
    (erased (CTerm) eu) (erased (Erase g b u eu) eru) (erased (CTerm) e) (erased (Erase h a t e) er)
    -> (erased (CTerm) e2) (erased (Erase g a r e2) er2) (erased (Sub k eu e e2) s))
  (match erased sb _
    ((SubstHit _ _ _ _ _ m p)
      (let-match erased er (EVar _ _ _ x mx))
      (let-match erased (memidx-det h b m x k mx (hole-idx b g h i m p k q)) (Refl _ _))
      (values eu eru (SubHit k eu)))
    ((SubstMiss _ _ _ _ _ _ m n p)
      (let-match erased er (EVar _ _ _ y my))
      (let ((erased x) (erased mx)) (memidx-ex g a m))
      (let ((erased y1) (erased my1) (erased s)) (varshift-idx b g h i a m n p k q x mx))
      (let-match erased (memidx-det h a n y1 y my1 my) (Refl _ _))
      (values (CVar x) (EVar g a m x mx) (SubMiss k eu x y s)))
    ((SubstLam _ _ _ _ _ c a1 u1 t1 r1 w p)
      (let-match erased er (ELam _ _ _ _ e1 er1))
      (let ((erased eu1) (erased eru1) (erased sh)) (weaken-sim c g (Cons _ c g) (InsertHere c g) b u u1 w (Zero) (IIHere c g) eu eru))
      (let ((erased e2) (erased er2) (erased s))
        (subst-sim b (Cons _ c g) (Cons _ c h) (InsertThere b c g h i) u1 a1 t1 r1 p (Succ k) (IIThere b c g h i k q) eu1 eru1 e1 er1))
      (values (CLam e2) (ELam g c a1 r1 e2 er2) (SubLam k eu eu1 e1 e2 sh s)))
    ((SubstApp _ _ _ _ _ c _ f f2 x x2 p1 p2)
      (let-match erased er (EApp _ _ _ _ _ ef ex er1 er2))
      (let ((erased ef2) (erased erf) (erased sf)) (subst-sim b g h i u (Arr c a) f f2 p1 k q eu eru ef er1))
      (let ((erased ex2) (erased erx) (erased sx)) (subst-sim b g h i u c x x2 p2 k q eu eru ex er2))
      (values (CApp ef2 ex2) (EApp g c a f2 x2 ef2 ex2 erf erx) (SubApp k eu ef ef2 ex ex2 sf sx)))))

(def-fns _ $ (erased step-sim : (erased (List (Ty)) g) (erased (Ty) a) (erased (Term g a) t u) (subterm erased (OneStep g a t u) st)
    (erased (CTerm) e) (erased (Erase g a t e) er) -> (erased (CTerm) e2) (erased (Erase g a u e2) er2) (erased (Step e e2) s))
  (match erased st _
    ((StepBeta _ a1 _ body u1 _ p)
      (let-match erased er (EApp _ _ _ _ _ el eu erl eru))
      (let-match erased erl (ELam _ _ _ _ eb erb))
      (let ((erased e2) (erased er2) (erased s)) (subst-sim a1 g (Cons _ a1 g) (InsertHere a1 g) u1 a body u p (Zero) (IIHere a1 g) eu eru eb erb))
      (values e2 er2 (StBeta eb eu e2 s)))
    ((StepLam _ a1 b1 t1 u1 p)
      (let-match erased er (ELam _ _ _ _ e1 er1))
      (let ((erased e2) (erased er2) (erased s)) (step-sim (Cons _ a1 g) b1 t1 u1 p e1 er1))
      (values (CLam e2) (ELam g a1 b1 u1 e2 er2) (StLam e1 e2 s)))
    ((StepFun _ a1 _ f f2 x p)
      (let-match erased er (EApp _ _ _ _ _ ef ex erf erx))
      (let ((erased ef2) (erased erf2) (erased s)) (step-sim g (Arr a1 a) f f2 p ef erf))
      (values (CApp ef2 ex) (EApp g a1 a f2 x ef2 ex erf2 erx) (StAppL ef ef2 ex s)))
    ((StepArg _ a1 _ f x x2 p)
      (let-match erased er (EApp _ _ _ _ _ ef ex erf erx))
      (let ((erased ex2) (erased erx2) (erased s)) (step-sim g a1 x x2 p ex erx))
      (values (CApp ef ex2) (EApp g a1 a f x2 ef ex2 erf erx2) (StAppR ef ex ex2 s)))))

(def-adts
  ((Height : ((CTerm) e) ((Sn e) d) ((Nat) n) -> Type)
    enum
    (many HeightMk : (erased (CTerm) e) (erased (List (CTerm)) ls) (erased (Reducts e ls) r) (erased (AllSn ls) a) (erased (Nat) m)
       (erased (AllHeight ls a m) h) -> (Height e (MkSn e ls r a) (Succ m))))
  ((AllHeight : ((List (CTerm)) ls) ((AllSn ls) a) ((Nat) m) -> Type)
    enum
    (many AHNil : -> (AllHeight (Nil (CTerm)) (ASNil) (Zero)))
    (many AHCons : (erased (CTerm) x) (erased (List (CTerm)) xs) (erased (Sn x) dx) (erased (AllSn xs) a) (erased (Nat) h m k)
       (erased (Height x dx h) p) (erased (AllHeight xs a m) q) (erased (Add h m k) s)
       -> (AllHeight (Cons (CTerm) x xs) (ASCons x xs dx a) k))))

(def-fns _
  ((erased height-ex : (erased (CTerm) e) (subterm erased (Sn e) d) -> (erased (Nat) n) (erased (Height e d n) h))
    (let-match erased d (MkSn _ ls r a))
    (let ((erased m) (erased h)) (all-height-ex ls a))
    (values (Succ m) (HeightMk e ls r a m h)))
  ((erased all-height-ex : (erased (List (CTerm)) ls) (subterm erased (AllSn ls) a) -> (erased (Nat) m) (erased (AllHeight ls a m) h))
    (match erased a _
      ((ASNil) (values (Zero) (AHNil)))
      ((ASCons x xs dx a1)
        (let ((erased h) (erased p)) (height-ex x dx))
        (let ((erased m) (erased q)) (all-height-ex xs a1))
        (let ((erased k) (erased s)) (add h m))
        (values k (AHCons x xs dx a1 h m k p q s))))))

(def-fns _ $ (erased all-height-get : (erased (List (CTerm)) ls) (erased (AllSn ls) a) (erased (Nat) m) (erased (AllHeight ls a m) ah)
    (erased (Nat) i) (erased (CTerm) x) (subterm erased (Nth (CTerm) ls i x) n)
    -> (erased (Sn x) d) (erased (Nat) h) (erased (Height x d h) p) (erased (Lt h (Succ m)) lt))
  (match erased n _
    ((NthHere _ _ _)
      (let-match erased ah (AHCons _ _ dx _ h m1 _ p _ s))
      (values dx h p (add-le-left h m1 m s)))
    ((NthThere _ _ xs i1 _ n1)
      (let-match erased ah (AHCons _ _ _ a1 h m1 _ _ q s))
      (let ((erased d) (erased h1) (erased p1) (erased lt)) (all-height-get xs a1 m1 q i1 x n1))
      (values d h1 p1 (lt-le-trans h1 (Succ m1) (Succ m) lt (LtS m1 (Succ m) (add-le-right h m1 m s)))))))

(def-fns _ $ (erased height-step : (erased (CTerm) e e2) (erased (Sn e) d) (erased (Nat) n) (erased (Height e d n) h) (erased (Step e e2) s)
    -> (erased (Sn e2) d2) (erased (Nat) n2) (erased (Height e2 d2 n2) h2) (erased (Lt n2 n) lt))
  (let-match erased h (HeightMk _ ls r a m ah))
  (let ((erased i) (erased nth)) (reducts-complete e e2 ls r s))
  (all-height-get ls a m ah i e2 nth))

(def-fns _ $ (erased reduction-bound : (erased (List (Ty)) g) (erased (Ty) a) (erased (Nat) k) (erased (Term g a) t u) (subterm erased (Reduction g a k t u) rd)
    (erased (CTerm) e) (erased (Erase g a t e) er) (erased (Sn e) d) (erased (Nat) n) (erased (Height e d n) h) -> (erased (NatLe k n) le))
  (match erased rd _
    ((Done _ _ _) (MkNatLe (Zero) n (LtZ n)))
    ((Then _ _ k1 _ v _ p q)
      (let ((erased e2) (erased er2) (erased s)) (step-sim g a t v p e er))
      (let ((erased d2) (erased n2) (erased h2) (erased lt)) (height-step e e2 d n h s))
      (let-match erased (reduction-bound g a k1 v u q e2 er2 d2 n2 h2) (MkNatLe _ _ l))
      (MkNatLe k n (LtS k1 n (lt-le-trans k1 (Succ n2) n l (LtS n2 n lt)))))))
