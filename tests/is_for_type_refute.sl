(def-lvl L)
(def-fns _ $ (erased absurd fn-type-is : (erased (Eq Type (Fn L (erased Type A) -> (erased A r)) (Fn L (erased Type A) -> (erased A is r))) p) -> (erased (False) f))
  p)
(def-fns _ $ (erased absurd fn-is-type : (erased (Eq Type (Fn L (erased Type A) -> (erased A is r)) (Fn L (erased Type A) -> (erased A r))) p) -> (erased (False) f))
  p)
(def-fns _ $ (erased absurd fn-atoms : (erased Type X) (erased Type Y) (erased (Eq Type (Fn L -> (erased X r)) (Fn L -> (erased Y is r))) p) -> (erased (False) f))
  p)
(def-fns _ $ (erased absurd valctor-type-is : (erased (TyCtor -> Type) T)
    (erased (Eq Type (ValCtor (erased Type A) (erased A x) -> (T)) (ValCtor (erased Type S) (erased S is s) -> (T))) p) -> (erased (False) f))
  p)
(def-fns _ $ (erased absurd ctor-type-is : (erased (TyCtor -> Type) T)
    (erased (ValCtor (erased Type A) (erased A x) -> (T)) C)
    (erased (ValCtor (erased Type S) (erased S is s) -> (T)) D)
    (erased Type B) (erased B b)
    (erased (Eq (T) (C B b) (D B B)) p) -> (erased (False) f))
  p)
(def-fns _ $ (erased absurd ctor-is-type : (erased (TyCtor -> Type) T)
    (erased (ValCtor (erased Type A) (erased A x) -> (T)) C)
    (erased (ValCtor (erased Type S) (erased S is s) -> (T)) D)
    (erased Type B) (erased B b)
    (erased (Eq (T) (D B B) (C B b)) p) -> (erased (False) f))
  p)
