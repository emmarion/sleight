; expect: (Cons _ (MkPair _ _ (BTrue) 0) $ Cons _ (MkPair _ _ (BTrue) 1) $ Cons _ (MkPair _ _ (BFalse) 0) $ Cons _ (MkPair _ _ (BTrue) 2) $ Cons _ (MkPair _ _ (BFalse) 1) $ Cons _ (MkPair _ _ (BFalse) 99) $ Cons _ (MkPair _ _ (BFalse) 3) $ Cons _ (MkPair _ _ (BFalse) 1) $ Cons _ (MkPair _ _ (BFalse) 0) $ Nil _)
; needs: ../std/list
(def-adts $ (Box : -> Type) enum (many MkBox : (many (Nat) v) -> (Box)))

(def-fns _ $ (many tag : (erased Type A) (erased (List (SlotItem A)) xs) (erased (Slot) s) (erased (List (SlotItem A)) ys)
    (many (SlotIntern A xs s ys) r) -> (many (Pair (Bool) (Nat)) out))
  (match many r _ ((SlotExisting _ _ _ _ _ i _) (MkPair _ _ (BFalse) i)) ((SlotAdded _ _ _ _ _ i _) (MkPair _ _ (BTrue) i))))

(def-fns _ $ (many found : (erased Type A) (erased (List (SlotItem A)) xs) (erased (Slot) s) (erased Type U) (erased U u)
    (many (SlotFind A xs s U u) r) -> (many (Nat) out))
  (match many r _ ((SlotFound _ _ _ _ _ i _) i) ((SlotMissing _ _ _) 99)))

(def-adts $ (SuffixOf : (Type A) ((List A) xs) ((List A) ys) -> Type)
  enum
  (many SuffixOfRefl : (erased Type A) (erased (List A) xs) -> (SuffixOf A xs xs))
  (many SuffixOfCons : (erased Type A) (erased A y) (erased (List A) xs) (erased (List A) ys)
     (erased (SuffixOf A xs ys) p) -> (SuffixOf A xs (Cons A y ys))))

(def-fns _ $ (erased nth-last-suffix : (erased Type A) (erased (List A) xs) (erased (List A) ys) (erased (Nat) i) (erased A x)
    (erased (NthLast A xs i x) q) (subterm erased (SuffixOf A xs ys) p) -> (erased (NthLast A ys i x) r))
  (let-match erased p (SuffixOfCons _ y _ zs p1) ((SuffixOfRefl _ _) q))
  (NthLastThere _ y zs i x (nth-last-suffix _ xs zs i x q p1)))

(def-fns _ $ (many recover : (many (Box) a) (many (Box) c) (many (Box) b) -> (many (Box) r at a) (many (Nat) hit))
  (let ((unique t0)) (slots-new (Box)))
  (let ((erased _) (many r1) (unique t1)) (slots-intern _ _ t0 _ _ (place-at-many _ a)))
  (let-match many r1 (SlotAdded _ _ _ v1 p1 i n) (absurd (SlotExisting _ _ _ _ _ _ p) p))
  (let ((erased ys2) (many r2) (unique t2)) (slots-intern _ _ t1 _ _ (place-at-many _ c)))
  (let ((erased pa)) (match erased r2 (((NthLast (SlotItem (Box)) ys2 i (MkSlotItem (Box) (slot-of a) v1 p1)) pa))
    ((SlotExisting _ _ _ _ _ _ _) (NthLastHere _ _ _ i n))
    ((SlotAdded _ _ _ _ _ _ _) (nth-last-suffix _ _ _ i _ (NthLastHere _ _ _ i n) (SuffixOfCons _ _ _ _ (SuffixOfRefl _ _))))))
  (let ((erased _) (many _) (many f) (unique _)) (slots-find _ _ t2 (slot-of b)))
  (let-match many f (SlotFound _ _ _ _ _ j q) ((SlotMissing _ _ _) (values a 0)))
  (let-match many (nat-cmp i j) (CEq _ _ _) (else (values a 0)))
  (let-match erased (nth-last-fn _ _ i _ _ pa q) (Refl _ _))
  (values b 1))

(def-fns _ $ (many run : -> (many (List (Pair (Bool) (Nat))) out))
  (let ((many a)) (MkBox 1))
  (let ((many b)) (MkBox 2))
  (let ((many c)) (MkBox 1))
  (let ((many d)) (MkBox 3))
  (let ((unique t0)) (slots-new (Box)))
  (let ((erased _) (many r1) (unique t1)) (slots-intern _ _ t0 _ _ (place-at-many _ a)))
  (let ((erased _) (many r2) (unique t2)) (slots-intern _ _ t1 _ _ (place-at-many _ b)))
  (let ((erased _) (many r3) (unique t3)) (slots-intern _ _ t2 _ _ (place-at-many _ a)))
  (let ((erased _) (many r4) (unique t4)) (slots-intern _ _ t3 _ _ (place-at-many _ c)))
  (let ((erased _) (many _) (many f1) (unique t5)) (slots-find _ _ t4 (slot-of b)))
  (let ((erased _) (many _) (many f2) (unique t6)) (slots-find _ _ t5 (slot-of d)))
  (let ((many len) (erased _) (unique _)) (slots-length _ _ t6))
  (let ((many _) (many v1)) (recover a b a))
  (let ((many _) (many v2)) (recover a a b))
  (Cons _ (tag _ _ _ _ r1) $ Cons _ (tag _ _ _ _ r2) $ Cons _ (tag _ _ _ _ r3) $ Cons _ (tag _ _ _ _ r4)
    $ Cons _ (MkPair _ _ (BFalse) (found _ _ _ _ _ f1)) $ Cons _ (MkPair _ _ (BFalse) (found _ _ _ _ _ f2))
    $ Cons _ (MkPair _ _ (BFalse) len) $ Cons _ (MkPair _ _ (BFalse) v1) $ Cons _ (MkPair _ _ (BFalse) v2) $ Nil _))

run
