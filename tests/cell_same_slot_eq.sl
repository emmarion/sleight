; expect: (Cons _ 7 $ Cons _ 0 $ Cons _ 1 $ Nil _)
(def-fns _ $ (many beside : (many (Nat) a) (many (Nat) b at a) -> (many (Nat) r)) b)
(def-fns _ $ (many heads : (many (List (Nat)) xs) (many (List (Nat)) ys) -> (many (Nat) r))
  (let-match many xs (Cons _ h1 t1 u1) ((Nil _) 0))
  (let-match many ys (Cons _ h2 t2 u2) ((Nil _) 0))
  (let-match many (slot-eq (slot-of u1) (slot-of u2)) (Some _ e) ((None _) 0))
  (let-match erased e (Refl _ _))
  (let-match many (cell-same u1 u2) (EONonErased _ j) ((EOErased _) 0))
  (let-match erased j (JMRefl _ _))
  (beside h1 h2))
(def-fns _ $ (many agree : (many (List (Nat)) xs) -> (many (Nat) r))
  (let-match many xs (Cons _ h1 t1 u1) ((Nil _) 0))
  (let-match many xs (Cons _ h2 t2 u2))
  (let-match many (cell-same u1 u2) (EONonErased _ j) ((EOErased _) 0))
  (let-match erased j (JMRefl _ _))
  (match many (slot-eq (slot-of h1) (slot-of h2)) _ ((Some _ e) 1) ((None _) 0)))
(def-fns _ $ (many run : (many (List (Nat)) xs) -> (many (List (Nat)) out))
  (Cons _ (heads xs xs) $ Cons _ (heads xs (Cons _ 7 (Nil _))) $ Cons _ (agree xs) $ Nil _))
(run (Cons _ 7 (Nil _)))
