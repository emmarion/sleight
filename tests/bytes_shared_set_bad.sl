; error: unique value `b` has conflicting non-erased uses
(let-match many #\J (MkChar j))
(def-fns _ $ (many shared-set : -> (many (String) r))
  (let ((erased xs) (unique b) (erased p)) (bytes-make (Succ (Zero)) j))
  (let-match erased p (RepeatCons _ _ _ _ _))
  (let ((many s) (erased sp)) (bytes-str _ (share b)))
  (let ((erased ys) (unique b2) (erased q)) (bytes-set _ b (Zero) j _ (NthHere _ _ _)))
  s)
shared-set
