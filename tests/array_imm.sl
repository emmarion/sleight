; expect: (MkPair _ _ #\c #\a)
(def-fns _ $ (many imm-test : -> (many (Pair (Char) (Char)) result))
  (let ((erased n) (unique a) (erased p)) (list-to-array _ (Cons _ #\a $ Cons _ #\b $ Nil _)))
  (let-match erased p (AILCons _ _ _ _ _ p1))
  (let-match erased p1 (AILCons _ _ _ _ _ p2))
  (let ((unique old) (unique b) (erased q))
    (array-swap-imm _ _ a (Zero) (MkCopy _ #\c) _ (NthZ _ _ _ _) (ImmCopy _ (ImmChar))))
  (let-match erased q (SetZ _ _ _ _ _))
  (let ((unique c) (erased r))
    (array-place-imm _ _ b (Succ (Zero)) old _ (NthS _ _ _ _ _ _ (NthZ _ _ _ _)) (ImmCopy _ (ImmChar))))
  (let-match erased r (SetS _ _ _ _ _ _ _ r1))
  (let-match erased r1 (SetZ _ _ _ _ _))
  (let ((many x) (unique d)) (array-get _ _ c (Zero) _ (NthZ _ _ _ _)))
  (let ((many y) (unique e)) (array-get _ _ d (Succ (Zero)) _ (NthS _ _ _ _ _ _ (NthZ _ _ _ _))))
  (MkPair _ _ x y))
imm-test
