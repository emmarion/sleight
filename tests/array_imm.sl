; expect: (MkPair _ _ #\c #\a)
(def-fns _ $ (many imm-test : -> (many (Pair (Char) (Char)) result))
  (let ((unique a)) (list-to-array _ (Cons _ (MkCopy _ #\a) $ Cons _ (MkCopy _ #\b) $ Nil _)))
  (let ((unique old) (erased _) (unique b) (erased q))
    (array-swap-imm _ _ a (Zero) (MkCopy _ #\c) _ (NthHere _ _ _) (ImmCopy _ (ImmChar))))
  (let-match erased q (SetHere _ _ _ _))
  (let ((erased _) (unique c) (erased r))
    (array-place-imm _ _ b (Succ (Zero)) old _ (NthThere _ _ _ _ _ (NthHere _ _ _)) (ImmCopy _ (ImmChar))))
  (let-match erased r (SetThere _ _ _ _ _ _ r1))
  (let-match erased r1 (SetHere _ _ _ _))
  (let ((many x) (unique d)) (array-get _ _ c (Zero) _ (NthHere _ _ _)))
  (let ((many y) (unique _)) (array-get _ _ d (Succ (Zero)) _ (NthThere _ _ _ _ _ (NthHere _ _ _))))
  (MkPair _ _ x y))
imm-test
