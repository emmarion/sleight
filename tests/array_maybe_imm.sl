; expect: (MkU62 0 _)
(def-fns _ $ (many go : (unique (U62) n) (unique (U62) n2) -> (many (U62) r))
  (let ((erased _) (unique a) (erased all)) (array-new (U62) (Succ (Succ (Zero)))))
  (let-match erased all (RepeatCons _ _ _ _ q))
  (let-match erased q (RepeatCons _ _ _ _ nil))
  (let-match erased nil (RepeatNil _ _))
  (let ((unique _) (erased _) (erased pe) (erased _) (unique b) (erased se))
    (array-pluck _ _ a (Succ (Zero)) _ (NthThere _ _ _ _ _ (NthHere _ _ _))))
  (let-match erased pe (PluckVacant _))
  (let-match erased se (SetThere _ _ _ _ _ _ se1))
  (let-match erased se1 (SetHere _ _ _ _))
  (let ((erased _) (unique c) (erased p1))
    (array-place-imm _ _ b (Zero) (Init _ n) _ (NthHere _ _ _) (ImmMaybe _ (ImmU62))))
  (let-match erased p1 (SetHere _ _ _ _))
  (let ((unique v) (erased _) (erased pv) (erased _) (unique d) (erased sv)) (array-pluck _ _ c (Zero) _ (NthHere _ _ _)))
  (let-match erased pv (PluckInit _ _ _ _))
  (let-match erased sv (SetHere _ _ _ _))
  (let ((erased _) (unique _) (erased _))
    (array-place-imm _ _ d (Zero) (Init _ n2) _ (NthHere _ _ _) (ImmMaybe _ (ImmU62))))
  (let-match unique v (Init _ x))
  (share x))
(go (MkU62 (Zero) u62-modulus-pos) (MkU62 (Zero) u62-modulus-pos))
