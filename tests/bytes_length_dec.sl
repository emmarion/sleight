; expect: (MkPair _ _ 2 $ MkPair _ _ 0 0)
(let-match many #\J (MkChar j))
(def-fns _ $ (many length-dec-test : -> (many (Pair (Nat) $ Pair (Nat) (Nat)) result))
  (let ((erased _) (unique b) (erased _)) (bytes-make 2 j))
  (let ((erased _) (erased _) (many d) (unique b1)) (bytes-length-dec _ b))
  (let ((many n) (erased _) (unique b2)) (bytes-length _ b1))
  (let ((many c)) (share b2))
  (let ((erased _) (erased _) (many d2)) (bytes-length-dec-many _ c))
  (MkPair _ _ n $ MkPair _ _ (match many d _ ((Yes _ _ _ _ _) 0) ((No _ _ _ _ _) 1)) (match many d2 _ ((Yes _ _ _ _ _) 0) ((No _ _ _ _ _) 1))))
length-dec-test
