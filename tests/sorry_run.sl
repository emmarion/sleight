; A `match` in run position only some of whose results are tainted binds each untainted result to its own
; value: where a tainted result is an `at` entry read back from an untainted word, where the taint comes from
; the branch of a phantom constructor or from an `else` that stands for phantoms alone, where the match is
; itself an at-match, and where it is a branch of another.
(def-adts $ (P : -> Type)
  enum
  (many A : -> (P))
  (erased Ph : -> (P))
  (erased Ph2 : -> (P))
  (many B : -> (P)))
(def-fns _ $ (many id : (many (Nat) n) -> (many (Nat) a))
  n)
(def-fns _ $ (many idp : (many (P) p) -> (many (P) q))
  p)
(let ((many x)) (id 3))
(let ((many y)) (id 40))
(let ((many v)) (idp (B)))
(let ((erased c)) (sorry (((Coercible (Shared) (Nat) x (Shared) (Nat) x) p))))
(let ((many _a1) (many _b1) (many d1)) (match many x (((Nat) a) ((Nat) b at a) ((Nat) d))
  ((Zero) (values x (coerce x c) 5))
  ((Succ _p) (values x (coerce x c) 9))))
(let ((many _b2) (many d2)) (match many x (((Nat) b at x) ((String) d))
  ((Zero) (values (sorry (((Nat) q at x))) "zero"))
  ((Succ _p) (values x "succ"))))
(let ((many _a3) (many d3)) (match many v (((Nat) a) ((String) b))
  ((A) (values 1 "a"))
  ((Ph) (values (sorry _) "ph"))
  ((Ph2) (values 3 "ph2"))
  ((B) (values 2 "b"))))
(let ((many _a4) (many d4)) (match many v (((Nat) a) ((Nat) b))
  ((A) (values 1 10))
  ((B) (values 2 20))
  (else (values (sorry _) 30))))
(let ((many _a5) (many d5)) (match many x (at (((Nat) a at x) ((Nat) b at y)))
  ((Zero) (values (sorry (((Nat) q at x))) y))
  ((Succ _p) (values x y))))
(let ((many _a6) (many _b6) (many d6)) (match many (id 0) (((Nat) a) ((Nat) b) ((Nat) e))
  ((Zero) (match many x (((Nat) a) ((Nat) b at a) ((Nat) d))
    ((Zero) (values x (sorry (((Nat) q at x))) 5))
    ((Succ _p) (values x x 9))))
  ((Succ _p) (values 1 2 3))))
(MkPair _ _ (MkPair _ _ d1 (str-append d2 "!")) $ MkPair _ _ (MkPair _ _ d3 d4) $ MkPair _ _ d5 d6)
; expect: (MkPair _ _ (MkPair _ _ 9 "succ!") $ MkPair _ _ (MkPair _ _ "b" 20) $ MkPair _ _ 40 9)
