; needs: ../std/list ../std/macro ../std/buffer
; expect: (MkPair _ _ (MkPair _ _ "cdefghij" $ MkPair _ _ "cdefghijklmnopqr" "Stuvwxyz") $ Cons _ 2 $ Cons _ 3 $ Cons _ 4 $ Cons _ 5 $ Cons _ 6 $ Cons _ 7 $ Cons _ 8 $ Nil _)
(def-fns _ $ (many fill : (erased (List (U8)) xs) (unique (BytesRing xs) v) (subterm many (String) s) ->
    (erased (List (U8)) ys) (unique (BytesRing ys) w))
  (let-match many s (SCons c rest) ((SNil) (values xs v)))
  (let-match many c (MkChar u))
  (let ((erased ys) (unique v2) (erased _)) (bytes-ring-push-back _ v u))
  (tail $ fill ys v2 rest))

(def-fns _ $ (many chars : (erased (List (U8)) xs) (unique (BytesRing xs) v) (many (Nat) n) (erased (Length (U8) xs n) l)
    (many (Nat) i) (subterm many (Nat) fuel) -> (many (Rope) s) (unique v is w at v))
  (let-match many fuel (Succ f1) ((Zero) (values (REmpty) v)))
  (let-match many (lt-dec i n) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (values (REmpty) v)))
  (let ((erased e) (erased q)) (nth-exists _ xs n i l lt))
  (let ((many x) (unique v2)) (bytes-ring-get _ v i e q))
  (let ((many rest) (unique v3)) (notail $ chars _ v2 n l (Succ i) f1))
  (values (RCat (RChar (MkChar x)) rest) v3))

(def-fns _ $ (many churn : (erased (List (U8)) xs) (unique (BytesRing xs) v) (subterm many (String) s) ->
    (many (Rope) out) (erased (List (U8)) ys) (unique (BytesRing ys) w))
  (let-match many s (SCons c rest) ((SNil) (values (REmpty) xs v)))
  (let-match many c (MkChar u))
  (let ((erased _) (unique v2) (erased k)) (bytes-ring-push-back _ v u))
  (let ((erased xs3) (unique v3) (many f)) (bytes-ring-pop-front _ v2))
  (let-match many f (FrontSome _ x _) (absurd (FrontNone _) k))
  (let ((many out) (erased ys) (unique w)) (notail $ churn xs3 v3 rest))
  (values (RCat (RChar (MkChar x)) out) ys w))

(def-fns _ $ (many drain : (erased (List (U8)) xs) (unique (BytesRing xs) v) (subterm many (Nat) n) (erased (Length (U8) xs n) l) ->
    (many (Rope) s))
  (let ((erased ys) (unique v2) (many f)) (bytes-ring-pop-front _ v))
  (let-match many f (FrontSome _ x _) ((FrontNone _) (REmpty)))
  (let-match many n (Succ m) (absurd (Zero) l))
  (let-match erased l (LengthCons _ _ _ _ l1))
  (RCat (RChar (MkChar x)) (notail $ drain ys v2 m l1)))

(def-fns _ $ (many bytes-test : -> (many (Pair (String) (Pair (String) (String))) r))
  (let-match many #\S (MkChar big-s))
  (let ((erased _) (unique r1)) (fill _ (bytes-ring-new) "abcde"))
  (let ((erased _) (unique r2) (many _)) (bytes-ring-pop-front _ r1))
  (let ((erased _) (unique r3) (many _)) (bytes-ring-pop-front _ r2))
  (let ((erased _) (unique r4)) (fill _ r3 "fghij"))
  (let ((many n) (erased l) (unique r5)) (bytes-ring-length _ r4))
  (let ((many s1) (unique r6)) (chars _ r5 n l (Zero) n))
  (let ((many s2) (erased _) (unique r7)) (churn _ r6 "klmnopqrstuvwxyz"))
  (let ((many n2) (erased l2) (unique r8)) (bytes-ring-length _ r7))
  (let-match many (lt-dec (Zero) n2) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (MkPair _ _ "" $ MkPair _ _ "" "")))
  (let ((erased m) (erased q)) (nth-exists _ _ n2 (Zero) l2 lt))
  (let ((erased _) (unique r9) (erased _)) (bytes-ring-set _ r8 (Zero) big-s m q))
  (let ((many n3) (erased l3) (unique r10)) (bytes-ring-length _ r9))
  (let ((many t1) (erased _)) (flatten s1))
  (let ((many t2) (erased _)) (flatten s2))
  (let ((many t3) (erased _)) (flatten $ drain _ r10 n3 l3))
  (MkPair _ _ t1 $ MkPair _ _ t2 t3))

(def-fns _ $ (many afill : (erased (List (Copy (Nat))) xs) (unique (Ring (Nat) xs) v) (subterm many (List (Nat)) ks) ->
    (erased (List (Copy (Nat))) ys) (unique (Ring (Nat) ys) w))
  (let-match many ks (Cons _ k rest) ((Nil _) (values xs v)))
  (let ((erased ys) (unique v2) (erased _)) (ring-push-back _ _ v (MkCopy _ k)))
  (tail $ afill ys v2 rest))

(def-fns _ $ (many adrain : (erased (List (Copy (Nat))) xs) (unique (Ring (Nat) xs) v) (subterm many (Nat) n)
    (erased (Length (Copy (Nat)) xs n) l) -> (many (List (Nat)) out))
  (let ((erased ys) (unique v2) (many f)) (ring-pop-front _ _ v))
  (let-match many f (FrontSome _ x _) ((FrontNone _) (Nil _)))
  (let-match many x (MkCopy _ k))
  (let-match many n (Succ m) (absurd (Zero) l))
  (let-match erased l (LengthCons _ _ _ _ l1))
  (Cons _ k (notail $ adrain ys v2 m l1)))

(def-fns _ $ (many array-test : -> (many (List (Nat)) r))
  (let ((erased _) (unique r1)) (afill _ (ring-new _) (Cons _ 1 $ Cons _ 2 $ Cons _ 3 $ Cons _ 4 $ Nil _)))
  (let ((erased _) (unique r2) (many _)) (ring-pop-front _ _ r1))
  (let ((erased _) (unique r3)) (afill _ r2 (Cons _ 5 $ Cons _ 6 $ Cons _ 7 $ Cons _ 8 $ Nil _)))
  (let ((many n) (erased l) (unique r4)) (ring-length _ _ r3))
  (adrain _ r4 n l))

(MkPair _ _ (bytes-test) (array-test))
