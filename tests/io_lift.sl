; stdin: a
; stdin: bb
; expect: starting
; expect: > bb
; exit: 3
; Two libraries at two levels embedded in a program at a third, at no runtime cost: lift2 mints the program's
; level B and returns, erased, each value at (IO B) and the proof that coerces to it. The erased walk gives each
; continuation a level-B delegate, whose coercibility coercible-ctor lifts through the request; every proof is
; minted inside, after B, so the caller supplies levels and values only. The caller cannot mint a level
; relation about B itself, B reaching it opened from an existential rather than from def-lvl, so lift2
; discharges Predates thunk-lvl B where B is minted and returns it (DESIGN section 31), which is what lets
; the prelude's thunk hold the nullary continuation at B.
(def-lvl proof-lvl)
(def-lvl lift-lvl)
(let (erased pl) (prove-predates proof-lvl lift-lvl))

(def-fns lift-lvl $ erased lift2 : (erased (Level) L1) (erased (Level) L2) (many (IO L1) io1) (many (IO L2) io2) ->
    (erased (Level) B) (erased (IO B) o1) (erased (IO B) o2)
    (erased (Coercible (IO L1) io1 (IO B) o1) q1) (erased (Coercible (IO L2) io2 (IO B) o2) q2)
    (erased (Predates (Level) thunk-lvl B) tb)
  (def-lvl B)
  (let (erased pb) (prove-predates proof-lvl B))
  (let (erased tb) (prove-predates thunk-lvl B))
  (let (erased p1) (prove-predates L1 B))
  (let (erased p2) (prove-predates L2 B))
  (def-fns proof-lvl $ erased lift-proof : (erased (Level) A) (erased (Predates (Level) A B) ab) (subterm many (IO A) io) ->
      (erased (IO B) out) (erased (Coercible (IO B) out (IO A) io) p)
    (def-fns proof-lvl $ erased lift-fn : (erased Type X) (subterm many (Fn A (many X x) -> (many (IO A) next)) k) ->
        (erased (Fn B (many X x) -> (many (IO B) next)) o)
        (erased (Coercible (Fn B (many X x) -> (many (IO B) next)) o (Fn A (many X x) -> (many (IO A) next)) k) p)
      (def-fns B $ many o : (many X x) -> (many (IO B) next)
        (let (many r) (delegate (k (predates ab) x)))
        (let (erased o2) (erased q) (lift-proof (predates pb) A ab r))
        (coerce r (coercible-sym q)))
      (values o (coercible-of o)))
    (def-fns proof-lvl $ erased lift-fn0 : (subterm many (Fn A -> (many (IO A) next)) k) ->
        (erased (Fn B -> (many (IO B) next)) o)
        (erased (Coercible (Fn B -> (many (IO B) next)) o (Fn A -> (many (IO A) next)) k) p)
      (def-fns B $ many o : -> (many (IO B) next)
        (let (many r) (delegate (k (predates ab))))
        (let (erased o2) (erased q) (lift-proof (predates pb) A ab r))
        (coerce r (coercible-sym q)))
      (values o (coercible-of o)))
    (match many io _
      ((Exit l c) (values (Exit B c) (coercible-ctor Exit B A (coercible-refl c))))
      ((Step l k)
        (let (erased o) (erased q) (lift-fn0 (subterm _) k))
        (values (Step B o) (coercible-ctor Step B A q)))
      ((WriteOut l t k)
        (let (erased o) (erased q) (lift-fn0 (subterm _) k))
        (values (WriteOut B t o) (coercible-ctor WriteOut B A (coercible-refl t) q)))
      ((WriteErr l t k)
        (let (erased o) (erased q) (lift-fn0 (subterm _) k))
        (values (WriteErr B t o) (coercible-ctor WriteErr B A (coercible-refl t) q)))
      ((ReadLine l k)
        (let (erased o) (erased q) (lift-fn (Maybe (String)) (subterm _) k))
        (values (ReadLine B o) (coercible-ctor ReadLine B A q)))
      ((ReadFile l path k)
        (let (erased o) (erased q) (lift-fn (Result (String)) (subterm _) k))
        (values (ReadFile B path o) (coercible-ctor ReadFile B A (coercible-refl path) q)))
      ((WriteFile l path t k)
        (let (erased o) (erased q) (lift-fn (Result (Unit)) (subterm _) k))
        (values (WriteFile B path t o) (coercible-ctor WriteFile B A (coercible-refl path) (coercible-refl t) q)))
      ((GetArgs l k)
        (let (erased o) (erased q) (lift-fn (List (String)) (subterm _) k))
        (values (GetArgs B o) (coercible-ctor GetArgs B A q)))
      ((GetEnv l n k)
        (let (erased o) (erased q) (lift-fn (Maybe (String)) (subterm _) k))
        (values (GetEnv B n o) (coercible-ctor GetEnv B A (coercible-refl n) q)))
      ((GetEnvs l k)
        (let (erased o) (erased q) (lift-fn (List (Pair (String) (String))) (subterm _) k))
        (values (GetEnvs B o) (coercible-ctor GetEnvs B A q)))
      ((AppendFile l path t k)
        (let (erased o) (erased q) (lift-fn (Result (Unit)) (subterm _) k))
        (values (AppendFile B path t o) (coercible-ctor AppendFile B A (coercible-refl path) (coercible-refl t) q)))
      ((ReadRemaining l k)
        (let (erased o) (erased q) (lift-fn (String) (subterm _) k))
        (values (ReadRemaining B o) (coercible-ctor ReadRemaining B A q)))
      ((ListDir l path k)
        (let (erased o) (erased q) (lift-fn (Result (List (String))) (subterm _) k))
        (values (ListDir B path o) (coercible-ctor ListDir B A (coercible-refl path) q)))
      ((GetCwd l k)
        (let (erased o) (erased q) (lift-fn (String) (subterm _) k))
        (values (GetCwd B o) (coercible-ctor GetCwd B A q)))
      ((Stat l path k)
        (let (erased o) (erased q) (lift-fn (Result (EntryKind)) (subterm _) k))
        (values (Stat B path o) (coercible-ctor Stat B A (coercible-refl path) q)))
      ((MkDir l path k)
        (let (erased o) (erased q) (lift-fn (Result (Change)) (subterm _) k))
        (values (MkDir B path o) (coercible-ctor MkDir B A (coercible-refl path) q)))
      ((DeleteFile l path k)
        (let (erased o) (erased q) (lift-fn (Result (Change)) (subterm _) k))
        (values (DeleteFile B path o) (coercible-ctor DeleteFile B A (coercible-refl path) q)))
      ((DeleteDir l path k)
        (let (erased o) (erased q) (lift-fn (Result (Change)) (subterm _) k))
        (values (DeleteDir B path o) (coercible-ctor DeleteDir B A (coercible-refl path) q)))))
  (let (erased x1) (erased q1) (lift-proof (predates pl) L1 p1 io1))
  (let (erased x2) (erased q2) (lift-proof (predates pl) L2 p2 io2))
  (values B x1 x2 (coercible-sym q1) (coercible-sym q2) tb))

(def-lvl A1)
(let (many d3) (lt-dec 3 u8-modulus))
(comptime-match many d3 (Yes za3 zb3 zp3))
(let (many code3) (MkU8 3 zp3))
(let (erased str-a1) (prove-predates str-lvl A1))
(let (erased th-a1) (prove-predates thunk-lvl A1))
(def-fns A1 $ many lib-echo : (many (Maybe (String)) line) -> (many (IO A1) next)
  (match many line _
    ((None a) (Exit A1 code3))
    ((Some a s)
      (WriteOut A1 (str-append (predates str-a1) "> " (str-append (predates str-a1) s "\n"))
        (thunk (predates th-a1) _ _ (ReadLine A1 lib-echo))))))

(def-lvl A2)
(let (many d0) (lt-dec 0 u8-modulus))
(comptime-match many d0 (Yes za0 zb0 zp0))
(let (many code0) (MkU8 0 zp0))
(let (erased th-a2) (prove-predates thunk-lvl A2))
(def-fns A2 $ many banner : (many (List (String)) args) -> (many (IO A2) next)
  (match many args _
    ((Nil a) (WriteErr A2 "no args\n" (thunk (predates th-a2) _ _ (Exit A2 code0))))
    ((Cons a x rest) (WriteErr A2 x (thunk (predates th-a2) _ _ (Exit A2 code0))))))

(let (many echo-a1) (ReadLine A1 lib-echo))
(let (many banner-a2) (GetArgs A2 banner))
(let (erased B) (erased e) (erased b) (erased qe) (erased qb) (erased th-b) (lift2 A1 A2 echo-a1 banner-a2))
(def-fns B $ many user-start : (many (Maybe (String)) line) -> (many (IO B) next)
  (match many line _
    ((None a) (coerce banner-a2 qb))
    ((Some a s) (WriteOut B "starting\n" (thunk (predates th-b) _ _ (coerce echo-a1 qe))))))

(ReadLine B user-start)
