; expect: (MkPair _ _ 3 3)
(def-fns _ $ (many length-many-test : -> (many (Pair (Nat) (Nat)) result))
  (let ((unique a)) (list-to-array _ (Cons _ (MkCopy _ 4) $ Cons _ (MkCopy _ 7) $ Cons _ (MkCopy _ 9) $ Nil _)))
  (let ((many b)) (share a))
  (let ((erased _) (unique m) (erased _)) (array-new (Nat) 3))
  (let ((many m2)) (share m))
  (let ((many len) (erased _)) (array-length-many _ _ b))
  (let ((many len2) (erased _)) (array-length-many _ _ m2))
  (MkPair _ _ len len2))
length-many-test
