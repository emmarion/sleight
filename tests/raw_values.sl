; expect: (MkPair _ _ (RawList (MkPos "f" 0 2) $ Cons _ (RawSymbol (NoPos) $ SName "x") $ Nil _) $ MkPair _ _ "y" $ MkPos "f" 0 2)
(let ((many x)) (RawList (MkPos "f" 0 2) $ Cons _ (RawSymbol (NoPos) $ SName "x") $ Nil _))
(def-fns _ $ (many text : (many (Symbol) s) -> (many (String) t))
  (match many s _ ((SName t) t) ((SGen _ t _) t)))
(def-fns _ $ (many first : (subterm many (Raw) r) -> (many (String) s))
  (let-match many r (RawList _ items) ((RawSymbol _ s) (text s)) (else "other"))
  (match many items _ ((Nil _) "none") ((Cons _ h _) (tail $ first h))))
(def-fns _ $ (many pos : (many (Raw) r) -> (many (Pos) p))
  (match many r _ ((RawSymbol p _) p) ((RawList p _) p) ((RawWild p) p) ((RawSettled p _ _ _ _) p)))
(def-fns _ $ (many main : -> (many (Pair (Raw) $ Pair (String) (Pos)) p)) (MkPair _ _ x $ MkPair _ _ (first $ RawList (NoPos) $ Cons _ (RawSymbol (NoPos) $ SName "y") $ Cons _ x $ Nil _) (pos x)))
main
