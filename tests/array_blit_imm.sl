  (let-match many (array-get-many _ _ a i _ nth) (MkCopy _ v))
  v)

(def-fns _ $ (many blit-imm-test : -> (many (Pair (Pair (U62) (U62)) (Pair (U62) (U62))) r))
  (let ((unique s)) (list-to-array _ (Cons _ (char-u62 #\a) $ Cons _ (char-u62 #\b) $ Nil _)))
  (let ((unique d)) (list-to-array _ (Cons _ (char-u62 #\z) $ Cons _ (char-u62 #\z) $ Cons _ (char-u62 #\z) $ Nil _)))
  (let ((erased _) (unique r) (unique s2) (erased p))
    (array-blit-imm _ _ _ _ _ s (Zero) d (Succ (Zero)) (Succ (Succ (Zero)))
      (SpliceHere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceNil _ _)
      (SpliceThere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceNil _ _)
      (imm-all-of _ (ImmCopy _ (ImmU62)) _) (imm-all-of _ (ImmCopy _ (ImmU62)) _)))
  (let-match erased p (SpliceThere _ _ _ _ _ _ _ p1))
  (let-match erased p1 (SpliceHere _ _ _ _ _ _ _ p2))
  (let-match erased p2 (SpliceHere _ _ _ _ _ _ _ p3))
  (let-match erased p3 (SpliceNil _ _))
  (let ((many src)) (share s2))
  (let ((unique e)) (list-to-array _ (Cons _ (char-u62 #\z) $ Cons _ (char-u62 #\z) $ Nil _)))
  (let ((erased _) (unique f) (erased q))
    (array-blit-many-imm _ _ _ _ _ src (Succ (Zero)) e (Zero) (Succ (Zero))
      (SpliceThere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceNil _ _)
      (SpliceHere _ _ _ _ _ _ _ $ SpliceNil _ _)
      (imm-all-of _ (ImmCopy _ (ImmU62)) _) (imm-all-of _ (ImmCopy _ (ImmU62)) _)))
  (let-match erased q (SpliceHere _ _ _ _ _ _ _ q1))
  (let-match erased q1 (SpliceNil _ _))
  (let ((many dst)) (share r))
  (let ((many fs)) (share f))
  (MkPair _ _ (MkPair _ _ (get _ dst (Zero) _ (NthHere _ _ _)) (get _ dst (Succ (Zero)) _ (NthThere _ _ _ _ _ (NthHere _ _ _))))
    (MkPair _ _ (get _ dst (Succ (Succ (Zero))) _ (NthThere _ _ _ _ _ (NthThere _ _ _ _ _ (NthHere _ _ _)))) (get _ fs (Zero) _ (NthHere _ _ _)))))
