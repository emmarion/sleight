; expect: (Cons _ 1 $ Cons _ 0 $ Cons _ 2 $ Nil _)
(def-lvl L)
(def-fns L $ (many inc : (many (Nat) n) -> (many (Nat) m)) (Succ n))
(def-fns L $ (many dec : (many (Nat) n) -> (many (Nat) m)) n)
(def-adts $ (IsInc : ((Fn L (many (Nat) n) -> (many (Nat) m)) f) -> Type)
  enum
  (many MkIsInc : -> (IsInc inc)))
(def-fns _ $ (many transport : (many (Fn L (many (Nat) n) -> (many (Nat) m)) f)
    (many (Fn L (many (Nat) n) -> (many (Nat) m)) g) (many (IsInc f) w) -> (many (Maybe $ IsInc g) r))
  (let-match many (slot-eq (slot-of f) (slot-of g)) (Some _ e) ((None _) (None _)))
  (let-match erased e (Refl _ _))
  (let-match many (fn-same f g) (EONonErased _ j) ((EOErased _) (None _)))
  (let-match erased j (Refl _ _))
  (Some _ w))
(def-fns _ $ (many found : (many (Maybe $ IsInc dec) x) -> (many (Nat) r))
  (match many x _ ((Some _ w) 1) ((None _) 0)))
(def-fns _ $ (many run : -> (many (List (Nat)) out))
  (let ((many a)) (match many (transport inc inc (MkIsInc)) (((Nat) k)) ((Some _ w) 1) ((None _) 0)))
  (Cons _ a $ Cons _ (found $ transport inc dec (MkIsInc)) $ Cons _ (inc $ inc 0) $ Nil _))
run
