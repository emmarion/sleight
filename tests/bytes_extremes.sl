; expect: (MkPair _ _ (MkU8 0 _) $ MkPair _ _ (MkU8 255 _) 2)
(let-match many #\x00 (MkChar lo))
(let-match many #\xff (MkChar hi))
(def-fns _ $ (many extremes-test : -> (many (Pair (U8) $ Pair (U8) (Nat)) r))
  (let ((erased xs) (unique b) (erased p)) (bytes-make (Succ (Succ (Zero))) lo))
  (let-match erased p (RepeatCons _ _ _ _ p1))
  (let-match erased p1 (RepeatCons _ _ _ _ _))
  (let ((erased ys) (unique b2) (erased q)) (bytes-set _ b (Succ (Zero)) hi _ (NthThere _ _ _ _ _ (NthHere _ _ _))))
  (let-match erased q (SetThere _ _ _ _ _ _ q1))
  (let-match erased q1 (SetHere _ _ _ _))
  (let ((many frozen)) (share b2))
  (let ((many s) (erased sp)) (bytes-str _ (share (bytes-copy _ frozen))))
  (let ((erased zs) (unique back) (erased bp)) (str-bytes-copy s))
  (let ((many len) (erased lp) (unique back2)) (bytes-length _ back))
  (MkPair _ _ (bytes-get-many _ frozen (Zero) _ (NthHere _ _ _))
    $ MkPair _ _ (bytes-get-many _ frozen (Succ (Zero)) _ (NthThere _ _ _ _ _ (NthHere _ _ _))) len))
extremes-test
