; expect: (MkPair _ _ "ell" "hELLo")
(def-fns _ $ (many sub-blit-test : -> (many (Pair (String) (String)) r))
  (let ((erased xs) (unique b) (erased sp)) (str-bytes-copy "hello"))
  (let ((many len) (erased lp) (unique b2)) (bytes-length _ b))
  (let ((erased us) (unique caps) (erased cp)) (str-bytes-copy "HELLO"))
  (let ((many clen) (erased clp) (unique caps2)) (bytes-length _ caps))
  (let ((many e) (erased a)) (add 1 3))
  (let-match many (lt-dec e (Succ len)) (Yes _ _ lt) ((No _ _ _) (MkPair _ _ "" "")))
  (let-match many (lt-dec e (Succ clen)) (Yes _ _ clt) ((No _ _ _) (MkPair _ _ "" "")))
  (let ((erased ys) (erased range)) (splice-range _ _ _ lp 1 3 e a lt))
  (let ((many frozen)) (share b2))
  (let ((unique c)) (bytes-sub _ frozen 1 3 _ range))
  (let ((many s) (erased p)) (bytes-str _ (share c)))
  (let ((erased ks) (erased from)) (splice-range _ _ _ clp 1 3 e a clt))
  (let ((unique dst)) (bytes-copy _ frozen))
  (let ((erased zs) (unique r) (erased q)) (bytes-blit _ (share caps2) 1 _ dst 1 3 _ from _ range))
  (let ((many t) (erased tp)) (bytes-str _ (share r)))
  (MkPair _ _ s t))
sub-blit-test
