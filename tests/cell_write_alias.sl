; expect: 1
(def-adts $ (Box : -> Type) enum (many Boxed : (many (Nat) n) -> (Box)))
(let ((many zero)) 0)
(let ((many one)) 1)
(let ((unique u)) (cell-alloc (Boxed (slot-of zero))))
(let ((many s)) (slot-of u))
(let ((unique u2)) (cell-write unique u (Boxed (slot-of zero))))
(def-fns _ $ (many read-at : (many (Slot) target) (unique (Cell Boxed (slot-of one)) c at target) -> (many (Nat) n))
  (let ((many box)) (share (at (c one))))
  (let-match many box (Boxed n))
  n)
(let-match many #\x00 (MkChar exit-code))
(def-lvl L)
(def-unique L $ (unique run : -> (unique (IO L) out))
  (let ((unique u3)) (cell-write unique u2 (Boxed (slot-of one))))
  (let ((many answer)) (read-at s u3))
  (def-unique L $ (unique done : -> (unique (IO L) out)) (Exit L exit-code))
  (def-unique L $ (unique newline : -> (unique (IO L) out)) (WriteOut L "\n" done))
  (WriteOut L (nat-str answer) newline))
(Step L run)
