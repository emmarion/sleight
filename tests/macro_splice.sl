; expect: (MkPair _ _ 4 $ MkPair _ _ "a\tb" #\A)
(def-fns _ $ (many pass : (unique (MacroWorld) mw) (many (Pos) _here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (values mw args))
(let ((many splice)) (MkMacro _ pass))
(splice (let ((many x)) "a\tb") (let ((many y)) #\x41))
(def-fns _ $ (many f : (splice (many (Nat) n)) -> (many (Nat) m)) (splice n))
(let ((many (splice (Pair (String) (Char))) p)) (MkPair _ _ x (splice y)))
(let ((unique once)) (MkMacro _ pass))
((share once) (let ((many k)) (f 4)))
(MkPair _ _ k (splice p))
