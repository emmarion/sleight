(def-adts $ (LeOut : -> Type)
  enum
  (many MkLe : (many (String) s1) (many (String) s2) (many (Nat) w2) (many (Nat) w0) (many (Nat) x) (many (Nat) y)
     (many (Nat) z1) (many (Nat) z2) -> (LeOut)))
(def-fns _ $ (many le-cons : (many (Nat) d) (erased (Lt d u8-modulus) pd) (erased (List (U8)) ds) (many (Nat) w) (erased (LE ds w) p) ->
    (many (Nat) v) (erased (LE (Cons (U8) (MkU8 d pd) ds) v) q))
  (let ((many m) (erased mm)) (mul w u8-modulus))
  (let ((many v) (erased a)) (add m d))
  (values v (LEByte d w m v pd ds p mm a)))
(def-fns _ $ (many le-test : (many (U8) j) (many (U8) k) -> (many (LeOut) r))
  (let ((many i2)) (Succ $ Succ $ Zero))
  (let ((many i4)) (Succ $ Succ i2))
  (let-match many j (MkU8 nj pj))
  (let-match many k (MkU8 nk pk))
  (let ((erased xs) (unique b) (erased p)) (bytes-make i4 j))
  (let-match erased p (RepeatCons _ _ _ _ p1))
  (let-match erased p1 (RepeatCons _ _ _ _ p2))
  (let-match erased p2 (RepeatCons _ _ _ _ p3))
  (let-match erased p3 (RepeatCons _ _ _ _ p4))
  (let-match erased p4 (RepeatNil _ _))
  (let ((erased (List (U8)) jj)) (Cons (U8) j $ Cons (U8) j $ Nil (U8)))
  (let ((erased (Splice (U8) xs (Zero) i2 jj xs) range0))
    (SpliceHere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceNil _ _))
  (let ((erased (Splice (U8) xs i2 i2 jj xs) range2))
    (SpliceThere _ _ _ _ _ _ _ $ SpliceThere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceHere _ _ _ _ _ _ _ $ SpliceNil _ _))
  (let ((many v1) (erased q1)) (le-cons nj pj _ (Zero) (LEEnd)))
  (let ((erased vjj) (erased qjj)) (le-cons nj pj _ v1 q1))
  (let ((many vkj) (erased qkj)) (le-cons nk pk _ v1 q1))
  (let ((many w2) (unique b1)) (bytes-get16 _ _ b i2 range2 vjj qjj))
  (let ((erased _) (erased _) (unique b2) (erased sp) (erased q))
    (bytes-set16 _ _ b1 (Zero) vkj range0 (le-bound _ _ _ _ _ qkj (LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthNil _) sixteen-mul u16-modulus-pow2)))
  (let ((many w0) (unique b3)) (bytes-get16 _ _ b2 (Zero) (splice-reread _ _ _ _ _ _ sp) vkj q))
  (let ((many s1) (erased sb1)) (bytes-str _ (share b3)))
  (let ((many v3) (erased q3)) (le-cons nj pj _ vkj qkj))
  (let ((many v4) (erased q4)) (le-cons nk pk _ v3 q3))
  (let ((erased _) (unique c) (erased pc)) (bytes-make i4 j))
  (let ((erased _) (erased _) (unique c1) (erased sp4) (erased q5))
    (bytes-set32 _ _ c (Zero) v4 (splice-whole _ _ _ (repeat-length _ _ _ _ pc)) (le-bound _ _ _ _ _ q4
      (LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthCons _ _ _ _ $ LengthNil _) thirty-two-mul u32-modulus-pow2)))
  (let ((erased range4)) (splice-reread _ _ _ _ _ _ sp4))
  (let ((many x) (unique c2)) (bytes-get32 _ _ c1 (Zero) range4 v4 q5))
  (let ((many cs)) (share c2))
  (let ((many s2) (erased sb2)) (bytes-str _ cs))
  (MkLe s1 s2 w2 w0 x (bytes-get32-many _ _ cs (Zero) range4 v4 q5)
    (str-get16 s1 (Zero) _ _ sb1 (splice-reread _ _ _ _ _ _ sp) vkj q) (str-get32 s2 (Zero) _ _ sb2 range4 v4 q5)))
