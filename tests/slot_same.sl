; expect: (Cons _ 1 $ Cons _ 0 $ Cons _ 1 $ Cons _ 0 $ Cons _ 1 $ Cons _ 0 $ Cons _ 1 $ Cons _ 0 $ Cons _ 1 $ Cons _ 0 $ Cons _ 1 $ Nil _)
(def-fns _ $ (many str : (many (String) x) (many (String) y) -> (many (Nat) r))
  (let-match many (slot-eq (slot-of x) (slot-of y)) (Some _ se) ((None _) 0))
  (let-match erased se (Refl _ _))
  (let-match many (string-same x y) (EONonErased _ e) ((EOErased _) 0))
  (let-match erased e (Refl _ _))
  (let ((erased (Eq (String) x y) q)) (Refl (String) x))
  1)
(def-fns _ $ (many chr : (many (Char) x) (many (Char) y) -> (many (Nat) r))
  (let-match many (slot-eq (slot-of x) (slot-of y)) (Some _ se) ((None _) 0))
  (let-match erased se (Refl _ _))
  (let-match many (char-same x y) (EONonErased _ e) ((EOErased _) 0))
  (let-match erased e (Refl _ _))
  (let ((erased (Eq (Char) x y) q)) (Refl (Char) x))
  1)
(def-fns _ $ (many byt : (erased (List (U8)) xs) (erased (List (U8)) ys) (many (Bytes xs) x) (many (Bytes ys) y) -> (many (Nat) r))
  (let-match many (slot-eq (slot-of x) (slot-of y)) (Some _ se) ((None _) 0))
  (let-match erased se (Refl _ _))
  (let-match many (bytes-same xs ys x y) (EONonErased _ e) ((EOErased _) 0))
  (let-match erased e (JMRefl _ _))
  (let ((erased (Eq (List (U8)) xs ys) q)) (Refl (List (U8)) xs))
  1)
(def-fns _ $ (many hf : (erased (Nat) n) (erased (Nat) k) (many (Half n) x) (many (Half k) y) -> (many (Nat) r))
  (let-match many (slot-eq (slot-of x) (slot-of y)) (Some _ se) ((None _) 0))
  (let-match erased se (Refl _ _))
  (let-match many (half-same n k x y) (EONonErased _ e) ((EOErased _) 0))
  (let-match erased e (JMRefl _ _))
  (let ((erased (Eq (Nat) n k) q)) (Refl (Nat) n))
  1)
(def-fns _ $ (many at copy-nat-same : (subterm many (Copy (Nat)) a) (many (Copy (Nat)) b at a) ->
    (many (ErasedOr (Eq (Copy (Nat)) a b)) r at vacant-slot))
  (let-match many a (MkCopy _ va))
  (let-match many b (MkCopy _ vb))
  (let ((many e)) (nat-same va vb))
  (let-match many e (EONonErased _ ev) ((EOErased _) (erased-or-void _ _ e (Refl _ e))))
  (let-match erased ev (Refl _ _))
  (erased-or-swap _ _ (Refl (Copy (Nat)) a) e))
(let ((erased L) (many asame) (erased asat)) (array-same-factory (level-of copy-nat-same)))
(open-at-fn asat)
(def-fns _ $ (many arr : (erased (List (Copy (Nat))) xs) (erased (List (Copy (Nat))) ys)
    (many (Array (Copy (Nat)) xs) x) (many (Array (Copy (Nat)) ys) y) -> (many (Nat) r))
  (let-match many (slot-eq (slot-of x) (slot-of y)) (Some _ se) ((None _) 0))
  (let-match erased se (Refl _ _))
  (let-match many (asame _ copy-nat-same (at-fn-of copy-nat-same) xs ys x y) (EONonErased _ e) ((EOErased _) 0))
  (let-match erased e (JMRefl _ _))
  (let ((erased (Eq (List (Copy (Nat))) xs ys) q)) (Refl (List (Copy (Nat))) xs))
  1)
(def-fns _ $ (many run : -> (many (List (Nat)) out))
  (let ((many s)) "hello")
  (let ((many c)) #\a)
  (let-match many c (MkChar u))
  (let ((erased bx) (unique b1) (erased _)) (bytes-make 3 u))
  (let ((many bs1)) (share b1))
  (let ((erased by) (unique b2) (erased _)) (bytes-make 3 u))
  (let ((many bs2)) (share b2))
  (let ((many h7)) (nat-halve 7))
  (let ((many h0)) (nat-halve 0))
  (let ((erased ax) (unique a1) (erased _)) (array-make _ 2 5))
  (let ((many as1)) (share a1))
  (let ((erased ay) (unique a2) (erased _)) (array-make _ 2 5))
  (let ((many as2)) (share a2))
  (Cons _ (str s s) $ Cons _ (str s "hello!") $ Cons _ (chr c c) $ Cons _ (chr c #\b)
    $ Cons _ (byt bx bx bs1 bs1) $ Cons _ (byt bx by bs1 bs2)
    $ Cons _ (hf _ _ h7 h7) $ Cons _ (hf _ _ h7 (nat-halve 9)) $ Cons _ (hf _ _ h0 h0)
    $ Cons _ (arr ax ay as1 as2) $ Cons _ (arr ax ax as1 as1) $ Nil _))
run
