; expect: (MkPair _ _ "" $ MkPair _ _ "" $ MkPair _ _ 0 $ MkPair _ _ 0 0)
(let-match many #\J (MkChar j))
(def-fns _ $ (many empty-test : -> (many (Pair (String) $ Pair (String) $ Pair (Nat) $ Pair (Nat) (Nat)) r))
  (let ((erased _) (unique b) (erased _)) (bytes-make (Zero) j))
  (let ((many len) (erased _) (unique b2)) (bytes-length _ b))
  (let ((many frozen)) (share b2))
  (let ((unique b3)) (bytes-copy _ frozen))
  (let ((many s) (erased _)) (bytes-str _ (share b3)))
  (let ((erased _) (unique c) (erased _)) (str-bytes-copy ""))
  (let ((many t) (erased _)) (bytes-str _ (share c)))
  (let ((unique a)) (list-to-array _ (Nil (Copy (Nat)))))
  (let ((unique a2)) (array-copy _ _ (share a)))
  (let ((many alen) (erased _) (unique _)) (array-length _ _ a2))
  (let ((many flen) (erased _)) (bytes-length-many _ frozen))
  (MkPair _ _ s $ MkPair _ _ t $ MkPair _ _ len $ MkPair _ _ flen alen))
empty-test
