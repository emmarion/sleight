; stdin: a
; stdin: bb
; expect: starting
; expect: > bb
; exit: 3
; The same embedding done at runtime, without coercion: lift rewraps every continuation in a level-B closure
; that lifts the callee's answer, one closure per request. The closures sit at B, above lift's own level.
; The walk takes each request apart at unique, which is what lets each branch consume the continuation it
; holds into the closure that calls it; the extra binder in every pattern is the request's cell.
(def-lvl C)
(def-fns C $ (many lift : (erased (Level) A) (erased (Level) B) (erased (Predates (Level) A B) ab) (erased (Predates (Level) C B) cb)
    (unique (IO A) io) -> (unique (IO B) out))
  (match unique io _
    ((Exit l c _) (Exit B c))
    ((Step l k _)
      (def-unique B $ (unique w : -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab))))
      (Step B w))
    ((WriteOut l t k _)
      (def-unique B $ (unique w : -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab))))
      (WriteOut B t w))
    ((WriteErr l t k _)
      (def-unique B $ (unique w : -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab))))
      (WriteErr B t w))
    ((ReadLine l k _)
      (def-unique B $ (unique w : (many (Maybe (String)) line) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) line)))
      (ReadLine B w))
    ((ReadFile l p k _)
      (def-unique B $ (unique w : (many (Result (String)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (ReadFile B p w))
    ((WriteFile l p t k _)
      (def-unique B $ (unique w : (many (Result (Unit)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (WriteFile B p t w))
    ((GetArgs l k _)
      (def-unique B $ (unique w : (many (List (String)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (GetArgs B w))
    ((GetEnv l n k _)
      (def-unique B $ (unique w : (many (Maybe (String)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (GetEnv B n w))
    ((GetEnvs l k _)
      (def-unique B $ (unique w : (many (List (Pair (String) (String))) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (GetEnvs B w))
    ((AppendFile l p t k _)
      (def-unique B $ (unique w : (many (Result (Unit)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (AppendFile B p t w))
    ((ReadRemaining l k _)
      (def-unique B $ (unique w : (many (String) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (ReadRemaining B w))
    ((ListDir l p k _)
      (def-unique B $ (unique w : (many (Result (List (String))) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (ListDir B p w))
    ((GetCwd l k _)
      (def-unique B $ (unique w : (many (String) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (GetCwd B w))
    ((Stat l p k _)
      (def-unique B $ (unique w : (many (Result (EntryKind)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (Stat B p w))
    ((MkDir l p k _)
      (def-unique B $ (unique w : (many (Result (Change)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (MkDir B p w))
    ((DeleteFile l p k _)
      (def-unique B $ (unique w : (many (Result (Change)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (DeleteFile B p w))
    ((DeleteDir l p k _)
      (def-unique B $ (unique w : (many (Result (Change)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (DeleteDir B p w))
    ((Confine l d k _)
      (def-unique B $ (unique w : (many (Result (Unit)) r) -> (unique (IO B) next))
        (lift (predates cb) A B ab cb (k (predates ab) r)))
      (Confine B d w))))

(def-lvl A0)
(def-lvl A)
(let ((many d3)) (lt-dec 3 u8-modulus))
(comptime-match many d3 (Yes za3 zb3 zp3))
(let ((many code3)) (MkU8 3 zp3))
(let ((erased str-a0)) (prove-predates str-lvl A0))
(let ((erased th-a0)) (prove-predates thunk-lvl A0))
(let ((erased a0-a)) (prove-predates A0 A))
(def-fns A0 $ (many lib-echo : (many (Maybe (String)) line) -> (unique (IO A) next))
  (let-match many line (Some a s) ((None a) (Exit A code3)))
  (def-unique A $ (unique again : (many (Maybe (String)) next-line) -> (unique (IO A) next)) (lib-echo (predates a0-a) next-line))
  (WriteOut A (str-append (predates str-a0) "> " (str-append (predates str-a0) s "\n"))
    (unique-thunk (predates th-a0) _ _ (ReadLine A again))))
(def-unique A $ (unique echo-start : (many (Maybe (String)) line) -> (unique (IO A) next)) (lib-echo (predates a0-a) line))

(def-lvl B)
(let ((erased a-b)) (prove-predates A B))
(let ((erased c-b)) (prove-predates C B))
(let ((erased th-b)) (prove-predates thunk-lvl B))
(def-unique B $ (unique user-start : (many (Maybe (String)) line) -> (unique (IO B) next))
  (WriteOut B "starting\n" (unique-thunk (predates th-b) _ _ (lift (predates c-b) A B a-b c-b (ReadLine A echo-start)))))

(ReadLine B user-start)
