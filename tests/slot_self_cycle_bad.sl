; error: `slot-self`: `x` contradicts the facts in force (`(slot-of x)` occurs in `(K (slot-of x))`)
(def-fns _ $ (many f : (erased (ValCtor (many (Slot) a) -> (Slot)) K)
    (many (Slot) x) (erased (Eq (Slot) x (K (slot-of x))) p) -> (many (Nat) n))
  (match erased p (((Nat) r))
    ((Refl _ _)
      (slot-self x)
      (let ((erased e)) (Refl (Slot) (slot-of x)))
      (Zero))))
(Zero)
