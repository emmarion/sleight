; expect: (MkPair _ _ (MkPair _ _ (MkBox 5) $ MkBox 6) $ Cons _ (MkBox 1) $ Cons _ (MkBox 9) $ Cons _ (MkBox 7) $ Nil _)
(def-adts $ (Box : -> Type) enum (many MkBox : (many (Nat) n) -> (Box)))
(def-fns _ $ (many id-cell : (erased (Slot) s) (many (Cell MkBox s) u) -> (many (Cell MkBox s) r)) u)
(def-fns _ $ (many twice : (unique (Cell MkBox vacant-slot) c) -> (many (Pair (Box) (Box)) p))
  (let ((many a)) ((share c) 5))
  (let ((many b)) ((share c) 6))
  (MkPair _ _ a b))
(def-fns _ $ (many through : (many (Box) b) (many (Nat) k) -> (many (List (Box)) r))
  (let-match many b (MkBox _ u))
  (let ((unique w)) (cell-write many (id-cell _ u) (MkBox (slot-of k))))
  (Cons _ b $ Cons _ ((id-cell _ u) 9) $ Cons _ (share (w (at) k)) $ Nil _))
(let ((unique c)) (cell-alloc MkBox))
(MkPair _ _ (twice c) (through (MkBox 1) 7))
