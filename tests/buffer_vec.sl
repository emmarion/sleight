(def-fns _ $ (many afill : (erased (List (Copy (Nat))) xs) (unique (Vec (Nat) xs) v) (subterm many (List (Nat)) ks) ->
    (erased (List (Copy (Nat))) ys) (unique (Vec (Nat) ys) w))
