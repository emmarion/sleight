(def-fns _ $ (many mk : (subterm many (Nat) n) (many (List (String)) acc) -> (many (List (String)) r))
  (match many n _ ((Zero) acc) ((Succ k) (tail $ mk k (Cons _ (nat-str n) acc)))))
(def-fns _ $ (many intern-all : (erased (List (SlotItem (String))) xs) (unique (Slots (String) xs) l) (subterm many (List (String)) ys) ->
    (erased (List (SlotItem (String))) zs) (unique (Slots (String) zs) l2))
  (let-match many ys (Cons _ h t) ((Nil _) (values xs l)))
  (let ((many p)) (place-at-many (String) h))
  (let ((erased ws) (many _) (unique l1)) (slots-intern _ _ l _ _ p))
  (tail $ intern-all ws l1 t))
(def-fns _ $ (many count : (erased (List (SlotItem (String))) xs) (unique (Slots (String) xs) l) (subterm many (List (String)) ys) (many (Nat) acc) ->
    (many (Nat) n) (unique (Slots (String) xs) l2))
  (let-match many ys (Cons _ h t) ((Nil _) (values acc l)))
  (let ((erased _) (many _) (many fr) (unique l1)) (slots-find _ _ l (slot-of h)))
  (match many fr _
    ((SlotFound _ _ _ _ _ _ _) (tail $ count xs l1 t (Succ acc)))
    ((SlotMissing _ _ _) (tail $ count xs l1 t acc))))
(def-lvl main-lvl)
(def-fns _ $ (many main : -> (unique (Program main-lvl) r))
  (def-unique main-lvl $ (unique step : (unique (World) w) -> (unique (World) w2 at w) (unique (Program main-lvl) p))
    (let ((many strs)) (mk 2000 (Nil _)))
    (let ((unique l)) (slots-new (String)))
    (let ((erased _) (unique l2)) (intern-all _ l strs))
    (let ((many c0) (unique l3)) (count _ l2 strs (Zero)))
    (let ((many _)) (mk 1000 (Nil _)))
    (let ((unique w1) (many _)) (world-do (Usage) w (Measure (Start))))
    (let ((many _)) (mk 1000 (Nil _)))
    (let ((many c1) (unique l4)) (count _ l3 strs (Zero)))
    (let ((unique w2) (many _)) (world-do (Usage) w1 (Measure (Start))))
    (let ((many c2) (unique _)) (count _ l4 strs (Zero)))
    (let ((unique w3) (many _)) (world-do (Unit) w2 (WriteOut (str-append (nat-str c0) (str-append " " (str-append (nat-str c1) (str-append " " (str-append (nat-str c2) "\n"))))))))
    (values w3 (Exit main-lvl (MkU8 (Zero) u8-modulus-pos))))
  (Continue main-lvl step))
(main)
