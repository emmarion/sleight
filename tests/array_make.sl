; expect: (MkPair _ _ #\a #\z)
(def-fns _ $ (many make-test : -> (many (Pair (Char) (Char)) result))
  (let ((erased xs) (unique a) (erased p)) (array-make _ (Succ (Succ (Zero))) #\a))
  (let-match erased p (RepeatCons _ _ _ _ p1))
  (let-match erased p1 (RepeatCons _ _ _ _ p2))
  (let ((erased b-ix) (unique b) (erased q))
    (array-place-imm _ _ a (Succ (Zero)) (MkCopy _ #\z) _ (NthThere _ _ _ _ _ (NthHere _ _ _)) (ImmCopy _ (ImmChar))))
  (let-match erased q (SetThere _ _ _ _ _ _ q1))
  (let-match erased q1 (SetHere _ _ _ _))
  (let ((many x) (unique c)) (array-get _ _ b (Zero) _ (NthHere _ _ _)))
  (let ((many y) (unique d)) (array-get _ _ c (Succ (Zero)) _ (NthThere _ _ _ _ _ (NthHere _ _ _))))
  (MkPair _ _ x y))
make-test
