; work/loops.sl: the heapsort loops (milestone 3, DONE). All runtime code is
; tail loops over u62-* ops and swap2-imm writes; all proof work is erased.
; This file comes after work/heap4.sl.
;
;   - sift-down (sink): the hole h in subtree(i0) holds the floating value x;
;     H is the ghost heap with ws = H[h := x] and x <= H[h]. Swaps x with the
;     larger child while it is bigger, then places x where it fits. Returns
;     the content, its Copy list, the permutation so far, `HeapOn ws2 hi i0
;     d0`, and the disjoint window `Frames ws2 hi i0 d0 flo fhi` transported
;     across every write.
;   - ext-loop: the extraction loop (moves the root to the region's end and
;     shrinks the region).
;   - build-loop: the heapify loop (sifts nodes q-1 .. 0 for q = n >> 1),
;     returning the whole-array heap `HeapOn ys n 0 0`.

; sift-down: the hole h in subtree(i0) holds the floating value x; H is the
; ghost heap with ws = H[h := x] and x <= H[h]. Swaps x with the larger child
; while it is bigger, then places x where it fits. Returns the content, its
; Copy list, the permutation so far, and `HeapOn ws2 hi i0 d0`.
(def-fns _ $ (many sink :
    (subterm erased (Nat) cnt)
    (erased (List (Nat)) xs0)
    (erased (Nat) n) (erased (Lt n u62-modulus) nfits)
    (erased (List (Nat)) ws) (erased (List (Copy (Nat))) ds)
    (erased (Length (Nat) ws n) ly) (erased (AllTo (Nat) Lt ws u62-modulus) bnd) (erased (Copies (Nat) ws ds) rel)
    (many (Nat) hi) (erased (Lt hi (Succ n)) hin) (many (Nat) q) (erased (Hf hi q) hfd)
    (erased (List (Nat)) H) (erased (Nat) i0) (erased (Nat) d0) (erased (Double i0 d0) dd0)
    (many (Nat) h) (erased (Nat) dh) (erased (Double h dh) ddh) (many (Nat) x)
    (erased (Nat) v) (erased (Nth (Nat) H h v) nh) (erased (Below i0 d0 h) bel)
    (erased (Lt h hi) hlt) (erased (Add h cnt hi) hcn)
    (erased (SetNth (Nat) H h x ws) sh) (erased (HeapOn H hi i0 d0) heapH) (erased (Le x v) lew)
    (erased (List (Nat)) ps) (erased (List (Nat)) ssx) (erased (Split ws hi ps ssx) spl) (erased (RangeLe ps ssx) rl)
    (erased (Nat) flo) (erased (Nat) fhi) (erased (Frames ws hi i0 d0 flo fhi) fr)
    (unique (Array (Copy (Nat)) ds) a) (erased (Permutation (Nat) xs0 ws) perm)
    ->
    (erased (List (Nat)) ws2) (erased (List (Copy (Nat))) ds2) (unique (Array (Copy (Nat)) ds2) r at a)
    (erased (Copies (Nat) ws2 ds2) rel2) (erased (Permutation (Nat) xs0 ws2) perm2)
    (erased (List (Nat)) ps2) (erased (Split ws2 hi ps2 ssx) spl2) (erased (RangeLe ps2 ssx) rl2)
    (erased (HeapOn ws2 hi i0 d0) heap2) (erased (Length (Nat) ws2 n) ly2) (erased (AllTo (Nat) Lt ws2 u62-modulus) bnd2)
    (erased (Frames ws2 hi i0 d0 flo fhi) fr2))
  (let-match erased hfd (MkHf _ _ hm hmm hr had hrl pq))
  (let ((erased hbd)) (lt-le-trans h hi n hlt hin))
  (let ((erased hbdu)) (lt-trans h n u62-modulus hbd nfits))
  (let ((erased hibd)) (le-lt-trans hi n u62-modulus (MkLe hi n hin) nfits))
  (let ((erased xg) (erased nhx) (erased ndhx)) (nth-pair ws ds rel n ly h hbd))
  (let ((erased xbnd)) (allto-nth (Nat) Lt ws u62-modulus bnd h xg nhx))
  (let-match erased (nth-fn (Nat) ws h x xg (setnth-nth (Nat) H h x ws sh) nhx) (Refl _ _))
  (let ((erased npsx)) (split-nth-below ws hi ps ssx spl h x nhx hlt))
  (let ((erased gsx)) (rangele-at ps ssx rl h x npsx))
  (let-match many (u62-lt-dec h q hbdu pq) (Yes _ _ _ _ hq)
    ((No _ _ _ _ le-qh) (let ((erased qh)) (lt-eq-succ _ _ le-qh))
      (let ((erased nl)) (half-out hi q hfd h dh ddh qh))
      (let ((erased fit)) (FitLeaf H hi h dh x ddh nl))
      (let ((erased heap2) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
        (heap-replace H hi i0 d0 heapH dh h bel hlt v nh x ws sh lew fit))
      (values ws ds a rel perm ps spl rl heap2 ly bnd fr)))
  (let ((erased lin)) (half-in hi q hfd h dh ddh hq))
  (let ((erased cln)) (lt-le-trans (Succ dh) hi n lin hin))
  (let ((erased clbd)) (lt-trans (Succ dh) n u62-modulus cln nfits))
  (let ((many t)) (u62-add h h dh (double-add h dh ddh) (lt-trans dh (Succ dh) u62-modulus (lt-succ dh) clbd)))
  (let ((many cl)) (u62-inc t clbd))
  (let ((erased y) (erased ny) (erased ndy)) (nth-pair ws ds rel n ly cl cln))
  (let ((many yv) (unique a1)) (array-get (Nat) ds a cl y ndy))
  (let ((erased ybnd)) (allto-nth (Nat) Lt ws u62-modulus bnd cl y ny))
  (let ((erased crbd)) (le-lt-trans (Succ (Succ dh)) hi u62-modulus (MkLe (Succ (Succ dh)) hi (LtS (Succ dh) hi lin)) hibd))
  (let ((many cr)) (u62-inc cl crbd))
  (let-match many (u62-lt-dec cr hi crbd hibd) (Yes _ _ _ _ rin)
    ((No _ _ _ _ le-nron) (let ((erased nron)) (lt-eq-succ _ _ le-nron))
      (let ((erased dcl) (erased ddcl)) (double (Succ dh)))
      (let ((erased dhn) (erased nodeH)) (heap-below H hi i0 d0 h bel heapH))
      (let-match erased (double-fn h dh dhn ddh (heap-dd H hi h dhn nodeH)) (Refl _ _))
      (let-match erased nodeH (HOne _ _ _ _ ddhn d2n dd2n xn yn nxn nyn linn nronn len subln)
        (absurd (HLeaf _ _ _ _ ddhn nln) (lt-asym (Succ dh) hi lin nln))
        (absurd (HTwo _ _ _ _ ddhn d2n dd2n d3n dd3n xn yn zn nxn nyn nzn rinn le1n le2n subln subrn)
          (lt-asym (Succ (Succ dh)) hi rinn nron)))
      (let-match erased (nth-fn (Nat) H h v xn nh nxn) (Refl _ _))
      (let ((erased nyh2)) (setnth-nth-inv (Nat) H h x ws sh (Succ dh) y ny (NeGT (Succ dh) h (double-lt h dh ddh))))
      (let-match erased (nth-fn (Nat) H (Succ dh) y yn nyh2 nyn) (Refl _ _))
      (let-match many (u62-lt-dec x yv xbnd ybnd) (Yes _ _ _ _ xy)
        ((No _ _ _ _ le-yx) (let ((erased yx)) (lt-eq-succ _ _ le-yx))
          (let ((erased fit)) (FitOne H hi h dh x ddh dcl ddcl y nyh2 lin nron (MkLe y x yx)))
          (let ((erased heap2) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
            (heap-replace H hi i0 d0 heapH dh h bel hlt v nh x ws sh lew fit))
          (values ws ds a1 rel perm ps spl rl heap2 ly bnd fr)))
      (let ((erased ds1) (erased s1d) (erased ds2) (erased s2d) (unique a2))
        (swap2-imm ws ds rel bnd a1 h cl x nhx ndhx yv ny ndy))
      (let ((erased ws1) (erased relA) (erased s1)) (copies-setnth ws ds rel h y ds1 s1d))
      (let ((erased ws2x) (erased rel2) (erased s2)) (copies-setnth ws1 ds1 relA cl x ds2 s2d))
      (let ((erased nys)) (split-nth-below ws hi ps ssx spl cl y ny lin))
      (let ((erased gy)) (rangele-at ps ssx rl cl y nys))
      (let ((erased ps1w) (erased s1p) (erased spl1)) (split-write ws hi ps ssx spl h y ws1 s1 hlt))
      (let ((erased rl1)) (rangele-write ps ssx rl h y ps1w s1p gy))
      (let ((erased ps2w) (erased s2p) (erased spl2)) (split-write ws1 hi ps1w ssx spl1 cl x ws2x s2 lin))
      (let ((erased rl2)) (rangele-write ps1w ssx rl1 cl x ps2w s2p gsx))
      (let ((erased permx)) (perm-swap-at ws h cl x y nhx ny ws1 s1 ws2x s2))
      (let ((erased perm2)) (PTrans (Nat) xs0 ws ws2x perm permx))
      (let ((erased heap1) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
        (heap-replace H hi i0 d0 heapH dh h bel hlt v nh y ws1
          (setnth-overwrite (Nat) H h x ws sh y ws1 s1) len
          (FitOne H hi h dh y ddh dcl ddcl y nyh2 lin nron (le-refl y))))
      (let ((erased bel2)) (below-trans i0 d0 h bel dh cl (BLeft h dh ddh dcl ddcl (Succ dh) (BHere (Succ dh) dcl ddcl))))
      (let ((erased fr1)) (frames-congr ws hi i0 d0 dd0 flo fhi fr dh h bel y ws1 s1))
      (let ((erased fr2c)) (frames-congr ws1 hi i0 d0 dd0 flo fhi fr1 dh cl bel2 x ws2x s2))
      (let ((erased hdj) (erased ddj)) (double cl))
      (let ((erased nh2)) (setnth-nth-diff (Nat) ws h y ws1 s1 cl y ny (NeGT cl h (double-lt h dh ddh))))
      (let ((erased cnt2) (erased acn2)) (sub hi cl (lt-weaken (Succ dh) hi lin)))
      (let ((erased lcc)) (add-swap-lt h cnt hi cl cnt2 hcn acn2 (double-lt h dh ddh)))
      (let ((erased ly1)) (setnth-length (Nat) ws h n y ws1 s1 ly))
      (let ((erased ly2)) (setnth-length (Nat) ws1 cl n x ws2x s2 ly1))
      (let ((erased bnd2)) (allto-perm (Nat) Lt ws ws2x u62-modulus permx bnd))
      (tail (sink (subterm (lt-subterm cnt2 cnt lcc)) cnt2 xs0 n nfits ws2x ds2 ly2 bnd2 rel2
        hi hin q hfd ws1 i0 d0 dd0 cl hdj ddj x y nh2 bel2 lin acn2 s2 heap1
        (le-of-lt x y xy) ps2w ssx spl2 rl2 flo fhi fr2c a2 perm2))))
  (let ((erased z) (erased nz) (erased ndz)) (nth-pair ws ds rel n ly cr (lt-le-trans (Succ (Succ dh)) hi n rin hin)))
  (let ((many zv) (unique a2)) (array-get (Nat) ds a1 cr z ndz))
  (let ((erased zbnd)) (allto-nth (Nat) Lt ws u62-modulus bnd cr z nz))
  (let ((erased dcl2) (erased ddcl2)) (double (Succ dh)))
  (let ((erased dcr) (erased ddcr)) (double (Succ (Succ dh))))
  (let ((erased dhn) (erased nodeH)) (heap-below H hi i0 d0 h bel heapH))
  (let-match erased (double-fn h dh dhn ddh (heap-dd H hi h dhn nodeH)) (Refl _ _))
  (let-match erased nodeH (HTwo _ _ _ _ ddhn d2n dd2n d3n dd3n xn yn zn nxn nyn nzn rinn le1n le2n subln subrn)
    (absurd (HLeaf _ _ _ _ ddhn nln) (lt-asym (Succ (Succ dh)) hi rin (lt-weaken hi (Succ (Succ dh)) nln)))
    (absurd (HOne _ _ _ _ ddhn d2n dd2n xn yn nxn nyn linn nronn len subln) (lt-asym (Succ (Succ dh)) hi rin nronn)))
  (let-match erased (nth-fn (Nat) H h v xn nh nxn) (Refl _ _))
  (let ((erased nyh2)) (setnth-nth-inv (Nat) H h x ws sh (Succ dh) y ny (NeGT (Succ dh) h (double-lt h dh ddh))))
  (let ((erased nzh2)) (setnth-nth-inv (Nat) H h x ws sh (Succ (Succ dh)) z nz (NeGT (Succ (Succ dh)) h (lt-weaken h (Succ dh) (double-lt h dh ddh)))))
  (let-match erased (nth-fn (Nat) H (Succ dh) y yn nyh2 nyn) (Refl _ _))
  (let-match erased (nth-fn (Nat) H (Succ (Succ dh)) z zn nzh2 nzn) (Refl _ _))
  (let-match many (u62-lt-dec zv yv zbnd ybnd) (Yes _ _ _ _ zy)
    ((No _ _ _ _ le-yz) (let ((erased yz)) (lt-eq-succ _ _ le-yz))
      (let-match many (u62-lt-dec x zv xbnd zbnd) (Yes _ _ _ _ xz)
        ((No _ _ _ _ le-zx) (let ((erased zx)) (lt-eq-succ _ _ le-zx))
          (let ((erased fit)) (FitTwo H hi h dh x ddh dcl2 ddcl2 dcr ddcr y z nyh2 nzh2 rin
            (le-trans y z x (MkLe y z yz) (MkLe z x zx)) (MkLe z x zx)))
          (let ((erased heap2) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
            (heap-replace H hi i0 d0 heapH dh h bel hlt v nh x ws sh lew fit))
          (values ws ds a2 rel perm ps spl rl heap2 ly bnd fr)))
      (let ((erased ds1) (erased s1d) (erased ds2) (erased s2d) (unique a3))
        (swap2-imm ws ds rel bnd a2 h cr x nhx ndhx zv nz ndz))
      (let ((erased ws1) (erased relA) (erased s1)) (copies-setnth ws ds rel h z ds1 s1d))
      (let ((erased ws2x) (erased rel2) (erased s2)) (copies-setnth ws1 ds1 relA cr x ds2 s2d))
      (let ((erased nzs)) (split-nth-below ws hi ps ssx spl cr z nz rin))
      (let ((erased gz)) (rangele-at ps ssx rl cr z nzs))
      (let ((erased ps1w) (erased s1p) (erased spl1)) (split-write ws hi ps ssx spl h z ws1 s1 hlt))
      (let ((erased rl1)) (rangele-write ps ssx rl h z ps1w s1p gz))
      (let ((erased ps2w) (erased s2p) (erased spl2)) (split-write ws1 hi ps1w ssx spl1 cr x ws2x s2 rin))
      (let ((erased rl2)) (rangele-write ps1w ssx rl1 cr x ps2w s2p gsx))
      (let ((erased permx)) (perm-swap-at ws h cr x z nhx nz ws1 s1 ws2x s2))
      (let ((erased perm2)) (PTrans (Nat) xs0 ws ws2x perm permx))
      (let ((erased heap1) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
        (heap-replace H hi i0 d0 heapH dh h bel hlt v nh z ws1
          (setnth-overwrite (Nat) H h x ws sh z ws1 s1) le2n
          (FitTwo H hi h dh z ddh dcl2 ddcl2 dcr ddcr y z nyh2 nzh2 rin (MkLe y z yz) (le-refl z))))
      (let ((erased bel2)) (below-trans i0 d0 h bel dh cr (BRight h dh ddh dcr ddcr (Succ (Succ dh)) (BHere (Succ (Succ dh)) dcr ddcr))))
      (let ((erased fr1)) (frames-congr ws hi i0 d0 dd0 flo fhi fr dh h bel z ws1 s1))
      (let ((erased fr2c)) (frames-congr ws1 hi i0 d0 dd0 flo fhi fr1 dh cr bel2 x ws2x s2))
      (let ((erased hdj) (erased ddj)) (double cr))
      (let ((erased nh2)) (setnth-nth-diff (Nat) ws h z ws1 s1 cr z nz (NeGT cr h (lt-weaken h (Succ dh) (double-lt h dh ddh)))))
      (let ((erased cnt2) (erased acn2)) (sub hi cr (lt-weaken (Succ (Succ dh)) hi rin)))
      (let ((erased lcc)) (add-swap-lt h cnt hi cr cnt2 hcn acn2 (lt-weaken h (Succ dh) (double-lt h dh ddh))))
      (let ((erased ly1)) (setnth-length (Nat) ws h n z ws1 s1 ly))
      (let ((erased ly2)) (setnth-length (Nat) ws1 cr n x ws2x s2 ly1))
      (let ((erased bnd2)) (allto-perm (Nat) Lt ws ws2x u62-modulus permx bnd))
      (tail (sink (subterm (lt-subterm cnt2 cnt lcc)) cnt2 xs0 n nfits ws2x ds2 ly2 bnd2 rel2
        hi hin q hfd ws1 i0 d0 dd0 cr hdj ddj x z nh2 bel2 rin acn2 s2 heap1
        (le-of-lt x z xz) ps2w ssx spl2 rl2 flo fhi fr2c a3 perm2))))
  (let-match many (u62-lt-dec x yv xbnd ybnd) (Yes _ _ _ _ xy)
    ((No _ _ _ _ le-yx) (let ((erased yx)) (lt-eq-succ _ _ le-yx))
      (let ((erased fit)) (FitTwo H hi h dh x ddh dcl2 ddcl2 dcr ddcr y z nyh2 nzh2 rin
        (MkLe y x yx) (le-trans z y x (le-of-lt z y zy) (MkLe y x yx))))
      (let ((erased heap2) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
        (heap-replace H hi i0 d0 heapH dh h bel hlt v nh x ws sh lew fit))
      (values ws ds a2 rel perm ps spl rl heap2 ly bnd fr)))
  (let ((erased ds1) (erased s1d) (erased ds2) (erased s2d) (unique a3))
    (swap2-imm ws ds rel bnd a2 h cl x nhx ndhx yv ny ndy))
  (let ((erased ws1) (erased relA) (erased s1)) (copies-setnth ws ds rel h y ds1 s1d))
  (let ((erased ws2x) (erased rel2) (erased s2)) (copies-setnth ws1 ds1 relA cl x ds2 s2d))
  (let ((erased nys)) (split-nth-below ws hi ps ssx spl cl y ny lin))
  (let ((erased gy)) (rangele-at ps ssx rl cl y nys))
  (let ((erased ps1w) (erased s1p) (erased spl1)) (split-write ws hi ps ssx spl h y ws1 s1 hlt))
  (let ((erased rl1)) (rangele-write ps ssx rl h y ps1w s1p gy))
  (let ((erased ps2w) (erased s2p) (erased spl2)) (split-write ws1 hi ps1w ssx spl1 cl x ws2x s2 lin))
  (let ((erased rl2)) (rangele-write ps1w ssx rl1 cl x ps2w s2p gsx))
  (let ((erased permx)) (perm-swap-at ws h cl x y nhx ny ws1 s1 ws2x s2))
  (let ((erased perm2)) (PTrans (Nat) xs0 ws ws2x perm permx))
  (let ((erased heap1) (erased w2) (erased nw2) (erased v2) (erased nv2) (erased lei))
    (heap-replace H hi i0 d0 heapH dh h bel hlt v nh y ws1
      (setnth-overwrite (Nat) H h x ws sh y ws1 s1) le1n
      (FitTwo H hi h dh y ddh dcl2 ddcl2 dcr ddcr y z nyh2 nzh2 rin (le-refl y) (le-of-lt z y zy))))
  (let ((erased bel2)) (below-trans i0 d0 h bel dh cl (BLeft h dh ddh dcl2 ddcl2 (Succ dh) (BHere (Succ dh) dcl2 ddcl2))))
  (let ((erased fr1)) (frames-congr ws hi i0 d0 dd0 flo fhi fr dh h bel y ws1 s1))
  (let ((erased fr2c)) (frames-congr ws1 hi i0 d0 dd0 flo fhi fr1 dh cl bel2 x ws2x s2))
  (let ((erased hdj) (erased ddj)) (double cl))
  (let ((erased nh2)) (setnth-nth-diff (Nat) ws h y ws1 s1 cl y ny (NeGT cl h (double-lt h dh ddh))))
  (let ((erased cnt2) (erased acn2)) (sub hi cl (lt-weaken (Succ dh) hi lin)))
  (let ((erased lcc)) (add-swap-lt h cnt hi cl cnt2 hcn acn2 (double-lt h dh ddh)))
  (let ((erased ly1)) (setnth-length (Nat) ws h n y ws1 s1 ly))
  (let ((erased ly2)) (setnth-length (Nat) ws1 cl n x ws2x s2 ly1))
  (let ((erased bnd2)) (allto-perm (Nat) Lt ws ws2x u62-modulus permx bnd))
  (tail (sink (subterm (lt-subterm cnt2 cnt lcc)) cnt2 xs0 n nfits ws2x ds2 ly2 bnd2 rel2
    hi hin q hfd ws1 i0 d0 dd0 cl hdj ddj x y nh2 bel2 lin acn2 s2 heap1
    (le-of-lt x y xy) ps2w ssx spl2 rl2 flo fhi fr2c a3 perm2)))

; The extraction loop: the heap region is [0, hsize); each step moves the root
; (the region's maximum) to the region's last position, sifts the new root
; down, and shrinks the region. The suffix past hsize is sorted and above the
; whole region; at hsize <= 1 the content is sorted. State: HeapOn ys hsize 0 0,
; Split ys hsize ps ss, Ascending ss, RangeLe ps ss, plus the content and array
; plumbing. Each step: u62-lt-dec 1 hsize (No: done), u62-dec for k = hsize-1,
; nth-pair at 0 and k, swap2-imm (0, k), ext-plumb, asc-head, rangele-ext,
; kids-after-swap + sift-entry, one u62-shr k 1 for sink's Hf, then sink at
; hole 0 with bound k, and recurse with hsize := k.
(def-fns _ $ (many ext-loop :
    (subterm many (Nat) hsize)
    (erased (List (Nat)) xs0) (erased (Nat) n) (erased (Lt n u62-modulus) nfits)
    (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds) (unique (Array (Copy (Nat)) ds) a)
    (erased (Copies (Nat) ys ds) rel) (erased (Length (Nat) ys n) ly)
    (erased (AllTo (Nat) Lt ys u62-modulus) bnd) (erased (Permutation (Nat) xs0 ys) perm)
    (erased (List (Nat)) ps) (erased (List (Nat)) ss) (erased (Split ys hsize ps ss) spl)
    (erased (Ascending (Nat) Le ss) asc) (erased (RangeLe ps ss) rl)
    (erased (HeapOn ys hsize (Zero) (Zero)) heap) (erased (Lt hsize (Succ n)) hin)
    ->
    (erased (List (Nat)) ys2) (erased (List (Copy (Nat))) ds2) (unique (Array (Copy (Nat)) ds2) r at a)
    (erased (Copies (Nat) ys2 ds2) rel2) (erased (Permutation (Nat) xs0 ys2) perm2)
    (erased (Ascending (Nat) Le ys2) asc2))
  (let ((erased one-below)) (prove-literal-lt 1 4611686018427387904))
  (let ((erased hbn)) (lt-le-trans hsize (Succ n) u62-modulus hin (LtS n u62-modulus nfits)))
  (let-match many (u62-lt-dec 1 hsize one-below hbn) (Yes _ _ _ _ hge)
    ((No _ _ _ _ le-hlt2) (let ((erased hlt2)) (lt-eq-succ _ _ le-hlt2))
      (let-match many (u62-lt-dec (Zero) hsize u62-modulus-pos hbn) (Yes _ _ _ _ hpos)
        ((No _ _ _ _ le-hz0) (let ((erased hz0)) (lt-eq-succ _ _ le-hz0))
          (let-match erased hz0 (LtZ _) (absurd (LtS _ _ z1) z1))
          (let-match erased spl (SpNil _) (absurd SpCons))
          (values ys ds a rel perm asc)))
      (let-match erased hpos (LtZ ph) (absurd LtS))
      (let-match erased hlt2 (LtS _ _ j0lt) (absurd LtZ))
      (let-match erased j0lt (LtZ _) (absurd (LtS _ _ z0) z0))
      (let-match erased spl (SpCons y0 yst j0 psx sst sp1) (absurd SpNil))
      (let-match erased sp1 (SpNil _) (absurd SpCons))
      (values ys ds a rel perm (asc-head y0 (Nil (Nat)) sst rl asc))))
  (let-match erased hge (LtS _ _ hz) (absurd LtZ))
  (let-match erased hz (LtZ hz2) (absurd LtS))
  (let ((many k)) (u62-dec (Succ hz2) hsize hbn))
  (let ((erased kh)) (lt-succ (Succ hz2)))
  (let ((erased klt)) (lt-le-trans (Succ hz2) hsize n kh hin))
  (let ((erased klz)) (lt-trans (Succ hz2) n u62-modulus klt nfits))
  (let ((erased zlt)) (lt-le-trans (Zero) hsize n (LtZ (Succ hz2)) hin))
  (let ((erased xr) (erased nx0) (erased ndx0)) (nth-pair ys ds rel n ly (Zero) zlt))
  (let ((erased w) (erased nw) (erased ndw)) (nth-pair ys ds rel n ly (Succ hz2) klt))
  (let-match erased spl (SpCons y0 yst j0 psx sst sp1))
  (let-match erased nx0 (NthHere _ _ _))
  (let ((erased leq)) (heap-max ys hsize (Zero) heap xr nx0 ps ss spl))
  (let ((erased npsw)) (split-nth-below ys hsize ps ss spl (Succ hz2) w nw kh))
  (let ((erased lwx)) (allto-nth (Nat) Le ps xr leq (Succ hz2) w npsw))
  (let ((erased gsw)) (rangele-at ps ss rl (Succ hz2) w npsw))
  (let ((many xrv) (unique a0)) (array-get (Nat) ds a (Zero) xr ndx0))
  (let ((many wv) (unique a1)) (array-get (Nat) ds a0 k w ndw))
  (let ((erased ds1) (erased s1d) (erased ds2) (erased s2d) (unique a2))
    (swap2-imm ys ds rel bnd a1 (Zero) k xrv nx0 ndx0 wv nw ndw))
  (let ((erased ws1) (erased relA) (erased s1n)) (copies-setnth ys ds rel (Zero) w ds1 s1d))
  (let ((erased ws2) (erased rel2) (erased s2n)) (copies-setnth ws1 ds1 relA (Succ hz2) xr ds2 s2d))
  (let ((erased permx)) (perm-swap-at ys (Zero) (Succ hz2) xr w nx0 nw ws1 s1n ws2 s2n))
  (let ((erased perm2)) (PTrans (Nat) xs0 ys ws2 perm permx))
  (let ((erased ly1)) (setnth-length (Nat) ys (Zero) n w ws1 s1n ly))
  (let ((erased lyw)) (setnth-length (Nat) ws1 (Succ hz2) n xr ws2 s2n ly1))
  (let ((erased bndw)) (allto-perm (Nat) Lt ys ws2 u62-modulus permx bnd))
  (let ((erased psp) (erased ps2) (erased sns) (erased stp) (erased outp))
    (ext-plumb ys xr nx0 hz2 w nw ws1 s1n ws2 s2n ps ss spl))
  (let ((erased rlw)) (rangele-ext xr ss psp w ps sns ps2 stp rl leq))
  (let ((erased ascw)) (asc-head xr psx sst rl asc))
  (let ((erased kids)) (kids-after-swap ys (Succ hz2) heap w ws1 s1n xr ws2 s2n))
  (let ((erased nw1)) (setnth-nth (Nat) ys (Zero) w ws1 s1n))
  (let ((erased nw2))
    (setnth-nth-diff (Nat) ws1 (Succ hz2) xr ws2 s2n (Zero) w nw1 (NeLO (Zero) (Succ hz2) (LtZ hz2))))
  (let ((erased Hx) (erased vx) (erased nhx2) (erased shx) (erased heapHx) (erased lewx))
    (sift-entry ws2 (Succ hz2) (Zero) (Zero) (D0) kids w nw2))
  (let ((many qk) (erased v1) (erased pv1) (erased m1) (erased r1) (erased mm1) (erased ad1) (erased rlt1) (erased pq1))
    (u62-shr k 1 klz (shift-one-lt)))
  (let ((erased hfk)) (hf-of (Succ hz2) v1 pv1 qk m1 mm1 r1 ad1 rlt1 pq1))
  (let ((erased hin2)) (lt-weaken (Succ hz2) n klt))
  (let ((erased ys3) (erased ds3) (unique a3) (erased rel3) (erased perm3)
        (erased ps3) (erased spl3) (erased rl3) (erased heap3) (erased ly3) (erased bnd3) (erased fr3))
    (sink k xs0 n nfits ws2 ds2 lyw bndw rel2
      k hin2 qk hfk Hx (Zero) (Zero) (D0)
      (Zero) (Zero) (D0) wv
      vx nhx2 (BHere (Zero) (Zero) (D0)) (LtZ hz2) (AddZero (Succ hz2))
      shx heapHx lewx ps2 (Cons (Nat) xr sst) outp rlw
      (Zero) (Zero) (FrNil ws2 k (Zero) (Zero) (Zero)) a2 perm2))
  (tail $ ext-loop k xs0 n nfits
    ys3 ds3 a3 rel3 ly3 bnd3 perm3 ps3 (Cons (Nat) xr sst) spl3 ascw rl3 heap3 hin2))

; The build loop: sift nodes j, j-1, ..., 0 into a max-heap on [0, n). The
; window BInv ys n j dj says [j+1, 2j+2] holds heaps on ys; each step reads
; node j's children's heaps off the window, sifts node j, and steps the window
; down to j-1 (binv-down). At j = 0 the sift's output heap is the whole-array
; heap. The bound Lt j q threads from the half mark (q = n >> 1).
(def-fns _ $ (many build-loop :
    (subterm many (Nat) j)
    (erased (Nat) dj) (erased (Double j dj) ddj)
    (erased (List (Nat)) xs0) (many (Nat) n) (erased (Lt n u62-modulus) nfits)
    (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds) (unique (Array (Copy (Nat)) ds) a)
    (erased (Copies (Nat) ys ds) rel) (erased (Length (Nat) ys n) ly)
    (erased (AllTo (Nat) Lt ys u62-modulus) bnd) (erased (Permutation (Nat) xs0 ys) perm)
    (erased (BInv ys n j dj) binv)
    (many (Nat) q) (erased (Hf n q) hfd) (erased (Lt j q) jq)
    ->
    (erased (List (Nat)) ys2) (erased (List (Copy (Nat))) ds2) (unique (Array (Copy (Nat)) ds2) r at a)
    (erased (Copies (Nat) ys2 ds2) rel2) (erased (Permutation (Nat) xs0 ys2) perm2)
    (erased (Length (Nat) ys2 n) ly2) (erased (AllTo (Nat) Lt ys2 u62-modulus) bnd2)
    (erased (HeapOn ys2 n (Zero) (Zero)) heap0))
  (let-match erased binv (MkBInv _ _ _ _ _ _ _ _ _ _ fr))
  (let-match erased (q-le-n n q hfd) (MkLe _ _ qn))
  (let ((erased jn)) (lt-le-trans j q n jq qn))
  (let ((erased jmod)) (lt-trans j n u62-modulus jn nfits))
  (let ((erased x) (erased nx) (erased ndx)) (nth-pair ys ds rel n ly j jn))
  (let ((many xv) (unique a1)) (array-get (Nat) ds a j x ndx))
  (let ((erased kids)) (binv-kids ys ds rel n ly j dj ddj binv))
  (let ((erased Hx) (erased vx) (erased nhx) (erased shx) (erased heapHx) (erased lewx))
    (sift-entry ys n j dj ddj kids x nx))
  (let ((erased cnt) (erased acn)) (sub n j (lt-weaken j n jn)))
  (let ((erased spfull)) (split-full ys n ly))
  (let ((erased rlnil)) (rangele-nil ys))
  (let ((erased ys2) (erased ds2) (unique a2) (erased rel2) (erased perm2)
        (erased ps2) (erased spl2) (erased rl2) (erased heap2) (erased ly2) (erased bnd2) (erased fr2))
    (sink cnt xs0 n nfits ys ds ly bnd rel
      n (lt-succ n) q hfd
      Hx j dj ddj j dj ddj xv vx nhx (BHere j dj ddj) jn acn shx heapHx lewx
      ys (Nil (Nat)) spfull rlnil (Succ j) (Succ dj) fr a1 perm))
  (let-match many (u62-lt-dec (Zero) j u62-modulus-pos jmod) (Yes _ _ _ _ jpos)
    ((No _ _ _ _ le-jz) (let ((erased jz)) (lt-eq-succ _ _ le-jz))
      (let-match erased jz (LtZ _) (absurd (LtS _ _ z1) z1))
      (let-match erased ddj (D0))
      (values ys2 ds2 a2 rel2 perm2 ly2 bnd2 heap2)))
  (let-match erased jpos (LtZ jz))
  (let ((many j1)) (u62-dec jz j jmod))
  (let-match erased ddj (DS ja dj1 ddj1))
  (let ((erased binv1)) (binv-down ys2 n ja dj1 ddj1 heap2 fr2))
  (tail $ build-loop j1 dj1 ddj1 xs0 n nfits ys2 ds2 a2 rel2 ly2 bnd2 perm2 binv1 q hfd
    (lt-trans ja j q (lt-succ ja) jq)))
