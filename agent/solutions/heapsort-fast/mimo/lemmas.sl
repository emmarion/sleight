; work/lemmas.sl: shared erased lemmas for the certified in-place sort.
; All proofs here are erased and never run. spec.sl already provides NatLe, MkNatLe.

(def-adts
  ((GE : ((Nat) a) ((Nat) b) -> Type)
    enum
    (many MkGE : (erased (Nat) a) (erased (Nat) b) (erased (Lt b (Succ a)) p) -> (GE a b))))

(def-fns _ $ (erased le-trans : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c)
    (erased (NatLe a b) p) (erased (NatLe b c) q) -> (erased (NatLe a c) r))
  (let-match erased p (MkNatLe _ _ p1))
  (let-match erased q (MkNatLe _ _ q1))
  (MkNatLe a c (lt-le-trans a (Succ b) (Succ c) p1 (LtS b (Succ c) q1))))

(def-fns _ $ (erased ge-of-le : (erased (Nat) a) (erased (Nat) b) (subterm erased (NatLe a b) p) -> (erased (GE b a) q))
  (let-match erased p (MkNatLe _ _ p1))
  (MkGE b a p1))

(def-fns _ $ (erased le-of-lt : (erased (Nat) a) (erased (Nat) b) (subterm erased (Lt a b) p) -> (erased (NatLe a b) q))
  (MkNatLe a b (lt-weaken a b p)))

(def-fns _ $ (erased le-refl : (erased (Nat) a) -> (erased (NatLe a a) q))
  (MkNatLe a a (lt-succ a)))

(def-fns _ $ (erased perm-refl : (subterm erased (List (Nat)) xs) -> (erased (Permutation (Nat) xs xs) p))
  (match erased xs _
    ((Nil _) (PNil (Nat)))
    ((Cons _ hd tl) (PSkip (Nat) hd tl tl (perm-refl tl)))))

; perm-swap0 a b rest j nj rest2 sj: rest2 = rest with position j set to a,
; nj says rest[j] = b, so (a :: rest) and (b :: rest2) differ by one swap.
(def-fns _ $ (erased perm-swap0 : (erased (Nat) a) (erased (Nat) b) (subterm erased (List (Nat)) rest)
    (erased (Nat) j) (erased (Nth (Nat) rest j b) nj) (erased (List (Nat)) rest2) (erased (SetNth (Nat) rest j a rest2) sj)
    -> (erased (Permutation (Nat) (Cons (Nat) a rest) (Cons (Nat) b rest2)) p))
  (let-match erased sj (SetThere _ hd r1 j1 _ r2 sj1)
    ((SetHere _ _ _ r) (let-match erased nj (NthHere _ _ _)) (PSwap (Nat) a b r)))
  (let-match erased nj (NthThere _ _ _ _ _ nj1))
  (let ((erased ih)) (perm-swap0 a b r1 j1 nj1 r2 sj1))
  (PTrans (Nat) (Cons (Nat) a (Cons (Nat) hd r1)) (Cons (Nat) hd (Cons (Nat) a r1)) (Cons (Nat) b (Cons (Nat) hd r2))
    (PSwap (Nat) a hd r1)
    (PTrans (Nat) (Cons (Nat) hd (Cons (Nat) a r1)) (Cons (Nat) hd (Cons (Nat) b r2)) (Cons (Nat) b (Cons (Nat) hd r2))
      (PSkip (Nat) hd (Cons (Nat) a r1) (Cons (Nat) b r2) ih)
      (PSwap (Nat) hd b r2))))

; Mirror: rest2 = rest with position i set to b, nj says rest[i] = a.
(def-fns _ $ (erased perm-swap0-back : (erased (Nat) a) (erased (Nat) b) (subterm erased (List (Nat)) rest)
    (erased (Nat) i) (erased (Nth (Nat) rest i a) ni) (erased (List (Nat)) rest2) (erased (SetNth (Nat) rest i b rest2) si)
    -> (erased (Permutation (Nat) (Cons (Nat) b rest) (Cons (Nat) a rest2)) p))
  (let-match erased si (SetThere _ hd r1 i1 _ r2 si1)
    ((SetHere _ _ _ r) (let-match erased ni (NthHere _ _ _)) (PSwap (Nat) b a r)))
  (let-match erased ni (NthThere _ _ _ _ _ ni1))
  (let ((erased ih)) (perm-swap0-back a b r1 i1 ni1 r2 si1))
  (PTrans (Nat) (Cons (Nat) b (Cons (Nat) hd r1)) (Cons (Nat) hd (Cons (Nat) b r1)) (Cons (Nat) a (Cons (Nat) hd r2))
    (PSwap (Nat) b hd r1)
    (PTrans (Nat) (Cons (Nat) hd (Cons (Nat) b r1)) (Cons (Nat) hd (Cons (Nat) a r2)) (Cons (Nat) a (Cons (Nat) hd r2))
      (PSkip (Nat) hd (Cons (Nat) b r1) (Cons (Nat) a r2) ih)
      (PSwap (Nat) hd a r2))))

; perm-swap-at ys i j a b ni nj ys1 s1 ys2 s2: s1 sets ys[i] := b giving ys1,
; s2 sets ys1[j] := a giving ys2; so ys2 is ys with positions i and j swapped.
(def-fns _ $ (erased perm-swap-at : (subterm erased (List (Nat)) ys) (erased (Nat) i) (erased (Nat) j)
    (erased (Nat) a) (erased (Nat) b) (erased (Nth (Nat) ys i a) ni) (erased (Nth (Nat) ys j b) nj)
    (erased (List (Nat)) ys1) (erased (SetNth (Nat) ys i b ys1) s1)
    (erased (List (Nat)) ys2) (erased (SetNth (Nat) ys1 j a ys2) s2)
    -> (erased (Permutation (Nat) ys ys2) p))
  (let-match erased s1 (SetThere _ hd r1 i1 _ r1x s1x)
    ((SetHere _ _ _ r)
      (let-match erased s2 (SetThere _ _ _ j1 _ r2 s2x)
        ((SetHere _ _ _ _)
          (let-match erased nj (NthHere _ _ _))
          (let-match erased ni (NthHere _ _ _))
          (perm-refl ys)))
      (let-match erased nj (NthThere _ _ _ _ _ nj1))
      (let-match erased ni (NthHere _ _ _))
      (perm-swap0 a b r j1 nj1 r2 s2x)))
  (let-match erased s2 (SetThere _ _ _ j1 _ r2 s2x)
    ((SetHere _ _ _ _)
      (let-match erased nj (NthHere _ _ _))
      (let-match erased ni (NthThere _ _ _ _ _ ni1))
      (perm-swap0-back a b r1 i1 ni1 r1x s1x)))
  (let-match erased ni (NthThere _ _ _ _ _ ni1))
  (let-match erased nj (NthThere _ _ _ _ _ nj1))
  (PSkip (Nat) hd r1 r2 (perm-swap-at r1 i1 j1 a b ni1 nj1 r1x s1x r2 s2x)))

; ---- AllTo: all elements of xs relate to the fixed m ----

(def-fns _ $ (erased allto-nth : (erased Type A) (erased (TyCtor (A x) (A y) -> Type) R) (erased (List A) xs)
    (erased A m) (erased (AllTo A R xs m) all) (erased (Nat) i) (erased A y) (subterm erased (Nth A xs i y) nth)
    -> (erased (R y m) p))
  (let-match erased all (AllToCons _ _ x rest _ p rest-all) (absurd (AllToNil _ _ _) nth))
  (let-match erased nth (NthThere _ _ _ i1 _ nth1) ((NthHere _ _ _) p))
  (allto-nth A R rest m rest-all i1 y nth1))

; ---- Snoc: ys = xs with v appended ----
(def-adts
  ((Snoc : ((List (Nat)) xs) ((Nat) v) ((List (Nat)) ys) -> Type)
    enum
    (many SnNil : (erased (Nat) v) -> (Snoc (Nil (Nat)) v (Cons (Nat) v (Nil (Nat)))))
    (many SnCons : (erased (Nat) x) (erased (List (Nat)) xs) (erased (Nat) v) (erased (List (Nat)) ys)
       (erased (Snoc xs v ys) p) -> (Snoc (Cons (Nat) x xs) v (Cons (Nat) x ys)))))

(def-fns _ $ (erased asc-snoc : (erased (List (Nat)) ps) (erased (Nat) v) (erased (List (Nat)) ps2)
    (erased (Snoc ps v ps2) sns) (subterm erased (Ascending (Nat) NatLe ps) asc)
    (erased (AllTo (Nat) NatLe ps v) all) -> (erased (Ascending (Nat) NatLe ps2) out))
  (let-match erased sns (SnCons x xs1 v1 ys1 s1)
    ((SnNil _)
      (let-match erased asc (AscNil _ _))
      (AscOne (Nat) NatLe v)))
  (let-match erased all (AllToCons _ _ x1 rest _ px prest))
  (let-match erased s1 (SnCons y ys3 v2 ys4 s2)
    ((SnNil _)
      (let-match erased asc (AscOne _ _ _))
      (AscCons (Nat) NatLe x1 v1 (Nil (Nat)) px (AscOne (Nat) NatLe v1))))
  (let-match erased asc (AscCons _ _ _ y1 rest1 xy ascy))
  (AscCons (Nat) NatLe x1 y1 ys4 xy (asc-snoc (Cons (Nat) y1 rest1) v1 ys1 s1 ascy prest)))

; ---- Split: ys = ps ++ ss at position i ----
(def-adts
  ((Split : ((List (Nat)) ys) ((Nat) i) ((List (Nat)) ps) ((List (Nat)) ss) -> Type)
    enum
    (many SpNil : (erased (List (Nat)) ss) -> (Split ss (Zero) (Nil (Nat)) ss))
    (many SpCons : (erased (Nat) x) (erased (List (Nat)) rest) (erased (Nat) j) (erased (List (Nat)) ps)
       (erased (List (Nat)) ss) (erased (Split rest j ps ss) p)
       -> (Split (Cons (Nat) x rest) (Succ j) (Cons (Nat) x ps) ss))))

(def-fns _ $ (erased split-full-eq : (erased (List (Nat)) ys) (erased (Nat) i) (erased (List (Nat)) ps)
    (erased (List (Nat)) ss) (subterm erased (Split ys i ps ss) spl) (erased (Length (Nat) ys i) ly)
    -> (erased (Eq (List (Nat)) ys ps) e))
  (let-match erased spl (SpCons x rest j ps1 ss1 p1)
    ((SpNil _)
      (let-match erased ly (LengthNil _))
      (Refl (List (Nat)) ys)))
  (let-match erased ly (LengthCons _ _ _ _ ly1))
  (let-match erased (split-full-eq rest j ps1 ss1 p1 ly1) (Refl _ _))
  (Refl (List (Nat)) ys))

; ---- RangeLe: every element of ps is <= every element of ss ----
(def-adts
  ((RangeLe : ((List (Nat)) ps) ((List (Nat)) ss) -> Type)
    enum
    (many RLNil : (erased (List (Nat)) ss) -> (RangeLe (Nil (Nat)) ss))
    (many RLCons : (erased (Nat) p) (erased (List (Nat)) ps) (erased (List (Nat)) ss)
       (erased (AllTo (Nat) GE ss p) hd) (erased (RangeLe ps ss) rest)
       -> (RangeLe (Cons (Nat) p ps) ss))))

; ---- TailRep: ss2 is tail ss with one element replaced by the head u ----
(def-adts
  ((TailRep : ((List (Nat)) ss) ((Nat) u) ((List (Nat)) ss2) -> Type)
    enum
    (many TRSame : (erased (Nat) u) (erased (List (Nat)) ss1) -> (TailRep (Cons (Nat) u ss1) u ss1))
    (many TRSet : (erased (Nat) u) (erased (List (Nat)) ss1) (erased (Nat) t) (erased (List (Nat)) ss2)
       (erased (SetNth (Nat) ss1 t u ss2) p) -> (TailRep (Cons (Nat) u ss1) u ss2))))

(def-fns _ $ (erased allto-set : (erased (List (Nat)) ss1) (erased (Nat) t) (erased (Nat) u)
    (erased (List (Nat)) ss2) (erased (Nat) p) (erased (SetNth (Nat) ss1 t u ss2) st)
    (subterm erased (AllTo (Nat) GE ss1 p) all) (erased (GE u p) gu)
    -> (erased (AllTo (Nat) GE ss2 p) out))
  (let-match erased st (SetThere _ _ _ t1 _ ss2x st1)
    ((SetHere _ _ _ _)
      (let-match erased all (AllToCons _ _ _ rest _ pu prest))
      (AllToCons (Nat) GE u rest p gu prest)))
  (let-match erased all (AllToCons _ _ x rest _ px prest))
  (AllToCons (Nat) GE x ss2x p px (allto-set rest t1 u ss2x p st1 prest gu)))

(def-fns _ $ (erased rangele-nth : (erased (List (Nat)) ps) (erased (List (Nat)) ss)
    (erased (Nat) t) (erased (Nat) v) (subterm erased (RangeLe ps ss) rl) (erased (Nth (Nat) ss t v) nt)
    -> (erased (AllTo (Nat) NatLe ps v) out))
  (let-match erased rl (RLCons p1 ps1 ss1 hd rest)
    ((RLNil _) (AllToNil (Nat) NatLe v)))
  (let-match erased (allto-nth (Nat) GE ss1 p1 hd t v nt) (MkGE _ _ g1))
  (AllToCons (Nat) NatLe p1 ps1 v (MkNatLe p1 v g1) (rangele-nth ps1 ss1 t v rest nt)))

(def-fns _ $ (erased rangele-tail : (erased (List (Nat)) ps) (erased (List (Nat)) ss) (erased (Nat) u)
    (erased (List (Nat)) ss2) (subterm erased (RangeLe ps ss) rl) (erased (TailRep ss u ss2) trp)
    -> (erased (RangeLe ps ss2) out))
  (let-match erased trp (TRSet u1 ss1 t ss2x st)
    ((TRSame _ ssx)
      (let-match erased rl (RLCons p1 ps1 _ hd rest)
        ((RLNil _) (RLNil ss2)))
      (let-match erased hd (AllToCons _ _ _ _ _ gu prest))
      (RLCons p1 ps1 ss2 prest (rangele-tail ps1 ss u ss2 rest trp))))
  (let-match erased rl (RLCons p1 ps1 _ hd rest)
    ((RLNil _) (RLNil ss2x)))
  (let-match erased hd (AllToCons _ _ _ _ _ gu prest))
  (RLCons p1 ps1 ss2x (allto-set ss1 t u ss2x p1 st prest gu)
    (rangele-tail ps1 ss u ss2x rest trp)))

(def-fns _ $ (erased rangele-sn : (erased (List (Nat)) ps) (erased (List (Nat)) ss2) (erased (Nat) v)
    (erased (List (Nat)) ps2) (subterm erased (RangeLe ps ss2) rl) (erased (AllTo (Nat) GE ss2 v) gv)
    (erased (Snoc ps v ps2) sns) -> (erased (RangeLe ps2 ss2) out))
  (let-match erased sns (SnCons x xs1 v1 ys1 s1)
    ((SnNil _)
      (RLCons v (Nil (Nat)) ss2 gv (RLNil ss2))))
  (let-match erased rl (RLCons _ _ _ hd rest))
  (RLCons x ys1 ss2 hd (rangele-sn xs1 ss2 v1 ys1 rest gv s1)))

; ---- MinScan: v is <= the first t elements of ss ----
(def-adts
  ((MinScan : ((List (Nat)) ss) ((Nat) v) ((Nat) t) -> Type)
    enum
    (many MSNil : (erased (List (Nat)) ss) (erased (Nat) v) -> (MinScan ss v (Zero)))
    (many MSCons : (erased (Nat) w) (erased (List (Nat)) ss1) (erased (Nat) v) (erased (Nat) t)
       (erased (Lt v (Succ w)) le) (erased (MinScan ss1 v t) rest)
       -> (MinScan (Cons (Nat) w ss1) v (Succ t)))))

(def-fns _ $ (erased min-scan-keep : (erased (List (Nat)) ss) (erased (Nat) v) (erased (Nat) t)
    (subterm erased (MinScan ss v t) ms) (erased (Nat) w) (erased (Nth (Nat) ss t w) nt)
    (erased (Lt v (Succ w)) le) -> (erased (MinScan ss v (Succ t)) out))
  (let-match erased nt (NthThere _ _ _ t1 _ nt1)
    ((NthHere _ _ ssx)
      (let-match erased ms (MSNil _ _))
      (MSCons w ssx v (Zero) le (MSNil ssx v))))
  (let-match erased ms (MSCons w0 ssx v0 t0 le0 rest0))
  (MSCons w0 ssx v (Succ t1) le0 (min-scan-keep ssx v t1 rest0 w nt1 le)))

(def-fns _ $ (erased min-scan-mono : (erased (List (Nat)) ss) (erased (Nat) v) (erased (Nat) v2)
    (erased (Nat) t) (subterm erased (MinScan ss v t) ms) (erased (Lt v2 (Succ v)) lt)
    -> (erased (MinScan ss v2 t) out))
  (let-match erased ms (MSCons w ss1 v1 t1 le rest)
    ((MSNil _ _) (MSNil ss v2)))
  (let-match erased (le-trans v2 v w (MkNatLe v2 v lt) (MkNatLe v w le)) (MkNatLe _ _ lw))
  (MSCons w ss1 v2 t1 lw (min-scan-mono ss1 v v2 t1 rest lt)))

(def-fns _ $ (erased min-scan-full : (erased (List (Nat)) ss) (erased (Nat) v) (erased (Nat) t)
    (subterm erased (MinScan ss v t) ms) (erased (Length (Nat) ss t) ll)
    -> (erased (AllTo (Nat) GE ss v) out))
  (let-match erased ms (MSCons w ss1 v1 t1 le rest)
    ((MSNil _ _) (let-match erased ll (LengthNil _)) (AllToNil (Nat) GE v)))
  (let-match erased ll (LengthCons _ _ _ _ ll1))
  (AllToCons (Nat) GE w ss1 v (MkGE w v le) (min-scan-full ss1 v t1 rest ll1)))

; Nth at absolute position j = i + t reads the t-th element of the suffix ss.
(def-fns _ $ (erased split-nth : (erased (List (Nat)) ys) (erased (Nat) i) (erased (List (Nat)) ps)
    (erased (List (Nat)) ss) (subterm erased (Split ys i ps ss) spl)
    (erased (Nat) t) (erased (Nat) j) (erased (Add i t j) ad) (erased (Nat) w) (erased (Nth (Nat) ys j w) nt)
    -> (erased (Nth (Nat) ss t w) out))
  (let-match erased spl (SpCons x rest j0 ps1 ss1 p1)
    ((SpNil _)
      (let-match erased ad (AddZero _))
      nt))
  (let-match erased ad (AddSucc _ _ j1 ad1))
  (let-match erased nt (NthThere _ _ _ _ _ nt1))
  (split-nth rest j0 ps1 ss1 p1 t j1 ad1 w nt1))

; ---- counter lemmas ----

(def-fns _ $ (erased add-eq-zero : (erased (Nat) i) (erased (Nat) n) (subterm erased (Add i (Zero) n) p)
    -> (erased (Eq (Nat) i n) e))
  (let-match erased p (AddSucc i1 _ n1 q1)
    ((AddZero _) (Refl (Nat) i)))
  (let-match erased (add-eq-zero i1 n1 q1) (Refl _ _))
  (Refl (Nat) i))

(def-fns _ $ (erased add-move : (erased (Nat) i) (erased (Nat) k1) (erased (Nat) n)
    (subterm erased (Add i (Succ k1) n) p) -> (erased (Add (Succ i) k1 n) q))
  (let-match erased p (AddSucc i1 _ n1 q1)
    ((AddZero _) (AddSucc (Zero) k1 k1 (AddZero k1))))
  (AddSucc (Succ i1) k1 n1 (add-move i1 k1 n1 q1)))

(def-fns _ $ (erased add-inj-right : (erased (Nat) i) (erased (Nat) t) (erased (Nat) k) (erased (Nat) n)
    (subterm erased (Add i t n) p) (erased (Add i k n) q) -> (erased (Eq (Nat) t k) e))
  (let-match erased p (AddSucc i1 _ n1 p1)
    ((AddZero _)
      (let-match erased q (AddZero _))
      (Refl (Nat) t)))
  (let-match erased q (AddSucc _ _ _ q1))
  (let-match erased (add-inj-right i1 t k n1 p1 q1) (Refl _ _))
  (Refl (Nat) t))

; ---- length preservation ----

(def-fns _ $ (erased copies-length : (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds)
    (subterm erased (Copies (Nat) ys ds) rel) (erased (Nat) n) (erased (Length (Nat) ys n) ll)
    -> (erased (Length (Copy (Nat)) ds n) out))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1)
    ((CopiesNil _) (let-match erased ll (LengthNil _)) (LengthNil (Copy (Nat)))))
  (let-match erased ll (LengthCons _ _ _ n1 ll1))
  (LengthCons (Copy (Nat)) (MkCopy (Nat) x) cs1 n1 (copies-length rest cs1 rel1 n1 ll1)))

(def-fns _ $ (erased copies-length-back : (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds)
    (subterm erased (Copies (Nat) ys ds) rel) (erased (Nat) n) (erased (Length (Copy (Nat)) ds n) ll)
    -> (erased (Length (Nat) ys n) out))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1)
    ((CopiesNil _) (let-match erased ll (LengthNil _)) (LengthNil (Nat))))
  (let-match erased ll (LengthCons _ _ _ n1 ll1))
  (LengthCons (Nat) x rest n1 (copies-length-back rest cs1 rel1 n1 ll1)))

(def-fns _ $ (erased allto-trp : (erased (List (Nat)) ss) (erased (Nat) v) (erased (Nat) u)
    (erased (List (Nat)) ss2) (subterm erased (AllTo (Nat) GE ss v) all) (erased (TailRep ss u ss2) trp)
    -> (erased (AllTo (Nat) GE ss2 v) out))
  (let-match erased trp (TRSet u1 ss1 t ss2x st)
    ((TRSame _ ssx)
      (let-match erased all (AllToCons _ _ _ _ _ guv prest))
      prest))
  (let-match erased all (AllToCons _ _ _ _ _ guv prest))
  (allto-set ss1 t u ss2x v st prest guv))

(def-fns _ $ (erased tailrep-length : (erased (List (Nat)) ss) (erased (Nat) u) (erased (List (Nat)) ss2)
    (erased (Nat) k1) (subterm erased (TailRep ss u ss2) trp) (erased (Length (Nat) ss (Succ k1)) ll)
    -> (erased (Length (Nat) ss2 k1) out))
  (let-match erased trp (TRSet u1 ss1 t ss2x st)
    ((TRSame _ ssx)
      (let-match erased ll (LengthCons _ _ _ _ ll1))
      ll1))
  (let-match erased ll (LengthCons _ _ _ _ ll1))
  (setnth-length (Nat) ss1 t k1 u ss2x st ll1))

; If position i of xs already holds x, setting it to x again leaves every
; occurrence of x readable at the same index.
(def-fns _ $ (erased setnth-nth-same : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x)
    (erased (List A) ys) (subterm erased (SetNth A xs i x ys) st) (erased (Nat) m) (erased (Nth A xs m x) nt)
    -> (erased (Nth A ys m x) out))
  (let-match erased st (SetThere _ hd rest i1 _ ys1 st1)
    ((SetHere _ _ _ rest)
      (let-match erased nt (NthThere _ _ _ m1 _ nt1)
        ((NthHere _ _ _) (NthHere A x rest)))
      (NthThere A x rest m1 x nt1)))
  (let-match erased nt (NthThere _ _ _ m1 _ nt1)
    ((NthHere _ _ _) (NthHere A hd ys1)))
  (NthThere A hd ys1 m1 x (setnth-nth-same A rest i1 x ys1 st1 m1 nt1)))

; Translate a write on the copy list into a write on the unwrapped list.
(def-fns _ $ (erased copies-setnth : (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds)
    (subterm erased (Copies (Nat) ys ds) rel) (erased (Nat) t) (erased (Nat) u)
    (erased (List (Copy (Nat))) ds2) (erased (SetNth (Copy (Nat)) ds t (MkCopy (Nat) u) ds2) st)
    -> (erased (List (Nat)) ys2) (erased (Copies (Nat) ys2 ds2) rel2) (erased (SetNth (Nat) ys t u ys2) sy))
  (let-match erased st (SetThere _ _ _ t1 _ ds2x st1)
    ((SetHere _ _ _ _)
      (let-match erased rel (CopiesCons _ x rest cs1 rel1))
      (values (Cons (Nat) u rest) (CopiesCons (Nat) u rest cs1 rel1) (SetHere (Nat) x u rest))))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1))
  (let ((erased ys2x) (erased rel2x) (erased sy1)) (copies-setnth rest cs1 rel1 t1 u ds2x st1))
  (values (Cons (Nat) x ys2x) (CopiesCons (Nat) x ys2x ds2x rel2x) (SetThere (Nat) x rest t1 u ys2x sy1)))

; The element at position i, unwrapped, with an Nth proof on both lists.
(def-fns _ $ (erased nth-pair : (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds)
    (subterm erased (Copies (Nat) ys ds) rel) (erased (Nat) n) (erased (Length (Nat) ys n) ly)
    (erased (Nat) i) (erased (Lt i n) lt)
    -> (erased (Nat) v) (erased (Nth (Nat) ys i v) ny) (erased (Nth (Copy (Nat)) ds i (MkCopy (Nat) v)) nd))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1)
    (absurd (CopiesNil _) (let-match erased ly (LengthNil _)) lt))
  (let-match erased ly (LengthCons _ _ _ n1 ly1))
  (let-match erased i (Succ i1) ((Zero) (values x (NthHere (Nat) x rest) (NthHere (Copy (Nat)) (MkCopy (Nat) x) cs1))))
  (let-match erased lt (LtS _ _ lt1))
  (let ((erased v) (erased ny) (erased nd)) (nth-pair rest cs1 rel1 n1 ly1 i1 lt1))
  (values v (NthThere (Nat) x rest i1 v ny) (NthThere (Copy (Nat)) (MkCopy (Nat) x) cs1 i1 (MkCopy (Nat) v) nd)))

; swap-plumb: the runtime swaps positions i and m of the copy array (i <= m);
; this rebuilds the unwrapped content, the permutation, and the segment state.
(def-fns _ $ (erased swap-plumb :
    (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds) (subterm erased (Copies (Nat) ys ds) rel)
    (erased (Nat) i) (erased (Nat) m) (erased (Lt i (Succ m)) im)
    (erased (Nat) u) (erased (Nth (Nat) ys i u) ni)
    (erased (Nat) v) (erased (Nth (Nat) ys m v) nm)
    (erased (List (Copy (Nat))) ds1) (erased (SetNth (Copy (Nat)) ds i (MkCopy (Nat) v) ds1) s1)
    (erased (List (Copy (Nat))) ds2) (erased (SetNth (Copy (Nat)) ds1 m (MkCopy (Nat) u) ds2) s2)
    (erased (List (Nat)) ps) (erased (List (Nat)) ss) (erased (Split ys i ps ss) spl)
    ->
    (erased (List (Nat)) ys2) (erased (Copies (Nat) ys2 ds2) rel2)
    (erased (Permutation (Nat) ys ys2) perm)
    (erased (List (Nat)) ps2) (erased (Snoc ps v ps2) sns)
    (erased (List (Nat)) ss2) (erased (Split ys2 (Succ i) ps2 ss2) spl2)
    (erased (TailRep ss u ss2) trp))
  (let-match erased rel (CopiesCons _ x ys1 dsx rel1)
    (absurd (CopiesNil _) s1))
  (let-match erased s1 (SetThere _ _ _ i1 _ ds1x s1x)
    ((SetHere _ _ _ _)
      (let-match erased spl (SpNil _))
      (let-match erased s2 (SetThere _ _ _ m1 _ ds2x s2x)
        ((SetHere _ _ _ _)
          (let-match erased ni (NthHere _ _ _))
          (let-match erased nm (NthHere _ _ _))
          (values ys rel (perm-refl ys) (Cons (Nat) v (Nil (Nat))) (SnNil v) ys1
            (SpCons x ys1 (Zero) (Nil (Nat)) ys1 (SpNil ys1)) (TRSame u ys1))))
      (let-match erased ni (NthHere _ _ _))
      (let-match erased nm (NthThere _ _ _ m2 _ nm1))
      (let ((erased ys21) (erased rel21) (erased sy1)) (copies-setnth ys1 dsx rel1 m1 u ds2x s2x))
      (values (Cons (Nat) v ys21) (CopiesCons (Nat) v ys21 ds2x rel21)
        (perm-swap0 u v ys1 m1 nm1 ys21 sy1)
        (Cons (Nat) v (Nil (Nat))) (SnNil v) ys21
        (SpCons v ys21 (Zero) (Nil (Nat)) ys21 (SpNil ys21))
        (TRSet u ys1 m1 ys21 sy1))))
  (let-match erased s2 (SetThere _ _ _ m1 _ ds2x s2x)
    (absurd (SetHere _ _ _ _) (let-match erased im (LtS _ _ im1)) im1))
  (let-match erased spl (SpCons x2 ys1b i1b ps1 ss1 spl1))
  (let-match erased im (LtS _ _ im1))
  (let-match erased ni (NthThere _ _ _ _ _ ni1))
  (let-match erased nm (NthThere _ _ _ _ _ nm1))
  (let ((erased ys2x) (erased rel2x) (erased permx) (erased ps2x) (erased snsx) (erased ss2x) (erased spl2x) (erased trpx))
    (swap-plumb ys1 dsx rel1 i1 m1 im1 u ni1 v nm1 ds1x s1x ds2x s2x ps1 ss1 spl1))
  (values (Cons (Nat) x ys2x) (CopiesCons (Nat) x ys2x ds2x rel2x) (PSkip (Nat) x ys1 ys2x permx)
    (Cons (Nat) x ps2x) (SnCons x ps1 v ps2x snsx) ss2x
    (SpCons x ys2x (Succ i1b) ps2x ss2x spl2x) trpx))

(def-fns _ $ (erased allto-perm : (erased Type A) (erased (TyCtor (A x) (A y) -> Type) R) (erased (List A) xs)
    (erased (List A) ys) (erased A m) (subterm erased (Permutation A xs ys) p) (erased (AllTo A R xs m) all)
    -> (erased (AllTo A R ys m) out))
  (match erased p _
    ((PNil _) (let-match erased all (AllToNil _ _ _)) (AllToNil A R m))
    ((PSkip _ x xs1 ys1 p1)
      (let-match erased all (AllToCons _ _ _ _ _ px prest))
      (AllToCons A R x ys1 m px (allto-perm A R xs1 ys1 m p1 prest)))
    ((PSwap _ x1 y1 l1)
      (let-match erased all (AllToCons _ _ _ _ _ px prest1))
      (let-match erased prest1 (AllToCons _ _ _ _ _ py prest))
      (AllToCons A R y1 (Cons A x1 l1) m py (AllToCons A R x1 l1 m px prest)))
    ((PTrans _ xs1b ys1b zs1b p1b q1b)
      (let ((erased all1)) (allto-perm A R xs1b ys1b m p1b all))
      (allto-perm A R ys1b zs1b m q1b all1))))

(def-fns _ $ (erased copies-length-fn : (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds)
    (erased (Nat) n) (erased (Nat) n2) (subterm erased (Length (Nat) ys n) l1) (erased (Length (Copy (Nat)) ds n2) l2)
    (erased (Copies (Nat) ys ds) rel) -> (erased (Eq (Nat) n n2) e))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1)
    ((CopiesNil _)
      (let-match erased l1 (LengthNil _))
      (let-match erased l2 (LengthNil _))
      (Refl (Nat) n)))
  (let-match erased l1 (LengthCons _ _ _ a1 la1))
  (let-match erased l2 (LengthCons _ _ _ b1 lb1))
  (let-match erased (copies-length-fn rest cs1 a1 b1 la1 lb1 rel1) (Refl _ _))
  (Refl (Nat) n))
