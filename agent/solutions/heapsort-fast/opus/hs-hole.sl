; Sift-down with a hole: the sifted value is held aside and written once, at its final place.
; The array holds ps; the logical list xs is ps with the held value v at the hole k.

(def-fns _ $ (erased setnth-self : (erased (List Elt) xs) (erased (Nat) i) (erased Elt x) (subterm erased (Nth Elt xs i x) nx)
    -> (erased (SetNth Elt xs i x xs) r))
  (match erased nx _
    ((NthHere _ _ rest) (SetHere Elt x x rest))
    ((NthThere _ y rest i1 _ nx1) (SetThere Elt y rest i1 x rest (setnth-self rest i1 x nx1)))))

(def-fns _ $ (erased setnth-reset : (erased (List Elt) ps) (erased (Nat) k) (erased Elt y) (erased (List Elt) xs)
    (subterm erased (SetNth Elt ps k y xs) st) (erased Elt z) (erased (List Elt) zs) (erased (SetNth Elt ps k z zs) sz)
    -> (erased (SetNth Elt xs k z zs) r))
  (match erased st _
    ((SetHere _ x _ rest) (let-match erased sz (SetHere _ _ _ _)) (SetHere Elt y z rest))
    ((SetThere _ x rest k1 _ rest2 st1)
      (let-match erased sz (SetThere _ _ _ _ _ rest3 sz1))
      (SetThere Elt x rest2 k1 z rest3 (setnth-reset rest k1 y rest2 st1 z rest3 sz1)))))

; Moving the hole from k down to its child m, whose value em exceeds the held value ev.
(def-fns _ $ (erased hole-go : (erased (List Elt) ps) (erased (List Elt) xs) (erased (Nat) k) (erased Elt ev)
    (erased (SetNth Elt ps k ev xs) st)
    (erased (Nat) len) (erased (Length Elt ps len) lp) (erased (Nat) n) (erased (Lt n (Succ len)) nl)
    (erased (Nat) a) (erased (Covers xs n k a) cv) (erased (Grand xs n k a) g)
    (erased (Nat) d0) (erased (Double k d0) dd0) (erased (Lt a (Succ (Succ d0))) ka)
    (erased (Nat) f) (erased (Add k f n) kf)
    (erased (Nat) m) (erased Elt em) (erased (Nth Elt xs m em) nm) (erased (ParentOf k m) pkm) (erased (Lt m n) mn)
    (erased (Bnd xs n (Succ d0) m) b1) (erased (Bnd xs n (Succ (Succ d0)) m) b2) (erased (ULe ev em) le)
    (erased (List Elt) ps2) (erased (SetNth Elt ps k em ps2) s1)
    -> (erased (List Elt) xs2) (erased (SetNth Elt ps2 m ev xs2) s2) (erased (Length Elt ps2 len) lp2)
    (erased (Covers xs2 n m a) cv2) (erased (Grand xs2 n m a) g2)
    (erased (Nat) dm) (erased (Double m dm) ddm) (erased (Lt a (Succ (Succ dm))) ma)
    (erased (Nat) f2) (erased (Add m f2 n) mf) (erased (Lt f2 f) fl) (erased (Swap xs k m xs2) sw))
  (let ((erased km)) (parent-lt k m pkm))
  (let ((erased lp2)) (setnth-length Elt ps k len em ps2 s1 lp))
  (let ((erased lpx)) (setnth-length Elt ps k len ev xs st lp))
  (let ((erased xs2) (erased s2)) (setnth-exists Elt ps2 len m ev lp2 (lt-le-trans m n len mn nl)))
  (let ((erased nk)) (setnth-nth Elt ps k ev xs st))
  (let ((erased sw)) (MkSwap xs k m ev em ps2 xs2 nk nm km (setnth-reset ps k ev xs st em ps2 s1) s2))
  (let ((erased cv2)) (covers-swap xs n k a cv g m pkm mn xs2 sw d0 dd0 b1 b2 ev em nk nm le))
  (let ((erased g2) (erased dm) (erased ddm) (erased ma)) (grand-swap xs n k a cv m pkm xs2 sw em nm d0 dd0 ka len lpx nl))
  (let ((erased f2) (erased mf)) (sub n m (lt-weaken m n mn)))
  (values xs2 s2 lp2 cv2 g2 dm ddm ma f2 mf (fuel-step k f n kf m f2 mf km) sw))

(def-fns _ $ (many sifth : (erased (List Elt) ps) (unique (Array Elt ps) arr)
    (erased (Nat) len) (erased (Length Elt ps len) lp) (erased (Lt len max-array-length) fits)
    (many (Nat) n) (erased (Lt n (Succ len)) nl) (many (Nat) k) (erased (Lt k n) kn)
    (many (Nat) v) (erased (Lt v u62-modulus) pv) (erased (List Elt) xs)
    (erased (SetNth Elt ps k (MkCopy (U62) (MkU62 v pv)) xs) st)
    (erased (Nat) a) (erased (Covers xs n k a) cv) (erased (Grand xs n k a) g)
    (erased (Nat) d0) (erased (Double k d0) dd0) (erased (Lt a (Succ (Succ d0))) ka)
    (subterm erased (Nat) f) (erased (Add k f n) kf)
    -> (erased (List Elt) ys) (unique (Array Elt ys) r at arr) (erased (Shuf xs n ys) sh) (erased (Covers ys n n a) cv2))
  (let ((erased ev)) (MkCopy (U62) (MkU62 v pv)))
  (let ((erased nM)) (le-lt-trans n len max-array-length nl fits))
  (let ((erased kM)) (lt-trans k n max-array-length kn nM))
  (let ((erased bnd)) (idx-bound k kM d0 dd0))
  (let ((erased nmod)) (lt-trans n max-array-length u62-modulus nM max-array-length-below-u62))
  (let ((erased lmod)) (lt-trans (Succ d0) (Succ (Succ d0)) u62-modulus (lt-succ (Succ d0)) bnd))
  (let ((erased d0mod)) (lt-trans d0 (Succ d0) u62-modulus (lt-succ d0) lmod))
  (let ((erased kL)) (lt-le-trans k n len kn nl))
  (let ((erased eo) (erased no)) (nth-exists Elt ps len k lp kL))
  (let ((erased nk)) (setnth-nth Elt ps k ev xs st))
  (let ((many dk)) (u62-add k k d0 (double-add k d0 dd0) d0mod))
  (let ((many l)) (u62-inc dk lmod))
  (let-match many (u62-lt-dec l n lmod nmod) (Yes _ _ _ _ ln)
    ((No _ _ _ _ le-q) (let ((erased q)) (lt-eq-succ _ _ le-q))
      (let ((erased ps2) (unique arr2) (erased s)) (array-place-imm Elt ps arr k (MkCopy (U62) (MkU62 v pv)) eo no (ImmCopy (U62) (ImmU62))))
      (let-match erased (setnth-fn Elt ps k ev xs ps2 st s) (Refl _ _))
      (values ps2 arr2 (ShNil ps2 n)
        (covers-fill xs n k a cv d0 dd0 (BOut xs n (Succ d0) k q) (BOut xs n (Succ (Succ d0)) k (lt-weaken n (Succ (Succ d0)) q)) n))))
  (let ((erased kl)) (double-lt k d0 dd0))
  (let ((erased el0) (erased nel)) (nth-exists Elt ps len l lp (lt-le-trans l n len ln nl)))
  (let-match erased el0 (MkCopy _ ul))
  (let ((many wl) (unique arr1)) (array-get (U62) ps arr l ul nel))
  (let-match many wl (MkU62 vl pl))
  (let ((erased el)) (MkCopy (U62) (MkU62 vl pl)))
  (let ((erased nlx)) (setnth-nth-gt Elt ps k l ev el xs st nel kl))
  (let ((many r)) (u62-inc l bnd))
  (let-match many (u62-lt-dec r n bnd nmod) (Yes _ _ _ _ rn)
    ((No _ _ _ _ le-q) (let ((erased q)) (lt-eq-succ _ _ le-q))
      ; Only the left child: m = l.
      (let ((erased b1)) (BIn xs n l l el el nlx nlx (ule-refl el)))
      (let ((erased b2)) (BOut xs n r l q))
      (let-match many (u62-lt-dec v vl pv pl) (Yes _ _ _ _ vlt)
        ((No _ _ _ _ le-q2) (let ((erased q2)) (lt-eq-succ _ _ le-q2))
          (let ((erased ps2) (unique arr2) (erased s)) (array-place-imm Elt ps arr1 k (MkCopy (U62) (MkU62 v pv)) eo no (ImmCopy (U62) (ImmU62))))
          (let-match erased (setnth-fn Elt ps k ev xs ps2 st s) (Refl _ _))
          (let ((erased ule)) (ule-of-le vl pl v pv q2))
          (values ps2 arr2 (ShNil ps2 n)
            (covers-fill xs n k a cv d0 dd0 (bnd-trans xs n (Succ d0) l k b1 el ev nlx nk ule)
              (bnd-trans xs n (Succ (Succ d0)) l k b2 el ev nlx nk ule) n))))
      (let ((erased ps2) (unique arr2) (erased s1)) (array-place-imm Elt ps arr1 k (MkCopy (U62) (MkU62 vl pl)) eo no (ImmCopy (U62) (ImmU62))))
      (let ((erased xs2) (erased s2) (erased lp2) (erased cv2) (erased g2) (erased dm) (erased ddm) (erased ma)
            (erased f2) (erased mf) (erased fl) (erased sw))
        (hole-go ps xs k ev st len lp n nl a cv g d0 dd0 ka f kf l el nlx (PoL k d0 dd0) ln b1 b2
          (ule-of-le v pv vl pl (lt-weaken v vl vlt)) ps2 s1))
      (let ((erased ys) (unique rr) (erased sh) (erased cv3))
        (tail (sifth ps2 arr2 len lp2 fits n nl l ln v pv xs2 s2 a cv2 g2 dm ddm ma (subterm (lt-subterm f2 f fl)) f2 mf)))
      (values ys rr (ShCons xs n k l xs2 ys sw ln sh) cv3)))
  (let ((erased er0) (erased ner)) (nth-exists Elt ps len r lp (lt-le-trans r n len rn nl)))
  (let-match erased er0 (MkCopy _ ur))
  (let ((many wr) (unique arr3)) (array-get (U62) ps arr1 r ur ner))
  (let-match many wr (MkU62 vr pr))
  (let ((erased er)) (MkCopy (U62) (MkU62 vr pr)))
  (let ((erased nrx)) (setnth-nth-gt Elt ps k r ev er xs st ner (lt-trans k l r kl (lt-succ l))))
  (let-match many (u62-lt-dec vl vr pl pr) (Yes _ _ _ _ lr)
    ((No _ _ _ _ le-q) (let ((erased q)) (lt-eq-succ _ _ le-q))
      ; The left child is the larger: m = l.
      (let ((erased b1)) (BIn xs n l l el el nlx nlx (ule-refl el)))
      (let ((erased b2)) (BIn xs n r l er el nrx nlx (ule-of-le vr pr vl pl q)))
      (let-match many (u62-lt-dec v vl pv pl) (Yes _ _ _ _ vlt)
        ((No _ _ _ _ le-q2) (let ((erased q2)) (lt-eq-succ _ _ le-q2))
          (let ((erased ps2) (unique arr2) (erased s)) (array-place-imm Elt ps arr3 k (MkCopy (U62) (MkU62 v pv)) eo no (ImmCopy (U62) (ImmU62))))
          (let-match erased (setnth-fn Elt ps k ev xs ps2 st s) (Refl _ _))
          (let ((erased ule)) (ule-of-le vl pl v pv q2))
          (values ps2 arr2 (ShNil ps2 n)
            (covers-fill xs n k a cv d0 dd0 (bnd-trans xs n (Succ d0) l k b1 el ev nlx nk ule)
              (bnd-trans xs n (Succ (Succ d0)) l k b2 el ev nlx nk ule) n))))
      (let ((erased ps2) (unique arr2) (erased s1)) (array-place-imm Elt ps arr3 k (MkCopy (U62) (MkU62 vl pl)) eo no (ImmCopy (U62) (ImmU62))))
      (let ((erased xs2) (erased s2) (erased lp2) (erased cv2) (erased g2) (erased dm) (erased ddm) (erased ma)
            (erased f2) (erased mf) (erased fl) (erased sw))
        (hole-go ps xs k ev st len lp n nl a cv g d0 dd0 ka f kf l el nlx (PoL k d0 dd0) ln b1 b2
          (ule-of-le v pv vl pl (lt-weaken v vl vlt)) ps2 s1))
      (let ((erased ys) (unique rr) (erased sh) (erased cv3))
        (tail (sifth ps2 arr2 len lp2 fits n nl l ln v pv xs2 s2 a cv2 g2 dm ddm ma (subterm (lt-subterm f2 f fl)) f2 mf)))
      (values ys rr (ShCons xs n k l xs2 ys sw ln sh) cv3)))
  ; The right child is the larger: m = r.
  (let ((erased b1)) (BIn xs n l r el er nlx nrx (ule-of-le vl pl vr pr (lt-weaken vl vr lr))))
  (let ((erased b2)) (BIn xs n r r er er nrx nrx (ule-refl er)))
  (let-match many (u62-lt-dec v vr pv pr) (Yes _ _ _ _ vlt)
    ((No _ _ _ _ le-q2) (let ((erased q2)) (lt-eq-succ _ _ le-q2))
      (let ((erased ps2) (unique arr2) (erased s)) (array-place-imm Elt ps arr3 k (MkCopy (U62) (MkU62 v pv)) eo no (ImmCopy (U62) (ImmU62))))
      (let-match erased (setnth-fn Elt ps k ev xs ps2 st s) (Refl _ _))
      (let ((erased ule)) (ule-of-le vr pr v pv q2))
      (values ps2 arr2 (ShNil ps2 n)
        (covers-fill xs n k a cv d0 dd0 (bnd-trans xs n (Succ d0) r k b1 er ev nrx nk ule)
          (bnd-trans xs n (Succ (Succ d0)) r k b2 er ev nrx nk ule) n))))
  (let ((erased ps2) (unique arr2) (erased s1)) (array-place-imm Elt ps arr3 k (MkCopy (U62) (MkU62 vr pr)) eo no (ImmCopy (U62) (ImmU62))))
  (let ((erased xs2) (erased s2) (erased lp2) (erased cv2) (erased g2) (erased dm) (erased ddm) (erased ma)
        (erased f2) (erased mf) (erased fl) (erased sw))
    (hole-go ps xs k ev st len lp n nl a cv g d0 dd0 ka f kf r er nrx (PoR k d0 dd0) rn b1 b2
      (ule-of-le v pv vr pr (lt-weaken v vr vlt)) ps2 s1))
  (let ((erased ys) (unique rr) (erased sh) (erased cv3))
    (tail (sifth ps2 arr2 len lp2 fits n nl r rn v pv xs2 s2 a cv2 g2 dm ddm ma (subterm (lt-subterm f2 f fl)) f2 mf)))
  (values ys rr (ShCons xs n k r xs2 ys sw rn sh) cv3))

; Build phase: sift positions i, i-1, ..., 0.
(def-fns _ $ (many buildh : (erased (List Elt) ps) (unique (Array Elt ps) arr)
    (many (Nat) n) (erased (Length Elt ps n) lp) (erased (Lt n max-array-length) fits)
    (subterm many (Nat) i) (erased (Lt i n) inn) (erased (Lt i u62-modulus) im)
    (erased (Nat) d) (erased (Double i d) dd) (erased (Covers ps n n (Succ (Succ (Succ d)))) cv)
    -> (erased (List Elt) ys) (unique (Array Elt ys) r at arr) (erased (Permutation Elt ps ys) pm)
    (erased (Length Elt ys n) lp2) (erased (Covers ys n n (Succ (Zero))) cv2))
  (let ((erased cvi)) (build-step ps n i d dd cv))
  (let ((erased f) (erased kf)) (sub n i (lt-weaken i n inn)))
  (let ((erased e0) (erased ne)) (nth-exists Elt ps n i lp inn))
  (let-match erased e0 (MkCopy _ u))
  (let ((many w) (unique arr0)) (array-get (U62) ps arr i u ne))
  (let-match many w (MkU62 v pv))
  (let ((erased ys1) (unique arr1) (erased sh1) (erased cv1))
    (sifth ps arr0 n lp fits n (lt-succ n) i inn v pv ps (setnth-self ps i (MkCopy (U62) (MkU62 v pv)) ne)
      (Succ d) cvi (GLow ps n i (Succ d) (double-lt i d dd)) d dd (lt-succ (Succ d)) f kf))
  (let ((erased pm1)) (shuf-perm ps n ys1 sh1))
  (let ((erased lp1)) (shuf-length ps n ys1 sh1 n lp))
  (let-match many (u62-lt-dec (Zero) i u62-modulus-pos im) (Yes _ _ _ _ ipos)
    ((No _ _ _ _ le-i0) (let ((erased i0)) (lt-eq-succ _ _ le-i0))
      (let-match erased i0 (LtZ _) (absurd (LtS _ _ z) z))
      (let-match erased dd (D0))
      (values ys1 arr1 pm1 lp1 cv1)))
  (let-match erased ipos (LtZ i1))
  (let-match erased dd (DS _ d1 dd1))
  (let ((erased i1m)) (lt-trans i1 i u62-modulus (lt-succ i1) im))
  (let ((many i2)) (u62-dec i1 i im))
  (let ((erased ys) (unique r) (erased pm2) (erased lp2) (erased cv2))
    (tail (buildh ys1 arr1 n lp1 fits i2 (lt-trans i1 i n (lt-succ i1) inn) i1m d1 dd1 cv1)))
  (values ys r (PTrans Elt ps ys1 ys pm1 pm2) lp2 cv2))

(def-fns _ $ (many build-all : (erased (List Elt) ps) (unique (Array Elt ps) arr)
    (many (Nat) n) (erased (Length Elt ps n) lp) (erased (Lt n max-array-length) fits)
    -> (erased (List Elt) ys) (unique (Array Elt ys) r at arr) (erased (Permutation Elt ps ys) pm)
    (erased (Length Elt ys n) lp2) (erased (Covers ys n n (Succ (Zero))) cv2))
  (let ((erased nmod)) (lt-trans n max-array-length u62-modulus fits max-array-length-below-u62))
  (let-match many (u62-lt-dec 1 n hs-one-fits nmod) (Yes _ _ _ _ two)
    ((No _ _ _ _ le-small) (let ((erased small)) (lt-eq-succ _ _ le-small)) (values ps arr (perm-refl ps) lp (CEnd ps n n (Succ (Zero)) small))))
  ; Start at the last parent, n/2 - 1.
  (let ((many h) (erased v) (erased pv) (erased m) (erased r) (erased mm) (erased ad) (erased rlt) (erased hm))
    (u62-shr n 1 nmod hs-shift-one))
  (let-match erased pv (PS _ _ _ p0 dw))
  (let-match erased p0 (P0))
  (let-match erased dw (DS _ _ dw0))
  (let-match erased dw0 (D0))
  (let ((erased nm1)) (add-small m r n ad rlt))
  (let-match erased (mul2-double h m mm) (DS h1 d1 dd1) (absurd (D0) (lt-asym (Succ (Zero)) n two nm1)))
  (let ((many i0)) (u62-dec h1 h hm))
  (let ((erased i0n)) (lt-le-trans h1 m n (lt-trans h1 (Succ d1) m (double-lt h1 d1 dd1) (lt-succ (Succ d1))) (add-le-left m r n ad)))
  (tail (buildh ps arr n lp fits i0 i0n (lt-trans h1 h u62-modulus (lt-succ h1) hm) d1 dd1
    (CEnd ps n n (Succ (Succ (Succ d1))) nm1))))

; Extraction phase: the heap is the first n positions, and the rest, s, is sorted and no less than the heap.
(def-fns _ $ (many extracth : (erased (List Elt) ps) (unique (Array Elt ps) arr)
    (erased (Nat) len) (erased (Length Elt ps len) lp) (erased (Lt len max-array-length) fits)
    (subterm many (Nat) n) (erased (Lt n (Succ len)) nl) (erased (Covers ps n n (Succ (Zero))) cv)
    (erased (List Elt) s) (erased (DropN ps n s) dr) (erased (Ascending Elt ULe s) asc) (erased (Bound ps n s) bd)
    -> (erased (List Elt) ys) (unique (Array Elt ys) r at arr) (erased (Permutation Elt ps ys) pm)
    (erased (Ascending Elt ULe ys) asc2))
  (let ((erased nM)) (le-lt-trans n len max-array-length nl fits))
  (let ((erased nmod)) (lt-trans n max-array-length u62-modulus nM max-array-length-below-u62))
  (let-match many (u62-lt-dec 1 n hs-one-fits nmod) (Yes _ _ _ _ two)
    ((No _ _ _ _ le-small) (let ((erased small)) (lt-eq-succ _ _ le-small))
      (let ((erased asc2)) (match erased n (((Ascending Elt ULe ps) q))
        ((Zero) (let-match erased dr (DZ _)) asc)
        ((Succ n0)
          (let-match erased small (LtS _ _ z))
          (let-match erased z (LtZ _) (absurd (LtS _ _ z2) z2))
          (let-match erased nl (LtS _ _ nl0))
          (let ((erased x) (erased nx)) (nth-exists Elt ps len (Zero) lp nl0))
          (let-match erased (dropn-step ps (Zero) s dr x nx) (DZ _))
          (asc-push ps n s asc bd x nx (LtZ (Zero))))))
      (values ps arr (perm-refl ps) asc2)))
  (let-match erased two (LtS _ n1 n1pos))
  (let-match erased n1pos (LtZ n0))
  (let ((many n1r)) (u62-dec n1 n nmod))
  (let ((erased n1len)) (lt-le-trans n1 n len (lt-succ n1) nl))
  (let ((erased e0) (erased ne0)) (nth-exists Elt ps len (Zero) lp (lt-le-trans (Zero) n len (LtZ n1) nl)))
  (let-match erased e0 (MkCopy _ u0))
  (let ((many w0) (unique arr1)) (array-get (U62) ps arr (Zero) u0 ne0))
  (let-match many w0 (MkU62 vr pr))
  (let ((erased er)) (MkCopy (U62) (MkU62 vr pr)))
  (let ((erased e1) (erased ne1)) (nth-exists Elt ps len n1 lp n1len))
  (let-match erased e1 (MkCopy _ u1))
  (let ((many w1) (unique arr2)) (array-get (U62) ps arr1 n1r u1 ne1))
  (let-match many w1 (MkU62 vn pn))
  (let ((erased en)) (MkCopy (U62) (MkU62 vn pn)))
  (let ((erased ps1) (unique arr3) (erased s1))
    (array-place-imm Elt ps arr2 n1r (MkCopy (U62) (MkU62 vr pr)) en ne1 (ImmCopy (U62) (ImmU62))))
  (let ((erased lp1)) (setnth-length Elt ps n1 len er ps1 s1 lp))
  (let ((erased xs) (erased st)) (setnth-exists Elt ps1 len (Zero) en lp1 (lt-le-trans (Zero) n len (LtZ n1) nl)))
  (let ((erased ws) (erased r0) (erased r1)) (setnth-commute-gt Elt ps n1 (Zero) er en ps1 xs s1 st (LtZ n0)))
  (let ((erased sw)) (MkSwap ps (Zero) n1 er en ws xs ne0 ne1 (LtZ n0) r0 r1))
  (let ((erased ab)) (root-max ps n cv len lp nl er ne0))
  (let ((erased cv1)) (covers-root-shrink ps n1 (Succ (Zero)) cv (LtZ (Zero)) xs sw))
  (let ((erased nyr)) (swap-at-j ps (Zero) n1 xs sw er ne0))
  (let ((erased dr1)) (dropn-step xs n1 s (dropn-swap ps n s dr (Zero) n1 xs sw (lt-succ n1)) er nyr))
  (let ((erased asc1)) (asc-push ps n s asc bd er ne0 (LtZ n1)))
  (let ((erased bd1)) (BdCons xs n1 er s (allbelow-shrink xs n1 er (allbelow-swap ps n er ab (Zero) n1 xs sw (lt-succ n1)))))
  (let ((erased ys2) (unique arr4) (erased sh) (erased cv2))
    (sifth ps1 arr3 len lp1 fits n1r (lt-weaken n1 len n1len) (Zero) (LtZ n0) vn pn xs st
      (Succ (Zero)) cv1 (GLow xs n1 (Zero) (Succ (Zero)) (LtZ (Zero)))
      (Zero) (D0) (LtS (Zero) (Succ (Zero)) (LtZ (Zero))) n1 (AddZero n1)))
  (let ((erased s2l)) (Cons Elt er s))
  (let ((erased dr2)) (shuf-dropn xs n1 ys2 sh n1 (lt-succ n1) s2l dr1))
  (let ((erased bd2)) (shuf-bound xs n1 ys2 sh s2l bd1))
  (let ((erased lp2)) (shuf-length xs n1 ys2 sh len (swap-length ps (Zero) n1 xs sw len lp)))
  (let ((erased ys) (unique r) (erased pm) (erased asc2))
