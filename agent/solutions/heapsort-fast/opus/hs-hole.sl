  (values ys r (PTrans Elt ps xs ys (swap-perm ps (Zero) n1 xs sw) (PTrans Elt xs ys2 ys (shuf-perm xs n1 ys2 sh) pm)) asc2))

(def-fns _ $ (many heapsort-fast : (erased (List (Nat)) xs) (erased (AllTo (Nat) Lt xs u62-modulus) small)
    (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n max-array-length) fits)
    (erased (List (Copy (Nat))) cs) (unique (Array (Copy (Nat)) cs) a) (erased (Copies (Nat) xs cs) rel) ->
    (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds) (unique (Array (Copy (Nat)) ds) r at a)
    (erased (Copies (Nat) ys ds) rel2) (erased (SortedPerm (Nat) Le xs ys) correct))
  (let ((erased es) (erased w) (erased b) (erased c)) (to-u62 xs small cs rel a))
  (let ((unique arr)) (coerce a c))
  (let ((many nn) (erased lp0) (unique arr1)) (array-length Elt es arr))
  (let-match erased (length-fn (Nat) xs n nn len (wr-length xs es w nn lp0)) (Refl _ _))
  (let ((erased es1) (unique arr2) (erased pm1) (erased lp1) (erased cv1)) (build-all es arr1 nn lp0 fits))
  (let ((erased es2) (unique arr3) (erased pm2) (erased asc))
    (extracth es1 arr2 n lp1 fits nn (lt-succ n) cv1 (Nil Elt) (dropn-full es1 n lp1) (AscNil Elt ULe) (BdNil es1 n)))
  (let ((erased ys) (erased w2) (erased pmn)) (perm-from-u62 xs es es2 w (PTrans Elt es es1 es2 pm1 pm2)))
  (let ((erased ascn)) (asc-from-u62 ys es2 w2 asc))
  (let ((erased ds) (erased rel2) (erased a2) (erased c2)) (from-u62 ys es2 w2 arr3))
  (let ((unique r)) (coerce arr3 c2))
  (values ys ds r rel2 (MkSortedPerm (Nat) Le xs ys ascn pmn)))
