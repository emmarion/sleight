; Lemmas for one sift-down step.

(def-fns _ $ (erased child-bnd : (erased (List Elt) xs) (erased (Nat) n) (erased (Nat) k) (erased (Nat) c) (erased (Nat) t)
    (erased (Nat) d) (erased (Double k d) dd) (erased (ParentOf k c) pk)
    (erased (Bnd xs n (Succ d) t) b1) (erased (Bnd xs n (Succ (Succ d)) t) b2) -> (erased (Bnd xs n c t) r))
  (match erased pk _
    ((PoL _ d1 dd1) (let-match erased (double-fn k d1 d dd1 dd) (Refl _ _)) b1)
    ((PoR _ d1 dd1) (let-match erased (double-fn k d1 d dd1 dd) (Refl _ _)) b2)))

(def-fns _ $ (erased grand-up : (erased (List Elt) xs) (erased (Nat) n) (erased (Nat) k) (erased (Nat) a)
    (erased (Grand xs n k a) g) -> (erased (Grand xs n k (Succ a)) r))
  (match erased g _
    ((GLow _ _ _ _ low) (GLow xs n k (Succ a) (lt-weaken k a low)))
    ((GPar _ _ _ _ q d qk dd b1 b2) (GPar xs n k (Succ a) q d qk dd b1 b2))))

; A child of k lies beyond 2k.
(def-fns _ $ (erased child-ge : (erased (Nat) k) (erased (Nat) m) (erased (Nat) d) (erased (Double k d) dd)
    (erased (ParentOf k m) pk) -> (erased (Lt d m) r))
  (match erased pk _
    ((PoL _ d1 dd1) (let-match erased (double-fn k d1 d dd1 dd) (Refl _ _)) (lt-succ d))
    ((PoR _ d1 dd1) (let-match erased (double-fn k d1 d dd1 dd) (Refl _ _)) (lt-weaken d (Succ d) (lt-succ d)))))

; After swapping k with m, a child c of m is still no greater than m's old value, now at k.
(def-fns _ $ (erased grand-bnd : (erased (List Elt) xs) (erased (Nat) n) (erased (Nat) k) (erased (Nat) a)
    (erased (Covers xs n k a) cv) (erased (Nat) m) (erased (Nat) c) (erased (ParentOf m c) pmc)
    (erased (List Elt) ys) (erased (Swap xs k m ys) sw) (erased Elt xm) (erased (Nth Elt xs m xm) nm)
    (erased (Lt a (Succ m)) am) (erased (Lt k m) km)
    (erased (Nat) len) (erased (Length Elt xs len) lenp) (erased (Lt n (Succ len)) nl) -> (erased (Bnd ys n c k) r))
  (let-match erased (lt-dec c n) (Yes _ _ _ _ cn) ((No _ _ _ _ le-q) (let ((erased q)) (lt-eq-succ _ _ le-q)) (BOut ys n c k q)))
  (let ((erased xc) (erased nc)) (nth-exists Elt xs len c lenp (lt-le-trans c n len cn nl)))
  (let ((erased mc)) (parent-lt m c pmc))
  (let ((erased le)) (covers-lookup xs n k a cv c (lt-trans a (Succ m) (Succ c) am (LtS m c mc)) cn m pmc (NeG m k km)
    xc xm nc nm))
  (BIn ys n c k xc xm (swap-other xs k m ys sw c xc nc (NeG c k (lt-trans k m c km mc)) (NeG c m mc))
    (swap-at-i xs k m ys sw xm nm) le))

(def-fns _ $ (erased grand-swap : (erased (List Elt) xs) (erased (Nat) n) (erased (Nat) k) (erased (Nat) a)
    (erased (Covers xs n k a) cv) (erased (Nat) m) (erased (ParentOf k m) pkm)
    (erased (List Elt) ys) (erased (Swap xs k m ys) sw) (erased Elt xm) (erased (Nth Elt xs m xm) nm)
    (erased (Nat) d) (erased (Double k d) dd) (erased (Lt a (Succ (Succ d))) ka)
    (erased (Nat) len) (erased (Length Elt xs len) lenp) (erased (Lt n (Succ len)) nl)
    -> (erased (Grand ys n m a) g) (erased (Nat) dm) (erased (Double m dm) ddm) (erased (Lt a (Succ (Succ dm))) ma))
  (let ((erased dm) (erased ddm)) (double m))
  (let ((erased dlm)) (child-ge k m d dd pkm))
  (let ((erased am)) (lt-le-trans a (Succ (Succ d)) (Succ m) ka (LtS (Succ d) (Succ m) (LtS d m dlm))))
  (let ((erased km)) (parent-lt k m pkm))
  (let ((erased ma)) (lt-le-trans a (Succ m) (Succ (Succ dm)) am (LtS m (Succ (Succ dm)) (lt-weaken m (Succ dm) (double-lt m dm ddm)))))
  (values
    (GPar ys n m a k dm pkm ddm
      (grand-bnd xs n k a cv m (Succ dm) (PoL m dm ddm) ys sw xm nm am km len lenp nl)
      (grand-bnd xs n k a cv m (Succ (Succ dm)) (PoR m dm ddm) ys sw xm nm am km len lenp nl))
    dm ddm ma))

; One step of sifting: swap k with its larger child m, which exceeds it.
(def-fns _ $ (erased covers-swap : (erased (List Elt) xs) (erased (Nat) n) (erased (Nat) k) (erased (Nat) a)
    (subterm erased (Covers xs n k a) cv) (erased (Grand xs n k a) g)
    (erased (Nat) m) (erased (ParentOf k m) pkm) (erased (Lt m n) mn) (erased (List Elt) ys) (erased (Swap xs k m ys) sw)
    (erased (Nat) d) (erased (Double k d) dd) (erased (Bnd xs n (Succ d) m) bm1) (erased (Bnd xs n (Succ (Succ d)) m) bm2)
    (erased Elt xk) (erased Elt xm) (erased (Nth Elt xs k xk) nk) (erased (Nth Elt xs m xm) nm) (erased (ULe xk xm) le)
    -> (erased (Covers ys n m a) r))
  (let ((erased nyk)) (swap-at-i xs k m ys sw xm nm))
  (let-match erased cv (COk _ _ _ _ p x y pa an na np lexy rest)
    ((CEnd _ _ _ _ out) (CEnd ys n m a out))
    ((CSkip _ _ _ _ pk an rest)
      (let ((erased tl)) (covers-swap xs n k (Succ a) rest (grand-up xs n k a g) m pkm mn ys sw d dd bm1 bm2 xk xm nk nm le))
      (let-match erased (eq-or-ne a m) (IsNe _ _ am)
        ((IsEq _) (COk ys n m a k xk xm pk an (swap-at-j xs k m ys sw xk nk) nyk le tl)))
      (let ((erased b)) (child-bnd xs n k a m d dd pk bm1 bm2))
      (let-match erased b (BIn _ _ _ _ xc y2 nc nm2 lec) (absurd (BOut _ _ _ _ out) (lt-asym a n an out)))
      (let-match erased (nth-fn Elt xs m y2 xm nm2 nm) (Refl _ _))
      (COk ys n m a k xc xm pk an (swap-other xs k m ys sw a xc nc (ne-of-gt a k (parent-lt k a pk)) am) nyk lec tl)))
  (let ((erased tl)) (covers-swap xs n k (Succ a) rest (grand-up xs n k a g) m pkm mn ys sw d dd bm1 bm2 xk xm nk nm le))
  (let-match erased (eq-or-ne p m) (IsNe _ _ pm)
    ((IsEq _) (CSkip ys n m a pa an tl)))
  (let-match erased (eq-or-ne p k) (IsNe _ _ pk)
    ((IsEq _)
      (let-match erased (nth-fn Elt xs k y xk np nk) (Refl _ _))
      (let-match erased (eq-or-ne a m) (IsNe _ _ am)
        ((IsEq _) (COk ys n m a k xk xm pa an (swap-at-j xs k m ys sw xk nk) nyk le tl)))
      (COk ys n m a k x xm pa an (swap-other xs k m ys sw a x na (ne-of-gt a k (parent-lt k a pa)) am) nyk
        (ule-trans x xk xm lexy le) tl)))
  (let ((erased npy)) (swap-other xs k m ys sw p y np pk pm))
  (let-match erased (eq-or-ne a k) (IsNe _ _ ak)
    ((IsEq _)
      (let-match erased g (GPar _ _ _ _ q d2 qk dd2 b1 b2) (absurd (GLow _ _ _ _ low) (lt-irrefl k low)))
      (let-match erased (parent-fn q p k qk pa) (Refl _ _))
      (let ((erased b)) (child-bnd xs n k m p d2 dd2 pkm b1 b2))
      (let-match erased b (BIn _ _ _ _ xm2 y2 nm2 np2 lemp) (absurd (BOut _ _ _ _ out) (lt-asym m n mn out)))
      (let-match erased (nth-fn Elt xs m xm2 xm nm2 nm) (Refl _ _))
      (let-match erased (nth-fn Elt xs p y2 y np2 np) (Refl _ _))
      (COk ys n m k p xm y pa an nyk npy lemp tl)))
  (let-match erased (eq-or-ne a m) (IsNe _ _ am)
    (absurd (IsEq _) (let-match erased (parent-fn k p m pkm pa) (Refl _ _)) (ne-irrefl k pk)))
  (COk ys n m a p x y pa an (swap-other xs k m ys sw a x na ak am) npy lexy tl))
