; Standalone end-to-end regression program, compiled after distance.sl.
; Text constants are assembled at compile time, outside the measurement.
(let ((erased ed-reg-empty-xs) (unique ed-reg-empty-u) (erased _)) (str-bytes-copy ""))
(let ((many ed-reg-empty-b)) (share ed-reg-empty-u))
(let ((many ed-reg-empty-n) (erased ed-reg-empty-len)) (bytes-length-many _ ed-reg-empty-b))
(let ((many ed-reg-empty)) (MkText _ ed-reg-empty-b ed-reg-empty-n ed-reg-empty-len (prove-literal-lt ed-reg-empty-n 18014398509481984)))
(let ((erased ed-reg-a-xs) (unique ed-reg-a-u) (erased _)) (str-bytes-copy "a"))
(let ((many ed-reg-a-b)) (share ed-reg-a-u))
(let ((many ed-reg-a-n) (erased ed-reg-a-len)) (bytes-length-many _ ed-reg-a-b))
(let ((many ed-reg-a)) (MkText _ ed-reg-a-b ed-reg-a-n ed-reg-a-len (prove-literal-lt ed-reg-a-n 18014398509481984)))
(let ((erased ed-reg-upper-xs) (unique ed-reg-upper-u) (erased _)) (str-bytes-copy "A"))
(let ((many ed-reg-upper-b)) (share ed-reg-upper-u))
(let ((many ed-reg-upper-n) (erased ed-reg-upper-len)) (bytes-length-many _ ed-reg-upper-b))
(let ((many ed-reg-upper)) (MkText _ ed-reg-upper-b ed-reg-upper-n ed-reg-upper-len (prove-literal-lt ed-reg-upper-n 18014398509481984)))
(let ((erased ed-reg-ab-xs) (unique ed-reg-ab-u) (erased _)) (str-bytes-copy "ab"))
(let ((many ed-reg-ab-b)) (share ed-reg-ab-u))
(let ((many ed-reg-ab-n) (erased ed-reg-ab-len)) (bytes-length-many _ ed-reg-ab-b))
(let ((many ed-reg-ab)) (MkText _ ed-reg-ab-b ed-reg-ab-n ed-reg-ab-len (prove-literal-lt ed-reg-ab-n 18014398509481984)))
(let ((erased ed-reg-ba-xs) (unique ed-reg-ba-u) (erased _)) (str-bytes-copy "ba"))
(let ((many ed-reg-ba-b)) (share ed-reg-ba-u))
(let ((many ed-reg-ba-n) (erased ed-reg-ba-len)) (bytes-length-many _ ed-reg-ba-b))
(let ((many ed-reg-ba)) (MkText _ ed-reg-ba-b ed-reg-ba-n ed-reg-ba-len (prove-literal-lt ed-reg-ba-n 18014398509481984)))
(let ((erased ed-reg-ca-xs) (unique ed-reg-ca-u) (erased _)) (str-bytes-copy "CA"))
(let ((many ed-reg-ca-b)) (share ed-reg-ca-u))
(let ((many ed-reg-ca-n) (erased ed-reg-ca-len)) (bytes-length-many _ ed-reg-ca-b))
(let ((many ed-reg-ca)) (MkText _ ed-reg-ca-b ed-reg-ca-n ed-reg-ca-len (prove-literal-lt ed-reg-ca-n 18014398509481984)))
(let ((erased ed-reg-abc-xs) (unique ed-reg-abc-u) (erased _)) (str-bytes-copy "ABC"))
(let ((many ed-reg-abc-b)) (share ed-reg-abc-u))
(let ((many ed-reg-abc-n) (erased ed-reg-abc-len)) (bytes-length-many _ ed-reg-abc-b))
(let ((many ed-reg-abc)) (MkText _ ed-reg-abc-b ed-reg-abc-n ed-reg-abc-len (prove-literal-lt ed-reg-abc-n 18014398509481984)))
(let ((erased ed-reg-kitten-xs) (unique ed-reg-kitten-u) (erased _)) (str-bytes-copy "kitten"))
(let ((many ed-reg-kitten-b)) (share ed-reg-kitten-u))
(let ((many ed-reg-kitten-n) (erased ed-reg-kitten-len)) (bytes-length-many _ ed-reg-kitten-b))
(let ((many ed-reg-kitten)) (MkText _ ed-reg-kitten-b ed-reg-kitten-n ed-reg-kitten-len (prove-literal-lt ed-reg-kitten-n 18014398509481984)))
(let ((erased ed-reg-sitting-xs) (unique ed-reg-sitting-u) (erased _)) (str-bytes-copy "sitting"))
(let ((many ed-reg-sitting-b)) (share ed-reg-sitting-u))
(let ((many ed-reg-sitting-n) (erased ed-reg-sitting-len)) (bytes-length-many _ ed-reg-sitting-b))
(let ((many ed-reg-sitting)) (MkText _ ed-reg-sitting-b ed-reg-sitting-n ed-reg-sitting-len (prove-literal-lt ed-reg-sitting-n 18014398509481984)))

(def-fns _ $ (many ed-reg-equals : (erased (List (U8)) xs) (many (Text xs) s)
    (erased (List (U8)) ys) (many (Text ys) t) (many (Nat) expected) (erased (Lt expected u62-modulus) pe) -> (many (Bool) ok))
  (let ((many d) (erased dist)) (edit-distance-fast xs s ys t))
  (let ((erased nx) (erased lx) (erased fx) (erased _)) (ed-text-length xs s))
  (let ((erased ny) (erased ly) (erased fy) (erased _)) (ed-text-length ys t))
  (let ((erased pd)) (lt-trans d ed-value-limit u62-modulus (ed-dist-small xs ys d dist nx ny lx ly fx fy) ed-value-limit-fit))
  (match many (u62-cmp d expected pd pe) (((Bool) _))
    ((CEq _ _ _) (BTrue)) ((CLt _ _ _ _ _) (BFalse)) ((CGt _ _ _ _ _) (BFalse))))

; Stop on the first failed case. The swapped-pair case CA/ABC distinguishes
; optimal string alignment from unrestricted Damerau-Levenshtein distance.
(def-fns _ $ (many ed-reg-suite : -> (many (Bool) ok))
  (let-match many (ed-reg-equals _ ed-reg-empty _ ed-reg-empty 0 u62-modulus-pos) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-empty _ ed-reg-abc 6 (prove-literal-lt 6 4611686018427387904)) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-abc _ ed-reg-empty 6 (prove-literal-lt 6 4611686018427387904)) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-a _ ed-reg-upper 1 (prove-literal-lt 1 4611686018427387904)) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-ab _ ed-reg-ba 2 (prove-literal-lt 2 4611686018427387904)) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-ca _ ed-reg-abc 6 (prove-literal-lt 6 4611686018427387904)) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-abc _ ed-reg-ca 6 (prove-literal-lt 6 4611686018427387904)) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-ab _ ed-reg-ab 0 u62-modulus-pos) (BTrue) (else (BFalse)))
  (let-match many (ed-reg-equals _ ed-reg-ab _ ed-reg-a 2 (prove-literal-lt 2 4611686018427387904)) (BTrue) (else (BFalse)))
  (ed-reg-equals _ ed-reg-kitten _ ed-reg-sitting 6 (prove-literal-lt 6 4611686018427387904)))

(def-lvl EdRegression)
(def-unique EdRegression $ (unique ed-reg-start : (unique (World) w at vacant-slot) -> (unique (World) out at w) (unique (Program EdRegression) next))
  (let-match many (ed-reg-suite) (BTrue)
    ((BFalse)
      (let ((unique w1) (many _)) (world-do _ w (WriteOut "FAIL edit-distance regression\n")))
      (values w1 (Exit EdRegression (MkU8 1 (prove-literal-lt 1 u8-modulus))))))
  (let ((unique w1) (many _)) (world-do _ w (WriteOut "ok: 10 edit-distance regressions\n")))
  (values w1 (Exit EdRegression (MkU8 0 u8-modulus-pos))))
(Continue EdRegression ed-reg-start)
