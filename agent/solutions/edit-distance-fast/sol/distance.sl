; Rotate exactly three arrays as each new source row is completed.
(def-fns _ $ (many ed-distance-loop :
    (erased (List (U8)) whole) (many (Bytes whole) source) (erased (Nat) nx)
    (erased (Length (U8) whole nx) lx) (erased (Lt nx max-array-length) fx)
    (erased (List (U8)) ys) (many (Bytes ys) target) (many (Nat) n)
    (erased (Length (U8) ys n) len) (erased (Lt n max-array-length) fits)
    (subterm many (Nat) i) (erased (Lt i (Succ nx)) in)
    (erased (List (U8)) xs) (erased (EdSuffix (U8) whole i xs) suffix)
    (erased (List (Copy (U62))) old1) (erased (EdRow xs ys old1) row1) (unique (Array (Copy (U62)) old1) prev1)
    (many (U8) x2) (many (Bool) has-x) (erased (List (Copy (U62))) old2)
    (erased (EdPrevious xs ys old2 x2 has-x) previous) (unique (Array (Copy (U62)) old2) prev2)
    (erased (Length (Copy (U62)) old2 (Succ n)) old2-length)
    (erased (List (Copy (U62))) cells) (unique (Array (Copy (U62)) cells) buf)
    (erased (Length (Copy (U62)) cells (Succ n)) buffer-length)
    (many (Nat) bd) (erased (Dist xs (Nil (U8)) bd) boundary) (erased (Lt bd ed-value-limit) bd-small) ->
    (many (Nat) d) (erased (Dist whole ys d) dist))
  (let ((erased ip)) (lt-le-trans i (Succ nx) u62-modulus in
    (LtS nx u62-modulus (lt-trans nx max-array-length u62-modulus fx max-array-length-below-u62))))
  (let-match many (u62-lt-dec 0 i u62-modulus-pos ip) (Yes _ _ _ _ pos)
    ((No _ _ _ _ le-iz) (let ((erased iz)) (le-lt-succ _ _ le-iz))
      (let-match erased iz (LtZ _) (absurd (LtS _ _ bad) bad))
      (let-match erased suffix (EdSuffixHere _ _))
      (let ((many d) (erased dist) (erased _) (unique _)) (ed-row-get xs ys old1 row1 prev1 0 ys (EdSuffixHere (U8) ys)))
      (values d dist)))
  (let-match erased pos (LtZ k))
  (let ((many j)) (u62-dec k i ip))
  (let ((erased x) (erased source-prev)) (ed-suffix-prev (U8) whole k xs suffix))
  (let ((many byte)) (bytes-get-many whole source j x (ed-suffix-nth (U8) whole k x xs source-prev)))
  (let ((erased m) (erased lm) (erased pm)) (ed-suffix-small-length whole nx lx fx k (Cons _ x xs) source-prev))
  (let ((erased updated) (unique out) (erased row) (unique prev1a) (unique prev2a)
      (many new-bd) (erased new-boundary) (erased new-bd-small))
    (ed-build-row byte xs m lm pm ys target n len fits old1 row1 prev1 x2 has-x old2 previous prev2
      cells buf buffer-length bd boundary bd-small))
  (let-match erased in (LtS _ _ kn))
  (tail (ed-distance-loop whole source nx lx fx ys target n len fits j (lt-weaken k nx kn) (Cons _ x xs) source-prev
    updated row out byte (BTrue) old1 (EdPreviousCons x xs ys old1 row1) prev1a (ed-row-length xs ys old1 row1 n len)
    old2 prev2a old2-length new-bd new-boundary new-bd-small)))

(def-fns _ $ (many edit-distance-fast : (erased (List (U8)) xs) (many (Text xs) s)
    (erased (List (U8)) ys) (many (Text ys) t) -> (many (Nat) d) (erased (Dist xs ys d) dist))
  (let ((many nx) (erased lx) (erased fx) (erased px)) (ed-text-length xs s))
  (let ((many n) (erased len) (erased fits) (erased pn)) (ed-text-length ys t))
  (let-match many (u62-lt-dec 0 nx u62-modulus-pos px) (Yes _ _ _ _ _)
    ((No _ _ _ _ le-iz) (let ((erased iz)) (le-lt-succ _ _ le-iz))
      (let-match erased iz (LtZ _) (absurd (LtS _ _ bad) bad))
      (let-match erased lx (LengthNil _))
      (let ((many d) (erased dist) (erased _)) (ed-boundary-left ys t))
      (values d dist)))
  (let-match many (u62-lt-dec 0 n u62-modulus-pos pn) (Yes _ _ _ _ _)
    ((No _ _ _ _ le-iz) (let ((erased iz)) (le-lt-succ _ _ le-iz))
      (let-match erased iz (LtZ _) (absurd (LtS _ _ bad) bad))
      (let-match erased len (LengthNil _))
      (let ((many d) (erased dist) (erased _)) (ed-boundary-right xs s))
      (values d dist)))
  (let-match many s (MkText _ source _ _ _))
  (let-match many t (MkText _ target _ _ _))
  (let ((erased old1) (unique prev1) (erased row1)) (ed-initial-row ys n len fits))
  (let ((many count)) (u62-inc n (ed-succ-length-fit n fits)))
  (let ((erased old2) (unique prev2) (erased rep2)) (array-make (U62) count (MkU62 0 u62-modulus-pos)))
  (let ((erased cells) (unique buf) (erased rep)) (array-make (U62) count (MkU62 0 u62-modulus-pos)))
  (ed-distance-loop xs source nx lx fx ys target n len fits nx (lt-succ nx) (Nil _) (ed-suffix-end (U8) xs nx lx)
    old1 row1 prev1 (MkU8 0 u8-modulus-pos) (BFalse) old2 (EdPreviousNil ys old2 (MkU8 0 u8-modulus-pos)) prev2
    (repeat-length _ _ _ _ rep2) cells buf (repeat-length _ _ _ _ rep)
    0 (DistNil) (prove-literal-lt 0 1152921504606846976)))

(qed (MkEditDistance _ edit-distance-fast))
