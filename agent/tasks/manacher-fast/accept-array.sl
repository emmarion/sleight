(def-fns _ $ (many accept-array : (erased (List (Nat)) xs) (erased (AllBelow xs u62-modulus) small)
    (erased (Nat) len) (unique (Array (Copy (Nat)) len) a) (erased (ArrayIsList (Nat) xs len a) rel)
    (erased (Lt len u62-modulus) fits) -> (many (Nat) n) (erased (LongestPalindrome xs n) correct))
  (let ((many n) (erased correct)) (longest-palindrome-fast xs small len a rel fits))
  (values n correct))
