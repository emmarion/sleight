(def-fns _ $ (erased u62-list-witness : (erased (List (Nat)) xs) (subterm erased (AllTo (Nat) Lt xs u62-modulus) small) ->
    (erased (List (U62)) us)
    (erased (Coercible (Shared) (List (Nat)) xs (Shared) (List (U62)) us) c))
  (let-match erased small (AllToCons _ _ x rest _ p small1)
    ((AllToNil _ _ _) (values (Nil (U62)) (coercible-ctor (Shared) Nil (Nat) (U62)))))
  (let ((erased us1) (erased c1)) (u62-list-witness rest small1))
  (values (Cons (U62) (MkU62 x p) us1)
          (coercible-ctor (Shared) Cons (Nat) (U62) (coercible-wrap (Shared) MkU62 x p) c1)))

(def-adts
  ((Ne : ((Nat) a) ((Nat) b) -> Type)
    enum
    (many NeLt : (erased (Nat) a) (erased (Nat) b) (erased (Lt a b) p) -> (Ne a b))
    (many NeGt : (erased (Nat) a) (erased (Nat) b) (erased (Lt b a) p) -> (Ne a b))))

(def-adts
  ((LoOk : ((List (Nat)) xs) ((Nat) lo) ((Nat) k) -> Type)
    enum
    (many LoZero : (erased (List (Nat)) xs) (erased (Nat) k) -> (LoOk xs (Zero) k))
    (many LoAt : (erased (List (Nat)) xs) (erased (Nat) i) (erased (Nat) y) (erased (Nat) k)
        (erased (Nth (Nat) xs i y) nth) (erased (Lt y k) lt) -> (LoOk xs (Succ i) k))))

(def-adts
  ((HiOk : ((List (Nat)) xs) ((Nat) n) ((Nat) hi) ((Nat) k) -> Type)
    enum
    (many HiEnd : (erased (List (Nat)) xs) (erased (Nat) n) (erased (Nat) k) -> (HiOk xs n n k))
    (many HiAt : (erased (List (Nat)) xs) (erased (Nat) n) (erased (Nat) i) (erased (Nat) y) (erased (Nat) k)
        (erased (Nth (Nat) xs i y) nth) (erased (Lt k y) lt) -> (HiOk xs n i k))))

(def-adts
  ((Search : ((List (Nat)) xs) ((Nat) k) -> Type)
    enum
    (many Found : (erased (List (Nat)) xs) (erased (Nat) k) (many (Nat) i) (erased (Nth (Nat) xs i k) nth)
        -> (Search xs k))
    (many Absent : (erased (List (Nat)) xs) (erased (Nat) k) (erased (AllTo (Nat) Ne xs k) none)
        -> (Search xs k))))

(def-fns _ $ (erased add-shift : (erased (Nat) lo) (erased (Nat) m) (erased (Nat) mid) (erased (Nat) r) (erased (Nat) w)
    (erased (Nat) hi) (subterm erased (Add lo m mid) am) (erased (Add (Succ m) r w) amr) (erased (Add lo w hi) aw)
    -> (erased (Add (Succ mid) r hi) q))
  (let-match erased am (AddSucc lo1 _ mid1 am1) ((AddZero _) (let-match erased aw (AddZero _)) amr))
  (let-match erased aw (AddSucc _ _ hi1 aw1))
  (AddSucc (Succ mid1) r hi1 (add-shift lo1 m mid1 r w hi1 am1 amr aw1)))

(def-fns _ $ (erased add-lt-mono : (erased (Nat) lo) (erased (Nat) m) (erased (Nat) mid) (erased (Nat) w) (erased (Nat) hi)
    (subterm erased (Add lo m mid) am) (erased (Add lo w hi) aw) (erased (Lt m w) lt) -> (erased (Lt mid hi) q))
  (let-match erased am (AddSucc lo1 _ mid1 am1) ((AddZero _) (let-match erased aw (AddZero _)) lt))
  (let-match erased aw (AddSucc _ _ hi1 aw1))
  (LtS mid1 hi1 (add-lt-mono lo1 m mid1 w hi1 am1 aw1 lt)))

(def-fns _ $ (erased nth-exists : (erased (List (Nat)) xs) (erased (Nat) n) (subterm erased (Length (Nat) xs n) l)
    (erased (Nat) i) (erased (Lt i n) lt) -> (erased (Nat) x) (erased (Nth (Nat) xs i x) p))
  (let-match erased l (LengthCons _ y rest n1 l1) (absurd (LengthNil _) lt))
  (let-match erased i (Succ i1) ((Zero) (values y (NthHere _ _ _))))
  (let-match erased lt (LtS _ _ lt1))
  (let ((erased x) (erased p)) (nth-exists rest n1 l1 i1 lt1))
  (values x (NthThere _ _ _ _ _ p)))

(def-fns _ $ (erased asc-head-le : (erased (Nat) x) (erased (List (Nat)) rest) (erased (Ascending (Nat) Le (Cons (Nat) x rest)) asc)
    (erased (Nat) i) (erased (Nat) y) (subterm erased (Nth (Nat) (Cons (Nat) x rest) i y) nth) -> (erased (Lt x (Succ y)) le))
  (let-match erased nth (NthThere _ _ _ i1 _ nth1) ((NthHere _ _ _) (lt-succ x)))
  (let-match erased asc (AscCons _ _ _ z rest1 xz asc1) (absurd (AscOne _ _ _) (match erased nth1 _)))
  (let-match erased xz (MkLe _ _ xz1))
  (let ((erased zy)) (asc-head-le z rest1 asc1 i1 y nth1))
  (lt-le-trans x (Succ z) (Succ y) xz1 (LtS z (Succ y) zy)))

(def-fns _ $ (erased all-above : (erased (Nat) y) (erased (List (Nat)) rest) (erased (Nat) k)
    (subterm erased (Ascending (Nat) Le (Cons (Nat) y rest)) asc) (erased (Lt k y) ky)
    -> (erased (AllTo (Nat) Ne (Cons (Nat) y rest) k) none))
  (let-match erased asc (AscCons _ _ _ z rest1 yz asc1)
    ((AscOne _ _ _) (AllToCons (Nat) Ne y (Nil (Nat)) k (NeGt y k ky) (AllToNil (Nat) Ne k))))
  (let-match erased yz (MkLe _ _ yz1))
  (AllToCons (Nat) Ne y rest k (NeGt y k ky) (all-above z rest1 k asc1 (lt-le-trans k y z ky yz1))))

(def-fns _ $ (erased absent : (erased (List (Nat)) xs) (erased (Ascending (Nat) Le xs) asc) (erased (Nat) n)
    (subterm erased (Length (Nat) xs n) len) (erased (Nat) g) (erased (Nat) k)
    (erased (LoOk xs g k) lok) (erased (HiOk xs n g k) hok) -> (erased (AllTo (Nat) Ne xs k) none))
  (let-match erased lok (LoAt _ g1 y _ nth yk)
    ((LoZero _ _)
      (let-match erased hok (HiAt _ _ _ z _ nth0 kz)
        ((HiEnd _ _ _) (let-match erased len (LengthNil _)) (AllToNil (Nat) Ne k)))
      (let-match erased nth0 (NthHere _ _ rest))
      (all-above z rest k asc kz)))
  (let-match erased len (LengthCons _ x rest n1 len1) (absurd (LengthNil _) nth))
  (let ((erased xy)) (asc-head-le x rest asc g1 y nth))
  (let ((erased xk)) (lt-le-trans x (Succ y) k xy (LtS y k yk)))
  (let ((erased asc1)) (match erased asc (((Ascending (Nat) Le rest) a))
    ((AscOne _ _ _) (AscNil (Nat) Le))
    ((AscCons _ _ _ _ _ _ a1) a1)))
  (let ((erased lok1)) (match erased nth (((LoOk rest g1 k) l))
    ((NthHere _ _ _) (LoZero rest k))
    ((NthThere _ _ _ g2 _ nth1) (LoAt rest g2 y k nth1 yk))))
  (let ((erased hok1)) (match erased hok (((HiOk rest n1 g1 k) h))
    ((HiEnd _ _ _) (HiEnd rest n1 k))
    ((HiAt _ _ _ z _ nth2 kz) (let-match erased nth2 (NthThere _ _ _ _ _ nth3)) (HiAt rest n1 g1 z k nth3 kz))))
  (AllToCons (Nat) Ne x rest k (NeLt x k xk) (absent rest asc1 n1 len1 g1 k lok1 hok1)))

(def-fns _ $ (erased copies-nth : (erased (List (Nat)) xs) (erased (List (Copy (Nat))) cs) (erased (Copies (Nat) xs cs) rel)
    (erased (Nat) i) (erased (Nat) y) (subterm erased (Nth (Nat) xs i y) nth) -> (erased (Nth (Copy (Nat)) cs i (MkCopy (Nat) y)) cnth))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1) (absurd (CopiesNil _) nth))
  (let-match erased nth (NthThere _ _ _ i1 _ nth1) ((NthHere _ _ _) (NthHere (Copy (Nat)) (MkCopy (Nat) x) cs1)))
  (NthThere (Copy (Nat)) (MkCopy (Nat) x) cs1 i1 (MkCopy (Nat) y) (copies-nth rest cs1 rel1 i1 y nth1)))

(def-fns _ $ (erased copies-length : (erased (List (Nat)) xs) (erased (List (Copy (Nat))) cs) (subterm erased (Copies (Nat) xs cs) rel)
    (erased (Nat) n) (erased (Length (Copy (Nat)) cs n) clen) -> (erased (Length (Nat) xs n) len))
  (let-match erased rel (CopiesCons _ x rest cs1 rel1) ((CopiesNil _) (let-match erased clen (LengthNil _)) (LengthNil (Nat))))
  (let-match erased clen (LengthCons _ _ _ n1 clen1))
  (LengthCons (Nat) x rest n1 (copies-length rest cs1 rel1 n1 clen1)))

(def-fns _ $ (erased allto-nth : (erased Type A) (erased (TyCtor (A x) (A y) -> Type) R) (erased (List A) xs) (erased A m)
    (erased (AllTo A R xs m) all) (erased (Nat) i) (erased A y) (subterm erased (Nth A xs i y) nth) -> (erased (R y m) p))
  (let-match erased all (AllToCons _ _ x rest _ p rest-all) (absurd (AllToNil _ _ _) nth))
  (let-match erased nth (NthThere _ _ _ i1 _ nth1) ((NthHere _ _ _) p))
  (allto-nth A R rest m rest-all i1 y nth1))

(def-fns _ $ (erased length-fn : (erased (List (Nat)) xs) (erased (Nat) a) (erased (Nat) b)
    (subterm erased (Length (Nat) xs a) la) (erased (Length (Nat) xs b) lb) -> (erased (Eq (Nat) a b) e))
  (let-match erased la (LengthCons _ x rest a1 la1) ((LengthNil _) (let-match erased lb (LengthNil _)) (Refl (Nat) a)))
  (let-match erased lb (LengthCons _ _ _ b1 lb1))
  (let-match erased (length-fn rest a1 b1 la1 lb1) (Refl _ _))
  (Refl (Nat) a))

(let ((many bs-two)) (Succ (Succ (Zero))))
(let ((many bs-two-cmp)) (nat-cmp bs-two u62m))
(comptime-match many bs-two-cmp (CLt _ _ _ _ bs-two-fits))
(let ((many bs-zero-cmp)) (nat-cmp (Zero) u62m))
(comptime-match many bs-zero-cmp (CLt _ _ _ _ bs-zero-fits))

(def-fns _ $ (many split : (many (Nat) w) (erased (Lt w u62-modulus) wm) (erased (Lt (Zero) w) pos)
    -> (many (Nat) m) (erased (Lt m w) lm))
  (let ((many q) (erased k2) (erased r) (erased mm) (erased ad) (erased rlt) (erased qm))
    (u62-div w bs-two wm bs-two-fits (LtZ (Succ (Zero)))))
  (let ((erased lm)) (match erased q (((Lt q w) l))
    ((Zero) pos)
    ((Succ q1) (lt-le-trans q k2 w (mul-lt q1 bs-two k2 mm (LtS (Zero) (Succ (Zero)) (LtZ (Zero)))) (add-le-left k2 r w ad)))))
  (values q lm))

(def-fns _ $ (many bsearch-loop : (erased (List (Nat)) xs) (erased (AllTo (Nat) Lt xs u62-modulus) small)
    (erased (Ascending (Nat) Le xs) asc) (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n u62-modulus) fits)
    (erased (List (Copy (Nat))) cs) (many (Array (Copy (Nat)) cs) a) (erased (Copies (Nat) xs cs) rel)
    (many (Nat) k) (erased (Lt k u62-modulus) km) (many (Nat) lo) (subterm many (Nat) w)
    (erased (Nat) hi) (erased (Add lo w hi) span) (erased (Lt hi (Succ n)) hin)
    (erased (LoOk xs lo k) lok) (erased (HiOk xs n hi k) hok) -> (many (Search xs k) s))
  (let ((erased wn)) (lt-le-trans w (Succ hi) (Succ n) (add-le-left w lo hi (add-comm lo w hi span)) (LtS hi (Succ n) hin)))
  (let ((erased wm)) (lt-le-trans w (Succ n) u62-modulus wn (LtS n u62-modulus fits)))
  (let-match many (u62-cmp (Zero) w bs-zero-fits wm) (CLt _ _ _ _ pos)
    ((CEq _ _ _)
      (let-match erased (add-fn lo (Zero) hi lo span (add-zero-right lo)) (Refl _ _))
      (Absent xs k (absent xs asc n len lo k lok hok)))
    (absurd (CGt _ _ _ _ neg) (match erased neg _)))
  (let ((many m) (erased ltm)) (split w wm pos))
  (let ((erased mid) (erased amid)) (add lo m))
  (let ((erased midhi)) (add-lt-mono lo m mid w hi amid span ltm))
  (let ((erased midn)) (lt-le-trans mid hi n midhi hin))
  (let ((many i)) (u62-add lo m mid amid (lt-trans mid n u62-modulus midn fits)))
  (let ((erased v) (erased nth)) (nth-exists xs n len mid midn))
  (let ((many c)) (array-get-many (Copy (Nat)) cs a i (MkCopy (Nat) v) (copies-nth xs cs rel mid v nth)))
  (let-match many c (MkCopy _ x))
  (let-match many (u62-cmp x k (allto-nth (Nat) Lt xs u62-modulus small mid v nth) km) (CLt _ _ _ _ xk)
    ((CEq _ _ _) (Found xs k i nth))
    ((CGt _ _ _ _ kx)
      (tail $ bsearch-loop xs small asc n len fits cs a rel k km lo (subterm (lt-subterm m w ltm)) m mid amid
        (lt-weaken mid n midn) lok (HiAt xs n mid x k nth kx))))
  (let ((many m1)) (u62-inc m (lt-le-trans (Succ m) (Succ w) u62-modulus (LtS m w ltm) (LtS w u62-modulus wm))))
  (let ((many r) (erased amr) (erased rm)) (u62-sub w m1 wm (LtS m w ltm)))
  (let ((erased ltr)) (add-pos-lt r (Succ m) w (add-comm (Succ m) r w amr) (LtZ m)))
  (let ((erased ahi)) (add-shift lo m mid r w hi amid amr span))
  (let ((many lo1)) (u62-inc i (lt-le-trans (Succ mid) (Succ n) u62-modulus (LtS mid n midn) (LtS n u62-modulus fits))))
  (tail $ bsearch-loop xs small asc n len fits cs a rel k km lo1 (subterm (lt-subterm r w ltr)) r hi ahi hin
    (LoAt xs mid x k nth xk) hok))

(def-fns _ $ (many bsearch : (erased (List (Nat)) xs) (erased (AllTo (Nat) Lt xs u62-modulus) small)
    (erased (Ascending (Nat) Le xs) asc) (erased (Nat) n0) (erased (Length (Nat) xs n0) len0) (erased (Lt n0 u62-modulus) fits)
    (erased (List (Copy (Nat))) cs) (many (Array (Copy (Nat)) cs) a) (erased (Copies (Nat) xs cs) rel)
    (many (Nat) k) (erased (Lt k u62-modulus) km) -> (many (Search xs k) s))
  (let ((many n) (erased clen)) (array-length-many (Copy (Nat)) cs a))
  (let ((erased len)) (copies-length xs cs rel n clen))
  (let-match erased (length-fn xs n0 n len0 len) (Refl _ _))
  (bsearch-loop xs small asc n len fits cs a rel k km (Zero) n n (AddZero n) (lt-succ n) (LoZero xs k) (HiEnd xs n k)))
