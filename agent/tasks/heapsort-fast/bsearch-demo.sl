(def-fns _ $ (many gen : (subterm many (Nat) j) (many (Nat) h) (erased (Double j h) dh) (erased (Lt h u62-modulus) hm)
    (erased (List (Nat)) acc) (erased (Ascending (Nat) Le (Cons (Nat) h acc)) asc)
    (erased (AllTo (Nat) Lt (Cons (Nat) h acc) u62-modulus) small)
    (erased (Nat) l) (erased (Length (Nat) (Cons (Nat) h acc) l) len) (erased (Nat) total) (erased (Add j l total) count)
    (many (List (Copy (Nat))) cs) (erased (Copies (Nat) (Cons (Nat) h acc) cs) rel)
    -> (erased (List (Nat)) xs) (erased (Ascending (Nat) Le xs) asc2) (erased (AllTo (Nat) Lt xs u62-modulus) small2)
    (erased (Length (Nat) xs total) len2) (many (List (Copy (Nat))) cs2) (erased (Copies (Nat) xs cs2) rel2))
  (let-match many j (Succ j1)
    ((Zero) (let-match erased count (AddZero _)) (values (Cons (Nat) h acc) asc small len cs rel)))
  (let-match erased dh (DS _ h1 dh1))
  (let-match erased count (AddSucc _ _ total1 count1))
  (let-match many h (Succ hp))
  (let-match many hp (Succ h2))
  (let ((erased h2h)) (lt-weaken h2 (Succ h2) (lt-succ h2)))
  (let ((erased le)) (MkLe h2 h (lt-weaken h2 (Succ (Succ h2)) h2h)))
  (tail $ gen j1 h2 dh1 (lt-trans h2 h u62-modulus h2h hm) (Cons (Nat) h acc) (AscCons (Nat) Le h2 h acc le asc)
    (AllToCons (Nat) Lt h2 (Cons (Nat) h acc) u62-modulus (lt-trans h2 h u62-modulus h2h hm) small)
    (Succ l) (LengthCons (Nat) h2 (Cons (Nat) h acc) l len) total (add-succ-right j1 l total1 count1)
    (Cons (Copy (Nat)) (MkCopy (Nat) h2) cs) (CopiesCons (Nat) h2 (Cons (Nat) h acc) cs rel)))

(def-fns _ $ (many queries : (erased (List (Nat)) xs) (erased (AllTo (Nat) Lt xs u62-modulus) small)
    (erased (Ascending (Nat) Le xs) asc) (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n u62-modulus) fits)
    (erased (List (Copy (Nat))) cs) (many (Array (Copy (Nat)) cs) a) (erased (Copies (Nat) xs cs) rel)
    (subterm many (Nat) q) (erased (Lt q u62-modulus) qm) (many (Nat) found) -> (many (Nat) total))
  (let-match many q (Succ q1) ((Zero) found))
  (let ((erased q1m)) (lt-trans q1 q u62-modulus (lt-succ q1) qm))
  (match many (bsearch xs small asc n len fits cs a rel q1 q1m) _
    ((Found _ _ i nth) (tail $ queries xs small asc n len fits cs a rel q1 q1m (Succ found)))
    ((Absent _ _ none) (tail $ queries xs small asc n len fits cs a rel q1 q1m found))))

(let ((many demo-top)) 1048575)
(let ((many demo-h0) (erased demo-dh0)) (double demo-top))
(let ((many demo-h0-cmp)) (nat-cmp demo-h0 u62m))
(comptime-match many demo-h0-cmp (CLt _ _ _ _ demo-h0-fits))
(let ((many demo-n-cmp)) (nat-cmp (Succ demo-top) u62m))
(comptime-match many demo-n-cmp (CLt _ _ _ _ demo-n-fits))
(let ((many demo-q)) 1000000)
(let ((many demo-q-cmp)) (nat-cmp demo-q u62m))
(comptime-match many demo-q-cmp (CLt _ _ _ _ demo-q-fits))
(let ((many demo-zero-cmp)) (lt-dec 0 u8-modulus))
(comptime-match many demo-zero-cmp (Yes _ _ demo-zero-u8))

(def-lvl Demo)

(def-unique Demo $ (unique demo-report : (many (Nat) found) (many (Usage) u) -> (unique (IO Demo) next))
  (let-match many u (MkUsage wall-ns user-ns sys-ns minor-words promoted-words major-words minor-gcs major-gcs))
  (WriteOut Demo (str-append "found " (str-append (nat-str found) (str-append "\nwall-ns " (str-append (nat-str wall-ns)
      (str-append "\nminor-words " (str-append (nat-str minor-words) "\n"))))))
    (unique-thunk _ _ (Exit Demo (MkU8 0 demo-zero-u8)))))

(def-unique Demo $ (unique demo-start : -> (unique (IO Demo) next))
  (let ((erased xs) (erased asc) (erased small) (erased len) (many cs) (erased rel))
    (gen demo-top demo-h0 demo-dh0 demo-h0-fits (Nil (Nat)) (AscOne (Nat) Le demo-h0)
      (AllToCons (Nat) Lt demo-h0 (Nil (Nat)) u62-modulus demo-h0-fits (AllToNil (Nat) Lt u62-modulus))
      (Succ (Zero)) (LengthCons (Nat) demo-h0 (Nil (Nat)) (Zero) (LengthNil (Nat)))
      (Succ demo-top) (add-succ-right demo-top (Zero) demo-top (add-zero-right demo-top))
      (Cons (Copy (Nat)) (MkCopy (Nat) demo-h0) (Nil (Copy (Nat))))
      (CopiesCons (Nat) demo-h0 (Nil (Nat)) (Nil (Copy (Nat))) (CopiesNil (Nat)))))
  (let ((unique ua)) (list-to-array (Nat) cs))
  (let ((many a)) (share ua))
  (def-unique _ $ (unique run : -> (many (Nat) found))
    (queries xs small asc (Succ demo-top) len demo-n-fits cs a rel demo-q demo-q-fits (Zero)))
  (Measure Demo _ _ run demo-report))

(Step Demo demo-start)
