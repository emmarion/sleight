  (let ((erased s2) (erased sum2)) (add la lc))
  (MkFits la lc s2 sum2 (lt-le-trans (Succ s2) (Succ (Succ s)) u62-modulus (LtS _ _ (add-mono la lc s2 lb s sum2 sum le)) (LtS _ _ small))))

(def-fns _ $ (many row-loop : (erased (Char) x) (many (Nat) kx) (erased (Folded x kx) fx) (erased (String) a) (many (Codes a) ca)
    (erased (Nat) la) (erased (StrLength a la) pla)
    (erased (String) w) (many (Nat) lw) (erased (StrLength w lw) plw) (erased (Fits (Succ la) lw) fit)
    (erased (String) b) (many (Nat) p) (erased (StrLength b p) lb) (subterm erased (Path b w) path)
    (erased (List (Copy (U62))) ks) (erased (Coded w lw ks) cw) (unique (Array (Copy (U62)) ks) ka)
    (erased (List (Copy (U62))) xu) (erased (Nat) du) (erased (Tab a w lw du xu) tu) (unique (Array (Copy (U62)) xu) up)
    (erased (List (Copy (U62))) xv) (erased (PrevT a w lw xv) tv) (unique (Array (Copy (U62)) xv) up2)
    (many (Nat) n) (erased (List (Copy (U62))) ys) (unique (Array (Copy (U62)) ys) tg) (erased (Tab (SCons x a) b p n ys) t)
    (erased (Nat) cap) (erased (Length (Copy (U62)) ys cap) lg) (erased (Lt lw cap) pc)
    -> (unique ka is ka1 at ka) (unique up is up1 at up) (unique up2 is up21 at up2)
    (many (Nat) n2) (erased (List (Copy (U62))) zs) (unique (Array (Copy (U62)) zs) r at tg) (erased (Tab (SCons x a) w lw n2 zs) t2)
    (erased (Length (Copy (U62)) zs cap) lz))
  (let-match many (lt-dec p lw) (Yes _ _ more)
    ((No _ _ ge)
      (let-match erased path (PathTop _)
        (absurd (PathUp y _ _ above)
          (let-match erased (path-le _ _ above (Succ p) (SLenCons y b p lb) lw plw) (LtS _ _ lt))
          (lt-irrefl _ (lt-le-trans p lw p lt ge))))
      (let-match erased (strlen-fn _ _ _ lb plw) (Refl _ _))
      (values ka up up2 n ys tg t lg)))
  (let-match erased path (PathUp y _ _ above)
    (absurd (PathTop _) (let-match erased (strlen-fn _ _ _ lb plw) (Refl _ _)) (lt-irrefl _ more)))
  (let ((erased lb1)) (SLenCons y b p lb))
  (let ((erased d1) (erased tu1)) (tab-sub _ _ _ _ _ tu _ above _ lb1))
  (let-match erased tu1 (TabCons _ _ _ _ _ d3 tu3 _ pd1 dist1 nth1))
  (let ((erased cb1)) (coded-sub _ _ _ cw _ above _ lb1))
  (let-match erased cb1 (CodedCons _ _ _ _ cb _ _ _ _))
  (let ((erased tv1)) (prevt-sub _ _ _ _ tv _ above _ lb1))
  (let ((many p1)) (Succ p))
  (let ((many ky) (erased fy) (unique ka1)) (code-read y b p ks cb1 ka p1 (Refl _ p1)))
  (let ((many m1) (unique upa)) (arr-read xu up p1 d1 pd1 nth1))
  (let ((erased pd3) (erased nth3) (erased dist3)) (tab-at _ _ _ _ _ tu3))
  (let ((many m3) (unique upb)) (arr-read xu upa p d3 pd3 nth3))
  (let ((erased _) (erased _) (erased dist2)) (tab-at _ _ _ _ _ t))
  (let ((unique ka2) (unique up2b) (many cs) (erased es) (erased ts) (erased sb) (erased lts))
    (swaps-arr x kx fx a ca y ky fy b p ks cb ka1 xv tv1 up2 m3 dist3))
  (let ((many n1) (erased dist)) (combine x kx fx a y ky fy b m1 dist1 n dist2 m3 dist3 cs es ts sb lts))
  (let ((erased lt1)) (LtS p lw more))
  (let ((erased pd)) (under _ _ _ _ _ dist (SLenCons x a la pla) lb1 (fits-le _ _ _ fit lt1)))
  (let ((erased zs) (unique r) (erased s) (erased lz)) (arr-write ys tg cap lg p1 (lt-le-trans p1 (Succ lw) cap lt1 (LtS _ _ pc)) n1 pd))
  (tail $ row-loop x kx fx a ca la pla w lw plw fit (SCons y b) p1 lb1 above ks cw ka2 xu du tu upb xv tv up2b n1 zs r
    (TabCons _ y b zs p n (tab-set _ _ _ _ _ p1 _ zs s (lt-succ p) t) n1 pd dist (setnth-nth _ _ _ _ _ s)) cap lz pc))

(def-fns _ $ (many row-arr : (erased (Char) x) (many (Nat) kx) (erased (Folded x kx) fx) (erased (String) a) (many (Codes a) ca)
    (erased (Nat) la) (erased (StrLength a la) pla)
    (erased (String) w) (many (Nat) lw) (erased (StrLength w lw) plw) (erased (Fits (Succ la) lw) fit)
    (erased (List (Copy (U62))) ks) (erased (Coded w lw ks) cw) (unique (Array (Copy (U62)) ks) ka)
    (erased (List (Copy (U62))) xu) (erased (Nat) du) (erased (Tab a w lw du xu) tu) (unique (Array (Copy (U62)) xu) up)
    (erased (List (Copy (U62))) xv) (erased (PrevT a w lw xv) tv) (unique (Array (Copy (U62)) xv) up2)
    (erased (List (Copy (U62))) xt) (unique (Array (Copy (U62)) xt) tg) (erased (Nat) cap) (erased (Length (Copy (U62)) xt cap) lg) (erased (Lt lw cap) pc)
    -> (unique ka is ka1 at ka) (unique up is up1 at up) (unique up2 is up21 at up2)
    (many (Nat) n) (erased (List (Copy (U62))) ys) (unique (Array (Copy (U62)) ys) r at tg) (erased (Tab (SCons x a) w lw n ys) t)
    (erased (Length (Copy (U62)) ys cap) ly))
  (let ((erased path)) (path-bottom w))
  (let ((erased du0) (erased tu0)) (tab-sub _ _ _ _ _ tu _ path _ (SLenNil)))
  (let-match erased tu0 (TabNil _ _ _ pdu dist1 nth1))
  (let ((many m) (unique up1)) (arr-read xu up (Zero) du0 pdu nth1))
  (let-match erased dist1 (MkDistance _ _ _ e lb))
  (let ((erased dist)) (MkDistance _ _ _ (Delete x a (SNil) m e) (OnlyDeletes x a (Succ m) m lb (covers-paid (Zero) m))))
  (let ((many n)) (Succ m))
  (let ((erased pd)) (under _ _ _ _ _ dist (SLenCons x a la pla) (SLenNil) (fits-le _ _ _ fit (LtZ lw))))
  (let ((erased ys) (unique r) (erased s) (erased ly)) (arr-write xt tg cap lg (Zero) (lt-le-trans (Zero) (Succ lw) cap (LtZ lw) (LtS _ _ pc)) n pd))
  (tail $ row-loop x kx fx a ca la pla w lw plw fit (SNil) (Zero) (SLenNil) path ks cw ka xu du tu up1 xv tv up2 n ys r
    (TabNil _ ys n pd dist (setnth-nth _ _ _ _ _ s)) cap ly pc))

(def-fns _ $ (many rows-arr : (erased (String) a) (subterm many (Codes a) ca) (erased (Nat) la) (erased (StrLength a la) pla)
    (erased (String) w) (many (Nat) lw) (erased (StrLength w lw) plw) (erased (Fits la lw) fit)
    (erased (List (Copy (U62))) ks) (erased (Coded w lw ks) cw) (unique (Array (Copy (U62)) ks) ka)
    (erased (Nat) cap) (erased (Lt lw cap) pc)
    (erased (List (Copy (U62))) x0) (unique (Array (Copy (U62)) x0) b0) (erased (Length (Copy (U62)) x0 cap) l0)
    (erased (List (Copy (U62))) x1) (unique (Array (Copy (U62)) x1) b1) (erased (Length (Copy (U62)) x1 cap) l1)
    (erased (List (Copy (U62))) x2) (unique (Array (Copy (U62)) x2) b2) (erased (Length (Copy (U62)) x2 cap) l2)
    -> (unique ka is ka2 at ka) (many (Nat) d)
    (erased (List (Copy (U62))) y0) (unique (Array (Copy (U62)) y0) r0 at b0) (erased (Tab a w lw d y0) t0) (erased (Length (Copy (U62)) y0 cap) k0)
    (erased (List (Copy (U62))) y1) (unique (Array (Copy (U62)) y1) r1 at b1) (erased (PrevT a w lw y1) t1) (erased (Length (Copy (U62)) y1 cap) k1)
    (erased (List (Copy (U62))) y2) (unique (Array (Copy (U62)) y2) r2 at b2) (erased (Length (Copy (U62)) y2 cap) k2))
  (let-match many ca (CCons x a1 kx fx ca1)
    ((CNil)
      (let-match erased pla (SLenNil))
      (let ((many d) (erased y0) (unique r0) (erased t0) (erased k0)) (fill-base w lw plw fit x0 b0 cap l0 pc))
      (values ka d y0 r0 t0 k0 x1 b1 (NoPrevT w lw x1) l1 x2 b2 l2)))
  (let-match erased pla (SLenCons _ _ la1 pla1))
  (let ((unique ka1) (many d1) (erased z1) (unique s1) (erased u1) (erased j1) (erased z2) (unique s2) (erased u2) (erased j2) (erased z0) (unique s0) (erased j0))
    (notail $ rows-arr a1 ca1 la1 pla1 w lw plw (fits-left _ _ fit) ks cw ka cap pc x1 b1 l1 x2 b2 l2 x0 b0 l0))
  (let ((unique ka2) (unique s1b) (unique s2b) (many n) (erased ys) (unique s0b) (erased t) (erased ly))
    (row-arr x kx fx a1 ca1 la1 pla1 w lw plw fit ks cw ka1 z1 d1 u1 s1 z2 u2 s2 z0 s0 cap j0 pc))
  (values ka2 n ys s0b t ly z1 s1b (HasPrevT x a1 w lw z1 d1 u1) j1 z2 s2b j2))

(def-adts
  ((Room : ((Nat) lq) ((Nat) lw) ((Nat) cap) -> Type)
    enum
    (many Roomy : (erased (Nat) lq) (erased (Nat) lw) (erased (Nat) cap) (erased (Fits lq lw) fit) (erased (Lt lw cap) pc) -> (Room lq lw cap))
    (many Cramped : (erased (Nat) lq) (erased (Nat) lw) (erased (Nat) cap) -> (Room lq lw cap))))

(def-fns _ $ (many room : (many (Nat) lq) (many (Nat) lw) (many (Nat) cap) -> (many (Room lq lw cap) r))
  (let ((many s) (erased sum)) (add lq lw))
  (let-match many (lt-dec (Succ s) limit) (Yes _ _ small) ((No _ _ _) (Cramped lq lw cap)))
  (match many (lt-dec lw cap) _
    ((Yes _ _ pc) (Roomy lq lw cap (MkFits lq lw s sum small) pc))
    ((No _ _ _) (Cramped lq lw cap))))

(def-fns _ $ (many word-distance : (erased (String) q) (many (Codes q) cq) (many (Nat) lq) (erased (StrLength q lq) pq)
    (erased (List (U8)) xs) (many (Bytes xs) bs) (erased (Nat) n) (erased (Length (U8) xs n) ln)
    (many (Nat) s) (many (Nat) lw) (erased (Nat) e) (erased (Add s lw e) sum) (erased (Lt e (Succ n)) le)
    (erased (String) wt) (erased (Drop xs s wt) dw) (erased (String) w) (erased (String) t) (erased (WordThen wt w t) wth) (erased (StrLength w lw) pw)
    (many (Nat) cap)
    (erased (List (Copy (U62))) ks) (unique (Array (Copy (U62)) ks) ka) (erased (Length (Copy (U62)) ks cap) lk) (erased (List (Copy (U62))) x0) (unique (Array (Copy (U62)) x0) b0) (erased (Length (Copy (U62)) x0 cap) l0) (erased (List (Copy (U62))) x1) (unique (Array (Copy (U62)) x1) b1) (erased (Length (Copy (U62)) x1 cap) l1) (erased (List (Copy (U62))) x2) (unique (Array (Copy (U62)) x2) b2) (erased (Length (Copy (U62)) x2 cap) l2)
    -> (many (Nat) d) (erased (Distance q w d) dist)
    (erased (List (Copy (U62))) ks2) (unique (Array (Copy (U62)) ks2) ka2 at ka) (erased (Length (Copy (U62)) ks2 cap) lk2) (erased (List (Copy (U62))) y0) (unique (Array (Copy (U62)) y0) r0 at b0) (erased (Length (Copy (U62)) y0 cap) k0) (erased (List (Copy (U62))) y1) (unique (Array (Copy (U62)) y1) r1 at b1) (erased (Length (Copy (U62)) y1 cap) k1) (erased (List (Copy (U62))) y2) (unique (Array (Copy (U62)) y2) r2 at b2) (erased (Length (Copy (U62)) y2 cap) k2))
  (match many (room lq lw cap) _
    ((Cramped _ _ _)
      (let ((many ws)) (word-string xs bs n ln s lw e sum le wt dw w t wth pw))
      (let ((many d) (erased dist)) (distance-codes q cq w (codes ws)))
      (values d dist ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2))
    ((Roomy _ _ _ fit pc)
      (let ((erased ks1) (unique ka1) (erased cw) (erased lk1)) (fill-codes xs bs w s (drop-word-at xs s wt dw w t wth) lw pw ks ka cap lk pc))
      (let ((unique ka2) (many d) (erased y0) (unique r0) (erased t0) (erased k0) (erased y1) (unique r1) (erased _) (erased k1) (erased y2) (unique r2) (erased k2))
        (rows-arr q cq lq pq w lw pw fit ks1 cw ka1 cap pc x0 b0 l0 x1 b1 l1 x2 b2 l2))
      (let ((erased _) (erased _) (erased dist)) (tab-at _ _ _ _ _ t0))
      (values d dist ks1 ka2 lk1 y0 r0 k0 y1 r1 k1 y2 r2 k2))))
