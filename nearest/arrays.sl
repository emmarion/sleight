    (many Cramped : (erased (Nat) lq) (erased (Nat) lw) (erased (Nat) cap) -> (Room lq lw cap))))

(def-fns _ $ (many room : (many (Nat) lq) (many (Nat) lw) (many (Nat) cap) -> (many (Room lq lw cap) r))
