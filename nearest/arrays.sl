(def-adts
  ((Fits : ((Nat) la) ((Nat) lb) -> Type)
    enum
    (many MkFits : (erased (Nat) la) (erased (Nat) lb) (erased (Nat) s) (erased (Add la lb s) sum) (erased (Lt (Succ s) u8-modulus) small)
       -> (Fits la lb))))

(def-fns _ $ (erased fits-left : (erased (Nat) la) (erased (Nat) lb) (erased (Fits (Succ la) lb) f) -> (erased (Fits la lb) r))
  (let-match erased f (MkFits _ _ s sum small))
  (let-match erased sum (AddSucc _ _ s1 sum1))
  (MkFits la lb s1 sum1 (lt-trans _ _ _ (lt-succ (Succ s1)) small)))

(def-fns _ $ (erased fits-right : (erased (Nat) la) (erased (Nat) lb) (erased (Fits la (Succ lb)) f) -> (erased (Fits la lb) r))
  (let-match erased f (MkFits _ _ s sum small))
  (let ((erased s1) (erased e) (erased sum1)) (add-succ-right-inv la lb s sum))
  (let-match erased e (Refl _ _))
  (MkFits la lb s1 sum1 (lt-trans _ _ _ (lt-succ (Succ s1)) small)))

(def-fns _ $ (erased inserts-all : (subterm erased (String) b) (erased (Nat) lb) (erased (StrLength b lb) pb) -> (erased (Edits (SNil) b lb) e))
  (let-match erased b (SCons y b1) ((SNil) (let-match erased pb (SLenNil)) (Done)))
  (let-match erased pb (SLenCons _ _ lb1 pb1))
  (Insert y (SNil) b1 lb1 (inserts-all b1 lb1 pb1)))

(def-fns _ $ (erased trivial-edits : (subterm erased (String) a) (erased (String) b) (erased (Nat) la) (erased (Nat) lb) (erased (Nat) s)
    (erased (StrLength a la) pa) (erased (StrLength b lb) pb) (erased (Add la lb s) sum) -> (erased (Edits a b s) e))
  (let-match erased a (SCons x a1) ((SNil) (let-match erased pa (SLenNil)) (let-match erased sum (AddZero _)) (inserts-all b lb pb)))
  (let-match erased pa (SLenCons _ _ la1 pa1))
  (let-match erased sum (AddSucc _ _ s1 sum1))
  (Delete x a1 b s1 (trivial-edits a1 b la1 lb s1 pa1 pb sum1)))

(def-fns _ $ (erased under : (erased (String) a) (erased (String) b) (erased (Nat) d) (erased (Nat) la) (erased (Nat) lb)
    (erased (Distance a b d) dist) (erased (StrLength a la) pa) (erased (StrLength b lb) pb) (erased (Fits la lb) f) -> (erased (Lt d u62-modulus) r))
  (let-match erased f (MkFits _ _ s sum small))
  (let-match erased dist (MkDistance _ _ _ _ al))
  (let ((erased le)) (at-least-sound _ _ _ _ (trivial-edits a b la lb s pa pb sum) al))
  (lt-trans d u8-modulus u62-modulus (lt-le-trans d (Succ s) u8-modulus le (lt-weaken _ _ small)) u8-below-u62))

(def-adts
  ((Tab : ((String) a) ((String) b) ((Nat) p) ((Nat) d) ((List (Copy (U62))) xs) -> Type)
    enum
    (many TabNil : (erased (String) a) (erased (List (Copy (U62))) xs) (erased (Nat) d) (erased (Lt d u62-modulus) pd)
       (erased (Distance a (SNil) d) dist) (erased (Nth (Copy (U62)) xs (Zero) (MkCopy (U62) (MkU62 d pd))) here)
       -> (Tab a (SNil) (Zero) d xs))
    (many TabCons : (erased (String) a) (erased (Char) y) (erased (String) b) (erased (List (Copy (U62))) xs) (erased (Nat) p)
       (erased (Nat) d0) (erased (Tab a b p d0 xs) rest) (erased (Nat) d) (erased (Lt d u62-modulus) pd)
       (erased (Distance a (SCons y b) d) dist) (erased (Nth (Copy (U62)) xs (Succ p) (MkCopy (U62) (MkU62 d pd))) here)
       -> (Tab a (SCons y b) (Succ p) d xs))))

(def-adts
  ((PrevT : ((String) a) ((String) b) ((Nat) p) ((List (Copy (U62))) xs) -> Type)
    enum
    (many NoPrevT : (erased (String) b) (erased (Nat) p) (erased (List (Copy (U62))) xs) -> (PrevT (SNil) b p xs))
    (many HasPrevT : (erased (Char) x) (erased (String) a) (erased (String) b) (erased (Nat) p) (erased (List (Copy (U62))) xs)
       (erased (Nat) d) (erased (Tab a b p d xs) row) -> (PrevT (SCons x a) b p xs))))

(def-fns _ $ (erased tab-at : (erased (String) a) (erased (String) b) (erased (Nat) p) (erased (Nat) d) (erased (List (Copy (U62))) xs)
    (erased (Tab a b p d xs) t)
    -> (erased (Lt d u62-modulus) pd) (erased (Nth (Copy (U62)) xs p (MkCopy (U62) (MkU62 d pd))) nth) (erased (Distance a b d) dist))
  (match erased t _
    ((TabNil _ _ _ pd dist here) (values pd here dist))
    ((TabCons _ _ _ _ _ _ _ _ pd dist here) (values pd here dist))))

(def-fns _ $ (erased tab-len : (erased (String) a) (erased (String) b) (erased (Nat) p) (erased (Nat) d) (erased (List (Copy (U62))) xs)
    (subterm erased (Tab a b p d xs) t) -> (erased (StrLength b p) l))
  (match erased t _
    ((TabNil _ _ _ _ _ _) (SLenNil))
    ((TabCons _ y b1 _ p1 _ rest _ _ _ _) (SLenCons y b1 p1 (tab-len _ _ _ _ _ rest)))))

(def-fns _ $ (erased tab-set : (erased (String) a) (erased (String) b) (erased (Nat) p) (erased (Nat) d) (erased (List (Copy (U62))) xs)
    (erased (Nat) i) (erased (Copy (U62)) v) (erased (List (Copy (U62))) ys) (erased (SetNth (Copy (U62)) xs i v ys) s) (erased (Lt p i) lt)
    (subterm erased (Tab a b p d xs) t) -> (erased (Tab a b p d ys) r))
  (match erased t _
    ((TabNil _ _ _ pd dist here) (TabNil a ys d pd dist (setnth-nth-lt _ xs i (Zero) v _ ys s here lt)))
    ((TabCons _ y b1 _ p1 d0 rest _ pd dist here)
      (TabCons a y b1 ys p1 d0 (tab-set _ _ _ _ _ i v ys s (lt-trans p1 p i (lt-succ p1) lt) rest) d pd dist
        (setnth-nth-lt _ xs i p v _ ys s here lt)))))

(def-fns _ $ (erased prev-down : (erased (String) a) (erased (Char) y) (erased (String) b) (erased (Nat) p) (erased (List (Copy (U62))) xs)
    (erased (PrevT a (SCons y b) (Succ p) xs) t) -> (erased (PrevT a b p xs) r))
  (let-match erased t (HasPrevT x2 a2 _ _ _ _ row) ((NoPrevT _ _ _) (NoPrevT b p xs)))
  (let-match erased row (TabCons _ _ _ _ _ d0 rest _ _ _ _))
  (HasPrevT x2 a2 b p xs d0 rest))

(def-fns _ $ (many arr-read : (erased (List (Copy (U62))) xs) (unique (Array (Copy (U62)) xs) arr) (many (Nat) p)
    (erased (Nat) d) (erased (Lt d u62-modulus) pd) (erased (Nth (Copy (U62)) xs p (MkCopy (U62) (MkU62 d pd))) nth)
    -> (many d is v) (unique arr is r at arr))
  (let ((many u) (unique r)) (array-get (U62) xs arr p (MkU62 d pd) nth))
  (let-match many u (MkU62 v _))
  (values v r))

(def-fns _ $ (many arr-write : (erased (List (Copy (U62))) xs) (unique (Array (Copy (U62)) xs) arr) (erased (Nat) cap) (erased (Length (Copy (U62)) xs cap) len)
    (many (Nat) p) (erased (Lt p cap) pc) (many (Nat) d) (erased (Lt d u62-modulus) pd)
    -> (erased (List (Copy (U62))) ys) (unique (Array (Copy (U62)) ys) r at arr)
    (erased (SetNth (Copy (U62)) xs p (MkCopy (U62) (MkU62 d pd)) ys) s) (erased (Length (Copy (U62)) ys cap) len2))
  (let ((erased old) (erased nth)) (nth-exists _ xs cap p len pc))
  (let ((erased ys) (unique r) (erased s)) (array-place-imm _ xs arr p (MkCopy _ (MkU62 d pd)) old nth (ImmCopy _ (ImmU62))))
  (values ys r s (setnth-length _ _ _ _ _ _ s len)))

(def-fns _ $ (many fill-base : (erased (String) b) (subterm many (Codes b) cb) (many (Nat) p) (erased (StrLength b p) lp) (erased (Fits (Zero) p) fit)
    (erased (List (Copy (U62))) xs) (unique (Array (Copy (U62)) xs) arr) (erased (Nat) cap) (erased (Length (Copy (U62)) xs cap) len) (erased (Lt p cap) pc)
    -> (many (Nat) d) (erased (List (Copy (U62))) ys) (unique (Array (Copy (U62)) ys) r at arr) (erased (Tab (SNil) b p d ys) t)
    (erased (Length (Copy (U62)) ys cap) len2))
  (let-match many cb (CCons y b1 _ _ cb1)
    ((CNil)
      (let-match erased lp (SLenNil))
      (let ((erased dist)) (MkDistance _ _ _ (Done) (Trivially _ _)))
      (let ((erased pd)) (under _ _ _ _ _ dist (SLenNil) (SLenNil) fit))
      (let ((erased ys) (unique r) (erased s) (erased len2)) (arr-write xs arr cap len p pc (Zero) pd))
      (values (Zero) ys r (TabNil _ ys (Zero) pd dist (setnth-nth _ _ _ _ _ s)) len2)))
  (let-match erased lp (SLenCons _ _ p1 lp1))
  (let-match many p (Succ p1r))
  (let ((many d1) (erased ys1) (unique r1) (erased t1) (erased len1))
    (notail $ fill-base b1 cb1 p1r lp1 (fits-right _ _ fit) xs arr cap len (lt-trans p1 p cap (lt-succ p1) pc)))
  (let ((erased _) (erased _) (erased dist1)) (tab-at _ _ _ _ _ t1))
  (let-match erased dist1 (MkDistance _ _ _ e1 a1))
  (let ((erased dist)) (MkDistance _ _ _ (Insert y (SNil) b1 d1 e1) (OnlyInserts y b1 (Succ d1) d1 a1 (covers-paid (Zero) d1))))
  (let ((many d)) (Succ d1))
  (let ((erased pd)) (under _ _ _ _ _ dist (SLenNil) lp fit))
  (let ((erased ys) (unique r) (erased s) (erased len2)) (arr-write ys1 r1 cap len1 p pc d pd))
  (values d ys r (TabCons _ y b1 ys p1 d1 (tab-set _ _ _ _ _ p _ ys s (lt-succ p1) t1) d pd dist (setnth-nth _ _ _ _ _ s)) len2))

(def-fns _ $ (many swaps-arr : (erased (Char) x) (many (Nat) kx) (erased (Folded x kx) fx) (erased (String) a) (many (Codes a) ca)
    (erased (Char) y) (many (Nat) ky) (erased (Folded y ky) fy) (erased (String) b) (many (Codes b) cb) (many (Nat) p)
    (erased (List (Copy (U62))) xv) (erased (PrevT a (SCons y b) (Succ p) xv) tv) (unique (Array (Copy (U62)) xv) up2)
    (many (Nat) m3) (erased (Distance a b m3) d3)
    -> (unique up2 is r at up2) (many (Nat) cs) (erased (Edits (SCons x a) (SCons y b) cs) e) (erased (Nat) t)
    (erased (SwapBound x a y b t) sb) (erased (Lt cs (Succ t)) le))
  (let-match erased d3 (MkDistance _ _ _ e3 _))
  (let ((erased fallback)) (Replace x y a b m3 e3))
  (let-match many ca (CCons x2 a2 kx2 fx2 _) ((CNil) (values up2 (Succ m3) fallback (Succ m3) (NothingToSwapLeft x y b (Succ m3)) (lt-succ _))))
  (let-match many cb (CCons y2 b2 ky2 fy2 _) ((CNil) (values up2 (Succ m3) fallback (Succ m3) (NothingToSwapRight x a y (Succ m3)) (lt-succ _))))
  (let-match erased tv (HasPrevT _ _ _ _ _ _ row))
  (let-match erased row (TabCons _ _ _ _ _ _ row1 _ _ _ _))
  (let-match erased row1 (TabCons _ _ _ _ p2 d4 row2 _ _ _ _))
  (let-match many p (Succ p2r))
  (let ((erased pd4) (erased nth4) (erased dist4)) (tab-at _ _ _ _ _ row2))
  (let ((many m4) (unique up3)) (arr-read xv up2 p2r d4 pd4 nth4))
  (let ((many cs) (erased es) (erased t) (erased sb) (erased le)) (swap-decide x kx fx x2 kx2 fx2 a2 y ky fy y2 ky2 fy2 b2 m3 d3 m4 dist4))
  (values up3 cs es t sb le))

(def-fns _ $ (many row-step-arr : (erased (Char) x) (many (Nat) kx) (erased (Folded x kx) fx) (erased (String) a) (many (Codes a) ca)
    (erased (Nat) la) (erased (StrLength a la) pla)
    (erased (String) b) (subterm many (Codes b) cb) (many (Nat) p) (erased (Fits (Succ la) p) fit)
    (erased (List (Copy (U62))) xu) (erased (Nat) du) (erased (Tab a b p du xu) tu) (unique (Array (Copy (U62)) xu) up)
    (erased (List (Copy (U62))) xv) (erased (PrevT a b p xv) tv) (unique (Array (Copy (U62)) xv) up2)
    (erased (List (Copy (U62))) xt) (unique (Array (Copy (U62)) xt) tg) (erased (Nat) cap) (erased (Length (Copy (U62)) xt cap) lg) (erased (Lt p cap) pc)
    -> (unique up is up1 at up) (unique up2 is up21 at up2)
    (many (Nat) n) (erased (List (Copy (U62))) ys) (unique (Array (Copy (U62)) ys) r at tg) (erased (Tab (SCons x a) b p n ys) t)
    (erased (Length (Copy (U62)) ys cap) ly))
  (let-match many cb (CCons y b1 ky fy cb1)
    ((CNil)
      (let-match erased tu (TabNil _ _ _ pdu dist1 nth1))
      (let ((many m) (unique up1)) (arr-read xu up p du pdu nth1))
      (let-match erased dist1 (MkDistance _ _ _ e lb))
      (let ((erased dist)) (MkDistance _ _ _ (Delete x a (SNil) m e) (OnlyDeletes x a (Succ m) m lb (covers-paid (Zero) m))))
      (let ((many n)) (Succ m))
      (let ((erased pd)) (under _ _ _ _ _ dist (SLenCons x a la pla) (SLenNil) fit))
      (let ((erased ys) (unique r) (erased s) (erased ly)) (arr-write xt tg cap lg p pc n pd))
      (values up1 up2 n ys r (TabNil _ ys n pd dist (setnth-nth _ _ _ _ _ s)) ly)))
  (let-match erased tu (TabCons _ _ _ _ p1 d3 tu1 _ pdu dist1 nth1))
  (let-match many p (Succ p1r))
  (let ((unique up1) (unique up21) (many m2) (erased ys1) (unique tg1) (erased t1) (erased ly1))
    (notail $ row-step-arr x kx fx a ca la pla b1 cb1 p1r (fits-right _ _ fit) xu d3 tu1 up xv (prev-down _ _ _ _ _ tv) up2
      xt tg cap lg (lt-trans p1 p cap (lt-succ p1) pc)))
  (let ((many m1) (unique up3)) (arr-read xu up1 p du pdu nth1))
  (let ((erased pd3) (erased nth3) (erased dist3)) (tab-at _ _ _ _ _ tu1))
  (let ((many m3) (unique up4)) (arr-read xu up3 p1r d3 pd3 nth3))
  (let ((erased _) (erased _) (erased dist2)) (tab-at _ _ _ _ _ t1))
  (let ((unique up22) (many cs) (erased es) (erased ts) (erased sb) (erased lts)) (swaps-arr x kx fx a ca y ky fy b1 cb1 p1r xv tv up21 m3 dist3))
  (let ((many n) (erased dist)) (combine x kx fx a y ky fy b1 m1 dist1 m2 dist2 m3 dist3 cs es ts sb lts))
  (let ((erased pd)) (under _ _ _ _ _ dist (SLenCons x a la pla) (tab-len _ _ _ _ _ tu) fit))
  (let ((erased ys) (unique r) (erased s) (erased ly)) (arr-write ys1 tg1 cap ly1 p pc n pd))
  (values up4 up22 n ys r (TabCons _ y b1 ys p1 m2 (tab-set _ _ _ _ _ p _ ys s (lt-succ p1) t1) n pd dist (setnth-nth _ _ _ _ _ s)) ly))

(def-fns _ $ (many rows-arr : (erased (String) a) (subterm many (Codes a) ca) (erased (Nat) la) (erased (StrLength a la) pla)
    (erased (String) w) (many (Codes w) cw) (many (Nat) lw) (erased (StrLength w lw) plw) (erased (Fits la lw) fit)
    (erased (Nat) cap) (erased (Lt lw cap) pc)
    (erased (List (Copy (U62))) x0) (unique (Array (Copy (U62)) x0) b0) (erased (Length (Copy (U62)) x0 cap) l0)
    (erased (List (Copy (U62))) x1) (unique (Array (Copy (U62)) x1) b1) (erased (Length (Copy (U62)) x1 cap) l1)
    (erased (List (Copy (U62))) x2) (unique (Array (Copy (U62)) x2) b2) (erased (Length (Copy (U62)) x2 cap) l2)
    -> (many (Nat) d)
    (erased (List (Copy (U62))) y0) (unique (Array (Copy (U62)) y0) r0) (erased (Tab a w lw d y0) t0) (erased (Length (Copy (U62)) y0 cap) k0)
    (erased (List (Copy (U62))) y1) (unique (Array (Copy (U62)) y1) r1) (erased (PrevT a w lw y1) t1) (erased (Length (Copy (U62)) y1 cap) k1)
    (erased (List (Copy (U62))) y2) (unique (Array (Copy (U62)) y2) r2) (erased (Length (Copy (U62)) y2 cap) k2))
  (let-match many ca (CCons x a1 kx fx ca1)
    ((CNil)
      (let-match erased pla (SLenNil))
      (let ((many d) (erased y0) (unique r0) (erased t0) (erased k0)) (fill-base w cw lw plw fit x0 b0 cap l0 pc))
      (values d y0 r0 t0 k0 x1 b1 (NoPrevT w lw x1) l1 x2 b2 l2)))
  (let-match erased pla (SLenCons _ _ la1 pla1))
  (let ((many d1) (erased y0) (unique r0) (erased t0) (erased k0) (erased y1) (unique r1) (erased t1) (erased k1) (erased y2) (unique r2) (erased k2))
    (notail $ rows-arr a1 ca1 la1 pla1 w cw lw plw (fits-left _ _ fit) cap pc x0 b0 l0 x1 b1 l1 x2 b2 l2))
  (let ((unique r0b) (unique r1b) (many n) (erased ys) (unique r2b) (erased t) (erased ly))
    (row-step-arr x kx fx a1 ca1 la1 pla1 w cw lw fit y0 d1 t0 r0 y1 t1 r1 y2 r2 cap k2 pc))
  (values n ys r2b t ly y0 r0b (HasPrevT x a1 w lw y0 d1 t0) k0 y1 r1b k1))

(def-fns _ $ (many distance-arr : (erased (String) q) (many (Codes q) cq) (erased (Nat) lq) (erased (StrLength q lq) pq)
    (erased (String) w) (many (Codes w) cw) (many (Nat) lw) (erased (StrLength w lw) pw) (erased (Fits lq lw) fit)
    -> (many (Nat) n) (erased (Distance q w n) d))
  (let ((many z)) (MkU62 (Zero) u62-modulus-pos))
  (let ((erased x0) (unique b0) (erased r0)) (array-make (U62) (Succ lw) z))
  (let ((erased x1) (unique b1) (erased r1)) (array-make (U62) (Succ lw) z))
  (let ((erased x2) (unique b2) (erased r2)) (array-make (U62) (Succ lw) z))
  (let ((many n) (erased y0) (unique _) (erased t0) (erased _) (erased _) (unique _) (erased _) (erased _) (erased _) (unique _) (erased _))
    (rows-arr q cq lq pq w cw lw pw fit (Succ lw) (lt-succ lw)
      x0 b0 (repeat-length _ _ _ _ r0) x1 b1 (repeat-length _ _ _ _ r1) x2 b2 (repeat-length _ _ _ _ r2)))
  (let ((erased _) (erased _) (erased dist)) (tab-at _ _ _ _ _ t0))
  (values n dist))

(def-fns _ $ (many word-distance : (erased (String) q) (many (Codes q) cq) (many (Nat) lq) (erased (StrLength q lq) pq)
    (many (String) w) (many (Nat) lw) (erased (StrLength w lw) pw) -> (many (Nat) n) (erased (Distance q w n) d))
  (let ((many cw)) (codes w))
  (let ((many s) (erased sum)) (add lq lw))
  (match many (lt-dec (Succ s) u8-modulus) _
    ((Yes _ _ small) (distance-arr q cq lq pq w cw lw pw (MkFits lq lw s sum small)))
    ((No _ _ _) (distance-codes q cq w cw))))
