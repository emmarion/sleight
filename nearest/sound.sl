(unary 65 64)
(unary 91 90)
(let ((erased a-before-z)) (prove-literal-lt 65 90))

(def-fns _ $ (erased absurd lt-gap : (erased (Nat) a) (erased (Nat) n) (erased (Lt a n) lo) (erased (Lt n (Succ a)) hi) -> (erased (False) f))
  (lt-irrefl a (lt-le-trans a n a lo hi)))

(def-fns _ $ (erased folded-fn : (erased (Char) c) (erased (Nat) i) (erased (Nat) j) (erased (Folded c i) fi) (erased (Folded c j) fj)
    -> (erased (Eq (Nat) i j) e))
  (match erased fi _
    ((FoldUpper n p lo hi _ si)
      (match erased fj _
        ((FoldUpper _ _ _ _ _ sj) (add-fn n 32 i j si sj))
        (absurd (FoldBelow _ _ b) (lt-gap 64 n lo b))
        (absurd (FoldAbove _ _ b) (lt-gap 90 n b hi))))
    ((FoldBelow n p b)
      (match erased fj _
        (absurd (FoldUpper _ _ lo _ _ _) (lt-gap 64 n lo b))
        ((FoldBelow _ _ _) (Refl _ i))
        (absurd (FoldAbove _ _ a) (lt-irrefl 90 (lt-trans 90 65 90 (lt-trans 90 n 65 a b) a-before-z)))))
    ((FoldAbove n p a)
      (match erased fj _
        (absurd (FoldUpper _ _ _ hi _ _) (lt-gap 90 n a hi))
        (absurd (FoldBelow _ _ b) (lt-irrefl 90 (lt-trans 90 65 90 (lt-trans 90 n 65 a b) a-before-z)))
        ((FoldAbove _ _ _) (Refl _ i))))))

(def-fns _ $ (erased absurd same-different : (erased (Char) x) (erased (Char) y) (erased (SameLetter x y) s) (erased (DifferentLetter x y) d)
    -> (erased (False) f))
  (let-match erased s (Same _ _ k fx fy))
  (match erased d _
    (absurd (Below _ _ i j gx gy lt)
      (let-match erased (folded-fn x k i fx gx) (Refl _ _))
      (let-match erased (folded-fn y k j fy gy) (Refl _ _))
      (lt-irrefl k lt))
    (absurd (Above _ _ i j gx gy gt)
      (let-match erased (folded-fn x k i fx gx) (Refl _ _))
      (let-match erased (folded-fn y k j fy gy) (Refl _ _))
      (lt-irrefl k gt))))

(def-fns _ $ (erased le-trans : (erased (Nat) a) (erased (Nat) b) (erased (Nat) c) (erased (Lt a (Succ b)) p) (erased (Lt b (Succ c)) q)
    -> (erased (Lt a (Succ c)) r))
  (lt-le-trans a (Succ b) (Succ c) p (LtS _ _ q)))

(def-fns _ $ (erased add-mono : (erased (Nat) c) (erased (Nat) j) (erased (Nat) s) (erased (Nat) n) (erased (Nat) t)
    (subterm erased (Add c j s) p) (erased (Add c n t) q) (erased (Lt j (Succ n)) le) -> (erased (Lt s (Succ t)) r))
  (match erased p _
    ((AddZero _) (let-match erased q (AddZero _)) le)
    ((AddSucc c1 _ s1 p1) (let-match erased q (AddSucc _ _ t1 q1)) (LtS _ _ (add-mono c1 j s1 n t1 p1 q1 le)))))

(def-fns _ $ (erased covers-sound : (erased (Nat) c) (erased (Nat) j) (erased (Nat) k) (erased (Nat) n) (erased (Nat) t)
    (erased (Covers c j k) cv) (erased (Lt j (Succ n)) le) (erased (Add c n t) q) -> (erased (Lt k (Succ t)) r))
  (let-match erased cv (MkCovers _ _ _ s total enough))
  (le-trans k s t (le-lt k s enough) (add-mono c j s n t total q le)))

(def-fns _ $ (erased one-plus : (erased (Nat) n) -> (erased (Add (Succ (Zero)) n (Succ n)) p))
  (AddSucc (Zero) n n (AddZero n)))

(def-fns _ $ (erased cost-same : (erased (Char) x) (erased (Char) y) (erased (Nat) c) (erased (LetterCost x y c) lc) (erased (SameLetter x y) s)
    -> (erased (Eq (Nat) c (Zero)) e))
  (let-match erased lc (LettersMatch _ _ _) (absurd (LettersDiffer _ _ d) (same-different x y s d)))
  (Refl _ c))

(def-fns _ $ (erased at-least-sound : (erased (String) a) (erased (String) b) (erased (Nat) n) (erased (Nat) k)
    (subterm erased (Edits a b n) e) (erased (AtLeast a b k) p) -> (erased (Lt k (Succ n)) le))
  (let-match erased p (EveryFirstStep x y a1 b1 _ cp pair-cost jp pair pair-enough jd delete delete-enough ji insert insert-enough swap)
    ((Trivially _ _) (LtZ n))
    ((OnlyDeletes x a1 _ j rest enough)
      (let-match erased e (Delete _ _ _ m r))
      (covers-sound _ _ _ _ _ enough (at-least-sound _ _ _ _ r rest) (one-plus m)))
    ((OnlyInserts y b1 _ j rest enough)
      (let-match erased e (Insert _ _ _ m r))
      (covers-sound _ _ _ _ _ enough (at-least-sound _ _ _ _ r rest) (one-plus m))))
  (match erased e _
    ((Keep _ _ _ _ _ same r)
      (let-match erased (cost-same x y cp pair-cost same) (Refl _ _))
      (covers-sound _ _ _ _ _ pair-enough (at-least-sound _ _ _ _ r pair) (AddZero n)))
    ((Replace _ _ _ _ m r)
      (let ((erased le)) (at-least-sound _ _ _ _ r pair))
      (match erased pair-cost _
        ((LettersMatch _ _ _) (lt-weaken _ _ (covers-sound _ _ _ _ _ pair-enough le (AddZero m))))
        ((LettersDiffer _ _ _) (covers-sound _ _ _ _ _ pair-enough le (one-plus m)))))
    ((Delete _ _ _ m r) (covers-sound _ _ _ _ _ delete-enough (at-least-sound _ _ _ _ r delete) (one-plus m)))
    ((Insert _ _ _ m r) (covers-sound _ _ _ _ _ insert-enough (at-least-sound _ _ _ _ r insert) (one-plus m)))
    ((Swap x1 x2 y1 y2 a2 b2 m first second r)
      (let-match erased swap (SwapCosts _ _ _ _ _ _ _ c1 fc c2 sc c mismatches j rest enough))
      (let-match erased (cost-same x1 y2 c1 fc first) (Refl _ _))
      (let-match erased (cost-same x2 y1 c2 sc second) (Refl _ _))
      (let-match erased mismatches (AddZero _))
      (covers-sound _ _ _ _ _ enough (at-least-sound _ _ _ _ r rest) (one-plus m)))))

(def-fns _ $ (erased lt-antisym : (erased (Nat) n) (erased (Nat) m) (subterm erased (Lt n (Succ m)) p) (erased (Lt m (Succ n)) q)
    -> (erased (Eq (Nat) n m) e))
  (let-match erased p (LtS n1 _ p1)
    ((LtZ _) (match erased q _ ((LtZ _) (Refl _ n)) (absurd (LtS _ _ z) z))))
  (let-match erased m (Succ m1) (absurd (Zero) p1))
  (let-match erased q (LtS _ _ q1))
  (let-match erased (lt-antisym n1 m1 p1 q1) (Refl _ _))
  (Refl _ n))

(def-fns _ $ (erased distance-fn : (erased (String) a) (erased (String) b) (erased (Nat) n) (erased (Nat) m)
    (erased (Distance a b n) dn) (erased (Distance a b m) dm) -> (erased (Eq (Nat) n m) e))
  (let-match erased dn (MkDistance _ _ _ en an))
  (let-match erased dm (MkDistance _ _ _ em am))
  (lt-antisym n m (at-least-sound _ _ _ _ em an) (at-least-sound _ _ _ _ en am)))
