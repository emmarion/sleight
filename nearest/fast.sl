(def-fns _ $ (erased same-sym : (erased (Char) x) (erased (Char) y) (erased (SameLetter x y) s) -> (erased (SameLetter y x) r))
  (let-match erased s (Same _ _ k fx fy))
  (Same y x k fy fx))

(def-fns _ $ (erased different-sym : (erased (Char) x) (erased (Char) y) (erased (DifferentLetter x y) d) -> (erased (DifferentLetter y x) r))
  (match erased d _
    ((Below _ _ i j fx fy lt) (Above y x j i fy fx lt))
    ((Above _ _ i j fx fy gt) (Below y x j i fy fx gt))))

(def-fns _ $ (erased cost-sym : (erased (Char) x) (erased (Char) y) (erased (Nat) c) (erased (LetterCost x y c) lc) -> (erased (LetterCost y x c) r))
  (match erased lc _
    ((LettersMatch _ _ s) (LettersMatch y x (same-sym x y s)))
    ((LettersDiffer _ _ d) (LettersDiffer y x (different-sym x y d)))))

(def-fns _
  ((erased at-least-sym : (erased (String) a) (erased (String) b) (erased (Nat) k)
        (subterm erased (AtLeast a b k) p) -> (erased (AtLeast b a k) r))
    (match erased p _
      ((Trivially _ _) (Trivially b a))
      ((OnlyDeletes x a1 _ j rest en) (OnlyInserts x a1 k j (at-least-sym _ _ _ rest) en))
      ((OnlyInserts y b1 _ j rest en) (OnlyDeletes y b1 k j (at-least-sym _ _ _ rest) en))
      ((EveryFirstStep x y a1 b1 _ cp lc jp pair pe jd delete de ji insert ie swap)
        (EveryFirstStep y x b1 a1 k cp (cost-sym x y cp lc) jp (at-least-sym _ _ _ pair) pe
          ji (at-least-sym _ _ _ insert) ie jd (at-least-sym _ _ _ delete) de (swap-sym _ _ _ _ _ swap)))))
  ((erased swap-sym : (erased (Char) x) (erased (String) a) (erased (Char) y) (erased (String) b) (erased (Nat) k)
        (subterm erased (SwapBound x a y b k) p) -> (erased (SwapBound y b x a k) r))
    (match erased p _
      ((NothingToSwapLeft _ _ _ _) (NothingToSwapRight y b x k))
      ((NothingToSwapRight _ _ _ _) (NothingToSwapLeft y x a k))
      ((SwapCosts x1 x2 a2 y1 y2 b2 _ c1 l1 c2 l2 c m j rest en)
        (SwapCosts y1 y2 b2 x1 x2 a2 k c2 (cost-sym x2 y1 c2 l2) c1 (cost-sym x1 y2 c1 l1) c (add-comm c1 c2 c m) j (at-least-sym _ _ _ rest) en)))))

(def-fns _ $ (erased letter-cost : (erased (Char) x) (erased (Char) y) -> (erased (Nat) c) (erased (LetterCost x y c) lc))
  (let ((erased i) (erased fx)) (fold x))
  (let ((erased j) (erased fy)) (fold y))
  (match erased (letters x y i fx j fy) (((Nat) c) ((LetterCost x y c) lc))
    ((SameLetters _ _ s) (values (Zero) (LettersMatch x y s)))
    ((DifferentLetters _ _ d) (values (Succ (Zero)) (LettersDiffer x y d)))))

(def-fns _ $ (erased covers-free : (erased (Nat) c) (erased (Nat) k) -> (erased (Covers c k k) r))
  (let ((erased s) (erased p)) (add c k))
  (MkCovers c k k s p (MkLe k s (add-le-right c k s p))))

(def-fns _ $ (erased gap-bound : (subterm erased (String) a) (subterm erased (String) b) (erased (Nat) la) (erased (Nat) lb) (erased (Nat) k) (erased (Nat) c)
    (erased (StrLength a la) pa) (erased (StrLength b lb) pb) (erased (Add k la c) s) (erased (Lt c (Succ lb)) le) -> (erased (AtLeast a b k) r))
  (let-match erased s (AddSucc k1 _ c1 s1) ((AddZero _) (Trivially a b)))
  (let-match erased le (LtS _ _ le1))
  (let-match erased b (SCons y b1) (absurd (SNil) (let-match erased pb (SLenNil)) le1))
  (let-match erased pb (SLenCons _ _ lb1 pb1))
  (let-match erased a (SCons x a1)
    ((SNil) (let-match erased pa (SLenNil))
      (OnlyInserts y b1 k k1 (gap-bound (SNil) b1 (Zero) lb1 k1 c1 (SLenNil) pb1 s1 le1) (covers-paid (Zero) k1))))
  (let-match erased pa (SLenCons _ _ la1 pa1))
  (let ((erased c2) (erased e2) (erased s2)) (add-succ-right-inv k1 la1 c1 s1))
  (let-match erased e2 (Refl _ _))
  (let-match erased le1 (LtS _ _ le2))
  (let ((erased cp) (erased lc)) (letter-cost x y))
  (let ((erased swap))
    (match erased a1 (((SwapBound x a1 y b1 k) r))
      ((SNil) (NothingToSwapLeft x y b1 k))
      ((SCons x2 a2)
        (let-match erased b1 (SCons y2 b2) ((SNil) (NothingToSwapRight x a1 y k)))
        (let-match erased pa1 (SLenCons _ _ la2 pa2))
        (let-match erased pb1 (SLenCons _ _ lb2 pb2))
        (let ((erased c3) (erased e3) (erased s3)) (add-succ-right-inv k1 la2 c2 s2))
        (let-match erased e3 (Refl _ _))
        (let-match erased le2 (LtS _ _ le3))
        (let ((erased u1) (erased l1)) (letter-cost x y2))
        (let ((erased u2) (erased l2)) (letter-cost x2 y))
        (let ((erased u) (erased pu)) (add u1 u2))
        (SwapCosts x x2 a2 y y2 b2 k u1 l1 u2 l2 u pu k1 (gap-bound a2 b2 la2 lb2 k1 c3 pa2 pb2 s3 (lt-weaken _ _ le3)) (covers-paid u k1)))))
  (EveryFirstStep x y a1 b1 k
    cp lc k (gap-bound a1 b1 la1 lb1 k (Succ c2) pa1 pb1 (AddSucc k1 la1 c2 s2) (LtS _ _ le2)) (covers-free cp k)
    k1 (gap-bound a1 b la1 lb k1 c2 pa1 pb s2 (lt-weaken _ _ (lt-weaken _ _ le2))) (covers-paid (Zero) k1)
    k1 (gap-bound a b1 la lb1 k1 c1 pa pb1 s1 le1) (covers-paid (Zero) k1)
    swap))

(def-adts
  ((Gap : ((String) a) ((String) b) ((Nat) k) -> Type)
    enum
    (many FarApart : (erased (String) a) (erased (String) b) (erased (Nat) k) (erased (AtLeast a b k) p) -> (Gap a b k))
    (many Unknown : (erased (String) a) (erased (String) b) (erased (Nat) k) -> (Gap a b k))))

(def-fns _ $ (many gap : (erased (String) a) (many (Nat) la) (erased (StrLength a la) pa) (erased (String) b) (many (Nat) lb) (erased (StrLength b lb) pb)
    (many (Nat) k) -> (many (Gap a b k) r))
  (let ((many c) (erased s)) (add k la))
  (let-match many (lt-dec c (Succ lb)) (No _ _ _) ((Yes _ _ le) (FarApart a b k (gap-bound a b la lb k c pa pb s le))))
  (let ((many c2) (erased s2)) (add k lb))
  (match many (lt-dec c2 (Succ la)) _
    ((Yes _ _ le) (FarApart a b k (at-least-sym b a k (gap-bound b a lb la k c2 pb pa s2 le))))
    ((No _ _ _) (Unknown a b k))))

(def-fns _ $ (erased far : (erased (String) q) (erased (String) w) (erased (Nat) d) (erased (AtLeast q w (Succ d)) p)
    -> (erased (Nat) e) (erased (Distance q w e) dist) (erased (Lt d e) farther))
  (let ((erased e) (erased dist)) (distance q w))
  (let-match erased dist (MkDistance _ _ _ edits _))
  (let-match erased (at-least-sound _ _ _ _ edits p) (LtS _ _ farther))
  (values e dist farther))

(def-fns _
  ((many scan : (erased (String) q) (many (Codes q) cq) (many (Nat) lq) (erased (StrLength q lq) pq) (erased (String) text) (erased (List (U8)) xs) (many (Bytes xs) bs) (erased (Nat) n) (erased (Length (U8) xs n) ln) (erased (StrBytes text xs) sbt)
        (subterm many (Nat) o) (erased (String) t) (erased (Drop xs o t) dt) (erased (Boundary t) bd)
        (erased (List (String)) sfx) (erased (Words t sfx) wds)
        (many (Nat) d) (many (List (String)) rs) (erased (Nearest q sfx d rs) p) (many (Nat) cap)
        (erased (List (Copy (U62))) ks) (unique (Array (Copy (U62)) ks) ka) (erased (Length (Copy (U62)) ks cap) lk) (erased (List (Copy (U62))) x0) (unique (Array (Copy (U62)) x0) b0) (erased (Length (Copy (U62)) x0 cap) l0) (erased (List (Copy (U62))) x1) (unique (Array (Copy (U62)) x1) b1) (erased (Length (Copy (U62)) x1 cap) l1) (erased (List (Copy (U62))) x2) (unique (Array (Copy (U62)) x2) b2) (erased (Length (Copy (U62)) x2 cap) l2)
        -> (many (Nat) d2) (many (List (String)) rs2) (erased (List (String)) ws) (erased (Words text ws) wd) (erased (Nearest q ws d2 rs2) p2)
        (erased (List (Copy (U62))) ks2) (unique (Array (Copy (U62)) ks2) ka2 at ka) (erased (Length (Copy (U62)) ks2 cap) lk2) (erased (List (Copy (U62))) y0) (unique (Array (Copy (U62)) y0) r0 at b0) (erased (Length (Copy (U62)) y0 cap) k0) (erased (List (Copy (U62))) y1) (unique (Array (Copy (U62)) y1) r1 at b1) (erased (Length (Copy (U62)) y1 cap) k1) (erased (List (Copy (U62))) y2) (unique (Array (Copy (U62)) y2) r2 at b2) (erased (Length (Copy (U62)) y2 cap) k2))
    (let-match many o (Succ o1)
      ((Zero) (let-match erased (drop-zero text xs sbt t dt) (Refl _ _)) (values d rs sfx wds p ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2)))
    (let ((erased le)) (drop-le xs o n t dt ln))
    (let-match erased le (LtS _ _ lt))
    (let ((erased x) (erased nth)) (nth-exists _ xs n o1 ln lt))
    (let ((many b)) (bytes-get-many xs bs o1 x nth))
    (let-match many (classify b) (OtherByte _ nl)
      ((NewlineByte _ e)
        (let-match erased e (Refl _ _))
        (tail $ scan q cq lq pq text xs bs n ln sbt o1 (SCons #\newline t) (DropChar xs o1 b t nth dt) (AtNewline t) sfx (SkipNewline t sfx wds) d rs p cap ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2)))
    (let ((many k) (erased s) (erased wt) (erased dw) (erased w) (erased wth) (erased lw) (erased ok) (erased sum))
      (word-back xs bs n ln o1 (SCons (MkChar b) t) (DropChar xs o1 b t nth dt) (SCons (MkChar b) (SNil)) t (first-char t (MkChar b) bd nl)
        (Succ (Zero)) (SLenCons (MkChar b) (SNil) (Zero) (SLenNil)) o (add-succ-right o1 (Zero) o1 (add-zero-right o1))))
    (let ((many sr) (erased sum2)) (sub o k (add-le-right s k o sum)))
    (let-match erased (add-cancel-left k sr s o sum2 (add-comm s k o sum)) (Refl _ _))
    (let-match erased lw (SLenCons _ _ k1 _) (absurd (SLenNil) wth))
    (let ((erased c1) (erased e1) (erased sum1)) (add-succ-right-inv sr k1 o sum))
    (let-match erased e1 (Refl _ _))
    (let ((erased dec)) (lt-subterm sr o (add-le-left sr k1 c1 sum1)))
    (let ((erased wds2)) (TakeWord wt w t sfx wth wds))
    (let-match many rs (Cons _ r1 rs1)
      ((Nil _)
        (let-match erased p (NoWords _ _))
        (let ((many e) (erased de) (erased ks3) (unique ka3) (erased lk3) (erased x3) (unique b3) (erased l3) (erased x4) (unique b4) (erased l4) (erased x5) (unique b5) (erased l5)) (word-distance q cq lq pq xs bs n ln sr k o sum le wt dw w t wth lw cap ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2))
        (let ((many wstr)) (word-string xs bs n ln sr k o sum le wt dw w t wth lw))
        (tail $ resume q cq lq pq text xs bs n ln sbt (subterm dec) sr ok wt dw (Cons _ w sfx) wds2 e (Cons _ wstr (Nil _)) (Closest q _ e w _ (RankedTie q w sfx e _ de (RankedNil q e))) cap ks3 ka3 lk3 x3 b3 l3 x4 b4 l4 x5 b5 l5)))
    (let-match erased p (Closest _ _ _ _ _ ranked))
    (let-match many (gap q lq pq w k lw (Succ d)) (Unknown _ _ _)
      ((FarApart _ _ _ bound)
        (let ((erased e) (erased de) (erased gt)) (far q w d bound))
        (tail $ resume q cq lq pq text xs bs n ln sbt (subterm dec) sr ok wt dw (Cons _ w sfx) wds2 d rs (Closest q _ d r1 rs1 (RankedFar q w sfx d _ e de gt ranked)) cap ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2)))
    (let ((many e) (erased de) (erased ks3) (unique ka3) (erased lk3) (erased x3) (unique b3) (erased l3) (erased x4) (unique b4) (erased l4) (erased x5) (unique b5) (erased l5)) (word-distance q cq lq pq xs bs n ln sr k o sum le wt dw w t wth lw cap ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2))
    (match many (nat-cmp e d) _
      ((CLt _ _ _ _ closer)
        (let ((many wstr)) (word-string xs bs n ln sr k o sum le wt dw w t wth lw))
        (tail $ resume q cq lq pq text xs bs n ln sbt (subterm dec) sr ok wt dw (Cons _ w sfx) wds2 e (Cons _ wstr (Nil _)) (Closest q _ e w _ (RankedTie q w sfx e _ de (rerank _ _ _ _ _ ranked closer))) cap ks3 ka3 lk3 x3 b3 l3 x4 b4 l4 x5 b5 l5))
      ((CEq _ _ _)
        (let ((many wstr)) (word-string xs bs n ln sr k o sum le wt dw w t wth lw))
        (tail $ resume q cq lq pq text xs bs n ln sbt (subterm dec) sr ok wt dw (Cons _ w sfx) wds2 d (Cons _ wstr rs) (Closest q _ d w _ (RankedTie q w sfx d _ de ranked)) cap ks3 ka3 lk3 x3 b3 l3 x4 b4 l4 x5 b5 l5))
      ((CGt _ _ _ _ gt) (tail $ resume q cq lq pq text xs bs n ln sbt (subterm dec) sr ok wt dw (Cons _ w sfx) wds2 d rs (Closest q _ d r1 rs1 (RankedFar q w sfx d _ e de gt ranked)) cap ks3 ka3 lk3 x3 b3 l3 x4 b4 l4 x5 b5 l5))))
  ((many resume : (erased (String) q) (many (Codes q) cq) (many (Nat) lq) (erased (StrLength q lq) pq) (erased (String) text) (erased (List (U8)) xs) (many (Bytes xs) bs) (erased (Nat) n) (erased (Length (U8) xs n) ln) (erased (StrBytes text xs) sbt)
        (subterm many (Nat) s) (erased (StartOk xs s) ok) (erased (String) t) (erased (Drop xs s t) dt)
        (erased (List (String)) sfx) (erased (Words t sfx) wds)
        (many (Nat) d) (many (List (String)) rs) (erased (Nearest q sfx d rs) p) (many (Nat) cap)
        (erased (List (Copy (U62))) ks) (unique (Array (Copy (U62)) ks) ka) (erased (Length (Copy (U62)) ks cap) lk) (erased (List (Copy (U62))) x0) (unique (Array (Copy (U62)) x0) b0) (erased (Length (Copy (U62)) x0 cap) l0) (erased (List (Copy (U62))) x1) (unique (Array (Copy (U62)) x1) b1) (erased (Length (Copy (U62)) x1 cap) l1) (erased (List (Copy (U62))) x2) (unique (Array (Copy (U62)) x2) b2) (erased (Length (Copy (U62)) x2 cap) l2)
        -> (many (Nat) d2) (many (List (String)) rs2) (erased (List (String)) ws) (erased (Words text ws) wd) (erased (Nearest q ws d2 rs2) p2)
        (erased (List (Copy (U62))) ks2) (unique (Array (Copy (U62)) ks2) ka2 at ka) (erased (Length (Copy (U62)) ks2 cap) lk2) (erased (List (Copy (U62))) y0) (unique (Array (Copy (U62)) y0) r0 at b0) (erased (Length (Copy (U62)) y0 cap) k0) (erased (List (Copy (U62))) y1) (unique (Array (Copy (U62)) y1) r1 at b1) (erased (Length (Copy (U62)) y1 cap) k1) (erased (List (Copy (U62))) y2) (unique (Array (Copy (U62)) y2) r2 at b2) (erased (Length (Copy (U62)) y2 cap) k2))
    (let-match many s (Succ s1)
      ((Zero) (let-match erased (drop-zero text xs sbt t dt) (Refl _ _)) (values d rs sfx wds p ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2)))
    (let-match erased ok (PastNewline _ _ u here e))
    (let-match erased e (Refl _ _))
    (tail $ scan q cq lq pq text xs bs n ln sbt s1 (SCons #\newline t) (DropChar xs s1 u t here dt) (AtNewline t) sfx (SkipNewline t sfx wds) d rs p cap ks ka lk x0 b0 l0 x1 b1 l1 x2 b2 l2)))

(def-fns _ $ (many longest-line : (erased (List (U8)) xs) (many (Bytes xs) bs) (many (Nat) n) (erased (Length (U8) xs n) ln)
    (many (Nat) i) (many (Nat) cur) (many (Nat) best) (subterm many (Nat) fuel) -> (many (Nat) r))
  (let ((many top)) (match many (lt-dec best cur) (((Nat) r)) ((Yes _ _ _) cur) ((No _ _ _) best)))
  (let-match many fuel (Succ f) ((Zero) top))
  (let-match many (lt-dec i n) (Yes _ _ lt) ((No _ _ _) top))
  (let ((erased x) (erased nth)) (nth-exists _ xs n i ln lt))
  (match many (classify (bytes-get-many xs bs i x nth)) _
    ((NewlineByte _ _) (tail $ longest-line xs bs n ln (Succ i) (Zero) top f))
    ((OtherByte _ _) (tail $ longest-line xs bs n ln (Succ i) (Succ cur) best f))))

(def-adts
  ((Answer : ((String) text) ((String) query) -> Type)
    enum
    (many NoQuery : (erased (String) text) (erased (String) query) (erased (Words query (Nil (String))) none) -> (Answer text query))
    (many Found : (erased (String) text) (erased (String) query) (many (Nat) d) (many (List (String)) rs)
       (erased (List (String)) ws) (erased (Words text ws) words) (erased (String) q) (erased (List (String)) qs)
       (erased (Words query (Cons (String) q qs)) queries) (erased (Nearest q ws d rs) nearest) -> (Answer text query))))

(def-fns _ $ (many nearest-in : (many (String) text) (many (String) query) -> (many (Answer text query) r))
  (let ((many qws) (erased wq)) (split-words query))
  (let-match many qws (Cons _ q qs) ((Nil _) (NoQuery text query wq)))
  (let ((erased xs) (unique b) (erased sbt)) (str-bytes-copy text))
  (let ((many bs)) (share b))
  (let ((many n) (erased ln)) (bytes-length-many xs bs))
  (let ((many lq) (erased pq)) (str-length q))
  (let ((many cap)) (Succ (longest-line xs bs n ln (Zero) (Zero) (Zero) n)))
  (let ((many z)) (MkU62 (Zero) u62-modulus-pos))
  (let ((erased ks) (unique ka) (erased rk)) (array-make (U62) cap z))
  (let ((erased x0) (unique b0) (erased r0)) (array-make (U62) cap z))
  (let ((erased x1) (unique b1) (erased r1)) (array-make (U62) cap z))
  (let ((erased x2) (unique b2) (erased r2)) (array-make (U62) cap z))
  (let ((many d) (many rs) (erased ws) (erased wd) (erased p) (erased ks3) (unique ka3) (erased lk3) (erased x3) (unique b3) (erased l3) (erased x4) (unique b4) (erased l4) (erased x5) (unique b5) (erased l5))
    (scan q (codes q) lq pq text xs bs n ln sbt n (SNil) (DropEnd xs n ln) (AtTextEnd) (Nil _) (NoText) (Zero) (Nil _) (NoWords q (Zero)) cap
      ks ka (repeat-length _ _ _ _ rk) x0 b0 (repeat-length _ _ _ _ r0) x1 b1 (repeat-length _ _ _ _ r1) x2 b2 (repeat-length _ _ _ _ r2)))
  (Found text query d rs ws wd q qs wq p))

(def-fns _ $ (many answer : (many (String) text) (many (String) query) -> (many (String) out))
  (match many (nearest-in text query) _
    ((NoQuery _ _ _) "no query word\n")
    ((Found _ _ d rs _ _ _ _ _ _) (show d rs))))
