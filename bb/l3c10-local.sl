(sk-family Sk5 MkSk5 sk5-of ()
  (c-st3 (1 DR "" TV "01" TV) (1 DR "1" TV "1" TV))
  (c-m1 (1 DR "01" TV "101111110000" TV) (2 DL "1" TV "0001111111111" TV))
  (c-m11a (1 DR "" TV "110111111" TV) (2 DL "1" TV "00001111" TV))
  (c-m11b (1 DR "" TV "11001111110000" TV) (2 DL "1" TV "0000000111111" TV))
  (c-m11c (1 DR "" TV "110001111110000" TV) (2 DL "1" TV "00000000111111" TV))
  (c-m011a (1 DR "" TV "0110111111" TV) (2 DL "1" TV "000001111" TV))
  (c-m011b (1 DR "" TV "011001111110000" TV) (2 DL "1" TV "00000000111111" TV))
  (c-m011c (1 DR "" TV "0110001111110000" TV) (2 DL "1" TV "000000000111111" TV)))
(comptime-match many (sk5-of p3) (ROk _ sg5))

(def-adts
  ((Dx : ((Rq) e) ((List (Bool)) X) ((Conf) c) -> Type)
    enum
    (many MkDx : (erased (Nat) q) (erased (List (Rn)) L R) (erased (Bool) h) (erased (List (Bool)) l r X rx) (erased (Den L l) dl) (erased (Den R r) dr)
       (erased (Cat (Bool) r X rx) cx) -> (Dx (MkRq q L h R) X (MkConf q l h rx)))))

(def-fns _ $ (erased rp-catx : (erased (Bool) b) (erased (Nat) w) (erased (List (Bool)) r y X yX) (subterm erased (Rp b w r y) p) (erased (Cat (Bool) y X yX) c)
    -> (erased (List (Bool)) rX) (erased (Cat (Bool) r X rX) c2) (erased (Rp b w rX yX) q))
  (let-match erased p (RpS _ w1 _ y1 p1) ((RpZ _ _) (values yX c (RpZ b yX))))
  (let-match erased c (CatC _ _ _ _ y1X c1))
  (let ((erased rX) (erased c2) (erased q1)) (rp-catx b w1 r y1 X y1X p1 c1))
  (values rX c2 (RpS b w1 rX y1X q1)))

(def-adts
  ((BNeg : ((Bool) a b) -> Type)
    enum
    (many BnT : -> (BNeg (BTrue) (BFalse)))
    (many BnF : -> (BNeg (BFalse) (BTrue)))))

(def-fns _ $ (erased mac-go : (erased (Bool) b nb) (erased (BNeg b nb) ng) (erased (Nat) p) (erased (List (Bool)) l x r) (erased (Rp b p l x) rp)
    -> (erased (Nat) t) (erased (List (Bool)) y) (erased (Rp nb p r y) q) (erased (Run l3 (MkConf 2 x b r) t (MkConf 2 l b y)) run))
  (match erased ng _
    ((BnT)
      (let ((erased y) (erased q) (erased g)) (wipe-go p l x r rp))
      (let ((erased t) (erased run)) (go-run 2 2 _ _ _ _ _ _ g))
      (values t y q run))
    ((BnF)
      (let ((erased y) (erased q) (erased g)) (chain-go p l x r rp))
      (let ((erased t) (erased run)) (go-run 2 2 _ _ _ _ _ _ g))
      (values t y q run))))

(def-lvl LF)

(def-adts
  ((FR : ((Rq) e e2) -> Type)
    enum
    (many MkFR : (erased (Rq) e e2)
       (erased (Fn LF (erased (List (Bool)) X) (erased (Conf) c) (erased (Dx e X c) d)
           -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) r) (erased (Dx e2 X c2) d2) (erased (CEz c2 a) z)) f)
       -> (FR e e2))))

(def-adts
  ((FRs : ((Rq) e) -> Type)
    enum
    (many FOk : (erased (Rq) e) (many (Rq) e2) (erased (FR e e2) p) -> (FRs e))
    (many FNo : (erased (Rq) e) -> (FRs e))))

(def-adts
  ((FSq : ((Rq) e e2) -> Type)
    enum
    (many FsN : (erased (Rq) e) -> (FSq e e))
    (many FsC : (erased (Rq) e e1 e2) (erased (FSq e e1) s) (erased (FR e1 e2) p) -> (FSq e e2))))

(def-fns _ $ (erased fsq-run : (erased (Rq) e e2) (subterm erased (FSq e e2) s) (erased (List (Bool)) X) (erased (Conf) c) (erased (Dx e X c) d)
    -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) r) (erased (Dx e2 X c2) d2) (erased (CEz c2 a) z))
  (let-match erased s (FsC _ e1 _ s1 p) ((FsN _) (values c c (Zero) (RNil l3 c) d (cez-refl c))))
  (let ((erased a1) (erased c1) (erased t1) (erased r1) (erased d1) (erased z1)) (fsq-run e e1 s1 X c d))
  (let-match erased p (MkFR _ _ f))
  (let ((erased a2) (erased c3) (erased t2) (erased r2) (erased d2) (erased z2)) (f X c1 d1))
  (let ((erased a3) (erased r3) (erased z3)) (run-eqz l3 c1 a2 a1 t2 r2 z1))
  (let ((erased t) (erased r)) (run-cat l3 c a1 a3 t1 t2 r1 r3))
  (values a3 c3 t r d2 (cez-trans c3 a2 a3 z2 z3)))

(def-fns _ $ (many f-step : (many (Rq) e) -> (many (FRs e) res))
  (let ((many no)) (FNo e))
  (let-match many e (MkRq q L h R))
  (let-match many (tlook l3 q h) (LkOk _ _ _ tr lk) ((LkNo _ _ _) no))
  (let-match many tr (Mov w d q2) ((Hlt) no))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (match many d _
    ((DL)
      (let ((many h2) (many L2) (erased l2) (many pp) (erased dl2)) (rpop L l dl))
      (let ((many R2) (erased dr2)) (push w R r dr))
      (def-fns LF $ (erased pf : (erased (List (Bool)) X) (erased (Conf) c) (erased (Dx e X c) dx)
          -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) run) (erased (Dx (MkRq q2 L2 h2 R2) X c2) d2) (erased (CEz c2 a) z))
        (let-match erased dx (MkDx _ _ _ _ l1 r1 _ rx dl1 dr1 cx))
        (let-match erased (den-fn L l l1 dl dl1) (Refl _ _))
        (let-match erased (den-fn R r r1 dr dr1) (Refl _ _))
        (let ((erased a)) (MkConf q2 l2 h2 (Cons (Bool) w rx)))
        (values a a (Succ (Zero)) (RSnoc l3 c c a (Zero) (RNil l3 c) (StepL l3 q q2 l rx l2 h w h2 lk pp))
          (MkDx q2 L2 R2 h2 l2 (Cons (Bool) w r) X (Cons (Bool) w rx) dl2 dr2 (CatC _ w r X rx cx)) (cez-refl a)))
      (FOk e (MkRq q2 L2 h2 R2) (MkFR e _ pf)))
    ((DR)
      (let ((many h2) (many R2) (erased r2) (many pp) (erased dr2)) (rpop R r dr))
      (let-match many pp (PullCons _ _) ((PullNil) no))
      (let ((many L2) (erased y) (erased z2) (erased dl2) (erased p) (erased ez)) (cpushn w (Succ (Zero)) L l dl))
      (let-match erased p (RpS _ _ _ _ p1))
      (let-match erased p1 (RpZ _ _))
      (def-fns LF $ (erased pf : (erased (List (Bool)) X) (erased (Conf) c) (erased (Dx e X c) dx)
          -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) run) (erased (Dx (MkRq q2 L2 h2 R2) X c2) d2) (erased (CEz c2 a) z))
        (let-match erased dx (MkDx _ _ _ _ l1 r1 _ rx dl1 dr1 cx))
        (let-match erased (den-fn L l l1 dl dl1) (Refl _ _))
        (let-match erased (den-fn R r r1 dr dr1) (Refl _ _))
        (let-match erased cx (CatC _ _ _ _ r2X cx2))
        (let ((erased a)) (MkConf q2 (Cons (Bool) w l) h2 r2X))
        (values a (MkConf q2 y h2 r2X) (Succ (Zero)) (RSnoc l3 c c a (Zero) (RNil l3 c) (StepR l3 q q2 l rx r2X h w h2 lk (PullCons h2 r2X)))
          (MkDx q2 L2 R2 h2 y r2 X r2X dl2 dr2 cx2) (MkCEz q2 y r2X (Cons (Bool) w l) r2X h2 ez (eqz-refl r2X))))
      (FOk e (MkRq q2 L2 h2 R2) (MkFR e _ pf)))))

(def-fns _ $ (many bneg : (many (Bool) b) -> (many (Bool) nb) (erased (BNeg b nb) ng))
  (match many b _ ((BTrue) (values (BFalse) (BnT))) ((BFalse) (values (BTrue) (BnF)))))

(def-fns _ $ (many f-mac : (many (Rq) e) -> (many (FRs e) res))
  (let ((many no)) (FNo e))
  (let-match many e (MkRq q L h R))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) no))
  (let-match many L (Cons _ rn L1) ((Nil _) no))
  (let-match many rn (MkRn b p))
  (let-match many (eq-bit b h) (ESome _ eb) ((ENone _) no))
  (let-match many p (Succ _) ((Zero) no))
  (let-match erased eq (Refl _ _))
  (let-match erased eb (Refl _ _))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let-match erased dl (DeC _ _ _ l1 _ dl1 rp))
  (let ((many nb) (erased ng)) (bneg b))
  (let ((many R2) (erased y0) (erased p0) (erased d2)) (pushrun nb p R r dr))
  (def-fns LF $ (erased pf : (erased (List (Bool)) X) (erased (Conf) c) (erased (Dx e X c) dx)
      -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) run) (erased (Dx (MkRq 2 L1 h R2) X c2) d2) (erased (CEz c2 a) z))
    (let-match erased dx (MkDx _ _ _ _ la r1 _ rx dla dr1 cx))
    (let-match erased (den-fn L l la dl dla) (Refl _ _))
    (let-match erased (den-fn R r r1 dr dr1) (Refl _ _))
    (let ((erased t) (erased y) (erased q1) (erased run)) (mac-go b nb ng p l1 l rx rp))
    (let ((erased a)) (MkConf 2 l1 h y))
    (values a a t run (MkDx 2 L1 R2 h l1 y0 X y dl1 d2 (rp-cat nb p r y0 X rx y p0 q1 cx)) (cez-refl a)))
  (FOk e (MkRq 2 L1 h R2) (MkFR e _ pf)))

(def-fns _ $ (many f-apply : (many (Rq) e)
    (erased (List (Bool)) lz x0 u y xr) (many (Nat) n) (many (List (Rn)) L0) (erased (Den L0 lz) d0) (erased (Rp (BTrue) n lz x0) p0)
    (erased (List (Tk)) X) (erased (Tt) T) (erased (XT X T u) px) (many (List (Rn)) R1) (erased (Den R1 y) d1) (erased (Cat (Bool) u y xr) cu)
    (erased (Dc e (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr))) dc)
    (many (Nat) k w) (many (List (Tk)) Z) (many (Tt) U) (erased (RdK k X T Z U w) rk) -> (many (FRs e) res))
  (let-match many (stripz w R1 y d1) (SzOk _ _ r2 R2 d2 pw) ((SzNo _ _) (FNo e)))
  (let ((many m2) (erased mk2)) (mul k (Succ (Succ (Succ (Zero))))))
  (let ((many s) (erased as)) (add m2 n))
  (let ((many Lo)) (Cons _ (MkRn (BFalse) (Succ (Succ (Zero)))) (Cons _ (MkRn (BTrue) s) L0)))
  (let-match many (xtr Z U) (MkXTR _ _ U3 u3 pu3 dU3))
  (let ((many C) (erased dC)) (push (BFalse) U3 u3 dU3))
  (let ((many Ro) (erased ro) (erased dRo) (erased cro)) (rapp C (Cons (Bool) (BFalse) u3) dC R2 r2 d2))
  (let-match erased cro (CatC _ _ _ _ zr2 cz))
  (def-fns LF $ (erased pf : (erased (List (Bool)) XX) (erased (Conf) c) (erased (Dx e XX c) dx)
      -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) run) (erased (Dx (MkRq 2 Lo (BTrue) Ro) XX c2) dd) (erased (CEz c2 a) z))
    (let-match erased dx (MkDx _ L R _ la ra _ rx dla dra cx))
    (let-match erased dc (MkDc _ _ _ _ l0 r0 dl0 dr0))
    (let-match erased (den-fn L la l0 dla dl0) (Refl _ _))
    (let-match erased (den-fn R ra r0 dra dr0) (Refl _ _))
    (let-match erased cx (CatC _ _ _ _ xrX cxr))
    (let ((erased yX) (erased cyX) (erased cuX)) (cat-assoc (Bool) u y xr XX xrX cu cxr))
    (let ((erased r2X) (erased cr2X) (erased pwX)) (rp-catx (BFalse) w r2 y XX yX pw cyX))
    (let ((erased v) (erased tb) (erased xb)) (xt-cat X T u yX xrX px cuX))
    (let ((erased m) (erased mk) (erased x3) (erased u2) (erased zr) (erased p1) (erased tb3) (erased zb) (erased t) (erased run))
      (rdk-run k w n X Z T U rk lz r2X x0 yX v xrX p0 pwX tb xb))
    (let-match erased (mul-fn k n3 m m2 mk mk2) (Refl _ _))
    (let ((erased zr2X) (erased czX)) (cat-ex (Bool) zr2 XX))
    (let ((erased w2) (erased cw2) (erased cuz)) (cat-assoc (Bool) u3 r2 zr2 XX zr2X cz czX))
    (let-match erased (cat-fn (Bool) r2 XX w2 r2X cw2 cr2X) (Refl _ _))
    (let ((erased v3) (erased tb4) (erased zb2)) (xt-cat Z U u3 r2X zr2X pu3 cuz))
    (let-match erased (tb-fn U r2X u2 v3 tb3 tb4) (Refl _ _))
    (let-match erased (xb-fn Z u2 zr zr2X zb zb2) (Refl _ _))
    (let ((erased dLo)) (DeC (BFalse) n2 (Cons _ (MkRn (BTrue) s) L0) x3 (bits "00" x3) (DeC (BTrue) s L0 lz x3 d0 (rp-add (BTrue) m n s lz x0 x3 p1 p0 as)) (rp2 _ x3)))
    (let ((erased a)) (MkConf 2 (bits "00" x3) (BTrue) (bits "0" zr)))
    (values a a t run (MkDx 2 Lo Ro (BTrue) (bits "00" x3) ro XX (bits "0" zr) dLo dRo (CatC _ (BFalse) zr2 XX zr2X czX)) (cez-refl a)))
  (FOk e (MkRq 2 Lo (BTrue) Ro) (MkFR e _ pf)))

(def-fns _ $ (many f-jump : (many (Rq) e) (many (LmR e) lm) -> (many (FRs e) res))
  (let ((many no)) (FNo e))
  (let-match many lm (LmOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc) ((LmNo _) no))
  (let ((many inf) (many g)) (c-avail R1))
  (let-match many (lt-dec g 24) (No _ _ _ _ _) ((Yes _ _ _ _ _) no))
  (let-match many (decode X T) (DecOk F s) ((DecNo) no))
  (let-match many s (Succ _) ((Zero) no))
  (let-match many (famok F) (FkOk _ ok) ((FkNo _) no))
  (let ((many nm) (erased mx)) (maxs-run F))
  (let-match many (lt-dec s (Succ nm)) (Yes _ _ _ _ bn) ((No _ _ _ _ _) no))
  (let ((many Xs) (many Ts) (erased ph)) (phi-run F s nm ok mx bn))
  (let-match many (tks-eq Xs X) (ESome _ e1) ((ENone _) no))
  (let-match many (tt-eq Ts T) (ESome _ e2) ((ENone _) no))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((many cs) (erased a1) (erased b1) (erased ra1) (erased tb1) (erased ae1)) (cells X T))
  (let ((many g3) (erased _) (erased _) (erased _) (erased _) (erased _)) (div g (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let-match many (c-refine 4 F s nm ok mx bn g (min-nat s g3) cs) (PaOk _ _ k s2 as2 Z U ph2 ez a2 b2 ra2 tb2 ae2) ((PaNo _ _) no))
  (let-match many k (Succ kj) ((Zero) no))
  (let ((erased w0) (erased rk)) (phi-chain F nm s s2 kj X Z T U ok mx bn as2 ph ph2))
  (let ((many m) (erased mk)) (mul k (Succ (Succ (Succ (Zero))))))
  (let ((many em) (erased aem)) (add ez m))
  (let-match many (lt-dec cs (Succ em)) (Yes _ _ _ _ le) ((No _ _ _ _ _) no))
  (let ((many w) (erased aw)) (sub em cs le))
  (let ((erased S) (erased q1) (erased q2)) (rdk-cells k w0 X Z T U rk a1 b1 a2 b2 cs ez m ra1 tb1 ra2 tb2 ae1 ae2 mk))
  (let-match erased (add-fn ez m S em q2 aem) (Refl _ _))
  (let-match erased (add-cancel cs w0 w S q1 aw) (Refl _ _))
  (f-apply e lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc k w Z U rk))

(def-fns _ $ (many f-round : (many (Rq) e) (many (LmR e) lm) -> (many (FRs e) res))
  (let-match many lm (LmOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc) ((LmNo _) (FNo e)))
  (let-match many (rd-run X T) (RdOk _ _ Y T2 c rd) ((RdNo _ _) (FNo e)))
  (f-apply e lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc (Succ (Zero)) c Y T2
    (RkS (Zero) c (Zero) c X Y Y T T2 T2 rd (RkZ Y T2) (add-zero-right c))))

(def-fns _ $ (many pushr : (many (Bool) b) (many (Nat) n) (many (List (Rn)) R) (erased (List (Bool)) x) (erased (Den R x) d)
    -> (many (List (Rn)) R2) (erased (List (Bool)) y) (erased (Rp b n x y) p) (erased (Den R2 y) d2))
  (match many n _ ((Zero) (values R x (RpZ b x) d)) ((Succ _) (pushrun b n R x d))))

(def-fns _ $ (many f-walk : (many (Rq) e) -> (many (FRs e) res))
  (let ((many no)) (FNo e))
  (let-match many e (MkRq q L h R))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) no))
  (let-match erased eq (Refl _ _))
  (let-match many h (BTrue) ((BFalse) no))
  (let-match many R (Cons _ rn Rrs) ((Nil _) no))
  (let-match many rn (MkRn b ga))
  (let-match many b (BFalse) ((BTrue) no))
  (let-match many ga (Succ ga1) ((Zero) no))
  (let-match many ga1 (Succ ga2) ((Zero) no))
  (let ((erased x) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let-match erased dr (DeC _ _ _ rt _ drr pa))
  (let-match erased pa (RpS _ _ _ r1 pa1))
  (let-match erased pa1 (RpS _ _ _ r2 pa2))
  (let-match many (stk-parse 1000000000 L x dl) (MkStk _ l K L3 ls d3))
  (let-match many K (Cons _ _ _) ((Nil _) no))
  (let ((many W)) (Cons _ (Tp) (Nil (Tk))))
  (let-match many (wk-run K W) (WkOk _ _ Y wk) ((WkNo _ _) no))
  (let ((many Rq2) (erased y2) (erased pz) (erased d2)) (pushr (BFalse) ga2 Rrs rt drr))
  (let-match erased (rp-fn (BFalse) ga2 rt y2 r2 pz pa2) (Refl _ _))
  (let-match many (xtr Y (TtE)) (MkXTR _ _ U3 u3 pu3 dU3))
  (let ((many C) (erased dC)) (push (BFalse) U3 u3 dU3))
  (let ((many Ro) (erased ro) (erased dRo) (erased cro)) (push-runs C (Cons (Bool) (BFalse) u3) dC Rq2 y2 d2))
  (let-match erased cro (CatC _ _ _ _ w cw))
  (def-fns LF $ (erased pf : (erased (List (Bool)) XX) (erased (Conf) c) (erased (Dx e XX c) dx)
      -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) run) (erased (Dx (MkRq 2 L3 (BTrue) Ro) XX c2) dd) (erased (CEz c2 a) z))
    (let-match erased dx (MkDx _ _ _ _ la ra _ rx dla dra cx))
    (let-match erased (den-fn L x la dl dla) (Refl _ _))
    (let-match erased (den-fn R r ra dr dra) (Refl _ _))
    (let-match erased cx (CatC _ _ _ _ rx1 cx1))
    (let-match erased cx1 (CatC _ _ _ _ r2X cr2X))
    (let ((erased yb) (erased xb) (erased g)) (wk-ok K W Y wk l r2X _ (CfH l r2X x _ K W ls (XbP (Nil (Tk)) r2X r2X (XbN r2X))) (PoP (Nil (Tk)))))
    (let ((erased t) (erased run)) (go-run 2 2 _ _ _ _ _ _ g))
    (let ((erased wX) (erased cwX)) (cat-ex (Bool) w XX))
    (let ((erased w2) (erased cw2) (erased cuz)) (cat-assoc (Bool) u3 y2 w XX wX cw cwX))
    (let-match erased (cat-fn (Bool) y2 XX w2 r2X cw2 cr2X) (Refl _ _))
    (let ((erased v) (erased tbv) (erased xbw)) (xt-cat Y (TtE) u3 r2X wX pu3 cuz))
    (let-match erased tbv (TbE _))
    (let-match erased (xb-fn Y r2X yb wX xb xbw) (Refl _ _))
    (let ((erased a)) (MkConf 2 l (BTrue) (bits "0" wX)))
    (values a a t run (MkDx 2 L3 Ro (BTrue) l ro XX (bits "0" wX) d3 dRo (CatC _ (BFalse) w XX wX cwX)) (cez-refl a)))
  (FOk e (MkRq 2 L3 (BTrue) Ro) (MkFR e _ pf)))


(def-fns _ $ (many f-move : (many (Rq) e) -> (many (FRs e) res))
  (let-match many e (MkRq q L h R))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let ((many lm)) (c-lm e (MkConf q l h r) (MkDc q L R h l r dl dr)))
  (let-match many (f-jump e lm) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-round e lm) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-walk e) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
