    ((XbN _) (let-match erased c (CatN _ _)) q)
    ((XbP X1 _ x1 p1) (let-match erased c (CatC _ _ _ _ X3 c1)) (XbP X3 w x1 (xb-app X1 Y X3 v w x1 p1 q c1)))
    ((XbZ X1 _ x1 p1) (let-match erased c (CatC _ _ _ _ X3 c1)) (XbZ X3 w x1 (xb-app X1 Y X3 v w x1 p1 q c1)))
    ((XbO X1 _ x1 p1) (let-match erased c (CatC _ _ _ _ X3 c1)) (XbO X3 w x1 (xb-app X1 Y X3 v w x1 p1 q c1)))))

(def-adts
  ((WTk : ((List (Bool)) y) -> Type)
    enum
    (many WtOk : (erased (List (Bool)) y yh r) (many (List (Bool)) w) (erased (Cat (Bool) w yh y) c) (many (Nat) h) (many (List (Rn)) R) (erased (Den R r) d)
       (erased (Rp (BFalse) h r yh) p) -> (WTk y))
    (many WtNo : (erased (List (Bool)) y) -> (WTk y))))

(def-fns _ $ (many wtk : (subterm many (Nat) n) (many (List (Rn)) R) (erased (List (Bool)) y) (erased (Den R y) d) -> (many (WTk y) res))
  (let ((many no)) (WtNo y))
  (let-match many n (Succ n1) ((Zero) no))
  (let-match many R (Cons _ rn R1) ((Nil _) no))
  (let-match many rn (MkRn b h))
  (let-match many h (Succ _) ((Zero) no))
  (let-match erased d (DeC _ _ _ y1 _ d1 p))
  (let-match many (match many b (((Bool) m))
      ((BFalse) (match many (lt-dec 8 h) _ ((Yes _ _ _ _ _) (BTrue)) ((No _ _ _ _ _) (BFalse))))
      ((BTrue) (match many (lt-dec 64 h) _ ((Yes _ _ _ _ _) (BTrue)) ((No _ _ _ _ _) (BFalse)))))
    (BFalse)
    ((BTrue) (match many b _ ((BFalse) (WtOk y y y1 (Nil (Bool)) (CatN _ y) h R1 d1 p)) ((BTrue) no))))
  (let-match many (notail $ wtk n1 R1 y1 d1) (WtOk _ yh r w1 c1 h2 R2 d2 p2) ((WtNo _) no))
  (let ((many w0) (erased pw)) (brep b h))
  (let ((many w) (erased cw)) (bcat w0 w1))
  (let ((erased w2) (erased cw2) (erased pw2)) (rp-catx b h (Nil (Bool)) w0 w1 w pw cw))
  (let-match erased cw2 (CatN _ _))
  (WtOk y yh r w (rp-cat b h w1 w yh y1 y pw2 p c1) h2 R2 d2 p2))

(def-adts $ (Tz : -> Type)
  enum
  (many TzOk : (many (List (Tk)) Y) (many (Tt) T) -> (Tz))
  (many TzNo : -> (Tz)))

(def-fns _ $ (many lrev : (erased Type A) (many (List A) acc) (subterm many (List A) l) -> (many (List A) r))
  (let-match many l (Cons _ x l1) ((Nil _) acc))
  (tail $ lrev A (Cons A x acc) l1))

(def-fns _ $ (many tps : (subterm many (Nat) z) (many (List (Tk)) acc) -> (many (List (Tk)) r))
  (let-match many z (Succ z1) ((Zero) acc))
  (tail $ tps z1 (Cons _ (Tp) acc)))

(def-fns _ $ (many tz-end : (many (List (Tk)) acc) (many (Nat) z) (many (Tt) T0 T1 T2) -> (many (Tz) r))
  (let ((many Y)) (lrev (Tk) (Nil (Tk)) acc))
  (let-match many z (Succ z1) ((Zero) (TzOk Y T0)))
  (let-match many z1 (Succ z2) ((Zero) (TzOk Y T1)))
  (match many z2 _ ((Zero) (TzOk Y T2)) ((Succ _) (TzNo))))

(def-fns _ $ (many tokz : (subterm many (List (Bool)) cs) (many (Nat) z) (many (List (Tk)) acc) -> (many (Tz) r))
  (let-match many cs (Cons _ c cs1) ((Nil _) (tz-end acc z (TtE) (TtE) (TtE))))
  (let-match many c (BTrue) ((BFalse) (tail $ tokz cs1 (Succ z) acc)))
  (let-match many cs1 (Cons _ c2 cs2) ((Nil _) (tz-end acc z (Tt1) (Tt1) (Tt1))))
  (let-match many c2 (BTrue) ((BFalse) (TzNo)))
  (let-match many cs2 (Cons _ c3 cs3) ((Nil _) (tz-end acc z (Tt11) (Tt011) (Tt0011))))
  (let-match many c3 (BTrue) ((BFalse) (TzNo)))
  (let-match many z (Succ z1) ((Zero) (tail $ tokz cs3 (Zero) (Cons _ (T0) acc))))
  (tail $ tokz cs3 (Zero) (Cons _ (T1) (tps z1 acc))))

(def-fns _ $ (many try-ident : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc0 z))
  (let-match many (c-lm e c dc0) (LmOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc) ((LmNo _) no))
  (let-match many (wtk 64 R1 y d1) (WtOk _ yh r w cw h R2 d2 ph) ((WtNo _) no))
  (let-match many w (Cons _ _ _) ((Nil _) no))
  (let ((many tbs) (erased tbn)) (tbits T))
  (let ((many cells) (erased cc)) (bcat tbs w))
  (let-match many (tokz cells (Zero) (Nil (Tk))) (TzOk Y T2) ((TzNo) no))
  (let ((many b) (erased pb)) (xt Y T2))
  (let-match many (bsame b cells) (ESome _ eb) ((ENone _) no))
  (let-match erased eb (Refl _ _))
  (let ((many X2) (erased cX)) (lcat (Tk) X Y))
  (let-match many (itl 20000 X2 T2 h (Zero) (Zero)) (ItOk _ _ k wu Z U rk))
  (let-match many k (Succ _) ((Zero) no))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X T u y xr px cu))
  (let ((erased c1)) (tb-catr T tbs y v tbn tb))
  (let ((erased vv) (erased cvv)) (cat-ex (Bool) cells yh))
  (let ((erased wy) (erased c2) (erased c3)) (cat-assoc (Bool) tbs w cells yh vv cc cvv))
  (let-match erased (cat-fn (Bool) w yh wy y c2 cw) (Refl _ _))
  (let-match erased (cat-fn (Bool) tbs y vv v c3 c1) (Refl _ _))
  (let ((erased v2) (erased tb2) (erased xb2)) (xt-cat Y T2 cells yh v pb cvv))
  (let ((erased xb3)) (xb-app X Y X2 v v2 xr xb xb2 cX))
  (let-match many (xtr X2 T2) (MkXTR _ _ U2 u2 px2 dU2))
  (let ((erased xr2) (erased cu2)) (cat-ex (Bool) u2 yh))
  (let ((erased v3) (erased tb3) (erased xb4)) (xt-cat X2 T2 u2 yh xr2 px2 cu2))
  (let-match erased (tb-fn T2 yh v2 v3 tb2 tb3) (Refl _ _))
  (let-match erased (xb-fn X2 v2 xr xr2 xb3 xb4) (Refl _ _))
  (c-apply c0 e ch lz x0 u2 yh xr n L0 d0 p0 X2 T2 px2 (Cons _ (MkRn (BFalse) h) R2) (DeC (BFalse) h R2 r yh d2 ph) cu2 dc k wu Z U rk))

(def-fns _ $ (many try-identG : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (match many (guarded e) _ ((BTrue) (try-ident c0 e ch)) ((BFalse) (RsNo l3 c0 e ch))))
