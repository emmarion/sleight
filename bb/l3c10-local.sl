  (let-match many (notail $ rns-eq a1 b1) (ESome _ e3) ((ENone _) (ENone _)))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased e3 (Refl _ _))
  (ESome _ (Refl _ a)))

(def-fns _ $ (many rq-eq : (many (Rq) a b) -> (many (ErasedMaybe (Eq (Rq) a b)) r))
  (let-match many a (MkRq q L h R))
  (let-match many b (MkRq q2 L2 h2 R2))
  (let-match many (eq-nat q q2) (ESome _ e1) ((ENone _) (ENone _)))
  (let-match many (eq-bit h h2) (ESome _ e2) ((ENone _) (ENone _)))
  (let-match many (rns-eq L L2) (ESome _ e3) ((ENone _) (ENone _)))
  (let-match many (rns-eq R R2) (ESome _ e4) ((ENone _) (ENone _)))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased e3 (Refl _ _))
  (let-match erased e4 (Refl _ _))
  (ESome _ (Refl _ a)))

(def-fns _ $ (many f-run : (subterm many (Nat) fuel) (erased (Rq) e0) (many (Rq) e) (erased (FSq e0 e) s) (many (Rq) tgt)
    -> (many (ErasedMaybe (FSq e0 tgt)) r) (many (Nat) left) (many (Rq) last))
  (let-match many (rq-eq e tgt) (ENone _) ((ESome _ eq) (let-match erased eq (Refl _ _)) (values (ESome _ s) fuel e)))
  (let-match many fuel (Succ f) ((Zero) (values (ENone _) fuel e)))
  (let-match many (f-move e) (FOk _ e2 p) ((FNo _) (values (ENone _) fuel e)))
  (tail $ f-run f e0 e2 (FsC e0 e e2 s p) tgt))
