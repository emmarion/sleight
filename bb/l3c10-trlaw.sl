(def-fns _ $ (many c10-ent-l : (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Rs l3 c0) res))
  (let-match many (nat-eq i 15) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-trainl c0 e ch)))
  (let-match many (nat-eq i 16) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-traingl c0 e ch)))
  (c10-ent-f i c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-scan-l : (subterm many (Nat) n) (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Nat) j) (many (Rs l3 c0) res))
  (let ((many r)) (fired c0 e ch (c10-ent-l i c0 e ch lm lc mp rho)))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values i r)))
  (let-match many n (Succ n1) ((Zero) (values i r)))
  (tail $ c10-scan-l n1 (Succ i) c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-move-l : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) idx) (many (Rs l3 c0) res))
