(def-fns _ $ (many rns-same : (subterm many (List (Rn)) A) (many (List (Rn)) B) -> (many (Bool) r))
  (let-match many (slot-eq (slot-of A) (slot-of B)) (ENone _) ((ESome _ _) (BTrue)))
  (let-match many A (Cons _ ra A1) ((Nil _) (match many B _ ((Nil _) (BTrue)) (else (BFalse)))))
  (let-match many B (Cons _ rb B1) ((Nil _) (BFalse)))
  (let-match many ra (MkRn x m))
  (let-match many rb (MkRn x2 m2))
  (let-match many (eq-bit x x2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (nat-eq m m2) (Equal _ _ _) (else (BFalse)))
  (tail $ rns-same A1 B1))

(def-fns _ $ (many rq-same : (many (Rq) e f) -> (many (Bool) r))
  (let-match many e (MkRq q L h R))
  (let-match many f (MkRq q2 L2 h2 R2))
  (let-match many (nat-eq q q2) (Equal _ _ _) (else (BFalse)))
  (let-match many (eq-bit h h2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (rns-same L L2) (BTrue) ((BFalse) (BFalse)))
  (rns-same R R2))

(def-fns _ $ (many tl-id : (subterm many (Nat) k) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many (try-ident c0 e ch) (RsNo _ _ _ _) ((RsOk _ _ e2 ch2) (c-dlev 1 c0 e2 ch2)))
  (let-match many k (Succ k1) ((Zero) (RsNo l3 c0 e ch)))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (c-round c0 e ch (c-lm e c dc)) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (let-match many (tl-id k1 c0 e1 ch1) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (RsOk l3 c0 e2 ch2))

(def-fns _ $ (many tl-marker : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many (tl-id 0 c0 e ch) (RsNo _ _ _ _) ((RsOk _ _ e2 ch2) (RsOk l3 c0 e2 ch2)))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (c-jump (BFalse) c0 e ch (c-lm e c dc)) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) no))
  (let-match many (tl-id 1 c0 e1 ch1) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) no))
  (RsOk l3 c0 e2 ch2))

(def-fns _ $ (many tl-walk : (subterm many (Nat) k) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many k (Succ k1) ((Zero) (RsOk l3 c0 e ch)))
  (let-match many (tl-marker c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (tail $ tl-walk k1 c0 e1 ch1))

(def-fns _ $ (many train-l : (many (Bool) g1) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many no)) (train-f g1 c0 e ch))
  (let-match many (train-tgt-s g1 c0 e ch) (TgOk t S) ((TgNo) (RsNo l3 c0 e ch)))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (c-lm e c dc) (LmOk _ _ _ _ _ _ _ _ _ _ _ _ _ R1 _ _ _) ((LmNo _) no))
  (let-match many (find-at R1 S 0) (Some _ i) ((None _) no))
  (let ((many k) (many _) (erased _) (erased _) (erased _) (erased _)) (divmod i (Succ 1) (LtZ 1)))
  (let-match many (tl-walk k c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) no))
  (let-match many (rq-same e1 t) (BTrue) ((BFalse) no))
  (RsOk l3 c0 e1 ch1))
