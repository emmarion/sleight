  (let ((many j) (many r)) (c10-scan-l 2 2 c0 e ch lm lc (None _) 0))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j r)))
  (let ((many mp) (many rho)) (fe-of lc))
  (c10-scan-l 21 5 c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-run5 : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) left) (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values fuel e ch)))
  (let ((many _) (many r)) (c10-move-l c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values fuel e1 ch1)))
