(def-fns _ $ (many rns-same : (subterm many (List (Rn)) A) (many (List (Rn)) B) -> (many (Bool) r))
  (let-match many (slot-eq (slot-of A) (slot-of B)) (ENone _) ((ESome _ _) (BTrue)))
  (let-match many A (Cons _ ra A1) ((Nil _) (match many B _ ((Nil _) (BTrue)) (else (BFalse)))))
  (let-match many B (Cons _ rb B1) ((Nil _) (BFalse)))
  (let-match many ra (MkRn x m))
  (let-match many rb (MkRn x2 m2))
  (let-match many (eq-bit x x2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (nat-eq m m2) (Equal _ _ _) (else (BFalse)))
  (tail $ rns-same A1 B1))

(def-fns _ $ (many rq-same : (many (Rq) e f) -> (many (Bool) r))
  (let-match many e (MkRq q L h R))
  (let-match many f (MkRq q2 L2 h2 R2))
  (let-match many (nat-eq q q2) (Equal _ _ _) (else (BFalse)))
  (let-match many (eq-bit h h2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (rns-same L L2) (BTrue) ((BFalse) (BFalse)))
  (rns-same R R2))

(def-fns _ $ (many tl-id : (subterm many (Nat) k) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many (try-ident c0 e ch) (RsNo _ _ _ _) ((RsOk _ _ e2 ch2) (c-dlev 1 c0 e2 ch2)))
