(def-fns _ $ (many ls-runs : (subterm many (List (Nat)) K) (many (List (Rn)) L) (erased (List (Bool)) l) (erased (Den L l) d)
    -> (many (List (Rn)) L2) (erased (List (Bool)) x) (erased (Ls l K x) ls) (erased (Den L2 x) d2))
  (let-match many K (Cons _ t K1) ((Nil _) (values L l (LsN l) d)))
  (let ((many L1) (erased y) (erased ls1) (erased d1)) (notail $ ls-runs K1 L l d))
  (let ((many L3) (erased y2) (erased p) (erased d3)) (pushrun (BTrue) t L1 y d1))
  (let ((many L4) (erased d4)) (push (BFalse) L3 y2 d3))
  (values L4 (Cons (Bool) (BFalse) y2) (LsC l y y2 t K1 ls1 p) d4))

(def-fns _ $ (many base3 : (many (List (Rn)) L) (erased (List (Bool)) x) (erased (Den L x) d) -> (many (List (Rn)) L2) (erased (Den L2 (bits "00111" x)) d2))
  (let ((many L1) (erased d1)) (push (BTrue) L x d))
  (let ((many L3) (erased d3)) (push (BTrue) L1 _ d1))
  (let ((many L4) (erased d4)) (push (BTrue) L3 _ d3))
  (let ((many L5) (erased d5)) (push (BFalse) L4 _ d4))
  (push (BFalse) L5 _ d5))

(def-fns _ $ (erased ls-fn : (erased (List (Bool)) l) (erased (List (Nat)) K) (erased (List (Bool)) x y) (subterm erased (Ls l K x) p) (erased (Ls l K y) q)
    -> (erased (Eq (List (Bool)) x y) e))
  (match erased p _
    ((LsN _) (let-match erased q (LsN _)) (Refl _ x))
    ((LsC _ y1 z1 t K1 p1 r1)
      (let-match erased q (LsC _ y2 z2 _ _ q1 r2))
      (let-match erased (ls-fn l K1 y1 y2 p1 q1) (Refl _ _))
      (let-match erased (rp-fn (BTrue) t y1 z1 z2 r1 r2) (Refl _ _))
      (Refl _ x))))

(def-fns _ $ (many try-sweep : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ l r dl dr))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) (RsNo l3 c0 e ch)))
  (let-match erased eq (Refl _ _))
  (let-match many h (BTrue) ((BFalse) (RsNo l3 c0 e ch)))
  (let-match many R (Cons _ rn R1) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many rn (MkRn b a0))
  (let-match many a0 (Succ a) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many (parse 1000000000 a R1) (MkPX X _ _) ((NoPX) (RsNo l3 c0 e ch)))
  (let-match many X (Cons _ x0 X1) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many x0 (Tp) (else (RsNo l3 c0 e ch)))
  (let-match many X1 (Cons _ x1 W) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many x1 (T1) (else (RsNo l3 c0 e ch)))
  (let-match many (sw-run (Cons _ (Succ (Succ (Succ (Zero)))) (Nil (Nat))) W) (SwOk _ _ s sw) ((SwNo _ _) (RsNo l3 c0 e ch)))
  (let-match many s (SEnd K) ((STurn _ _) (RsNo l3 c0 e ch)))
  (let-match many (strip (bits "00" (Nil (Bool))) L l dl) (StOk _ _ x0b L0 d0 cl) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let-match erased cl (CatC _ _ _ _ _ cl1))
  (let-match erased cl1 (CatC _ _ _ _ _ cl2))
  (let-match erased cl2 (CatN _ _))
  (let-match many (strip (bits "0" (Nil (Bool))) R r dr) (StOk _ _ xr R2 d2 cr) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let-match erased cr (CatC _ _ _ _ _ cr1))
  (let-match erased cr1 (CatN _ _))
  (let-match many (xtr X (TtE)) (MkXTR _ _ UB ub pu dub))
  (let-match many (strip-runs UB ub dub R2 xr d2) (StOk _ _ u R3 d3 cu) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X (TtE) ub u xr pu cu))
  (let-match erased tb (TbE _))
  (let ((many h2) (many R4) (erased u2) (many pp) (erased d4)) (rpop R3 u d3))
  (let-match many pp (PullCons _ _) ((PullNil) (RsNo l3 c0 e ch)))
  (let ((erased e1) (erased cf1) (erased g1)) (gadget x0b u xr W xb))
  (let ((erased e2) (erased so) (erased g2)) (sw-ok _ W _ sw _ u e1 cf1))
  (let-match erased so (SoE _ _ _ _ cf2))
  (let-match erased cf2 (CfB _ _ x2 _ _ _ ls2 xb2))
  (let-match erased xb2 (XbN _))
  (let ((erased tr) (erased run)) (go-run 2 1 _ _ _ _ _ _ (go-cat _ _ _ g1 g2)))
  (let ((many La) (erased dLa)) (base3 L0 x0b d0))
  (let ((many Lb) (erased x3) (erased ls3) (erased dLb)) (ls-runs K La _ dLa))
  (let-match erased (ls-fn _ K x2 x3 ls2 ls3) (Refl _ _))
  (RsOk l3 c0 (MkRq 1 Lb h2 R4) (rch-run l3 c0 c _ e _ tr ch dc run (MkDc 1 Lb R4 h2 x3 u2 dLb d4))))

(def-adts
  ((StkR : ((List (Bool)) x) -> Type)
    enum
    (many MkStk : (erased (List (Bool)) x l) (many (List (Nat)) K) (many (List (Rn)) L) (erased (Ls l K x) ls) (erased (Den L l) d) -> (StkR x))))

(def-fns _ $ (many stk-parse : (subterm many (Nat) fuel) (many (List (Rn)) L) (erased (List (Bool)) x) (erased (Den L x) d) -> (many (StkR x) r))
  (let ((many none)) (MkStk x x (Nil (Nat)) L (LsN x) d))
  (let-match many fuel (Succ f) ((Zero) none))
  (let-match many L (Cons _ r0 L1) ((Nil _) none))
  (let-match many r0 (MkRn b0 k0))
  (let-match many b0 (BFalse) ((BTrue) none))
  (let-match many (nat-eq k0 1) (Equal _ _ _) (else none))
  (let-match many L1 (Cons _ r1 L2) ((Nil _) none))
  (let-match many r1 (MkRn b1 t))
  (let-match many b1 (BTrue) ((BFalse) none))
  (let-match many (lt-dec 1 t) (Yes _ _ _ _ _) ((No _ _ _ _ _) none))
  (let-match many (lt-dec t 65) (Yes _ _ _ _ _) ((No _ _ _ _ _) none))
  (let-match erased d (DeC _ _ _ y _ d1 p))
  (let-match erased p (RpS _ _ _ _ p1))
  (let-match erased p1 (RpZ _ _))
  (let-match erased d1 (DeC _ _ _ y2 _ d2 p2))
  (let-match many (notail $ stk-parse f L2 y2 d2) (MkStk _ l K L3 ls d3))
  (MkStk x l (Cons _ t K) L3 (LsC l y2 y t K ls p2) d3))

(def-fns _ $ (many try-walk : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ x r dl dr))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) (RsNo l3 c0 e ch)))
  (let-match erased eq (Refl _ _))
  (let-match many h (BTrue) ((BFalse) (RsNo l3 c0 e ch)))
  (let-match many (strip (bits "00" (Nil (Bool))) R r dr) (StOk _ _ rr R2 d2 cr) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let-match erased cr (CatC _ _ _ _ _ cr1))
  (let-match erased cr1 (CatC _ _ _ _ _ cr2))
  (let-match erased cr2 (CatN _ _))
  (let-match many (stk-parse 64 L x dl) (MkStk _ l K L3 ls d3))
  (let-match many K (Cons _ _ _) ((Nil _) (RsNo l3 c0 e ch)))
  (let ((many W)) (Cons _ (Tp) (Nil (Tk))))
  (let-match many (wk-run K W) (WkOk _ _ Y wk) ((WkNo _ _) (RsNo l3 c0 e ch)))
  (let ((erased y) (erased xb) (erased g)) (wk-ok K W Y wk l rr _ (CfH l rr x _ K W ls (XbP (Nil (Tk)) rr rr (XbN rr))) (PoP (Nil (Tk)))))
  (let ((erased tr) (erased run)) (go-run 2 2 _ _ _ _ _ _ g))
  (let-match many (xtr Y (TtE)) (MkXTR _ _ UB ub pu dub))
  (let ((many R4) (erased y4) (erased d4) (erased c4)) (push-runs UB ub dub R2 rr d2))
  (let ((erased v) (erased tb) (erased xb4)) (xt-cat Y (TtE) ub rr y4 pu c4))
  (let-match erased tb (TbE _))
  (let-match erased (xb-fn Y rr y y4 xb xb4) (Refl _ _))
  (let ((many R5) (erased d5)) (push (BFalse) R4 y d4))
  (RsOk l3 c0 (MkRq 2 L3 (BTrue) R5) (rch-run l3 c0 c _ e _ tr ch dc run (MkDc 2 L3 R5 (BTrue) l (bits "0" y) d3 d5))))

(def-adts
  ((SwPre : ((List (Nat)) K) -> Type)
    enum
    (many SpOk : (erased (List (Nat)) K) (many (List (Tk)) W) (many (List (Nat)) K2) (erased (Sw K W (SEnd K2)) sw) -> (SwPre K))))

(def-fns _ $ (many sw-pre : (many (List (Nat)) K) (subterm many (List (Tk)) R) -> (many (SwPre K) r))
  (let ((many stop)) (SpOk K (Nil (Tk)) K (SwEnd K)))
  (let-match many R (Cons _ x R1) ((Nil _) stop))
  (match many x _
    ((T0) (let-match many (notail $ sw-pre (Cons _ (Succ (Succ (Zero))) K) R1) (SpOk _ W K2 sw))
      (SpOk K (Cons _ (T0) W) K2 (SwT0 K W (SEnd K2) sw)))
    ((T1) (let-match many (notail $ sw-pre (Cons _ (Succ (Succ (Succ (Zero)))) K) R1) (SpOk _ W K2 sw))
      (SpOk K (Cons _ (T1) W) K2 (SwT1 K W (SEnd K2) sw)))
    ((Tp)
      (let-match many R1 (Cons _ y R2) ((Nil _) stop))
      (match many y _
        ((T0) (let-match many (notail $ sw-pre (Cons _ (Succ (Succ (Succ (Zero)))) K) R2) (SpOk _ W K2 sw))
          (SpOk K (Cons _ (Tp) (Cons _ (T0) W)) K2 (SwP0 K W (SEnd K2) sw)))
        ((T1)
          (let-match many K (Cons _ t K1) ((Nil _) stop))
          (let-match many t (Succ t1) ((Zero) stop))
          (let-match many t1 (Succ t2) ((Zero) stop))
          (let-match many t2 (Zero) ((Succ _) stop))
          (let-match many K1 (Cons _ s0 K2) ((Nil _) stop))
          (let-match many (notail $ sw-pre (Cons _ (Succ (Succ (Zero))) (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s0) K2))) R2) (SpOk _ W K3 sw))
          (SpOk K (Cons _ (Tp) (Cons _ (T1) W)) K3 (SwP1M s0 K2 W (SEnd K3) sw)))
        ((Tp)
          (let-match many K (Cons _ t K1) ((Nil _) stop))
          (let-match many t (Succ t1) ((Zero) stop))
          (let-match many t1 (Succ t2) ((Zero) stop))
          (let-match many t2 (Zero) ((Succ _) stop))
          (let-match many K1 (Cons _ s0 K2) ((Nil _) stop))
          (let-match many (notail $ sw-pre (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s0) K2)) R2) (SpOk _ W K3 sw))
          (SpOk K (Cons _ (Tp) (Cons _ (Tp) W)) K3 (SwPPM s0 K2 W (SEnd K3) sw)))))))

(def-fns _ $ (many try-msweep : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ x r dl dr))
  (let-match many (eq-nat q 1) (ESome _ eq) ((ENone _) (RsNo l3 c0 e ch)))
  (let-match erased eq (Refl _ _))
  (let-match many (stk-parse 64 L x dl) (MkStk _ l K L3 ls d3))
  (let ((many Rh) (erased dh)) (push h R r dr))
  (let-match many Rh (Cons _ rn R1) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many rn (MkRn b0 a0))
  (let ((many px)) (match many b0 (((PX) p)) ((BFalse) (parse 64 a0 R1)) ((BTrue) (parse 64 0 Rh))))
  (let-match many px (MkPX X _ _) ((NoPX) (RsNo l3 c0 e ch)))
  (let-match many (sw-pre K X) (SpOk _ W K2 sw))
  (let-match many W (Cons _ _ _) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many (xtr W (TtE)) (MkXTR _ _ UB ub pu dub))
  (let-match many (strip-runs UB ub dub Rh _ dh) (StOk _ _ y R2 d2 cu) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat W (TtE) ub y _ pu cu))
  (let-match erased tb (TbE _))
  (let ((many h2) (many R4) (erased y2) (many pp) (erased d4)) (rpop R2 y d2))
  (let-match many pp (PullCons _ _) ((PullNil) (RsNo l3 c0 e ch)))
  (let ((erased e2) (erased so) (erased g)) (sw-ok K W _ sw l y _ (CfB l y x _ K W ls xb)))
  (let-match erased so (SoE _ _ _ _ cf2))
  (let-match erased cf2 (CfB _ _ x2 _ _ _ ls2 xb2))
  (let-match erased xb2 (XbN _))
  (let ((erased tr) (erased run)) (go-run 1 1 _ _ _ _ _ _ g))
  (let ((many L4) (erased x3) (erased ls3) (erased d5)) (ls-runs K2 L3 l d3))
  (let-match erased (ls-fn l K2 x2 x3 ls2 ls3) (Refl _ _))
  (RsOk l3 c0 (MkRq 1 L4 h2 R4) (rch-run l3 c0 c _ e _ tr ch dc run (MkDc 1 L4 R4 h2 x3 y2 d5 d4))))

(def-fns _ $ (many l3move3 : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) r))
  (let-match many e (MkRq q L h R))
  (let-match many (lmom q h L) (BTrue) ((BFalse)
    (let-match many (try-walk c0 e ch) (RsNo _ _ e1 ch1) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
    (let-match many (try-msweep c0 e1 ch1) (RsNo _ _ e2 ch2) ((RsOk _ _ e2 ch2) (RsOk l3 c0 e2 ch2)))
    (rmove l3 m2 mm c0 e2 ch2)))
  (let-match many (try-jump c0 e ch) (RsNo _ _ e1 ch1) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (let-match many (try-round c0 e1 ch1) (RsNo _ _ e2 ch2) ((RsOk _ _ e2 ch2) (RsOk l3 c0 e2 ch2)))
  (let-match many (try-sweep c0 e2 ch2) (RsNo _ _ e3 ch3) ((RsOk _ _ e3 ch3) (RsOk l3 c0 e3 ch3)))
  (rmove l3 m2 mm c0 e3 ch3))

(def-fns _ $ (many l3run3 : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    -> (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values e ch)))
  (let-match many (l3move3 m2 mm c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values e1 ch1)))
  (tail $ l3run3 m2 mm c0 f e1 ch1))

