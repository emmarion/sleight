(def-fns _ $ (many dgo : (many (Nat) tidx reps) (many (String) in) -> (many (String) out))
  (let ((many e) (many s)) (rd-cfg in))
  (let ((many r) (many tl)) (match many (dloop 1000000000 tidx reps 0 0 e s) (((Rope) r) ((Rope) tl))
    ((HOk k e2) (values (show-cfg e2) (sp (RStr "OK") k)))
    ((HBad k why e2) (values (RCat (show-cfg e2) (match many (dprop why e2) _ ((Some _ m) (match many m _ ((Some _ e3) (show-cfg e3)) ((None _) (RStr "none\n")))) ((None _) (RStr "-\n")))) (sp (sp (RStr "BAD") k) why)))))
  (let ((many o) (erased _)) (flatten (RCat r (RCat tl (RChar #\newline)))))
  o)

(def-fns _ $ (many dmain : (many (String) in) -> (many (String) out))
