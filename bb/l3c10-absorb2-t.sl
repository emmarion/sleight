(def-fns _ $ (many ab2-why : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) st why))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc0 z))
  (let-match many (c-lm e c dc0) (LmOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc) ((LmNo _) (values 0 100)))
  (let-match many T (Tt1) (else (values 0 101)))
  (let-match many (decode X T) (DecOk F0 s0) ((DecNo) (values 0 102)))
  (let-match many (id-at F0 s0 X T) (IdOk _ _ F s nb ok mx bn ph) ((IdNo _ _) (values 0 103)))
  (let ((many ex) (erased rex)) (rl-run X))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X T u y xr px cu))
  (let-match many (am-loop 100000 F s nb ok mx bn X ph ex rex R1 y v xr d1 tb xb n lz x0 p0 (Zero))
    (MkAmL _ _ _ _ _ F2 s2 nf ok2 mx2 bn2 Xf ph2 Rt rc2 v2 xr2 dr2 tb2 xb2 M st why x3 pm t run))
  (values st why))

(def-fns _ $ (many amain : (many (String) in) -> (many (String) out))
  (let ((many idx) (many s0)) (tok in))
  (let ((many e) (many s1)) (rd-cfg s0))
  (let ((many f) (many _)) (rd-cfg s1))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let ((many r)) (match many (nat-eq idx 23) (((Rs l3 c0) r)) ((Equal _ _ _) (mac-absorb2 c0 e ch)) (else (c10-mac (monus idx 200) c0 e ch))))
  (let ((many st) (many why)) (ab2-why c0 e ch))
  (let ((many o)) (match many r (((Rope) o))
    ((RsOk _ _ e2 _) (match many (rq-eq e2 f) _ ((ESome _ _) (RStr "MATCH")) ((ENone _) (RStr "DIFF"))))
    ((RsNo _ _ _ _) (RStr "NOFIRE"))))
  (let ((many s) (erased _)) (flatten (RCat (sp (sp o st) why) (RChar #\newline))))
  s)
