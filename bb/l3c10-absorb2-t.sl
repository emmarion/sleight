(def-fns _ $ (many amain : (many (String) in) -> (many (String) out))
  (let ((many idx) (many s0)) (tok in))
  (let ((many e) (many s1)) (rd-cfg s0))
  (let ((many f) (many _)) (rd-cfg s1))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let-match many (match many (nat-eq idx 23) (((AbR c0) r)) ((Equal _ _ _) (ab2-run c0 e ch)) (else (MkAbR c0 (c10-mac (monus idx 200) c0 e ch) 0 0)))
    (MkAbR _ r st why))
  (let ((many o)) (match many r (((Rope) o))
    ((RsOk _ _ e2 _) (match many (rq-eq e2 f) _ ((ESome _ _) (RStr "MATCH")) ((ENone _) (RStr "DIFF"))))
    ((RsNo _ _ _ _) (RStr "NOFIRE"))))
  (let ((many s) (erased _)) (flatten (RCat (sp (sp o st) why) (RChar #\newline))))
  s)
