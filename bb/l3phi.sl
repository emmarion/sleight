  (let-match many R (Cons _ d R1) ((Nil _) (let-match erased r (RvN _ _)) (values Xs e)))
  (let-match erased r (RvC _ _ _ _ _ r1))
  (let ((many X1) (erased t)) (dt-run d Xs))
  (tail $ enc-fold R1 (Cons (Nat) d S) X1 D r1 (EnC d S Xs X1 e t)))

(def-fns _ $ (many enc-tr : (many (List (Nat)) D) -> (many (List (Tk)) X) (erased (DEnc D X) e))
  (let ((many R) (erased q)) (rev-of (Nat) D (Nil (Nat)) D (RvN (Nat) D)))
  (enc-fold R (Nil (Nat)) (Nil (Tk)) D q (EnN)))

(def-fns _ $ (many dg-fold : (subterm many (List (Ps)) R) (many (List (Ps)) S) (many (List (Nat)) Ds) (erased (List (Nat)) E) (erased (List (Ps)) w)
    (erased (Rva (Ps) R S w) r) (erased (Dg S E Ds) g) -> (many (List (Nat)) D) (erased (Dg w E D) g2))
  (let-match many R (Cons _ x R1) ((Nil _) (let-match erased r (RvN _ _)) (values Ds g)))
  (let-match erased r (RvC _ _ _ _ _ r1))
  (let ((many h) (many l) (erased p)) (dig2-run x))
  (tail $ dg-fold R1 (Cons (Ps) x S) (Cons (Nat) h (Cons (Nat) l Ds)) E w r1 (DgC x h l S E Ds g p)))

(def-fns _ $ (many dg-tr : (many (List (Ps)) w) (many (List (Nat)) E) -> (many (List (Nat)) D) (erased (Dg w E D) g))
  (let ((many R) (erased q)) (rev-of (Ps) w (Nil (Ps)) w (RvN (Ps) w)))
  (dg-fold R (Nil (Ps)) E E w q (DgN E)))

(def-fns _ $ (many dgv-fold : (subterm many (List (Ps)) R) (many (List (Ps)) S) (many (List (Nat)) Ds) (many (Tt) T) (erased (List (Ps)) w)
    (erased (Rva (Ps) R S w) r) (erased (DgV S Ds T) g) -> (many (List (Nat)) D) (erased (DgV w D T) g2))
  (let-match many R (Cons _ x R1) ((Nil _) (let-match erased r (RvN _ _)) (values Ds g)))
  (let-match erased r (RvC _ _ _ _ _ r1))
  (let ((many h) (many l) (erased p)) (dig2-run x))
  (tail $ dgv-fold R1 (Cons (Ps) x S) (Cons (Nat) h (Cons (Nat) l Ds)) T w r1 (DvC x h l S Ds T g p)))

(def-fns _ $ (many dgv-tr : (many (Ps) x) (many (List (Ps)) w) -> (many (List (Nat)) D) (many (Tt) T) (erased (DgV (Cons (Ps) x w) D T) g))
  (let ((many R) (erased q)) (rev-of (Ps) (Cons (Ps) x w) (Nil (Ps)) _ (RvN (Ps) (Cons (Ps) x w))))
  (let-match many R (Cons _ z R1) (absurd (Nil _) (match erased q _)))
  (let-match erased q (RvC _ _ _ _ _ q1))
  (let ((many h) (many T) (erased b)) (bot-run z))
  (let ((many D) (erased g)) (dgv-fold R1 (Cons (Ps) z (Nil (Ps))) (Cons (Nat) h (Nil (Nat))) T _ q1 (DvN z h T b)))
  (values D T g))

(def-fns _ $ (many odd-head : (many (Nat) m s) (erased (Nat) n) (erased (Double (Succ m) n) d) (erased (Lt s (Succ n)) bn)
    -> (many (Ps) x) (many (Nat) h rs) (erased (Nat) i r) (erased (List (Nat)) ss) (erased (Sg6 m ss) g) (erased (Loc ss s i r) lc)
    (erased (StS i x r m rs) st) (erased (Dig2 x (Zero) h) pd) (erased (Lt rs (Succ m)) lt))
  (let ((many ss3)) (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Nil (Nat)))
  (let ((many ss) (erased g)) (sg6 m))
  (let-match erased g (MkSg6 _))
  (let ((many i) (many r) (erased lc3)) (loc-find ss3 s n n2 m (dbl-loc3 m n d) bn))
  (let ((erased lc)) (loc-pfx ss3 ss s i r lc3 (PfC _ _ _ $ PfC _ _ _ $ PfC _ _ _ $ PfN _)))
  (let ((many x) (many rs) (erased st)) (sts-of i r m s ss g lc))
  (let ((many h0) (many h) (erased p)) (dig2-run x))
  (let-match erased (odd-hi i r m rs s h0 h x lc3 st p) (Refl _ _))
  (values x h rs i r ss g lc st p (sts-lt i r m rs s x ss g lc st)))

(def-fns _ $ (erased dt1 : (erased (List (Tk)) R) -> (erased (Dt n1 R (Cons (Tk) (T1) R)) t))
  (DtS (Zero) R _ (TpZ (Cons (Tk) (T1) R))))

(def-fns _ $ (erased dt2 : (erased (List (Tk)) R) -> (erased (Dt n2 R (Cons (Tk) (Tp) (Cons (Tk) (T1) R))) t))
  (DtS n1 R _ (TpS (Zero) _ _ (TpZ (Cons (Tk) (T1) R)))))

(def-fns _ $ (many dge-step : (many (Ps) x) (many (List (Tk)) X) -> (many (List (Tk)) X2) (erased (Nat) h l) (erased (List (Tk)) Xm) (erased (Dig2 x h l) p)
    (erased (Dt l X Xm) tl) (erased (Dt h Xm X2) th))
  (let ((many t0)) (Cons _ (T0) X))
  (let ((many t1)) (Cons _ (T1) X))
  (let ((many t2)) (Cons _ (Tp) t1))
  (match many x _
    ((PrA) (values (Cons _ (T1) t0) n1 (Zero) t0 (D2A) (DtZ X) (dt1 t0)))
    ((PrB) (values (Cons _ (T1) t1) n1 n1 t1 (D2B) (dt1 X) (dt1 t1)))
    ((PrBp) (values (Cons _ (T1) t2) n1 n2 t2 (D2Bp) (dt2 X) (dt1 t2)))
    ((PrC) (values (Cons _ (T0) t0) (Zero) (Zero) t0 (D2C) (DtZ X) (DtZ t0)))
    ((PrD) (values (Cons _ (T0) t1) (Zero) n1 t1 (D2D) (dt1 X) (DtZ t1)))
    ((PrDp) (values (Cons _ (T0) t2) (Zero) n2 t2 (D2Dp) (dt2 X) (DtZ t2)))))

(def-fns _ $ (many dge : (subterm many (List (Ps)) w) (erased (List (Nat)) E) (many (List (Tk)) XE) (erased (DEnc E XE) eE)
    -> (many (List (Tk)) X) (erased (List (Nat)) D) (erased (Dg w E D) g) (erased (DEnc D X) e))
  (let-match many w (Cons _ x w1) ((Nil _) (values XE E (DgN E) eE)))
  (let ((many X1) (erased D1) (erased g1) (erased e1)) (notail $ dge w1 E XE eE))
  (let ((many X2) (erased h) (erased l) (erased Xm) (erased p) (erased tl) (erased th)) (dge-step x X1))
  (values X2 (Cons (Nat) h (Cons (Nat) l D1)) (DgC x h l w1 E D1 g1 p) (EnC h _ Xm X2 (EnC l D1 X1 Xm e1 tl) th)))

(def-fns _ $ (many dge-z : (many (List (Ps)) w) -> (many (List (Tk)) X) (erased (List (Nat)) D) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g) (erased (DEnc D X) e))
  (dge w (Cons (Nat) (Zero) (Nil (Nat))) (Cons _ (T0) (Nil (Tk))) (EnC (Zero) (Nil (Nat)) (Nil (Tk)) _ (EnN) (DtZ (Nil (Tk))))))

(def-fns _ $ (many phi-run : (many (Fam) F) (many (Nat) s) (erased (Nat) n) (erased (FamOK F) ok) (erased (MaxS F n) mx) (erased (Lt s (Succ n)) bn)
    -> (many (List (Tk)) X) (many (Tt) T) (erased (Phi F s X T) ph))
  (match many F _
    ((FE P T)
      (let-match erased mx (MxE _ _ _ q))
      (let ((many t) (erased tq)) (top-run P))
      (let-match erased (top-fn P n t q tq) (Refl _ _))
      (let ((many w) (erased b)) (blk-fast P s t tq bn))
      (let ((many Xd) (erased D) (erased g) (erased ed)) (dge-z w))
      (let ((many X) (erased t)) (dt-run n2 Xd))
      (values X T (PhE P s T w D X b g (EnC n2 D Xd X ed t))))
    ((FO P T)
      (let-match erased mx (MxO _ t _ _ q d))
      (let ((many m) (erased tq)) (top-run P))
      (let-match erased (top-fn P t m q tq) (Refl _ _))
      (let ((many x) (many h) (many rs) (erased i) (erased r) (erased ss) (erased g) (erased lc) (erased st) (erased pd) (erased lt)) (odd-head m s n d bn))
      (let ((many w) (erased b)) (blk-fast P rs m tq lt))
      (let ((many Xd) (erased D) (erased g2) (erased ed)) (dge-z w))
      (let ((many X1) (erased t1)) (dt-run h Xd))
      (let ((many X) (erased t)) (dt-run n2 X1))
      (values X T (PhO P s T x h w D X (BlS P m s i r rs x w ss tq g lc st b) pd g2 (EnC n2 _ X1 X (EnC h D Xd X1 ed t1) t))))
    ((FVE P)
      (let-match erased ok (OkVE _))
      (let-match erased mx (MxVE _ _ q))
      (let ((many t) (erased tq)) (top-run P))
      (let-match erased (top-fn P n t q tq) (Refl _ _))
      (let ((many w) (erased b)) (blk-fast P s t tq bn))
      (let-match many w (Cons _ y w1) (absurd (Nil _) b))
      (let ((many D) (many T) (erased g)) (dgv-tr y w1))
      (let ((many X) (erased e)) (enc-tr (Cons (Nat) n2 D)))
      (values X T (PhVE P s T w D X b g e)))
    ((FVO P)
      (let-match erased ok (OkVO _))
      (let-match erased mx (MxVO _ t _ q d))
      (let ((many m) (erased tq)) (top-run P))
      (let-match erased (top-fn P t m q tq) (Refl _ _))
      (let ((many x) (many h) (many rs) (erased i) (erased r) (erased ss) (erased g) (erased lc) (erased st) (erased pd) (erased lt)) (odd-head m s n d bn))
      (let ((many w) (erased b)) (blk-fast P rs m tq lt))
      (let-match many w (Cons _ y w1) (absurd (Nil _) b))
      (let ((many D) (many T) (erased g2)) (dgv-tr y w1))
      (let ((many X) (erased e)) (enc-tr (Cons (Nat) n2 (Cons (Nat) h D))))
      (values X T (PhVO P s T x h w D X (BlS P m s i r rs x w ss tq g lc st b) pd g2 e)))))

(def-fns _ $ (many maxs-run : (many (Fam) F) -> (many (Nat) n) (erased (MaxS F n) mx))
  (match many F _
    ((FE P T) (let ((many t) (erased tp)) (top-run P)) (values t (MxE P t T tp)))
    ((FO P T)
      (let ((many t) (erased tp)) (top-run P))
      (let ((many n) (erased d)) (double (Succ t)))
      (values n (MxO P t n T tp d)))
    ((FVE P) (let ((many t) (erased tp)) (top-run P)) (values t (MxVE P t tp)))
    ((FVO P)
      (let ((many t) (erased tp)) (top-run P))
      (let ((many n) (erased d)) (double (Succ t)))
      (values n (MxVO P t n tp d)))))
