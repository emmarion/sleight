(def-adts $ (Ps : -> Type)
  enum
  (many PrA : -> (Ps))
  (many PrB : -> (Ps))
  (many PrBp : -> (Ps))
  (many PrC : -> (Ps))
  (many PrD : -> (Ps))
  (many PrDp : -> (Ps)))

(def-adts
  ((Dig2 : ((Ps) x) ((Nat) h) ((Nat) l) -> Type)
    enum
    (many D2A : -> (Dig2 (PrA) (Succ (Zero)) (Zero)))
    (many D2B : -> (Dig2 (PrB) (Succ (Zero)) (Succ (Zero))))
    (many D2Bp : -> (Dig2 (PrBp) (Succ (Zero)) (Succ (Succ (Zero)))))
    (many D2C : -> (Dig2 (PrC) (Zero) (Zero)))
    (many D2D : -> (Dig2 (PrD) (Zero) (Succ (Zero))))
    (many D2Dp : -> (Dig2 (PrDp) (Zero) (Succ (Succ (Zero)))))))

(def-adts
  ((Bot : ((Ps) x) ((Nat) h) ((Tt) T) -> Type)
    enum
    (many BoA : -> (Bot (PrA) (Succ (Zero)) (Tt11)))
    (many BoB : -> (Bot (PrB) (Succ (Zero)) (Tt011)))
    (many BoBp : -> (Bot (PrBp) (Succ (Zero)) (Tt0011)))
    (many BoC : -> (Bot (PrC) (Zero) (Tt11)))
    (many BoD : -> (Bot (PrD) (Zero) (Tt011)))
    (many BoDp : -> (Bot (PrDp) (Zero) (Tt0011)))))

(def-adts
  ((Bt : ((Nat) d) -> Type)
    enum
    (many BtZ : -> (Bt (Zero)))
    (many BtO : -> (Bt (Succ (Zero))))))

(def-adts
  ((Dt : ((Nat) d) ((List (Tk)) R) ((List (Tk)) X) -> Type)
    enum
    (many DtZ : (erased (List (Tk)) R) -> (Dt (Zero) R (Cons (Tk) (T0) R)))
    (many DtS : (erased (Nat) k) (erased (List (Tk)) R X) (erased (TpR k (Cons (Tk) (T1) R) X) p) -> (Dt (Succ k) R X))))

(def-adts
  ((DEnc : ((List (Nat)) D) ((List (Tk)) X) -> Type)
    enum
    (many EnN : -> (DEnc (Nil (Nat)) (Nil (Tk))))
    (many EnC : (erased (Nat) d) (erased (List (Nat)) D) (erased (List (Tk)) X1 X) (erased (DEnc D X1) e) (erased (Dt d X1 X) t)
       -> (DEnc (Cons (Nat) d D) X))))

(def-adts
  ((Dg : ((List (Ps)) w) ((List (Nat)) E) ((List (Nat)) D) -> Type)
    enum
    (many DgN : (erased (List (Nat)) E) -> (Dg (Nil (Ps)) E E))
    (many DgC : (erased (Ps) x) (erased (Nat) h l) (erased (List (Ps)) w) (erased (List (Nat)) E D) (erased (Dg w E D) g)
       (erased (Dig2 x h l) p) -> (Dg (Cons (Ps) x w) E (Cons (Nat) h (Cons (Nat) l D))))))

(def-adts
  ((DgV : ((List (Ps)) w) ((List (Nat)) D) ((Tt) T) -> Type)
    enum
    (many DvN : (erased (Ps) x) (erased (Nat) h) (erased (Tt) T) (erased (Bot x h T) b)
       -> (DgV (Cons (Ps) x (Nil (Ps))) (Cons (Nat) h (Nil (Nat))) T))
    (many DvC : (erased (Ps) x) (erased (Nat) h l) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (Tt) T) (erased (DgV w D T) g)
       (erased (Dig2 x h l) p) -> (DgV (Cons (Ps) x w) (Cons (Nat) h (Cons (Nat) l D)) T))))

(def-adts
  ((Cy : ((Bool) c) ((Nat) n) ((Nat) n2) -> Type)
    enum
    (many CyF : (erased (Nat) n) -> (Cy (BFalse) n n))
    (many CyT : (erased (Nat) n) -> (Cy (BTrue) n (Succ n)))))

(def-adts
  ((Var : ((Ps) x) -> Type)
    enum
    (many VA : -> (Var (PrA)))
    (many VB : -> (Var (PrB)))
    (many VC : -> (Var (PrC)))
    (many VD : -> (Var (PrD)))))

(def-adts
  ((Pre : ((Ps) x) ((Ps) x2) ((Bool) co) -> Type)
    enum
    (many PreN : (erased (Ps) x) (erased (Var x) v) -> (Pre x x (BFalse)))
    (many PreDp : -> (Pre (PrDp) (PrA) (BTrue)))))

(def-adts
  ((Step : ((Ps) x) ((Bool) c) ((Ps) y) ((Bool) co) -> Type)
    enum
    (many StA0 : -> (Step (PrA) (BFalse) (PrA) (BFalse)))
    (many StA1 : -> (Step (PrA) (BTrue) (PrB) (BFalse)))
    (many StB0 : -> (Step (PrB) (BFalse) (PrB) (BFalse)))
    (many StB1 : -> (Step (PrB) (BTrue) (PrBp) (BFalse)))
    (many StC0 : -> (Step (PrC) (BFalse) (PrC) (BFalse)))
    (many StC1 : -> (Step (PrC) (BTrue) (PrD) (BFalse)))
    (many StD0 : -> (Step (PrD) (BFalse) (PrD) (BFalse)))
    (many StD1 : -> (Step (PrD) (BTrue) (PrDp) (BFalse)))
    (many StDp0 : -> (Step (PrDp) (BFalse) (PrA) (BTrue)))
    (many StDp1 : -> (Step (PrDp) (BTrue) (PrB) (BTrue)))))

(def-adts
  ((Rnd : ((List (Ps)) w) ((List (Ps)) w2) ((Bool) c) -> Type)
    enum
    (many RnN : -> (Rnd (Nil (Ps)) (Nil (Ps)) (BTrue)))
    (many RnBp : (erased (List (Ps)) w) -> (Rnd (Cons (Ps) (PrBp) w) (Cons (Ps) (PrC) w) (BFalse)))
    (many RnX : (erased (Ps) x y) (erased (List (Ps)) w w2) (erased (Bool) c co) (erased (Rnd w w2 c) r) (erased (Step x c y co) s)
       -> (Rnd (Cons (Ps) x w) (Cons (Ps) y w2) co))))

(def-adts
  ((Up : ((List (Tk)) X) ((List (Tk)) W) -> Type)
    enum
    (many UpZ : (erased (List (Tk)) R) -> (Up (Cons (Tk) (T0) R) (Cons (Tk) (T1) R)))
    (many Up1 : (erased (List (Tk)) R) -> (Up (Cons (Tk) (T1) R) (Cons (Tk) (Tp) (Cons (Tk) (T1) R))))
    (many UpP : (erased (List (Tk)) R) -> (Up (Cons (Tk) (Tp) R) (Cons (Tk) (Tp) (Cons (Tk) (Tp) R))))))

(def-adts
  ((Fin : ((SRes) s) ((Tt) T) ((List (Tk)) Y) ((Tt) T2) ((Nat) c) -> Type)
    enum
    (many FinT : (erased (List (Nat)) K) (erased (List (Tk)) W Y) (erased (Tt) T) (erased (Wk K W Y) w)
       -> (Fin (STurn K W) T Y T (Zero)))
    (many FinE : (erased (List (Nat)) K K2) (erased (List (Tk)) W Y) (erased (Tt) T T2) (erased (Nat) c)
       (erased (En K T K2 W T2 c) e) (erased (Wk K2 W Y) w) -> (Fin (SEnd K) T Y T2 c))))

(def-adts
  ((Rr : ((List (Nat)) K) ((List (Tk)) X) ((Tt) T) ((List (Tk)) Y) ((Tt) T2) -> Type)
    enum
    (many MkRr : (erased (List (Nat)) K) (erased (List (Tk)) X Y) (erased (Tt) T T2) (erased (SRes) s) (erased (Nat) c)
       (erased (Sw K X s) w) (erased (Fin s T Y T2 c) f) -> (Rr K X T Y T2))))

(def-fns _ $ (erased tpr-fn : (erased (Nat) m) (erased (List (Tk)) R X X2) (subterm erased (TpR m R X) p) (erased (TpR m R X2) q)
    -> (erased (Eq (List (Tk)) X X2) e))
  (let-match erased p (TpS m1 _ X1 p1) ((TpZ _) (let-match erased q (TpZ _)) (Refl _ X)))
  (let-match erased q (TpS _ _ X3 q1))
  (let-match erased (tpr-fn m1 R X1 X3 p1 q1) (Refl _ _))
  (Refl _ X))

(def-fns _ $ (erased dt-fn : (erased (Nat) d) (erased (List (Tk)) R X X2) (erased (Dt d R X) p) (erased (Dt d R X2) q)
    -> (erased (Eq (List (Tk)) X X2) e))
  (match erased p _
    ((DtZ _) (let-match erased q (DtZ _)) (Refl _ X))
    ((DtS k _ _ p1) (let-match erased q (DtS _ _ _ q1)) (tpr-fn k _ X X2 p1 q1))))

(def-fns _ $ (erased enc-fn : (erased (List (Nat)) D) (erased (List (Tk)) X X2) (subterm erased (DEnc D X) p) (erased (DEnc D X2) q)
    -> (erased (Eq (List (Tk)) X X2) e))
  (match erased p _
    ((EnN) (let-match erased q (EnN)) (Refl _ X))
    ((EnC d D1 X1 _ e1 t1)
      (let-match erased q (EnC _ _ X3 _ e2 t2))
      (let-match erased (enc-fn D1 X1 X3 e1 e2) (Refl _ _))
      (dt-fn d X1 X X2 t1 t2))))

(def-fns _ $ (erased dig2-fn : (erased (Ps) x) (erased (Nat) h l h2 l2) (erased (Dig2 x h l) p) (erased (Dig2 x h2 l2) q)
    -> (erased (Eq (Nat) h h2) e) (erased (Eq (Nat) l l2) f))
  (match erased p _
    ((D2A) (let-match erased q (D2A)) (values (Refl _ h) (Refl _ l)))
    ((D2B) (let-match erased q (D2B)) (values (Refl _ h) (Refl _ l)))
    ((D2Bp) (let-match erased q (D2Bp)) (values (Refl _ h) (Refl _ l)))
    ((D2C) (let-match erased q (D2C)) (values (Refl _ h) (Refl _ l)))
    ((D2D) (let-match erased q (D2D)) (values (Refl _ h) (Refl _ l)))
    ((D2Dp) (let-match erased q (D2Dp)) (values (Refl _ h) (Refl _ l)))))

(def-fns _ $ (erased bot-fn : (erased (Ps) x) (erased (Nat) h h2) (erased (Tt) T T2) (erased (Bot x h T) p) (erased (Bot x h2 T2) q)
    -> (erased (Eq (Nat) h h2) e) (erased (Eq (Tt) T T2) f))
  (match erased p _
    ((BoA) (let-match erased q (BoA)) (values (Refl _ h) (Refl _ T)))
    ((BoB) (let-match erased q (BoB)) (values (Refl _ h) (Refl _ T)))
    ((BoBp) (let-match erased q (BoBp)) (values (Refl _ h) (Refl _ T)))
    ((BoC) (let-match erased q (BoC)) (values (Refl _ h) (Refl _ T)))
    ((BoD) (let-match erased q (BoD)) (values (Refl _ h) (Refl _ T)))
    ((BoDp) (let-match erased q (BoDp)) (values (Refl _ h) (Refl _ T)))))

(def-fns _ $ (erased dg-fn : (erased (List (Ps)) w) (erased (List (Nat)) E D D2) (subterm erased (Dg w E D) p) (erased (Dg w E D2) q)
    -> (erased (Eq (List (Nat)) D D2) e))
  (match erased p _
    ((DgN _) (let-match erased q (DgN _)) (Refl _ D))
    ((DgC x h l w1 _ D1 g1 p1)
      (let-match erased q (DgC _ h2 l2 _ _ D3 g2 p2))
      (let-match erased (dg-fn w1 E D1 D3 g1 g2) (Refl _ _))
      (let ((erased e1) (erased e2)) (dig2-fn x h l h2 l2 p1 p2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (Refl _ D))))

(def-fns _ $ (erased dgv-fn : (erased (List (Ps)) w) (erased (List (Nat)) D D2) (erased (Tt) T T2) (subterm erased (DgV w D T) p) (erased (DgV w D2 T2) q)
    -> (erased (Eq (List (Nat)) D D2) e) (erased (Eq (Tt) T T2) f))
  (match erased p _
    ((DvN x h _ b1)
      (let-match erased q (DvN _ h2 _ b2) (absurd (DvC _ _ _ _ _ _ g _) g))
      (let ((erased e1) (erased e2)) (bot-fn x h h2 T T2 b1 b2))
      (let-match erased e1 (Refl _ _))
      (values (Refl _ D) e2))
    ((DvC x h l w1 D1 _ g1 p1)
      (let-match erased q (DvC _ h2 l2 _ D3 _ g2 p2) (absurd (DvN _ _ _ _) g1))
      (let ((erased e1) (erased e2)) (dgv-fn w1 D1 D3 T T2 g1 g2))
      (let-match erased e1 (Refl _ _))
      (let ((erased f1) (erased f2)) (dig2-fn x h l h2 l2 p1 p2))
      (let-match erased f1 (Refl _ _))
      (let-match erased f2 (Refl _ _))
      (values (Refl _ D) e2))))

(let ((many n1)) (Succ (Zero)))
(let ((many n2)) (Succ n1))
(let ((many n3)) (Succ n2))
(let ((many n4)) (Succ n3))
(let ((many n5)) (Succ n4))

(def-fns _ $ (erased step-dec : (erased (Ps) x y) (erased (Bool) c co) (erased (Step x c y co) st) ->
    (erased (Ps) x2) (erased (Nat) h l l2) (erased (Pre x x2 co) pr) (erased (Dig2 x2 h l) p) (erased (Cy c l l2) cy) (erased (Dig2 y h l2) q))
  (match erased st _
    ((StA0) (values (PrA) n1 (Zero) (Zero) (PreN _ (VA)) (D2A) (CyF _) (D2A)))
    ((StA1) (values (PrA) n1 (Zero) n1 (PreN _ (VA)) (D2A) (CyT _) (D2B)))
    ((StB0) (values (PrB) n1 n1 n1 (PreN _ (VB)) (D2B) (CyF _) (D2B)))
    ((StB1) (values (PrB) n1 n1 n2 (PreN _ (VB)) (D2B) (CyT _) (D2Bp)))
    ((StC0) (values (PrC) (Zero) (Zero) (Zero) (PreN _ (VC)) (D2C) (CyF _) (D2C)))
    ((StC1) (values (PrC) (Zero) (Zero) n1 (PreN _ (VC)) (D2C) (CyT _) (D2D)))
    ((StD0) (values (PrD) (Zero) n1 n1 (PreN _ (VD)) (D2D) (CyF _) (D2D)))
    ((StD1) (values (PrD) (Zero) n1 n2 (PreN _ (VD)) (D2D) (CyT _) (D2Dp)))
    ((StDp0) (values (PrA) n1 (Zero) (Zero) (PreDp) (D2A) (CyF _) (D2A)))
    ((StDp1) (values (PrA) n1 (Zero) n1 (PreDp) (D2A) (CyT _) (D2B)))))

(def-fns _ $ (erased up-tl0 : (erased (List (Tk)) X W) (erased (Up X W) u) -> (erased (Tl0 W X) t))
  (match erased u _
    ((UpZ R) (Tl01 R))
    ((Up1 R) (Tl0P X))
    ((UpP R) (Tl0P X))))

(def-fns _ $ (erased up-tpr : (erased (Nat) d) (erased (List (Tk)) A Bb WB) (erased (Dt d A Bb) t) (erased (Up Bb WB) u)
    -> (erased (TpR d (Cons (Tk) (T1) A) WB) p))
  (match erased t _
    ((DtZ _) (let-match erased u (UpZ _)) (TpZ _))
    ((DtS k _ _ q)
      (match erased u _
        (absurd (UpZ _) q)
        ((Up1 _) (TpS k _ Bb q))
        ((UpP _) (TpS k _ Bb q))))))

(def-fns _ $ (erased up-ex : (erased (Nat) d) (erased (List (Tk)) A Bb) (erased (Dt d A Bb) t) -> (erased (List (Tk)) WB) (erased (Up Bb WB) u))
  (let-match erased t (DtS k _ _ q) ((DtZ _) (values (Cons (Tk) (T1) A) (UpZ A))))
  (match erased q _
    ((TpZ _) (values (Cons (Tk) (Tp) Bb) (Up1 A)))
    ((TpS _ _ R2 _) (values (Cons (Tk) (Tp) Bb) (UpP R2)))))

(def-fns _ $ (erased up-enc : (erased (Nat) d) (erased (List (Nat)) D) (erased (List (Tk)) Z) (erased (DEnc (Cons (Nat) d D) Z) e)
    -> (erased (List (Tk)) W) (erased (Up Z W) u))
  (let-match erased e (EnC _ _ X1 _ _ t))
  (up-ex d X1 Z t))

(def-fns _ $ (erased wk-up : (erased (Nat) d) (erased (List (Tk)) A Bb WA WB Y) (erased (List (Nat)) K) (erased (Dt d A Bb) t)
    (erased (Up A WA) ua) (erased (Up Bb WB) ub) (erased (Wk K WB Y) wk) -> (erased (Wk (Cons (Nat) (Succ (Succ d)) K) WA Y) r))
  (WkC d K WA A WB Y (up-tl0 A WA ua) (up-tpr d A Bb WB t ub) wk))

(def-fns _ $ (erased wk-top : (erased (Nat) d) (erased (List (Tk)) Z W Y) (erased (Up Z W) u) (erased (TpR d (Cons (Tk) (T1) Z) Y) p)
    -> (erased (Wk (Cons (Nat) (Succ (Succ d)) (Nil (Nat))) W Y) r))
  (WkC d (Nil (Nat)) W Z Y Y (up-tl0 Z W u) p (WkN Y)))

(def-fns _ $ (erased sw-dig : (erased (Nat) d) (erased (List (Tk)) R X) (erased (List (Nat)) K) (erased (SRes) s) (erased (Bt d) b)
    (erased (Dt d R X) t) (erased (Sw (Cons (Nat) (Succ (Succ d)) K) R s) sw) -> (erased (Sw K X s) r))
  (match erased b _
    ((BtZ) (let-match erased t (DtZ _)) (SwT0 K R s sw))
    ((BtO) (let-match erased t (DtS _ _ _ p)) (let-match erased p (TpZ _)) (SwT1 K R s sw))))

(def-fns _ $ (erased var-bits : (erased (Ps) x) (erased (Nat) h l) (erased (Var x) v) (erased (Dig2 x h l) p) -> (erased (Bt h) a) (erased (Bt l) b))
  (match erased v _
    ((VA) (let-match erased p (D2A)) (values (BtO) (BtZ)))
    ((VB) (let-match erased p (D2B)) (values (BtO) (BtO)))
    ((VC) (let-match erased p (D2C)) (values (BtZ) (BtZ)))
    ((VD) (let-match erased p (D2D)) (values (BtZ) (BtO)))))

(def-fns _ $ (erased sw-pair : (erased (Ps) x x2) (erased (Bool) co) (erased (Nat) hx lx h l) (erased (List (Tk)) X1 Xa X)
    (erased (Nat) t t2) (erased (List (Nat)) K) (erased (SRes) s) (erased (Pre x x2 co) pr) (erased (Dig2 x hx lx) px) (erased (Dig2 x2 h l) p2)
    (erased (Dt lx X1 Xa) tl) (erased (Dt hx Xa X) th) (erased (Cy co t t2) cy)
    (erased (Sw (Cons (Nat) (Succ (Succ l)) (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t2 K))) X1 s) sw) -> (erased (Sw (Cons (Nat) t K) X s) r))
  (match erased pr _
    ((PreN _ v)
      (let-match erased cy (CyF _))
      (let ((erased e1) (erased e2)) (dig2-fn x hx lx h l px p2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let ((erased bh) (erased bl)) (var-bits x h l v p2))
      (sw-dig h Xa X (Cons (Nat) t K) s bh th (sw-dig l X1 Xa (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t K)) s bl tl sw)))
    ((PreDp)
      (let-match erased cy (CyT _))
      (let-match erased px (D2Dp))
      (let-match erased p2 (D2A))
      (let-match erased tl (DtS _ _ _ q))
      (let-match erased q (TpS _ _ _ q1))
      (let-match erased q1 (TpZ _))
      (let-match erased th (DtZ _))
      (SwT0 (Cons (Nat) t K) _ s (SwP1M t K X1 s sw)))))

(def-fns _ $ (erased cy-ss : (erased (Bool) c) (erased (Nat) l l2) (erased (Cy c l l2) p) -> (erased (Cy c (Succ (Succ l)) (Succ (Succ l2))) q))
  (match erased p _
    ((CyF _) (CyF _))
    ((CyT _) (CyT _))))

(def-fns _ $ (erased enc-pair : (erased (Nat) h l) (erased (List (Nat)) D) (erased (List (Tk)) X) (erased (DEnc (Cons (Nat) h (Cons (Nat) l D)) X) e)
    -> (erased (List (Tk)) X1 Xa) (erased (DEnc D X1) e1) (erased (Dt l X1 Xa) tl) (erased (Dt h Xa X) th))
  (let-match erased e (EnC _ _ Xa _ ea th))
  (let-match erased ea (EnC _ _ X1 _ e1 tl))
  (values X1 Xa e1 tl th))

(def-fns _ $ (erased rr-turn : (erased (Nat) t) (erased (List (Nat)) K D) (erased (List (Tk)) X Z W Y) (erased (Tt) T)
    (erased (DEnc (Cons (Nat) n1 (Cons (Nat) n2 D)) X) e) (erased (DEnc (Cons (Nat) (Zero) (Cons (Nat) (Zero) D)) Z) f) (erased (Up Z W) u)
    (erased (Wk (Cons (Nat) t K) W Y) wk) -> (erased (Rr (Cons (Nat) t K) X T Y T) r))
  (let ((erased X1) (erased Xa) (erased e1) (erased tl) (erased th)) (enc-pair _ _ D X e))
  (let ((erased Z1) (erased Za) (erased f1) (erased sl) (erased sh)) (enc-pair _ _ D Z f))
  (let-match erased (enc-fn D X1 Z1 e1 f1) (Refl _ _))
  (let-match erased tl (DtS _ _ _ q))
  (let-match erased q (TpS _ _ _ q1))
  (let-match erased q1 (TpZ _))
  (let-match erased th (DtS _ _ _ q2))
  (let-match erased q2 (TpZ _))
  (let-match erased sl (DtZ _))
  (let-match erased sh (DtZ _))
  (let-match erased u (UpZ _))
  (MkRr _ _ _ _ _ _ _
    (SwT1 _ _ _ (SwP1T (Zero) (Cons (Nat) t K) X1 _ (TpZ _)))
    (FinT _ _ _ _ wk)))

(def-fns _ $ (erased rd-of : (erased (List (Tk)) W Y) (erased (Tt) T T2) (erased (Rr (Cons (Nat) n3 (Nil (Nat))) W T Y T2) r)
    -> (erased (Nat) c) (erased (Rd (Cons (Tk) (Tp) (Cons (Tk) (T1) W)) T Y T2 c) d))
  (let-match erased r (MkRr _ _ _ _ _ s c sw fin))
  (match erased fin _
    ((FinT K W2 _ _ wk) (values (Zero) (RdT W W2 Y K T sw wk)))
    ((FinE K K2 W2 _ _ _ _ en wk) (values c (RdE W W2 Y K K2 T T2 c sw en wk)))))

(def-fns _ $ (erased up-dg : (erased (List (Ps)) w) (erased (Nat) z) (erased (List (Nat)) E D) (erased (List (Tk)) Z)
    (erased (Dg w (Cons (Nat) z E) D) g) (erased (DEnc D Z) e) -> (erased (List (Tk)) W) (erased (Up Z W) u))
  (match erased g _
    ((DgN _) (up-enc _ _ _ e))
    ((DgC _ _ _ _ _ _ _ _) (up-enc _ _ _ e))))

(def-fns _ $ (erased up-dgv : (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (Tt) T) (erased (List (Tk)) Z)
    (erased (DgV w D T) g) (erased (DEnc D Z) e) -> (erased (List (Tk)) W) (erased (Up Z W) u))
  (match erased g _
    ((DvN _ _ _ _) (up-enc _ _ _ e))
    ((DvC _ _ _ _ _ _ _ _) (up-enc _ _ _ e))))

(def-fns _ $ (erased pair-in : (erased (Ps) x y) (erased (Bool) c1 co) (erased (Nat) hy ly t2) (erased (List (Nat)) K)
    (erased (List (Tk)) Z1 Za Z W W1 Y) (erased (Step x c1 y co) st) (erased (Dig2 y hy ly) py) (erased (Dt ly Z1 Za) sl) (erased (Dt hy Za Z) sh)
    (erased (Up Z W) u) (erased (Up Z1 W1) u1) (erased (Wk (Cons (Nat) t2 K) W Y) wk) ->
    (erased (Ps) x2) (erased (Nat) h l l2) (erased (Pre x x2 co) pr) (erased (Dig2 x2 h l) p2) (erased (Cy c1 (Succ (Succ l)) (Succ (Succ l2))) cy1)
    (erased (Wk (Cons (Nat) (Succ (Succ l2)) (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t2 K))) W1 Y) wk2))
  (let ((erased x2) (erased h) (erased l) (erased l2) (erased pr) (erased p2) (erased cy1) (erased q2)) (step-dec x y c1 co st))
  (let ((erased f) (erased f2)) (dig2-fn y h l2 hy ly q2 py))
  (let-match erased f (Refl _ _))
  (let-match erased f2 (Refl _ _))
  (let ((erased Wa) (erased ua)) (up-ex l2 Z1 Za sl))
  (let ((erased wk1)) (wk-up h Za Z Wa W Y (Cons (Nat) t2 K) sh ua u wk))
  (values x2 h l l2 pr p2 (cy-ss c1 l l2 cy1) (wk-up l2 Z1 Za W1 Wa Y (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t2 K)) sl u1 ua wk1)))

(def-fns _ $ (erased pair-out : (erased (Ps) x x2) (erased (Bool) co) (erased (Nat) hx lx h l t t2) (erased (List (Tk)) X1 Xa X Y)
    (erased (List (Nat)) K) (erased (Tt) T T2) (erased (Pre x x2 co) pr) (erased (Dig2 x hx lx) px) (erased (Dig2 x2 h l) p2)
    (erased (Dt lx X1 Xa) tl) (erased (Dt hx Xa X) th) (erased (Cy co t t2) cy)
    (erased (Rr (Cons (Nat) (Succ (Succ l)) (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t2 K))) X1 T Y T2) ih) -> (erased (Rr (Cons (Nat) t K) X T Y T2) r))
  (let-match erased ih (MkRr _ _ _ _ _ s c sw fin))
  (MkRr _ _ _ _ _ s c (sw-pair x x2 co hx lx h l X1 Xa X t t2 K s pr px p2 tl th cy sw) fin))

(def-fns _ $ (erased gp : (erased (List (Ps)) w w2) (erased (Bool) c) (subterm erased (Rnd w w2 c) rn)
    (erased (Nat) t t2) (erased (List (Nat)) K D D2) (erased (List (Tk)) X Z W Y) (erased (Tt) T) (erased (Plain T) pl)
    (erased (Cy c t t2) cy) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g) (erased (DEnc D X) e)
    (erased (Dg w2 (Cons (Nat) (Zero) (Nil (Nat))) D2) g2) (erased (DEnc D2 Z) e2) (erased (Up Z W) u) (erased (Wk (Cons (Nat) t2 K) W Y) wk)
    -> (erased (Rr (Cons (Nat) t K) X T Y T) r))
  (match erased rn _
    ((RnN)
      (let-match erased cy (CyT _))
      (let-match erased g (DgN _))
      (let-match erased g2 (DgN _))
      (let-match erased e (EnC _ _ _ _ e0 t0))
      (let-match erased e0 (EnN))
      (let-match erased t0 (DtZ _))
      (let-match erased e2 (EnC _ _ _ _ f0 s0))
      (let-match erased f0 (EnN))
      (let-match erased s0 (DtZ _))
      (let-match erased u (UpZ _))
      (MkRr _ _ _ _ _ _ _ (SwT0 (Cons (Nat) t K) _ _ (SwEnd _)) (FinE _ _ _ _ _ _ _ (EnMP T pl t K) wk)))
    ((RnBp w1)
      (let-match erased cy (CyF _))
      (let-match erased g (DgC _ _ _ _ _ D1 g1 p1))
      (let-match erased p1 (D2Bp))
      (let-match erased g2 (DgC _ _ _ _ _ D3 g3 p3))
      (let-match erased p3 (D2C))
      (let-match erased (dg-fn w1 _ D1 D3 g1 g3) (Refl _ _))
      (rr-turn t K D1 X Z W Y T e e2 u wk))
    ((RnX x y w1 w3 c1 co rn1 st)
      (let-match erased g (DgC _ hx lx _ _ D1 g1 px))
      (let-match erased g2 (DgC _ hy ly _ _ D3 g3 py))
      (let ((erased X1) (erased Xa) (erased e1) (erased tl) (erased th)) (enc-pair hx lx D1 X e))
      (let ((erased Z1) (erased Za) (erased f1) (erased sl) (erased sh)) (enc-pair hy ly D3 Z e2))
      (let ((erased W1) (erased u1)) (up-dg w3 _ _ D3 Z1 g3 f1))
      (let ((erased x2) (erased h) (erased l) (erased l2) (erased pr) (erased p2) (erased cy1) (erased wk2))
        (pair-in x y c1 co hy ly t2 K Z1 Za Z W W1 Y st py sl sh u u1 wk))
      (pair-out x x2 co hx lx h l t t2 X1 Xa X Y K T T pr px p2 tl th cy
        (gp w1 w3 c1 rn1 (Succ (Succ l)) (Succ (Succ l2)) (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t2 K)) D1 D3 X1 Z1 W1 Y T pl cy1 g1 e1 g3 f1 u1 wk2)))))

(def-fns _ $ (erased v2-base : (erased (Ps) x y) (erased (Bool) co) (erased (Nat) hx hy t t2) (erased (List (Nat)) K)
    (erased (List (Tk)) X Z W Y) (erased (Tt) T T2) (erased (Step x (BTrue) y co) st) (erased (Bot x hx T) bx) (erased (Bot y hy T2) by)
    (erased (Dt hx (Nil (Tk)) X) tx) (erased (Dt hy (Nil (Tk)) Z) ty) (erased (Up Z W) u) (erased (Cy co t t2) cy)
    (erased (Wk (Cons (Nat) t2 K) W Y) wk) -> (erased (Rr (Cons (Nat) t K) X T Y T2) r))
  (let ((erased wk2)) (WkC hy (Cons (Nat) t2 K) (Cons (Tk) (Tp) (Nil (Tk))) (Nil (Tk)) W Y (Tl0P (Nil (Tk))) (up-tpr hy (Nil (Tk)) Z W ty u) wk))
  (match erased st _
    ((StA1) (let-match erased bx (BoA)) (let-match erased by (BoB)) (let-match erased cy (CyF _))
      (MkRr _ _ _ _ _ _ _ (sw-dig _ _ _ _ _ (BtO) tx (SwEnd _)) (FinE _ _ _ _ _ _ _ (En11 _) wk2)))
    ((StB1) (let-match erased bx (BoB)) (let-match erased by (BoBp)) (let-match erased cy (CyF _))
      (MkRr _ _ _ _ _ _ _ (sw-dig _ _ _ _ _ (BtO) tx (SwEnd _)) (FinE _ _ _ _ _ _ _ (En011 _) wk2)))
    ((StC1) (let-match erased bx (BoC)) (let-match erased by (BoD)) (let-match erased cy (CyF _))
      (MkRr _ _ _ _ _ _ _ (sw-dig _ _ _ _ _ (BtZ) tx (SwEnd _)) (FinE _ _ _ _ _ _ _ (En11 _) wk2)))
    ((StD1) (let-match erased bx (BoD)) (let-match erased by (BoDp)) (let-match erased cy (CyF _))
      (MkRr _ _ _ _ _ _ _ (sw-dig _ _ _ _ _ (BtZ) tx (SwEnd _)) (FinE _ _ _ _ _ _ _ (En011 _) wk2)))
    ((StDp1) (let-match erased bx (BoDp)) (let-match erased by (BoB)) (let-match erased cy (CyT _))
      (MkRr _ _ _ _ _ _ _ (sw-dig _ _ _ _ _ (BtZ) tx (SwEnd _)) (FinE _ _ _ _ _ _ _ (EnM4 t K) wk2)))))

(def-fns _ $ (erased gv : (erased (List (Ps)) w w2) (erased (Bool) c) (subterm erased (Rnd w w2 c) rn)
    (erased (Nat) t t2) (erased (List (Nat)) K D D2) (erased (List (Tk)) X Z W Y) (erased (Tt) T T2)
    (erased (Cy c t t2) cy) (erased (DgV w D T) g) (erased (DEnc D X) e)
    (erased (DgV w2 D2 T2) g2) (erased (DEnc D2 Z) e2) (erased (Up Z W) u) (erased (Wk (Cons (Nat) t2 K) W Y) wk)
    -> (erased (Rr (Cons (Nat) t K) X T Y T2) r))
  (match erased rn _
    (absurd (RnN) g)
    ((RnBp w1)
      (let-match erased cy (CyF _))
      (match erased g _
        ((DvN _ _ _ b)
          (let-match erased b (BoBp))
          (let-match erased g2 (DvN _ _ _ b2) (absurd (DvC _ _ _ _ _ _ gg _) gg))
          (let-match erased b2 (BoC))
          (let-match erased e (EnC _ _ _ _ e0 t0))
          (let-match erased e0 (EnN))
          (let-match erased t0 (DtS _ _ _ q))
          (let-match erased q (TpZ _))
          (let-match erased e2 (EnC _ _ _ _ f0 s0))
          (let-match erased f0 (EnN))
          (let-match erased s0 (DtZ _))
          (let-match erased u (UpZ _))
          (MkRr _ _ _ _ _ _ _ (SwT1 _ _ _ (SwEnd _)) (FinE _ _ _ _ _ _ _ (EnT4 (Zero) (Cons (Nat) t K) _ (TpZ _)) wk)))
        ((DvC _ _ _ _ D1 _ g1 p1)
          (let-match erased p1 (D2Bp))
          (let-match erased g2 (DvC _ _ _ _ D3 _ g3 p3) (absurd (DvN _ _ _ _) g1))
          (let-match erased p3 (D2C))
          (let ((erased f1) (erased f2)) (dgv-fn w1 D1 D3 T T2 g1 g3))
          (let-match erased f1 (Refl _ _))
          (let-match erased f2 (Refl _ _))
          (rr-turn t K D1 X Z W Y T e e2 u wk))))
    ((RnX x y w1 w3 c1 co rn1 st)
      (match erased g _
        ((DvN _ hx _ bx)
          (let-match erased rn1 (RnN))
          (let-match erased g2 (DvN _ hy _ by) (absurd (DvC _ _ _ _ _ _ gg _) gg))
          (let-match erased e (EnC _ _ _ _ e0 tx))
          (let-match erased e0 (EnN))
          (let-match erased e2 (EnC _ _ _ _ f0 ty))
          (let-match erased f0 (EnN))
          (v2-base x y co hx hy t t2 K X Z W Y T T2 st bx by tx ty u cy wk))
        ((DvC _ hx lx _ D1 _ g1 px)
          (let-match erased g2 (DvC _ hy ly _ D3 _ g3 py) (absurd (DvN _ _ _ _) (let-match erased rn1 (RnN)) g1))
          (let ((erased X1) (erased Xa) (erased e1) (erased tl) (erased th)) (enc-pair hx lx D1 X e))
          (let ((erased Z1) (erased Za) (erased f1) (erased sl) (erased sh)) (enc-pair hy ly D3 Z e2))
          (let ((erased W1) (erased u1)) (up-dgv w3 D3 T2 Z1 g3 f1))
          (let ((erased x2) (erased h) (erased l) (erased l2) (erased pr) (erased p2) (erased cy1) (erased wk2))
            (pair-in x y c1 co hy ly t2 K Z1 Za Z W W1 Y st py sl sh u u1 wk))
          (pair-out x x2 co hx lx h l t t2 X1 Xa X Y K T T2 pr px p2 tl th cy
            (gv w1 w3 c1 rn1 (Succ (Succ l)) (Succ (Succ l2)) (Cons (Nat) (Succ (Succ h)) (Cons (Nat) t2 K)) D1 D3 X1 Z1 W1 Y T T2 cy1 g1 e1 g3 f1 u1 wk2)))))))

(def-adts
  ((Loc : ((List (Nat)) ss) ((Nat) rho) ((Nat) i) ((Nat) r) -> Type)
    enum
    (many LcH : (erased (Nat) s r) (erased (List (Nat)) ss) (erased (Lt r s) p) -> (Loc (Cons (Nat) s ss) r (Zero) r))
    (many LcT : (erased (Nat) s rho1 rho i r) (erased (List (Nat)) ss) (erased (Add s rho1 rho) a) (erased (Loc ss rho1 i r) q)
       -> (Loc (Cons (Nat) s ss) rho (Succ i) r))))

(def-adts
  ((Sg6 : ((Nat) m) ((List (Nat)) ss) -> Type)
    enum
    (many MkSg6 : (erased (Nat) m)
       -> (Sg6 m (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) m $ Nil (Nat))))))

(def-adts
  ((StS : ((Nat) i) ((Ps) x) ((Nat) r) ((Nat) m) ((Nat) rs) -> Type)
    enum
    (many Ss0 : (erased (Nat) m) -> (StS (Zero) (PrDp) (Zero) m m))
    (many Ss1 : (erased (Nat) r m) -> (StS n1 (PrD) r m r))
    (many Ss2 : (erased (Nat) r m) -> (StS n2 (PrC) r m r))
    (many Ss3 : (erased (Nat) m) -> (StS n3 (PrBp) (Zero) m m))
    (many Ss4 : (erased (Nat) r m) -> (StS n4 (PrB) r m r))
    (many Ss5 : (erased (Nat) r m) -> (StS n5 (PrA) r m r))))

(def-adts
  ((Vs : ((Nat) j) ((Ps) x) ((Ps) y) ((Nat) z) ((Nat) m) -> Type)
    enum
    (many Vs1 : (erased (Nat) m) -> (Vs (Zero) (PrD) (PrDp) (Zero) m))
    (many Vs2 : (erased (Nat) m) -> (Vs n1 (PrC) (PrD) m m))
    (many Vs4 : (erased (Nat) m) -> (Vs n3 (PrB) (PrBp) (Zero) m))
    (many Vs5 : (erased (Nat) m) -> (Vs n4 (PrA) (PrB) m m))))

(def-adts
  ((TopAt : ((Nat) m) ((Nat) t) -> Type)
    enum
    (many TA5 : (erased (Nat) m1 t) (erased (List (Nat)) ss) (erased (Sg6 (Succ m1) ss) g) (erased (Loc ss t n5 m1) q) -> (TopAt (Succ m1) t))
    (many TA4 : (erased (Nat) t) (erased (List (Nat)) ss) (erased (Sg6 (Zero) ss) g) (erased (Loc ss t n4 (Zero)) q) -> (TopAt (Zero) t))))

(def-adts
  ((Top : ((Nat) p) ((Nat) t) -> Type)
    enum
    (many TopZ : -> (Top (Zero) (Zero)))
    (many TopS : (erased (Nat) p m t) (erased (Top p m) q) (erased (TopAt m t) a) -> (Top (Succ p) t))))

(def-adts
  ((LpR : ((Nat) p) ((Nat) l) -> Type)
    enum
    (many MkLpR : (erased (Nat) p t) (erased (Top p t) q) -> (LpR p (Succ t)))))

(def-adts
  ((PBlk : ((Nat) p) ((Nat) rho) ((List (Ps)) w) -> Type)
    enum
    (many BlZ : -> (PBlk (Zero) (Zero) (Nil (Ps))))
    (many BlS : (erased (Nat) p m rho i r rs) (erased (Ps) x) (erased (List (Ps)) w) (erased (List (Nat)) ss) (erased (Top p m) q)
       (erased (Sg6 m ss) g) (erased (Loc ss rho i r) lc) (erased (StS i x r m rs) st) (erased (PBlk p rs w) b)
       -> (PBlk (Succ p) rho (Cons (Ps) x w)))))

(def-adts
  ((Prv : ((Nat) p) ((Nat) rho) ((Nat) rho2) ((Bool) c) -> Type)
    enum
    (many DcS : (erased (Nat) p r) -> (Prv p (Succ r) r (BFalse)))
    (many DcZ : (erased (Nat) p t) (erased (Top p t) q) -> (Prv p (Zero) t (BTrue)))))

(def-fns _ $ (erased lt-pre : (erased (Nat) a b) (erased (Lt (Succ a) b) p) -> (erased (Lt a b) q))
  (lt-trans a (Succ a) b (lt-succ a) p))

(def-fns _ $ (erased loc-dec : (erased (List (Nat)) ss) (erased (Nat) rho i r) (subterm erased (Loc ss rho i (Succ r)) q)
    -> (erased (Nat) rho1) (erased (Eq (Nat) rho (Succ rho1)) e) (erased (Loc ss rho1 i r) q1))
  (let-match erased q (LcT s rho1 _ i1 _ ss1 a q1) ((LcH s _ ss1 p) (values r (Refl _ rho) (LcH s r ss1 (lt-pre r s p)))))
  (let ((erased rho2) (erased e1) (erased q2)) (loc-dec ss1 rho1 i1 r q1))
  (let-match erased e1 (Refl _ _))
  (let ((erased c1) (erased e2) (erased a2)) (add-succ-right-inv s rho2 rho a))
  (values c1 e2 (LcT s rho2 c1 i1 r ss1 a2 q2)))

(def-fns _ $ (erased loc-pred : (erased (List (Nat)) ss) (erased (Nat) rho i z) (subterm erased (Loc ss rho (Succ i) (Zero)) q)
    (erased (Nth (Nat) ss i (Succ z)) n) -> (erased (Nat) rho1) (erased (Eq (Nat) rho (Succ rho1)) e) (erased (Loc ss rho1 i z) q1))
  (let-match erased q (LcT s rho1 _ _ _ ss1 a q1))
  (match erased q1 _
    ((LcH _ _ _ _)
      (let-match erased n (NthHere _ _ _))
      (let-match erased a (AddSucc _ _ c a1))
      (let-match erased (add-fn z (Zero) c z a1 (add-zero-right z)) (Refl _ _))
      (values z (Refl _ rho) (LcH (Succ z) z ss1 (lt-succ z))))
    ((LcT _ _ _ i1 _ _ _ _)
      (let-match erased n (NthThere _ _ _ _ _ nt))
      (let ((erased rho2) (erased e1) (erased q2)) (loc-pred ss1 rho1 i1 z q1 nt))
      (let-match erased e1 (Refl _ _))
      (let ((erased c1) (erased e2) (erased a2)) (add-succ-right-inv s rho2 rho a))
      (values c1 e2 (LcT s rho2 c1 i1 z ss1 a2 q2)))))

(def-fns _ $ (erased loc-fn : (erased (List (Nat)) ss) (erased (Nat) rho i r i2 r2) (subterm erased (Loc ss rho i r) p) (erased (Loc ss rho i2 r2) q)
    -> (erased (Eq (Nat) i i2) e) (erased (Eq (Nat) r r2) f))
  (match erased p _
    ((LcH s _ ss1 lt)
      (let-match erased q (LcH _ _ _ _) (absurd (LcT _ rho1 _ _ _ _ a _) (lt-asym rho s lt (add-le-left s rho1 rho a))))
      (values (Refl _ i) (Refl _ r)))
    ((LcT s rho1 _ i1 _ ss1 a p1)
      (let-match erased q (LcT _ rho2 _ i3 _ _ a2 q1) (absurd (LcH _ _ _ lt) (lt-asym rho s lt (add-le-left s rho1 rho a))))
      (let-match erased (add-cancel s rho1 rho2 rho a a2) (Refl _ _))
      (let ((erased e1) (erased e2)) (loc-fn ss1 rho1 i1 r i3 r2 p1 q1))
      (values (eq-cong-succ i1 i3 e1) e2))))

(def-fns _ $ (erased loc-inj : (erased (List (Nat)) ss) (erased (Nat) rho rho2 i r) (subterm erased (Loc ss rho i r) p) (erased (Loc ss rho2 i r) q)
    -> (erased (Eq (Nat) rho rho2) e))
  (match erased p _
    ((LcH _ _ _ _) (let-match erased q (LcH _ _ _ _)) (Refl _ rho))
    ((LcT s rho1 _ i1 _ ss1 a p1)
      (let-match erased q (LcT _ rho3 _ _ _ _ a2 q1))
      (let-match erased (loc-inj ss1 rho1 rho3 i1 r p1 q1) (Refl _ _))
      (add-fn s rho1 rho rho2 a a2))))

(def-fns _ $ (many loc-mk : (subterm many (List (Nat)) ss) (many (Nat) i r) (erased (Nat) s) (erased (Nth (Nat) ss i s) n) (erased (Lt r s) p)
    -> (many (Nat) rho) (erased (Loc ss rho i r) q))
  (let-match many ss (Cons _ s0 ss1) (absurd (Nil _) n))
  (match many i _
    ((Zero) (let-match erased n (NthHere _ _ _)) (values r (LcH s0 r ss1 p)))
    ((Succ i1)
      (let-match erased n (NthThere _ _ _ _ _ nt))
      (let ((many rho1) (erased q1)) (notail $ loc-mk ss1 i1 r s nt p))
      (let ((many rho) (erased a)) (add s0 rho1))
      (values rho (LcT s0 rho1 rho i1 r ss1 a q1)))))

(def-fns _ $ (many sg6 : (many (Nat) m) -> (many (List (Nat)) ss) (erased (Sg6 m ss) g))
  (values (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) m $ Nil (Nat)) (MkSg6 m)))

(def-fns _ $ (many top-at : (many (Nat) m) -> (many (Nat) t) (erased (TopAt m t) a))
  (let ((many ss) (erased g)) (sg6 m))
  (let-match erased g (MkSg6 _))
  (match many m _
    ((Zero)
      (let ((many t) (erased q)) (loc-mk ss n4 (Zero) n1 (NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthHere _ _ _) (LtZ _)))
      (values t (TA4 t ss g q)))
    ((Succ m1)
      (let ((many t) (erased q))
        (loc-mk ss n5 m1 m (NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthHere _ _ _) (lt-succ m1)))
      (values t (TA5 m1 t ss g q)))))

(def-fns _ $ (erased top-fn : (erased (Nat) p t t2) (subterm erased (Top p t) a) (erased (Top p t2) b) -> (erased (Eq (Nat) t t2) e))
  (match erased a _
    ((TopZ) (let-match erased b (TopZ)) (Refl _ t))
    ((TopS p1 m _ a1 ta)
      (let-match erased b (TopS _ m2 _ b1 tb))
      (let-match erased (top-fn p1 m m2 a1 b1) (Refl _ _))
      (match erased ta _
        ((TA5 m1 _ ss g q)
          (let-match erased tb (TA5 _ _ ss2 g2 q2))
          (let-match erased g (MkSg6 _))
          (let-match erased g2 (MkSg6 _))
          (loc-inj ss t t2 n5 m1 q q2))
        ((TA4 _ ss g q)
          (let-match erased tb (TA4 _ ss2 g2 q2))
          (let-match erased g (MkSg6 _))
          (let-match erased g2 (MkSg6 _))
          (loc-inj ss t t2 n4 (Zero) q q2))))))

(def-fns _ $ (erased sts-fn : (erased (Nat) i r m rs rs2) (erased (Ps) x x2) (erased (StS i x r m rs) p) (erased (StS i x2 r m rs2) q)
    -> (erased (Eq (Ps) x x2) e) (erased (Eq (Nat) rs rs2) f))
  (match erased p _
    ((Ss0 _) (let-match erased q (Ss0 _)) (values (Refl _ x) (Refl _ rs)))
    ((Ss1 _ _) (let-match erased q (Ss1 _ _)) (values (Refl _ x) (Refl _ rs)))
    ((Ss2 _ _) (let-match erased q (Ss2 _ _)) (values (Refl _ x) (Refl _ rs)))
    ((Ss3 _) (let-match erased q (Ss3 _)) (values (Refl _ x) (Refl _ rs)))
    ((Ss4 _ _) (let-match erased q (Ss4 _ _)) (values (Refl _ x) (Refl _ rs)))
    ((Ss5 _ _) (let-match erased q (Ss5 _ _)) (values (Refl _ x) (Refl _ rs)))))

(def-fns _ $ (erased blk-fn : (erased (Nat) p rho) (erased (List (Ps)) w w2) (subterm erased (PBlk p rho w) a) (erased (PBlk p rho w2) b)
    -> (erased (Eq (List (Ps)) w w2) e))
  (match erased a _
    ((BlZ) (let-match erased b (BlZ)) (Refl _ w))
    ((BlS p1 m _ i r rs x w1 ss top g lc st b1)
      (let-match erased b (BlS _ m2 _ i2 r2 rs2 x2 w3 ss2 top2 g2 lc2 st2 b2))
      (let-match erased (top-fn p1 m m2 top top2) (Refl _ _))
      (let-match erased g (MkSg6 _))
      (let-match erased g2 (MkSg6 _))
      (let ((erased e1) (erased e2)) (loc-fn ss rho i r i2 r2 lc lc2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let ((erased f1) (erased f2)) (sts-fn i r m rs rs2 x x2 st st2))
      (let-match erased f1 (Refl _ _))
      (let-match erased f2 (Refl _ _))
      (let-match erased (blk-fn p1 rs w1 w3 b1 b2) (Refl _ _))
      (Refl _ w))))

(def-fns _ $ (erased var-facts : (erased (Nat) j z m r) (erased (Ps) x y) (erased (List (Nat)) ss) (erased (Vs j x y z m) v) (erased (Sg6 m ss) g)
    -> (erased (StS (Succ j) x r m r) s1) (erased (StS j y z m m) s2) (erased (Nth (Nat) ss j (Succ z)) n)
    (erased (Step x (BFalse) x (BFalse)) t0) (erased (Step x (BTrue) y (BFalse)) t1))
  (let-match erased g (MkSg6 _))
  (match erased v _
    ((Vs1 _) (values (Ss1 r m) (Ss0 m) (NthHere _ _ _) (StD0) (StD1)))
    ((Vs2 _) (values (Ss2 r m) (Ss1 m m) (NthThere _ _ _ _ _ $ NthHere _ _ _) (StC0) (StC1)))
    ((Vs4 _) (values (Ss4 r m) (Ss3 m) (NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthHere _ _ _) (StB0) (StB1)))
    ((Vs5 _) (values (Ss5 r m) (Ss4 m m) (NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthHere _ _ _) (StA0) (StA1)))))

(def-fns _ $ (erased var-step : (erased (Nat) p m rho j z r r1) (erased (Bool) c1) (erased (Ps) x y) (erased (List (Ps)) w1 w3) (erased (List (Nat)) ss)
    (erased (Top p m) top) (erased (Sg6 m ss) g) (erased (Loc ss rho (Succ j) r) lc) (erased (Vs j x y z m) v)
    (erased (Rnd w1 w3 c1) rn1) (erased (Prv p r r1 c1) pv) (erased (PBlk p r1 w3) b3)
    -> (erased (List (Ps)) w2) (erased (Nat) rho2) (erased (Bool) c) (erased (Rnd (Cons (Ps) x w1) w2 c) rn)
    (erased (Prv (Succ p) rho rho2 c) pv2) (erased (PBlk (Succ p) rho2 w2) b2))
  (let ((erased s1) (erased s2) (erased nt) (erased t0) (erased t1)) (var-facts j z m r1 x y ss v g))
  (match erased pv _
    ((DcS _ _)
      (let ((erased rho2) (erased e) (erased lc2)) (loc-dec ss rho (Succ j) r1 lc))
      (let-match erased e (Refl _ _))
      (values (Cons (Ps) x w3) rho2 (BFalse) (RnX _ _ _ _ _ _ rn1 t0) (DcS _ rho2) (BlS p m rho2 (Succ j) r1 r1 x w3 ss top g lc2 s1 b3)))
    ((DcZ _ _ tp)
      (let-match erased (top-fn p r1 m tp top) (Refl _ _))
      (let ((erased rho2) (erased e) (erased lc2)) (loc-pred ss rho j z lc nt))
      (let-match erased e (Refl _ _))
      (values (Cons (Ps) y w3) rho2 (BFalse) (RnX _ _ _ _ _ _ rn1 t1) (DcS _ rho2) (BlS p m rho2 j z m y w3 ss top g lc2 s2 b3)))))

(def-fns _ $ (erased rnd-blk : (erased (Nat) p rho) (erased (List (Ps)) w) (subterm erased (PBlk p rho w) b)
    -> (erased (List (Ps)) w2) (erased (Nat) rho2) (erased (Bool) c) (erased (Rnd w w2 c) rn) (erased (Prv p rho rho2 c) pv) (erased (PBlk p rho2 w2) b2))
  (let-match erased b (BlS p1 m _ i r rs x w1 ss top g lc st b1) ((BlZ) (values (Nil (Ps)) (Zero) (BTrue) (RnN) (DcZ (Zero) (Zero) (TopZ)) (BlZ))))
  (let ((erased w3) (erased r1) (erased c1) (erased rn1) (erased pv1) (erased b3)) (rnd-blk p1 rs w1 b1))
  (let-match erased g (MkSg6 _))
  (match erased st _
    ((Ss0 _)
      (let-match erased lc (LcH _ _ _ _))
      (let ((erased t) (erased ta)) (top-at m))
      (match erased ta _
        ((TA5 m1 _ ss2 g2 q)
          (let-match erased g2 (MkSg6 _))
          (let-match erased pv1 (DcS _ _))
          (values (Cons (Ps) (PrA) w3) t (BTrue) (RnX _ _ _ _ _ _ rn1 (StDp0)) (DcZ _ t (TopS p1 m t top ta))
            (BlS p1 m t n5 m1 m1 (PrA) w3 ss top g q (Ss5 m1 m) b3)))
        ((TA4 _ ss2 g2 q)
          (let-match erased g2 (MkSg6 _))
          (let-match erased pv1 (DcZ _ _ tp))
          (let-match erased (top-fn p1 r1 m tp top) (Refl _ _))
          (values (Cons (Ps) (PrB) w3) t (BTrue) (RnX _ _ _ _ _ _ rn1 (StDp1)) (DcZ _ t (TopS p1 m t top ta))
            (BlS p1 m t n4 (Zero) (Zero) (PrB) w3 ss top g q (Ss4 (Zero) m) b3)))))
    ((Ss1 _ _) (var-step p1 m rho (Zero) (Zero) r r1 c1 (PrD) (PrDp) w1 w3 ss top g lc (Vs1 m) rn1 pv1 b3))
    ((Ss2 _ _) (var-step p1 m rho n1 m r r1 c1 (PrC) (PrD) w1 w3 ss top g lc (Vs2 m) rn1 pv1 b3))
    ((Ss3 _)
      (let ((erased rho2) (erased e) (erased lc2)) (loc-pred ss rho n2 m lc (NthThere _ _ _ _ _ $ NthThere _ _ _ _ _ $ NthHere _ _ _)))
      (let-match erased e (Refl _ _))
      (values (Cons (Ps) (PrC) w1) rho2 (BFalse) (RnBp w1) (DcS _ rho2) (BlS p1 m rho2 n2 m m (PrC) w1 ss top g lc2 (Ss2 m m) b1)))
    ((Ss4 _ _) (var-step p1 m rho n3 (Zero) r r1 c1 (PrB) (PrBp) w1 w3 ss top g lc (Vs4 m) rn1 pv1 b3))
    ((Ss5 _ _) (var-step p1 m rho n4 m r r1 c1 (PrA) (PrB) w1 w3 ss top g lc (Vs5 m) rn1 pv1 b3))))

(def-adts $ (Fam : -> Type)
  enum
  (many FE : (many (Nat) P) (many (Tt) T) -> (Fam))
  (many FO : (many (Nat) P) (many (Tt) T) -> (Fam))
  (many FVE : (many (Nat) P) -> (Fam))
  (many FVO : (many (Nat) P) -> (Fam)))

(def-adts
  ((FamOK : ((Fam) F) -> Type)
    enum
    (many OkE : (erased (Nat) P) (erased (Tt) T) (erased (Plain T) pl) -> (FamOK (FE P T)))
    (many OkO : (erased (Nat) P) (erased (Tt) T) (erased (Plain T) pl) -> (FamOK (FO P T)))
    (many OkVE : (erased (Nat) P) -> (FamOK (FVE (Succ P))))
    (many OkVO : (erased (Nat) P) -> (FamOK (FVO (Succ P))))))

(def-adts
  ((Phi : ((Fam) F) ((Nat) s) ((List (Tk)) X) ((Tt) T) -> Type)
    enum
    (many PhE : (erased (Nat) P s) (erased (Tt) T) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) X)
       (erased (PBlk P s w) b) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g) (erased (DEnc (Cons (Nat) n2 D) X) e)
       -> (Phi (FE P T) s X T))
    (many PhO : (erased (Nat) P s) (erased (Tt) T) (erased (Ps) x) (erased (Nat) h) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) X)
       (erased (PBlk (Succ P) s (Cons (Ps) x w)) b) (erased (Dig2 x (Zero) h) p) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g)
       (erased (DEnc (Cons (Nat) n2 (Cons (Nat) h D)) X) e) -> (Phi (FO P T) s X T))
    (many PhVE : (erased (Nat) P s) (erased (Tt) T) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) X)
       (erased (PBlk P s w) b) (erased (DgV w D T) g) (erased (DEnc (Cons (Nat) n2 D) X) e) -> (Phi (FVE P) s X T))
    (many PhVO : (erased (Nat) P s) (erased (Tt) T) (erased (Ps) x) (erased (Nat) h) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) X)
       (erased (PBlk (Succ P) s (Cons (Ps) x w)) b) (erased (Dig2 x (Zero) h) p) (erased (DgV w D T) g)
       (erased (DEnc (Cons (Nat) n2 (Cons (Nat) h D)) X) e) -> (Phi (FVO P) s X T))))

(def-adts
  ((MaxS : ((Fam) F) ((Nat) n) -> Type)
    enum
    (many MxE : (erased (Nat) P t) (erased (Tt) T) (erased (Top P t) q) -> (MaxS (FE P T) t))
    (many MxO : (erased (Nat) P t n) (erased (Tt) T) (erased (Top P t) q) (erased (Double (Succ t) n) d) -> (MaxS (FO P T) n))
    (many MxVE : (erased (Nat) P t) (erased (Top P t) q) -> (MaxS (FVE P) t))
    (many MxVO : (erased (Nat) P t n) (erased (Top P t) q) (erased (Double (Succ t) n) d) -> (MaxS (FVO P) n))))

(def-adts
  ((Eol : ((Fam) F) ((List (Tk)) Y) ((Tt) T2) -> Type)
    enum
    (many EoE : (erased (Nat) P t) (erased (Tt) T) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) Y)
       (erased (Top P t) q) (erased (PBlk P t w) b) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g) (erased (DEnc (Cons (Nat) n3 D) Y) e)
       -> (Eol (FE P T) Y T))
    (many EoO : (erased (Nat) P t) (erased (Tt) T) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) Y)
       (erased (Top P t) q) (erased (PBlk P t w) b) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g)
       (erased (DEnc (Cons (Nat) n1 (Cons (Nat) (Zero) D)) Y) e) -> (Eol (FO P T) Y T))
    (many EoVE : (erased (Nat) P t) (erased (Tt) T2) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) Y)
       (erased (Top P t) q) (erased (PBlk P t w) b) (erased (DgV w D T2) g) (erased (DEnc (Cons (Nat) n3 D) Y) e) -> (Eol (FVE P) Y T2))
    (many EoVO : (erased (Nat) P t) (erased (Tt) T2) (erased (List (Ps)) w) (erased (List (Nat)) D) (erased (List (Tk)) Y)
       (erased (Top P t) q) (erased (PBlk P t w) b) (erased (DgV w D T2) g)
       (erased (DEnc (Cons (Nat) n1 (Cons (Nat) (Zero) D)) Y) e) -> (Eol (FVO P) Y T2))))

(def-fns _ $ (erased tok2 : (erased (Nat) d) (erased (List (Nat)) D) (erased (List (Tk)) X) (erased (DEnc (Cons (Nat) (Succ d) D) X) e)
    -> (erased (List (Tk)) X1) (erased (DEnc D X1) e1) (erased (TpR d (Cons (Tk) (T1) X1) X) p))
  (let-match erased e (EnC _ _ X1 _ e1 t))
  (let-match erased t (DtS _ _ _ p))
  (values X1 e1 p))

(def-fns _ $ (erased rr-dig : (erased (Nat) d) (erased (List (Nat)) K) (erased (List (Tk)) R X Y) (erased (Tt) T T2) (erased (Bt d) b)
    (erased (Dt d R X) t) (erased (Rr (Cons (Nat) (Succ (Succ d)) K) R T Y T2) r) -> (erased (Rr K X T Y T2) q))
  (let-match erased r (MkRr _ _ _ _ _ s c sw fin))
  (MkRr _ _ _ _ _ s c (sw-dig d R X K s b t sw) fin))

(def-fns _ $ (erased odd-top : (erased (Ps) x x2) (erased (List (Ps)) w w2) (erased (Nat) h h2) (erased (Dig2 x (Zero) h) pd)
    (erased (Dig2 x2 (Zero) h2) pd2) (erased (Rnd (Cons (Ps) x w) (Cons (Ps) x2 w2) (BFalse)) rn)
    -> (erased (Bool) c1) (erased (Rnd w w2 c1) rn1) (erased (Cy c1 h h2) cy) (erased (Bt h) bh))
  (let-match erased rn (RnX _ _ _ _ c1 _ rn1 st) (absurd (RnBp _) pd))
  (let ((erased x3) (erased h3) (erased l) (erased l2) (erased pr) (erased p3) (erased cy) (erased q3)) (step-dec x x2 c1 (BFalse) st))
  (let-match erased pr (PreN _ v))
  (let ((erased e1) (erased e2)) (dig2-fn x (Zero) h h3 l pd p3))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let ((erased f1) (erased f2)) (dig2-fn x2 h3 l2 (Zero) h2 q3 pd2))
  (let-match erased f2 (Refl _ _))
  (let ((erased b0) (erased bh)) (var-bits x (Zero) h v pd))
  (values c1 rn1 cy bh))

(def-fns _ $ (erased ev-p : (erased (List (Ps)) w w2) (erased (Bool) c) (erased (Nat) d) (erased (List (Nat)) D D2) (erased (List (Tk)) X Y) (erased (Tt) T)
    (erased (Rnd w w2 c) rn) (erased (Cy c n3 (Succ (Succ d))) cy) (erased (Plain T) pl) (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) dg)
    (erased (DEnc (Cons (Nat) n2 D) X) en) (erased (Dg w2 (Cons (Nat) (Zero) (Nil (Nat))) D2) dg2) (erased (DEnc (Cons (Nat) (Succ d) D2) Y) en2)
    -> (erased (Nat) k) (erased (Rd X T Y T k) r))
  (let ((erased X1) (erased e1) (erased p1)) (tok2 n1 D X en))
  (let-match erased p1 (TpS _ _ _ q1))
  (let-match erased q1 (TpZ _))
  (let ((erased Z) (erased f1) (erased r1)) (tok2 d D2 Y en2))
  (let ((erased W) (erased u)) (up-dg w2 _ _ D2 Z dg2 f1))
  (rd-of X1 Y T T (gp w w2 c rn n3 (Succ (Succ d)) (Nil (Nat)) D D2 X1 Z W Y T pl cy dg e1 dg2 f1 u (wk-top d Z W Y u r1))))

(def-fns _ $ (erased ev-v : (erased (List (Ps)) w w2) (erased (Bool) c) (erased (Nat) d) (erased (List (Nat)) D D2) (erased (List (Tk)) X Y) (erased (Tt) T T2)
    (erased (Rnd w w2 c) rn) (erased (Cy c n3 (Succ (Succ d))) cy) (erased (DgV w D T) dg)
    (erased (DEnc (Cons (Nat) n2 D) X) en) (erased (DgV w2 D2 T2) dg2) (erased (DEnc (Cons (Nat) (Succ d) D2) Y) en2)
    -> (erased (Nat) k) (erased (Rd X T Y T2 k) r))
  (let ((erased X1) (erased e1) (erased p1)) (tok2 n1 D X en))
  (let-match erased p1 (TpS _ _ _ q1))
  (let-match erased q1 (TpZ _))
  (let ((erased Z) (erased f1) (erased r1)) (tok2 d D2 Y en2))
  (let ((erased W) (erased u)) (up-dgv w2 D2 T2 Z dg2 f1))
  (rd-of X1 Y T T2 (gv w w2 c rn n3 (Succ (Succ d)) (Nil (Nat)) D D2 X1 Z W Y T T2 cy dg e1 dg2 f1 u (wk-top d Z W Y u r1))))

(def-fns _ $ (erased conj : (erased (Fam) F) (erased (Nat) s) (erased (List (Tk)) X Y) (erased (Tt) T T2) (erased (FamOK F) ok)
    (erased (Phi F (Succ s) X T) a) (erased (Phi F s Y T2) b) -> (erased (Nat) c) (erased (Rd X T Y T2 c) d))
  (match erased a _
    ((PhE P _ _ w D _ bk dg en)
      (let-match erased b (PhE _ _ _ w2 D2 _ bk2 dg2 en2))
      (let-match erased ok (OkE _ _ pl))
      (let ((erased w3) (erased s3) (erased c3) (erased rn) (erased pv) (erased bk3)) (rnd-blk P (Succ s) w bk))
      (let-match erased pv (DcS _ _))
      (let-match erased (blk-fn P s w3 w2 bk3 bk2) (Refl _ _))
      (ev-p w w2 (BFalse) n1 D D2 X Y T rn (CyF _) pl dg en dg2 en2))
    ((PhO P _ _ x h w D _ bk pd dg en)
      (let-match erased b (PhO _ _ _ x2 h2 w2 D2 _ bk2 pd2 dg2 en2))
      (let-match erased ok (OkO _ _ pl))
      (let ((erased w3) (erased s3) (erased c3) (erased rn) (erased pv) (erased bk3)) (rnd-blk (Succ P) (Succ s) (Cons (Ps) x w) bk))
      (let-match erased pv (DcS _ _))
      (let-match erased (blk-fn (Succ P) s w3 (Cons (Ps) x2 w2) bk3 bk2) (Refl _ _))
      (let ((erased c1) (erased rn1) (erased cy) (erased bh)) (odd-top x x2 w w2 h h2 pd pd2 rn))
      (let ((erased Xa) (erased ea) (erased p1)) (tok2 n1 (Cons (Nat) h D) X en))
      (let-match erased p1 (TpS _ _ _ q1))
      (let-match erased q1 (TpZ _))
      (let-match erased ea (EnC _ _ X1 _ e1 th))
      (let ((erased Ya) (erased fa) (erased r1)) (tok2 n1 (Cons (Nat) h2 D2) Y en2))
      (let-match erased fa (EnC _ _ Z _ f1 sh))
      (let ((erased W) (erased u)) (up-dg w2 _ _ D2 Z dg2 f1))
      (let ((erased Wa) (erased ua)) (up-ex h2 Z Ya sh))
      (let ((erased wk)) (wk-up h2 Z Ya W Wa Y (Cons (Nat) n3 (Nil (Nat))) sh u ua (wk-top n1 Ya Wa Y ua r1)))
      (rd-of Xa Y T T (rr-dig h (Cons (Nat) n3 (Nil (Nat))) X1 Xa Y T T bh th
        (gp w w2 c1 rn1 (Succ (Succ h)) (Succ (Succ h2)) (Cons (Nat) n3 (Nil (Nat))) D D2 X1 Z W Y T pl (cy-ss c1 h h2 cy) dg e1 dg2 f1 u wk))))
    ((PhVE P _ _ w D _ bk dg en)
      (let-match erased b (PhVE _ _ _ w2 D2 _ bk2 dg2 en2))
      (let ((erased w3) (erased s3) (erased c3) (erased rn) (erased pv) (erased bk3)) (rnd-blk P (Succ s) w bk))
      (let-match erased pv (DcS _ _))
      (let-match erased (blk-fn P s w3 w2 bk3 bk2) (Refl _ _))
      (ev-v w w2 (BFalse) n1 D D2 X Y T T2 rn (CyF _) dg en dg2 en2))
    ((PhVO P _ _ x h w D _ bk pd dg en)
      (let-match erased b (PhVO _ _ _ x2 h2 w2 D2 _ bk2 pd2 dg2 en2))
      (let ((erased w3) (erased s3) (erased c3) (erased rn) (erased pv) (erased bk3)) (rnd-blk (Succ P) (Succ s) (Cons (Ps) x w) bk))
      (let-match erased pv (DcS _ _))
      (let-match erased (blk-fn (Succ P) s w3 (Cons (Ps) x2 w2) bk3 bk2) (Refl _ _))
      (let ((erased c1) (erased rn1) (erased cy) (erased bh)) (odd-top x x2 w w2 h h2 pd pd2 rn))
      (let ((erased Xa) (erased ea) (erased p1)) (tok2 n1 (Cons (Nat) h D) X en))
      (let-match erased p1 (TpS _ _ _ q1))
      (let-match erased q1 (TpZ _))
      (let-match erased ea (EnC _ _ X1 _ e1 th))
      (let ((erased Ya) (erased fa) (erased r1)) (tok2 n1 (Cons (Nat) h2 D2) Y en2))
      (let-match erased fa (EnC _ _ Z _ f1 sh))
      (let ((erased W) (erased u)) (up-dgv w2 D2 T2 Z dg2 f1))
      (let ((erased Wa) (erased ua)) (up-ex h2 Z Ya sh))
      (let ((erased wk)) (wk-up h2 Z Ya W Wa Y (Cons (Nat) n3 (Nil (Nat))) sh u ua (wk-top n1 Ya Wa Y ua r1)))
      (rd-of Xa Y T T2 (rr-dig h (Cons (Nat) n3 (Nil (Nat))) X1 Xa Y T T2 bh th
        (gv w w2 c1 rn1 (Succ (Succ h)) (Succ (Succ h2)) (Cons (Nat) n3 (Nil (Nat))) D D2 X1 Z W Y T T2 (cy-ss c1 h h2 cy) dg e1 dg2 f1 u wk))))))

(def-fns _ $ (erased shed-id : (erased (Nat) P t h) (erased (Ps) x) (erased (List (Ps)) w w2) (erased (PBlk (Succ P) (Zero) (Cons (Ps) x w)) bk)
    (erased (Dig2 x (Zero) h) pd) (erased (Top P t) top) (erased (PBlk P t w2) bk2) -> (erased (Eq (List (Ps)) w w2) e) (erased (Eq (Nat) h n2) f))
  (let-match erased bk (BlS _ m _ i r rs _ _ ss top0 g lc st b1))
  (let-match erased g (MkSg6 _))
  (let-match erased lc (LcH _ _ _ _) (absurd (LcT _ _ _ _ _ _ a _) a))
  (let-match erased st (Ss0 _))
  (let-match erased pd (D2Dp))
  (let-match erased (top-fn P m t top0 top) (Refl _ _))
  (values (blk-fn P m w w2 b1 bk2) (Refl _ h)))

(def-fns _ $ (erased shed-core : (erased (List (Nat)) D) (erased (List (Tk)) X Y) (erased (Tt) T) (erased (DEnc (Cons (Nat) n2 (Cons (Nat) n2 D)) X) e)
    (erased (DEnc (Cons (Nat) n1 (Cons (Nat) (Zero) D)) Y) f) -> (erased (Rd X T Y T (Zero)) d))
  (let ((erased Xa) (erased ea) (erased p1)) (tok2 n1 (Cons (Nat) n2 D) X e))
  (let-match erased p1 (TpS _ _ _ q1))
  (let-match erased q1 (TpZ _))
  (let ((erased X1) (erased e1) (erased p2)) (tok2 n1 D Xa ea))
  (let-match erased p2 (TpS _ _ _ q2))
  (let-match erased q2 (TpZ _))
  (let ((erased Ya) (erased fa) (erased r1)) (tok2 (Zero) (Cons (Nat) (Zero) D) Y f))
  (let-match erased r1 (TpZ _))
  (let-match erased fa (EnC _ _ Y1 _ f1 s1))
  (let-match erased s1 (DtZ _))
  (let-match erased (enc-fn D X1 Y1 e1 f1) (Refl _ _))
  (RdT _ _ _ (Nil (Nat)) T (SwP1T (Zero) (Nil (Nat)) X1 _ (TpZ _)) (WkN _)))

(def-fns _ $ (erased eol : (erased (Fam) F) (erased (List (Tk)) X Y) (erased (Tt) T T2) (erased (FamOK F) ok)
    (erased (Phi F (Zero) X T) a) (erased (Eol F Y T2) b) -> (erased (Nat) c) (erased (Rd X T Y T2 c) d))
  (match erased a _
    ((PhE P _ _ w D _ bk dg en)
      (let-match erased b (EoE _ t _ w2 D2 _ top bk2 dg2 en2))
      (let-match erased ok (OkE _ _ pl))
      (let ((erased w3) (erased s3) (erased c3) (erased rn) (erased pv) (erased bk3)) (rnd-blk P (Zero) w bk))
      (let-match erased pv (DcZ _ _ top3))
      (let-match erased (top-fn P s3 t top3 top) (Refl _ _))
      (let-match erased (blk-fn P s3 w3 w2 bk3 bk2) (Refl _ _))
      (ev-p w w2 (BTrue) n2 D D2 X Y T rn (CyT _) pl dg en dg2 en2))
    ((PhO P _ _ x h w D _ bk pd dg en)
      (let-match erased b (EoO _ t _ w2 D2 _ top bk2 dg2 en2))
      (let ((erased e1) (erased e2)) (shed-id P t h x w w2 bk pd top bk2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let-match erased (dg-fn w _ D D2 dg dg2) (Refl _ _))
      (values (Zero) (shed-core D X Y T en en2)))
    ((PhVE P _ _ w D _ bk dg en)
      (let-match erased b (EoVE _ t _ w2 D2 _ top bk2 dg2 en2))
      (let ((erased w3) (erased s3) (erased c3) (erased rn) (erased pv) (erased bk3)) (rnd-blk P (Zero) w bk))
      (let-match erased pv (DcZ _ _ top3))
      (let-match erased (top-fn P s3 t top3 top) (Refl _ _))
      (let-match erased (blk-fn P s3 w3 w2 bk3 bk2) (Refl _ _))
      (ev-v w w2 (BTrue) n2 D D2 X Y T T2 rn (CyT _) dg en dg2 en2))
    ((PhVO P _ _ x h w D _ bk pd dg en)
      (let-match erased b (EoVO _ t _ w2 D2 _ top bk2 dg2 en2))
      (let ((erased e1) (erased e2)) (shed-id P t h x w w2 bk pd top bk2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let ((erased f1) (erased f2)) (dgv-fn w D D2 T T2 dg dg2))
      (let-match erased f1 (Refl _ _))
      (let-match erased f2 (Refl _ _))
      (values (Zero) (shed-core D X Y T en en2)))))

(def-adts
  ((TopL : ((Nat) p) ((Nat) t) -> Type)
    enum
    (many TLZ : -> (TopL (Zero) (Zero)))
    (many TLS : (erased (Nat) p) (many (Nat) m) (erased (Nat) t) (many (TopL p m) rest) (erased (TopAt m t) a) -> (TopL (Succ p) t))))

(def-adts
  ((Ale : ((List (Nat)) ss) ((Nat) b) -> Type)
    enum
    (many AeN : (erased (Nat) b) -> (Ale (Nil (Nat)) b))
    (many AeC : (erased (Nat) s b) (erased (List (Nat)) ss) (erased (Lt s b) p) (erased (Ale ss b) q) -> (Ale (Cons (Nat) s ss) b))))

(def-adts
  ((Pfx : ((List (Nat)) xs) ((List (Nat)) ys) -> Type)
    enum
    (many PfN : (erased (List (Nat)) ys) -> (Pfx (Nil (Nat)) ys))
    (many PfC : (erased (Nat) x) (erased (List (Nat)) xs ys) (erased (Pfx xs ys) p) -> (Pfx (Cons (Nat) x xs) (Cons (Nat) x ys)))))

(def-fns _ $ (erased topl-top : (erased (Nat) p t) (subterm erased (TopL p t) tl) -> (erased (Top p t) q))
  (let-match erased tl (TLS p1 m _ tl1 a) ((TLZ) (TopZ)))
  (TopS p1 m t (topl-top p1 m tl1) a))

(def-fns _ $ (erased add-le-cancel : (erased (Nat) s a b x y) (subterm erased (Add s a x) p) (erased (Add s b y) q) (erased (Lt x (Succ y)) l)
    -> (erased (Lt a (Succ b)) r))
  (match erased p _
    ((AddZero _) (let-match erased q (AddZero _)) l)
    ((AddSucc s1 _ x1 p1)
      (let-match erased q (AddSucc _ _ y1 q1))
      (let-match erased l (LtS _ _ l1))
      (add-le-cancel s1 a b x1 y1 p1 q1 l1))))

(def-fns _ $ (erased loc-le : (erased (List (Nat)) ss) (erased (Nat) rho i r b) (subterm erased (Loc ss rho i r) q) (erased (Ale ss (Succ b)) al)
    -> (erased (Lt r b) l))
  (match erased q _
    ((LcH s _ _ p) (let-match erased al (AeC _ _ _ sb _)) (lt-le-trans r s b p sb))
    ((LcT _ rho1 _ i1 _ ss1 _ q1) (let-match erased al (AeC _ _ _ _ al1)) (loc-le ss1 rho1 i1 r b q1 al1))))

(def-fns _ $ (erased loc-pfx : (erased (List (Nat)) ss ss2) (erased (Nat) rho i r) (subterm erased (Loc ss rho i r) q) (erased (Pfx ss ss2) f)
    -> (erased (Loc ss2 rho i r) q2))
  (match erased q _
    ((LcH s _ _ p) (let-match erased f (PfC _ _ ys _)) (LcH s r ys p))
    ((LcT s rho1 _ i1 _ ss1 a q1) (let-match erased f (PfC _ _ ys f1)) (LcT s rho1 rho i1 r ys a (loc-pfx ss1 ys rho1 i1 r q1 f1)))))

(def-fns _ $ (erased sts-lt : (erased (Nat) i r m rs rho) (erased (Ps) x) (erased (List (Nat)) ss) (erased (Sg6 m ss) g) (erased (Loc ss rho i r) lc)
    (erased (StS i x r m rs) st) -> (erased (Lt rs (Succ m)) l))
  (let-match erased g (MkSg6 _))
  (let ((erased (Ale ss (Succ (Succ m))) al)) (AeC _ _ _ (LtS _ _ (LtZ _)) $ AeC _ _ _ (lt-succ (Succ m)) $ AeC _ _ _ (lt-succ (Succ m)) $
    AeC _ _ _ (LtS _ _ (LtZ _)) $ AeC _ _ _ (lt-succ (Succ m)) $ AeC _ _ _ (lt-weaken _ _ (lt-succ m)) $ AeN _))
  (match erased st _
    ((Ss0 _) (lt-succ m))
    ((Ss1 _ _) (loc-le ss rho i r (Succ m) lc al))
    ((Ss2 _ _) (loc-le ss rho i r (Succ m) lc al))
    ((Ss3 _) (lt-succ m))
    ((Ss4 _ _) (loc-le ss rho i r (Succ m) lc al))
    ((Ss5 _ _) (loc-le ss rho i r (Succ m) lc al))))

(def-fns _ $ (erased ta-loc : (erased (Nat) m t) (erased (List (Nat)) ss) (erased (TopAt m t) a) (erased (Sg6 m ss) g)
    -> (erased (Nat) i z) (erased (Loc ss t i z) q))
  (let-match erased g (MkSg6 _))
  (match erased a _
    ((TA5 m1 _ _ g2 q) (let-match erased g2 (MkSg6 _)) (values n5 m1 q))
    ((TA4 _ _ g2 q) (let-match erased g2 (MkSg6 _)) (values n4 (Zero) q))))

(def-fns _ $ (many mk-topl : (subterm many (Nat) p) -> (many (Nat) t) (many (TopL p t) tl))
  (let-match many p (Succ p1) ((Zero) (values (Zero) (TLZ))))
  (let ((many m) (many tl1)) (notail $ mk-topl p1))
  (let ((many t) (erased a)) (top-at m))
  (values t (TLS p1 m t tl1 a)))

(def-fns _ $ (many loc-find : (subterm many (List (Nat)) ss) (many (Nat) rho) (erased (Nat) t i z) (erased (Loc ss t i z) q) (erased (Lt rho (Succ t)) bn)
    -> (many (Nat) j) (many (Nat) r) (erased (Loc ss rho j r) lc))
  (let-match many ss (Cons _ s ss1) (absurd (Nil _) q))
  (let-match many (lt-dec rho s) (No _ _ _ _ le) ((Yes _ _ _ _ p) (values (Zero) rho (LcH s rho ss1 p))))
  (let ((erased ge)) (le-lt-succ s rho le))
  (let ((many rho1) (erased a)) (sub rho s ge))
  (let-match erased q (LcT _ t1 _ i1 _ _ a0 q1) (absurd (LcH _ _ _ p0) (lt-asym t rho (lt-le-trans t s rho p0 ge) bn)))
  (let ((many j) (many r) (erased lc)) (notail $ loc-find ss1 rho1 t1 i1 z q1 (add-le-cancel s rho1 t1 rho t a a0 bn)))
  (values (Succ j) r (LcT s rho1 rho j r ss1 a lc)))

(def-fns _ $ (many sts-of : (many (Nat) i r m) (erased (Nat) rho) (erased (List (Nat)) ss) (erased (Sg6 m ss) g) (erased (Loc ss rho i r) q)
    -> (many (Ps) x) (many (Nat) rs) (erased (StS i x r m rs) st))
  (let-match erased g (MkSg6 _))
  (let-match many i (Succ i1)
    ((Zero) (let-match erased q (LcH _ _ _ p)) (let-match erased p (LtZ _) (absurd (LtS _ _ l) l)) (values (PrDp) m (Ss0 m))))
  (let-match erased q (LcT _ _ _ _ _ _ _ q1))
  (let-match many i1 (Succ i2) ((Zero) (values (PrD) r (Ss1 r m))))
  (let-match erased q1 (LcT _ _ _ _ _ _ _ q2))
  (let-match many i2 (Succ i3) ((Zero) (values (PrC) r (Ss2 r m))))
  (let-match erased q2 (LcT _ _ _ _ _ _ _ q3))
  (let-match many i3 (Succ i4)
    ((Zero) (let-match erased q3 (LcH _ _ _ p)) (let-match erased p (LtZ _) (absurd (LtS _ _ l) l)) (values (PrBp) m (Ss3 m))))
  (let-match erased q3 (LcT _ _ _ _ _ _ _ q4))
  (let-match many i4 (Succ i5) ((Zero) (values (PrB) r (Ss4 r m))))
  (let-match erased q4 (LcT _ _ _ _ _ _ _ q5))
  (let-match many i5 (Zero) (absurd (Succ _) (let-match erased q5 (LcT _ _ _ _ _ _ _ q6)) q6))
  (values (PrA) r (Ss5 r m)))

(def-fns _ $ (many blk-run : (subterm many (Nat) p) (many (Nat) rho) (erased (Nat) t) (many (TopL p t) tl) (erased (Lt rho (Succ t)) bn)
    -> (many (List (Ps)) w) (erased (PBlk p rho w) b))
  (let-match many p (Succ p1) ((Zero) (let-match erased tl (TLZ)) (let-match erased bn (LtZ _) (absurd (LtS _ _ l) l)) (values (Nil (Ps)) (BlZ))))
  (let-match many tl (TLS _ m _ tl1 ta))
  (let ((many ss) (erased g)) (sg6 m))
  (let ((erased i0) (erased z0) (erased q0)) (ta-loc m t ss ta g))
  (let ((many i) (many r) (erased lc)) (loc-find ss rho t i0 z0 q0 bn))
  (let ((many x) (many rs) (erased st)) (sts-of i r m rho ss g lc))
  (let ((many w1) (erased b1)) (notail $ blk-run p1 rs m tl1 (sts-lt i r m rs rho x ss g lc st)))
  (values (Cons (Ps) x w1) (BlS p1 m rho i r rs x w1 ss (topl-top p1 m tl1) g lc st b1)))

(def-fns _ $ (erased dbl-loc3 : (erased (Nat) m n) (erased (Double (Succ m) n) d)
    -> (erased (Loc (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Nil (Nat)) n n2 m) q))
  (let-match erased d (DS _ d1 dd))
  (LcT n1 (Succ d1) n n1 m _ (AddSucc (Zero) (Succ d1) (Succ d1) (AddZero (Succ d1)))
    (LcT (Succ m) m (Succ d1) (Zero) m _ (AddSucc m m d1 (dbl-add m d1 dd)) (LcH (Succ m) m _ (lt-succ m)))))

(def-fns _ $ (erased absurd loc3-no : (erased (Nat) a rho k r)
    (erased (Loc (Cons (Nat) n1 $ Cons (Nat) (Succ a) $ Cons (Nat) (Succ a) $ Nil (Nat)) rho (Succ (Succ (Succ k))) r) q) -> (erased (False) f))
  (let-match erased q (LcT _ _ _ _ _ _ _ q1))
  (let-match erased q1 (LcT _ _ _ _ _ _ _ q2))
  (let-match erased q2 (LcT _ _ _ _ _ _ _ q3))
  q3)

(def-fns _ $ (erased odd-hi : (erased (Nat) i r m rs rho h0 h) (erased (Ps) x)
    (erased (Loc (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Nil (Nat)) rho i r) lc)
    (erased (StS i x r m rs) st) (erased (Dig2 x h0 h) p) -> (erased (Eq (Nat) h0 (Zero)) e))
  (match erased st _
    ((Ss0 _) (let-match erased p (D2Dp)) (Refl _ h0))
    ((Ss1 _ _) (let-match erased p (D2D)) (Refl _ h0))
    ((Ss2 _ _) (let-match erased p (D2C)) (Refl _ h0))
    (absurd (Ss3 _) (loc3-no m rho (Zero) r lc))
    (absurd (Ss4 _ _) (loc3-no m rho n1 r lc))
    (absurd (Ss5 _ _) (loc3-no m rho n2 r lc))))

(def-fns _ $ (many dig2-run : (many (Ps) x) -> (many (Nat) h l) (erased (Dig2 x h l) p))
  (match many x _
    ((PrA) (values n1 (Zero) (D2A)))
    ((PrB) (values n1 n1 (D2B)))
    ((PrBp) (values n1 n2 (D2Bp)))
    ((PrC) (values (Zero) (Zero) (D2C)))
    ((PrD) (values (Zero) n1 (D2D)))
    ((PrDp) (values (Zero) n2 (D2Dp)))))

(def-fns _ $ (many bot-run : (many (Ps) x) -> (many (Nat) h) (many (Tt) T) (erased (Bot x h T) b))
  (match many x _
    ((PrA) (values n1 (Tt11) (BoA)))
    ((PrB) (values n1 (Tt011) (BoB)))
    ((PrBp) (values n1 (Tt0011) (BoBp)))
    ((PrC) (values (Zero) (Tt11) (BoC)))
    ((PrD) (values (Zero) (Tt011) (BoD)))
    ((PrDp) (values (Zero) (Tt0011) (BoDp)))))

(def-fns _ $ (many dg-run : (subterm many (List (Ps)) w) (many (List (Nat)) E) -> (many (List (Nat)) D) (erased (Dg w E D) g))
  (let-match many w (Cons _ x w1) ((Nil _) (values E (DgN E))))
  (let ((many h) (many l) (erased p)) (dig2-run x))
  (let ((many D) (erased g)) (notail $ dg-run w1 E))
  (values (Cons (Nat) h (Cons (Nat) l D)) (DgC x h l w1 E D g p)))

(def-fns _ $ (many dgv-run : (many (Ps) x) (subterm many (List (Ps)) w) -> (many (List (Nat)) D) (many (Tt) T) (erased (DgV (Cons (Ps) x w) D T) g))
  (let-match many w (Cons _ y w1)
    ((Nil _) (let ((many h) (many T) (erased b)) (bot-run x)) (values (Cons (Nat) h (Nil (Nat))) T (DvN x h T b))))
  (let ((many h) (many l) (erased p)) (dig2-run x))
  (let ((many D) (many T) (erased g)) (notail $ dgv-run y w1))
  (values (Cons (Nat) h (Cons (Nat) l D)) T (DvC x h l w D T g p)))

(def-fns _ $ (many tpr-run : (subterm many (Nat) k) (many (List (Tk)) R) -> (many (List (Tk)) X) (erased (TpR k R X) p))
  (let-match many k (Succ kk) ((Zero) (values R (TpZ R))))
  (let ((many X1) (erased p1)) (notail $ tpr-run kk R))
  (values (Cons (Tk) (Tp) X1) (TpS kk R X1 p1)))

(def-fns _ $ (many enc-run : (subterm many (List (Nat)) D) -> (many (List (Tk)) X) (erased (DEnc D X) e))
  (let-match many D (Cons _ d D1) ((Nil _) (values (Nil (Tk)) (EnN))))
  (let ((many X1) (erased e1)) (notail $ enc-run D1))
  (let-match many d (Succ k) ((Zero) (values (Cons (Tk) (T0) X1) (EnC d D1 X1 _ e1 (DtZ X1)))))
  (let ((many X) (erased p)) (tpr-run k (Cons (Tk) (T1) X1)))
  (values X (EnC d D1 X1 X e1 (DtS k X1 X p))))

(def-fns _ $ (many odd-head : (many (Nat) m s) (erased (Nat) n) (erased (Double (Succ m) n) d) (erased (Lt s (Succ n)) bn)
    -> (many (Ps) x) (many (Nat) h rs) (erased (Nat) i r) (erased (List (Nat)) ss) (erased (Sg6 m ss) g) (erased (Loc ss s i r) lc)
    (erased (StS i x r m rs) st) (erased (Dig2 x (Zero) h) pd) (erased (Lt rs (Succ m)) lt))
  (let ((many ss3)) (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Nil (Nat)))
  (let ((many ss) (erased g)) (sg6 m))
  (let-match erased g (MkSg6 _))
  (let ((many i) (many r) (erased lc3)) (loc-find ss3 s n n2 m (dbl-loc3 m n d) bn))
  (let ((erased lc)) (loc-pfx ss3 ss s i r lc3 (PfC _ _ _ $ PfC _ _ _ $ PfC _ _ _ $ PfN _)))
  (let ((many x) (many rs) (erased st)) (sts-of i r m s ss g lc))
  (let ((many h0) (many h) (erased p)) (dig2-run x))
  (let-match erased (odd-hi i r m rs s h0 h x lc3 st p) (Refl _ _))
  (values x h rs i r ss g lc st p (sts-lt i r m rs s x ss g lc st)))

(def-fns _ $ (many phi-run : (many (Fam) F) (many (Nat) s) (erased (Nat) n) (erased (FamOK F) ok) (erased (MaxS F n) mx) (erased (Lt s (Succ n)) bn)
    -> (many (List (Tk)) X) (many (Tt) T) (erased (Phi F s X T) ph))
  (match many F _
    ((FE P T)
      (let-match erased mx (MxE _ _ _ q))
      (let ((many t) (many tl)) (mk-topl P))
      (let-match erased (top-fn P n t q (topl-top P t tl)) (Refl _ _))
      (let ((many w) (erased b)) (blk-run P s t tl bn))
      (let ((many D) (erased g)) (dg-run w (Cons (Nat) (Zero) (Nil (Nat)))))
      (let ((many X) (erased e)) (enc-run (Cons (Nat) n2 D)))
      (values X T (PhE P s T w D X b g e)))
    ((FO P T)
      (let-match erased mx (MxO _ t _ _ q d))
      (let ((many m) (many tl)) (mk-topl P))
      (let-match erased (top-fn P t m q (topl-top P m tl)) (Refl _ _))
      (let ((many x) (many h) (many rs) (erased i) (erased r) (erased ss) (erased g) (erased lc) (erased st) (erased pd) (erased lt)) (odd-head m s n d bn))
      (let ((many w) (erased b)) (blk-run P rs m tl lt))
      (let ((many D) (erased g2)) (dg-run w (Cons (Nat) (Zero) (Nil (Nat)))))
      (let ((many X) (erased e)) (enc-run (Cons (Nat) n2 (Cons (Nat) h D))))
      (values X T (PhO P s T x h w D X (BlS P m s i r rs x w ss (topl-top P m tl) g lc st b) pd g2 e)))
    ((FVE P)
      (let-match erased ok (OkVE _))
      (let-match erased mx (MxVE _ _ q))
      (let ((many t) (many tl)) (mk-topl P))
      (let-match erased (top-fn P n t q (topl-top P t tl)) (Refl _ _))
      (let ((many w) (erased b)) (blk-run P s t tl bn))
      (let-match many w (Cons _ y w1) (absurd (Nil _) b))
      (let ((many D) (many T) (erased g)) (dgv-run y w1))
      (let ((many X) (erased e)) (enc-run (Cons (Nat) n2 D)))
      (values X T (PhVE P s T w D X b g e)))
    ((FVO P)
      (let-match erased ok (OkVO _))
      (let-match erased mx (MxVO _ t _ q d))
      (let ((many m) (many tl)) (mk-topl P))
      (let-match erased (top-fn P t m q (topl-top P m tl)) (Refl _ _))
      (let ((many x) (many h) (many rs) (erased i) (erased r) (erased ss) (erased g) (erased lc) (erased st) (erased pd) (erased lt)) (odd-head m s n d bn))
      (let ((many w) (erased b)) (blk-run P rs m tl lt))
      (let-match many w (Cons _ y w1) (absurd (Nil _) b))
      (let ((many D) (many T) (erased g2)) (dgv-run y w1))
      (let ((many X) (erased e)) (enc-run (Cons (Nat) n2 (Cons (Nat) h D))))
      (values X T (PhVO P s T x h w D X (BlS P m s i r rs x w ss (topl-top P m tl) g lc st b) pd g2 e)))))

(def-fns _ $ (many maxs-run : (many (Fam) F) -> (many (Nat) n) (erased (MaxS F n) mx))
  (match many F _
    ((FE P T) (let ((many t) (many tl)) (mk-topl P)) (values t (MxE P t T (topl-top P t tl))))
    ((FO P T)
      (let ((many t) (many tl)) (mk-topl P))
      (let ((many n) (erased d)) (double (Succ t)))
      (values n (MxO P t n T (topl-top P t tl) d)))
    ((FVE P) (let ((many t) (many tl)) (mk-topl P)) (values t (MxVE P t (topl-top P t tl))))
    ((FVO P)
      (let ((many t) (many tl)) (mk-topl P))
      (let ((many n) (erased d)) (double (Succ t)))
      (values n (MxVO P t n (topl-top P t tl) d)))))
