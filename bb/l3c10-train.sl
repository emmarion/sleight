(def-fns _ $ (many f-ident : (many (Rq) e) (many (LmR e) lm) -> (many (FRs e) res))
  (let-match many (ident-lm e lm) (IdtOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc k w Z U rk) ((IdtNo _) (FNo e)))
  (f-apply e lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc k w Z U rk))

(def-fns _ $ (many f-sweep3 : (many (Rq) e) -> (many (FRs e) res))
  (let ((many no)) (FNo e))
  (let-match many e (MkRq q L h R))
  (let-match many (eq-nat q 1) (ESome _ eq) ((ENone _) no))
  (let-match erased eq (Refl _ _))
  (let-match many h (BFalse) ((BTrue) no))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let-match many (sw3 L l dl R r dr) (S3Ok _ _ lo r1 zz L2 d2 g1 R1 dr1 pz w) ((S3No _ _) no))
  (let ((many R2) (erased y) (erased py) (erased d3)) (pushr (BFalse) g1 R1 r1 dr1))
  (let-match erased (rp-fn (BFalse) g1 r1 y zz py pz) (Refl _ _))
  (def-fns LF $ (erased pf : (erased (List (Bool)) X) (erased (Conf) c) (erased (Dx e X c) dx)
      -> (erased (Conf) a c2) (erased (Nat) t) (erased (Run l3 c t a) run) (erased (Dx (MkRq 1 L2 (BFalse) R2) X c2) dx2) (erased (CEz c2 a) z))
    (let-match erased dx (MkDx _ _ _ _ la ra _ rx dla dra cx))
    (let-match erased (den-fn L l la dl dla) (Refl _ _))
    (let-match erased (den-fn R r ra dr dra) (Refl _ _))
    (let ((erased zX) (erased czX) (erased g)) (s3-go l r lo zz w X rx cx))
    (let ((erased t) (erased run)) (go-run 1 1 l rx lo zX (BFalse) (BFalse) g))
    (let ((erased a)) (MkConf 1 lo (BFalse) zX))
    (values a a t run (MkDx 1 L2 R2 (BFalse) lo y X zX d2 d3 czX) (cez-refl a)))
  (FOk e (MkRq 1 L2 (BFalse) R2) (MkFR e _ pf)))

(def-fns _ $ (many fm-move : (many (Rq) e) -> (many (FRs e) res))
  (let-match many e (MkRq q L h R))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let ((many lm)) (c-lm e (MkConf q l h r) (MkDc q L R h l r dl dr)))
  (let-match many (f-jump e lm) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-round e lm) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-walk e) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-mac e) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-ident e lm) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (let-match many (f-sweep3 e) (FNo _) ((FOk _ e2 p) (FOk e e2 p)))
  (f-step e))

(def-fns _ $ (many fm-run : (subterm many (Nat) fuel) (erased (Rq) e0) (many (Rq) e) (erased (FSq e0 e) s) (many (Rq) tgt) -> (many (ErasedMaybe (FSq e0 tgt)) r))
  (let-match many (rq-eq e tgt) (ENone _) ((ESome _ eq) (let-match erased eq (Refl _ _)) (ESome _ s)))
  (let-match many fuel (Succ f) ((Zero) (ENone _)))
  (let-match many (fm-move e) (FOk _ e2 p) ((FNo _) (ENone _)))
  (tail $ fm-run f e0 e2 (FsC e0 e e2 s p) tgt))

(def-fns _ $ (many cut-cert : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Nat) fuel) (many (Rq) t) (many (List (Rn)) S) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many e (MkRq q L h R))
  (let-match many t (MkRq tq tL th tR))
  (let-match many (find-at R S 0) (Some _ i1) ((None _) no))
  (let-match many (find-at tR S 0) (Some _ j1) ((None _) no))
  (let-match many i1 (Succ i) ((Zero) no))
  (let-match many j1 (Succ j) ((Zero) no))
  (let-match many (run-at i R) (Some _ rg) ((None _) no))
  (let-match many (run-at j tR) (Some _ rg2) ((None _) no))
  (let-match many rg (MkRn bg G))
  (let-match many rg2 (MkRn bg2 G2))
  (let-match many bg (BFalse) ((BTrue) no))
  (let-match many bg2 (BFalse) ((BTrue) no))
  (let-match many (nle G2 G) (BTrue) ((BFalse) no))
  (let ((many ein)) (MkRq q L h (rtake-g i R (Succ (monus G G2)))))
  (let ((many eo)) (MkRq tq tL th (rtake-g j tR 1)))
  (let-match many (fm-run fuel ein ein (FsN ein) eo) (ESome _ s) ((ENone _) no))
  (rs-normpre c0 (Succ j) (frame-one (MkFE ein eo s) c0 e ch)))

(def-fns _ $ (many train-f : (many (Bool) g1) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many (train-tgt-s g1 c0 e ch) (TgOk t S) ((TgNo) (RsNo l3 c0 e ch)))
  (let-match many (cut-cert c0 e ch 1000000 t S) (RsNo _ _ _ _) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (r-run 1000000 c0 e ch t))

(def-fns _ $ (many try-train3 : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (train-f (BFalse) c0 e ch))

(def-fns _ $ (many try-traing3 : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (train-f (BTrue) c0 e ch))

(def-fns _ $ (many c10-ent-t : (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Rs l3 c0) res))
  (let-match many (nat-eq i 15) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-train3 c0 e ch)))
  (let-match many (nat-eq i 16) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-traing3 c0 e ch)))
  (c10-ent-f i c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-scan-t : (subterm many (Nat) n) (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Nat) j) (many (Rs l3 c0) res))
  (let ((many r)) (fired c0 e ch (c10-ent-t i c0 e ch lm lc mp rho)))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values i r)))
  (let-match many n (Succ m1) ((Zero) (values i r)))
  (tail $ c10-scan-t m1 (Succ i) c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-move-t : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) idx) (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let ((many lm)) (c-lm e c dc))
  (let ((many lc)) (lc-of e lm))
  (let ((many j0) (many r0)) (c10-big c0 e ch lm))
  (let-match many r0 (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j0 r0)))
  (let ((many j) (many r)) (c10-scan-t 2 2 c0 e ch lm lc (None _) 0))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j r)))
  (let ((many mp) (many rho)) (fe-of lc))
  (c10-scan-t 21 5 c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-run4 : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) left) (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values fuel e ch)))
  (let ((many _) (many r)) (c10-move-t c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values fuel e1 ch1)))
  (tail $ c10-run4 c0 f e1 ch1))
