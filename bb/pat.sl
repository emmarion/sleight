    ((PoE)
      (let-match erased e (ENil _))
      (let-match erased pp (PullCons _ _) ((PullNil) (values (Refl _ h2) (MkSI s S2 x2 L e (eqz-refl L)))))
      (let-match erased z (EZ _ _ za zb))
      (let-match erased za (ZC _ z1))
      (values (Refl _ h2) (MkSI s S2 x2 L e (EZ x2 L z1 zb))))
    ((PoW _ w S1)
      (let-match erased e (ECons _ _ _ d L1 _ id e1 c))
      (let-match erased id (IDW _ _))
      (let-match erased c (CatC _ _ _ _ m c1))
      (let ((erased e2)) (ECons s (IW w) S1 w L1 m (IDW s w) e1 c1))
      (match erased z _
