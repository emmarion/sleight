      (match erased o (((False) f))
        ((InL _ _ i0) (pat-go ps p m c n hs Pz s kz ac ex i0))
        ((InR _ _ i1) (pat-go ps p m c n hs Ps s2 ks ac ex i1))))
    ((ClLeaf _ _ q q2 j h b w d L R X Y X2 L2 R2 T t pl o1 po o2 nt mt)
      (let-match erased ip (MkIn _ _ _ _ _ l r il ir))
      (let ((erased lk0)) (ext-look p m q h _ ex pl))
      (let-match erased hs (HMove _ _ c2 n1 st rest) ((HStop _ _ _ _ _ lk) (match erased (look-fn m q h _ _ lk lk0) (((False) f)))))
      (let ((erased w2) (erased d2) (erased q3) (erased x) (erased y) (erased x2) (erased l2) (erased r2) (erased h2) (erased lk) (erased sc) (erased pp) (erased sc2) (erased e))
        (stp-view m q l r h c2 st))
      (let-match erased (look-fn m q h _ _ lk lk0) (Refl _ _))
      (let-match erased e (Refl _ _))
      (let ((erased ix) (erased iy)) (side-fwd d L R X Y l r x y s o1 sc il ir))
      (let ((erased eb) (erased ix2)) (pop-ok s X X2 b h2 x x2 po ix pp))
      (let-match erased eb (Refl _ _))
      (let ((erased il2) (erased ir2)) (side-bwd d L2 R2 X2 _ l2 r2 x2 _ s o2 sc2 ix2 (push-in s Y w y iy)))
      (let ((erased s3) (erased it)) (match-ok _ T t s _ mt (MkIn s q2 L2 R2 b l2 r2 il2 ir2)))
      (pat-go ps p m _ n1 rest T s3 (allcl-nth ps ps p j T ac nt) ac ex it))))

(def-fns _ $ (erased absurd never-pat : (erased (List (PT)) p) (erased (List (Tr)) m) (erased (PatOK p) po) (erased (Ext p m) ex)
    (erased (Nat) s) (erased (HaltsAt m (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) s) hs) -> (erased (False) f))
