(def-fns _ $ (erased side-bwd : (erased (Mv) d) (erased (List (It)) L R X Y) (erased (List (Bool)) l r x y) (erased (List (Nat)) s)
    (erased (Ori (List (It)) d L R X Y) sd) (erased (Ori (List (Bool)) d l r x y) sc) (erased (SdIn s X x) ix) (erased (SdIn s Y y) iy)
