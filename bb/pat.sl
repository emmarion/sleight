  (MkSI s _ _ (Cons (Bool) w L) (ECons s _ S _ L _ (IDW s _) e (CatC (Bool) w (Nil (Bool)) L L (CatN (Bool) L))) (EC w y L z)))

(def-fns _ $ (erased side-fwd : (erased (Mv) d) (erased (List (It)) L R X Y) (erased (List (Bool)) l r x y) (erased (List (Nat)) s)
    (erased (Ori (List (It)) d L R X Y) sd) (erased (Ori (List (Bool)) d l r x y) sc) (erased (SdIn s L l) il) (erased (SdIn s R r) ir)
