    (many AlCons : (erased (List (Pat)) ps) (erased (List (PT)) p) (erased (Pat) P) (erased (List (Pat)) qs) (erased (Cl ps p P) k) (erased (AllCl ps p qs) a)
       -> (AllCl ps p (Cons (Pat) P qs)))))

(def-adts
