      (pop-ok s S1 S2 b h2 x x2 po1 (MkSI s S1 x L e1 z) pp))))

(def-fns _ $ (erased push-in : (erased (List (Nat)) s) (erased (List (It)) S) (erased (Bool) w) (erased (List (Bool)) y) (erased (SdIn s S y) si)
