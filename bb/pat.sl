(def-fns _ $ (erased absurd pat-go : (erased (List (Pat)) ps) (erased (List (PT)) p) (erased (List (Tr)) m) (erased (Conf) c) (erased (Nat) n)
    (subterm erased (HaltsAt m c n) hs) (erased (Pat) P) (erased (List (Nat)) s) (subterm erased (Cl ps p P) cl) (erased (AllCl ps p ps) ac)
    (erased (Ext p m) ex) (erased (In s P c) ip) -> (erased (False) f))
