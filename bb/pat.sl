  (pat-go ps p m _ s hs T s2 (allcl-nth ps ps p j T ac nt) ac ex it))

(def-fns _ $ (many eq-bl : (subterm many (List (Bool)) a) (many (List (Bool)) b) -> (many (Maybe (Eq (List (Bool)) a b)) r))
  (let-match many a (Cons _ x xs) ((Nil _) (match many b _ ((Nil _) (Some _ (Refl _ a))) ((Cons _ _ _) (None _)))))
  (let-match many b (Cons _ y ys) ((Nil _) (None _)))
  (let-match many (eq-bit x y) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (notail $ eq-bl xs ys) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl _ a)))

(def-fns _ $ (many eq-it : (many (It) a) (many (It) b) -> (many (Maybe (Eq (It) a b)) r))
  (match many a _
    ((IW w)
      (let-match many b (IW w2) ((IP _ _) (None _)))
      (let-match many (eq-bl w w2) (Some _ e) ((None _) (None _)))
      (let-match erased e (Refl _ _))
      (Some _ (Refl _ a)))
    ((IP w v)
      (let-match many b (IP w2 v2) ((IW _) (None _)))
      (let-match many (eq-bl w w2) (Some _ e) ((None _) (None _)))
      (let-match erased e (Refl _ _))
      (let-match many (eq-nat v v2) (Some _ e2) ((None _) (None _)))
      (let-match erased e2 (Refl _ _))
      (Some _ (Refl _ a)))))

(def-fns _ $ (many eq-its : (subterm many (List (It)) a) (many (List (It)) b) -> (many (Maybe (Eq (List (It)) a b)) r))
  (let-match many a (Cons _ x xs) ((Nil _) (match many b _ ((Nil _) (Some _ (Refl _ a))) ((Cons _ _ _) (None _)))))
  (let-match many b (Cons _ y ys) ((Nil _) (None _)))
  (let-match many (eq-it x y) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (notail $ eq-its xs ys) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl _ a)))

(def-fns _ $ (many zeros-of : (subterm many (List (Bool)) w) -> (many (Res (Zeros w)) r))
  (let-match many w (Cons _ x w1) ((Nil _) (ROk _ (ZN))))
  (let-match many x (BFalse) ((BTrue) (RFail _)))
  (let-match many (notail $ zeros-of w1) (ROk _ z) ((RFail _) (RFail _)))
  (ROk _ (ZC w1 z)))

(def-fns _ $ (many iwd-of : (many (It) i) -> (many (List (Bool)) w) (erased (IWd i w) iw))
  (match many i _ ((IW w) (values w (WdW w))) ((IP w v) (values w (WdP w v)))))

(def-adts
  ((Unsn : ((List (Bool)) w) -> Type)
    enum
    (many SnOk : (erased (List (Bool)) w) (many (List (Bool)) xs) (many (Bool) x) (erased (Cat (Bool) xs (Cons (Bool) x (Nil (Bool))) w) c) -> (Unsn w))
    (many SnNo : (erased (List (Bool)) w) -> (Unsn w))))

(def-fns _ $ (many unsnoc : (subterm many (List (Bool)) w) -> (many (Unsn w) r))
  (let-match many w (Cons _ a w1) ((Nil _) (SnNo w)))
  (let-match many w1 (Cons _ _ _) ((Nil _) (SnOk w (Nil (Bool)) a (CatN (Bool) w))))
  (let-match many (notail $ unsnoc w1) (SnOk _ xs x c) ((SnNo _) (SnNo w)))
  (SnOk w (Cons (Bool) a xs) x (CatC (Bool) a xs (Cons (Bool) x (Nil (Bool))) w1 c)))

(def-adts
  ((RwR : ((List (It)) S) -> Type)
    enum
    (many RwGot : (erased (List (It)) S) (many (List (It)) S2) (erased (Rw S S2) r) -> (RwR S))
    (many RwNone : (erased (List (It)) S) -> (RwR S))))

(def-fns _ $ (many rw-or : (erased (List (It)) S) (many (RwR S) a b) -> (many (RwR S) r))
  (match many a _ ((RwGot _ _ _) a) ((RwNone _) b)))

(def-fns _ $ (many rw-front : (many (List (It)) S) -> (many (RwR S) r))
  (let-match many S (Cons _ i rest) ((Nil _) (RwNone S)))
  (let ((many w) (erased iw)) (iwd-of i))
  (let ((many re))
    (match many w (((RwR S) r))
      ((Nil _) (RwGot S rest (RwE i rest iw)))
      ((Cons _ _ _)
        (let-match many rest (Nil _) ((Cons _ _ _) (RwNone S)))
        (match many (zeros-of w) _ ((ROk _ z) (RwGot S rest (RwT i w iw z))) ((RFail _) (RwNone S))))))
  (let ((many rs))
    (match many i (((RwR S) r))
      ((IW w0)
        (let-match many w0 (Cons _ b w1) ((Nil _) (RwNone S)))
        (let-match many w1 (Nil _) ((Cons _ c w2) (RwGot S (Cons _ (IW (Cons _ b (Nil _))) (Cons _ (IW w1) rest)) (RwS b c w2 rest))))
        (let-match many rest (Cons _ j rest2) ((Nil _) (RwNone S)))
        (let-match many j (IP w3 v) ((IW _) (RwNone S)))
        (let-match many (unsnoc w3) (SnOk _ xs y c) ((SnNo _) (RwNone S)))
        (let-match many (eq-bit y b) (Some _ e) ((None _) (RwNone S)))
        (let-match erased e (Refl _ _))
        (RwGot S (Cons _ (IP (Cons _ b xs) v) (Cons _ i rest2)) (RwRot b xs w3 v rest2 c)))
      ((IP w0 u)
        (let-match many rest (Cons _ j rest2) ((Nil _) (RwNone S)))
        (let-match many j (IP w3 v) ((IW _) (RwNone S)))
        (let-match many (eq-bl w0 w3) (Some _ e) ((None _) (RwNone S)))
        (let-match erased e (Refl _ _))
        (let-match many (lt-dec v u) (Yes _ _ _ _ _) ((No _ _ _ _ _) (RwNone S)))
        (RwGot S (Cons _ j (Cons _ i rest2)) (RwCom w0 u v rest2)))))
  (rw-or S re rs))

(def-fns _ $ (many rw-find : (subterm many (List (It)) S) -> (many (RwR S) r))
  (let-match many (rw-front S) (RwNone _) ((RwGot _ S2 r) (RwGot S S2 r)))
  (let-match many S (Cons _ i rest) ((Nil _) (RwNone S)))
  (let-match many (notail $ rw-find rest) (RwGot _ S2 r) ((RwNone _) (RwNone S)))
  (RwGot S (Cons _ i S2) (RwC i rest S2 r)))

(def-fns _ $ (many norm : (subterm many (Nat) fuel) (many (List (It)) S) -> (many (List (It)) Nm) (erased (Nrm S Nm) n))
  (let-match many fuel (Succ f) ((Zero) (values S (NRefl S))))
  (let-match many (rw-find S) (RwGot _ S1 r) ((RwNone _) (values S (NRefl S))))
  (let ((many Nm) (erased n)) (tail $ norm f S1))
  (values Nm (NStep S S1 Nm r n)))

(def-fns _ $ (many cut-of : (many (Bool) f) (many (Nat) v) (subterm many (List (It)) S) -> (many (List (It)) S2) (erased (Cut f v S S2) c))
  (let-match many S (Cons _ i rest) ((Nil _) (values (Nil (It)) (CuN f v))))
  (let ((many S3) (erased c)) (notail $ cut-of f v rest))
  (let-match many i (IP w u) ((IW w) (values (Cons _ i S3) (CuW f v w rest S3 c))))
  (let-match many (nat-eq u v) (Equal _ _ _) ((Unequal _ _ _ _ ap) (values (Cons _ i S3) (CuK f u v w rest S3 ap c))))
  (match many f _
    ((BFalse) (values S3 (Cu0 v w rest S3 c)))
    ((BTrue) (values (Cons _ (IW w) (Cons _ i S3)) (Cu1 v w rest S3 c)))))

(def-fns _ $ (many cutp-of : (many (Bool) f) (many (Nat) v) (many (Pat) P) -> (many (Pat) Pb) (erased (CutP f v P Pb) c))
  (let-match many P (MkPat q L h R))
  (let ((many L2) (erased cl)) (cut-of f v L))
  (let ((many R2) (erased cr)) (cut-of f v R))
  (values (MkPat q L2 h R2) (MkCP f v q L R L2 R2 h cl cr)))

(def-fns _ $ (many nthor-of : (erased Type A) (many A d) (subterm many (List A) xs) (many (Nat) i) -> (many A x) (erased (NthOr A d xs i x) p))
  (let-match many xs (Cons _ a rest) ((Nil _) (values d (NOEnd A d i))))
  (let-match many i (Succ i1) ((Zero) (values a (NOHere A d a rest))))
  (let ((many x) (erased p)) (tail $ nthor-of A d rest i1))
  (values x (NOThere A d x a rest i1 p)))

(def-fns _ $ (many suba-of : (many (List (Bool)) w) (subterm many (List (At)) as) (many (List (It)) S) -> (many (List (It)) S2) (erased (SubA w as S S2) p))
  (let-match many as (Cons _ a as1) ((Nil _) (values S (SANil w S))))
  (let ((many S3) (erased p)) (notail $ suba-of w as1 S))
  (match many a _
    ((AOne) (values (Cons _ (IW w) S3) (SAOne w as1 S S3 p)))
    ((AVar u) (values (Cons _ (IP w u) S3) (SAVar w u as1 S S3 p)))))

(def-fns _ $ (many subs-of : (many (List (List (At))) t) (subterm many (List (It)) S) -> (many (List (It)) S2) (erased (SubS t S S2) p))
  (let-match many S (Cons _ i rest) ((Nil _) (values (Nil (It)) (SSNil t))))
  (let ((many S1) (erased p)) (notail $ subs-of t rest))
  (let-match many i (IP w v) ((IW w) (values (Cons _ i S1) (SSW t w rest S1 p))))
  (let ((many as) (erased nt)) (nthor-of _ (Nil (At)) t v))
  (let ((many S2) (erased sa)) (suba-of w as S1))
  (values S2 (SSP t w v as rest S1 S2 nt p sa)))

(def-adts
  ((PopR : ((List (It)) S) -> Type)
    enum
    (many PRGot : (erased (List (It)) S) (many (Bool) b) (many (List (It)) S2) (erased (PPop S b S2) po) -> (PopR S))
    (many PRVar : (erased (List (It)) S) (many (Nat) v) -> (PopR S))))

(def-fns _ $ (many pop-skip : (erased (It) i) (erased (List (It)) S) (erased (IWd i (Nil (Bool))) iw) (many (PopR S) r) -> (many (PopR (Cons (It) i S)) r2))
  (match many r _
    ((PRGot _ b S2 po) (PRGot _ b S2 (PoS i S S2 b iw po)))
    ((PRVar _ v) (PRVar _ v))))

(def-fns _ $ (many pop-of : (subterm many (List (It)) S) -> (many (PopR S) r))
  (let-match many S (Cons _ i rest) ((Nil _) (PRGot S (BFalse) (Nil (It)) (PoE))))
  (match many i _
    ((IW w)
      (let-match many w (Cons _ b w1) ((Nil _) (pop-skip i rest (WdW w) (notail $ pop-of rest))))
      (PRGot S b (Cons _ (IW w1) rest) (PoW b w1 rest)))
    ((IP w v)
      (let-match many w (Cons _ _ _) ((Nil _) (pop-skip i rest (WdP w v) (notail $ pop-of rest))))
      (PRVar S v))))

(def-fns _ $ (many ori-of : (erased Type A) (many (Mv) d) (many A l r) -> (many A x y) (erased (Ori A d l r x y) o))
  (match many d _ ((DL) (values l r (OrL A l r))) ((DR) (values r l (OrR A l r)))))

(def-fns _ $ (many ori-mk : (erased Type A) (many (Mv) d) (many A x y) -> (many A l r) (erased (Ori A d l r x y) o))
  (match many d _ ((DL) (values x y (OrL A x y))) ((DR) (values y x (OrR A y x)))))

(def-fns _ $ (many nth-r : (erased Type A) (subterm many (List A) xs) (many (Nat) i) -> (many (NthR A xs i) r))
  (let-match many xs (Cons _ a rest) ((Nil _) (NNo A xs i)))
  (let-match many i (Succ i1) ((Zero) (NOk A xs i a (NthHere A a rest))))
  (let-match many (notail $ nth-r A rest i1) (NOk _ _ _ x p) ((NNo _ _ _) (NNo A xs i)))
  (NOk A xs i x (NthThere A a rest i1 x p)))

(def-fns _ $ (many side-of : (many (List (List (At))) t) (many (List (It)) Q T) -> (many (Res (SideOK t Q T)) r))
  (let ((many T2) (erased ss)) (subs-of t T))
  (let ((many Na) (erased nq)) (norm 4000 Q))
  (let ((many Nb) (erased nt)) (norm 4000 T2))
  (let-match many (eq-its Na Nb) (Some _ e) ((None _) (RFail _)))
  (let-match erased e (Refl _ _))
  (ROk _ (MkSO t Q T T2 Na ss nq nt)))

(def-fns _ $ (many match-of : (many (Pat) Q T) (many (List (List (At))) t) -> (many (Res (Match Q T t)) r))
  (let-match many Q (MkPat q L h R))
  (let-match many T (MkPat q2 TL h2 TR))
  (let-match many (eq-nat q q2) (Some _ e1) ((None _) (RFail _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (eq-bit h h2) (Some _ e2) ((None _) (RFail _)))
  (let-match erased e2 (Refl _ _))
  (let-match many (side-of t L TL) (ROk _ ml) ((RFail _) (RFail _)))
  (let-match many (side-of t R TR) (ROk _ mr) ((RFail _) (RFail _)))
  (ROk _ (MkMatch q h L R TL TR t ml mr)))

(def-adts $ (PTree : -> Type)
  enum
  (many PTCut : (many (PTree) a b) -> (PTree))
  (many PTLeaf : (many (Nat) j) (many (List (List (At))) t) -> (PTree)))

(def-fns _ $ (many check-cl : (many (List (PT)) p) (many (List (Pat)) ps) (many (Pat) P) (subterm many (PTree) tr) -> (many (Res (Cl ps p P)) r))
  (let-match many P (MkPat q L h R))
  (let-match many (plook p q h) (PLOk _ _ _ x pl) ((PLNo _ _ _) (RFail _)))
  (let-match many x (Def tt) ((Undef) (RFail _)))
  (let-match many tt (Mov w d q2) ((Hlt) (RFail _)))
  (let ((many X) (many Y) (erased o1)) (ori-of _ d L R))
  (match many tr _
    ((PTCut a b)
      (let-match many (pop-of X) (PRVar _ v) ((PRGot _ _ _ _) (RFail _)))
      (let ((many Pz) (erased c0)) (cutp-of (BFalse) v P))
      (let ((many Ps) (erased c1)) (cutp-of (BTrue) v P))
      (let-match many (notail $ check-cl p ps Pz a) (ROk _ kz) ((RFail _) (RFail _)))
      (let-match many (notail $ check-cl p ps Ps b) (ROk _ ks) ((RFail _) (RFail _)))
      (ROk _ (ClCut ps p P Pz Ps v c0 c1 kz ks)))
    ((PTLeaf j t)
      (let-match many (pop-of X) (PRGot _ b X2 po) ((PRVar _ _) (RFail _)))
      (let ((many L2) (many R2) (erased o2)) (ori-mk _ d X2 (Cons _ (IW (Cons _ w (Nil _))) Y)))
      (let-match many (nth-r _ ps j) (NOk _ _ _ T nt) ((NNo _ _ _) (RFail _)))
      (let-match many (match-of (MkPat q2 L2 b R2) T t) (ROk _ mt) ((RFail _) (RFail _)))
      (ROk _ (ClLeaf ps p q q2 j h b w d L R X Y X2 L2 R2 T t pl o1 po o2 nt mt)))))

(def-fns _ $ (many check-cls : (many (List (PT)) p) (many (List (Pat)) ps) (subterm many (List (Pat)) qs) (many (List (PTree)) trs) -> (many (Res (AllCl ps p qs)) r))
  (let-match many qs (Cons _ P qs1) ((Nil _) (ROk _ (AlNil ps p))))
  (let-match many trs (Cons _ tr trs1) ((Nil _) (RFail _)))
  (let-match many (check-cl p ps P tr) (ROk _ k) ((RFail _) (RFail _)))
  (let-match many (notail $ check-cls p ps qs1 trs1) (ROk _ a) ((RFail _) (RFail _)))
  (ROk _ (AlCons ps p P qs1 k a)))

(def-adts $ (PatCert : -> Type)
  enum
  (many MkPC : (many (List (Pat)) ps) (many (Nat) j) (many (List (List (At))) t) (many (List (PTree)) trs) -> (PatCert)))

(def-fns _ $ (many check-pat : (many (List (PT)) p) (many (PatCert) ct) -> (many (Res (PatOK p)) r))
  (let-match many ct (MkPC ps j t trs))
  (let-match many (check-cls p ps ps trs) (ROk _ ac) ((RFail _) (RFail _)))
  (let-match many (nth-r _ ps j) (NOk _ _ _ T nt) ((NNo _ _ _) (RFail _)))
  (let-match many (match-of (MkPat (Zero) (Nil (It)) (BFalse) (Nil (It))) T t) (ROk _ mt) ((RFail _) (RFail _)))
  (ROk _ (MkPatOK p ps j T t ac nt mt)))

(def-fns _ $ (many nums-go : (subterm many (Nat) fuel) (many (String) s) (many (Nat) acc) (many (Bool) inn) -> (many (List (Nat)) r))
  (let-match many fuel (Succ f) ((Zero) (Nil _)))
  (let-match many s (SCons c rest) ((SNil) (match many inn _ ((BTrue) (Cons _ acc (Nil _))) ((BFalse) (Nil _)))))
  (let-match many (ch-is c #\space) (BFalse)
    ((BTrue) (match many inn _ ((BTrue) (Cons _ acc (notail $ nums-go f rest 0 (BFalse)))) ((BFalse) (tail $ nums-go f rest 0 (BFalse))))))
  (let ((many a10) (erased _)) (mul acc 10))
  (let ((many a2) (erased _)) (add a10 (dig c)))
  (tail $ nums-go f rest a2 (BTrue)))

(def-fns _ $ (many d-bits : (subterm many (Nat) n) (many (List (Nat)) xs) -> (many (List (Bool)) v) (many (List (Nat)) rest))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs)))
  (let-match many xs (Cons _ k xs1) ((Nil _) (values (Nil _) xs)))
  (let ((many bs) (many rest)) (notail $ d-bits n1 xs1))
  (values (Cons _ (match many k (((Bool) b)) ((Zero) (BFalse)) ((Succ _) (BTrue))) bs) rest))

(def-fns _ $ (many d-items : (subterm many (Nat) n) (many (List (Nat)) xs) -> (many (List (It)) v) (many (List (Nat)) rest))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs)))
  (let-match many xs (Cons _ k xs1) ((Nil _) (values (Nil _) xs)))
  (let ((many it) (many xs2))
    (match many k (((It) i) ((List (Nat)) r))
      ((Zero) (values (IW (Cons _ (BFalse) (Nil _))) xs1))
      ((Succ kk)
        (let-match many kk (Succ _) ((Zero) (values (IW (Cons _ (BTrue) (Nil _))) xs1)))
        (let-match many xs1 (Cons _ len xs3) ((Nil _) (values (IW (Nil _)) xs1)))
        (let ((many w) (many xs4)) (d-bits len xs3))
        (let-match many xs4 (Cons _ v xs5) ((Nil _) (values (IW (Nil _)) xs4)))
        (values (IP w v) xs5))))
  (let ((many its) (many rest)) (notail $ d-items n1 xs2))
  (values (Cons _ it its) rest))

(def-fns _ $ (many d-pats : (subterm many (Nat) n) (many (List (Nat)) xs) -> (many (List (Pat)) v) (many (List (Nat)) rest))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs)))
  (let-match many xs (Cons _ q xs1) ((Nil _) (values (Nil _) xs)))
  (let-match many xs1 (Cons _ h xs2) ((Nil _) (values (Nil _) xs)))
  (let-match many xs2 (Cons _ nl xs3) ((Nil _) (values (Nil _) xs)))
  (let ((many L) (many xs4)) (d-items nl xs3))
  (let-match many xs4 (Cons _ nr xs5) ((Nil _) (values (Nil _) xs)))
  (let ((many R) (many xs6)) (d-items nr xs5))
  (let ((many ps) (many rest)) (notail $ d-pats n1 xs6))
  (values (Cons _ (MkPat q L (match many h (((Bool) b)) ((Zero) (BFalse)) ((Succ _) (BTrue))) R) ps) rest))

(def-fns _ $ (many d-atoms : (subterm many (Nat) n) (many (List (Nat)) xs) -> (many (List (At)) v) (many (List (Nat)) rest))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs)))
  (let-match many xs (Cons _ k xs1) ((Nil _) (values (Nil _) xs)))
  (let ((many as) (many rest)) (notail $ d-atoms n1 xs1))
  (values (Cons _ (match many k (((At) a)) ((Zero) (AOne)) ((Succ v) (AVar v))) as) rest))

(def-fns _ $ (many d-tau : (subterm many (Nat) n) (many (List (Nat)) xs) -> (many (List (List (At))) v) (many (List (Nat)) rest))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs)))
  (let-match many xs (Cons _ k xs1) ((Nil _) (values (Nil _) xs)))
  (let ((many as) (many xs2)) (d-atoms k xs1))
  (let ((many t) (many rest)) (notail $ d-tau n1 xs2))
  (values (Cons _ as t) rest))

(def-fns _ $ (many d-leaf : (many (List (Nat)) xs) -> (many (Nat) j) (many (List (List (At))) t) (many (List (Nat)) rest))
  (let-match many xs (Cons _ j xs1) ((Nil _) (values 0 (Nil _) xs)))
  (let-match many xs1 (Cons _ k xs2) ((Nil _) (values 0 (Nil _) xs)))
  (let ((many t) (many rest)) (d-tau k xs2))
  (values j t rest))

(def-fns _ $ (many d-trees : (subterm many (Nat) fuel) (many (Nat) n) (many (List (Nat)) xs) -> (many (List (PTree)) v) (many (List (Nat)) rest))
  (let-match many fuel (Succ f) ((Zero) (values (Nil _) xs)))
  (let-match many n (Succ n1) ((Zero) (values (Nil _) xs)))
  (let-match many xs (Cons _ k xs1) ((Nil _) (values (Nil _) xs)))
  (let ((many tr) (many xs2))
    (match many k (((PTree) a) ((List (Nat)) r))
      ((Zero)
        (let ((many ab) (many xs3)) (notail $ d-trees f 2 xs1))
        (let-match many ab (Cons _ a ab1) ((Nil _) (values (PTLeaf 0 (Nil _)) xs3)))
        (let-match many ab1 (Cons _ b _) ((Nil _) (values (PTLeaf 0 (Nil _)) xs3)))
        (values (PTCut a b) xs3))
      ((Succ _)
        (let ((many j) (many t) (many xs3)) (d-leaf xs1))
        (values (PTLeaf j t) xs3))))
  (let ((many trs) (many rest)) (notail $ d-trees f n1 xs2))
  (values (Cons _ tr trs) rest))

(def-fns _ $ (many pat-cert : (many (String) s) -> (many (PatCert) ct))
  (let ((many len) (erased _)) (str-length s))
  (let ((many xs)) (nums-go (Succ len) s 0 (BFalse)))
  (let-match many xs (Cons _ np xs1) ((Nil _) (MkPC (Nil _) 0 (Nil _) (Nil _))))
  (let ((many ps) (many xs2)) (d-pats np xs1))
  (let ((many j) (many t) (many xs3)) (d-leaf xs2))
  (let ((many trs) (many _)) (d-trees (Succ len) np xs3))
  (MkPC ps j t trs))
