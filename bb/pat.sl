(def-fns _ $ (erased stp-view : (erased (List (Tr)) m) (erased (Nat) q) (erased (List (Bool)) l r) (erased (Bool) h) (erased (Conf) c2)
    (erased (Stp m (MkConf q l h r) c2) st) -> (erased (Bool) w) (erased (Mv) d) (erased (Nat) q2) (erased (List (Bool)) x y x2 l2 r2) (erased (Bool) h2)
    (erased (Look m q h (Mov w d q2)) lk) (erased (Ori (List (Bool)) d l r x y) sc) (erased (Pull x h2 x2) pp)
    (erased (Ori (List (Bool)) d l2 r2 x2 (Cons (Bool) w y)) sc2) (erased (Eq (Conf) c2 (MkConf q2 l2 h2 r2)) e))
