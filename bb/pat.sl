(def-fns _ $ (erased allcl-nth : (erased (List (Pat)) ps qs) (erased (List (PT)) p) (erased (Nat) j) (erased (Pat) T)
    (erased (AllCl ps p qs) ac) (subterm erased (Nth (Pat) qs j T) nt) -> (erased (Cl ps p T) k))
  (let-match erased ac (AlCons _ _ _ qs1 k ac1) ((AlNil _ _) (match erased nt _)))
