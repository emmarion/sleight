(def-adts $ (It : -> Type)
  enum
  (many IW : (many (List (Bool)) w) -> (It))
  (many IP : (many (List (Bool)) w) (many (Nat) v) -> (It)))

(def-adts
  ((NthOr : (Type A) (A d) ((List A) xs) ((Nat) i) (A x) -> Type)
    enum
    (many NOEnd : (erased Type A) (erased A d) (erased (Nat) i) -> (NthOr A d (Nil A) i d))
    (many NOHere : (erased Type A) (erased A d x) (erased (List A) xs) -> (NthOr A d (Cons A x xs) (Zero) x))
    (many NOThere : (erased Type A) (erased A d x y) (erased (List A) xs) (erased (Nat) i) (erased (NthOr A d xs i x) p)
       -> (NthOr A d (Cons A y xs) (Succ i) x))))

(def-adts
  ((RepL : ((List (Bool)) w) ((Nat) n) ((List (Bool)) r) -> Type)
    enum
    (many RZ : (erased (List (Bool)) w) -> (RepL w (Zero) (Nil (Bool))))
    (many RS : (erased (List (Bool)) w r1 r) (erased (Nat) n) (erased (RepL w n r1) p) (erased (Cat (Bool) w r1 r) c)
       -> (RepL w (Succ n) r))))

(def-adts
  ((IDen : ((List (Nat)) s) ((It) i) ((List (Bool)) d) -> Type)
    enum
    (many IDW : (erased (List (Nat)) s) (erased (List (Bool)) w) -> (IDen s (IW w) w))
    (many IDP : (erased (List (Nat)) s) (erased (List (Bool)) w r) (erased (Nat) v n) (erased (NthOr (Nat) (Zero) s v n) nv)
       (erased (RepL w n r) rp) -> (IDen s (IP w v) r))))

(def-adts
  ((Exp : ((List (Nat)) s) ((List (It)) S) ((List (Bool)) L) -> Type)
    enum
    (many ENil : (erased (List (Nat)) s) -> (Exp s (Nil (It)) (Nil (Bool))))
    (many ECons : (erased (List (Nat)) s) (erased (It) i) (erased (List (It)) S) (erased (List (Bool)) d L1 L)
       (erased (IDen s i d) id) (erased (Exp s S L1) e) (erased (Cat (Bool) d L1 L) c) -> (Exp s (Cons (It) i S) L))))

(def-adts
  ((Zeros : ((List (Bool)) l) -> Type)
    enum
    (many ZN : -> (Zeros (Nil (Bool))))
    (many ZC : (erased (List (Bool)) l) (erased (Zeros l) z) -> (Zeros (Cons (Bool) (BFalse) l)))))

(def-adts
  ((Eqz : ((List (Bool)) a) ((List (Bool)) b) -> Type)
    enum
    (many EZ : (erased (List (Bool)) a b) (erased (Zeros a) za) (erased (Zeros b) zb) -> (Eqz a b))
    (many EC : (erased (Bool) x) (erased (List (Bool)) a b) (erased (Eqz a b) e) -> (Eqz (Cons (Bool) x a) (Cons (Bool) x b)))))

(def-fns _ $ (erased cat-fn : (erased Type A) (erased (List A) x y z z2) (subterm erased (Cat A x y z) c) (erased (Cat A x y z2) c2)
    -> (erased (Eq (List A) z z2) e))
  (let-match erased c (CatC _ a xs _ zs c1) ((CatN _ _) (let-match erased c2 (CatN _ _)) (Refl _ z)))
  (let-match erased c2 (CatC _ _ _ _ zs2 c3))
  (let-match erased (cat-fn A xs y zs zs2 c1 c3) (Refl _ _))
  (Refl _ z))

(def-fns _ $ (erased cat-ex : (erased Type A) (subterm erased (List A) x) (erased (List A) y) -> (erased (List A) z) (erased (Cat A x y z) c))
  (let-match erased x (Cons _ a xs) ((Nil _) (values y (CatN A y))))
  (let ((erased zs) (erased c)) (cat-ex A xs y))
  (values (Cons A a zs) (CatC A a xs y zs c)))

(def-fns _ $ (erased cat-nil : (erased Type A) (erased (List A) x z) (subterm erased (Cat A x (Nil A) z) c) -> (erased (Eq (List A) z x) e))
  (let-match erased c (CatC _ a xs _ zs c1) ((CatN _ _) (Refl _ z)))
  (let-match erased (cat-nil A xs zs c1) (Refl _ _))
  (Refl _ z))

(def-fns _ $ (erased nthor-fn : (erased Type A) (erased A d) (erased (List A) xs) (erased (Nat) i) (erased A x y)
    (subterm erased (NthOr A d xs i x) p) (erased (NthOr A d xs i y) q) -> (erased (Eq A x y) e))
  (match erased p _
    ((NOEnd _ _ _) (let-match erased q (NOEnd _ _ _)) (Refl _ x))
    ((NOHere _ _ _ _) (let-match erased q (NOHere _ _ _ _)) (Refl _ x))
    ((NOThere _ _ _ b rest k p1)
      (let-match erased q (NOThere _ _ _ _ _ _ q1))
      (nthor-fn A d rest k x y p1 q1))))

(def-fns _ $ (erased nthor-ex : (erased Type A) (erased A d) (subterm erased (List A) xs) (erased (Nat) i) -> (erased A x) (erased (NthOr A d xs i x) p))
  (let-match erased xs (Cons _ a rest) ((Nil _) (values d (NOEnd A d i))))
  (let-match erased i (Succ i1) ((Zero) (values a (NOHere A d a rest))))
  (let ((erased x) (erased p)) (nthor-ex A d rest i1))
  (values x (NOThere A d x a rest i1 p)))

(def-fns _ $ (erased rep-fn : (erased (List (Bool)) w r r2) (erased (Nat) n) (subterm erased (RepL w n r) p) (erased (RepL w n r2) q)
    -> (erased (Eq (List (Bool)) r r2) e))
  (let-match erased p (RS _ r1 _ n1 p1 c) ((RZ _) (let-match erased q (RZ _)) (Refl _ r)))
  (let-match erased q (RS _ r3 _ _ q1 c2))
  (let-match erased (rep-fn w r1 r3 n1 p1 q1) (Refl _ _))
  (cat-fn (Bool) w r1 r r2 c c2))

(def-fns _ $ (erased rep-ex : (erased (List (Bool)) w) (subterm erased (Nat) n) -> (erased (List (Bool)) r) (erased (RepL w n r) p))
  (let-match erased n (Succ n1) ((Zero) (values (Nil (Bool)) (RZ w))))
  (let ((erased r1) (erased p1)) (rep-ex w n1))
  (let ((erased r) (erased c)) (cat-ex (Bool) w r1))
  (values r (RS w r1 r n1 p1 c)))

(def-fns _ $ (erased iden-fn : (erased (List (Nat)) s) (erased (It) i) (erased (List (Bool)) d d2) (erased (IDen s i d) p) (erased (IDen s i d2) q)
    -> (erased (Eq (List (Bool)) d d2) e))
  (match erased p _
    ((IDW _ _) (let-match erased q (IDW _ _)) (Refl _ d))
    ((IDP _ w _ v n nv rp)
      (let-match erased q (IDP _ _ _ _ n2 nv2 rp2))
      (let-match erased (nthor-fn (Nat) (Zero) s v n n2 nv nv2) (Refl _ _))
      (rep-fn w d d2 n rp rp2))))

(def-fns _ $ (erased iden-ex : (erased (List (Nat)) s) (erased (It) i) -> (erased (List (Bool)) d) (erased (IDen s i d) p))
  (let-match erased i (IP w v) ((IW w) (values w (IDW s w))))
  (let ((erased n) (erased nv)) (nthor-ex (Nat) (Zero) s v))
  (let ((erased r) (erased rp)) (rep-ex w n))
  (values r (IDP s w r v n nv rp)))

(def-fns _ $ (erased exp-fn : (erased (List (Nat)) s) (erased (List (It)) S) (erased (List (Bool)) L L2) (subterm erased (Exp s S L) p) (erased (Exp s S L2) q)
    -> (erased (Eq (List (Bool)) L L2) e))
  (let-match erased p (ECons _ i S1 d L1 _ id e c) ((ENil _) (let-match erased q (ENil _)) (Refl _ L)))
  (let-match erased q (ECons _ _ _ d2 L3 _ id2 e2 c2))
  (let-match erased (iden-fn s i d d2 id id2) (Refl _ _))
  (let-match erased (exp-fn s S1 L1 L3 e e2) (Refl _ _))
  (cat-fn (Bool) d L1 L L2 c c2))

(def-fns _ $ (erased exp-ex : (erased (List (Nat)) s) (subterm erased (List (It)) S) -> (erased (List (Bool)) L) (erased (Exp s S L) p))
  (let-match erased S (Cons _ i S1) ((Nil _) (values (Nil (Bool)) (ENil s))))
  (let ((erased d) (erased id)) (iden-ex s i))
  (let ((erased L1) (erased e)) (exp-ex s S1))
  (let ((erased L) (erased c)) (cat-ex (Bool) d L1))
  (values L (ECons s i S1 d L1 L id e c)))

(def-fns _ $ (erased eqz-refl : (subterm erased (List (Bool)) a) -> (erased (Eqz a a) e))
  (let-match erased a (Cons _ x a1) ((Nil _) (EZ a a (ZN) (ZN))))
  (EC x a1 a1 (eqz-refl a1)))

(def-fns _ $ (erased eqz-sym : (erased (List (Bool)) a b) (subterm erased (Eqz a b) e) -> (erased (Eqz b a) f))
  (match erased e _
    ((EZ _ _ za zb) (EZ b a zb za))
    ((EC x a1 b1 e1) (EC x b1 a1 (eqz-sym a1 b1 e1)))))

(def-fns _ $ (erased eqz-zeros : (erased (List (Bool)) a b) (subterm erased (Eqz a b) e) (erased (Zeros a) za) -> (erased (Zeros b) zb))
  (let-match erased e (EC x a1 b1 e1) ((EZ _ _ _ zb) zb))
  (let-match erased za (ZC _ z1))
  (ZC b1 (eqz-zeros a1 b1 e1 z1)))

(def-fns _ $ (erased eqz-trans : (erased (List (Bool)) a b c) (subterm erased (Eqz a b) e) (erased (Eqz b c) f) -> (erased (Eqz a c) g))
  (let-match erased e (EC x a1 b1 e1) ((EZ _ _ za zb) (EZ a c za (eqz-zeros b c f zb))))
  (let-match erased f (EC _ _ c1 f1)
    ((EZ _ _ zb zc) (let-match erased zb (ZC _ z1)) (EZ a c (ZC a1 (eqz-zeros b1 a1 (eqz-sym a1 b1 e1) z1)) zc)))
  (EC x a1 c1 (eqz-trans a1 b1 c1 e1 f1)))

(def-fns _ $ (erased eqz-cat : (erased (List (Bool)) d a b da db) (subterm erased (Cat (Bool) d a da) c) (erased (Cat (Bool) d b db) c2) (erased (Eqz a b) e)
    -> (erased (Eqz da db) f))
  (let-match erased c (CatC _ x d1 _ a3 c1) ((CatN _ _) (let-match erased c2 (CatN _ _)) e))
  (let-match erased c2 (CatC _ _ _ _ b3 c3))
  (EC x a3 b3 (eqz-cat d1 a b a3 b3 c1 c3 e)))

(def-adts
  ((IWd : ((It) i) ((List (Bool)) w) -> Type)
    enum
    (many WdW : (erased (List (Bool)) w) -> (IWd (IW w) w))
    (many WdP : (erased (List (Bool)) w) (erased (Nat) v) -> (IWd (IP w v) w))))

(def-adts
  ((Rw : ((List (It)) S) ((List (It)) S2) -> Type)
    enum
    (many RwC : (erased (It) i) (erased (List (It)) S S2) (erased (Rw S S2) r) -> (Rw (Cons (It) i S) (Cons (It) i S2)))
    (many RwE : (erased (It) i) (erased (List (It)) S) (erased (IWd i (Nil (Bool))) iw) -> (Rw (Cons (It) i S) S))
    (many RwT : (erased (It) i) (erased (List (Bool)) w) (erased (IWd i w) iw) (erased (Zeros w) z) -> (Rw (Cons (It) i (Nil (It))) (Nil (It))))
    (many RwS : (erased (Bool) b c) (erased (List (Bool)) w) (erased (List (It)) S)
       -> (Rw (Cons (It) (IW (Cons (Bool) b (Cons (Bool) c w))) S) (Cons (It) (IW (Cons (Bool) b (Nil (Bool)))) (Cons (It) (IW (Cons (Bool) c w)) S))))
    (many RwRot : (erased (Bool) x) (erased (List (Bool)) xs w) (erased (Nat) v) (erased (List (It)) S)
       (erased (Cat (Bool) xs (Cons (Bool) x (Nil (Bool))) w) c)
       -> (Rw (Cons (It) (IW (Cons (Bool) x (Nil (Bool)))) (Cons (It) (IP w v) S)) (Cons (It) (IP (Cons (Bool) x xs) v) (Cons (It) (IW (Cons (Bool) x (Nil (Bool)))) S))))
    (many RwCom : (erased (List (Bool)) w) (erased (Nat) u v) (erased (List (It)) S)
       -> (Rw (Cons (It) (IP w u) (Cons (It) (IP w v) S)) (Cons (It) (IP w v) (Cons (It) (IP w u) S))))))

(def-adts
  ((Nrm : ((List (It)) S) ((List (It)) S2) -> Type)
    enum
    (many NRefl : (erased (List (It)) S) -> (Nrm S S))
    (many NStep : (erased (List (It)) S S1 S2) (erased (Rw S S1) r) (erased (Nrm S1 S2) n) -> (Nrm S S2))))

(def-fns _ $ (erased zeros-cat : (erased (List (Bool)) a b c) (subterm erased (Zeros a) za) (erased (Zeros b) zb) (erased (Cat (Bool) a b c) ct) -> (erased (Zeros c) zc))
  (let-match erased za (ZC a1 z1) ((ZN) (let-match erased ct (CatN _ _)) zb))
  (let-match erased ct (CatC _ _ _ _ c1 ct1))
  (ZC c1 (zeros-cat a1 b c1 z1 zb ct1)))

(def-fns _ $ (erased rep-zeros : (erased (List (Bool)) w r) (erased (Nat) n) (subterm erased (RepL w n r) p) (erased (Zeros w) z) -> (erased (Zeros r) zr))
  (let-match erased p (RS _ r1 _ n1 p1 c) ((RZ _) (ZN)))
  (zeros-cat w r1 r z (rep-zeros w r1 n1 p1 z) c))

(def-fns _ $ (erased iden-zeros : (erased (List (Nat)) s) (erased (It) i) (erased (List (Bool)) w d) (erased (IWd i w) iw) (erased (IDen s i d) id) (erased (Zeros w) z)
    -> (erased (Zeros d) zd))
  (match erased id _
    ((IDW _ _) (let-match erased iw (WdW _)) z)
    ((IDP _ _ _ _ n _ rp) (let-match erased iw (WdP _ _)) (rep-zeros w d n rp z))))

(def-fns _ $ (erased rep-nil : (erased (List (Bool)) r) (erased (Nat) n) (subterm erased (RepL (Nil (Bool)) n r) p) -> (erased (Eq (List (Bool)) r (Nil (Bool))) e))
  (let-match erased p (RS _ r1 _ n1 p1 c) ((RZ _) (Refl _ r)))
  (let-match erased c (CatN _ _))
  (rep-nil r1 n1 p1))

(def-fns _ $ (erased iden-empty : (erased (List (Nat)) s) (erased (It) i) (erased (List (Bool)) d) (erased (IWd i (Nil (Bool))) iw) (erased (IDen s i d) id)
    -> (erased (Eq (List (Bool)) d (Nil (Bool))) e))
  (match erased id _
    ((IDW _ _) (let-match erased iw (WdW _)) (Refl _ d))
    ((IDP _ _ _ _ n _ rp) (let-match erased iw (WdP _ _)) (rep-nil d n rp))))

(def-fns _ $ (erased add-ex : (subterm erased (Nat) a) (erased (Nat) b) -> (erased (Nat) c) (erased (Add a b c) p))
  (let-match erased a (Succ a1) ((Zero) (values b (AddZero b))))
  (let ((erased c) (erased p)) (add-ex a1 b))
  (values (Succ c) (AddSucc a1 b c p)))

(def-fns _ $ (erased cat-assoc2 : (erased Type A) (erased (List A) x w y wy z) (erased (Cat A w y wy) c1) (subterm erased (Cat A x wy z) c2)
    -> (erased (List A) x2) (erased (Cat A x w x2) c3) (erased (Cat A x2 y z) c4))
  (let-match erased c2 (CatC _ a xs _ zs c) ((CatN _ _) (values w (CatN A w) c1)))
  (let ((erased x2) (erased c3) (erased c4)) (cat-assoc2 A xs w y wy zs c1 c))
  (values (Cons A a x2) (CatC A a xs w x2 c3) (CatC A a x2 y zs c4)))

(def-fns _ $ (erased rep-add : (erased (List (Bool)) w ra rb x) (erased (Nat) a b c) (subterm erased (RepL w a ra) p) (erased (RepL w b rb) q)
    (erased (Add a b c) ad) (erased (Cat (Bool) ra rb x) ct) -> (erased (RepL w c x) r))
  (let-match erased p (RS _ r1 _ a1 p1 cw) ((RZ _) (let-match erased ad (AddZero _)) (let-match erased ct (CatN _ _)) q))
  (let-match erased ad (AddSucc _ _ c1 ad1))
  (let ((erased y) (erased c3) (erased c4)) (cat-assoc (Bool) w r1 ra rb x cw ct))
  (RS w y x c1 (rep-add w r1 rb y a1 b c1 p1 q ad1 c3) c4))

(def-fns _ $ (erased rep-com : (erased (List (Bool)) w ra rb l1 x y l l2) (erased (Nat) a b) (erased (RepL w a ra) p) (erased (RepL w b rb) q)
    (erased (Cat (Bool) rb l1 x) c1) (erased (Cat (Bool) ra x l) c2) (erased (Cat (Bool) ra l1 y) c3) (erased (Cat (Bool) rb y l2) c4)
    -> (erased (Eq (List (Bool)) l l2) e))
  (let ((erased ab) (erased c5) (erased c6)) (cat-assoc2 (Bool) ra rb l1 x l c1 c2))
  (let ((erased ba) (erased c7) (erased c8)) (cat-assoc2 (Bool) rb ra l1 y l2 c3 c4))
  (let ((erased k) (erased ad)) (add-ex a b))
  (let-match erased (rep-fn w ab ba k (rep-add w ra rb ab a b k p q ad c5) (rep-add w rb ra ba b a k q p (add-comm a b k ad) c7)) (Refl _ _))
  (cat-fn (Bool) ab l1 l l2 c6 c8))

(def-fns _ $ (erased rot-rep : (erased (Bool) x) (erased (List (Bool)) xs w r r2 l1 m l2) (erased (Nat) n)
    (erased (Cat (Bool) xs (Cons (Bool) x (Nil (Bool))) w) cx) (subterm erased (RepL w n r) p) (erased (RepL (Cons (Bool) x xs) n r2) q)
    (erased (Cat (Bool) r l1 m) c1) (erased (Cat (Bool) r2 (Cons (Bool) x l1) l2) c2) -> (erased (Eq (List (Bool)) l2 (Cons (Bool) x m)) e))
  (let-match erased p (RS _ r1 _ n1 p1 cw)
    ((RZ _) (let-match erased q (RZ _)) (let-match erased c1 (CatN _ _)) (let-match erased c2 (CatN _ _)) (Refl _ l2)))
  (let-match erased q (RS _ r3 _ _ q1 cw2))
  (let ((erased m1) (erased c3) (erased c4)) (cat-assoc (Bool) w r1 r l1 m cw c1))
  (let ((erased n2) (erased c5) (erased c6)) (cat-assoc (Bool) (Cons (Bool) x xs) r3 r2 (Cons (Bool) x l1) l2 cw2 c2))
  (let-match erased (rot-rep x xs w r1 r3 l1 m1 n2 n1 cx p1 q1 c3 c5) (Refl _ _))
  (let ((erased k) (erased c7) (erased c8)) (cat-assoc (Bool) xs (Cons (Bool) x (Nil (Bool))) w m1 m cx c4))
  (let-match erased c7 (CatC _ _ _ _ _ c9))
  (let-match erased c9 (CatN _ _))
  (let-match erased c6 (CatC _ _ _ _ l3 c10))
  (let-match erased (cat-fn (Bool) xs k l3 m c10 c8) (Refl _ _))
  (Refl _ l2))

(def-fns _ $ (erased rw-ok : (erased (List (Nat)) s) (erased (List (It)) S S2) (erased (List (Bool)) L L2) (subterm erased (Rw S S2) r)
    (erased (Exp s S L) p) (erased (Exp s S2 L2) q) -> (erased (Eqz L L2) e))
  (match erased r _
    ((RwC i S1 S3 r1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased q (ECons _ _ _ d2 L3 _ id2 e2 c2))
      (let-match erased (iden-fn s i d d2 id id2) (Refl _ _))
      (eqz-cat d L1 L3 L L2 c c2 (rw-ok s S1 S3 L1 L3 r1 e e2)))
    ((RwE i S1 iw)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased (iden-empty s i d iw id) (Refl _ _))
      (let-match erased c (CatN _ _))
      (let-match erased (exp-fn s S1 L1 L2 e q) (Refl _ _))
      (eqz-refl L))
    ((RwT i w iw z)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased e (ENil _))
      (let-match erased q (ENil _))
      (let-match erased (cat-nil (Bool) d L c) (Refl _ _))
      (EZ L L2 (iden-zeros s i w d iw id z) (ZN)))
    ((RwS b c0 w S1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased id (IDW _ _))
      (let-match erased c (CatC _ _ _ _ m c1))
      (let-match erased q (ECons _ _ _ d2 l3 _ id2 e2 c2))
      (let-match erased id2 (IDW _ _))
      (let-match erased c2 (CatC _ _ _ _ _ c3))
      (let-match erased c3 (CatN _ _))
      (let-match erased e2 (ECons _ _ _ d3 l5 _ id3 e3 c4))
      (let-match erased id3 (IDW _ _))
      (let-match erased (exp-fn s S1 L1 l5 e e3) (Refl _ _))
      (let-match erased (cat-fn (Bool) d3 L1 m l3 c1 c4) (Refl _ _))
      (eqz-refl L))
    ((RwRot x xs w v S1 cx)
      (let-match erased p (ECons _ _ _ d m _ id e c))
      (let-match erased id (IDW _ _))
      (let-match erased c (CatC _ _ _ _ _ c0))
      (let-match erased c0 (CatN _ _))
      (let-match erased e (ECons _ _ _ r1 l1 _ id1 e1 c1))
      (let-match erased id1 (IDP _ _ _ _ n nv rp))
      (let-match erased q (ECons _ _ _ r2 n1 _ id2 e2 c2))
      (let-match erased id2 (IDP _ _ _ _ n2 nv2 rp2))
      (let-match erased (nthor-fn (Nat) (Zero) s v n n2 nv nv2) (Refl _ _))
      (let-match erased e2 (ECons _ _ _ d3 l3 _ id3 e3 c3))
      (let-match erased id3 (IDW _ _))
      (let-match erased c3 (CatC _ _ _ _ _ c4))
      (let-match erased c4 (CatN _ _))
      (let-match erased (exp-fn s S1 l1 l3 e1 e3) (Refl _ _))
      (let-match erased (rot-rep x xs w r1 r2 l1 m L2 n cx rp rp2 c1 c2) (Refl _ _))
      (eqz-refl L))
    ((RwCom w u v S1)
      (let-match erased p (ECons _ _ _ ra x _ idu e c))
      (let-match erased idu (IDP _ _ _ _ a nva rpa))
      (let-match erased e (ECons _ _ _ rb l1 _ idv e1 c1))
      (let-match erased idv (IDP _ _ _ _ b nvb rpb))
      (let-match erased q (ECons _ _ _ rb2 y _ idv2 e2 c2))
      (let-match erased (iden-fn s (IP w v) rb rb2 idv idv2) (Refl _ _))
      (let-match erased e2 (ECons _ _ _ ra2 l3 _ idu2 e3 c3))
      (let-match erased (iden-fn s (IP w u) ra ra2 idu idu2) (Refl _ _))
      (let-match erased (exp-fn s S1 l1 l3 e1 e3) (Refl _ _))
      (let-match erased (rep-com w ra rb l1 x y L L2 a b rpa rpb c1 c c3 c2) (Refl _ _))
      (eqz-refl L))))

(def-fns _ $ (erased nrm-ok : (erased (List (Nat)) s) (erased (List (It)) S S2) (erased (List (Bool)) L L2) (subterm erased (Nrm S S2) n)
    (erased (Exp s S L) p) (erased (Exp s S2 L2) q) -> (erased (Eqz L L2) e))
  (let-match erased n (NStep _ S1 _ r n1) ((NRefl _) (let-match erased (exp-fn s S L L2 p q) (Refl _ _)) (eqz-refl L)))
  (let ((erased L1) (erased p1)) (exp-ex s S1))
  (eqz-trans L L1 L2 (rw-ok s S S1 L L1 r p p1) (nrm-ok s S1 S2 L1 L2 n1 p1 q)))

(def-adts $ (At : -> Type)
  enum
  (many AOne : -> (At))
  (many AVar : (many (Nat) v) -> (At)))

(def-adts
  ((EvA : ((List (Nat)) s) ((List (At)) as) ((Nat) n) -> Type)
    enum
    (many EANil : (erased (List (Nat)) s) -> (EvA s (Nil (At)) (Zero)))
    (many EAOne : (erased (List (Nat)) s) (erased (List (At)) as) (erased (Nat) n) (erased (EvA s as n) e) -> (EvA s (Cons (At) (AOne) as) (Succ n)))
    (many EAVar : (erased (List (Nat)) s) (erased (Nat) u k n m) (erased (List (At)) as) (erased (NthOr (Nat) (Zero) s u k) nk) (erased (EvA s as n) e)
       (erased (Add k n m) ad) -> (EvA s (Cons (At) (AVar u) as) m))))

(def-adts
  ((EvT : ((List (List (At))) t) ((List (Nat)) s) ((List (Nat)) s2) -> Type)
    enum
    (many ETNil : (erased (List (Nat)) s) -> (EvT (Nil (List (At))) s (Nil (Nat))))
    (many ETCons : (erased (List (At)) as) (erased (List (List (At))) t) (erased (List (Nat)) s s2) (erased (Nat) n) (erased (EvA s as n) e)
       (erased (EvT t s s2) et) -> (EvT (Cons (List (At)) as t) s (Cons (Nat) n s2)))))

(def-adts
  ((SubA : ((List (Bool)) w) ((List (At)) as) ((List (It)) S) ((List (It)) S2) -> Type)
    enum
    (many SANil : (erased (List (Bool)) w) (erased (List (It)) S) -> (SubA w (Nil (At)) S S))
    (many SAOne : (erased (List (Bool)) w) (erased (List (At)) as) (erased (List (It)) S S2) (erased (SubA w as S S2) p)
       -> (SubA w (Cons (At) (AOne) as) S (Cons (It) (IW w) S2)))
    (many SAVar : (erased (List (Bool)) w) (erased (Nat) u) (erased (List (At)) as) (erased (List (It)) S S2) (erased (SubA w as S S2) p)
       -> (SubA w (Cons (At) (AVar u) as) S (Cons (It) (IP w u) S2)))))

(def-adts
  ((SubS : ((List (List (At))) t) ((List (It)) S) ((List (It)) S2) -> Type)
    enum
    (many SSNil : (erased (List (List (At))) t) -> (SubS t (Nil (It)) (Nil (It))))
    (many SSW : (erased (List (List (At))) t) (erased (List (Bool)) w) (erased (List (It)) S S2) (erased (SubS t S S2) p)
       -> (SubS t (Cons (It) (IW w) S) (Cons (It) (IW w) S2)))
    (many SSP : (erased (List (List (At))) t) (erased (List (Bool)) w) (erased (Nat) v) (erased (List (At)) as) (erased (List (It)) S S1 S2)
       (erased (NthOr (List (At)) (Nil (At)) t v as) nt) (erased (SubS t S S1) p) (erased (SubA w as S1 S2) sa)
       -> (SubS t (Cons (It) (IP w v) S) S2))))

(def-fns _ $ (erased eva-ex : (erased (List (Nat)) s) (subterm erased (List (At)) as) -> (erased (Nat) n) (erased (EvA s as n) e))
  (let-match erased as (Cons _ a as1) ((Nil _) (values (Zero) (EANil s))))
  (let ((erased n1) (erased e1)) (eva-ex s as1))
  (let-match erased a (AVar u) ((AOne) (values (Succ n1) (EAOne s as1 n1 e1))))
  (let ((erased k) (erased nk)) (nthor-ex (Nat) (Zero) s u))
  (let ((erased m) (erased ad)) (add-ex k n1))
  (values m (EAVar s u k n1 m as1 nk e1 ad)))

(def-fns _ $ (erased evt-ex : (subterm erased (List (List (At))) t) (erased (List (Nat)) s) -> (erased (List (Nat)) s2) (erased (EvT t s s2) et))
  (let-match erased t (Cons _ as t1) ((Nil _) (values (Nil (Nat)) (ETNil s))))
  (let ((erased n) (erased e)) (eva-ex s as))
  (let ((erased s3) (erased et)) (evt-ex t1 s))
  (values (Cons (Nat) n s3) (ETCons as t1 s s3 n e et)))

(def-fns _ $ (erased evt-nth : (erased (List (List (At))) t) (erased (List (Nat)) s s2) (erased (Nat) v) (erased (List (At)) as)
    (subterm erased (EvT t s s2) et) (erased (NthOr (List (At)) (Nil (At)) t v as) nt) -> (erased (Nat) n) (erased (NthOr (Nat) (Zero) s2 v n) nv) (erased (EvA s as n) e))
  (match erased et _
    ((ETNil _) (let-match erased nt (NOEnd _ _ _)) (values (Zero) (NOEnd (Nat) (Zero) v) (EANil s)))
    ((ETCons as0 t1 _ s3 n0 e0 et1)
      (let-match erased nt (NOThere _ _ _ _ _ v1 nt1) ((NOHere _ _ _ _) (values n0 (NOHere (Nat) (Zero) n0 s3) e0)))
      (let ((erased n) (erased nv) (erased e)) (evt-nth t1 s s3 v1 as et1 nt1))
      (values n (NOThere (Nat) (Zero) n n0 s3 v1 nv) e))))

(def-fns _ $ (erased suba-ok : (erased (List (Nat)) s) (erased (List (Bool)) w L) (erased (List (At)) as) (erased (List (It)) S S2) (erased (Nat) n)
    (subterm erased (SubA w as S S2) sa) (erased (Exp s S2 L) p) (erased (EvA s as n) ev)
    -> (erased (List (Bool)) R L1) (erased (RepL w n R) rp) (erased (Exp s S L1) e) (erased (Cat (Bool) R L1 L) c))
  (match erased sa _
    ((SANil _ _) (let-match erased ev (EANil _)) (values (Nil (Bool)) L (RZ w) p (CatN (Bool) L)))
    ((SAOne _ as1 _ S3 sa1)
      (let-match erased p (ECons _ _ _ d L3 _ id e c))
      (let-match erased id (IDW _ _))
      (let-match erased ev (EAOne _ _ n1 ev1))
      (let ((erased R1) (erased L1) (erased rp1) (erased e1) (erased c1)) (suba-ok s w L3 as1 S S3 n1 sa1 e ev1))
      (let ((erased x) (erased c2) (erased c3)) (cat-assoc2 (Bool) w R1 L1 L3 L c1 c))
      (values x L1 (RS w R1 x n1 rp1 c2) e1 c3))
    ((SAVar _ u as1 _ S3 sa1)
      (let-match erased p (ECons _ _ _ rk L3 _ id e c))
      (let-match erased id (IDP _ _ _ _ k nk rk1))
      (let-match erased ev (EAVar _ _ k2 n1 _ _ nk2 ev1 ad))
      (let-match erased (nthor-fn (Nat) (Zero) s u k k2 nk nk2) (Refl _ _))
      (let ((erased R1) (erased L1) (erased rp1) (erased e1) (erased c1)) (suba-ok s w L3 as1 S S3 n1 sa1 e ev1))
      (let ((erased x) (erased c2) (erased c3)) (cat-assoc2 (Bool) rk R1 L1 L3 L c1 c))
      (values x L1 (rep-add w rk R1 x k n1 n rk1 rp1 ad c2) e1 c3))))

(def-fns _ $ (erased subst-ok : (erased (List (List (At))) t) (erased (List (Nat)) s s2) (erased (List (It)) S S2) (erased (List (Bool)) L)
    (subterm erased (SubS t S S2) ss) (erased (EvT t s s2) et) (erased (Exp s S2 L) p) -> (erased (Exp s2 S L) q))
  (match erased ss _
    ((SSNil _) (let-match erased p (ENil _)) (ENil s2))
    ((SSW _ w S1 S3 ss1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased id (IDW _ _))
      (ECons s2 (IW w) S1 w L1 L (IDW s2 w) (subst-ok t s s2 S1 S3 L1 ss1 et e) c))
    ((SSP _ w v as S1 Sm _ nt ss1 sa)
      (let ((erased n) (erased nv) (erased ev)) (evt-nth t s s2 v as et nt))
      (let ((erased R) (erased L1) (erased rp) (erased e) (erased c)) (suba-ok s w L as Sm S2 n sa p ev))
      (ECons s2 (IP w v) S1 R L1 L (IDP s2 w R v n nv rp) (subst-ok t s s2 S1 Sm L1 ss1 et e) c))))

(def-adts $ (Pat : -> Type)
  enum
  (many MkPat : (many (Nat) q) (many (List (It)) l) (many (Bool) h) (many (List (It)) r) -> (Pat)))

(def-adts
  ((SdIn : ((List (Nat)) s) ((List (It)) S) ((List (Bool)) l) -> Type)
    enum
    (many MkSI : (erased (List (Nat)) s) (erased (List (It)) S) (erased (List (Bool)) l L) (erased (Exp s S L) e) (erased (Eqz l L) z) -> (SdIn s S l))))

(def-adts
  ((In : ((List (Nat)) s) ((Pat) P) ((Conf) c) -> Type)
    enum
    (many MkIn : (erased (List (Nat)) s) (erased (Nat) q) (erased (List (It)) L R) (erased (Bool) h) (erased (List (Bool)) l r)
       (erased (SdIn s L l) il) (erased (SdIn s R r) ir) -> (In s (MkPat q L h R) (MkConf q l h r)))))

(def-adts
  ((SideOK : ((List (List (At))) t) ((List (It)) Q) ((List (It)) T) -> Type)
    enum
    (many MkSO : (erased (List (List (At))) t) (erased (List (It)) Q T T2 Nm) (erased (SubS t T T2) ss) (erased (Nrm Q Nm) nq) (erased (Nrm T2 Nm) nt)
       -> (SideOK t Q T))))

(def-adts
  ((Match : ((Pat) P) ((Pat) T) ((List (List (At))) t) -> Type)
    enum
    (many MkMatch : (erased (Nat) q) (erased (Bool) h) (erased (List (It)) L R TL TR) (erased (List (List (At))) t)
       (erased (SideOK t L TL) ml) (erased (SideOK t R TR) mr) -> (Match (MkPat q L h R) (MkPat q TL h TR) t))))

(def-fns _ $ (erased side-ok : (erased (List (List (At))) t) (erased (List (Nat)) s s2) (erased (List (It)) Q T) (erased (List (Bool)) l)
    (erased (SideOK t Q T) so) (erased (EvT t s s2) et) (erased (SdIn s Q l) si) -> (erased (SdIn s2 T l) si2))
  (let-match erased so (MkSO _ _ _ T2 Nm ss nq nt))
  (let-match erased si (MkSI _ _ _ LQ e z))
  (let ((erased LT) (erased e2)) (exp-ex s T2))
  (let ((erased LN) (erased e3)) (exp-ex s Nm))
  (let ((erased z2)) (eqz-trans l LQ LN z (nrm-ok s Q Nm LQ LN nq e e3)))
  (MkSI s2 T l LT (subst-ok t s s2 T T2 LT ss et e2) (eqz-trans l LN LT z2 (eqz-sym LT LN (nrm-ok s T2 Nm LT LN nt e2 e3)))))

(def-fns _ $ (erased match-ok : (erased (Pat) P T) (erased (List (List (At))) t) (erased (List (Nat)) s) (erased (Conf) c)
    (erased (Match P T t) mt) (erased (In s P c) ip) -> (erased (List (Nat)) s2) (erased (In s2 T c) it))
  (let-match erased mt (MkMatch q h L R TL TR _ ml mr))
  (let-match erased ip (MkIn _ _ _ _ _ l r il ir))
  (let ((erased s2) (erased et)) (evt-ex t s))
  (values s2 (MkIn s2 q TL TR h l r (side-ok t s s2 L TL l ml et il) (side-ok t s s2 R TR r mr et ir))))

(def-adts
  ((Cut : ((Bool) f) ((Nat) v) ((List (It)) S) ((List (It)) S2) -> Type)
    enum
    (many CuN : (erased (Bool) f) (erased (Nat) v) -> (Cut f v (Nil (It)) (Nil (It))))
    (many CuW : (erased (Bool) f) (erased (Nat) v) (erased (List (Bool)) w) (erased (List (It)) S S2) (erased (Cut f v S S2) p)
       -> (Cut f v (Cons (It) (IW w) S) (Cons (It) (IW w) S2)))
    (many CuK : (erased (Bool) f) (erased (Nat) u v) (erased (List (Bool)) w) (erased (List (It)) S S2) (erased (Apart (Nat) Lt u v) ap) (erased (Cut f v S S2) p)
       -> (Cut f v (Cons (It) (IP w u) S) (Cons (It) (IP w u) S2)))
    (many Cu0 : (erased (Nat) v) (erased (List (Bool)) w) (erased (List (It)) S S2) (erased (Cut (BFalse) v S S2) p)
       -> (Cut (BFalse) v (Cons (It) (IP w v) S) S2))
    (many Cu1 : (erased (Nat) v) (erased (List (Bool)) w) (erased (List (It)) S S2) (erased (Cut (BTrue) v S S2) p)
       -> (Cut (BTrue) v (Cons (It) (IP w v) S) (Cons (It) (IW w) (Cons (It) (IP w v) S2))))))

(def-adts
  ((CutP : ((Bool) f) ((Nat) v) ((Pat) P) ((Pat) Pb) -> Type)
    enum
    (many MkCP : (erased (Bool) f) (erased (Nat) v q) (erased (List (It)) L R L2 R2) (erased (Bool) h) (erased (Cut f v L L2) sl) (erased (Cut f v R R2) sr)
       -> (CutP f v (MkPat q L h R) (MkPat q L2 h R2)))))

(def-adts
  ((Dec1 : ((List (Nat)) s) ((Nat) v) ((List (Nat)) s2) -> Type)
    enum
    (many D1H : (erased (Nat) k) (erased (List (Nat)) s) -> (Dec1 (Cons (Nat) (Succ k) s) (Zero) (Cons (Nat) k s)))
    (many D1T : (erased (Nat) y v) (erased (List (Nat)) s s2) (erased (Dec1 s v s2) p) -> (Dec1 (Cons (Nat) y s) (Succ v) (Cons (Nat) y s2)))))

(def-fns _ $ (erased dec-ex : (erased (List (Nat)) s) (erased (Nat) v k) (subterm erased (NthOr (Nat) (Zero) s v (Succ k)) nv)
    -> (erased (List (Nat)) s2) (erased (Dec1 s v s2) dc) (erased (NthOr (Nat) (Zero) s2 v k) nv2))
  (let-match erased nv (NOThere _ _ _ y s1 v1 nv1) ((NOHere _ _ _ s1) (values (Cons (Nat) k s1) (D1H k s1) (NOHere (Nat) (Zero) k s1))))
  (let ((erased s3) (erased dc) (erased nv3)) (dec-ex s1 v1 k nv1))
  (values (Cons (Nat) y s3) (D1T y v1 s1 s3 dc) (NOThere (Nat) (Zero) k y s3 v1 nv3)))

(def-fns _ $ (erased dec-other : (erased (List (Nat)) s s2) (erased (Nat) v u x) (subterm erased (Dec1 s v s2) dc) (erased (Apart (Nat) Lt u v) ap)
    (erased (NthOr (Nat) (Zero) s u x) nu) -> (erased (NthOr (Nat) (Zero) s2 u x) nu2))
  (match erased dc _
    ((D1H k s1)
      (let-match erased nu (NOThere _ _ _ _ _ uq nu1) ((NOHere _ _ _ _) (match erased ap _ (absurd (ApLt _ _ _ _ l) l) (absurd (ApGt _ _ _ _ l) l))))
      (NOThere (Nat) (Zero) x k s1 uq nu1))
    ((D1T y v1 s1 s3 dc1)
      (let-match erased nu (NOThere _ _ _ _ _ uq nu1) ((NOHere _ _ _ _) (NOHere (Nat) (Zero) y s3)))
      (let ((erased ap1)) (match erased ap (((Apart (Nat) Lt uq v1) a))
        ((ApLt _ _ _ _ l) (let-match erased l (LtS _ _ l1)) (ApLt (Nat) Lt uq v1 l1))
        ((ApGt _ _ _ _ l) (let-match erased l (LtS _ _ l1)) (ApGt (Nat) Lt uq v1 l1))))
      (NOThere (Nat) (Zero) x y s3 uq (dec-other s1 s3 v1 uq x dc1 ap1 nu1)))))

(def-fns _ $ (erased cut0-ok : (erased (List (Nat)) s) (erased (Nat) v) (erased (List (It)) S S2) (erased (List (Bool)) L) (subterm erased (Cut (BFalse) v S S2) sp)
    (erased (NthOr (Nat) (Zero) s v (Zero)) nv) (erased (Exp s S L) p) -> (erased (Exp s S2 L) q))
  (match erased sp _
    ((CuN _ _) p)
    ((CuW _ _ w S1 S3 sp1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (ECons s (IW w) S3 d L1 L id (cut0-ok s v S1 S3 L1 sp1 nv e) c))
    ((CuK _ u _ w S1 S3 ap sp1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (ECons s (IP w u) S3 d L1 L id (cut0-ok s v S1 S3 L1 sp1 nv e) c))
    ((Cu0 _ w S1 _ sp1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased id (IDP _ _ _ _ n nv1 rp))
      (let-match erased (nthor-fn (Nat) (Zero) s v n (Zero) nv1 nv) (Refl _ _))
      (let-match erased rp (RZ _))
      (let-match erased c (CatN _ _))
      (cut0-ok s v S1 S2 L sp1 nv e))))

(def-fns _ $ (erased cut1-ok : (erased (List (Nat)) s s2) (erased (Nat) v k) (erased (List (It)) S S2) (erased (List (Bool)) L) (subterm erased (Cut (BTrue) v S S2) sp)
    (erased (NthOr (Nat) (Zero) s v (Succ k)) nv) (erased (Dec1 s v s2) dc) (erased (NthOr (Nat) (Zero) s2 v k) nv2) (erased (Exp s S L) p) -> (erased (Exp s2 S2 L) q))
  (match erased sp _
    ((CuN _ _) (let-match erased p (ENil _)) (ENil s2))
    ((CuW _ _ w S1 S3 sp1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased id (IDW _ _))
      (ECons s2 (IW w) S3 d L1 L (IDW s2 w) (cut1-ok s s2 v k S1 S3 L1 sp1 nv dc nv2 e) c))
    ((CuK _ u _ w S1 S3 ap sp1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased id (IDP _ _ _ _ n nu rp))
      (ECons s2 (IP w u) S3 d L1 L (IDP s2 w d u n (dec-other s s2 v u n dc ap nu) rp) (cut1-ok s s2 v k S1 S3 L1 sp1 nv dc nv2 e) c))
    ((Cu1 _ w S1 S3 sp1)
      (let-match erased p (ECons _ _ _ d L1 _ id e c))
      (let-match erased id (IDP _ _ _ _ n nv1 rp))
      (let-match erased (nthor-fn (Nat) (Zero) s v n (Succ k) nv1 nv) (Refl _ _))
      (let-match erased rp (RS _ r1 _ _ rp1 cw))
      (let ((erased m) (erased c1) (erased c2)) (cat-assoc (Bool) w r1 d L1 L cw c))
      (ECons s2 (IW w) (Cons (It) (IP w v) S3) w m L (IDW s2 w)
        (ECons s2 (IP w v) S3 r1 L1 m (IDP s2 w r1 v k nv2 rp1) (cut1-ok s s2 v k S1 S3 L1 sp1 nv dc nv2 e) c1) c2))))

(def-fns _ $ (erased sdin-cut0 : (erased (List (Nat)) s) (erased (Nat) v) (erased (List (It)) S S2) (erased (List (Bool)) l)
    (erased (Cut (BFalse) v S S2) cu) (erased (NthOr (Nat) (Zero) s v (Zero)) nv) (erased (SdIn s S l) si) -> (erased (SdIn s S2 l) si2))
  (let-match erased si (MkSI _ _ _ L e z))
  (MkSI s S2 l L (cut0-ok s v S S2 L cu nv e) z))

(def-fns _ $ (erased sdin-cut1 : (erased (List (Nat)) s s2) (erased (Nat) v k) (erased (List (It)) S S2) (erased (List (Bool)) l)
    (erased (Cut (BTrue) v S S2) cu) (erased (NthOr (Nat) (Zero) s v (Succ k)) nv) (erased (Dec1 s v s2) dc) (erased (NthOr (Nat) (Zero) s2 v k) nv2)
    (erased (SdIn s S l) si) -> (erased (SdIn s2 S2 l) si2))
  (let-match erased si (MkSI _ _ _ L e z))
  (MkSI s2 S2 l L (cut1-ok s s2 v k S S2 L cu nv dc nv2 e) z))

(def-fns _ $ (erased cut-in : (erased (Nat) v) (erased (Pat) P Pz Ps) (erased (List (Nat)) s) (erased (Conf) c)
    (erased (CutP (BFalse) v P Pz) c0) (erased (CutP (BTrue) v P Ps) c1) (erased (In s P c) ip)
    -> (erased (List (Nat)) s2) (erased (Or (In s Pz c) (In s2 Ps c)) o))
  (let-match erased c0 (MkCP _ _ q L R L0 R0 h lz r0))
  (let-match erased c1 (MkCP _ _ _ _ _ L1 R1 _ l1 r1))
  (let-match erased ip (MkIn _ _ _ _ _ l r il ir))
  (let ((erased n) (erased nv)) (nthor-ex (Nat) (Zero) s v))
  (let-match erased n (Succ k)
    ((Zero) (values s (InL _ _ (MkIn s q L0 R0 h l r (sdin-cut0 s v L L0 l lz nv il) (sdin-cut0 s v R R0 r r0 nv ir))))))
  (let ((erased s2) (erased dc) (erased nv2)) (dec-ex s v k nv))
  (values s2 (InR _ _ (MkIn s2 q L1 R1 h l r (sdin-cut1 s s2 v k L L1 l l1 nv dc nv2 il) (sdin-cut1 s s2 v k R R1 r r1 nv dc nv2 ir)))))

(def-adts
  ((Ori : (Type A) ((Mv) d) (A l) (A r) (A x) (A y) -> Type)
    enum
    (many OrL : (erased Type A) (erased A l r) -> (Ori A (DL) l r l r))
    (many OrR : (erased Type A) (erased A l r) -> (Ori A (DR) l r r l))))

(def-adts
  ((PPop : ((List (It)) S) ((Bool) b) ((List (It)) S2) -> Type)
    enum
    (many PoE : -> (PPop (Nil (It)) (BFalse) (Nil (It))))
    (many PoW : (erased (Bool) b) (erased (List (Bool)) w) (erased (List (It)) S) -> (PPop (Cons (It) (IW (Cons (Bool) b w)) S) b (Cons (It) (IW w) S)))
    (many PoS : (erased (It) i) (erased (List (It)) S S2) (erased (Bool) b) (erased (IWd i (Nil (Bool))) iw) (erased (PPop S b S2) p)
       -> (PPop (Cons (It) i S) b S2))))

(def-fns _ $ (erased pop-ok : (erased (List (Nat)) s) (erased (List (It)) S S2) (erased (Bool) b h2) (erased (List (Bool)) x x2)
    (subterm erased (PPop S b S2) po) (erased (SdIn s S x) si) (erased (Pull x h2 x2) pp) -> (erased (Eq (Bool) h2 b) e) (erased (SdIn s S2 x2) si2))
  (let-match erased si (MkSI _ _ _ L e z))
