(def-fns _ $ (many c10-ent : (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Rs l3 c0) res))
  (let-match many (nat-eq i 0) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-bigjc c0 e ch)))
  (let-match many (nat-eq i 1) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-bigj c0 e ch)))
  (let-match many (nat-eq i 2) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-wr (BTrue) c0 e ch)))
