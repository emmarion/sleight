(def-fns _ $ (many c10-ent : (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Rs l3 c0) res))
  (let-match many (nat-eq i 0) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-bigjc c0 e ch)))
  (let-match many (nat-eq i 1) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-bigj c0 e ch)))
  (let-match many (nat-eq i 2) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-wr (BTrue) c0 e ch)))
  (let-match many (nat-eq i 3) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-vdesc (BTrue) c0 e ch)))
  (let-match many (nat-eq i 4) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-wr (BFalse) c0 e ch)))
  (let-match many (nat-eq i 5) (Unequal _ _ _ _ _) ((Equal _ _ _) (fe-cert c0 e ch (BTrue) lc mp rho)))
  (let-match many (nat-eq i 6) (Unequal _ _ _ _ _) ((Equal _ _ _) (fe-cert c0 e ch (BFalse) lc mp rho)))
  (let-match many (nat-eq i 7) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-certify c0 e ch 100000 (m-reent lc))))
  (let-match many (nat-eq i 8) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-certify c0 e ch 100000 (m-beven lc))))
  (let-match many (nat-eq i 9) (Unequal _ _ _ _ _) ((Equal _ _ _) (mac-chain c0 e ch)))
  (let-match many (nat-eq i 10) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-death c0 e ch)))
  (let-match many (nat-eq i 11) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-aend c0 e ch)))
  (let-match many (nat-eq i 12) (Unequal _ _ _ _ _) ((Equal _ _ _) (frame-tbl tbl-l0 c0 e ch)))
  (let-match many (nat-eq i 13) (Unequal _ _ _ _ _) ((Equal _ _ _) (frame-tbl tbl-ax c0 e ch)))
  (let-match many (nat-eq i 14) (Unequal _ _ _ _ _) ((Equal _ _ _) (frame-tbl tbl-frame c0 e ch)))
  (let-match many (nat-eq i 15) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-train c0 e ch)))
  (let-match many (nat-eq i 16) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-traing c0 e ch)))
  (let-match many (nat-eq i 17) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-fdesc c0 e ch)))
  (let-match many (nat-eq i 18) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-contact c0 e ch)))
  (let-match many (nat-eq i 19) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-contact0 c0 e ch)))
  (let-match many (nat-eq i 20) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-iterG c0 e ch)))
  (let-match many (nat-eq i 21) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-identG c0 e ch)))
  (let-match many (nat-eq i 22) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-sweep3 c0 e ch)))
  (let-match many (nat-eq i 23) (Unequal _ _ _ _ _) ((Equal _ _ _) (mac-absorb c0 e ch)))
  (let-match many (nat-eq i 24) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-resume c0 e ch)))
  (let-match many (nat-eq i 25) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-vdesc (BFalse) c0 e ch)))
  (c-move9 c0 e ch))

(def-fns _ $ (many c10-scan : (subterm many (Nat) n) (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Nat) j) (many (Rs l3 c0) res))
  (let ((many r)) (c10-ent i c0 e ch lc mp rho))
  (let-match many n (Succ n1) ((Zero) (values i r)))
  (let-match many (match many r (((Bool) b)) ((RsOk _ _ e1 _) (match many (rq-eq e1 e) _ ((ESome _ _) (BFalse)) ((ENone _) (BTrue)))) ((RsNo _ _ _ _) (BFalse)))
    (BFalse) ((BTrue) (values i r)))
  (tail $ c10-scan n1 (Succ i) c0 e ch lc mp rho))

(def-fns _ $ (many c10-move : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) idx) (many (Rs l3 c0) res))
  (let ((many j) (many r)) (c10-scan 4 0 c0 e ch (LcNo) (None _) 0))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j r)))
  (let ((many lc)) (lmc e))
  (let ((many mp) (many rho)) (fe-of lc))
  (c10-scan 21 5 c0 e ch lc mp rho))

(def-fns _ $ (many c10-run2 : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) left) (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values fuel e ch)))
  (let ((many _) (many r)) (c10-move c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values fuel e1 ch1)))
  (tail $ c10-run2 c0 f e1 ch1))
