  (let-match many (nat-eq i 20) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-iterG c0 e ch)))
  (let-match many (nat-eq i 21) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-identG c0 e ch)))
  (let-match many (nat-eq i 22) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-sweep3 c0 e ch)))
  (let-match many (nat-eq i 23) (Unequal _ _ _ _ _) ((Equal _ _ _) (mac-absorb c0 e ch)))
  (let-match many (nat-eq i 24) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-resume-c c0 e ch)))
  (let-match many (nat-eq i 25) (Unequal _ _ _ _ _) ((Equal _ _ _) (c-vdesc-u (BFalse) c0 e ch)))
  (c-move9-at c0 e ch lm))

(def-fns _ $ (many c10-try : (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Rs l3 c0) res))
  (let ((many r)) (c10-ent i c0 e ch lm lc mp rho))
  (let-match many r (RsOk _ _ e1 _) ((RsNo _ _ _ _) r))
  (match many (rq-eq e1 e) _ ((ESome _ _) (RsNo l3 c0 e ch)) ((ENone _) r)))

(def-fns _ $ (many c10-scan : (subterm many (Nat) n) (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmR e) lm) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Nat) j) (many (Rs l3 c0) res))
  (let ((many r)) (c10-try i c0 e ch lm lc mp rho))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values i r)))
  (let-match many n (Succ n1) ((Zero) (values i r)))
  (tail $ c10-scan n1 (Succ i) c0 e ch lm lc mp rho))

(def-fns _ $ (many lc-of : (erased (Rq) e) (many (LmR e) lm) -> (many (LmC) r))
  (let-match many lm (LmOk _ _ _ _ _ _ n L0 _ _ X T _ R1 _ _ _) ((LmNo _) (LcNo)))
  (let-match many (tdigits 0 X) (Some _ D) ((None _) (LcNo)))
  (LcOk n L0 D X T R1))

(def-fns _ $ (many c10-move : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) idx) (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let ((many lm)) (c-lm e c dc))
  (let ((many lc)) (lc-of e lm))
  (let ((many j) (many r)) (c10-scan 4 0 c0 e ch lm lc (None _) 0))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j r)))
  (let ((many mp) (many rho)) (fe-of lc))
  (c10-scan 21 5 c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-run2 : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) left) (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values fuel e ch)))
  (let ((many _) (many r)) (c10-move c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values fuel e1 ch1)))
  (tail $ c10-run2 c0 f e1 ch1))
