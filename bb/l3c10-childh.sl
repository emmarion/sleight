(def-fns _ $ (many rn-eq : (subterm many (List (Rn)) A) (many (List (Rn)) B) -> (many (Bool) r))
  (let-match many A (Cons _ a A1) ((Nil _) (match many B _ ((Nil _) (BTrue)) ((Cons _ _ _) (BFalse)))))
  (let-match many B (Cons _ b B1) ((Nil _) (BFalse)))
  (let-match many a (MkRn x n))
  (let-match many b (MkRn y m))
  (let-match many (eq-bit x y) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (neqb n m) (BTrue) ((BFalse) (BFalse)))
  (tail $ rn-eq A1 B1))

(def-fns _ $ (many rq-eq : (many (Rq) a b) -> (many (Bool) r))
  (let-match many a (MkRq q L h R))
  (let-match many b (MkRq q2 L2 h2 R2))
  (let-match many (neqb q q2) (BTrue) ((BFalse) (BFalse)))
  (let-match many (eq-bit h h2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (rn-eq L L2) (BTrue) ((BFalse) (BFalse)))
  (rn-eq R R2))

(def-fns _ $ (many fe-macro : (many (Bool) child) (many (LmC) lc) -> (many (Maybe (Rq)) r))
  (let ((many mp) (many rho)) (fe-of lc))
  (match many child _ ((BTrue) (m-child lc mp rho)) ((BFalse) (m-bcovf lc mp rho))))

(def-fns _ $ (many rs-maybe : (erased (Conf) c0) (many (Rs l3 c0) r) -> (many (Maybe (Rq)) m))
  (match many r _ ((RsOk _ _ e1 _) (Some _ e1)) ((RsNo _ _ _ _) (None _))))

(def-fns _ $ (many macro-at : (many (Nat) j) (many (Rq) e) (many (LmC) lc) -> (many (Maybe (Rq)) r))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let-match many (neqb j 6) (BFalse) ((BTrue) (rs-maybe c0 (try-bcovf c0 e ch))))
  (let-match many (neqb j 10) (BFalse) ((BTrue) (rs-maybe c0 (try-death c0 e ch))))
  (let-match many (neqb j 5) (BFalse) ((BTrue) (rs-maybe c0 (try-child c0 e ch))))
  (let-match many (neqb j 24) (BFalse) ((BTrue) (m-resume e)))
  (let-match many (neqb j 8) (BFalse) ((BTrue) (rs-maybe c0 (try-beven c0 e ch))))
  (let-match many (neqb j 7) (BFalse) ((BTrue) (rs-maybe c0 (try-reent c0 e ch))))
  (None _))

(def-fns _ $ (many chk : (subterm many (List (Nat)) js) (many (Nat) i mv) (many (Rq) e e2) (many (LmC) lc) (many (List (Nat)) cnt) (many (Rope) log)
    -> (many (List (Nat)) cnt2) (many (Rope) log2))
  (let-match many js (Cons _ j js1) ((Nil _) (values cnt log)))
  (let-match many cnt (Cons _ c cnt1) ((Nil _) (values cnt log)))
  (let-match many (lt-dec j (Succ i)) (Yes _ _ _ _ _) ((No _ _ _ _ _) (values cnt log)))
  (let ((many r)) (macro-at j e lc))
  (let ((many bad)) (RCat log (RCat (sp (sp (RStr "BAD") mv) j) (RChar #\newline))))
  (let ((many ok) (many log1)) (match many (neqb j i) (((Bool) ok) ((Rope) log1))
    ((BTrue) (match many r _ ((None _) (values (BFalse) bad)) ((Some _ e3) (match many (rq-eq e3 e2) _ ((BTrue) (values (BTrue) log)) ((BFalse) (values (BFalse) bad))))))
    ((BFalse) (match many r _ ((None _) (values (BTrue) log)) ((Some _ _) (values (BFalse) (RCat bad (RStr "  (fired early)\n"))))))))
  (let ((many c2)) (match many ok (((Nat) c2)) ((BTrue) (Succ c)) ((BFalse) c)))
  (let ((many cnt3) (many log3)) (notail $ chk js1 i mv e e2 lc cnt1 log1))
  (values (Cons _ c2 cnt3) log3))

(def-fns _ $ (many js-for : (many (Nat) mode i) (many (List (Nat)) js) -> (many (List (Nat)) js2))
  (let-match many mode (Succ _) ((Zero) js))
  (match many (neqb mode i) _ ((BTrue) (Cons _ i (Nil (Nat)))) ((BFalse) (Nil (Nat)))))

(def-fns _ $ (many chk-rep : (subterm many (Nat) rep) (many (List (Nat)) js) (many (Nat) i mv) (many (Rq) e e2) (many (List (Nat)) cnt) (many (Rope) log)
    -> (many (List (Nat)) cnt2) (many (Rope) log2))
  (let ((many cnt1) (many log1)) (chk js i mv e e2 (lmc e) cnt log))
  (let-match many rep (Succ r1) ((Zero) (values cnt1 log1)))
  (let-match many r1 (Succ _) ((Zero) (values cnt1 log1)))
  (tail $ chk-rep r1 js i mv e e2 cnt log))

(def-fns _ $ (many cloop : (many (Nat) mode rep) (subterm many (Nat) fuel) (many (Nat) mv) (many (List (Nat)) js) (many (Rq) e) (many (String) s) (many (List (Nat)) cnt) (many (Rope) log)
    -> (many (Nat) mv2) (many (List (Nat)) cnt2) (many (Rope) log2))
  (let-match many fuel (Succ f) ((Zero) (values mv cnt log)))
  (let ((many kind) (many s1)) (tok s))
  (let-match many kind (Succ _) ((Zero) (values mv cnt log)))
  (let ((many i) (many s2)) (tok s1))
  (let ((many e2) (many s3)) (rd-patch s2 e))
  (let ((many mv1)) (Succ mv))
  (let ((many js2)) (js-for mode i js))
  (let ((many cnt1) (many log1)) (match many js2 (((List (Nat)) c) ((Rope) l)) ((Nil _) (values cnt log)) ((Cons _ _ _) (chk-rep rep js2 i mv1 e e2 cnt log))))
  (tail $ cloop mode rep f mv1 js e2 s3 cnt1 log1))

(def-fns _ $ (many show-nats : (subterm many (List (Nat)) A) (many (Rope) acc) -> (many (Rope) r))
  (let-match many A (Cons _ a A1) ((Nil _) acc))
  (tail $ show-nats A1 (sp acc a)))

(def-fns _ $ (many zeros-like : (subterm many (List (Nat)) A) -> (many (List (Nat)) B))
  (let-match many A (Cons _ _ A1) ((Nil _) A))
  (Cons _ 0 (notail $ zeros-like A1)))

(def-fns _ $ (many cmain : (many (String) in) -> (many (String) out))
  (let ((many js)) (Cons _ 5 $ Cons _ 6 $ Cons _ 7 $ Cons _ 8 $ Cons _ 10 $ Cons _ 24 $ Nil (Nat)))
  (let ((many mode) (many s0)) (tok in))
  (let ((many rep) (many s1)) (tok s0))
  (let ((many e) (many s)) (rd-cfg s1))
  (let ((many mv) (many cnt) (many log)) (cloop mode rep 1000000000 0 js e s (zeros-like js) (RStr "")))
  (let ((many o) (erased _)) (flatten (RCat log (RCat (show-nats cnt (sp (RStr "MOVES") mv)) (RChar #\newline)))))
  o)
