(def-fns _ $ (many tdigits : (many (Nat) acc) (subterm many (List (Tk)) X) -> (many (Maybe (List (Nat))) D))
  (let-match many X (Cons _ x X1) ((Nil _) (let-match many (nat-zero-dec acc) (IsZero) ((IsSucc _) (None _))) (Some _ (Nil (Nat)))))
  (match many x _
    ((Tp) (tail $ tdigits (Succ acc) X1))
    ((T0) (let-match many (nat-zero-dec acc) (IsZero) ((IsSucc _) (None _)))
      (let-match many (notail $ tdigits (Zero) X1) (Some _ D1) ((None _) (None _)))
      (Some _ (Cons _ (Zero) D1)))
    ((T1) (let-match many (notail $ tdigits (Zero) X1) (Some _ D1) ((None _) (None _)))
      (Some _ (Cons _ (Succ acc) D1)))))

(def-fns _ $ (many nrev : (many (List (Nat)) A) (subterm many (List (Nat)) D) -> (many (List (Nat)) R))
  (let-match many D (Cons _ d D1) ((Nil _) A))
  (tail $ nrev (Cons _ d A) D1))

(def-fns _ $ (many nlen : (subterm many (List (Nat)) D) -> (many (Nat) n))
  (let-match many D (Cons _ _ D1) ((Nil _) (Zero)))
  (Succ (notail $ nlen D1)))

(def-fns _ $ (many lo3 : (many (Nat) l) (many (Ps) x0) (many (Ps) x1) (many (Ps) x2) -> (many (Maybe (Ps)) x))
  (let-match many l (Succ l1) ((Zero) (Some _ x0)))
  (let-match many l1 (Succ l2) ((Zero) (Some _ x1)))
  (let-match many l2 (Zero) ((Succ _) (None _)))
  (Some _ x2))

(def-fns _ $ (many pair-of : (many (Nat) h) (many (Nat) l) -> (many (Maybe (Ps)) x))
  (let-match many h (Succ h1) ((Zero) (lo3 l (PrC) (PrD) (PrDp))))
  (let-match many h1 (Zero) ((Succ _) (None _)))
  (lo3 l (PrA) (PrB) (PrBp)))

(def-fns _ $ (many pairs : (subterm many (List (Nat)) D) -> (many (Maybe (List (Ps))) w))
  (let-match many D (Cons _ a D1) ((Nil _) (Some _ (Nil (Ps)))))
  (let-match many D1 (Cons _ b D2) ((Nil _) (None _)))
  (let-match many (pair-of a b) (Some _ x) ((None _) (None _)))
  (let-match many (notail $ pairs D2) (Some _ w) ((None _) (None _)))
  (Some _ (Cons _ x w)))

(def-adts $ (Vl : -> Type)
  enum
  (many MkVl : (many (Nat) v) (many (Nat) k) -> (Vl)))

(def-fns _ $ (many vl-init : (subterm many (List (Nat)) D) -> (many (List (Vl)) V))
  (let-match many D (Cons _ d D1) ((Nil _) (Nil (Vl))))
  (Cons _ (MkVl d 1) (notail $ vl-init D1)))

(def-fns _ $ (many vl-pass : (subterm many (List (Vl)) V) -> (many (List (Vl)) W))
  (let-match many V (Cons _ a V1) ((Nil _) V))
  (let-match many V1 (Cons _ b V2) ((Nil _) V))
  (let-match many a (MkVl va ka))
  (let-match many b (MkVl vb kb))
  (Cons _ (MkVl (nat-add (nat-shl va (nat-add kb kb)) vb) (nat-add ka kb)) (notail $ vl-pass V2)))

(def-fns _ $ (many vl-loop : (subterm many (Nat) fuel) (many (List (Vl)) V) -> (many (Nat) v))
  (let-match many V (Cons _ a V1) ((Nil _) (Zero)))
  (let-match many a (MkVl va _))
  (let-match many V1 (Cons _ _ _) ((Nil _) va))
  (let-match many fuel (Succ f) ((Zero) (Zero)))
  (tail $ vl-loop f (vl-pass V)))

(def-fns _ $ (many b4 : (many (List (Nat)) D) -> (many (Nat) v))
  (vl-loop (nlen D) (vl-init D)))

(def-fns _ $ (many nreps : (many (Nat) a) (subterm many (List (Ps)) w) -> (many (List (Nat)) D))
  (let-match many w (Cons _ _ w1) ((Nil _) (Nil (Nat))))
  (Cons _ a (notail $ nreps a w1)))

(def-fns _ $ (many rdig : (many (Nat) acc cs) (subterm many (List (Ps)) w) -> (many (List (Nat)) D) (many (Nat) cs2))
  (let-match many w (Cons _ x w1) ((Nil _) (values (Nil (Nat)) cs)))
  (let ((many d) (many c) (many rs))
    (match many x (((Nat) d) ((Nat) c) ((Bool) rs))
      ((PrDp) (values 0 0 (BTrue)))
      ((PrD) (values 0 1 (BFalse)))
      ((PrC) (values 1 1 (BFalse)))
      ((PrBp) (values 2 1 (BTrue)))
      ((PrB) (values 2 2 (BFalse)))
      ((PrA) (values 3 2 (BFalse)))))
  (let ((many a1)) (nat-add acc d))
  (let ((many c1)) (nat-add cs c))
  (let-match many rs (BFalse) ((BTrue) (values (Cons _ a1 (nreps a1 w1)) c1)))
  (let ((many D1) (many cs2)) (notail $ rdig a1 c1 w1))
  (values (Cons _ a1 D1) cs2))

(def-fns _ $ (many rho-of : (many (List (Ps)) w) -> (many (Nat) r) (many (Nat) l))
  (let ((many D) (many cs)) (rdig 0 0 w))
  (values (nat-add (b4 D) cs) (b4 (Cons _ 1 (nreps 1 w)))))

(def-fns _ $ (many odd-s : (many (Nat) h) (many (Nat) r) (many (Nat) l) -> (many (Nat) s))
  (let-match many h (Succ h1) ((Zero) (let ((many s) (erased _)) (add r l)) (Succ s)))
  (let-match many h1 (Succ _) ((Zero) (Succ r)))
  (Zero))

(def-adts $ (Dec : -> Type)
  enum
  (many DecOk : (many (Fam) F) (many (Nat) s) -> (Dec))
  (many DecNo : -> (Dec)))

(def-fns _ $ (many tail-lo : (many (Tt) T) -> (many (Maybe (Nat)) lo))
  (match many T _
    ((Tt11) (Some _ (Zero)))
    ((Tt011) (Some _ (Succ (Zero))))
    ((Tt0011) (Some _ (Succ (Succ (Zero)))))
    (else (None _))))

(def-fns _ $ (many napp : (subterm many (List (Nat)) A) (many (List (Nat)) B) -> (many (List (Nat)) C))
  (let-match many A (Cons _ a A1) ((Nil _) B))
  (Cons _ a (notail $ napp A1 B)))

(def-fns _ $ (many fam-of : (many (Bool) v2) (many (Bool) odd) (many (Nat) P) (many (Tt) T) -> (many (Fam) F))
  (match many v2 _
    ((BFalse) (match many odd _ ((BFalse) (FE P T)) ((BTrue) (FO P T))))
    ((BTrue) (match many odd _ ((BFalse) (FVE (Succ P))) ((BTrue) (FVO (Succ P)))))))

(def-fns _ $ (many dec-pairs : (many (Bool) v2) (many (List (Nat)) B) (many (List (Nat)) E) (many (Tt) T) -> (many (Dec) r))
  (let ((many n) (many par) (erased _) (erased _) (erased _) (erased _)) (divmod (nlen B) (Succ (Succ (Zero))) (LtZ _)))
  (let-match many par (Succ _) ((Zero)
    (let-match many (pairs (napp B E)) (Some _ w) ((None _) (DecNo)))
    (let ((many r) (many l)) (rho-of w))
    (DecOk (fam-of v2 (BFalse) n T) r)))
  (let-match many B (Cons _ h B1) ((Nil _) (DecNo)))
  (let-match many (pairs (napp B1 E)) (Some _ w) ((None _) (DecNo)))
  (let ((many r) (many l)) (rho-of w))
  (DecOk (fam-of v2 (BTrue) n T) (odd-s h r l)))

(def-fns _ $ (many decode : (many (List (Tk)) X) (many (Tt) T) -> (many (Dec) r))
  (let-match many (tdigits (Zero) X) (Some _ D) ((None _) (DecNo)))
  (let-match many D (Cons _ d0 D1) ((Nil _) (DecNo)))
  (let-match many (nat-eq d0 2) (Equal _ _ _) (else (DecNo)))
  (let-match many (nrev (Nil (Nat)) D1) (Cons _ last RR) ((Nil _) (DecNo)))
  (let ((many B)) (nrev (Nil (Nat)) RR))
  (let-match many (tail-lo T) (Some _ lo) ((None _)
    (let-match many (nat-zero-dec last) (IsZero) ((IsSucc _) (DecNo)))
    (dec-pairs (BFalse) B (Nil (Nat)) T)))
  (dec-pairs (BTrue) B (Cons _ last (Cons _ lo (Nil (Nat)))) T))
