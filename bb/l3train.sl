  (let-match erased (mul-fn k n3 mm m mk2 mk) (Refl _ _))
  (let-match many (next-phi P s1 h x w D Z g en) (NxOk _ _ _ _ _ s2 n2v mx2 bn2 Y ph2 a3) ((NxNo _ _ _ _ _) miss))
  (TrOk P s X xr x0 s2 n2v mx2 bn2 Y ph2 (Succ $ Succ $ Succ $ Succ $ Succ $ Succ $ Succ $ Succ c2) (rl-ap3 Z Y (Zero) _ a3 (rl-s8 Z c2 rz)) R4 y zr d4 (xb-ap3 Z Y y zr a3 zb) m x3 p1 t run))

(def-fns _ $ (many land-k : (subterm many (Nat) tries) (many (Nat) G k) (many (Nat) P s) (erased (Nat) n) (erased (MaxS (FO P (TtE)) n) mx) (erased (Lt s (Succ n)) bn)
    (erased (List (Tk)) X) (erased (Phi (FO P (TtE)) s X (TtE)) ph) (many (Nat) e) (erased (Rl X (Zero) e) re)
    (many (List (Rn)) Rt) (erased (List (Bool)) rc xr) (erased (Den Rt rc) dr) (erased (Xb X rc xr) xb)
    (erased (Nat) nn) (erased (List (Bool)) lz x0) (erased (Rp (BTrue) nn lz x0) p0)
    -> (many (TrS P s X xr x0) r))
  (let ((many r)) (land k P s n mx bn X ph e re Rt rc xr dr xb nn lz x0 p0))
  (let-match many tries (Succ t1) ((Zero) r))
  (let-match many r (TrNo _ _ _ _ _ w) (else r))
  (let-match many w (Succ _) ((Zero) r))
  (let ((many g2)) (monus G 2))
  (let ((many up) (many _) (erased _) (erased _) (erased _) (erased _)) (divmod (monus g2 w) (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let ((many dn) (many _) (erased _) (erased _) (erased _) (erased _)) (divmod (monus w g2) (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let-match many (nat-zero-dec (nat-add up dn)) (IsSucc _) ((IsZero) r))
  (tail $ land-k t1 G (monus (nat-add k up) dn) P s n mx bn X ph e re Rt rc xr dr xb nn lz x0 p0))

(def-adts
  ((TrL : ((Nat) P s) ((List (Tk)) X) ((List (Bool)) xr x0) -> Type)
    enum
    (many MkTrL : (erased (Nat) P s) (erased (List (Tk)) X) (erased (List (Bool)) xr x0)
       (many (Nat) P2 s2) (erased (Nat) n2) (erased (MaxS (FO P2 (TtE)) n2) mx2) (erased (Lt s2 (Succ n2)) bn2)
       (erased (List (Tk)) X2) (erased (Phi (FO P2 (TtE)) s2 X2 (TtE)) ph2)
       (many (List (Rn)) Rt2) (erased (List (Bool)) rc2 xr2) (erased (Den Rt2 rc2) dr2) (erased (Xb X2 rc2 xr2) xb2)
       (many (Nat) M) (erased (List (Bool)) x3) (erased (Rp (BTrue) M x0 x3) pm)
       (erased (Nat) t) (erased (Run l3 (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr)) t (MkConf 2 (bits "00" x3) (BTrue) (bits "0" xr2))) run)
       -> (TrL P s X xr x0))))

(def-fns _ $ (many train-loop : (subterm many (Nat) fuel) (many (Nat) P s) (erased (Nat) n) (erased (MaxS (FO P (TtE)) n) mx) (erased (Lt s (Succ n)) bn)
    (erased (List (Tk)) X) (erased (Phi (FO P (TtE)) s X (TtE)) ph) (many (Nat) e) (erased (Rl X (Zero) e) re)
    (many (List (Rn)) Rt) (erased (List (Bool)) rc xr) (erased (Den Rt rc) dr) (erased (Xb X rc xr) xb)
    (erased (Nat) nn) (erased (List (Bool)) lz x0) (erased (Rp (BTrue) nn lz x0) p0)
    -> (many (TrL P s X xr x0) r))
  (let ((many stop)) (MkTrL P s X xr x0 P s n mx bn X ph Rt rc xr dr xb (Zero) x0 (RpZ _ x0) (Zero) (RNil l3 _)))
  (let-match many fuel (Succ f) ((Zero) stop))
  (let-match many (train-ahead Rt) (Some _ G) ((None _) stop))
  (let ((many k0) (many _) (erased _) (erased _) (erased _) (erased _)) (divmod G (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let-match many (land-k 3 G k0 P s n mx bn X ph e re Rt rc xr dr xb nn lz x0 p0)
    (TrOk _ _ _ _ _ s2 n2 mx2 bn2 X2 ph2 e2 re2 Rt2 rc2 xr2 dr2 xb2 m x3 p1 t1 run1) ((TrNo _ _ _ _ _ _) stop))
  (let-match many (notail $ train-loop f (Succ P) s2 n2 mx2 bn2 X2 ph2 e2 re2 Rt2 rc2 xr2 dr2 xb2 m x0 x3 p1)
    (MkTrL _ _ _ _ _ P3 s3 n3v mx3 bn3 X3 ph3 Rt3 rc3 xr3 dr3 xb3 M x4 pm t2 run2))
  (let ((many M2) (erased aM)) (add M m))
  (let ((erased u) (erased run3)) (run-cat l3 _ _ _ t1 t2 run1 run2))
  (MkTrL P s X xr x0 P3 s3 n3v mx3 bn3 X3 ph3 Rt3 rc3 xr3 dr3 xb3 M2 x4 (rp-add (BTrue) M m M2 x0 x3 x4 pm p1 aM) u run3))

(def-fns _ $ (many try-train : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (PX) px) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many px (MkPX X0 T0 rest) ((NoPX) no))
  (let-match many T0 (TtE) (else no))
  (let-match many (train-ahead rest) (Some _ _) ((None _) no))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ l r dl dr))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) no))
  (let-match erased eq (Refl _ _))
  (let-match many h (BTrue) ((BFalse) no))
  (let-match many (decode X0 T0) (DecOk F s) ((DecNo) no))
  (let-match many F (FO P T) (else no))
  (let-match many T (TtE) (else no))
  (let ((many n) (erased mx)) (maxs-run (FO P (TtE))))
  (let-match many (lt-dec s (Succ n)) (Yes _ _ _ _ bn) ((No _ _ _ _ _) no))
  (let ((many X) (many T1) (erased ph)) (phi-run (FO P (TtE)) s n (OkO P (TtE) (PlE)) mx bn))
  (let-match erased ph (PhO _ _ _ _ _ _ _ _ _ _ _ _))
  (let ((many ex) (erased a1) (erased b1) (erased ra1) (erased tb1) (erased ae1)) (cells X (TtE)))
  (let-match erased tb1 (TwE _))
  (let-match erased (add-fn a1 (Zero) ex a1 ae1 (add-zero-right a1)) (Refl _ _))
  (let-match many (strip (bits "00" (Nil (Bool))) L l dl) (StOk _ _ x0 L0 d0 cl) ((StNo _ _) no))
  (let-match erased cl (CatC _ _ _ _ _ cl1))
  (let-match erased cl1 (CatC _ _ _ _ _ cl2))
  (let-match erased cl2 (CatN _ _))
  (let ((many nn) (erased lz) (erased p0)) (ones L0 x0 d0))
  (let-match many (strip (bits "0" (Nil (Bool))) R r dr) (StOk _ _ xr R1 d1 cr) ((StNo _ _) no))
  (let-match erased cr (CatC _ _ _ _ _ cr1))
  (let-match erased cr1 (CatN _ _))
  (let-match many (xtr X (TtE)) (MkXTR _ _ UU u pu du))
  (let-match many (strip-runs UU u du R1 xr d1) (StOk _ _ rc R2 d2 cu) ((StNo _ _) no))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X (TtE) u rc xr pu cu))
  (let-match erased tb (TbE _))
  (let-match many (train-loop 1000000 P s n mx bn X ph ex ra1 R2 rc xr d2 xb nn lz x0 p0)
    (MkTrL _ _ _ _ _ P2 s2 n2v mx2 bn2 Xf ph2 Rt rc2 xr2 dr2 xb2 M x3 pm t run))
  (let-match many M (Succ _) ((Zero) no))
  (let ((many Xr) (many Tr) (erased ph3)) (phi-run (FO P2 (TtE)) s2 n2v (OkO P2 (TtE) (PlE)) mx2 bn2))
  (let-match erased ph3 (PhO _ _ _ _ _ _ _ _ _ _ _ _))
  (let-match erased (pho-fn P2 s2 (TtE) Xf Xr ph2 ph3) (Refl _ _))
  (let ((many La) (erased xa) (erased pa) (erased da)) (pushrun (BTrue) M L0 x0 d0))
  (let-match erased (rp-fn (BTrue) M x0 xa x3 pa pm) (Refl _ _))
  (let ((many Lb) (erased db)) (push (BFalse) La x3 da))
  (let ((many Lc) (erased dLc)) (push (BFalse) Lb _ db))
  (let-match many (xtr Xr Tr) (MkXTR _ _ U3 u3 pu3 du3))
  (let ((many Ra) (erased ya) (erased dya) (erased ca)) (push-runs U3 u3 du3 Rt rc2 dr2))
  (let ((erased v3) (erased tb3) (erased zb3)) (xt-cat Xr Tr u3 rc2 ya pu3 ca))
  (let-match erased tb3 (TbE _))
  (let-match erased (xb-fn Xr rc2 xr2 ya xb2 zb3) (Refl _ _))
  (let ((many Rb) (erased dRb)) (push (BFalse) Ra xr2 dya))
  (RsOk l3 c0 (MkRq 2 Lc (BTrue) Rb)
    (rch-run l3 c0 c _ e _ t ch dc run (MkDc 2 Lc Rb (BTrue) (bits "00" x3) (bits "0" xr2) dLc dRb))))

(def-fns _ $ (many l3move4 : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) r))
  (let-match many e (MkRq q L h R))
  (let-match many (lmom q h L) (BTrue) ((BFalse) (walk-move m2 mm c0 e ch)))
  (let ((many px)) (lparse e))
  (let-match many (try-train c0 e ch px) (RsNo _ _ e1 ch1) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (lmom-move m2 mm c0 e1 ch1 px))

(def-fns _ $ (many l3run4 : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    -> (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values e ch)))
  (let-match many (l3move4 m2 mm c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values e1 ch1)))
  (tail $ l3run4 m2 mm c0 f e1 ch1))
