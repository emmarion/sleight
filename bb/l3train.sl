      (let-match erased g2 (DgC _ _ _ _ _ _ g3 p))
      (let-match erased g3 (DgN _))
      (let-match erased p (D2Dp))
      (E3N))
    ((SnC x w1 w3 s1)
      (let-match erased g (DgC _ h l _ _ D1 g1 p))
      (let-match erased g2 (DgC _ h2 l2 _ _ D3 g3 p2))
      (let ((erased e1) (erased e2)) (dig2-fn x h l h2 l2 p p2))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (E3C h _ _ (E3C l _ _ (dg-ex3 w1 w3 D1 D3 s1 g1 g3))))))

(def-fns _ $ (erased xb-ap3 : (erased (List (Tk)) Z Y) (erased (List (Bool)) y x) (subterm erased (Ap3 Z Y) a)
    (erased (Xb Z (bits "00111111" y) x) xb) -> (erased (Xb Y y x) q))
  (match erased a _
    ((A3N) (let-match erased xb (XbN _)) (XbP _ y _ (XbO _ y _ (XbZ _ y y (XbN y)))))
