(def-fns _ $ (erased enc-rl : (erased (List (Nat)) D) (erased (List (Tk)) X) (erased (Nat) n) (subterm erased (DEnc D X) e) (erased (Ds D n) ds)
    -> (erased (Rl X (Zero) n) r))
