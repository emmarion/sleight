(def-fns _ $ (many ps-eq : (many (Ps) x y) -> (many (ErasedMaybe (Eq (Ps) x y)) r))
  (match many x _
    ((PrA) (match many y _ ((PrA) (ESome _ (Refl _ x))) (else (ENone _))))
    ((PrB) (match many y _ ((PrB) (ESome _ (Refl _ x))) (else (ENone _))))
    ((PrBp) (match many y _ ((PrBp) (ESome _ (Refl _ x))) (else (ENone _))))
    ((PrC) (match many y _ ((PrC) (ESome _ (Refl _ x))) (else (ENone _))))
    ((PrD) (match many y _ ((PrD) (ESome _ (Refl _ x))) (else (ENone _))))
