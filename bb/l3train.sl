        ((XbZ _ _ x1 p) (XbZ Y1 y x1 (xb-ap3 X1 Y1 y x1 a1 p)))
        ((XbO _ _ x1 p) (XbO Y1 y x1 (xb-ap3 X1 Y1 y x1 a1 p)))))))

(def-fns _ $ (erased rl-ap3 : (erased (List (Tk)) Z Y) (erased (Nat) z n) (subterm erased (Ap3 Z Y) a)
    (erased (Rl Z (Succ $ Succ $ Succ $ Succ $ Succ $ Succ $ Succ $ Succ z) n) r) -> (erased (Rl Y z n) q))
