    ((EnN) (let-match erased ds (DsN)) (RlN (Zero)))
    ((EnC d D1 X1 _ e1 t)
      (let-match erased ds (DsC _ n1 a _ ds1 ad))
      (let ((erased r1)) (enc-rl D1 X1 n1 e1 ds1))
      (match erased t _
        ((DtZ _) (let-match erased ad (AddZero _)) (RlZ X1 (Zero) n1 r1))
        ((DtS k _ _ p)
