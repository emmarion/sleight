(def-adts
  ((Ap3 : ((List (Tk)) X) ((List (Tk)) Y) -> Type)
    enum
    (many A3N : -> (Ap3 (Nil (Tk)) (Cons (Tk) (Tp) $ Cons (Tk) (T1) $ Cons (Tk) (T0) $ Nil (Tk))))
    (many A3C : (erased (Tk) t) (erased (List (Tk)) X Y) (erased (Ap3 X Y) p) -> (Ap3 (Cons (Tk) t X) (Cons (Tk) t Y)))))

(def-adts
  ((Ex3 : ((List (Nat)) D) ((List (Nat)) D2) -> Type)
    enum
    (many E3N : -> (Ex3 (Cons (Nat) (Zero) (Nil (Nat))) (Cons (Nat) (Zero) $ Cons (Nat) n2 $ Cons (Nat) (Zero) $ Nil (Nat))))
    (many E3C : (erased (Nat) d) (erased (List (Nat)) D D2) (erased (Ex3 D D2) p) -> (Ex3 (Cons (Nat) d D) (Cons (Nat) d D2)))))

(def-adts
  ((Sn : ((List (Ps)) w) ((List (Ps)) w2) -> Type)
    enum
    (many SnN : -> (Sn (Nil (Ps)) (Cons (Ps) (PrDp) (Nil (Ps)))))
    (many SnC : (erased (Ps) x) (erased (List (Ps)) w w2) (erased (Sn w w2) p) -> (Sn (Cons (Ps) x w) (Cons (Ps) x w2)))))

(def-adts
  ((Ds : ((List (Nat)) D) ((Nat) n) -> Type)
    enum
    (many DsN : -> (Ds (Nil (Nat)) (Zero)))
    (many DsC : (erased (Nat) d n a) (erased (List (Nat)) D) (erased (Ds D n) p) (erased (Add d n a) q)
       -> (Ds (Cons (Nat) d D) (Succ (Succ (Succ a)))))))

(def-fns _ $ (erased tpr-ap3 : (erased (Nat) m) (erased (List (Tk)) R R2 X Y) (subterm erased (TpR m R X) p) (erased (TpR m R2 Y) q)
    (erased (Ap3 R R2) a) -> (erased (Ap3 X Y) b))
  (match erased p _
    ((TpZ _) (let-match erased q (TpZ _)) a)
    ((TpS m1 _ X1 p1) (let-match erased q (TpS _ _ Y1 q1)) (A3C (Tp) X1 Y1 (tpr-ap3 m1 R R2 X1 Y1 p1 q1 a)))))

(def-fns _ $ (erased enc-ap3 : (erased (List (Nat)) D D2) (erased (List (Tk)) X Y) (subterm erased (Ex3 D D2) x) (erased (DEnc D X) e)
    (erased (DEnc D2 Y) f) -> (erased (Ap3 X Y) a))
  (match erased x _
    ((E3N)
      (let-match erased e (EnC _ _ X1 _ e1 t))
      (let-match erased e1 (EnN))
      (let-match erased t (DtZ _))
      (let-match erased f (EnC _ _ Y1 _ f1 u))
      (let-match erased u (DtZ _))
      (let-match erased f1 (EnC _ _ Y2 _ f2 u2))
      (let-match erased u2 (DtS _ _ _ v))
      (let-match erased v (TpS _ _ _ v1))
      (let-match erased v1 (TpZ _))
      (let-match erased f2 (EnC _ _ Y3 _ f3 u3))
      (let-match erased f3 (EnN))
      (let-match erased u3 (DtZ _))
      (A3C (T0) _ _ (A3N)))
    ((E3C d D1 D3 x1)
      (let-match erased e (EnC _ _ X1 _ e1 t))
      (let-match erased f (EnC _ _ Y1 _ f1 u))
      (let ((erased a1)) (enc-ap3 D1 D3 X1 Y1 x1 e1 f1))
      (match erased t _
        ((DtZ _) (let-match erased u (DtZ _)) (A3C (T0) X1 Y1 a1))
        ((DtS k _ _ p1) (let-match erased u (DtS _ _ _ q1)) (tpr-ap3 k _ _ X Y p1 q1 (A3C (T1) X1 Y1 a1)))))))

(def-fns _ $ (erased dg-ex3 : (erased (List (Ps)) w w2) (erased (List (Nat)) D D2) (subterm erased (Sn w w2) s)
    (erased (Dg w (Cons (Nat) (Zero) (Nil (Nat))) D) g) (erased (Dg w2 (Cons (Nat) (Zero) (Nil (Nat))) D2) g2) -> (erased (Ex3 D D2) x))
