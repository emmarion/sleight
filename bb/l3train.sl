          (let-match erased ad (AddSucc _ _ a1 ad1))
          (let ((erased a3)) (add-succ-right k _ _ $ add-succ-right k _ _ $ add-succ-right k _ _ $ add-succ-right k _ _ ad1))
          (let-match erased (add-fn k _ u2 _ a2 a3) (Refl _ _))
          r2)))))

