  (let-match many (stripz wv Rt rc dr) (SzOk _ _ r R3 d3 pw) ((SzNo _ _) miss))
  (let-match many (strip (bits "00111111" (Nil (Bool))) R3 r d3) (StOk _ _ y R4 d4 cy) ((StNo _ _) miss))
