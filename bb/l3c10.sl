(sk-family Sk4 MkSk4 sk4-of ()
  (c-wipe (2 DR "1" TV "1" TV) (2 DL "1" TV "0" TV))
  (c-chain (2 DR "0" TV "0" TV) (2 DL "0" TV "1" TV)))
(comptime-match many (sk4-of p3) (ROk _ sg4))

(def-fns _ $ (erased cez-refl : (erased (Conf) c) -> (erased (CEz c c) z))
  (let-match erased c (MkConf q l h r))
  (MkCEz q l r l r h (eqz-refl l) (eqz-refl r)))

(def-fns _ $ (erased cez-sym : (erased (Conf) c d) (erased (CEz c d) z) -> (erased (CEz d c) z2))
  (let-match erased z (MkCEz q l r l2 r2 h el er))
  (MkCEz q l2 r2 l r h (eqz-sym l l2 el) (eqz-sym r r2 er)))

(def-fns _ $ (erased cez-trans : (erased (Conf) a b c) (erased (CEz a b) x) (erased (CEz b c) y) -> (erased (CEz a c) z))
  (let-match erased x (MkCEz q l r l2 r2 h el er))
  (let-match erased y (MkCEz _ _ _ l4 rr4 _ fl fr))
  (MkCEz q l r l4 rr4 h (eqz-trans l l2 l4 el fl) (eqz-trans r r2 rr4 er fr)))

(def-fns _ $ (erased rch-z : (erased (List (Tr)) m) (erased (Conf) c0 c c1 d d2) (erased (Rq) e e2) (erased (Nat) s)
    (erased (Rch m c0 e) ch) (erased (Dc e c) dc) (erased (CEz c c1) z1) (erased (Run m c1 s d) r) (erased (Dc e2 d2) dc2) (erased (CEz d d2) z2)
    -> (erased (Rch m c0 e2) ch2))
  (let-match erased ch (MkRch _ _ a c3 _ t r0 dc3 z))
  (let-match erased (dc-fn e c c3 dc dc3) (Refl _ _))
  (let ((erased a2) (erased r2) (erased za)) (run-eqz m c1 d a s r (cez-trans c1 c a (cez-sym c c1 z1) z)))
  (let ((erased u) (erased r3)) (run-cat m c0 a a2 t s r0 r2))
  (MkRch m c0 a2 d2 e2 u r3 dc2 (cez-trans d2 d a2 (cez-sym d d2 z2) za)))

(def-fns _ $ (erased rch-self : (erased (List (Tr)) m) (erased (Rq) e) -> (erased (Conf) c) (erased (Rch m c e) ch))
  (let-match erased e (MkRq q L h R))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (values (MkConf q l h r) (MkRch m _ _ _ e (Zero) (RNil m (MkConf q l h r)) (MkDc q L R h l r dl dr) (cez-refl (MkConf q l h r)))))

(def-fns _ $ (many cpushn : (many (Bool) b) (many (Nat) n) (many (List (Rn)) L) (erased (List (Bool)) x) (erased (Den L x) d)
    -> (many (List (Rn)) L2) (erased (List (Bool)) y z) (erased (Den L2 y) d2) (erased (Rp b n x z) p) (erased (Eqz y z) ez))
  (let-match many (nat-zero-dec n) (IsSucc _) ((IsZero) (values L x x d (RpZ b x) (eqz-refl x))))
  (let-match many L (Cons _ _ _) ((Nil _)
    (let-match erased d (DeN))
    (let ((erased z) (erased p)) (rp-ex b n (Nil (Bool))))
    (match many b _
      ((BFalse) (values (Nil (Rn)) (Nil (Bool)) z (DeN) p (EZ _ _ (ZN) (rp-zeros n _ z p (ZN)))))
      ((BTrue) (values (Cons _ (MkRn b n) (Nil (Rn))) z z (DeC b n (Nil (Rn)) (Nil (Bool)) z (DeN) p) p (eqz-refl z))))))
  (let ((many L2) (erased y) (erased p) (erased d2)) (pushrun b n L x d))
  (values L2 y y d2 p (eqz-refl y)))

(def-fns _ $ (many rapp : (subterm many (List (Rn)) A) (erased (List (Bool)) a) (erased (Den A a) da) (many (List (Rn)) Bs) (erased (List (Bool)) b) (erased (Den Bs b) db)
    -> (many (List (Rn)) C) (erased (List (Bool)) c) (erased (Den C c) dc) (erased (Cat (Bool) a b c) ct))
  (let-match many A (Cons _ rn A1) ((Nil _) (let-match erased da (DeN)) (values Bs b db (CatN _ b))))
  (let-match erased da (DeC x k _ a1 _ da1 p))
  (let ((many C1) (erased c1) (erased dc1) (erased ct1)) (notail $ rapp A1 a1 da1 Bs b db))
  (let ((erased c2) (erased q)) (rp-ex x k c1))
  (values (Cons _ rn C1) c2 (DeC x k C1 c1 c2 dc1 q) (rp-cat x k a1 a b c1 c2 p q ct1)))

(def-fns _ $ (many rstrip : (subterm many (List (Rn)) A) (erased (List (Bool)) u) (erased (Den A u) du) (many (List (Rn)) L) (erased (List (Bool)) x) (erased (Den L x) d)
    -> (many (Strip u x) s))
  (let-match many A (Cons _ ra A1) ((Nil _) (let-match erased du (DeN)) (StOk u x x L d (CatN _ x))))
  (let-match many L (Cons _ rl L1) ((Nil _) (StNo u x)))
  (let-match many ra (MkRn b k))
  (let-match many rl (MkRn b2 k2))
  (let-match many (eq-bit b b2) (ESome _ e1) ((ENone _) (StNo u x)))
  (let-match many (eq-nat k k2) (ESome _ e2) ((ENone _) (StNo u x)))
  (let-match erased e1 (Refl _ _))
  (let-match erased e2 (Refl _ _))
  (let-match erased du (DeC _ _ _ u1 _ du1 pu))
  (let-match erased d (DeC _ _ _ x1 _ d1 px))
  (let-match many (notail $ rstrip A1 u1 du1 L1 x1 d1) (StOk _ _ y L2 d2 c) ((StNo _ _) (StNo u x)))
  (StOk u x y L2 d2 (rp-cat b k u1 u y x1 x pu px c)))

(def-adts
  ((CTake : ((Nat) w) ((List (Bool)) x) -> Type)
    enum
    (many CtOk : (erased (Nat) w) (erased (List (Bool)) x r rc) (many (List (Rn)) L) (erased (Den L r) d) (erased (Rp (BFalse) w r rc) p) (erased (Eqz x rc) ez)
       -> (CTake w x))
    (many CtNo : (erased (Nat) w) (erased (List (Bool)) x) -> (CTake w x))))

(def-fns _ $ (many rest-take : (many (List (Rn)) R) (erased (List (Bool)) x) (erased (Den R x) d) (many (Nat) u) -> (many (CTake u x) t))
  (let ((erased rc) (erased prc)) (rp-ex (BFalse) u (Nil (Bool))))
  (let ((erased zrc)) (rp-zeros u _ rc prc (ZN)))
  (let-match many R (Cons _ rn R1) ((Nil _) (let-match erased d (DeN)) (CtOk u x (Nil (Bool)) rc (Nil (Rn)) (DeN) prc (EZ _ _ (ZN) zrc))))
  (let-match many rn (MkRn b g))
  (let-match erased d (DeC _ _ _ x1 _ d1 pg))
  (let-match many b (BFalse)
    ((BTrue) (let-match many (nat-zero-dec u) (IsZero) ((IsSucc _) (CtNo u x))) (CtOk u x x x R d (RpZ _ x) (eqz-refl x))))
  (let-match many (lt-dec g u) (No _ _ _ _ le)
    ((Yes _ _ _ _ _)
      (let-match many R1 (Nil _) ((Cons _ _ _) (CtNo u x)))
      (let-match erased d1 (DeN))
      (CtOk u x (Nil (Bool)) rc (Nil (Rn)) (DeN) prc (EZ _ _ (rp-zeros g _ x pg (ZN)) zrc))))
  (let ((many k) (erased a)) (sub g u (le-lt-succ _ _ le)))
  (let ((erased mid) (erased pk) (erased pu)) (rp-split (BFalse) u k g x1 x a pg))
  (let ((many R2) (erased y) (erased z) (erased d2) (erased pz) (erased ez)) (cpushn (BFalse) k R1 x1 d1))
  (let-match erased (rp-fn (BFalse) k x1 z mid pz pk) (Refl _ _))
  (let ((erased rc2) (erased prc2)) (rp-ex (BFalse) u y))
  (CtOk u x y rc2 R2 d2 prc2 (rp-eqz (BFalse) u z y x rc2 pu prc2 (eqz-sym y z ez))))

(def-adts
  ((LSp : ((List (Bool)) l) -> Type)
    enum
    (many LSpOk : (erased (List (Bool)) lz x0) (many (Nat) n) (many (List (Rn)) L0) (erased (Den L0 lz) d) (erased (Rp (BTrue) n lz x0) p)
       -> (LSp (bits "00" x0)))
    (many LSpNo : (erased (List (Bool)) l) -> (LSp l))))

(def-fns _ $ (many left-split : (many (List (Rn)) L) (erased (List (Bool)) l) (erased (Den L l) d) -> (many (LSp l) r))
  (let-match many L (Cons _ rn rest) ((Nil _) (LSpNo l)))
  (let-match many rn (MkRn b a))
  (let-match many b (BFalse) ((BTrue) (LSpNo l)))
  (let-match many a (Succ a1) ((Zero) (LSpNo l)))
  (let-match many a1 (Succ k) ((Zero) (LSpNo l)))
  (let-match erased d (DeC _ _ _ t _ d1 p))
  (let-match erased p (RpS _ _ _ l1 p1))
  (let-match erased p1 (RpS _ _ _ mid p2))
  (let-match many k (Succ _)
    ((Zero)
      (let-match erased p2 (RpZ _ _))
      (let-match many rest (Cons _ r1 L0) ((Nil _) (LSpOk t t (Zero) rest d1 (RpZ _ t))))
      (let-match many r1 (MkRn b1 n))
      (let-match many b1 (BTrue) ((BFalse) (LSpOk t t (Zero) rest d1 (RpZ _ t))))
      (let-match erased d1 (DeC _ _ _ lz _ d0 pn))
      (LSpOk lz t n L0 d0 pn)))
  (LSpOk mid mid (Zero) (Cons _ (MkRn (BFalse) k) rest) (DeC (BFalse) k rest t mid d1 p2) (RpZ _ mid)))

(def-fns _ $ (erased wipe-go : (erased (Nat) p) (erased (List (Bool)) l x r) (subterm erased (Rp (BTrue) p l x) rp)
    -> (erased (List (Bool)) y) (erased (Rp (BFalse) p r y) q) (erased (Go (MkTc 2 (DR) x (Cons (Bool) (BTrue) r)) (MkTc 2 (DR) l (Cons (Bool) (BTrue) y))) g))
  (let-match erased rp (RpS _ p1 _ x1 rp1) ((RpZ _ _) (values r (RpZ _ r) (go-refl _))))
  (let ((erased y) (erased q) (erased g)) (wipe-go p1 l x1 (bits "0" r) rp1))
  (values y (rp-snoc _ p1 r y q) (go-cat _ _ _ (go-dl _ _ _ _ _ (c-wipe p3 sg4 x1 r)) g)))

(def-fns _ $ (erased chain-go : (erased (Nat) p) (erased (List (Bool)) l x r) (subterm erased (Rp (BFalse) p l x) rp)
    -> (erased (List (Bool)) y) (erased (Rp (BTrue) p r y) q) (erased (Go (MkTc 2 (DR) x (Cons (Bool) (BFalse) r)) (MkTc 2 (DR) l (Cons (Bool) (BFalse) y))) g))
  (let-match erased rp (RpS _ p1 _ x1 rp1) ((RpZ _ _) (values r (RpZ _ r) (go-refl _))))
  (let ((erased y) (erased q) (erased g)) (chain-go p1 l x1 (bits "1" r) rp1))
  (values y (rp-snoc _ p1 r y q) (go-cat _ _ _ (go-dl _ _ _ _ _ (c-chain p3 sg4 x1 r)) g)))

(def-fns _ $ (many c-step1 : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ l r dl dr))
  (let-match many (tlook l3 q h) (LkOk _ _ _ tr lk) ((LkNo _ _ _) (RsNo l3 c0 e ch)))
  (let-match many tr (Mov w d q2) ((Hlt) (RsNo l3 c0 e ch)))
  (let ((erased one)) (Succ (Zero)))
  (match many d _
    ((DL)
      (let ((many h2) (many L2) (erased l2) (erased pp) (erased dl2)) (rpop L l dl))
      (let ((many R2) (erased y) (erased z2) (erased d2) (erased p) (erased ez)) (cpushn w (Succ (Zero)) R r dr))
      (let-match erased p (RpS _ _ _ _ p1))
      (let-match erased p1 (RpZ _ _))
      (RsOk l3 c0 (MkRq q2 L2 h2 R2)
        (rch-z l3 c0 c c _ _ e _ one ch dc (cez-refl c) (RSnoc l3 c c _ (Zero) (RNil l3 c) (StepL l3 q q2 l r l2 h w h2 lk pp))
          (MkDc q2 L2 R2 h2 l2 y dl2 d2) (MkCEz q2 l2 (Cons (Bool) w r) l2 y h2 (eqz-refl l2) (eqz-sym y _ ez)))))
    ((DR)
      (let ((many h2) (many R2) (erased r2) (erased pp) (erased dr2)) (rpop R r dr))
      (let ((many L2) (erased y) (erased z2) (erased d2) (erased p) (erased ez)) (cpushn w (Succ (Zero)) L l dl))
      (let-match erased p (RpS _ _ _ _ p1))
      (let-match erased p1 (RpZ _ _))
      (RsOk l3 c0 (MkRq q2 L2 h2 R2)
        (rch-z l3 c0 c c _ _ e _ one ch dc (cez-refl c) (RSnoc l3 c c _ (Zero) (RNil l3 c) (StepR l3 q q2 l r r2 h w h2 lk pp))
          (MkDc q2 L2 R2 h2 y r2 d2 dr2) (MkCEz q2 (Cons (Bool) w l) r2 y r2 h2 (eqz-sym y _ ez) (eqz-refl r2)))))))

(def-fns _ $ (many c-mac : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ l r dl dr))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) (c-step1 c0 e ch)))
  (let-match many L (Cons _ rn L1) ((Nil _) (c-step1 c0 e ch)))
  (let-match many rn (MkRn b p))
  (let-match many (eq-bit b h) (ESome _ eb) ((ENone _) (c-step1 c0 e ch)))
  (let-match many p (Succ _) ((Zero) (c-step1 c0 e ch)))
  (let-match erased eq (Refl _ _))
  (let-match erased eb (Refl _ _))
  (let-match erased dl (DeC _ _ _ l1 _ dl1 rp))
  (match many b _
    ((BTrue)
      (let ((erased y) (erased q2) (erased g)) (wipe-go p l1 l r rp))
      (let ((erased t) (erased run)) (go-run 2 2 _ _ _ _ _ _ g))
      (let ((many R2) (erased y2) (erased z2) (erased d2) (erased p2) (erased ez)) (cpushn (BFalse) p R r dr))
      (let-match erased (rp-fn (BFalse) p r z2 y p2 q2) (Refl _ _))
      (RsOk l3 c0 (MkRq 2 L1 h R2)
        (rch-z l3 c0 c c _ _ e _ t ch dc (cez-refl c) run (MkDc 2 L1 R2 h l1 y2 dl1 d2) (MkCEz 2 l1 y l1 y2 h (eqz-refl l1) (eqz-sym y2 y ez)))))
    ((BFalse)
      (let ((erased y) (erased q2) (erased g)) (chain-go p l1 l r rp))
      (let ((erased t) (erased run)) (go-run 2 2 _ _ _ _ _ _ g))
      (let ((many R2) (erased y2) (erased z2) (erased d2) (erased p2) (erased ez)) (cpushn (BTrue) p R r dr))
      (let-match erased (rp-fn (BTrue) p r z2 y p2 q2) (Refl _ _))
      (RsOk l3 c0 (MkRq 2 L1 h R2)
        (rch-z l3 c0 c c _ _ e _ t ch dc (cez-refl c) run (MkDc 2 L1 R2 h l1 y2 dl1 d2) (MkCEz 2 l1 y l1 y2 h (eqz-refl l1) (eqz-sym y2 y ez)))))))

(def-fns _ $ (erased tb-eqz : (erased (Tt) T) (erased (List (Bool)) a b x y) (erased (Tb T a x) p) (erased (Tb T b y) q) (erased (Eqz a b) e) -> (erased (Eqz x y) f))
  (match erased p _
    ((TbE _) (let-match erased q (TbE _)) e)
    ((Tb1 _) (let-match erased q (Tb1 _)) (EC _ _ _ e))
    ((Tb11 _) (let-match erased q (Tb11 _)) (EC _ _ _ (EC _ _ _ e)))
    ((Tb011 _) (let-match erased q (Tb011 _)) (EC _ _ _ (EC _ _ _ (EC _ _ _ e))))
    ((Tb0011 _) (let-match erased q (Tb0011 _)) (EC _ _ _ (EC _ _ _ (EC _ _ _ (EC _ _ _ e)))))))

(def-fns _ $ (erased xb-eqz : (erased (List (Tk)) X) (erased (List (Bool)) a b x y) (subterm erased (Xb X a x) p) (erased (Xb X b y) q) (erased (Eqz a b) e)
    -> (erased (Eqz x y) f))
  (match erased p _
    ((XbN _) (let-match erased q (XbN _)) e)
    ((XbP X1 _ x1 p1) (let-match erased q (XbP _ _ y1 q1)) (EC _ _ _ (xb-eqz X1 a b x1 y1 p1 q1 e)))
    ((XbZ X1 _ x1 p1) (let-match erased q (XbZ _ _ y1 q1)) (EC _ _ _ (EC _ _ _ (EC _ _ _ (xb-eqz X1 a b x1 y1 p1 q1 e)))))
    ((XbO X1 _ x1 p1) (let-match erased q (XbO _ _ y1 q1)) (EC _ _ _ (EC _ _ _ (EC _ _ _ (EC _ _ _ (xb-eqz X1 a b x1 y1 p1 q1 e))))))))

(def-adts $ (PDg : -> Type)
  enum
  (many MkPDg : (many (List (Nat)) D) (many (Tt) T) -> (PDg))
  (many NoPDg : -> (PDg)))

(def-fns _ $ (many pdg : (many (List (Nat)) acc) (many (Tt) T) -> (many (PDg) r))
  (MkPDg (nrev (Nil (Nat)) acc) T))

(def-fns _ $ (many zeros-onto : (subterm many (Nat) k) (many (List (Nat)) acc) -> (many (List (Nat)) r))
  (let-match many k (Succ kq) ((Zero) acc))
  (tail $ zeros-onto kq (Cons _ (Zero) acc)))

(def-fns _ $ (many c-pgo : (subterm many (List (Rn)) R) (many (List (Nat)) acc) -> (many (PDg) r))
  (let-match many R (Cons _ r0 R1) ((Nil _) (pdg acc (TtE))))
  (let-match many r0 (MkRn b0 a))
  (let-match many b0 (BFalse) ((BTrue) (pdg acc (TtE))))
  (let-match many R1 (Cons _ r1 R2) ((Nil _) (pdg acc (TtE))))
  (let-match many r1 (MkRn b1 j))
  (let-match many b1 (BTrue) ((BFalse) (pdg acc (TtE))))
  (let-match many (lt-dec 8 a) (No _ _ _ _ _) ((Yes _ _ _ _ _) (pdg acc (TtE))))
  (let ((many q) (many rm) (erased _) (erased _) (erased _) (erased _)) (divmod j (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let-match many q (Succ q1)
    ((Zero)
      (let-match many (nat-eq j 2) (Equal _ _ _) (else (NoPDg)))
      (let-match many (nat-eq a 1) (Unequal _ _ _ _ _) ((Equal _ _ _) (pdg acc (Tt011))))
      (match many (nat-eq a 2) _ ((Equal _ _ _) (pdg acc (Tt0011))) (else (NoPDg)))))
  (let-match many (lt-dec 100000 q) (No _ _ _ _ _) ((Yes _ _ _ _ _) (NoPDg)))
  (let ((many acc2)) (zeros-onto q1 (Cons _ a acc)))
  (let-match many rm (Succ rm1) ((Zero) (tail $ c-pgo R2 acc2)))
  (match many rm1 _ ((Zero) (pdg acc2 (Tt1))) ((Succ _) (pdg acc2 (Tt11)))))

(def-fns _ $ (many c-parse : (many (List (Rn)) R) -> (many (PDg) r))
  (let-match many R (Cons _ r0 R1) ((Nil _) (NoPDg)))
  (let-match many r0 (MkRn b0 a))
  (let-match many b0 (BFalse) ((BTrue) (NoPDg)))
  (let-match many a (Succ a1) ((Zero) (NoPDg)))
  (c-pgo (Cons _ (MkRn (BFalse) a1) R1) (Nil (Nat))))

(def-fns _ $ (many c-enc : (subterm many (List (Nat)) D) -> (many (List (Tk)) X))
  (let-match many D (Cons _ d D1) ((Nil _) (Nil (Tk))))
  (dig d (notail $ c-enc D1)))

(def-adts
  ((LmR : ((Rq) e) -> Type)
    enum
    (many LmOk : (erased (Rq) e) (erased (List (Bool)) lz x0 u y xr) (many (Nat) n) (many (List (Rn)) L0) (erased (Den L0 lz) d0) (erased (Rp (BTrue) n lz x0) p0)
       (many (List (Tk)) X) (many (Tt) T) (erased (XT X T u) px) (many (List (Rn)) R1) (erased (Den R1 y) d1) (erased (Cat (Bool) u y xr) cu)
       (erased (Dc e (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr))) dc) -> (LmR e))
    (many LmNo : (erased (Rq) e) -> (LmR e))))

(def-fns _ $ (many c-lm : (many (Rq) e) (erased (Conf) c) (erased (Dc e c) dc) -> (many (LmR e) r))
  (let-match many e (MkRq q L h R))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) (LmNo e)))
  (let-match many h (BTrue) ((BFalse) (LmNo e)))
  (let-match erased eq (Refl _ _))
  (let-match erased dc (MkDc _ _ _ _ l r dl dr))
  (let-match many (left-split L l dl) (LSpOk lz x0 n L0 d0 p0) ((LSpNo _) (LmNo e)))
  (let-match many (c-parse R) (MkPDg Dq T) ((NoPDg) (LmNo e)))
  (let ((many X)) (c-enc Dq))
  (let-match many (xtr X T) (MkXTR _ _ U0 u px dU))
  (let ((many C) (erased dC)) (push (BFalse) U0 u dU))
  (let-match many (rstrip C (Cons (Bool) (BFalse) u) dC R r dr) (StOk _ _ y R1 d1 cr) ((StNo _ _) (LmNo e)))
  (let-match erased cr (CatC _ _ _ _ xr cu))
  (LmOk e lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc))

(def-fns _ $ (many c-apply : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (erased (List (Bool)) lz x0 u y xr) (many (Nat) n) (many (List (Rn)) L0) (erased (Den L0 lz) d0) (erased (Rp (BTrue) n lz x0) p0)
    (erased (List (Tk)) X) (erased (Tt) T) (erased (XT X T u) px) (many (List (Rn)) R1) (erased (Den R1 y) d1) (erased (Cat (Bool) u y xr) cu)
