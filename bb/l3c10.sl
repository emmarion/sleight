(def-fns _ $ (many c-pgrp : (subterm many (List (Rn)) R) (erased (List (Bool)) x) (erased (Den R x) d) -> (many (PR x) r))
  (let ((many stop)) (PrOk x x x (Nil (Tk)) (TtE) R d (TbE x) (XbN x)))
  (let-match many R (Cons _ r0 R1) ((Nil _) stop))
  (let-match many r0 (MkRn b0 a))
  (let-match many b0 (BFalse) ((BTrue) stop))
  (let-match many R1 (Cons _ r1 R2) ((Nil _) stop))
  (let-match many r1 (MkRn b1 j))
  (let-match many b1 (BTrue) ((BFalse) stop))
  (let-match many (lt-dec 8 a) (No _ _ _ _ _) ((Yes _ _ _ _ _) stop))
  (let-match erased d (DeC _ _ _ x1 _ d1 pa))
  (let-match erased d1 (DeC _ _ _ x2 _ d2 pj))
