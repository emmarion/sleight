  (let ((erased z) (erased prm) (erased pm)) (rp-split (BTrue) m rm j x2 x1 ad pj))
  (let ((many no)) (PrNo x))
  (let-match many q (Succ q1)
    ((Zero)
      (let-match erased mm (MulZero _))
      (let-match erased ad (AddZero _))
      (let-match erased pm (RpZ _ _))
      (let-match many rm (Succ rm1) ((Zero) no))
      (let-match many rm1 (Succ rm2) ((Zero) no))
      (let-match many rm2 (Zero) ((Succ _) no))
      (let-match erased prm (RpS _ _ _ _ prm1))
      (let-match erased prm1 (RpS _ _ _ _ prm2))
      (let-match erased prm2 (RpZ _ _))
      (let-match many a (Succ a1) ((Zero) no))
      (let-match erased pa (RpS _ _ _ _ pa1))
      (let-match many a1 (Succ a2)
        ((Zero) (let-match erased pa1 (RpZ _ _)) (PrOk x x2 x (Nil (Tk)) (Tt011) R2 d2 (Tb011 x2) (XbN x))))
      (let-match many a2 (Zero) ((Succ _) no))
      (let-match erased pa1 (RpS _ _ _ _ pa2))
      (let-match erased pa2 (RpZ _ _))
      (PrOk x x2 x (Nil (Tk)) (Tt0011) R2 d2 (Tb0011 x2) (XbN x))))
  (let-match many (lt-dec 100000 q) (No _ _ _ _ _) ((Yes _ _ _ _ _) no))
  (let ((many rr)) (match many rm (((PR z) rr))
    ((Zero) (let-match erased prm (RpZ _ _)) (notail $ c-pgrp R2 x2 d2))
    ((Succ rm1)
