          (let-match erased prm2 (RpZ _ _))
          (PrOk z x2 z (Nil (Tk)) (Tt11) R2 d2 (Tb11 x2) (XbN z)))))))
  (let-match many rr (PrOk _ y v X T R3 d3 tb xz) ((PrNo _) no))
  (let-match erased mm (MulSucc _ _ c _ mm1 adm))
  (let ((erased w) (erased pc) (erased p3)) (rp-split (BTrue) n3 c m z x1 (add-comm c n3 m adm) pm))
  (let-match erased p3 (RpS _ _ _ _ p31))
  (let-match erased p31 (RpS _ _ _ _ p32))
  (let-match erased p32 (RpS _ _ _ _ p33))
  (let-match erased p33 (RpZ _ _))
  (let ((many Xq) (erased xq)) (t0s-x q1 X v z w c mm1 pc xz))
  (let ((many Xa) (erased xa)) (match many a (((List (Tk)) Xa) ((Xb Xa v x) xa))
    ((Zero) (let-match erased pa (RpZ _ _)) (values (Cons _ (T0) Xq) (XbZ Xq v w xq)))
    ((Succ a1) (tps-x a1 (Cons _ (T1) Xq) v (bits "0" x1) x (rp-shift (BFalse) a1 x1 x pa) (XbO Xq v w xq)))))
  (PrOk x y v Xa T R3 d3 tb xa))

