    ((NKF _ f _) (NKF k f U0))
    ((NKC _ _) (NKC k U0))
    ((NKE _ _) (NKE k U0))
    ((NKV _ _) (NKV k U0))
    ((NKR _ b _) (NKR k b U0))
    ((NKW _ k2 n _ ne) (NKW k k2 n U0 ne))
    ((NKT _ c0 _) (NKT k c0 U0))))

(def-fns _ $ (erased tnk-fr : (erased (Pk) k) (erased (List (Sy)) t tz U) (erased (TNk k t) nk) (erased (Cat (Sy) t (Cons (Sy) iD tz) U) c) -> (erased (TNk k U) nk2))
