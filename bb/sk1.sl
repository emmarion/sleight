(def-adts
  ((CV : ((Nat) a) ((Am) n) ((Nat) v) -> Type)
    enum
    (many CVF : (erased (Nat) a c) -> (CV a (MkAm (BFalse) c) c))
    (many CVT : (erased (Nat) a c v) (erased (Add a c v) p) -> (CV a (MkAm (BTrue) c) v))))

(def-adts
  ((Ins1 : ((Nat) a) ((Sy) x) ((Sy) y) -> Type)
    enum
    (many I1F : (erased (Nat) a) (erased (Fx) f) -> (Ins1 a (YF f) (YF f)))
    (many I1C : (erased (Nat) a) -> (Ins1 a (YC) (YC)))
    (many I1W : (erased (Nat) a v) (erased (Pk) k) (erased (Am) n) (erased (CV a n v) cv) -> (Ins1 a (YW k n) (YW k (MkAm (BFalse) v))))
    (many I1E : (erased (Nat) a) -> (Ins1 a (YE) (YE)))
    (many I1V : (erased (Nat) a) -> (Ins1 a (YV) (YV)))
    (many I1R : (erased (Nat) a b) -> (Ins1 a (YR b) (YR b)))))

(def-adts
  ((Ins : ((Nat) a) ((List (Sy)) t) ((List (Sy)) s) -> Type)
    enum
    (many InN : (erased (Nat) a) -> (Ins a (Nil (Sy)) (Nil (Sy))))
    (many InC : (erased (Nat) a) (erased (Sy) x y) (erased (List (Sy)) t s) (erased (Ins1 a x y) i) (erased (Ins a t s) p) -> (Ins a (Cons (Sy) x t) (Cons (Sy) y s)))))

(def-adts
  ((InsC : ((Nat) a) ((Cf) c) ((Cf) s) -> Type)
    enum
    (many MkInsC : (erased (Nat) a) (erased (Mv) d) (erased (List (Sy)) l r l2 r2) (erased (Ins a l l2) il) (erased (Ins a r r2) ir)
       -> (InsC a (MkCf d l r) (MkCf d l2 r2)))))

(def-adts
  ((TNk : ((Pk) k) ((List (Sy)) t) -> Type)
    enum
    (many TNN : (erased (Pk) k) -> (TNk k (Nil (Sy))))
    (many TNF : (erased (Pk) k) (erased (Fx) f) (erased (List (Sy)) t) -> (TNk k (Cons (Sy) (YF f) t)))
    (many TNC : (erased (Pk) k) (erased (List (Sy)) t) -> (TNk k (Cons (Sy) (YC) t)))
    (many TNE : (erased (Pk) k) (erased (List (Sy)) t) -> (TNk k (Cons (Sy) (YE) t)))
    (many TNV : (erased (Pk) k) (erased (List (Sy)) t) -> (TNk k (Cons (Sy) (YV) t)))
    (many TNR : (erased (Pk) k) (erased (Nat) b) (erased (List (Sy)) t) -> (TNk k (Cons (Sy) (YR b) t)))
    (many TNW : (erased (Pk) k k2) (erased (Am) n) (erased (List (Sy)) t) (erased (KNe k k2) ne) -> (TNk k (Cons (Sy) (YW k2 n) t)))))

(def-adts
  ((CnAdd : ((Am) n1) ((Am) n2) ((Am) n3) -> Type)
    enum
    (many CAF : (erased (Nat) c1 c2 c3) (erased (Add c1 c2 c3) p) -> (CnAdd (MkAm (BFalse) c1) (MkAm (BFalse) c2) (MkAm (BFalse) c3)))
    (many CAL : (erased (Nat) c1 c2 c3) (erased (Add c1 c2 c3) p) -> (CnAdd (MkAm (BTrue) c1) (MkAm (BFalse) c2) (MkAm (BTrue) c3)))
    (many CAR : (erased (Nat) c1 c2 c3) (erased (Add c1 c2 c3) p) -> (CnAdd (MkAm (BFalse) c1) (MkAm (BTrue) c2) (MkAm (BTrue) c3)))))

(def-adts
  ((Nz : ((Am) n) -> Type)
    enum
    (many NzT : (erased (Nat) c) -> (Nz (MkAm (BTrue) c)))
    (many NzF : (erased (Nat) c) -> (Nz (MkAm (BFalse) (Succ c))))))

(def-adts
  ((CnSub : ((Nat) n) ((Am) xs) ((Am) d) -> Type)
    enum
    (many MkCnSub : (erased (Nat) n c d) (erased (Bool) k) (erased (Add n d c) p) -> (CnSub n (MkAm k c) (MkAm k d)))))

(def-adts
  ((TPush : ((Pk) k) ((Am) n) ((List (Sy)) t) ((List (Sy)) t2) -> Type)
    enum
    (many TPZ : (erased (Pk) k) (erased (List (Sy)) t) -> (TPush k (MkAm (BFalse) (Zero)) t t))
    (many TPM : (erased (Pk) k) (erased (Am) n m s) (erased (List (Sy)) t) (erased (Nz n) nz) (erased (CnAdd n m s) a)
       -> (TPush k n (Cons (Sy) (YW k m) t) (Cons (Sy) (YW k s) t)))
    (many TPC : (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t) (erased (Nz n) nz) (erased (TNk k t) nk) -> (TPush k n t (Cons (Sy) (YW k n) t)))))

(let ((many az)) (MkAm (BFalse) (Zero)))

(def-adts
  ((TSt : ((Am) xs) ((Nat) n) ((List (Sy)) t) ((List (Sy)) t2) -> Type)
    enum
    (many TStP : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) t2) (erased (TPush (KX) xs (Cons (Sy) iP (Cons (Sy) (YE) (Nil (Sy)))) t2) pu)
       -> (TSt xs n (Cons (Sy) iP (Cons (Sy) (YE) (Nil (Sy)))) t2))
    (many TStX : (erased (Am) xs v xs2) (erased (Nat) n) (erased (List (Sy)) t t2) (erased (CnAdd xs v xs2) a) (erased (TSt xs2 n t t2) s)
       -> (TSt xs n (Cons (Sy) (YW (KX) v) t) t2))
    (many TStD : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) t t1 t2) (erased (TSt az n t t1) s) (erased (TPush (KX) xs (Cons (Sy) iD t1) t2) pu)
       -> (TSt xs n (Cons (Sy) iD t) t2))
    (many TStC : (erased (Am) xs d) (erased (Nat) n n2 n4) (erased (List (Sy)) t t1 t2 t3) (erased (CnSub n xs d) a) (erased (Add n n n2) a2) (erased (Add n2 n2 n4) a4)
       (erased (TSt az n4 t t1) s) (erased (TPush (KX) (MkAm (BFalse) n2) t1 t2) pu) (erased (TPush (KX) d (Cons (Sy) (YC) t2) t3) pu2)
       -> (TSt xs n (Cons (Sy) (YC) t) t3))
    (many TStG : (erased (Am) xs g) (erased (Nat) n) (erased (List (Sy)) t t1 t2 t3) (erased (TSt az n t t1) s) (erased (TPush (KG) g t1 t2) pu) (erased (TPush (KX) xs t2 t3) pu2)
       -> (TSt xs n (Cons (Sy) (YW (KG) g) t) t3))
    (many TStV : (erased (Am) xs) (erased (Nat) n b b2) (erased (List (Sy)) t2) (erased (Add n b2 b) a) (erased (TPush (KX) xs (Cons (Sy) (YR b2) (Nil (Sy))) t2) pu)
       -> (TSt xs n (Cons (Sy) (YR b) (Nil (Sy))) t2))))

(def-adts
  ((TRw : ((Bool) sd) ((List (Sy)) t) ((List (Sy)) t2) -> Type)
    enum
    (many TRSp : (erased (Bool) sd kk) (erased (Pk) k) (erased (Nat) c) (erased (List (Sy)) t)
       -> (TRw sd (Cons (Sy) (YW k (MkAm kk (Succ c))) t) (Cons (Sy) (YW k (MkAm (BFalse) 1)) (Cons (Sy) (YW k (MkAm kk c)) t))))
    (many TRMg : (erased (Bool) sd) (erased (Pk) k) (erased (Am) n1 n2 n3) (erased (List (Sy)) t) (erased (CnAdd n1 n2 n3) a)
       -> (TRw sd (Cons (Sy) (YW k n1) (Cons (Sy) (YW k n2) t)) (Cons (Sy) (YW k n3) t)))
    (many TRPu : (erased (Bool) sd) (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t t2) (erased (TPush k n t t2) pu) -> (TRw sd (Cons (Sy) (YW k n) t) t2))
    (many TRUf : (erased (Bool) sd) (erased (Pk) k) (erased (List (Sy)) cw t t2) (erased (Cw sd k cw) w) (erased (Cat (Sy) cw t t2) c)
       -> (TRw sd (Cons (Sy) (YW k (MkAm (BFalse) 1)) t) t2))
    (many TRUn : (erased (Bool) sd) (erased (Sy) s) (erased (List (Sy)) t t2) (erased (TRw sd t t2) w) -> (TRw sd (Cons (Sy) s t) (Cons (Sy) s t2)))))

(def-adts
  ((TMv : ((Cf) c) ((Cf) c2) -> Type)
    enum
    (many TMvL : (erased (Pk) K) (erased (Mvk) ml mr) (erased (Nat) r) (erased (Kl K ml mr r) kl) (erased (Am) n) (erased (List (Sy)) L R R2) (erased (TPush K n R R2) pu)
       -> (TMv (MkCf (DL) (Cons (Sy) (YW K n) L) R) (MkCf (DL) L R2)))
    (many TMvR : (erased (Pk) K) (erased (Mvk) ml mr) (erased (Nat) r) (erased (Kl K ml mr r) kl) (erased (Am) n) (erased (List (Sy)) L R L2) (erased (TPush K n L L2) pu)
       -> (TMv (MkCf (DR) L (Cons (Sy) (YW K n) R)) (MkCf (DR) L2 R)))
    (many TMvP : (erased (Am) n) (erased (List (Sy)) L R L2) (erased (TPush (KX) n L L2) pu)
       -> (TMv (MkCf (DR) L (Cons (Sy) iP (Cons (Sy) (YW (KX) n) R))) (MkCf (DR) L2 (Cons (Sy) iP R))))
    (many TMvG : (erased (Am) n) (erased (List (Sy)) L R L2) (erased (TPush (KH) n L L2) pu)
       -> (TMv (MkCf (DR) L (Cons (Sy) iP (Cons (Sy) iD (Cons (Sy) (YW (KG) n) R)))) (MkCf (DR) L2 (Cons (Sy) iP (Cons (Sy) iD R)))))))

(def-adts
  ((TStp : ((Cf) c) ((Cf) c2) ((Bool) g) -> Type)
    enum
    (many TSRl : (erased (Rl) rl) (erased (Cf) c c2) (erased (RlOK sk1p rl) ok) (erased (RApp rl c c2) ap) -> (TStp c c2 (BTrue)))
    (many TSRL : (erased (Mv) d) (erased (List (Sy)) l l2 r) (erased (TRw (BTrue) l l2) w) -> (TStp (MkCf d l r) (MkCf d l2 r) (BFalse)))
    (many TSRR : (erased (Mv) d) (erased (List (Sy)) l r r2) (erased (TRw (BFalse) r r2) w) -> (TStp (MkCf d l r) (MkCf d l r2) (BFalse)))
    (many TSMv : (erased (Cf) c c2) (erased (TMv c c2) m) -> (TStp c c2 (BFalse)))
    (many TSSt : (erased (List (Sy)) l r r2) (erased (TSt az 1 r r2) s) -> (TStp (MkCf (DR) l r) (MkCf (DL) l r2) (BFalse)))
    (many TSSn : (erased (List (Sy)) l r r2) (erased (St (Zero) 1 r r2) s) -> (TStp (MkCf (DR) l r) (MkCf (DL) l r2) (BFalse)))))

(def-adts
  ((TRun : ((Cf) c0) ((Cf) c) ((Bool) g) -> Type)
    enum
    (many TRZ : (erased (Cf) c) -> (TRun c c (BFalse)))
    (many TRS : (erased (Cf) c0 c c2) (erased (Bool) g1 g2 g) (erased (TRun c0 c g1) r) (erased (TStp c c2 g2) s) (erased (Orb g1 g2 g) o) -> (TRun c0 c2 g))))

