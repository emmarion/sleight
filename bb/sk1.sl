(def-fns _ $ (erased pw-add : (erased (Bool) sd) (erased (Pk) k) (erased (Nat) v1 v2 v) (erased (List (Bool)) y y1 z)
    (subterm erased (Pw sd k v1 y1 z) p) (erased (Pw sd k v2 y y1) q) (erased (Add v1 v2 v) a) -> (erased (Pw sd k v y z) r))
  (match erased p _
    ((PwZ _ _ _) (let-match erased a (AddZero _)) q)
    ((PwS _ _ w1 _ y2 _ p1 wk)
      (let-match erased a (AddSucc _ _ w a1))
      (PwS sd k w y y2 z (pw-add sd k w1 v2 w y y1 y2 p1 q a1) wk))))

(def-fns _ $ (erased pw-split : (erased (Bool) sd) (erased (Pk) k) (erased (Nat) v1 v2 v) (erased (List (Bool)) y z)
    (erased (Pw sd k v y z) p) (subterm erased (Add v1 v2 v) a) -> (erased (List (Bool)) y1) (erased (Pw sd k v2 y y1) q) (erased (Pw sd k v1 y1 z) r))
  (let-match erased a (AddSucc w1 _ w a1) ((AddZero _) (values z p (PwZ sd k z))))
  (let-match erased p (PwS _ _ _ _ y2 _ p1 wk))
  (let ((erased y1) (erased q) (erased r)) (pw-split sd k w1 v2 w y y2 p1 a1))
  (values y1 q (PwS sd k w1 y1 y2 z r wk)))

(def-fns _ $ (erased tp-split : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd) (erased (List (Sy)) pre bt t) (erased (Sy) b0) (erased (List (Bool)) z)
    (subterm erased (Cat (Sy) pre (Cons (Sy) b0 bt) t) c) (erased (Tp env r sd t z) tp)
    -> (erased (List (Bool)) y) (erased (Ln sd pre y z) ln) (erased (Tp env r sd (Cons (Sy) b0 bt) y) tb))
  (let-match erased c (CatC _ a pre1 _ t1 c1) ((CatN _ _) (values z (LnN sd z) tp)))
  (match erased tp _
    ((TpC _ _ _ _ _ y1 _ tp1 w)
      (let ((erased y) (erased ln) (erased tb)) (tp-split env r sd pre1 bt t1 b0 y1 c1 tp1))
      (values y (LnC sd a pre1 y y1 z ln w) tb))
    (absurd (TpE _ _ _ _ _) (match erased c1 _))
    (absurd (TpV _ _ _) (match erased c1 _))
    (absurd (TpR _ _ _ _ _ _ _ _) (match erased c1 _))))

(def-fns _ $ (erased tp-join : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd) (erased (List (Sy)) pre bt t) (erased (List (Bool)) y z)
    (subterm erased (Cat (Sy) pre bt t) c) (erased (Ln sd pre y z) ln) (erased (Tp env r sd bt y) tb) -> (erased (Tp env r sd t z) tp))
  (let-match erased c (CatC _ a pre1 _ t1 c1) ((CatN _ _) (let-match erased ln (LnN _ _)) tb))
  (let-match erased ln (LnC _ _ _ _ y1 _ ln1 w))
  (TpC env r sd a t1 y1 z (tp-join env r sd pre1 bt t1 y y1 c1 ln1 tb) w))

(def-fns _ $ (erased push-tp : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd) (erased (Pk) k) (erased (Nat) n) (erased (List (Sy)) t t2) (erased (List (Bool)) y z)
    (erased (Push k n t t2) pu) (erased (Tp env r sd t y) tp) (erased (Pw sd k n y z) pw) -> (erased (Tp env r sd t2 z) tp2))
  (match erased pu _
    ((PuZ _ _) (let-match erased pw (PwZ _ _ _)) tp)
    ((PuM _ n1 m s t0 a)
      (let-match erased tp (TpC _ _ _ _ _ y0 _ tp0 w))
      (let-match erased w (WdK _ _ _ _ _ pw0))
      (TpC env r sd _ t0 y0 z tp0 (WdK sd k s y0 z (pw-add sd k n m s y0 y z pw pw0 a))))
    ((PuC _ n1 _ nk) (TpC env r sd _ t y z tp (WdK sd k n y z pw)))))

(def-fns _ $ (erased unpush-tp : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd) (erased (Pk) k) (erased (Nat) n) (erased (List (Sy)) t t2) (erased (List (Bool)) z)
    (erased (Push k n t t2) pu) (erased (Tp env r sd t2 z) tp2) -> (erased (List (Bool)) y) (erased (Tp env r sd t y) tp) (erased (Pw sd k n y z) pw))
  (match erased pu _
    ((PuZ _ _) (values z tp2 (PwZ sd k z)))
    ((PuM _ n1 m s t0 a)
      (let-match erased tp2 (TpC _ _ _ _ _ y0 _ tp0 w))
      (let-match erased w (WdK _ _ _ _ _ pw0))
      (let ((erased y) (erased q) (erased p)) (pw-split sd k n m s y0 z pw0 a))
      (values y (TpC env r sd _ t0 y0 y tp0 (WdK sd k m y0 y q)) p))
    ((PuC _ n1 _ nk)
      (let-match erased tp2 (TpC _ _ _ _ _ y _ tp w))
      (let-match erased w (WdK _ _ _ _ _ pw))
      (values y tp pw))))

(def-adts
  ((SRw : ((Bool) sd) ((List (Sy)) t) ((List (Sy)) t2) -> Type)
    enum
    (many RwMg : (erased (Bool) sd) (erased (Pk) k) (erased (Nat) v1 v2 v) (erased (List (Sy)) t) (erased (Add v1 v2 v) a)
       -> (SRw sd (Cons (Sy) (YW k (MkAm (BFalse) v1)) (Cons (Sy) (YW k (MkAm (BFalse) v2)) t)) (Cons (Sy) (YW k (MkAm (BFalse) v)) t)))
    (many RwSp : (erased (Bool) sd) (erased (Pk) k) (erased (Nat) v1 v2 v) (erased (List (Sy)) t) (erased (Add v1 v2 v) a)
       -> (SRw sd (Cons (Sy) (YW k (MkAm (BFalse) v)) t) (Cons (Sy) (YW k (MkAm (BFalse) v1)) (Cons (Sy) (YW k (MkAm (BFalse) v2)) t))))
    (many RwPu : (erased (Bool) sd) (erased (Pk) k) (erased (Nat) n) (erased (List (Sy)) t t2) (erased (Push k n t t2) pu)
       -> (SRw sd (Cons (Sy) (YW k (MkAm (BFalse) n)) t) t2))
    (many RwUp : (erased (Bool) sd) (erased (Pk) k) (erased (Nat) n) (erased (Sy) b0) (erased (List (Sy)) bt t2) (erased (Push k n (Cons (Sy) b0 bt) t2) pu)
       -> (SRw sd t2 (Cons (Sy) (YW k (MkAm (BFalse) n)) (Cons (Sy) b0 bt))))
    (many RwUf : (erased (Bool) sd) (erased (Pk) k) (erased (List (Sy)) cw t t2) (erased (Cw sd k cw) w) (erased (Cat (Sy) cw t t2) c)
       -> (SRw sd (Cons (Sy) (YW k (MkAm (BFalse) 1)) t) t2))
    (many RwFd : (erased (Bool) sd) (erased (Pk) k) (erased (List (Sy)) cw bt t2) (erased (Sy) b0) (erased (Cw sd k cw) w) (erased (Cat (Sy) cw (Cons (Sy) b0 bt) t2) c)
       -> (SRw sd t2 (Cons (Sy) (YW k (MkAm (BFalse) 1)) (Cons (Sy) b0 bt))))
    (many RwUn : (erased (Bool) sd) (erased (Sy) s) (erased (List (Sy)) t t2) (erased (SRw sd t t2) w) -> (SRw sd (Cons (Sy) s t) (Cons (Sy) s t2)))))

(def-fns _ $ (erased cw-fn : (erased (Bool) sd) (erased (Pk) k) (erased (List (Sy)) c1 c2) (erased (Cw sd k c1) w1) (erased (Cw sd k c2) w2) -> (erased (Eq (List (Sy)) c1 c2) e))
  (match erased w1 _
    ((CwF) (let-match erased w2 (CwF)) (Refl _ c1))
    ((CwGl) (let-match erased w2 (CwGl)) (Refl _ c1))
    ((CwGr) (let-match erased w2 (CwGr)) (Refl _ c1))
    ((CwH) (let-match erased w2 (CwH)) (Refl _ c1))))

(def-fns _ $ (erased srw-tp : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd) (erased (List (Sy)) t t2) (erased (List (Bool)) z)
    (subterm erased (SRw sd t t2) rw) (erased (Tp env r sd t z) tp) -> (erased (Tp env r sd t2 z) tp2))
  (match erased rw _
    ((RwMg _ k v1 v2 v t0 a)
      (let-match erased tp (TpC _ _ _ _ _ y1 _ tp1 w1))
      (let-match erased tp1 (TpC _ _ _ _ _ y _ tp0 w2))
      (let-match erased w1 (WdK _ _ _ _ _ p1))
      (let-match erased w2 (WdK _ _ _ _ _ p2))
      (TpC env r sd _ t0 y z tp0 (WdK sd k v y z (pw-add sd k v1 v2 v y y1 z p1 p2 a))))
    ((RwSp _ k v1 v2 v t0 a)
      (let-match erased tp (TpC _ _ _ _ _ y _ tp0 w))
      (let-match erased w (WdK _ _ _ _ _ p))
      (let ((erased y1) (erased q) (erased q2)) (pw-split sd k v1 v2 v y z p a))
      (TpC env r sd _ _ y1 z (TpC env r sd _ t0 y y1 tp0 (WdK sd k v2 y y1 q)) (WdK sd k v1 y1 z q2)))
    ((RwPu _ k n t0 _ pu)
      (let-match erased tp (TpC _ _ _ _ _ y _ tp0 w))
      (let-match erased w (WdK _ _ _ _ _ p))
      (push-tp env r sd k n t0 t2 y z pu tp0 p))
    ((RwUp _ k n b0 bt _ pu)
      (let ((erased y) (erased tp0) (erased p)) (unpush-tp env r sd k n _ t z pu tp))
      (TpC env r sd _ _ y z tp0 (WdK sd k n y z p)))
    ((RwUf _ k cw t0 _ w c)
      (let-match erased tp (TpC _ _ _ _ _ y _ tp0 wd))
      (let-match erased wd (WdK _ _ _ _ _ p))
      (let-match erased p (PwS _ _ _ _ y1 _ p0 wk))
      (let-match erased p0 (PwZ _ _ _))
      (let-match erased wk (WkC _ _ cw2 _ _ w2 ln) ((WkX _ _ _ _) (match erased w _)))
      (let-match erased (cw-fn sd k cw cw2 w w2) (Refl _ _))
      (tp-join env r sd cw t0 t2 y z c ln tp0))
    ((RwFd _ k cw bt _ b0 w c)
      (let ((erased y) (erased ln) (erased tb)) (tp-split env r sd cw bt t b0 z c tp))
      (TpC env r sd _ _ y z tb (WdK sd k 1 y z (PwS sd k (Zero) y y z (PwZ sd k y) (WkC sd k cw y z w ln)))))
    ((RwUn _ s t0 t3 w)
      (match erased tp _
        ((TpC _ _ _ _ _ y _ tp0 wd) (TpC env r sd s t3 y z (srw-tp env r sd t0 t3 y w tp0) wd))
        (absurd (TpE _ _ _ _ _) (match erased w _ (absurd (RwUp _ _ _ _ _ _ pu) (match erased pu _)) (absurd (RwFd _ _ _ _ _ _ _ c) (match erased c _))))
        (absurd (TpV _ _ _) (match erased w _ (absurd (RwUp _ _ _ _ _ _ pu) (match erased pu _)) (absurd (RwFd _ _ _ _ _ _ _ c) (match erased c _))))
        (absurd (TpR _ _ _ _ _ _ _ _) (match erased w _ (absurd (RwUp _ _ _ _ _ _ pu) (match erased pu _)) (absurd (RwFd _ _ _ _ _ _ _ c) (match erased c _))))))))

(def-adts
  ((CRw : ((Cf) c) ((Cf) c2) -> Type)
    enum
    (many CRL : (erased (Mv) d) (erased (List (Sy)) l l2 r) (erased (SRw (BTrue) l l2) w) -> (CRw (MkCf d l r) (MkCf d l2 r)))
    (many CRR : (erased (Mv) d) (erased (List (Sy)) l r r2) (erased (SRw (BFalse) r r2) w) -> (CRw (MkCf d l r) (MkCf d l r2)))))

(def-fns _ $ (erased hl-rw : (erased (Env) env) (erased (Nat) rl rr u) (erased (Cf) c c2) (erased (CRw c c2) cr) (erased (HL env rl rr c u) hl)
    -> (erased (HL env rl rr c2 u) hl2))
  (let-match erased hl (MkHL _ _ _ _ _ e lc hz))
  (match erased cr _
    ((CRL d l l2 r w)
      (match erased lc _
        ((LcR _ _ _ _ _ zl zr tl tr) (MkHL env rl rr c2 u e (LcR env rl rr l2 r zl zr (srw-tp env rl (BTrue) l l2 zl w tl) tr) hz))
        ((LcL _ _ _ _ _ zl zr tl tr) (MkHL env rl rr c2 u e (LcL env rl rr l2 r zl zr (srw-tp env rl (BTrue) l l2 zl w tl) tr) hz))))
    ((CRR d l r r2 w)
      (match erased lc _
        ((LcR _ _ _ _ _ zl zr tl tr) (MkHL env rl rr c2 u e (LcR env rl rr l r2 zl zr tl (srw-tp env rr (BFalse) r r2 zr w tr)) hz))
        ((LcL _ _ _ _ _ zl zr tl tr) (MkHL env rl rr c2 u e (LcL env rl rr l r2 zl zr tl (srw-tp env rr (BFalse) r r2 zr w tr)) hz))))))

(def-fns _ $ (erased gs-cat : (erased (List (Bool)) s1 w s y y1 z) (erased (GS (MkSd s1 (TV)) y y1) g1) (erased (GS (MkSd w (TV)) y1 z) g2)
    (subterm erased (Cat (Bool) w s1 s) c) -> (erased (GS (MkSd s (TV)) y z) g))
  (let-match erased c (CatC _ b w1 _ s2 c1) ((CatN _ _) (let-match erased g2 (GSV _)) g1))
  (let-match erased g2 (GSC _ _ z1 _ _ g3))
  (GSC s2 y z1 (TV) b (gs-cat s1 w1 s2 y y1 z1 g1 g3 c1)))

(def-fns _ $ (erased gs-split : (erased (List (Bool)) s1 w s y z) (erased (GS (MkSd s (TV)) y z) g) (subterm erased (Cat (Bool) w s1 s) c)
    -> (erased (List (Bool)) y1) (erased (GS (MkSd s1 (TV)) y y1) g1) (erased (GS (MkSd w (TV)) y1 z) g2))
  (let-match erased c (CatC _ b w1 _ s2 c1) ((CatN _ _) (values z g (GSV z))))
  (let-match erased g (GSC _ _ z1 _ _ g3))
  (let ((erased y1) (erased g1) (erased g2)) (gs-split s1 w1 s2 y z1 g3 c1))
  (values y1 g1 (GSC w1 y1 z1 (TV) b g2)))

(def-fns _ $ (erased gs-ex : (erased (Tl) f) (subterm erased (List (Bool)) s) (erased (List (Bool)) t) -> (erased (List (Bool)) x) (erased (GS (MkSd s f) t x) g))
  (let-match erased s (Cons _ b s1) ((Nil _) (match erased f _ ((TV) (values t (GSV t))) ((TZ) (values (Nil (Bool)) (GSZ t))))))
  (let ((erased x) (erased g)) (gs-ex f s1 t))
  (values (Cons (Bool) b x) (GSC s1 t x f b g)))

(def-fns _ $ (erased gs-tz : (erased (List (Bool)) s t x) (subterm erased (GS (MkSd s (TZ)) t x) g) -> (erased (Eq (List (Bool)) x s) e))
  (let-match erased g (GSC s1 _ x1 _ b g1) ((GSZ _) (Refl _ x)))
  (let-match erased (gs-tz s1 t x1 g1) (Refl _ _))
  (Refl _ x))

(def-fns _ $ (erased gs-zv : (erased (List (Bool)) s t x) (subterm erased (GS (MkSd s (TZ)) t x) g) -> (erased (GS (MkSd s (TV)) (Nil (Bool)) x) g2))
  (let-match erased g (GSC s1 _ x1 _ b g1) ((GSZ _) (GSV (Nil (Bool)))))
  (GSC s1 (Nil (Bool)) x1 (TV) b (gs-zv s1 t x1 g1)))

(def-fns _ $ (erased gs-zeros : (erased (List (Bool)) s y z) (subterm erased (GS (MkSd s (TV)) y z) g) (erased (Zeros y) zy) -> (erased (Eqz z s) e))
  (let-match erased g (GSC s1 _ z1 _ b g1) ((GSV _) (EZ z s zy (ZN))))
  (EC b z1 s1 (gs-zeros s1 y z1 g1 zy)))

(def-fns _ $ (erased gt-ex : (erased (Ta) a) (erased (List (Bool)) lt rt) -> (erased (Tc) e) (erased (GT a lt rt e) g))
  (let-match erased a (MkTa q d L R))
  (let-match erased L (MkSd sl fl))
  (let-match erased R (MkSd sr fr))
  (let ((erased l) (erased gl)) (gs-ex fl sl lt))
  (let ((erased r) (erased gr)) (gs-ex fr sr rt))
  (values (MkTc q d l r) (MkGT q d L R lt rt l r gl gr)))

(def-adts
  ((SdEz : ((Sd) a) ((Sd) b) -> Type)
    enum
    (many SEV : (erased (List (Bool)) s) -> (SdEz (MkSd s (TV)) (MkSd s (TV))))
    (many SEZ : (erased (List (Bool)) s1 s2) (erased (Eqz s1 s2) e) -> (SdEz (MkSd s1 (TZ)) (MkSd s2 (TZ))))))

(def-adts
  ((TaEz : ((Ta) a) ((Ta) b) -> Type)
    enum
    (many MkTaEz : (erased (Nat) q) (erased (Mv) d) (erased (Sd) L1 R1 L2 R2) (erased (SdEz L1 L2) el) (erased (SdEz R1 R2) er)
       -> (TaEz (MkTa q d L1 R1) (MkTa q d L2 R2)))))

(def-fns _ $ (erased sd-ez : (erased (Sd) A Bd) (erased (List (Bool)) t x y) (erased (SdEz A Bd) se) (erased (GS A t x) ga) (erased (GS Bd t y) gb) -> (erased (Eqz x y) e))
  (match erased se _
    ((SEV s) (let-match erased (gs-fn A t x y ga gb) (Refl _ _)) (eqz-refl x))
    ((SEZ s1 s2 e)
      (let-match erased (gs-tz s1 t x ga) (Refl _ _))
      (let-match erased (gs-tz s2 t y gb) (Refl _ _))
      e)))

(def-fns _ $ (erased gt-ez : (erased (Ta) a b) (erased (List (Bool)) lt rt) (erased (Tc) e1 e2) (erased (TaEz a b) te) (erased (GT a lt rt e1) g1) (erased (GT b lt rt e2) g2)
    -> (erased (TcEz e1 e2) tz))
  (let-match erased te (MkTaEz q d L1 R1 L2 R2 el er))
  (let-match erased g1 (MkGT _ _ _ _ _ _ l1 r1 gl1 gr1))
  (let-match erased g2 (MkGT _ _ _ _ _ _ l2 r2 gl2 gr2))
  (MkTcEz q d l1 r1 l2 r2 (sd-ez L1 L2 lt l1 l2 el gl1 gl2) (sd-ez R1 R2 rt r1 r2 er gr1 gr2)))

(def-fns _ $ (erased aw-fn : (erased (Bool) sd) (erased (Fx) f) (erased (List (Bool)) w1 w2) (erased (Aw sd f w1) a1) (erased (Aw sd f w2) a2) -> (erased (Eq (List (Bool)) w1 w2) e))
  (match erased a1 _
    ((AwDl) (let-match erased a2 (AwDl)) (Refl _ w1))
    ((AwDr) (let-match erased a2 (AwDr)) (Refl _ w1))
    ((AwP _) (let-match erased a2 (AwP _)) (Refl _ w1))
    ((AwC0) (let-match erased a2 (AwC0)) (Refl _ w1))
    ((AwC1) (let-match erased a2 (AwC1)) (Refl _ w1))
    ((AwC2) (let-match erased a2 (AwC2)) (Refl _ w1))
    ((AwF0) (let-match erased a2 (AwF0)) (Refl _ w1))
    ((AwF1) (let-match erased a2 (AwF1)) (Refl _ w1))
    ((AwF2) (let-match erased a2 (AwF2)) (Refl _ w1))
    ((AwF3) (let-match erased a2 (AwF3)) (Refl _ w1))
    ((AwG0) (let-match erased a2 (AwG0)) (Refl _ w1))
    ((AwG1) (let-match erased a2 (AwG1)) (Refl _ w1))
    ((AwG2) (let-match erased a2 (AwG2)) (Refl _ w1))))

(def-adts
  ((Pb : ((Bool) sd) ((Sy) s) ((List (Bool)) w) -> Type)
    enum
    (many PbF : (erased (Bool) sd) (erased (Fx) f) (erased (List (Bool)) w) (erased (Aw sd f w) a) -> (Pb sd (YF f) w))
    (many PbC : (erased (Bool) sd) -> (Pb sd (YC) (bits "1010")))
    (many PbX : (erased (Bool) sd) -> (Pb sd (YW (KX) (MkAm (BFalse) 1)) (bits "110110")))))

(def-adts
  ((Bw : ((Bool) sd) ((List (Sy)) t) ((List (Bool)) s) -> Type)
    enum
    (many BwN : (erased (Bool) sd) -> (Bw sd (Nil (Sy)) (Nil (Bool))))
    (many BwC : (erased (Bool) sd) (erased (Sy) a) (erased (List (Sy)) t) (erased (List (Bool)) s1 w s) (erased (Bw sd t s1) b) (erased (Pb sd a w) p)
       (erased (Cat (Bool) w s1 s) c) -> (Bw sd (Cons (Sy) a t) s))))

(def-fns _ $ (erased pb-wd : (erased (Bool) sd) (erased (Sy) a) (erased (List (Bool)) w y z) (erased (Pb sd a w) p) (erased (Wd sd a y z) wd) -> (erased (GS (MkSd w (TV)) y z) g))
  (match erased p _
    ((PbF _ f _ aw) (let-match erased wd (WdF _ _ w2 _ _ aw2 g)) (let-match erased (aw-fn sd f w w2 aw aw2) (Refl _ _)) g)
    ((PbC _) (let-match erased wd (WdC _ _ _ g)) g)
    ((PbX _)
      (let-match erased wd (WdK _ _ _ _ _ pw))
      (let-match erased pw (PwS _ _ _ _ y1 _ pw0 wk))
      (let-match erased pw0 (PwZ _ _ _))
      (let-match erased wk (WkX _ _ _ g) ((WkC _ _ _ _ _ c _) (match erased c _)))
      g)))

(def-fns _ $ (erased wd-pb : (erased (Bool) sd) (erased (Sy) a) (erased (List (Bool)) w y z) (erased (Pb sd a w) p) (erased (GS (MkSd w (TV)) y z) g) -> (erased (Wd sd a y z) wd))
  (match erased p _
    ((PbF _ f _ aw) (WdF sd f w y z aw g))
    ((PbC _) (WdC sd y z g))
    ((PbX _) (WdK sd (KX) 1 y z (PwS sd (KX) (Zero) y y z (PwZ sd (KX) y) (WkX sd y z g))))))

(def-fns _ $ (erased ln-gs : (erased (Bool) sd) (erased (List (Sy)) t) (erased (List (Bool)) s y z) (subterm erased (Bw sd t s) b) (erased (Ln sd t y z) ln)
    -> (erased (GS (MkSd s (TV)) y z) g))
  (let-match erased b (BwC _ a t1 s1 w _ b1 p c) ((BwN _) (let-match erased ln (LnN _ _)) (GSV y)))
  (let-match erased ln (LnC _ _ _ _ y1 _ ln1 wd))
  (gs-cat s1 w s y y1 z (ln-gs sd t1 s1 y y1 b1 ln1) (pb-wd sd a w y1 z p wd) c))

(def-fns _ $ (erased gs-ln : (erased (Bool) sd) (erased (List (Sy)) t) (erased (List (Bool)) s y z) (subterm erased (Bw sd t s) b) (erased (GS (MkSd s (TV)) y z) g)
    -> (erased (Ln sd t y z) ln))
  (let-match erased b (BwC _ a t1 s1 w _ b1 p c) ((BwN _) (let-match erased g (GSV _)) (LnN sd y)))
  (let ((erased y1) (erased g1) (erased g2)) (gs-split s1 w s y z g c))
  (LnC sd a t1 y y1 z (gs-ln sd t1 s1 y y1 b1 g1) (wd-pb sd a w y1 z p g2)))

(def-adts $ (Rl : -> Type)
  enum
  (many MkRl : (many (Mv) d) (many (List (Sy)) lp) (many (Bool) le) (many (List (Sy)) rp) (many (Bool) re) (many (Mv) d2) (many (List (Sy)) lp2 rp2) -> (Rl)))

(def-adts
  ((EB : ((Bool) e) ((List (Sy)) x) -> Type)
    enum
    (many EBV : (erased (List (Sy)) x) -> (EB (BFalse) x))
    (many EBE : -> (EB (BTrue) (Cons (Sy) (YE) (Nil (Sy)))))))

(def-adts
  ((Sde : ((Bool) e) ((List (Sy)) lp lp2 l l2) -> Type)
    enum
    (many MkSde : (erased (Bool) e) (erased (List (Sy)) lp lp2 x l l2) (erased (EB e x) eb) (erased (Cat (Sy) lp x l) c) (erased (Cat (Sy) lp2 x l2) c2)
       -> (Sde e lp lp2 l l2))))

(def-adts
  ((RApp : ((Rl) rl) ((Cf) c) ((Cf) c2) -> Type)
    enum
    (many MkRApp : (erased (Mv) d d2) (erased (List (Sy)) lp rp lp2 rp2 l r l2 r2) (erased (Bool) le re)
       (erased (Sde le lp lp2 l l2) sl) (erased (Sde re rp rp2 r r2) sr)
       -> (RApp (MkRl d lp le rp re d2 lp2 rp2) (MkCf d l r) (MkCf d2 l2 r2)))))

(def-adts
  ((Dq : ((Mv) d) ((Nat) q) ((List (Bool)) s) ((List (Bool)) s2) -> Type)
    enum
    (many DqR : (erased (List (Bool)) s) -> (Dq (DR) (Zero) s s))
    (many DqL : (erased (List (Bool)) s) -> (Dq (DL) 2 s (Cons (Bool) (BTrue) (Cons (Bool) (BFalse) s))))))

(def-adts
  ((Tz : ((Bool) e) ((Tl) f) -> Type)
    enum
    (many TzF : -> (Tz (BFalse) (TV)))
    (many TzT : -> (Tz (BTrue) (TZ)))))

(def-adts
  ((TaOf : ((Mv) d) ((List (Sy)) lp) ((Bool) le) ((List (Sy)) rp) ((Bool) re) ((Ta) a) -> Type)
    enum
    (many MkTaOf : (erased (Mv) d) (erased (List (Sy)) lp rp) (erased (Bool) le re) (erased (List (Bool)) ls rs rs2) (erased (Nat) q) (erased (Tl) f1 f2)
       (erased (Bw (BTrue) lp ls) bl) (erased (Bw (BFalse) rp rs) br) (erased (Dq d q rs rs2) dq) (erased (Tz le f1) z1) (erased (Tz re f2) z2)
       -> (TaOf d lp le rp re (MkTa q d (MkSd ls f1) (MkSd rs2 f2))))))

(def-adts
  ((RlOK : ((List (PT)) p) ((Rl) rl) -> Type)
    enum
    (many MkRlOK : (erased (List (PT)) p) (erased (Mv) d d2) (erased (List (Sy)) lp rp lp2 rp2) (erased (Bool) le re) (erased (Ta) ta tb a1)
       (erased (TaOf d lp le rp re ta) ti) (erased (TaOf d2 lp2 le rp2 re tb) to) (erased (ARun p ta a1) ar) (erased (TaEz a1 tb) te)
       -> (RlOK p (MkRl d lp le rp re d2 lp2 rp2)))))

(def-fns _ $ (erased absurd bw-nil : (erased (Bool) sd) (erased (List (Sy)) lp) (erased (List (Bool)) s) (erased (List (Sy)) l) (erased (Env) env) (erased (Nat) r) (erased (List (Bool)) z)
    (subterm erased (Bw sd lp s) bw) (erased (Cat (Sy) lp (Nil (Sy)) l) c) (erased (Tp env r sd l z) tp) -> (erased (False) f))
  (match erased bw _
    (absurd (BwN _) (let-match erased c (CatN _ _)) (match erased tp _))
    (absurd (BwC _ a t s1 w _ b p ct)
      (let-match erased c (CatC _ _ _ _ l1 c1))
      (match erased tp _
        (absurd (TpC _ _ _ _ _ y _ tp1 _) (bw-nil sd t s1 l1 env r y b c1 tp1))
        (absurd (TpE _ _ _ _ _) (match erased p _))
        (absurd (TpV _ _ _) (match erased p _))
        (absurd (TpR _ _ _ _ _ _ _ _) (match erased p _))))))

(def-fns _ $ (erased gs-zex : (subterm erased (List (Bool)) s) (erased (List (Bool)) t) -> (erased (GS (MkSd s (TZ)) t s) g))
  (let-match erased s (Cons _ b s1) ((Nil _) (GSZ t)))
  (GSC s1 t s1 (TZ) b (gs-zex s1 t)))

(def-fns _ $ (erased sde-in : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd e) (erased (List (Sy)) lp lp2 l l2) (erased (List (Bool)) z s) (erased (Tl) f)
    (erased (Sde e lp lp2 l l2) sde) (erased (Tp env r sd l z) tp) (erased (Bw sd lp s) bw) (erased (Tz e f) tz)
    -> (erased (List (Sy)) x) (erased (List (Bool)) y z2) (erased (EB e x) eb) (erased (Cat (Sy) lp2 x l2) c2) (erased (Tp env r sd x y) tx)
    (erased (GS (MkSd s f) y z2) g) (erased (Eqz z z2) ez))
  (let-match erased sde (MkSde _ _ _ x _ _ eb c c2))
  (let-match erased eb (EBV _) ((EBE)
    (let-match erased tz (TzT))
    (let ((erased y) (erased ln) (erased tx)) (tp-split env r sd lp (Nil (Sy)) l (YE) z c tp))
    (let-match erased tx (TpE _ _ _ _ zy) ((TpC _ _ _ _ _ _ _ _ w) (match erased w _)))
    (values x y s eb c2 tx (gs-zex s y) (gs-zeros s y z (ln-gs sd lp s y z bw ln) zy))))
  (let-match erased tz (TzF))
  (let-match erased x (Cons _ x0 xt) ((Nil _) (match erased (bw-nil sd lp s l env r z bw c tp) _)))
  (let ((erased y) (erased ln) (erased tx)) (tp-split env r sd lp xt l x0 z c tp))
  (values x y z eb c2 tx (ln-gs sd lp s y z bw ln) (eqz-refl z)))

(def-fns _ $ (erased sde-out : (erased (Env) env) (erased (Nat) r) (erased (Bool) sd e) (erased (List (Sy)) lp2 x l2) (erased (List (Bool)) y z2 s2) (erased (Tl) f)
    (erased (EB e x) eb) (erased (Cat (Sy) lp2 x l2) c2) (erased (Tp env r sd x y) tx) (erased (Bw sd lp2 s2) bw) (erased (Tz e f) tz) (erased (GS (MkSd s2 f) y z2) g)
    -> (erased (Tp env r sd l2 z2) tp))
  (let-match erased eb (EBV _) ((EBE)
    (let-match erased tz (TzT))
    (let-match erased (gs-tz s2 y z2 g) (Refl _ _))
    (tp-join env r sd lp2 x l2 (Nil (Bool)) z2 c2 (gs-ln sd lp2 s2 (Nil (Bool)) z2 bw (gs-zv s2 y z2 g)) (TpE env r sd (Nil (Bool)) (ZN)))))
  (let-match erased tz (TzF))
  (tp-join env r sd lp2 x l2 y z2 c2 (gs-ln sd lp2 s2 y z2 bw g) tx))

(def-fns _ $ (erased tz-fn : (erased (Bool) e) (erased (Tl) f f2) (erased (Tz e f) a) (erased (Tz e f2) b) -> (erased (Eq (Tl) f f2) q))
  (match erased a _ ((TzF) (let-match erased b (TzF)) (Refl _ f)) ((TzT) (let-match erased b (TzT)) (Refl _ f))))

(def-fns _ $ (erased dq-ex : (erased (Mv) d) (erased (Nat) q) (erased (List (Bool)) s s2 x) (erased (Dq d q s s2) dq) -> (erased (List (Bool)) x2) (erased (Dq d q x x2) dq2))
  (match erased dq _ ((DqR _) (values x (DqR x))) ((DqL _) (values (Cons (Bool) (BTrue) (Cons (Bool) (BFalse) x)) (DqL x)))))

(def-fns _ $ (erased dq-gs : (erased (Mv) d) (erased (Nat) q q2) (erased (List (Bool)) s s2 z Z y) (erased (Tl) f) (erased (Dq d q s s2) a) (erased (Dq d q2 z Z) b)
    (erased (GS (MkSd s f) y z) g) -> (erased (GS (MkSd s2 f) y Z) g2))
  (match erased a _
    ((DqR _) (let-match erased b (DqR _)) g)
    ((DqL _) (let-match erased b (DqL _)) (GSC _ _ _ _ _ (GSC _ _ _ _ _ g)))))

(def-fns _ $ (erased dq-ez : (erased (Mv) d) (erased (Nat) q q2) (erased (List (Bool)) z Z z2 Z2) (erased (Dq d q z Z) a) (erased (Dq d q2 z2 Z2) b) (erased (Eqz z z2) e)
    -> (erased (Eqz Z Z2) e2))
  (match erased a _
    ((DqR _) (let-match erased b (DqR _)) e)
    ((DqL _) (let-match erased b (DqL _)) (EC _ _ _ (EC _ _ _ e)))))

(def-fns _ $ (erased dq-ungs : (erased (Mv) d) (erased (Nat) q) (erased (List (Bool)) s s2 y Z) (erased (Tl) f) (erased (Dq d q s s2) a) (erased (GS (MkSd s2 f) y Z) g)
    -> (erased (List (Bool)) z) (erased (Dq d q z Z) b) (erased (GS (MkSd s f) y z) g2))
  (let-match erased a (DqL _) ((DqR _) (values Z (DqR Z) g)))
  (let-match erased g (GSC _ _ Z1 _ _ g1))
  (let-match erased g1 (GSC _ _ z _ _ g2))
  (values z (DqL z) g2))

(def-fns _ $ (erased lc-dq : (erased (Env) env) (erased (Nat) rl rr) (erased (Mv) d) (erased (List (Sy)) l r) (erased (Tc) e) (erased (Nat) q) (erased (List (Bool)) s s2)
    (erased (Lc env rl rr (MkCf d l r) e) lc) (erased (Dq d q s s2) dq)
    -> (erased (List (Bool)) zl zr Z) (erased (Tp env rl (BTrue) l zl) tl) (erased (Tp env rr (BFalse) r zr) tr) (erased (Dq d q zr Z) dz) (erased (Eq (Tc) e (MkTc q d zl Z)) ee))
  (match erased dq _
    ((DqR _) (let-match erased lc (LcR _ _ _ _ _ zl zr tl tr)) (values zl zr zr tl tr (DqR zr) (Refl _ e)))
    ((DqL _) (let-match erased lc (LcL _ _ _ _ _ zl zr tl tr)) (values zl zr (Cons (Bool) (BTrue) (Cons (Bool) (BFalse) zr)) tl tr (DqL zr) (Refl _ e)))))

(def-fns _ $ (erased lc-of-dq : (erased (Env) env) (erased (Nat) rl rr) (erased (Mv) d) (erased (List (Sy)) l r) (erased (Nat) q) (erased (List (Bool)) zl zr Z)
    (erased (Tp env rl (BTrue) l zl) tl) (erased (Tp env rr (BFalse) r zr) tr) (erased (Dq d q zr Z) dz) -> (erased (Lc env rl rr (MkCf d l r) (MkTc q d zl Z)) lc))
  (match erased dz _
    ((DqR _) (LcR env rl rr l r zl zr tl tr))
    ((DqL _) (LcL env rl rr l r zl zr tl tr))))

(def-fns _ $ (erased rapp-hl : (erased (Rl) rl) (erased (Cf) c c2) (erased (Env) env) (erased (Nat) rl0 rr u) (erased (RlOK sk1p rl) ok) (erased (RApp rl c c2) ap)
    (erased (HL env rl0 rr c u) hl) -> (erased (Nat) v) (erased (HL env rl0 rr c2 v) hl2) (erased (Lt v u) lt))
  (let-match erased ap (MkRApp d d2 lp rp lp2 rp2 l r l2 r2 le re sl sr))
  (let-match erased ok (MkRlOK _ _ _ _ _ _ _ _ _ ta tb a1 ti to ar te))
  (let-match erased ti (MkTaOf _ _ _ _ _ ls rs rs2 q f1 f2 bl br dq z1 z2))
  (let-match erased to (MkTaOf _ _ _ _ _ ls3 rs3 rs4 q3 f3 f4 bl3 br3 dq3 z3 z4))
  (let-match erased (tz-fn le f1 f3 z1 z3) (Refl _ _))
  (let-match erased (tz-fn re f2 f4 z2 z4) (Refl _ _))
  (let-match erased hl (MkHL _ _ _ _ _ e lc hz))
  (let ((erased zl) (erased zr) (erased Z) (erased tl) (erased tr) (erased dz) (erased ee)) (lc-dq env rl0 rr d l r e q rs rs2 lc dq))
  (let-match erased ee (Refl _ _))
  (let ((erased xl) (erased yl) (erased zl2) (erased ebl) (erased cl2) (erased txl) (erased gl) (erased ezl)) (sde-in env rl0 (BTrue) le lp lp2 l l2 zl ls f1 sl tl bl z1))
  (let ((erased xr) (erased yr) (erased zr2) (erased ebr) (erased cr2) (erased txr) (erased gr) (erased ezr)) (sde-in env rr (BFalse) re rp rp2 r r2 zr rs f2 sr tr br z2))
  (let ((erased Z2) (erased dz2)) (dq-ex d q rs rs2 zr2 dq))
  (let ((erased hz2)) (hz-eqz sk1p e (MkTc q d zl2 Z2) u hz (MkTcEz q d zl Z zl2 Z2 ezl (dq-ez d q q zr Z zr2 Z2 dz dz2 ezr))))
  (let ((erased g2)) (MkGT q d (MkSd ls f1) (MkSd rs2 f2) yl yr zl2 Z2 gl (dq-gs d q q rs rs2 zr2 Z2 yr f2 dq dz2 gr)))
  (let ((erased e3) (erased g3)) (gt-ex a1 yl yr))
  (let ((erased v) (erased hz3) (erased lt)) (hz-reach sk1p _ e3 u (arun-reach sk1p ta a1 yl yr _ e3 ar g2 g3) hz2))
  (let ((erased e4) (erased g4)) (gt-ex tb yl yr))
  (let ((erased hz4)) (hz-eqz sk1p e3 e4 v hz3 (gt-ez a1 tb yl yr e3 e4 te g3 g4)))
  (let-match erased g4 (MkGT _ _ _ _ _ _ zl4 Z4 gl4 gR4))
  (let ((erased zr4) (erased dz4) (erased gr4)) (dq-ungs d2 q3 rs3 rs4 yr Z4 f2 dq3 gR4))
  (let ((erased tl4)) (sde-out env rl0 (BTrue) le lp2 xl l2 yl zl4 ls3 f1 ebl cl2 txl bl3 z1 gl4))
  (let ((erased tr4)) (sde-out env rr (BFalse) re rp2 xr r2 yr zr4 rs3 f2 ebr cr2 txr br3 z2 gr4))
  (values v (MkHL env rl0 rr c2 v e4 (lc-of-dq env rl0 rr d2 l2 r2 q3 zl4 zr4 Z4 tl4 tr4 dz4) hz4) lt))

(def-fns _ $ (many cat-of : (erased Type A) (subterm many (List A) a) (many (List A) b) -> (many (List A) c) (erased (Cat A a b c) p))
  (let-match many a (Cons _ x a1) ((Nil _) (values b (CatN A b))))
  (let ((many c) (erased p)) (notail $ cat-of A a1 b))
  (values (Cons A x c) (CatC A x a1 b c p)))

(def-adts
  ((PbR : ((Bool) sd) ((Sy) s) -> Type)
    enum
    (many PbOk : (erased (Bool) sd) (erased (Sy) s) (many (List (Bool)) w) (erased (Pb sd s w) p) -> (PbR sd s))
    (many PbNo : (erased (Bool) sd) (erased (Sy) s) -> (PbR sd s))))

(def-fns _ $ (many fx-pb : (many (Bool) sd) (many (Fx) f) -> (many (PbR sd (YF f)) r))
  (match many sd _
    ((BTrue)
      (match many f _
        ((QD) (PbOk sd _ (bits "10110") (PbF sd f _ (AwDl))))
        ((QP) (PbOk sd _ (bits "110") (PbF sd f _ (AwP sd))))
        ((QC0) (PbOk sd _ (bits "1101110110") (PbF sd f _ (AwC0))))
        ((QC1) (PbOk sd _ (bits "100110") (PbF sd f _ (AwC1))))
        ((QC2) (PbOk sd _ (bits "11011110") (PbF sd f _ (AwC2))))
        ((QF0) (PbOk sd _ (bits "110111011110") (PbF sd f _ (AwF0))))
        ((QF1) (PbOk sd _ (bits "10011110") (PbF sd f _ (AwF1))))
        ((QF2) (PbOk sd _ (bits "1101111110") (PbF sd f _ (AwF2))))
        ((QF3) (PbOk sd _ (bits "101110") (PbF sd f _ (AwF3))))
        ((QG0) (PbOk sd _ (bits "11011101110110") (PbF sd f _ (AwG0))))
        ((QG1) (PbOk sd _ (bits "1001110110") (PbF sd f _ (AwG1))))
        ((QG2) (PbOk sd _ (bits "110111110110") (PbF sd f _ (AwG2))))))
    ((BFalse)
      (match many f _
        ((QD) (PbOk sd _ (bits "11010") (PbF sd f _ (AwDr))))
        ((QP) (PbOk sd _ (bits "110") (PbF sd f _ (AwP sd))))
        (else (PbNo sd _))))))

(def-fns _ $ (many pb-of : (many (Bool) sd) (many (Sy) s) -> (many (PbR sd s) r))
  (let-match many s (YW k n) ((YF f) (fx-pb sd f)) ((YC) (PbOk sd _ (bits "1010") (PbC sd))) (else (PbNo sd _)))
  (let-match many k (KX) (else (PbNo sd _)))
  (let-match many n (MkAm b c))
  (let-match many b (BFalse) ((BTrue) (PbNo sd _)))
  (let-match many (eq-nat c 1) (Some _ e) ((None _) (PbNo sd _)))
  (let-match erased e (Refl _ _))
  (PbOk sd _ (bits "110110") (PbX sd)))

(def-adts
  ((BwR : ((Bool) sd) ((List (Sy)) t) -> Type)
    enum
    (many BwOk : (erased (Bool) sd) (erased (List (Sy)) t) (many (List (Bool)) s) (erased (Bw sd t s) b) -> (BwR sd t))
    (many BwNo : (erased (Bool) sd) (erased (List (Sy)) t) -> (BwR sd t))))

(def-fns _ $ (many bw-of : (many (Bool) sd) (subterm many (List (Sy)) t) -> (many (BwR sd t) r))
  (let-match many t (Cons _ a t1) ((Nil _) (BwOk sd t (Nil (Bool)) (BwN sd))))
  (let-match many (notail $ bw-of sd t1) (BwOk _ _ s1 b) ((BwNo _ _) (BwNo sd t)))
  (let-match many (pb-of sd a) (PbOk _ _ w p) ((PbNo _ _) (BwNo sd t)))
  (let ((many s) (erased c)) (cat-of (Bool) w s1))
  (BwOk sd t s (BwC sd a t1 s1 w s b p c)))

(def-adts
  ((TaR : ((Mv) d) ((List (Sy)) lp) ((Bool) le) ((List (Sy)) rp) ((Bool) re) -> Type)
    enum
    (many TaOk : (erased (Mv) d) (erased (List (Sy)) lp rp) (erased (Bool) le re) (many (Ta) a) (erased (TaOf d lp le rp re a) p) -> (TaR d lp le rp re))
    (many TaNo : (erased (Mv) d) (erased (List (Sy)) lp rp) (erased (Bool) le re) -> (TaR d lp le rp re))))

(def-fns _ $ (many ta-of : (many (Mv) d) (many (List (Sy)) lp) (many (Bool) le) (many (List (Sy)) rp) (many (Bool) re) -> (many (TaR d lp le rp re) r))
  (let-match many (bw-of (BTrue) lp) (BwOk _ _ ls bl) ((BwNo _ _) (TaNo d lp rp le re)))
  (let-match many (bw-of (BFalse) rp) (BwOk _ _ rs br) ((BwNo _ _) (TaNo d lp rp le re)))
  (let ((many f1) (erased z1)) (match many le (((Tl) f) ((Tz le f) z)) ((BFalse) (values (TV) (TzF))) ((BTrue) (values (TZ) (TzT)))))
  (let ((many f2) (erased z2)) (match many re (((Tl) f) ((Tz re f) z)) ((BFalse) (values (TV) (TzF))) ((BTrue) (values (TZ) (TzT)))))
  (match many d _
    ((DR) (TaOk d lp rp le re (MkTa (Zero) d (MkSd ls f1) (MkSd rs f2)) (MkTaOf d lp rp le re ls rs rs (Zero) f1 f2 bl br (DqR rs) z1 z2)))
    ((DL) (TaOk d lp rp le re (MkTa 2 d (MkSd ls f1) (MkSd (Cons (Bool) (BTrue) (Cons (Bool) (BFalse) rs)) f2))
      (MkTaOf d lp rp le re ls rs _ 2 f1 f2 bl br (DqL rs) z1 z2)))))

(def-fns _ $ (many eqz-of : (subterm many (List (Bool)) a) (many (List (Bool)) b) -> (many (Maybe (Eqz a b)) r))
  (let-match many a (Cons _ x a1) ((Nil _) (match many (zeros-of b) _ ((ROk _ zb) (Some _ (EZ a b (ZN) zb))) ((RFail _) (None _)))))
  (let-match many b (Cons _ y b1) ((Nil _) (match many (zeros-of a) _ ((ROk _ za) (Some _ (EZ a b za (ZN)))) ((RFail _) (None _)))))
  (let-match many (eq-bit x y) (Some _ e) ((None _) (None _)))
  (let-match erased e (Refl _ _))
  (let-match many (notail $ eqz-of a1 b1) (Some _ e1) ((None _) (None _)))
  (Some _ (EC x a1 b1 e1)))

(def-fns _ $ (many sdez-of : (many (Sd) a) (many (Sd) b) -> (many (Maybe (SdEz a b)) r))
  (let-match many a (MkSd s f))
  (let-match many b (MkSd s2 f2))
  (match many f _
    ((TV)
      (let-match many f2 (TV) ((TZ) (None _)))
      (let-match many (eq-bl s s2) (Some _ e) ((None _) (None _)))
      (let-match erased e (Refl _ _))
      (Some _ (SEV s)))
    ((TZ)
      (let-match many f2 (TZ) ((TV) (None _)))
      (let-match many (eqz-of s s2) (Some _ e) ((None _) (None _)))
      (Some _ (SEZ s s2 e)))))

(def-fns _ $ (many taez-of : (many (Ta) a) (many (Ta) b) -> (many (Maybe (TaEz a b)) r))
  (let-match many a (MkTa q d L R))
  (let-match many b (MkTa q2 d2 L2 R2))
  (let-match many (eq-nat q q2) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (eq-dir d d2) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (let-match many (sdez-of L L2) (Some _ el) ((None _) (None _)))
  (let-match many (sdez-of R R2) (Some _ er) ((None _) (None _)))
  (Some _ (MkTaEz q d L R L2 R2 el er)))

(def-adts
  ((SzR : ((List (PT)) p) ((Ta) a) ((Ta) b) -> Type)
    enum
    (many SzOk : (erased (List (PT)) p) (erased (Ta) a b a1) (erased (ARun p a a1) ar) (erased (TaEz a1 b) te) -> (SzR p a b))
    (many SzNo : (erased (List (PT)) p) (erased (Ta) a b) -> (SzR p a b))))

(def-fns _ $ (many srz : (many (List (PT)) p) (many (Ta) a b) (subterm many (Nat) fuel) -> (many (SzR p a b) r))
  (let-match many fuel (Succ f) ((Zero) (SzNo p a b)))
  (let-match many (astep p a) (ASOk _ _ a1 st) ((ASNo _ _) (SzNo p a b)))
  (let-match many (taez-of a1 b) (None _) ((Some _ te) (SzOk p a b a1 (AR1 p a a1 st) te)))
  (let-match many (notail $ srz p a1 b f) (SzOk _ _ _ a2 ar te) ((SzNo _ _ _) (SzNo p a b)))
  (SzOk p a b a2 (ARS p a a1 a2 st ar) te))

(def-fns _ $ (many rl-ok : (many (List (PT)) p) (many (Rl) rl) -> (many (Res (RlOK p rl)) r))
  (let-match many rl (MkRl d lp le rp re d2 lp2 rp2))
  (let-match many (ta-of d lp le rp re) (TaOk _ _ _ _ _ ta ti) ((TaNo _ _ _ _ _) (RFail _)))
  (let-match many (ta-of d2 lp2 le rp2 re) (TaOk _ _ _ _ _ tb to) ((TaNo _ _ _ _ _) (RFail _)))
  (let-match many (srz p ta tb 3000) (SzOk _ _ _ a1 ar te) ((SzNo _ _ _) (RFail _)))
  (ROk _ (MkRlOK p d d2 lp rp lp2 rp2 le re ta tb a1 ti to ar te)))

(let ((many iX)) (YW (KX) (MkAm (BFalse) 1)))
(let ((many iD)) (YF (QD)))
(let ((many iP)) (YF (QP)))
