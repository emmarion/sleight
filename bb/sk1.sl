    ((StX _ _ v xs2 t0 _ a st1) (let-match erased lv (LvO _ _ _ _ lv1)) (st-lv xs2 n k t0 t2 st1 lv1))
    ((StD _ _ t0 t1 _ st1 pu) (let-match erased lv (LvO _ _ _ _ lv1)) (push-lv (KX) xs k _ t2 pu (LvO iD t1 k (NCF (QD)) (st-lv (Zero) n k t0 t1 st1 lv1))))
    ((StC _ _ d n2 n4 t0 t1 t3 _ a a2 a4 st1 pu pu2)
