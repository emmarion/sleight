    ((TNF _ f _) (TNF k f U0))
    ((TNC _ _) (TNC k U0))
    ((TNE _ _) (TNE k U0))
    ((TNV _ _) (TNV k U0))
    ((TNR _ b _) (TNR k b U0))
    ((TNW _ k2 n _ ne) (TNW k k2 n U0 ne))))

(def-fns _ $ (erased push-fr : (erased (Pk) k) (erased (Nat) a) (erased (List (Sy)) w w2 tz W) (erased (Push k a w w2) pu) (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c)
    -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (Push k a W W2) pu2))
  (let-match erased pu (PuM _ n m s t0 ad)
    ((PuZ _ _) (values W c (PuZ k W)))
    ((PuC _ n _ nk) (values (Cons (Sy) (YW k (MkAm (BFalse) (Succ n))) W) (CatC (Sy) _ w _ W c) (PuC k n W (notk-fr k w tz W nk c)))))
  (let-match erased c (CatC _ _ _ _ W0 c0))
  (values (Cons (Sy) (YW k (MkAm (BFalse) s)) W0) (CatC (Sy) _ t0 _ W0 c0) (PuM k n m s W0 ad)))

(def-fns _ $ (erased tpush-fr : (erased (Pk) k) (erased (Am) a) (erased (List (Sy)) w w2 tz W) (erased (TPush k a w w2) pu) (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c)
    (erased (Nx w) nx) -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (TPush k a W W2) pu2) (erased (Nx w2) nx2))
  (let-match erased pu (TPM _ _ m s t0 nz ca)
    ((TPZ _ _) (values W c (TPZ k W) nx))
    ((TPC _ _ _ nz nk) (values (Cons (Sy) (YW k a) W) (CatC (Sy) _ w _ W c) (TPC k a W nz (tnk-fr k w tz W nk c)) (NxC _ w (NsW k a) nx))))
  (let-match erased c (CatC _ _ _ _ W0 c0))
  (let-match erased nx (NxC _ _ _ nx0))
  (values (Cons (Sy) (YW k s) W0) (CatC (Sy) _ t0 _ W0 c0) (TPM k a m s W0 nz ca) (NxC _ t0 (NsW k s) nx0)))

(def-fns _ $ (erased trw-fr : (erased (Bool) sd) (erased (List (Sy)) w w2 tz W) (subterm erased (TRw sd w w2) rw) (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c) (erased (Nx w) nx)
    -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (TRw sd W W2) rw2) (erased (Nx w2) nx2))
  (match erased rw _
    ((TRSp _ kk k cc t0)
      (let-match erased c (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ _ nx0))
      (values (Cons (Sy) (YW k (MkAm (BFalse) 1)) (Cons (Sy) (YW k (MkAm kk cc)) W0)) (CatC (Sy) _ _ _ _ (CatC (Sy) _ t0 _ W0 c0)) (TRSp sd kk k cc W0)
        (NxC _ _ (NsW k _) (NxC _ t0 (NsW k _) nx0))))
    ((TRMg _ k n1 n2 n3 t0 a)
      (let-match erased c (CatC _ _ _ _ W1 c1))
      (let-match erased c1 (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ _ nx1))
      (let-match erased nx1 (NxC _ _ _ nx0))
      (values (Cons (Sy) (YW k n3) W0) (CatC (Sy) _ t0 _ W0 c0) (TRMg sd k n1 n2 n3 W0 a) (NxC _ t0 (NsW k n3) nx0)))
    ((TRPu _ k n t0 t3 pu)
      (let-match erased c (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ _ nx0))
      (let ((erased W2) (erased c2) (erased pu2) (erased nx2)) (tpush-fr k n t0 t3 tz W0 pu c0 nx0))
      (values W2 c2 (TRPu sd k n W0 W2 pu2) nx2))
    ((TRUf _ k cw t0 t3 cwp cc)
      (let-match erased c (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ _ nx0))
      (let ((erased W2) (erased c2)) (cat-ex (Sy) t3 (Cons (Sy) iD tz)))
      (let ((erased wy) (erased c3) (erased c4)) (cat-assoc (Sy) cw t0 t3 (Cons (Sy) iD tz) W2 cc c2))
      (let-match erased (cat-fn (Sy) t0 (Cons (Sy) iD tz) wy W0 c3 c0) (Refl _ _))
      (values W2 c2 (TRUf sd k cw W0 W2 cwp c4) (nx-cat cw t0 t3 cc (cw-nx sd k cw cwp) nx0)))
    ((TRUn _ s t0 t3 rw1)
      (let-match erased c (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ ns nx0))
      (let ((erased W3) (erased c3) (erased rw3) (erased nx3)) (trw-fr sd t0 t3 tz W0 rw1 c0 nx0))
      (values (Cons (Sy) s W3) (CatC (Sy) s t3 _ W3 c3) (TRUn sd s W0 W3 rw3) (NxC s t3 ns nx3)))))

(def-fns _ $ (erased tmv-fr : (erased (Mv) d d2) (erased (List (Sy)) l l2 w w2 tz W) (erased (TMv (MkCf d l w) (MkCf d2 l2 w2)) mv) (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c) (erased (Nx w) nx)
    -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (TMv (MkCf d l W) (MkCf d2 l2 W2)) mv2) (erased (Nx w2) nx2))
  (match erased mv _
    ((TMvL K ml mr r kl n L R R2 pu)
      (let ((erased W2) (erased c2) (erased pu2) (erased nx2)) (tpush-fr K n R R2 tz W pu c nx))
      (values W2 c2 (TMvL K ml mr r kl n L W W2 pu2) nx2))
    ((TMvR K ml mr r kl n L R L2 pu)
      (let-match erased c (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ _ nx0))
      (values W0 c0 (TMvR K ml mr r kl n L W0 L2 pu) nx0))
    ((TMvP n L R L2 pu)
      (let-match erased c (CatC _ _ _ _ W1 c1))
      (let-match erased c1 (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ ns nx1))
      (let-match erased nx1 (NxC _ _ _ nx0))
      (values (Cons (Sy) iP W0) (CatC (Sy) iP R _ W0 c0) (TMvP n L W0 L2 pu) (NxC iP R ns nx0)))
    ((TMvG n L R L2 pu)
      (let-match erased c (CatC _ _ _ _ W1 c1))
      (let-match erased c1 (CatC _ _ _ _ Wb cb))
      (let-match erased cb (CatC _ _ _ _ W0 c0))
      (let-match erased nx (NxC _ _ ns nx1))
      (let-match erased nx1 (NxC _ _ ns1 nxb))
      (let-match erased nxb (NxC _ _ _ nx0))
      (values (Cons (Sy) iP (Cons (Sy) iD W0)) (CatC (Sy) iP _ _ _ (CatC (Sy) iD R _ W0 c0)) (TMvG n L W0 L2 pu) (NxC iP _ ns (NxC iD R ns1 nx0))))))

(def-fns _ $ (erased sde-fr : (erased (Bool) e) (erased (List (Sy)) lp lp2 w w2 tz W) (erased (Sde e lp lp2 w w2) sd) (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c) (erased (Nx w) nx)
    (erased (Nx lp2) nx1) -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (Sde e lp lp2 W W2) sd2) (erased (Nx w2) nx2))
  (let-match erased sd (MkSde _ _ _ x _ _ eb ca cb))
  (let ((erased x2) (erased c3) (erased c4)) (cat-assoc (Sy) lp x w (Cons (Sy) iD tz) W ca c))
  (let ((erased W2) (erased c2)) (cat-ex (Sy) w2 (Cons (Sy) iD tz)))
  (let ((erased x3) (erased c5) (erased c6)) (cat-assoc (Sy) lp2 x w2 (Cons (Sy) iD tz) W2 cb c2))
  (let-match erased (cat-fn (Sy) x (Cons (Sy) iD tz) x2 x3 c3 c5) (Refl _ _))
  (let ((erased nxx)) (nx-suf lp x w ca nx))
  (let ((erased eb2)) (match erased eb (((EB e x2) eb2))
    ((EBV _) (EBV x2))
    ((EBE) (let-match erased nxx (NxC _ _ ns _)) (match erased ns _))))
  (values W2 c2 (MkSde e lp lp2 x2 W W2 eb2 c4 c6) (nx-cat lp2 x w2 cb nx1 nxx)))

(def-fns _ $ (erased tstp-fr : (erased (Mv) d d2) (erased (List (Sy)) l l2 w w2 tz W) (erased (Bool) g) (erased (TStp (MkCf d l w) (MkCf d2 l2 w2) g) ts)
    (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c) (erased (Nx w) nx)
    -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (TStp (MkCf d l W) (MkCf d2 l2 W2) g) ts2) (erased (Nx w2) nx2))
  (match erased ts _
    ((TSRl rl _ _ ok ap)
      (let-match erased ap (MkRApp _ _ lp rp lp2 rp2 _ _ _ _ le re sl sr))
      (let ((erased W2) (erased c2) (erased sr2) (erased nx2)) (sde-fr re rp rp2 w w2 tz W sr c nx (rl-nx d d2 lp rp lp2 rp2 le re ok)))
      (values W2 c2 (TSRl rl _ _ ok (MkRApp d d2 lp rp lp2 rp2 l W l2 W2 le re sl sr2)) nx2))
    ((TSRL _ _ _ _ rw) (values W c (TSRL d l l2 W rw) nx))
    ((TSRR _ _ _ _ rw)
      (let ((erased W2) (erased c2) (erased rw2) (erased nx2)) (trw-fr (BFalse) w w2 tz W rw c nx))
      (values W2 c2 (TSRR d l W W2 rw2) nx2))
    ((TSMv _ _ mv)
      (let ((erased W2) (erased c2) (erased mv2) (erased nx2)) (tmv-fr d d2 l l2 w w2 tz W mv c nx))
      (values W2 c2 (TSMv _ _ mv2) nx2))
    (absurd (TSSt _ _ _ st) (tst-nx az 1 w w2 st nx))
    (absurd (TSSn _ _ _ st) (st-nx (Zero) 1 w w2 st nx))))

(def-fns _ $ (erased trun-fr : (erased (Mv) d d2) (erased (List (Sy)) l l2 w w2 tz W) (erased (Bool) g) (subterm erased (TRun (MkCf d l w) (MkCf d2 l2 w2) g) tr)
    (erased (Cat (Sy) w (Cons (Sy) iD tz) W) c) (erased (Nx w) nx)
    -> (erased (List (Sy)) W2) (erased (Cat (Sy) w2 (Cons (Sy) iD tz) W2) c2) (erased (TRun (MkCf d l W) (MkCf d2 l2 W2) g) tr2) (erased (Nx w2) nx2))
  (let-match erased tr (TRS _ c1 _ g1 g2 _ r s o) ((TRZ _) (values W c (TRZ _) nx)))
  (let-match erased c1 (MkCf d1 l1 w1))
  (let ((erased W1) (erased cc1) (erased r2) (erased nx1)) (trun-fr d d1 l l1 w w1 tz W g1 r c nx))
  (let ((erased W2) (erased c2) (erased s2) (erased nx2)) (tstp-fr d1 d2 l1 l2 w1 w2 tz W1 g2 s cc1 nx1))
  (values W2 c2 (TRS _ _ _ g1 g2 g r2 s2 o) nx2))

(def-adts
  ((Swin : ((Nat) xs) ((Nat) n) ((List (Sy)) u) ((List (Sy)) w) ((Nat) m) -> Type)
    enum
    (many SwE : (erased (Nat) xs n) (erased (List (Sy)) w) (erased (Push (KX) xs (Nil (Sy)) w) pu) -> (Swin xs n (Nil (Sy)) w n))
    (many SwX : (erased (Nat) xs n v xs2 m) (erased (List (Sy)) u w) (erased (Add xs v xs2) a) (erased (Swin xs2 n u w m) s)
       -> (Swin xs n (Cons (Sy) (YW (KX) (MkAm (BFalse) v)) u) w m))
    (many SwD : (erased (Nat) xs n m) (erased (List (Sy)) u w1 w) (erased (Swin (Zero) n u w1 m) s) (erased (Push (KX) xs (Cons (Sy) iD w1) w) pu)
       -> (Swin xs n (Cons (Sy) iD u) w m))
    (many SwC : (erased (Nat) xs n d n2 n4 m) (erased (List (Sy)) u w1 w2 w) (erased (Add n d xs) a) (erased (Add n n n2) a2) (erased (Add n2 n2 n4) a4)
       (erased (Swin (Zero) n4 u w1 m) s) (erased (Push (KX) n2 w1 w2) pu) (erased (Push (KX) d (Cons (Sy) (YC) w2) w) pu2)
       -> (Swin xs n (Cons (Sy) (YC) u) w m))
    (many SwG : (erased (Nat) xs n g m) (erased (List (Sy)) u w1 w2 w) (erased (Swin (Zero) n u w1 m) s) (erased (Push (KG) g w1 w2) pu) (erased (Push (KX) xs w2 w) pu2)
       -> (Swin xs n (Cons (Sy) (YW (KG) (MkAm (BFalse) g)) u) w m))))

(def-fns _ $ (erased sw-st : (erased (Nat) xs n m) (erased (List (Sy)) u w tz U T2) (subterm erased (Swin xs n u w m) sw) (erased (Cat (Sy) u (Cons (Sy) iD tz) U) c)
    (erased (St (Zero) m tz T2) st) -> (erased (List (Sy)) W) (erased (Cat (Sy) w (Cons (Sy) iD T2) W) c2) (erased (St xs n U W) st2))
  (match erased sw _
    ((SwE _ _ _ pu)
      (let-match erased c (CatN _ _))
      (let ((erased W) (erased c2) (erased pu2)) (push-fr (KX) xs (Nil (Sy)) w T2 (Cons (Sy) iD T2) pu (CatN (Sy) _)))
      (values W c2 (StD xs n tz T2 W st pu2)))
    ((SwX _ _ v xs2 _ u0 _ a s)
      (let-match erased c (CatC _ _ _ _ U0 c0))
      (let ((erased W) (erased c2) (erased st2)) (sw-st xs2 n m u0 w tz U0 T2 s c0 st))
      (values W c2 (StX xs n v xs2 U0 W a st2)))
    ((SwD _ _ _ u0 w1 _ s pu)
      (let-match erased c (CatC _ _ _ _ U0 c0))
      (let ((erased W1) (erased c1) (erased st1)) (sw-st (Zero) n m u0 w1 tz U0 T2 s c0 st))
      (let ((erased W) (erased c2) (erased pu2)) (push-fr (KX) xs (Cons (Sy) iD w1) w T2 (Cons (Sy) iD W1) pu (CatC (Sy) iD w1 _ W1 c1)))
      (values W c2 (StD xs n U0 W1 W st1 pu2)))
    ((SwC _ _ d n2 n4 _ u0 w1 w2 _ a a2 a4 s pu pu2)
      (let-match erased c (CatC _ _ _ _ U0 c0))
      (let ((erased W1) (erased c1) (erased st1)) (sw-st (Zero) n4 m u0 w1 tz U0 T2 s c0 st))
      (let ((erased W2) (erased c3) (erased pu3)) (push-fr (KX) n2 w1 w2 T2 W1 pu c1))
      (let ((erased W) (erased c2) (erased pu4)) (push-fr (KX) d (Cons (Sy) (YC) w2) w T2 (Cons (Sy) (YC) W2) pu2 (CatC (Sy) (YC) w2 _ W2 c3)))
      (values W c2 (StC xs n d n2 n4 U0 W1 W2 W a a2 a4 st1 pu3 pu4)))
    ((SwG _ _ g _ u0 w1 w2 _ s pu pu2)
      (let-match erased c (CatC _ _ _ _ U0 c0))
      (let ((erased W1) (erased c1) (erased st1)) (sw-st (Zero) n m u0 w1 tz U0 T2 s c0 st))
      (let ((erased W2) (erased c3) (erased pu3)) (push-fr (KG) g w1 w2 T2 W1 pu c1))
      (let ((erased W) (erased c2) (erased pu4)) (push-fr (KX) xs w2 w T2 W2 pu2 c3))
      (values W c2 (StG xs n g U0 W1 W2 W st1 pu3 pu4)))))

(def-fns _ $ (erased sw-nx : (erased (Nat) xs n m) (erased (List (Sy)) u w) (subterm erased (Swin xs n u w m) sw) -> (erased (Nx w) p))
  (match erased sw _
    ((SwE _ _ _ pu) (push-nx (KX) xs _ w pu (NxN)))
    ((SwX _ _ v xs2 _ u0 _ a s) (sw-nx xs2 n m u0 w s))
    ((SwD _ _ _ u0 w1 _ s pu) (push-nx (KX) xs _ w pu (NxC iD w1 (NsF (QD)) (sw-nx (Zero) n m u0 w1 s))))
    ((SwC _ _ d n2 n4 _ u0 w1 w2 _ a a2 a4 s pu pu2)
      (push-nx (KX) d _ w pu2 (NxC (YC) w2 (NsC) (push-nx (KX) n2 w1 w2 pu (sw-nx (Zero) n4 m u0 w1 s)))))
    ((SwG _ _ g _ u0 w1 w2 _ s pu pu2) (push-nx (KX) xs w2 w pu2 (push-nx (KG) g w1 w2 pu (sw-nx (Zero) n m u0 w1 s))))))

(def-adts
  ((SwR : ((Nat) xs) ((Nat) n) ((List (Sy)) u) -> Type)
    enum
    (many SwOk : (erased (Nat) xs n) (erased (List (Sy)) u) (many (List (Sy)) w) (many (Nat) m) (erased (Swin xs n u w m) p) -> (SwR xs n u))
    (many SwNo : (erased (Nat) xs n) (erased (List (Sy)) u) -> (SwR xs n u))))

(def-adts
  ((Xz : ((Nat) xs c) ((List (Sy)) u) -> Type)
    enum
    (many XzY : (erased (Nat) c1) (erased (List (Sy)) u) -> (Xz (Zero) (Succ c1) (Cons (Sy) iD u)))
    (many XzN : (erased (Nat) xs c) (erased (List (Sy)) u) -> (Xz xs c u))))

(def-fns _ $ (many xz-of : (many (Nat) xs c) (many (List (Sy)) u) -> (many (Xz xs c u) r))
  (let-match many xs (Zero) ((Succ _) (XzN xs c u)))
  (let-match many (nat-cmp (Zero) c) (CLt _ _ _ _ p) ((CEq _ _ _) (XzN xs c u)) (absurd (CGt _ _ _ _ q) q))
  (let-match erased p (LtZ c1))
  (let-match many u (Cons _ s u1) ((Nil _) (XzN xs c u)))
  (let-match many s (YF f) (else (XzN xs c u)))
  (let-match many f (QD) (else (XzN xs c u)))
  (XzY c1 u1))

(def-fns _ $ (many sw-of : (many (Nat) xs n) (subterm many (List (Sy)) u) -> (many (SwR xs n u) r))
  (let-match many u (Cons _ s u0) ((Nil _)
    (let ((many w) (erased pu)) (push-ex (KX) xs (Nil (Sy))))
    (SwOk xs n u w n (SwE xs n w pu))))
  (match many s _
    ((YF f)
      (let-match many f (QD) (else (SwNo xs n u)))
      (let-match many (notail $ sw-of (Zero) n u0) (SwOk _ _ _ w1 m s1) ((SwNo _ _ _) (SwNo xs n u)))
      (let ((many w) (erased pu)) (push-ex (KX) xs (Cons (Sy) iD w1)))
      (SwOk xs n u w m (SwD xs n m u0 w1 w s1 pu)))
    ((YC)
      (let-match many (lt-dec n (Succ xs)) (Yes _ _ _ _ p) ((No _ _ _ _ _) (SwNo xs n u)))
      (let ((many d) (erased ad)) (sub xs n p))
      (let ((many n2) (erased a2)) (add n n))
      (let ((many n4) (erased a4)) (add n2 n2))
      (let-match many (notail $ sw-of (Zero) n4 u0) (SwOk _ _ _ w1 m s1) ((SwNo _ _ _) (SwNo xs n u)))
      (let ((many w2) (erased pu)) (push-ex (KX) n2 w1))
      (let ((many w) (erased pu2)) (push-ex (KX) d (Cons (Sy) (YC) w2)))
      (SwOk xs n u w m (SwC xs n d n2 n4 m u0 w1 w2 w ad a2 a4 s1 pu pu2)))
    ((YW k v)
      (let-match many v (MkAm b c))
      (let-match many b (BFalse) ((BTrue) (SwNo xs n u)))
      (match many k _
        ((KX)
          (let-match many (xz-of xs c u0) (XzN _ _ _) ((XzY c1 _)
            (let-match many u0 (Cons _ _ u1))
            (let-match many (notail $ sw-of (Zero) n u1) (SwOk _ _ _ w1 m s1) ((SwNo _ _ _) (SwNo xs n u)))
            (let ((many w)) (Cons (Sy) s (Cons (Sy) iD w1)))
            (SwOk xs n u w m (SwX xs n c c m u0 w (AddZero c) (SwD c n m u1 w1 w s1 (PuC (KX) c1 _ (NKF (KX) (QD) w1)))))))
          (let ((many xs2) (erased a)) (add xs c))
          (let-match many (notail $ sw-of xs2 n u0) (SwOk _ _ _ w m s1) ((SwNo _ _ _) (SwNo xs n u)))
          (SwOk xs n u w m (SwX xs n c xs2 m u0 w a s1)))
        ((KG)
          (let-match many (notail $ sw-of (Zero) n u0) (SwOk _ _ _ w1 m s1) ((SwNo _ _ _) (SwNo xs n u)))
          (let ((many w2) (erased pu)) (push-ex (KG) c w1))
          (let ((many w) (erased pu2)) (push-ex (KX) xs w2))
          (SwOk xs n u w m (SwG xs n c m u0 w1 w2 w s1 pu pu2)))
        (else (SwNo xs n u))))
    (else (SwNo xs n u))))

(def-adts
  ((Ds : ((List (Sy)) r) -> Type)
    enum
    (many DsOk : (erased (List (Sy)) r) (many (List (Sy)) u t) (erased (Cat (Sy) u (Cons (Sy) iD t) r) c) -> (Ds r))
    (many DsNo : (erased (List (Sy)) r) -> (Ds r))))

(def-fns _ $ (many ds-cons : (many (Sy) s) (many (List (Sy)) r) (many (Ds r) x) -> (many (Ds (Cons (Sy) s r)) y))
  (let-match many x (DsOk _ u t c) ((DsNo _) (DsNo _)))
  (DsOk _ (Cons (Sy) s u) t (CatC (Sy) s u _ r c)))

(def-fns _ $ (many dsplit : (many (Nat) k) (subterm many (List (Sy)) r) -> (many (Ds r) x))
  (let-match many r (Cons _ s r0) ((Nil _) (DsNo r)))
  (let-match many k (Zero) ((Succ j) (ds-cons s r0 (notail $ dsplit j r0))))
  (let-match many s (YF f) (else (ds-cons s r0 (notail $ dsplit (Zero) r0))))
  (let-match many f (QD) (else (ds-cons s r0 (notail $ dsplit (Zero) r0))))
  (DsOk r (Nil (Sy)) r0 (CatN (Sy) r)))

(def-adts $ (Pn : -> Type)
  enum
  (many PnE : -> (Pn))
  (many PnP : (many (Nat) q) -> (Pn)))

(def-adts $ (Zk : -> Type)
  enum
  (many ZkB : (many (Pn) pd) (many (List (Sy)) t) (many (Maybe (Nat)) c) -> (Zk))
  (many ZkC : (many (Pn) pd) (many (List (Sy)) s) (many (Maybe (Nat)) c) (many (Zk) k) -> (Zk)))

(def-adts
  ((Za : ((Pn) pd) ((List (Sy)) x y) -> Type)
    enum
    (many ZaE : (erased (List (Sy)) x) -> (Za (PnE) x x))
    (many ZaP : (erased (Nat) q) (erased (List (Sy)) x y) (erased (St (Zero) q x y) st) -> (Za (PnP q) x y))))

(def-adts
  ((Dn : ((Zk) k) ((List (Sy)) x) -> Type)
    enum
    (many DnB : (erased (Pn) pd) (erased (List (Sy)) t x) (erased (Maybe (Nat)) c) (erased (Za pd t x) a) -> (Dn (ZkB pd t c) x))
    (many DnC : (erased (Pn) pd) (erased (List (Sy)) s y sy x) (erased (Maybe (Nat)) c) (erased (Zk) k) (erased (Dn k y) dn)
       (erased (Cat (Sy) s (Cons (Sy) iD y) sy) cs) (erased (Za pd sy x) a) -> (Dn (ZkC pd s c k) x))))

(def-adts
  ((Pq : ((Pn) pd pc pd2) -> Type)
    enum
    (many PqE : (erased (Pn) pd) -> (Pq pd (PnE) pd))
    (many PqN : (erased (Nat) m) -> (Pq (PnE) (PnP m) (PnP m)))
    (many PqA : (erased (Nat) q m qm) (erased (Add q m qm) a) -> (Pq (PnP q) (PnP m) (PnP qm)))))

(def-adts
  ((Kt : ((Zk) k) ((Pn) pc) ((Zk) k2) -> Type)
    enum
    (many KtB : (erased (Pn) pd pc pd2) (erased (List (Sy)) t) (erased (Maybe (Nat)) c c2) (erased (Pq pd pc pd2) pq) -> (Kt (ZkB pd t c) pc (ZkB pd2 t c2)))
    (many KtC : (erased (Pn) pd pc pd2) (erased (List (Sy)) s) (erased (Maybe (Nat)) c c2) (erased (Zk) k) (erased (Pq pd pc pd2) pq)
       -> (Kt (ZkC pd s c k) pc (ZkC pd2 s c2 k)))))

(def-adts
  ((Xp : ((Pn) pd) ((List (Sy)) s s2) ((Pn) pc) -> Type)
    enum
    (many XpE : (erased (List (Sy)) s) -> (Xp (PnE) s s (PnE)))
    (many XpP : (erased (Nat) q m) (erased (List (Sy)) s s2) (erased (Swin (Zero) q s s2 m) sw) -> (Xp (PnP q) s s2 (PnP m)))))

(def-adts
  ((Lp : ((Zk) k) ((List (Sy)) s2) ((Zk) k2) -> Type)
    enum
    (many LpB : (erased (Pn) pd pc) (erased (List (Sy)) t u u2 t1) (erased (Maybe (Nat)) c c2) (erased (Cat (Sy) u (Cons (Sy) iD t1) t) ct) (erased (Xp pd u u2 pc) xp)
       -> (Lp (ZkB pd t c) u2 (ZkB pc t1 c2)))
    (many LpC : (erased (Pn) pd pc) (erased (List (Sy)) s s2) (erased (Maybe (Nat)) c) (erased (Zk) k k2) (erased (Xp pd s s2 pc) xp) (erased (Kt k pc k2) kt)
       -> (Lp (ZkC pd s c k) s2 k2))))

(def-adts
  ((Chk : ((List (Sy)) t) ((Maybe (Zk)) mb) ((Zk) k) -> Type)
    enum
    (many ChB : (erased (List (Sy)) t) (erased (Maybe (Nat)) c) -> (Chk t (None (Zk)) (ZkB (PnE) t c)))
    (many ChO : (erased (List (Sy)) t) (erased (Maybe (Nat)) c) (erased (Zk) k) -> (Chk t (Some (Zk) k) (ZkC (PnE) t c k)))
    (many ChS : (erased (List (Sy)) t a t1) (erased (Maybe (Zk)) mb) (erased (Maybe (Nat)) c) (erased (Zk) k) (erased (Cat (Sy) a (Cons (Sy) iD t1) t) ct)
       (erased (Chk t1 mb k) ch) -> (Chk t mb (ZkC (PnE) a c k)))))

(def-adts
  ((Db : ((Maybe (Zk)) mb) ((List (Sy)) t x) -> Type)
    enum
    (many DbN : (erased (List (Sy)) t) -> (Db (None (Zk)) t t))
    (many DbS : (erased (Zk) k) (erased (List (Sy)) t y x) (erased (Dn k y) dn) (erased (Cat (Sy) t (Cons (Sy) iD y) x) c) -> (Db (Some (Zk) k) t x))))

(def-fns _ $ (erased pq-za : (erased (Pn) pd pc pd2) (erased (List (Sy)) y x) (erased (Pq pd pc pd2) pq) (erased (Za pd2 y x) a)
    -> (erased (List (Sy)) z) (erased (Za pd y z) a1) (erased (Za pc z x) a2))
  (let-match erased pq (PqA q m qm ad) ((PqE _) (values x a (ZaE x))) ((PqN m) (values y (ZaE y) a)))
  (let-match erased a (ZaP _ _ _ st))
  (let ((erased z) (erased s1) (erased s2)) (st-add (Zero) qm y x st q m ad))
  (values z (ZaP q y z s1) (ZaP m z x s2)))

(def-fns _ $ (erased kt-dn : (erased (Zk) k k2) (erased (Pn) pc) (erased (List (Sy)) x) (erased (Kt k pc k2) kt) (erased (Dn k2 x) dn)
    -> (erased (List (Sy)) z) (erased (Dn k z) dn2) (erased (Za pc z x) a))
  (match erased kt _
    ((KtB pd _ pd2 t c _ pq)
      (let-match erased dn (DnB _ _ _ _ a0))
      (let ((erased z) (erased a1) (erased a2)) (pq-za pd pc pd2 t x pq a0))
      (values z (DnB pd t z c a1) a2))
    ((KtC pd _ pd2 s c _ ks pq)
      (let-match erased dn (DnC _ _ y sy _ _ _ dn1 cs a0))
      (let ((erased z) (erased a1) (erased a2)) (pq-za pd pc pd2 sy x pq a0))
      (values z (DnC pd s y sy z c ks dn1 cs a1) a2))))

(def-fns _ $ (erased xp-dn : (erased (Pn) pd pc) (erased (List (Sy)) s s2 z sz y) (erased (Xp pd s s2 pc) xp) (erased (Cat (Sy) s (Cons (Sy) iD z) sz) cz) (erased (Za pc z y) a)
    -> (erased (List (Sy)) x) (erased (Za pd sz x) a2) (erased (Cat (Sy) s2 (Cons (Sy) iD y) x) c))
  (match erased xp _
    ((XpE _) (let-match erased a (ZaE _)) (values sz (ZaE sz) cz))
    ((XpP q m _ _ sw)
      (let-match erased a (ZaP _ _ _ st))
      (let ((erased W) (erased c2) (erased st2)) (sw-st (Zero) q m s s2 z sz y sw cz st))
      (values W (ZaP q sz W st2) c2))))

(def-fns _ $ (erased lp-dn : (erased (Zk) k k2) (erased (List (Sy)) s2 y) (erased (Lp k s2 k2) lp) (erased (Dn k2 y) dn)
    -> (erased (List (Sy)) x) (erased (Dn k x) dn2) (erased (Cat (Sy) s2 (Cons (Sy) iD y) x) c))
  (match erased lp _
    ((LpB pd pc t u _ t1 c _ ct xp)
      (let-match erased dn (DnB _ _ _ _ a))
      (let ((erased x) (erased a2) (erased c2)) (xp-dn pd pc u s2 t1 t y xp ct a))
      (values x (DnB pd t x c a2) c2))
    ((LpC pd pc s _ c ks _ xp kt)
      (let ((erased z) (erased dn1) (erased a)) (kt-dn ks k2 pc y kt dn))
      (let ((erased sz) (erased cz)) (cat-ex (Sy) s (Cons (Sy) iD z)))
      (let ((erased x) (erased a2) (erased c2)) (xp-dn pd pc s s2 z sz y xp cz a))
      (values x (DnC pd s z sz x c ks dn1 cz a2) c2))))

(def-fns _ $ (erased ch-dn : (erased (List (Sy)) t x) (erased (Maybe (Zk)) mb) (erased (Zk) k) (subterm erased (Chk t mb k) ch) (erased (Dn k x) dn) -> (erased (Db mb t x) db))
  (match erased ch _
    ((ChB _ c) (let-match erased dn (DnB _ _ _ _ a)) (let-match erased a (ZaE _)) (DbN t))
    ((ChO _ c kb) (let-match erased dn (DnC _ _ y _ _ _ _ dn0 cs a)) (let-match erased a (ZaE _)) (DbS kb t y x dn0 cs))
    ((ChS _ a0 t1 _ c ks ct ch1)
      (let-match erased dn (DnC _ _ y1 _ _ _ _ dn1 cs a))
      (let-match erased a (ZaE _))
      (match erased (ch-dn t1 y1 mb ks ch1 dn1) _
        ((DbN _) (let-match erased (cat-fn (Sy) a0 (Cons (Sy) iD t1) x t cs ct) (Refl _ _)) (DbN t))
        ((DbS kb _ y _ dn0 c1)
          (let ((erased X) (erased cX)) (cat-ex (Sy) t (Cons (Sy) iD y)))
          (let ((erased bc) (erased c3) (erased c4)) (cat-assoc (Sy) a0 (Cons (Sy) iD t1) t _ X ct cX))
          (let-match erased c3 (CatC _ _ _ _ bc1 c5))
          (let-match erased (cat-fn (Sy) t1 (Cons (Sy) iD y) bc1 y1 c5 c1) (Refl _ _))
          (let-match erased (cat-fn (Sy) a0 (Cons (Sy) iD y1) X x c4 cs) (Refl _ _))
          (DbS kb t y x dn0 cX))))))

(def-adts
  ((Lz : ((Zk) k) ((Mv) d) ((List (Sy)) l w) -> Type)
    enum
    (many LzB : (erased (List (Sy)) l r u t) (erased (Zk) k) (erased (MRun sk1-blank (MkCf (DR) l r)) mr) (erased (Cat (Sy) u (Cons (Sy) iD t) r) c)
       (erased (Chk t (None (Zk)) k) ch) -> (Lz k (DR) l u))
    (many LzS : (erased (List (Sy)) l w w2) (erased (Nat) m) (erased (Zk) k k2) (erased (Lz k (DR) l w) z) (erased (Swin (Zero) 1 w w2 m) s) (erased (Kt k (PnP m) k2) kt)
       -> (Lz k2 (DL) l w2))
    (many LzT : (erased (Mv) d d2) (erased (List (Sy)) l l2 u u2) (erased (Zk) k) (erased (Bool) g) (erased (Lz k d l u) z)
       (erased (TRun (MkCf d l u) (MkCf d2 l2 u2) g) tr) (erased (Nx u) nx) -> (Lz k d2 l2 u2))
    (many LzP : (erased (Mv) d) (erased (List (Sy)) l w s W) (erased (Zk) k k2) (erased (Lz k d l w) z) (erased (Lp k s k2) lp) (erased (Cat (Sy) w (Cons (Sy) iD s) W) c)
       -> (Lz k2 d l W))
    (many LzF : (erased (Mv) d) (erased (List (Sy)) l w w1 w2) (erased (Zk) k k2) (erased (Lz k d l w) z) (erased (Cat (Sy) w1 (Cons (Sy) iD w2) w) c)
       (erased (Chk w2 (Some (Zk) k) k2) ch) -> (Lz k2 d l w1))))

(def-fns _ $ (erased mr-st : (erased (Cf) c c2) (erased (Bool) g) (erased (MRun sk1-blank c) mr) (erased (TStp c c2 g) s) -> (erased (MRun sk1-blank c2) mr2))
  (MRS sk1-blank c c2 g mr (TRS c c c2 (BFalse) g g (TRZ c) s (OrbF g))))

(def-fns _ $ (erased lz-force : (erased (Zk) k) (erased (List (Sy)) x l w W) (erased (Mv) d) (subterm erased (Lz k d l w) z) (erased (Dn k x) dn)
    (erased (Cat (Sy) w (Cons (Sy) iD x) W) c) -> (erased (MRun sk1-blank (MkCf d l W)) mr))
  (match erased z _
    ((LzB _ r _ t _ mr c0 ch)
      (let-match erased (ch-dn t x (None _) k ch dn) (DbN _))
      (let-match erased (cat-fn (Sy) w (Cons (Sy) iD t) r W c0 c) (Refl _ _))
      mr)
    ((LzS _ w0 _ m kb _ z1 s kt)
      (let ((erased y) (erased dn1) (erased a)) (kt-dn kb k (PnP m) x kt dn))
      (let-match erased a (ZaP _ _ _ st))
      (let ((erased U1) (erased c1)) (cat-ex (Sy) w0 (Cons (Sy) iD y)))
      (let ((erased W2) (erased c2) (erased st2)) (sw-st (Zero) 1 m w0 w y U1 x s c1 st))
      (let-match erased (cat-fn (Sy) w (Cons (Sy) iD x) W2 W c2 c) (Refl _ _))
      (mr-st _ _ (BFalse) (lz-force kb y l w0 U1 (DR) z1 dn1 c1) (TSSn l U1 W st2)))
    ((LzT d1 _ l1 _ u _ _ g z1 tr nx)
      (let ((erased U1) (erased c1)) (cat-ex (Sy) u (Cons (Sy) iD x)))
      (let ((erased W2) (erased c2) (erased tr2) (erased nx2)) (trun-fr d1 d l1 l u w x U1 g tr c1 nx))
      (let-match erased (cat-fn (Sy) w (Cons (Sy) iD x) W2 W c2 c) (Refl _ _))
      (MRS sk1-blank _ _ g (lz-force k x l1 u U1 d1 z1 dn c1) tr2))
    ((LzP _ _ w0 s _ kb _ z1 lp c1)
      (let ((erased x0) (erased dn0) (erased c0)) (lp-dn kb k s x lp dn))
      (let ((erased wy) (erased c3) (erased c4)) (cat-assoc (Sy) w0 (Cons (Sy) iD s) w _ W c1 c))
      (let-match erased c3 (CatC _ _ _ _ wy1 c5))
      (let-match erased (cat-fn (Sy) s (Cons (Sy) iD x) x0 wy1 c0 c5) (Refl _ _))
      (lz-force kb x0 l w0 W d z1 dn0 c4))
    ((LzF _ _ w0 _ w2 kb _ z1 c1 ch)
      (let-match erased (ch-dn w2 x (Some _ kb) k ch dn) (DbS _ _ y _ dn1 cs))
      (let ((erased W1) (erased c2)) (cat-ex (Sy) w0 (Cons (Sy) iD y)))
      (let ((erased bc) (erased c3) (erased c4)) (cat-assoc (Sy) w (Cons (Sy) iD w2) w0 _ W1 c1 c2))
      (let-match erased c3 (CatC _ _ _ _ bc1 c5))
      (let-match erased (cat-fn (Sy) w2 (Cons (Sy) iD y) bc1 x c5 cs) (Refl _ _))
      (let-match erased (cat-fn (Sy) w (Cons (Sy) iD x) W1 W c4 c) (Refl _ _))
      (lz-force kb y l w0 W1 d z1 dn1 c2))))

(def-fns _ $ (many zk-cap : (many (Zk) k) -> (many (Maybe (Nat)) c))
  (match many k _ ((ZkB _ _ c) c) ((ZkC _ _ c _) c)))

(def-fns _ $ (many pn-n : (many (Pn) pd) -> (many (Nat) n))
  (match many pd _ ((PnE) (Zero)) ((PnP q) q)))

(def-fns _ $ (many cap-sub : (many (Maybe (Nat)) c) (many (Nat) m) -> (many (Maybe (Nat)) r))
  (let-match many c (Some _ k) ((None _) (None _)))
  (let-match many (lt-dec m (Succ k)) (Yes _ _ _ _ p) ((No _ _ _ _ _) (Some _ (Zero))))
  (let ((many d) (erased _)) (sub k m p))
  (Some _ d))

(def-fns _ $ (many pq-of : (many (Pn) pd pc) -> (many (Pn) pd2) (erased (Pq pd pc pd2) pq))
  (let-match many pc (PnP m) ((PnE) (values pd (PqE pd))))
  (let-match many pd (PnP q) ((PnE) (values (PnP m) (PqN m))))
  (let ((many qm) (erased a)) (add q m))
  (values (PnP qm) (PqA q m qm a)))

(def-fns _ $ (many kt-of : (many (Zk) k) (many (Pn) pc) -> (many (Zk) k2) (erased (Kt k pc k2) kt))
  (match many k _
    ((ZkB pd t c) (let ((many pd2) (erased pq)) (pq-of pd pc)) (values (ZkB pd2 t (cap-sub c (pn-n pc))) (KtB pd pc pd2 t c _ pq)))
    ((ZkC pd s c ks) (let ((many pd2) (erased pq)) (pq-of pd pc)) (values (ZkC pd2 s (cap-sub c (pn-n pc)) ks) (KtC pd pc pd2 s c _ ks pq)))))

(def-adts
  ((XpR : ((Pn) pd) ((List (Sy)) s) -> Type)
    enum
