(def-fns _ $ (erased st-sound : (subterm erased (Nat) rr) (subterm erased (Nat) k) (erased (Nat) xs) (erased (List (Sy)) t t2) (subterm erased (St xs 1 t t2) st)
    (erased (Lv t k) lv) (erased (Env) env) (erased (Nat) rl u) (erased (List (Sy)) L)
    (erased (HU env rl rr (MkCf (DR) (Cons (Sy) (YW (KX) (MkAm (BFalse) xs)) L) t) u) hu) -> (erased (HU env rl rr (MkCf (DL) L t2) u) hu2))
