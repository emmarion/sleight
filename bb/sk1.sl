      (let-match erased ins (InC _ _ _ _ s0 i ins0))
      (let-match erased i (I1W _ v _ _ cv))
      (let ((erased s2) (erased ins2) (erased pu2)) (tpush-push a0 v k n t0 t2 s0 pu ins0 cv))
      (values s2 ins2 (RwPu sd k v s0 s2 pu2)))
    ((TRUf _ k cw t0 _ cw1 c)
      (let-match erased ins (InC _ _ _ _ s0 i ins0))
      (let-match erased i (I1W _ v _ _ cv))
      (let-match erased cv (CVF _ _))
      (let ((erased s2) (erased ins2) (erased c2)) (ins-join (Succ a0) cw t0 t2 s0 c (cw-ins (Succ a0) sd k cw cw1) ins0))
      (values s2 ins2 (RwUf sd k cw s0 s2 cw1 c2)))
    ((TRUn _ x t0 t3 w1)
      (let-match erased ins (InC _ _ y _ s0 i ins0))
      (let ((erased s3) (erased ins3) (erased rw)) (trw-srw a0 sd t0 t3 s0 w1 ins0))
      (values (Cons (Sy) y s3) (InC _ _ _ _ _ i ins3) (RwUn sd y s0 s3 rw)))))

(def-fns _ $ (erased tmv-hu : (erased (Nat) a0) (erased (Cf) c c2 sc) (erased (TMv c c2) mv) (erased (InsC (Succ a0) c sc) ic) (erased (Env) env) (erased (Nat) rl rr u)
    (erased (HU env rl rr sc u) hu) -> (erased (Cf) sc2) (erased (InsC (Succ a0) c2 sc2) ic2) (erased (HU env rl rr sc2 u) hu2))
  (let-match erased ic (MkInsC _ d l r l2 r2 il ir))
  (match erased mv _
    ((TMvL K ml mr k kl n L R R2 pu)
      (let-match erased il (InC _ _ _ _ L2 i ilL))
      (let-match erased i (I1W _ v _ _ cv))
      (let ((erased S2) (erased ir2) (erased pu2)) (tpush-push a0 v K n R R2 r2 pu ir cv))
      (values (MkCf (DL) L2 S2) (MkInsC _ _ _ _ _ _ ilL ir2) (hu-ml K ml mr k kl v L2 r2 S2 pu2 env rl rr u hu)))
    ((TMvR K ml mr k kl n L R L3 pu)
      (let-match erased ir (InC _ _ _ _ R2 i irR))
      (let-match erased i (I1W _ v _ _ cv))
      (let ((erased S2) (erased il2) (erased pu2)) (tpush-push a0 v K n L L3 l2 pu il cv))
      (values (MkCf (DR) S2 R2) (MkInsC _ _ _ _ _ _ il2 irR) (hu-mr K ml mr k kl v l2 R2 S2 pu2 env rl rr u hu)))
    ((TMvP n L R L3 pu)
      (let-match erased ir (InC _ _ _ _ R1 i1 ir1))
      (let-match erased i1 (I1F _ _))
      (let-match erased ir1 (InC _ _ _ _ R2 i ir2))
      (let-match erased i (I1W _ v _ _ cv))
      (let ((erased S2) (erased il2) (erased pu2)) (tpush-push a0 v (KX) n L L3 l2 pu il cv))
      (values (MkCf (DR) S2 (Cons (Sy) iP R2)) (MkInsC _ _ _ _ _ _ il2 (InC _ _ _ _ _ (I1F _ (QP)) ir2)) (hu-mp v l2 R2 S2 pu2 env rl rr u hu)))
    ((TMvG n L R L3 pu)
      (let-match erased ir (InC _ _ _ _ R1 i1 ir1))
      (let-match erased i1 (I1F _ _))
      (let-match erased ir1 (InC _ _ _ _ R0 i0 ir0))
      (let-match erased i0 (I1F _ _))
      (let-match erased ir0 (InC _ _ _ _ R2 i ir2))
      (let-match erased i (I1W _ v _ _ cv))
      (let ((erased S2) (erased il2) (erased pu2)) (tpush-push a0 v (KH) n L L3 l2 pu il cv))
      (values (MkCf (DR) S2 (Cons (Sy) iP (Cons (Sy) iD R2))) (MkInsC _ _ _ _ _ _ il2 (InC _ _ _ _ _ (I1F _ (QP)) (InC _ _ _ _ _ (I1F _ (QD)) ir2)))
        (hu-mg v l2 R2 S2 pu2 env rl rr u hu)))))

(def-adts
  ((Lg : ((Bool) g) ((Nat) v) ((Nat) u) -> Type)
    enum
    (many LgT : (erased (Nat) v u) (erased (Lt v u) lt) -> (Lg (BTrue) v u))
    (many LgF : (erased (Nat) v u) (erased (Lt v (Succ u)) lt) -> (Lg (BFalse) v u))))

(def-fns _ $ (erased lg-cat : (erased (Bool) g1 g2 g) (erased (Nat) v1 v2 u) (erased (Lg g1 v1 u) p) (erased (Lg g2 v2 v1) q) (erased (Orb g1 g2 g) o) -> (erased (Lg g v2 u) r))
  (let ((erased l2)) (match erased q (((Lt v2 (Succ v1)) l2)) ((LgT _ _ lt) (lt-weaken v2 v1 lt)) ((LgF _ _ lt) lt)))
  (match erased o _
    ((OrbT _) (let-match erased p (LgT _ _ l1)) (LgT v2 u (lt-le-trans v2 (Succ v1) u l2 (LtS v1 u l1))))
    ((OrbF _)
      (let-match erased p (LgF _ _ l1))
      (match erased q _
        ((LgT _ _ lt) (LgT v2 u (lt-le-trans v2 v1 u lt l1)))
        ((LgF _ _ lt) (LgF v2 u (le-tr v2 v1 u lt l1)))))))

(def-adts
  ((AF : ((List (Sy)) t) -> Type)
    enum
    (many AFN : -> (AF (Nil (Sy))))
    (many AFF : (erased (Fx) f) (erased (List (Sy)) t) (erased (AF t) p) -> (AF (Cons (Sy) (YF f) t)))
    (many AFC : (erased (List (Sy)) t) (erased (AF t) p) -> (AF (Cons (Sy) (YC) t)))
    (many AFW : (erased (Pk) k) (erased (Nat) c) (erased (List (Sy)) t) (erased (AF t) p) -> (AF (Cons (Sy) (YW k (MkAm (BFalse) c)) t)))
    (many AFE : (erased (List (Sy)) t) (erased (AF t) p) -> (AF (Cons (Sy) (YE) t)))
    (many AFV : (erased (List (Sy)) t) (erased (AF t) p) -> (AF (Cons (Sy) (YV) t)))
    (many AFR : (erased (Nat) b) (erased (List (Sy)) t) (erased (AF t) p) -> (AF (Cons (Sy) (YR b) t)))))

(def-fns _ $ (many af-of : (subterm many (List (Sy)) t) -> (many (Res (AF t)) r))
  (let-match many t (Cons _ s t0) ((Nil _) (ROk _ (AFN))))
  (let-match many (notail $ af-of t0) (ROk _ p) ((RFail _) (RFail _)))
  (let-match many s (YW k n)
    ((YF f) (ROk _ (AFF f t0 p)))
    ((YC) (ROk _ (AFC t0 p)))
    ((YE) (ROk _ (AFE t0 p)))
    ((YV) (ROk _ (AFV t0 p)))
    ((YR b) (ROk _ (AFR b t0 p))))
  (let-match many n (MkAm b c))
  (match many b _ ((BFalse) (ROk _ (AFW k c t0 p))) ((BTrue) (RFail _))))

(def-fns _ $ (erased af-ins : (erased (Nat) a) (erased (List (Sy)) t) (subterm erased (AF t) af) -> (erased (Ins a t t) ins))
  (match erased af _
    ((AFN) (InN a))
    ((AFF f t0 p) (InC a _ _ t0 t0 (I1F a f) (af-ins a t0 p)))
    ((AFC t0 p) (InC a _ _ t0 t0 (I1C a) (af-ins a t0 p)))
    ((AFW k c t0 p) (InC a _ _ t0 t0 (I1W a c k _ (CVF a c)) (af-ins a t0 p)))
    ((AFE t0 p) (InC a _ _ t0 t0 (I1E a) (af-ins a t0 p)))
    ((AFV t0 p) (InC a _ _ t0 t0 (I1V a) (af-ins a t0 p)))
    ((AFR b t0 p) (InC a _ _ t0 t0 (I1R a b) (af-ins a t0 p)))))

(def-fns _ $ (erased ins-af : (erased (Nat) a) (erased (List (Sy)) t s) (subterm erased (AF t) af) (erased (Ins a t s) ins) -> (erased (Eq (List (Sy)) s t) e))
  (match erased af _
    ((AFN) (let-match erased ins (InN _)) (Refl _ s))
    ((AFF f t0 p) (let-match erased ins (InC _ _ _ _ s0 i ins0)) (let-match erased i (I1F _ _))
      (let-match erased (ins-af a t0 s0 p ins0) (Refl _ _)) (Refl _ s))
    ((AFC t0 p) (let-match erased ins (InC _ _ _ _ s0 i ins0)) (let-match erased i (I1C _))
      (let-match erased (ins-af a t0 s0 p ins0) (Refl _ _)) (Refl _ s))
    ((AFW k c t0 p) (let-match erased ins (InC _ _ _ _ s0 i ins0)) (let-match erased i (I1W _ v _ _ cv)) (let-match erased cv (CVF _ _))
      (let-match erased (ins-af a t0 s0 p ins0) (Refl _ _)) (Refl _ s))
    ((AFE t0 p) (let-match erased ins (InC _ _ _ _ s0 i ins0)) (let-match erased i (I1E _))
      (let-match erased (ins-af a t0 s0 p ins0) (Refl _ _)) (Refl _ s))
    ((AFV t0 p) (let-match erased ins (InC _ _ _ _ s0 i ins0)) (let-match erased i (I1V _))
      (let-match erased (ins-af a t0 s0 p ins0) (Refl _ _)) (Refl _ s))
    ((AFR b t0 p) (let-match erased ins (InC _ _ _ _ s0 i ins0)) (let-match erased i (I1R _ _))
      (let-match erased (ins-af a t0 s0 p ins0) (Refl _ _)) (Refl _ s))))

(def-fns _ $ (erased push-af : (erased (Pk) k) (erased (Nat) a) (erased (List (Sy)) t t2) (erased (Push k a t t2) pu) (erased (AF t) p) -> (erased (AF t2) q))
  (let-match erased pu (PuM _ n m s t0 ad) ((PuZ _ _) p) ((PuC _ n _ nk) (AFW k (Succ n) t p)))
  (let-match erased p (AFW _ _ _ p1))
  (AFW k s t0 p1))

(def-fns _ $ (erased st-af : (erased (Nat) xs n) (erased (List (Sy)) t t2) (subterm erased (St xs n t t2) st) -> (erased (AF t) p) (erased (AF t2) q))
  (match erased st _
    ((StP _ _ _ pu) (let ((erased p)) (AFF (QP) _ (AFE _ (AFN)))) (values p (push-af (KX) xs _ t2 pu p)))
    ((StX _ _ v xs2 t0 _ a s) (let ((erased p) (erased q)) (st-af xs2 n t0 t2 s)) (values (AFW (KX) v t0 p) q))
    ((StD _ _ t0 t1 _ s pu) (let ((erased p) (erased q)) (st-af (Zero) n t0 t1 s)) (values (AFF (QD) t0 p) (push-af (KX) xs _ t2 pu (AFF (QD) t1 q))))
    ((StC _ _ d n2 n4 t0 t1 t3 _ a a2 a4 s pu pu2)
      (let ((erased p) (erased q)) (st-af (Zero) n4 t0 t1 s))
      (values (AFC t0 p) (push-af (KX) d _ t2 pu2 (AFC t3 (push-af (KX) n2 t1 t3 pu q)))))
    ((StG _ _ g t0 t1 t3 _ s pu pu2)
      (let ((erased p) (erased q)) (st-af (Zero) n t0 t1 s))
      (values (AFW (KG) g t0 p) (push-af (KX) xs t3 t2 pu2 (push-af (KG) g t1 t3 pu q))))
    ((StV _ _ b b2 _ a pu) (values (AFR b _ (AFN)) (push-af (KX) xs _ t2 pu (AFR b2 _ (AFN)))))))

(def-fns _ $ (erased ss-hl : (erased (Nat) a0) (erased (List (Sy)) l r2 sl sr sr2) (erased (St (Zero) 1 sr sr2) st) (erased (Ins (Succ a0) l sl) il) (erased (Ins (Succ a0) r2 sr2) ir2)
    (erased (Env) env) (erased (Nat) rl rr u) (erased (HL env rl rr (MkCf (DR) sl sr) u) hl)
    -> (erased (Cf) sc2) (erased (InsC (Succ a0) (MkCf (DL) l r2) sc2) ic2) (erased (Nat) v) (erased (HL env rl rr sc2 v) hl2) (erased (Lg (BFalse) v u) lg))
  (let ((erased k) (erased lv)) (lv-ex sr))
  (let ((erased hu)) (st-sound rr k (Zero) sr sr2 st lv env rl u sl (hu-zl (KX) env rl rr u (DR) sl sr (hu-of env rl rr u _ hl))))
  (let-match erased hu (MkHU _ _ _ _ _ v hl2 lt))
  (values (MkCf (DL) sl sr2) (MkInsC _ _ _ _ _ _ il ir2) v hl2 (LgF v u lt)))

(def-fns _ $ (erased ts-sound : (erased (Nat) a0) (erased (Cf) c c2 sc) (erased (Bool) g) (erased (TStp c c2 g) ts) (erased (InsC (Succ a0) c sc) ic) (erased (Env) env) (erased (Nat) rl rr u)
    (erased (HL env rl rr sc u) hl) -> (erased (Cf) sc2) (erased (InsC (Succ a0) c2 sc2) ic2) (erased (Nat) v) (erased (HL env rl rr sc2 v) hl2) (erased (Lg g v u) lg))
  (match erased ts _
    ((TSRl ru _ _ ok ap)
      (let ((erased sc2) (erased ic2) (erased ap2)) (rapp-ins (Succ a0) ru c c2 sc ok ap ic))
      (let ((erased v) (erased hl2) (erased lt)) (rapp-hl ru sc sc2 env rl rr u ok ap2 hl))
      (values sc2 ic2 v hl2 (LgT v u lt)))
    ((TSRL d l l2 r w)
      (let-match erased ic (MkInsC _ _ _ _ sl sr il ir))
      (let ((erased s2) (erased il2) (erased rw)) (trw-srw a0 (BTrue) l l2 sl w il))
      (values (MkCf d s2 sr) (MkInsC _ _ _ _ _ _ il2 ir) u (hl-rw env rl rr u sc _ (CRL d sl s2 sr rw) hl) (LgF u u (lt-succ u))))
    ((TSRR d l r r2 w)
      (let-match erased ic (MkInsC _ _ _ _ sl sr il ir))
      (let ((erased s2) (erased ir2) (erased rw)) (trw-srw a0 (BFalse) r r2 sr w ir))
      (values (MkCf d sl s2) (MkInsC _ _ _ _ _ _ il ir2) u (hl-rw env rl rr u sc _ (CRR d sl sr s2 rw) hl) (LgF u u (lt-succ u))))
    ((TSMv _ _ mv)
      (let ((erased sc2) (erased ic2) (erased hu)) (tmv-hu a0 c c2 sc mv ic env rl rr u (hu-of env rl rr u sc hl)))
      (let-match erased hu (MkHU _ _ _ _ _ v hl2 lt))
      (values sc2 ic2 v hl2 (LgF v u lt)))
    ((TSSt l r r2 st)
      (let-match erased ic (MkInsC _ _ _ _ sl sr il ir))
      (let ((erased sr2) (erased ir2) (erased st2)) (tst-st a0 (Zero) az 1 r r2 sr st ir (CVF (Succ a0) (Zero))))
      (ss-hl a0 l r2 sl sr sr2 st2 il ir2 env rl rr u hl))
    ((TSSn l r r2 st)
      (let-match erased ic (MkInsC _ _ _ _ sl sr il ir))
      (let ((erased f1) (erased f2)) (st-af (Zero) 1 r r2 st))
      (let-match erased (ins-af (Succ a0) r sr f1 ir) (Refl _ _))
      (ss-hl a0 l r2 sl r r2 st il (af-ins (Succ a0) r2 f2) env rl rr u hl))))

(def-fns _ $ (erased trun-sound : (erased (Nat) a0) (erased (Cf) c0 c s0) (erased (Bool) g) (subterm erased (TRun c0 c g) tr) (erased (InsC (Succ a0) c0 s0) ic)
    (erased (Env) env) (erased (Nat) rl rr u) (erased (HL env rl rr s0 u) hl)
    -> (erased (Cf) s) (erased (InsC (Succ a0) c s) ic2) (erased (Nat) v) (erased (HL env rl rr s v) hl2) (erased (Lg g v u) lg))
  (let-match erased tr (TRS _ c1 _ g1 g2 _ tr1 ts o) ((TRZ _) (values s0 ic u hl (LgF u u (lt-succ u)))))
  (let ((erased s1) (erased ic1) (erased v1) (erased hl1) (erased lg1)) (trun-sound a0 c0 c1 s0 g1 tr1 ic env rl rr u hl))
  (let ((erased s2) (erased ic2) (erased v2) (erased hl2) (erased lg2)) (ts-sound a0 c1 c s1 g2 ts ic1 env rl rr v1 hl1))
  (values s2 ic2 v2 hl2 (lg-cat g1 g2 g v1 v2 u lg1 lg2 o)))


(def-fns _ $ (many eq-fx : (many (Fx) a) (many (Fx) b) -> (many (Maybe (Eq (Fx) a b)) r))
  (match many a _
    ((QD) (match many b _ ((QD) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QP) (match many b _ ((QP) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QC0) (match many b _ ((QC0) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QC1) (match many b _ ((QC1) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QC2) (match many b _ ((QC2) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QF0) (match many b _ ((QF0) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QF1) (match many b _ ((QF1) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QF2) (match many b _ ((QF2) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QF3) (match many b _ ((QF3) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QG0) (match many b _ ((QG0) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QG1) (match many b _ ((QG1) (Some _ (Refl (Fx) a))) (else (None _))))
    ((QG2) (match many b _ ((QG2) (Some _ (Refl (Fx) a))) (else (None _))))))

(def-fns _ $ (many eq-am : (many (Am) a) (many (Am) b) -> (many (Maybe (Eq (Am) a b)) r))
  (let-match many a (MkAm k c))
  (let-match many b (MkAm k2 c2))
  (let-match many (eq-bit k k2) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (eq-nat c c2) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl (Am) a)))

(def-fns _ $ (many eq-sy : (many (Sy) a) (many (Sy) b) -> (many (Maybe (Eq (Sy) a b)) r))
  (let-match many a (YW k n)
    ((YF f) (let-match many b (YF f2) (else (None _))) (let-match many (eq-fx f f2) (Some _ e) ((None _) (None _))) (let-match erased e (Refl _ _)) (Some _ (Refl (Sy) a)))
    ((YC) (match many b _ ((YC) (Some _ (Refl (Sy) a))) (else (None _))))
    ((YE) (match many b _ ((YE) (Some _ (Refl (Sy) a))) (else (None _))))
    ((YV) (match many b _ ((YV) (Some _ (Refl (Sy) a))) (else (None _))))
    ((YR x) (let-match many b (YR y) (else (None _))) (let-match many (eq-nat x y) (Some _ e) ((None _) (None _))) (let-match erased e (Refl _ _)) (Some _ (Refl (Sy) a))))
  (let-match many b (YW k2 n2) (else (None _)))
  (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ _) (None _)))
  (let-match many (eq-am n n2) (Some _ e) ((None _) (None _)))
  (let-match erased e (Refl _ _))
  (Some _ (Refl (Sy) a)))

(def-fns _ $ (many eq-sys : (subterm many (List (Sy)) a) (many (List (Sy)) b) -> (many (Maybe (Eq (List (Sy)) a b)) r))
  (let-match many a (Cons _ x a1) ((Nil _) (match many b _ ((Nil _) (Some _ (Refl _ a))) (else (None _)))))
  (let-match many b (Cons _ y b1) ((Nil _) (None _)))
  (let-match many (eq-sy x y) (Some _ e) ((None _) (None _)))
  (let-match erased e (Refl _ _))
  (let-match many (notail $ eq-sys a1 b1) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl _ a)))

(def-fns _ $ (many eq-cf : (many (Cf) a) (many (Cf) b) -> (many (Maybe (Eq (Cf) a b)) r))
  (let-match many a (MkCf d l r))
  (let-match many b (MkCf d2 l2 r2))
  (let-match many (eq-dir d d2) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (eq-sys l l2) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (let-match many (eq-sys r r2) (Some _ e3) ((None _) (None _)))
  (let-match erased e3 (Refl _ _))
  (Some _ (Refl (Cf) a)))

(def-fns _ $ (many tnk-of : (many (Pk) k) (many (List (Sy)) t) -> (many (Maybe (TNk k t)) r))
  (let-match many t (Cons _ s t0) ((Nil _) (Some _ (TNN k))))
  (let-match many s (YW k2 n)
    ((YF f) (Some _ (TNF k f t0)))
    ((YC) (Some _ (TNC k t0)))
    ((YE) (Some _ (TNE k t0)))
    ((YV) (Some _ (TNV k t0)))
    ((YR b) (Some _ (TNR k b t0))))
  (match many (pk-cmp k k2) _ ((PkNe _ _ ne) (Some _ (TNW k k2 n t0 ne))) ((PkEq _) (None _))))

(def-adts
  ((CaR : ((Am) n1) ((Am) n2) -> Type)
    enum
    (many CaOk : (erased (Am) n1 n2) (many (Am) n3) (erased (CnAdd n1 n2 n3) p) -> (CaR n1 n2))
    (many CaNo : (erased (Am) n1 n2) -> (CaR n1 n2))))

(def-fns _ $ (erased cn-add-f : (erased (Bool) k) (erased (Nat) c1 c2 c3) (erased (Add c1 c2 c3) p) -> (erased (CnAdd (MkAm (BFalse) c1) (MkAm k c2) (MkAm k c3)) r))
  (match erased k _ ((BFalse) (CAF c1 c2 c3 p)) ((BTrue) (CAR c1 c2 c3 p))))

(def-fns _ $ (many cn-add : (many (Am) n1) (many (Am) n2) -> (many (CaR n1 n2) r))
  (let-match many n1 (MkAm kk1 c1))
  (let-match many n2 (MkAm k2 c2))
  (let-match many kk1 (BFalse) ((BTrue)
    (let-match many k2 (BFalse) ((BTrue) (CaNo n1 n2)))
    (let ((many c3) (erased p)) (add c1 c2))
    (CaOk n1 n2 (MkAm (BTrue) c3) (CAL c1 c2 c3 p))))
  (let-match many c1 (Succ _) ((Zero) (CaOk n1 n2 n2 (cn-add-f k2 c1 c2 c2 (AddZero c2)))))
  (let ((many c3) (erased p)) (add c1 c2))
  (CaOk n1 n2 (MkAm k2 c3) (cn-add-f k2 c1 c2 c3 p)))

(def-adts
  ((NzR : ((Am) n) -> Type)
    enum
    (many NzY : (erased (Am) n) (erased (Nz n) nz) -> (NzR n))
    (many NzN : -> (NzR az))))

(def-fns _ $ (many nz-of : (many (Am) n) -> (many (NzR n) r))
  (let-match many n (MkAm k c))
  (let-match many k (BFalse) ((BTrue) (NzY n (NzT c))))
  (let-match many c (Succ c1) ((Zero) (NzN)))
  (NzY n (NzF c1)))

(def-adts
  ((PuR : ((Pk) k) ((Am) n) ((List (Sy)) t) -> Type)
    enum
    (many PuOk : (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t) (many (List (Sy)) t2) (erased (TPush k n t t2) p) -> (PuR k n t))
    (many PuNo : (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t) -> (PuR k n t))))

(def-fns _ $ (many tpush : (many (Pk) k) (many (Am) n) (many (List (Sy)) t) -> (many (PuR k n t) r))
  (let-match many (nz-of n) (NzY _ nz) ((NzN) (PuOk k n t t (TPZ k t))))
  (let-match many (tnk-of k t) (None _) ((Some _ nk) (PuOk k n t (Cons (Sy) (YW k n) t) (TPC k n t nz nk))))
  (let-match many t (Cons _ s t0) ((Nil _) (PuNo k n t)))
  (let-match many s (YW k2 m) (else (PuNo k n t)))
  (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ _) (PuNo k n t)))
  (let-match many (cn-add n m) (CaOk _ _ s3 ca) ((CaNo _ _) (PuNo k n t)))
  (PuOk k n t (Cons (Sy) (YW k s3) t0) (TPM k n m s3 t0 nz ca)))

(def-adts
  ((CsR : ((Nat) n) ((Am) xs) -> Type)
    enum
    (many CsOk : (erased (Nat) n) (erased (Am) xs) (many (Am) d) (erased (CnSub n xs d) p) -> (CsR n xs))
    (many CsNo : (erased (Nat) n) (erased (Am) xs) -> (CsR n xs))))

(def-fns _ $ (many cn-sub : (many (Nat) n) (many (Am) xs) -> (many (CsR n xs) r))
  (let-match many xs (MkAm k c))
  (let-match many (lt-dec n (Succ c)) (Yes _ _ _ _ p) ((No _ _ _ _ _) (CsNo n xs)))
  (let ((many d) (erased ad)) (sub c n p))
  (CsOk n xs (MkAm k d) (MkCnSub n c d k ad)))

(def-fns _ $ (erased cn-add-z : (erased (Am) v) -> (erased (CnAdd az v v) r))
  (let-match erased v (MkAm k c))
  (cn-add-f k (Zero) c c (AddZero c)))

(def-adts
  ((XdR : ((Am) xs v) ((List (Sy)) t) -> Type)
    enum
    (many XdY : (erased (Am) v) (erased (List (Sy)) t) (erased (Nz v) nz) -> (XdR az v (Cons (Sy) iD t)))
    (many XdN : (erased (Am) xs v) (erased (List (Sy)) t) -> (XdR xs v t))))

(def-fns _ $ (many xd-of : (many (Am) xs v) (many (List (Sy)) t) -> (many (XdR xs v t) r))
  (let-match many (nz-of xs) (NzN) ((NzY _ _) (XdN xs v t)))
  (let-match many (nz-of v) (NzY _ nz) ((NzN) (XdN xs v t)))
  (let-match many t (Cons _ s t1) ((Nil _) (XdN xs v t)))
  (let-match many s (YF f) (else (XdN xs v t)))
  (let-match many f (QD) (else (XdN xs v t)))
  (XdY v t1 nz))

(def-adts
  ((StO : ((Am) xs) ((Nat) n) ((List (Sy)) t t2) -> Type)
    enum
    (many StY : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) t t2) (erased (TSt xs n t t2) p) -> (StO xs n t t2))
    (many StN : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) t) -> (StO xs n t (Nil (Sy))))))

(def-fns _ $ (many st-no : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) t) -> (many (List (Sy)) t2) (erased (StO xs n t t2) p))
  (values (Nil (Sy)) (StN xs n t)))

(def-fns _ $ (erased st-x : (erased (Am) xs v xs2) (erased (Nat) n) (erased (List (Sy)) t t2) (erased (CnAdd xs v xs2) a) (erased (StO xs2 n t t2) o)
    -> (erased (StO xs n (Cons (Sy) (YW (KX) v) t) t2) r))
  (match erased o _ ((StY _ _ _ _ st) (StY xs n _ t2 (TStX xs v xs2 n t t2 a st))) ((StN _ _ _) (StN xs n _))))

(def-fns _ $ (many tstride : (many (Am) xs) (many (Nat) n) (subterm many (List (Sy)) t) -> (many (List (Sy)) t2) (erased (StO xs n t t2) p))
  (let-match many t (Cons _ s t0) ((Nil _) (st-no xs n t)))
  (match many s _
    ((YF f)
      (match many f _
        ((QP)
          (let-match many t0 (Cons _ s1 t1) ((Nil _) (st-no xs n t)))
          (let-match many s1 (YE) (else (st-no xs n t)))
          (let-match many t1 (Nil _) (else (st-no xs n t)))
          (let-match many (tpush (KX) xs t) (PuOk _ _ _ t2 pu) ((PuNo _ _ _) (st-no xs n t)))
          (values t2 (StY xs n t t2 (TStP xs n t2 pu))))
        ((QD)
          (let ((many t1) (erased o)) (notail $ tstride az n t0))
          (let-match many t1 (Cons _ _ _) ((Nil _) (st-no xs n t)))
          (let-match erased o (StY _ _ _ _ s1))
          (let ((many dt)) (Cons (Sy) iD t1))
          (let-match many (nz-of xs) (NzY _ nz) ((NzN) (values dt (StY xs n t dt (TStD xs n t0 t1 dt s1 (TPZ (KX) dt))))))
          (values (Cons (Sy) (YW (KX) xs) dt) (StY xs n t _ (TStD xs n t0 t1 _ s1 (TPC (KX) xs dt nz (TNF (KX) (QD) t1))))))
        (else (st-no xs n t))))
    ((YC)
      (let-match many (cn-sub n xs) (CsOk _ _ d cs) ((CsNo _ _) (st-no xs n t)))
      (let ((many n2) (erased a2)) (add n n))
      (let ((many n4) (erased a4)) (add n2 n2))
      (let ((many t1) (erased o)) (notail $ tstride az n4 t0))
      (let-match many t1 (Cons _ _ _) ((Nil _) (st-no xs n t)))
      (let-match erased o (StY _ _ _ _ s1))
      (let-match many (tpush (KX) (MkAm (BFalse) n2) t1) (PuOk _ _ _ t2 pu) ((PuNo _ _ _) (st-no xs n t)))
      (let-match many (tpush (KX) d (Cons (Sy) (YC) t2)) (PuOk _ _ _ t3 pu2) ((PuNo _ _ _) (st-no xs n t)))
      (values t3 (StY xs n t t3 (TStC xs d n n2 n4 t0 t1 t2 t3 cs a2 a4 s1 pu pu2))))
    ((YW k v)
      (match many k _
        ((KX)
          (let-match many (xd-of xs v t0) (XdN _ _ _) ((XdY _ _ nz)
            (let-match many t0 (Cons _ _ t3))
            (let ((many t2) (erased o)) (notail $ tstride az n t3))
            (let-match many t2 (Cons _ _ _) ((Nil _) (st-no xs n t)))
            (let-match erased o (StY _ _ _ _ s1))
            (values (Cons (Sy) s (Cons (Sy) iD t2)) (StY xs n t _ (TStX az v v n t0 _ (cn-add-z v) (TStD v n t3 t2 _ s1 (TPC (KX) v (Cons (Sy) iD t2) nz (TNF (KX) (QD) t2))))))))
          (let-match many (cn-add xs v) (CaOk _ _ xs2 ca) ((CaNo _ _) (st-no xs n t)))
          (let ((many t2) (erased o)) (tail $ tstride xs2 n t0))
          (values t2 (st-x xs v xs2 n t0 t2 ca o)))
        ((KG)
          (let ((many t1) (erased o)) (notail $ tstride az n t0))
          (let-match many t1 (Cons _ _ _) ((Nil _) (st-no xs n t)))
          (let-match erased o (StY _ _ _ _ s1))
          (let-match many (tpush (KG) v t1) (PuOk _ _ _ t2 pu) ((PuNo _ _ _) (st-no xs n t)))
          (let-match many (tpush (KX) xs t2) (PuOk _ _ _ t3 pu2) ((PuNo _ _ _) (st-no xs n t)))
          (values t3 (StY xs n t t3 (TStG xs v n t0 t1 t2 t3 s1 pu pu2))))
        (else (st-no xs n t))))
    ((YR b)
      (let-match many t0 (Nil _) (else (st-no xs n t)))
      (let-match many (lt-dec n (Succ b)) (Yes _ _ _ _ p) ((No _ _ _ _ _) (st-no xs n t)))
      (let ((many b2) (erased ad)) (sub b n p))
      (let-match many (tpush (KX) xs (Cons (Sy) (YR b2) (Nil (Sy)))) (PuOk _ _ _ t2 pu) ((PuNo _ _ _) (st-no xs n t)))
      (values t2 (StY xs n t t2 (TStV xs n b b2 t2 ad pu))))
    (else (st-no xs n t))))

(def-adts
  ((StpR : ((List (Sy)) pre) ((List (Sy)) l) -> Type)
    enum
    (many StpOk : (erased (List (Sy)) pre l) (many (List (Sy)) x) (erased (Cat (Sy) pre x l) c) -> (StpR pre l))
    (many StpNo : (erased (List (Sy)) pre l) -> (StpR pre l))))

(def-fns _ $ (many strip : (subterm many (List (Sy)) pre) (many (List (Sy)) l) -> (many (StpR pre l) r))
  (let-match many pre (Cons _ a pre1) ((Nil _) (StpOk pre l l (CatN (Sy) l))))
  (let-match many l (Cons _ y l1) ((Nil _) (StpNo pre l)))
  (let-match many (eq-sy a y) (Some _ e) ((None _) (StpNo pre l)))
  (let-match erased e (Refl _ _))
  (let-match many (notail $ strip pre1 l1) (StpOk _ _ x c) ((StpNo _ _) (StpNo pre l)))
  (StpOk pre l x (CatC (Sy) a pre1 x l1 c)))

(def-adts
  ((SdR : ((Bool) e) ((List (Sy)) lp lp2 l) -> Type)
    enum
    (many SdOk : (erased (Bool) e) (erased (List (Sy)) lp lp2 l) (many (List (Sy)) l2) (erased (Sde e lp lp2 l l2) p) -> (SdR e lp lp2 l))
    (many SdNo : (erased (Bool) e) (erased (List (Sy)) lp lp2 l) -> (SdR e lp lp2 l))))

(def-fns _ $ (many sde-of : (many (Bool) e) (many (List (Sy)) lp lp2 l) -> (many (SdR e lp lp2 l) r))
  (let-match many (strip lp l) (StpOk _ _ x c) ((StpNo _ _) (SdNo e lp lp2 l)))
  (let ((many l2) (erased c2)) (cat-of (Sy) lp2 x))
  (let-match many e (BTrue) ((BFalse) (SdOk e lp lp2 l l2 (MkSde e lp lp2 x l l2 (EBV x) c c2))))
  (let-match many x (Cons _ x0 x1) ((Nil _) (SdNo e lp lp2 l)))
  (let-match many x0 (YE) (else (SdNo e lp lp2 l)))
  (let-match many x1 (Nil _) (else (SdNo e lp lp2 l)))
  (SdOk e lp lp2 l l2 (MkSde e lp lp2 x l l2 (EBE) c c2)))

(def-adts
  ((RaR : ((Rl) rl) ((Cf) c) -> Type)
    enum
    (many RaOk : (erased (Rl) rl) (erased (Cf) c) (many (Cf) c2) (erased (RApp rl c c2) p) -> (RaR rl c))
    (many RaNo : (erased (Rl) rl) (erased (Cf) c) -> (RaR rl c))))

(def-fns _ $ (many rapp-of : (many (Rl) rl) (many (Cf) c) -> (many (RaR rl c) r))
  (let-match many rl (MkRl d lp le rp re d2 lp2 rp2))
  (let-match many c (MkCf d1 l r))
  (let-match many (eq-dir d d1) (Some _ e) ((None _) (RaNo rl c)))
  (let-match erased e (Refl _ _))
  (let-match many (sde-of le lp lp2 l) (SdOk _ _ _ _ l2 sl) ((SdNo _ _ _ _) (RaNo rl c)))
  (let-match many (sde-of re rp rp2 r) (SdOk _ _ _ _ r2 sr) ((SdNo _ _ _ _) (RaNo rl c)))
  (RaOk rl c (MkCf d2 l2 r2) (MkRApp d d2 lp rp lp2 rp2 l r l2 r2 le re sl sr)))

(def-adts
  ((CwR : ((Bool) sd) ((Pk) k) -> Type)
    enum
    (many CwOk : (erased (Bool) sd) (erased (Pk) k) (many (List (Sy)) cw) (erased (Cw sd k cw) w) -> (CwR sd k))
    (many CwNo : (erased (Bool) sd) (erased (Pk) k) -> (CwR sd k))))

(def-fns _ $ (many cw-of : (many (Bool) sd) (many (Pk) k) -> (many (CwR sd k) r))
  (match many sd _
    ((BTrue) (match many k _ ((KF) (CwOk sd k cw-f (CwF))) ((KG) (CwOk sd k cw-gl (CwGl))) ((KH) (CwOk sd k cw-h (CwH))) ((KX) (CwNo sd k))))
    ((BFalse) (match many k _ ((KG) (CwOk sd k cw-gr (CwGr))) (else (CwNo sd k))))))

(def-adts $ (Op : -> Type)
  enum
  (many OSp : -> (Op))
  (many OPu : -> (Op))
  (many OUf : -> (Op)))

(def-adts
  ((TwR : ((Bool) sd) ((List (Sy)) t) -> Type)
    enum
    (many RwOk : (erased (Bool) sd) (erased (List (Sy)) t) (many (List (Sy)) t2) (erased (TRw sd t t2) w) -> (TwR sd t))
    (many RwNo : (erased (Bool) sd) (erased (List (Sy)) t) -> (TwR sd t))))

(def-fns _ $ (many trw-of : (many (Bool) sd) (many (Op) op) (subterm many (Nat) i) (many (List (Sy)) t) -> (many (TwR sd t) r))
  (let-match many t (Cons _ s t0) ((Nil _) (RwNo sd t)))
  (let-match many i (Zero) ((Succ j)
    (let-match many (notail $ trw-of sd op j t0) (RwOk _ _ t3 w) ((RwNo _ _) (RwNo sd t)))
    (RwOk sd t (Cons (Sy) s t3) (TRUn sd s t0 t3 w))))
  (let-match many s (YW k n) (else (RwNo sd t)))
  (match many op _
    ((OSp)
      (let-match many n (MkAm kk c))
      (let-match many c (Succ c1) ((Zero) (RwNo sd t)))
      (RwOk sd t (Cons (Sy) (YW k (MkAm (BFalse) 1)) (Cons (Sy) (YW k (MkAm kk c1)) t0)) (TRSp sd kk k c1 t0)))
    ((OPu)
      (let-match many (tpush k n t0) (PuOk _ _ _ t2 pu) ((PuNo _ _ _) (RwNo sd t)))
      (RwOk sd t t2 (TRPu sd k n t0 t2 pu)))
    ((OUf)
      (let-match many (eq-am n (MkAm (BFalse) 1)) (Some _ e) ((None _) (RwNo sd t)))
      (let-match erased e (Refl _ _))
      (let-match many (cw-of sd k) (CwOk _ _ cw w) ((CwNo _ _) (RwNo sd t)))
      (let ((many t2) (erased c)) (cat-of (Sy) cw t0))
      (RwOk sd t t2 (TRUf sd k cw t0 t2 w c)))))

(def-adts
  ((Ac : ((Cf) c0) -> Type)
    enum
    (many AcOk : (erased (Cf) c0) (many (Cf) c) (many (Bool) g) (erased (TRun c0 c g) r) -> (Ac c0))
    (many AcNo : (erased (Cf) c0) -> (Ac c0))))

(def-fns _ $ (many orb-of : (many (Bool) a b) -> (many (Bool) c) (erased (Orb a b c) o))
  (match many a _ ((BTrue) (values (BTrue) (OrbT b))) ((BFalse) (values b (OrbF b)))))

(def-fns _ $ (many ac-ts : (erased (Cf) c0) (many (Cf) c) (many (Bool) g) (erased (TRun c0 c g) r) (many (Cf) c2) (many (Bool) g2) (erased (TStp c c2 g2) s)
    -> (many (Ac c0) ac))
  (let ((many g3) (erased o)) (orb-of g g2))
  (AcOk c0 c2 g3 (TRS c0 c c2 g g2 g3 r s o)))

(def-fns _ $ (many ac-rl : (erased (Cf) c0) (many (Ac c0) ac) (many (Rl) rl) (erased (RlOK sk1p rl) k) -> (many (Ac c0) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (AcNo c0)))
  (let-match many (rapp-of rl c) (RaOk _ _ c2 ap) ((RaNo _ _) (AcNo c0)))
  (ac-ts c0 c g tr c2 (BTrue) (TSRl rl c c2 k ap)))

(def-fns _ $ (many ac-rw : (erased (Cf) c0) (many (Ac c0) ac) (many (Bool) sd) (many (Op) op) (many (Nat) i) -> (many (Ac c0) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (AcNo c0)))
  (let-match many c (MkCf d l rr))
  (match many sd _
    ((BTrue)
      (let-match many (trw-of sd op i l) (RwOk _ _ l2 w) ((RwNo _ _) (AcNo c0)))
      (ac-ts c0 c g tr (MkCf d l2 rr) (BFalse) (TSRL d l l2 rr w)))
    ((BFalse)
      (let-match many (trw-of sd op i rr) (RwOk _ _ r2 w) ((RwNo _ _) (AcNo c0)))
      (ac-ts c0 c g tr (MkCf d l r2) (BFalse) (TSRR d l rr r2 w)))))

(def-fns _ $ (many nth-sy : (subterm many (List (Sy)) t) (many (Nat) i) -> (many (Maybe (Sy)) r))
  (let-match many t (Cons _ s t0) ((Nil _) (None _)))
  (let-match many i (Succ j) ((Zero) (Some _ s)))
  (tail $ nth-sy t0 j))

(def-fns _ $ (many ac-side : (erased (Cf) c0) (many (Ac c0) ac) (many (Bool) sd) (many (Nat) i) -> (many (Maybe (Sy)) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (None _)))
  (let-match many c (MkCf d l rr))
  (match many sd _ ((BTrue) (nth-sy l i)) ((BFalse) (nth-sy rr i))))

(def-fns _ $ (many ac-pl : (erased (Cf) c0) (many (Ac c0) ac) (many (Bool) sd) (many (Nat) i) -> (many (Ac c0) r))
  (let-match many (ac-side c0 ac sd i) (Some _ s) ((None _) (AcNo c0)))
  (let-match many s (YW k n) (else (AcNo c0)))
  (match many (eq-am n (MkAm (BFalse) 1)) _ ((Some _ _) ac) ((None _) (ac-rw c0 ac sd (OSp) i))))

(def-fns _ $ (many ac-ux : (erased (Cf) c0) (many (Ac c0) ac) (many (Nat) i) -> (many (Ac c0) r))
  (let-match many (ac-side c0 ac (BFalse) i) (Some _ s) ((None _) (AcNo c0)))
  (let-match many s (YW k n) (else (AcNo c0)))
  (match many k _
    ((KX) (ac-pl c0 ac (BFalse) i))
    ((KG) (ac-pl c0 (ac-rw c0 (ac-pl c0 ac (BFalse) i) (BFalse) (OUf) i) (BFalse) i))
    (else (AcNo c0))))

(def-fns _ $ (many ac-mvl : (erased (Cf) c0) (many (Ac c0) ac) -> (many (Ac c0) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (AcNo c0)))
  (let-match many c (MkCf d l rr))
  (let-match many d (DL) ((DR) (AcNo c0)))
  (let-match many l (Cons _ s L) ((Nil _) (AcNo c0)))
  (let-match many s (YW K n) (else (AcNo c0)))
  (let-match many (tpush K n rr) (PuOk _ _ _ R2 pu) ((PuNo _ _ _) (AcNo c0)))
  (match many K _
    ((KX) (ac-ts c0 c g tr (MkCf (DL) L R2) (BFalse) (TSMv c _ (TMvL K (MXL) (MXR) (Zero) (KlX) n L rr R2 pu))))
    ((KG) (ac-ts c0 c g tr (MkCf (DL) L R2) (BFalse) (TSMv c _ (TMvL K (MGL) (MGR) (Succ (Zero)) (KlG) n L rr R2 pu))))
    (else (AcNo c0))))

(def-fns _ $ (many ac-mvr : (erased (Cf) c0) (many (Ac c0) ac) -> (many (Ac c0) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (AcNo c0)))
  (let-match many c (MkCf d l rr))
  (let-match many d (DR) ((DL) (AcNo c0)))
  (let-match many rr (Cons _ s R) ((Nil _) (AcNo c0)))
  (let-match many s (YW K n) (else (AcNo c0)))
  (let-match many (tpush K n l) (PuOk _ _ _ L2 pu) ((PuNo _ _ _) (AcNo c0)))
  (match many K _
    ((KX) (ac-ts c0 c g tr (MkCf (DR) L2 R) (BFalse) (TSMv c _ (TMvR K (MXL) (MXR) (Zero) (KlX) n l R L2 pu))))
    ((KG) (ac-ts c0 c g tr (MkCf (DR) L2 R) (BFalse) (TSMv c _ (TMvR K (MGL) (MGR) (Succ (Zero)) (KlG) n l R L2 pu))))
    (else (AcNo c0))))

(def-fns _ $ (many ac-mvp : (erased (Cf) c0) (many (Ac c0) ac) -> (many (Ac c0) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (AcNo c0)))
  (let-match many c (MkCf d l rr))
  (let-match many d (DR) ((DL) (AcNo c0)))
  (let-match many rr (Cons _ s0 r1) ((Nil _) (AcNo c0)))
  (let-match many s0 (YF f) (else (AcNo c0)))
  (let-match many f (QP) (else (AcNo c0)))
  (let-match many r1 (Cons _ s R) ((Nil _) (AcNo c0)))
  (let-match many s (YW K n) (else (AcNo c0)))
  (let-match many K (KX) (else (AcNo c0)))
  (let-match many (tpush (KX) n l) (PuOk _ _ _ L2 pu) ((PuNo _ _ _) (AcNo c0)))
  (ac-ts c0 c g tr (MkCf (DR) L2 (Cons (Sy) iP R)) (BFalse) (TSMv c _ (TMvP n l R L2 pu))))

(def-fns _ $ (many ac-mvg : (erased (Cf) c0) (many (Ac c0) ac) -> (many (Ac c0) r))
  (let-match many ac (AcOk _ c g tr) ((AcNo _) (AcNo c0)))
  (let-match many c (MkCf d l rr))
  (let-match many d (DR) ((DL) (AcNo c0)))
  (let-match many rr (Cons _ s0 r1) ((Nil _) (AcNo c0)))
  (let-match many s0 (YF f) (else (AcNo c0)))
  (let-match many f (QP) (else (AcNo c0)))
  (let-match many r1 (Cons _ s1 r2) ((Nil _) (AcNo c0)))
  (let-match many s1 (YF f1) (else (AcNo c0)))
  (let-match many f1 (QD) (else (AcNo c0)))
  (let-match many r2 (Cons _ s R) ((Nil _) (AcNo c0)))
  (let-match many s (YW K n) (else (AcNo c0)))
