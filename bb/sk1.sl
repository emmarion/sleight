    ((YV) (Some _ (NxC s t0 (NsV) p)))
    (else (None _))))

(comptime-match many (nx-of cw-f) (Some _ nx-f))
(comptime-match many (nx-of cw-gl) (Some _ nx-gl))
(comptime-match many (nx-of cw-gr) (Some _ nx-gr))
(comptime-match many (nx-of cw-h) (Some _ nx-h))

(def-fns _ $ (erased cw-nx : (erased (Bool) sd) (erased (Pk) k) (erased (List (Sy)) cw) (erased (Cw sd k cw) w) -> (erased (Nx cw) p))
  (match erased w _ ((CwF) nx-f) ((CwGl) nx-gl) ((CwGr) nx-gr) ((CwH) nx-h)))

(def-fns _ $ (erased nx-cat : (erased (List (Sy)) x y z) (subterm erased (Cat (Sy) x y z) c) (erased (Nx x) p) (erased (Nx y) q) -> (erased (Nx z) r))
  (let-match erased c (CatC _ a x1 _ z1 c1) ((CatN _ _) q))
  (let-match erased p (NxC _ _ n p1))
  (NxC a z1 n (nx-cat x1 y z1 c1 p1 q)))

(def-fns _ $ (erased nx-suf : (erased (List (Sy)) x y z) (subterm erased (Cat (Sy) x y z) c) (erased (Nx z) p) -> (erased (Nx y) q))
  (let-match erased c (CatC _ a x1 _ z1 c1) ((CatN _ _) p))
  (let-match erased p (NxC _ _ _ p1))
  (nx-suf x1 y z1 c1 p1))

(def-fns _ $ (erased push-nx : (erased (Pk) k) (erased (Nat) a) (erased (List (Sy)) t t2) (erased (Push k a t t2) pu) (erased (Nx t) p) -> (erased (Nx t2) q))
  (let-match erased pu (PuM _ n m s t0 ad) ((PuZ _ _) p) ((PuC _ n _ nk) (NxC _ t (NsW k _) p)))
  (let-match erased p (NxC _ _ _ p1))
  (NxC _ t0 (NsW k _) p1))

(def-fns _ $ (erased bw-nx : (erased (Bool) sd) (erased (List (Sy)) t) (erased (List (Bool)) s) (subterm erased (Bw sd t s) b) -> (erased (Nx t) p))
  (let-match erased b (BwC _ a t0 s1 w _ b1 pb c) ((BwN _) (NxN)))
  (let ((erased ns)) (match erased pb (((Ns a) ns)) ((PbF _ f _ _) (NsF f)) ((PbC _) (NsC)) ((PbX _) (NsW (KX) _))))
  (NxC a t0 ns (bw-nx sd t0 s1 b1)))

(def-fns _ $ (erased rl-nx : (erased (Mv) d d2) (erased (List (Sy)) lp rp lp2 rp2) (erased (Bool) le re) (erased (RlOK sk1p (MkRl d lp le rp re d2 lp2 rp2)) ok) -> (erased (Nx rp2) p))
  (let-match erased ok (MkRlOK _ _ _ _ _ _ _ _ _ ta tb a1 ti to ar te))
  (let-match erased to (MkTaOf _ _ _ _ _ ls rs rs2 q f1 f2 bl br dq z1 z2))
  (bw-nx (BFalse) rp2 rs br))

(def-fns _ $ (erased absurd tst-nx : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) t t2) (subterm erased (TSt xs n t t2) st) (erased (Nx t) p) -> (erased (False) f))
  (match erased st _
    (absurd (TStP _ _ _ _) (let-match erased p (NxC _ _ _ p1)) (let-match erased p1 (NxC _ _ n1 _)) (match erased n1 _))
    (absurd (TStX _ v xs2 _ t0 _ a s) (let-match erased p (NxC _ _ _ p1)) (tst-nx xs2 n t0 t2 s p1))
    (absurd (TStD _ _ t0 t1 _ s pu) (let-match erased p (NxC _ _ _ p1)) (tst-nx az n t0 t1 s p1))
    (absurd (TStC _ d _ n2 n4 t0 t1 t3 _ a a2 a4 s pu pu2) (let-match erased p (NxC _ _ _ p1)) (tst-nx az n4 t0 t1 s p1))
    (absurd (TStG _ g _ t0 t1 t3 _ s pu pu2) (let-match erased p (NxC _ _ _ p1)) (tst-nx az n t0 t1 s p1))
    (absurd (TStV _ _ b b2 _ a pu) (let-match erased p (NxC _ _ n1 _)) (match erased n1 _))))

(def-fns _ $ (erased absurd st-nx : (erased (Nat) xs n) (erased (List (Sy)) t t2) (subterm erased (St xs n t t2) st) (erased (Nx t) p) -> (erased (False) f))
  (match erased st _
    (absurd (StP _ _ _ _) (let-match erased p (NxC _ _ _ p1)) (let-match erased p1 (NxC _ _ n1 _)) (match erased n1 _))
    (absurd (StX _ _ v xs2 t0 _ a s) (let-match erased p (NxC _ _ _ p1)) (st-nx xs2 n t0 t2 s p1))
    (absurd (StD _ _ t0 t1 _ s pu) (let-match erased p (NxC _ _ _ p1)) (st-nx (Zero) n t0 t1 s p1))
    (absurd (StC _ _ d n2 n4 t0 t1 t3 _ a a2 a4 s pu pu2) (let-match erased p (NxC _ _ _ p1)) (st-nx (Zero) n4 t0 t1 s p1))
    (absurd (StG _ _ g t0 t1 t3 _ s pu pu2) (let-match erased p (NxC _ _ _ p1)) (st-nx (Zero) n t0 t1 s p1))
    (absurd (StV _ _ b b2 _ a pu) (let-match erased p (NxC _ _ n1 _)) (match erased n1 _))))

(def-fns _ $ (erased notk-fr : (erased (Pk) k) (erased (List (Sy)) t tz U) (erased (NotK k t) nk) (erased (Cat (Sy) t (Cons (Sy) iD tz) U) c) -> (erased (NotK k U) nk2))
  (let-match erased c (CatC _ _ _ _ U0 _) ((CatN _ _) (NKF k (QD) tz)))
