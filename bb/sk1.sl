(def-fns _ $ (erased sk1-add-assoc : (erased (Nat) a b c ab abc) (subterm erased (Add a b ab) p) (erased (Add ab c abc) q)
    -> (erased (Nat) bc) (erased (Add b c bc) r) (erased (Add a bc abc) s))
  (let-match erased p (AddSucc a1 _ ab1 p1) ((AddZero _) (values abc q (AddZero abc))))
  (let-match erased q (AddSucc _ _ abc1 q1))
  (let ((erased bc) (erased r) (erased s)) (sk1-add-assoc a1 b c ab1 abc1 p1 q1))
  (values bc r (AddSucc a1 bc abc1 s)))

(def-fns _ $ (erased sk1-add-assoc-r : (erased (Nat) b a m c s s2) (erased (Add b a c) p) (erased (Add a m s) q) (erased (Add b s s2) r) -> (erased (Add c m s2) t))
  (let ((erased w) (erased cw)) (add-ex c m))
  (let ((erased bc) (erased r1) (erased r2)) (sk1-add-assoc b a m c w p cw))
  (let-match erased (add-fn a m s bc q r1) (Refl _ _))
  (let-match erased (add-fn b s s2 w r r2) (Refl _ _))
  cw)

(def-fns _ $ (erased push-fn : (erased (Pk) k) (erased (Nat) n) (erased (List (Sy)) t t1 t2) (erased (Push k n t t1) p) (erased (Push k n t t2) q)
    -> (erased (Eq (List (Sy)) t1 t2) e))
  (match erased p _
    ((PuZ _ _) (let-match erased q (PuZ _ _)) (Refl _ t1))
    ((PuM _ n1 m s1 t0 a)
      (let-match erased q (PuM _ _ _ s2 _ a2) ((PuC _ _ _ nk) (match erased nk _ (absurd (NKW _ _ _ _ ne) (match erased ne _)))))
      (let-match erased (add-fn (Succ n1) m s1 s2 a a2) (Refl _ _))
      (Refl _ t1))
    ((PuC _ n1 _ nk)
      (let-match erased q (PuC _ _ _ _) ((PuM _ _ _ _ _ _) (match erased nk _ (absurd (NKW _ _ _ _ ne) (match erased ne _)))))
      (Refl _ t1))))

(def-fns _ $ (erased push-comp : (erased (Pk) k) (erased (Nat) a b c) (erased (List (Sy)) u u1 u2) (erased (Push k a u u1) p) (erased (Push k b u1 u2) q)
    (erased (Add b a c) ad) -> (erased (Push k c u u2) r))
  (match erased p _
    ((PuZ _ _) (let-match erased (add-fn b (Zero) c b ad (add-zero-right b)) (Refl _ _)) q)
    ((PuM _ n1 m s t0 a1)
      (match erased q _
        ((PuZ _ _) (let-match erased ad (AddZero _)) p)
        ((PuM _ n2 _ s2 _ a2)
          (let-match erased ad (AddSucc _ _ c1 ad1))
          (PuM k c1 m s2 t0 (sk1-add-assoc-r b a m c s s2 ad a1 a2)))
        (absurd (PuC _ _ _ nk) (match erased nk _ (absurd (NKW _ _ _ _ ne) (match erased ne _))))))
    ((PuC _ n1 _ nk)
      (match erased q _
        ((PuZ _ _) (let-match erased ad (AddZero _)) p)
        ((PuM _ n2 _ s2 _ a2)
          (let-match erased (add-fn b a c s2 ad a2) (Refl _ _))
          (let-match erased ad (AddSucc _ _ c1 _))
          (PuC k c1 u nk))
        (absurd (PuC _ _ _ nk2) (match erased nk2 _ (absurd (NKW _ _ _ _ ne) (match erased ne _))))))))

(def-adts
  ((PkC : ((Pk) a) ((Pk) b) -> Type)
    enum
    (many PkEq : (erased (Pk) a) -> (PkC a a))
    (many PkNe : (erased (Pk) a b) (erased (KNe a b) ne) -> (PkC a b))))

(def-fns _ $ (many pk-cmp : (many (Pk) a) (many (Pk) b) -> (many (PkC a b) r))
  (match many a _
    ((KX) (match many b _ ((KX) (PkEq a)) ((KF) (PkNe a b (KNeXF))) ((KG) (PkNe a b (KNeXG))) ((KH) (PkNe a b (KNeXH)))))
    ((KF) (match many b _ ((KX) (PkNe a b (KNeFX))) ((KF) (PkEq a)) ((KG) (PkNe a b (KNeFG))) ((KH) (PkNe a b (KNeFH)))))
    ((KG) (match many b _ ((KX) (PkNe a b (KNeGX))) ((KF) (PkNe a b (KNeGF))) ((KG) (PkEq a)) ((KH) (PkNe a b (KNeGH)))))
    ((KH) (match many b _ ((KX) (PkNe a b (KNeHX))) ((KF) (PkNe a b (KNeHF))) ((KG) (PkNe a b (KNeHG))) ((KH) (PkEq a))))))

(def-fns _ $ (many push-ex : (many (Pk) k) (many (Nat) n) (many (List (Sy)) t) -> (many (List (Sy)) t2) (erased (Push k n t t2) p))
  (let-match many n (Succ n1) ((Zero) (values t (PuZ k t))))
  (let ((many t1)) (Cons (Sy) (YW k (MkAm (BFalse) (Succ n1))) t))
  (let-match many t (Cons _ s t0) ((Nil _) (values t1 (PuC k n1 t (NKN k)))))
  (let-match many s (YW k2 m)
    ((YF f) (values t1 (PuC k n1 t (NKF k f t0))))
    ((YC) (values t1 (PuC k n1 t (NKC k t0))))
    ((YE) (values t1 (PuC k n1 t (NKE k t0))))
    ((YV) (values t1 (PuC k n1 t (NKV k t0))))
    ((YR b) (values t1 (PuC k n1 t (NKR k b t0)))))
  (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ ne) (values t1 (PuC k n1 t (NKW k k2 m t0 ne)))))
  (let-match many m (MkAm b c))
  (let-match many b (BFalse) ((BTrue) (values t1 (PuC k n1 t (NKT k c t0)))))
  (let ((many s2) (erased a)) (add (Succ n1) c))
  (values (Cons (Sy) (YW k (MkAm (BFalse) s2)) t0) (PuM k n1 c s2 t0 a)))

(def-fns _ $ (erased st-unpush : (erased (Nat) a n) (erased (List (Sy)) u u1 t2) (erased (Push (KX) a u u1) pu) (erased (St a n u t2) st) -> (erased (St (Zero) n u1 t2) st2))
  (let-match erased pu (PuM _ n1 m s t0 ad) ((PuZ _ _) st) ((PuC _ n1 _ nk) (StX (Zero) n a a u t2 (AddZero a) st)))
  (let-match erased st (StX _ _ _ xs2 _ _ a1 st1))
  (let-match erased (add-fn a m xs2 s a1 ad) (Refl _ _))
  (StX (Zero) n s s t0 t2 (AddZero s) st1))

(def-fns _ $ (erased st-more : (erased (Nat) xs1 n) (erased (List (Sy)) t t1) (subterm erased (St xs1 n t t1) st) (erased (Nat) xs s) (erased (Add xs xs1 s) ad)
    (erased (List (Sy)) t2) (erased (Push (KX) xs t1 t2) pu) -> (erased (St s n t t2) st2))
  (match erased st _
    ((StP _ _ _ pu1) (StP s n t2 (push-comp (KX) xs1 xs s _ t1 t2 pu1 pu ad)))
    ((StX _ _ v xs2 t0 _ a st1)
      (let ((erased s2) (erased a2)) (add-ex xs xs2))
      (StX s n v s2 t0 t2 (sk1-add-assoc-r xs xs1 v s xs2 s2 ad a a2) (st-more xs2 n t0 t1 st1 xs s2 a2 t2 pu)))
    ((StD _ _ t0 ta _ st1 pu1) (StD s n t0 ta t2 st1 (push-comp (KX) xs1 xs s _ t1 t2 pu1 pu ad)))
    ((StC _ _ d n2 n4 t0 ta tb _ a a2 a4 st1 pu1 pu2)
      (let ((erased d2) (erased ad2)) (add-ex xs d))
      (let ((erased bc) (erased r1) (erased r2)) (sk1-add-assoc n d xs xs1 s a (add-comm xs xs1 s ad)))
      (let-match erased (add-fn d xs bc d2 r1 (add-comm xs d d2 ad2)) (Refl _ _))
      (StC s n d2 n2 n4 t0 ta tb t2 r2 a2 a4 st1 pu1 (push-comp (KX) d xs d2 _ t1 t2 pu2 pu ad2)))
    ((StG _ _ g t0 ta tb _ st1 pu1 pu2) (StG s n g t0 ta tb t2 st1 pu1 (push-comp (KX) xs1 xs s _ t1 t2 pu2 pu ad)))
    ((StV _ _ b b2 _ a pu1) (StV s n b b2 t2 a (push-comp (KX) xs1 xs s _ t1 t2 pu1 pu ad)))))

(def-fns _ $ (erased st-g : (erased (Nat) m g xs) (erased (List (Sy)) tc ta te tb t2) (erased (St (Zero) m tc ta) st) (erased (Push (KG) g tc te) p1)
    (erased (Push (KG) g ta tb) p2) (erased (Push (KX) xs tb t2) p3) -> (erased (St xs m te t2) st2))
  (match erased p1 _
    ((PuZ _ _) (let-match erased p2 (PuZ _ _)) (st-more (Zero) m tc ta st xs xs (add-zero-right xs) t2 p3))
    ((PuC _ _ _ _) (StG xs m g tc ta tb t2 st p2 p3))
    ((PuM _ n1 h s tc1 a)
      (let-match erased st (StG _ _ _ _ ta1 ta2 _ st1 q1 q2))
      (let-match erased q2 (PuZ _ _))
      (StG xs m s tc1 ta1 tb t2 st1 (push-comp (KG) h g s ta1 ta tb q1 p2 a) p3))))

(def-fns _ $ (erased st-add : (erased (Nat) xs nm) (erased (List (Sy)) t t2) (subterm erased (St xs nm t t2) st) (erased (Nat) n m) (erased (Add n m nm) anm)
    -> (erased (List (Sy)) t1) (erased (St xs n t t1) s1) (erased (St (Zero) m t1 t2) s2))
  (match erased st _
    ((StP _ _ _ pu)
      (let ((erased t1) (erased p1)) (push-ex (KX) xs t))
      (values t1 (StP xs n t1 p1) (st-unpush xs m t t1 t2 p1 (StP xs m t2 pu))))
    ((StX _ _ v xs2 t0 _ a st1)
      (let ((erased t1) (erased s1) (erased s2)) (st-add xs2 nm t0 t2 st1 n m anm))
      (values t1 (StX xs n v xs2 t0 t1 a s1) s2))
    ((StD _ _ t0 ta _ st1 pu)
      (let ((erased tb) (erased s1) (erased s2)) (st-add (Zero) nm t0 ta st1 n m anm))
      (let ((erased t1) (erased p1)) (push-ex (KX) xs (Cons (Sy) iD tb)))
      (values t1 (StD xs n t0 tb t1 s1 p1) (st-unpush xs m _ t1 t2 p1 (StD xs m tb ta t2 s2 pu))))
    ((StC _ _ d n2 n4 t0 ta tb _ a a2 a4 st1 pu pu2)
      (let ((erased Nn2) (erased aN2)) (add-ex n n))
      (let ((erased N4) (erased aN4)) (add-ex Nn2 Nn2))
      (let ((erased M2) (erased aM2)) (add-ex m m))
      (let ((erased M4) (erased aM4)) (add-ex M2 M2))
      (let ((erased a24)) (diag-add n m nm n2 Nn2 M2 anm a2 aN2 aM2))
      (let ((erased tc) (erased s1) (erased s2)) (st-add (Zero) n4 t0 ta st1 N4 M4 (diag-add Nn2 M2 n2 n4 N4 M4 a24 a4 aN4 aM4)))
      (let ((erased d1) (erased ad1)) (add-ex m d))
      (let ((erased bc) (erased r1) (erased r2)) (sk1-add-assoc n m d nm xs anm a))
      (let-match erased (add-fn m d bc d1 r1 ad1) (Refl _ _))
      (let ((erased te) (erased pe)) (push-ex (KX) Nn2 tc))
      (let ((erased t1) (erased p1)) (push-ex (KX) d1 (Cons (Sy) (YC) te)))
      (let ((erased tf) (erased pf)) (push-ex (KX) Nn2 ta))
      (let ((erased s3)) (st-unpush Nn2 M4 tc te tf pe (st-more (Zero) M4 tc ta s2 Nn2 Nn2 (add-zero-right Nn2) tf pf)))
      (let ((erased tg) (erased pg)) (push-ex (KX) M2 tf))
      (let-match erased (push-fn (KX) n2 ta tb tg pu (push-comp (KX) Nn2 M2 n2 ta tf tg pf pg (add-comm Nn2 M2 n2 a24))) (Refl _ _))
      (values t1 (StC xs n d1 Nn2 N4 t0 tc te t1 r2 aN2 aN4 s1 pe p1)
        (st-unpush d1 m _ t1 t2 p1 (StC d1 m d M2 M4 te tf tb t2 ad1 aM2 aM4 s3 pg pu2))))
    ((StG _ _ g t0 ta tb _ st1 pu pu2)
      (let ((erased tc) (erased s1) (erased s2)) (st-add (Zero) nm t0 ta st1 n m anm))
      (let ((erased te) (erased pe)) (push-ex (KG) g tc))
      (let ((erased t1) (erased p1)) (push-ex (KX) xs te))
      (values t1 (StG xs n g t0 tc te t1 s1 pe p1) (st-unpush xs m te t1 t2 p1 (st-g m g xs tc ta te tb t2 s2 pe pu pu2))))
    ((StV _ _ b b2 _ a pu)
      (let ((erased b1) (erased ab1)) (add-ex m b2))
      (let ((erased bc) (erased r1) (erased r2)) (sk1-add-assoc n m b2 nm b anm a))
      (let-match erased (add-fn m b2 bc b1 r1 ab1) (Refl _ _))
      (let ((erased t1) (erased p1)) (push-ex (KX) xs (Cons (Sy) (YR b1) (Nil (Sy)))))
      (values t1 (StV xs n b b1 t1 r2 p1) (st-unpush xs m _ t1 t2 p1 (StV xs m b1 b2 t2 ab1 pu))))))

(def-adts
  ((NC : ((Sy) s) -> Type)
    enum
    (many NCF : (erased (Fx) f) -> (NC (YF f)))
    (many NCW : (erased (Pk) k) (erased (Am) n) -> (NC (YW k n)))
    (many NCE : -> (NC (YE)))
    (many NCV : -> (NC (YV)))
    (many NCR : (erased (Nat) b) -> (NC (YR b)))))

(def-adts
  ((Lv : ((List (Sy)) t) ((Nat) k) -> Type)
    enum
    (many LvN : -> (Lv (Nil (Sy)) (Zero)))
    (many LvC : (erased (List (Sy)) t) (erased (Nat) k) (erased (Lv t k) p) -> (Lv (Cons (Sy) (YC) t) (Succ k)))
    (many LvO : (erased (Sy) s) (erased (List (Sy)) t) (erased (Nat) k) (erased (NC s) nc) (erased (Lv t k) p) -> (Lv (Cons (Sy) s t) k))))

(def-fns _ $ (erased lv-ex : (subterm erased (List (Sy)) t) -> (erased (Nat) k) (erased (Lv t k) p))
  (let-match erased t (Cons _ s t1) ((Nil _) (values (Zero) (LvN))))
  (let ((erased k) (erased p)) (lv-ex t1))
  (match erased s (((Nat) k2) ((Lv t k2) p2))
    ((YC) (values (Succ k) (LvC t1 k p)))
    ((YF f) (values k (LvO s t1 k (NCF f) p)))
    ((YW kk1 n) (values k (LvO s t1 k (NCW kk1 n) p)))
    ((YE) (values k (LvO s t1 k (NCE) p)))
    ((YV) (values k (LvO s t1 k (NCV) p)))
    ((YR b) (values k (LvO s t1 k (NCR b) p)))))

(def-fns _ $ (erased push-lv : (erased (Pk) k) (erased (Nat) a n) (erased (List (Sy)) t t2) (erased (Push k a t t2) pu) (erased (Lv t n) lv) -> (erased (Lv t2 n) lv2))
  (let-match erased pu (PuM _ n1 m s t0 _) ((PuZ _ _) lv) ((PuC _ n1 _ _) (LvO _ t n (NCW k _) lv)))
  (let-match erased lv (LvO _ _ _ _ lv1))
  (LvO _ t0 n (NCW k _) lv1))

(def-fns _ $ (erased st-lv : (erased (Nat) xs n k) (erased (List (Sy)) t t2) (subterm erased (St xs n t t2) st) (erased (Lv t k) lv) -> (erased (Lv t2 k) lv2))
