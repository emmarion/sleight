      (let-match erased lv1 (LvN))
      (push-lv (KX) xs k _ t2 pu (LvO _ _ _ (NCR b2) (LvN))))))

(def-adts
  ((Td : ((Mv) d) ((List (Bool)) zl) ((List (Bool)) zr) ((Tc) e) -> Type)
    enum
    (many TdR : (erased (List (Bool)) zl zr) -> (Td (DR) zl zr (MkTc (Zero) (DR) zl zr)))
    (many TdL : (erased (List (Bool)) zl zr) -> (Td (DL) zl zr (MkTc 2 (DL) zl (Cons (Bool) (BTrue) (Cons (Bool) (BFalse) zr)))))))

(def-fns _ $ (erased hl-open : (erased (Env) env) (erased (Nat) rl rr u) (erased (Mv) d) (erased (List (Sy)) l r) (erased (HL env rl rr (MkCf d l r) u) hl)
