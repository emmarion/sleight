(def-adts $ (Mvk : -> Type)
  enum
  (many MXL : -> (Mvk))
  (many MXR : -> (Mvk))
  (many MPX : -> (Mvk))
  (many MGL : -> (Mvk))
  (many MGR : -> (Mvk))
  (many MPG : -> (Mvk)))

(def-adts
  ((MvC : ((Mvk) k) ((Nat) i) ((Nat) j) ((List (Sy)) L) ((List (Sy)) R) ((Cf) c) -> Type)
    enum
    (many MvXL : (erased (Nat) i j) (erased (List (Sy)) L R)
       -> (MvC (MXL) i j L R (MkCf (DL) (Cons (Sy) (YW (KX) (MkAm (BFalse) i)) L) (Cons (Sy) (YW (KX) (MkAm (BFalse) j)) R))))
    (many MvXR : (erased (Nat) i j) (erased (List (Sy)) L R)
       -> (MvC (MXR) i j L R (MkCf (DR) (Cons (Sy) (YW (KX) (MkAm (BFalse) j)) L) (Cons (Sy) (YW (KX) (MkAm (BFalse) i)) R))))
    (many MvPX : (erased (Nat) i j) (erased (List (Sy)) L R)
       -> (MvC (MPX) i j L R (MkCf (DR) (Cons (Sy) (YW (KX) (MkAm (BFalse) j)) L) (Cons (Sy) iP (Cons (Sy) (YW (KX) (MkAm (BFalse) i)) R)))))
    (many MvGL : (erased (Nat) i j) (erased (List (Sy)) L R)
       -> (MvC (MGL) i j L R (MkCf (DL) (Cons (Sy) (YW (KG) (MkAm (BFalse) i)) L) (Cons (Sy) (YW (KG) (MkAm (BFalse) j)) R))))
    (many MvGR : (erased (Nat) i j) (erased (List (Sy)) L R)
       -> (MvC (MGR) i j L R (MkCf (DR) (Cons (Sy) (YW (KG) (MkAm (BFalse) j)) L) (Cons (Sy) (YW (KG) (MkAm (BFalse) i)) R))))
    (many MvPG : (erased (Nat) i j) (erased (List (Sy)) L R)
       -> (MvC (MPG) i j L R (MkCf (DR) (Cons (Sy) (YW (KH) (MkAm (BFalse) j)) L) (Cons (Sy) iP (Cons (Sy) iD (Cons (Sy) (YW (KG) (MkAm (BFalse) i)) R))))))))

(def-adts
  ((Rk : ((Mvk) k) ((Nat) r) -> Type)
    enum
    (many RkXL : (erased (Nat) r) -> (Rk (MXL) r))
    (many RkXR : (erased (Nat) r) -> (Rk (MXR) r))
    (many RkPX : (erased (Nat) r) -> (Rk (MPX) r))
    (many RkGL : (erased (Nat) r) -> (Rk (MGL) (Succ r)))
    (many RkGR : (erased (Nat) r) -> (Rk (MGR) (Succ r)))
    (many RkPG : (erased (Nat) r) -> (Rk (MPG) (Succ r)))))

(def-adts
  ((Rv : ((List (Sy)) ws) ((List (Sy)) R) ((List (Sy)) R2) -> Type)
    enum
    (many RvN : (erased (List (Sy)) R) -> (Rv (Nil (Sy)) R R))
    (many RvD : (erased (List (Sy)) t R R2) (erased (Rv t (Cons (Sy) iD R) R2) p) -> (Rv (Cons (Sy) iD t) R R2))
    (many RvX : (erased (Nat) k) (erased (List (Sy)) t R R2) (erased (Rv t (Cons (Sy) (YW (KX) (MkAm (BFalse) k)) R) R2) p)
       -> (Rv (Cons (Sy) (YW (KX) (MkAm (BFalse) k)) t) R R2))))

(def-adts
  ((PpA : ((List (Sy)) ws) ((List (Sy)) A) ((List (Sy)) A2) -> Type)
    enum
    (many PpN : (erased (List (Sy)) A) -> (PpA (Nil (Sy)) A A))
    (many PpC : (erased (Nat) k) (erased (List (Sy)) t A A2)
       (erased (PpA t (Cons (Sy) (YW (KX) (MkAm (BFalse) k)) (Cons (Sy) iD (Cons (Sy) (YF (QC1)) A))) A2) p)
       -> (PpA (Cons (Sy) (YW (KX) (MkAm (BFalse) (Succ k))) (Cons (Sy) iD t)) A A2))))

(def-fns _ $ (erased mvc-ex : (erased (Mvk) k) (erased (Nat) i j) (erased (List (Sy)) L R) (erased (Cf) c) (erased (MvC k i j L R c) mc) (erased (Nat) i2 j2)
    -> (erased (Cf) c2) (erased (MvC k i2 j2 L R c2) mc2))
  (match erased mc _
    ((MvXL _ _ _ _) (values (MkCf (DL) (Cons (Sy) (YW (KX) (MkAm (BFalse) i2)) L) (Cons (Sy) (YW (KX) (MkAm (BFalse) j2)) R)) (MvXL i2 j2 L R)))
    ((MvXR _ _ _ _) (values (MkCf (DR) (Cons (Sy) (YW (KX) (MkAm (BFalse) j2)) L) (Cons (Sy) (YW (KX) (MkAm (BFalse) i2)) R)) (MvXR i2 j2 L R)))
    ((MvPX _ _ _ _) (values (MkCf (DR) (Cons (Sy) (YW (KX) (MkAm (BFalse) j2)) L) (Cons (Sy) iP (Cons (Sy) (YW (KX) (MkAm (BFalse) i2)) R))) (MvPX i2 j2 L R)))
    ((MvGL _ _ _ _) (values (MkCf (DL) (Cons (Sy) (YW (KG) (MkAm (BFalse) i2)) L) (Cons (Sy) (YW (KG) (MkAm (BFalse) j2)) R)) (MvGL i2 j2 L R)))
    ((MvGR _ _ _ _) (values (MkCf (DR) (Cons (Sy) (YW (KG) (MkAm (BFalse) j2)) L) (Cons (Sy) (YW (KG) (MkAm (BFalse) i2)) R)) (MvGR i2 j2 L R)))
    ((MvPG _ _ _ _) (values (MkCf (DR) (Cons (Sy) (YW (KH) (MkAm (BFalse) j2)) L) (Cons (Sy) iP (Cons (Sy) iD (Cons (Sy) (YW (KG) (MkAm (BFalse) i2)) R))))
      (MvPG i2 j2 L R)))))

