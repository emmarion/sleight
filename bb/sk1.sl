      (push-lv (KX) d k _ t2 pu2 (LvC t3 kk1 (push-lv (KX) n2 kk1 t1 t3 pu (st-lv (Zero) n4 kk1 t0 t1 st1 lv1)))))
    ((StG _ _ g t0 t1 t3 _ st1 pu pu2)
      (let-match erased lv (LvO _ _ _ _ lv1))
      (push-lv (KX) xs k t3 t2 pu2 (push-lv (KG) g k t1 t3 pu (st-lv (Zero) n k t0 t1 st1 lv1))))
    ((StV _ _ b b2 _ a pu)
