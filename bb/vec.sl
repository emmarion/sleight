(def-adts $ (Vec : (Type A) -> Type)
  enum
  (many MkVec : (erased Type A) (erased (List (Copy A)) xs) (many (Nat) cap) (erased (Length (Copy A) xs cap) l)
     (unique (Array (Copy A) xs) a) (many A d) -> (Vec A)))

(def-fns _ $ (many vec-new : (erased Type A) (many (Nat) cap) (many A d) -> (unique (Vec A) v))
  (let ((erased xs) (unique a) (erased rp)) (array-make A cap d))
  (MkVec A xs cap (repeat-length _ _ _ _ rp) a d))

(def-fns _ $ (many vec-get : (erased Type A) (unique (Vec A) v) (many (Nat) i) -> (many A x) (unique (Vec A) v2 at v))
  (let-match unique v (MkVec _ xs cap l a d u))
  (let-match many (lt-dec i cap) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (values d (at unique (u A xs cap l a d)))))
  (let ((erased c) (erased nt)) (lt-nth _ xs cap i l lt))
  (let-match erased c (MkCopy _ y))
  (let ((many x) (unique a2)) (array-get _ _ a i y nt))
  (values x (at unique (u A xs cap l a2 d))))

(def-fns _ $ (many vec-copy : (erased Type A) (erased (List (Copy A)) xs ys) (many (Nat) n m) (erased (Length (Copy A) xs n) lx)
    (erased (Length (Copy A) ys m) ly) (unique (Array (Copy A) xs) a) (unique (Array (Copy A) ys) b) (subterm many (Nat) k) (many (Nat) i) ->
    (erased (List (Copy A)) zs) (erased (Length (Copy A) zs m) lz) (unique (Array (Copy A) zs) b2 at b))
  (let-match many k (Succ k1) ((Zero) (values ys ly b)))
  (let-match many (lt-dec i n) (Yes _ _ _ _ ln) ((No _ _ _ _ _) (values ys ly b)))
  (let-match many (lt-dec i m) (Yes _ _ _ _ lm) ((No _ _ _ _ _) (values ys ly b)))
  (let ((erased c) (erased nt)) (lt-nth _ xs n i lx ln))
  (let-match erased c (MkCopy _ y))
  (let ((many x) (unique a2)) (array-get _ _ a i y nt))
  (let ((erased c2) (erased nt2)) (lt-nth _ ys m i ly lm))
  (let ((erased ys2) (unique b1) (erased st)) (array-place _ _ b i (MkCopy _ x) c2 nt2))
  (tail $ vec-copy A xs ys2 n m lx (setnth-len _ ys ys2 i m _ st ly) a2 b1 k1 (Succ i)))

(def-fns _ $ (many vec-set : (erased Type A) (unique (Vec A) v) (many (Nat) i) (many A x) -> (unique (Vec A) v2 at v))
  (let-match unique v (MkVec _ xs cap l a d u))
  (let-match many (lt-dec i cap) (No _ _ _ _ _)
    ((Yes _ _ _ _ lt)
      (let ((erased c) (erased nt)) (lt-nth _ xs cap i l lt))
      (let ((erased ys) (unique a2) (erased st)) (array-place _ _ a i (MkCopy _ x) c nt))
      (at unique (u A ys cap (setnth-len _ xs ys i cap _ st l) a2 d))))
  (let ((many c2) (erased _)) (add cap cap))
  (let ((many c3)) (match many (lt-dec i c2) (((Nat) c)) ((Yes _ _ _ _ _) c2) ((No _ _ _ _ _) (Succ i))))
  (let ((erased ys) (unique b) (erased rp)) (array-make A c3 d))
  (let ((erased zs) (erased lz) (unique b2)) (vec-copy A xs ys cap c3 l (repeat-length _ _ _ _ rp) a b cap 0))
  (let-match many (lt-dec i c3) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (u A zs c3 lz b2 (at) d)))
  (let ((erased c) (erased nt)) (lt-nth _ zs c3 i lz lt))
  (let ((erased ws) (unique b3) (erased st)) (array-place _ _ b2 i (MkCopy _ x) c nt))
  (u A ws c3 (setnth-len _ zs ws i c3 _ st lz) b3 (at) d))
