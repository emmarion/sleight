(def-fns _ $ (many b2-mac : (many (Nat) idx) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many (nat-eq idx 15) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-train2 c0 e ch)))
  (let-match many (nat-eq idx 16) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-traing2 c0 e ch)))
  (let-match many (nat-eq idx 115) (Unequal _ _ _ _ _) ((Equal _ _ _) (try-train c0 e ch)))
  (RsNo l3 c0 e ch))

(def-fns _ $ (many b2-rep : (subterm many (Nat) k) (many (Nat) idx) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many r)) (b2-mac idx c0 e ch))
  (let-match many k (Succ k2) ((Zero) r))
  (let-match many k2 (Succ _) ((Zero) r))
  (tail $ b2-rep k2 idx c0 e ch))

(def-fns _ $ (many tmain : (many (String) in) -> (many (String) out))
  (let ((many idx) (many s0)) (tok in))
  (let ((many rep) (many s0b)) (tok s0))
  (let ((many e) (many s1)) (rd-cfg s0b))
  (let ((many f) (many _)) (rd-cfg s1))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let ((many o)) (match many (b2-rep rep idx c0 e ch) (((Rope) o))
    ((RsOk _ _ e2 _) (match many (rq-eq e2 f) _ ((ESome _ _) (RStr "MATCH")) ((ENone _) (RStr "DIFF"))))
    ((RsNo _ _ _ _) (RStr "NOFIRE"))))
  (let ((many s) (erased _)) (flatten (RCat o (RChar #\newline))))
  s)
