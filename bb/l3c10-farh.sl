(let ((erased fp-pos)) (prove-literal-lt 0 2305843009213693951))

(def-fns _ $ (many fp-runs : (subterm many (List (Rn)) L) (many (Nat) acc) -> (many (Nat) h))
  (let-match many L (Cons _ rn L1) ((Nil _) acc))
  (let-match many rn (MkRn b n))
  (let ((many q) (many r) (erased _) (erased _) (erased _) (erased _))
    (divmod (nat-add (nat-mul acc 1000003) (nat-add (nat-add n n) (bit-nat b))) 2305843009213693951 fp-pos))
  (tail $ fp-runs L1 r))

(def-fns _ $ (many show-fp : (many (Rq) e) -> (many (Rope) r))
  (let-match many e (MkRq q L h R))
  (sp (sp (sp (sp (sp (sp (RStr "") q) (bit-nat h)) (nlen-runs L 0)) (nlen-runs R 0)) (fp-runs L 0)) (fp-runs R 0)))

(def-lvl FP0)
(def-lvl FP)
(def-fns FP0 $ (many fstep : (subterm many (Nat) fuel) (many (Nat) mv) (many (List (Nat)) cks) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program FP) next))
  (let-match many fuel (Succ f) ((Zero) (values w (Exit FP (MkU8 0 rp-z)))))
  (let ((many i) (many r)) (c10-move-f c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (values w (Exit FP (MkU8 0 rp-z)))))
  (let ((many mv1)) (Succ mv))
  (let ((unique w1) (many u)) (world-do _ w (Measure sw-stop)))
  (let-match many u (MkUsage wall user _ _ _ _ _ _))
  (let ((many ck) (many cks1)) (match many cks (((Bool) b) ((List (Nat)) t))
    ((Cons _ k t) (match many (nat-eq k mv1) _ ((Equal _ _ _) (values (BTrue) t)) (else (values (BFalse) cks))))
    ((Nil _) (values (BFalse) cks))))
  (let ((many line)) (RCat (sp (sp (sp (RStr "T") mv1) i) user) (RCat (sp (RStr "") wall) (RChar #\newline))))
  (let ((many txt)) (match many ck (((Rope) t)) ((BTrue) (RCat line (RCat (sp (RStr "F") mv1) (RCat (show-fp e1) (RChar #\newline))))) ((BFalse) line)))
  (let ((many s) (erased _)) (flatten txt))
  (let ((unique w2) (many _)) (world-do _ w1 (WriteOut s)))
  (def-unique FP $ (unique again : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program FP) next))
    (fstep f mv1 cks1 c0 e1 ch1 v))
  (values w2 (Continue FP again)))

(def-fns _ $ (many rprog-in : (many (Nat) mv0 n) (many (List (Nat)) cks) -> (unique (Program FP) p))
  (def-unique FP $ (unique go : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program FP) next))
    (let ((unique v1) (many s)) (world-do _ v (ReadRemaining)))
    (let ((many e) (many _)) (rd-cfg s))
    (let ((erased c0) (erased ch)) (rch-self l3 e))
    (fstep n mv0 cks c0 e ch v1))
  (Continue FP go))
