(def-fns _ $ (erased trel-alg : (erased (Nat) T D D1 dx E1 X Y M1 R31 Z R3) (erased (Add dx D1 D) p1) (erased (Add T D1 E1) p2) (erased (Add X Y M1) p3)
    (erased (Add M1 R31 E1) p4) (erased (Add Y dx Z) p5) (erased (Add Z R31 R3) p6) -> (erased (Nat) E) (erased (Add T D E) q1) (erased (Add X R3 E) q2))
  (let ((erased E) (erased e)) (add-ex E1 dx))
  (let ((erased u) (erased u1) (erased u2)) (add-assoc-r T D1 E1 dx E p2 e))
  (let-match erased (add-fn D1 dx u D u1 (add-comm dx D1 D p1)) (Refl _ _))
  (let ((erased v) (erased v1) (erased v2)) (add-assoc-r X Y M1 R31 E1 p3 p4))
  (let ((erased w) (erased w1) (erased w2)) (add-assoc-r X v E1 dx E v2 e))
  (let-match erased (add-fn Z R31 w R3 (add-swp Y R31 v dx w Z v1 w1 p5) p6) (Refl _ _))
  (values E u2 w2))

(def-fns _ $ (erased trel : (erased (Nat) p r a b D m y) (erased (List (Ps)) w) (subterm erased (PBlk p r w) bk) (erased (Fzl w) fz) (erased (Sdw w D) sd)
    (erased (Hp w a b) h) (erased (Top p m) tp) (erased (D3 (Succ m) y) d3)
    -> (erased (Nat) T E M R3) (erased (Mul b n4 T) xt) (erased (Add T D E) e1) (erased (Mul a (Succ y) M) mm) (erased (D3 r R3) dr) (erased (Add M R3 E) e2))
  (let-match erased bk (BlS p1 m1 _ i r1 rs x w1 ss top g lc st b1)
    ((BlZ)
      (let-match erased h (HpN _))
      (let-match erased sd (SdwN))
      (let-match erased tp (TopZ))
      (let-match erased d3 (D3S _ _ d0))
      (let-match erased d0 (D3Z))
      (let ((erased T) (erased xt)) (mul-ex a n4))
      (values T T T (Zero) xt (add-zero-right T) xt (D3Z) (add-zero-right T))))
