  (let-match erased h (HpC _ _ _ a4 t a2 _ ma tg ad h1))
  (let-match erased sd (SdwC _ _ dx D1 _ dl sd1 ad1))
  (let-match erased tp (TopS _ m0 _ top0 ta))
  (let-match erased (top-fn p1 m0 m1 top0 top) (Refl _ _))
