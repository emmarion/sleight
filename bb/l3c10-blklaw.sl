  (let ((erased T) (erased E1) (erased M1) (erased R31) (erased xt) (erased e11) (erased mm1) (erased dr1) (erased e21))
    (trel p1 rs a2 b D1 m1 y1 w1 b1 fz1 sd1 h1 top d31))
  (let ((erased X) (erased Y) (erased mx) (erased my) (erased qxy)) (mul-dist a4 t a2 (Succ y1) M1 ad mm1))
  (let ((erased o) (erased Z) (erased ao) (erased er) (erased az) (erased dz)) (trel-pair x i r1 rs m1 r t dx y1 Y lc st tg dl d31 my fx))
  (let-match erased er (Refl _ _))
  (let ((erased R3) (erased dr) (erased ar)) (d3-add o r1 r Z R31 ao dz dr1))
  (let ((erased E) (erased q1) (erased q2)) (trel-alg T D D1 dx E1 X Y M1 R31 Z R3 ad1 e11 qxy e21 az ar))
  (values T E X R3 xt q1 (mul-sc a a4 (Succ y1) X (Succ y) ma mx (k4 m1 m y1 y (topat-q4 m1 m ta) d31 d3)) dr q2))

(def-fns _ $ (erased dm-uniq : (erased (Nat) b n q m r q2 m2 r2) (erased (Mul q b m) mm) (erased (Add m r n) ad) (erased (Lt r b) lt)
    (erased (Mul q2 b m2) mm2) (erased (Add m2 r2 n) ad2) (erased (Lt r2 b) lt2) -> (erased (Eq (Nat) q q2) e1) (erased (Eq (Nat) r r2) e2))
