(let ((many one)) (Succ (Zero)))
(let ((many three)) (Succ two))
(let ((many four)) (Succ three))
(let ((many five)) (Succ four))

(def-adts
  ((Nz : ((Ps) x) -> Type)
    enum
    (many NzA : -> (Nz (PrA)))
    (many NzB : -> (Nz (PrB)))
    (many NzC : -> (Nz (PrC)))
    (many NzD : -> (Nz (PrD)))))

(def-adts
  ((Nfw : ((List (Ps)) w) -> Type)
    enum
    (many NfN : -> (Nfw (Nil (Ps))))
    (many NfC : (erased (Ps) x) (erased (List (Ps)) w) (erased (Nz x) z) (erased (Nfw w) f) -> (Nfw (Cons (Ps) x w)))))

(def-fns _ $ (erased nz-sts : (erased (Ps) x) (erased (Nat) i r m rs r2 m2) (erased (Nz x) z) (erased (StS i x r m rs) st)
    -> (erased (Eq (Nat) rs r) e) (erased (StS i x r2 m2 r2) st2))
  (match erased st _
    (absurd (Ss0 _) (match erased z _))
    ((Ss1 _ _) (values (Refl _ rs) (Ss1 r2 m2)))
    ((Ss2 _ _) (values (Refl _ rs) (Ss2 r2 m2)))
    (absurd (Ss3 _) (match erased z _))
    ((Ss4 _ _) (values (Refl _ rs) (Ss4 r2 m2)))
    ((Ss5 _ _) (values (Refl _ rs) (Ss5 r2 m2)))))

(def-fns _ $ (erased sts-inv : (erased (Nat) i i2 r r2 m rs) (erased (Ps) x) (erased (StS i x r m rs) p) (erased (StS i2 x r2 m rs) q)
    -> (erased (Eq (Nat) i i2) e) (erased (Eq (Nat) r r2) f))
  (match erased p _
    ((Ss0 _) (let-match erased q (Ss0 _)) (values (Refl _ i) (Refl _ r)))
    ((Ss1 _ _) (let-match erased q (Ss1 _ _)) (values (Refl _ i) (Refl _ r)))
    ((Ss2 _ _) (let-match erased q (Ss2 _ _)) (values (Refl _ i) (Refl _ r)))
    ((Ss3 _) (let-match erased q (Ss3 _)) (values (Refl _ i) (Refl _ r)))
    ((Ss4 _ _) (let-match erased q (Ss4 _ _)) (values (Refl _ i) (Refl _ r)))
    ((Ss5 _ _) (let-match erased q (Ss5 _ _)) (values (Refl _ i) (Refl _ r)))))

(def-fns _ $ (erased blk-inj : (erased (Nat) p p2 rho rho2) (erased (List (Ps)) w) (subterm erased (PBlk p rho w) a) (erased (PBlk p2 rho2 w) b)
    -> (erased (Eq (Nat) p p2) e) (erased (Eq (Nat) rho rho2) f))
  (match erased a _
    ((BlZ) (let-match erased b (BlZ)) (values (Refl _ p) (Refl _ rho)))
    ((BlS p1 m _ i r rs x w1 ss top g lc st b1)
      (let-match erased b (BlS p3 m2 _ i2 r2 rs2 _ _ ss2 top2 g2 lc2 st2 b2))
      (let ((erased e1) (erased f1)) (blk-inj p1 p3 rs rs2 w1 b1 b2))
      (let-match erased e1 (Refl _ _))
      (let-match erased f1 (Refl _ _))
      (let-match erased (top-fn p1 m m2 top top2) (Refl _ _))
      (let-match erased g (MkSg6 _))
      (let-match erased g2 (MkSg6 _))
      (let ((erased e2) (erased f2)) (sts-inv i i2 r r2 m rs x st st2))
      (let-match erased e2 (Refl _ _))
      (let-match erased f2 (Refl _ _))
      (values (Refl _ p) (loc-inj ss rho rho2 i r lc lc2)))))

(def-fns _ $ (erased loc-shift : (erased (List (Nat)) ss) (erased (Nat) rho i r r2 d) (subterm erased (Loc ss rho i r) q) (erased (Add r2 d r) a)
    -> (erased (Nat) rho2) (erased (Loc ss rho2 i r2) q2) (erased (Add rho2 d rho) b))
  (match erased q _
    ((LcH s _ ss1 lt) (values r2 (LcH s r2 ss1 (lt-le-trans r2 (Succ r) s (add-le-left r2 d r a) (LtS r s lt))) a))
    ((LcT s rho1 _ i1 _ ss1 ad q1)
      (let ((erased rho3) (erased q3) (erased b1)) (loc-shift ss1 rho1 i1 r r2 d q1 a))
      (let ((erased c) (erased p) (erased p2)) (add-assoc-l s rho3 d rho1 rho b1 ad))
      (values c (LcT s rho3 c i1 r2 ss1 p q3) p2))))

(def-fns _ $ (erased frame : (erased (List (Ps)) u W1 W2 wf wf2) (erased (Nat) P rho n r1 r2 d)
    (subterm erased (Cat (Ps) u W1 wf) c1) (erased (Cat (Ps) u W2 wf2) c2) (erased (PBlk P rho wf) b) (erased (Nfw u) nf)
    (erased (PBlk n r1 W1) b1) (erased (PBlk n r2 W2) b2) (erased (Add r2 d r1) a)
    -> (erased (Nat) rho2) (erased (PBlk P rho2 wf2) bo) (erased (Add rho2 d rho) ao))
  (match erased c1 _
    ((CatN _ _)
      (let-match erased c2 (CatN _ _))
      (let ((erased e) (erased f)) (blk-inj P n rho r1 W1 b b1))
      (let-match erased e (Refl _ _))
      (let-match erased f (Refl _ _))
      (values r2 b2 a))
    ((CatC _ x u1 _ wf1 c11)
      (let-match erased c2 (CatC _ _ _ _ wf3 c21))
      (let-match erased nf (NfC _ _ z nf1))
      (let-match erased b (BlS p1 m _ i r rs _ _ ss top g lc st bb))
      (let ((erased rho3) (erased b3) (erased a3)) (frame u1 W1 W2 wf1 wf3 p1 rs n r1 r2 d c11 c21 bb nf1 b1 b2 a))
      (let ((erased e) (erased st2)) (nz-sts x i r m rs rho3 m z st))
      (let-match erased e (Refl _ _))
      (let ((erased rho4) (erased lc4) (erased a4)) (loc-shift ss rho i r rho3 d lc a3))
      (values rho4 (BlS p1 m rho4 i rho3 rho3 x wf3 ss top g lc4 st2 b3) a4))))

(def-adts
  ((Dlt : ((Ps) x) ((Nat) d) -> Type)
    enum
    (many DzA : -> (Dlt (PrA) n3))
    (many DzB : -> (Dlt (PrB) n4))
    (many DzBp : -> (Dlt (PrBp) n1))
    (many DzC : -> (Dlt (PrC) n2))
    (many DzD : -> (Dlt (PrD) n3))
    (many DzDp : -> (Dlt (PrDp) (Zero)))))

(def-adts
  ((Sdw : ((List (Ps)) w) ((Nat) D) -> Type)
    enum
    (many SdwN : -> (Sdw (Nil (Ps)) (Zero)))
    (many SdwC : (erased (Ps) x) (erased (List (Ps)) w) (erased (Nat) d D E) (erased (Dlt x d) p) (erased (Sdw w D) q) (erased (Add d D E) a)
       -> (Sdw (Cons (Ps) x w) E))))

(def-adts
  ((X4 : ((Nat) a) ((Nat) b) -> Type)
    enum
    (many X4Z : -> (X4 (Zero) (Zero)))
    (many X4S : (erased (Nat) a b) (erased (X4 a b) p) -> (X4 (Succ a) (Succ (Succ (Succ (Succ b))))))))

(def-fns _ $ (erased x4-ex : (subterm erased (Nat) a) -> (erased (Nat) b) (erased (X4 a b) p))
  (let-match erased a (Succ a1) ((Zero) (values (Zero) (X4Z))))
  (let ((erased b1) (erased p1)) (x4-ex a1))
  (values (Succ (Succ (Succ (Succ b1)))) (X4S a1 b1 p1)))

(def-fns _ $ (erased x4-fn : (erased (Nat) a b c) (subterm erased (X4 a b) p) (erased (X4 a c) q) -> (erased (Eq (Nat) b c) e))
  (let-match erased p (X4S a1 b1 p1) ((X4Z) (let-match erased q (X4Z)) (Refl _ b)))
  (let-match erased q (X4S _ c1 q1))
  (let-match erased (x4-fn a1 b1 c1 p1 q1) (Refl _ _))
  (Refl _ b))

(def-fns _ $ (erased x4-add : (erased (Nat) a b c A B) (subterm erased (Add a b c) ad) (erased (X4 a A) xa) (erased (X4 b B) xb)
    -> (erased (Nat) C) (erased (X4 c C) xc) (erased (Add A B C) r))
  (let-match erased ad (AddSucc a1 _ c1 ad1) ((AddZero _) (let-match erased xa (X4Z)) (values B xb (AddZero B))))
  (let-match erased xa (X4S _ A1 xa1))
  (let ((erased C1) (erased xc1) (erased r1)) (x4-add a1 b c1 A1 B ad1 xa1 xb))
  (values (Succ (Succ (Succ (Succ C1)))) (X4S c1 C1 xc1) (AddSucc _ _ _ $ AddSucc _ _ _ $ AddSucc _ _ _ $ AddSucc _ _ _ r1)))

(def-fns _ $ (erased x4-lt : (erased (Nat) a b A B) (subterm erased (Lt a b) l) (erased (X4 a A) xa) (erased (X4 b B) xb) -> (erased (Lt A B) r))
  (let-match erased xb (X4S b1 B1 xb1) (absurd (X4Z) (match erased l _)))
  (let-match erased l (LtS a1 _ l1) ((LtZ _) (let-match erased xa (X4Z)) (LtZ _)))
  (let-match erased xa (X4S _ A1 xa1))
  (LtS _ _ $ LtS _ _ $ LtS _ _ $ LtS _ _ (x4-lt a1 b1 A1 B1 l1 xa1 xb1)))

(def-fns _ $ (erased q4-x4 : (erased (Nat) m t) (subterm erased (Q4 m t) q) -> (erased (X4 (Succ m) t) x))
  (match erased q _
    ((Q4Z) (X4S (Zero) (Zero) (X4Z)))
    ((Q4S m1 t1 q1) (X4S _ _ (q4-x4 m1 t1 q1)))))

(def-fns _ $ (erased bnd4 : (erased (Nat) x K X r s S) (erased (Add x K X) a) (erased (X4 r X) xr) (erased (Lt r s) l) (erased (X4 s S) xs) -> (erased (Lt x S) q))
  (lt-le-trans x (Succ X) S (add-le-left x K X a) (LtS X S (x4-lt r s X S l xr xs))))

(def-fns _ $ (erased segm : (erased (Nat) x K X m X2) (erased (Add x K X) a) (erased (Add m X X2) b)
    -> (erased (Nat) x2) (erased (Add (Succ m) x x2) c) (erased (Add x2 K (Succ X2)) d))
  (let ((erased c1) (erased p) (erased q)) (add-assoc-l m x K X X2 a b))
  (values (Succ c1) (AddSucc m x c1 p) (AddSucc c1 K X2 q)))

(def-fns _ $ (erased segm1 : (erased (Nat) x K X m X2) (erased (Add x (Succ K) X) a) (erased (Add m X X2) b)
    -> (erased (Nat) x2) (erased (Add (Succ m) x x2) c) (erased (Add x2 K X2) d))
  (let ((erased x2) (erased c) (erased d1)) (segm x (Succ K) X m X2 a b))
  (let ((erased c1) (erased e) (erased d)) (add-succ-right-inv x2 K (Succ X2) d1))
  (let-match erased e (Refl _ _))
  (values x2 c d))

(def-fns _ $ (erased snoc-loc : (erased (Nat) i r m rho dx D1 D rho3 R1 m2) (erased (Ps) x) (erased (Nz x) z) (erased (StS i x r m r) st)
    (erased (Loc (Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) (Succ m) $ Cons (Nat) n1 $ Cons (Nat) (Succ m) $ Cons (Nat) m $ Nil (Nat)) rho i r) lc)
    (erased (Dlt x dx) dl) (erased (Add dx D1 D) ad) (erased (X4 (Succ m) m2) xm) (erased (X4 r R1) xr) (erased (Add rho3 D1 R1) a3)
    -> (erased (Nat) rho2 R) (erased (X4 rho R) x4) (erased (Add rho2 D R) a)
    (erased (Loc (Cons (Nat) n1 $ Cons (Nat) (Succ m2) $ Cons (Nat) (Succ m2) $ Cons (Nat) n1 $ Cons (Nat) (Succ m2) $ Cons (Nat) m2 $ Nil (Nat)) rho2 i rho3) lc2))
  (match erased st _
    (absurd (Ss0 _) (match erased z _))
    (absurd (Ss3 _) (match erased z _))
    ((Ss1 _ _)
      (let-match erased dl (DzD))
      (let-match erased ad (AddSucc _ _ _ ad1))
      (let-match erased ad1 (AddSucc _ _ _ ad2))
      (let-match erased ad2 (AddSucc _ _ _ ad3))
      (let-match erased ad3 (AddZero _))
      (let-match erased lc (LcT _ rho1 _ _ _ _ a1 lc1))
      (let-match erased a1 (AddSucc _ _ _ a0))
      (let-match erased a0 (AddZero _))
      (let-match erased lc1 (LcH _ _ _ lt))
      (let ((erased bnd)) (bnd4 rho3 D1 R1 r (Succ m) m2 a3 xr lt xm))
      (values (Succ rho3) (Succ (Succ (Succ (Succ R1)))) (X4S r R1 xr)
        (AddSucc _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ a3)
        (LcT n1 rho3 (Succ rho3) (Zero) rho3 _ (a1x rho3) (LcH (Succ m2) rho3 _ (lt-weaken _ _ bnd)))))
    ((Ss2 _ _)
      (let-match erased dl (DzC))
      (let-match erased ad (AddSucc _ _ _ ad1))
      (let-match erased ad1 (AddSucc _ _ _ ad2))
      (let-match erased ad2 (AddZero _))
      (let-match erased lc (LcT _ rho1 _ _ _ _ a1 lc1))
      (let-match erased a1 (AddSucc _ _ _ a0))
      (let-match erased a0 (AddZero _))
      (let-match erased lc1 (LcT _ rho4 _ _ _ _ a2 lc2))
      (let-match erased lc2 (LcH _ _ _ lt))
      (let ((erased C1) (erased x1) (erased c1)) (x4-add (Succ m) r rho1 m2 R1 a2 xm xr))
      (let ((erased y1) (erased b1) (erased e1)) (segm rho3 D1 R1 m2 C1 a3 c1))
      (let ((erased bnd)) (bnd4 rho3 D1 R1 r (Succ m) m2 a3 xr lt xm))
      (values (Succ y1) (Succ (Succ (Succ (Succ C1)))) (X4S rho1 C1 x1)
        (AddSucc _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ e1)
        (LcT n1 y1 (Succ y1) n1 rho3 _ (a1x y1) $ LcT (Succ m2) rho3 y1 (Zero) rho3 _ b1 $ LcH (Succ m2) rho3 _ (lt-weaken _ _ bnd))))
    ((Ss4 _ _)
      (let-match erased dl (DzB))
      (let-match erased ad (AddSucc _ _ _ ad1))
      (let-match erased ad1 (AddSucc _ _ _ ad2))
      (let-match erased ad2 (AddSucc _ _ _ ad3))
      (let-match erased ad3 (AddSucc _ _ _ ad4))
      (let-match erased ad4 (AddZero _))
      (let-match erased lc (LcT _ q1 _ _ _ _ a1 lc1))
      (let-match erased a1 (AddSucc _ _ _ a0))
      (let-match erased a0 (AddZero _))
      (let-match erased lc1 (LcT _ q2 _ _ _ _ a2 lc2))
      (let-match erased lc2 (LcT _ q3 _ _ _ _ a3b lc3))
      (let-match erased lc3 (LcT _ q4 _ _ _ _ a4 lc4))
      (let-match erased a4 (AddSucc _ _ _ a40))
      (let-match erased a40 (AddZero _))
      (let-match erased lc4 (LcH _ _ _ lt))
      (let ((erased C2) (erased x2) (erased c2)) (x4-add (Succ m) q3 q2 m2 _ a3b xm (X4S r R1 xr)))
      (let ((erased C1) (erased x1) (erased c1)) (x4-add (Succ m) q2 q1 m2 C2 a2 xm x2))
      (let ((erased e3)) (AddSucc _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ a3))
      (let ((erased y2) (erased b2) (erased e2)) (segm1 (Succ rho3) (Succ (Succ D1)) _ m2 C2 e3 c2))
      (let ((erased y1) (erased b1) (erased e1)) (segm1 y2 (Succ D1) C2 m2 C1 e2 c1))
      (let ((erased bnd)) (bnd4 rho3 D1 R1 r (Succ m) m2 a3 xr lt xm))
      (values (Succ y1) (Succ (Succ (Succ (Succ C1)))) (X4S q1 C1 x1)
        (add-succ-right _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ $ AddSucc _ _ _ e1)
        (LcT n1 y1 (Succ y1) n3 rho3 _ (a1x y1) $ LcT (Succ m2) y2 y1 n2 rho3 _ b1 $ LcT (Succ m2) (Succ rho3) y2 n1 rho3 _ b2 $
          LcT n1 rho3 (Succ rho3) (Zero) rho3 _ (a1x rho3) $ LcH (Succ m2) rho3 _ (lt-weaken _ _ bnd))))
    ((Ss5 _ _)
      (let-match erased dl (DzA))
      (let-match erased ad (AddSucc _ _ _ ad1))
      (let-match erased ad1 (AddSucc _ _ _ ad2))
      (let-match erased ad2 (AddSucc _ _ _ ad3))
      (let-match erased ad3 (AddZero _))
      (let-match erased lc (LcT _ q1 _ _ _ _ a1 lc1))
      (let-match erased a1 (AddSucc _ _ _ a0))
      (let-match erased a0 (AddZero _))
      (let-match erased lc1 (LcT _ q2 _ _ _ _ a2 lc2))
      (let-match erased lc2 (LcT _ q3 _ _ _ _ a3b lc3))
      (let-match erased lc3 (LcT _ q4 _ _ _ _ a4 lc4))
      (let-match erased a4 (AddSucc _ _ _ a40))
      (let-match erased a40 (AddZero _))
      (let-match erased lc4 (LcT _ q5 _ _ _ _ a5 lc5))
      (let-match erased lc5 (LcH _ _ _ lt))
      (let-match erased xm (X4S _ M xmm))
      (let ((erased C4) (erased x4b) (erased c4)) (x4-add (Succ m) r q4 _ R1 a5 xm xr))
      (let ((erased C2) (erased x2) (erased c2)) (x4-add (Succ m) q3 q2 _ _ a3b xm (X4S q4 C4 x4b)))
      (let ((erased C1) (erased x1) (erased c1)) (x4-add (Succ m) q2 q1 _ C2 a2 xm x2))
      (let ((erased y4) (erased b4) (erased e4)) (segm rho3 D1 R1 _ C4 a3 c4))
      (let ((erased e3)) (AddSucc _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ e4))
      (let ((erased y2) (erased b2) (erased e2)) (segm1 (Succ y4) (Succ D1) _ _ C2 e3 c2))
      (let ((erased y1) (erased b1) (erased e1)) (segm1 y2 D1 C2 _ C1 e2 c1))
      (let ((erased bnd)) (bnd4 rho3 D1 R1 r m M a3 xr lt xmm))
      (values (Succ y1) (Succ (Succ (Succ (Succ C1)))) (X4S q1 C1 x1)
        (AddSucc _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ $ add-succ-right _ _ _ e1)
        (LcT n1 y1 (Succ y1) n4 rho3 _ (a1x y1) $ LcT _ y2 y1 n3 rho3 _ b1 $ LcT _ (Succ y4) y2 n2 rho3 _ b2 $
          LcT n1 y4 (Succ y4) n1 rho3 _ (a1x y4) $ LcT _ rho3 y4 (Zero) rho3 _ b4 $
          LcH _ rho3 _ (lt-weaken _ _ $ lt-weaken _ _ $ lt-weaken _ _ $ lt-weaken _ _ bnd))))))

(def-fns _ $ (erased blk-snoc : (erased (Nat) p rho D) (erased (List (Ps)) w w2) (subterm erased (PBlk p rho w) b) (erased (Nfw w) nf) (erased (Sdw w D) sd)
    (erased (Sn w w2) sn) -> (erased (Nat) rho2 R) (erased (X4 rho R) x4) (erased (Add rho2 D R) a) (erased (PBlk (Succ p) rho2 w2) b2))
  (match erased b _
    ((BlZ)
      (let-match erased sn (SnN))
      (let-match erased sd (SdwN))
      (values (Zero) (Zero) (X4Z) (AddZero (Zero))
        (BlS (Zero) (Zero) (Zero) (Zero) (Zero) (Zero) (PrDp) (Nil (Ps)) _ (TopZ) (MkSg6 (Zero)) (LcH n1 (Zero) _ (LtZ _)) (Ss0 (Zero)) (BlZ))))
    ((BlS p1 m _ i r rs x w1 ss top g lc st bb)
      (let-match erased sn (SnC _ _ w3 sn1))
      (let-match erased nf (NfC _ _ z nf1))
      (let-match erased sd (SdwC _ _ dx D1 _ dl sd1 ad))
      (let ((erased e) (erased _)) (nz-sts x i r m rs r m z st))
      (let-match erased e (Refl _ _))
      (let ((erased rho3) (erased R1) (erased xr) (erased a3) (erased b3)) (blk-snoc p1 r D1 w1 w3 bb nf1 sd1 sn1))
      (let ((erased m2) (erased ta)) (top-at m))
      (let ((erased xm)) (q4-x4 m m2 (topat-q4 m m2 ta)))
      (let-match erased g (MkSg6 _))
      (let ((erased rho2) (erased R) (erased x4) (erased a) (erased lc2)) (snoc-loc i r m rho dx D1 D rho3 R1 m2 x z st lc dl ad xm xr a3))
      (let ((erased _) (erased st2)) (nz-sts x i r m r rho3 m2 z st))
      (values rho2 R x4 a (BlS (Succ p1) m2 rho2 i rho3 rho3 x w3 _ (TopS p1 m m2 top ta) (MkSg6 m2) lc2 st2 b3)))))

(def-fns _ $ (erased rva-gen : (erased (List (Ps)) acc V u V2 W w2) (subterm erased (Rva (Ps) acc V u) r) (erased (Cat (Ps) V W V2) c)
    (erased (Cat (Ps) u W w2) d) -> (erased (Rva (Ps) acc V2 w2) q))
  (match erased r _
    ((RvN _ _) (let-match erased (cat-fn (Ps) V W V2 w2 c d) (Refl _ _)) (RvN (Ps) V2))
    ((RvC _ x acc1 _ _ r1)
      (RvC (Ps) x acc1 V2 w2 (rva-gen acc1 (Cons (Ps) x V) u (Cons (Ps) x V2) W w2 r1 (CatC (Ps) x V W V2 c) d)))))

(def-fns _ $ (erased rva-cat : (erased (List (Ps)) acc V w) (subterm erased (Rva (Ps) acc V w) r)
    -> (erased (List (Ps)) u) (erased (Rva (Ps) acc (Nil (Ps)) u) q) (erased (Cat (Ps) u V w) c))
  (match erased r _
    ((RvN _ _) (values (Nil (Ps)) (RvN (Ps) (Nil (Ps))) (CatN (Ps) V)))
    ((RvC _ x acc1 _ _ r1)
      (let ((erased u1) (erased q1) (erased c1)) (rva-cat acc1 (Cons (Ps) x V) w r1))
      (let ((erased u) (erased c2) (erased c3))
        (cat-assoc2 (Ps) u1 (Cons (Ps) x (Nil (Ps))) V (Cons (Ps) x V) w (CatC (Ps) x (Nil (Ps)) V V (CatN (Ps) V)) c1))
