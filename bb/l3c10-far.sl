(def-fns _ $ (many rnorm-pre : (subterm many (Nat) k) (many (List (Rn)) L) (erased (List (Bool)) x) (erased (Den L x) d) -> (many (List (Rn)) L2) (erased (Den L2 x) d2))
  (let-match many k (Succ k1) ((Zero) (values L d)))
  (let-match many L (Cons _ rn L1) ((Nil _) (values L d)))
  (let-match erased d (DeC _ _ _ t _ d1 p))
  (let ((many L3) (erased d3)) (notail $ rnorm-pre k1 L1 t d1))
  (let-match many rn (MkRn b n))
  (let-match many n (Succ _) ((Zero) (let-match erased p (RpZ _ _)) (values L3 d3)))
  (let ((many L4) (erased y) (erased q) (erased d4)) (pushrun b n L3 t d3))
  (let-match erased (rp-fn b n t x y p q) (Refl _ _))
  (values L4 d4))

(def-fns _ $ (many rs-normpre : (erased (Conf) c0) (many (Nat) k) (many (Rs l3 c0) r) -> (many (Rs l3 c0) res))
  (let-match many r (RsOk _ _ e ch) ((RsNo _ _ _ _) r))
  (let-match erased ch (MkRch _ _ a c _ n run dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ l x dl dr))
  (let ((many R2) (erased dr2)) (rnorm-pre k R x dr))
  (RsOk l3 c0 (MkRq q L h R2) (MkRch l3 c0 a c (MkRq q L h R2) n run (MkDc q L R2 h l x dl dr2) z)))

(def-fns _ $ (many find-at : (subterm many (List (Rn)) A) (many (List (Rn)) B) (many (Nat) acc) -> (many (Maybe (Nat)) r))
  (let-match many (slot-eq (slot-of A) (slot-of B)) (ENone _) ((ESome _ _) (Some _ acc)))
  (let-match many A (Cons _ _ A1) ((Nil _) (None _)))
  (tail $ find-at A1 B (Succ acc)))

(def-fns _ $ (many c-certify-f : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Nat) fuel) (many (LmC) lc) (many (Maybe (Rq)) mt) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many mt (Some _ t) ((None _) no))
  (let-match many lc (LcOk _ _ _ _ _ R1) ((LcNo) no))
  (let-match many R1 (Cons _ _ Rt) ((Nil _) no))
  (let-match many e (MkRq q L h R))
  (let-match many t (MkRq tq tL th tR))
  (let-match many (find-at R R1 0) (Some _ i) ((None _) no))
  (let-match many (find-at tR Rt 0) (Some _ j1) ((None _) no))
  (let ((many j)) (monus j1 1))
  (let-match many (run-at i R) (Some _ rg) ((None _) no))
  (let-match many (run-at j tR) (Some _ rg2) ((None _) no))
  (let-match many rg (MkRn bg G))
  (let-match many rg2 (MkRn bg2 G2))
  (let-match many bg (BFalse) ((BTrue) no))
  (let-match many bg2 (BFalse) ((BTrue) no))
  (let-match many (nle G2 G) (BTrue) ((BFalse) no))
  (let ((many ein)) (MkRq q L h (rtake-g i R (Succ (monus G G2)))))
  (let ((many P)) (rtake-g j tR 1))
  (let ((erased p) (erased dp)) (den-ex P))
  (let ((many P2) (erased _)) (rnorm P p dp))
  (let ((erased tl0) (erased dtl)) (den-ex tL))
  (let ((many tL2) (erased _)) (rnorm tL tl0 dtl))
  (let ((many eo)) (MkRq tq tL2 th P2))
  (let ((many ok) (many _) (many _)) (f-run fuel ein ein (FsN ein) eo))
  (let-match many ok (ESome _ s) ((ENone _) no))
  (rs-normpre c0 (Succ j) (frame-one (MkFE ein eo s) c0 e ch)))

(def-fns _ $ (many certify-fc : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Nat) fuel) (many (LmC) lc) (many (Maybe (Rq)) mt) -> (many (Rs l3 c0) res))
  (let-match many (c-certify-f c0 e ch fuel lc mt) (RsNo _ _ _ _) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (c-certify-c c0 e ch fuel 0 mt))

(def-fns _ $ (many c-child-f : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many (child-pre lc mp rho) (CpOk _ p _ gbc Gr _ _) ((CpNo) no))
  (let-match many (child-head p rho gbc) (CrOk _ _ _ _ cE) ((CrNo) no))
  (let ((many need)) (nat-add cE (nat-add (uon p) (kdf p))))
  (let-match many (nle need Gr) (BTrue) ((BFalse) no))
  (let-match many (reach-t1 c0 10000000 256 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) no))
