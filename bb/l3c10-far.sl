(def-fns _ $ (many fired : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Rs l3 c0) r) -> (many (Rs l3 c0) res))
  (let-match many r (RsOk _ _ e1 _) ((RsNo _ _ _ _) r))
  (match many (rq-eq e1 e) _ ((ESome _ _) (RsNo l3 c0 e ch)) ((ENone _) r)))

(def-fns _ $ (many c10-big : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (LmR e) lm)
    -> (many (Nat) j) (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many (bigj-ok e) (BTrue) ((BFalse) (values 2 no)))
  (let ((many r1)) (c-move9-at c0 e ch lm))
  (let-match many r1 (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (values 2 no)))
  (let ((many r0)) (match many (c-move9 c0 e1 ch1) (((Rs l3 c0) r)) ((RsOk _ _ e2 ch2) (fired c0 e ch (try-contact c0 e2 ch2))) ((RsNo _ _ _ _) no)))
  (let-match many r0 (RsNo _ _ _ _) ((RsOk _ _ _ _) (values 0 r0)))
  (let ((many r2)) (fired c0 e ch r1))
  (match many r2 _ ((RsOk _ _ _ _) (values 1 r2)) ((RsNo _ _ _ _) (values 2 r2))))

(def-fns _ $ (many c10-move-f : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) idx) (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let ((many lm)) (c-lm e c dc))
  (let ((many lc)) (lc-of e lm))
  (let ((many j0) (many r0)) (c10-big c0 e ch lm))
  (let-match many r0 (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j0 r0)))
  (let ((many j) (many r)) (c10-scan 2 2 c0 e ch lm lc (None _) 0))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values j r)))
  (let ((many mp) (many rho)) (fe-of lc))
  (c10-scan 21 5 c0 e ch lm lc mp rho))

(def-fns _ $ (many c10-run3 : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Nat) left) (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values fuel e ch)))
  (let ((many _) (many r)) (c10-move-f c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values fuel e1 ch1)))
  (tail $ c10-run3 c0 f e1 ch1))
