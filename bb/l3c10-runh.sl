(let ((many rp-d0)) (lt-dec 0 u8-modulus))
(comptime-match many rp-d0 (Yes _ _ _ _ rp-z))

(def-fns _ $ (many tscan : (subterm many (Nat) n) (many (Nat) i) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho) (many (Nat) t0) (many (Rope) acc) (unique (World) w at vacant-slot)
    -> (unique (World) w2 at w) (many (Nat) j) (many (Rs l3 c0) res) (many (Nat) t) (many (Rope) acc2))
  (let ((many r)) (c10-try i c0 e ch lc mp rho))
  (let ((unique w1) (many u)) (world-do _ w (Measure sw-stop)))
  (let-match many u (MkUsage _ t1 _ _ _ _ _ _))
  (let ((many acc1)) (sp acc (monus t1 t0)))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values w1 i r t1 acc1)))
  (let-match many n (Succ n1) ((Zero) (values w1 i r t1 acc1)))
  (tail $ tscan n1 (Succ i) c0 e ch lc mp rho t1 acc1 w1))

(def-fns _ $ (many tmove : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Nat) t0) (unique (World) w at vacant-slot)
    -> (unique (World) w2 at w) (many (Nat) j) (many (Rs l3 c0) res) (many (Nat) t) (many (Rope) acc))
  (let ((unique w1) (many j) (many r) (many t1) (many a1)) (tscan 4 0 c0 e ch (LcNo) (None _) 0 t0 (RStr " E") w))
  (let-match many r (RsNo _ _ _ _) ((RsOk _ _ _ _) (values w1 j r t1 a1)))
  (let ((many lc)) (lmc e))
  (let ((many mp) (many rho)) (fe-of lc))
  (let ((unique w2) (many u)) (world-do _ w1 (Measure sw-stop)))
  (let-match many u (MkUsage _ t2 _ _ _ _ _ _))
  (tscan 21 5 c0 e ch lc mp rho t2 (sp (RCat a1 (RStr " P")) (monus t2 t1)) w2))

(def-lvl RP0)
(def-lvl RP)
(def-fns RP0 $ (many rstep : (subterm many (Nat) fuel) (many (Nat) mv) (many (List (Nat)) cks) (many (Nat) t0) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program RP) next))
  (let-match many fuel (Succ f) ((Zero) (values w (Exit RP (MkU8 0 rp-z)))))
  (let ((unique w0) (many i) (many r) (many _) (many ts)) (tmove c0 e ch t0 w))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (values w0 (Exit RP (MkU8 0 rp-z)))))
  (let ((many mv1)) (Succ mv))
  (let ((unique w1) (many u)) (world-do _ w0 (Measure sw-stop)))
  (let-match many u (MkUsage wall user _ _ _ _ _ _))
  (let ((many ck) (many cks1)) (match many cks (((Bool) b) ((List (Nat)) t))
    ((Cons _ k t) (match many (nat-eq k mv1) _ ((Equal _ _ _) (values (BTrue) t)) (else (values (BFalse) cks))))
    ((Nil _) (values (BFalse) cks))))
  (let ((many line)) (RCat (sp (sp (sp (RStr "T") mv1) i) user) (RCat (sp (RStr "") wall) (RCat ts (RChar #\newline)))))
  (let ((many txt)) (match many ck (((Rope) t)) ((BTrue) (RCat line (RCat (sp (RStr "C") mv1) (RCat (RChar #\newline) (show-cfg e1))))) ((BFalse) line)))
  (let ((many s) (erased _)) (flatten txt))
  (let ((unique w2) (many _)) (world-do _ w1 (WriteOut s)))
  (def-unique RP $ (unique again : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program RP) next))
    (rstep f mv1 cks1 user c0 e1 ch1 v))
  (values w2 (Continue RP again)))

(def-fns _ $ (many rprog : (many (Nat) n) (many (List (Nat)) cks) -> (unique (Program RP) p))
  (def-unique RP $ (unique go : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program RP) next))
    (rstep n 0 cks 0 _ (MkRq (Zero) (Nil (Rn)) (BFalse) (Nil (Rn))) (rch0 l3) v))
  (Continue RP go))
