(sk-family Sk7 MkSk7 sk7-of ()
  (c-dd (1 DR "0110" TV "10110000" TV) (2 DL "10" TV "0000111111" TV)))
(comptime-match many (sk7-of p3) (ROk _ sg7))

(def-fns _ $ (many ct-dd : (many (List (Tk)) Z) (many (Tt) T) (many (List (Rn)) R3) (erased (List (Bool)) r u2 zr x3) (erased (Den R3 r) d3)
    (erased (Tb T r u2) tb2) (erased (Xb Z u2 zr) zb) -> (many (CtR T Z r u2 zr x3) res))
  (let ((many no)) (KtNo T Z r u2 zr x3))
  (let-match many T (Tt1) (else no))
  (let-match erased tb2 (Tb1 _))
  (let-match many (strip (bits "00111111111111011" (Nil (Bool))) R3 r d3) (StOk _ _ y1 R4 d4 cy) ((StNo _ _) no))
  (let-match erased (cat-fn (Bool) _ _ r _ cy $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _
      $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _
      $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatC _ _ _ _ _ $ CatN _ y1)
    (Refl _ _))
  (let-match many (strip (bits "0000" (Nil (Bool))) R4 y1 d4) (StOk _ _ r5 R5 d5 c4) ((StNo _ _) no))
  (let-match erased (cat4 r5 y1 c4) (Refl _ _))
  (let-match many Z (Cons _ z0 Z1) ((Nil _) no))
  (let-match many z0 (Tp) (else no))
  (let-match many Z1 (Cons _ z1 W) ((Nil _) no))
  (let-match many z1 (T1) (else no))
  (let-match many (sw-run (Cons _ (Succ (Succ (Succ (Zero)))) (Nil (Nat))) W) (SwOk _ _ sr sw) ((SwNo _ _) no))
  (let-match many sr (SEnd K) ((STurn _ _) no))
  (let-match many K (Cons _ kt K2) ((Nil _) no))
  (let-match many kt (Succ kt1) ((Zero) no))
  (let-match many kt1 (Succ kt2) ((Zero) no))
  (let-match many kt2 (Zero) ((Succ _) no))
  (let-match many K2 (Cons _ s0 K1) ((Nil _) no))
  (let ((many K0)) (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s0) K1)))
  (let ((many K5)) (Cons _ (Succ (Succ (Zero))) $ Cons _ (Succ (Succ (Zero))) $ Cons _ (Succ (Succ (Zero))) K0))
  (let ((many W5)) (Cons _ (Tp) $ Cons _ (Tp) $ Cons _ (T1) $ Cons _ (T0) $ Nil (Tk)))
  (let-match many (wk-run K5 W5) (WkOk _ _ Y wk) ((WkNo _ _) no))
  (let ((erased l)) (bits "00111" x3))
  (let ((erased e1) (erased cf1) (erased g1)) (gadget x3 u2 zr W zb))
  (let ((erased e2) (erased so) (erased g2)) (sw-ok _ W _ sw l u2 e1 cf1))
  (let-match erased so (SoE _ _ _ _ cf2))
  (let-match erased cf2 (CfB _ _ x2 _ _ _ ls2 xb2))
  (let-match erased xb2 (XbN _))
  (let ((erased v)) (bits "1111111111110110000" r5))
  (let ((erased x5) (erased ls3) (erased g3)) (merge (Tt1) (Pl1) s0 K1 l x2 v u2 (bits "1" v) ls2 (Tb1 _) (Tb1 _)))
  (let ((erased u3)) (bits "10110000" r5))
  (let ((erased cf3)) (CfB l u3 x5 _ K0 (Cons _ (T0) $ Cons _ (T0) $ Cons _ (T0) $ Cons _ (T0) $ Nil (Tk)) ls3
    (XbZ _ _ _ $ XbZ _ _ _ $ XbZ _ _ _ $ XbZ _ _ _ $ XbN u3)))
  (let ((erased K4)) (Cons (Nat) n2 $ Cons (Nat) n2 $ Cons (Nat) n2 $ Cons (Nat) n2 K0))
  (let ((erased e4) (erased so4) (erased g4))
    (sw-ok K0 _ (SEnd K4) (SwT0 K0 _ _ $ SwT0 _ _ _ $ SwT0 _ _ _ $ SwT0 _ _ _ $ SwEnd K4) l u3 (MkTc 1 (DR) x5 (bits "1" v)) cf3))
  (let-match erased so4 (SoE _ _ _ _ cf4))
  (let-match erased cf4 (CfB _ _ x4 _ _ _ ls4 xb4))
  (let-match erased xb4 (XbN _))
  (let-match erased ls4 (LsC _ y _ _ _ ls5 q))
  (let-match erased q (RpS _ _ _ _ q1))
  (let-match erased q1 (RpS _ _ _ _ q2))
  (let-match erased q2 (RpZ _ _))
  (let-match erased ls5 (LsC _ _ z2 _ _ _ _))
  (let ((erased cf5)) (CfH l r5 y _ K5 W5 ls5 (XbP _ _ _ $ XbP _ _ _ $ XbO _ _ _ $ XbZ _ _ _ $ XbN r5)))
  (let ((erased yr) (erased yb) (erased g6)) (wk-ok K5 W5 Y wk l r5 _ cf5 (PoP _)))
  (let ((erased t) (erased run))
    (go-run 2 2 _ _ _ _ _ _ (go-cat _ _ _ g1 $ go-cat _ _ _ g2 $ go-cat _ _ _ g3 $ go-cat _ _ _ g4 $ go-cat _ _ _ (go-dl _ _ _ _ _ (c-dd p3 sg7 z2 r5)) g6)))
  (KtOk T Z r u2 zr x3 Y (TtE) R5 r5 r5 yr d5 (TbE r5) yb n3 _ (rp3 _ x3) t run))

(def-fns _ $ (many nat-is : (many (Nat) a b) -> (many (Bool) r))
  (match many (nat-eq a b) _ ((Equal _ _ _) (BTrue)) (else (BFalse))))

(def-fns _ $ (many rn-at : (many (List (Rn)) R) (many (Bool) b) -> (many (Nat) n) (many (List (Rn)) R1))
  (let-match many R (Cons _ rn R1) ((Nil _) (values 0 R)))
  (let-match many rn (MkRn c n))
  (match many (eq-bit b c) _ ((ESome _ _) (values n R1)) ((ENone _) (values 0 R))))

(def-fns _ $ (many nmk : (subterm many (List (Rn)) R) -> (many (Nat) k))
  (let-match many R (Cons _ r1 R1) ((Nil _) 0))
  (let-match many R1 (Cons _ r2 R2) ((Nil _) 0))
  (let-match many r1 (MkRn b1 m))
  (let-match many r2 (MkRn b2 _))
  (let-match many b1 (BTrue) ((BFalse) 0))
  (let-match many b2 (BFalse) ((BTrue) 0))
  (let-match many (nat-eq m 6) (Equal _ _ _) (else 0))
  (Succ (notail $ nmk R2)))

(def-fns _ $ (many hc-ok : (subterm many (Nat) k) (many (List (Rn)) R) -> (many (Bool) ok))
  (let ((many m) (many R1)) (rn-at R (BTrue)))
  (let ((many g) (many R2)) (rn-at R1 (BFalse)))
  (let-match many (and (nat-is m 6) (nat-is g (monus (nat-shl 1 (nat-add 3 (nat-add k k))) 2))) (BTrue) ((BFalse) (BFalse)))
  (let-match many k (Succ k1)
    ((Zero)
      (let ((many d1) (many R3)) (rn-at R2 (BTrue)))
      (let ((many d2) (many R4)) (rn-at R3 (BFalse)))
      (let ((many d3) (many R5)) (rn-at R4 (BTrue)))
      (let ((many d4) (many _)) (rn-at R5 (BFalse)))
      (and (nat-is d1 12) (nat-is d2 1) (nat-is d3 2) (match many d4 (((Bool) b)) ((Zero) (BFalse)) ((Succ _) (BTrue))))))
  (tail $ hc-ok k1 R2))

(def-fns _ $ (many c-rounds : (subterm many (Nat) k) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many k (Succ k1) ((Zero) (RsOk l3 c0 e ch)))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (c-round c0 e ch (c-lm e c dc)) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (tail $ c-rounds k1 c0 e1 ch1))

(def-fns _ $ (many dd-out : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Nat) n) (many (List (Rn)) L0) (erased (List (Bool)) lz x0 xr) (erased (Den L0 lz) d0)
    (erased (Rp (BTrue) n lz x0) p0) (erased (Dc e (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr))) dc) (many (List (Tk)) X2) (many (Tt) T2) (many (List (Rn)) Rt) (erased (List (Bool)) rc2 v2 xr2) (erased (Den Rt rc2) dr2)
    (erased (Tb T2 rc2 v2) tb2) (erased (Xb X2 v2 xr2) xb2) (many (Nat) M) (erased (List (Bool)) x3) (erased (Rp (BTrue) M x0 x3) pm)
    (erased (Nat) t) (erased (Run l3 (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr)) t (MkConf 2 (bits "00" x3) (BTrue) (bits "0" xr2))) run)
    -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match many (ct-dd X2 T2 Rt rc2 v2 xr2 x3 dr2 tb2 xb2) (KtOk _ _ _ _ _ _ Y T4 R5 r5 u5 yr d5 tb5 yb m2 x4 p2 t2 run2) ((KtNo _ _ _ _ _ _) no))
  (let ((many M2) (erased aM)) (add m2 M))
  (let ((many sc) (erased as)) (add M2 n))
  (let ((erased t3) (erased run3)) (run-cat l3 _ _ _ t t2 run run2))
  (let ((many Lo)) (Cons _ (MkRn (BFalse) (Succ (Succ (Zero)))) (Cons _ (MkRn (BTrue) sc) L0)))
  (let ((erased dLo)) (DeC (BFalse) n2 (Cons _ (MkRn (BTrue) sc) L0) x4 (bits "00" x4)
    (DeC (BTrue) sc L0 lz x4 d0 (rp-add (BTrue) M2 n sc lz x0 x4 (rp-add (BTrue) m2 M M2 x0 x3 x4 p2 pm aM) p0 as)) (rp2 _ x4)))
  (let-match many (xtr Y T4) (MkXTR _ _ U3 u3 pu3 dU3))
  (let ((many C) (erased dC)) (push (BFalse) U3 u3 dU3))
  (let ((many Ro) (erased ro) (erased dRo) (erased cro)) (rapp C (Cons (Bool) (BFalse) u3) dC R5 r5 d5))
  (let-match erased cro (CatC _ _ _ _ zr2 cz))
  (let ((erased v3) (erased tb3) (erased zb3)) (xt-cat Y T4 u3 r5 zr2 pu3 cz))
  (let-match erased (tb-fn T4 r5 u5 v3 tb5 tb3) (Refl _ _))
  (let-match erased (xb-fn Y u5 yr zr2 yb zb3) (Refl _ _))
  (let ((many e1)) (MkRq 2 Lo (BTrue) Ro))
  (RsOk l3 c0 e1 (rch-run l3 c0 _ _ e _ t3 ch dc run3 (MkDc 2 Lo Ro (BTrue) (bits "00" x4) ro dLo dRo))))

(def-fns _ $ (many c-aend : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc0 z))
  (let-match many (c-lm e c dc0) (LmOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc) ((LmNo _) no))
  (let-match many (and (nat-is n 2) (match many T (((Bool) b)) ((Tt1) (BTrue)) (else (BFalse)))) (BTrue) ((BFalse) no))
  (let ((many G) (many Rm)) (rn-at R1 (BFalse)))
  (let-match many (nmk Rm) (Succ q) ((Zero) no))
  (let-match many (hc-ok q Rm) (BTrue) ((BFalse) no))
  (let-match many (decode X T) (DecOk F0 s0) ((DecNo) no))
  (let-match many (id-at F0 s0 X T) (IdOk _ _ F s nb ok mx bn ph) ((IdNo _ _) no))
  (let-match many (and (match many F (((Bool) b)) ((FO _ _) (BTrue)) (else (BFalse))) (nat-is (nat-add s 2) nb)) (BTrue) ((BFalse) no))
  (let ((many ex) (erased a1) (erased b1) (erased ra1) (erased tbn1) (erased ae1)) (cells X T))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X T u y xr px cu))
  (let-match many (ms-loop 100000 (BTrue) (BTrue) F s nb ok mx bn X T ph ex a1 b1 ra1 tbn1 ae1 R1 y v xr d1 tb xb n lz x0 p0 ex ex (Zero))
    (MkMsL _ _ _ _ _ _ F2 s2 X2 T2 ph2 Rt rc2 v2 xr2 dr2 tb2 xb2 M st x3 pm t run _ _ _))
  (let-match many (dd-out c0 e ch n L0 lz x0 xr d0 p0 dc X2 T2 Rt rc2 v2 xr2 dr2 tb2 xb2 M x3 pm t run) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) no))
  (let-match many (c-rounds 2 c0 e1 ch1)
    (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) no))
  (RsOk l3 c0 e2 ch2))
