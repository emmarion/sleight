(def-adts $ (BByte : ((String) s) -> Type)
  enum
  (many BEnd : -> (BByte (SNil)))
  (many BAt : (many (Nat) n) (erased (Lt n u8-modulus) p) (many (String) r) -> (BByte (SCons (MkChar (MkU8 n p)) r))))

(def-fns _ $ (many bnext : (many (String) s) -> (many (BByte s) x))
  (let-match many s (SCons c r) ((SNil) (BEnd)))
  (let-match many c (MkChar u))
  (let-match many u (MkU8 n p))
  (BAt n p r))

(def-adts $ (BRes : (Type A) ((TyCtor ((String) s) (A x) ((String) r) -> Type) R) ((String) s) -> Type)
  enum
  (many BOk : (erased Type A) (erased (TyCtor ((String) s) (A x) ((String) r) -> Type) R) (erased (String) s) (many A x) (many (String) r) (erased (R s x r) d)
     -> (BRes A R s))
  (many BNo : (erased Type A) (erased (TyCtor ((String) s) (A x) ((String) r) -> Type) R) (erased (String) s) -> (BRes A R s)))

(def-adts $ (BNum : ((String) s) ((Nat) n) ((String) r) -> Type)
  enum
  (many BnEnd : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (BNum (SCons (MkChar (MkU8 (Zero) p)) r) (Zero) r))
  (many BnDig : (erased (Nat) d m bm n) (erased (Lt (Succ d) u8-modulus) p) (erased (String) s r) (erased (BNum s m r) q) (erased (Mul m 255 bm) mm)
     (erased (Add d bm n) ad) -> (BNum (SCons (MkChar (MkU8 (Succ d) p)) s) n r)))

(def-adts $ (BNs : ((String) s) ((Nat) k) ((List (Nat)) xs) ((String) r) -> Type)
  enum
  (many BsNil : (erased (String) s) -> (BNs s (Zero) (Nil (Nat)) s))
  (many BsCons : (erased (Nat) k x) (erased (List (Nat)) xs) (erased (String) s r1 r) (erased (BNum s x r1) p) (erased (BNs r1 k xs r) q)
     -> (BNs s (Succ k) (Cons (Nat) x xs) r)))

(def-adts $ (BBit : ((String) s) ((Bool) b) ((String) r) -> Type)
  enum
  (many BbF : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (BBit (SCons (MkChar (MkU8 (Zero) p)) r) (BFalse) r))
  (many BbT : (erased (Lt (Succ (Zero)) u8-modulus) p) (erased (String) r) -> (BBit (SCons (MkChar (MkU8 (Succ (Zero)) p)) r) (BTrue) r)))

(def-adts
  ((BP : ((String) s) ((PGen) g) ((String) r) -> Type)
    enum
    (many BpNil : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (BP (SCons (MkChar (MkU8 (Zero) p)) r) (PNil) r))
    (many BpDig : (erased (Lt (Succ (Zero)) u8-modulus) p) (erased (Nat) k b n) (erased (PGen) g) (erased (String) s r1 r)
       (erased (BNs s (Succ (Succ (Succ (Zero)))) (Cons (Nat) k (Cons (Nat) b (Cons (Nat) n (Nil (Nat))))) r1) ns) (erased (BP r1 g r) q)
       -> (BP (SCons (MkChar (MkU8 (Succ (Zero)) p)) s) (PDig k b n g) r))
    (many BpG : (erased (Lt (Succ (Succ (Zero))) u8-modulus) p) (erased (NGen) h) (erased (PGen) g) (erased (String) s r1 r) (erased (BN s h r1) q1)
       (erased (BP r1 g r) q) -> (BP (SCons (MkChar (MkU8 (Succ (Succ (Zero))) p)) s) (PG h g) r)))
  ((BN : ((String) s) ((NGen) g) ((String) r) -> Type)
    enum
    (many BgNil : (erased (Lt (Zero) u8-modulus) p) (erased (String) r) -> (BN (SCons (MkChar (MkU8 (Zero) p)) r) (GNil) r))
    (many BgCons : (erased (Lt (Succ (Zero)) u8-modulus) p) (erased (Nat) x) (erased (NGen) g) (erased (String) s r1 r) (erased (BNum s x r1) p1)
       (erased (BN r1 g r) q) -> (BN (SCons (MkChar (MkU8 (Succ (Zero)) p)) s) (GCons x g) r))
    (many BgRep : (erased (Lt (Succ (Succ (Zero))) u8-modulus) p) (erased (Nat) k) (erased (NGen) b g) (erased (String) s r1 r2 r) (erased (BNum s k r1) p1)
       (erased (BN r1 b r2) q1) (erased (BN r2 g r) q) -> (BN (SCons (MkChar (MkU8 (Succ (Succ (Zero))) p)) s) (GRep k b g) r))
    (many BgTrn : (erased (Lt (Succ (Succ (Succ (Zero)))) u8-modulus) p) (erased (Nat) k v a c sb) (erased (NGen) bf af g) (erased (String) s r1 r2 r3 r)
       (erased (BNs s (Succ (Succ (Succ (Succ (Succ (Zero)))))) (Cons (Nat) k (Cons (Nat) v (Cons (Nat) a (Cons (Nat) c (Cons (Nat) sb (Nil (Nat))))))) r1) ns)
       (erased (BN r1 bf r2) q1) (erased (BN r2 af r3) q2) (erased (BN r3 g r) q)
       -> (BN (SCons (MkChar (MkU8 (Succ (Succ (Succ (Zero)))) p)) s) (GTrn k v a c sb (MkGBlk bf af) g) r))))

(def-adts $ (BQ : ((String) s) ((PQ) g) ((String) r) -> Type)
  enum
  (many MkBQ : (erased (Nat) q) (erased (Bool) h bl br) (erased (PGen) gl gr) (erased (String) s r1 r2 r3 r4 r5 r)
     (erased (BNum s q r1) p1) (erased (BBit r1 h r2) p2) (erased (BBit r2 bl r3) p3) (erased (BP r3 gl r4) p4) (erased (BBit r4 br r5) p5) (erased (BP r5 gr r) p6)
     -> (BQ s (MkPQ q h bl gl br gr) r)))

(def-fns _ $ (erased bnum-fn : (erased (String) s r r2) (erased (Nat) n n2) (subterm erased (BNum s n r) p) (erased (BNum s n2 r2) q)
    -> (erased (Eq (Nat) n n2) e1) (erased (Eq (String) r r2) e2))
  (match erased p _
    ((BnEnd _ _) (let-match erased q (BnEnd _ _)) (values (Refl _ n) (Refl _ r)))
    ((BnDig d m bm _ _ s1 _ p1 mm ad)
      (let-match erased q (BnDig _ m2 bm2 _ _ _ _ q1 mm2 ad2))
      (let ((erased e1) (erased e2)) (bnum-fn s1 r r2 m m2 p1 q1))
      (let-match erased e1 (Refl _ _))
      (let-match erased (mul-fn m 255 bm bm2 mm mm2) (Refl _ _))
      (values (add-fn d bm n n2 ad ad2) e2))))

(def-fns _ $ (erased bns-fn : (erased (String) s r r2) (erased (Nat) k) (erased (List (Nat)) xs ys) (subterm erased (BNs s k xs r) p) (erased (BNs s k ys r2) q)
    -> (erased (Eq (List (Nat)) xs ys) e1) (erased (Eq (String) r r2) e2))
  (match erased p _
    ((BsNil _) (let-match erased q (BsNil _)) (values (Refl _ xs) (Refl _ r)))
    ((BsCons k1 x xs1 _ r1 _ p1 q1)
      (let-match erased q (BsCons _ y ys1 _ t1 _ p2 q2))
      (let ((erased a1) (erased b1)) (bnum-fn s r1 t1 x y p1 p2))
      (let-match erased a1 (Refl _ _))
      (let-match erased b1 (Refl _ _))
      (let ((erased a2) (erased b2)) (bns-fn r1 r r2 k1 xs1 ys1 q1 q2))
      (let-match erased a2 (Refl _ _))
      (values (Refl _ xs) b2))))

(def-fns _ $ (erased bbit-fn : (erased (String) s r r2) (erased (Bool) a b) (erased (BBit s a r) p) (erased (BBit s b r2) q)
    -> (erased (Eq (Bool) a b) e1) (erased (Eq (String) r r2) e2))
  (match erased p _
    ((BbF _ _) (let-match erased q (BbF _ _)) (values (Refl _ a) (Refl _ r)))
    ((BbT _ _) (let-match erased q (BbT _ _)) (values (Refl _ a) (Refl _ r)))))

(def-fns _
  ((erased bp-fn : (erased (String) s r r2) (erased (PGen) g g2) (subterm erased (BP s g r) p) (erased (BP s g2 r2) q)
      -> (erased (Eq (PGen) g g2) e1) (erased (Eq (String) r r2) e2))
    (match erased p _
      ((BpNil _ _) (let-match erased q (BpNil _ _)) (values (Refl _ g) (Refl _ r)))
      ((BpDig _ k b n g1 s1 r1 _ ns p1)
        (let-match erased q (BpDig _ _ _ _ h1 _ t1 _ ns2 q1))
        (let ((erased a1) (erased b1)) (bns-fn s1 r1 t1 _ _ _ ns ns2))
        (let-match erased a1 (Refl _ _))
        (let-match erased b1 (Refl _ _))
        (let ((erased a2) (erased b2)) (bp-fn r1 r r2 g1 h1 p1 q1))
        (let-match erased a2 (Refl _ _))
        (values (Refl _ g) b2))
      ((BpG _ h g1 s1 r1 _ p0 p1)
        (let-match erased q (BpG _ h2 g2' _ t1 _ q0 q1))
        (let ((erased a1) (erased b1)) (bn-fn s1 r1 t1 h h2 p0 q0))
        (let-match erased a1 (Refl _ _))
        (let-match erased b1 (Refl _ _))
        (let ((erased a2) (erased b2)) (bp-fn r1 r r2 g1 g2' p1 q1))
        (let-match erased a2 (Refl _ _))
        (values (Refl _ g) b2))))
  ((erased bn-fn : (erased (String) s r r2) (erased (NGen) g g2) (subterm erased (BN s g r) p) (erased (BN s g2 r2) q)
      -> (erased (Eq (NGen) g g2) e1) (erased (Eq (String) r r2) e2))
    (match erased p _
      ((BgNil _ _) (let-match erased q (BgNil _ _)) (values (Refl _ g) (Refl _ r)))
      ((BgCons _ x g1 s1 r1 _ p0 p1)
        (let-match erased q (BgCons _ y h1 _ t1 _ q0 q1))
        (let ((erased a1) (erased b1)) (bnum-fn s1 r1 t1 x y p0 q0))
        (let-match erased a1 (Refl _ _))
        (let-match erased b1 (Refl _ _))
        (let ((erased a2) (erased b2)) (bn-fn r1 r r2 g1 h1 p1 q1))
        (let-match erased a2 (Refl _ _))
        (values (Refl _ g) b2))
      ((BgRep _ k b g1 s1 r1 rr2 _ p0 pb p1)
        (let-match erased q (BgRep _ k2 b2 h1 _ t1 tt2 _ q0 qb q1))
        (let ((erased a1) (erased c1)) (bnum-fn s1 r1 t1 k k2 p0 q0))
        (let-match erased a1 (Refl _ _))
        (let-match erased c1 (Refl _ _))
        (let ((erased a2) (erased c2)) (bn-fn r1 rr2 tt2 b b2 pb qb))
        (let-match erased a2 (Refl _ _))
        (let-match erased c2 (Refl _ _))
        (let ((erased a3) (erased c3)) (bn-fn rr2 r r2 g1 h1 p1 q1))
        (let-match erased a3 (Refl _ _))
        (values (Refl _ g) c3))
      ((BgTrn _ k v a c sb bf af g1 s1 r1 rr2 r3 _ ns pf pa p1)
        (let-match erased q (BgTrn _ _ _ _ _ _ bf2 af2 h1 _ t1 tt2 t3 _ ns2 qf qa q1))
        (let ((erased a1) (erased c1)) (bns-fn s1 r1 t1 _ _ _ ns ns2))
        (let-match erased a1 (Refl _ _))
        (let-match erased c1 (Refl _ _))
        (let ((erased a2) (erased c2)) (bn-fn r1 rr2 tt2 bf bf2 pf qf))
        (let-match erased a2 (Refl _ _))
        (let-match erased c2 (Refl _ _))
        (let ((erased a3) (erased c3)) (bn-fn rr2 r3 t3 af af2 pa qa))
        (let-match erased a3 (Refl _ _))
        (let-match erased c3 (Refl _ _))
        (let ((erased a4) (erased c4)) (bn-fn r3 r r2 g1 h1 p1 q1))
        (let-match erased a4 (Refl _ _))
        (values (Refl _ g) c4)))))

(def-fns _ $ (erased bq-fn : (erased (String) s r r2) (erased (PQ) g g2) (erased (BQ s g r) p) (erased (BQ s g2 r2) q)
    -> (erased (Eq (PQ) g g2) e1) (erased (Eq (String) r r2) e2))
  (let-match erased p (MkBQ n h bl br gl gr _ r1 rr2 r3 r4 r5 _ p1 p2 p3 p4 p5 p6))
  (let-match erased q (MkBQ n' h' bl' br' gl' gr' _ t1 tt2 t3 t4 t5 _ q1 q2 q3 q4 q5 q6))
  (let ((erased a1) (erased c1)) (bnum-fn s r1 t1 n n' p1 q1))
  (let-match erased a1 (Refl _ _))
  (let-match erased c1 (Refl _ _))
  (let ((erased a2) (erased c2)) (bbit-fn r1 rr2 tt2 h h' p2 q2))
  (let-match erased a2 (Refl _ _))
  (let-match erased c2 (Refl _ _))
  (let ((erased a3) (erased c3)) (bbit-fn rr2 r3 t3 bl bl' p3 q3))
  (let-match erased a3 (Refl _ _))
  (let-match erased c3 (Refl _ _))
  (let ((erased a4) (erased c4)) (bp-fn r3 r4 t4 gl gl' p4 q4))
  (let-match erased a4 (Refl _ _))
  (let-match erased c4 (Refl _ _))
  (let ((erased a5) (erased c5)) (bbit-fn r4 r5 t5 br br' p5 q5))
  (let-match erased a5 (Refl _ _))
  (let-match erased c5 (Refl _ _))
  (let ((erased a6) (erased c6)) (bp-fn r5 r r2 gr gr' p6 q6))
  (let-match erased a6 (Refl _ _))
  (values (Refl _ g) c6))

(def-fns _ $ (many dec-num : (subterm many (String) s) -> (many (BRes (Nat) BNum s) o))
  (let-match many (bnext s) (BAt n p r) ((BEnd) (BNo _ _ _)))
  (let-match many n (Succ d) ((Zero) (BOk _ _ _ (Zero) r (BnEnd p r))))
  (let-match many (notail $ dec-num r) (BOk _ _ _ m r2 q) (else (BNo _ _ _)))
  (let ((many bm) (erased mm)) (mul m 255))
  (let ((many v) (erased ad)) (add d bm))
  (BOk _ _ _ v r2 (BnDig d m bm v p r r2 q mm ad)))

(def-adts $ (BNsR : ((String) s) ((Nat) k) -> Type)
  enum
  (many BsOk : (erased (String) s) (erased (Nat) k) (many (List (Nat)) xs) (many (String) r) (erased (BNs s k xs r) d) -> (BNsR s k))
  (many BsNo : (erased (String) s) (erased (Nat) k) -> (BNsR s k)))

(def-fns _ $ (many dec-ns : (subterm many (Nat) k) (many (String) s) -> (many (BNsR s k) o))
  (let-match many k (Succ k1) ((Zero) (BsOk s k (Nil _) s (BsNil s))))
  (let-match many (dec-num s) (BOk _ _ _ x r1 p) (else (BsNo s k)))
  (let-match many (notail $ dec-ns k1 r1) (BsOk _ _ xs r q) ((BsNo _ _) (BsNo s k)))
  (BsOk s k (Cons _ x xs) r (BsCons k1 x xs s r1 r p q)))

(def-fns _ $ (many dec-bit : (many (String) s) -> (many (BRes (Bool) BBit s) o))
  (let-match many (bnext s) (BAt n p r) ((BEnd) (BNo _ _ _)))
  (let-match many n (Succ k) ((Zero) (BOk _ _ _ (BFalse) r (BbF p r))))
  (let-match many k (Zero) (else (BNo _ _ _)))
  (BOk _ _ _ (BTrue) r (BbT p r)))

(def-fns _
  ((many dec-p : (subterm many (Nat) fuel) (many (String) s) -> (many (BRes (PGen) BP s) o))
    (let-match many fuel (Succ f) ((Zero) (BNo _ _ _)))
    (let-match many (bnext s) (BAt n p t) ((BEnd) (BNo _ _ _)))
    (let-match many n (Succ n1) ((Zero) (BOk _ _ _ (PNil) t (BpNil p t))))
    (let-match many n1 (Succ n2)
      ((Zero)
        (let-match many (dec-ns (Succ (Succ (Succ (Zero)))) t) (BsOk _ _ xs r1 ns) ((BsNo _ _) (BNo _ _ _)))
        (let-match many xs (Cons _ k x1) ((Nil _) (BNo _ _ _)))
        (let-match many x1 (Cons _ b x2) ((Nil _) (BNo _ _ _)))
        (let-match many x2 (Cons _ m x3) ((Nil _) (BNo _ _ _)))
        (let-match many x3 (Nil _) ((Cons _ _ _) (BNo _ _ _)))
        (let-match many (notail $ dec-p f r1) (BOk _ _ _ g r q) (else (BNo _ _ _)))
        (BOk _ _ _ (PDig k b m g) r (BpDig p k b m g t r1 r ns q))))
    (let-match many n2 (Zero) (else (BNo _ _ _)))
    (let-match many (notail $ dec-n f t) (BOk _ _ _ h r1 q1) (else (BNo _ _ _)))
    (let-match many (notail $ dec-p f r1) (BOk _ _ _ g r q) (else (BNo _ _ _)))
    (BOk _ _ _ (PG h g) r (BpG p h g t r1 r q1 q)))
  ((many dec-n : (subterm many (Nat) fuel) (many (String) s) -> (many (BRes (NGen) BN s) o))
    (let-match many fuel (Succ f) ((Zero) (BNo _ _ _)))
    (let-match many (bnext s) (BAt n p t) ((BEnd) (BNo _ _ _)))
    (let-match many n (Succ n1) ((Zero) (BOk _ _ _ (GNil) t (BgNil p t))))
    (let-match many n1 (Succ n2)
      ((Zero)
        (let-match many (dec-num t) (BOk _ _ _ x r1 p1) (else (BNo _ _ _)))
        (let-match many (notail $ dec-n f r1) (BOk _ _ _ g r q) (else (BNo _ _ _)))
        (BOk _ _ _ (GCons x g) r (BgCons p x g t r1 r p1 q))))
    (let-match many n2 (Succ n3)
      ((Zero)
        (let-match many (dec-num t) (BOk _ _ _ k r1 p1) (else (BNo _ _ _)))
        (let-match many (notail $ dec-n f r1) (BOk _ _ _ b r2 q1) (else (BNo _ _ _)))
        (let-match many (notail $ dec-n f r2) (BOk _ _ _ g r q) (else (BNo _ _ _)))
        (BOk _ _ _ (GRep k b g) r (BgRep p k b g t r1 r2 r p1 q1 q))))
    (let-match many n3 (Zero) (else (BNo _ _ _)))
    (let-match many (dec-ns (Succ (Succ (Succ (Succ (Succ (Zero)))))) t) (BsOk _ _ xs r1 ns) ((BsNo _ _) (BNo _ _ _)))
    (let-match many xs (Cons _ k x1) ((Nil _) (BNo _ _ _)))
    (let-match many x1 (Cons _ v x2) ((Nil _) (BNo _ _ _)))
    (let-match many x2 (Cons _ a x3) ((Nil _) (BNo _ _ _)))
    (let-match many x3 (Cons _ c x4) ((Nil _) (BNo _ _ _)))
    (let-match many x4 (Cons _ sb x5) ((Nil _) (BNo _ _ _)))
    (let-match many x5 (Nil _) ((Cons _ _ _) (BNo _ _ _)))
    (let-match many (notail $ dec-n f r1) (BOk _ _ _ bf r2 q1) (else (BNo _ _ _)))
    (let-match many (notail $ dec-n f r2) (BOk _ _ _ af r3 q2) (else (BNo _ _ _)))
    (let-match many (notail $ dec-n f r3) (BOk _ _ _ g r q) (else (BNo _ _ _)))
    (BOk _ _ _ (GTrn k v a c sb (MkGBlk bf af) g) r (BgTrn p k v a c sb bf af g t r1 r2 r3 r ns q1 q2 q))))

(def-fns _ $ (many dec-q : (many (String) s) -> (many (BRes (PQ) BQ s) o))
  (let-match many (dec-num s) (BOk _ _ _ q r1 p1) (else (BNo _ _ _)))
  (let-match many (dec-bit r1) (BOk _ _ _ h r2 p2) (else (BNo _ _ _)))
  (let-match many (dec-bit r2) (BOk _ _ _ bl r3 p3) (else (BNo _ _ _)))
  (let-match many (dec-p 1000000000 r3) (BOk _ _ _ gl r4 p4) (else (BNo _ _ _)))
  (let-match many (dec-bit r4) (BOk _ _ _ br r5 p5) (else (BNo _ _ _)))
  (let-match many (dec-p 1000000000 r5) (BOk _ _ _ gr r p6) (else (BNo _ _ _)))
  (BOk _ _ _ (MkPQ q h bl gl br gr) r (MkBQ q h bl br gl gr s r1 r2 r3 r4 r5 r p1 p2 p3 p4 p5 p6)))

(def-adts $ (GenB : ((String) s) ((Rq) e) -> Type)
  enum
  (many MkGenB : (erased (String) s r) (erased (PQ) g) (erased (Rq) e) (erased (BQ s g r) d) (erased (GenP g e) p) -> (GenB s e)))

(def-fns _ $ (erased genb-fn : (erased (String) s) (erased (Rq) e e2) (erased (GenB s e) p) (erased (GenB s e2) p2) -> (erased (Eq (Rq) e e2) r))
  (let-match erased p (MkGenB _ r g _ d gp))
  (let-match erased p2 (MkGenB _ r2 g2 _ d2 gp2))
  (let ((erased a) (erased _)) (bq-fn s r r2 g g2 d d2))
  (let-match erased a (Refl _ _))
  (genp-fn g e e2 gp gp2))

(def-adts $ (GBR : ((String) s) -> Type)
  enum
  (many GBOk : (erased (String) s) (many (Rq) e) (erased (GenB s e) p) -> (GBR s))
  (many GBNo : (erased (String) s) -> (GBR s)))

(def-fns _ $ (many gen-b : (many (String) s) -> (many (GBR s) o))
  (let-match many (dec-q s) (BOk _ _ _ g r d) (else (GBNo s)))
  (let-match many (gen-p g) (GPOk _ e p) ((GPNo _) (GBNo s)))
  (GBOk s e (MkGenB s r g e d p)))

(def-adts
  ((RchB : ((List (Tr)) m) ((Conf) c0) ((String) g) -> Type)
    enum
    (many MkRchB : (erased (List (Tr)) m) (erased (Conf) c0) (erased (String) g) (erased (Rq) e) (erased (GenB g e) p) (erased (Rch m c0 e) ch) -> (RchB m c0 g))))

(def-adts
  ((ReachB : ((List (Tr)) m) ((String) g g2) -> Type)
    enum
    (many MkReachB : (erased (List (Tr)) m) (erased (String) g g2) (erased (Rq) e e2) (erased (GenB g e) p) (erased (GenB g2 e2) p2) (erased (ReachQ m e e2) rr)
       -> (ReachB m g g2))))

(def-adts
  ((SpanB : ((List (Tr)) m) ((String) g) ((Nat) n) -> Type)
    enum
    (many MkSpanB : (erased (List (Tr)) m) (erased (String) g) (erased (Nat) n) (erased (Level) lv)
       (erased (Fn lv (erased (RchB m (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) g) ch) -> (erased (Span m (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) n) s)) f)
       -> (SpanB m g n))))

(def-fns _ $ (erased rchb-cat : (erased (List (Tr)) m) (erased (Conf) c0) (erased (String) g g2) (erased (RchB m c0 g) ch) (erased (ReachB m g g2) rg)
    -> (erased (RchB m c0 g2) ch2))
  (let-match erased ch (MkRchB _ _ _ e p c))
  (let-match erased rg (MkReachB _ _ _ e1 e2 p1 p2 rr))
  (let-match erased (genb-fn g e e1 p p1) (Refl _ _))
  (MkRchB m c0 g2 e2 p2 (rr-cat m c0 e e2 c rr)))

(def-fns _ $ (many rb-first : (many (Nat) n) (many (List (Nat)) sc) (many (String) g2) -> (many (Res (RchB l3 (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) g2)) r))
  (let-match many (gen-b g2) (GBOk _ e2 p2) ((GBNo _) (RFail _)))
  (let ((many e)) (MkRq (Zero) (Nil (Rn)) (BFalse) (Nil (Rn))))
  (let ((many f) (erased rr)) (run-from6 n sc e))
  (let-match many (rq-eq f e2) (ESome _ eq) ((ENone _) (RFail _)))
  (let-match erased eq (Refl _ _))
  (ROk _ (MkRchB l3 _ g2 e2 p2 (rr-cat l3 _ e f (rch0 l3) rr))))

(def-fns _ $ (many rb-run : (many (Nat) n) (many (List (Nat)) sc) (many (String) g g2) -> (many (Res (ReachB l3 g g2)) r))
  (let-match many (gen-b g) (GBOk _ e p) ((GBNo _) (RFail _)))
  (let-match many (gen-b g2) (GBOk _ e2 p2) ((GBNo _) (RFail _)))
  (let ((many f) (erased rr)) (run-from6 n sc e))
  (let-match many (rq-eq f e2) (ESome _ eq) ((ENone _) (RFail _)))
  (let-match erased eq (Refl _ _))
  (ROk _ (MkReachB l3 g g2 e e2 p p2 rr)))

(def-fns _ $ (many rb-span : (many (Nat) n) (many (List (Nat)) sc) (many (Nat) bnd) (many (String) g) -> (many (Res (SpanB l3 g bnd)) r))
  (let-match many (gen-b g) (GBOk _ e p) ((GBNo _) (RFail _)))
  (let ((many f) (erased rr)) (run-from6 n sc e))
  (let-match many (span-all l3 bnd f) (ROk _ sa) ((RFail _) (RFail _)))
  (let-match erased sa (MkSpanAll _ _ _ lv h))
  (def-fns _ $ (erased span-of : (erased (RchB l3 (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) g) ch) -> (erased (Span l3 (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) bnd) s))
    (let-match erased ch (MkRchB _ _ _ e1 p1 c))
    (let-match erased (genb-fn g e1 e p1 p) (Refl _ _))
    (h (rr-cat l3 _ e f c rr)))
  (ROk _ (MkSpanB l3 g bnd (level-of span-of) span-of)))
