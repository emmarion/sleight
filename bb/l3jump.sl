(def-adts
  ((RdK : ((Nat) k) ((List (Tk)) X) ((Tt) T) ((List (Tk)) Z) ((Tt) U) ((Nat) w) -> Type)
    enum
    (many RkZ : (erased (List (Tk)) X) (erased (Tt) T) -> (RdK (Zero) X T X T (Zero)))
    (many RkS : (erased (Nat) k c u w) (erased (List (Tk)) X Y Z) (erased (Tt) T T2 U) (erased (Rd X T Y T2 c) rd)
       (erased (RdK k Y T2 Z U u) rk) (erased (Add c u w) a) -> (RdK (Succ k) X T Z U w))))

(def-fns _ $ (erased rp-peel3 : (erased (Bool) b) (erased (Nat) n) (erased (List (Bool)) t x y)
    (erased (Rp b n t x) p) (erased (Rp b (Succ (Succ (Succ n))) t y) q) -> (erased (Rp b n3 x y) r))
  (let-match erased q (RpS _ _ _ y1 q1))
  (let-match erased q1 (RpS _ _ _ y2 q2))
  (let-match erased q2 (RpS _ _ _ y3 q3))
  (let-match erased (rp-fn b n t x y3 p q3) (Refl _ _))
  (rp3 b x))

(def-fns _ $ (erased rdk-run : (erased (Nat) k w n) (erased (List (Tk)) X Z) (erased (Tt) T U) (subterm erased (RdK k X T Z U w) rk)
    (erased (List (Bool)) lz r x0 rc v xr) (erased (Rp (BTrue) n lz x0) p0) (erased (Rp (BFalse) w r rc) pw) (erased (Tb T rc v) tb) (erased (Xb X v xr) xb) ->
    (erased (Nat) m) (erased (Mul k n3 m) mk) (erased (List (Bool)) x3 u2 zr) (erased (Rp (BTrue) m x0 x3) p1) (erased (Tb U r u2) tb2) (erased (Xb Z u2 zr) zb)
    (erased (Nat) t) (erased (Run l3 (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr)) t (MkConf 2 (bits "00" x3) (BTrue) (bits "0" zr))) run))
  (match erased rk _
    ((RkZ _ _)
      (let-match erased pw (RpZ _ _))
      (values (Zero) (MulZero n3) x0 v xr (RpZ _ x0) tb xb (Zero) (RNil l3 _)))
    ((RkS k1 c u _ _ Y _ _ T2 _ rd rk1 a)
      (let ((erased mid) (erased pu) (erased pc)) (rp-split (BFalse) c u w r rc a pw))
      (let ((erased x1) (erased u1) (erased yr) (erased p1) (erased tb1) (erased yb) (erased t1) (erased run1))
        (round-run X Y T T2 c n rd lz mid x0 rc v xr p0 pc tb xb))
      (let ((erased m1) (erased mk1) (erased x3) (erased u2) (erased zr) (erased p3) (erased tb2) (erased zb) (erased t2) (erased run2))
        (rdk-run k1 u (Succ (Succ (Succ n))) Y Z T2 U rk1 lz r x1 mid u1 yr p1 pu tb1 yb))
      (let ((erased m) (erased am)) (add-ex m1 n3))
      (let ((erased t) (erased run)) (run-cat l3 _ _ _ t1 t2 run1 run2))
      (values m (MulSucc k1 n3 m1 m mk1 am) x3 u2 zr (rp-add (BTrue) m1 n3 m x0 x1 x3 p3 (rp-peel3 (BTrue) n lz x0 x1 p0 p1) am) tb2 zb t run))))

(def-fns _ $ (erased rl-ex : (subterm erased (List (Tk)) X) (erased (Nat) z) -> (erased (Nat) n) (erased (Rl X z n) r))
  (let-match erased X (Cons _ x X1) ((Nil _) (values z (RlN z))))
  (let ((erased n1) (erased r1)) (rl-ex X1 z))
  (match erased x _
    ((Tp) (values (Succ n1) (RlP X1 z n1 r1)))
    ((T0) (values (Succ (Succ (Succ n1))) (RlZ X1 z n1 r1)))
    ((T1) (values (Succ (Succ (Succ (Succ n1)))) (RlO X1 z n1 r1)))))

(def-fns _ $ (erased rdk-cells : (erased (Nat) k w) (erased (List (Tk)) X Z) (erased (Tt) T U) (subterm erased (RdK k X T Z U w) rk)
    (erased (Nat) a b a2 b2 e e2 m) (erased (Rl X (Zero) a) ra) (erased (Tn T (Zero) b) wb) (erased (Rl Z (Zero) a2) ra2) (erased (Tn U (Zero) b2) wb2)
    (erased (Add a b e) ae) (erased (Add a2 b2 e2) ae2) (erased (Mul k n3 m) mk) -> (erased (Nat) s) (erased (Add e w s) q1) (erased (Add e2 m s) q2))
  (match erased rk _
    ((RkZ _ _)
      (let-match erased mk (MulZero _))
      (let-match erased (rl-fn X (Zero) a a2 ra ra2) (Refl _ _))
      (let-match erased (add-zero-eq b b2 (tn-add T (Zero) b2 b wb2 wb)) (Refl _ _))
      (let-match erased (add-fn a b e e2 ae ae2) (Refl _ _))
      (values e (add-zero-right e) (add-zero-right e)))
    ((RkS k1 c u _ _ Y _ _ T2 _ rd rk1 acu)
      (let-match erased mk (MulSucc _ _ m1 _ mk1 am))
      (let ((erased aY) (erased raY)) (rl-ex Y (Zero)))
      (let ((erased bY) (erased wbY)) (tn-ex T2 (Zero)))
      (let ((erased eY) (erased aeY)) (add-ex aY bY))
      (let ((erased s1) (erased ab) (erased aYb) (erased q1) (erased q2) (erased q3) (erased q4)) (rd-cells X Y T T2 c rd a b aY bY ra wb raY wbY))
      (let-match erased (add-fn a b ab e q1 ae) (Refl _ _))
      (let-match erased (add-fn aY bY aYb eY q3 aeY) (Refl _ _))
      (let ((erased s2) (erased p1) (erased p2)) (rdk-cells k1 u Y Z T2 U rk1 aY bY a2 b2 eY e2 m1 raY wbY ra2 wb2 aeY ae2 mk1))
      (let ((erased S) (erased aS)) (add-ex s1 u))
      (let ((erased cu) (erased acu2) (erased aeS)) (add-assoc e c u s1 S q2 aS))
      (let-match erased (add-fn c u cu w acu2 acu) (Refl _ _))
      (let ((erased uw) (erased auw) (erased auw3)) (add-rot eY n3 u s1 S q4 aS))
      (let-match erased (add-fn eY u uw s2 auw p1) (Refl _ _))
      (let ((erased bc) (erased abc) (erased aS2)) (add-assoc e2 m1 n3 s2 S p2 auw3))
      (let-match erased (add-fn m1 n3 bc m abc am) (Refl _ _))
      (values S aeS aS2))))

(def-adts
  ((XT : ((List (Tk)) X) ((Tt) T) ((List (Bool)) u) -> Type)
    enum
    (many XTN : (erased (Tt) T) (erased (List (Bool)) u) (erased (Tb T (Nil (Bool)) u) tb) -> (XT (Nil (Tk)) T u))
    (many XTP : (erased (List (Tk)) X) (erased (Tt) T) (erased (List (Bool)) u) (erased (XT X T u) p) -> (XT (Cons (Tk) (Tp) X) T (bits "0" u)))
    (many XTZ : (erased (List (Tk)) X) (erased (Tt) T) (erased (List (Bool)) u) (erased (XT X T u) p) -> (XT (Cons (Tk) (T0) X) T (bits "111" u)))
    (many XTO : (erased (List (Tk)) X) (erased (Tt) T) (erased (List (Bool)) u) (erased (XT X T u) p) -> (XT (Cons (Tk) (T1) X) T (bits "0111" u)))))

(def-fns _ $ (erased tb-cat : (erased (Tt) T) (erased (List (Bool)) u y x) (erased (Tb T (Nil (Bool)) u) tb) (erased (Cat (Bool) u y x) c) -> (erased (Tb T y x) r))
  (match erased tb _
    ((TbE _) (let-match erased c (CatN _ _)) (TbE y))
    ((Tb1 _) (let-match erased c (CatC _ _ _ _ _ c1)) (let-match erased c1 (CatN _ _)) (Tb1 y))
    ((Tb11 _) (let-match erased c (CatC _ _ _ _ _ c1)) (let-match erased c1 (CatC _ _ _ _ _ c2)) (let-match erased c2 (CatN _ _)) (Tb11 y))
    ((Tb011 _) (let-match erased c (CatC _ _ _ _ _ c1)) (let-match erased c1 (CatC _ _ _ _ _ c2)) (let-match erased c2 (CatC _ _ _ _ _ c3))
      (let-match erased c3 (CatN _ _)) (Tb011 y))
    ((Tb0011 _) (let-match erased c (CatC _ _ _ _ _ c1)) (let-match erased c1 (CatC _ _ _ _ _ c2)) (let-match erased c2 (CatC _ _ _ _ _ c3))
      (let-match erased c3 (CatC _ _ _ _ _ c4)) (let-match erased c4 (CatN _ _)) (Tb0011 y))))

(def-fns _ $ (erased xt-cat : (erased (List (Tk)) X) (erased (Tt) T) (erased (List (Bool)) u y x) (subterm erased (XT X T u) p) (erased (Cat (Bool) u y x) c)
    -> (erased (List (Bool)) v) (erased (Tb T y v) tb) (erased (Xb X v x) xb))
  (match erased p _
    ((XTN _ _ tb) (values x (tb-cat T u y x tb c) (XbN x)))
    ((XTP X1 _ u1 p1)
      (let-match erased c (CatC _ _ _ _ x1 c1))
      (let ((erased v) (erased tb) (erased xb)) (xt-cat X1 T u1 y x1 p1 c1))
      (values v tb (XbP X1 v x1 xb)))
    ((XTZ X1 _ u1 p1)
      (let-match erased c (CatC _ _ _ _ x1 c1)) (let-match erased c1 (CatC _ _ _ _ x2 c2)) (let-match erased c2 (CatC _ _ _ _ x3 c3))
      (let ((erased v) (erased tb) (erased xb)) (xt-cat X1 T u1 y x3 p1 c3))
      (values v tb (XbZ X1 v x3 xb)))
    ((XTO X1 _ u1 p1)
      (let-match erased c (CatC _ _ _ _ x1 c1)) (let-match erased c1 (CatC _ _ _ _ x2 c2)) (let-match erased c2 (CatC _ _ _ _ x3 c3))
      (let-match erased c3 (CatC _ _ _ _ x4 c4))
      (let ((erased v) (erased tb) (erased xb)) (xt-cat X1 T u1 y x4 p1 c4))
      (values v tb (XbO X1 v x4 xb)))))

(def-fns _ $ (many tbits : (many (Tt) T) -> (many (List (Bool)) u) (erased (Tb T (Nil (Bool)) u) tb))
  (match many T _
    ((TtE) (values (Nil (Bool)) (TbE _)))
    ((Tt1) (values (bits "1" (Nil (Bool))) (Tb1 _)))
    ((Tt11) (values (bits "11" (Nil (Bool))) (Tb11 _)))
    ((Tt011) (values (bits "011" (Nil (Bool))) (Tb011 _)))
    ((Tt0011) (values (bits "0011" (Nil (Bool))) (Tb0011 _)))))

(def-fns _ $ (many xt : (subterm many (List (Tk)) X) (many (Tt) T) -> (many (List (Bool)) u) (erased (XT X T u) p))
  (let-match many X (Cons _ x X1) ((Nil _) (let ((many u) (erased tb)) (tbits T)) (values u (XTN T u tb))))
  (let ((many u) (erased p)) (notail $ xt X1 T))
  (match many x _
    ((Tp) (values (bits "0" u) (XTP X1 T u p)))
    ((T0) (values (bits "111" u) (XTZ X1 T u p)))
    ((T1) (values (bits "0111" u) (XTO X1 T u p)))))

(def-adts
  ((XTR : ((List (Tk)) X) ((Tt) T) -> Type)
    enum
    (many MkXTR : (erased (List (Tk)) X) (erased (Tt) T) (many (List (Rn)) U) (erased (List (Bool)) u) (erased (XT X T u) p) (erased (Den U u) d) -> (XTR X T))))

(def-fns _ $ (many xtr : (subterm many (List (Tk)) X) (many (Tt) T) -> (many (XTR X T) r))
  (let-match many X (Cons _ x X1) ((Nil _)
    (let ((many u) (erased tb)) (tbits T))
    (let ((many U) (erased y) (erased d) (erased c)) (pushbits u (Nil (Rn)) (Nil (Bool)) (DeN)))
    (let-match erased (cat-nil (Bool) u y c) (Refl _ _))
    (MkXTR X T U u (XTN T u tb) d)))
  (let-match many (notail $ xtr X1 T) (MkXTR _ _ U1 u1 p1 d1))
  (match many x _
    ((Tp)
      (let ((many U2) (erased y) (erased q) (erased d2)) (pushrun (BFalse) (Succ (Zero)) U1 u1 d1))
      (let-match erased q (RpS _ _ _ _ q1)) (let-match erased q1 (RpZ _ _))
      (MkXTR X T U2 _ (XTP X1 T u1 p1) d2))
    ((T0)
      (let ((many U2) (erased y) (erased q) (erased d2)) (pushrun (BTrue) (Succ (Succ (Succ (Zero)))) U1 u1 d1))
      (let-match erased q (RpS _ _ _ _ q1)) (let-match erased q1 (RpS _ _ _ _ q2)) (let-match erased q2 (RpS _ _ _ _ q3)) (let-match erased q3 (RpZ _ _))
      (MkXTR X T U2 _ (XTZ X1 T u1 p1) d2))
    ((T1)
      (let ((many U2) (erased y) (erased q) (erased d2)) (pushrun (BTrue) (Succ (Succ (Succ (Zero)))) U1 u1 d1))
      (let-match erased q (RpS _ _ _ _ q1)) (let-match erased q1 (RpS _ _ _ _ q2)) (let-match erased q2 (RpS _ _ _ _ q3)) (let-match erased q3 (RpZ _ _))
      (let ((many U3) (erased y3) (erased q4) (erased d3)) (pushrun (BFalse) (Succ (Zero)) U2 y d2))
      (let-match erased q4 (RpS _ _ _ _ q5)) (let-match erased q5 (RpZ _ _))
      (MkXTR X T U3 _ (XTO X1 T u1 p1) d3))))

(def-fns _ $ (erased tb-fn : (erased (Tt) T) (erased (List (Bool)) r x y) (erased (Tb T r x) p) (erased (Tb T r y) q) -> (erased (Eq (List (Bool)) x y) e))
  (match erased p _
    ((TbE _) (let-match erased q (TbE _)) (Refl _ x))
    ((Tb1 _) (let-match erased q (Tb1 _)) (Refl _ x))
    ((Tb11 _) (let-match erased q (Tb11 _)) (Refl _ x))
    ((Tb011 _) (let-match erased q (Tb011 _)) (Refl _ x))
    ((Tb0011 _) (let-match erased q (Tb0011 _)) (Refl _ x))))

(def-fns _ $ (erased xb-fn : (erased (List (Tk)) X) (erased (List (Bool)) r x y) (subterm erased (Xb X r x) p) (erased (Xb X r y) q) -> (erased (Eq (List (Bool)) x y) e))
  (match erased p _
    ((XbN _) (let-match erased q (XbN _)) (Refl _ x))
    ((XbP X1 _ x1 p1) (let-match erased q (XbP _ _ y1 q1)) (let-match erased (xb-fn X1 r x1 y1 p1 q1) (Refl _ _)) (Refl _ x))
    ((XbZ X1 _ x1 p1) (let-match erased q (XbZ _ _ y1 q1)) (let-match erased (xb-fn X1 r x1 y1 p1 q1) (Refl _ _)) (Refl _ x))
    ((XbO X1 _ x1 p1) (let-match erased q (XbO _ _ y1 q1)) (let-match erased (xb-fn X1 r x1 y1 p1 q1) (Refl _ _)) (Refl _ x))))

(def-fns _ $ (many apply-rdk : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (many (Nat) k w) (many (List (Tk)) X Z) (many (Tt) T U) (erased (RdK k X T Z U w) rk) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let-match many e (MkRq q L h R))
  (let-match erased dc (MkDc _ _ _ _ l r dl dr))
  (let-match many (eq-nat q 2) (ESome _ eq) ((ENone _) (RsNo l3 c0 e ch)))
  (let-match erased eq (Refl _ _))
  (let-match many h (BTrue) ((BFalse) (RsNo l3 c0 e ch)))
  (let-match many (strip (bits "00" (Nil (Bool))) L l dl) (StOk _ _ x0 L0 d0 cl) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let-match erased cl (CatC _ _ _ _ _ cl1))
  (let-match erased cl1 (CatC _ _ _ _ _ cl2))
  (let-match erased cl2 (CatN _ _))
  (let ((many n) (erased lz) (erased p0)) (ones L0 x0 d0))
  (let-match many (strip (bits "0" (Nil (Bool))) R r dr) (StOk _ _ xr R1 d1 cr) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let-match erased cr (CatC _ _ _ _ _ cr1))
  (let-match erased cr1 (CatN _ _))
  (let-match many (xtr X T) (MkXTR _ _ UU u pu du))
  (let-match many (strip-runs UU u du R1 xr d1) (StOk _ _ rc R2 d2 cu) ((StNo _ _) (RsNo l3 c0 e ch)))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X T u rc xr pu cu))
  (let-match many (stripz w R2 rc d2) (SzOk _ _ rr R3 d3 pw) ((SzNo _ _) (RsNo l3 c0 e ch)))
  (let ((erased m) (erased mk) (erased x3) (erased u2) (erased zr) (erased p1) (erased tb2) (erased zb) (erased t) (erased run))
    (rdk-run k w n X Z T U rk lz rr x0 rc v xr p0 pw tb xb))
  (let ((many m2) (erased mk2)) (mul k (Succ (Succ (Succ (Zero))))))
  (let-match erased (mul-fn k n3 m m2 mk mk2) (Refl _ _))
  (let ((many La) (erased xa) (erased pa) (erased da)) (pushrun (BTrue) m2 L0 x0 d0))
  (let-match erased (rp-fn (BTrue) m x0 xa x3 pa p1) (Refl _ _))
  (let ((many Lb) (erased db)) (push (BFalse) La x3 da))
  (let ((many Lc) (erased dc2)) (push (BFalse) Lb _ db))
  (let-match many (xtr Z U) (MkXTR _ _ U3 u3 pu3 du3))
  (let ((many Ra) (erased ya) (erased dya) (erased ca)) (push-runs U3 u3 du3 R3 rr d3))
  (let ((erased v3) (erased tb3) (erased zb3)) (xt-cat Z U u3 rr ya pu3 ca))
  (let-match erased (tb-fn U rr u2 v3 tb2 tb3) (Refl _ _))
  (let-match erased (xb-fn Z u2 zr ya zb zb3) (Refl _ _))
  (let ((many Rb) (erased drb)) (push (BFalse) Ra zr dya))
  (RsOk l3 c0 (MkRq 2 Lc (BTrue) Rb)
    (rch-run l3 c0 c _ e _ t ch dc run (MkDc 2 Lc Rb (BTrue) (bits "00" x3) (bits "0" zr) dc2 drb))))

(def-adts
  ((SwR : ((List (Nat)) K) ((List (Tk)) R) -> Type)
    enum
    (many SwOk : (erased (List (Nat)) K) (erased (List (Tk)) R) (many (SRes) s) (erased (Sw K R s) p) -> (SwR K R))
    (many SwNo : (erased (List (Nat)) K) (erased (List (Tk)) R) -> (SwR K R))))

(def-fns _ $ (many tpr : (subterm many (Nat) m) (many (List (Tk)) R) -> (many (List (Tk)) R2) (erased (TpR m R R2) p))
  (let-match many m (Succ m1) ((Zero) (values R (TpZ R))))
  (let ((many R1) (erased p1)) (notail $ tpr m1 R))
  (values (Cons _ (Tp) R1) (TpS m1 R R1 p1)))

(def-fns _ $ (many sw-run : (many (List (Nat)) K) (subterm many (List (Tk)) R) -> (many (SwR K R) r))
  (let-match many R (Cons _ x R1) ((Nil _) (SwOk K R (SEnd K) (SwEnd K))))
  (match many x _
    ((T0) (let-match many (notail $ sw-run (Cons _ (Succ (Succ (Zero))) K) R1) (SwOk _ _ s p) ((SwNo _ _) (SwNo K R)))
      (SwOk K R s (SwT0 K R1 s p)))
    ((T1) (let-match many (notail $ sw-run (Cons _ (Succ (Succ (Succ (Zero)))) K) R1) (SwOk _ _ s p) ((SwNo _ _) (SwNo K R)))
      (SwOk K R s (SwT1 K R1 s p)))
    ((Tp)
      (let-match many R1 (Cons _ y R2) ((Nil _) (SwNo K R)))
      (match many y _
        ((T0) (let-match many (notail $ sw-run (Cons _ (Succ (Succ (Succ (Zero)))) K) R2) (SwOk _ _ s p) ((SwNo _ _) (SwNo K R)))
          (SwOk K R s (SwP0 K R2 s p)))
        ((T1)
          (let-match many K (Cons _ t K1) ((Nil _) (SwNo K R)))
          (let-match many t (Succ t1) ((Zero) (SwNo K R)))
          (let-match many t1 (Succ t2) ((Zero) (SwNo K R)))
          (let-match many t2 (Succ m) ((Zero)
            (let-match many K1 (Cons _ s0 K2) ((Nil _) (SwNo K R)))
            (let-match many (notail $ sw-run (Cons _ (Succ (Succ (Zero))) (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s0) K2))) R2) (SwOk _ _ s p)
              ((SwNo _ _) (SwNo K R)))
            (SwOk K R s (SwP1M s0 K2 R2 s p))))
          (let ((many W) (erased pw)) (tpr m (Cons _ (T1) (Cons _ (T0) R2))))
          (SwOk K R (STurn K1 W) (SwP1T m K1 R2 W pw)))
        ((Tp)
          (let-match many K (Cons _ t K1) ((Nil _) (SwNo K R)))
          (let-match many t (Succ t1) ((Zero) (SwNo K R)))
          (let-match many t1 (Succ t2) ((Zero) (SwNo K R)))
          (let-match many t2 (Succ m) ((Zero)
            (let-match many K1 (Cons _ s0 K2) ((Nil _) (SwNo K R)))
            (let-match many (notail $ sw-run (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s0) K2)) R2) (SwOk _ _ s p) ((SwNo _ _) (SwNo K R)))
            (SwOk K R s (SwPPM s0 K2 R2 s p))))
          (let ((many W) (erased pw)) (tpr m (Cons _ (T1) R2)))
          (SwOk K R (STurn K1 W) (SwPPT m K1 R2 W pw)))))))

(def-adts
  ((WkR : ((List (Nat)) K) ((List (Tk)) R) -> Type)
    enum
    (many WkOk : (erased (List (Nat)) K) (erased (List (Tk)) R) (many (List (Tk)) Y) (erased (Wk K R Y) p) -> (WkR K R))
    (many WkNo : (erased (List (Nat)) K) (erased (List (Tk)) R) -> (WkR K R))))

(def-adts
  ((Tl0R : ((List (Tk)) R) -> Type)
    enum
    (many MkTl0R : (erased (List (Tk)) R) (many (List (Tk)) R1) (erased (Tl0 R R1) p) -> (Tl0R R))))

(def-fns _ $ (many tl0-run : (many (List (Tk)) R) -> (many (Maybe (Tl0R R)) r))
  (let-match many R (Cons _ x R2) ((Nil _) (Some _ (MkTl0R R R (Tl0N)))))
  (match many x _
    ((Tp) (Some _ (MkTl0R R R2 (Tl0P R2))))
    ((T1) (Some _ (MkTl0R R (Cons _ (T0) R2) (Tl01 R2))))
    ((T0) (None _))))

(def-fns _ $ (many wk-run : (subterm many (List (Nat)) K) (many (List (Tk)) R) -> (many (WkR K R) r))
  (let-match many K (Cons _ t K1) ((Nil _) (WkOk K R R (WkN R))))
  (let-match many t (Succ t1) ((Zero) (WkNo K R)))
  (let-match many t1 (Succ m) ((Zero) (WkNo K R)))
  (let-match many (tl0-run R) (Some _ pr) ((None _) (WkNo K R)))
  (let-match many pr (MkTl0R _ R1 tl))
  (let ((many R2) (erased tp)) (tpr m (Cons _ (T1) R1)))
  (let-match many (notail $ wk-run K1 R2) (WkOk _ _ Y w) ((WkNo _ _) (WkNo K R)))
  (WkOk K R Y (WkC m K1 R R1 R2 Y tl tp w)))

(def-adts
  ((EnR : ((List (Nat)) K) ((Tt) T) -> Type)
    enum
    (many EnOk : (erased (List (Nat)) K) (erased (Tt) T) (many (List (Nat)) K2) (many (List (Tk)) W) (many (Tt) T2) (many (Nat) c) (erased (En K T K2 W T2 c) p)
       -> (EnR K T))
    (many EnNo : (erased (List (Nat)) K) (erased (Tt) T) -> (EnR K T))))

(def-fns _ $ (many en-plain : (many (List (Nat)) K) (many (Tt) T) (erased (Plain T) pl) -> (many (EnR K T) r))
  (let-match many K (Cons _ t K1) ((Nil _) (EnNo K T)))
  (let-match many t (Succ t1) ((Zero) (EnNo K T)))
  (let-match many t1 (Succ t2) ((Zero) (EnNo K T)))
  (let-match many t2 (Succ m) ((Zero)
    (let-match many K1 (Cons _ s K2) ((Nil _) (EnNo K T)))
    (EnOk K T (Cons _ (Succ s) K2) (Cons _ (T1) (Nil (Tk))) T (Succ (Succ (Succ (Succ (Zero))))) (EnMP T pl s K2))))
  (let ((many W) (erased p)) (tpr m (Cons _ (T1) (Nil (Tk)))))
  (EnOk K T K1 W T (Succ (Succ (Zero))) (EnTP T pl m K1 W p)))

(def-fns _ $ (many en-4 : (many (List (Nat)) K) -> (many (EnR K (Tt0011)) r))
  (let-match many K (Cons _ t K1) ((Nil _) (EnNo K _)))
  (let-match many t (Succ t1) ((Zero) (EnNo K _)))
  (let-match many t1 (Succ t2) ((Zero) (EnNo K _)))
  (let-match many t2 (Succ m) ((Zero)
    (let-match many K1 (Cons _ s K2) ((Nil _) (EnNo K _)))
    (EnOk K _ (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s) K2)) (Cons _ (Tp) (Nil (Tk))) (Tt011) (Succ (Succ (Succ (Succ (Zero))))) (EnM4 s K2))))
  (let ((many W) (erased p)) (tpr m (Cons _ (T1) (Nil (Tk)))))
  (EnOk K _ K1 W (Tt11) (Zero) (EnT4 m K1 W p)))

(def-fns _ $ (many en-run : (many (List (Nat)) K) (many (Tt) T) -> (many (EnR K T) r))
  (let ((many four)) (Succ (Succ (Succ (Succ (Zero))))))
  (let ((many tp1)) (Cons _ (Tp) (Nil (Tk))))
  (let-match many T (TtE) ((Tt11) (EnOk K T K tp1 (Tt011) four (En11 K))) ((Tt011) (EnOk K T K tp1 (Tt0011) four (En011 K)))
    ((Tt1) (tail $ en-plain K T (Pl1))) ((Tt0011) (tail $ en-4 K)))
  (tail $ en-plain K T (PlE)))

(def-adts
  ((RdR : ((List (Tk)) X) ((Tt) T) -> Type)
    enum
    (many RdOk : (erased (List (Tk)) X) (erased (Tt) T) (many (List (Tk)) Y) (many (Tt) T2) (many (Nat) c) (erased (Rd X T Y T2 c) p) -> (RdR X T))
    (many RdNo : (erased (List (Tk)) X) (erased (Tt) T) -> (RdR X T))))

(def-fns _ $ (many rd-run : (many (List (Tk)) X) (many (Tt) T) -> (many (RdR X T) r))
  (let-match many X (Cons _ x0 X1) ((Nil _) (RdNo X T)))
  (let-match many x0 (Tp) (else (RdNo X T)))
  (let-match many X1 (Cons _ x1 W) ((Nil _) (RdNo X T)))
  (let-match many x1 (T1) (else (RdNo X T)))
  (let ((many K0)) (Cons _ (Succ (Succ (Succ (Zero)))) (Nil (Nat))))
  (let-match many (sw-run K0 W) (SwOk _ _ s sw) ((SwNo _ _) (RdNo X T)))
  (match many s _
    ((STurn K W2)
      (let-match many (wk-run K W2) (WkOk _ _ Y wk) ((WkNo _ _) (RdNo X T)))
      (RdOk X T Y T (Zero) (RdT W W2 Y K T sw wk)))
    ((SEnd K)
      (let-match many (en-run K T) (EnOk _ _ K2 W2 T2 c en) ((EnNo _ _) (RdNo X T)))
      (let-match many (wk-run K2 W2) (WkOk _ _ Y wk) ((WkNo _ _) (RdNo X T)))
      (RdOk X T Y T2 c (RdE W W2 Y K K2 T T2 c sw en wk)))))

(def-adts $ (PX : -> Type)
  enum
  (many MkPX : (many (List (Tk)) X) (many (Tt) T) (many (List (Rn)) rest) -> (PX))
  (many NoPX : -> (PX)))

(def-fns _ $ (many dig : (many (Nat) z) (many (List (Tk)) R) -> (many (List (Tk)) X))
  (let-match many z (Succ z1) ((Zero) (Cons _ (T0) R)))
  (let ((many X) (erased _)) (tpr z1 (Cons _ (T1) R)))
  X)

(def-fns _ $ (many t0s : (subterm many (Nat) j) (many (List (Tk)) R) -> (many (List (Tk)) X))
  (let-match many j (Succ j1) ((Zero) R))
  (Cons _ (T0) (notail $ t0s j1 R)))

(def-fns _ $ (many tk-app : (subterm many (List (Tk)) A) (many (List (Tk)) X) -> (many (List (Tk)) Y))
  (let-match many A (Cons _ a A1) ((Nil _) X))
  (Cons _ a (notail $ tk-app A1 X)))

(def-fns _ $ (many pcons : (many (List (Tk)) A) (many (PX) p) -> (many (PX) r))
  (let-match many p (MkPX X T rest) ((NoPX) (NoPX)))
  (MkPX (tk-app A X) T rest))

(def-fns _ $ (many tail-of : (many (Nat) z) (many (List (Rn)) rest) -> (many (PX) p))
  (let-match many z (Succ z1) ((Zero) (NoPX)))
  (let-match many z1 (Succ z2) ((Zero) (MkPX (Nil (Tk)) (Tt011) rest)))
  (let-match many z2 (Zero) ((Succ _) (NoPX)))
  (MkPX (Nil (Tk)) (Tt0011) rest))

(def-fns _ $ (many parse : (many (Nat) cap) (many (Nat) fuel) (many (Nat) z) (subterm many (List (Rn)) R) -> (many (PX) p))
  (let-match many fuel (Succ f) ((Zero) (MkPX (Nil (Tk)) (TtE) R)))
  (let-match many (lt-dec 3 z) (No _ _ _ _ _) ((Yes _ _ _ _ _) (NoPX)))
  (let-match many R (Cons _ rn R1) ((Nil _) (NoPX)))
  (let-match many rn (MkRn b L))
  (let-match many b (BTrue) ((BFalse) (NoPX)))
  (let-match many (lt-dec L cap) (Yes _ _ _ _ _) ((No _ _ _ _ _) (NoPX)))
  (let ((many j) (many rm) (erased _) (erased _) (erased _) (erased _)) (divmod L (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let-match many j (Succ j1) ((Zero) (let-match many (nat-eq rm 2) (Equal _ _ _) (else (NoPX))) (tail-of z R1)))
  (let ((many toks)) (dig z (t0s j1 (Nil (Tk)))))
  (let-match many rm (Zero) ((Succ rm1) (let-match many rm1 (Zero) ((Succ _) (MkPX toks (Tt11) R1))) (MkPX toks (Tt1) R1)))
  (let-match many R1 (Cons _ rn2 R2) ((Nil _) (MkPX toks (TtE) R1)))
  (let-match many rn2 (MkRn _ a))
  (let-match many (lt-dec 3 a) (No _ _ _ _ _) ((Yes _ _ _ _ _) (MkPX toks (TtE) R1)))
  (let-match many R2 (Cons _ _ _) ((Nil _) (MkPX toks (TtE) R1)))
  (pcons toks (notail $ parse cap f a R2)))

(def-fns _ $ (many lparse : (many (Rq) e) -> (many (PX) px))
  (let-match many e (MkRq q L h R))
  (let-match many R (Cons _ rn R1) ((Nil _) (NoPX)))
  (let-match many rn (MkRn b a0))
  (let-match many b (BFalse) ((BTrue) (NoPX)))
  (let-match many a0 (Succ a) ((Zero) (NoPX)))
  (parse 10000000 1000000000 a R1))

(def-fns _ $ (many try-round : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (PX) px) -> (many (Rs l3 c0) res))
  (let-match many e (MkRq q L h R))
  (let-match many R (Cons _ rn R1) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many rn (MkRn b a0))
  (let-match many b (BFalse) ((BTrue) (RsNo l3 c0 e ch)))
  (let-match many a0 (Succ a) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many px (MkPX X T _) ((NoPX) (RsNo l3 c0 e ch)))
  (let-match many (rd-run X T) (RdOk _ _ Y T2 c rd) ((RdNo _ _) (RsNo l3 c0 e ch)))
  (apply-rdk c0 e ch (Succ (Zero)) c X Y T T2 (RkS (Zero) c (Zero) c X Y Y T T2 T2 rd (RkZ Y T2) (add-zero-right c))))

(def-fns _ $ (many l3move : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) r))
  (let-match many (try-round c0 e ch (lparse e)) (RsNo _ _ e1 ch1) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (rmove l3 m2 mm c0 e1 ch1))

(def-fns _ $ (many l3run : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    -> (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values e ch)))
  (let-match many (l3move m2 mm c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values e1 ch1)))
  (tail $ l3run m2 mm c0 f e1 ch1))
