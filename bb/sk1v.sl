    ((DR) (simple-r-v l w F R rv wl lw cr))
    ((DL) (simple-l-v l w F R rv wl lw cr))))
  (match unique ws _
    ((WvGo _ _ _ d2 l2 w2 R2 rv2 wl2 lw2 cr2 g tr)
      (let ((erased W2) (erased cw2) (erased tr2) (erased nx2)) (trun-fr d d2 l l2 w w2 F R g tr cr nx))
      (let-match erased (cat-fn (Sy) w2 (Cons (Sy) iD F) W2 R2 cw2 cr2) (Refl _ _))
