(def-adts
  ((En : ((List (Sy)) r) ((List (U8)) ts) ((List (Nat)) cs) -> Type)
    enum
    (many EnN : -> (En (Nil (Sy)) (Nil (U8)) (Nil (Nat))))
    (many EnC : (erased (Sy) s) (erased (List (Sy)) r) (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (List (U8)) ts) (erased (List (Nat)) cs)
       (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e) (erased (En r ts cs) en)
       -> (En (Cons (Sy) s r) (Cons (U8) u ts) (Cons (Nat) c cs)))))

(def-fns _ $ (erased en-nth : (erased (List (Sy)) r) (erased (List (U8)) ts) (erased (List (Nat)) cs) (erased (Nat) i) (erased (Sy) s)
    (erased (En r ts cs) en) (subterm erased (Nth (Sy) r i s) nt)
    -> (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (Nth (U8) ts i u) nu) (erased (Nth (Nat) cs i c) nc)
    (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e))
  (let-match erased en (EnC _ r1 t u c ts1 cs1 cu e en1) (absurd (EnN) nt))
  (let-match erased nt (NthThere _ _ _ i1 _ nt1) ((NthHere _ _ _) (values t u c (NthHere _ u ts1) (NthHere _ c cs1) cu e)))
  (let ((erased t2) (erased u2) (erased c2) (erased nu) (erased nc) (erased cu2) (erased e2)) (en-nth r1 ts1 cs1 i1 s en1 nt1))
  (values t2 u2 c2 (NthThere _ u ts1 i1 u2 nu) (NthThere _ c cs1 i1 c2 nc) cu2 e2))

(def-fns _ $ (erased en-drop : (erased (List (Sy)) p ys r) (erased (List (U8)) ts) (erased (List (Nat)) cs) (erased (Nat) k)
    (erased (En r ts cs) en) (subterm erased (Cat (Sy) p ys r) c) (erased (Length (Sy) p k) lk)
    -> (erased (List (U8)) pt ts2) (erased (List (Nat)) pc cs2) (erased (Cat (U8) pt ts2 ts) ct) (erased (Length (U8) pt k) lt)
    (erased (Cat (Nat) pc cs2 cs) cc) (erased (Length (Nat) pc k) lc) (erased (En ys ts2 cs2) en2))
  (let-match erased c (CatC _ _ p1 _ r1 c1)
    ((CatN _ _) (let-match erased lk (LengthNil _)) (values (Nil (U8)) ts (Nil (Nat)) cs (CatN (U8) ts) (LengthNil _) (CatN (Nat) cs) (LengthNil _) en)))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let-match erased en (EnC _ _ t u n ts1 cs1 cu e en1))
  (let ((erased pt) (erased ts2) (erased pc) (erased cs2) (erased ct) (erased lt) (erased cc) (erased lc) (erased en2)) (en-drop p1 ys r1 ts1 cs1 k1 en1 c1 lk1))
  (values (Cons (U8) u pt) ts2 (Cons (Nat) n pc) cs2 (CatC (U8) u pt ts2 ts1 ct) (LengthCons _ u pt k1 lt) (CatC (Nat) n pc cs2 cs1 cc) (LengthCons _ n pc k1 lc) en2))

(def-fns _ $ (erased en-length : (erased (List (Sy)) r) (erased (List (U8)) ts) (erased (List (Nat)) cs) (erased (Nat) n)
    (subterm erased (En r ts cs) en) (erased (Length (U8) ts n) lt) -> (erased (Length (Sy) r n) l))
  (let-match erased en (EnC s r1 _ u _ ts1 _ _ _ en1) ((EnN) (let-match erased lt (LengthNil _)) (LengthNil _)))
  (let-match erased lt (LengthCons _ _ _ n1 lt1))
  (LengthCons _ s r1 n1 (en-length r1 ts1 _ n1 en1 lt1)))

(def-adts $ (Sv : ((List (Sy)) r) -> Type)
  enum
  (many MkSv : (erased (List (Sy)) r) (erased (List (U8)) ts) (erased (List (Nat)) cs) (unique (Bv ts) tv) (unique (Av (Nat) cs) cv) (erased (En r ts cs) en) -> (Sv r)))

(def-fns _ $ (many sv-new : (many (Nat) cap) -> (unique (Sv (Nil (Sy))) v))
