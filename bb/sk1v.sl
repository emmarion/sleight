  (let ((unique tv2)) (bv-push ts tv (coerce t cu)))
  (let ((unique cv2)) (av-push (Nat) cs cv c))
  (u _ _ _ (at) tv2 (at) cv2 (EnC s r t w c ts cs cu e en)))

(def-fns _ $ (many sv-pop : (erased (Sy) s) (erased (List (Sy)) r) (unique (Sv (Cons (Sy) s r)) v) -> (unique (Sv r) v2 at v))
  (let-match unique v (MkSv _ _ _ tv cv en u))
