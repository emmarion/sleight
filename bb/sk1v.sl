        ((BFalse) (lv-force d l w F R rv1 wl lw cr k z zv lz))))
    ((WvDead _ _ _) (LvDead))))

(def-fns _ $ (many lv-fail : (many (List (Sy)) l) (erased (List (Sy)) w F R) (unique (Sv R) rv) (many (Nat) wl) (erased (Length (Sy) w wl) lw)
