    (tail $ mrun-v c2 (MRS sk1-blank c c2 g mr tr) r0 z0 f))
  ((many lrun-v : (many (Mv) d) (many (List (Sy)) l) (erased (List (Sy)) w F R) (unique (Sv R) rv) (many (Nat) wl) (erased (Length (Sy) w wl) lw)
      (erased (Cat (Sy) w (Cons (Sy) iD F) R) cr) (erased (Zk) k) (many (Zm k F) z) (unique (Sv (Nil (Sy))) zv) (erased (Lz k d l w) lz) (erased (Nx w) nx) (many (Bool) sk)
