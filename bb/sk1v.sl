  (let ((many b) (unique tb2)) (bytes-get _ tb1 p w nu))
  (let ((many cy) (unique ca2)) (array-get _ _ ca p c nc))
  (values (sy-is (coerce b (coercible-sym cu)) c cy s e q) (at unique (u r tps cps n cap l1 l2 ly tb2 ca2))))

(def-fns _ $ (many sv-symp : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) p) (erased (Nat) i n) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    (erased (Length (Sy) r n) l) (erased (Add (Succ i) p n) ad) -> (many s is y) (unique v is v2 at v))
