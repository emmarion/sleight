  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (en-nth r ts cs i s en nt))
  (let ((many y) (unique tv2)) (bv-get ts tv i w nu))
  (values (coerce y (coercible-sym cu)) c e (at unique (u _ ts cs tv2 cv en))))

(def-fns _ $ (many sv-cnt : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    -> (many (Nat) y) (erased (Tg) t) (erased (Ecd s t y) e) (unique v is v2 at v))
