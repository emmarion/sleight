; Ly r tps cps n: logical symbol i of r (0 the top) is encoded at physical index n-1-i of the tag bytes tps and the counts cps.
(def-adts
  ((Ly : ((List (Sy)) r) ((List (U8)) tps) ((List (Copy (Nat))) cps) ((Nat) n) -> Type)
    enum
    (many LyN : (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) -> (Ly (Nil (Sy)) tps cps (Zero)))
    (many LyC : (erased (Sy) s) (erased (List (Sy)) r) (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps)
       (erased (Nat) n) (erased (Ly r tps cps n) ly) (erased (Nth (U8) tps n u) nu) (erased (Nth (Copy (Nat)) cps n (MkCopy (Nat) c)) nc)
       (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e) -> (Ly (Cons (Sy) s r) tps cps (Succ n)))))

(def-fns _ $ (erased ly-length : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n)
    (subterm erased (Ly r tps cps n) ly) -> (erased (Length (Sy) r n) l))
  (let-match erased ly (LyC s r1 _ _ _ _ _ n1 ly1 _ _ _ _) ((LyN _ _) (LengthNil _)))
  (LengthCons _ s r1 n1 (ly-length r1 tps cps n1 ly1)))

(def-fns _ $ (erased ly-le : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n cap)
    (erased (Ly r tps cps n) ly) (erased (Length (U8) tps cap) l) -> (erased (Lt n (Succ cap)) le))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 _ nu _ _ _) ((LyN _ _) (LtZ cap)))
  (LtS n1 cap (nth-lt-length _ tps n1 cap _ nu l)))

(def-fns _ $ (erased ly-nth : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n i p) (erased (Sy) s)
    (subterm erased (Ly r tps cps n) ly) (erased (Nth (Sy) r i s) nt) (erased (Add (Succ i) p n) ad)
    -> (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (Nth (U8) tps p u) nu) (erased (Nth (Copy (Nat)) cps p (MkCopy (Nat) c)) nc)
    (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e))
  (let-match erased ly (LyC _ r1 t u c _ _ n1 ly1 nu nc cu e) (absurd (LyN _ _) nt))
  (let-match erased ad (AddSucc _ _ _ ad1))
  (let-match erased nt (NthThere _ _ _ i1 _ nt2) ((NthHere _ _ _) (let-match erased ad1 (AddZero _)) (values t u c nu nc cu e)))
  (ly-nth r1 tps cps n1 i1 p s ly1 nt2 ad1))

(def-fns _ $ (erased ly-agr : (erased (List (Sy)) r) (erased (List (U8)) tps tps2) (erased (List (Copy (Nat))) cps cps2) (erased (Nat) n q)
    (subterm erased (Ly r tps cps n) ly) (erased (Agr (U8) tps tps2 q) gt) (erased (Agr (Copy (Nat)) cps cps2 q) gc) (erased (Lt n (Succ q)) le)
    -> (erased (Ly r tps2 cps2 n) r2))
  (let-match erased ly (LyC s r1 t u c _ _ n1 ly1 nu nc cu e) ((LyN _ _) (LyN tps2 cps2)))
  (let-match erased le (LtS _ _ lt))
  (LyC s r1 t u c tps2 cps2 n1 (ly-agr r1 tps tps2 cps cps2 n1 q ly1 gt gc (lt-weaken n1 q lt)) (agr-nth _ tps tps2 q n1 u gt nu lt)
    (agr-nth _ cps cps2 q n1 _ gc nc lt) cu e))

(def-fns _ $ (erased ly-drop-le : (erased (List (Sy)) p ys r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n k)
    (subterm erased (Cat (Sy) p ys r) c) (erased (Ly r tps cps n) ly) (erased (Length (Sy) p k) lk) -> (erased (Lt k (Succ n)) le))
  (let-match erased c (CatC _ _ p1 _ r1 c1) ((CatN _ _) (let-match erased lk (LengthNil _)) (LtZ n)))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 ly1 _ _ _ _))
  (LtS k1 n (ly-drop-le p1 ys r1 tps cps n1 k1 c1 ly1 lk1)))

(def-fns _ $ (erased ly-drop : (erased (List (Sy)) p ys r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n k m)
    (subterm erased (Cat (Sy) p ys r) c) (erased (Ly r tps cps n) ly) (erased (Length (Sy) p k) lk) (erased (Add k m n) ad) -> (erased (Ly ys tps cps m) r2))
  (let-match erased c (CatC _ _ p1 _ r1 c1) ((CatN _ _) (let-match erased lk (LengthNil _)) (let-match erased ad (AddZero _)) ly))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 ly1 _ _ _ _))
  (let-match erased ad (AddSucc _ _ _ ad1))
  (ly-drop p1 ys r1 tps cps n1 k1 m c1 ly1 lk1 ad1))

(def-fns _ $ (erased ly-le-c : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n cap)
    (erased (Ly r tps cps n) ly) (erased (Length (Copy (Nat)) cps cap) l) -> (erased (Lt n (Succ cap)) le))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 _ _ nc _ _) ((LyN _ _) (LtZ cap)))
  (LtS n1 cap (nth-lt-length _ cps n1 cap _ nc l)))

(def-adts $ (Sv : ((List (Sy)) r) -> Type)
  enum
  (many MkSv : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
     (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly)
     (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) -> (Sv r)))

(def-fns _ $ (many sv-new : (many (Nat) cap) -> (unique (Sv (Nil (Sy))) v))
  (let ((erased tps) (unique tb) (erased rt)) (bytes-make cap (MkU8 0 u8l0)))
  (let ((erased cps) (unique ca) (erased rc)) (array-make (Nat) cap 0))
  (MkSv _ tps cps (Zero) cap (repeat-length _ _ _ _ rt) (repeat-length _ _ _ _ rc) (LyN tps cps) tb ca))

(def-fns _ $ (many sv-len : (erased (List (Sy)) r) (unique (Sv r) v) -> (many (Nat) n) (erased (Length (Sy) r n) p) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (values n (ly-length r tps cps n ly) (at unique (u r tps cps n cap l1 l2 ly tb ca))))

(def-fns _ $ (many sv-put : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly) (erased (Lt n cap) lt)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    -> (erased (List (U8)) tps2) (erased (List (Copy (Nat))) cps2) (erased (Length (U8) tps2 cap) l3) (erased (Length (Copy (Nat)) cps2 cap) l4)
    (erased (Ly (Cons (Sy) s r) tps2 cps2 (Succ n)) ly2) (unique (Bytes tps2) tb2 at tb) (unique (Array (Copy (Nat)) cps2) ca2 at ca))
  (let ((erased w) (erased cu)) (tg-u8 t))
  (let ((erased m1) (erased nt1)) (nth-exists _ tps cap n l1 lt))
  (let ((erased tps2) (unique tb2) (erased st1)) (bytes-set _ tb n (coerce t cu) m1 nt1))
  (let ((erased m2) (erased nt2)) (nth-exists _ cps cap n l2 lt))
  (let ((erased cps2) (unique ca2) (erased st2)) (array-place _ _ ca n (MkCopy _ c) m2 nt2))
  (values tps2 cps2 (setnth-length _ tps n cap w tps2 st1 l1) (setnth-length _ cps n cap (MkCopy _ c) cps2 st2 l2)
    (LyC s r t w c tps2 cps2 n
      (ly-agr r tps tps2 cps cps2 n n ly (setnth-agr _ tps tps2 n n w st1 (lt-succ n)) (setnth-agr _ cps cps2 n n _ st2 (lt-succ n)) (lt-succ n))
      (setnth-nth _ tps n w tps2 st1) (setnth-nth _ cps n (MkCopy _ c) cps2 st2) cu e)
    tb2 ca2))

(def-fns _ $ (many sv-grow-push : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    (erased (Slot) s1 s2 s3) (unique (Cell MkSv s1 s2 s3) u) -> (unique (Sv (Cons (Sy) s r)) v at u))
  (let ((many c2) (erased ad)) (add n n))
  (let ((many cap2)) (Succ c2))
  (let ((erased le)) (add-le-left n n c2 ad))
  (let ((erased lcap)) (ly-le r tps cps n cap ly l1))
  (let ((erased qt) (unique bt) (erased rt)) (bytes-make cap2 (MkU8 0 u8l0)))
  (let ((erased lqt)) (repeat-length _ _ _ _ rt))
  (let ((erased ys) (erased fr)) (splice-range _ tps cap l1 (Zero) n n (AddZero n) lcap))
  (let ((erased old) (erased to)) (splice-range _ qt cap2 lqt (Zero) n n (AddZero n) (lt-weaken n cap2 le)))
  (let ((erased zt) (unique bt2) (erased sp)) (bytes-blit _ (share tb) (Zero) _ bt (Zero) n ys fr old to))
  (let ((erased qc) (unique bc) (erased rc)) (array-make (Nat) cap2 0))
  (let ((erased lqc)) (repeat-length _ _ _ _ rc))
  (let ((erased ysc) (erased frc)) (splice-range _ cps cap l2 (Zero) n n (AddZero n) (ly-le-c r tps cps n cap ly l2)))
  (let ((erased oldc) (erased toc)) (splice-range _ qc cap2 lqc (Zero) n n (AddZero n) (lt-weaken n cap2 le)))
  (let ((erased zc) (unique bc2) (erased spc)) (array-blit _ _ (share ca) (Zero) _ bc (Zero) n ysc frc oldc toc))
  (let ((erased lzt)) (splice-length _ qt ys zt (Zero) n cap2 sp lqt))
  (let ((erased lzc)) (splice-length _ qc ysc zc (Zero) n cap2 spc lqc))
  (let ((erased ly1)) (ly-agr r tps zt cps zc n n ly (splice-agr _ tps qt ys zt n fr sp) (splice-agr _ cps qc ysc zc n frc spc) (lt-succ n)))
  (let ((erased tps3) (erased cps3) (erased l3) (erased l4) (erased ly2) (unique tb3) (unique ca3))
    (sv-put r zt zc n cap2 lzt lzc ly1 le bt2 bc2 t c s e))
  (u _ tps3 cps3 (Succ n) cap2 l3 l4 ly2 tb3 ca3))

(def-fns _ $ (many sv-push : (erased (List (Sy)) r) (unique (Sv r) v) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    -> (unique (Sv (Cons (Sy) s r)) v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((many len) (erased lt0) (unique tb0)) (bytes-length _ tb))
  (let-match erased (length-fn (U8) tps len cap lt0 l1) (Refl _ _))
  (let-match many (lt-dec n len) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (sv-grow-push r tps cps n len l1 l2 ly tb0 ca t c s e _ _ _ u)))
  (let ((erased tps2) (erased cps2) (erased l3) (erased l4) (erased ly2) (unique tb2) (unique ca2)) (sv-put r tps cps n len l1 l2 ly lt tb0 ca t c s e))
  (u _ tps2 cps2 (Succ n) cap l3 l4 ly2 (at) tb2 (at) ca2))

(def-fns _ $ (many sv-tagp : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) p) (erased (Nat) i n) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    (erased (Length (Sy) r n) l) (erased (Add (Succ i) p n) ad) -> (many (Tg) t) (erased (Nat) c) (erased (Ecd s t c) e) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n0 cap l1 l2 ly tb ca u))
  (let-match erased (length-fn (Sy) r n0 n (ly-length r tps cps n0 ly) l) (Refl _ _))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (ly-nth r tps cps n0 i p s ly nt ad))
  (let ((many y) (unique tb2)) (bytes-get _ tb p w nu))
  (values (coerce y (coercible-sym cu)) c e (at unique (u r tps cps n0 cap l1 l2 ly tb2 ca))))

(def-fns _ $ (many sv-cntp : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) p) (erased (Nat) i n) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    (erased (Length (Sy) r n) l) (erased (Add (Succ i) p n) ad) -> (many (Nat) y) (erased (Tg) t) (erased (Ecd s t y) e) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n0 cap l1 l2 ly tb ca u))
  (let-match erased (length-fn (Sy) r n0 n (ly-length r tps cps n0 ly) l) (Refl _ _))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (ly-nth r tps cps n0 i p s ly nt ad))
  (let ((many y) (unique ca2)) (array-get _ _ ca p c nc))
  (values y t e (at unique (u r tps cps n0 cap l1 l2 ly tb ca2))))

(def-fns _ $ (many sv-at : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    -> (many (Nat) p) (erased (Nat) n) (erased (Length (Sy) r n) l) (erased (Add (Succ i) p n) ad) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((erased l)) (ly-length r tps cps n ly))
  (let ((many p) (erased ad)) (sub n (Succ i) (LtS i n (nth-lt-length _ r i n s nt l))))
  (values p n l ad (at unique (u r tps cps n cap l1 l2 ly tb ca))))

(def-fns _ $ (many sv-tag : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    -> (many (Tg) t) (erased (Nat) c) (erased (Ecd s t c) e) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((many p) (erased ad)) (sub n (Succ i) (LtS i n (nth-lt-length _ r i n s nt (ly-length r tps cps n ly)))))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (ly-nth r tps cps n i p s ly nt ad))
  (let ((many y) (unique tb2)) (bytes-get _ tb p w nu))
  (values (coerce y (coercible-sym cu)) c e (at unique (u r tps cps n cap l1 l2 ly tb2 ca))))

(def-fns _ $ (many sv-cnt : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt)
    -> (many (Nat) y) (erased (Tg) t) (erased (Ecd s t y) e) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((many p) (erased ad)) (sub n (Succ i) (LtS i n (nth-lt-length _ r i n s nt (ly-length r tps cps n ly)))))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (ly-nth r tps cps n i p s ly nt ad))
  (let ((many y) (unique ca2)) (array-get _ _ ca p c nc))
  (values y t e (at unique (u r tps cps n cap l1 l2 ly tb ca2))))

(def-fns _ $ (many sv-sym : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt) -> (many s is y) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((many p) (erased ad)) (sub n (Succ i) (LtS i n (nth-lt-length _ r i n s nt (ly-length r tps cps n ly)))))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (ly-nth r tps cps n i p s ly nt ad))
  (let ((many b) (unique tb2)) (bytes-get _ tb p w nu))
  (let ((many cy) (unique ca2)) (array-get _ _ ca p c nc))
  (values (dec-at (coerce b (coercible-sym cu)) cy s e) (at unique (u r tps cps n cap l1 l2 ly tb2 ca2))))

(def-fns _ $ (many sv-is : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt) (many (Sy) q)
    -> (many (Maybe (Eq (Sy) s q)) res) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((many p) (erased ad)) (sub n (Succ i) (LtS i n (nth-lt-length _ r i n s nt (ly-length r tps cps n ly)))))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (ly-nth r tps cps n i p s ly nt ad))
  (let ((many b) (unique tb2)) (bytes-get _ tb p w nu))
  (let ((many cy) (unique ca2)) (array-get _ _ ca p c nc))
  (values (sy-is (coerce b (coercible-sym cu)) c cy s e q) (at unique (u r tps cps n cap l1 l2 ly tb2 ca2))))

(def-fns _ $ (many sv-tag0 : (erased (Sy) s) (erased (List (Sy)) r) (unique (Sv (Cons (Sy) s r)) v) -> (many (Tg) t) (erased (Nat) c) (erased (Ecd s t c) e) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let-match erased ly (LyC _ _ t w c _ _ _ _ nu _ cu e))
  (let-match many n (Succ m))
  (let ((many y) (unique tb2)) (bytes-get _ tb m w nu))
  (values (coerce y (coercible-sym cu)) c e (at unique (u _ tps cps n cap l1 l2 ly tb2 ca))))

(def-fns _ $ (many sv-cnt0 : (erased (Sy) s) (erased (List (Sy)) r) (unique (Sv (Cons (Sy) s r)) v) -> (many (Nat) y) (erased (Tg) t) (erased (Ecd s t y) e) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let-match erased ly (LyC _ _ t w c _ _ _ _ _ nc cu e))
  (let-match many n (Succ m))
  (let ((many y) (unique ca2)) (array-get _ _ ca m c nc))
  (values y t e (at unique (u _ tps cps n cap l1 l2 ly tb ca2))))

(def-fns _ $ (many sv-pop : (erased (Sy) s) (erased (List (Sy)) r) (unique (Sv (Cons (Sy) s r)) v) -> (unique (Sv r) v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let-match erased ly (LyC _ _ _ _ _ _ _ _ ly1 _ _ _ _))
  (let-match many n (Succ m))
  (u r tps cps m cap l1 l2 ly1 (at) tb (at) ca))

(def-fns _ $ (many sv-set-top : (erased (Sy) s) (erased (List (Sy)) r) (unique (Sv (Cons (Sy) s r)) v) (many (Tg) t) (many (Nat) c) (erased (Sy) s2) (erased (Ecd s2 t c) e)
    -> (unique (Sv (Cons (Sy) s2 r)) v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let-match erased ly (LyC _ _ _ _ _ _ _ _ ly1 nu _ _ _))
  (let-match many n (Succ m))
  (let ((erased tps2) (erased cps2) (erased l3) (erased l4) (erased ly2) (unique tb2) (unique ca2))
    (sv-put r tps cps m cap l1 l2 ly1 (nth-lt-length _ tps m cap _ nu l1) tb ca t c s2 e))
  (u _ tps2 cps2 (at) n cap l3 l4 ly2 (at) tb2 (at) ca2))

(def-fns _ $ (many sv-drop : (erased (List (Sy)) p ys r) (unique (Sv r) v) (many (Nat) k) (erased (Cat (Sy) p ys r) c) (erased (Length (Sy) p k) lk)
    -> (unique (Sv ys) v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let ((many m) (erased ad)) (sub n k (ly-drop-le p ys r tps cps n k c ly lk)))
  (u ys tps cps m cap l1 l2 (ly-drop p ys r tps cps n k m c ly lk ad) (at) tb (at) ca))

(def-fns _ $ (many sv-clear : (erased (List (Sy)) r) (unique (Sv r) v) -> (unique (Sv (Nil (Sy))) v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (u _ tps cps (Zero) cap l1 l2 (LyN tps cps) (at) tb (at) ca))

(def-fns _ $ (many sv-move : (erased (Sy) x) (erased (List (Sy)) zs r) (unique (Sv (Cons (Sy) x zs)) zv) (unique (Sv r) rv)
    -> (unique (Sv zs) zv2 at zv) (unique (Sv (Cons (Sy) x r)) rv2 at rv))
  (let-match unique zv (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (let-match erased ly (LyC _ _ t w c _ _ _ ly1 nu nc cu e))
  (let-match many n (Succ m))
  (let ((many y) (unique tb2)) (bytes-get _ tb m w nu))
  (let ((many cy) (unique ca2)) (array-get _ _ ca m c nc))
