(def-fns _ $ (many simple-r-v : (many (List (Sy)) l) (erased (List (Sy)) w F R) (unique (Sv R) rv) (many (Nat) wl) (erased (Length (Sy) w wl) lw)
    (erased (Cat (Sy) w (Cons (Sy) iD F) R) cr) -> (unique (Wv (MkCf (DR) l w) F R) r))
