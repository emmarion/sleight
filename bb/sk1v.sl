; Ly r tps cps n: logical symbol i of r (0 the top) is encoded at physical index n-1-i of the tag bytes tps and the counts cps.
(def-adts
  ((Ly : ((List (Sy)) r) ((List (U8)) tps) ((List (Copy (Nat))) cps) ((Nat) n) -> Type)
    enum
    (many LyN : (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) -> (Ly (Nil (Sy)) tps cps (Zero)))
    (many LyC : (erased (Sy) s) (erased (List (Sy)) r) (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps)
       (erased (Nat) n) (erased (Ly r tps cps n) ly) (erased (Nth (U8) tps n u) nu) (erased (Nth (Copy (Nat)) cps n (MkCopy (Nat) c)) nc)
       (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e) -> (Ly (Cons (Sy) s r) tps cps (Succ n)))))

(def-fns _ $ (erased ly-length : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n)
    (subterm erased (Ly r tps cps n) ly) -> (erased (Length (Sy) r n) l))
  (let-match erased ly (LyC s r1 _ _ _ _ _ n1 ly1 _ _ _ _) ((LyN _ _) (LengthNil _)))
  (LengthCons _ s r1 n1 (ly-length r1 tps cps n1 ly1)))

(def-fns _ $ (erased len-e : (subterm erased (List (Sy)) x) -> (erased (Nat) n) (erased (Length (Sy) x n) l))
  (let-match erased x (Cons _ s x1) ((Nil _) (values (Zero) (LengthNil _))))
  (let ((erased n) (erased l)) (len-e x1))
  (values (Succ n) (LengthCons _ s x1 n l)))

(def-fns _ $ (erased ly-le : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n cap)
    (erased (Ly r tps cps n) ly) (erased (Length (U8) tps cap) l) -> (erased (Lt n (Succ cap)) le))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 _ nu _ _ _) ((LyN _ _) (LtZ cap)))
  (LtS n1 cap (nth-lt-length _ tps n1 cap _ nu l)))

(def-fns _ $ (erased ly-nth : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n i p) (erased (Sy) s)
    (subterm erased (Ly r tps cps n) ly) (erased (Nth (Sy) r i s) nt) (erased (Add (Succ i) p n) ad)
    -> (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (Nth (U8) tps p u) nu) (erased (Nth (Copy (Nat)) cps p (MkCopy (Nat) c)) nc)
    (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e))
  (let-match erased ly (LyC _ r1 t u c _ _ n1 ly1 nu nc cu e) (absurd (LyN _ _) nt))
  (let-match erased ad (AddSucc _ _ _ ad1))
  (let-match erased nt (NthThere _ _ _ i1 _ nt2) ((NthHere _ _ _) (let-match erased ad1 (AddZero _)) (values t u c nu nc cu e)))
  (ly-nth r1 tps cps n1 i1 p s ly1 nt2 ad1))

(def-fns _ $ (erased ly-agr : (erased (List (Sy)) r) (erased (List (U8)) tps tps2) (erased (List (Copy (Nat))) cps cps2) (erased (Nat) n q)
    (subterm erased (Ly r tps cps n) ly) (erased (Agr (U8) tps tps2 q) gt) (erased (Agr (Copy (Nat)) cps cps2 q) gc) (erased (Lt n (Succ q)) le)
    -> (erased (Ly r tps2 cps2 n) r2))
  (let-match erased ly (LyC s r1 t u c _ _ n1 ly1 nu nc cu e) ((LyN _ _) (LyN tps2 cps2)))
  (let-match erased le (LtS _ _ lt))
  (LyC s r1 t u c tps2 cps2 n1 (ly-agr r1 tps tps2 cps cps2 n1 q ly1 gt gc (lt-weaken n1 q lt)) (agr-nth _ tps tps2 q n1 u gt nu lt)
    (agr-nth _ cps cps2 q n1 _ gc nc lt) cu e))

(def-fns _ $ (erased ly-drop-le : (erased (List (Sy)) p ys r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n k)
    (subterm erased (Cat (Sy) p ys r) c) (erased (Ly r tps cps n) ly) (erased (Length (Sy) p k) lk) -> (erased (Lt k (Succ n)) le))
  (let-match erased c (CatC _ _ p1 _ r1 c1) ((CatN _ _) (let-match erased lk (LengthNil _)) (LtZ n)))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 ly1 _ _ _ _))
  (LtS k1 n (ly-drop-le p1 ys r1 tps cps n1 k1 c1 ly1 lk1)))

(def-fns _ $ (erased ly-drop : (erased (List (Sy)) p ys r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n k m)
    (subterm erased (Cat (Sy) p ys r) c) (erased (Ly r tps cps n) ly) (erased (Length (Sy) p k) lk) (erased (Add k m n) ad) -> (erased (Ly ys tps cps m) r2))
  (let-match erased c (CatC _ _ p1 _ r1 c1) ((CatN _ _) (let-match erased lk (LengthNil _)) (let-match erased ad (AddZero _)) ly))
  (let-match erased lk (LengthCons _ _ _ k1 lk1))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 ly1 _ _ _ _))
  (let-match erased ad (AddSucc _ _ _ ad1))
  (ly-drop p1 ys r1 tps cps n1 k1 m c1 ly1 lk1 ad1))

(def-fns _ $ (erased ly-le-c : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) n cap)
    (erased (Ly r tps cps n) ly) (erased (Length (Copy (Nat)) cps cap) l) -> (erased (Lt n (Succ cap)) le))
  (let-match erased ly (LyC _ _ _ _ _ _ _ n1 _ _ nc _ _) ((LyN _ _) (LtZ cap)))
  (LtS n1 cap (nth-lt-length _ cps n1 cap _ nc l)))

(def-adts $ (Sv : ((List (Sy)) r) -> Type)
  enum
  (many MkSv : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
     (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly)
     (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) -> (Sv r)))

(def-fns _ $ (many sv-new : (many (Nat) cap) -> (unique (Sv (Nil (Sy))) v))
  (let ((erased tps) (unique tb) (erased rt)) (bytes-make cap (MkU8 0 u8l0)))
  (let ((erased cps) (unique ca) (erased rc)) (array-make (Nat) cap 0))
  (MkSv _ tps cps (Zero) cap (repeat-length _ _ _ _ rt) (repeat-length _ _ _ _ rc) (LyN tps cps) tb ca))

(def-fns _ $ (many sv-len : (erased (List (Sy)) r) (unique (Sv r) v) -> (many (Nat) n) (erased (Length (Sy) r n) p) (unique v is v2 at v))
  (let-match unique v (MkSv _ tps cps n cap l1 l2 ly tb ca u))
  (values n (ly-length r tps cps n ly) (at unique (u r tps cps n cap l1 l2 ly tb ca))))

(def-adts
  ((Bd : ((Nat) n) -> Type)
    enum
    (many BdY : (erased (Nat) n) (erased (Lt n u62-modulus) b) -> (Bd n))
    (many BdN : (erased (Nat) n) -> (Bd n))))

(def-fns _ $ (many cap-dec : (erased (List (U8)) tps) (erased (Nat) cap) (unique (Bytes tps) tb) (erased (Length (U8) tps cap) l1)
    -> (many (Bd cap) d) (unique tb is tb2 at tb))
  (let ((erased len) (erased lp) (many d) (unique tb1)) (bytes-length-dec _ tb))
  (let-match erased (length-fn (U8) tps len cap lp l1) (Refl _ _))
  (values (match many d _ ((Yes _ _ _ _ b) (BdY cap b)) ((No _ _ _ _ _) (BdN cap))) tb1))

(def-fns _ $ (erased imm-nat : (many (Nat) n) (erased (Lt n u62-modulus) q) -> (erased (ImmSlot (slot-of n)) r))
  (ImmPlaced _ (ImmU62) _ _ (place-at-many _ (coerce n (coercible-wrap (Shared) MkU62 n q)))))

(def-fns _ $ (erased imm-le : (many (Nat) n) (erased (Nat) cap) (erased (Lt n (Succ cap)) b) (erased (Lt cap u62-modulus) q) -> (erased (ImmSlot (slot-of n)) r))
  (imm-nat n (lt-le-trans n (Succ cap) u62-modulus b (LtS cap u62-modulus q))))

(def-fns _ $ (erased le-bd : (erased (Nat) a n) (erased (Lt a (Succ n)) le) (erased (Lt n u62-modulus) bd) -> (erased (Lt a u62-modulus) r))
  (lt-le-trans a (Succ n) u62-modulus le (LtS n u62-modulus bd)))

(def-fns _ $ (erased add-bd : (erased (Nat) a b n) (erased (Add a b n) ad) (erased (Lt n u62-modulus) bd) -> (erased (Lt a u62-modulus) r))
  (le-bd a n (add-le-left a b n ad) bd))

(def-fns _ $ (many bd-sub : (erased (Nat) n) (many (Bd n) d) (many (Nat) a b) (erased (Lt a (Succ n)) an) (erased (Lt b (Succ a)) ba)
    -> (many (Nat) c) (erased (Add b c a) ad))
  (let-match many d (BdY _ q) ((BdN _) (sub a b ba)))
  (let ((many c) (erased ad) (erased _)) (u62-sub a b (le-bd a n an q) ba))
  (values c ad))

(def-fns _ $ (many bd-add : (erased (Nat) n) (many (Bd n) d) (many (Nat) a b) (erased (Nat) c) (erased (Add a b c) ad) (erased (Lt c (Succ n)) cn) -> (many c is s))
  (let-match many d (BdY _ q) ((BdN _) (let ((many s) (erased ad2)) (add a b)) (let-match erased (add-fn a b s c ad2 ad) (Refl _ _)) s))
  (u62-add a b c ad (le-bd c n cn q)))

(def-fns _ $ (many bd-inc : (erased (Nat) n) (many (Bd n) d) (many (Nat) a) (erased (Lt a n) an) -> (many (Succ a) is s))
  (let-match many d (BdY _ q) ((BdN _) (Succ a)))
  (u62-inc a (le-bd (Succ a) n (LtS a n an) q)))

(def-fns _ $ (many bd-pred : (erased (Nat) n) (many (Bd n) d) (erased (Nat) m) (many (Succ m) is a) (erased (Lt a (Succ n)) an) -> (many m is s))
  (let-match many d (BdY _ q) ((BdN _) (let-match many a (Succ m1)) m1))
  (u62-dec m a (le-bd a n an q)))

(def-fns _ $ (many bd-eqd : (erased (Nat) n) (many (Bd n) d) (many (Nat) a b) (erased (Lt a (Succ n)) an) (erased (Lt b (Succ n)) bn) -> (many (EqDec (Nat) Lt a b) e))
  (let-match many d (BdY _ q) ((BdN _) (nat-eq a b)))
  (u62-eq a b (le-bd a n an q) (le-bd b n bn q)))

(def-fns _ $ (many bd-ltd : (erased (Nat) n) (many (Bd n) d) (many (Nat) a b) (erased (Lt a (Succ n)) an) (erased (Lt b (Succ n)) bn) -> (many (Dec (Nat) Lt a b) e))
  (let-match many d (BdY _ q) ((BdN _) (lt-dec a b)))
  (u62-lt-dec a b (le-bd a n an q) (le-bd b n bn q)))

(def-fns _ $ (many bd-ltl : (erased (Nat) n) (many (Bd n) d) (many (Nat) a b) (erased (Lt a (Succ n)) an) (erased (Lt b u62-modulus) bm) -> (many (Dec (Nat) Lt a b) e))
  (let-match many d (BdY _ q) ((BdN _) (lt-dec a b)))
  (u62-lt-dec a b (le-bd a n an q) bm))

(def-fns _ $ (many bd-gtl : (erased (Nat) n) (many (Bd n) d) (many (Nat) a b) (erased (Lt a u62-modulus) am) (erased (Lt b (Succ n)) bn) -> (many (Dec (Nat) Lt a b) e))
  (let-match many d (BdY _ q) ((BdN _) (lt-dec a b)))
  (u62-lt-dec a b am (le-bd b n bn q)))

(let ((erased lit1)) (lt-trans 1 64 u62-modulus (prove-literal-lt 1 64) pm64))
(let ((erased lit2)) (lt-trans 2 64 u62-modulus (prove-literal-lt 2 64) pm64))
(let ((erased lit5)) (lt-trans 5 64 u62-modulus (prove-literal-lt 5 64) pm64))
(let ((erased lit16)) (lt-trans 16 64 u62-modulus (prove-literal-lt 16 64) pm64))

(def-fns _ $ (many sv-sub : (erased (List (U8)) tps) (erased (Nat) cap) (unique (Bytes tps) tb) (erased (Length (U8) tps cap) l1)
    (many (Nat) n k) (erased (Lt n (Succ cap)) nc) (erased (Lt k (Succ n)) le) -> (many (Nat) m) (erased (Add k m n) ad) (unique tb is tb2 at tb))
  (let ((many d) (unique tb1)) (cap-dec tps cap tb l1))
  (let ((many m) (erased ad)) (bd-sub cap d n k nc le))
  (values m ad tb1))

(def-fns _ $ (many vput : (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) i) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Lt i cap) lt)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c)
    -> (erased (U8) w) (erased (Coercible (Shared) (Tg) t (Shared) (U8) w) cu) (erased (List (U8)) tps2) (erased (List (Copy (Nat))) cps2)
    (erased (SetNth (U8) tps i w tps2) st1) (erased (SetNth (Copy (Nat)) cps i (MkCopy (Nat) c) cps2) st2)
    (erased (Length (U8) tps2 cap) l3) (erased (Length (Copy (Nat)) cps2 cap) l4) (unique (Bytes tps2) tb2 at tb) (unique (Array (Copy (Nat)) cps2) ca2 at ca))
  (let ((erased w) (erased cu)) (tg-u8 t))
  (let ((erased m1) (erased nt1)) (nth-exists _ tps cap i l1 lt))
  (let ((erased tps2) (unique tb2) (erased st1)) (bytes-set _ tb i (coerce t cu) m1 nt1))
  (let ((erased m2) (erased nt2)) (nth-exists _ cps cap i l2 lt))
  (let ((erased cps2) (unique ca2) (erased st2)) (array-place _ _ ca i (MkCopy _ c) m2 nt2))
  (values w cu tps2 cps2 st1 st2 (setnth-length _ tps i cap w tps2 st1 l1) (setnth-length _ cps i cap (MkCopy _ c) cps2 st2 l2) tb2 ca2))

(def-fns _ $ (many sv-put : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly) (erased (Lt n cap) lt)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    -> (erased (List (U8)) tps2) (erased (List (Copy (Nat))) cps2) (erased (Length (U8) tps2 cap) l3) (erased (Length (Copy (Nat)) cps2 cap) l4)
    (erased (Ly (Cons (Sy) s r) tps2 cps2 (Succ n)) ly2) (unique (Bytes tps2) tb2 at tb) (unique (Array (Copy (Nat)) cps2) ca2 at ca))
  (let ((erased w) (erased cu) (erased tps2) (erased cps2) (erased st1) (erased st2) (erased l3) (erased l4) (unique tb2) (unique ca2))
    (vput tps cps n cap l1 l2 lt tb ca t c))
  (values tps2 cps2 l3 l4
    (LyC s r t w c tps2 cps2 n
      (ly-agr r tps tps2 cps cps2 n n ly (setnth-agr _ tps tps2 n n w st1 (lt-succ n)) (setnth-agr _ cps cps2 n n _ st2 (lt-succ n)) (lt-succ n))
      (setnth-nth _ tps n w tps2 st1) (setnth-nth _ cps n (MkCopy _ c) cps2 st2) cu e)
    tb2 ca2))

(def-fns _ $ (many sv-grow : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Nat) cap2) (erased (Lt n (Succ cap2)) le)
    -> (erased (List (U8)) tps2) (erased (List (Copy (Nat))) cps2) (erased (Length (U8) tps2 cap2) l3) (erased (Length (Copy (Nat)) cps2 cap2) l4)
    (erased (Ly r tps2 cps2 n) ly2) (unique (Bytes tps2) tb2) (unique (Array (Copy (Nat)) cps2) ca2))
  (let ((erased qt) (unique bt) (erased rt)) (bytes-make cap2 (MkU8 0 u8l0)))
  (let ((erased lqt)) (repeat-length _ _ _ _ rt))
  (let ((erased ys) (erased fr)) (splice-range _ tps cap l1 (Zero) n n (AddZero n) (ly-le r tps cps n cap ly l1)))
  (let ((erased old) (erased to)) (splice-range _ qt cap2 lqt (Zero) n n (AddZero n) le))
  (let ((erased zt) (unique bt2) (erased sp)) (bytes-blit-many _ _ ys old (share tb) (Zero) bt (Zero) n fr to))
  (let ((erased qc) (unique bc) (erased rc)) (array-make (Nat) cap2 0))
  (let ((erased lqc)) (repeat-length _ _ _ _ rc))
  (let ((erased ysc) (erased frc)) (splice-range _ cps cap l2 (Zero) n n (AddZero n) (ly-le-c r tps cps n cap ly l2)))
  (let ((erased oldc) (erased toc)) (splice-range _ qc cap2 lqc (Zero) n n (AddZero n) le))
  (let ((erased zc) (unique bc2) (erased spc)) (array-blit-many _ _ _ ysc oldc (share ca) (Zero) bc (Zero) n frc toc))
  (values zt zc (splice-length _ qt ys zt (Zero) n cap2 sp lqt) (splice-length _ qc ysc zc (Zero) n cap2 spc lqc)
    (ly-agr r tps zt cps zc n n ly (splice-agr _ tps qt ys zt n fr sp) (splice-agr _ cps qc ysc zc n frc spc) (lt-succ n)) bt2 bc2))

(def-fns _ $ (many sv-grow-push : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    (erased (Slot) s1 s2 s3) (unique (Cell MkSv s1 s2 s3) u) -> (unique (Sv (Cons (Sy) s r)) v at u))
  (let ((many c2) (erased ad)) (add n n))
  (let ((many cap2)) (Succ c2))
  (let ((erased le)) (add-le-left n n c2 ad))
  (let ((erased tps2) (erased cps2) (erased l3) (erased l4) (erased ly1) (unique bt2) (unique bc2)) (sv-grow r tps cps n cap l1 l2 ly tb ca cap2 (lt-weaken n cap2 le)))
  (let ((erased tps3) (erased cps3) (erased l5) (erased l6) (erased ly2) (unique tb3) (unique ca3)) (sv-put r tps2 cps2 n cap2 l3 l4 ly1 le bt2 bc2 t c s e))
  (u _ tps3 cps3 (Succ n) cap2 l5 l6 ly2 tb3 ca3))

(def-fns _ $ (many sv-room : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Nat) need) (erased (Lt n (Succ need)) le)
    -> (erased (Nat) cap2) (erased (List (U8)) tps2) (erased (List (Copy (Nat))) cps2) (erased (Length (U8) tps2 cap2) l3) (erased (Length (Copy (Nat)) cps2 cap2) l4)
    (erased (Ly r tps2 cps2 n) ly2) (erased (Lt need (Succ cap2)) room) (unique (Bytes tps2) tb2) (unique (Array (Copy (Nat)) cps2) ca2))
  (let ((many len) (erased lt0) (unique tb0)) (bytes-length _ tb))
  (let-match erased (length-fn (U8) tps len cap lt0 l1) (Refl _ _))
  (let-match many (lt-dec need (Succ len)) (No _ _ _ _ _) ((Yes _ _ _ _ room) (values cap tps cps l1 l2 ly room tb0 ca)))
  (let ((many c2) (erased ad)) (add need need))
  (let ((many cap2)) (Succ c2))
  (let ((erased room)) (lt-weaken need cap2 (add-le-left need need c2 ad)))
  (let ((erased tps2) (erased cps2) (erased l3) (erased l4) (erased ly2) (unique tb2) (unique ca2))
    (sv-grow r tps cps n cap l1 l2 ly tb0 ca cap2 (lt-le-trans n (Succ need) (Succ cap2) le (LtS need (Succ cap2) room))))
  (values cap2 tps2 cps2 l3 l4 ly2 room tb2 ca2))

(def-fns _ $ (many sv-store : (erased (List (Sy)) r) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) n0 n) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Ly r tps cps n) ly) (erased (Lt n0 (Succ cap)) b0)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (unique (Cell MkSv (slot-of n0) (slot-of tb) (slot-of ca)) u) -> (unique (Sv r) v at u))
  (let ((many d) (unique tb1)) (cap-dec tps cap tb l1))
  (let-match many d (BdY _ q) ((BdN _) (u r tps cps n cap l1 l2 ly (at) tb1 (at) ca)))
  (u r tps cps (imm (imm-le n0 cap b0 q) (imm-le n cap (ly-le r tps cps n cap ly l1) q)) n cap l1 l2 ly (at) tb1 (at) ca))

(def-fns _ $ (many sv-push : (erased (List (Sy)) r) (unique (Sv r) v) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    -> (unique (Sv (Cons (Sy) s r)) v2 at v))
