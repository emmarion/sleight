    (many SbC : (erased (List (Sy)) r u) (erased (Nat) i j) (erased (Sy) x) (erased (Nth (Sy) r i x) nt) (erased (Sub r (Succ i) j u) sb) -> (Sub r i j (Cons (Sy) x u)))))

(def-fns _ $ (erased ecd-wc : (erased (Pk) k) (erased (Nat) c y) (erased (Tg) t) (erased (Ecd (YW k (MkAm (BFalse) c)) t y) e) -> (erased (Eq (Nat) c y) q))
  (match erased e _ ((EcXF _) (Refl _ _)) ((EcFF _) (Refl _ _)) ((EcGF _) (Refl _ _)) ((EcHF _) (Refl _ _))))

(def-fns _ $ (erased add-pos : (erased (Nat) y a1 s) (erased (Add y (Succ a1) s) ad) -> (erased (Lt (Zero) s) p))
  (match erased ad _ ((AddZero _) (LtZ a1)) ((AddSucc _ _ c1 _) (LtZ c1))))

(def-adts
  ((PdR : ((List (Sy)) zs o) ((Pk) pk) ((Nat) pc) ((Pk) k) ((Nat) a) ((List (Sy)) zs2) -> Type)
    enum
    (many PdOk : (erased (List (Sy)) zs o zs2 o2) (erased (Pk) pk k pk2) (erased (Nat) pc a pc2) (erased (Pa o pk pc k a o2 pk2 pc2) pa)
       (erased (Sc zs2 o2 pk2 pc2) sc) -> (PdR zs o pk pc k a zs2))
    (many PdNo : (erased (List (Sy)) zs o zs2) (erased (Pk) pk k) (erased (Nat) pc a) -> (PdR zs o pk pc k a zs2))))

(def-fns _ $ (many pd-w : (erased (List (Sy)) zs o) (erased (Pk) pk) (erased (Nat) pc) (unique (Sv zs) zv) (many (Pk) k2 k) (erased (Nat) c) (many (Nat) a1)
    (erased (List (Sy)) zs0) (erased (Eq (List (Sy)) zs (Cons (Sy) (YW k2 (MkAm (BFalse) c)) zs0)) q) (erased (Sc zs o pk pc) sc)
    -> (erased (List (Sy)) zs2) (unique (Sv zs2) zv2 at zv) (many (PdR zs o pk pc k (Succ a1) zs2) r))
  (let-match erased q (Refl _ _))
  (let-match many (pk-cmp k2 k) (PkEq _)
    ((PkNe _ _ ne)
      (let ((erased o2) (erased pa) (erased sc2)) (sc-diff zs0 o pk k k2 pc c a1 sc ne))
      (let ((many t) (erased e)) (wk-tag k (Succ a1)))
      (values (Cons (Sy) (YW k (MkAm (BFalse) (Succ a1))) zs) (sv-push zs zv t (Succ a1) _ e) (PdOk _ _ _ o2 _ _ _ _ _ _ pa sc2))))
  (let ((many y) (erased t0) (erased e0) (unique zv1)) (sv-cnt zs zv 0 _ (NthHere _ _ zs0)))
  (let-match erased (ecd-wc k c y t0 e0) (Refl _ _))
  (let ((many s) (erased ad)) (add y (Succ a1)))
  (let ((erased pa) (erased sc2)) (sc-merge zs0 o pk k pc y (Succ a1) s sc ad (add-pos y a1 s ad)))
  (let ((many t2) (erased e2)) (wk-tag k s))
  (values (Cons (Sy) (YW k (MkAm (BFalse) s)) zs0) (sv-set-top _ zs0 zv1 t2 s _ e2) (PdOk _ _ _ o _ _ _ _ _ _ pa sc2)))

(def-fns _ $ (many pd-n : (erased (List (Sy)) zs o) (erased (Pk) pk) (erased (Nat) pc) (unique (Sv zs) zv) (many (Pk) k) (many (Nat) a1)
    (many (Tg) t) (erased (Ecd (YW k (MkAm (BFalse) (Succ a1))) t (Succ a1)) e) (erased (Nwf zs) nw) (erased (Sc zs o pk pc) sc)
    -> (erased (List (Sy)) zs2) (unique (Sv zs2) zv2 at zv) (many (PdR zs o pk pc k (Succ a1) zs2) r))
  (let ((erased pa) (erased sc2)) (sc-new zs o pk k pc a1 sc nw))
  (values (Cons (Sy) (YW k (MkAm (BFalse) (Succ a1))) zs) (sv-push zs zv t (Succ a1) _ e) (PdOk _ _ _ o _ _ _ _ _ _ pa sc2)))

(def-fns _ $ (many pend : (erased (List (Sy)) zs o) (erased (Pk) pk) (erased (Nat) pc) (unique (Sv zs) zv) (many (Pk) k) (many (Nat) a) (erased (Sc zs o pk pc) sc)
    -> (erased (List (Sy)) zs2) (unique (Sv zs2) zv2 at zv) (many (PdR zs o pk pc k a zs2) r))
  (let-match many a (Succ a1) ((Zero) (values zs zv (PdOk _ _ zs o _ _ _ _ _ _ (PaZ o pk k pc) sc))))
  (let ((many t) (erased e)) (wk-tag k a))
  (let ((many n) (erased ln) (unique zv1)) (sv-len zs zv))
  (let-match many n (Succ n1) ((Zero) (let-match erased ln (LengthNil _)) (pd-n zs o pk pc zv1 k a1 t e (NwN) sc)))
  (let-match erased ln (LengthCons _ x zs0 _ _))
  (let ((many t0) (erased c0) (erased e0) (unique zv2)) (sv-tag zs zv1 0 x (NthHere _ x zs0)))
  (match many t0 _
    ((TgXF) (let-match erased e0 (EcXF _)) (pd-w zs o pk pc zv2 (KX) k c0 a1 zs0 (Refl _ _) sc))
    ((TgFF) (let-match erased e0 (EcFF _)) (pd-w zs o pk pc zv2 (KF) k c0 a1 zs0 (Refl _ _) sc))
    ((TgGF) (let-match erased e0 (EcGF _)) (pd-w zs o pk pc zv2 (KG) k c0 a1 zs0 (Refl _ _) sc))
    ((TgHF) (let-match erased e0 (EcHF _)) (pd-w zs o pk pc zv2 (KH) k c0 a1 zs0 (Refl _ _) sc))
    ((TgQD) (let-match erased e0 (EcQD _)) (pd-n zs o pk pc zv2 k a1 t e (NwB _ zs0 (NbF (QD))) sc))
    ((TgC) (let-match erased e0 (EcC _)) (pd-n zs o pk pc zv2 k a1 t e (NwB _ zs0 (NbC)) sc))
    (else (values zs zv2 (PdNo _ _ _ _ _ _ _)))))

(def-fns _ $ (erased sub-lt : (erased (List (Sy)) r u) (erased (Nat) i j) (erased (Sy) x) (subterm erased (Sub r i j (Cons (Sy) x u)) sb) -> (erased (Lt i j) lt))
  (let-match erased sb (SbC _ _ _ _ _ _ sb1))
  (match erased sb1 _
    ((SbN _ _) (lt-succ i))
    ((SbC _ u1 _ _ x1 _ _) (lt-trans i (Succ i) j (lt-succ i) (sub-lt r u1 (Succ i) j x1 sb1)))))

(def-adts
  ((SfR : ((List (Sy)) o0) ((Nat) xs0 n0) ((List (Sy)) u0 zs) -> Type)
    enum
    (many SfOk : (erased (List (Sy)) o0 u0 zs W W2) (erased (Nat) xs0 n0) (many (Nat) m) (erased (Rv zs W) rv) (erased (Cat (Sy) o0 W2 W) c)
       (erased (Swin xs0 n0 u0 W2 m) s) -> (SfR o0 xs0 n0 u0 zs))
    (many SfNo : (erased (List (Sy)) o0) (erased (Nat) xs0 n0) (erased (List (Sy)) u0 zs) -> (SfR o0 xs0 n0 u0 zs))))

(def-fns _ $ (many sw-f : (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Sub r i j u) sb)
    (erased (List (Sy)) zs) (unique (Sv zs) zv) (many (Nat) xs n)
    (erased (List (Sy)) o0 u0 o) (erased (Nat) xs0 n0 pc) (erased (Pk) pk) (erased (Fw o0 xs0 n0 u0 o pk pc xs n u) f) (erased (Sc zs o pk pc) sc)
    -> (unique rv is rv2 at rv) (erased (List (Sy)) zs2) (unique (Sv zs2) zv2 at zv) (many (SfR o0 xs0 n0 u0 zs2) res))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap)
    ((Equal _ _ _)
      (let-match erased sb (SbN _ _) (absurd (SbC _ u2 _ _ x1 _ _) (lt-asym i i (sub-lt r u2 i i x1 sb) (lt-weaken i i (sub-lt r u2 i i x1 sb)))))
      (let ((erased zs2) (unique zv2) (many pr)) (pend zs o pk pc zv (KX) xs sc))
      (let-match many pr (PdOk _ _ _ o1 _ _ pk1 _ _ pc1 pa sc2) ((PdNo _ _ _ _ _ _ _) (values rv zs2 zv2 (SfNo _ _ _ _ _))))
      (let ((erased W) (erased cs) (erased pu) (erased c) (erased rw)) (sc-end zs2 o1 pk1 pc1 sc2))
      (let ((erased w) (erased pw)) (push-ex (KX) xs (Nil (Sy))))
      (let ((erased w2) (erased p2) (erased c2)) (pa-back o o1 (Nil (Sy)) w cs W pk (KX) pk1 pc xs pc1 pa pu c pw))
      (let ((erased W2) (erased c3) (erased s3)) (fw-swin o0 u0 o (Nil (Sy)) w w2 W xs0 n0 pc xs n n pk f (SwE xs n w pw) p2 c2))
      (values rv zs2 zv2 (SfOk _ _ _ W W2 _ _ n rw c3 s3))))
  (let-match erased sb (SbC _ u1 _ _ x nt sb1) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let ((many t) (erased c) (erased e) (unique rv1)) (sv-tag r rv i x nt))
  (match many t _
    ((TgQD)
      (let-match erased e (EcQD _))
      (let ((erased zs1) (unique zv1) (many pr)) (pend zs o pk pc zv (KX) xs sc))
      (let-match many pr (PdOk _ _ _ o1 _ _ pk1 _ _ pc1 pa sc1) ((PdNo _ _ _ _ _ _ _) (values rv1 zs1 zv1 (SfNo _ _ _ _ _))))
      (let ((unique zv2)) (sv-push zs1 zv1 (TgQD) 0 iD (EcQD 0)))
      (let ((erased o2) (erased fe) (erased sc2)) (sc-emit zs1 o1 pk1 pc1 iD sc1 (NbF (QD))))
      (tail $ sw-f r rv1 (Succ i) j u1 sb1 _ zv2 0 n o0 u0 o2 xs0 n0 0 (KX) (FwD o0 u0 o o1 o2 u1 xs0 n0 pc pc1 xs n pk pk1 f pa fe) sc2))
    ((TgC)
      (let-match erased e (EcC _))
      (let-match many (lt-dec n (Succ xs)) (Yes _ _ _ _ pl) ((No _ _ _ _ _) (values rv1 zs zv (SfNo _ _ _ _ _))))
      (let ((many d) (erased ad)) (sub xs n pl))
      (let ((many n2) (erased a2)) (add n n))
      (let ((many n4) (erased a4)) (add n2 n2))
      (let ((erased zs1) (unique zv1) (many pr)) (pend zs o pk pc zv (KX) d sc))
      (let-match many pr (PdOk _ _ _ o1 _ _ pk1 _ _ pc1 pa sc1) ((PdNo _ _ _ _ _ _ _) (values rv1 zs1 zv1 (SfNo _ _ _ _ _))))
      (let ((unique zv2)) (sv-push zs1 zv1 (TgC) 0 (YC) (EcC 0)))
      (let ((erased o2) (erased fe) (erased sc2)) (sc-emit zs1 o1 pk1 pc1 (YC) sc1 (NbC)))
      (let ((erased zs3) (unique zv3) (many pr3)) (pend _ o2 (KX) 0 zv2 (KX) n2 sc2))
      (let-match many pr3 (PdOk _ _ _ o3 _ _ pk3 _ _ pc3 pb sc3) ((PdNo _ _ _ _ _ _ _) (values rv1 zs3 zv3 (SfNo _ _ _ _ _))))
      (tail $ sw-f r rv1 (Succ i) j u1 sb1 _ zv3 0 n4 o0 u0 o3 xs0 n0 pc3 pk3
        (FwC o0 u0 o o1 o2 o3 u1 xs0 n0 pc pc1 pc3 xs n d n2 n4 pk pk1 pk3 f ad a2 a4 pa fe pb) sc3))
    ((TgXF)
      (let-match erased e (EcXF _))
      (let ((many cv) (erased t2) (erased e2) (unique rv2)) (sv-cnt r rv1 i x nt))
      (let-match erased e2 (EcXF _))
      (let ((many xs2) (erased a)) (add xs cv))
      (tail $ sw-f r rv2 (Succ i) j u1 sb1 zs zv xs2 n o0 u0 o xs0 n0 pc pk (FwX o0 u0 o u1 xs0 n0 pc xs n cv xs2 pk f a) sc))
    ((TgGF)
      (let-match erased e (EcGF _))
      (let ((many g) (erased t2) (erased e2) (unique rv2)) (sv-cnt r rv1 i x nt))
      (let-match erased e2 (EcGF _))
      (let ((erased zs1) (unique zv1) (many pr)) (pend zs o pk pc zv (KX) xs sc))
      (let-match many pr (PdOk _ _ _ o1 _ _ pk1 _ _ pc1 pa sc1) ((PdNo _ _ _ _ _ _ _) (values rv2 zs1 zv1 (SfNo _ _ _ _ _))))
      (let ((erased zs2) (unique zv2) (many pr2)) (pend zs1 o1 pk1 pc1 zv1 (KG) g sc1))
      (let-match many pr2 (PdOk _ _ _ o2 _ _ pk2 _ _ pc2 pb sc2) ((PdNo _ _ _ _ _ _ _) (values rv2 zs2 zv2 (SfNo _ _ _ _ _))))
      (tail $ sw-f r rv2 (Succ i) j u1 sb1 zs2 zv2 0 n o0 u0 o2 xs0 n0 pc2 pk2 (FwG o0 u0 o o1 o2 u1 xs0 n0 pc pc1 pc2 xs n g pk pk1 pk2 f pa pb) sc2))
    (else (values rv1 zs zv (SfNo _ _ _ _ _)))))

(def-fns _ $ (many sv-move : (erased (Sy) x) (erased (List (Sy)) zs r) (unique (Sv (Cons (Sy) x zs)) zv) (unique (Sv r) rv)
    -> (unique (Sv zs) zv2 at zv) (unique (Sv (Cons (Sy) x r)) rv2 at rv))
  (let-match unique zv (MkSv _ _ _ ztv zcv zen zu))
  (let-match erased zen (EnC _ _ t w c zts zcs cu e zen1))
  (let ((many y) (unique ztv1)) (bv-get _ ztv 0 w (NthHere _ w zts)))
  (let ((many cy) (unique zcv1)) (av-get (Nat) _ zcv 0 c (NthHere _ c zcs)))
  (let ((many y2) (unique ztv2)) (bv-pop w zts ztv1))
  (let ((many cy2) (unique zcv2)) (av-pop (Nat) c zcs zcv1))
  (let ((unique zv2)) (zu zs zts zcs (at) ztv2 (at) zcv2 zen1))
  (let-match unique rv (MkSv _ ts cs tv cv en ru))
  (let ((unique tv2)) (bv-push ts tv y))
  (let ((unique cv2)) (av-push (Nat) cs cv cy))
  (let ((unique rv2)) (ru _ _ _ (at) tv2 (at) cv2 (EnC x r t w c ts cs cu e en)))
  (values zv2 rv2))

(def-fns _ $ (erased cat-one-r : (erased (List (Sy)) e W r WR) (erased (Sy) x) (subterm erased (Cat (Sy) e (Cons (Sy) x (Nil (Sy))) W) c1) (erased (Cat (Sy) e (Cons (Sy) x r) WR) c2)
    -> (erased (Cat (Sy) W r WR) c))
  (let-match erased c1 (CatC _ a e1 _ W1 c3) ((CatN _ _) (let-match erased c2 (CatN _ _)) (CatC (Sy) x (Nil (Sy)) r r (CatN (Sy) r))))
  (let-match erased c2 (CatC _ _ _ _ WR1 c4))
  (CatC (Sy) a W1 r WR1 (cat-one-r e1 W1 r WR1 x c3 c4)))

(def-fns _ $ (many xfer : (erased (List (Sy)) zs W r) (unique (Sv zs) zv) (subterm erased (Rv zs W) rw) (unique (Sv r) rv)
    -> (erased (List (Sy)) WR) (erased (Cat (Sy) W r WR) c) (unique (Sv (Nil (Sy))) zv2 at zv) (unique (Sv WR) rv2 at rv))
  (let ((many n) (erased ln) (unique zv0)) (sv-len zs zv))
  (let-match many n (Succ n1)
    ((Zero) (let-match erased rw (RvN) (absurd (RvS _ _ _ _ _ _) ln)) (values r (CatN (Sy) r) zv0 rv)))
  (let-match erased rw (RvS zs1 e _ x rw1 ce) (absurd (RvN) ln))
  (let ((unique zv1) (unique rv1)) (sv-move x zs1 r zv0 rv))
  (let ((erased WR) (erased c1) (unique zv2) (unique rv2)) (tail $ xfer zs1 e (Cons (Sy) x r) zv1 rw1 rv1))
  (values WR (cat-one-r e W r WR x ce c1) zv2 rv2))

(def-fns _ $ (many sv-sym : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) s) (erased (Nth (Sy) r i s) nt) -> (many s is y) (unique v is v2 at v))
  (let-match unique v (MkSv _ ts cs tv cv en u))
  (let ((erased t) (erased w) (erased c) (erased nu) (erased nc) (erased cu) (erased e)) (en-nth r ts cs i s en nt))
  (let ((many b) (unique tv2)) (bv-get ts tv i w nu))
  (let ((many cy) (unique cv2)) (av-get (Nat) cs cv i c nc))
  (values (dec-at (coerce b (coercible-sym cu)) cy s e) (at unique (u _ ts cs tv2 cv2 en))))

(def-fns _ $ (many sv-of : (many (Nat) cap) (subterm many (List (Sy)) x) -> (unique (Sv x) v))
  (let-match many x (Cons _ s x1) ((Nil _) (sv-new cap)))
  (let ((many t) (many c) (erased e)) (enc-sy s))
  (sv-push x1 (notail $ sv-of cap x1) t c s e))

(def-fns _ $ (many sv-list : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Sub r i j u) sb)
    -> (many u is y) (unique v is v2 at v))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap)
    ((Equal _ _ _) (let-match erased sb (SbN _ _) (absurd (SbC _ u2 _ _ x1 _ _) (lt-asym i i (sub-lt r u2 i i x1 sb) (lt-weaken i i (sub-lt r u2 i i x1 sb)))))
      (values (Nil (Sy)) v)))
  (let-match erased sb (SbC _ u1 _ _ x nt sb1) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let ((many y) (unique v1)) (sv-sym r v i x nt))
  (let ((many ys) (unique v2)) (notail $ sv-list r v1 (Succ i) j u1 sb1))
  (values (Cons (Sy) y ys) v2))

(def-fns _ $ (erased add-succ-move : (erased (Nat) i n j) (erased (Add (Succ i) n j) ad) -> (erased (Add i (Succ n) j) ad2))
  (let-match erased ad (AddSucc _ _ j1 ad1))
  (add-succ-right i n j1 ad1))

(def-fns _ $ (erased len-snoc : (erased (List (Sy)) p p2) (erased (Nat) i) (erased (Sy) x) (subterm erased (Length (Sy) p i) lp) (erased (Cat (Sy) p (Cons (Sy) x (Nil (Sy))) p2) c)
    -> (erased (Length (Sy) p2 (Succ i)) l))
  (let-match erased lp (LengthCons _ a p1 i1 lp1)
    ((LengthNil _) (let-match erased c (CatN _ _)) (LengthCons _ x (Nil (Sy)) (Zero) (LengthNil _))))
  (let-match erased c (CatC _ _ _ _ q1 c1))
  (LengthCons _ a q1 (Succ i1) (len-snoc p1 q1 i1 x lp1 c1)))

(def-fns _ $ (erased cat-nth : (erased (List (Sy)) p v r) (erased (Nat) i) (erased (Sy) x) (subterm erased (Cat (Sy) p (Cons (Sy) x v) r) c) (erased (Length (Sy) p i) lp)
    -> (erased (Nth (Sy) r i x) nt))
  (let-match erased c (CatC _ a p1 _ r1 c1) ((CatN _ _) (let-match erased lp (LengthNil _)) (NthHere _ x v)))
  (let-match erased lp (LengthCons _ _ _ i1 lp1))
  (NthThere _ a r1 i1 x (cat-nth p1 v r1 i1 x c1 lp1)))

(def-fns _ $ (erased sub-of : (erased (List (Sy)) r p u) (erased (Nat) i n) (subterm erased (List (Sy)) v) (erased (Cat (Sy) p v r) c) (erased (Length (Sy) p i) lp)
    (erased (Length (Sy) v n) lv) -> (erased (Nat) j) (erased (Add i n j) ad) (erased (Sub r i j v) sb))
  (let-match erased v (Cons _ x v1) ((Nil _) (let-match erased lv (LengthNil _)) (values i (add-zero-right i) (SbN r i))))
  (let-match erased lv (LengthCons _ _ _ n1 lv1))
  (let ((erased p2) (erased c2)) (cat-ex (Sy) p (Cons (Sy) x (Nil (Sy)))))
  (let ((erased c3)) (cat-one-r p p2 v1 r x c2 c))
  (let ((erased j) (erased ad) (erased sb)) (sub-of r p2 v1 (Succ i) n1 v1 c3 (len-snoc p p2 i x lp c2) lv1))
  (values j (add-succ-move i n1 j ad) (SbC r v1 i j x (cat-nth p v1 r i x c lp) sb)))
