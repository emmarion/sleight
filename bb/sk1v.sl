      ((LvGo d2 l2 w2 F2 R2 rv2 wl2 lw2 cr2 k2 z2 zv2 lz2 nx2 sk2) (tail $ lrun-v d2 l2 w2 F2 R2 rv2 wl2 lw2 cr2 k2 z2 zv2 lz2 nx2 sk2 f))
      ((LvNo _ _) (RFail _))
