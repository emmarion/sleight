  (lv-fold l W F R2 rv4 nW lW cWR k2 z2 zv4 (LzS l w W m k k2 lz sw kt) (sw-nx (Zero) 1 m w W sw)))

(def-fns _
  ((many mrun-v : (many (Cf) c) (erased (MRun sk1-blank c) mr) (unique (Sv (Nil (Sy))) rv zv) (subterm many (Nat) fuel) -> (many (Res (MainOK)) r))
