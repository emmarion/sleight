    ((TgQP) (let-match erased e (EcQP _)) (simple-p-v c0 F R rv1 l x0 wl lw cr (BFalse) tr))
    (else (WvNo c0 F R rv1 (BFalse)))))

(def-fns _ $ (many simple-l-v : (many (List (Sy)) l) (erased (List (Sy)) w F R) (unique (Sv R) rv) (many (Nat) wl) (erased (Length (Sy) w wl) lw)
