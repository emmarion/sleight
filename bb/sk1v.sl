    (let-match many (lz-go d2 l2 w2 k2 lz2) (MrOk c mr) ((MrNo) (RFail _)))
    (tail $ mrun-v c mr r0 z0 f)))

(def-fns _ $ (many main-run-v : -> (many (Res (MainOK)) r))
