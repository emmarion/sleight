  (let ((unique tv2)) (bv-set-top w0 ts tv (coerce t cu)))
  (let ((unique cv2)) (av-set-top (Nat) c0 cs cv c))
  (u _ _ _ (at) tv2 (at) cv2 (EnC s2 r t w c ts cs cu e en1)))

(def-fns _ $ (many sv-drop : (erased (List (Sy)) p ys r) (unique (Sv r) v) (many (Nat) k) (erased (Cat (Sy) p ys r) c) (erased (Length (Sy) p k) lk)
    -> (unique (Sv ys) v2 at v))
