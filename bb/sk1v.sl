        ((QG2) (rule-v c0 F R rv (DL) l w wl lw cr (BFalse) tr r-g2 k-g2))))
    (else (WvNo c0 F R rv (BFalse)))))

(def-fns _ $ (many lz-simple-v : (many (Mv) d) (many (List (Sy)) l) (erased (List (Sy)) w F R) (unique (Sv R) rv) (many (Nat) wl) (erased (Length (Sy) w wl) lw)
    (erased (Cat (Sy) w (Cons (Sy) iD F) R) cr) (erased (Zk) k) (many (Zm k F) z) (unique (Sv (Nil (Sy))) zv) (erased (Lz k d l w) lz) (erased (Nx w) nx) (many (Bool) sk)
