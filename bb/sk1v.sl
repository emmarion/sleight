  (let-match erased cr1 (CatC _ _ _ _ R2 cr2))
  (let-match erased cr2 (CatC _ _ _ _ R3 _))
  (let ((many t) (erased c) (erased e) (unique rv1)) (sv-tag R rv (Succ (Succ (Zero))) y (NthThere _ iP R1 (Succ (Zero)) y (NthThere _ iD R2 (Zero) y (NthHere _ y R3)))))
  (match many t _
