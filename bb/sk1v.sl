(def-fns _ $ (erased add-succ-move : (erased (Nat) i n j) (erased (Add (Succ i) n j) ad) -> (erased (Add i (Succ n) j) ad2))
  (let-match erased ad (AddSucc _ _ j1 ad1))
  (add-succ-right i n j1 ad1))

; Lq zs tps cps p cap: logical symbol i of zs (0 the top) is encoded at physical index p+i, so zs fills [p, cap).
(def-adts
  ((Lq : ((List (Sy)) zs) ((List (U8)) tps) ((List (Copy (Nat))) cps) ((Nat) p cap) -> Type)
    enum
    (many LqN : (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) cap) -> (Lq (Nil (Sy)) tps cps cap cap))
    (many LqC : (erased (Sy) s) (erased (List (Sy)) zs) (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps)
       (erased (Nat) p cap) (erased (Lq zs tps cps (Succ p) cap) lq) (erased (Nth (U8) tps p u) nu) (erased (Nth (Copy (Nat)) cps p (MkCopy (Nat) c)) nc)
       (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e) -> (Lq (Cons (Sy) s zs) tps cps p cap))))

(def-fns _ $ (erased lq-le : (erased (List (Sy)) zs) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) p cap)
    (erased (Lq zs tps cps p cap) lq) (erased (Length (U8) tps cap) l) -> (erased (Lt p (Succ cap)) le))
  (let-match erased lq (LqC _ _ _ _ _ _ _ _ _ _ nu _ _ _) ((LqN _ _ _) (lt-succ cap)))
  (lt-weaken p cap (nth-lt-length _ tps p cap _ nu l)))

(def-fns _ $ (erased lq-length : (erased (List (Sy)) zs) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) p cap)
    (subterm erased (Lq zs tps cps p cap) lq) -> (erased (Nat) k) (erased (Length (Sy) zs k) l) (erased (Add p k cap) ad))
  (let-match erased lq (LqC s zs1 _ _ _ _ _ _ _ lq1 _ _ _ _) ((LqN _ _ _) (values (Zero) (LengthNil _) (add-zero-right cap))))
  (let ((erased k1) (erased l1) (erased ad1)) (lq-length zs1 tps cps (Succ p) cap lq1))
  (values (Succ k1) (LengthCons _ s zs1 k1 l1) (add-succ-move p k1 cap ad1)))

(def-fns _ $ (erased lq-set : (erased (List (Sy)) zs) (erased (List (U8)) tps tps2) (erased (List (Copy (Nat))) cps cps2) (erased (Nat) p cap i) (erased (U8) w) (erased (Copy (Nat)) y)
    (subterm erased (Lq zs tps cps p cap) lq) (erased (SetNth (U8) tps i w tps2) st1) (erased (SetNth (Copy (Nat)) cps i y cps2) st2) (erased (Lt i p) lt)
    -> (erased (Lq zs tps2 cps2 p cap) r))
  (let-match erased lq (LqC s zs1 t u c _ _ _ _ lq1 nu nc cu e) ((LqN _ _ _) (LqN tps2 cps2 cap)))
  (LqC s zs1 t u c tps2 cps2 p cap (lq-set zs1 tps tps2 cps cps2 (Succ p) cap i w y lq1 st1 st2 (lt-weaken i p lt))
    (setnth-nth-gt _ tps i p w u tps2 st1 nu lt) (setnth-nth-gt _ cps i p y _ cps2 st2 nc lt) cu e))

(def-fns _ $ (erased lq-move : (erased (List (Sy)) zs) (erased (List (U8)) stp yt dtp0 dtp) (erased (List (Copy (Nat))) scp yc dcp0 dcp)
    (erased (Nat) p0 p capS k j t m capD)
    (subterm erased (Lq zs stp scp p capS) lq) (erased (Length (U8) stp capS) ls)
    (erased (Splice (U8) stp p0 k yt stp) ft) (erased (Splice (U8) dtp0 j k yt dtp) tt) (erased (Splice (Copy (Nat)) scp p0 k yc scp) fc) (erased (Splice (Copy (Nat)) dcp0 j k yc dcp) tc)
    (erased (Add p0 k capS) ae) (erased (Add p0 t p) ap) (erased (Add j t m) am) (erased (Add j k capD) ad)
    -> (erased (Lq zs dtp dcp m capD) lq2))
  (let-match erased lq (LqC s zs1 tg u c _ _ _ _ lq1 nu nc cu ec)
    ((LqN _ _ _)
      (let-match erased (add-cancel p0 t k capS ap ae) (Refl _ _))
      (let-match erased (add-fn j k m capD am ad) (Refl _ _))
      (LqN dtp dcp capD)))
  (let ((erased lt)) (nth-lt-length _ stp p capS u nu ls))
  (LqC s zs1 tg u c dtp dcp m capD
    (lq-move zs1 stp yt dtp0 dtp scp yc dcp0 dcp p0 (Succ p) capS k j (Succ t) (Succ m) capD lq1 ls ft tt fc tc ae (add-succ-right p0 t p ap) (add-succ-right j t m am) ad)
    (splice-move (U8) stp yt dtp0 dtp p0 j k t p capS m u ft tt nu ap ae lt am)
    (splice-move (Copy (Nat)) scp yc dcp0 dcp p0 j k t p capS m _ fc tc nc ap ae lt am) cu ec))

(def-adts $ (Qv : ((List (Sy)) zs) -> Type)
  enum
  (many MkQv : (erased (List (Sy)) zs) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) p) (erased (Nat) cap)
     (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Lq zs tps cps p cap) lq)
     (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) -> (Qv zs)))

(def-fns _ $ (many qv-new : (many (Nat) cap) -> (unique (Qv (Nil (Sy))) v))
  (let ((erased tps) (unique tb) (erased rt)) (bytes-make cap (MkU8 0 u8l0)))
  (let ((erased cps) (unique ca) (erased rc)) (array-make (Nat) cap 0))
  (MkQv _ tps cps cap cap (repeat-length _ _ _ _ rt) (repeat-length _ _ _ _ rc) (LqN tps cps cap) tb ca))

(def-fns _ $ (many qv-len : (erased (List (Sy)) zs) (unique (Qv zs) v) -> (many (Nat) n) (erased (Length (Sy) zs n) l) (unique v is v2 at v))
  (let-match unique v (MkQv _ tps cps p cap l1 l2 lq tb ca u))
  (let ((many len) (erased lt0) (unique tb0)) (bytes-length _ tb))
  (let-match erased (length-fn (U8) tps len cap lt0 l1) (Refl _ _))
  (let ((erased k) (erased lk) (erased ak)) (lq-length zs tps cps p cap lq))
  (let ((many d) (erased ad) (unique tb1)) (sv-sub tps cap tb0 l1 len p (lt-succ cap) (lq-le zs tps cps p cap lq l1)))
  (let-match erased (add-cancel p d k cap ad ak) (Refl _ _))
  (values d lk (at unique (u zs tps cps p cap l1 l2 lq tb1 ca))))

(def-adts
  ((Qt : ((List (Sy)) zs) -> Type)
    enum
    (many QtN : -> (Qt (Nil (Sy))))
    (many QtC : (erased (Sy) x) (erased (List (Sy)) zs) -> (Qt (Cons (Sy) x zs)))))

(def-fns _ $ (many qv-top : (erased (List (Sy)) zs) (unique (Qv zs) v) -> (many (Qt zs) q) (unique v is v2 at v))
  (let-match unique v (MkQv _ tps cps p cap l1 l2 lq tb ca u))
  (let ((many len) (erased lt0) (unique tb0)) (bytes-length _ tb))
  (let-match erased (length-fn (U8) tps len cap lt0 l1) (Refl _ _))
  (let ((unique v2)) (at unique (u zs tps cps p cap l1 l2 lq tb0 ca)))
  (let-match many (nat-eq p len) (Unequal _ _ _ _ ap)
    ((Equal _ _ _) (let-match erased lq (LqN _ _ _) (absurd (LqC _ _ _ _ _ _ _ _ _ _ nu _ _ _) (lt-asym p p (nth-lt-length _ tps p p _ nu l1) (lt-weaken p p (nth-lt-length _ tps p p _ nu l1))))) (values (QtN) v2)))
  (let-match erased lq (LqC x zs0 _ _ _ _ _ _ _ _ _ _ _ _) (absurd (LqN _ _ _) (apart-irrefl p ap)))
  (values (QtC x zs0) v2))

(def-fns _ $ (many qv-put : (erased (List (Sy)) zs) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) p) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Lq zs tps cps (Succ p) cap) lq) (erased (Lt p cap) lt)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    -> (erased (List (U8)) tps2) (erased (List (Copy (Nat))) cps2) (erased (Length (U8) tps2 cap) l3) (erased (Length (Copy (Nat)) cps2 cap) l4)
    (erased (Lq (Cons (Sy) s zs) tps2 cps2 p cap) lq2) (unique (Bytes tps2) tb2 at tb) (unique (Array (Copy (Nat)) cps2) ca2 at ca))
  (let ((erased w) (erased cu) (erased tps2) (erased cps2) (erased st1) (erased st2) (erased l3) (erased l4) (unique tb2) (unique ca2))
    (vput tps cps p cap l1 l2 lt tb ca t c))
  (values tps2 cps2 l3 l4
    (LqC s zs t w c tps2 cps2 p cap (lq-set zs tps tps2 cps cps2 (Succ p) cap p w _ lq st1 st2 (lt-succ p))
      (setnth-nth _ tps p w tps2 st1) (setnth-nth _ cps p (MkCopy _ c) cps2 st2) cu e)
    tb2 ca2))

(def-fns _ $ (many qv-store : (erased (List (Sy)) zs) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (many (Nat) p0 p) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Lq zs tps cps p cap) lq) (erased (Lt p0 (Succ cap)) b0)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (unique (Cell MkQv (slot-of p0) (slot-of tb) (slot-of ca)) u) -> (unique (Qv zs) v at u))
  (let ((many d) (unique tb1)) (cap-dec tps cap tb l1))
  (let-match many d (Yes _ _ _ _ q) ((No _ _ _ _ _) (u zs tps cps p cap l1 l2 lq (at) tb1 (at) ca)))
  (u zs tps cps (imm (imm-le p0 cap b0 q) (imm-le p cap (lq-le zs tps cps p cap lq l1) q)) p cap l1 l2 lq (at) tb1 (at) ca))

(def-fns _ $ (many qv-grow-push : (erased (List (Sy)) zs) (erased (List (U8)) tps) (erased (List (Copy (Nat))) cps) (erased (Nat) cap)
    (erased (Length (U8) tps cap) l1) (erased (Length (Copy (Nat)) cps cap) l2) (erased (Lq zs tps cps (Zero) cap) lq)
    (unique (Bytes tps) tb) (unique (Array (Copy (Nat)) cps) ca) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    (erased (Slot) s1 s2 s3) (unique (Cell MkQv s1 s2 s3) u) -> (unique (Qv (Cons (Sy) s zs)) v at u))
  (let ((many len) (erased lt0) (unique tb0)) (bytes-length _ tb))
  (let-match erased (length-fn (U8) tps len cap lt0 l1) (Refl _ _))
  (let ((many c2) (erased ad)) (add len len))
  (let ((many cap2)) (Succ c2))
  (let ((erased aj)) (AddSucc len len c2 ad))
  (let ((erased qt) (unique bt) (erased rt)) (bytes-make cap2 (MkU8 0 u8l0)))
  (let ((erased lqt)) (repeat-length _ _ _ _ rt))
  (let ((erased ys) (erased fr)) (splice-range _ tps len l1 (Zero) len len (AddZero len) (lt-succ len)))
  (let ((erased old) (erased to)) (splice-range _ qt cap2 lqt (Succ len) len cap2 aj (lt-succ cap2)))
  (let ((erased zt) (unique bt2) (erased sp)) (bytes-blit-many _ _ ys old (share tb0) (Zero) bt (Succ len) len fr to))
  (let ((erased qc) (unique bc) (erased rc)) (array-make (Nat) cap2 0))
  (let ((erased lqc)) (repeat-length _ _ _ _ rc))
  (let ((erased ysc) (erased frc)) (splice-range _ cps len l2 (Zero) len len (AddZero len) (lt-succ len)))
  (let ((erased oldc) (erased toc)) (splice-range _ qc cap2 lqc (Succ len) len cap2 aj (lt-succ cap2)))
  (let ((erased zc) (unique bc2) (erased spc)) (array-blit-many _ _ _ ysc oldc (share ca) (Zero) bc (Succ len) len frc toc))
  (let ((erased lzt)) (splice-length _ qt ys zt (Succ len) len cap2 sp lqt))
  (let ((erased lzc)) (splice-length _ qc ysc zc (Succ len) len cap2 spc lqc))
  (let ((erased lq1)) (lq-move zs tps ys qt zt cps ysc qc zc (Zero) (Zero) len len (Succ len) (Zero) (Succ len) cap2 lq l1 fr sp frc spc
    (AddZero len) (AddZero (Zero)) (add-zero-right (Succ len)) aj))
  (let ((erased tps3) (erased cps3) (erased l3) (erased l4) (erased lq2) (unique tb3) (unique ca3))
    (qv-put zs zt zc len cap2 lzt lzc lq1 (add-le-left len len c2 ad) bt2 bc2 t c s e))
  (u _ tps3 cps3 len cap2 l3 l4 lq2 tb3 ca3))

(def-fns _ $ (many qv-push : (erased (List (Sy)) zs) (unique (Qv zs) v) (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e)
    -> (unique (Qv (Cons (Sy) s zs)) v2 at v))
  (let-match unique v (MkQv _ tps cps p cap l1 l2 lq tb ca u))
  (let-match many p (Succ p1) ((Zero) (qv-grow-push zs tps cps cap l1 l2 lq tb ca t c s e _ _ _ u)))
  (let ((erased b0)) (lq-le zs tps cps p cap lq l1))
  (let-match erased b0 (LtS _ _ lt))
  (let ((erased tps2) (erased cps2) (erased l3) (erased l4) (erased lq2) (unique tb2) (unique ca2)) (qv-put zs tps cps p1 cap l1 l2 lq lt tb ca t c s e))
  (qv-store _ tps2 cps2 p p1 cap l3 l4 lq2 b0 tb2 ca2 u))

