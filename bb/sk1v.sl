(def-fns _ $ (many sv-cur : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) (erased (Sy) x) (erased (Nth (Sy) r i x) nt)
    -> (many (Nat) q) (erased (Nat) nr) (erased (Length (Sy) r nr) lr) (erased (Add i q nr) aq) (unique v is v2 at v))
