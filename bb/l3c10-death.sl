(def-fns _ $ (many rq-norm : (many (Rq) t) -> (many (Rq) t2))
  (let-match many t (MkRq q L h R))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let ((many L2) (erased _)) (rnorm L l dl))
  (let ((many R2) (erased _)) (rnorm R r dr))
  (MkRq q L2 h R2))

(def-fns _ $ (many death-end : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Rq) t) -> (many (Rs l3 c0) res))
  (let-match many e (MkRq _ L _ _))
  (let-match many t (MkRq _ Lt _ _))
  (let-match many (c-wr-n (nat-shr (monus (rlen L 0) (rlen Lt 0)) 1) (BFalse) c0 e ch) (RsNo _ _ _ _)
    ((RsOk _ _ e1 ch1) (match many (rq-same e1 t) _ ((ESome _ _) (RsOk l3 c0 e1 ch1)) ((ENone _) (RsNo l3 c0 e ch)))))
  (let-match many fuel (Succ f) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many (c-move9 c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (tail $ death-end c0 f e1 ch1 t))

(def-fns _ $ (many c-death : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let ((many lc)) (lmc e))
  (let-match many (m-death lc) (Some _ t) ((None _) no))
  (let-match many lc (LcOk _ _ D _ _ _) ((LcNo) no))
  (let ((many P)) (memp D))
  (let-match many (fd-levels P c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) no))
  (let-match many (death-end c0 64 e1 ch1 (rq-norm t)) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) no))
  (c-certify c0 e2 ch2 0 (Some _ t)))
