(def-fns _ $ (many r-move : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc z))
  (let ((many lm)) (c-lm e c dc))
  (let ((many fr)) (match many (f-jump e lm) (((FRs e) r))
    ((FNo _) (match many (f-round e lm) _ ((FNo _) (match many (f-walk e) _ ((FNo _) (f-mac e)) (else r r))) (else r r)))
    (else r r)))
  (let-match many fr (FNo _)
    ((FOk _ e2 p) (RsOk l3 c0 e2 (fsq-rch c0 e e2 (FsC e e e2 (FsN e) p) ch))))
  (let ((many ri)) (try-ident c0 e ch))
  (let-match many ri (RsNo _ _ _ _) ((RsOk _ _ _ _) ri))
  (let ((many rs)) (try-sweep3 c0 e ch))
  (let-match many rs (RsNo _ _ _ _) ((RsOk _ _ _ _) rs))
  (let-match many (f-step e) (FOk _ e2 p) ((FNo _) (RsNo l3 c0 e ch)))
  (RsOk l3 c0 e2 (fsq-rch c0 e e2 (FsC e e e2 (FsN e) p) ch)))

(def-fns _ $ (many r-run : (subterm many (Nat) fuel) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Rq) tgt) -> (many (Rs l3 c0) res))
  (let-match many (rq-eq e tgt) (ENone _) ((ESome _ _) (RsOk l3 c0 e ch)))
  (let-match many fuel (Succ f) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many (r-move c0 e ch) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (tail $ r-run f c0 e2 ch2 tgt))

(def-fns _ $ (many train-r : (many (Bool) g1) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many (train-tgt g1 c0 e ch) (Some _ t) ((None _) (RsNo l3 c0 e ch)))
  (r-run 1000000 c0 e ch t))

(def-fns _ $ (many try-train2 : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (train-r (BFalse) c0 e ch))

(def-fns _ $ (many try-traing2 : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (train-r (BTrue) c0 e ch))
