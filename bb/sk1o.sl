  (let-match many c (Succ c1) ((Zero) (NzN)))
  (NzY _ (NzF c1)))

(def-fns _ $ (many tpush-m : (many (Pk) k) (erased (Bool) b b2) (erased (Nat) c c2) (many (Bool) b3) (many (Nat) c3) (erased (List (Sy)) t0)
