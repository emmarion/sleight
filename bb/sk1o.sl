  (tpush-m k (BFalse) b2 c c2 b2 c3 t0 v3 nz (cn-add-f b2 c c2 c3 ad)))

(def-adts
  ((XvR : ((Am) xs v) ((List (Sy)) r) ((Nat) i j) ((List (Sy)) u) -> Type)
