          (let-match many p2 (PvOk _ _ _ _ pu2) ((PvNo _ _ _) (let ((erased t4) (unique ov4) (many r4)) (tso-no (MkAm xb xc) n u t3 ov3)) (values rv2 t4 ov4 r4)))
          (values rv2 t3 ov3 (TsoY _ n u t3 (TStC _ _ n n2 n4 u0 t1 t2 t3 (MkCnSub n xc dc xb ad) a2 a4 s1 pu pu2))))
        ((TgR)
