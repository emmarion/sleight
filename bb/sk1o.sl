    (many PvNo : (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t) -> (Pv k n t t))))

(def-fns _ $ (many kb-tag : (many (Pk) k) (many (Bool) b) (erased (Nat) c) -> (many (Tg) t) (erased (Ecd (YW k (MkAm b c)) t c) e))
