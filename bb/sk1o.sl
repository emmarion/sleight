(def-adts
  ((Su : ((List (Sy)) r) -> Type)
    enum
    (many SuN : (unique (Sv (Nil (Sy))) v) -> (Su (Nil (Sy))))
    (many SuC : (many (Sy) s) (erased (List (Sy)) r) (unique (Sv r) v) -> (Su (Cons (Sy) s r)))))

(def-fns _ $ (many sv-uncons : (erased (List (Sy)) r) (unique (Sv r) v) -> (unique (Su r) res))
  (let ((many n) (erased ln) (unique v1)) (sv-len r v))
  (let-match many n (Succ n1) ((Zero) (let-match erased ln (LengthNil _)) (SuN v1)))
  (let-match erased ln (LengthCons _ x r0 _ _))
  (let ((many y) (unique v2)) (sv-sym _ v1 0 x (NthHere _ x r0)))
  (SuC y r0 (sv-pop x r0 v2)))

(def-fns _ $ (many sv-cons : (many (Sy) s) (erased (List (Sy)) r) (unique (Sv r) v) -> (unique (Sv (Cons (Sy) s r)) v2 at v))
  (let ((many t) (many c) (erased e)) (enc-sy s))
  (sv-push r v t c s e))

(def-fns _ $ (many tnk-hd : (many (Pk) k) (many (Sy) s) (erased (List (Sy)) t0) -> (many (Maybe (TNk k (Cons (Sy) s t0))) r))
  (let-match many s (YW k2 n)
    ((YF f) (Some _ (TNF k f t0)))
    ((YC) (Some _ (TNC k t0)))
    ((YE) (Some _ (TNE k t0)))
    ((YV) (Some _ (TNV k t0)))
    ((YR b) (Some _ (TNR k b t0))))
  (match many (pk-cmp k k2) _ ((PkNe _ _ ne) (Some _ (TNW k k2 n t0 ne))) ((PkEq _) (None _))))

(def-adts
  ((Pv : ((Pk) k) ((Am) n) ((List (Sy)) t) -> Type)
    enum
    (many PvOk : (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t t2) (unique (Sv t2) v) (erased (TPush k n t t2) p) -> (Pv k n t))
    (many PvNo : (erased (Pk) k) (erased (Am) n) (erased (List (Sy)) t) (unique (Sv t) v) -> (Pv k n t))))

(def-fns _ $ (many tpush-sv : (many (Pk) k) (many (Am) n) (erased (List (Sy)) t) (unique (Sv t) v) -> (unique (Pv k n t) r))
  (let-match many (nz-of n) (NzY _ nz) ((NzN) (PvOk k n t t v (TPZ k t))))
  (match unique (sv-uncons t v) _
    ((SuN v1) (PvOk k n t _ (sv-cons (YW k n) _ v1) (TPC k n t nz (TNN k))))
    ((SuC s t0 v1)
      (let-match many (tnk-hd k s t0) (None _) ((Some _ nk) (PvOk k n t _ (sv-cons (YW k n) _ (sv-cons s t0 v1)) (TPC k n t nz nk))))
      (let-match many s (YW k2 m) (else (PvNo k n t (sv-cons s t0 v1))))
      (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ _) (PvNo k n t (sv-cons s t0 v1))))
      (let-match many (cn-add n m) (CaOk _ _ s3 ca) ((CaNo _ _) (PvNo k n t (sv-cons s t0 v1))))
      (PvOk k n t _ (sv-cons (YW k s3) t0 v1) (TPM k n m s3 t0 nz ca)))))

(def-adts
  ((XvR : ((Am) xs v) ((List (Sy)) r) ((Nat) i j) ((List (Sy)) u) -> Type)
    enum
    (many XvY : (erased (Am) v) (erased (List (Sy)) r) (erased (Nat) i j) (erased (List (Sy)) u) (erased (Nz v) nz) (erased (Sub r (Succ i) j u) sb)
       -> (XvR az v r i j (Cons (Sy) iD u)))
    (many XvN : (erased (Am) xs v) (erased (List (Sy)) r) (erased (Nat) i j) (erased (List (Sy)) u) -> (XvR xs v r i j u))))

(def-fns _ $ (many xd-v : (many (Am) xs v) (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (erased (Sub r i j u) sb)
    (many (Nat) q) (erased (Nat) nr) (erased (Length (Sy) r nr) lr) (erased (Add i q nr) aq) (erased (Lt j (Succ nr)) jn) (erased (Lt nr u62-modulus) bd) -> (unique rv is rv2 at rv) (many (XvR xs v r i j u) res))
  (let-match many (nz-of xs) (NzN) ((NzY _ _) (values rv (XvN xs v r i j u))))
  (let-match many (nz-of v) (NzY _ nz) ((NzN) (values rv (XvN az v r i j u))))
  (let-match many (u62-eq i j (add-bd i q nr aq bd) (le-bd j nr jn bd)) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values rv (XvN az v r i j u))))
  (let-match erased sb (SbC _ u1 _ _ x nt sb1) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let-match erased q (Succ q1e) (absurd (Zero) (sw-q0 r i nr x nt lr aq)))
  (let ((many q1)) (u62-dec q1e q (add-bd q i nr (add-comm i q nr aq) bd)))
  (let ((many t) (erased c) (erased e) (unique rv1)) (sv-tagp r rv q1 i nr x nt lr (add-shift i q1 nr aq)))
  (let-match many t (TgQD) (else (values rv1 (XvN az v r i j u))))
  (let-match erased e (EcQD _))
  (values rv1 (XvY v r i j u1 nz sb1)))

(def-adts
  ((Tso : ((Am) xs) ((Nat) n) ((List (Sy)) u) -> Type)
    enum
    (many TsoY : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) u t2) (unique (Sv t2) ov) (erased (TSt xs n u t2) p) -> (Tso xs n u))
    (many TsoN : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) u) (unique (Sv (Nil (Sy))) ov) -> (Tso xs n u))))

(def-fns _ $ (many tso-push : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) u) (erased (Pk) k) (erased (Am) m) (erased (List (Sy)) t) (unique (Pv k m t) p)
    -> (unique (Tso xs n u) r))
  (TsoN xs n u (match unique p _ ((PvOk _ _ _ t2 v _) (sv-clear t2 v)) ((PvNo _ _ _ v) (sv-clear t v)))))

(def-fns _ $ (many tstride-p : (many (Am) xs) (many (Nat) n) (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Sub r i j u) sb)
    (unique (Sv (Nil (Sy))) ov) (many (Nat) q) (erased (Nat) nr) (erased (Length (Sy) r nr) lr) (erased (Add i q nr) aq) (erased (Lt j (Succ nr)) jn) (erased (Lt nr u62-modulus) bd) -> (unique rv is rv2 at rv) (unique (Tso xs n u) res))
  (let-match many (u62-eq i j (add-bd i q nr aq bd) (le-bd j nr jn bd)) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values rv (TsoN xs n u ov))))
  (let-match erased sb (SbC _ u0 _ _ x nt sb1) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let-match erased q (Succ q1e) (absurd (Zero) (sw-q0 r i nr x nt lr aq)))
  (let ((many q1)) (u62-dec q1e q (add-bd q i nr (add-comm i q nr aq) bd)))
  (let ((erased aq1)) (add-shift i q1 nr aq))
  (let ((erased b1)) (add-bd (Succ i) q1 nr aq1 bd))
  (let ((many s) (unique rv1)) (sv-symp r rv q1 i nr x nt lr aq1))
  (match many s _
    ((YF f)
      (match many f _
        ((QP)
          (let ((many i1)) (u62-inc i b1))
          (let-match many (u62-eq i1 j b1 (le-bd j nr jn bd)) (Unequal _ _ _ _ ap1) ((Equal _ _ _) (values rv1 (TsoN xs n u ov))))
          (let-match erased sb1 (SbC _ u1 _ _ x1 nt1 sb2) (absurd (SbN _ _) (apart-irrefl (Succ i) ap1)))
          (let-match erased q1 (Succ q2e) (absurd (Zero) (sw-q0 r (Succ i) nr x1 nt1 lr aq1)))
          (let ((many q2)) (u62-dec q2e q1 (add-bd q1 (Succ i) nr (add-comm (Succ i) q1 nr aq1) bd)))
          (let ((erased aq2)) (add-shift (Succ i) q2 nr aq1))
          (let ((many s1) (unique rv2)) (sv-symp r rv1 q2 (Succ i) nr x1 nt1 lr aq2))
          (let-match many s1 (YE) (else (values rv2 (TsoN xs n u ov))))
          (let ((erased b2)) (add-bd (Succ (Succ i)) q2 nr aq2 bd))
          (let-match many (u62-eq (u62-inc i1 b2) j b2 (le-bd j nr jn bd)) (Equal _ _ _) ((Unequal _ _ _ _ _) (values rv2 (TsoN xs n u ov))))
          (let-match erased (sub-nil r u1 (Succ (Succ i)) sb2) (Refl _ _))
          (let ((unique ov1)) (sv-cons iP _ (sv-cons (YE) _ ov)))
          (let-match unique (tpush-sv (KX) xs u ov1) (PvOk _ _ _ t2 ov2 pu) ((PvNo _ _ _ ov2) (values rv2 (TsoN xs n u (sv-clear u ov2)))))
          (values rv2 (TsoY xs n u t2 ov2 (TStP xs n t2 pu))))
        ((QD)
          (let ((unique rv2) (unique r1)) (notail $ tstride-p az n r rv1 (u62-inc i b1) j u0 sb1 ov q1 nr lr aq1 jn bd))
          (let-match unique r1 (TsoY _ _ _ t1 ov1 s1) ((TsoN _ _ _ ov1) (values rv2 (TsoN xs n u ov1))))
          (let ((unique ov2)) (sv-cons iD t1 ov1))
          (let-match many (nz-of xs) (NzY _ nz) ((NzN) (values rv2 (TsoY xs n u _ ov2 (TStD xs n u0 t1 _ s1 (TPZ (KX) _))))))
          (values rv2 (TsoY xs n u _ (sv-cons (YW (KX) xs) _ ov2) (TStD xs n u0 t1 _ s1 (TPC (KX) xs _ nz (TNF (KX) (QD) t1))))))
        (else (values rv1 (TsoN xs n u ov)))))
    ((YC)
      (let-match many (cn-sub n xs) (CsOk _ _ d cs) ((CsNo _ _) (values rv1 (TsoN xs n u ov))))
      (let ((many n2) (erased a2)) (add n n))
      (let ((many n4) (erased a4)) (add n2 n2))
      (let ((unique rv2) (unique r1)) (notail $ tstride-p az n4 r rv1 (u62-inc i b1) j u0 sb1 ov q1 nr lr aq1 jn bd))
      (let-match unique r1 (TsoY _ _ _ t1 ov1 s1) ((TsoN _ _ _ ov1) (values rv2 (TsoN xs n u ov1))))
      (let-match unique (tpush-sv (KX) (MkAm (BFalse) n2) t1 ov1) (PvOk _ _ _ t2 ov2 pu) (else p (values rv2 (tso-push xs n u (KX) _ t1 p))))
      (let-match unique (tpush-sv (KX) d _ (sv-cons (YC) t2 ov2)) (PvOk _ _ _ t3 ov3 pu2) (else p (values rv2 (tso-push xs n u (KX) d _ p))))
      (values rv2 (TsoY xs n u t3 ov3 (TStC xs d n n2 n4 u0 t1 t2 t3 cs a2 a4 s1 pu pu2))))
    ((YW k v)
      (match many k _
        ((KX)
          (let ((unique rv2) (many xd)) (xd-v xs v r rv1 (u62-inc i b1) j u0 sb1 q1 nr lr aq1 jn bd))
          (let-match many xd (XvN _ _ _ _ _ _)
            ((XvY _ _ _ _ u3 nz _)
              (let-match erased sb1 (SbC _ _ _ _ _ nt3 sb3))
              (let-match erased q1 (Succ q2e) (absurd (Zero) (sw-q0 r (Succ i) nr iD nt3 lr aq1)))
              (let ((many q2)) (u62-dec q2e q1 (add-bd q1 (Succ i) nr (add-comm (Succ i) q1 nr aq1) bd)))
              (let ((erased aq2)) (add-shift (Succ i) q2 nr aq1))
              (let ((unique rv3) (unique r1)) (notail $ tstride-p az n r rv2 (u62-inc (u62-inc i b1) (add-bd (Succ (Succ i)) q2 nr aq2 bd)) j u3 sb3 ov q2 nr lr aq2 jn bd))
              (let-match unique r1 (TsoY _ _ _ t2 ov1 s1) ((TsoN _ _ _ ov1) (values rv3 (TsoN xs n u ov1))))
              (let ((unique ov2)) (sv-cons iD t2 ov1))
              (values rv3 (TsoY xs n u _ (sv-cons s _ ov2)
                (TStX az v v n u0 _ (cn-add-z v) (TStD v n u3 t2 _ s1 (TPC (KX) v (Cons (Sy) iD t2) nz (TNF (KX) (QD) t2))))))))
          (let-match many (cn-add xs v) (CaOk _ _ xs2 ca) ((CaNo _ _) (values rv2 (TsoN xs n u ov))))
          (let ((unique rv3) (unique r1)) (notail $ tstride-p xs2 n r rv2 (u62-inc i b1) j u0 sb1 ov q1 nr lr aq1 jn bd))
          (let-match unique r1 (TsoY _ _ _ t2 ov1 s1) ((TsoN _ _ _ ov1) (values rv3 (TsoN xs n u ov1))))
          (values rv3 (TsoY xs n u t2 ov1 (TStX xs v xs2 n u0 t2 ca s1))))
        ((KG)
          (let ((unique rv2) (unique r1)) (notail $ tstride-p az n r rv1 (u62-inc i b1) j u0 sb1 ov q1 nr lr aq1 jn bd))
          (let-match unique r1 (TsoY _ _ _ t1 ov1 s1) ((TsoN _ _ _ ov1) (values rv2 (TsoN xs n u ov1))))
          (let-match unique (tpush-sv (KG) v t1 ov1) (PvOk _ _ _ t2 ov2 pu) (else p (values rv2 (tso-push xs n u (KG) v t1 p))))
          (let-match unique (tpush-sv (KX) xs t2 ov2) (PvOk _ _ _ t3 ov3 pu2) (else p (values rv2 (tso-push xs n u (KX) xs t2 p))))
          (values rv2 (TsoY xs n u t3 ov3 (TStG xs v n u0 t1 t2 t3 s1 pu pu2))))
        (else (values rv1 (TsoN xs n u ov)))))
    ((YR b)
      (let-match many (u62-eq (u62-inc i b1) j b1 (le-bd j nr jn bd)) (Equal _ _ _) ((Unequal _ _ _ _ _) (values rv1 (TsoN xs n u ov))))
      (let-match erased (sub-nil r u0 (Succ i) sb1) (Refl _ _))
      (let-match many (lt-dec n (Succ b)) (Yes _ _ _ _ p) ((No _ _ _ _ _) (values rv1 (TsoN xs n u ov))))
      (let ((many b2) (erased ad)) (sub b n p))
      (let-match unique (tpush-sv (KX) xs _ (sv-cons (YR b2) _ ov)) (PvOk _ _ _ t2 ov2 pu) (else q (values rv1 (tso-push xs n u (KX) xs _ q))))
      (values rv1 (TsoY xs n u t2 ov2 (TStV xs n b b2 t2 ad pu))))
    (else (values rv1 (TsoN xs n u ov)))))

(def-fns _ $ (many tstride-v : (many (Am) xs) (many (Nat) n) (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Sub r i j u) sb)
    (unique (Sv (Nil (Sy))) ov) -> (unique rv is rv2 at rv) (unique (Tso xs n u) res))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values rv (TsoN xs n u ov))))
  (let-match erased sb (SbC _ _ _ _ x nt _) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let ((many q) (erased nr) (erased lr) (erased aq) (unique rv1)) (sv-cur r rv i x nt))
  (let ((many dd) (unique rv2)) (sv-bd r rv1 nr lr))
  (let-match many dd (BdY _ bd) ((BdN _) (values rv2 (TsoN xs n u ov))))
  (tstride-p xs n r rv2 i j u sb ov q nr lr aq (sub-end r u i j nr sb lr (lt-weaken i nr (nth-lt-length _ r i nr x nt lr))) bd))

(def-fns _ $ (many sv-nth : (erased (List (Sy)) r) (unique (Sv r) v) (many (Nat) i) -> (many (Maybe (Sy)) s) (unique v is v2 at v))
  (let ((many n) (erased ln) (unique v1)) (sv-len r v))
  (let-match many (lt-dec i n) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (values (None _) v1)))
  (let ((erased x) (erased nt)) (nth-exists _ r n i ln lt))
  (let ((many y) (unique v2)) (sv-sym r v1 i x nt))
  (values (Some _ y) v2))

(def-adts
  ((Sdv : ((Bool) e) ((List (Sy)) lp lp2 l) -> Type)
    enum
    (many SdvOk : (erased (Bool) e) (erased (List (Sy)) lp lp2 l l2) (unique (Sv l2) v) (erased (Sde e lp lp2 l l2) p) -> (Sdv e lp lp2 l))
    (many SdvNo : (erased (Bool) e) (erased (List (Sy)) lp lp2 l) (unique (Sv l) v) -> (Sdv e lp lp2 l))))

(def-fns _ $ (many sde-sv : (many (Bool) e) (many (List (Sy)) lp lp2) (erased (List (Sy)) r) (unique (Sv r) rv) -> (unique (Sdv e lp lp2 r) res))
  (let ((many n) (erased sb) (unique rv1)) (sub-all r rv))
  (let ((unique rv2) (many st)) (strip-v r rv1 lp n r sb))
  (let-match many st (StvOk _ _ _ _ _ i2 x np c lnp ad sbx) ((StvNo _ _ _ _ _) (SdvNo e lp lp2 r rv2)))
  (let-match erased ad (AddZero _))
  (let-match many e (BTrue)
    ((BFalse)
      (let ((erased l2) (erased c2) (unique rv3)) (push-list lp2 x (sv-drop lp x r rv2 i2 c lnp)))
      (SdvOk e lp lp2 r l2 rv3 (MkSde e lp lp2 x r l2 (EBV x) c c2))))
  (let-match many (nat-eq i2 n) (Unequal _ _ _ _ ap) ((Equal _ _ _) (SdvNo e lp lp2 r rv2)))
  (let-match erased sbx (SbC _ x1 _ _ y nt sb1) (absurd (SbN _ _) (apart-irrefl i2 ap)))
  (let ((many s) (unique rv3)) (sv-sym r rv2 i2 y nt))
  (let-match many s (YE) (else (SdvNo e lp lp2 r rv3)))
  (let-match many (nat-eq (Succ i2) n) (Equal _ _ _) ((Unequal _ _ _ _ _) (SdvNo e lp lp2 r rv3)))
  (let-match erased (sub-nil r x1 (Succ i2) sb1) (Refl _ _))
  (let ((erased l2) (erased c2) (unique rv4)) (push-list lp2 x (sv-drop lp x r rv3 i2 c lnp)))
  (SdvOk e lp lp2 r l2 rv4 (MkSde e lp lp2 x r l2 (EBE) c c2)))

(def-adts
  ((Twv : ((Bool) sd) ((List (Sy)) t) -> Type)
    enum
    (many TwvOk : (erased (Bool) sd) (erased (List (Sy)) t t2) (unique (Sv t2) v) (erased (TRw sd t t2) w) -> (Twv sd t))
    (many TwvNo : (erased (Bool) sd) (erased (List (Sy)) t) (unique (Sv t) v) -> (Twv sd t))))

(def-fns _ $ (many trw-sv : (many (Bool) sd) (many (Op) op) (subterm many (Nat) i) (erased (List (Sy)) t) (unique (Sv t) v) -> (unique (Twv sd t) r))
  (let-match unique (sv-uncons t v) (SuC s t0 v1) ((SuN v1) (TwvNo sd _ v1)))
  (let-match many i (Zero) ((Succ j)
    (let-match unique (notail $ trw-sv sd op j t0 v1) (TwvOk _ _ t3 v2 w) ((TwvNo _ _ v2) (TwvNo sd t (sv-cons s t0 v2))))
    (TwvOk sd t (Cons (Sy) s t3) (sv-cons s t3 v2) (TRUn sd s t0 t3 w))))
  (let-match many s (YW k n) (else (TwvNo sd t (sv-cons s t0 v1))))
  (match many op _
    ((OSp)
      (let-match many n (MkAm kk c))
      (let-match many c (Succ c1) ((Zero) (TwvNo sd t (sv-cons s t0 v1))))
      (TwvOk sd t _ (sv-cons (YW k (MkAm (BFalse) 1)) _ (sv-cons (YW k (MkAm kk c1)) t0 v1)) (TRSp sd kk k c1 t0)))
    ((OPu)
      (match unique (tpush-sv k n t0 v1) _
        ((PvOk _ _ _ t2 v2 pu) (TwvOk sd t t2 v2 (TRPu sd k n t0 t2 pu)))
        ((PvNo _ _ _ v2) (TwvNo sd t (sv-cons s t0 v2)))))
    ((OUf)
      (let-match many (eq-am n (MkAm (BFalse) 1)) (Some _ e) ((None _) (TwvNo sd t (sv-cons s t0 v1))))
      (let-match erased e (Refl _ _))
      (let-match many (cw-of sd k) (CwOk _ _ cw w) ((CwNo _ _) (TwvNo sd t (sv-cons s t0 v1))))
      (let ((erased t2) (erased c) (unique v2)) (push-list cw t0 v1))
      (TwvOk sd t t2 v2 (TRUf sd k cw t0 t2 w c)))))

(def-adts $ (Ao : ((Cf) c0) -> Type)
  enum
  (many AoOk : (erased (Cf) c0) (many (Mv) d) (many (List (Sy)) l) (erased (List (Sy)) r) (unique (Sv r) rv) (unique (Sv (Nil (Sy))) ov) (many (Bool) g)
     (erased (TRun c0 (MkCf d l r) g) tr) -> (Ao c0))
  (many AoNo : (erased (Cf) c0) (erased (List (Sy)) r) (unique (Sv r) rv) (unique (Sv (Nil (Sy))) ov) -> (Ao c0)))

(def-fns _ $ (many ao-no : (erased (Cf) c0) (unique (Ao c0) ac) -> (unique (Ao c0) r))
  (match unique ac _ ((AoOk _ _ _ r rv ov _ _) (AoNo c0 r rv ov)) (else a a)))

(def-fns _ $ (many ac-ts-o : (erased (Cf) c0) (erased (Cf) c) (many (Bool) g) (erased (TRun c0 c g) tr) (many (Mv) d2) (many (List (Sy)) l2) (erased (List (Sy)) r2)
    (unique (Sv r2) rv) (unique (Sv (Nil (Sy))) ov) (many (Bool) g2) (erased (TStp c (MkCf d2 l2 r2) g2) s) -> (unique (Ao c0) ac))
  (let ((many g3) (erased o)) (orb-of g g2))
  (AoOk c0 d2 l2 r2 rv ov g3 (TRS c0 c (MkCf d2 l2 r2) g g2 g3 tr s o)))

(def-fns _ $ (many ac-rl-o : (erased (Cf) c0) (unique (Ao c0) ac) (many (Rl) rl) (erased (RlOK sk1p rl) k) -> (unique (Ao c0) r))
  (let-match unique ac (AoOk _ d l r rv ov g tr) (else a a))
  (let-match many rl (MkRl d1 lp le rp re d2 lp2 rp2))
  (let-match many (eq-dir d1 d) (Some _ ed) ((None _) (AoNo c0 r rv ov)))
  (let-match erased ed (Refl _ _))
  (let-match many (sde-of le lp lp2 l) (SdOk _ _ _ _ l2 sl) ((SdNo _ _ _ _) (AoNo c0 r rv ov)))
  (match unique (sde-sv re rp rp2 r rv) _
    ((SdvNo _ _ _ _ rv1) (AoNo c0 r rv1 ov))
