      (values rv3 t3 ov3 (TsoY _ n u t3 (TStG _ _ n u0 t1 t2 t3 s1 pu pu2))))
    ((WcO _ _)
      (match many t _
        ((TgQP)
          (let-match erased e (EcQP _))
          (let-match many (u62-eq i1 j b1 (le-bd j nr jn bd)) (Unequal _ _ _ _ ap1) ((Equal _ _ _) (values rv1 (Nil (Sy)) ov (TsoN _ n u))))
          (let-match erased sb1 (SbC _ u1 _ _ x1 nt1 sb2) (absurd (SbN _ _) (apart-irrefl (Succ i) ap1)))
          (let-match erased q1 (Succ q2e) (absurd (Zero) (sw-q0 r (Succ i) nr x1 nt1 lr aq1)))
          (let ((many q2)) (u62-dec q2e q1 (add-bd q1 (Succ i) nr (add-comm (Succ i) q1 nr aq1) bd)))
          (let ((erased aq2)) (add-shift (Succ i) q2 nr aq1))
          (let ((many t1) (erased c1) (erased e1) (unique rv2)) (sv-tagp r rv1 q2 (Succ i) nr x1 nt1 lr aq2))
          (let-match many t1 (TgE) (else (values rv2 (Nil (Sy)) ov (TsoN _ n u))))
          (let-match erased e1 (EcE _))
          (let ((erased b2)) (add-bd (Succ (Succ i)) q2 nr aq2 bd))
          (let-match many (u62-eq (u62-inc i1 b2) j b2 (le-bd j nr jn bd)) (Equal _ _ _) ((Unequal _ _ _ _ _) (values rv2 (Nil (Sy)) ov (TsoN _ n u))))
          (let-match erased (sub-nil r u1 (Succ (Succ i)) sb2) (Refl _ _))
          (let ((unique ov1)) (sv-push (Cons (Sy) (YE) (Nil (Sy))) (sv-push (Nil (Sy)) ov (TgE) 0 (YE) (EcE 0)) (TgQP) 0 iP (EcQP 0)))
          (let ((erased t3) (unique ov2) (many p1)) (tpush-v (KX) xb xc (Cons (Sy) iP (Cons (Sy) (YE) (Nil (Sy)))) ov1))
          (let-match many p1 (PvOk _ _ _ _ pu) ((PvNo _ _ _) (let ((erased t4) (unique ov3) (many r3)) (tso-no (MkAm xb xc) n u t3 ov2)) (values rv2 t4 ov3 r3)))
          (values rv2 t3 ov2 (TsoY _ n u t3 (TStP _ n t3 pu))))
        ((TgQD)
          (let-match erased e (EcQD _))
          (let ((unique rv2) (erased t1) (unique ov1) (many r1)) (notail $ tstride-p (BFalse) (Zero) n r rv1 i1 j u0 sb1 ov q1 nr lr aq1 jn bd))
          (let-match many r1 (TsoY _ _ _ _ s1) ((TsoN _ _ _) (values rv2 t1 ov1 (TsoN _ n u))))
          (let ((unique ov2)) (sv-push t1 ov1 (TgQD) 0 iD (EcQD 0)))
          (let-match many (nz-b xb xc) (NzY _ nz) ((NzN) (values rv2 (Cons (Sy) iD t1) ov2 (TsoY _ n u _ (TStD _ n u0 t1 _ s1 (TPZ (KX) _))))))
          (let ((many tg) (erased e2)) (kb-tag (KX) xb xc))
          (values rv2 (Cons (Sy) (YW (KX) (MkAm xb xc)) (Cons (Sy) iD t1)) (sv-push (Cons (Sy) iD t1) ov2 tg xc _ e2)
            (TsoY _ n u _ (TStD _ n u0 t1 _ s1 (TPC (KX) _ _ nz (TNF (KX) (QD) t1))))))
        ((TgC)
          (let-match erased e (EcC _))
          (let-match many (lt-dec n (Succ xc)) (Yes _ _ _ _ p) ((No _ _ _ _ _) (values rv1 (Nil (Sy)) ov (TsoN _ n u))))
          (let ((many dc) (erased ad)) (sub xc n p))
          (let ((many n2) (erased a2)) (add n n))
          (let ((many n4) (erased a4)) (add n2 n2))
