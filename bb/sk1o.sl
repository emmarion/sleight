(def-fns _ $ (many xd-v : (many (Bool) xb) (many (Nat) xc) (many (Bool) vb) (many (Nat) vc) (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (erased (Sub r i j u) sb)
    (many (Nat) q) (erased (Nat) nr) (erased (Length (Sy) r nr) lr) (erased (Add i q nr) aq) (erased (Lt j (Succ nr)) jn) (erased (Lt nr u62-modulus) bd)
