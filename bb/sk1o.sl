(def-fns _ $ (many wc-of : (many (Tg) t) (erased (Sy) s) (erased (Nat) c) (erased (Ecd s t c) e) -> (many (Wc s c) w))
  (match many t _
    ((TgXF) (let-match erased e (EcXF _)) (WcX (BFalse) c)) ((TgXT) (let-match erased e (EcXT _)) (WcX (BTrue) c))
    ((TgGF) (let-match erased e (EcGF _)) (WcG (BFalse) c)) ((TgGT) (let-match erased e (EcGT _)) (WcG (BTrue) c))
    (else (WcO s c))))

(def-fns _ $ (many wb-of : (many (Tg) t) (erased (Pk) k) (erased (Bool) b) (erased (Nat) c) (erased (Ecd (YW k (MkAm b c)) t c) e) -> (many b is r))
  (match many t _
    ((TgXF) (let-match erased e (EcXF _)) (BFalse)) ((TgXT) (let-match erased e (EcXT _)) (BTrue))
    ((TgFF) (let-match erased e (EcFF _)) (BFalse)) ((TgFT) (let-match erased e (EcFT _)) (BTrue))
    ((TgGF) (let-match erased e (EcGF _)) (BFalse)) ((TgGT) (let-match erased e (EcGT _)) (BTrue))
    ((TgHF) (let-match erased e (EcHF _)) (BFalse)) ((TgHT) (let-match erased e (EcHT _)) (BTrue))
    (absurd (TgQD) e) (absurd (TgQP) e) (absurd (TgQC0) e) (absurd (TgQC1) e) (absurd (TgQC2) e) (absurd (TgQF0) e) (absurd (TgQF1) e) (absurd (TgQF2) e)
    (absurd (TgQF3) e) (absurd (TgQG0) e) (absurd (TgQG1) e) (absurd (TgQG2) e) (absurd (TgC) e) (absurd (TgE) e) (absurd (TgV) e) (absurd (TgR) e)))

(def-fns _ $ (many tstride-p : (many (Bool) xb) (many (Nat) xc n) (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Sub r i j u) sb)
    (unique (Sv (Nil (Sy))) ov) (many (Nat) q) (erased (Nat) nr) (erased (Length (Sy) r nr) lr) (erased (Add i q nr) aq) (erased (Lt j (Succ nr)) jn) (erased (Lt nr u62-modulus) bd)
    -> (unique rv is rv2 at rv) (erased (List (Sy)) t2) (unique (Sv t2) ov2 at ov) (many (Tso (MkAm xb xc) n u t2) res))
  (let-match many (u62-eq i j (add-bd i q nr aq bd) (le-bd j nr jn bd)) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values rv (Nil (Sy)) ov (TsoN _ n u))))
  (let-match erased sb (SbC _ u0 _ _ x nt sb1) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let-match erased q (Succ q1e) (absurd (Zero) (sw-q0 r i nr x nt lr aq)))
  (let ((many q1)) (u62-dec q1e q (add-bd q i nr (add-comm i q nr aq) bd)))
  (let ((erased aq1)) (add-shift i q1 nr aq))
  (let ((erased b1)) (add-bd (Succ i) q1 nr aq1 bd))
  (let ((many i1)) (u62-inc i b1))
  (let ((many t) (erased c) (erased e) (unique rv1)) (sv-tagp r rv q1 i nr x nt lr aq1))
  (match many (wc-of t x c e) _
    ((WcX b _)
      (let ((many cv) (erased t5) (erased e5) (unique rv2)) (sv-cntp r rv1 q1 i nr x nt lr aq1))
      (let-match erased (ecd-wc2 (KX) b c cv t5 e5) (Refl _ _))
      (let ((many vb)) (wb-of t (KX) b c e))
      (let ((unique rv3) (many xd)) (xd-v xb xc vb cv r rv2 i1 j u0 sb1 q1 nr lr aq1 jn bd))
      (match many xd _
        ((XvY _ _ _ _ u3 nz _)
          (let-match erased sb1 (SbC _ _ _ _ _ nt3 sb3))
          (let-match erased q1 (Succ q2e) (absurd (Zero) (sw-q0 r (Succ i) nr iD nt3 lr aq1)))
          (let ((many q2)) (u62-dec q2e q1 (add-bd q1 (Succ i) nr (add-comm (Succ i) q1 nr aq1) bd)))
          (let ((erased aq2)) (add-shift (Succ i) q2 nr aq1))
          (let ((unique rv4) (erased t2) (unique ov1) (many r1))
            (notail $ tstride-p (BFalse) (Zero) n r rv3 (u62-inc i1 (add-bd (Succ (Succ i)) q2 nr aq2 bd)) j u3 sb3 ov q2 nr lr aq2 jn bd))
          (let-match many r1 (TsoY _ _ _ _ s1) ((TsoN _ _ _) (values rv4 t2 ov1 (TsoN _ n u))))
          (values rv4 (Cons (Sy) x (Cons (Sy) iD t2)) (sv-push (Cons (Sy) iD t2) (sv-push t2 ov1 (TgQD) 0 iD (EcQD 0)) t cv x e)
            (TsoY _ n u _ (TStX az _ _ n u0 _ (cn-add-z _) (TStD _ n u3 t2 _ s1 (TPC (KX) _ (Cons (Sy) iD t2) nz (TNF (KX) (QD) t2)))))))
        ((XvN _ _ _ _ _ _)
          (let ((many xc2) (erased ad)) (add xc cv))
          (let-match many xb (BFalse)
            ((BTrue)
              (let-match many vb (BFalse) ((BTrue) (values rv3 (Nil (Sy)) ov (TsoN _ n u))))
              (let ((unique rv4) (erased t2) (unique ov1) (many r1)) (notail $ tstride-p (BTrue) xc2 n r rv3 i1 j u0 sb1 ov q1 nr lr aq1 jn bd))
              (values rv4 t2 ov1 (tso-x _ _ _ n u0 t2 (CAL xc cv xc2 ad) r1))))
          (let ((unique rv4) (erased t2) (unique ov1) (many r1)) (notail $ tstride-p vb xc2 n r rv3 i1 j u0 sb1 ov q1 nr lr aq1 jn bd))
          (values rv4 t2 ov1 (tso-x _ _ _ n u0 t2 (cn-add-f vb xc cv xc2 ad) r1)))))
    ((WcG b _)
      (let ((many gc) (erased t5) (erased e5) (unique rv2)) (sv-cntp r rv1 q1 i nr x nt lr aq1))
      (let-match erased (ecd-wc2 (KG) b c gc t5 e5) (Refl _ _))
      (let ((many gb)) (wb-of t (KG) b c e))
      (let ((unique rv3) (erased t1) (unique ov1) (many r1)) (notail $ tstride-p (BFalse) (Zero) n r rv2 i1 j u0 sb1 ov q1 nr lr aq1 jn bd))
      (let-match many r1 (TsoY _ _ _ _ s1) ((TsoN _ _ _) (values rv3 t1 ov1 (TsoN _ n u))))
      (let ((erased t2) (unique ov2) (many p1)) (tpush-v (KG) gb gc t1 ov1))
