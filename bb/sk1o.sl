  (values rv1 (XvY _ r i j u1 nz sb1)))

(def-adts
  ((Tso : ((Am) xs) ((Nat) n) ((List (Sy)) u t2) -> Type)
    enum
    (many TsoY : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) u t2) (erased (TSt xs n u t2) p) -> (Tso xs n u t2))
    (many TsoN : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) u) -> (Tso xs n u (Nil (Sy))))))

(def-fns _ $ (many tso-no : (erased (Am) xs) (erased (Nat) n) (erased (List (Sy)) u t) (unique (Sv t) ov) -> (erased (List (Sy)) t2) (unique (Sv t2) ov2 at ov) (many (Tso xs n u t2) res))
