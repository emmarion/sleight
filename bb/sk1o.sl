          (let-match many p1 (PvOk _ _ _ _ pu) ((PvNo _ _ _) (let ((erased t3) (unique ov3) (many r3)) (tso-no (MkAm xb xc) n u t2 ov2)) (values rv2 t3 ov3 r3)))
          (values rv2 t2 ov2 (TsoY _ n u t2 (TStV _ n b b2 t2 ad pu))))
        (else (values rv1 (Nil (Sy)) ov (TsoN _ n u)))))))

(def-fns _ $ (many tstride-v : (many (Am) xs) (many (Nat) n) (erased (List (Sy)) r) (unique (Sv r) rv) (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Sub r i j u) sb)
    (unique (Sv (Nil (Sy))) ov) -> (unique rv is rv2 at rv) (erased (List (Sy)) t2) (unique (Sv t2) ov2 at ov) (many (Tso xs n u t2) res))
  (let-match many xs (MkAm xb xc))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values rv (Nil (Sy)) ov (TsoN xs n u))))
  (let-match erased sb (SbC _ _ _ _ x nt _) (absurd (SbN _ _) (apart-irrefl i ap)))
  (let ((many q) (erased nr) (erased lr) (erased aq) (unique rv1)) (sv-cur r rv i x nt))
  (let ((many dd) (unique rv2)) (sv-bd r rv1 nr lr))
