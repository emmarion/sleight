  (values (Cons (Sy) (YW k (MkAm b3 c3)) t0) (sv-set-top _ t0 v tg c3 _ e) (PvOk k _ _ _ (TPM k _ _ _ t0 nz ca))))

(def-fns _ $ (many tpush-v : (many (Pk) k) (many (Bool) b) (many (Nat) c) (erased (List (Sy)) t) (unique (Sv t) v)
    -> (erased (List (Sy)) t2) (unique (Sv t2) v2 at v) (many (Pv k (MkAm b c) t t2) r))
  (let-match many (nz-b b c) (NzY _ nz) ((NzN) (values t v (PvOk k _ t t (TPZ k t)))))
