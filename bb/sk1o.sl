  (let-match many (tn-of k t1 x c1 e1) (TnM _ b2 _)
    ((TnN _ _ _ tn) (values (Cons (Sy) (YW k (MkAm b c)) t) (sv-push t v2 tg c _ e) (PvOk k _ t _ (TPC k _ t nz (tn1-tnk k x t0 tn))))))
  (let ((many c2) (erased t2) (erased e2) (unique v3)) (sv-cnt0 x t0 v2))
