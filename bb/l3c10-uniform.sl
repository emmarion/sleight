(def-fns _ $ (erased dch-run : (erased (Nat) K n u nout) (erased (List (Bool)) lz lzo) (erased (List (Tk)) X Xf) (erased (Tt) T)
    (subterm erased (Dch K n lz X T nout lzo Xf u) dh)
    (erased (List (Bool)) x0 r rc v xr) (erased (Rp (BTrue) n lz x0) p0) (erased (Rp (BFalse) u r rc) pu) (erased (Tb T rc v) tb) (erased (Xb X v xr) xb)
    -> (erased (List (Bool)) x0o u4 yr) (erased (Rp (BTrue) nout lzo x0o) po) (erased (Tb T r u4) tb4) (erased (Xb Xf u4 yr) yb)
    (erased (Nat) t) (erased (Run l3 (MkConf 2 (bits "00" x0) (BTrue) (bits "0" xr)) t (MkConf 2 (bits "00" x0o) (BTrue) (bits "0" yr))) run))
  (let-match erased dh (DhS K1 _ s m3 a u1 u2 _ _ _ y _ _ X2 _ _ lv mk am py dh1 au)
    ((DhZ _ _ _ _) (let-match erased pu (RpZ _ _)) (values x0 v xr p0 tb xb (Zero) (RNil l3 _))))
  (let ((erased mid) (erased pu2) (erased pu1)) (rp-split (BFalse) u1 u2 u r rc au pu))
  (let ((erased y1) (erased u3) (erased yr1) (erased py1) (erased tb3) (erased yb1) (erased t1) (erased run1))
    (lvl-run s n u1 m3 a X X2 T lv mk am lz x0 mid rc v xr p0 pu1 tb xb))
  (let-match erased (rp-fn (BTrue) _ lz y1 y py1 py) (Refl _ _))
  (let ((erased x0o) (erased u4) (erased yr) (erased po) (erased tb4) (erased yb) (erased t2) (erased run2))
    (dch-run K1 n2 u2 nout (bits "0110" y) lzo X2 Xf T dh1 (bits "110110" y) r mid u3 yr1 (rp2 _ _) pu2 tb3 yb1))
  (let ((erased t) (erased run)) (run-cat l3 _ _ _ t1 t2 run1 run2))
  (values x0o u4 yr po tb4 yb t run))
