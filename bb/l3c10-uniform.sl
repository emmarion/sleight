  (let ((many qo)) (fd-loop-u (min-nat 256 q) q s 0 G cx))
  (let-match many (lt-dec qo q) (Yes _ _ _ _ _) ((No _ _ _ _ _) no))
  (c-dlev (monus q qo) c0 e ch))

(def-fns _ $ (many dl-best : (subterm many (Nat) fuel) (many (Nat) lo hi) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Rs l3 c0) best)
    -> (many (Rs l3 c0) res))
  (let-match many fuel (Succ f) ((Zero) best))
  (let-match many (lt-dec hi lo) (No _ _ _ _ _) ((Yes _ _ _ _ _) best))
  (let ((many mid)) (nat-shr (nat-add lo hi) 1))
  (match many (c-dlev mid c0 e ch) _
    ((RsOk _ _ e1 ch1) (tail $ dl-best f (Succ mid) hi c0 e ch (RsOk l3 c0 e1 ch1)))
    ((RsNo _ _ _ _) (tail $ dl-best f lo (monus mid 1) c0 e ch best))))

(def-fns _ $ (many c-vdesc-u : (many (Bool) all) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) r))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (v-check e c dc) (VYes q front) ((VNo) no))
  (let ((many k)) (monus q 1))
  (let-match many all (BFalse) ((BTrue) (match many front _ ((BTrue) (c-dlev k c0 e ch)) ((BFalse) no))))
  (dl-best 64 1 k c0 e ch no))

(def-fns _ $ (many udprop : (many (Nat) idx) (many (Rq) e) -> (many (Maybe (Maybe (Rq))) r))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let-match many (nat-eq idx 17) (Unequal _ _ _ _ _) ((Equal _ _ _) (Some _ (rs-opt c0 (c-fdesc-u c0 e ch)))))
  (let-match many (nat-eq idx 3) (Unequal _ _ _ _ _) ((Equal _ _ _) (Some _ (rs-opt c0 (c-vdesc-u (BTrue) c0 e ch)))))
  (let-match many (nat-eq idx 25) (Unequal _ _ _ _ _) ((Equal _ _ _) (Some _ (rs-opt c0 (c-vdesc-u (BFalse) c0 e ch)))))
  (dprop idx e))

(def-fns _ $ (many udrep : (subterm many (Nat) n) (many (Nat) idx) (many (Rq) e) -> (many (Maybe (Maybe (Rq))) r))
  (let ((many r)) (udprop idx e))
  (let-match many n (Succ n1) ((Zero) r))
  (let-match many n1 (Succ _) ((Zero) r))
  (tail $ udrep n1 idx e))

(def-fns _ $ (many udloop : (subterm many (Nat) fuel) (many (Nat) tidx reps mv ok) (many (Rq) e) (many (String) s) -> (many (HRes) r))
  (let-match many fuel (Succ f) ((Zero) (HOk ok e)))
  (let ((many kind) (many s1)) (tok s))
  (let-match many kind (Succ j1) ((Zero) (HOk ok e)))
  (let-match many j1 (Succ j2) ((Zero) (HOk ok e)))
  (let ((many idx) (many s2)) (match many j2 (((Nat) idx) ((String) s2)) ((Zero) (values 0 s1)) ((Succ _) (tok s1))))
  (let ((many e2) (many s3)) (rd-patch s2 e))
  (let ((many on)) (match many tidx (((Bool) b)) ((Zero) (BTrue)) (else (match many (nat-eq idx tidx) (((Bool) b)) ((Equal _ _ _) (BTrue)) (else (BFalse))))))
  (let ((many v)) (match many on (((Nat) v)) ((BFalse) 0)
    ((BTrue)
      (let-match many (udrep (match many tidx (((Nat) n)) ((Zero) 1) (else reps)) idx e) (Some _ m) ((None _) 0))
      (let-match many m (Some _ e3) ((None _) 2))
      (match many (rq-eq e3 e2) _ ((BTrue) 1) ((BFalse) 3)))))
  (let-match many v (Succ v1) ((Zero) (tail $ udloop f tidx reps (Succ mv) ok e2 s3)))
  (let-match many v1 (Zero) ((Succ _) (HBad (Succ mv) idx e)))
  (tail $ udloop f tidx reps (Succ mv) (Succ ok) e2 s3))

(def-fns _ $ (many umain : (many (String) in) -> (many (String) out))
  (let ((many tidx) (many s0)) (tok in))
  (let ((many reps) (many s1)) (tok s0))
  (let ((many e) (many s)) (rd-cfg s1))
  (let ((many r)) (match many (udloop 1000000000 tidx reps 0 0 e s) (((Rope) r))
    ((HOk k e2) (sp (RStr "OK") k))
    ((HBad k why e2) (sp (sp (RStr "BAD") k) why))))
  (let ((many o) (erased _)) (flatten (RCat r (RChar #\newline))))
  o)

(def-fns _ $ (many c-casc : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many no)) (RsNo l3 c0 e ch))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (c-lm e c dc) (LmOk _ _ _ _ _ _ _ _ _ _ X T _ _ _ _ _) ((LmNo _) no))
  (let-match many (fd-tail-ok T) (BTrue) ((BFalse) no))
  (let-match many (decode X T) (DecOk F s) ((DecNo) no))
  (let-match many F (FO q _) (else no))
  (let ((many t) (erased _)) (top-run q))
  (let-match many (nat-eq s (nat-add t t)) (Equal _ _ _) (else no))
  (c-dlev q c0 e ch))
