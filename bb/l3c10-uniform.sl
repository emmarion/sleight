      (values c (Refl _ m)))
    ((TA4 _ ss g q)
      (let-match erased g (MkSg6 _))
      (let-match erased q (LcT _ _ _ _ _ _ a _))
      (let-match erased a (AddSucc _ _ c _))
      (values c (Refl _ m)))))

