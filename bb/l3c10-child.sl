(def-fns _ $ (many nle : (many (Nat) a b) -> (many (Bool) r))
  (match many (lt-dec b a) _ ((Yes _ _ _ _ _) (BFalse)) ((No _ _ _ _ _) (BTrue))))

(def-fns _ $ (many neqb : (many (Nat) a b) -> (many (Bool) r))
  (match many (nat-eq a b) _ ((Equal _ _ _) (BTrue)) (else (BFalse))))

(def-fns _ $ (many nlist-eq : (subterm many (List (Nat)) A) (many (List (Nat)) B) -> (many (Bool) r))
  (let-match many A (Cons _ a A1) ((Nil _) (match many B _ ((Nil _) (BTrue)) ((Cons _ _ _) (BFalse)))))
  (let-match many B (Cons _ b B1) ((Nil _) (BFalse)))
  (let-match many (neqb a b) (BTrue) ((BFalse) (BFalse)))
  (tail $ nlist-eq A1 B1))

(def-fns _ $ (many cells-d : (many (Nat) acc) (subterm many (List (Nat)) D) -> (many (Nat) n))
  (let-match many D (Cons _ d D1) ((Nil _) acc))
  (tail $ cells-d (nat-add acc (nat-add d 3)) D1))

(def-fns _ $ (many dsum : (many (Nat) acc) (subterm many (List (Nat)) D) -> (many (Nat) n))
  (let-match many D (Cons _ d D1) ((Nil _) acc))
  (tail $ dsum (nat-add acc d) D1))

(def-fns _ $ (many lpf : (many (Nat) P) -> (many (Nat) l))
  (let ((many t) (erased _)) (top-run P))
  (Succ t))

(def-fns _ $ (many blkw : (many (Nat) P rho) -> (many (List (Ps)) w))
  (let ((many t) (erased tp)) (top-run P))
  (let-match many (lt-dec rho (Succ t)) (Yes _ _ _ _ bn) ((No _ _ _ _ _) (Nil (Ps))))
  (let ((many w) (erased _)) (blk-fast P rho t tp bn))
  w)

(def-fns _ $ (many dgw : (many (List (Ps)) w) -> (many (List (Nat)) D))
  (let ((many D) (erased _)) (dg-tr w (Cons _ 0 (Nil (Nat)))))
  D)

(def-fns _ $ (many phie : (many (Nat) P rho) -> (many (List (Nat)) D))
  (Cons _ 2 (dgw (blkw P rho))))

(def-fns _ $ (many phio : (many (Nat) P s) -> (many (List (Nat)) D))
  (let ((many l)) (lpf P))
  (let-match many s (Succ s1) ((Zero) (Cons _ 2 (Cons _ 2 (dgw (blkw P (monus l 1)))))))
  (let-match many (nle s l) (BFalse) ((BTrue) (Cons _ 2 (Cons _ 1 (dgw (blkw P s1))))))
  (Cons _ 2 (Cons _ 0 (dgw (blkw P (monus s1 l))))))

(def-fns _ $ (many swf : (many (Nat) p) -> (many (Nat) n))
  (dsum 0 (dgw (blkw p (monus (lpf p) 1)))))

(def-fns _ $ (many uon : (many (Nat) P) -> (many (Nat) u))
  (let ((many s)) (monus (nat-mul 2 (lpf P)) 2))
  (monus (nat-add (nat-mul 3 s) (cells-d 0 (phio P 0))) (cells-d 0 (phio P s))))

(def-fns _ $ (many kdf : (many (Nat) q) -> (many (Nat) k))
  (let-match many q (Succ q1) ((Zero) 0))
  (monus (nat-add (nat-mul 8 (lpf q1)) (swf 1)) (nat-add (nat-mul 2 q1) (swf q))))

(def-fns _ $ (many rpushn : (many (Bool) b) (many (Nat) g) (many (List (Rn)) R) -> (many (List (Rn)) R2))
  (let-match many g (Succ _) ((Zero) R))
  (let-match many R (Cons _ rn R1) ((Nil _) (match many b _ ((BFalse) R) ((BTrue) (Cons _ (MkRn b g) R)))))
  (let-match many rn (MkRn b2 k))
  (match many (eq-bit b b2) _ ((ESome _ _) (Cons _ (MkRn b2 (nat-add g k)) R1)) ((ENone _) (Cons _ (MkRn b g) R))))

(def-fns _ $ (many pushk : (many (Bool) b) (many (Nat) g) (many (List (Rn)) R) -> (many (List (Rn)) R2))
  (let-match many R (Cons _ rn R1) ((Nil _) (Cons _ (MkRn b g) R)))
  (let-match many rn (MkRn b2 k))
  (match many (eq-bit b b2) _ ((ESome _ _) (Cons _ (MkRn b2 (nat-add g k)) R1)) ((ENone _) (Cons _ (MkRn b g) R))))

(def-fns _ $ (many rcat : (subterm many (List (Rn)) A) (many (List (Rn)) B) -> (many (List (Rn)) C))
  (let-match many A (Cons _ a A1) ((Nil _) B))
  (Cons _ a (notail $ rcat A1 B)))

(def-fns _ $ (many tok-runs : (many (List (Tk)) X) (many (Tt) T) -> (many (List (Rn)) U))
  (let-match many (xtr X T) (MkXTR _ _ U _ _ _))
  U)

(def-fns _ $ (many reg-runs : (many (List (Tk)) X) (many (Tt) T) -> (many (List (Rn)) U))
  (pushk (BFalse) 1 (tok-runs X T)))

(def-fns _ $ (many lm-out : (many (List (Rn)) L0) (many (Nat) n) (many (List (Tk)) X) (many (Tt) T) (many (List (Rn)) R2) -> (many (Rq) e))
  (MkRq 2 (Cons _ (MkRn (BFalse) 2) (Cons _ (MkRn (BTrue) n) L0)) (BTrue) (rcat (reg-runs X T) R2)))

(def-fns _ $ (many rstrip-c : (subterm many (List (Rn)) A) (many (List (Rn)) R) -> (many (Maybe (List (Rn))) r))
  (let-match many A (Cons _ a A1) ((Nil _) (Some _ R)))
  (let-match many R (Cons _ b R1) ((Nil _) (None _)))
  (let-match many a (MkRn x n))
  (let-match many b (MkRn y m))
  (let-match many (eq-bit x y) (ESome _ _) ((ENone _) (None _)))
  (let-match many (neqb n m) (BTrue) ((BFalse) (None _)))
  (tail $ rstrip-c A1 R1))

(def-adts $ (LmC : -> Type)
  enum
  (many LcOk : (many (Nat) n) (many (List (Rn)) L0) (many (List (Nat)) D) (many (List (Tk)) X) (many (Tt) T) (many (List (Rn)) R1) -> (LmC))
  (many LcNo : -> (LmC)))

(def-fns _ $ (many lmc : (many (Rq) e) -> (many (LmC) r))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let-match many (c-lm e c dc) (LmOk _ _ _ _ _ _ n L0 _ _ X T _ R1 _ _ _) ((LmNo _) (LcNo)))
  (let-match many (tdigits 0 X) (Some _ D) ((None _) (LcNo)))
  (LcOk n L0 D X T R1))

(def-fns _ $ (many memp : (many (List (Nat)) D) -> (many (Nat) P))
  (nat-shr (monus (nlen D) 3) 1))

(def-fns _ $ (many death-tail : (subterm many (Nat) q) (many (Nat) L) (many (List (Rn)) R) -> (many (List (Rn)) R2))
  (let-match many q (Succ q1) ((Zero) R))
  (let ((many L1)) (nat-shr (monus L 1) 2))
  (Cons _ (MkRn (BTrue) 6) (Cons _ (MkRn (BFalse) (nat-mul 6 L)) (notail $ death-tail q1 L1 R))))

(def-fns _ $ (many death-runs : (many (Nat) P n g) (many (List (Rn)) Rt) -> (many (List (Rn)) R))
  (let ((many L)) (lpf P))
  (let ((many fin)) (Cons _ (MkRn (BTrue) 6) $ Cons _ (MkRn (BFalse) 6) $ Cons _ (MkRn (BTrue) 12) $ Cons _ (MkRn (BFalse) 1) $
    Cons _ (MkRn (BTrue) 2) (rpushn (BFalse) g Rt)))
  (Cons _ (MkRn (BFalse) (nat-add (nat-mul 6 L) n)) (death-tail (monus P 1) (nat-shr (monus L 1) 2) fin)))

(def-fns _ $ (many mem-ok : (many (Nat) P) (many (List (Nat)) D) -> (many (Bool) b))
  (let-match many P (Succ _) ((Zero) (BFalse)))
  (nlist-eq D (phio P (monus (nat-mul 2 (lpf P)) 2))))

(def-fns _ $ (many m-death : (many (LmC) lc) -> (many (Maybe (Rq)) r))
  (let-match many lc (LcOk n L0 D X T R1) ((LcNo) (None _)))
  (let-match many T (Tt1) (else (None _)))
  (let ((many P)) (memp D))
  (let-match many (mem-ok P D) (BTrue) ((BFalse) (None _)))
  (let-match many R1 (Cons _ r0 Rt) ((Nil _) (None _)))
  (let-match many r0 (MkRn b G))
  (let-match many b (BFalse) ((BTrue) (None _)))
  (let ((many KU)) (nat-add (kdf P) (uon P)))
  (let-match many (nle KU G) (BTrue) ((BFalse) (None _)))
  (Some _ (MkRq 2 L0 (BTrue) (death-runs P n (monus G KU) Rt))))

(def-fns _ $ (many fe-of : (many (List (Tk)) X) (many (Tt) T) -> (many (Maybe (Nat)) P) (many (Nat) rho))
  (let-match many T (TtE) (else (values (None _) 0)))
  (let-match many (decode X T) (DecOk F rho) ((DecNo) (values (None _) 0)))
  (let-match many F (FE P T2) (else (values (None _) 0)))
  (let-match many T2 (TtE) (else (values (None _) 0)))
  (values (Some _ P) rho))

(def-fns _ $ (many cov : (many (Nat) P) -> (many (Nat) c))
  (match many (rd-run (c-enc (phie P 0)) (TtE)) _ ((RdOk _ _ _ _ c _) c) ((RdNo _ _) 0)))

(def-fns _ $ (many wov-runs : (many (Nat) P) -> (many (List (Rn)) R))
  (pushk (BTrue) 7 (tok-runs (c-enc (dgw (blkw P (monus (lpf P) 1)))) (TtE))))

(def-fns _ $ (many m-bcovf : (many (LmC) lc) -> (many (Maybe (Rq)) r))
  (let-match many lc (LcOk n L0 D X T R1) ((LcNo) (None _)))
  (let ((many mp) (many rho)) (fe-of X T))
  (let-match many mp (Some _ P) ((None _) (None _)))
  (let-match many (nlist-eq D (phie P rho)) (BTrue) ((BFalse) (None _)))
  (let-match many (lt-dec rho (lpf P)) (Yes _ _ _ _ _) ((No _ _ _ _ _) (None _)))
  (let ((many u)) (nat-add (monus (nat-add (nat-mul 3 rho) (cells-d 0 (phie P 0))) (cells-d 0 D)) (cov P)))
  (let ((many R2)) (match many R1 (((List (Rn)) R2)) ((Nil _) (Cons _ (MkRn (BFalse) u) R1)) ((Cons _ _ _) R1)))
  (let-match many R2 (Cons _ r0 Rt) ((Nil _) (None _)))
  (let-match many r0 (MkRn b G0))
  (let-match many b (BFalse) ((BTrue) (None _)))
  (let-match many (nle u G0) (BTrue) ((BFalse) (None _)))
  (Some _ (MkRq 2 L0 (BTrue) (Cons _ (MkRn (BFalse) (nat-add (nat-add 5 (nat-mul 3 rho)) n)) (rcat (wov-runs P) (rpushn (BFalse) (monus G0 u) Rt))))))

(def-fns _ $ (many rn-eq : (subterm many (List (Rn)) A) (many (List (Rn)) B) -> (many (Bool) r))
  (let-match many A (Cons _ a A1) ((Nil _) (match many B _ ((Nil _) (BTrue)) ((Cons _ _ _) (BFalse)))))
  (let-match many B (Cons _ b B1) ((Nil _) (BFalse)))
  (let-match many a (MkRn x n))
  (let-match many b (MkRn y m))
  (let-match many (eq-bit x y) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (neqb n m) (BTrue) ((BFalse) (BFalse)))
  (tail $ rn-eq A1 B1))

(def-fns _ $ (many rq-eq : (many (Rq) a b) -> (many (Bool) r))
  (let-match many a (MkRq q L h R))
  (let-match many b (MkRq q2 L2 h2 R2))
  (let-match many (neqb q q2) (BTrue) ((BFalse) (BFalse)))
  (let-match many (eq-bit h h2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (rn-eq L L2) (BTrue) ((BFalse) (BFalse)))
  (rn-eq R R2))

(def-fns _ $ (many macro-at : (many (Nat) j) (many (Rq) e) (many (LmC) lc) -> (many (Maybe (Rq)) r))
  (let-match many (neqb j 6) (BFalse) ((BTrue) (m-bcovf lc)))
  (let-match many (neqb j 10) (BFalse) ((BTrue) (m-death lc)))
  (None _))

(def-fns _ $ (many chk : (subterm many (List (Nat)) js) (many (Nat) i mv) (many (Rq) e e2) (many (LmC) lc) (many (List (Nat)) cnt) (many (Rope) log)
    -> (many (List (Nat)) cnt2) (many (Rope) log2))
  (let-match many js (Cons _ j js1) ((Nil _) (values cnt log)))
  (let-match many cnt (Cons _ c cnt1) ((Nil _) (values cnt log)))
  (let-match many (lt-dec j (Succ i)) (Yes _ _ _ _ _) ((No _ _ _ _ _) (values cnt log)))
  (let ((many r)) (macro-at j e lc))
  (let ((many bad)) (RCat log (RCat (sp (sp (RStr "BAD") mv) j) (RChar #\newline))))
  (let ((many ok) (many log1)) (match many (neqb j i) (((Bool) ok) ((Rope) log1))
    ((BTrue) (match many r _ ((None _) (values (BFalse) bad)) ((Some _ e3) (match many (rq-eq e3 e2) _ ((BTrue) (values (BTrue) log)) ((BFalse) (values (BFalse) bad))))))
    ((BFalse) (match many r _ ((None _) (values (BTrue) log)) ((Some _ _) (values (BFalse) (RCat bad (RStr "  (fired early)\n"))))))))
  (let ((many c2)) (match many ok (((Nat) c2)) ((BTrue) (Succ c)) ((BFalse) c)))
  (let ((many cnt3) (many log3)) (notail $ chk js1 i mv e e2 lc cnt1 log1))
  (values (Cons _ c2 cnt3) log3))

(def-fns _ $ (many cloop : (subterm many (Nat) fuel) (many (Nat) mv) (many (List (Nat)) js) (many (Rq) e) (many (String) s) (many (List (Nat)) cnt) (many (Rope) log)
    -> (many (Nat) mv2) (many (List (Nat)) cnt2) (many (Rope) log2))
  (let-match many fuel (Succ f) ((Zero) (values mv cnt log)))
  (let ((many kind) (many s1)) (tok s))
  (let-match many kind (Succ _) ((Zero) (values mv cnt log)))
  (let ((many i) (many s2)) (tok s1))
  (let ((many e2) (many s3)) (rd-patch s2 e))
  (let ((many mv1)) (Succ mv))
  (let ((many cnt1) (many log1)) (chk js i mv1 e e2 (lmc e) cnt log))
  (tail $ cloop f mv1 js e2 s3 cnt1 log1))

(def-fns _ $ (many show-nats : (subterm many (List (Nat)) A) (many (Rope) acc) -> (many (Rope) r))
  (let-match many A (Cons _ a A1) ((Nil _) acc))
  (tail $ show-nats A1 (sp acc a)))

(def-fns _ $ (many zeros-like : (subterm many (List (Nat)) A) -> (many (List (Nat)) B))
  (let-match many A (Cons _ _ A1) ((Nil _) A))
  (Cons _ 0 (notail $ zeros-like A1)))

(def-fns _ $ (many cmain : (many (String) in) -> (many (String) out))
  (let ((many js)) (Cons _ 5 $ Cons _ 6 $ Cons _ 7 $ Cons _ 8 $ Cons _ 10 $ Cons _ 24 $ Nil (Nat)))
  (let ((many e) (many s)) (rd-cfg in))
  (let ((many mv) (many cnt) (many log)) (cloop 1000000000 0 js e s (zeros-like js) (RStr "")))
  (let ((many o) (erased _)) (flatten (RCat log (RCat (show-nats cnt (sp (RStr "MOVES") mv)) (RChar #\newline)))))
  o)
