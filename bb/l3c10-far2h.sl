(def-fns _ $ (many rd-nats : (subterm many (Nat) k) (many (String) s) -> (many (List (Nat)) xs) (many (String) t))
  (let-match many k (Succ k1) ((Zero) (values (Nil _) s)))
  (let ((many n) (many s1)) (tok s))
  (let ((many xs) (many t)) (notail $ rd-nats k1 s1))
  (values (Cons _ n xs) t))

(def-lvl S15P0)
(def-lvl S15P)
(def-fns S15P0 $ (many s15-step : (subterm many (List (Nat)) sc) (many (Nat) mv) (many (List (Nat)) cks) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program S15P) next))
  (let-match many sc (Cons _ i sc1) ((Nil _) (values w (Exit S15P (MkU8 0 rp-z)))))
  (let ((many r)) (s15-move i c0 e ch))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (let ((many s) (erased _)) (flatten (sp (sp (RStr "FAIL") mv) i))) (let ((unique w1) (many _)) (world-do _ w (WriteOut s))) (values w1 (Exit S15P (MkU8 0 rp-z)))))
  (let ((many mv1)) (Succ mv))
  (let ((unique w1) (many u)) (world-do _ w (Measure sw-stop)))
  (let-match many u (MkUsage wall user _ _ _ _ _ _))
  (let ((many ck) (many cks1)) (match many cks (((Bool) b) ((List (Nat)) t))
    ((Cons _ k t) (match many (nat-eq k mv1) _ ((Equal _ _ _) (values (BTrue) t)) (else (values (BFalse) cks))))
    ((Nil _) (values (BFalse) cks))))
  (let ((many line)) (RCat (sp (sp (sp (RStr "T") mv1) i) user) (RCat (sp (RStr "") wall) (RChar #\newline))))
  (let ((many txt)) (match many ck (((Rope) t)) ((BTrue) (RCat line (RCat (sp (RStr "F") mv1) (RCat (show-fp e1) (RChar #\newline))))) ((BFalse) line)))
  (let ((many s) (erased _)) (flatten txt))
  (let ((unique w2) (many _)) (world-do _ w1 (WriteOut s)))
  (def-unique S15P $ (unique again : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program S15P) next))
    (s15-step sc1 mv1 cks1 c0 e1 ch1 v))
  (values w2 (Continue S15P again)))

(def-fns _ $ (many s15-prog : (many (Nat) mv0) -> (unique (Program S15P) p))
  (def-unique S15P $ (unique go : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program S15P) next))
    (let ((unique v1) (many s)) (world-do _ v (ReadRemaining)))
    (let ((many e) (many s1)) (rd-cfg s))
    (let ((many n) (many s2)) (tok s1))
    (let ((many sc) (many s3)) (tok s2))
    (let ((many cks) (many s4)) (rd-nats n s3))
    (let ((many scr) (many _)) (rd-nats sc s4))
    (let ((erased c0) (erased ch)) (rch-self l3 e))
    (s15-step scr mv0 cks c0 e ch v1))
  (Continue S15P go))
