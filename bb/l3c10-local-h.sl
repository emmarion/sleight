(def-fns _ $ (many local-mac : (many (Nat) idx) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Bool) has) (many (Rs l3 c0) res))
  (let-match many (nat-eq idx 12) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) (frame-tbl tbl-l0 c0 e ch))))
  (let-match many (nat-eq idx 13) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) (frame-tbl tbl-ax c0 e ch))))
  (let-match many (nat-eq idx 14) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) (frame-tbl tbl-frame c0 e ch))))
  (let-match many (nat-eq idx 22) (Unequal _ _ _ _ _) ((Equal _ _ _) (values (BTrue) (try-sweep3 c0 e ch))))
  (values (BFalse) (RsNo l3 c0 e ch)))

(def-fns _ $ (many m-rep : (subterm many (Nat) k) (many (Nat) idx) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Bool) has) (many (Rs l3 c0) res))
  (let ((many has) (many r)) (local-mac idx c0 e ch))
  (let-match many k (Succ k2) ((Zero) (values has r)))
  (let-match many k2 (Succ _) ((Zero) (values has r)))
  (tail $ m-rep k2 idx c0 e ch))

(def-adts $ (MRes : -> Type)
  enum
  (many MOk : (many (Nat) k ok) (many (Rq) e) -> (MRes))
  (many MBad : (many (Nat) k why) (many (Rq) e) -> (MRes)))

(def-fns _ $ (many mloop : (many (Nat) rep rm) (subterm many (Nat) fuel) (many (Nat) mv ok) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (String) s) -> (many (MRes) r))
  (let-match many fuel (Succ f) ((Zero) (MOk mv ok e)))
  (let ((many kind) (many s1)) (tok s))
  (let-match many kind (Succ j1) ((Zero) (MOk mv ok e)))
  (let-match many j1 (Zero)
    ((Succ j2)
      (let ((many idx) (many s1b)) (match many j2 (((Nat) i) ((String) t)) ((Zero) (values 99 s1)) ((Succ _) (tok s1))))
      (let ((many e2) (many s2)) (rd-patch s1b e))
      (let ((many has) (many r)) (m-rep rm idx c0 e ch))
      (let-match many has (BTrue)
        ((BFalse)
          (let ((erased c2) (erased ch2)) (rch-self l3 e2))
          (tail $ mloop rep rm f (Succ mv) ok c2 e2 ch2 s2)))
      (let-match many r (RsOk _ _ e3 ch3) ((RsNo _ _ _ _) (MBad mv (nat-add 1000 idx) e)))
      (let-match many (rq-eq e3 e2) (ESome _ _) ((ENone _) (MBad mv (nat-add 2000 idx) e3)))
      (tail $ mloop rep rm f (Succ mv) (Succ ok) c0 e3 ch3 s2)))
  (let ((many cls) (many s2)) (tok s1))
  (let ((many q) (many s3)) (tok s2))
  (let ((many h) (many s4)) (tok s3))
  (let ((many lb) (many s5)) (tok s4))
  (let ((many ln) (many s6)) (tok s5))
  (let ((many rb) (many s7)) (tok s6))
  (let ((many rn) (many s8)) (tok s7))
  (let-match many (c-rep rep c0 e ch) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) (MBad mv 1 e)))
  (let-match many e2 (MkRq q2 L2 h2 R2))
  (let-match many (nat-eq q q2) (Equal _ _ _) (else (MBad mv 2 e2)))
  (let-match many (nat-eq h (bit-nat h2)) (Equal _ _ _) (else (MBad mv 3 e2)))
  (let-match many (first-ok L2 lb ln) (BTrue) ((BFalse) (MBad mv 4 e2)))
  (let-match many (first-ok R2 rb rn) (BTrue) ((BFalse) (MBad mv 5 e2)))
  (tail $ mloop rep rm f (Succ mv) ok c0 e2 ch2 s8))

(def-fns _ $ (many mmain : (many (String) in) -> (many (String) out))
  (let ((many rep) (many s0)) (tok in))
  (let ((many rm) (many s1)) (tok s0))
  (let ((many e) (many s)) (rd-cfg s1))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let ((many r) (many tl)) (match many (mloop rep rm 1000000000 0 0 c0 e ch s) (((Rope) r) ((Rope) tl))
    ((MOk k ok e2) (values (show-cfg e2) (sp (sp (RStr "OK") k) ok)))
    ((MBad k why e2) (values (show-cfg e2) (sp (sp (RStr "BAD") k) why)))))
  (let ((many o) (erased _)) (flatten (RCat r (RCat tl (RChar #\newline)))))
  o)
