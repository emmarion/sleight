  (let ((many i) (erased bw)) (u62-and h mask ph (lt-trans mask (Succ mask) u62-modulus (lt-succ mask) pm)))
  (values h ph i (and-le _ _ _ bw)))

(def-fns _ $ (many ht-probe : (unique (Vec (U62)) slots) (unique (Vec (List (KN))) keys) (unique (Vec (U62)) hs) (many (Nat) mask h)
    (erased (Lt (Succ mask) u62-modulus) pm) (erased (Lt h u62-modulus) ph) (many (List (KN)) k) (subterm many (Nat) fuel) (many (Nat) i) (erased (Lt i (Succ mask)) li) ->
    (unique (Vec (U62)) s2 at slots) (unique (Vec (List (KN))) k2 at keys) (unique (Vec (U62)) h2 at hs) (many (Maybe (Nat)) r) (many (Nat) ix))
  (let ((many sv) (unique slots1)) (vec-get _ slots i))
  (let-match many sv (MkU62 s _))
  (let-match many s (Succ id) ((Zero) (values slots1 keys hs (None _) i)))
  (let-match many fuel (Succ f) ((Zero) (values slots1 keys hs (None _) i)))
  (let ((many next) (erased ln)) (ht-next mask i pm li))
  (let ((many hu) (unique hs1)) (vec-get _ hs id))
  (let-match many hu (MkU62 hv phv))
  (let-match many (u62-eq hv h phv ph) (Equal _ _ _) (else (tail $ ht-probe slots1 keys hs1 mask h pm ph k f next ln)))
  (let ((many kk) (unique keys1)) (vec-get _ keys id))
  (let-match many (keys-eq kk k) (BTrue) ((BFalse) (tail $ ht-probe slots1 keys1 hs1 mask h pm ph k f next ln)))
  (values slots1 keys1 hs1 (Some _ id) i))

(def-fns _ $ (many ht-find : (unique (HT) t) (many (List (KN)) k) -> (many (Maybe (Nat)) r) (unique (HT) t2 at t))
  (let-match unique t (MkHT n mask pm slots keys hs u))
  (let ((many h) (erased ph) (many i0) (erased li)) (ht-start mask pm k))
  (let ((unique s1) (unique ky1) (unique h1) (many r) (many _)) (ht-probe slots keys hs mask h pm ph k (Succ mask) i0 li))
