(def-fns _ $ (many rw-pop-edges : (many (KN) side) (subterm many (List (Pair (List (KN)) (List (Blk)))) ps) ->
    (many (List (Pair (KN) (Tgt))) es))
  (let-match many ps (Cons _ pr rest) ((Nil _) (Nil _)))
