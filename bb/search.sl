        k0 k1 cap (Cons (Nat) 0 $ Cons (Nat) 1 $ Nil (Nat)))))
  (let ((many keys)) (zero-keys k0 ln (zero-keys k1 ln (Nil (List (KN))))))
  (let ((many st)) (tab-of (BFalse) keys (empty-tab)))
  (let ((many n) (erased _)) (list-count _ keys))
  (let ((many acc) (erased _)) (range n))
  (let-match many st (MkTab _ ids _ _))
  (let ((many ri)) (match many (hfind _ ids (Cons (KN) k1 (rw-enc (but-last _ (repeat _ ln k0)) (Nil (Blk))))) (((KN) i)) ((Some _ i) i) ((None _) k0)))
  (values sy1 st k0 ri cap acc))

