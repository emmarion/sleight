  x)

(def-fns _ $ (many k-eq : (many (KN) a b) -> (many (Bool) r))
  (let-match many a (MkKN x px))
  (let-match many b (MkKN y py))
  (match many (u62-eq x y (lt-trans x B u62-modulus px bB) (lt-trans y B u62-modulus py bB)) _ ((Equal _ _ _) (BTrue)) (else (BFalse))))

(def-fns _ $ (many k-inc : (many (KN) a) -> (many (KN) r))
  (let-match many a (MkKN x px))
  (let ((erased lx)) (lt-le-trans (Succ x) (Succ B) u62-modulus (LtS x B px) (LtS B u62-modulus bB)))
  (let ((many y)) (u62-inc x lx))
  (match many (u62-lt-dec y B lx bB) _ ((Yes _ _ _ _ p) (MkKN y p)) ((No _ _ _ _ _) k0)))

(def-fns _ $ (many keys-eq : (subterm many (List (KN)) xs) (many (List (KN)) ys) -> (many (Bool) r))
  (let-match many xs (Cons _ x xr) ((Nil _) (match many ys _ ((Nil _) (BTrue)) ((Cons _ _ _) (BFalse)))))
  (let-match many ys (Cons _ y yr) ((Nil _) (BFalse)))
  (let-match many (k-eq x y) (BTrue) ((BFalse) (BFalse)))
  (tail $ keys-eq xr yr))

(def-fns _ $ (many snoc : (erased Type A) (subterm many (List A) xs) (many A y) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (Cons A y (Nil A))))
  (Cons A x (notail $ snoc A rest y)))

(def-fns _ $ (many but-last : (erased Type A) (subterm many (List A) xs) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (Nil A)))
  (let-match many rest (Cons _ _ _) ((Nil _) (Nil A)))
  (Cons A x (notail $ but-last A rest)))

(def-fns _ $ (many take : (erased Type A) (subterm many (Nat) n) (many (List A) xs) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) (Nil A)))
  (let-match many xs (Cons _ x rest) ((Nil _) (Nil A)))
  (Cons A x (notail $ take A n1 rest)))

(def-fns _ $ (many repeat : (erased Type A) (subterm many (Nat) n) (many A x) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) (Nil A)))
