  (many MkSide : (many (List (Cnd)) cs) (many (Nat) open) -> (Side)))

(def-fns _ $ (many side : (many (Side) sd) (many (Bool) fl) (many (Nat) t pos q) (many (List (Bool)) nr) (many (Bool) h) (many (List (Bool)) fr)
    -> (many (Maybe (CycF)) r) (many (Side) sd2))
