  (let-match many (tab-get t i) (Some _ key) ((None _) more))
  (let-match many key (Cons _ b _) ((Nil _) more))
  (match many (k-eq b k0) _ ((BTrue) (Cons (Bool) (BFalse) more)) ((BFalse) (Cons (Bool) (BTrue) more))))

