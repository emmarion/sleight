  (many MkTab : (many (KN) n) (many (HMap (KN)) ids) (many (HMap (List (KN))) keys) (many (HMap (List (KN))) ix) -> (Tab)))

(def-fns _ $ (many tab-get : (many (Tab) t) (many (KN) i) -> (many (Maybe (List (KN))) k))
  (let-match many t (MkTab _ _ keys _))
  (hat _ keys i (Nil (KN))))

