(def-fns _ $ (erased add-mono-l : (erased (Nat) a b x s t) (subterm erased (Lt a b) l) (erased (Add a x s) p) (erased (Add b x t) q) -> (erased (Lt s t) r))
  (match erased l _
    ((LtZ b1)
      (let-match erased p (AddZero _))
      (let-match erased q (AddSucc _ _ t1 q1))
      (add-le-left x b1 t1 (add-comm b1 x t1 q1)))
    ((LtS a1 b1 m1x)
      (let-match erased p (AddSucc _ _ s1 pk1))
      (let-match erased q (AddSucc _ _ t1 q1))
      (LtS s1 t1 (add-mono-l a1 b1 x s1 t1 m1x pk1 q1)))))

(def-fns _ $ (erased add-mono-r : (erased (Nat) a x y s t) (erased (Lt x y) l) (erased (Add a x s) p) (erased (Add a y t) q) -> (erased (Lt s t) r))
  (add-mono-l x y a s t l (add-comm a x s p) (add-comm a y t q)))

(def-fns _ $ (erased mul-mono-l : (erased (Nat) a b c r t) (subterm erased (Lt a b) l) (erased (Mul a c r) p) (erased (Mul b c t) q)
    (erased (Lt (Zero) c) pos) -> (erased (Lt r t) res))
  (match erased l _
    ((LtZ b1)
      (let-match erased p (MulZero _))
      (let-match erased q (MulSucc _ _ t1 _ _ qa))
      (lt-pos t1 t (add-pos-lt t1 c t qa pos)))
    ((LtS a1 b1 m1x)
      (let-match erased p (MulSucc _ _ r1 _ pk1 pa))
      (let-match erased q (MulSucc _ _ t1 _ q1 qa))
      (add-mono-l r1 t1 c r t (mul-mono-l a1 b1 c r1 t1 m1x pk1 q1 pos) pa qa))))

