  (let-match many fuel (Succ f) ((Zero) m))
  (let ((many ks) (many s2)) (take-digs 10 s))
  (let ((many ds) (many s3)) (take-digs 2 s2))
  (let-match many ds (Cons _ a ds1) ((Nil _) m))
  (let-match many ds1 (Cons _ b _) ((Nil _) m))
  (let ((many a10) (erased _)) (mul (kv a) 10))
  (let ((many i) (erased _)) (add a10 (kv b)))
  (tail $ hint-map f s3 (hset _ m ks i)))

(def-fns _ $ (many hints-of : (many (String) s) -> (many (HMap (Nat)) m))
  (let ((many n) (erased _)) (str-length s))
  (tail $ hint-map n s (HE (Nat))))

(def-fns _ $ (many ch-is : (many (Char) c d) -> (many (Bool) b))
  (match many (char-eq c d) _ ((Equal _ _ _) (BTrue)) (else (BFalse))))

(def-fns _ $ (many pt-of : (many (Char) c1 c2 c3) -> (many (PT) x))
  (let-match many (ch-is c1 #\-) (BFalse) ((BTrue) (Undef)))
  (let-match many (ch-is c1 #\H) (BFalse) ((BTrue) (Def (Hlt))))
  (let ((many d)) (match many (ch-is c2 #\R) (((Mv) e)) ((BTrue) (DR)) ((BFalse) (DL))))
  (Def (Mov (ch-is c1 #\1) d (dig c3))))

(def-fns _ $ (many pts-of : (subterm many (Nat) n) (many (String) s) -> (many (List (PT)) p) (many (String) s2))
  (let-match many n (Succ n1) ((Zero) (values (Nil (PT)) s)))
  (let-match many s (SCons c1 s1) ((SNil) (values (Nil (PT)) s)))
  (let-match many s1 (SCons c2 s3) ((SNil) (values (Nil (PT)) s)))
  (let-match many s3 (SCons c3 s4) ((SNil) (values (Nil (PT)) s)))
  (let ((many p) (many s5)) (notail $ pts-of n1 s4))
  (values (Cons (PT) (pt-of c1 c2 c3) p) s5))

(def-fns _ $ (many holes-from : (subterm many (Nat) fuel) (many (Nat) k) (many (String) s) -> (many (List (List (PT))) hl))
  (let-match many fuel (Succ f) ((Zero) (Nil _)))
  (let-match many s (SCons _ _) ((SNil) (Nil _)))
  (let ((many p) (many s2)) (pts-of k s))
  (Cons _ p (notail $ holes-from f k s2)))

(def-fns _ $ (many holes-of : (many (Nat) k) (many (String) s) -> (many (List (List (PT))) hl))
  (let ((many n) (erased _)) (str-length s))
  (tail $ holes-from n k s))

(def-fns _ $ (many nth-opt : (erased Type A) (subterm many (List A) xs) (many (Nat) i) -> (many (Maybe A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (None A)))
  (let-match many i (Succ i1) ((Zero) (Some A x)))
  (tail $ nth-opt A rest i1))

(def-adts $ (Try : -> Type)
  enum
  (many TGot : (many (Cert) ct) -> (Try))
  (many TMiss : -> (Try))
  (many TBad : -> (Try)))

(def-fns _ $ (many stage-try : (many (Stage) st) (many (List (PT)) p) (unique (WS) w) -> (many (Try) r) (unique (WS) w2 at w))
  (let-match many st (MkStage _ hs hm _))
  (let-match many hm (Some _ m)
    ((None _)
      (let ((many r) (unique w1)) (gen-cert p hs w))
      (values (match many r (((Try) t)) ((Some _ ct) (TGot ct)) ((None _) (TMiss))) w1)))
  (let-match many (hfind _ m (pt-key p)) (Some _ i) ((None _) (values (TMiss) w)))
  (let-match many (nth-opt _ hs i) (Some _ se) ((None _) (values (TBad) w)))
  (let ((many r) (unique w1)) (search p se 24 w))
  (let-match many r (Some _ ct) ((None _) (values (TBad) w1)))
  (values (TGot ct) w1))

(def-fns _ $ (many eq-pts : (subterm many (List (PT)) a) (many (List (PT)) b) -> (many (Maybe (Eq (List (PT)) a b)) r))
  (let-match many a (Cons _ x xs) ((Nil _) (match many b _ ((Nil _) (Some _ (Refl (List (PT)) a))) ((Cons _ _ _) (None _)))))
  (let-match many b (Cons _ y ys) ((Nil _) (None _)))
  (let-match many (notail $ eq-pts xs ys) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many x (Def t) ((Undef) (match many y _ ((Undef) (Some _ (Refl (List (PT)) a))) ((Def _) (None _)))))
  (let-match many y (Def u) ((Undef) (None _)))
  (let-match many (eq-tr t u) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl (List (PT)) a)))

(def-fns _ $ (many find-hole : (many (List (PT)) p) (subterm many (List (List (PT))) hl) -> (many (Maybe (Mem (List (PT)) p hl)) r))
  (let-match many hl (Cons _ x rest) ((Nil _) (None _)))
  (let-match many (eq-pts p x) (None _) ((Some _ e) (let-match erased e (Refl _ _)) (Some _ (MemHere (List (PT)) p rest))))
  (let-match many (notail $ find-hole p rest) (Some _ mm) ((None _) (None _)))
  (Some _ (MemThere (List (PT)) p x rest mm)))

(def-adts
  ((Leaf : ((Nat) n) ((Nat) k) ((List (List (PT))) hl) ((List (PT)) p) -> Type)
    enum
    (many LDone : (erased (Nat) n k) (erased (List (List (PT))) hl) (erased (List (PT)) p) (many (Res (TNode n k hl p)) r) -> (Leaf n k hl p))
    (many LSplit : (erased (Nat) n k) (erased (List (List (PT))) hl) (erased (List (PT)) p) (many (Nat) q) (many (Bool) h)
       (many (Par p q h) pa) -> (Leaf n k hl p))))

(def-fns _ $ (many classify : (many (Nat) n k) (many (List (List (PT))) hl) (many (List (PT)) p) (many (Stage) cur)
    (subterm many (List (Stage)) sts) (many (PSimR p) res) (unique (WS) w) -> (many (Leaf n k hl p) r) (unique (WS) w2 at w))
  (let ((many fail)) (LDone n k hl p (RFail _)))
  (match many res _
    ((PSHalt _ t q l r h pr pl)
      (let-match many (lt-dec (Succ t) (Succ k)) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (values fail w)))
      (values (LDone n k hl p (ROk _ (TH n k hl p t q l r h pr pl lt))) w))
    ((PSUndef _ t q l r h pr pl)
      (values (LSplit n k hl p q h (MkPar p t q 1000 l r h side0 side0 snap0 0 1 pr pl)) w))
    ((PSOut _ t q l r h pr)
      (let ((many tr) (unique w1)) (stage-try cur p w))
      (let-match many tr (TMiss) ((TGot ct) (values (LDone n k hl p (check-cert n k hl p ct)) w1)) ((TBad) (values fail w1)))
      (let-match many (find-hole p hl) (None _) ((Some _ mh) (values (LDone n k hl p (ROk _ (THole n k hl p mh))) w1)))
      (let-match many sts (Cons _ st rest) ((Nil _) (values fail w1)))
      (let-match many st (MkStage lim _ hm _))
      (let-match many hm (Some _ _) ((None _) (tail $ classify n k hl p st rest (psim p lim t q l h r pr) w1)))
      (let ((many tr2) (unique w2)) (stage-try st p w1))
      (let-match many tr2 (TMiss) ((TGot ct) (values (LDone n k hl p (check-cert n k hl p ct)) w2)) ((TBad) (values fail w2)))
      (tail $ classify n k hl p st rest (psim p lim t q l h r pr) w2))))

(def-fns _
  ((many build : (many (Nat) n) (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (List (PT))) hl)
       (many (List (PT)) p) (many (List (Stage)) pn) (many (NS p) ns) (unique (WS) w) -> (many (Res (TNode n k hl p)) r) (unique (WS) w2 at w))
    (let-match many (all-go p) (RFail _) ((ROk _ g) (values (ROk _ (TF n k hl p g)) w)))
    (let-match many pn (Cons _ st0 sts) ((Nil _) (values (RFail _) w)))
    (let-match many st0 (MkStage lim _ _ _))
    (let-match many ns (MkNS _ t0 q0 pos0 lz r0 h0 sr sl snap st nx pr0))
    (let-match many sr (MkSide csr opr))
    (let-match many sl (MkSide csl opl))
    (let ((many fuel)) (match many (lt-dec t0 (Succ lim)) (((Nat) x)) ((Yes _ _ _ _ le) (let ((many d) (erased _)) (sub lim t0 le)) d) ((No _ _ _ _ _) 0)))
    (let ((many lf) (unique w1))
      (match many (nsim p fuel t0 q0 pos0 lz h0 r0 csr csl opr opl snap st nx pr0) (((Leaf n k hl p) x) ((WS) w1 at w))
        ((NRUndef _ q h pa) (values (LSplit n k hl p q h pa) w))
        ((NRCyc _ cf) (let-match many cf (MkCF f t1 D P)) (values (LDone n k hl p (check-cyc n k hl p f t1 D P)) w))
        ((NRHalt _ t q l r h pr pl)
          (let-match many (lt-dec (Succ t) (Succ k)) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (values (LDone n k hl p (RFail _)) w)))
          (values (LDone n k hl p (ROk _ (TH n k hl p t q l r h pr pl lt))) w))
        ((NROut _ ps) (classify n k hl p st0 sts ps w))))
    (let-match many lf (LSplit _ _ _ _ q h pa) ((LDone _ _ _ _ rz) (values rz w1)))
    (let-match many pa (MkPar _ t _ _ l r _ _ _ _ _ _ pr pl))
    (let-match many dep (Succ d1)
      ((Zero) (values (match many (find-hole p hl) (((Res (TNode n k hl p)) x)) ((Some _ mh) (ROk _ (THole n k hl p mh))) ((None _) (RFail _))) w1)))
    (let ((many c)) (seen p (Succ (Zero))))
    (let-match many (below-of c p) (ROk _ bl) ((RFail _) (values (RFail _) w1)))
    (let-match many (uf-of c p) (ROk _ uf) ((RFail _) (values (RFail _) w1)))
    (let-match many (lt-dec q c) (Yes _ _ _ _ lq) ((No _ _ _ _ _) (values (RFail _) w1)))
    (let ((many c2) (many nc))
      (match many (lt-dec c n) (((Nat) c2) ((Res (NextC n c c2)) nc))
        ((Yes _ _ _ _ lcn) (values (Succ c) (ROk _ (NCS n c lcn))))
        ((No _ _ _ _ _) (match many (nat-eq c n) _ ((Equal _ _ _) (values n (ROk _ (NCN n)))) (else (values n (RFail _)))))))
    (let-match many nc (ROk _ nc1) ((RFail _) (values (RFail _) w1)))
    (let ((many xs) (erased rg)) (range c2))
    (let ((many os2) (erased op)) (opts xs))
    (let ((many ra) (unique w2)) (notail $ build-all n d1 os2 k hl p q h pn pa w1))
    (let-match many ra (ROk _ ta) ((RFail _) (values (RFail _) w2)))
    (values (ROk _ (TS n k hl p t q l r h pr pl c c2 xs os2 rg op nc1 uf bl lq ta)) w2))
  ((many build-all : (many (Nat) n) (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (List (PT))) hl)
       (many (List (PT)) p) (many (Nat) q) (many (Bool) h) (many (List (Stage)) pn) (many (Par p q h) pa) (unique (WS) w) ->
       (many (Res (TAll n k hl p q h os)) r) (unique (WS) w2 at w))
    (let-match many os (Cons _ x rest) ((Nil _) (values (ROk _ (TANil n k hl p q h)) w)))
    (let-match many (pset p q h (Def x)) (PSOk _ _ _ _ p2 ps) ((PSNo _ _ _ _) (values (RFail _) w)))
    (let-match many pa (MkPar _ t _ pos l r _ sr sl snap st nx pr pl))
    (let ((many ns)) (MkNS p2 t q pos l r h sr sl snap st nx (prun-set p p2 q h (Def x) _ _ t ps pl pr)))
    (let ((many rn) (unique w1)) (notail $ build n dep rest k hl p2 pn ns w))
    (let-match many rn (ROk _ tn) ((RFail _) (values (RFail _) w1)))
    (let ((many ra) (unique w2)) (notail $ build-all n dep rest k hl p q h pn pa w1))
    (let-match many ra (ROk _ ta) ((RFail _) (values (RFail _) w2)))
    (values (ROk _ (TACons n k hl p p2 q h x rest ps tn ta)) w2)))

(def-fns _ $ (many stages-load : (subterm many (List (Stage)) pn) -> (many (List (Stage)) r))
  (let-match many pn (Cons _ st rest) ((Nil _) (Nil (Stage))))
  (let-match many st (MkStage lim hs hm src))
  (let ((many st2)) (match many src (((Stage) s)) ((None _) st) ((Some _ s) (MkStage lim hs (Some _ (hints-of s)) (None _)))))
  (Cons (Stage) st2 (notail $ stages-load rest)))

(def-fns _ $ (many build-at : (many (Nat) n dep k) (many (List (List (PT))) hl) (many (List (PT)) p) (many (List (Stage)) pn) -> (many (Res (TNode n k hl p)) r))
  (let ((many z)) (Nil (Bool)))
  (let ((many r) (unique _)) (build n dep (Nil (Tr)) k hl p (stages-load pn) (MkNS p 0 (Zero) 1000 z z (BFalse) side0 side0 snap0 0 1 (PRNil p _)) (ws-new)))
  r)

(def-fns _ $ (many build-root : (many (Nat) n dep) (many (List (Tr)) os) (many (Nat) k) (many (List (List (PT))) hl) (many (List (PT)) p)
    (many (List (Stage)) pn) -> (many (Res (TAll n k hl p (Zero) (BFalse) os)) r))
  (let-match many (root-par p) (Some _ pa) ((None _) (RFail _)))
  (let ((many r) (unique _)) (build-all n dep os k hl p (Zero) (BFalse) (stages-load pn) pa (ws-new)))
  r)

(let ((many settings))
  (Cons _ (SN 1 1 0 (BFalse) 100) $ Cons _ (SN 2 2 0 (BFalse) 200) $ Cons _ (SN 3 3 0 (BFalse) 400) $
   Cons _ (SN 2 2 2 (BFalse) 1600) $ Cons _ (SN 3 3 2 (BFalse) 1600) $ Cons _ (SN 2 2 4 (BFalse) 600) $
   Cons _ (SN 3 3 4 (BFalse) 1600) $ Cons _ (SN 2 2 6 (BFalse) 3200) $ Cons _ (SN 3 3 6 (BFalse) 3200) $
   Cons _ (SN 2 2 8 (BFalse) 1600) $ Cons _ (SN 3 3 8 (BFalse) 1600) $ Cons _ (SN 2 2 0 (BTrue) 10000) $
   Cons _ (SN 4 4 10 (BFalse) 10000) $ Cons _ (SW 2 3 10000) $ Nil (Setting)))

(def-lvl BD)
(def-fns _ $ (many sub-of : (many (Nat) n dep k) (many (List (List (PT))) hl) (many (List (Stage)) pn) (many (List (PT)) p)
    -> (many (Fn BD -> (many (Res (TNode n k hl p)) r)) f))
  (def-fns BD $ (many go : -> (many (Res (TNode n k hl p)) r)) (build-at n dep k hl p pn))
  go)

(def-fns _ $ (many top-of : (many (Nat) n dep) (many (List (Tr)) os) (many (Nat) k) (many (List (PT)) p) (many (List (Stage)) pn)
    (many (List (List (PT))) hl) -> (many (Fn BD -> (many (Res (TAll n k hl p (Zero) (BFalse) os)) r)) f))
  (def-fns BD $ (many go : -> (many (Res (TAll n k hl p (Zero) (BFalse) os)) r)) (build-root n dep os k hl p pn))
  go)
