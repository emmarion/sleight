      (match many b0 _
        ((Bit0) (HN A h2 k2 v2 (notail $ hput A c0 h q pq k v) c1 c2 c3))
        ((Bit1) (HN A h2 k2 v2 c0 (notail $ hput A c1 h q pq k v) c2 c3))))
    ((Bit1)
