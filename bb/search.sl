  (let ((many z)) (Nil (Bool)))
  (let-match many (find-cyc p 100 0 0 128 z (BFalse) z (Nil (HEnt)) (MkHE 9 0 z (BFalse) z) 0 1) (Some _ cf) ((None _) (RFail _)))
  (let-match many cf (MkCF f t1 D P))
  (tail $ check-cyc n k p f t1 D P))

