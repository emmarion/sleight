      ((BFalse) (match many (lt-dec p1 ex) (((Nat) a) ((List (Bool)) b) ((List (Bool)) c)) ((Yes _ _ _ _ _) (values p1 lq r1)) ((No _ _ _ _ _) (values ex lq r1))))
      ((BTrue) (match many (lt-dec ex p1) (((Nat) a) ((List (Bool)) b) ((List (Bool)) c)) ((Yes _ _ _ _ _) (values p1 r1 lq)) ((No _ _ _ _ _) (values ex r1 lq))))))
  (let-match many (cand fl q1 p1 ex1 q nr1 fr1 nr h1 h) (None _) ((Some _ D) (Some _ (MkPair _ _ (Succ k) D))))
  (tail $ scan rest fl (Succ k) ex1 q nr h))

(def-fns _ $ (many side : (many (List (HEnt)) hs) (many (Bool) fl) (many (Nat) t pos q) (many (List (Bool)) nr) (many (Bool) h) (many (List (Bool)) fr)
    -> (many (Maybe (CycF)) r))
  (let-match many fr (Nil _) ((Cons _ _ _) (None _)))
