(def-adts $ (KN : -> Type)
  enum newtype
  (many MkKN : (many (Nat) n) (erased (Lt n B) p) -> (KN)))

(let ((many k0)) (MkKN 0 pk0))
(let ((many k1)) (MkKN 1 pk1))

(def-fns _ $ (many kn : (many (Nat) x) -> (many (KN) k))
  (match many (lt-dec x B) _ ((Yes _ _ _ _ p) (MkKN x p)) ((No _ _ _ _ _) k0)))

(def-fns _ $ (many kv : (many (KN) k) -> (many (Nat) x))
