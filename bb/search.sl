(def-fns _ $ (many init-st : (many (Setting) se) -> (unique (Tab) sy st) (many (KN) li ri) (many (Nat) cap) (many (List (Nat)) acc))
  (let ((unique sy1)) (tab-of (BFalse) (Cons _ (Cons (KN) k0 (Nil (KN))) $ Cons _ (Cons (KN) k1 (Nil (KN))) $ Nil (List (KN))) (tab-new)))
  (let-match many se (SW ln _ cap)
