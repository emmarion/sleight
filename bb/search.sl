  (many MkSnap : (many (Nat) q) (many (List (Bool)) l) (many (Bool) h) (many (List (Bool)) r) -> (Snap)))

(def-fns _ $ (many cfg-eq : (many (Snap) a) (many (Nat) q) (many (List (Bool)) l) (many (Bool) h) (many (List (Bool)) r) -> (many (Bool) b))
