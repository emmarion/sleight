        ((Bit0) (HN A h2 k2 v2 c0 c1 (notail $ hput A c2 h q pq k v) c3))
        ((Bit1) (HN A h2 k2 v2 c0 c1 c2 (notail $ hput A c3 h q pq k v)))))))

