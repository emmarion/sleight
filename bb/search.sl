(def-fns _ $ (many nats-eq : (subterm many (List (Nat)) xs) (many (List (Nat)) ys) -> (many (Bool) r))
  (let-match many xs (Cons _ x xr) ((Nil _) (match many ys _ ((Nil _) (BTrue)) ((Cons _ _ _) (BFalse)))))
  (let-match many ys (Cons _ y yr) ((Nil _) (BFalse)))
  (let-match many (nat-eq x y) (Equal _ _ _) (else (BFalse)))
  (tail $ nats-eq xr yr))

(def-fns _ $ (many key-index : (many (List (Nat)) k) (subterm many (List (List (Nat))) t) (many (Nat) i) -> (many (Maybe (Nat)) r))
  (let-match many t (Cons _ x rest) ((Nil _) (None _)))
  (match many (nats-eq k x) _
    ((BTrue) (Some _ i))
    ((BFalse) (tail $ key-index k rest (Succ i)))))

(def-fns _ $ (many snoc : (erased Type A) (subterm many (List A) xs) (many A y) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (Cons A y (Nil A))))
  (Cons A x (notail $ snoc A rest y)))

(def-fns _ $ (many but-last : (erased Type A) (subterm many (List A) xs) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (Nil A)))
  (let-match many rest (Cons _ _ _) ((Nil _) (Nil A)))
  (Cons A x (notail $ but-last A rest)))

(def-fns _ $ (many take : (erased Type A) (subterm many (Nat) n) (many (List A) xs) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) (Nil A)))
  (let-match many xs (Cons _ x rest) ((Nil _) (Nil A)))
  (Cons A x (notail $ take A n1 rest)))

(def-fns _ $ (many repeat : (erased Type A) (subterm many (Nat) n) (many A x) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) (Nil A)))
  (Cons A x (notail $ repeat A n1 x)))

(def-fns _ $ (many intern : (many (List (Nat)) k) (many (List (List (Nat))) t) -> (many (Nat) i) (many (List (List (Nat))) t2) (many (Bool) new))
  (let-match many (key-index k t 0) (None _) ((Some _ i) (values i t (BFalse))))
  (let ((many n) (erased _)) (list-count _ t))
  (values n (snoc _ t k) (BTrue)))

(def-fns _ $ (many bits : (subterm many (List (List (Nat))) t) -> (many (List (Bool)) bs))
  (let-match many t (Cons _ key rest) ((Nil _) (Nil (Bool))))
  (let ((many more)) (notail $ bits rest))
  (let-match many key (Cons _ b _) ((Nil _) more))
  (match many b _
    ((Zero) (Cons (Bool) (BFalse) more))
    ((Succ _) (Cons (Bool) (BTrue) more))))

(def-adts $ (GSt : -> Type)
  enum
  (many MkGSt : (many (List (List (Nat))) sy) (many (List (List (Nat))) st) (many (List (ACN)) S) (many (Bool) ch) -> (GSt)))

(def-adts $ (Push : -> Type)
  enum
  (many MkPush : (many (Nat) q2) (many (Dir) d) (many (Nat) sid) (many (List (List (Nat))) sy) (many (Nat) no)
     (many (List (List (Nat))) st) (many (Bool) new) (many (Nat) P pi) -> (Push)))

(def-fns _ $ (many push : (many (List (PT)) p) (many (Nat) H) (many (ACN) a) (many (GSt) g) -> (many (Maybe (Push)) r))
  (let-match many g (MkGSt sy st _ _))
  (let-match many a (MkACN q sl sh sr))
  (let-match many (nth-r _ sy sh) (NOk _ _ _ hs _) ((NNo _ _ _) (None _)))
  (let-match many hs (Cons _ hb hist) ((Nil _) (None _)))
  (let ((many b)) (match many hb (((Bool) b)) ((Zero) (BFalse)) (else (BTrue))))
  (let-match many (plook p q b) (PLOk _ _ _ x _) ((PLNo _ _ _) (None _)))
  (let-match many x (Def t) ((Undef) (None _)))
  (let-match many t (Go w d q2) ((Halt) (None _)))
  (let ((many wn)) (match many w (((Nat) n)) ((BFalse) 0) ((BTrue) 1)))
  (let ((many sid) (many sy2) (many _)) (intern (Cons (Nat) wn (take _ H (Cons (Nat) q hist))) sy))
  (let ((many O) (many oi) (many P) (many pi))
    (match many d (((Nat) O) ((Nat) oi) ((Nat) P) ((Nat) pi)) ((DL) (values 1 sr 0 sl)) ((DR) (values 0 sl 1 sr))))
  (let-match many (nth-r _ st oi) (NOk _ _ _ okey _) ((NNo _ _ _) (None _)))
  (let-match many okey (Cons _ _ o) ((Nil _) (None _)))
  (let ((many no) (many st2) (many new)) (intern (Cons (Nat) O (Cons (Nat) sid (but-last _ o))) st))
  (Some _ (MkPush q2 d sid sy2 no st2 new P pi)))

(def-fns _ $ (many add-pair : (many (Nat) q2) (many (Dir) d) (many (Nat) no p0 P) (many (List (Nat)) pt)
    (many (List (Nat)) key) (many (Nat) i) (many (List (ACN)) S) (many (Bool) ch) -> (many (List (ACN)) S2) (many (Bool) ch2))
  (let-match many key (Cons _ side g) ((Nil _) (values S ch)))
  (let-match many (nat-eq side P) (Equal _ _ _) (else (values S ch)))
  (let-match many (nats-eq (but-last _ g) pt) (BTrue) ((BFalse) (values S ch)))
  (let ((many a)) (match many d (((ACN) a)) ((DL) (MkACN q2 i p0 no)) ((DR) (MkACN q2 no p0 i))))
  (let-match many (find-acn a S) (RFail _) ((ROk _ _) (values S ch)))
  (values (snoc _ S a) (BTrue)))

(def-fns _ $ (many pair-all : (many (Nat) q2) (many (Dir) d) (many (Nat) no p0 P) (many (List (Nat)) pt)
    (subterm many (List (List (Nat))) t) (many (Nat) i) (many (List (ACN)) S) (many (Bool) ch) -> (many (List (ACN)) S2) (many (Bool) ch2))
  (let-match many t (Cons _ key rest) ((Nil _) (values S ch)))
  (let ((many S1) (many ch1)) (add-pair q2 d no p0 P pt key i S ch))
  (tail $ pair-all q2 d no p0 P pt rest (Succ i) S1 ch1))

(def-fns _ $ (many step-cfg : (many (List (PT)) p) (many (Nat) H) (many (ACN) a) (many (GSt) g) -> (many (Maybe (GSt)) r))
  (let-match many (push p H a g) (Some _ pu) ((None _) (None _)))
  (let-match many pu (MkPush q2 d _ sy2 no st2 new P pi))
  (let-match many g (MkGSt _ _ S ch))
  (let-match many (nth-r _ st2 pi) (NOk _ _ _ pkey _) ((NNo _ _ _) (None _)))
  (let-match many pkey (Cons _ _ pg) ((Nil _) (None _)))
  (let-match many pg (Cons _ p0 pt) ((Nil _) (None _)))
  (let ((many ch1)) (match many new (((Bool) c)) ((BTrue) (BTrue)) ((BFalse) ch)))
  (let ((many S2) (many ch2)) (pair-all q2 d no p0 P pt st2 0 S ch1))
  (Some _ (MkGSt sy2 st2 S2 ch2)))

(def-fns _ $ (many pass : (many (List (PT)) p) (many (Nat) H) (subterm many (List (ACN)) T) (many (GSt) g) -> (many (Maybe (GSt)) r))
  (let-match many T (Cons _ a rest) ((Nil _) (Some _ g)))
  (let-match many (step-cfg p H a g) (Some _ g2) ((None _) (None _)))
  (tail $ pass p H rest g2))

(def-fns _ $ (many fixpoint : (many (List (PT)) p) (many (Nat) H cap) (subterm many (Nat) fuel) (many (GSt) g) -> (many (Maybe (GSt)) r))
  (let-match many fuel (Succ f) ((Zero) (None _)))
  (let-match many g (MkGSt sy st S _))
  (let-match many (pass p H S (MkGSt sy st S (BFalse))) (Some _ g2) ((None _) (None _)))
  (let-match many g2 (MkGSt _ _ S2 ch))
  (let ((many n) (erased _)) (list-count _ S2))
  (let-match many (lt-dec n cap) (Yes _ _ _) ((No _ _ _) (None _)))
  (match many ch _ ((BFalse) (Some _ g2)) ((BTrue) (tail $ fixpoint p H cap f g2))))

(def-fns _ $ (many choices : (many (List (PT)) p) (many (Nat) H) (subterm many (List (ACN)) T) (many (GSt) g) ->
    (many (Maybe (List (Pair (Nat) (Nat)))) r))
  (let-match many T (Cons _ a rest) ((Nil _) (Some _ (Nil (Pair (Nat) (Nat))))))
  (let-match many (push p H a g) (Some _ pu) ((None _) (None _)))
  (let-match many pu (MkPush _ _ sid _ no _ _ _ _))
  (let-match many (notail $ choices p H rest g) (Some _ cs) ((None _) (None _)))
  (Some _ (Cons (Pair (Nat) (Nat)) (MkPair _ _ sid no) cs)))

(def-fns _ $ (many edges-to : (many (Nat) i side c) (many (List (Nat)) gt) (subterm many (List (List (Nat))) t) (many (Nat) j)
    (many (List (Edge)) acc) -> (many (List (Edge)) es))
  (let-match many t (Cons _ key rest) ((Nil _) acc))
  (let ((many more)) (notail $ edges-to i side c gt rest (Succ j) acc))
  (let-match many key (Cons _ s2 g2) ((Nil _) more))
  (let-match many (nat-eq s2 side) (Equal _ _ _) (else more))
  (let-match many (nats-eq (but-last _ g2) gt) (BTrue) ((BFalse) more))
  (Cons (Edge) (MkE i c j) more))

(def-fns _ $ (many edges-from : (many (List (List (Nat))) all) (subterm many (List (List (Nat))) t) (many (Nat) i) -> (many (List (Edge)) es))
  (let-match many t (Cons _ key rest) ((Nil _) (Nil (Edge))))
  (let ((many more)) (notail $ edges-from all rest (Succ i)))
  (let-match many key (Cons _ side g) ((Nil _) more))
  (let-match many g (Cons _ c gt) ((Nil _) more))
  (edges-to i side c gt all 0 more))

(def-fns _ $ (many ngram : (many (List (PT)) p) (many (Nat) H k cap) -> (many (Maybe (Cert)) r))
  (let ((many z)) (repeat _ k 0))
  (let ((many sy)) (Cons _ (Cons (Nat) 0 (Nil (Nat))) (Nil (List (Nat)))))
  (let ((many st)) (Cons _ (Cons (Nat) 0 z) $ Cons _ (Cons (Nat) 1 z) $ Nil (List (Nat))))
  (let ((many a0)) (MkACN 0 0 0 1))
  (let-match many (fixpoint p H cap cap (MkGSt sy st (Cons (ACN) a0 (Nil (ACN))) (BFalse))) (Some _ g) ((None _) (None _)))
  (let-match many g (MkGSt sy2 st2 S _))
  (let-match many (choices p H S g) (Some _ ch) ((None _) (None _)))
  (Some _ (MkCert (bits sy2) (edges-from st2 st2 0) (Cons (Nat) 0 $ Cons (Nat) 1 $ Nil (Nat)) S ch a0)))

(def-fns _ $ (many gen-cert : (many (List (PT)) p) (subterm many (List (Pair (Nat) (Nat))) hs) (many (Nat) cap) -> (many (Maybe (Cert)) r))
  (let-match many hs (Cons _ hk rest) ((Nil _) (None _)))
  (let-match many hk (MkPair _ _ H k))
  (let-match many (ngram p H k cap) (None _) ((Some _ c) (Some _ c)))
  (tail $ gen-cert p rest cap))

(def-fns _
  ((many build : (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (Tr)) O) (many (List (PT)) p)
       (many (List (Pair (Nat) (Nat))) hs) (many (Nat) cap lim) -> (many (Res (TNode k O p)) r))
    (match many (psim p lim (Zero) (Zero) (Nil (Bool)) (BFalse) (Nil (Bool)) (PRNil p _)) _
      ((PSHalt _ t q l r h pr pl)
        (let-match many (lt-dec (Succ t) (Succ k)) (Yes _ _ lt) ((No _ _ _) (RFail _)))
        (ROk _ (TH k O p t q l r h pr pl lt)))
      ((PSUndef _ t q l r h pr pl)
        (let-match many dep (Succ d1) ((Zero) (RFail _)))
        (let-match many (notail $ build-all d1 O k O p q h hs cap lim) (ROk _ ta) ((RFail _) (RFail _)))
        (ROk _ (TS k O p t q l r h pr pl ta)))
      ((PSOut _)
        (let-match many (gen-cert p hs cap) (Some _ ct) ((None _) (RFail _)))
        (check-cert k O p ct))))
  ((many build-all : (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (Tr)) O) (many (List (PT)) p)
       (many (Nat) q) (many (Bool) h) (many (List (Pair (Nat) (Nat))) hs) (many (Nat) cap lim) -> (many (Res (TAll k O p q h os)) r))
    (let-match many os (Cons _ x rest) ((Nil _) (ROk _ (TANil k O p q h))))
    (let-match many (pset p q h (Def x)) (PSOk _ _ _ _ p2 ps) ((PSNo _ _ _ _) (RFail _)))
    (let-match many (notail $ build dep rest k O p2 hs cap lim) (ROk _ tn) ((RFail _) (RFail _)))
    (let-match many (notail $ build-all dep rest k O p q h hs cap lim) (ROk _ ta) ((RFail _) (RFail _)))
    (ROk _ (TACons k O p p2 q h x rest ps tn ta))))
