(def-fns _ $ (many nats-eq : (subterm many (List (Nat)) xs) (many (List (Nat)) ys) -> (many (Bool) r))
  (let-match many xs (Cons _ x xr) ((Nil _) (match many ys _ ((Nil _) (BTrue)) ((Cons _ _ _) (BFalse)))))
  (let-match many ys (Cons _ y yr) ((Nil _) (BFalse)))
  (let-match many (nat-eq x y) (Equal _ _ _) (else (BFalse)))
  (tail $ nats-eq xr yr))

(def-fns _ $ (many key-index : (many (List (Nat)) k) (subterm many (List (List (Nat))) t) (many (Nat) i) -> (many (Maybe (Nat)) r))
  (let-match many t (Cons _ x rest) ((Nil _) (None _)))
  (match many (nats-eq k x) _
    ((BTrue) (Some _ i))
    ((BFalse) (tail $ key-index k rest (Succ i)))))

(def-fns _ $ (many snoc : (erased Type A) (subterm many (List A) xs) (many A y) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (Cons A y (Nil A))))
  (Cons A x (notail $ snoc A rest y)))

(def-fns _ $ (many but-last : (erased Type A) (subterm many (List A) xs) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (Nil A)))
  (let-match many rest (Cons _ _ _) ((Nil _) (Nil A)))
  (Cons A x (notail $ but-last A rest)))

(def-fns _ $ (many take : (erased Type A) (subterm many (Nat) n) (many (List A) xs) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) (Nil A)))
  (let-match many xs (Cons _ x rest) ((Nil _) (Nil A)))
  (Cons A x (notail $ take A n1 rest)))

(def-fns _ $ (many repeat : (erased Type A) (subterm many (Nat) n) (many A x) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) (Nil A)))
  (Cons A x (notail $ repeat A n1 x)))

(def-fns _ $ (many intern : (many (List (Nat)) k) (many (List (List (Nat))) t) -> (many (Nat) i) (many (List (List (Nat))) t2) (many (Bool) new))
  (let-match many (key-index k t 0) (None _) ((Some _ i) (values i t (BFalse))))
  (let ((many n) (erased _)) (list-count _ t))
  (values n (snoc _ t k) (BTrue)))

(def-fns _ $ (many bits : (subterm many (List (List (Nat))) t) -> (many (List (Bool)) bs))
  (let-match many t (Cons _ key rest) ((Nil _) (Nil (Bool))))
  (let ((many more)) (notail $ bits rest))
  (let-match many key (Cons _ b _) ((Nil _) more))
  (match many b _
    ((Zero) (Cons (Bool) (BFalse) more))
    ((Succ _) (Cons (Bool) (BTrue) more))))

(def-adts $ (GSt : -> Type)
  enum
  (many MkGSt : (many (List (List (Nat))) sy) (many (List (List (Nat))) st) (many (List (ACN)) S) (many (Bool) ch) -> (GSt)))

(def-adts $ (Setting : -> Type)
  enum
  (many SN : (many (Nat) kl kr H) (many (Bool) lru) (many (Nat) cap) -> (Setting))
  (many SW : (many (Nat) ln T cap) -> (Setting)))

(def-adts $ (Blk : -> Type)
  enum
  (many MkBlk : (many (List (Nat)) w) (many (Nat) k) (many (Bool) plus) -> (Blk)))

(def-fns _ $ (many cat : (erased Type A) (subterm many (List A) xs) (many (List A) ys) -> (many (List A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) ys))
  (Cons A x (notail $ cat A rest ys)))

(def-fns _ $ (many drop : (erased Type A) (subterm many (Nat) n) (many (List A) xs) -> (many (List A) r))
  (let-match many n (Succ n1) ((Zero) xs))
  (let-match many xs (Cons _ _ rest) ((Nil _) xs))
  (tail $ drop A n1 rest))

(def-fns _ $ (many drop-nat : (many (Nat) x) (subterm many (List (Nat)) xs) -> (many (List (Nat)) r))
  (let-match many xs (Cons _ y rest) ((Nil _) xs))
  (let ((many more)) (notail $ drop-nat x rest))
  (match many (nat-eq x y) _ ((Equal _ _ _) more) (else (Cons (Nat) y more))))

(def-fns _ $ (many all-zero : (subterm many (List (Nat)) xs) -> (many (Bool) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (BTrue)))
  (let-match many x (Zero) ((Succ _) (BFalse)))
  (tail $ all-zero rest))

(def-fns _ $ (many enc-blks : (subterm many (List (Blk)) L) -> (many (List (Nat)) r))
  (let-match many L (Cons _ b rest) ((Nil _) (Nil (Nat))))
  (let-match many b (MkBlk w k plus))
  (let ((many f)) (match many plus (((Nat) f)) ((BFalse) 0) ((BTrue) 1)))
  (Cons (Nat) k (Cons (Nat) f (cat _ w (notail $ enc-blks rest)))))

(def-fns _ $ (many rw-enc : (many (List (Nat)) u) (many (List (Blk)) L) -> (many (List (Nat)) r))
  (let ((many n) (erased _)) (list-count _ u))
  (Cons (Nat) n (cat _ u (enc-blks L))))

(def-fns _ $ (many dec-blks : (many (Nat) ln) (subterm many (Nat) fuel) (many (List (Nat)) xs) -> (many (List (Blk)) L))
  (let-match many fuel (Succ f) ((Zero) (Nil (Blk))))
  (let-match many xs (Cons _ k xs1) ((Nil _) (Nil (Blk))))
  (let-match many xs1 (Cons _ fl xs2) ((Nil _) (Nil (Blk))))
  (let ((many plus)) (match many fl (((Bool) b)) ((Zero) (BFalse)) ((Succ _) (BTrue))))
  (Cons (Blk) (MkBlk (take _ ln xs2) k plus) (notail $ dec-blks ln f (drop _ ln xs2))))

(def-fns _ $ (many rw-dec : (many (Nat) ln) (many (List (Nat)) key) -> (many (List (Nat)) u) (many (List (Blk)) L))
  (let-match many key (Cons _ nu rest) ((Nil _) (values (Nil (Nat)) (Nil (Blk)))))
  (let ((many n) (erased _)) (list-count _ rest))
  (values (take _ nu rest) (dec-blks ln n (drop _ nu rest))))

(def-fns _ $ (many rw-push : (many (List (Blk)) L) (many (List (Nat)) w) (many (Nat) T) -> (many (List (Blk)) r))
  (let ((many fresh)) (Cons (Blk) (MkBlk w 1 (BFalse)) L))
  (let-match many L (Cons _ b rest) ((Nil _) (match many (all-zero w) _ ((BTrue) (Nil (Blk))) ((BFalse) fresh))))
  (let-match many b (MkBlk w0 k plus))
  (let-match many (nats-eq w0 w) (BTrue) ((BFalse) fresh))
  (let-match many plus (BFalse) ((BTrue) L))
  (match many (lt-dec (Succ k) T) _
    ((Yes _ _ _) (Cons (Blk) (MkBlk w (Succ k) (BFalse)) rest))
    ((No _ _ _) (Cons (Blk) (MkBlk w T (BTrue)) rest))))

(def-fns _ $ (many rw-pops : (many (Nat) ln T) (many (List (Blk)) L) -> (many (List (Pair (List (Nat)) (List (Blk)))) r))
  (let-match many L (Cons _ b rest) ((Nil _) (Cons _ (MkPair _ _ (repeat _ ln 0) (Nil (Blk))) (Nil _))))
  (let-match many b (MkBlk w k plus))
  (let ((many c)) (match many plus (((Nat) c)) ((BFalse) k) ((BTrue) T)))
  (let ((many first))
    (match many c (((List (Blk)) l))
      ((Zero) rest)
      ((Succ c1) (match many c1 _ ((Zero) rest) ((Succ _) (Cons (Blk) (MkBlk w c1 (BFalse)) rest))))))
  (let ((many one)) (Cons _ (MkPair _ _ w first) (Nil (Pair (List (Nat)) (List (Blk))))))
  (match many plus _ ((BFalse) one) ((BTrue) (Cons _ (MkPair _ _ w L) one))))

(def-fns _ $ (many rw-pop-edges : (many (Nat) side) (subterm many (List (Pair (List (Nat)) (List (Blk)))) ps) ->
    (many (List (Pair (Nat) (List (Nat)))) es))
  (let-match many ps (Cons _ pr rest) ((Nil _) (Nil _)))
  (let ((many more)) (notail $ rw-pop-edges side rest))
  (let-match many pr (MkPair _ _ w L))
  (let-match many w (Cons _ c w1) ((Nil _) more))
  (Cons _ (MkPair _ _ c (Cons (Nat) side (rw-enc w1 L))) more))

(def-fns _ $ (many rw-edges : (many (Nat) ln T side) (many (List (Nat)) g) -> (many (List (Pair (Nat) (List (Nat)))) es))
  (let ((many u) (many L)) (rw-dec ln g))
  (let-match many u (Cons _ c u1) ((Nil _) (rw-pop-edges side (rw-pops ln T L))))
  (Cons _ (MkPair _ _ c (Cons (Nat) side (rw-enc u1 L))) (Nil _)))

(def-fns _ $ (many sn-edges : (many (Nat) side c) (many (List (Nat)) gt) (subterm many (List (List (Nat))) t) -> (many (List (Pair (Nat) (List (Nat)))) es))
  (let-match many t (Cons _ key rest) ((Nil _) (Nil _)))
  (let ((many more)) (notail $ sn-edges side c gt rest))
  (let-match many key (Cons _ s2 g2) ((Nil _) more))
  (let-match many (nat-eq s2 side) (Equal _ _ _) (else more))
  (let-match many (nats-eq (but-last _ g2) gt) (BTrue) ((BFalse) more))
  (Cons _ (MkPair _ _ c key) more))

(def-fns _ $ (many edges-of : (many (Setting) se) (many (List (List (Nat))) st) (many (List (Nat)) key) -> (many (List (Pair (Nat) (List (Nat)))) es))
  (let-match many key (Cons _ side g) ((Nil _) (Nil _)))
  (let-match many se (SN _ _ _ _ _) ((SW ln T _) (rw-edges ln T side g)))
  (let-match many g (Cons _ c gt) ((Nil _) (Nil _)))
  (sn-edges side c gt st))

(def-fns _ $ (many sym-key : (many (Setting) se) (many (Nat) w q hb) (many (List (Nat)) hist) -> (many (List (Nat)) k))
  (let-match many se (SN _ _ H lru _) ((SW _ _ _) (Cons (Nat) w (Nil (Nat)))))
  (let ((many qq) (erased _)) (add q q))
  (let ((many ev) (erased _)) (add qq hb))
  (match many lru _
    ((BTrue) (Cons (Nat) w (Cons (Nat) ev (drop-nat ev hist))))
    ((BFalse) (Cons (Nat) w (take _ H (Cons (Nat) ev hist))))))

(def-fns _ $ (many push-key : (many (Setting) se) (many (Nat) O sid) (many (List (Nat)) o) -> (many (List (Nat)) k))
  (let-match many se (SW ln T _) ((SN _ _ _ _ _) (Cons (Nat) O (Cons (Nat) sid (but-last _ o)))))
  (let ((many u) (many L)) (rw-dec ln o))
  (let ((many u2)) (Cons (Nat) sid u))
  (let ((many n) (erased _)) (list-count _ u2))
  (match many (nat-eq n ln) _
    ((Equal _ _ _) (Cons (Nat) O (rw-enc (Nil (Nat)) (rw-push L u2 T))))
    (else (Cons (Nat) O (rw-enc u2 L)))))

(def-adts $ (Push : -> Type)
  enum
  (many MkPush : (many (Nat) q2) (many (Dir) d) (many (Nat) sid) (many (List (List (Nat))) sy) (many (Nat) no)
     (many (List (List (Nat))) st) (many (Bool) new) (many (Nat) pi) -> (Push)))

(def-fns _ $ (many push : (many (List (PT)) p) (many (Setting) se) (many (ACN) a) (many (GSt) g) -> (many (Maybe (Push)) r))
  (let-match many g (MkGSt sy st _ _))
  (let-match many a (MkACN q sl sh sr))
  (let-match many (nth-r _ sy sh) (NOk _ _ _ hs _) ((NNo _ _ _) (None _)))
  (let-match many hs (Cons _ hb hist) ((Nil _) (None _)))
  (let ((many b)) (match many hb (((Bool) b)) ((Zero) (BFalse)) (else (BTrue))))
  (let-match many (plook p q b) (PLOk _ _ _ x _) ((PLNo _ _ _) (None _)))
  (let-match many x (Def t) ((Undef) (None _)))
  (let-match many t (Go w d q2) ((Halt) (None _)))
  (let ((many wn)) (match many w (((Nat) n)) ((BFalse) 0) ((BTrue) 1)))
  (let ((many sid) (many sy2) (many _)) (intern (sym-key se wn q hb hist) sy))
  (let ((many O) (many oi) (many pi)) (match many d (((Nat) O) ((Nat) oi) ((Nat) pi)) ((DL) (values 1 sr sl)) ((DR) (values 0 sl sr))))
  (let-match many (nth-r _ st oi) (NOk _ _ _ okey _) ((NNo _ _ _) (None _)))
  (let-match many okey (Cons _ _ o) ((Nil _) (None _)))
  (let ((many no) (many st2) (many new)) (intern (push-key se O sid o) st))
  (Some _ (MkPush q2 d sid sy2 no st2 new pi)))

(def-fns _ $ (many add-succ : (many (Nat) q2) (many (Dir) d) (many (Nat) no) (subterm many (List (Pair (Nat) (List (Nat)))) es)
    (many (List (List (Nat))) st) (many (List (ACN)) S) (many (Bool) ch) -> (many (List (List (Nat))) st2) (many (List (ACN)) S2) (many (Bool) ch2))
  (let-match many es (Cons _ e rest) ((Nil _) (values st S ch)))
  (let-match many e (MkPair _ _ c key))
  (let ((many j) (many st1) (many _)) (intern key st))
  (let ((many a)) (match many d (((ACN) a)) ((DL) (MkACN q2 j c no)) ((DR) (MkACN q2 no c j))))
  (match many (find-acn a S) _
    ((ROk _ _) (tail $ add-succ q2 d no rest st1 S ch))
    ((RFail _) (tail $ add-succ q2 d no rest st1 (snoc _ S a) (BTrue)))))

(def-fns _ $ (many step-cfg : (many (List (PT)) p) (many (Setting) se) (many (ACN) a) (many (GSt) g) -> (many (Maybe (GSt)) r))
  (let-match many (push p se a g) (Some _ pu) ((None _) (None _)))
  (let-match many pu (MkPush q2 d _ sy2 no st2 new pi))
  (let-match many g (MkGSt _ _ S ch))
  (let-match many (nth-r _ st2 pi) (NOk _ _ _ pkey _) ((NNo _ _ _) (None _)))
  (let ((many ch1)) (match many new (((Bool) c)) ((BTrue) (BTrue)) ((BFalse) ch)))
  (let ((many st3) (many S2) (many ch2)) (add-succ q2 d no (edges-of se st2 pkey) st2 S ch1))
  (Some _ (MkGSt sy2 st3 S2 ch2)))

(def-fns _ $ (many pass : (many (List (PT)) p) (many (Setting) se) (subterm many (List (ACN)) T) (many (GSt) g) -> (many (Maybe (GSt)) r))
  (let-match many T (Cons _ a rest) ((Nil _) (Some _ g)))
  (let-match many (step-cfg p se a g) (Some _ g2) ((None _) (None _)))
  (tail $ pass p se rest g2))

(def-fns _ $ (many fixpoint : (many (List (PT)) p) (many (Setting) se) (many (Nat) cap) (subterm many (Nat) fuel) (many (GSt) g) -> (many (Maybe (GSt)) r))
  (let-match many fuel (Succ f) ((Zero) (None _)))
  (let-match many g (MkGSt sy st S _))
  (let-match many (pass p se S (MkGSt sy st S (BFalse))) (Some _ g2) ((None _) (None _)))
  (let-match many g2 (MkGSt _ _ S2 ch))
  (let ((many n) (erased _)) (list-count _ S2))
  (let-match many (lt-dec n cap) (Yes _ _ _) ((No _ _ _) (None _)))
  (match many ch _ ((BFalse) (Some _ g2)) ((BTrue) (tail $ fixpoint p se cap f g2))))

(def-fns _ $ (many choices : (many (List (PT)) p) (many (Setting) se) (subterm many (List (ACN)) T) (many (GSt) g) ->
    (many (Maybe (List (Pair (Nat) (Nat)))) r))
  (let-match many T (Cons _ a rest) ((Nil _) (Some _ (Nil (Pair (Nat) (Nat))))))
  (let-match many (push p se a g) (Some _ pu) ((None _) (None _)))
  (let-match many pu (MkPush _ _ sid _ no _ _ _))
  (let-match many (notail $ choices p se rest g) (Some _ cs) ((None _) (None _)))
  (Some _ (Cons (Pair (Nat) (Nat)) (MkPair _ _ sid no) cs)))

(def-fns _ $ (many edge-ids : (many (Nat) i) (subterm many (List (Pair (Nat) (List (Nat)))) es) (many (List (List (Nat))) st) (many (List (Edge)) acc) ->
    (many (List (List (Nat))) st2) (many (List (Edge)) acc2))
  (let-match many es (Cons _ e rest) ((Nil _) (values st acc)))
  (let-match many e (MkPair _ _ c key))
  (let ((many j) (many st1) (many _)) (intern key st))
  (tail $ edge-ids i rest st1 (Cons (Edge) (MkE i c j) acc)))

(def-fns _ $ (many all-edges : (many (Setting) se) (subterm many (Nat) fuel) (many (Nat) i) (many (List (List (Nat))) st) (many (List (Edge)) acc) ->
    (many (Maybe (List (Edge))) es))
  (let-match many fuel (Succ f) ((Zero) (None _)))
  (let-match many (nth-r _ st i) (NOk _ _ _ key _) ((NNo _ _ _) (Some _ acc)))
  (let ((many st2) (many acc2)) (edge-ids i (edges-of se st key) st acc))
  (tail $ all-edges se f (Succ i) st2 acc2))

(def-fns _ $ (many zero-keys : (many (Nat) side) (subterm many (Nat) j) (many (List (List (Nat))) acc) -> (many (List (List (Nat))) r))
  (let-match many j (Succ j1) ((Zero) acc))
  (tail $ zero-keys side j1 (Cons _ (Cons (Nat) side (rw-enc (repeat _ j1 0) (Nil (Blk)))) acc)))

(def-fns _ $ (many init-st : (many (Setting) se) ->
    (many (List (List (Nat))) sy st) (many (Nat) li ri cap) (many (List (Nat)) acc))
  (let-match many se (SW ln _ cap)
    ((SN kl kr _ _ cap)
      (values (Cons _ (Cons (Nat) 0 (Nil (Nat))) (Nil (List (Nat))))
        (Cons _ (Cons (Nat) 0 (repeat _ kl 0)) $ Cons _ (Cons (Nat) 1 (repeat _ kr 0)) $ Nil (List (Nat)))
        0 1 cap (Cons (Nat) 0 $ Cons (Nat) 1 $ Nil (Nat)))))
  (let ((many st)) (zero-keys 0 ln (zero-keys 1 ln (Nil (List (Nat))))))
  (let ((many n) (erased _)) (list-count _ st))
  (let ((many acc) (erased _)) (range n))
  (let ((many ri)) (match many (key-index (Cons (Nat) 1 (rw-enc (but-last _ (repeat _ ln 0)) (Nil (Blk)))) st 0) (((Nat) i)) ((Some _ i) i) ((None _) 0)))
  (values (Cons _ (Cons (Nat) 0 (Nil (Nat))) $ Cons _ (Cons (Nat) 1 (Nil (Nat))) $ Nil (List (Nat))) st 0 ri cap acc))

(def-fns _ $ (many search : (many (List (PT)) p) (many (Setting) se) -> (many (Maybe (Cert)) r))
  (let ((many sy) (many st) (many li) (many ri) (many cap) (many acc)) (init-st se))
  (let ((many a0)) (MkACN 0 li 0 ri))
  (let-match many (fixpoint p se cap cap (MkGSt sy st (Cons (ACN) a0 (Nil (ACN))) (BFalse))) (Some _ g) ((None _) (None _)))
  (let-match many g (MkGSt sy2 st2 S _))
  (let-match many (choices p se S g) (Some _ ch) ((None _) (None _)))
  (let ((many n) (erased _)) (list-count _ st2))
  (let ((many fuel) (erased _)) (add n cap))
  (let-match many (all-edges se fuel 0 st2 (Nil (Edge))) (Some _ es) ((None _) (None _)))
  (Some _ (MkCert (bits sy2) es acc S ch a0)))

(def-fns _ $ (many gen-cert : (many (List (PT)) p) (subterm many (List (Setting)) hs) -> (many (Maybe (Cert)) r))
  (let-match many hs (Cons _ se rest) ((Nil _) (None _)))
  (let-match many (search p se) (None _) ((Some _ c) (Some _ c)))
  (tail $ gen-cert p rest))

(def-fns _ $ (many seen : (subterm many (List (PT)) p) (many (Nat) c) -> (many (Nat) r))
  (let-match many p (Cons _ x rest) ((Nil _) c))
  (let-match many x (Def t) ((Undef) (tail $ seen rest c)))
  (let-match many t (Go _ _ q) ((Halt) (tail $ seen rest c)))
  (let-match many (lt-dec q c) (No _ _ _) ((Yes _ _ _) (tail $ seen rest c)))
  (tail $ seen rest (Succ q)))

(def-fns _ $ (many below-of : (many (Nat) c) (subterm many (List (PT)) p) -> (many (Res (Below c p)) r))
  (let-match many p (Cons _ x rest) ((Nil _) (ROk _ (BlwNil c))))
  (let-match many (notail $ below-of c rest) (ROk _ b) ((RFail _) (RFail _)))
  (let-match many x (Def t) ((Undef) (ROk _ (BlwU c rest b))))
  (let-match many t (Go w d q) ((Halt) (ROk _ (BlwH c rest b))))
  (let-match many (lt-dec q c) (Yes _ _ lq) ((No _ _ _) (RFail _)))
  (ROk _ (BlwG c rest w d q lq b)))

(def-fns _ $ (many uf0 : (subterm many (List (PT)) p) -> (many (Res (UF (Zero) p)) r))
  (let-match many p (Cons _ x0 p1) ((Nil _) (ROk _ (UFZ (Zero) _ (UNil)))))
  (let-match many p1 (Cons _ x1 rest) ((Nil _) (RFail _)))
  (let-match many x0 (Undef) ((Def _) (RFail _)))
  (let-match many x1 (Undef) ((Def _) (RFail _)))
  (let-match many (notail $ uf0 rest) (ROk _ u) ((RFail _) (RFail _)))
  (let-match erased u (UFZ k _ ul))
  (ROk _ (UFZ (Succ k) _ (UCons k rest ul))))

(def-fns _ $ (many uf-of : (subterm many (Nat) c) (many (List (PT)) p) -> (many (Res (UF c p)) r))
  (let-match many c (Succ c1) ((Zero) (tail $ uf0 p)))
  (let-match many p (Cons _ x0 p1) ((Nil _) (RFail _)))
  (let-match many p1 (Cons _ x1 rest) ((Nil _) (RFail _)))
  (let-match many (notail $ uf-of c1 rest) (ROk _ u) ((RFail _) (RFail _)))
  (ROk _ (UFS c1 x0 x1 rest u)))

(def-fns _
  ((many build : (many (Nat) n) (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (PT)) p)
       (many (List (Setting)) hs) (many (Nat) lim) -> (many (Res (TNode n k p)) r))
    (match many (psim p lim (Zero) (Zero) (Nil (Bool)) (BFalse) (Nil (Bool)) (PRNil p _)) _
      ((PSHalt _ t q l r h pr pl)
        (let-match many (lt-dec (Succ t) (Succ k)) (Yes _ _ lt) ((No _ _ _) (RFail _)))
        (ROk _ (TH n k p t q l r h pr pl lt)))
      ((PSUndef _ t q l r h pr pl)
        (let-match many dep (Succ d1) ((Zero) (RFail _)))
        (let ((many c)) (seen p (Succ (Zero))))
        (let-match many (below-of c p) (ROk _ bl) ((RFail _) (RFail _)))
        (let-match many (uf-of c p) (ROk _ uf) ((RFail _) (RFail _)))
        (let-match many (lt-dec q c) (Yes _ _ lq) ((No _ _ _) (RFail _)))
        (let ((many c2) (many nc))
          (match many (lt-dec c n) (((Nat) c2) ((Res (NextC n c c2)) nc))
            ((Yes _ _ lcn) (values (Succ c) (ROk _ (NCS n c lcn))))
            ((No _ _ _) (match many (nat-eq c n) _ ((Equal _ _ _) (values n (ROk _ (NCN n)))) (else (values n (RFail _)))))))
        (let-match many nc (ROk _ nc1) ((RFail _) (RFail _)))
        (let ((many xs) (erased rg)) (range c2))
        (let ((many os2) (erased op)) (opts xs))
        (let-match many (notail $ build-all n d1 os2 k p q h hs lim) (ROk _ ta) ((RFail _) (RFail _)))
        (ROk _ (TS n k p t q l r h pr pl c c2 xs os2 rg op nc1 uf bl lq ta)))
      ((PSOut _)
        (let-match many (gen-cert p hs) (Some _ ct) ((None _) (RFail _)))
        (check-cert n k p ct))))
  ((many build-all : (many (Nat) n) (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (PT)) p)
       (many (Nat) q) (many (Bool) h) (many (List (Setting)) hs) (many (Nat) lim) -> (many (Res (TAll n k p q h os)) r))
    (let-match many os (Cons _ x rest) ((Nil _) (ROk _ (TANil n k p q h))))
    (let-match many (pset p q h (Def x)) (PSOk _ _ _ _ p2 ps) ((PSNo _ _ _ _) (RFail _)))
    (let-match many (notail $ build n dep rest k p2 hs lim) (ROk _ tn) ((RFail _) (RFail _)))
    (let-match many (notail $ build-all n dep rest k p q h hs lim) (ROk _ ta) ((RFail _) (RFail _)))
    (ROk _ (TACons n k p p2 q h x rest ps tn ta))))

(let ((many settings))
  (Cons _ (SN 1 1 0 (BFalse) 100) $ Cons _ (SN 2 2 0 (BFalse) 200) $ Cons _ (SN 3 3 0 (BFalse) 400) $
   Cons _ (SN 2 2 2 (BFalse) 1600) $ Cons _ (SN 3 3 2 (BFalse) 1600) $ Cons _ (SN 2 2 4 (BFalse) 600) $
   Cons _ (SN 3 3 4 (BFalse) 1600) $ Cons _ (SN 2 2 6 (BFalse) 3200) $ Cons _ (SN 3 3 6 (BFalse) 3200) $
   Cons _ (SN 2 2 8 (BFalse) 1600) $ Cons _ (SN 3 3 8 (BFalse) 1600) $ Cons _ (SN 2 2 0 (BTrue) 10000) $
   Cons _ (SN 4 4 10 (BFalse) 10000) $ Cons _ (SW 2 3 10000) $ Nil (Setting)))
