(def-fns _ $ (many nth-opt : (erased Type A) (subterm many (List A) xs) (many (Nat) i) -> (many (Maybe A) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (None A)))
  (let-match many i (Succ i1) ((Zero) (Some A x)))
  (tail $ nth-opt A rest i1))

(def-adts $ (Try : -> Type)
  enum
  (many TGot : (many (Cert) ct) -> (Try))
  (many TMiss : -> (Try))
  (many TBad : -> (Try)))

(def-fns _ $ (many stage-try : (many (Stage) st) (many (List (PT)) p) -> (many (Try) r))
  (let-match many st (MkStage _ hs hm))
  (let-match many hm (Some _ m) ((None _) (match many (gen-cert p hs) _ ((Some _ ct) (TGot ct)) ((None _) (TMiss)))))
  (let-match many (hfind _ m (pt-key p)) (Some _ i) ((None _) (TMiss)))
  (let-match many (nth-opt _ hs i) (Some _ se) ((None _) (TBad)))
  (let-match many (search p se) (Some _ ct) ((None _) (TBad)))
  (TGot ct))

(def-fns _ $ (many eq-pts : (subterm many (List (PT)) a) (many (List (PT)) b) -> (many (Maybe (Eq (List (PT)) a b)) r))
  (let-match many a (Cons _ x xs) ((Nil _) (match many b _ ((Nil _) (Some _ (Refl (List (PT)) a))) ((Cons _ _ _) (None _)))))
  (let-match many b (Cons _ y ys) ((Nil _) (None _)))
  (let-match many (notail $ eq-pts xs ys) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many x (Def t) ((Undef) (match many y _ ((Undef) (Some _ (Refl (List (PT)) a))) ((Def _) (None _)))))
  (let-match many y (Def u) ((Undef) (None _)))
  (let-match many (eq-tr t u) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl (List (PT)) a)))

(def-fns _ $ (many find-hole : (many (List (PT)) p) (subterm many (List (List (PT))) hl) -> (many (Maybe (Mem (List (PT)) p hl)) r))
  (let-match many hl (Cons _ x rest) ((Nil _) (None _)))
  (let-match many (eq-pts p x) (None _) ((Some _ e) (let-match erased e (Refl _ _)) (Some _ (MemHere (List (PT)) p rest))))
  (let-match many (notail $ find-hole p rest) (Some _ mm) ((None _) (None _)))
  (Some _ (MemThere (List (PT)) p x rest mm)))

(def-adts
  ((Leaf : ((Nat) n) ((Nat) k) ((List (List (PT))) hl) ((List (PT)) p) -> Type)
    enum
    (many LDone : (erased (Nat) n k) (erased (List (List (PT))) hl) (erased (List (PT)) p) (many (Res (TNode n k hl p)) r) -> (Leaf n k hl p))
    (many LSplit : (erased (Nat) n k) (erased (List (List (PT))) hl) (erased (List (PT)) p) (many (Nat) q) (many (Bool) h)
       (many (Par p q h) pa) -> (Leaf n k hl p))))

(def-fns _ $ (many classify : (many (Nat) n k) (many (List (List (PT))) hl) (many (List (PT)) p) (many (Stage) cur)
    (subterm many (List (Stage)) sts) (many (PSimR p) res) -> (many (Leaf n k hl p) r))
  (let ((many fail)) (LDone n k hl p (RFail _)))
  (match many res _
    ((PSHalt _ t q l r h pr pl)
      (let-match many (lt-dec (Succ t) (Succ k)) (Yes _ _ _ _ lt) ((No _ _ _ _ _) fail))
      (LDone n k hl p (ROk _ (TH n k hl p t q l r h pr pl lt))))
    ((PSUndef _ t q l r h pr pl)
      (let ((many sd)) (MkSide (Nil (Cnd)) 1000))
      (LSplit n k hl p q h (MkPar p t q 1000 l r h sd sd (MkSnap 9 (Nil (Bool)) (BFalse) (Nil (Bool))) 0 1 pr pl)))
    ((PSOut _ t q l r h pr)
      (let ((many tr)) (stage-try cur p))
      (let-match many tr (TMiss) ((TGot ct) (LDone n k hl p (check-cert n k hl p ct))) ((TBad) fail))
      (let-match many (find-hole p hl) (None _) ((Some _ mh) (LDone n k hl p (ROk _ (THole n k hl p mh)))))
      (let-match many sts (Cons _ st rest) ((Nil _) fail))
      (let-match many st (MkStage lim _ hm))
      (let-match many hm (Some _ _) ((None _) (tail $ classify n k hl p st rest (psim p lim t q l h r pr))))
      (let-match many (stage-try st p) (TMiss) ((TGot ct) (LDone n k hl p (check-cert n k hl p ct))) ((TBad) fail))
      (tail $ classify n k hl p st rest (psim p lim t q l h r pr)))))

(def-fns _
  ((many build : (many (Nat) n) (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (List (PT))) hl)
       (many (List (PT)) p) (many (List (Stage)) pn) (many (NS p) ns) -> (many (Res (TNode n k hl p)) r))
    (let-match many (all-go p) (RFail _) ((ROk _ g) (ROk _ (TF n k hl p g))))
    (let-match many pn (Cons _ st0 sts) ((Nil _) (RFail _)))
    (let-match many st0 (MkStage lim _ _))
    (let-match many ns (MkNS _ t0 q0 pos0 lz r0 h0 sr sl snap st nx pr0))
    (let ((many fuel)) (match many (lt-dec t0 (Succ lim)) (((Nat) x)) ((Yes _ _ _ _ le) (let ((many d) (erased _)) (sub lim t0 le)) d) ((No _ _ _ _ _) 0)))
    (let ((many lf))
      (match many (nsim p fuel t0 q0 pos0 lz h0 r0 sr sl snap st nx pr0) (((Leaf n k hl p) x))
        ((NRUndef _ q h pa) (LSplit n k hl p q h pa))
        ((NRCyc _ cf) (let-match many cf (MkCF f t1 D P)) (LDone n k hl p (check-cyc n k hl p f t1 D P)))
        ((NRHalt _ t q l r h pr pl)
          (let-match many (lt-dec (Succ t) (Succ k)) (Yes _ _ _ _ lt) ((No _ _ _ _ _) (LDone n k hl p (RFail _))))
          (LDone n k hl p (ROk _ (TH n k hl p t q l r h pr pl lt))))
        ((NROut _ ps) (classify n k hl p st0 sts ps))))
    (let-match many lf (LSplit _ _ _ _ q h pa) ((LDone _ _ _ _ rz) rz))
    (let-match many pa (MkPar _ t _ _ l r _ _ _ _ _ _ pr pl))
    (let-match many dep (Succ d1) ((Zero) (RFail _)))
    (let ((many c)) (seen p (Succ (Zero))))
    (let-match many (below-of c p) (ROk _ bl) ((RFail _) (RFail _)))
    (let-match many (uf-of c p) (ROk _ uf) ((RFail _) (RFail _)))
    (let-match many (lt-dec q c) (Yes _ _ _ _ lq) ((No _ _ _ _ _) (RFail _)))
    (let ((many c2) (many nc))
      (match many (lt-dec c n) (((Nat) c2) ((Res (NextC n c c2)) nc))
        ((Yes _ _ _ _ lcn) (values (Succ c) (ROk _ (NCS n c lcn))))
        ((No _ _ _ _ _) (match many (nat-eq c n) _ ((Equal _ _ _) (values n (ROk _ (NCN n)))) (else (values n (RFail _)))))))
    (let-match many nc (ROk _ nc1) ((RFail _) (RFail _)))
    (let ((many xs) (erased rg)) (range c2))
    (let ((many os2) (erased op)) (opts xs))
    (let-match many (notail $ build-all n d1 os2 k hl p q h pn pa) (ROk _ ta) ((RFail _) (RFail _)))
    (ROk _ (TS n k hl p t q l r h pr pl c c2 xs os2 rg op nc1 uf bl lq ta)))
  ((many build-all : (many (Nat) n) (subterm many (Nat) dep) (subterm many (List (Tr)) os) (many (Nat) k) (many (List (List (PT))) hl)
       (many (List (PT)) p) (many (Nat) q) (many (Bool) h) (many (List (Stage)) pn) (many (Par p q h) pa) -> (many (Res (TAll n k hl p q h os)) r))
    (let-match many os (Cons _ x rest) ((Nil _) (ROk _ (TANil n k hl p q h))))
    (let-match many (pset p q h (Def x)) (PSOk _ _ _ _ p2 ps) ((PSNo _ _ _ _) (RFail _)))
    (let-match many pa (MkPar _ t _ pos l r _ sr sl snap st nx pr pl))
    (let ((many ns)) (MkNS p2 t q pos l r h sr sl snap st nx (prun-set p p2 q h (Def x) _ _ t ps pl pr)))
    (let-match many (notail $ build n dep rest k hl p2 pn ns) (ROk _ tn) ((RFail _) (RFail _)))
    (let-match many (notail $ build-all n dep rest k hl p q h pn pa) (ROk _ ta) ((RFail _) (RFail _)))
    (ROk _ (TACons n k hl p p2 q h x rest ps tn ta))))

(def-fns _ $ (many build-root : (many (Nat) n dep) (many (List (Tr)) os) (many (Nat) k) (many (List (List (PT))) hl) (many (List (PT)) p)
    (many (List (Stage)) pn) -> (many (Res (TAll n k hl p (Zero) (BFalse) os)) r))
  (let-match many (root-par p) (Some _ pa) ((None _) (RFail _)))
  (tail $ build-all n dep os k hl p (Zero) (BFalse) pn pa))

