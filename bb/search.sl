        k0 k1 cap (Cons (Nat) 0 $ Cons (Nat) 1 $ Nil (Nat)))))
  (let ((many keys)) (zero-keys k0 ln (zero-keys k1 ln (Nil (List (KN))))))
  (let ((many st)) (tab-of (BFalse) keys (empty-tab)))
  (let ((many n) (erased _)) (list-count _ keys))
