  (tail $ tab-of ixd rest t1))

(def-fns _ $ (many tab-bits : (many (Tab) t) (many (KN) i) (subterm many (Nat) n) -> (many (List (Bool)) bs))
  (let-match many n (Succ n1) ((Zero) (Nil (Bool))))
