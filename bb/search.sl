(def-fns _ $ (many enc-blks : (subterm many (List (Blk)) L) -> (many (List (KN)) r))
  (let-match many L (Cons _ b rest) ((Nil _) (Nil (KN))))
  (let-match many b (MkBlk w k plus))
  (let ((many f)) (match many plus (((KN) f)) ((BFalse) k0) ((BTrue) k1)))
  (Cons (KN) k (Cons (KN) f (cat _ w (notail $ enc-blks rest)))))

(def-fns _ $ (many rw-enc : (many (List (KN)) u) (many (List (Blk)) L) -> (many (List (KN)) r))
  (let ((many n) (erased _)) (list-count _ u))
  (Cons (KN) (kn n) (cat _ u (enc-blks L))))

(def-fns _ $ (many dec-blks : (many (Nat) ln) (subterm many (Nat) fuel) (many (List (KN)) xs) -> (many (List (Blk)) L))
  (let-match many fuel (Succ f) ((Zero) (Nil (Blk))))
  (let-match many xs (Cons _ k xs1) ((Nil _) (Nil (Blk))))
  (let-match many xs1 (Cons _ fl xs2) ((Nil _) (Nil (Blk))))
  (Cons (Blk) (MkBlk (take _ ln xs2) k (match many (k-eq fl k0) (((Bool) b)) ((BTrue) (BFalse)) ((BFalse) (BTrue))))
    (notail $ dec-blks ln f (drop _ ln xs2))))

(def-fns _ $ (many rw-dec : (many (Nat) ln) (many (List (KN)) key) -> (many (List (KN)) u) (many (List (Blk)) L))
  (let-match many key (Cons _ nu rest) ((Nil _) (values (Nil (KN)) (Nil (Blk)))))
  (let ((many n) (erased _)) (list-count _ rest))
  (let ((many m)) (kv nu))
  (values (take _ m rest) (dec-blks ln n (drop _ m rest))))

(def-fns _ $ (many rw-push : (many (List (Blk)) L) (many (List (KN)) w) (many (Nat) T) -> (many (List (Blk)) r))
  (let ((many fresh)) (Cons (Blk) (MkBlk w k1 (BFalse)) L))
  (let-match many L (Cons _ b rest) ((Nil _) (match many (all-zero w) _ ((BTrue) (Nil (Blk))) ((BFalse) fresh))))
  (let-match many b (MkBlk w0 k plus))
  (let-match many (keys-eq w0 w) (BTrue) ((BFalse) fresh))
  (let-match many plus (BFalse) ((BTrue) L))
  (let ((many k2)) (k-inc k))
  (match many (lt-dec (kv k2) T) _
    ((Yes _ _ _ _ _) (Cons (Blk) (MkBlk w k2 (BFalse)) rest))
    ((No _ _ _ _ _) (Cons (Blk) (MkBlk w (kn T) (BTrue)) rest))))

(def-fns _ $ (many rw-pops : (many (Nat) ln T) (many (List (Blk)) L) -> (many (List (Pair (List (KN)) (List (Blk)))) r))
  (let-match many L (Cons _ b rest) ((Nil _) (Cons _ (MkPair _ _ (repeat _ ln k0) (Nil (Blk))) (Nil _))))
  (let-match many b (MkBlk w k plus))
  (let ((many c)) (match many plus (((Nat) c)) ((BFalse) (kv k)) ((BTrue) T)))
  (let ((many first))
    (match many c (((List (Blk)) l))
      ((Zero) rest)
      ((Succ c1) (match many c1 _ ((Zero) rest) ((Succ _) (Cons (Blk) (MkBlk w (kn c1) (BFalse)) rest))))))
  (let ((many one)) (Cons _ (MkPair _ _ w first) (Nil (Pair (List (KN)) (List (Blk))))))
  (let-match many plus (BTrue) ((BFalse) one))
  (let ((many low)) (Cons _ (MkPair _ _ w (Cons (Blk) (MkBlk w k1 (BFalse)) rest)) one))
  (let ((many more)) (match many c (((List (Pair (List (KN)) (List (Blk)))) m)) ((Zero) low) ((Succ c1) (match many c1 (((List (Pair (List (KN)) (List (Blk)))) m)) ((Zero) low) ((Succ _) one)))))
  (Cons _ (MkPair _ _ w L) more))

