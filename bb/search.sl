(def-fns _ $ (many edges-of : (many (Setting) se) (many (Tab) st) (many (List (KN)) key) -> (many (List (Pair (KN) (Tgt))) es))
  (let-match many key (Cons _ side g) ((Nil _) (Nil _)))
  (let-match many se (SN _ _ _ _ _) ((SW ln T _) (rw-edges ln T side g)))
  (let-match many g (Cons _ c gt) ((Nil _) (Nil _)))
  (with-c c (ix-get st (Cons (KN) side gt))))

(def-fns _ $ (many sym-key : (many (Setting) se) (many (KN) w q hb) (many (List (KN)) hist) -> (many (List (KN)) k))
  (let-match many se (SN _ _ H lru _) ((SW _ _ _) (Cons (KN) w (Nil (KN)))))
  (let ((many qq) (erased _)) (add (kv q) (kv q)))
  (let ((many ev0) (erased _)) (add qq (kv hb)))
  (let ((many ev)) (kn ev0))
  (match many lru _
    ((BTrue) (Cons (KN) w (Cons (KN) ev (drop-k ev hist))))
    ((BFalse) (Cons (KN) w (take _ H (Cons (KN) ev hist))))))

(def-fns _ $ (many push-key : (many (Setting) se) (many (KN) O sid) (many (List (KN)) o) -> (many (List (KN)) k))
  (let-match many se (SW ln T _) ((SN _ _ _ _ _) (Cons (KN) O (Cons (KN) sid (but-last _ o)))))
  (let ((many u) (many L)) (rw-dec ln o))
  (let ((many u2)) (Cons (KN) sid u))
  (let ((many n) (erased _)) (list-count _ u2))
  (match many (nat-eq n ln) _
    ((Equal _ _ _) (Cons (KN) O (rw-enc (Nil (KN)) (rw-push L u2 T))))
    (else (Cons (KN) O (rw-enc u2 L)))))

(def-adts $ (Push : -> Type)
  enum
  (many MkPush : (many (KN) q2) (many (Dir) d) (many (KN) sid) (many (Tab) sy) (many (List (KN)) nk) (many (KN) pi) -> (Push)))

(def-fns _ $ (many push : (many (List (PT)) p) (many (Setting) se) (many (KC) a) (many (Tab) sy st) -> (many (Maybe (Push)) r))
  (let-match many a (MkKC q sl sh sr))
  (let-match many (tab-get sy sh) (Some _ hs) ((None _) (None _)))
  (let-match many hs (Cons _ hb hist) ((Nil _) (None _)))
  (let ((many b)) (match many (k-eq hb k0) (((Bool) b)) ((BTrue) (BFalse)) ((BFalse) (BTrue))))
  (let-match many (plook p (kv q) b) (PLOk _ _ _ x _) ((PLNo _ _ _) (None _)))
  (let-match many x (Def t) ((Undef) (None _)))
