      ((Some _ io) (let-match many io (MkInfo sid no2 tg)) (inf-set ch src (MkInfo sid no2 (Cons (Nat) (kv x) tg))))
      ((None _) ch)))
  (tail $ fire j rest (MkGSt sy st S ch2 ss W wt n)))

(def-fns _ $ (many waits : (many (HMap (List (Wait))) wt) (many (List (KN)) pk) -> (many (List (Wait)) ws))
