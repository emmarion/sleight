  (let-match many (nat-eq q1 q) (Equal _ _ _) (else (BFalse)))
  (let-match many (bit-eq h1 h) (BTrue) ((BFalse) (BFalse)))
  (let-match many (same la l) (BTrue) ((BFalse) (BFalse)))
  (tail $ same r1 r))

(def-adts
  ((Par : ((List (PT)) p) ((Nat) q) ((Bool) h) -> Type)
    enum
    (many MkPar : (erased (List (PT)) p) (many (Nat) t q pos) (many (List (Bool)) l r) (many (Bool) h) (many (Side) sr sl) (many (Snap) snap)
       (many (Nat) st nx) (erased (PRunTo p (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) t (MkConf q l h r)) pr) (erased (PLook p q h (Undef)) pl) -> (Par p q h))))

(def-adts
  ((NS : ((List (PT)) p) -> Type)
    enum
    (many MkNS : (erased (List (PT)) p) (many (Nat) t q pos) (many (List (Bool)) l r) (many (Bool) h) (many (Side) sr sl) (many (Snap) snap)
       (many (Nat) st nx) (erased (PRunTo p (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) t (MkConf q l h r)) pr) -> (NS p))))

(def-adts
  ((NR : ((List (PT)) p) -> Type)
    enum
    (many NRCyc : (erased (List (PT)) p) (many (CycF) cf) -> (NR p))
    (many NRHalt : (erased (List (PT)) p) (many (Nat) t) (erased (Nat) q) (erased (List (Bool)) l r) (erased (Bool) h)
       (erased (PRunTo p (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) t (MkConf q l h r)) pr) (erased (PLook p q h (Def (Hlt))) pl) -> (NR p))
    (many NRUndef : (erased (List (PT)) p) (many (Nat) q) (many (Bool) h) (many (Par p q h) pa) -> (NR p))
    (many NROut : (erased (List (PT)) p) (many (PSimR p) r) -> (NR p))))

(def-fns _ $ (many nsim : (many (List (PT)) p) (subterm many (Nat) fuel) (many (Nat) t q pos) (many (List (Bool)) l) (many (Bool) h)
    (many (List (Bool)) r) (many (Side) sr sl) (many (Snap) snap) (many (Nat) st nx) (erased (PRunTo p (MkConf (Zero) (Nil (Bool)) (BFalse) (Nil (Bool))) t (MkConf q l h r)) pr)
    -> (many (NR p) res))
  (let ((many out)) (NROut p (PSOut p t q l r h pr)))
  (let-match many fuel (Succ f) ((Zero) out))
  (let-match many (cfg-eq snap q l h r) (BFalse)
    ((BTrue)
      (let ((many n) (erased _)) (list-count _ l))
      (let-match many (lt-dec st (Succ t)) (Yes _ _ _ _ le) ((No _ _ _ _ _) out))
      (let ((many P) (erased _)) (sub t st le))
      (NRCyc p (MkCF (BFalse) st n P))))
  (let ((many cr) (many sr2)) (side sr (BFalse) t pos q l h r))
  (let-match many cr (None _) ((Some _ c) (NRCyc p c)))
  (let ((many cl) (many sl2)) (side sl (BTrue) t pos q r h l))
  (let-match many cl (None _) ((Some _ c) (NRCyc p c)))
  (let-match many (plook p q h) (PLOk _ _ _ x pl) ((PLNo _ _ _) out))
  (let-match many x (Def tr) ((Undef) (NRUndef p q h (MkPar p t q pos l r h sr sl snap st nx pr pl))))
  (let-match many tr (Mov w d q2) ((Hlt) (NRHalt p t q l r h pr pl)))
  (let ((many snap2) (many st2) (many nx2))
    (match many (nat-eq t nx) (((Snap) a) ((Nat) b) ((Nat) c))
      ((Equal _ _ _) (let ((many n2) (erased _)) (add nx nx)) (values (MkSnap q l h r) t n2))
      (else (values snap st nx))))
  (match many d _
    ((DL)
      (let-match many pos (Succ pos1) ((Zero) out))
      (let ((many h2) (many l2) (erased pp)) (pop l))
      (tail $ nsim p f (Succ t) q2 pos1 l2 h2 (Cons (Bool) w r) sr2 sl2 snap2 st2 nx2
        (PRSnoc p _ _ _ t pr (PStepL p q q2 l r l2 h w h2 pl pp))))
    ((DR)
      (let ((many h2) (many r2) (erased pp)) (pop r))
      (tail $ nsim p f (Succ t) q2 (Succ pos) (Cons (Bool) w l) h2 r2 sr2 sl2 snap2 st2 nx2
        (PRSnoc p _ _ _ t pr (PStepR p q q2 l r r2 h w h2 pl pp))))))

(def-fns _ $ (many root-par : (many (List (PT)) p) -> (many (Maybe (Par p (Zero) (BFalse))) r))
  (let-match many (plook p (Zero) (BFalse)) (PLOk _ _ _ x pl) ((PLNo _ _ _) (None _)))
  (let-match many x (Undef) ((Def _) (None _)))
  (let ((many z)) (Nil (Bool)))
  (let ((many sd)) (MkSide (Nil (Cnd)) 1000))
  (Some _ (MkPar p 0 (Zero) 1000 z z (BFalse) sd sd (MkSnap 9 z (BFalse) z) 0 1 (PRNil p _) pl)))

(def-fns _ $ (many seen : (subterm many (List (PT)) p) (many (Nat) c) -> (many (Nat) r))
  (let-match many p (Cons _ x rest) ((Nil _) c))
  (let-match many x (Def t) ((Undef) (tail $ seen rest c)))
  (let-match many t (Mov _ _ q) ((Hlt) (tail $ seen rest c)))
  (let-match many (lt-dec q c) (No _ _ _ _ _) ((Yes _ _ _ _ _) (tail $ seen rest c)))
  (tail $ seen rest (Succ q)))

(def-fns _ $ (many below-of : (many (Nat) c) (subterm many (List (PT)) p) -> (many (Res (Below c p)) r))
  (let-match many p (Cons _ x rest) ((Nil _) (ROk _ (BlwNil c))))
  (let-match many (notail $ below-of c rest) (ROk _ b) ((RFail _) (RFail _)))
  (let-match many x (Def t) ((Undef) (ROk _ (BlwU c rest b))))
  (let-match many t (Mov w d q) ((Hlt) (ROk _ (BlwH c rest b))))
  (let-match many (lt-dec q c) (Yes _ _ _ _ lq) ((No _ _ _ _ _) (RFail _)))
  (ROk _ (BlwG c rest w d q lq b)))

(def-fns _ $ (many uf0 : (subterm many (List (PT)) p) -> (many (Res (UF (Zero) p)) r))
