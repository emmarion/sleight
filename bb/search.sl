(def-fns _ $ (many cfg-eq : (many (HEnt) a) (many (Nat) q) (many (List (Bool)) l) (many (Bool) h) (many (List (Bool)) r) -> (many (Bool) b))
  (let-match many a (MkHE q1 _ la h1 r1))
  (let-match many (nat-eq q1 q) (Equal _ _ _) (else (BFalse)))
  (let-match many (bit-eq h1 h) (BTrue) ((BFalse) (BFalse)))
  (let-match many (same la l) (BTrue) ((BFalse) (BFalse)))
  (tail $ same r1 r))

(def-fns _ $ (many find-cyc : (many (List (PT)) p) (subterm many (Nat) fuel) (many (Nat) t q pos) (many (List (Bool)) l) (many (Bool) h)
    (many (List (Bool)) r) (many (List (HEnt)) hs) (many (HEnt) snap) (many (Nat) st nx) -> (many (Maybe (CycF)) res))
  (let-match many fuel (Succ f) ((Zero) (None _)))
  (let-match many (cfg-eq snap q l h r) (BFalse)
    ((BTrue)
      (let ((many n) (erased _)) (list-count _ l))
      (let-match many (lt-dec st (Succ t)) (Yes _ _ _ _ le) ((No _ _ _ _ _) (None _)))
      (let ((many P) (erased _)) (sub t st le))
      (Some _ (MkCF (BFalse) st n P))))
  (let-match many (side hs (BFalse) t pos q l h r) (None _) ((Some _ c) (Some _ c)))
  (let-match many (side hs (BTrue) t pos q r h l) (None _) ((Some _ c) (Some _ c)))
  (let-match many (plook p q h) (PLOk _ _ _ x _) ((PLNo _ _ _) (None _)))
  (let-match many x (Def tr) ((Undef) (None _)))
  (let-match many tr (Go w d q2) ((Halt) (None _)))
  (let ((many cur)) (MkHE q pos l h r))
  (let ((many hs2)) (Cons (HEnt) cur hs))
  (let ((many snap2) (many st2) (many nx2))
    (match many (nat-eq t nx) (((HEnt) a) ((Nat) b) ((Nat) c))
      ((Equal _ _ _) (let ((many n2) (erased _)) (add nx nx)) (values cur t n2))
      (else (values snap st nx))))
  (match many d _
    ((DL)
      (let-match many pos (Succ pos1) ((Zero) (None _)))
      (let ((many h2) (many l2) (erased _)) (pop l))
      (tail $ find-cyc p f (Succ t) q2 pos1 l2 h2 (Cons (Bool) w r) hs2 snap2 st2 nx2))
    ((DR)
      (let ((many h2) (many r2) (erased _)) (pop r))
      (tail $ find-cyc p f (Succ t) q2 (Succ pos) (Cons (Bool) w l) h2 r2 hs2 snap2 st2 nx2))))

