(def-fns _ $ (many cand : (many (Bool) fl) (many (Nat) q1 p1 ex q) (many (List (Bool)) nr1 fr1 nr) (many (Bool) h1 h) -> (many (Maybe (Nat)) r))
  (let-match many fr1 (Nil _) ((Cons _ _ _) (None _)))
  (let-match many (nat-eq q1 q) (Equal _ _ _) (else (None _)))
  (let-match many (bit-eq h1 h) (BTrue) ((BFalse) (None _)))
  (let ((many a) (many b)) (match many fl (((Nat) a) ((Nat) b)) ((BFalse) (values ex p1)) ((BTrue) (values p1 ex))))
  (let-match many (lt-dec a (Succ b)) (Yes _ _ _ _ le) ((No _ _ _ _ _) (None _)))
  (let ((many D) (erased _)) (sub b a le))
  (let-match many (pre-same D nr1 nr) (BTrue) ((BFalse) (None _)))
