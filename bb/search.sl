(def-fns _ $ (many ht-next : (many (Nat) mask i) (erased (Lt (Succ mask) u62-modulus) pm) (erased (Lt i (Succ mask)) li) ->
    (many (Nat) j) (erased (Lt j (Succ mask)) lj))
  (let ((erased ls)) (lt-le-trans (Succ i) (Succ (Succ mask)) u62-modulus (LtS i (Succ mask) li) (LtS (Succ mask) u62-modulus pm)))
  (let ((erased lm)) (lt-trans mask (Succ mask) u62-modulus (lt-succ mask) pm))
  (let ((many j) (erased bw)) (u62-and (u62-inc i ls) mask ls lm))
  (values j (and-le _ _ _ bw)))

(def-fns _ $ (many ht-start : (many (Nat) mask) (erased (Lt (Succ mask) u62-modulus) pm) (many (List (KN)) k) ->
    (many (Nat) h) (erased (Lt h u62-modulus) ph) (many (Nat) i) (erased (Lt i (Succ mask)) li))
