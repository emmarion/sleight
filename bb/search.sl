  (let ((many a0)) (MkKC k0 li k0 ri))
  (let ((many as)) (Cons (KC) a0 (Nil (KC))))
  (let ((many fuel0) (erased _)) (add cap cap))
  (let-match many (run-wl p se cap fuel0 (MkGSt sy st as (HE (Info)) (hset _ (HE (KN)) (kc-key a0) k0) (Cons _ (MkPair _ _ a0 k0) (Nil _)) (HE (List (Wait))) 1)) (Some _ g)
    ((None _) (None _)))
  (let-match many g (MkGSt sy2 st2 S inf ss _ _ _))
  (let-match many st2 (MkTab n _ _ _))
  (let ((many fuel) (erased _)) (add (kv n) cap))
  (let ((many adj0) (many st3)) (all-rows se fuel k0 st2 (Nil _)))
  (let-match many adj0 (Some _ adjr) ((None _) (None _)))
  (let ((many Sd)) (rev _ S (Nil (KC))))
  (let-match many (chs inf k0 Sd) (Some _ ch) ((None _) (None _)))
  (let-match many sy2 (MkTab nsy _ _ _))
  (Some _ (MkCert (tab-bits sy2 k0 (kv nsy)) (rev _ adjr (Nil _)) acc (acn-of Sd) ch (MkACN 0 (kv li) 0 (kv ri)))))

