(def-fns _ $ (many tab-intern : (many (Bool) ixd) (many (List (KN)) k) (many (Tab) t) -> (many (KN) i) (many (Tab) t2) (many (Bool) new))
  (let-match many t (MkTab n ids keys ix))
  (let ((many h)) (hash k 0 pk0))
  (let-match many (hat _ ids h k) (None _) ((Some _ i) (values i t (BFalse))))
