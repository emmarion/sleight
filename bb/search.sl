  (let ((many op1)) (ext fl op pos))
  (let-match many fr (Nil _) ((Cons _ _ _) (values (None _) (MkSide cs op1))))
  (let ((many cs1)) (match many cs (((List (Cnd)) x)) ((Nil _) cs) ((Cons _ e rest) (let-match many e (MkCnd t1 q1 p1 _ nr1 h1)) (Cons _ (MkCnd t1 q1 p1 op1 nr1 h1) rest))))
  (let ((many sd2)) (MkSide (Cons _ (MkCnd t q pos pos nr h) cs1) pos))
  (let-match many (scan cs fl op1 q nr h) (Some _ kd) ((None _) (values (None _) sd2)))
  (let-match many kd (MkPair _ _ t1 D))
  (let-match many (lt-dec t1 (Succ t)) (Yes _ _ _ _ le) ((No _ _ _ _ _) (values (None _) sd2)))
  (let ((many P) (erased _)) (sub t t1 le))
  (values (Some _ (MkCF fl t1 D P)) sd2))

