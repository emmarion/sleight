        (let-match many k (Cons _ side g) ((Nil _) ix))
        (let ((many pk)) (Cons (KN) side (but-last _ g)))
        (hset _ ix pk (Cons _ n (ix-get t pk))))))
  (values n (MkTab (k-inc n) (hat-put _ ids h k n) (hat-put _ keys n (Nil (KN)) k) ix2) (BTrue)))

(def-fns _ $ (many tab-of : (many (Bool) ixd) (subterm many (List (List (KN))) ks) (many (Tab) t) -> (many (Tab) t2))
  (let-match many ks (Cons _ k rest) ((Nil _) t))
  (let ((many _) (many t1) (many _)) (tab-intern ixd k t))
  (tail $ tab-of ixd rest t1))

(def-fns _ $ (many tab-bits : (many (Tab) t) (many (KN) i) (subterm many (Nat) n) -> (many (List (Bool)) bs))
  (let-match many n (Succ n1) ((Zero) (Nil (Bool))))
  (let ((many more)) (notail $ tab-bits t (k-inc i) n1))
  (let-match many (tab-get t i) (Some _ key) ((None _) more))
  (let-match many key (Cons _ b _) ((Nil _) more))
  (match many (k-eq b k0) _ ((BTrue) (Cons (Bool) (BFalse) more)) ((BFalse) (Cons (Bool) (BTrue) more))))

