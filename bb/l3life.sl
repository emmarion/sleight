(def-fns _ $ (erased phi-chain : (erased (Fam) F) (erased (Nat) n s s2) (subterm erased (Nat) k) (erased (List (Tk)) X Z) (erased (Tt) T U)
    (erased (FamOK F) ok) (erased (MaxS F n) mx) (erased (Lt s (Succ n)) bn) (erased (Add (Succ k) s2 s) a) (erased (Phi F s X T) ph) (erased (Phi F s2 Z U) ph2)
    -> (erased (Nat) w) (erased (RdK (Succ k) X T Z U w) rk))
  (let-match erased a (AddSucc _ _ s1 a1))
  (let-match erased bn (LtS _ _ bn1))
  (let-match erased k (Succ k1) ((Zero)
    (let-match erased a1 (AddZero _))
    (let ((erased c) (erased rd)) (conj F s1 X Z T U ok ph ph2))
    (values c (RkS (Zero) c (Zero) c X Z Z T U U rd (RkZ Z U) (add-zero-right c)))))
  (let ((erased Y) (erased T2) (erased ph1)) (phi-run F s1 n ok mx (lt-weaken s1 n bn1)))
  (let ((erased c) (erased rd)) (conj F s1 X Y T T2 ok ph ph1))
  (let ((erased u) (erased rk1)) (phi-chain F n s1 s2 k1 Y Z T2 U ok mx (lt-weaken s1 n bn1) a1 ph1 ph2))
  (let ((erased w) (erased cw)) (add-ex c u))
  (values w (RkS k c u w X Y Z T T2 U rd rk1 cw)))

(def-fns _ $ (many rl-run : (subterm many (List (Tk)) X) -> (many (Nat) a) (erased (Rl X (Zero) a) r))
  (let-match many X (Cons _ x X1) ((Nil _) (values (Zero) (RlN (Zero)))))
  (let ((many a1) (erased r1)) (notail $ rl-run X1))
  (match many x _
    ((Tp) (values (Succ a1) (RlP X1 (Zero) a1 r1)))
    ((T0) (values (Succ (Succ (Succ a1))) (RlZ X1 (Zero) a1 r1)))
    ((T1) (values (Succ (Succ (Succ (Succ a1)))) (RlO X1 (Zero) a1 r1)))))

(def-fns _ $ (many tn-run : (many (Tt) T) -> (many (Nat) b) (erased (Tn T (Zero) b) tb))
  (match many T _
    ((TtE) (values (Zero) (TwE (Zero))))
    ((Tt1) (values (Succ (Zero)) (Tw1 (Zero))))
    ((Tt11) (values (Succ (Succ (Zero))) (Tw11 (Zero))))
    ((Tt011) (values (Succ (Succ (Succ (Zero)))) (Tw011 (Zero))))
    ((Tt0011) (values (Succ (Succ (Succ (Succ (Zero))))) (Tw0011 (Zero))))))

(def-fns _ $ (many cells : (many (List (Tk)) X) (many (Tt) T) -> (many (Nat) e) (erased (Nat) a b) (erased (Rl X (Zero) a) ra) (erased (Tn T (Zero) b) tb)
    (erased (Add a b e) ae))
  (let ((many a) (erased ra)) (rl-run X))
  (let ((many b) (erased tb)) (tn-run T))
  (let ((many e) (erased ae)) (add a b))
  (values e a b ra tb ae))

(def-adts
  ((FamOKR : ((Fam) F) -> Type)
    enum
    (many FkOk : (erased (Fam) F) (erased (FamOK F) ok) -> (FamOKR F))
    (many FkNo : (erased (Fam) F) -> (FamOKR F))))

(def-fns _ $ (many famok : (many (Fam) F) -> (many (FamOKR F) r))
  (match many F _
    ((FE P T) (match many T _ ((TtE) (FkOk _ (OkE P T (PlE)))) ((Tt1) (FkOk _ (OkE P T (Pl1)))) (else (FkNo _))))
    ((FO P T) (match many T _ ((TtE) (FkOk _ (OkO P T (PlE)))) ((Tt1) (FkOk _ (OkO P T (Pl1)))) (else (FkNo _))))
    ((FVE P) (let-match many P (Succ P1) ((Zero) (FkNo _))) (FkOk _ (OkVE P1)))
    ((FVO P) (let-match many P (Succ P1) ((Zero) (FkNo _))) (FkOk _ (OkVO P1)))))

(def-adts $ (Gap : -> Type)
  enum
  (many GFront : -> (Gap))
  (many GLen : (many (Nat) g) -> (Gap)))

(def-fns _ $ (many gap-of : (many (List (Rn)) rest) -> (many (Gap) g))
  (let-match many rest (Cons _ rn R3) ((Nil _) (GFront)))
  (let-match many rn (MkRn b g))
  (let-match many b (BFalse) ((BTrue) (GLen (Zero))))
  (let-match many R3 (Cons _ _ _) ((Nil _) (GFront)))
  (GLen g))

(def-fns _ $ (many jump-room : (many (Bool) front) (many (Nat) g) -> (many (Bool) b))
  (let-match many front (BFalse) ((BTrue) (BTrue)))
  (match many (lt-dec 2 g) _ ((Yes _ _ _ _ _) (BTrue)) ((No _ _ _ _ _) (BFalse))))

(def-fns _ $ (many min-nat : (many (Nat) a) (many (Nat) b) -> (many (Nat) c))
  (match many (lt-dec a b) _ ((Yes _ _ _ _ _) a) ((No _ _ _ _ _) b)))

(def-fns _ $ (many jump-k : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Fam) F) (many (Nat) s n) (erased (FamOK F) ok) (erased (MaxS F n) mx)
    (erased (Lt s (Succ n)) bn) (many (List (Tk)) X) (many (Tt) T) (erased (Phi F s X T) ph) (many (Nat) ex) (erased (Nat) a1 b1) (erased (Rl X (Zero) a1) ra1)
    (erased (Tn T (Zero) b1) tb1) (erased (Add a1 b1 ex) ae1) (many (Bool) front) (many (Nat) k) (subterm many (Nat) tries) -> (many (Rs l3 c0) res))
  (let-match many tries (Succ tries1) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many k (Succ k1) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many (lt-dec k (Succ s)) (Yes _ _ _ _ ks) ((No _ _ _ _ _) (RsNo l3 c0 e ch)))
  (let ((many s2) (erased as2)) (sub s k ks))
  (let ((many Z) (many U) (erased ph2)) (phi-run F s2 n ok mx (le-tr s2 s n (add-le-left s2 k s (add-comm k s2 s as2)) bn)))
  (let ((erased w0) (erased rk)) (phi-chain F n s s2 k1 X Z T U ok mx bn as2 ph ph2))
  (let ((many ez) (erased a2) (erased b2) (erased ra2) (erased tb2) (erased ae2)) (cells Z U))
  (let ((many m) (erased mk)) (mul k (Succ (Succ (Succ (Zero))))))
  (let ((many em) (erased aem)) (add ez m))
  (let-match many (lt-dec ex (Succ em)) (Yes _ _ _ _ le) ((No _ _ _ _ _) (RsNo l3 c0 e ch)))
  (let ((many w) (erased aw)) (sub em ex le))
  (let ((erased S) (erased q1) (erased q2)) (rdk-cells k w0 X Z T U rk a1 b1 a2 b2 ex ez m ra1 tb1 ra2 tb2 ae1 ae2 mk))
  (let-match erased (add-fn ez m S em q2 aem) (Refl _ _))
  (let-match erased (add-cancel ex w0 w S q1 aw) (Refl _ _))
  (let-match many (apply-rdk c0 e ch k w X Z T U rk) (RsNo _ _ _ _) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (match many front _
    ((BTrue)
      (let ((many e2) (erased ch2)) (rch-padr l3 c0 e ch w))
      (let-match many (apply-rdk c0 e2 ch2 k w X Z T U rk) (RsOk _ _ e3 ch3) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
      (RsOk l3 c0 e3 ch3))
    ((BFalse)
      (let ((many k2) (many _) (erased _) (erased _) (erased _) (erased _)) (divmod k (Succ (Succ (Zero))) (LtZ _)))
      (tail $ jump-k c0 e ch F s n ok mx bn X T ph ex a1 b1 ra1 tb1 ae1 front k2 tries1))))

(def-fns _ $ (many try-jump : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match many e (MkRq q L h R))
  (let-match many R (Cons _ rn R1) ((Nil _) (RsNo l3 c0 e ch)))
  (let-match many rn (MkRn b a0))
  (let-match many b (BFalse) ((BTrue) (RsNo l3 c0 e ch)))
  (let-match many a0 (Succ a) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many (parse a R1) (MkPX X0 T0 rest) ((NoPX) (RsNo l3 c0 e ch)))
  (let ((many g) (many front)) (match many (gap-of rest) (((Nat) g) ((Bool) f)) ((GFront) (values 0 (BTrue))) ((GLen g0) (values g0 (BFalse)))))
  (let-match many (jump-room front g) (BTrue) ((BFalse) (RsNo l3 c0 e ch)))
  (let-match many (decode X0 T0) (DecOk F s) ((DecNo) (RsNo l3 c0 e ch)))
  (let-match many (famok F) (FkOk _ ok) ((FkNo _) (RsNo l3 c0 e ch)))
  (let ((many n) (erased mx)) (maxs-run F))
  (let-match many (lt-dec s (Succ n)) (Yes _ _ _ _ bn) ((No _ _ _ _ _) (RsNo l3 c0 e ch)))
  (let ((many X) (many T) (erased ph)) (phi-run F s n ok mx bn))
  (let ((many ex) (erased a1) (erased b1) (erased ra1) (erased tb1) (erased ae1)) (cells X T))
  (let ((many g3) (many _) (erased _) (erased _) (erased _) (erased _)) (divmod g (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let ((many k)) (match many front (((Nat) k)) ((BTrue) s) ((BFalse) (min-nat g3 s))))
  (jump-k c0 e ch F s n ok mx bn X T ph ex a1 b1 ra1 tb1 ae1 front k (Succ (Succ (Succ (Succ (Zero)))))))

(def-fns _ $ (many lmom : (many (Nat) q) (many (Bool) h) (many (List (Rn)) L) -> (many (Bool) b))
  (let-match many h (BTrue) ((BFalse) (BFalse)))
  (let-match many (nat-eq q 2) (Equal _ _ _) (else (BFalse)))
  (let-match many L (Cons _ rn _) ((Nil _) (BFalse)))
  (let-match many rn (MkRn b n))
  (let-match many b (BFalse) ((BTrue) (BFalse)))
  (match many (lt-dec 1 n) _ ((Yes _ _ _ _ _) (BTrue)) ((No _ _ _ _ _) (BFalse))))

(def-fns _ $ (many l3move2 : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) r))
  (let-match many e (MkRq q L h R))
  (let-match many (lmom q h L) (BTrue) ((BFalse) (rmove l3 m2 mm c0 e ch)))
  (let-match many (try-jump c0 e ch) (RsNo _ _ e1 ch1) ((RsOk _ _ e1 ch1) (RsOk l3 c0 e1 ch1)))
  (l3move m2 mm c0 e1 ch1))

(def-fns _ $ (many l3run2 : (many (List (Tr)) m2) (erased (MirM m2 l3) mm) (erased (Conf) c0) (subterm many (Nat) fuel) (many (Rq) e) (erased (Rch l3 c0 e) ch)
    -> (many (Rq) e2) (erased (Rch l3 c0 e2) ch2))
  (let-match many fuel (Succ f) ((Zero) (values e ch)))
  (let-match many (l3move2 m2 mm c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (values e1 ch1)))
  (tail $ l3run2 m2 mm c0 f e1 ch1))
