(def-fns _ $ (many ws-skip : (subterm many (String) s) -> (many (String) t))
  (let-match many s (SCons ch rest) ((SNil) s))
  (let-match many (digit-of ch) (None _) ((Some _ _) s))
  (tail $ ws-skip rest))

(def-fns _ $ (many rd-dig : (subterm many (String) s) (many (Nat) acc) -> (many (Nat) n) (many (String) t))
  (let-match many s (SCons ch rest) ((SNil) (values acc s)))
  (let-match many (digit-of ch) (Some _ d) ((None _) (values acc s)))
  (tail $ rd-dig rest (nat-add (nat-mul ten acc) d)))

(def-fns _ $ (many tok : (many (String) s) -> (many (Nat) n) (many (String) t))
  (rd-dig (ws-skip s) (Zero)))

(def-fns _ $ (many num-bit : (many (Nat) n) -> (many (Bool) b))
  (match many n _ ((Zero) (BFalse)) ((Succ _) (BTrue))))

(def-fns _ $ (many bit-nat : (many (Bool) b) -> (many (Nat) n))
  (match many b _ ((BFalse) 0) ((BTrue) 1)))

(def-fns _ $ (many rd-runs : (subterm many (Nat) k) (many (String) s) (many (List (Rn)) tl) -> (many (List (Rn)) L) (many (String) t))
  (let-match many k (Succ j1) ((Zero) (values tl s)))
  (let ((many b) (many s1)) (tok s))
  (let ((many n) (many s2)) (tok s1))
  (let ((many L1) (many s3)) (notail $ rd-runs j1 s2 tl))
  (values (Cons _ (MkRn (num-bit b) n) L1) s3))

(def-fns _ $ (many drop-runs : (subterm many (Nat) k) (many (List (Rn)) L) -> (many (List (Rn)) L2))
  (let-match many k (Succ j1) ((Zero) L))
  (let-match many L (Cons _ _ L1) ((Nil _) L))
  (tail $ drop-runs j1 L1))

(def-fns _ $ (many rd-side : (many (String) s) (many (List (Rn)) old) -> (many (List (Rn)) L) (many (String) t))
  (let ((many k) (many s1)) (tok s))
  (rd-runs k s1 old))

(def-fns _ $ (many rd-diff : (many (String) s) (many (List (Rn)) old) -> (many (List (Rn)) L) (many (String) t))
  (let ((many k) (many s1)) (tok s))
  (rd-side s1 (drop-runs k old)))

(def-fns _ $ (many rd-cfg : (many (String) s) -> (many (Rq) e) (many (String) t))
  (let ((many q) (many s1)) (tok s))
  (let ((many h) (many s2)) (tok s1))
  (let ((many L) (many s3)) (rd-side s2 (Nil (Rn))))
  (let ((many R) (many s4)) (rd-side s3 (Nil (Rn))))
  (values (MkRq q L (num-bit h) R) s4))

(def-fns _ $ (many rd-patch : (many (String) s) (many (Rq) e) -> (many (Rq) e2) (many (String) t))
  (let-match many e (MkRq _ L _ R))
  (let ((many q) (many s1)) (tok s))
  (let ((many h) (many s2)) (tok s1))
  (let ((many L2) (many s3)) (rd-diff s2 L))
  (let ((many R2) (many s4)) (rd-diff s3 R))
  (values (MkRq q L2 (num-bit h) R2) s4))

(def-fns _ $ (many sp : (many (Rope) a) (many (Nat) n) -> (many (Rope) r))
  (RCat a (RCat (RChar #\space) (RStr (nat-str n)))))

(def-fns _ $ (many show-runs : (subterm many (List (Rn)) L) (many (Rope) acc) -> (many (Rope) r))
  (let-match many L (Cons _ rn L1) ((Nil _) acc))
  (let-match many rn (MkRn b n))
  (tail $ show-runs L1 (sp (sp acc (bit-nat b)) n)))

(def-fns _ $ (many nlen-runs : (subterm many (List (Rn)) L) (many (Nat) acc) -> (many (Nat) n))
  (let-match many L (Cons _ _ L1) ((Nil _) acc))
  (tail $ nlen-runs L1 (Succ acc)))

(def-fns _ $ (many show-side : (many (List (Rn)) L) -> (many (Rope) r))
  (RCat (show-runs L (RStr (nat-str (nlen-runs L (Zero))))) (RChar #\newline)))

(def-fns _ $ (many show-cfg : (many (Rq) e) -> (many (Rope) r))
  (let-match many e (MkRq q L h R))
  (let ((many top)) (RCat (sp (RStr (nat-str q)) (bit-nat h)) (RChar #\newline)))
  (RCat top (RCat (show-side L) (show-side R))))

(def-fns _ $ (many first-ok : (many (List (Rn)) L) (many (Nat) b) (many (Nat) n) -> (many (Bool) ok))
  (let-match many L (Cons _ rn _) ((Nil _) (match many (nat-eq b 2) _ ((Equal _ _ _) (BTrue)) (else (BFalse)))))
  (let-match many rn (MkRn x k))
  (let-match many (nat-eq (bit-nat x) b) (Equal _ _ _) (else (BFalse)))
  (match many (nat-eq k n) _ ((Equal _ _ _) (BTrue)) (else (BFalse))))

(def-adts $ (HRes : -> Type)
  enum
  (many HOk : (many (Nat) k) (many (Rq) e) -> (HRes))
  (many HBad : (many (Nat) k) (many (Nat) why) (many (Rq) e) -> (HRes)))

(def-fns _ $ (many c-rep : (subterm many (Nat) k) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many r)) (c-move9 c0 e ch))
  (let-match many k (Succ k2) ((Zero) r))
  (let-match many k2 (Succ _) ((Zero) r))
  (tail $ c-rep k2 c0 e ch))

(def-fns _ $ (many hloop : (many (Nat) rep) (subterm many (Nat) fuel) (many (Nat) mv) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (String) s) -> (many (HRes) r))
  (let-match many fuel (Succ f) ((Zero) (HOk mv e)))
  (let ((many kind) (many s1)) (tok s))
  (let-match many kind (Succ j1) ((Zero) (HOk mv e)))
  (let-match many j1 (Zero)
    ((Succ j2)
      (let-match many j2 (Succ _)
        ((Zero)
          (let ((many e2) (many s2)) (rd-patch s1 e))
          (let ((erased c2) (erased ch2)) (rch-self l3 e2))
          (tail $ hloop rep f (Succ mv) c2 e2 ch2 s2)))
      (let ((many idx) (many s2)) (tok s1))
      (let ((many e2) (many s3)) (rd-patch s2 e))
      (let-match many (c10-mac idx c0 e ch) (RsOk _ _ e3 ch3) ((RsNo _ _ _ _) (HBad mv 6 e)))
      (let-match many (rq-eq e3 e2) (BTrue) ((BFalse) (HBad mv 7 e3)))
      (tail $ hloop rep f (Succ mv) c0 e3 ch3 s3)))
  (let ((many cls) (many s2)) (tok s1))
  (let ((many q) (many s3)) (tok s2))
  (let ((many h) (many s4)) (tok s3))
  (let ((many lb) (many s5)) (tok s4))
  (let ((many ln) (many s6)) (tok s5))
  (let ((many rb) (many s7)) (tok s6))
  (let ((many rn) (many s8)) (tok s7))
  (let-match many (c-rep rep c0 e ch) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) (HBad mv 1 e)))
  (let-match many e2 (MkRq q2 L2 h2 R2))
  (let-match many (nat-eq q q2) (Equal _ _ _) (else (HBad mv 2 e2)))
  (let-match many (nat-eq h (bit-nat h2)) (Equal _ _ _) (else (HBad mv 3 e2)))
  (let-match many (first-ok L2 lb ln) (BTrue) ((BFalse) (HBad mv 4 e2)))
  (let-match many (first-ok R2 rb rn) (BTrue) ((BFalse) (HBad mv 5 e2)))
  (tail $ hloop rep f (Succ mv) c0 e2 ch2 s8))

(def-fns _ $ (many hmain : (many (String) in) -> (many (String) out))
  (let ((many rep) (many s0)) (tok in))
  (let ((many e) (many s)) (rd-cfg s0))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let ((many r) (many tl)) (match many (hloop rep 1000000000 0 c0 e ch s) (((Rope) r) ((Rope) tl))
    ((HOk k e2) (values (show-cfg e2) (sp (RStr "OK") k)))
    ((HBad k why e2) (values (show-cfg e2) (sp (sp (RStr "BAD") k) why)))))
  (let ((many o) (erased _)) (flatten (RCat r (RCat tl (RChar #\newline)))))
  o)

(def-fns _ $ (many smain : (many (String) in) -> (many (String) out))
  (let ((many n) (many _)) (tok in))
  (let ((many left) (many e) (erased _)) (c10run _ n (MkRq (Zero) (Nil (Rn)) (BFalse) (Nil (Rn))) (rch0 l3)))
  (let ((many o) (erased _)) (flatten (RCat (show-cfg e) (RCat (sp (RStr "LEFT") left) (RChar #\newline)))))
  o)
