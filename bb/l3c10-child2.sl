(def-fns _ $ (many c-reach-c : (erased (Conf) c0) (subterm many (Nat) fuel) (many (Nat) ck) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Rq) t) (many (Nat) ct)
    -> (many (Rs l3 c0) res))
  (let-match many ck (Succ k1) ((Zero) (c-reach c0 fuel e ch t ct)))
  (let-match many (rq-same e t) (ENone _) ((ESome _ eq) (let-match erased eq (Refl _ _)) (RsOk l3 c0 e ch)))
  (let-match many fuel (Succ f) ((Zero) (RsNo l3 c0 e ch)))
  (let-match many (c-casc c0 e ch) (RsNo _ _ _ _) ((RsOk _ _ e1 ch1) (c-reach c0 f e1 ch1 t ct)))
  (let-match many (c-move9 c0 e ch) (RsOk _ _ e1 ch1) ((RsNo _ _ e1 ch1) (RsNo l3 c0 e1 ch1)))
  (tail $ c-reach-c c0 f k1 e1 ch1 t ct))

(def-fns _ $ (many c-certify-c : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Nat) fuel ck) (many (Maybe (Rq)) mt) -> (many (Rs l3 c0) res))
  (let-match many mt (Some _ t) ((None _) (RsNo l3 c0 e ch)))
  (let-match many t (MkRq q L h R))
  (let ((erased l) (erased dl)) (den-ex L))
  (let ((erased r) (erased dr)) (den-ex R))
  (let ((many L2) (erased dl2)) (rnorm L l dl))
  (let ((many R2) (erased dr2)) (rnorm R r dr))
  (let-match many (c-reach-c c0 fuel ck e ch (MkRq q L2 h R2) (stk-cnt L2 0)) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (let-match many (rq-same e1 (MkRq q L2 h R2)) (ESome _ eq) ((ENone _) (RsNo l3 c0 e ch)))
  (let-match erased eq (Refl _ _))
  (let-match erased ch1 (MkRch _ _ a c _ n run dc z))
  (let-match erased (dc-fn e1 c (MkConf q l h r) dc (MkDc q L2 R2 h l r dl2 dr2)) (Refl _ _))
  (RsOk l3 c0 t (MkRch l3 c0 a c t n run (MkDc q L R h l r dl dr) z)))

(def-fns _ $ (many fe-cert-c : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) (many (Bool) child) (many (LmC) lc) (many (Maybe (Nat)) mp) (many (Nat) rho)
    -> (many (Rs l3 c0) res))
  (match many child _
    ((BTrue) (c-certify-c c0 e ch 10000000 256 (m-child lc mp rho)))
    ((BFalse) (c-certify-c c0 e ch 64 0 (m-bcovf lc mp rho)))))

(def-fns _ $ (many try-fe-c : (many (Bool) child) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let ((many lc)) (lmc e))
  (let ((many mp) (many rho)) (fe-of lc))
  (fe-cert-c c0 e ch child lc mp rho))

(def-fns _ $ (many try-resume-c : (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (let-match erased ch (MkRch _ _ _ c _ _ _ dc _))
  (let ((many lm)) (c-lm e c dc))
  (let-match many (resume-guard e lm) (BTrue) ((BFalse) (RsNo l3 c0 e ch)))
  (let-match many (c-move9-at c0 e ch lm) (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (let ((many lc)) (lmc e1))
  (let ((many mp) (many rho)) (fe-of lc))
  (let-match many (fe-cert-c c0 e1 ch1 (BFalse) lc mp rho) (RsNo _ _ _ _) ((RsOk _ _ e2 ch2) (RsOk l3 c0 e2 ch2)))
  (let-match many (fe-cert-c c0 e1 ch1 (BTrue) lc mp rho) (RsOk _ _ e2 ch2) ((RsNo _ _ _ _) (RsNo l3 c0 e ch)))
  (RsOk l3 c0 e2 ch2))
