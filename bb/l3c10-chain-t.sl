(def-fns _ $ (many runs-eq : (subterm many (List (Rn)) A) (many (List (Rn)) B) -> (many (Bool) r))
  (let-match many A (Cons _ ra A1) ((Nil _) (match many B _ ((Nil _) (BTrue)) (else (BFalse)))))
  (let-match many B (Cons _ rb B1) ((Nil _) (BFalse)))
  (let-match many ra (MkRn x m))
  (let-match many rb (MkRn y k))
  (let-match many (eq-bit x y) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (nat-eq m k) (Equal _ _ _) (else (BFalse)))
  (tail $ runs-eq A1 B1))

(def-fns _ $ (many rq-eq : (many (Rq) e f) -> (many (Bool) r))
  (let-match many e (MkRq q L h R))
  (let-match many f (MkRq q2 L2 h2 R2))
  (let-match many (nat-eq q q2) (Equal _ _ _) (else (BFalse)))
  (let-match many (eq-bit h h2) (ESome _ _) ((ENone _) (BFalse)))
  (let-match many (runs-eq L L2) (BTrue) ((BFalse) (BFalse)))
  (runs-eq R R2))

(def-fns _ $ (many c10-mac : (many (Nat) idx) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rs l3 c0) res))
  (match many (nat-eq idx 9) _
    ((Equal _ _ _) (c-chain c0 e ch))
    (else (match many (nat-eq idx 23) _ ((Equal _ _ _) (c-absorb c0 e ch)) (else (RsNo l3 c0 e ch))))))

(def-fns _ $ (many kmain : (many (String) in) -> (many (String) out))
  (let ((many idx) (many s0)) (tok in))
  (let ((many e) (many s1)) (rd-cfg s0))
  (let ((many f) (many _)) (rd-cfg s1))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let ((many r)) (match many (c10-mac idx c0 e ch) (((Rope) r))
    ((RsOk _ _ e2 _) (match many (rq-eq e2 f) _ ((BTrue) (RStr "MATCH")) ((BFalse) (RCat (RStr "DIFF\n") (show-cfg e2)))))
    ((RsNo _ _ _ _) (RStr "NOFIRE"))))
  (let ((many o) (erased _)) (flatten (RCat r (RChar #\newline))))
  o)

(def-fns _ $ (many fam-str : (many (Fam) F) -> (many (Rope) r))
  (match many F _
    ((FE P T) (RCat (RStr "FE") (RStr (nat-str P))))
    ((FO P T) (RCat (RStr "FO") (RStr (nat-str P))))
    ((FVE P) (RCat (RStr "FVE") (RStr (nat-str P))))
    ((FVO P) (RCat (RStr "FVO") (RStr (nat-str P))))))

(def-fns _ $ (many dstep : (many (Fam) F) (many (Nat) s n) (erased (FamOK F) ok) (erased (MaxS F n) mx)
    (erased (Lt s (Succ n)) bn) (many (List (Tk)) X) (many (Tt) T) (erased (Phi F s X T) ph) (many (Nat) e) (erased (Nat) a b) (erased (Rl X (Zero) a) ra)
    (erased (Tn T (Zero) b) tbn) (erased (Add a b e) ae) (many (List (Rn)) Rt) (erased (List (Bool)) rc v xr) (erased (Den Rt rc) dr) (erased (Tb T rc v) tb)
    (erased (Xb X v xr) xb) (erased (Nat) nn) (erased (List (Bool)) lz x0) (erased (Rp (BTrue) nn lz x0) p0) -> (many (Rope) r))
  (let ((many hd)) (RCat (fam-str F) (RCat (RStr " cells ") (RStr (nat-str e)))))
  (let-match many Rt (Cons _ rg R9) ((Nil _) (RStr "R1 nil")))
  (let-match many rg (MkRn bg G))
  (let ((many hd)) (RCat hd (RCat (RStr " G=") (RStr (nat-str G)))))
  (let ((many hd)) (match many R9 (((Rope) r)) ((Cons _ rr _) (let-match many rr (MkRn _ mm)) (RCat hd (RCat (RStr " next=") (RStr (nat-str mm))))) (else hd)))
  (let ((many k0) (erased _) (erased _) (erased _) (erased _) (erased _)) (div (monus G 2) (Succ (Succ (Succ (Zero)))) (LtZ _)))
  (let-match many (ms-jk 30 G k0 F s n ok mx bn X T ph e a b ra tbn ae Rt rc v xr dr tb xb nn lz x0 p0)
    (JmOk _ _ _ _ _ _ _ _ s1 c2 g Z ph1 R3 r d3 m1 x3 u2 zr p1 tb2 zb t1 run1)
    ((JmNo _ _ _ _ _ _ _ _ w) (RCat hd (RCat (RStr " jump miss w-G=") (RCat (RStr (nat-str (monus w G))) (RCat (RStr " G-w=") (RStr (nat-str (monus G w)))))))))
  (let ((many hd)) (RCat hd (RCat (RStr " gap=") (RStr (nat-str g)))))
  (let ((many hd)) (RCat hd (match many (rd-run Z T) (((Rope) r)) ((RdOk _ _ _ _ c _) (RCat (RStr " nextc=") (RStr (nat-str c)))) ((RdNo _ _) (RStr " rdno")))))
  (let ((many ct)) (match many T (((CtR T Z r u2 zr x3) ct))
    ((TtE) (ct-chain g Z R3 r u2 zr x3 d3 tb2 zb))
    ((Tt1) (ct-absorb g Z R3 r u2 zr x3 d3 tb2 zb))
    (else (CtNo T Z r u2 zr x3))))
  (let-match many ct (CtOk _ _ _ _ _ _ Y R5 r5 u5 yr d5 tb5 yb m2 x4 p2 t2 run2) ((CtNo _ _ _ _ _ _) (RCat hd (RStr " contact fail"))))
  (let ((many m4) (erased _)) (mul s1 4))
  (let-match many (decode Y T) (DecOk F2 s2) ((DecNo) (RCat hd (RStr " decode Y fail"))))
  (let-match many (ident (fam-s F) m4 Y T) (IdOk _ _ F3 s3 n2 ok2 mx2 bn2 ph2) ((IdNo _ _) (RCat hd (RCat (RStr " ident fail; decode gives ") (fam-str F2)))))
  (RCat hd (RCat (RStr " step ok ") (RCat (fam-str F3) (RCat (RStr " D=") (RStr (nat-str (monus m4 s3))))))))

(def-fns _ $ (many dbg : (many (Nat) fu) (erased (Conf) c0) (many (Rq) e) (erased (Rch l3 c0 e) ch) -> (many (Rope) r))
  (let-match erased ch (MkRch _ _ a c _ t0 r0 dc0 z))
  (let-match many (c-lm e c dc0) (LmOk _ lz x0 u y xr n L0 d0 p0 X T px R1 d1 cu dc) ((LmNo _) (RStr "lm")))
  (let-match many (decode X T) (DecOk F0 s0) ((DecNo) (RStr "decode")))
  (let-match many (id-at F0 s0 X T) (IdOk _ _ F s nb ok mx bn ph) ((IdNo _ _) (RCat (RStr "id ") (fam-str F0))))
  (let ((many ex) (erased a1) (erased b1) (erased ra1) (erased tbn1) (erased ae1)) (cells X T))
  (let ((erased v) (erased tb) (erased xb)) (xt-cat X T u y xr px cu))
  (let-match many (ms-loop fu (BTrue) F s nb ok mx bn X T ph ex a1 b1 ra1 tbn1 ae1 R1 y v xr d1 tb xb n lz x0 p0 ex ex (Zero))
    (MkMsL _ _ _ _ _ _ F2 s2 X2 ph2 Rt rc2 v2 xr2 dr2 tb2 xb2 M st x3 pm t run))
  (let-match many (id-at F2 s2 X2 T) (IdOk _ _ F3 s3 n3b ok3 mx3 bn3 ph3) ((IdNo _ _) (RStr "reid")))
  (let ((many e3) (erased a3) (erased b3) (erased ra3) (erased tbn3) (erased ae3)) (cells X2 T))
  (let ((erased nn) (erased an)) (add-ex M n))
  (RCat (RStr (nat-str st)) (RCat (RStr " steps; ") (dstep F3 s3 n3b ok3 mx3 bn3 X2 T ph3 e3 a3 b3 ra3 tbn3 ae3 Rt rc2 v2 xr2 dr2 tb2 xb2 nn lz x3 (rp-add (BTrue) M n nn lz x0 x3 pm p0 an)))))

(def-fns _ $ (many dmain : (many (String) in) -> (many (String) out))
  (let ((many idx) (many s0)) (tok in))
  (let ((many e) (many s1)) (rd-cfg s0))
  (let ((erased c0) (erased ch)) (rch-self l3 e))
  (let ((many o) (erased _)) (flatten (RCat (dbg idx c0 e ch) (RChar #\newline))))
  o)
