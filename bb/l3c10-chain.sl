    (JmOk _ _ _ _ _ _ _ _ s1 c2 Z ph1 R3 r d3 m1 x3 u2 zr p1 tb2 zb t1 run1) ((JmNo _ _ _ _ _ _ _ _ _) stop))
  (let ((many ct)) (match many T (((CtR T Z r u2 zr x3) ct))
    ((TtE) (ct-chain Z R3 r u2 zr x3 d3 tb2 zb))
    ((Tt1) (ct-absorb Z R3 r u2 zr x3 d3 tb2 zb))
    (else (CtNo T Z r u2 zr x3))))
  (let-match many ct (CtOk _ _ _ _ _ _ Y R5 r5 u5 yr d5 tb5 yb m2 x4 p2 t2 run2) ((CtNo _ _ _ _ _ _) stop))
  (let ((many m4) (erased _)) (mul s1 4))
  (let ((many F2g)) (fam-s F))
  (let ((many s2g)) (monus m4 (monus (nat-add dd c2) (nat-add cz 4))))
  (let-match many (ident F2g s2g Y T) (IdOk _ _ F2 s2 n2 ok2 mx2 bn2 ph2) ((IdNo _ _) stop))
  (let ((many e2) (erased a2) (erased b2) (erased ra2) (erased tbn2) (erased ae2)) (cells Y T))
  (let ((many m) (erased am)) (add m2 m1))
  (let ((erased p3)) (rp-add (BTrue) m2 m1 m x0 x3 x4 p2 p1 am))
  (let ((erased t3) (erased run3)) (run-cat l3 _ _ _ t1 t2 run1 run2))
  (let ((erased nn2) (erased an)) (add-ex m nn))
  (let ((erased p4)) (rp-add (BTrue) m nn nn2 lz x0 x4 p3 p0 an))
  (let-match many (notail $ ms-loop f ab F2 s2 n2 ok2 mx2 bn2 Y T ph2 e2 a2 b2 ra2 tbn2 ae2 R5 r5 u5 yr d5 tb5 yb nn2 lz x4 p4 c2 e (monus m4 s2))
    (MkMsL _ _ _ _ _ _ F3 s3 X3 ph3 Rt3 rc3 v3 xr3 dr3 tb3 xb3 M st x5 pm t4 run4))
  (let ((many M2) (erased aM)) (add M m))
  (let ((erased t5) (erased run5)) (run-cat l3 _ _ _ t3 t4 run3 run4))
  (MkMsL F s X T xr x0 F3 s3 X3 ph3 Rt3 rc3 v3 xr3 dr3 tb3 xb3 M2 (Succ st) x5 (rp-add (BTrue) M m M2 x0 x4 x5 pm p3 aM) t5 run5))

(def-fns _ $ (many rshort : (subterm many (Nat) n) (many (List (Rn)) R) -> (many (Bool) b))
