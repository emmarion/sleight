  (let-match many sr (SEnd K) ((STurn _ _) no))
  (let-match many K (Cons _ kt K2) ((Nil _) no))
  (let-match many kt (Succ kt1) ((Zero) no))
  (let-match many kt1 (Succ kt2) ((Zero) no))
  (let-match many kt2 (Zero) ((Succ _) no))
  (let-match many K2 (Cons _ s0 K1) ((Nil _) no))
  (let ((many K0)) (Cons _ (Succ (Succ (Succ (Zero)))) (Cons _ (Succ s0) K1)))
  (let-match many (wk-run (Cons _ (Succ (Succ (Succ (Zero)))) K0) (Cons _ (T1) (Nil (Tk)))) (WkOk _ _ Y wk) ((WkNo _ _) no))
  (let ((erased l)) (bits "00111" x3))
