  (let ((erased dLo)) (DeC (BFalse) n2 (Cons _ (MkRn (BTrue) sc) L0) x3 (bits "00" x3) (DeC (BTrue) sc L0 lz x3 d0 (rp-add (BTrue) M n sc lz x0 x3 pm p0 as)) (rp2 _ x3)))
