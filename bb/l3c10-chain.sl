  (CtOk (Tt1) Z r u2 zr x3 Y R5 r5 u5 yr d5 tb5 yb n3 _ (rp3 _ x3) t run))

(def-adts
  ((MsL : ((Fam) F) ((Nat) s) ((List (Tk)) X) ((Tt) T) ((List (Bool)) xr x0) -> Type)
    enum
    (many MkMsL : (erased (Fam) F) (erased (Nat) s) (erased (List (Tk)) X) (erased (Tt) T) (erased (List (Bool)) xr x0)
       (many (Fam) F2) (many (Nat) s2) (many (List (Tk)) X2) (erased (Phi F2 s2 X2 T) ph2)
