(def-fns _ $ (many ms-loop : (subterm many (Nat) fuel) (many (Bool) ab) (many (Fam) F) (many (Nat) s n) (erased (FamOK F) ok) (erased (MaxS F n) mx)
    (erased (Lt s (Succ n)) bn) (many (List (Tk)) X) (many (Tt) T) (erased (Phi F s X T) ph) (many (Nat) e) (erased (Nat) a b) (erased (Rl X (Zero) a) ra)
    (erased (Tn T (Zero) b) tbn) (erased (Add a b e) ae) (many (List (Rn)) Rt) (erased (List (Bool)) rc v xr) (erased (Den Rt rc) dr) (erased (Tb T rc v) tb)
    (erased (Xb X v xr) xb) (erased (Nat) nn) (erased (List (Bool)) lz x0) (erased (Rp (BTrue) nn lz x0) p0) (many (Nat) cz ce dd)
    -> (many (MsL F s X T xr x0) res))
  (let ((many stop)) (MkMsL F s X T xr x0 F s X ph Rt rc v xr dr tb xb (Zero) (Zero) x0 (RpZ _ x0) (Zero) (RNil l3 _)))
  (let-match many fuel (Succ f) ((Zero) stop))
  (let-match many Rt (Cons _ rg _) ((Nil _) stop))
  (let-match many rg (MkRn bg G))
  (let-match many bg (BFalse) ((BTrue) stop))
  (let ((many k0) (erased _) (erased _) (erased _) (erased _) (erased _)) (div (monus (nat-add G ce) (nat-add cz 2)) (Succ (Succ (Succ (Zero)))) (LtZ _)))
