       (many (Nat) i2) (erased (List (Sy)) x) (erased (Cat (Sy) p x w) c) (erased (Rg ts ns i2 e x) rg) -> (StwR ts ns e p w))
    (many StwNo : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) p w) -> (StwR ts ns e p w))))

(def-fns _ $ (many strip-w : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
    (subterm many (List (Sy)) p) (many (Nat) i e) (erased (List (Sy)) w) (erased (Rg ts ns i e w) rg)
    -> (unique tg is tg2 at tg) (unique cn is cn2 at cn) (many (StwR ts ns e p w) r))
  (let-match many p (Cons _ a p1) ((Nil _) (values tg cn (StwOk _ _ _ _ _ i w (CatN (Sy) w) rg))))
  (let-match many (nat-eq i e) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values tg cn (StwNo _ _ _ _ _))))
  (let-match erased rg (RgC _ _ _ _ s x0 t u c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (let ((many v) (unique tg1)) (bytes-get _ tg i _ nt))
