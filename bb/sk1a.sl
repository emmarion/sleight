      (tail $ push-new k n1 cap ts ns bt bc l1 l2 p e le t rg (NKN k))))
  (let-match erased rg (RgC _ _ _ _ s x tg u c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl p ap)))
  (let ((many v) (unique bt1)) (bytes-get _ bt p _ nt))
  (let ((many g)) (coerce v (coercible-sym cu)))
  (let-match many (wk-xg k g s c ec) (WkM _ _) ((WkN _ _ _ nk1) (tail $ push-new k n1 cap ts ns bt1 bc l1 l2 p e le t rg (nk1-nk k s x nk1))))
  (let ((many c0) (unique bc1)) (array-get _ _ bc p c nn))
  (let ((many s2) (erased a)) (add n c0))
  (let ((erased ns2) (unique bc2) (erased st)) (array-place _ _ bc1 p (MkCopy _ s2) (MkCopy _ c) nn))
  (values ts ns2 bt1 bc2 l1 (setnth-length _ ns p cap (MkCopy _ s2) ns2 st l2)
    (PhOk k n ts ns2 e t p _ (PuM k n1 c s2 x a)
      (RgC ts ns2 p e _ x tg u s2 nt (setnth-nth _ ns p (MkCopy _ s2) ns2 st) cu (ecd-w k c s2 tg ec) (rg-frn ts ns ns2 (Succ p) e p _ x r st (lt-succ p))))))

(def-adts
  ((SaR : ((Nat) xs n) ((List (Sy)) u) ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) e) -> Type)
    enum
    (many SaOk : (erased (Nat) xs n) (erased (List (Sy)) u) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e)
       (many (Nat) p m) (erased (List (Sy)) w) (erased (Swin xs n u w m) sw) (erased (Rg ts ns p e w) rg) -> (SaR xs n u ts ns e))
    (many SaNo : (erased (Nat) xs n) (erased (List (Sy)) u) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) -> (SaR xs n u ts ns e))))

(def-adts
  ((XzA : ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) i j) ((List (Sy)) u) ((Nat) xs c) -> Type)
    enum
    (many XzYes : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (Nat) c1) (erased (List (Sy)) u1)
       -> (XzA ts ns i j (Cons (Sy) iD u1) (Zero) (Succ c1)))
    (many XzNo : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (List (Sy)) u) (erased (Nat) xs c)
       -> (XzA ts ns i j u xs c))))

; xz-of over a range: a nonzero X count with no carry, followed by a D.
(def-fns _ $ (many sw-xd : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg)
    (many (Nat) i j) (erased (List (Sy)) u) (erased (Rg ts ns i j u) rg) (many (Nat) xs c) -> (unique tg is tg2 at tg) (many (XzA ts ns i j u xs c) r))
  (let-match many xs (Zero) ((Succ _) (values tg (XzNo _ _ _ _ _ _ _))))
  (let-match many c (Succ c1) ((Zero) (values tg (XzNo _ _ _ _ _ _ _))))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values tg (XzNo _ _ _ _ _ _ _))))
  (let-match erased rg (RgC _ _ _ _ s u1 t u8 cc nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (let ((many v) (unique tg1)) (bytes-get _ tg i _ nt))
  (let-match many (coerce v (coercible-sym cu)) (TgQD) (else (values tg1 (XzNo _ _ _ _ _ _ _))))
  (let-match erased ec (EcQD _))
  (values tg1 (XzYes _ _ _ _ c1 u1)))

; The stride of sw-of over cells i to j-1 of the a-buffers, written back to front into the b-buffers so that it ends at e.
(def-fns _ $ (many sw-a : (erased (List (U8)) ats) (erased (List (Copy (Nat))) ans) (unique (Bytes ats) atg) (unique (Array (Copy (Nat)) ans) acn)
    (many (Nat) i j) (erased (List (Sy)) u) (subterm erased (Rg ats ans i j u) rg)
    (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) e) (erased (Lt e (Succ cap)) le) (many (Nat) xs n)
    -> (unique atg is atg2 at atg) (unique acn is acn2 at acn)
    (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (SaR xs n u ts2 ns2 e) r))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap)
    ((Equal _ _ _)
      (let-match erased rg (RgN _ _ _) (absurd (RgC _ _ _ _ s1 x1 _ _ _ _ _ _ _ _) (lt-asym i i (rg-lt ats ans i i s1 x1 rg) (lt-weaken i i (rg-lt ats ans i i s1 x1 rg)))))
      (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l3) (erased l4) (many pb))
        (push-b (KX) xs cap ts ns bt bc l1 l2 e e le (Nil (Sy)) (RgN ts ns e)))
      (let-match many pb (PhOk _ _ _ _ _ _ p w pu rgw) ((PhNo _ _ _ _ _ _) (values atg acn ts2 ns2 bt2 bc2 l3 l4 (SaNo _ _ _ _ _ _))))
      (values atg acn ts2 ns2 bt2 bc2 l3 l4 (SaOk _ _ _ _ _ _ p n w (SwE xs n w pu) rgw))))
  (let-match erased rg (RgC _ _ _ _ s u0 tg u8 c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (let ((many v) (unique atg1)) (bytes-get _ atg i _ nt))
  (let ((many g)) (coerce v (coercible-sym cu)))
  (match many g _
    ((TgQD)
      (let-match erased ec (EcQD _))
      (let ((unique atg2) (unique acn2) (erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many sr))
        (notail $ sw-a ats ans atg1 acn (Succ i) j u0 r cap ts ns bt bc l1 l2 e le (Zero) n))
      (let-match many sr (SaOk _ _ _ _ _ _ p1 m w1 s1 rg1) ((SaNo _ _ _ _ _ _) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
      (let-match many p1 (Succ q) ((Zero) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
      (let ((erased lq)) (lt-pred q e cap (rg-le ts1 ns1 p1 e w1 rg1) le))
      (let ((erased ts3) (unique bt3) (erased l7) (erased rg3)) (wr-tag cap ts1 ns1 bt1 l5 l6 q lq (TgQD) (NcQD) iD c ec e w1 rg1))
      (let ((erased ts4) (erased ns4) (unique bt4) (unique bc4) (erased l8) (erased l9) (many pb))
        (push-b (KX) xs cap ts3 ns1 bt3 bc1 l7 l6 q e le _ rg3))
      (let-match many pb (PhOk _ _ _ _ _ _ p w pu rgw) ((PhNo _ _ _ _ _ _) (values atg2 acn2 ts4 ns4 bt4 bc4 l8 l9 (SaNo _ _ _ _ _ _))))
      (values atg2 acn2 ts4 ns4 bt4 bc4 l8 l9 (SaOk _ _ _ _ _ _ p m w (SwD xs n m u0 w1 w s1 pu) rgw)))
    ((TgC)
      (let-match erased ec (EcC _))
      (let-match many (lt-dec n (Succ xs)) (Yes _ _ _ _ pl) ((No _ _ _ _ _) (values atg1 acn ts ns bt bc l1 l2 (SaNo _ _ _ _ _ _))))
      (let ((many d) (erased ad)) (sub xs n pl))
      (let ((many n2) (erased a2)) (add n n))
      (let ((many n4) (erased a4)) (add n2 n2))
      (let ((unique atg2) (unique acn2) (erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many sr))
        (notail $ sw-a ats ans atg1 acn (Succ i) j u0 r cap ts ns bt bc l1 l2 e le (Zero) n4))
      (let-match many sr (SaOk _ _ _ _ _ _ p1 m w1 s1 rg1) ((SaNo _ _ _ _ _ _) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
      (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l7) (erased l8) (many pb))
        (push-b (KX) n2 cap ts1 ns1 bt1 bc1 l5 l6 p1 e le w1 rg1))
      (let-match many pb (PhOk _ _ _ _ _ _ p2 w2 pu rg2) ((PhNo _ _ _ _ _ _) (values atg2 acn2 ts2 ns2 bt2 bc2 l7 l8 (SaNo _ _ _ _ _ _))))
      (let-match many p2 (Succ q) ((Zero) (values atg2 acn2 ts2 ns2 bt2 bc2 l7 l8 (SaNo _ _ _ _ _ _))))
      (let ((erased lq)) (lt-pred q e cap (rg-le ts2 ns2 p2 e w2 rg2) le))
      (let ((erased ts3) (unique bt3) (erased l9) (erased rg3)) (wr-tag cap ts2 ns2 bt2 l7 l8 q lq (TgC) (NcC) (YC) c ec e w2 rg2))
      (let ((erased ts4) (erased ns4) (unique bt4) (unique bc4) (erased la) (erased lb) (many pb2))
        (push-b (KX) d cap ts3 ns2 bt3 bc2 l9 l8 q e le _ rg3))
      (let-match many pb2 (PhOk _ _ _ _ _ _ p w pu2 rgw) ((PhNo _ _ _ _ _ _) (values atg2 acn2 ts4 ns4 bt4 bc4 la lb (SaNo _ _ _ _ _ _))))
      (values atg2 acn2 ts4 ns4 bt4 bc4 la lb (SaOk _ _ _ _ _ _ p m w (SwC xs n d n2 n4 m u0 w1 w2 w ad a2 a4 s1 pu pu2) rgw)))
    ((TgXF)
      (let-match erased ec (EcXF _))
      (let ((many cv) (unique acn1)) (array-get _ _ acn i _ nn))
      (let ((unique atg5) (many xz)) (sw-xd ats ans atg1 (Succ i) j u0 r xs cv))
      (let ((unique acn5)) acn1)
      (let-match many xz (XzNo _ _ _ _ _ _ _)
        ((XzYes _ _ _ _ c1 u1)
          (let-match erased r (RgC _ _ _ _ _ _ _ _ _ _ _ _ _ r5))
          (let ((unique atg2) (unique acn2) (erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many sr))
            (notail $ sw-a ats ans atg5 acn5 (Succ (Succ i)) j u1 r5 cap ts ns bt bc l1 l2 e le (Zero) n))
          (let-match many sr (SaOk _ _ _ _ _ _ p1 m w1 s1 rg1) ((SaNo _ _ _ _ _ _) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
          (let-match many p1 (Succ q) ((Zero) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
          (let-match many q (Succ q2) ((Zero) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
          (let ((erased lq)) (lt-pred q e cap (rg-le ts1 ns1 p1 e w1 rg1) le))
          (let ((erased ts3) (unique bt3) (erased l7) (erased rg3)) (wr-tag cap ts1 ns1 bt1 l5 l6 q lq (TgQD) (NcQD) iD (Zero) (EcQD 0) e w1 rg1))
          (let ((erased lq2)) (lt-trans q2 q cap (lt-succ q2) lq))
          (let ((erased ts4) (erased ns4) (unique bt4) (unique bc4) (erased l8) (erased l9) (erased rg4))
            (wr-cons cap ts3 ns1 bt3 bc1 l7 l6 q2 lq2 (TgXF) cv _ (EcXF cv) e _ rg3))
          (values atg2 acn2 ts4 ns4 bt4 bc4 l8 l9
            (SaOk _ _ _ _ _ _ q2 m _ (SwX xs n c c m u0 _ (AddZero c) (SwD c n m u1 w1 _ s1 (PuC (KX) c1 _ (NKF (KX) (QD) w1)))) rg4))))
      (let ((many xs2) (erased a)) (add xs cv))
      (let ((unique atg2) (unique acn2) (erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many sr))
        (notail $ sw-a ats ans atg5 acn5 (Succ i) j u0 r cap ts ns bt bc l1 l2 e le xs2 n))
      (let-match many sr (SaOk _ _ _ _ _ _ p m w s1 rgw) ((SaNo _ _ _ _ _ _) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
      (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaOk _ _ _ _ _ _ p m w (SwX xs n c xs2 m u0 w a s1) rgw)))
    ((TgGF)
      (let-match erased ec (EcGF _))
      (let ((many cv) (unique acn1)) (array-get _ _ acn i _ nn))
      (let ((unique atg2) (unique acn2) (erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many sr))
        (notail $ sw-a ats ans atg1 acn1 (Succ i) j u0 r cap ts ns bt bc l1 l2 e le (Zero) n))
      (let-match many sr (SaOk _ _ _ _ _ _ p1 m w1 s1 rg1) ((SaNo _ _ _ _ _ _) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (SaNo _ _ _ _ _ _))))
      (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l7) (erased l8) (many pb))
        (push-b (KG) cv cap ts1 ns1 bt1 bc1 l5 l6 p1 e le w1 rg1))
      (let-match many pb (PhOk _ _ _ _ _ _ p2 w2 pu rg2) ((PhNo _ _ _ _ _ _) (values atg2 acn2 ts2 ns2 bt2 bc2 l7 l8 (SaNo _ _ _ _ _ _))))
      (let ((erased ts4) (erased ns4) (unique bt4) (unique bc4) (erased l9) (erased la) (many pb2))
        (push-b (KX) xs cap ts2 ns2 bt2 bc2 l7 l8 p2 e le w2 rg2))
      (let-match many pb2 (PhOk _ _ _ _ _ _ p w pu2 rgw) ((PhNo _ _ _ _ _ _) (values atg2 acn2 ts4 ns4 bt4 bc4 l9 la (SaNo _ _ _ _ _ _))))
      (values atg2 acn2 ts4 ns4 bt4 bc4 l9 la (SaOk _ _ _ _ _ _ p m w (SwG xs n c m u0 w1 w2 w s1 pu pu2) rgw)))
    (else (values atg1 acn ts ns bt bc l1 l2 (SaNo _ _ _ _ _ _)))))

(def-fns _ $ (many dec-at : (many (Tg) t) (many (Nat) c) (erased (Sy) s) (erased (Ecd s t c) e) -> (many s is r))
  (match many t _
    ((TgQD) (let-match erased e (EcQD _)) iD) ((TgQP) (let-match erased e (EcQP _)) iP)
    ((TgQC0) (let-match erased e (EcQC0 _)) (YF (QC0))) ((TgQC1) (let-match erased e (EcQC1 _)) (YF (QC1)))
    ((TgQC2) (let-match erased e (EcQC2 _)) (YF (QC2))) ((TgQF0) (let-match erased e (EcQF0 _)) (YF (QF0)))
    ((TgQF1) (let-match erased e (EcQF1 _)) (YF (QF1))) ((TgQF2) (let-match erased e (EcQF2 _)) (YF (QF2)))
    ((TgQF3) (let-match erased e (EcQF3 _)) (YF (QF3))) ((TgQG0) (let-match erased e (EcQG0 _)) (YF (QG0)))
    ((TgQG1) (let-match erased e (EcQG1 _)) (YF (QG1))) ((TgQG2) (let-match erased e (EcQG2 _)) (YF (QG2)))
    ((TgC) (let-match erased e (EcC _)) (YC)) ((TgE) (let-match erased e (EcE _)) (YE)) ((TgV) (let-match erased e (EcV _)) (YV))
    ((TgXF) (let-match erased e (EcXF _)) (YW (KX) (MkAm (BFalse) c))) ((TgXT) (let-match erased e (EcXT _)) (YW (KX) (MkAm (BTrue) c)))
    ((TgFF) (let-match erased e (EcFF _)) (YW (KF) (MkAm (BFalse) c))) ((TgFT) (let-match erased e (EcFT _)) (YW (KF) (MkAm (BTrue) c)))
    ((TgGF) (let-match erased e (EcGF _)) (YW (KG) (MkAm (BFalse) c))) ((TgGT) (let-match erased e (EcGT _)) (YW (KG) (MkAm (BTrue) c)))
    ((TgHF) (let-match erased e (EcHF _)) (YW (KH) (MkAm (BFalse) c))) ((TgHT) (let-match erased e (EcHT _)) (YW (KH) (MkAm (BTrue) c)))
    ((TgR) (let-match erased e (EcR _)) (YR c))))

(def-fns _ $ (many rd-list : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (many (Nat) i j) (erased (List (Sy)) x) (subterm erased (Rg ts ns i j x) rg) -> (unique bt is bt2 at bt) (unique bc is bc2 at bc) (many x is y))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap)
    ((Equal _ _ _)
      (let-match erased rg (RgN _ _ _) (absurd (RgC _ _ _ _ s1 x1 _ _ _ _ _ _ _ _) (lt-asym i i (rg-lt ts ns i i s1 x1 rg) (lt-weaken i i (rg-lt ts ns i i s1 x1 rg)))))
      (values bt bc (Nil (Sy)))))
  (let-match erased rg (RgC _ _ _ _ s x0 tg u c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (let ((many v) (unique bt1)) (bytes-get _ bt i _ nt))
  (let ((many cv) (unique bc1)) (array-get _ _ bc i c nn))
  (let ((many s2)) (dec-at (coerce v (coercible-sym cu)) cv s ec))
  (let ((unique bt2) (unique bc2) (many y0)) (notail $ rd-list ts ns bt1 bc1 (Succ i) j x0 r))
  (values bt2 bc2 (Cons (Sy) s2 y0)))

(def-adts
  ((WlR : ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) j) ((List (Sy)) x y) -> Type)
    enum
    (many WlOk : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) j) (erased (List (Sy)) x y) (many (Nat) p) (erased (List (Sy)) z)
       (erased (Cat (Sy) x y z) c) (erased (Rg ts ns p j z) rg) -> (WlR ts ns j x y))
    (many WlNo : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) j) (erased (List (Sy)) x y) -> (WlR ts ns j x y))))

; Writes x in front of the range e to j-1, which holds y.
(def-fns _ $ (many wr-pre : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) e) (erased (Nat) j) (erased (Lt j (Succ cap)) le)
    (erased (List (Sy)) y) (erased (Rg ts ns e j y) rg) (subterm many (List (Sy)) x)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (WlR ts2 ns2 j x y) r))
  (let-match many x (Cons _ s x0) ((Nil _) (values ts ns bt bc l1 l2 (WlOk ts ns j x y e y (CatN (Sy) y) rg))))
  (let ((erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many wl)) (notail $ wr-pre cap ts ns bt bc l1 l2 e j le y rg x0))
  (let-match many wl (WlOk _ _ _ _ _ p z0 c0 rg0) ((WlNo _ _ _ _ _) (values ts1 ns1 bt1 bc1 l5 l6 (WlNo _ _ _ _ _))))
  (let-match many p (Succ q) ((Zero) (values ts1 ns1 bt1 bc1 l5 l6 (WlNo _ _ _ _ _))))
  (let ((erased lq)) (lt-pred q j cap (rg-le ts1 ns1 p j z0 rg0) le))
  (let ((many t) (many c) (erased ec)) (enc-sy s))
  (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l7) (erased l8) (erased rg2)) (wr-cons cap ts1 ns1 bt1 bc1 l5 l6 q lq t c s ec j z0 rg0))
  (values ts2 ns2 bt2 bc2 l7 l8 (WlOk _ _ _ _ _ q _ (CatC (Sy) s x0 y z0 c0) rg2)))

; Copies cells i to j-1 of the a-buffers, holding x, in front of the range e to k-1 of the b-buffers, holding y.
(def-fns _ $ (many cp-pre : (erased (List (U8)) ats) (erased (List (Copy (Nat))) ans) (unique (Bytes ats) atg) (unique (Array (Copy (Nat)) ans) acn)
    (many (Nat) i j) (erased (List (Sy)) x) (subterm erased (Rg ats ans i j x) rx)
    (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) e) (erased (Nat) k) (erased (Lt k (Succ cap)) le)
    (erased (List (Sy)) y) (erased (Rg ts ns e k y) ry)
    -> (unique atg is atg2 at atg) (unique acn is acn2 at acn)
    (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (WlR ts2 ns2 k x y) r))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap)
    ((Equal _ _ _)
      (let-match erased rx (RgN _ _ _) (absurd (RgC _ _ _ _ s1 x1 _ _ _ _ _ _ _ _) (lt-asym i i (rg-lt ats ans i i s1 x1 rx) (lt-weaken i i (rg-lt ats ans i i s1 x1 rx)))))
      (values atg acn ts ns bt bc l1 l2 (WlOk ts ns k x y e y (CatN (Sy) y) ry))))
  (let-match erased rx (RgC _ _ _ _ s x0 tg u c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (let ((many v) (unique atg1)) (bytes-get _ atg i _ nt))
  (let ((many cv) (unique acn1)) (array-get _ _ acn i c nn))
  (let ((unique atg2) (unique acn2) (erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (many wl))
    (notail $ cp-pre ats ans atg1 acn1 (Succ i) j x0 r cap ts ns bt bc l1 l2 e k le y ry))
  (let-match many wl (WlOk _ _ _ _ _ p z0 c0 rg0) ((WlNo _ _ _ _ _) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (WlNo _ _ _ _ _))))
  (let-match many p (Succ q) ((Zero) (values atg2 acn2 ts1 ns1 bt1 bc1 l5 l6 (WlNo _ _ _ _ _))))
  (let ((erased lq)) (lt-pred q k cap (rg-le ts1 ns1 p k z0 rg0) le))
  (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l7) (erased l8) (erased rg2))
    (wr-cons cap ts1 ns1 bt1 bc1 l5 l6 q lq (coerce v (coercible-sym cu)) cv s ec k z0 rg0))
  (values atg2 acn2 ts2 ns2 bt2 bc2 l7 l8 (WlOk _ _ _ _ _ q _ (CatC (Sy) s x0 y z0 c0) rg2)))

(def-adts
  ((DaR : ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) i j) ((List (Sy)) x) -> Type)
    enum
    (many DaOk : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (List (Sy)) x) (many (Nat) s) (erased (List (Sy)) u t)
       (erased (Cat (Sy) u (Cons (Sy) iD t) x) c) (erased (Rg ts ns i s u) r1) (erased (Rg ts ns s j (Cons (Sy) iD t)) r2) -> (DaR ts ns i j x))
    (many DaNo : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (List (Sy)) x) -> (DaR ts ns i j x))))

(def-fns _ $ (many da-cons : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (Sy) s) (erased (List (Sy)) x0)
    (erased (Tg) tg) (erased (U8) u) (erased (Nat) c) (erased (Nth (U8) ts i u) nt) (erased (Nth (Copy (Nat)) ns i (MkCopy (Nat) c)) nn)
    (erased (Coercible (Shared) (Tg) tg (Shared) (U8) u) cu) (erased (Ecd s tg c) ec) (many (DaR ts ns (Succ i) j x0) d) -> (many (DaR ts ns i j (Cons (Sy) s x0)) r))
  (let-match many d (DaOk _ _ _ _ _ sp u1 t1 c1 r1 r2) ((DaNo _ _ _ _ _) (DaNo _ _ _ _ _)))
  (DaOk _ _ _ _ _ sp (Cons (Sy) s u1) t1 (CatC (Sy) s u1 _ x0 c1) (RgC ts ns i sp s u1 tg u c nt nn cu ec r1) r2))

; dsplit over a range: the first D at or after offset k.
(def-fns _ $ (many dsplit-a : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (many (Nat) k i j) (erased (List (Sy)) x)
    (subterm erased (Rg ts ns i j x) rg) -> (unique bt is bt2 at bt) (many (DaR ts ns i j x) r))
  (let-match many (nat-eq i j) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values bt (DaNo _ _ _ _ _))))
  (let-match erased rg (RgC _ _ _ _ s x0 tg u c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (match many k _
    ((Succ ka)
      (let ((unique bt2) (many d2)) (notail $ dsplit-a ts ns bt ka (Succ i) j x0 r))
      (values bt2 (da-cons ts ns i j s x0 tg u c nt nn cu ec d2)))
    ((Zero)
      (let ((many v) (unique bt0)) (bytes-get _ bt i _ nt))
      (let-match many (coerce v (coercible-sym cu)) (TgQD)
        (else
          (let ((unique bt2) (many d2)) (notail $ dsplit-a ts ns bt0 (Zero) (Succ i) j x0 r))
          (values bt2 (da-cons ts ns i j s x0 tg u c nt nn cu ec d2))))
      (let-match erased ec (EcQD _))
      (values bt0 (DaOk _ _ _ _ _ i (Nil (Sy)) x0 (CatN (Sy) x) (RgN ts ns i) rg)))))

(def-adts
  ((WnR : ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) e) ((List (Sy)) x) -> Type)
    enum
    (many WnOk : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) x) (many (Nat) p) (erased (Rg ts ns p e x) rg)
       -> (WnR ts ns e x))
    (many WnNo : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) x) -> (WnR ts ns e x))))

(def-fns _ $ (many wr-new : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) e) (erased (Lt e (Succ cap)) le) (many (List (Sy)) x)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (WnR ts2 ns2 e x) r))
  (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l3) (erased l4) (many wl)) (wr-pre cap ts ns bt bc l1 l2 e e le (Nil (Sy)) (RgN ts ns e) x))
