    ((TgGF) (let-match erased e (EcGF _)) (sy-w (KG) (BFalse) cv p)) ((TgGT) (let-match erased e (EcGT _)) (sy-w (KG) (BTrue) cv p))
    ((TgHF) (let-match erased e (EcHF _)) (sy-w (KH) (BFalse) cv p)) ((TgHT) (let-match erased e (EcHT _)) (sy-w (KH) (BTrue) cv p))))

(def-adts
