  (let-match many sr (StwOk _ _ _ _ _ i2 x c1 rg2) ((StwNo _ _ _ _ _) (values tg2 cn2 (StwNo _ _ _ _ _))))
  (values tg2 cn2 (StwOk _ _ _ _ _ i2 x (CatC (Sy) a p1 x x0 c1) rg2)))

