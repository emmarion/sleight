      ((TgXF) (let-match erased e (EcXF _)) (WkN k _ c (N1W k (KX) _ (KNeGX)))) ((TgXT) (let-match erased e (EcXT _)) (WkN k _ c (N1W k (KX) _ (KNeGX))))
      ((TgQD) (let-match erased e (EcQD _)) (WkN k _ c (N1F k (QD)))) ((TgC) (let-match erased e (EcC _)) (WkN k _ c (N1C k)))
      (else (wk-of k t s c e))))
    (else (wk-of k t s c e))))

(def-fns _ $ (many wk-tag : (many (Pk) k) (erased (Nat) c) -> (many (Tg) t) (erased (Ecd (YW k (MkAm (BFalse) c)) t c) e))
  (match many k _ ((KX) (values (TgXF) (EcXF c))) ((KF) (values (TgFF) (EcFF c))) ((KG) (values (TgGF) (EcGF c))) ((KH) (values (TgHF) (EcHF c)))))

(def-fns _ $ (erased ecd-w : (erased (Pk) k) (erased (Nat) c c2) (erased (Tg) t) (erased (Ecd (YW k (MkAm (BFalse) c)) t c) e)
