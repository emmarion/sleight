(def-adts
  ((PhR : ((Pk) k) ((Nat) n) ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) e) ((List (Sy)) t) -> Type)
    enum
    (many PhOk : (erased (Pk) k) (erased (Nat) n) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) t)
       (many (Nat) p) (erased (List (Sy)) t2) (erased (Push k n t t2) pu) (erased (Rg ts ns p e t2) rg) -> (PhR k n ts ns e t))
    (many PhNo : (erased (Pk) k) (erased (Nat) n) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) t)
       -> (PhR k n ts ns e t))))

(def-fns _ $ (many push-new : (many (Pk) k) (many (Nat) n1) (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns)
    (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc) (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2)
    (many (Nat) p) (erased (Nat) e) (erased (Lt e (Succ cap)) le) (erased (List (Sy)) t) (erased (Rg ts ns p e t) rg) (erased (NotK k t) nk)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (PhR k (Succ n1) ts2 ns2 e t) r))
  (let-match many p (Succ q) ((Zero) (values ts ns bt bc l1 l2 (PhNo k _ ts ns e t))))
  (let ((erased lq)) (lt-pred q e cap (rg-le ts ns p e t rg) le))
  (let ((many t0) (erased e0)) (wk-tag k (Succ n1)))
  (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l3) (erased l4) (erased rg2))
    (wr-cons cap ts ns bt bc l1 l2 q lq t0 (Succ n1) _ e0 e t rg))
  (values ts2 ns2 bt2 bc2 l3 l4 (PhOk k _ ts2 ns2 e t q _ (PuC k n1 t nk) rg2)))

(def-fns _ $ (many push-b : (many (Pk) k) (many (Nat) n) (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns)
    (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc) (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2)
    (many (Nat) p e) (erased (Lt e (Succ cap)) le) (erased (List (Sy)) t) (erased (Rg ts ns p e t) rg)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (PhR k n ts2 ns2 e t) r))
  (let-match many n (Succ n1) ((Zero) (values ts ns bt bc l1 l2 (PhOk k n ts ns e t p t (PuZ k t) rg))))
  (let-match many (nat-eq p e) (Unequal _ _ _ _ ap)
    ((Equal _ _ _)
