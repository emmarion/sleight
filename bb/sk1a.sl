  (let-match erased (cat-nil (Sy) x z c) (Refl _ _))
  (values ts2 ns2 bt2 bc2 l3 l4 (WnOk _ _ _ _ p rg)))

(def-adts $ (Sb : ((Nat) cap) -> Type)
