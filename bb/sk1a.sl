; The window is i to j-1; a stride writes its result into a spare buffer so that it ends at e.
(def-fns _ $ (many lstep-a : (many (Nat) cap) (many (Nat) e) (erased (Lt e (Succ cap)) le) (many (Mv) d) (many (List (Sy)) l)
