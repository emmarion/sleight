  (many MkSb : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
     (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) -> (Sb cap)))

(def-adts $ (Lza : ((Nat) cap) -> Type)
  enum
  (many LaGo : (erased (Nat) cap) (many (Mv) d) (many (List (Sy)) l)
     (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
     (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) i j) (erased (Lt j (Succ cap)) lj)
     (erased (List (Sy)) w) (erased (Rg ts ns i j w) rg)
     (unique (Sb cap) s1) (unique (Sb cap) s2) (many (Zk) k) (erased (Lz k d l w) z) (erased (Nx w) nx) -> (Lza cap))
  (many LaForce : (erased (Nat) cap) (many (Mv) d) (many (List (Sy)) l w) (unique (Sb cap) s0) (unique (Sb cap) s1) (unique (Sb cap) s2)
     (many (Zk) k) (erased (Lz k d l w) z) -> (Lza cap))
  (many LaNo : (erased (Nat) cap) (unique (Sb cap) s0) (unique (Sb cap) s1) (unique (Sb cap) s2) -> (Lza cap))
  (many LaDead : (erased (Nat) cap) -> (Lza cap)))

(def-fns _ $ (many lz-want-a : (many (Mv) d) (many (List (Sy)) l) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg)
    (unique (Array (Copy (Nat)) ns) cn) (many (Nat) i e) (erased (List (Sy)) w) (erased (Rg ts ns i e w) rg)
    -> (unique tg is tg2 at tg) (unique cn is cn2 at cn) (many (Bool) b))
  (let-match many d (DR) ((DL) (values tg cn (BFalse))))
  (let-match many (uni-l l) (UlNo _) ((UlOk _ _ _ _) (values tg cn (BTrue))))
  (let-match many l (Cons _ s0 _) ((Nil _) (values tg cn (BFalse))))
  (let-match many s0 (YF f0) (else (values tg cn (BFalse))))
  (let-match many f0 (QC0) (else (values tg cn (BFalse))))
  (let ((unique tg2) (unique cn2) (many wl)) (rd-list ts ns tg cn i e w rg))
  (values tg2 cn2 (lz-want d l wl)))

; A runner result from a list-side LsGo: the new window is written back into the window buffer.
(def-fns _ $ (many la-of : (erased (Nat) cap) (many (Nat) e) (erased (Lt e (Succ cap)) le) (many (Mv) d9) (many (List (Sy)) l9 w9) (many (Zk) k9) (erased (Lz k9 d9 l9 w9) z9)
    (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (unique (Sb cap) s1) (unique (Sb cap) s2) (many (Lzs) r)
    -> (unique (Lza cap) a))
  (let-match many r (LsGo d l w k z nx) ((LsForce) (LaForce _ d9 l9 w9 (MkSb _ ts ns tg cn l1 l2) s1 s2 k9 z9)))
  (let ((erased ts2) (erased ns2) (unique tg2) (unique cn2) (erased l3) (erased l4) (many wn)) (wr-new cap ts ns tg cn l1 l2 e le w))
  (let-match many wn (WnOk _ _ _ _ p rg) ((WnNo _ _ _ _) (LaForce _ d l w (MkSb _ ts2 ns2 tg2 cn2 l3 l4) s1 s2 k z)))
  (LaGo _ d l ts2 ns2 tg2 cn2 l3 l4 p e le w rg s1 s2 k z nx))

(def-adts $ (Fda : ((Nat) cap e) ((List (U8)) ts) ((List (Copy (Nat))) ns) -> Type)
  enum
  (many FdGo : (erased (Nat) cap e) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (many (List (Sy)) l)
     (erased (List (U8)) cts) (erased (List (Copy (Nat))) cns) (unique (Bytes cts) ctg) (unique (Array (Copy (Nat)) cns) ccn)
     (erased (Length (U8) cts cap) lc1) (erased (Length (Copy (Nat)) cns cap) lc2) (many (Nat) p) (erased (List (Sy)) w) (erased (Rg cts cns p e w) rg)
     (unique (Sb cap) sa) (many (Zk) k) (erased (Lz k (DL) l w) z) (erased (Nx w) nx) -> (Fda cap e ts ns))
  (many FdNo : (erased (Nat) cap e) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
     (unique (Sb cap) sc) -> (Fda cap e ts ns)))

; The window is i to j-1; a stride writes its result into another buffer so that it ends at e.
(def-fns _ $ (many lz-fold-a : (erased (Nat) cap) (many (Nat) e) (erased (Lt e (Succ cap)) le) (many (List (Sy)) l)
    (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) i j) (erased (List (Sy)) w) (erased (Rg ts ns i j w) rg)
    (unique (Sb cap) sc) (many (Zk) k) (erased (Lz k (DR) l w) z) -> (unique (Fda cap e ts ns) r))
  (let ((many i16) (erased _)) (add i 16))
  (let-match many (lt-dec j i16) (No _ _ _ _ _) ((Yes _ _ _ _ _) (FdNo _ e ts ns tg cn sc)))
  (let ((unique tg1) (many dr)) (dsplit-a ts ns tg 6 i j w rg))
  (let-match many dr (DaOk _ _ _ _ _ sp w1 w2 c r1 r2) ((DaNo _ _ _ _ _) (FdNo _ e ts ns tg1 cn sc)))
  (let-match unique sc (MkSb _ cts cns ctg ccn lc1 lc2))
  (let ((unique tg2) (unique cn2) (erased cts2) (erased cns2) (unique ctg2) (unique ccn2) (erased lc3) (erased lc4) (many sr))
    (sw-a ts ns tg1 cn i sp w1 r1 cap cts cns ctg ccn lc1 lc2 e le (Zero) 1))
  (let-match many sr (SaOk _ _ _ _ _ _ p3 m3 w3 s3 rgc) ((SaNo _ _ _ _ _ _) (FdNo _ e ts ns tg2 cn2 (MkSb _ cts2 cns2 ctg2 ccn2 lc3 lc4))))
  (let-match erased r2 (RgC _ _ _ _ _ _ _ _ _ _ _ _ _ r3))
  (let ((unique tg3) (unique cn3) (many w2l)) (rd-list ts ns tg2 cn2 (Succ sp) j w2 r3))
  (let ((many k2) (erased ch)) (ch-of w2l (Some _ k)))
  (let-match many (cap-ok m3 (zk-cap k2)) (BTrue) ((BFalse) (FdNo _ e ts ns tg3 cn3 (MkSb _ cts2 cns2 ctg2 ccn2 lc3 lc4))))
  (let ((many k3) (erased kt)) (kt-of k2 (PnP m3)))
  (FdGo _ e ts ns l cts2 cns2 ctg2 ccn2 lc3 lc4 p3 w3 rgc (MkSb _ ts ns tg3 cn3 l1 l2) k3
    (LzS l w1 w3 m3 k2 k3 (LzF (DR) l w w1 w2 k k2 z c ch) s3 kt) (sw-nx (Zero) 1 m3 w1 w3 s3)))

(def-fns _ $ (erased cat-nr : (erased Type A) (subterm erased (List A) x) -> (erased (Cat A x (Nil A) x) c))
  (let-match erased x (Cons _ a x1) ((Nil _) (CatN A (Nil A))))
  (CatC A a x1 (Nil A) x1 (cat-nr A x1)))

(def-fns _ $ (erased rg-end : (erased (List (U8)) ts ts2) (erased (List (Copy (Nat))) ns ns2) (erased (Nat) i j m) (erased (List (Sy)) w)
    (subterm erased (Rg ts ns i j w) r1) (erased (Rg ts2 ns2 i m w) r2) -> (erased (Eq (Nat) j m) e))
  (let-match erased r1 (RgC _ _ _ _ _ w1 _ _ _ _ _ _ _ r3) ((RgN _ _ _) (let-match erased r2 (RgN _ _ _)) (Refl _ _)))
  (let-match erased r2 (RgC _ _ _ _ _ _ _ _ _ _ _ _ _ r4))
  (rg-end ts ts2 ns ns2 (Succ i) j m w1 r3 r4))

; Writes cell q at or above the end of a range, keeping the range.
(def-fns _ $ (many wr-hi : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) q) (erased (Lt q cap) lq) (many (Tg) t) (many (Nat) c)
    (erased (Sy) s) (erased (Ecd s t c) e) (erased (Nat) i j) (erased (List (Sy)) w) (erased (Rg ts ns i j w) rg) (erased (Lt j (Succ q)) lj)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (erased (Rg ts2 ns2 i j w) rg2) (erased (Rg ts2 ns2 q (Succ q) (Cons (Sy) s (Nil (Sy)))) rc))
  (let ((erased u) (erased cu)) (tg-u8 t))
  (let ((many v)) (coerce t cu))
  (let ((erased m1) (erased nt0)) (nth-exists _ ts cap q l1 lq))
  (let ((erased ts2) (unique bt2) (erased st1)) (bytes-set _ bt q v m1 nt0))
  (let ((erased m2) (erased nn0)) (nth-exists _ ns cap q l2 lq))
  (let ((erased ns2) (unique bc2) (erased st2)) (array-place _ _ bc q (MkCopy _ c) m2 nn0))
  (values ts2 ns2 bt2 bc2 (setnth-length _ ts q cap u ts2 st1 l1) (setnth-length _ ns q cap (MkCopy _ c) ns2 st2 l2)
    (rg-frn-hi ts2 ns ns2 i j q _ w (rg-frt-hi ts ts2 ns i j q u w rg st1 lj) st2 lj)
    (RgC ts2 ns2 q (Succ q) s (Nil (Sy)) t u c (setnth-nth _ ts q u ts2 st1) (setnth-nth _ ns q (MkCopy _ c) ns2 st2) cu e (RgN ts2 ns2 (Succ q)))))

(def-adts
  ((WaR : ((Nat) cap) ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) i) ((List (Sy)) w x) -> Type)
    enum
    (many WaOk : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i) (erased (List (Sy)) w x)
       (many (Nat) j) (erased (Lt j (Succ cap)) lj) (erased (List (Sy)) z) (erased (Cat (Sy) w x z) c) (erased (Rg ts ns i j z) rg) -> (WaR cap ts ns i w x))
    (many WaNo : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i) (erased (List (Sy)) w x)
       (many (Nat) j) (erased (Lt j (Succ cap)) lj) (erased (Rg ts ns i j w) rg) -> (WaR cap ts ns i w x))))

; Appends x after the range i to j-1, which holds w.
(def-fns _ $ (many wr-app : (many (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) j) (erased (Lt j (Succ cap)) lj)
    (erased (Nat) i) (erased (List (Sy)) w) (erased (Rg ts ns i j w) rg) (subterm many (List (Sy)) x)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (many (WaR cap ts2 ns2 i w x) r))
  (let-match many x (Cons _ s x0) ((Nil _) (values ts ns bt bc l1 l2 (WaOk _ _ _ _ _ _ j lj w (cat-nr (Sy) w) rg))))
  (let-match many (lt-dec j cap) (Yes _ _ _ _ lq) ((No _ _ _ _ _) (values ts ns bt bc l1 l2 (WaNo _ _ _ _ _ _ j lj rg))))
  (let ((many t) (many c) (erased ec)) (enc-sy s))
  (let ((erased ts1) (erased ns1) (unique bt1) (unique bc1) (erased l5) (erased l6) (erased rgw) (erased rc))
    (wr-hi cap ts ns bt bc l1 l2 j lq t c s ec i j w rg (lt-succ j)))
  (let ((erased w1) (erased cw)) (cat-ex (Sy) w (Cons (Sy) s (Nil (Sy)))))
  (let ((erased rg1)) (rg-cat ts1 ns1 i j (Succ j) w _ w1 rgw rc cw))
  (let ((erased ts2) (erased ns2) (unique bt2) (unique bc2) (erased l7) (erased l8) (many wa))
    (notail $ wr-app cap ts1 ns1 bt1 bc1 l5 l6 (Succ j) (LtS j cap lq) i w1 rg1 x0))
  (match many wa _
    ((WaOk _ _ _ _ _ _ j2 lj2 z cz rgz)
      (let ((erased wy) (erased c3) (erased c4)) (cat-assoc (Sy) w (Cons (Sy) s (Nil (Sy))) w1 x0 z cw cz))
      (let-match erased c3 (CatC _ _ _ _ wy1 c5))
      (let-match erased c5 (CatN _ _))
      (values ts2 ns2 bt2 bc2 l7 l8 (WaOk _ _ _ _ _ _ j2 lj2 z c4 rgz)))
    ((WaNo _ _ _ _ _ _ j3 lj3 rg3)
      (let ((erased m) (erased r4) (erased r5)) (rg-split ts2 ns2 i j3 w _ w1 rg3 cw))
      (let-match erased (rg-end ts ts2 ns ns2 i j m w rg r4) (Refl _ _))
      (values ts2 ns2 bt2 bc2 l7 l8 (WaNo _ _ _ _ _ _ j lj r4)))))

(def-fns _ $ (many am-is : (many (Bool) b) (many (Nat) c) (many (Am) n) -> (many (Maybe (Eq (Am) (MkAm b c) n)) r))
  (let-match many n (MkAm b2 c2))
  (let-match many (eq-bit b b2) (Some _ e1) ((None _) (None _)))
  (let-match erased e1 (Refl _ _))
  (let-match many (eq-nat c c2) (Some _ e2) ((None _) (None _)))
  (let-match erased e2 (Refl _ _))
  (Some _ (Refl _ _)))

(def-fns _ $ (many sy-w : (many (Pk) k) (many (Bool) b) (many (Nat) c) (many (Sy) p) -> (many (Maybe (Eq (Sy) (YW k (MkAm b c)) p)) r))
  (let-match many p (YW k2 n2) (else (None _)))
  (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ _) (None _)))
  (let-match many (am-is b c n2) (Some _ e) ((None _) (None _)))
  (let-match erased e (Refl _ _))
  (Some _ (Refl _ _)))

(def-fns _ $ (many sy-f : (many (Fx) f) (many (Sy) p) -> (many (Maybe (Eq (Sy) (YF f) p)) r))
  (let-match many p (YF f2) (else (None _)))
  (let-match many (eq-fx f f2) (Some _ e) ((None _) (None _)))
  (let-match erased e (Refl _ _))
  (Some _ (Refl _ _)))

; Whether a cell, with tag t and count c, holds the symbol p.
(def-fns _ $ (many sy-is : (many (Tg) t) (erased (Nat) c) (many c is cv) (erased (Sy) s) (erased (Ecd s t c) e) (many (Sy) p) -> (many (Maybe (Eq (Sy) s p)) r))
  (match many t _
    ((TgQD) (let-match erased e (EcQD _)) (sy-f (QD) p)) ((TgQP) (let-match erased e (EcQP _)) (sy-f (QP) p))
    ((TgQC0) (let-match erased e (EcQC0 _)) (sy-f (QC0) p)) ((TgQC1) (let-match erased e (EcQC1 _)) (sy-f (QC1) p))
    ((TgQC2) (let-match erased e (EcQC2 _)) (sy-f (QC2) p)) ((TgQF0) (let-match erased e (EcQF0 _)) (sy-f (QF0) p))
    ((TgQF1) (let-match erased e (EcQF1 _)) (sy-f (QF1) p)) ((TgQF2) (let-match erased e (EcQF2 _)) (sy-f (QF2) p))
    ((TgQF3) (let-match erased e (EcQF3 _)) (sy-f (QF3) p)) ((TgQG0) (let-match erased e (EcQG0 _)) (sy-f (QG0) p))
    ((TgQG1) (let-match erased e (EcQG1 _)) (sy-f (QG1) p)) ((TgQG2) (let-match erased e (EcQG2 _)) (sy-f (QG2) p))
    ((TgC) (let-match erased e (EcC _)) (match many p _ ((YC) (Some _ (Refl _ _))) (else (None _))))
    ((TgE) (let-match erased e (EcE _)) (match many p _ ((YE) (Some _ (Refl _ _))) (else (None _))))
    ((TgV) (let-match erased e (EcV _)) (match many p _ ((YV) (Some _ (Refl _ _))) (else (None _))))
    ((TgR) (let-match erased e (EcR _))
      (let-match many p (YR b) (else (None _)))
      (let-match many (eq-nat cv b) (Some _ q) ((None _) (None _)))
      (let-match erased q (Refl _ _))
      (Some _ (Refl _ _)))
    ((TgXF) (let-match erased e (EcXF _)) (sy-w (KX) (BFalse) cv p)) ((TgXT) (let-match erased e (EcXT _)) (sy-w (KX) (BTrue) cv p))
    ((TgFF) (let-match erased e (EcFF _)) (sy-w (KF) (BFalse) cv p)) ((TgFT) (let-match erased e (EcFT _)) (sy-w (KF) (BTrue) cv p))
    ((TgGF) (let-match erased e (EcGF _)) (sy-w (KG) (BFalse) cv p)) ((TgGT) (let-match erased e (EcGT _)) (sy-w (KG) (BTrue) cv p))
    ((TgHF) (let-match erased e (EcHF _)) (sy-w (KH) (BFalse) cv p)) ((TgHT) (let-match erased e (EcHT _)) (sy-w (KH) (BTrue) cv p))))

(def-adts
  ((StwR : ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) e) ((List (Sy)) p w) -> Type)
    enum
    (many StwOk : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) p w)
       (many (Nat) i2) (erased (List (Sy)) x) (erased (Cat (Sy) p x w) c) (erased (Rg ts ns i2 e x) rg) -> (StwR ts ns e p w))
    (many StwNo : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) e) (erased (List (Sy)) p w) -> (StwR ts ns e p w))))

(def-fns _ $ (many strip-w : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
    (subterm many (List (Sy)) p) (many (Nat) i e) (erased (List (Sy)) w) (erased (Rg ts ns i e w) rg)
    -> (unique tg is tg2 at tg) (unique cn is cn2 at cn) (many (StwR ts ns e p w) r))
  (let-match many p (Cons _ a p1) ((Nil _) (values tg cn (StwOk _ _ _ _ _ i w (CatN (Sy) w) rg))))
  (let-match many (nat-eq i e) (Unequal _ _ _ _ ap) ((Equal _ _ _) (values tg cn (StwNo _ _ _ _ _))))
  (let-match erased rg (RgC _ _ _ _ s x0 t u c nt nn cu ec r) (absurd (RgN _ _ _) (apart-irrefl i ap)))
  (let ((many v) (unique tg1)) (bytes-get _ tg i _ nt))
  (let ((many cv) (unique cn1)) (array-get _ _ cn i c nn))
  (let-match many (sy-is (coerce v (coercible-sym cu)) c cv s ec a) (Some _ q) ((None _) (values tg1 cn1 (StwNo _ _ _ _ _))))
  (let-match erased q (Refl _ _))
  (let ((unique tg2) (unique cn2) (many sr)) (notail $ strip-w ts ns tg1 cn1 p1 (Succ i) e x0 r))
  (let-match many sr (StwOk _ _ _ _ _ i2 x c1 rg2) ((StwNo _ _ _ _ _) (values tg2 cn2 (StwNo _ _ _ _ _))))
  (values tg2 cn2 (StwOk _ _ _ _ _ i2 x (CatC (Sy) a p1 x x0 c1) rg2)))

(def-adts $ (Ws : ((Cf) c0) ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) cap e) -> Type)
  enum
  (many WsGo : (erased (Cf) c0) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) cap e)
     (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) tg) (unique (Array (Copy (Nat)) ns2) cn)
     (erased (Length (U8) ts2 cap) q1) (erased (Length (Copy (Nat)) ns2 cap) q2)
     (many (Mv) d) (many (List (Sy)) l) (many (Nat) i) (erased (List (Sy)) w) (erased (Rg ts2 ns2 i e w) rg) (many (Bool) g) (erased (TRun c0 (MkCf d l w) g) tr)
     -> (Ws c0 ts ns cap e))
  (many WsNo : (erased (Cf) c0) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) cap e)
     (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn) (many (Bool) fb) -> (Ws c0 ts ns cap e))
  (many WsDead : (erased (Cf) c0) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) cap e) -> (Ws c0 ts ns cap e)))

(def-fns _ $ (many ws-ts : (erased (Cf) c0) (erased (Nat) cap e) (erased (List (U8)) ts ts2) (erased (List (Copy (Nat))) ns ns2) (unique (Bytes ts2) tg) (unique (Array (Copy (Nat)) ns2) cn)
    (erased (Length (U8) ts2 cap) q1) (erased (Length (Copy (Nat)) ns2 cap) q2)
    (erased (Mv) d) (erased (List (Sy)) l w) (many (Bool) g) (erased (TRun c0 (MkCf d l w) g) tr)
    (many (Mv) d2) (many (List (Sy)) l2) (many (Nat) i2) (erased (List (Sy)) w2) (erased (Rg ts2 ns2 i2 e w2) rg) (many (Bool) g2) (erased (TStp (MkCf d l w) (MkCf d2 l2 w2) g2) s)
    -> (unique (Ws c0 ts ns cap e) r))
  (let ((many g3) (erased o)) (orb-of g g2))
  (WsGo c0 ts ns cap e ts2 ns2 tg cn q1 q2 d2 l2 i2 w2 rg g3 (TRS c0 _ _ g g2 g3 tr s o)))

; A rule: left side on the list, right side on the window; nothing is written unless it applies.
(def-fns _ $ (many rule-w : (erased (Cf) c0) (erased (Nat) cap) (many (Nat) e) (erased (Lt e (Succ cap)) eb)
    (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) tg) (unique (Array (Copy (Nat)) ns) cn)
    (erased (Length (U8) ts cap) q1) (erased (Length (Copy (Nat)) ns cap) q2)
    (many (Mv) d) (many (List (Sy)) l) (many (Nat) i) (erased (List (Sy)) w) (erased (Rg ts ns i e w) rg) (many (Bool) g) (erased (TRun c0 (MkCf d l w) g) tr)
    (many (Rl) rl) (erased (RlOK sk1p rl) k) -> (unique (Ws c0 ts ns cap e) r))
  (let-match many rl (MkRl d1 lp le rp re d2 lp2 rp2))
  (let-match many (eq-dir d1 d) (Some _ ed) ((None _) (WsNo c0 ts ns cap e tg cn (BFalse))))
  (let-match erased ed (Refl _ _))
  (let-match many re (BFalse) ((BTrue) (WsNo c0 ts ns cap e tg cn (BFalse))))
  (let-match many (sde-of le lp lp2 l) (SdOk _ _ _ _ l2 sl) ((SdNo _ _ _ _) (WsNo c0 ts ns cap e tg cn (BFalse))))
  (let ((unique tg1) (unique cn1) (many st)) (strip-w ts ns tg cn rp i e w rg))
  (let-match many st (StwOk _ _ _ _ _ i1 x c rg1) ((StwNo _ _ _ _ _) (WsNo c0 ts ns cap e tg1 cn1 (BFalse))))
  (let ((erased ts2) (erased ns2) (unique tg2) (unique cn2) (erased q3) (erased q4) (many wl)) (wr-pre cap ts ns tg1 cn1 q1 q2 i1 e eb x rg1 rp2))
  (let-match many wl (WlOk _ _ _ _ _ p w2 c2 rg2) ((WlNo _ _ _ _ _) (WsDead c0 ts ns cap e)))
  (ws-ts c0 cap e ts ts2 ns ns2 tg2 cn2 q3 q4 d l w g tr d2 l2 p w2 rg2 (BTrue)
    (TSRl rl _ _ k (MkRApp d d2 lp rp lp2 rp2 l w l2 w2 le (BFalse) sl (MkSde (BFalse) rp rp2 x w w2 (EBV x) c c2)))))

(def-adts
  ((Tn1 : ((Pk) k) ((Sy) s) -> Type)
    enum
    (many T1F : (erased (Pk) k) (erased (Fx) f) -> (Tn1 k (YF f)))
    (many T1C : (erased (Pk) k) -> (Tn1 k (YC)))
    (many T1E : (erased (Pk) k) -> (Tn1 k (YE)))
    (many T1V : (erased (Pk) k) -> (Tn1 k (YV)))
    (many T1R : (erased (Pk) k) (erased (Nat) b) -> (Tn1 k (YR b)))
    (many T1W : (erased (Pk) k k2) (erased (Am) n) (erased (KNe k k2) ne) -> (Tn1 k (YW k2 n)))))

(def-fns _ $ (erased tn1-tnk : (erased (Pk) k) (erased (Sy) s) (erased (List (Sy)) x) (erased (Tn1 k s) n) -> (erased (TNk k (Cons (Sy) s x)) nk))
  (match erased n _
    ((T1F _ f) (TNF k f x)) ((T1C _) (TNC k x)) ((T1E _) (TNE k x)) ((T1V _) (TNV k x)) ((T1R _ b) (TNR k b x)) ((T1W _ k2 m ne) (TNW k k2 m x ne))))

(def-adts
  ((TnR : ((Pk) k) ((Sy) s) ((Nat) c) -> Type)
    enum
    (many TnM : (erased (Pk) k) (many (Bool) b) (erased (Nat) c) -> (TnR k (YW k (MkAm b c)) c))
    (many TnN : (erased (Pk) k) (erased (Sy) s) (erased (Nat) c) (erased (Tn1 k s) nk) -> (TnR k s c))))

(def-fns _ $ (many tn-w : (many (Pk) k k2) (many (Bool) b) (erased (Nat) c) -> (many (TnR k (YW k2 (MkAm b c)) c) r))
  (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ ne) (TnN k _ c (T1W k k2 _ ne))))
  (TnM k b c))

(def-fns _ $ (many tn-of : (many (Pk) k) (many (Tg) t) (erased (Sy) s) (erased (Nat) c) (erased (Ecd s t c) e) -> (many (TnR k s c) r))
  (match many t _
    ((TgQD) (let-match erased e (EcQD _)) (TnN k _ c (T1F k (QD)))) ((TgQP) (let-match erased e (EcQP _)) (TnN k _ c (T1F k (QP))))
    ((TgQC0) (let-match erased e (EcQC0 _)) (TnN k _ c (T1F k (QC0)))) ((TgQC1) (let-match erased e (EcQC1 _)) (TnN k _ c (T1F k (QC1))))
    ((TgQC2) (let-match erased e (EcQC2 _)) (TnN k _ c (T1F k (QC2)))) ((TgQF0) (let-match erased e (EcQF0 _)) (TnN k _ c (T1F k (QF0))))
