(def-adts $ (Tg : -> Type)
  enum
  (many TgQD : -> (Tg)) (many TgQP : -> (Tg)) (many TgQC0 : -> (Tg)) (many TgQC1 : -> (Tg)) (many TgQC2 : -> (Tg)) (many TgQF0 : -> (Tg))
  (many TgQF1 : -> (Tg)) (many TgQF2 : -> (Tg)) (many TgQF3 : -> (Tg)) (many TgQG0 : -> (Tg)) (many TgQG1 : -> (Tg)) (many TgQG2 : -> (Tg))
  (many TgC : -> (Tg)) (many TgE : -> (Tg)) (many TgV : -> (Tg))
  (many TgXF : -> (Tg)) (many TgXT : -> (Tg)) (many TgFF : -> (Tg)) (many TgFT : -> (Tg))
  (many TgGF : -> (Tg)) (many TgGT : -> (Tg)) (many TgHF : -> (Tg)) (many TgHT : -> (Tg))
  (many TgR : -> (Tg)))

(def-adts
  ((Ecd : ((Sy) s) ((Tg) t) ((Nat) c) -> Type)
    enum
    (many EcQD : (erased (Nat) c) -> (Ecd (YF (QD)) (TgQD) c))
    (many EcQP : (erased (Nat) c) -> (Ecd (YF (QP)) (TgQP) c))
    (many EcQC0 : (erased (Nat) c) -> (Ecd (YF (QC0)) (TgQC0) c))
    (many EcQC1 : (erased (Nat) c) -> (Ecd (YF (QC1)) (TgQC1) c))
    (many EcQC2 : (erased (Nat) c) -> (Ecd (YF (QC2)) (TgQC2) c))
    (many EcQF0 : (erased (Nat) c) -> (Ecd (YF (QF0)) (TgQF0) c))
    (many EcQF1 : (erased (Nat) c) -> (Ecd (YF (QF1)) (TgQF1) c))
    (many EcQF2 : (erased (Nat) c) -> (Ecd (YF (QF2)) (TgQF2) c))
    (many EcQF3 : (erased (Nat) c) -> (Ecd (YF (QF3)) (TgQF3) c))
    (many EcQG0 : (erased (Nat) c) -> (Ecd (YF (QG0)) (TgQG0) c))
    (many EcQG1 : (erased (Nat) c) -> (Ecd (YF (QG1)) (TgQG1) c))
    (many EcQG2 : (erased (Nat) c) -> (Ecd (YF (QG2)) (TgQG2) c))
    (many EcC : (erased (Nat) c) -> (Ecd (YC) (TgC) c))
    (many EcE : (erased (Nat) c) -> (Ecd (YE) (TgE) c))
    (many EcV : (erased (Nat) c) -> (Ecd (YV) (TgV) c))
    (many EcXF : (erased (Nat) c) -> (Ecd (YW (KX) (MkAm (BFalse) c)) (TgXF) c))
    (many EcXT : (erased (Nat) c) -> (Ecd (YW (KX) (MkAm (BTrue) c)) (TgXT) c))
    (many EcFF : (erased (Nat) c) -> (Ecd (YW (KF) (MkAm (BFalse) c)) (TgFF) c))
    (many EcFT : (erased (Nat) c) -> (Ecd (YW (KF) (MkAm (BTrue) c)) (TgFT) c))
    (many EcGF : (erased (Nat) c) -> (Ecd (YW (KG) (MkAm (BFalse) c)) (TgGF) c))
    (many EcGT : (erased (Nat) c) -> (Ecd (YW (KG) (MkAm (BTrue) c)) (TgGT) c))
    (many EcHF : (erased (Nat) c) -> (Ecd (YW (KH) (MkAm (BFalse) c)) (TgHF) c))
    (many EcHT : (erased (Nat) c) -> (Ecd (YW (KH) (MkAm (BTrue) c)) (TgHT) c))
    (many EcR : (erased (Nat) c) -> (Ecd (YR c) (TgR) c))))

(let ((erased u8l0)) (prove-literal-lt 0 u8-modulus))
(let ((erased u8l1)) (prove-literal-lt 1 u8-modulus))
(let ((erased u8l2)) (prove-literal-lt 2 u8-modulus))
(let ((erased u8l3)) (prove-literal-lt 3 u8-modulus))
(let ((erased u8l4)) (prove-literal-lt 4 u8-modulus))
(let ((erased u8l5)) (prove-literal-lt 5 u8-modulus))
(let ((erased u8l6)) (prove-literal-lt 6 u8-modulus))
(let ((erased u8l7)) (prove-literal-lt 7 u8-modulus))
(let ((erased u8l8)) (prove-literal-lt 8 u8-modulus))
(let ((erased u8l9)) (prove-literal-lt 9 u8-modulus))
(let ((erased u8l10)) (prove-literal-lt 10 u8-modulus))
(let ((erased u8l11)) (prove-literal-lt 11 u8-modulus))
(let ((erased u8l12)) (prove-literal-lt 12 u8-modulus))
(let ((erased u8l13)) (prove-literal-lt 13 u8-modulus))
(let ((erased u8l14)) (prove-literal-lt 14 u8-modulus))
(let ((erased u8l15)) (prove-literal-lt 15 u8-modulus))
(let ((erased u8l16)) (prove-literal-lt 16 u8-modulus))
(let ((erased u8l17)) (prove-literal-lt 17 u8-modulus))
(let ((erased u8l18)) (prove-literal-lt 18 u8-modulus))
(let ((erased u8l19)) (prove-literal-lt 19 u8-modulus))
(let ((erased u8l20)) (prove-literal-lt 20 u8-modulus))
(let ((erased u8l21)) (prove-literal-lt 21 u8-modulus))
(let ((erased u8l22)) (prove-literal-lt 22 u8-modulus))
(let ((erased u8l23)) (prove-literal-lt 23 u8-modulus))

(def-fns _ $ (erased tg-u8 : (erased (Tg) t) -> (erased (U8) u) (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu))
  (match erased t _
    ((TgQD) (values (MkU8 0 u8l0) (coercible-trans (coercible-tag (Shared) TgQD) (coercible-wrap (Shared) MkU8 0 u8l0))))
    ((TgQP) (values (MkU8 1 u8l1) (coercible-trans (coercible-tag (Shared) TgQP) (coercible-wrap (Shared) MkU8 1 u8l1))))
    ((TgQC0) (values (MkU8 2 u8l2) (coercible-trans (coercible-tag (Shared) TgQC0) (coercible-wrap (Shared) MkU8 2 u8l2))))
    ((TgQC1) (values (MkU8 3 u8l3) (coercible-trans (coercible-tag (Shared) TgQC1) (coercible-wrap (Shared) MkU8 3 u8l3))))
    ((TgQC2) (values (MkU8 4 u8l4) (coercible-trans (coercible-tag (Shared) TgQC2) (coercible-wrap (Shared) MkU8 4 u8l4))))
    ((TgQF0) (values (MkU8 5 u8l5) (coercible-trans (coercible-tag (Shared) TgQF0) (coercible-wrap (Shared) MkU8 5 u8l5))))
    ((TgQF1) (values (MkU8 6 u8l6) (coercible-trans (coercible-tag (Shared) TgQF1) (coercible-wrap (Shared) MkU8 6 u8l6))))
    ((TgQF2) (values (MkU8 7 u8l7) (coercible-trans (coercible-tag (Shared) TgQF2) (coercible-wrap (Shared) MkU8 7 u8l7))))
    ((TgQF3) (values (MkU8 8 u8l8) (coercible-trans (coercible-tag (Shared) TgQF3) (coercible-wrap (Shared) MkU8 8 u8l8))))
    ((TgQG0) (values (MkU8 9 u8l9) (coercible-trans (coercible-tag (Shared) TgQG0) (coercible-wrap (Shared) MkU8 9 u8l9))))
    ((TgQG1) (values (MkU8 10 u8l10) (coercible-trans (coercible-tag (Shared) TgQG1) (coercible-wrap (Shared) MkU8 10 u8l10))))
    ((TgQG2) (values (MkU8 11 u8l11) (coercible-trans (coercible-tag (Shared) TgQG2) (coercible-wrap (Shared) MkU8 11 u8l11))))
    ((TgC) (values (MkU8 12 u8l12) (coercible-trans (coercible-tag (Shared) TgC) (coercible-wrap (Shared) MkU8 12 u8l12))))
    ((TgE) (values (MkU8 13 u8l13) (coercible-trans (coercible-tag (Shared) TgE) (coercible-wrap (Shared) MkU8 13 u8l13))))
    ((TgV) (values (MkU8 14 u8l14) (coercible-trans (coercible-tag (Shared) TgV) (coercible-wrap (Shared) MkU8 14 u8l14))))
    ((TgXF) (values (MkU8 15 u8l15) (coercible-trans (coercible-tag (Shared) TgXF) (coercible-wrap (Shared) MkU8 15 u8l15))))
    ((TgXT) (values (MkU8 16 u8l16) (coercible-trans (coercible-tag (Shared) TgXT) (coercible-wrap (Shared) MkU8 16 u8l16))))
    ((TgFF) (values (MkU8 17 u8l17) (coercible-trans (coercible-tag (Shared) TgFF) (coercible-wrap (Shared) MkU8 17 u8l17))))
    ((TgFT) (values (MkU8 18 u8l18) (coercible-trans (coercible-tag (Shared) TgFT) (coercible-wrap (Shared) MkU8 18 u8l18))))
    ((TgGF) (values (MkU8 19 u8l19) (coercible-trans (coercible-tag (Shared) TgGF) (coercible-wrap (Shared) MkU8 19 u8l19))))
    ((TgGT) (values (MkU8 20 u8l20) (coercible-trans (coercible-tag (Shared) TgGT) (coercible-wrap (Shared) MkU8 20 u8l20))))
    ((TgHF) (values (MkU8 21 u8l21) (coercible-trans (coercible-tag (Shared) TgHF) (coercible-wrap (Shared) MkU8 21 u8l21))))
    ((TgHT) (values (MkU8 22 u8l22) (coercible-trans (coercible-tag (Shared) TgHT) (coercible-wrap (Shared) MkU8 22 u8l22))))
    ((TgR) (values (MkU8 23 u8l23) (coercible-trans (coercible-tag (Shared) TgR) (coercible-wrap (Shared) MkU8 23 u8l23))))))

(def-fns _ $ (many enc-sy : (many (Sy) s) -> (many (Tg) t) (many (Nat) c) (erased (Ecd s t c) e))
  (match many s _
    ((YF f)
      (match many f _
        ((QD) (values (TgQD) 0 (EcQD 0))) ((QP) (values (TgQP) 0 (EcQP 0))) ((QC0) (values (TgQC0) 0 (EcQC0 0))) ((QC1) (values (TgQC1) 0 (EcQC1 0)))
        ((QC2) (values (TgQC2) 0 (EcQC2 0))) ((QF0) (values (TgQF0) 0 (EcQF0 0))) ((QF1) (values (TgQF1) 0 (EcQF1 0))) ((QF2) (values (TgQF2) 0 (EcQF2 0)))
        ((QF3) (values (TgQF3) 0 (EcQF3 0))) ((QG0) (values (TgQG0) 0 (EcQG0 0))) ((QG1) (values (TgQG1) 0 (EcQG1 0))) ((QG2) (values (TgQG2) 0 (EcQG2 0)))))
    ((YC) (values (TgC) 0 (EcC 0)))
    ((YE) (values (TgE) 0 (EcE 0)))
    ((YV) (values (TgV) 0 (EcV 0)))
    ((YR b) (values (TgR) b (EcR b)))
    ((YW k n)
      (let-match many n (MkAm b c))
      (match many k _
        ((KX) (match many b _ ((BFalse) (values (TgXF) c (EcXF c))) ((BTrue) (values (TgXT) c (EcXT c)))))
        ((KF) (match many b _ ((BFalse) (values (TgFF) c (EcFF c))) ((BTrue) (values (TgFT) c (EcFT c)))))
        ((KG) (match many b _ ((BFalse) (values (TgGF) c (EcGF c))) ((BTrue) (values (TgGT) c (EcGT c)))))
        ((KH) (match many b _ ((BFalse) (values (TgHF) c (EcHF c))) ((BTrue) (values (TgHT) c (EcHT c)))))))))

(def-fns _ $ (many dec-sy : (many (Tg) t) (many (Nat) c) -> (many (Sy) s) (erased (Ecd s t c) e))
  (match many t _
    ((TgQD) (values iD (EcQD c))) ((TgQP) (values iP (EcQP c))) ((TgQC0) (values (YF (QC0)) (EcQC0 c))) ((TgQC1) (values (YF (QC1)) (EcQC1 c)))
    ((TgQC2) (values (YF (QC2)) (EcQC2 c))) ((TgQF0) (values (YF (QF0)) (EcQF0 c))) ((TgQF1) (values (YF (QF1)) (EcQF1 c))) ((TgQF2) (values (YF (QF2)) (EcQF2 c)))
    ((TgQF3) (values (YF (QF3)) (EcQF3 c))) ((TgQG0) (values (YF (QG0)) (EcQG0 c))) ((TgQG1) (values (YF (QG1)) (EcQG1 c))) ((TgQG2) (values (YF (QG2)) (EcQG2 c)))
    ((TgC) (values (YC) (EcC c))) ((TgE) (values (YE) (EcE c))) ((TgV) (values (YV) (EcV c)))
    ((TgXF) (values (YW (KX) (MkAm (BFalse) c)) (EcXF c))) ((TgXT) (values (YW (KX) (MkAm (BTrue) c)) (EcXT c)))
    ((TgFF) (values (YW (KF) (MkAm (BFalse) c)) (EcFF c))) ((TgFT) (values (YW (KF) (MkAm (BTrue) c)) (EcFT c)))
    ((TgGF) (values (YW (KG) (MkAm (BFalse) c)) (EcGF c))) ((TgGT) (values (YW (KG) (MkAm (BTrue) c)) (EcGT c)))
    ((TgHF) (values (YW (KH) (MkAm (BFalse) c)) (EcHF c))) ((TgHT) (values (YW (KH) (MkAm (BTrue) c)) (EcHT c)))
    ((TgR) (values (YR c) (EcR c)))))

; Rg ts ns i j x: cells i to j-1 of a tag buffer indexed by ts and a count array indexed by ns encode the list x.
(def-adts
  ((Rg : ((List (U8)) ts) ((List (Copy (Nat))) ns) ((Nat) i) ((Nat) j) ((List (Sy)) x) -> Type)
    enum
    (many RgN : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i) -> (Rg ts ns i i (Nil (Sy))))
    (many RgC : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (Sy) s) (erased (List (Sy)) x)
       (erased (Tg) t) (erased (U8) u) (erased (Nat) c) (erased (Nth (U8) ts i u) nt) (erased (Nth (Copy (Nat)) ns i (MkCopy (Nat) c)) nn)
       (erased (Coercible (Shared) (Tg) t (Shared) (U8) u) cu) (erased (Ecd s t c) e) (erased (Rg ts ns (Succ i) j x) r)
       -> (Rg ts ns i j (Cons (Sy) s x)))))

(def-fns _ $ (erased rg-lt : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (Sy) s) (erased (List (Sy)) x)
    (subterm erased (Rg ts ns i j (Cons (Sy) s x)) rg) -> (erased (Lt i j) lt))
  (let-match erased rg (RgC _ _ _ _ _ _ _ _ _ _ _ _ _ r))
  (match erased r _
    ((RgN _ _ _) (lt-succ i))
    ((RgC _ _ _ _ s1 x1 _ _ _ _ _ _ _ _) (lt-trans i (Succ i) j (lt-succ i) (rg-lt ts ns (Succ i) j s1 x1 r)))))

(def-fns _ $ (erased rg-le : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (erased (List (Sy)) x)
    (erased (Rg ts ns i j x) rg) -> (erased (Lt i (Succ j)) le))
  (match erased rg _
    ((RgN _ _ _) (lt-succ i))
    ((RgC _ _ _ _ s1 x1 _ _ _ _ _ _ _ _) (lt-weaken i j (rg-lt ts ns i j s1 x1 rg)))))

(def-fns _ $ (erased rg-frt : (erased (List (U8)) ts ts2) (erased (List (Copy (Nat))) ns) (erased (Nat) i j q) (erased (U8) y) (erased (List (Sy)) x)
    (subterm erased (Rg ts ns i j x) rg) (erased (SetNth (U8) ts q y ts2) st) (erased (Lt q i) lt) -> (erased (Rg ts2 ns i j x) rg2))
  (match erased rg _
    ((RgN _ _ _) (RgN ts2 ns i))
    ((RgC _ _ _ _ s x1 t u c nt nn cu e r)
      (RgC ts2 ns i j s x1 t u c (setnth-nth-gt _ ts q i y u ts2 st nt lt) nn cu e (rg-frt ts ts2 ns (Succ i) j q y x1 r st (lt-weaken q i lt))))))

(def-fns _ $ (erased rg-frn : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns ns2) (erased (Nat) i j q) (erased (Copy (Nat)) y) (erased (List (Sy)) x)
    (subterm erased (Rg ts ns i j x) rg) (erased (SetNth (Copy (Nat)) ns q y ns2) st) (erased (Lt q i) lt) -> (erased (Rg ts ns2 i j x) rg2))
  (match erased rg _
    ((RgN _ _ _) (RgN ts ns2 i))
    ((RgC _ _ _ _ s x1 t u c nt nn cu e r)
      (RgC ts ns2 i j s x1 t u c nt (setnth-nth-gt _ ns q i y (MkCopy (Nat) c) ns2 st nn lt) cu e (rg-frn ts ns ns2 (Succ i) j q y x1 r st (lt-weaken q i lt))))))

(def-fns _ $ (erased rg-frt-hi : (erased (List (U8)) ts ts2) (erased (List (Copy (Nat))) ns) (erased (Nat) i j q) (erased (U8) y) (erased (List (Sy)) x)
    (subterm erased (Rg ts ns i j x) rg) (erased (SetNth (U8) ts q y ts2) st) (erased (Lt j (Succ q)) le) -> (erased (Rg ts2 ns i j x) rg2))
  (let-match erased rg (RgC _ _ _ _ s x1 t u c nt nn cu e r) ((RgN _ _ _) (RgN ts2 ns i)))
  (let ((erased lt)) (lt-le-trans i j q (rg-lt ts ns i j s x1 rg) le))
  (RgC ts2 ns i j s x1 t u c (setnth-nth-lt _ ts q i y u ts2 st nt lt) nn cu e (rg-frt-hi ts ts2 ns (Succ i) j q y x1 r st le)))

(def-fns _ $ (erased rg-frn-hi : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns ns2) (erased (Nat) i j q) (erased (Copy (Nat)) y) (erased (List (Sy)) x)
    (subterm erased (Rg ts ns i j x) rg) (erased (SetNth (Copy (Nat)) ns q y ns2) st) (erased (Lt j (Succ q)) le) -> (erased (Rg ts ns2 i j x) rg2))
  (let-match erased rg (RgC _ _ _ _ s x1 t u c nt nn cu e r) ((RgN _ _ _) (RgN ts ns2 i)))
  (let ((erased lt)) (lt-le-trans i j q (rg-lt ts ns i j s x1 rg) le))
  (RgC ts ns2 i j s x1 t u c nt (setnth-nth-lt _ ns q i y (MkCopy (Nat) c) ns2 st nn lt) cu e (rg-frn-hi ts ns ns2 (Succ i) j q y x1 r st le)))

(def-fns _ $ (erased rg-cat : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i m j) (erased (List (Sy)) x y z)
    (subterm erased (Rg ts ns i m x) r1) (erased (Rg ts ns m j y) r2) (erased (Cat (Sy) x y z) c) -> (erased (Rg ts ns i j z) rg))
  (match erased r1 _
    ((RgN _ _ _) (let-match erased c (CatN _ _)) r2)
    ((RgC _ _ _ _ s x1 t u cc nt nn cu e r)
      (let-match erased c (CatC _ _ _ _ z1 c1))
      (RgC ts ns i j s z1 t u cc nt nn cu e (rg-cat ts ns (Succ i) m j x1 y z1 r r2 c1)))))

(def-fns _ $ (erased rg-split : (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (erased (Nat) i j) (subterm erased (List (Sy)) x) (erased (List (Sy)) y z)
    (erased (Rg ts ns i j z) rg) (erased (Cat (Sy) x y z) c) -> (erased (Nat) m) (erased (Rg ts ns i m x) r1) (erased (Rg ts ns m j y) r2))
  (let-match erased c (CatC _ s x1 _ z1 c1) ((CatN _ _) (values i (RgN ts ns i) rg)))
  (let-match erased rg (RgC _ _ _ _ _ _ t u cc nt nn cu e r))
  (let ((erased m) (erased q1) (erased q2)) (rg-split ts ns (Succ i) j x1 y z1 r c1))
  (values m (RgC ts ns i m s x1 t u cc nt nn cu e q1) q2))

(def-adts $ (NoCnt : ((Tg) t) -> Type)
  enum
  (many NcQD : -> (NoCnt (TgQD))) (many NcQP : -> (NoCnt (TgQP))) (many NcQC0 : -> (NoCnt (TgQC0))) (many NcQC1 : -> (NoCnt (TgQC1)))
  (many NcQC2 : -> (NoCnt (TgQC2))) (many NcQF0 : -> (NoCnt (TgQF0))) (many NcQF1 : -> (NoCnt (TgQF1))) (many NcQF2 : -> (NoCnt (TgQF2)))
  (many NcQF3 : -> (NoCnt (TgQF3))) (many NcQG0 : -> (NoCnt (TgQG0))) (many NcQG1 : -> (NoCnt (TgQG1))) (many NcQG2 : -> (NoCnt (TgQG2)))
  (many NcC : -> (NoCnt (TgC))) (many NcE : -> (NoCnt (TgE))) (many NcV : -> (NoCnt (TgV))))

(def-fns _ $ (erased ecd-any : (erased (Tg) t) (erased (Sy) s) (erased (Nat) c c2) (erased (Ecd s t c) e) (erased (NoCnt t) nc) -> (erased (Ecd s t c2) e2))
  (match erased nc _
    ((NcQD) (let-match erased e (EcQD _)) (EcQD c2)) ((NcQP) (let-match erased e (EcQP _)) (EcQP c2))
    ((NcQC0) (let-match erased e (EcQC0 _)) (EcQC0 c2)) ((NcQC1) (let-match erased e (EcQC1 _)) (EcQC1 c2))
    ((NcQC2) (let-match erased e (EcQC2 _)) (EcQC2 c2)) ((NcQF0) (let-match erased e (EcQF0 _)) (EcQF0 c2))
    ((NcQF1) (let-match erased e (EcQF1 _)) (EcQF1 c2)) ((NcQF2) (let-match erased e (EcQF2 _)) (EcQF2 c2))
    ((NcQF3) (let-match erased e (EcQF3 _)) (EcQF3 c2)) ((NcQG0) (let-match erased e (EcQG0 _)) (EcQG0 c2))
    ((NcQG1) (let-match erased e (EcQG1 _)) (EcQG1 c2)) ((NcQG2) (let-match erased e (EcQG2 _)) (EcQG2 c2))
    ((NcC) (let-match erased e (EcC _)) (EcC c2)) ((NcE) (let-match erased e (EcE _)) (EcE c2)) ((NcV) (let-match erased e (EcV _)) (EcV c2))))

(def-fns _ $ (erased lt-pred : (erased (Nat) q e cap) (erased (Lt (Succ q) (Succ e)) l1) (erased (Lt e (Succ cap)) l2) -> (erased (Lt q cap) l))
  (let-match erased l1 (LtS _ _ la))
  (lt-le-trans q e cap la l2))

; Writes cell q with tag t and count c in front of a range that starts at q+1.
(def-fns _ $ (many wr-cons : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt) (unique (Array (Copy (Nat)) ns) bc)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) q) (erased (Lt q cap) lq) (many (Tg) t) (many (Nat) c)
    (erased (Sy) s) (erased (Ecd s t c) e) (erased (Nat) j) (erased (List (Sy)) x) (erased (Rg ts ns (Succ q) j x) rg)
    -> (erased (List (U8)) ts2) (erased (List (Copy (Nat))) ns2) (unique (Bytes ts2) bt2 at bt) (unique (Array (Copy (Nat)) ns2) bc2 at bc)
    (erased (Length (U8) ts2 cap) l3) (erased (Length (Copy (Nat)) ns2 cap) l4) (erased (Rg ts2 ns2 q j (Cons (Sy) s x)) rg2))
  (let ((erased u) (erased cu)) (tg-u8 t))
  (let ((many v)) (coerce t cu))
  (let ((erased m1) (erased nt0)) (nth-exists _ ts cap q l1 lq))
  (let ((erased ts2) (unique bt2) (erased st1)) (bytes-set _ bt q v m1 nt0))
  (let ((erased m2) (erased nn0)) (nth-exists _ ns cap q l2 lq))
  (let ((erased ns2) (unique bc2) (erased st2)) (array-place _ _ bc q (MkCopy _ c) m2 nn0))
  (values ts2 ns2 bt2 bc2 (setnth-length _ ts q cap u ts2 st1 l1) (setnth-length _ ns q cap (MkCopy _ c) ns2 st2 l2)
    (RgC ts2 ns2 q j s x t u c (setnth-nth _ ts q u ts2 st1) (setnth-nth _ ns q (MkCopy _ c) ns2 st2) cu e
      (rg-frn ts2 ns ns2 (Succ q) j q _ x (rg-frt ts ts2 ns (Succ q) j q u x rg st1 (lt-succ q)) st2 (lt-succ q)))))

; The same for a tag that carries no count, leaving the count array alone.
(def-fns _ $ (many wr-tag : (erased (Nat) cap) (erased (List (U8)) ts) (erased (List (Copy (Nat))) ns) (unique (Bytes ts) bt)
    (erased (Length (U8) ts cap) l1) (erased (Length (Copy (Nat)) ns cap) l2) (many (Nat) q) (erased (Lt q cap) lq) (many (Tg) t) (erased (NoCnt t) nc)
    (erased (Sy) s) (erased (Nat) c) (erased (Ecd s t c) e) (erased (Nat) j) (erased (List (Sy)) x) (erased (Rg ts ns (Succ q) j x) rg)
    -> (erased (List (U8)) ts2) (unique (Bytes ts2) bt2 at bt) (erased (Length (U8) ts2 cap) l3) (erased (Rg ts2 ns q j (Cons (Sy) s x)) rg2))
  (let ((erased u) (erased cu)) (tg-u8 t))
  (let ((many v)) (coerce t cu))
  (let ((erased m1) (erased nt0)) (nth-exists _ ts cap q l1 lq))
  (let ((erased ts2) (unique bt2) (erased st1)) (bytes-set _ bt q v m1 nt0))
  (let ((erased m2) (erased nn0)) (nth-exists _ ns cap q l2 lq))
  (let-match erased m2 (MkCopy _ c0))
  (values ts2 bt2 (setnth-length _ ts q cap u ts2 st1 l1)
    (RgC ts2 ns q j s x t u c0 (setnth-nth _ ts q u ts2 st1) nn0 cu (ecd-any t s c c0 e nc) (rg-frt ts ts2 ns (Succ q) j q u x rg st1 (lt-succ q)))))

(def-adts
  ((Nk1 : ((Pk) k) ((Sy) s) -> Type)
    enum
    (many N1F : (erased (Pk) k) (erased (Fx) f) -> (Nk1 k (YF f)))
    (many N1C : (erased (Pk) k) -> (Nk1 k (YC)))
    (many N1E : (erased (Pk) k) -> (Nk1 k (YE)))
    (many N1V : (erased (Pk) k) -> (Nk1 k (YV)))
    (many N1R : (erased (Pk) k) (erased (Nat) b) -> (Nk1 k (YR b)))
    (many N1W : (erased (Pk) k k2) (erased (Am) n) (erased (KNe k k2) ne) -> (Nk1 k (YW k2 n)))
    (many N1T : (erased (Pk) k) (erased (Nat) c) -> (Nk1 k (YW k (MkAm (BTrue) c))))))

(def-fns _ $ (erased nk1-nk : (erased (Pk) k) (erased (Sy) s) (erased (List (Sy)) x) (erased (Nk1 k s) n) -> (erased (NotK k (Cons (Sy) s x)) nk))
  (match erased n _
    ((N1F _ f) (NKF k f x)) ((N1C _) (NKC k x)) ((N1E _) (NKE k x)) ((N1V _) (NKV k x)) ((N1R _ b) (NKR k b x))
    ((N1W _ k2 m ne) (NKW k k2 m x ne)) ((N1T _ c) (NKT k c x))))

(def-adts
  ((WkR : ((Pk) k) ((Sy) s) ((Nat) c) -> Type)
    enum
    (many WkM : (erased (Pk) k) (erased (Nat) c) -> (WkR k (YW k (MkAm (BFalse) c)) c))
    (many WkN : (erased (Pk) k) (erased (Sy) s) (erased (Nat) c) (erased (Nk1 k s) nk) -> (WkR k s c))))

(def-fns _ $ (many wk-w : (many (Pk) k k2) (many (Bool) b) (erased (Nat) c) -> (many (WkR k (YW k2 (MkAm b c)) c) r))
  (let-match many (pk-cmp k k2) (PkEq _) ((PkNe _ _ ne) (WkN k _ c (N1W k k2 _ ne))))
  (match many b _ ((BFalse) (WkM k c)) ((BTrue) (WkN k _ c (N1T k c)))))

(def-fns _ $ (many wk-of : (many (Pk) k) (many (Tg) t) (erased (Sy) s) (erased (Nat) c) (erased (Ecd s t c) e) -> (many (WkR k s c) r))
  (match many t _
    ((TgQD) (let-match erased e (EcQD _)) (WkN k _ c (N1F k (QD)))) ((TgQP) (let-match erased e (EcQP _)) (WkN k _ c (N1F k (QP))))
    ((TgQC0) (let-match erased e (EcQC0 _)) (WkN k _ c (N1F k (QC0)))) ((TgQC1) (let-match erased e (EcQC1 _)) (WkN k _ c (N1F k (QC1))))
    ((TgQC2) (let-match erased e (EcQC2 _)) (WkN k _ c (N1F k (QC2)))) ((TgQF0) (let-match erased e (EcQF0 _)) (WkN k _ c (N1F k (QF0))))
    ((TgQF1) (let-match erased e (EcQF1 _)) (WkN k _ c (N1F k (QF1)))) ((TgQF2) (let-match erased e (EcQF2 _)) (WkN k _ c (N1F k (QF2))))
    ((TgQF3) (let-match erased e (EcQF3 _)) (WkN k _ c (N1F k (QF3)))) ((TgQG0) (let-match erased e (EcQG0 _)) (WkN k _ c (N1F k (QG0))))
    ((TgQG1) (let-match erased e (EcQG1 _)) (WkN k _ c (N1F k (QG1)))) ((TgQG2) (let-match erased e (EcQG2 _)) (WkN k _ c (N1F k (QG2))))
    ((TgC) (let-match erased e (EcC _)) (WkN k _ c (N1C k))) ((TgE) (let-match erased e (EcE _)) (WkN k _ c (N1E k)))
    ((TgV) (let-match erased e (EcV _)) (WkN k _ c (N1V k))) ((TgR) (let-match erased e (EcR _)) (WkN k _ c (N1R k c)))
    ((TgXF) (let-match erased e (EcXF _)) (wk-w k (KX) (BFalse) c)) ((TgXT) (let-match erased e (EcXT _)) (wk-w k (KX) (BTrue) c))
    ((TgFF) (let-match erased e (EcFF _)) (wk-w k (KF) (BFalse) c)) ((TgFT) (let-match erased e (EcFT _)) (wk-w k (KF) (BTrue) c))
    ((TgGF) (let-match erased e (EcGF _)) (wk-w k (KG) (BFalse) c)) ((TgGT) (let-match erased e (EcGT _)) (wk-w k (KG) (BTrue) c))
    ((TgHF) (let-match erased e (EcHF _)) (wk-w k (KH) (BFalse) c)) ((TgHT) (let-match erased e (EcHT _)) (wk-w k (KH) (BTrue) c))))

(def-fns _ $ (many wk-xg : (many (Pk) k) (many (Tg) t) (erased (Sy) s) (erased (Nat) c) (erased (Ecd s t c) e) -> (many (WkR k s c) r))
  (match many k _
    ((KX) (match many t _
      ((TgXF) (let-match erased e (EcXF _)) (WkM k c)) ((TgXT) (let-match erased e (EcXT _)) (WkN k _ c (N1T k c)))
      ((TgFF) (let-match erased e (EcFF _)) (WkN k _ c (N1W k (KF) _ (KNeXF)))) ((TgFT) (let-match erased e (EcFT _)) (WkN k _ c (N1W k (KF) _ (KNeXF))))
      ((TgGF) (let-match erased e (EcGF _)) (WkN k _ c (N1W k (KG) _ (KNeXG)))) ((TgGT) (let-match erased e (EcGT _)) (WkN k _ c (N1W k (KG) _ (KNeXG))))
      ((TgHF) (let-match erased e (EcHF _)) (WkN k _ c (N1W k (KH) _ (KNeXH)))) ((TgHT) (let-match erased e (EcHT _)) (WkN k _ c (N1W k (KH) _ (KNeXH))))
      (else (wk-of k t s c e))))
    ((KG) (match many t _
