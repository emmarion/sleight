    ((XbN _) (let-match erased (cat-fn (Bool) a b ab xb c d) (Refl _ _)) (XbN ab))
    ((XbP X1 _ x1 p1) (let-match erased d (CatC _ _ _ _ z1 d1)) (XbP X1 ab z1 (xb-tail X1 a b x1 ab z1 p1 c d1)))
    ((XbZ X1 _ x1 p1)
      (let-match erased d (CatC _ _ _ _ z1 d1)) (let-match erased d1 (CatC _ _ _ _ z2 d2)) (let-match erased d2 (CatC _ _ _ _ z3 d3))
      (XbZ X1 ab z3 (xb-tail X1 a b x1 ab z3 p1 c d3)))
    ((XbO X1 _ x1 p1)
      (let-match erased d (CatC _ _ _ _ z1 d1)) (let-match erased d1 (CatC _ _ _ _ z2 d2)) (let-match erased d2 (CatC _ _ _ _ z3 d3))
      (let-match erased d3 (CatC _ _ _ _ z4 d4))
      (XbO X1 ab z4 (xb-tail X1 a b x1 ab z4 p1 c d4)))))

(def-fns _ $ (erased tb-tail : (erased (Tt) T) (erased (List (Bool)) a b x ab xb) (erased (Tb T a x) p) (erased (Cat (Bool) a b ab) c)
    (erased (Cat (Bool) x b xb) d) -> (erased (Tb T ab xb) q))
  (let ((erased u) (erased tu) (erased cu)) (tb-split T a x p))
  (let ((erased w) (erased c1) (erased c2)) (cat-assoc (Bool) u a x b xb cu d))
  (let-match erased (cat-fn (Bool) a b w ab c1 c) (Refl _ _))
  (tb-cat T u ab xb tu c2))

(def-fns _ $ (many cat-of : (erased Type A) (subterm many (List A) x) (many (List A) y) -> (many (List A) z) (erased (Cat A x y z) c))
  (let-match many x (Cons _ a x1) ((Nil _) (values y (CatN A y))))
  (let ((many z1) (erased c1)) (notail $ cat-of A x1 y))
  (values (Cons A a z1) (CatC A a x1 y z1 c1)))

(def-fns _ $ (many zeros-rp : (subterm many (Nat) k) -> (many (List (Bool)) z) (erased (Rp (BFalse) k (Nil (Bool)) z) p))
  (let-match many k (Succ j) ((Zero) (values (Nil (Bool)) (RpZ _ _))))
  (let ((many z) (erased p)) (notail $ zeros-rp j))
  (values (Cons _ (BFalse) z) (RpS _ j _ z p)))

(def-fns _ $ (many rns-cells : (subterm many (List (Rn)) W) -> (many (Nat) n))
  (let-match many W (Cons _ rn W1) ((Nil _) 0))
  (let-match many rn (MkRn _ k))
  (nat-add k (notail $ rns-cells W1)))

(def-fns _ $ (many tk-split : (subterm many (Nat) a) (many (List (Tk)) X) -> (many (List (Tk)) U V) (erased (Cat (Tk) U V X) c))
  (let-match many a (Succ a1) ((Zero) (values (Nil (Tk)) X (CatN _ X))))
  (let-match many X (Cons _ t X1) ((Nil _) (values (Nil (Tk)) X (CatN _ X))))
  (let ((many U) (many V) (erased c)) (notail $ tk-split a1 X1))
  (values (Cons _ t U) V (CatC _ t U V X1 c)))

(def-adts
  ((Fw : ((List (Tk)) W) ((List (Tk)) G) -> Type)
    enum
    (many FwN : -> (Fw (Nil (Tk)) (Cons (Tk) (Tp) (Nil (Tk)))))
    (many FwZ : (erased (List (Tk)) W G H) (erased (Fw W G) p) (erased (Tl0 G H) tl) -> (Fw (Cons (Tk) (T0) W) (Cons (Tk) (T1) H)))
    (many FwO : (erased (List (Tk)) W G H) (erased (Fw W G) p) (erased (Tl0 G H) tl) -> (Fw (Cons (Tk) (T1) W) (Cons (Tk) (Tp) (Cons (Tk) (T1) H))))))

(def-adts
  ((FwR : ((List (Tk)) W) -> Type)
    enum
