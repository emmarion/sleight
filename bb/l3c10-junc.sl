  (match many t _
    ((T0) (FwOk W _ (FwZ W1 G W1 p tl) (Tl01 W1)))
    ((T1) (FwOk W _ (FwO W1 G W1 p tl) (Tl0P (Cons _ (T1) W1))))
    ((Tp) (FwNo W))))

