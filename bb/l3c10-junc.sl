(def-fns _ $ (many xb-cells : (subterm many (List (Tk)) X) (many (List (Bool)) r) -> (many (List (Bool)) x) (erased (Xb X r x) p))
  (let-match many X (Cons _ t X1) ((Nil _) (values r (XbN r))))
  (let ((many x1) (erased p1)) (notail $ xb-cells X1 r))
  (match many t _
    ((Tp) (values (bits "0" x1) (XbP X1 r x1 p1)))
    ((T0) (values (bits "111" x1) (XbZ X1 r x1 p1)))
    ((T1) (values (bits "0111" x1) (XbO X1 r x1 p1)))))

(def-fns _ $ (erased xb-tail : (erased (List (Tk)) X) (erased (List (Bool)) a b x ab xb) (subterm erased (Xb X a x) p) (erased (Cat (Bool) a b ab) c)
    (erased (Cat (Bool) x b xb) d) -> (erased (Xb X ab xb) q))
