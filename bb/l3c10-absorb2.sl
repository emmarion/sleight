(def-fns _ $ (erased rd-contact : (erased (List (Tk)) X W Y) (erased (Tt) T2) (erased (Ap3 W X) a) (erased (E1 W) e)
    (erased (Rd (Cons (Tk) (Tp) (Cons (Tk) (T1) X)) (Tt1) Y T2 n4) rd) -> (erased (Cx W Y) cx) (erased (Eq (Tt) T2 (Tt1)) et))
