    (many D0C : (erased (Nat) d e) (erased (List (Nat)) D) (erased (D0 (Cons (Nat) e D)) p) -> (D0 (Cons (Nat) d (Cons (Nat) e D))))))

(def-fns _ $ (erased d0-cons : (erased (Nat) d) (erased (List (Nat)) D) (erased (D0 D) q) -> (erased (D0 (Cons (Nat) d D)) r))
