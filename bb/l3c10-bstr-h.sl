(let ((many bh-d0)) (lt-dec 0 u8-modulus))
(comptime-match many bh-d0 (Yes _ _ _ _ bh-z))

(def-fns _ $ (many bh-user : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (many (Nat) t))
  (let ((unique w1) (many u)) (world-do _ w (Measure sw-stop)))
  (let-match many u (MkUsage _ user _ _ _ _ _ _))
  (values w1 user))

(def-fns _ $ (many bh-out : (unique (World) w at vacant-slot) (many (Rope) r) -> (unique (World) w2 at w))
  (let ((many s) (erased _)) (flatten r))
  (let ((unique w1) (many _)) (world-do _ w (WriteOut s)))
  w1)

(def-lvl BH0)
(def-lvl BH)
(def-fns BH0 $ (many bh-step : (subterm many (Nat) nm) (many (List (Nat)) sc) (many (Nat) mv) (many (List (Nat)) cks) (erased (Conf) c0) (many (Rq) e)
    (erased (Rch l3 c0 e) ch) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program BH) next))
  (let ((many k) (many nm1) (many sc1) (many r)) (match many nm (((Nat) k) ((Nat) nm1) ((List (Nat)) sc1) ((Rs l3 c0) r))
    ((Succ _)
      (let ((many k) (many nm1)) (match many (nat-cmp nm 1000) (((Nat) k) ((Nat) nm1)) ((CGt _ _ _ _ _) (values 1000 (monus nm 1000))) (else (values nm 0))))
      (let ((many _) (many e1) (erased ch1)) (c10-run6 c0 k e ch))
      (values k nm1 sc (RsOk _ _ e1 ch1)))
    ((Zero)
      (match many sc (((Nat) k) ((Nat) nm1) ((List (Nat)) sc1) ((Rs l3 c0) r))
        ((Cons _ i sc1) (values 1 0 sc1 (s15-move i c0 e ch)))
        ((Nil _) (values 1 0 sc (RsNo l3 c0 e ch)))))))
  (let-match many r (RsOk _ _ e1 ch1) ((RsNo _ _ _ _) (values (bh-out w (sp (RStr "END") mv)) (Exit BH (MkU8 0 bh-z)))))
  (let ((many mv1) (erased _)) (add mv k))
  (let ((unique w1) (many user)) (bh-user w))
  (let ((many ck) (many cks1)) (match many cks (((Bool) b) ((List (Nat)) t))
    ((Cons _ c t) (match many (nat-eq c mv1) _ ((Equal _ _ _) (values (BTrue) t)) (else (values (BFalse) cks))))
    ((Nil _) (values (BFalse) cks))))
  (let ((many line)) (RCat (sp (sp (RStr "T") mv1) user) (RChar #\newline)))
  (let ((unique w2)) (bh-out w1 (match many ck (((Rope) t)) ((BTrue) (RCat line (RCat (sp (RStr "C") mv1) (RCat (RChar #\newline) (show-cfg e1))))) ((BFalse) line))))
  (def-unique BH $ (unique again : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program BH) next))
    (bh-step nm1 sc1 mv1 cks1 c0 e1 ch1 v))
  (values w2 (Continue BH again)))

(def-fns _ $ (many bh-prog : (many (String) g) -> (unique (Program BH) p))
  (def-unique BH $ (unique go : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program BH) next))
    (let ((unique v1) (many s)) (world-do _ v (ReadRemaining)))
    (let ((many nm) (many s1)) (tok s))
    (let ((many nc) (many s2)) (tok s1))
    (let ((many ns) (many s3)) (tok s2))
    (let ((many cks) (many s4)) (rd-nats nc s3))
    (let ((many scr) (many _)) (rd-nats ns s4))
    (let ((unique v2) (many t0)) (bh-user v1))
    (let-match many (gen-b g) (GBOk _ e _) ((GBNo _) (values (bh-out v2 (RStr "NOGEN")) (Exit BH (MkU8 0 bh-z)))))
    (let ((unique v3) (many t1)) (bh-user v2))
    (let ((erased c0) (erased ch)) (rch-self l3 e))
    (let ((unique v4)) (bh-out v3 (RCat (sp (RStr "D") (monus t1 t0)) (RChar #\newline))))
    (bh-step nm scr 0 cks c0 e ch v4))
  (Continue BH go))
