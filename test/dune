(alias
 (name sources)
 (deps
  (glob_files %{project_root}/tests/*.sl)
  (glob_files %{project_root}/std/*.sl)
  (glob_files %{project_root}/pal/*.sl)
  %{project_root}/self/base.sl
  (glob_files %{project_root}/mini/*.sl)))

(test
 (name runtest)
 (libraries sleight unix)
 (deps
  (alias sources)))

(rule
 (action
  (with-stdin-from
   repl_rollback.in
   (with-outputs-to
    repl_rollback.out
    (run %{exe:../bin/main.exe} --repl)))))

(rule
 (alias runtest)
 (action
  (diff repl_rollback.expected repl_rollback.out)))

(rule
 (deps %{project_root}/tests/sorry_comptime.sl)
 (action
  (with-outputs-to
   sorry_strict.out
   (with-accepted-exit-codes
    1
    (run %{exe:../bin/main.exe} --warnings-as-errors %{project_root}/tests/sorry_comptime.sl)))))

(rule
 (alias runtest)
 (action
  (diff sorry_strict.expected sorry_strict.out)))

(rule
 (deps %{project_root}/tests/sorry_program.sl)
 (action
  (with-stdin-from
   sorry_program.in
   (with-outputs-to
    sorry_program.out
    (with-accepted-exit-codes
     3
     (run %{exe:../bin/main.exe} %{project_root}/tests/sorry_program.sl))))))

(rule
 (alias runtest)
 (action
  (diff sorry_program.expected sorry_program.out)))
