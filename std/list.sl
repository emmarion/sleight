(def-fns _ $ (erased length-fn : (erased Type A) (erased (List A) xs) (erased (Nat) n m)
    (subterm erased (Length A xs n) p) (erased (Length A xs m) q) -> (erased (Eq (Nat) n m) e))
  (let-match erased p (LengthCons _ a rest k p1) ((LengthNil _) (let-match erased q (LengthNil _)) (Refl _ n)))
  (let-match erased q (LengthCons _ b rest2 j q1))
  (let-match erased (length-fn _ rest k j p1 q1) (Refl _ _))
  (Refl _ n))

(def-fns _ $ (erased length-exists : (erased Type A) (subterm erased (List A) xs) ->
    (erased (Nat) n) (erased (Length A xs n) p))
  (let-match erased xs (Cons _ a rest) ((Nil _) (values (Zero) (LengthNil _))))
  (let ((erased k) (erased q)) (length-exists _ rest))
  (values (Succ k) (LengthCons _ a rest k q)))

(def-fns _ $ (erased nth-fn : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x y)
    (subterm erased (Nth A xs i x) p) (erased (Nth A xs i y) q) -> (erased (Eq A x y) e))
  (let-match erased p (NthThere _ a rest k b p1) ((NthHere _ a rest) (let-match erased q (NthHere _ c rest2)) (Refl _ x)))
  (let-match erased q (NthThere _ c rest2 k2 d q1))
  (let-match erased (nth-fn _ rest k b d p1 q1) (Refl _ _))
  (Refl _ x))

(def-fns _ $ (erased nth-lt-length : (erased Type A) (erased (List A) xs) (erased (Nat) i n) (erased A x)
    (subterm erased (Nth A xs i x) p) (erased (Length A xs n) q) -> (erased (Lt i n) r))
  (let-match erased p (NthThere _ a rest k b p1)
    ((NthHere _ a rest) (let-match erased q (LengthCons _ c rest2 j q1)) (LtZ j)))
  (let-match erased q (LengthCons _ c rest2 j q1))
  (LtS k j (nth-lt-length _ rest k j b p1 q1)))

(def-fns _ $ (erased nth-exists : (erased Type A) (erased (List A) xs) (erased (Nat) n i)
    (subterm erased (Length A xs n) p) (erased (Lt i n) lt) -> (erased A x) (erased (Nth A xs i x) q))
  (let-match erased p (LengthCons _ a rest k p1) (absurd (LengthNil _) lt))
  (let-match erased i (Succ i1) ((Zero) (values a (NthHere _ a rest))))
  (let-match erased lt (LtS _ _ lt1))
  (let ((erased b) (erased q)) (nth-exists _ rest k i1 p1 lt1))
  (values b (NthThere _ a rest i1 b q)))

(def-fns _ $ (erased setnth-fn : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A y) (erased (List A) ys zs)
    (subterm erased (SetNth A xs i y ys) p) (erased (SetNth A xs i y zs) q) -> (erased (Eq (List A) ys zs) e))
  (let-match erased p (SetThere _ a rest k b rest2 p1) ((SetHere _ a b rest) (let-match erased q (SetHere _ c d rest2)) (Refl _ ys)))
  (let-match erased q (SetThere _ c rest3 k2 d rest4 q1))
  (let-match erased (setnth-fn _ rest k b rest2 rest4 p1 q1) (Refl _ _))
  (Refl _ ys))

(def-fns _ $ (erased setnth-exists : (erased Type A) (erased (List A) xs) (erased (Nat) n i) (erased A y)
    (subterm erased (Length A xs n) p) (erased (Lt i n) lt) -> (erased (List A) ys) (erased (SetNth A xs i y ys) q))
  (let-match erased p (LengthCons _ a rest k p1) (absurd (LengthNil _) lt))
  (let-match erased i (Succ i1) ((Zero) (values (Cons _ y rest) (SetHere _ a y rest))))
  (let-match erased lt (LtS _ _ lt1))
  (let ((erased rest2) (erased q)) (setnth-exists _ rest k i1 y p1 lt1))
  (values (Cons _ a rest2) (SetThere _ a rest i1 y rest2 q)))

(def-fns _ $ (erased setnth-length : (erased Type A) (erased (List A) xs) (erased (Nat) i n) (erased A y) (erased (List A) ys)
    (subterm erased (SetNth A xs i y ys) p) (erased (Length A xs n) q) -> (erased (Length A ys n) r))
  (let-match erased p (SetThere _ a rest k b rest2 p1)
    ((SetHere _ a b rest) (let-match erased q (LengthCons _ c rest3 j q1)) (LengthCons _ b rest j q1)))
  (let-match erased q (LengthCons _ c rest3 j q1))
  (LengthCons _ a rest2 j (setnth-length _ rest k j b rest2 p1 q1)))

(def-fns _ $ (erased setnth-nth : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A y) (erased (List A) ys)
    (subterm erased (SetNth A xs i y ys) p) -> (erased (Nth A ys i y) q))
  (let-match erased p (SetThere _ a rest k b rest2 p1) ((SetHere _ a b rest) (NthHere _ b rest)))
  (NthThere _ a rest2 k b (setnth-nth _ rest k b rest2 p1)))

(def-fns _ $ (erased setnth-nth-lt : (erased Type A) (erased (List A) xs) (erased (Nat) i j) (erased A y x) (erased (List A) ys)
    (subterm erased (SetNth A xs i y ys) p) (erased (Nth A xs j x) q) (erased (Lt j i) lt) -> (erased (Nth A ys j x) r))
  (let-match erased p (SetThere _ a rest k b rest2 p1) (absurd (SetHere _ a b rest) lt))
  (let-match erased q (NthThere _ c rest3 j1 d q1) ((NthHere _ c rest3) (NthHere _ a rest2)))
  (let-match erased lt (LtS _ _ lt1))
  (NthThere _ a rest2 j1 x (setnth-nth-lt _ rest k j1 b x rest2 p1 q1 lt1)))

(def-fns _ $ (erased setnth-nth-gt : (erased Type A) (erased (List A) xs) (erased (Nat) i j) (erased A y x) (erased (List A) ys)
    (subterm erased (SetNth A xs i y ys) p) (erased (Nth A xs j x) q) (erased (Lt i j) gt) -> (erased (Nth A ys j x) r))
  (let-match erased q (NthThere _ c rest3 j1 d q1) (absurd (NthHere _ c rest3) gt))
  (let-match erased p (SetThere _ a rest k b rest2 p1) ((SetHere _ a b rest) (NthThere _ b rest j1 x q1)))
  (let-match erased gt (LtS _ _ gt1))
  (NthThere _ a rest2 j1 x (setnth-nth-gt _ rest k j1 b x rest2 p1 q1 gt1)))

(def-fns _ $ (erased setnth-back-lt : (erased Type A) (erased (List A) xs) (erased (Nat) i j) (erased A y x) (erased (List A) ys)
    (subterm erased (SetNth A xs i y ys) p) (erased (Nth A ys j x) q) (erased (Lt j i) lt) -> (erased (Nth A xs j x) r))
  (let-match erased p (SetThere _ a rest k b rest2 p1) (absurd (SetHere _ a b rest) lt))
  (let-match erased q (NthThere _ c rest3 j1 d q1) ((NthHere _ c rest3) (NthHere _ a rest)))
  (let-match erased lt (LtS _ _ lt1))
  (NthThere _ a rest j1 x (setnth-back-lt _ rest k j1 b x rest2 p1 q1 lt1)))

(def-fns _ $ (erased setnth-back-gt : (erased Type A) (erased (List A) xs) (erased (Nat) i j) (erased A y x) (erased (List A) ys)
    (subterm erased (SetNth A xs i y ys) p) (erased (Nth A ys j x) q) (erased (Lt i j) gt) -> (erased (Nth A xs j x) r))
  (let-match erased q (NthThere _ c rest3 j1 d q1) (absurd (NthHere _ c rest3) gt))
  (let-match erased p (SetThere _ a rest k b rest2 p1) ((SetHere _ a b rest) (NthThere _ a rest j1 x q1)))
  (let-match erased gt (LtS _ _ gt1))
  (NthThere _ a rest j1 x (setnth-back-gt _ rest k j1 b x rest2 p1 q1 gt1)))

(def-fns _ $ (erased setnth-same : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x) (erased (List A) ys)
    (subterm erased (Nth A xs i x) p) (erased (SetNth A xs i x ys) q) -> (erased (Eq (List A) xs ys) e))
  (let-match erased p (NthThere _ a rest k b p1) ((NthHere _ a rest) (let-match erased q (SetHere _ c d rest2)) (Refl _ xs)))
  (let-match erased q (SetThere _ c rest2 k2 d rest3 q1))
  (let-match erased (setnth-same _ rest k b rest3 p1 q1) (Refl _ _))
  (Refl _ xs))

(def-fns _ $ (erased setnth-twice : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A y z) (erased (List A) ys zs)
    (subterm erased (SetNth A xs i y ys) p) (erased (SetNth A ys i z zs) q) -> (erased (SetNth A xs i z zs) r))
  (let-match erased p (SetThere _ a rest k b rest2 p1) ((SetHere _ a b rest) (let-match erased q (SetHere _ c d rest2)) (SetHere _ a z rest)))
  (let-match erased q (SetThere _ c rest3 k2 d rest4 q1))
  (SetThere _ a rest k z rest4 (setnth-twice _ rest k b z rest2 rest4 p1 q1)))

(def-fns _ $ (erased setnth-commute-lt : (erased Type A) (erased (List A) xs) (erased (Nat) i j) (erased A y z) (erased (List A) ys zs)
    (subterm erased (SetNth A xs i y ys) p) (erased (SetNth A ys j z zs) q) (erased (Lt i j) lt) ->
    (erased (List A) ws) (erased (SetNth A xs j z ws) r) (erased (SetNth A ws i y zs) s))
  (let-match erased q (SetThere _ c rest3 j1 d rest4 q1) (absurd (SetHere _ c d rest3) lt))
  (let-match erased p (SetThere _ a rest k b rest2 p1)
    ((SetHere _ a b rest) (values (Cons _ a rest4) (SetThere _ a rest j1 z rest4 q1) (SetHere _ a y rest4))))
  (let-match erased lt (LtS _ _ lt1))
  (let ((erased ws1) (erased r1) (erased s1)) (setnth-commute-lt _ rest k j1 b z rest2 rest4 p1 q1 lt1))
  (values (Cons _ a ws1) (SetThere _ a rest j1 z ws1 r1) (SetThere _ a ws1 k b rest4 s1)))

(def-fns _ $ (erased setnth-commute-gt : (erased Type A) (erased (List A) xs) (erased (Nat) i j) (erased A y z) (erased (List A) ys zs)
    (subterm erased (SetNth A xs i y ys) p) (erased (SetNth A ys j z zs) q) (erased (Lt j i) gt) ->
    (erased (List A) ws) (erased (SetNth A xs j z ws) r) (erased (SetNth A ws i y zs) s))
  (let-match erased p (SetThere _ a rest k b rest2 p1) (absurd (SetHere _ a b rest) gt))
  (let-match erased q (SetThere _ c rest3 j1 d rest4 q1)
    ((SetHere _ c d rest3) (values (Cons _ z rest) (SetHere _ a z rest) (SetThere _ z rest k b rest2 p1))))
  (let-match erased gt (LtS _ _ gt1))
  (let ((erased ws1) (erased r1) (erased s1)) (setnth-commute-gt _ rest k j1 b z rest2 rest4 p1 q1 gt1))
  (values (Cons _ a ws1) (SetThere _ a rest j1 z ws1 r1) (SetThere _ a ws1 k b rest4 s1)))

(def-fns _ $ (erased repeat-length : (erased Type A) (erased (Nat) n) (erased A x) (erased (List A) xs)
    (subterm erased (Repeat A n x xs) p) -> (erased (Length A xs n) q))
  (let-match erased p (RepeatCons _ k a rest p1) ((RepeatNil _ a) (LengthNil _)))
  (LengthCons _ x rest k (repeat-length _ k x rest p1)))

(def-fns _ $ (erased repeat-nth : (erased Type A) (erased (Nat) n i) (erased A x) (erased (List A) xs)
    (subterm erased (Repeat A n x xs) p) (erased (Lt i n) lt) -> (erased (Nth A xs i x) q))
  (let-match erased p (RepeatCons _ k a rest p1) (absurd (RepeatNil _ a) lt))
  (let-match erased i (Succ i1) ((Zero) (NthHere _ x rest)))
  (let-match erased lt (LtS _ _ lt1))
  (NthThere _ x rest i1 x (repeat-nth _ k i1 x rest p1 lt1)))

(def-fns _ $ (erased repeat-elem : (erased Type A) (erased (Nat) n i) (erased A x y) (erased (List A) xs)
    (subterm erased (Repeat A n x xs) p) (erased (Nth A xs i y) q) -> (erased (Eq A x y) e))
  (let-match erased p (RepeatCons _ k a rest p1) (absurd (RepeatNil _ a) q))
  (let-match erased q (NthThere _ c rest2 i1 d q1) ((NthHere _ c rest2) (Refl _ x)))
  (repeat-elem _ k i1 x y rest p1 q1))

(def-fns _ $ (erased repeat-fn : (erased Type A) (erased (Nat) n) (erased A x) (erased (List A) xs ys)
    (subterm erased (Repeat A n x xs) p) (erased (Repeat A n x ys) q) -> (erased (Eq (List A) xs ys) e))
  (let-match erased p (RepeatCons _ k a rest p1) ((RepeatNil _ a) (let-match erased q (RepeatNil _ b)) (Refl _ xs)))
  (let-match erased q (RepeatCons _ k2 b rest2 q1))
  (let-match erased (repeat-fn _ k x rest rest2 p1 q1) (Refl _ _))
  (Refl _ xs))

(def-fns _ $ (erased repeat-exists : (erased Type A) (subterm erased (Nat) n) (erased A x) ->
    (erased (List A) xs) (erased (Repeat A n x xs) p))
  (let-match erased n (Succ k) ((Zero) (values (Nil _) (RepeatNil _ x))))
  (let ((erased rest) (erased p)) (repeat-exists _ k x))
  (values (Cons _ x rest) (RepeatCons _ k x rest p)))

(def-fns _ $ (erased nth-last-lt : (erased Type A) (erased (List A) xs) (erased (Nat) i n) (erased A x)
    (subterm erased (NthLast A xs i x) q) (erased (Length A xs n) p) -> (erased (Lt i n) r))
  (let-match erased p (LengthCons _ y rest k p1) (absurd (LengthNil _) q))
  (let-match erased q (NthLastThere _ _ _ _ _ q1)
    ((NthLastHere _ _ _ _ p2) (let-match erased (length-fn _ rest i k p2 p1) (Refl _ _)) (lt-succ i)))
  (lt-weaken i k (nth-last-lt _ rest i k x q1 p1)))

(def-fns _ $ (erased nth-last-fn : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x y)
    (subterm erased (NthLast A xs i x) p) (erased (NthLast A xs i y) q) -> (erased (Eq A x y) e))
  (match erased p _
    ((NthLastHere _ _ rest n l1)
      (match erased q _
        ((NthLastHere _ _ _ _ _) (Refl _ x))
        (absurd (NthLastThere _ _ _ _ _ q1) (let ((erased l)) (nth-last-lt _ rest n n y q1 l1)) (lt-asym n n l (lt-weaken n n l)))))
    ((NthLastThere _ z rest k _ p1)
      (match erased q _
        (absurd (NthLastHere _ _ _ _ l2) (let ((erased l)) (nth-last-lt _ rest k k x p1 l2)) (lt-asym k k l (lt-weaken k k l)))
        ((NthLastThere _ _ _ _ _ q1) (nth-last-fn _ rest k x y p1 q1))))))
