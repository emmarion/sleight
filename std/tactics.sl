(def-fns _ $ (many is-head : (unique (MacroWorld) mw) (many (Raw) hd)
    (erased Type T) (erased T t) (many (Settled (MErased) T t) want) -> (unique (MacroWorld) mw2 at mw) (many (Bool) b))
  (let-match many hd (RawSymbol p s) (else (values mw (BFalse))))
  (let ((unique mw1) (many res)) (resolve mw s))
  (let-match many res (RSettled m U v h) (else (values mw1 (BFalse))))
  (let ((unique mw2) (many e)) (settled-eq _ _ _ _ _ _ mw1 (settled-erase _ _ _ h) want))
  (values mw2 $ match many e (((Bool) _)) ((Some _ j) (BTrue)) ((None _) (BFalse))))

(def-fns _ $ (many split-arrow : (subterm many (List $ Raw) xs) (many (Pos) p) -> (many (List $ Raw) params) (many (List $ Raw) returns))
  (let-match many xs (Cons _ x rest) ((Nil _) (values (Nil _) (Nil _))))
  (let-match many (same-sym x (name p "->")) (BFalse) ((BTrue) (values (Nil _) rest)))
  (let ((many ps) (many rs)) (notail $ split-arrow rest p))
  (values (Cons _ x ps) rs))

(def-fns _ $ (many lt-chain : (subterm many (Nat) fuel) (many (List $ Raw) edges) (subterm many (List $ Raw) todo)
    (many (Raw) from) (many (Raw) to) (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many fuel (Succ f1) ((Zero) (None _)))
  (let-match many todo (Cons _ e rest) ((Nil _) (None _)))
  (let ((many next)) (notail $ lt-chain fuel edges rest from to p))
  (let-match many e (RawList ep es) (else next))
  (let-match many es (Cons _ h r1) ((Nil _) next))
  (let-match many r1 (Cons _ x r2) ((Nil _) next))
  (let-match many r2 (Cons _ y r3) ((Nil _) next))
  (let-match many (same-raw x from) (BTrue) ((BFalse) next))
  (let-match many (same-raw y to) (BFalse) ((BTrue) (Some _ h)))
  (let-match many (notail $ lt-chain f1 edges edges y to p) (Some _ q) ((None _) next))
  (Some _ $ form p $ Cons _ (RawSettled p _ _ _ (settled-of erased lt-trans)) $ Cons _ from $ Cons _ y $ Cons _ to $ two h q))

(def-fns _ $ (many succ-edges : (unique (MacroWorld) mw) (subterm many (Raw) t) (many (Pos) p) (many (List $ Raw) later) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let-match many t (RawList tp ts) (else (values mw later)))
  (let-match many ts (Cons _ hd t1) ((Nil _) (values mw later)))
  (let-match many t1 (Cons _ x t2) ((Nil _) (values mw later)))
  (let-match many t2 (Nil _) (else (values mw later)))
  (let ((unique mw1) (many s)) (is-head mw hd _ _ (settled-of erased Succ)))
  (let-match many s (BTrue) ((BFalse) (values mw1 later)))
  (tail $ succ-edges mw1 x p $ Cons _ (form p $ three (form p $ two (RawSettled p _ _ _ (settled-of erased lt-succ)) x) x t) later))

(def-fns _ $ (many name-edges : (many (Raw) x) (many (Raw) y) (subterm many (List $ Raw) names) (many (Pos) p) (many (List $ Raw) later) ->
    (many (List $ Raw) out))
  (match many names _
    ((Nil _) later)
    ((Cons _ n rest) (Cons _ (form p $ three n x y) $ notail $ name-edges x y rest p later))))

(def-fns _ $ (many lt-edges : (unique (MacroWorld) mw) (subterm many (List $ Raw) params) (many (Pos) p) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let-match many params (Cons _ prm rest) ((Nil _) (values mw (Nil _))))
  (let ((unique mw1) (many later)) (notail $ lt-edges mw rest p))
  (let-match many prm (RawList pp items) (else (values mw1 later)))
  (let-match many items (Cons _ m i1) ((Nil _) (values mw1 later)))
  (let-match many i1 (Cons _ ty names) ((Nil _) (values mw1 later)))
  (let-match many ty (RawList tp ts) (else (values mw1 later)))
  (let-match many ts (Cons _ hd t1) ((Nil _) (values mw1 later)))
  (let-match many t1 (Cons _ x t2) ((Nil _) (values mw1 later)))
  (let-match many t2 (Cons _ y t3) ((Nil _) (values mw1 later)))
  (let-match many t3 (Nil _) (else (values mw1 later)))
  (let ((unique mw2) (many lt)) (is-head mw1 hd _ _ (settled-of erased Lt)))
  (let-match many lt (BTrue) ((BFalse) (values mw2 later)))
  (let ((unique mw3) (many l1)) (succ-edges mw2 y p (name-edges x y names p later)))
  (succ-edges mw3 x p l1))

(def-fns _ $ (many lt-lemma-fn : (unique (MacroWorld) mw) (many (Pos) here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let-match many args (Cons _ header a1) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many header (RawList hp hs) (else (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many hs (Cons _ m h1) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many h1 (Cons _ fname h2) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many h2 (Cons _ colon h3) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let ((many params) (many returns)) (split-arrow h3 here))
  (let-match many returns (Cons _ ret more) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many ret (RawList rp ritems) (else (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many ritems (Cons _ rm r1) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many r1 (Cons _ goal r2) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many goal (RawList gp gs) (else (macro-fail mw here "lt-lemma: the goal is (Lt x z)")))
  (let-match many gs (Cons _ lt g1) ((Nil _) (macro-fail mw here "lt-lemma: the goal is (Lt x z)")))
  (let-match many g1 (Cons _ x g2) ((Nil _) (macro-fail mw here "lt-lemma: the goal is (Lt x z)")))
  (let-match many g2 (Cons _ z g3) ((Nil _) (macro-fail mw here "lt-lemma: the goal is (Lt x z)")))
  (let ((unique mw1) (many glt)) (is-head mw lt _ _ (settled-of erased Lt)))
  (let-match many glt (BTrue) ((BFalse) (macro-fail mw1 here "lt-lemma: the goal's head is not the prelude's `Lt`")))
  (let ((unique mw2) (many e0)) (lt-edges mw1 params here))
  (let ((unique mw3) (many e1)) (succ-edges mw2 z here e0))
  (let ((unique mw4) (many edges)) (succ-edges mw3 x here e1))
  (let-match many (lt-chain (raw-count edges) edges edges x z here) (Some _ pr)
    ((None _) (macro-fail mw4 here "lt-lemma: no chain of hypotheses reaches the goal")))
  (values mw4 $ one $ form here $ Cons _ (RawSettled here _ _ _ (settled-of many def-fns)) $ two (RawWild here) $ form here $ two header pr))
(let ((many lt-lemma)) (MkMacro _ lt-lemma-fn))
