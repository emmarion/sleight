(def-fns _ $ (many is-head : (unique (MacroWorld) mw) (many (Raw) hd)
    (erased Type T) (erased T t) (many (Settled (MErased) T t) want) -> (unique (MacroWorld) mw2 at mw) (many (Bool) b))
  (let-match many hd (RawSymbol p s) (else (values mw (BFalse))))
  (let ((unique mw1) (many res)) (resolve mw s))
  (let-match many res (RSettled m U v h) (else (values mw1 (BFalse))))
  (let ((unique mw2) (many e)) (settled-eq _ _ _ _ _ _ mw1 (settled-erase _ _ _ h) want))
  (values mw2 $ match many e (((Bool) _)) ((Some _ j) (BTrue)) ((None _) (BFalse))))

(def-adts $ (OrderHead : -> Type)
  enum
  (many HLt : -> (OrderHead))
  (many HLe : -> (OrderHead))
  (many HNe : -> (OrderHead))
  (many HFalse : -> (OrderHead))
  (many HAdd : -> (OrderHead))
  (many HDouble : -> (OrderHead))
  (many HOther : -> (OrderHead)))

(def-fns _ $ (many head-or : (unique (MacroWorld) mw) (many (Raw) hd) (erased Type T) (erased T t) (many (Settled (MErased) T t) want)
    (many (OrderHead) k) (many (OrderHead) found) -> (unique (MacroWorld) mw2 at mw) (many (OrderHead) r))
  (let-match many found (HOther) (else (values mw found)))
  (let ((unique mw1) (many b)) (is-head mw hd _ _ want))
  (values mw1 $ match many b (((OrderHead) _)) ((BTrue) k) ((BFalse) found)))

(def-fns _ $ (many order-head : (unique (MacroWorld) mw) (many (Raw) hd) -> (unique (MacroWorld) mw2 at mw) (many (OrderHead) k))
  (let ((unique mw1) (many k1)) (head-or mw hd _ _ (settled-of erased Lt) (HLt) (HOther)))
  (let ((unique mw2) (many k2)) (head-or mw1 hd _ _ (settled-of erased Le) (HLe) k1))
  (let ((unique mw3) (many k3)) (head-or mw2 hd _ _ (settled-of erased Ne) (HNe) k2))
  (let ((unique mw4) (many k4)) (head-or mw3 hd _ _ (settled-of erased False) (HFalse) k3))
  (let ((unique mw5) (many k5)) (head-or mw4 hd _ _ (settled-of erased Add) (HAdd) k4))
  (head-or mw5 hd _ _ (settled-of erased Double) (HDouble) k5))

(def-fns _ $ (many raw-at : (subterm many (List $ Raw) xs) (many (Nat) i) (many (Pos) p) -> (many (Raw) r))
  (let-match many xs (Cons _ x rest) ((Nil _) (RawWild p)))
  (let-match many i (Succ j) ((Zero) x))
  (tail $ raw-at rest j p))

(def-fns _ $ (many split-arrow : (subterm many (List $ Raw) xs) (many (Pos) p) -> (many (List $ Raw) params) (many (List $ Raw) returns))
  (let-match many xs (Cons _ x rest) ((Nil _) (values (Nil _) (Nil _))))
  (let-match many (same-sym x (name p "->")) (BFalse) ((BTrue) (values (Nil _) rest)))
  (let ((many ps) (many rs)) (notail $ split-arrow rest p))
  (values (Cons _ x ps) rs))

(def-adts $ (Edge : -> Type)
  enum
  (many MkEdge : (many (Raw) from) (many (Nat) p) (many (Nat) q) (many (Raw) proof) (many (Raw) to) -> (Edge)))

(def-fns _ $ (many edge-count : (subterm many (List (Edge)) xs) -> (many (Nat) n))
  (match many xs _ ((Nil _) (Zero)) ((Cons _ h t) (Succ $ notail $ edge-count t))))

(def-fns _ $ (many monus : (subterm many (Nat) a) (many (Nat) b) -> (many (Nat) r))
  (let-match many b (Succ b1) ((Zero) a))
  (let-match many a (Succ a1) ((Zero) (Zero)))
  (tail $ monus a1 b1))

(def-fns _ $ (many wilds : (subterm many (Nat) k) (many (Pos) p) (many (List $ Raw) rest) -> (many (List $ Raw) out))
  (match many k _ ((Zero) rest) ((Succ k1) (Cons _ (RawWild p) $ notail $ wilds k1 p rest))))

(def-fns _ $ (many lemma-app : (many (Pos) p) (erased Type T) (erased T t) (many (Settled (MErased) T t) h)
    (many (Nat) k) (many (List $ Raw) args) -> (many (Raw) r))
  (app p (ref p _ _ _ h) $ wilds k p args))

(def-fns _ $ (many steps : (subterm many (Nat) k) (erased Type T) (erased T t) (many (Settled (MErased) T t) h)
    (many (Raw) proof) (many (Pos) p) -> (many (Raw) r))
  (match many k _
    ((Zero) proof)
    ((Succ k1) (lemma-app p _ _ h 2 $ one $ notail $ steps k1 _ _ h proof p))))

(def-fns _ $ (many peel : (subterm many (Nat) pp) (many (Nat) qq) (many (Raw) proof) (many (Pos) p) ->
    (many (Nat) pp2) (many (Nat) qq2) (many (Raw) proof2))
  (let-match many pp (Succ p1) ((Zero) (values pp qq proof)))
  (let-match many qq (Succ q1) ((Zero) (values pp qq proof)))
  (tail $ peel p1 q1 (steps 1 _ _ (settled-of erased lt-pred) proof p) p))

(def-fns _ $ (many finish : (many (Edge) path) (many (Raw) z) (many (Nat) a) (many (Nat) b) (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many path (MkEdge x pp qq pr y))
  (let-match many (same-raw y z) (BTrue) ((BFalse) (None _)))
  (let-match many (monus (nat-add qq a) (nat-add b pp)) (Zero) (else (None _)))
  (let ((many p1) (many q1) (many pr1)) (peel pp qq pr p))
  (let ((many up)) (monus a p1))
  (Some _ $ steps (monus b (nat-add q1 up)) _ _ (settled-of erased lt-weaken)
    (steps (monus p1 a) _ _ (settled-of erased lt-succ-left) (steps up _ _ (settled-of erased LtS) pr1 p) p) p))

(def-fns _ $ (many seen-raw : (many (Raw) x) (subterm many (List $ Raw) xs) -> (many (Bool) b))
  (let-match many xs (Cons _ y rest) ((Nil _) (BFalse)))
  (let-match many (same-raw x y) (BFalse) ((BTrue) (BTrue)))
  (tail $ seen-raw x rest))

(def-fns _ $ (many extend : (many (Edge) path) (many (Edge) e) (many (List $ Raw) seen) (many (Pos) p) -> (many (Maybe (Edge)) out))
  (let-match many path (MkEdge x pp qq pr y))
  (let-match many e (MkEdge u r t h v))
  (let-match many (same-raw u y) (BTrue) ((BFalse) (None _)))
  (let-match many (seen-raw v seen) (BFalse) ((BTrue) (None _)))
  (Some _ $ MkEdge x (Succ $ nat-add pp r) (nat-add qq t)
    (lemma-app p _ _ (settled-of erased lt-le-trans) 3 $
      two (steps (Succ r) _ _ (settled-of erased LtS) pr p) (steps (Succ qq) _ _ (settled-of erased LtS) h p))
    v))

(def-fns _ $ (many reach : (subterm many (Nat) fuel) (many (List (Edge)) edges) (subterm many (List (Edge)) todo)
    (many (Edge) path) (many (List $ Raw) seen) (many (Raw) z) (many (Nat) a) (many (Nat) b) (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many (finish path z a b p) (None _) ((Some _ r) (Some _ r)))
  (let-match many fuel (Succ f1) ((Zero) (None _)))
  (let-match many todo (Cons _ e rest) ((Nil _) (None _)))
  (let ((many attempt)) (match many (extend path e seen p) (((Maybe $ Raw) _))
    ((None _) (None _))
    ((Some _ path2)
      (let-match many path2 (MkEdge x pp qq pr v))
      (notail $ reach f1 edges edges path2 (Cons _ v seen) z a b p))))
  (match many attempt _ ((Some _ r) (Some _ r)) ((None _) (tail $ reach fuel edges rest path seen z a b p))))

(def-fns _ $ (many decompose : (unique (MacroWorld) mw) (subterm many (Raw) t) -> (unique (MacroWorld) mw2 at mw) (many (Raw) base) (many (Nat) n))
  (let-match many t (RawList tp ts) (else (values mw t (Zero))))
  (let-match many ts (Cons _ hd t1) ((Nil _) (values mw t (Zero))))
  (let-match many t1 (Cons _ x t2) ((Nil _) (values mw t (Zero))))
  (let-match many t2 (Nil _) (else (values mw t (Zero))))
  (let ((unique mw1) (many s)) (is-head mw hd _ _ (settled-of erased Succ)))
  (let-match many s (BTrue) ((BFalse) (values mw1 t (Zero))))
  (let ((unique mw2) (many base) (many n)) (notail $ decompose mw1 x))
  (values mw2 base (Succ n)))

(def-fns _ $ (many hyp-edges : (many (OrderHead) k) (many (List $ Raw) xs) (subterm many (List $ Raw) names) (many (Pos) p)
    (many (List (Edge)) later) -> (many (List (Edge)) out))
  (let-match many names (Cons _ n rest) ((Nil _) later))
  (let ((many more)) (notail $ hyp-edges k xs rest p later))
  (let ((many x) (many y) (many z)) (values (raw-at xs 0 p) (raw-at xs 1 p) (raw-at xs 2 p)))
  (match many k _
    ((HLt) (Cons _ (MkEdge x 0 0 n y) more))
    ((HLe) (Cons _ (MkEdge x 0 1 (lemma-app p _ _ (settled-of erased le-lt) 2 $ one n) y) more))
    ((HAdd)
      (Cons _ (MkEdge x 0 1 (lemma-app p _ _ (settled-of erased add-le-left) 3 $ one n) z) $
        Cons _ (MkEdge y 0 1 (lemma-app p _ _ (settled-of erased add-le-right) 3 $ one n) z) more))
    ((HDouble) (Cons _ (MkEdge x 0 1 (lemma-app p _ _ (settled-of erased double-le) 2 $ one n) y) more))
    (else more)))

(def-fns _ $ (many order-edges : (unique (MacroWorld) mw) (subterm many (List $ Raw) params) (many (Pos) p) ->
    (unique (MacroWorld) mw2 at mw) (many (List (Edge)) out))
  (let-match many params (Cons _ prm rest) ((Nil _) (values mw (Nil _))))
  (let ((unique mw1) (many later)) (notail $ order-edges mw rest p))
  (let-match many prm (RawList pp items) (else (values mw1 later)))
  (let-match many items (Cons _ m i1) ((Nil _) (values mw1 later)))
  (let-match many i1 (Cons _ ty names) ((Nil _) (values mw1 later)))
  (let-match many ty (RawList tp ts) (else (values mw1 later)))
  (let-match many ts (Cons _ hd xs) ((Nil _) (values mw1 later)))
  (let ((unique mw2) (many k)) (order-head mw1 hd))
  (values mw2 $ hyp-edges k xs names p later))

(def-fns _ $ (many norm-edges : (unique (MacroWorld) mw) (subterm many (List (Edge)) es) ->
    (unique (MacroWorld) mw2 at mw) (many (List (Edge)) out))
  (let-match many es (Cons _ e rest) ((Nil _) (values mw (Nil _))))
  (let-match many e (MkEdge x pp qq pr y))
  (let ((unique mw1) (many u) (many i)) (decompose mw x))
  (let ((unique mw2) (many v) (many j)) (decompose mw1 y))
  (let ((unique mw3) (many more)) (notail $ norm-edges mw2 rest))
  (values mw3 $ Cons _ (MkEdge u (nat-add pp i) (nat-add qq j) pr v) more))

(def-fns _ $ (many prove-lt : (many (List (Edge)) edges) (many (Raw) x) (many (Nat) a) (many (Raw) z) (many (Nat) b) (many (Pos) p) ->
    (many (Maybe (Raw)) proof))
  (reach (edge-count edges) edges edges (MkEdge x 0 1 (app p (ref p _ _ _ (settled-of erased lt-succ)) $ one x) x) (one x) z a b p))

(def-fns _ $ (many cycle : (many (List (Edge)) edges) (subterm many (List (Edge)) todo) (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many todo (Cons _ e rest) ((Nil _) (None _)))
  (let-match many e (MkEdge u pp qq pr v))
  (let-match many (reach (edge-count edges) edges edges e (one v) u 0 0 p) (None _) ((Some _ r) (Some _ r)))
  (tail $ cycle edges rest p))

(def-fns _ $ (many lemma-map : (many (Pos) p) (erased Type T) (erased T t) (many (Settled (MErased) T t) h) (many (Nat) k)
    (many (Maybe (Raw)) proof) -> (many (Maybe (Raw)) r))
  (match many proof _ ((Some _ pr) (Some _ $ lemma-app p _ _ h k $ one pr)) ((None _) (None _))))

(def-fns _ $ (many goal-proof : (many (OrderHead) k) (many (List (Edge)) edges) (many (Raw) x) (many (Nat) a) (many (Raw) z) (many (Nat) b)
    (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many k (HNe)
    ((HLt) (prove-lt edges x a z b p))
    ((HLe) (lemma-map p _ _ (settled-of erased MkLe) 2 $ prove-lt edges x a z (Succ b) p))
    ((HFalse) (lemma-map p _ _ (settled-of erased lt-irrefl) 1 $ cycle edges edges p))
    (else (None _)))
  (let-match many (lemma-map p _ _ (settled-of erased NeLt) 2 $ prove-lt edges x a z b p) (None _) ((Some _ pr) (Some _ pr)))
  (lemma-map p _ _ (settled-of erased NeGt) 2 $ prove-lt edges z b x a p))

(def-fns _ $ (many lt-lemma-fn : (unique (MacroWorld) mw) (many (Pos) here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let-match many args (Cons _ header a1) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many header (RawList hp hs) (else (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many hs (Cons _ m h1) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many h1 (Cons _ fname h2) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many h2 (Cons _ colon h3) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let ((many params) (many returns)) (split-arrow h3 here))
  (let-match many returns (Cons _ ret more) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many ret (RawList rp ritems) (else (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many ritems (Cons _ rm r1) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many r1 (Cons _ goal r2) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many goal (RawList gp gs) (else (macro-fail mw here "lt-lemma: the goal is not a relation")))
  (let-match many gs (Cons _ rel g1) ((Nil _) (macro-fail mw here "lt-lemma: the goal is not a relation")))
  (let ((unique mw1) (many k)) (order-head mw rel))
  (let-match many (match many k (((Bool) _)) ((HAdd) (BFalse)) ((HDouble) (BFalse)) ((HOther) (BFalse)) (else (BTrue))) (BTrue)
    ((BFalse) (macro-fail mw1 here "lt-lemma: the goal's head is not the prelude's `Lt` or `False`, or std's `Le` or `Ne`")))
  (let ((unique mw2) (many raw)) (order-edges mw1 params here))
  (let ((unique mw3) (many edges)) (norm-edges mw2 raw))
  (let ((unique mw4) (many x) (many a)) (decompose mw3 (raw-at g1 0 here)))
  (let ((unique mw5) (many z) (many b)) (decompose mw4 (raw-at g1 1 here)))
  (let-match many (goal-proof k edges x a z b here) (Some _ body)
    ((None _) (macro-fail mw5 here "lt-lemma: no chain of hypotheses reaches the goal")))
  (values mw5 $ one $ form here $ Cons _ (RawSettled here _ _ _ (settled-of many def-fns)) $ two (RawWild here) $ form here $ two header body))
(let ((many lt-lemma)) (MkMacro _ lt-lemma-fn))
