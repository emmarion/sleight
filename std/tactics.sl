(def-fns _ $ (many is-head : (unique (MacroWorld) mw) (many (Raw) hd)
    (erased Type T) (erased T t) (many (Settled (MErased) T t) want) -> (unique (MacroWorld) mw2 at mw) (many (Bool) b))
  (let-match many hd (RawSymbol p s) (else (values mw (BFalse))))
  (let ((unique mw1) (many res)) (resolve mw s))
  (let-match many res (RSettled m U v h) (else (values mw1 (BFalse))))
  (let ((unique mw2) (many e)) (settled-eq _ _ _ _ _ _ mw1 (settled-erase _ _ _ h) want))
  (values mw2 $ match many e (((Bool) _)) ((Some _ j) (BTrue)) ((None _) (BFalse))))

(def-fns _ $ (many order-kind : (unique (MacroWorld) mw) (many (Raw) hd) -> (unique (MacroWorld) mw2 at mw) (many (Maybe (Bool)) strict))
  (let ((unique mw1) (many lt)) (is-head mw hd _ _ (settled-of erased Lt)))
  (let-match many lt (BFalse) ((BTrue) (values mw1 (Some _ (BTrue)))))
  (let ((unique mw2) (many le)) (is-head mw1 hd _ _ (settled-of erased Le)))
  (values mw2 $ match many le (((Maybe (Bool)) _)) ((BTrue) (Some _ (BFalse))) ((BFalse) (None _))))

(def-fns _ $ (many split-arrow : (subterm many (List $ Raw) xs) (many (Pos) p) -> (many (List $ Raw) params) (many (List $ Raw) returns))
  (let-match many xs (Cons _ x rest) ((Nil _) (values (Nil _) (Nil _))))
  (let-match many (same-sym x (name p "->")) (BFalse) ((BTrue) (values (Nil _) rest)))
  (let ((many ps) (many rs)) (notail $ split-arrow rest p))
  (values (Cons _ x ps) rs))

(def-adts $ (Edge : -> Type)
  enum
  (many MkEdge : (many (Bool) strict) (many (Raw) proof) (many (Raw) from) (many (Raw) to) -> (Edge)))

(def-fns _ $ (many edge-count : (subterm many (List (Edge)) xs) -> (many (Nat) n))
  (match many xs _ ((Nil _) (Zero)) ((Cons _ h t) (Succ $ notail $ edge-count t))))

(def-fns _ $ (many succ-raw : (many (Pos) p) (many (Raw) x) -> (many (Raw) r))
  (app p (ref p _ _ (settled-of erased Succ)) $ one x))

(def-fns _ $ (many zero-step : (many (Bool) strict) (many (Raw) from) (many (Raw) to) (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many strict (BFalse) ((BTrue) (None _)))
  (let-match many (same-raw from to) (BTrue) ((BFalse) (None _)))
  (Some _ $ app p (ref p _ _ (settled-of erased lt-succ)) $ one from))

(def-fns _ $ (many join : (many (Pos) p) (many (Bool) step-strict) (many (Bool) strict)
    (many (Raw) from) (many (Raw) y) (many (Raw) to) (many (Raw) h) (many (Raw) q) -> (many (Raw) r))
  (let ((many lt-le-trans-raw)) (ref p _ _ (settled-of erased lt-le-trans)))
  (let ((many top)) (match many strict (((Raw) _)) ((BTrue) to) ((BFalse) (succ-raw p to))))
  (let-match many step-strict (BFalse)
    ((BTrue)
      (let ((many lt)) (app p lt-le-trans-raw $ Cons _ from $ Cons _ y $ Cons _ to $ two h q))
      (match many strict _ ((BTrue) lt) ((BFalse) (app p (ref p _ _ (settled-of erased lt-weaken)) $ three from to lt)))))
  (app p lt-le-trans-raw $ Cons _ from $ Cons _ (succ-raw p y) $ Cons _ top $ two h $
    app p (ref p _ _ (settled-of erased LtS)) $ three y top q))

(def-fns _ $ (many reach : (subterm many (Nat) fuel) (many (List (Edge)) edges) (subterm many (List (Edge)) todo)
    (many (Raw) from) (many (Raw) to) (many (Bool) strict) (many (Pos) p) -> (many (Maybe (Raw)) proof))
  (let-match many (zero-step strict from to p) (None _) ((Some _ r) (Some _ r)))
  (let-match many fuel (Succ f1) ((Zero) (None _)))
  (let-match many todo (Cons _ e rest) ((Nil _) (None _)))
  (let ((many next)) (notail $ reach fuel edges rest from to strict p))
  (let-match many e (MkEdge step-strict h x y))
  (let-match many (same-raw x from) (BTrue) ((BFalse) next))
  (let ((many rest-strict)) (match many step-strict (((Bool) _)) ((BTrue) (BFalse)) ((BFalse) strict)))
  (let-match many (notail $ reach f1 edges edges y to rest-strict p) (Some _ q) ((None _) next))
  (Some _ $ join p step-strict strict from y to h q))

(def-fns _ $ (many succ-edges : (unique (MacroWorld) mw) (subterm many (Raw) t) (many (Pos) p) (many (List (Edge)) later) ->
    (unique (MacroWorld) mw2 at mw) (many (List (Edge)) out))
  (let-match many t (RawList tp ts) (else (values mw later)))
  (let-match many ts (Cons _ hd t1) ((Nil _) (values mw later)))
  (let-match many t1 (Cons _ x t2) ((Nil _) (values mw later)))
  (let-match many t2 (Nil _) (else (values mw later)))
  (let ((unique mw1) (many s)) (is-head mw hd _ _ (settled-of erased Succ)))
  (let-match many s (BTrue) ((BFalse) (values mw1 later)))
  (tail $ succ-edges mw1 x p $ Cons _ (MkEdge (BTrue) (app p (ref p _ _ (settled-of erased lt-succ)) $ one x) x t) later))

(def-fns _ $ (many name-edges : (many (Bool) strict) (many (Raw) x) (many (Raw) y) (subterm many (List $ Raw) names) (many (Pos) p)
    (many (List (Edge)) later) -> (many (List (Edge)) out))
  (let-match many names (Cons _ n rest) ((Nil _) later))
  (let ((many proof)) (match many strict (((Raw) _))
    ((BTrue) n)
    ((BFalse) (app p (ref p _ _ (settled-of erased le-lt)) $ three x y n))))
  (Cons _ (MkEdge strict proof x y) $ notail $ name-edges strict x y rest p later))

(def-fns _ $ (many order-edges : (unique (MacroWorld) mw) (subterm many (List $ Raw) params) (many (Pos) p) ->
    (unique (MacroWorld) mw2 at mw) (many (List (Edge)) out))
  (let-match many params (Cons _ prm rest) ((Nil _) (values mw (Nil _))))
  (let ((unique mw1) (many later)) (notail $ order-edges mw rest p))
  (let-match many prm (RawList pp items) (else (values mw1 later)))
  (let-match many items (Cons _ m i1) ((Nil _) (values mw1 later)))
  (let-match many i1 (Cons _ ty names) ((Nil _) (values mw1 later)))
  (let-match many ty (RawList tp ts) (else (values mw1 later)))
  (let-match many ts (Cons _ hd t1) ((Nil _) (values mw1 later)))
  (let-match many t1 (Cons _ x t2) ((Nil _) (values mw1 later)))
  (let-match many t2 (Cons _ y t3) ((Nil _) (values mw1 later)))
  (let-match many t3 (Nil _) (else (values mw1 later)))
  (let ((unique mw2) (many k)) (order-kind mw1 hd))
  (let-match many k (Some _ strict) ((None _) (values mw2 later)))
  (let ((unique mw3) (many l1)) (succ-edges mw2 y p (name-edges strict x y names p later)))
  (succ-edges mw3 x p l1))

(def-fns _ $ (many lt-lemma-fn : (unique (MacroWorld) mw) (many (Pos) here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let-match many args (Cons _ header a1) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many header (RawList hp hs) (else (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many hs (Cons _ m h1) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many h1 (Cons _ fname h2) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let-match many h2 (Cons _ colon h3) ((Nil _) (macro-fail mw here "lt-lemma: expected a signature")))
  (let ((many params) (many returns)) (split-arrow h3 here))
  (let-match many returns (Cons _ ret more) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many ret (RawList rp ritems) (else (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many ritems (Cons _ rm r1) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many r1 (Cons _ goal r2) ((Nil _) (macro-fail mw here "lt-lemma: expected one return")))
  (let-match many goal (RawList gp gs) (else (macro-fail mw here "lt-lemma: the goal is (Lt x z) or (Le x z)")))
  (let-match many gs (Cons _ rel g1) ((Nil _) (macro-fail mw here "lt-lemma: the goal is (Lt x z) or (Le x z)")))
  (let-match many g1 (Cons _ x g2) ((Nil _) (macro-fail mw here "lt-lemma: the goal is (Lt x z) or (Le x z)")))
  (let-match many g2 (Cons _ z g3) ((Nil _) (macro-fail mw here "lt-lemma: the goal is (Lt x z) or (Le x z)")))
  (let ((unique mw1) (many gk)) (order-kind mw rel))
  (let-match many gk (Some _ strict)
    ((None _) (macro-fail mw1 here "lt-lemma: the goal's head is neither the prelude's `Lt` nor std's `Le`")))
  (let ((unique mw2) (many e0)) (order-edges mw1 params here))
  (let ((unique mw3) (many e1)) (succ-edges mw2 z here e0))
  (let ((unique mw4) (many edges)) (succ-edges mw3 x here e1))
  (let-match many (reach (edge-count edges) edges edges x z strict here) (Some _ pr)
    ((None _) (macro-fail mw4 here "lt-lemma: no chain of hypotheses reaches the goal")))
  (let ((many body)) (match many strict (((Raw) _))
    ((BTrue) pr)
    ((BFalse) (app here (ref here _ _ (settled-of erased MkLe)) $ three x z pr))))
  (values mw4 $ one $ form here $ Cons _ (RawSettled here _ _ _ (settled-of many def-fns)) $ two (RawWild here) $ form here $ two header body))
(let ((many lt-lemma)) (MkMacro _ lt-lemma-fn))
