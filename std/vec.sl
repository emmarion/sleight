(def-adts
  ((Snoc : (Type A) ((List A) xs) (A x) ((List A) ys) -> Type)
    enum
    (many SnocNil : (erased Type A) (erased A x) -> (Snoc A (Nil A) x (Cons A x (Nil A))))
    (many SnocCons : (erased Type A) (erased A y) (erased (List A) xs) (erased A x) (erased (List A) ys)
       (erased (Snoc A xs x ys) p) -> (Snoc A (Cons A y xs) x (Cons A y ys)))))

(def-adts
  ((Vec--Spare : (Type A) ((List (MaybeUninit (USlotItem A))) us) -> Type)
    enum
    (many Vec--SpareNil : (erased Type A) -> (Vec--Spare A (Nil (MaybeUninit (USlotItem A)))))
    (many Vec--SpareVacant : (erased Type A) (erased (List (MaybeUninit (USlotItem A))) us) (erased (Vec--Spare A us) p)
       -> (Vec--Spare A (Cons (MaybeUninit (USlotItem A)) (Vacant (USlotItem A) vacant-slot) us)))
    (many Vec--SpareStale : (erased Type A) (erased (Slot) s) (erased (USlotItem A) w) (erased (Placed s (USlotItem A) w) q)
       (erased (List (MaybeUninit (USlotItem A))) us) (erased (Vec--Spare A us) p)
       -> (Vec--Spare A (Cons (MaybeUninit (USlotItem A)) (Stale (USlotItem A) s w q) us)))))

(def-adts
  ((Vec--Filled : (Type A) ((List A) xs) ((List (MaybeUninit (USlotItem A))) ms) -> Type)
    enum
    (many Vec--FilledSpare : (erased Type A) (erased (List (MaybeUninit (USlotItem A))) us) (erased (Vec--Spare A us) p)
       -> (Vec--Filled A (Nil A) us))
    (many Vec--FilledCons : (erased Type A) (erased (Slot) s) (erased A x) (erased (Placed s A x) pl)
       (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms) (erased (Vec--Filled A xs ms) p)
       -> (Vec--Filled A (Cons A x xs) (Cons (MaybeUninit (USlotItem A)) (Init (USlotItem A) (MkUSlotItem A s x pl)) ms)))))

(def-adts
  ((Vec--Lent : (Type A) ((List A) xs) ((Nat) i) ((Slot) s) ((List (MaybeUninit (USlotItem A))) ms) -> Type)
    enum
    (many Vec--LentHere : (erased Type A) (erased (Slot) s) (erased (USlotItem A) w) (erased (Placed s (USlotItem A) w) q)
       (erased A x) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms) (erased (Vec--Filled A xs ms) f)
       -> (Vec--Lent A (Cons A x xs) (Zero) s (Cons (MaybeUninit (USlotItem A)) (Stale (USlotItem A) s w q) ms)))
    (many Vec--LentThere : (erased Type A) (erased (Slot) s0) (erased A x) (erased (Placed s0 A x) pl)
       (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms) (erased (Nat) i) (erased (Slot) s)
       (erased (Vec--Lent A xs i s ms) r)
       -> (Vec--Lent A (Cons A x xs) (Succ i) s (Cons (MaybeUninit (USlotItem A)) (Init (USlotItem A) (MkUSlotItem A s0 x pl)) ms)))))

(def-adts $ (Vec--Hdr : (Type A) ((List (MaybeUninit (USlotItem A))) ms) ((Nat) n) -> Type)
  enum
  (many Vec--MkHdr : (erased Type A) (erased (List (MaybeUninit (USlotItem A))) ms) (many (Nat) len)
     (unique (Array (MaybeUninit (USlotItem A)) ms) buf) -> (Vec--Hdr A ms len)))

(def-adts $ (Vec : (Type A) ((List A) xs) -> Type)
  enum newtype
  (many MkVec : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms) (erased (Nat) n)
     (erased (Length A xs n) l) (unique (Vec--Hdr A ms n) h) (erased (Vec--Filled A xs ms) f) -> (Vec A xs)))

(def-adts $ (VecLent : (Type A) ((List A) xs) ((Nat) i) ((Slot) s) -> Type)
  enum newtype
  (many MkVecLent : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased (Slot) s)
     (erased (List (MaybeUninit (USlotItem A))) ms) (erased (Nat) n)
     (erased (Length A xs n) l) (unique (Vec--Hdr A ms n) h) (erased (Vec--Lent A xs i s ms) r) -> (VecLent A xs i s)))

(def-adts
  ((VecPop : (Type A) ((List A) xs) ((List A) ys) -> Type)
    enum
    (many PopEmpty : (erased Type A) -> (VecPop A (Nil A) (Nil A)))
    (many Popped : (erased Type A) (erased (List A) xs) (erased (List A) ys) (unique A x) (erased (Snoc A ys x xs) p)
       -> (VecPop A xs ys))))

(def-fns _ $ (erased vec--snoc-length : (erased Type A) (erased (List A) xs) (erased A x) (erased (List A) ys) (erased (Nat) n)
    (subterm erased (Snoc A xs x ys) s) (erased (Length A xs n) l) -> (erased (Length A ys (Succ n)) l2))
  (let-match erased s (SnocCons _ y xs1 _ ys1 s1)
    ((SnocNil _ _) (let-match erased l (LengthNil _)) (LengthCons _ x (Nil A) (Zero) (LengthNil _))))
  (let-match erased l (LengthCons _ _ _ n1 l1))
  (LengthCons _ y ys1 (Succ n1) (vec--snoc-length _ xs1 x ys1 n1 s1 l1)))

(def-fns _ $ (erased vec--snoc-last : (erased Type A) (erased (List A) xs) (erased (Nat) k)
    (subterm erased (Length A xs (Succ k)) p) ->
    (erased (List A) ys) (erased A x) (erased (Snoc A ys x xs) s) (erased (Nth A xs k x) n) (erased (Length A ys k) l))
  (let-match erased p (LengthCons _ y rest _ p1))
  (let-match erased k (Succ k1)
    ((Zero) (let-match erased p1 (LengthNil _)) (values (Nil A) y (SnocNil _ y) (NthHere _ y _) (LengthNil _))))
  (let ((erased ys1) (erased x) (erased s1) (erased n1) (erased l1)) (vec--snoc-last _ rest k1 p1))
  (values (Cons A y ys1) x (SnocCons _ y ys1 x rest s1) (NthThere _ y rest k1 x n1) (LengthCons _ y ys1 k1 l1)))

(def-fns _ $ (erased vec--splice-length : (erased Type A) (erased (List A) xs ys zs) (erased (Nat) i n c)
    (subterm erased (Splice A xs i n ys zs) p) (erased (Length A xs c) l) -> (erased (Length A zs c) l2))
  (match erased p _
    ((SpliceNil _ _) l)
    ((SpliceHere _ _ y xs1 n1 ys1 zs1 p1)
      (let-match erased l (LengthCons _ _ _ c1 l1))
      (LengthCons _ y zs1 c1 (vec--splice-length _ xs1 ys1 zs1 (Zero) n1 c1 p1 l1)))
    ((SpliceThere _ x xs1 i1 _ _ zs1 p1)
      (let-match erased l (LengthCons _ _ _ c1 l1))
      (LengthCons _ x zs1 c1 (vec--splice-length _ xs1 ys zs1 i1 n c1 p1 l1)))))

(def-fns _ $ (erased vec--repeat-spare : (erased Type A) (erased (Nat) n) (erased (List (MaybeUninit (USlotItem A))) us)
    (subterm erased (Repeat (MaybeUninit (USlotItem A)) n (Vacant (USlotItem A) vacant-slot) us) p) -> (erased (Vec--Spare A us) sp))
  (let-match erased p (RepeatCons _ k _ rest p1) ((RepeatNil _ _) (Vec--SpareNil _)))
  (Vec--SpareVacant _ rest (vec--repeat-spare _ k rest p1)))

(def-fns _ $ (erased vec--spare-rest : (erased Type A) (erased (MaybeUninit (USlotItem A)) m) (erased (List (MaybeUninit (USlotItem A))) us)
    (erased (Vec--Spare A (Cons (MaybeUninit (USlotItem A)) m us)) sp) -> (erased (Vec--Spare A us) sp1))
  (match erased sp _
    ((Vec--SpareVacant _ _ sp1) sp1)
    ((Vec--SpareStale _ _ _ _ _ sp1) sp1)))

(def-fns _ $ (erased vec--filled-le : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms)
    (erased (Nat) n c) (subterm erased (Vec--Filled A xs ms) f) (erased (Length A xs n) l) (erased (Length _ ms c) lc) ->
    (erased (Lt n (Succ c)) lt))
  (let-match erased f (Vec--FilledCons _ _ _ _ xs1 ms1 f1)
    ((Vec--FilledSpare _ _ _) (let-match erased l (LengthNil _)) (LtZ c)))
  (let-match erased l (LengthCons _ _ _ n1 l1))
  (let-match erased lc (LengthCons _ _ _ c1 lc1))
  (LtS n1 (Succ c1) (vec--filled-le _ xs1 ms1 n1 c1 f1 l1 lc1)))

(def-fns _ $ (erased vec--filled-nth : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms)
    (erased (Nat) i) (erased A x) (erased (Vec--Filled A xs ms) f) (subterm erased (Nth A xs i x) n) ->
    (erased (Slot) s) (erased (Placed s A x) pl)
    (erased (Nth (MaybeUninit (USlotItem A)) ms i (Init (USlotItem A) (MkUSlotItem A s x pl))) q))
  (let-match erased f (Vec--FilledCons _ s0 _ pl0 xs1 ms1 f1) (absurd (Vec--FilledSpare _ _ _) n))
  (let-match erased n (NthThere _ _ _ i1 _ n1) ((NthHere _ _ _) (values s0 pl0 (NthHere _ _ ms1))))
  (let ((erased s1) (erased pl1) (erased q1)) (vec--filled-nth _ xs1 ms1 i1 x f1 n1))
  (values s1 pl1 (NthThere _ _ ms1 i1 _ q1)))

(def-fns _ $ (erased vec--filled-set : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms ms2)
    (erased (Nat) i) (erased A old) (erased (Slot) s) (erased A x) (erased (Placed s A x) pl)
    (erased (Vec--Filled A xs ms) f) (subterm erased (Nth A xs i old) n)
    (erased (SetNth (MaybeUninit (USlotItem A)) ms i (Init (USlotItem A) (MkUSlotItem A s x pl)) ms2) e) ->
    (erased (List A) ys) (erased (SetNth A xs i x ys) p) (erased (Vec--Filled A ys ms2) f2))
  (let-match erased f (Vec--FilledCons _ s0 y pl0 xs1 ms1 f1) (absurd (Vec--FilledSpare _ _ _) n))
  (let-match erased n (NthThere _ _ _ i1 _ n1)
    ((NthHere _ _ _)
      (let-match erased e (SetHere _ _ _ _))
      (values (Cons A x xs1) (SetHere _ _ _ _) (Vec--FilledCons _ s x pl xs1 ms1 f1))))
  (let-match erased e (SetThere _ _ _ _ _ ms3 e1))
  (let ((erased ys1) (erased p1) (erased f3)) (vec--filled-set _ xs1 ms1 ms3 i1 old s x pl f1 n1 e1))
  (values (Cons A y ys1) (SetThere _ _ _ _ _ _ p1) (Vec--FilledCons _ s0 y pl0 ys1 ms3 f3)))

(def-fns _ $ (erased vec--filled-snoc : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms ms2)
    (erased (Nat) n) (erased (Slot) s) (erased A x) (erased (Placed s A x) pl)
    (subterm erased (Vec--Filled A xs ms) f) (erased (Length A xs n) l)
    (erased (SetNth (MaybeUninit (USlotItem A)) ms n (Init (USlotItem A) (MkUSlotItem A s x pl)) ms2) e) ->
    (erased (List A) ys) (erased (Snoc A xs x ys) sn) (erased (Vec--Filled A ys ms2) f2))
  (let-match erased f (Vec--FilledCons _ s0 y pl0 xs1 ms1 f1)
    ((Vec--FilledSpare _ _ sp)
      (let-match erased l (LengthNil _))
      (let-match erased e (SetHere _ _ _ us))
      (values (Cons A x (Nil A)) (SnocNil _ x) (Vec--FilledCons _ s x pl _ us (Vec--FilledSpare _ us (vec--spare-rest _ _ _ sp))))))
  (let-match erased l (LengthCons _ _ _ n1 l1))
  (let-match erased e (SetThere _ _ _ _ _ ms3 e1))
  (let ((erased ys1) (erased sn1) (erased f3)) (vec--filled-snoc _ xs1 ms1 ms3 n1 s x pl f1 l1 e1))
  (values (Cons A y ys1) (SnocCons _ y xs1 x ys1 sn1) (Vec--FilledCons _ s0 y pl0 ys1 ms3 f3)))

(def-fns _ $ (erased vec--filled-unsnoc : (erased Type A) (erased (List A) xs ys) (erased A x)
    (erased (List (MaybeUninit (USlotItem A))) ms ms2) (erased (Nat) k)
    (erased (Slot) s) (erased (USlotItem A) w) (erased (Placed s (USlotItem A) w) q)
    (erased (Vec--Filled A xs ms) f) (subterm erased (Snoc A ys x xs) sn) (erased (Length A ys k) l)
    (erased (SetNth (MaybeUninit (USlotItem A)) ms k (Stale (USlotItem A) s w q) ms2) e) -> (erased (Vec--Filled A ys ms2) f2))
  (let-match erased f (Vec--FilledCons _ s0 _ pl0 xs1 ms1 f1) (absurd (Vec--FilledSpare _ _ _) sn))
  (let-match erased sn (SnocCons _ y ys1 _ _ sn1)
    ((SnocNil _ _)
      (let-match erased l (LengthNil _))
      (let-match erased e (SetHere _ _ _ _))
      (let-match erased f1 (Vec--FilledSpare _ _ sp))
      (Vec--FilledSpare _ _ (Vec--SpareStale _ s w q _ sp))))
  (let-match erased l (LengthCons _ _ _ k1 l1))
  (let-match erased e (SetThere _ _ _ _ _ ms3 e1))
  (Vec--FilledCons _ s0 y pl0 ys1 ms3 (vec--filled-unsnoc _ xs1 ys1 x ms1 ms3 k1 s w q f1 sn1 l1 e1)))

(def-fns _ $ (erased vec--filled-prefix : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms)
    (erased (Nat) n) (erased (Length A xs n) l) (subterm erased (Vec--Filled A xs ms) f) ->
    (erased (List (MaybeUninit (USlotItem A))) ys) (erased (Splice _ ms (Zero) n ys ms) p))
  (let-match erased f (Vec--FilledCons _ s x pl xs1 ms1 f1)
    ((Vec--FilledSpare _ _ _) (let-match erased l (LengthNil _)) (values (Nil _) (SpliceNil _ _))))
  (let-match erased l (LengthCons _ _ _ n1 l1))
  (let ((erased ys1) (erased p1)) (vec--filled-prefix _ xs1 ms1 n1 l1 f1))
  (values (Cons _ (Init _ (MkUSlotItem A s x pl)) ys1) (SpliceHere _ _ _ _ _ _ _ p1)))

(def-fns _ $ (erased vec--refill : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms ys ds zs)
    (erased (Nat) n) (erased (Length A xs n) l) (subterm erased (Vec--Filled A xs ms) f)
    (erased (Splice _ ms (Zero) n ys ms) from) (erased (Vec--Spare A ds) sp) (erased (Splice _ ds (Zero) n ys zs) to) ->
    (erased (Vec--Filled A xs zs) f2))
  (let-match erased f (Vec--FilledCons _ s x pl xs1 ms1 f1)
    ((Vec--FilledSpare _ _ _)
      (let-match erased l (LengthNil _))
      (let-match erased to (SpliceNil _ _))
      (Vec--FilledSpare _ _ sp)))
  (let-match erased l (LengthCons _ _ _ n1 l1))
  (let-match erased from (SpliceHere _ _ _ _ _ ys1 _ from1))
  (let-match erased to (SpliceHere _ _ _ ds1 _ _ zs1 to1))
  (Vec--FilledCons _ s x pl xs1 zs1 (vec--refill _ xs1 ms1 ys1 ds1 zs1 n1 l1 f1 from1 (vec--spare-rest _ _ _ sp) to1)))

(def-fns _ $ (many vec--max : (many (Nat) a) (many (Nat) b) -> (many (Nat) c) (erased (Lt a (Succ c)) p) (erased (Lt b (Succ c)) q))
  (let ((many o)) (nat-cmp a b))
  (match many o _
    ((CLt _ _ _ _ lt) (values b (lt-weaken a b lt) (lt-succ b)))
    ((CEq _ _ _) (values a (lt-succ a) (lt-succ a)))
    ((CGt _ _ _ _ gt) (values a (lt-succ a) (lt-weaken b a gt)))))

(def-fns _ $ (many vec--next-cap : (many (Nat) cap) (many (Nat) req) -> (many (Nat) c2) (erased (Lt req (Succ c2)) le))
  (let ((many d) (erased _)) (add cap cap))
  (let ((many m) (erased le1) (erased _)) (vec--max req d))
  (let ((many c2) (erased le2) (erased _)) (vec--max m (Succ $ Succ $ Succ $ Succ $ Zero)))
  (values c2 (lt-le-trans req (Succ m) (Succ c2) le1 (LtS m (Succ c2) le2))))

(def-fns _ $ (many vec--room : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms)
    (many (Nat) len) (erased (Length A xs len) l) (unique (Array (MaybeUninit (USlotItem A)) ms) buf) (erased (Vec--Filled A xs ms) f)
    (erased (Slot) sl) (unique (Cell Vec--MkHdr sl (slot-of buf)) u) (many (Nat) req) ->
    (erased (List (MaybeUninit (USlotItem A))) ms2) (erased (Nat) cap) (erased (Length _ ms2 cap) lc)
    (unique (Array (MaybeUninit (USlotItem A)) ms2) buf2) (unique (Cell Vec--MkHdr sl (slot-of buf2)) u2 at u)
    (erased (Vec--Filled A xs ms2) f2) (erased (Lt req (Succ cap)) le))
  (let ((many cap) (erased lc) (unique buf1)) (array-length _ _ buf))
  (let ((many c)) (nat-cmp req cap))
  (let-match many c (CGt _ _ _ _ lt)
    ((CLt _ _ _ _ gt) (values ms cap lc buf1 u f (lt-weaken req cap gt)))
    ((CEq _ _ _) (values ms cap lc buf1 u f (lt-succ cap))))
  (let ((many c2) (erased le)) (vec--next-cap cap req))
  (let ((erased lr)) (lt-le-trans len (Succ cap) req (vec--filled-le _ _ _ len cap f l lc) (LtS cap req lt)))
  (let ((erased ds) (unique nb) (erased rp)) (array-new (USlotItem A) c2))
  (let ((erased dl)) (repeat-length _ _ _ _ rp))
  (let ((erased ys) (erased from)) (vec--filled-prefix _ _ _ len l f))
  (let ((erased _) (erased to)) (splice-range _ ds c2 dl (Zero) len len (AddZero len) (lt-weaken len c2 (lt-le-trans len req c2 lr le))))
  (let ((erased zs) (erased _) (erased _) (unique nb2) (unique _) (erased p) (erased _) (erased _))
    (array-move _ _ _ _ _ buf1 (Zero) nb (Zero) len from to))
  (values zs c2 (vec--splice-length _ ds ys zs (Zero) len c2 p dl) nb2 (cell-write unique u (Vec--MkHdr _ (slot-of nb2)))
          (vec--refill _ _ ms ys ds zs len l f from (vec--repeat-spare _ _ _ rp) p) le))

(def-fns _ $ (erased vec--lent : (erased Type A) (erased (List A) xs) (erased (List (MaybeUninit (USlotItem A))) ms ms2)
    (erased (Nat) i) (erased A x) (erased (Slot) s) (erased (USlotItem A) w) (erased (Placed s (USlotItem A) w) q)
    (erased (Vec--Filled A xs ms) f) (subterm erased (Nth A xs i x) n)
    (erased (SetNth (MaybeUninit (USlotItem A)) ms i (Stale (USlotItem A) s w q) ms2) e) -> (erased (Vec--Lent A xs i s ms2) r))
  (let-match erased f (Vec--FilledCons _ s0 y pl0 xs1 ms1 f1) (absurd (Vec--FilledSpare _ _ _) n))
  (let-match erased n (NthThere _ _ _ i1 _ n1)
    ((NthHere _ _ _) (let-match erased e (SetHere _ _ _ _)) (Vec--LentHere _ s w q y xs1 ms1 f1)))
  (let-match erased e (SetThere _ _ _ _ _ ms3 e1))
  (Vec--LentThere _ s0 y pl0 xs1 ms3 i1 s (vec--lent _ xs1 ms1 ms3 i1 x s w q f1 n1 e1)))

(def-fns _ $ (erased vec--lent-nth : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased (Slot) s)
    (erased (List (MaybeUninit (USlotItem A))) ms) (subterm erased (Vec--Lent A xs i s ms) r) ->
    (erased (USlotItem A) w) (erased (Placed s (USlotItem A) w) q)
    (erased (Nth (MaybeUninit (USlotItem A)) ms i (Stale (USlotItem A) s w q)) n))
  (let-match erased r (Vec--LentThere _ _ _ _ xs1 ms1 i1 _ r1)
    ((Vec--LentHere _ _ w q _ _ ms1 _) (values w q (NthHere _ _ ms1))))
  (let ((erased w) (erased q) (erased n1)) (vec--lent-nth _ xs1 i1 s ms1 r1))
  (values w q (NthThere _ _ ms1 i1 _ n1)))

(def-fns _ $ (erased vec--unlent : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased (Slot) s)
    (erased (List (MaybeUninit (USlotItem A))) ms ms2) (erased A y) (erased (Placed s A y) pl)
    (subterm erased (Vec--Lent A xs i s ms) r)
    (erased (SetNth (MaybeUninit (USlotItem A)) ms i (Init (USlotItem A) (MkUSlotItem A s y pl)) ms2) e) ->
    (erased (List A) ys) (erased (SetNth A xs i y ys) p) (erased (Vec--Filled A ys ms2) f))
  (let-match erased r (Vec--LentThere _ s0 x pl0 xs1 ms1 i1 _ r1)
    ((Vec--LentHere _ _ _ _ x xs1 ms1 f1)
      (let-match erased e (SetHere _ _ _ _))
      (values (Cons A y xs1) (SetHere _ x y xs1) (Vec--FilledCons _ s y pl xs1 ms1 f1))))
  (let-match erased e (SetThere _ _ _ _ _ ms3 e1))
  (let ((erased ys1) (erased p1) (erased f1)) (vec--unlent _ xs1 i1 s ms1 ms3 y pl r1 e1))
  (values (Cons A x ys1) (SetThere _ x xs1 i1 y ys1 p1) (Vec--FilledCons _ s0 x pl0 ys1 ms3 f1)))

(def-fns _ $ (many vec-with-capacity : (erased Type A) (many (Nat) n) -> (unique (Vec A (Nil A)) v))
  (let ((erased _) (unique buf) (erased rp)) (array-new (USlotItem A) n))
  (MkVec _ _ _ _ (LengthNil _) (Vec--MkHdr _ _ (Zero) buf) (Vec--FilledSpare _ _ (vec--repeat-spare _ _ _ rp))))

(def-fns _ $ (many vec-new : (erased Type A) -> (unique (Vec A (Nil A)) v))
  (vec-with-capacity A (Zero)))

(def-fns _ $ (many vec-len : (erased Type A) (erased (List A) xs) (unique (Vec A xs) v) ->
    (many (Nat) n) (erased (Length A xs n) p) (unique v is w at v))
  (let-match unique v (MkVec _ _ _ _ l h f))
  (let-match unique h (Vec--MkHdr _ _ len buf u))
  (values len l (MkVec _ _ _ _ l (at unique (u _ _ len buf)) f)))

(def-fns _ $ (many vec-len-many : (erased Type A) (erased (List A) xs) (many (Vec A xs) v) ->
    (many (Nat) n) (erased (Length A xs n) p))
  (let-match many v (MkVec _ _ _ _ l h _))
  (let-match many h (Vec--MkHdr _ _ len _))
  (values len l))

(def-fns _ $ (many vec-capacity : (erased Type A) (erased (List A) xs) (unique (Vec A xs) v) ->
    (many (Nat) n) (unique v is w at v))
  (let-match unique v (MkVec _ _ _ _ l h f))
  (let-match unique h (Vec--MkHdr _ _ len buf u))
  (let ((many cap) (erased _) (unique buf1)) (array-length _ _ buf))
  (values cap (MkVec _ _ _ _ l (at unique (u _ _ len buf1)) f)))

