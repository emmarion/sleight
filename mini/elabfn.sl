(def-fns _ $ (erased sc-abstract : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Ctx) ctx) (erased (Nat) m) (erased (Term) t) (erased (Term) u) (erased (Cov ctx0 acc ctx m) c) (erased (Sc ctx (Zero) t) st)
    (erased (Abstract acc t u) ab) -> (erased (Sc ctx0 m u) su))
  (let-match erased c (MkCov n0 _ e0 _ _ _ _ _ _ e1 _ _ _ _ _ _ _ cv ly))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
  (MkSc _ _ _ _ _ _ _ _ u (abstract-covers n0 e0 acc e1 (Zero) m t u cv ly sct ab)))

; The binders a telescope's ids become cover the same entries as the accumulated ids do, innermost first.
(def-adts
  ((CoversRev : ((Nat) n0) ((List (Ent)) e0) ((List (Maybe (Nat))) acc) ((List (Nat)) ids) ((List (Ent)) e1) -> Type)
    enum
    (many CvRNil : (erased (Nat) n0) (erased (List (Ent)) e0) (erased (List (Maybe (Nat))) acc) (erased (List (Ent)) e1) (erased (Covers n0 e0 acc e1) c) -> (CoversRev n0 e0 acc (Nil (Nat)) e1))
    (many CvRCons : (erased (Nat) n0) (erased (List (Ent)) e0) (erased (List (Maybe (Nat))) acc) (erased (Nat) x) (erased (List (Nat)) ids) (erased (List (Ent)) e1)
       (erased (CoversRev n0 e0 (Cons (Maybe (Nat)) (Some (Nat) x) acc) ids e1) c) -> (CoversRev n0 e0 acc (Cons (Nat) x ids) e1)))
  ((CovRev : ((Ctx) ctx0) ((List (Maybe (Nat))) acc) ((List (Nat)) ids) ((Ctx) ctx1) -> Type)
    enum
    (many MkCovRev : (erased (Nat) n0) (erased (List (Name)) s0) (erased (List (Ent)) e0) (erased (List (Rule)) r0) (erased (List (Adt)) a0) (erased (Maybe (Term)) l0) (erased (List (Term)) sa0)
       (erased (Nat) n1) (erased (List (Name)) s1) (erased (List (Ent)) e1) (erased (List (Rule)) r1) (erased (List (Adt)) a1) (erased (Maybe (Term)) l1) (erased (List (Term)) sa1)
       (erased (List (Maybe (Nat))) acc) (erased (List (Nat)) ids) (erased (Lt n0 (Succ n1)) le) (erased (CoversRev n0 e0 acc ids e1) c) -> (CovRev (MkCtx n0 s0 e0 r0 a0 l0 sa0) acc ids (MkCtx n1 s1 e1 r1 a1 l1 sa1))))
  ((Cat : ((List (Maybe (Nat))) xs) ((List (Maybe (Nat))) ys) ((List (Maybe (Nat))) out) -> Type)
    enum
    (many CatNil : (erased (List (Maybe (Nat))) ys) -> (Cat (Nil (Maybe (Nat))) ys ys))
    (many CatCons : (erased (Maybe (Nat)) x) (erased (List (Maybe (Nat))) xs) (erased (List (Maybe (Nat))) ys) (erased (List (Maybe (Nat))) out) (erased (Cat xs ys out) p)
       -> (Cat (Cons (Maybe (Nat)) x xs) ys (Cons (Maybe (Nat)) x out)))))
(def-fns _ $ (erased cat-nil : (subterm erased (List (Maybe (Nat))) xs) -> (erased (Cat xs (Nil (Maybe (Nat))) xs) p))
  (match erased xs _
    ((Nil _) (CatNil (Nil _)))
    ((Cons _ x rest) (CatCons x rest (Nil _) rest (cat-nil rest)))))
(def-fns _ $ (erased snoc-cat : (erased (List (Maybe (Nat))) b2) (erased (Maybe (Nat)) y) (erased (List (Maybe (Nat))) b) (erased (List (Maybe (Nat))) acc) (erased (List (Maybe (Nat))) out) (subterm erased (SnocId b2 y b) sn)
    (erased (Cat b acc out) ct) -> (erased (Cat b2 (Cons (Maybe (Nat)) y acc) out) r))
  (match erased sn _
    ((SnocIdNil _)
      (let-match erased ct (CatCons _ _ _ _ q))
      (match erased q _ ((CatNil _) (CatNil (Cons _ y acc)))))
    ((SnocIdCons z zs _ b3 p) (match erased ct _ ((CatCons _ _ _ out2 q) (CatCons z zs (Cons _ y acc) out2 (snoc-cat zs y b3 acc out2 p q)))))))
(def-fns _ $ (erased covers-rev-binders : (erased (Nat) n0) (erased (List (Ent)) e0) (erased (List (Maybe (Nat))) acc) (erased (List (Nat)) ids) (erased (List (Ent)) e1) (erased (List (Maybe (Nat))) b) (erased (List (Maybe (Nat))) out)
    (subterm erased (CoversRev n0 e0 acc ids e1) cr) (erased (Binders ids b) bd) (erased (Cat b acc out) ct) -> (erased (Covers n0 e0 out e1) c))
  (let-match erased cr (CvRCons _ _ _ x ids2 _ cr2)
    ((CvRNil _ _ _ _ c2)
      (let-match erased bd (BindersNil))
      (match erased ct _ ((CatNil _) c2))))
  (match erased bd _
    ((BindersCons _ _ b2 _ bd2 sn) (covers-rev-binders n0 e0 (Cons _ (Some _ x) acc) ids2 e1 b2 out cr2 bd2 (snoc-cat b2 (Some _ x) b acc out sn ct)))))
(def-fns _ $ (erased len-eq-length-r : (erased Type A) (erased Type B) (erased (List A) xs) (erased (List B) ys) (erased (Nat) m) (subterm erased (LenEq A B xs ys) le) (erased (Length A xs m) ln) -> (erased (Length B ys m) q))
  (match erased le _
    ((LENil _ _) (match erased ln _ ((LengthNil _) (LengthNil _))))
    ((LECons _ _ _ y xs2 ys2 p) (match erased ln _ ((LengthCons _ _ _ m2 l2) (LengthCons _ y ys2 m2 (len-eq-length-r _ _ xs2 ys2 m2 p l2)))))))
(def-fns _ $ (erased snocid-layout : (erased (List (Maybe (Nat))) xs) (erased (Nat) x) (erased (List (Maybe (Nat))) out) (erased (Nat) m) (subterm erased (SnocId xs (Some (Nat) x) out) sn) (erased (Layout (Nat) xs (Zero) m) ly) ->
    (erased (Layout (Nat) out (Zero) (Succ m)) q))
  (match erased sn _
    ((SnocIdNil _) (match erased ly _ ((LayNil _) (LaySome _ x (Nil _) (Zero) (LayNil _)))))
    ((SnocIdCons _ ys _ out2 p) (match erased ly _ ((LaySome _ y0 _ m2 l2) (LaySome _ y0 out2 (Succ m2) (snocid-layout ys x out2 m2 p l2)))))))
(def-fns _ $ (erased binders-layout : (erased (List (Nat)) ids) (erased (List (Maybe (Nat))) b) (erased (Nat) m) (subterm erased (Binders ids b) bd) (erased (Length (Nat) ids m) ln) -> (erased (Layout (Nat) b (Zero) m) q))
  (match erased bd _
    ((BindersNil) (match erased ln _ ((LengthNil _) (LayNil _))))
    ((BindersCons x ids2 acc out p sn) (match erased ln _ ((LengthCons _ _ _ m2 l2) (snocid-layout acc x out m2 sn (binders-layout ids2 acc m2 p l2)))))))
(def-fns _ $ (erased tele-ids-length : (erased (Ctx) ctx) (erased (List (Entry)) pt) (erased (List (Nat)) ids) (erased (Nat) m) (erased (ScT ctx (Zero) pt m) spt) (erased (LenEq (Entry) (Nat) pt ids) li) -> (erased (Length (Nat) ids m) ln))
  (let-match erased spt (MkScT _ _ _ _ _ _ _ _ _ _ sps))
  (let ((erased m2) (erased lp)) (list-len _ pt))
  (match erased (stele-plus _ (Zero) pt m m2 sps lp) _ ((PlusZ _) (len-eq-length-r _ _ pt ids m2 li lp))))
(def-fns _ $ (erased refs-length : (erased (List (Nat)) ids) (erased (List (Term)) ts) (erased (Nat) m) (subterm erased (Refs ids ts) rf) (erased (Length (Nat) ids m) ln) -> (erased (Length (Term) ts m) q))
  (match erased rf _
    ((RefsNil) (match erased ln _ ((LengthNil _) (LengthNil _))))
    ((RefsCons x ids2 ts2 p) (match erased ln _ ((LengthCons _ _ _ m2 l2) (LengthCons _ (Ref x) ts2 m2 (refs-length ids2 ts2 m2 p l2)))))))
(def-fns _ $ (erased refs-len-eq : (erased (List (Entry)) ps) (erased (List (Nat)) ids) (erased (List (Term)) ts) (erased (LenEq (Entry) (Nat) ps ids) le) (subterm erased (Refs ids ts) rf) -> (erased (LenEq (Term) (Entry) ts ps) q))
  (match erased rf _
    ((RefsNil) (match erased le _ ((LENil _ _) (LENil _ _))))
    ((RefsCons x ids2 ts2 p) (match erased le _ ((LECons _ _ e _ ps2 _ le2) (LECons _ _ (Ref x) e ts2 ps2 (refs-len-eq ps2 ids2 ts2 le2 p)))))))
(def-fns _ $ (erased args-len-eq : (erased (Ctx) ctx) (erased (List (Maybe (Term))) acc) (erased (List (Entry)) tele) (erased (List (Sexp)) args) (erased (List (Term)) ts) (subterm erased (ElabTermArgs ctx acc tele args (ArgsOk ts)) p) ->
    (erased (LenEq (Term) (Entry) ts tele) le))
  (match erased p _
    ((ETANil _ _) (LENil _ _))
    ((ETATy _ _ s t es _ rest at2 _ _ ts2 _ _ _ q2) (LECons _ _ at2 (MkEntry s (BFalse) t) ts2 es (args-len-eq ctx (Cons _ (Some _ at2) acc) es rest ts2 q2)))
    ((ETAIs _ _ s t es _ rest at2 _ _ ts2 _ _ _ q2) (LECons _ _ at2 (MkEntry s (BTrue) t) ts2 es (args-len-eq ctx (Cons _ (Some _ at2) acc) es rest ts2 q2)))))
(def-fns _ $ (many inst-ret-sc : (many (Ctx) ctx) (erased (Nat) out) (erased (List (Entry)) ps) (many (Term) ret) (many (List (Term)) as) (erased (ScT ctx (Zero) ps out) sps) (erased (Sc ctx out ret) sret) (erased (ScL ctx (Zero) as) sas)
    (erased (LenEq (Term) (Entry) as ps) le) -> (many (List (Maybe (Term))) subs) (erased (Somes as subs) so) (many (Term) ty) (erased (Subst subs ret ty) q) (erased (Sc ctx (Zero) ty) sty))
  (let-match many ctx (MkCtx _ _ e _ _ _ _))
  (let-match erased sps (MkScT _ _ _ _ _ _ _ _ _ _ tps))
  (let-match erased sret (MkSc _ _ _ _ _ _ _ _ _ tret))
  (let-match erased sas (MkScL _ _ _ _ _ _ _ _ _ tas))
  (let ((many sub2) (erased so) (many ty) (erased q) (erased sty)) (inst-ret e out ps ret as tps tret tas le))
  (values sub2 so ty q (MkSc _ _ _ _ _ _ _ _ ty sty)))
(def-fns _ $ (erased cov-binders : (erased (Ctx) ctx0) (erased (List (Nat)) ids) (erased (Ctx) ctx1) (erased (List (Maybe (Nat))) b) (erased (Nat) m) (erased (List (Entry)) pt) (erased (CovRev ctx0 (Nil (Maybe (Nat))) ids ctx1) cr)
    (erased (Binders ids b) bd) (erased (ScT ctx0 (Zero) pt m) spt) (erased (LenEq (Entry) (Nat) pt ids) li) -> (erased (Cov ctx0 b ctx1 m) c))
  (let-match erased cr (MkCovRev n0 _ e0 _ _ _ _ _ _ e1 _ _ _ _ _ _ le c2))
  (MkCov _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ le (covers-rev-binders n0 e0 (Nil _) ids e1 b b c2 bd (cat-nil b)) (binders-layout ids b m bd (tele-ids-length ctx0 pt ids m spt li))))
(def-fns _ $ (erased covers-rev-ext : (erased (Nat) n0) (erased (List (Ent)) e0) (erased (List (Maybe (Nat))) acc) (erased (List (Nat)) ids) (erased (List (Ent)) e1) (subterm erased (CoversRev n0 e0 acc ids e1) cr) -> (erased (Ext n0 e0 e1) x))
  (match erased cr _
    ((CvRNil _ _ _ _ c2) (covers-ext n0 e0 acc e1 c2))
    ((CvRCons _ _ _ y ids2 _ cr2) (covers-rev-ext n0 e0 (Cons _ (Some _ y) acc) ids2 e1 cr2))))
(def-fns _ $ (erased covrev-grew : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (List (Nat)) ids) (erased (Ctx) ctx1) (erased (CovRev ctx0 acc ids ctx1) cr) -> (erased (Grew ctx0 ctx1) g))
  (let-match erased cr (MkCovRev n0 s0 e0 r0 a0 l0 sa0 n1 s1 e1 r1 a1 l1 sa1 _ _ le c2))
  (GrewBy n0 s0 e0 r0 a0 l0 sa0 n1 s1 e1 r1 a1 l1 sa1 le (covers-rev-ext n0 e0 acc ids e1 c2)))

; A canonical former is a former of the same kind.
(def-adts
  ((IsValCtor : ((Term) t) -> Type)
    enum
    (many IVC : (erased (List (Entry)) ps) (erased (Term) r) -> (IsValCtor (TValCtor ps r))))
  ((IsTyCtor : ((Term) t) -> Type)
    enum
    (many ITC : (erased (List (Entry)) ps) -> (IsTyCtor (TTyCtor ps)))))
(def-fns _ $ (erased canon-valctor : (erased (List (Rule)) rules) (erased (List (Entry)) ps) (erased (Term) r) (erased (Term) u) (erased (Canon rules (TValCtor ps r) u) c) -> (erased (IsValCtor u) p))
  (match erased c _ ((CanValCtor _ _ ps2 _ r2 _ _) (IVC ps2 r2))))
(def-fns _ $ (erased canon-tyctor : (erased (List (Rule)) rules) (erased (List (Entry)) ps) (erased (Term) u) (erased (Canon rules (TTyCtor ps) u) c) -> (erased (IsTyCtor u) p))
  (match erased c _ ((CanTyCtor _ _ ps2 _) (ITC ps2))))

; ---- Context-level decisions: the type and kind of an entry, canonical forms, identity, refinement.

(def-fns _ $ (many type-of : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) x) (erased (Has ctx x) h) ->
    (many (Term) ty) (many (Kind) k) (erased (TypeOf ctx x ty) p) (erased (KindOf ctx x k) q) (erased (Sc ctx (Zero) ty) sc) (erased (List (Ent)) e2) (erased (Ents ctx e2) ee) (erased (EntOf e2 x ty k) eo))
  (let-match many ctx (MkCtx n s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ _ _ _ _ _ se _ _ _ _ _ _ _))
  (let-match erased h (MkHas _ _ _ _ _ _ _ _ he))
  (match many (ent-dec e x) _
    (absurd (EntMiss _ _ m) (has-ent-no-ent e x he m))
    ((EntHit _ _ ty k p) (values ty k (TypeOfBy ctx x ty k e (EntsOf n s e r a l sa) p) (KindOfBy ctx x ty k e (EntsOf n s e r a l sa) p) (MkSc _ _ _ _ _ _ _ _ ty (ent-of-scoped e e x ty k se p)) e (EntsOf n s e r a l sa) p))))

(def-fns _ $ (many canonical : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) t) (erased (Sc ctx (Zero) t) st) -> (many (Term) u) (erased (CanonAt ctx t u) p) (erased (Sc ctx (Zero) u) su))
  (let-match many ctx (MkCtx n s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ ranks top v al _ _ _ sr _ _ _ _ rp))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
  (let ((many u) (erased c)) (canon-tb e r (MkTable _ _ ranks top v al sr rp) t))
  (values u (CanonicalBy ctx t u r (RulesOf n s e r a l sa) c) (MkSc _ _ _ _ _ _ _ _ u (canon-scoped e r (Zero) t u sr sct c))))

(def-adts
  ((SameDec : ((Ctx) ctx) ((Term) t) ((Term) u) -> Type)
    enum
    (many SDSame : (erased (Ctx) ctx) (erased (Term) t) (erased (Term) u) (erased (Same ctx t u) p) -> (SameDec ctx t u))
    (many SDDiffer : (erased (Ctx) ctx) (erased (Term) t) (erased (Term) u) (erased (Differ ctx t u) p) -> (SameDec ctx t u)))
  ((RefineDec : ((Ctx) ctx) ((Term) t) ((Term) u) -> Type)
    enum
    (many RDRefined : (erased (Ctx) ctx) (erased (Term) t) (erased (Term) u) (many (Ctx) out) (many (WF out) wf) (erased (Grew ctx out) g) (erased (Refine ctx t u out) p) -> (RefineDec ctx t u))
    (many RDContradicted : (erased (Ctx) ctx) (erased (Term) t) (erased (Term) u) (erased (Contradict ctx t u) p) -> (RefineDec ctx t u))))
(def-fns _ $ (many same-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) t) (many (Term) u) (erased (Sc ctx (Zero) t) st) (erased (Sc ctx (Zero) u) su) -> (many (SameDec ctx t u) r))
  (let-match many ctx (MkCtx n s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ ranks top v al _ se _ sr _ _ _ _ rp))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
  (let-match erased su (MkSc _ _ _ _ _ _ _ _ _ scu))
  (let ((erased cnt) (erased fc)) (free-count e r))
  (let-match many (unify-eqs (Check) e se r (MkTable _ _ ranks top v al sr rp) cnt fc (Cons _ (MkEqn t u) (Nil _)) (SqCons _ _ _ _ sct scu (SqNil _))) (MkEqs _ _ _ _ o _ p))
  (match many o _
    ((UFail) (SDDiffer _ _ _ (DifferBy ctx t u e r (EntsOf n s e r a l sa) (RulesOf n s e r a l sa) p)))
    ((UOk rules2) (SDSame _ _ _ (SameBy ctx t u e r rules2 (EntsOf n s e r a l sa) (RulesOf n s e r a l sa) p)))))
(def-fns _ $ (many refine : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) t) (many (Term) u) (erased (Sc ctx (Zero) t) st) (erased (Sc ctx (Zero) u) su) -> (many (RefineDec ctx t u) d))
  (let-match many ctx (MkCtx n s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ ranks top v al be se ss sr sa2 sl ssa bi rp))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
  (let-match erased su (MkSc _ _ _ _ _ _ _ _ _ scu))
  (let ((erased cnt) (erased fc)) (free-count e r))
  (let-match many (unify-eqs (Force) e se r (MkTable _ _ ranks top v al sr rp) cnt fc (Cons _ (MkEqn t u) (Nil _)) (SqCons _ _ _ _ sct scu (SqNil _))) (MkEqs _ _ _ _ o ot p))
  (let-match many o (UOk rules2)
    ((UFail) (RDContradicted _ _ _ (ContradictBy ctx t u e r (EntsOf n s e r a l sa) (RulesOf n s e r a l sa) p))))
  (let-match many ot (OTOk _ _ tb))
  (let-match many tb (MkTable _ _ ranks2 top2 v2 al2 sr2 rp2))
  (RDRefined _ _ _ (MkCtx n s e rules2 a l sa) (MkWF _ _ _ _ _ _ _ ranks2 top2 v2 al2 be se ss sr2 sa2 sl ssa bi rp2)
    (GrewBy n s e r a l sa n s e rules2 a l sa (lt-succ n) (ExtRefl n e))
    (RefineBy ctx t u (MkCtx n s e rules2 a l sa) e r rules2 (EntsOf n s e r a l sa) (RulesOf n s e r a l sa) p (WithRulesTo n s e r a l sa rules2))))

; The type of a closed term of the grammar, through the context.
(def-adts $ (TypedDec : ((Ctx) ctx) ((Term) t) -> Type)
  enum
  (many TypedIs : (erased (Ctx) ctx) (erased (Term) t) (many (Term) ty) (erased (Typed ctx t ty) p) (erased (Sc ctx (Zero) ty) sc) -> (TypedDec ctx t)))
(def-fns _ $ (many typed-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) t) (erased (Sc ctx (Zero) t) st) -> (many (TypedDec ctx t) r))
  (let-match many ctx (MkCtx n s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ ranks top v al _ se _ sr _ _ _ _ rp))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
  (match many (type-of-term e se r (MkTable _ _ ranks top v al sr rp) t sct) _
    ((TotIs _ _ _ ty p sc) (TypedIs _ _ ty (TypedBy ctx t ty e r (EntsOf n s e r a l sa) (RulesOf n s e r a l sa) p) (MkSc _ _ _ _ _ _ _ _ ty sc)))))

; Minting a telescope's entries with the names given.
(def-adts
  ((MintTeleDec : ((Ctx) ctx) ((List (Maybe (Term))) acc) ((List (Entry)) tele) ((List (Maybe (String))) names) -> Type)
    enum
    (many MTMinted : (erased (Ctx) ctx) (erased (List (Maybe (Term))) acc) (erased (List (Entry)) tele) (erased (List (Maybe (String))) names) (many (Ctx) out) (many (List (Nat)) ids)
       (many (WF out) wf) (erased (Grew ctx out) g) (erased (HasAll out ids) h) (erased (LenEq (Entry) (Nat) tele ids) le) (erased (MintTele ctx acc tele names out ids) p) -> (MintTeleDec ctx acc tele names))))
(def-fns _ $ (many mint-tele : (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Maybe (Term))) acc) (erased (Nat) m) (erased (ScS ctx acc m) sacc) (subterm many (List (Entry)) tele) (erased (Nat) out) (erased (ScT ctx m tele out) stele)
    (many (List (Maybe (String))) names) (erased (LenEq (Entry) (Maybe (String)) tele names) len) -> (many (MintTeleDec ctx acc tele names) r))
  (match many tele _
    ((Nil _)
      (match many names _
        ((Nil _) (MTMinted _ _ _ _ ctx (Nil _) wf (grew-refl ctx) (has-all-nil ctx) (LENil _ _) (MTNil ctx acc)))
        (absurd (Cons _ _ _) len)))
    ((Cons _ e es)
      (let-match many names (Cons _ name ns) (absurd (Nil _) len))
      (let-match many e (MkEntry s i t))
      (let-match erased len (LECons _ _ _ _ _ _ len2))
      (let ((erased st) (erased ses)) (sct-parts ctx _ _ s i t es stele))
      (let ((many t2) (erased sb)) (subst acc _ (scs-length ctx acc _ sacc) t (sc-closed ctx _ t st)))
      (let ((erased st2)) (sc-subst ctx acc _ t t2 sacc st sb))
      (match many i _
        ((BFalse)
          (let ((many x) (many ctx1) (erased mnt) (many wf1) (erased g1) (erased hx)) (mint ctx wf name t2 (KPlain) (None _) st2 (scm-none ctx) (ROkNone _)))
          (let-match many (notail $ mint-tele ctx1 wf1 (Cons _ (Some _ (Ref x)) acc) _ (scs-cons ctx1 (Ref x) acc _ (sc-ref ctx1 x (entis-has ctx1 x _ _ hx)) (scs-grew ctx ctx1 acc _ g1 sacc)) es _ (sct-grew ctx ctx1 _ es _ g1 ses) ns len2) (MTMinted _ _ _ _ out3 ids wf2 g3 hids le p))
          (MTMinted _ _ _ _ out3 (Cons _ x ids) wf2 (grew-trans ctx ctx1 out3 g1 g3) (has-all-cons out3 x ids (has-grew ctx1 out3 x g3 (entis-has ctx1 x _ _ hx)) hids) (LECons _ _ e x es ids le)
            (MTTy ctx acc s t es name ns t2 x ctx1 out3 ids sb mnt p)))
        ((BTrue)
          (let-match many (typed-dec ctx wf t2 st2) (TypedIs _ _ ty tt sty))
          (let ((many x) (many ctx1) (erased mnt) (many wf1) (erased g1) (erased hx)) (mint ctx wf name ty (KPlain) (Some _ t2) sty (scm-some ctx t2 st2) (ROkSome _ _ (NDPlain))))
          (let-match many (notail $ mint-tele ctx1 wf1 (Cons _ (Some _ (Ref x)) acc) _ (scs-cons ctx1 (Ref x) acc _ (sc-ref ctx1 x (entis-has ctx1 x _ _ hx)) (scs-grew ctx ctx1 acc _ g1 sacc)) es _ (sct-grew ctx ctx1 _ es _ g1 ses) ns len2) (MTMinted _ _ _ _ out3 ids wf2 g4 hids le p))
          (MTMinted _ _ _ _ out3 (Cons _ x ids) wf2 (grew-trans ctx ctx1 out3 g1 g4) (has-all-cons out3 x ids (has-grew ctx1 out3 x g4 (entis-has ctx1 x _ _ hx)) hids) (LECons _ _ e x es ids le)
            (MTIs ctx acc s t es name ns t2 ty x ctx1 out3 ids sb tt mnt p)))))))

; A strict subterm, decided on canonical terms.
(def-adts
  ((SubDec : ((Ctx) ctx) ((Term) a) ((Term) b) -> Type)
    enum
    (many SubYes : (erased (Ctx) ctx) (erased (Term) a) (erased (Term) b) (erased (StrictSub ctx a b) p) -> (SubDec ctx a b))
    (many SubNo : (erased (Ctx) ctx) (erased (Term) a) (erased (Term) b) (erased (NotSub ctx a b) p) -> (SubDec ctx a b)))
  ((SubListDec : ((Ctx) ctx) ((Term) a) ((List (Term)) as) -> Type)
    enum
    (many SubLYes : (erased (Ctx) ctx) (erased (Term) a) (erased (List (Term)) as) (erased (SubOfList ctx a as) p) -> (SubListDec ctx a as))
    (many SubLNo : (erased (Ctx) ctx) (erased (Term) a) (erased (List (Term)) as) (erased (NotSubList ctx a as) p) -> (SubListDec ctx a as))))
(def-fns _ $ (many sub-parts : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) a) (erased (Term) b) (many (Term) h) (erased (List (Term)) as) (erased (AppParts b h as) ap) (erased (Sc ctx (Zero) a) sa) (erased (Sc ctx (Zero) h) sh)
    (many (SubListDec ctx a as) sl) -> (many (SubDec ctx a b) r))
  (let-match many (same-dec ctx wf a h sa sh) (SDDiffer _ _ _ df) ((SDSame _ _ _ s) (SubYes _ _ _ (SSHead ctx a b h as ap s))))
  (match many sl _
    ((SubLYes _ _ _ p) (SubYes _ _ _ (SSArg ctx a b h as ap p)))
    ((SubLNo _ _ _ p) (SubNo _ _ _ (NSApp ctx a b h as ap df p)))))
(def-fns _
  ((many sub-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) a) (erased (Sc ctx (Zero) a) sa) (subterm many (Term) b) (erased (Sc ctx (Zero) b) sb) -> (many (SubDec ctx a b) r))
    (match many b _
      ((TyApp h ps as)
        (let ((erased sh) (erased sas)) (sc-app-parts ctx _ h as (APTy h ps as) sb))
        (sub-parts ctx wf a _ h as (APTy h ps as) sa sh (notail $ sub-list-dec ctx wf a sa as sas)))
      ((ValApp h ps rt as)
        (let ((erased sh) (erased sas)) (sc-app-parts ctx _ h as (APVal h ps rt as) sb))
        (sub-parts ctx wf a _ h as (APVal h ps rt as) sa sh (notail $ sub-list-dec ctx wf a sa as sas)))
      ((Ref x) (SubNo _ _ _ (NSNotApp ctx a (Ref x) (NotAppRef x))))
      ((Bound k) (SubNo _ _ _ (NSNotApp ctx a (Bound k) (NotAppBound k))))
      ((TUniv) (SubNo _ _ _ (NSNotApp ctx a (TUniv) (NotAppUniv))))
      ((TFn l ps rs) (SubNo _ _ _ (NSNotApp ctx a (TFn l ps rs) (NotAppFn l ps rs))))
      ((TTyCtor ps) (SubNo _ _ _ (NSNotApp ctx a (TTyCtor ps) (NotAppTyCtor ps))))
      ((TValCtor ps ret) (SubNo _ _ _ (NSNotApp ctx a (TValCtor ps ret) (NotAppValCtor ps ret))))))
  ((many sub-list-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) a) (erased (Sc ctx (Zero) a) sa) (subterm many (List (Term)) as) (erased (ScL ctx (Zero) as) sas) -> (many (SubListDec ctx a as) r))
    (let-match many as (Cons _ b rest) ((Nil _) (SubLNo _ _ _ (NSLNil ctx a))))
    (let ((erased sb) (erased srest)) (scl-parts ctx b rest sas))
    (let-match many (same-dec ctx wf a b sa sb) (SDDiffer _ _ _ df)
      ((SDSame _ _ _ s) (SubLYes _ _ _ (SLSame ctx a b rest s))))
    (let-match many (notail $ sub-dec ctx wf a sa b sb) (SubNo _ _ _ n)
      ((SubYes _ _ _ p) (SubLYes _ _ _ (SLDeep ctx a b rest p))))
    (match many (notail $ sub-list-dec ctx wf a sa rest srest) _
      ((SubLYes _ _ _ p) (SubLYes _ _ _ (SLThere ctx a b rest p)))
      ((SubLNo _ _ _ p) (SubLNo _ _ _ (NSLCons ctx a b rest df n p))))))

; ---- Terms of the grammar, telescopes, and their arguments. Beside each outcome, what it built is scoped;
; a telescope's entries, abstracted over its binders, are scoped in the context it was entered from.

(def-adts
  ((EntryDec : ((Sexp) raw) -> Type)
    enum
    (many EntryShape : (erased (Sexp) raw) (many (Bool) s) (many (Bool) i) (many (Sexp) tr) (many (String) x) (erased (EntryRaw raw s i tr x) p) (erased (Subterm (Sexp) tr (Sexp) raw) subs) -> (EntryDec raw))
    (many EntryNot : (erased (Sexp) raw) -> (EntryDec raw))))
(def-fns _ $ (many entry-dec : (many (Sexp) raw) -> (many (EntryDec raw) r))
  (let-match many raw (RList items) (else (EntryNot _)))
  (let-match many items (Cons _ r1 rest1) (else (EntryNot _)))
  (let-match many rest1 (Cons _ r2 rest2) (else (EntryNot _)))
  (match many rest2 _
    ((Nil _)
      (match many r2 _
        ((RAtom x) (EntryShape _ (BFalse) (BFalse) r1 x (EntryTy r1 x) (prove-subterm r1 raw)))
        (else (EntryNot _))))
    ((Cons _ r3 rest3)
      (let-match many rest3 (Nil _) (else (EntryNot _)))
      (let-match many r3 (RAtom x) (else (EntryNot _)))
      (match many r1 _
        ((RKey k)
          (match many k _
            ((KSubterm) (EntryShape _ (BTrue) (BFalse) r2 x (EntrySub r2 x) (prove-subterm r2 raw)))
            (else (EntryNot _))))
        (else
          (let-match many r2 (RKey k2) (else (EntryNot _)))
          (match many k2 _
            ((KIs) (EntryShape _ (BFalse) (BTrue) r1 x (EntryIs r1 x) (prove-subterm r1 raw)))
            (else (EntryNot _))))))))

(def-adts
  ((TSc : ((Ctx) ctx) ((TOut) out) -> Type)
    enum
    (many TSOk : (erased (Ctx) ctx) (erased (Term) t) (erased (Term) ty) (erased (Sc ctx (Zero) t) st) (erased (Sc ctx (Zero) ty) sty) -> (TSc ctx (TOk t ty)))
    (many TSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (TSc ctx (TErr r))))
  ((ASc : ((Ctx) ctx) ((ArgsOut) out) -> Type)
    enum
    (many ASOk : (erased (Ctx) ctx) (erased (List (Term)) ts) (erased (ScL ctx (Zero) ts) sts) -> (ASc ctx (ArgsOk ts)))
    (many ASErr : (erased (Ctx) ctx) (erased (Reason) r) -> (ASc ctx (ArgsErr r))))
  ((TeleSc : ((Ctx) ctx0) ((List (Maybe (Nat))) acc) ((Nat) m) ((Ctx) ctx) ((TeleOut) out) -> Type)
    enum
    (many TLOk : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (Entry)) tele) (erased (List (Nat)) ids) (erased (List (Maybe (String))) names)
       (erased (Nat) m) (erased (Nat) mout) (many (WF out) wf) (erased (CovRev ctx0 acc ids out) cr) (erased (ScT ctx0 m tele mout) st) (erased (LenEq (Entry) (Nat) tele ids) li) (erased (LenEq (Entry) (Maybe (String)) tele names) ln)
       -> (TeleSc ctx0 acc m ctx (TeleOk out tele ids names)))
    (many TLErr : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Nat) m) (erased (Ctx) ctx) (erased (Reason) r) -> (TeleSc ctx0 acc m ctx (TeleErr r))))
  ((TermDec : ((Ctx) ctx) ((Sexp) raw) -> Type)
    enum
    (many MkTermDec : (erased (Ctx) ctx) (erased (Sexp) raw) (many (TOut) out) (erased (ElabTerm ctx raw out) p) (erased (TSc ctx out) sc) -> (TermDec ctx raw))
    (many TermStuck : (erased (Ctx) ctx) (erased (Sexp) raw) -> (TermDec ctx raw)))
  ((ArgsDec : ((Ctx) ctx) ((List (Maybe (Term))) acc) ((List (Entry)) tele) ((List (Sexp)) args) -> Type)
    enum
    (many MkArgsDec : (erased (Ctx) ctx) (erased (List (Maybe (Term))) acc) (erased (List (Entry)) tele) (erased (List (Sexp)) args) (many (ArgsOut) out) (erased (ElabTermArgs ctx acc tele args out) p) (erased (ASc ctx out) sc)
       -> (ArgsDec ctx acc tele args))
    (many ArgsStuck : (erased (Ctx) ctx) (erased (List (Maybe (Term))) acc) (erased (List (Entry)) tele) (erased (List (Sexp)) args) -> (ArgsDec ctx acc tele args)))
  ((FnTeleDec : ((Ctx) ctx0) ((List (Maybe (Nat))) acc) ((Nat) m) ((Ctx) ctx) ((List (Sexp)) raws) -> Type)
    enum
    (many MkTeleDec : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Nat) m) (erased (Ctx) ctx) (erased (List (Sexp)) raws) (many (TeleOut) out) (erased (ElabTele ctx acc raws out) p) (many (TeleSc ctx0 acc m ctx out) sc)
       -> (FnTeleDec ctx0 acc m ctx raws))
    (many TeleStuck : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Nat) m) (erased (Ctx) ctx) (erased (List (Sexp)) raws) -> (FnTeleDec ctx0 acc m ctx raws))))

(def-fns _ $ (erased scope-has-ctx : (erased (Ctx) ctx) (many (WF ctx) wf) (erased (List (Name)) scope) (erased (String) s) (erased (Nat) x) (erased (Scope ctx scope) sc) (erased (NameOf scope s x) n) -> (erased (Has ctx x) h))
  (let-match erased wf (MkWF _ _ e _ _ _ _ _ _ _ _ _ _ ss _ _ _ _ _ _))
  (let-match erased sc (ScopeOf _ _ _ _ _ _ _))
  (MkHas _ _ _ _ _ _ _ x (scope-has e scope s x ss n)))
(def-fns _ $ (erased sct-nil : (erased (Ctx) ctx) (erased (Nat) d) -> (erased (ScT ctx d (Nil (Entry)) d) s))
  (let-match erased ctx (MkCtx _ _ _ _ _ _ _))
  (MkScT _ _ _ _ _ _ _ _ _ (Nil _) (ScTNil _ _)))
(def-fns _ $ (erased sct-cons : (erased (Ctx) ctx) (erased (Nat) d) (erased (Nat) out) (erased (Bool) s) (erased (Bool) i) (erased (Term) t) (erased (List (Entry)) es) (erased (Sc ctx d t) p) (erased (ScT ctx (Succ d) es out) q) ->
    (erased (ScT ctx d (Cons (Entry) (MkEntry s i t) es) out) st))
  (let-match erased p (MkSc _ _ _ _ _ _ _ _ _ sct))
  (let-match erased q (MkScT _ _ _ _ _ _ _ _ _ _ sts))
  (MkScT _ _ _ _ _ _ _ _ _ _ (ScTCons _ _ s i t es _ sct sts)))
(def-fns _ $ (erased covrev-nil : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Ctx) ctx) (erased (Nat) m) (erased (Cov ctx0 acc ctx m) c) -> (erased (CovRev ctx0 acc (Nil (Nat)) ctx) cr))
  (let-match erased c (MkCov n0 _ e0 _ _ _ _ _ _ e1 _ _ _ _ _ _ le cv _))
  (MkCovRev _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ le (CvRNil n0 e0 acc e1 cv)))
(def-fns _ $ (erased covrev-cons : (erased (Ctx) ctx0) (erased (List (Maybe (Nat))) acc) (erased (Nat) x) (erased (List (Nat)) ids) (erased (Ctx) out) (erased (CovRev ctx0 (Cons (Maybe (Nat)) (Some (Nat) x) acc) ids out) c) ->
    (erased (CovRev ctx0 acc (Cons (Nat) x ids) out) cr))
  (let-match erased c (MkCovRev n0 _ e0 _ _ _ _ _ _ e1 _ _ _ _ _ _ le cv))
  (MkCovRev _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ le (CvRCons n0 e0 acc x ids e1 cv)))

; A TValCtor former's return (DESIGN.md section 11): the four ways the canonical return is not an application of a
; type constructor other than the former's own binders.
(def-adts
  ((TyAppDec : ((Term) c) -> Type)
    enum
    (many IsTyApp : (many (Term) h) (many (List (Entry)) ps) (many (List (Term)) as) -> (TyAppDec (TyApp h ps as)))
    (many IsNotTyApp : (erased (Term) c) (erased (NotTyApp c) p) -> (TyAppDec c)))
  ((TyCtorDec : ((Term) u) -> Type)
    enum
    (many TDIs : (many (List (Entry)) ps) -> (TyCtorDec (TTyCtor ps)))
    (many TDNot : (erased (Term) u) (erased (NotTyCtor u) p) -> (TyCtorDec u)))
  ((FormerRetDec : ((Ctx) ctx) ((List (Nat)) pids) ((Term) c) -> Type)
    enum
    (many FROk : (erased (Ctx) ctx) (erased (List (Nat)) pids) (many (Nat) t) (many (List (Entry)) aps) (many (List (Term)) args) (many (Term) tty) (many (List (Entry)) tps)
       (erased (NotMem t pids) nm) (erased (TypeOf ctx t tty) tt) (erased (CanonAt ctx tty (TTyCtor tps)) ct) -> (FormerRetDec ctx pids (TyApp (Ref t) aps args)))
    (many FRBad : (erased (Ctx) ctx) (erased (List (Nat)) pids) (erased (Term) c) (erased (BadFormerRet ctx pids c) br) -> (FormerRetDec ctx pids c))))
(def-fns _ $ (many tyapp-dec : (many (Term) c) -> (many (TyAppDec c) r))
  (match many c _
    ((TyApp h ps as) (IsTyApp h ps as))
    ((ValApp h ps r as) (IsNotTyApp _ (NTAValApp h ps r as)))
    ((Ref x) (IsNotTyApp _ (NTAOther _ (NotAppRef x))))
    ((Bound k) (IsNotTyApp _ (NTAOther _ (NotAppBound k))))
    ((TUniv) (IsNotTyApp _ (NTAOther _ (NotAppUniv))))
    ((TFn l ps rs) (IsNotTyApp _ (NTAOther _ (NotAppFn l ps rs))))
    ((TTyCtor ps) (IsNotTyApp _ (NTAOther _ (NotAppTyCtor ps))))
    ((TValCtor ps r) (IsNotTyApp _ (NTAOther _ (NotAppValCtor ps r))))))
(def-fns _ $ (many tyctor-dec : (many (Term) u) -> (many (TyCtorDec u) r))
  (match many u _
    ((TTyCtor ps) (TDIs ps))
    ((Ref x) (TDNot _ (NTCRef x)))
    ((Bound k) (TDNot _ (NTCBound k)))
    ((TyApp h ps as) (TDNot _ (NTCTyApp h ps as)))
    ((ValApp h ps r as) (TDNot _ (NTCValApp h ps r as)))
    ((TUniv) (TDNot _ (NTCUniv)))
    ((TFn l ps rs) (TDNot _ (NTCFn l ps rs)))
    ((TValCtor ps r) (TDNot _ (NTCValCtor ps r)))))
(def-fns _ $ (erased sc-ref-has : (erased (Ctx) ctx) (erased (Nat) x) (erased (Sc ctx (Zero) (Ref x)) s) -> (erased (Has ctx x) h))
  (let-match erased s (MkSc _ _ _ _ _ _ _ _ _ sc))
  (match erased sc _ ((ScRef _ _ _ hx) (MkHas _ _ _ _ _ _ _ x hx))))
(def-fns _ $ (many former-ret-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Nat)) pids) (many (Term) c) (erased (Sc ctx (Zero) c) sc) -> (many (FormerRetDec ctx pids c) r))
  (let-match many (tyapp-dec c) (IsTyApp h hps args) ((IsNotTyApp _ na) (FRBad _ _ _ (BFNotApp ctx pids c na))))
  (let-match many (nonref-dec h) (IsRef t) ((IsNonRef _ nr) (FRBad _ _ _ (BFHead ctx pids h hps args nr))))
  (let-match many (mem-dec t pids) (MemNo _ _ nm) ((MemYes _ _ m) (FRBad _ _ _ (BFOwn ctx pids t hps args m))))
  (let ((erased sh) (erased _)) (sc-app-parts ctx _ (Ref t) args (APTy (Ref t) hps args) sc))
  (let ((many tty) (many _) (erased tt) (erased _) (erased stty) (erased _) (erased _) (erased _)) (type-of ctx wf t (sc-ref-has ctx t sh)))
  (let ((many u) (erased cu) (erased _)) (canonical ctx wf tty stty))
  (match many (tyctor-dec u) _
    ((TDIs tps) (FROk _ _ t hps args tty tps nm tt cu))
    ((TDNot _ nt) (FRBad _ _ _ (BFNotTycon ctx pids t hps args tty u tt cu nt)))))

(def-fns _
  ((many elab-term : (many (Ctx) ctx) (many (WF ctx) wf) (subterm many (Sexp) raw) (subterm erased (POuter (PInner)) is _ph) -> (many (TermDec ctx raw) r))
    (match many raw _
      ((RAtom s)
        (let ((many scope) (erased sc)) (ctx-scope ctx))
        (let-match many (name-dec scope s) (NameHit _ _ x n)
          ((NameMiss _ _ n) (MkTermDec _ _ (TErr (RNotInScope)) (ETUnbound ctx s scope sc n) (TSErr _ _))))
        (let ((erased hx)) (scope-has-ctx ctx wf scope s x sc n))
        (let ((many ty) (many _) (erased p) (erased _) (erased sty) (erased _) (erased _) (erased _)) (type-of ctx wf x hx))
        (MkTermDec _ _ (TOk (Ref x) ty) (ETName ctx s x ty scope sc n p) (TSOk _ _ _ (sc-ref ctx x hx) sty)))
      ((RKey _) (TermStuck _ _))
      ((RList items)
        (let-match many items (Cons _ h args) ((Nil _) (TermStuck _ _)))
        (match many h _
          ((RKey k) (tail $ elab-former ctx wf k args (POuter (PInner))))
          ((RAtom s) (tail $ elab-term-app ctx wf h args items (POuter (PInner)) (HeadAtom s)))
          ((RList inner) (tail $ elab-term-app ctx wf h args items (POuter (PInner)) (HeadList inner)))))))
  ; (h args...) with a name or a list at the head
  ((many elab-term-app : (many (Ctx) ctx) (many (WF ctx) wf) (many (Sexp) h) (many (List (Sexp)) args) (subterm erased (Cons (Sexp) h args) is items) (subterm erased (POuter (PInner)) is _ph) (erased (HeadRaw h) _hr) ->
      (many (TermDec ctx (RList items)) r))
    (let-match many (notail $ elab-term ctx wf h (POuter (PInner))) (MkTermDec _ _ hout p sc) ((TermStuck _ _) (TermStuck _ _)))
    (let-match many hout (TOk ht hty) ((TErr r) (MkTermDec _ _ (TErr r) (ETAppHeadErr ctx h args r p) (TSErr _ _))))
    (let-match erased sc (TSOk _ _ _ sht shty))
    (let ((many hc) (erased cn) (erased shc)) (canonical ctx wf hty shty))
    (match many hc _
      ((TTyCtor ps)
        (let ((erased _) (erased sps)) (sc-tyctor-parts ctx ps shc))
        (let-match many (notail $ elab-term-args ctx wf (Nil _) _ (scs-nil ctx) ps _ sps args (POuter (PInner))) (MkArgsDec _ _ _ _ aout ap asc)
          ((ArgsStuck _ _ _ _) (TermStuck _ _)))
        (let-match many aout (ArgsOk ts)
          ((ArgsErr r) (MkTermDec _ _ (TErr r) (ETAppArgsErr ctx h args ht hty ps r p (HeadTy ctx hty ps cn) ap) (TSErr _ _))))
        (match erased asc _
          ((ASOk _ _ sts) (MkTermDec _ _ (TOk (TyApp ht ps ts) (TUniv)) (ETTyApp ctx h args ht hty ps ts p cn ap) (TSOk _ _ _ (sc-tyapp ctx ht ps ts _ sht sps sts (args-len-eq ctx (Nil _) ps args ts ap)) (sc-univ ctx))))))
      ((TValCtor ps ret)
        (let ((erased pd) (erased sps) (erased sret)) (sc-valctor-parts ctx ps ret shc))
        (let-match many (notail $ elab-term-args ctx wf (Nil _) _ (scs-nil ctx) ps _ sps args (POuter (PInner))) (MkArgsDec _ _ _ _ aout ap asc)
          ((ArgsStuck _ _ _ _) (TermStuck _ _)))
        (let-match many aout (ArgsOk ts)
          ((ArgsErr r) (MkTermDec _ _ (TErr r) (ETAppArgsErr ctx h args ht hty ps r p (HeadVal ctx hty ps ret cn) ap) (TSErr _ _))))
        (let-match erased asc (ASOk _ _ sts))
        (let ((erased sub2) (erased so) (many ty) (erased sb) (erased sty)) (inst-ret-sc ctx pd ps ret ts sps sret sts (args-len-eq ctx (Nil _) ps args ts ap)))
        (MkTermDec _ _ (TOk (ValApp ht ps ret ts) ty) (ETValApp ctx h args ht hty ps ret ts sub2 ty p cn ap so sb)
          (TSOk _ _ _ (sc-valapp ctx ht ps ret ts _ sht sps sret sts (args-len-eq ctx (Nil _) ps args ts ap)) sty)))
      ((Ref x) (MkTermDec _ _ (TErr (RNotApplicable)) (ETNotApplicable ctx h args ht hty (Ref x) p cn (NoTeleRef x)) (TSErr _ _)))
      ((Bound k) (MkTermDec _ _ (TErr (RNotApplicable)) (ETNotApplicable ctx h args ht hty (Bound k) p cn (NoTeleBound k)) (TSErr _ _)))
      ((TyApp h2 ps2 as2) (MkTermDec _ _ (TErr (RNotApplicable)) (ETNotApplicable ctx h args ht hty (TyApp h2 ps2 as2) p cn (NoTeleTyApp h2 ps2 as2)) (TSErr _ _)))
      ((ValApp h2 ps2 r2 as2) (MkTermDec _ _ (TErr (RNotApplicable)) (ETNotApplicable ctx h args ht hty (ValApp h2 ps2 r2 as2) p cn (NoTeleValApp h2 ps2 r2 as2)) (TSErr _ _)))
      ((TUniv) (MkTermDec _ _ (TErr (RNotApplicable)) (ETNotApplicable ctx h args ht hty (TUniv) p cn (NoTeleUniv)) (TSErr _ _)))
      ((TFn l ps rs) (MkTermDec _ _ (TErr (RNotApplicable)) (ETNotApplicable ctx h args ht hty (TFn l ps rs) p cn (NoTeleFn l ps rs)) (TSErr _ _)))))
  ; the formers: (TFn L (params) (rets)), (TTyCtor (params)), (TValCtor (params) ret)
  ((many elab-former : (many (Ctx) ctx) (many (WF ctx) wf) (many (Key) k) (subterm many (List (Sexp)) items) (subterm erased (POuter (PInner)) is _ph) -> (many (TermDec ctx (RList (Cons (Sexp) (RKey k) items))) r))
    (match many k _
      ((KFn)
        (let-match many items (Cons _ lr rest1) (else (TermStuck _ _)))
        (let-match many rest1 (Cons _ pr rest2) (else (TermStuck _ _)))
        (let-match many rest2 (Cons _ rr rest3) (else (TermStuck _ _)))
        (let-match many rest3 (Nil _) (else (TermStuck _ _)))
        (let-match many pr (RList ps) (else (TermStuck _ _)))
        (match many rr _
          ((RList rs) (tail $ elab-fn ctx wf lr ps rs items (PInner)))
          (else (TermStuck _ _))))
      ((KTyCtor)
        (let-match many items (Cons _ pr rest1) (else (TermStuck _ _)))
        (let-match many rest1 (Nil _) (else (TermStuck _ _)))
        (let-match many pr (RList ps) (else (TermStuck _ _)))
        (let-match many (notail $ elab-tele ctx ctx wf (Nil _) _ (cov-refl ctx) ps (POuter (PInner))) (MkTeleDec _ _ _ _ _ tout ep tsc)
          ((TeleStuck _ _ _ _ _) (TermStuck _ _)))
        (let-match many tout (TeleOk ctx1 pt pids pn)
          ((TeleErr r) (MkTermDec _ _ (TErr r) (ETTyCtorErr ctx ps r ep) (TSErr _ _))))
        (match many tsc _
          ((TLOk _ _ _ _ _ _ _ _ _ _ _ spt _ _) (MkTermDec _ _ (TOk (TTyCtor pt) (TUniv)) (ETTyCtor ctx ps ctx1 pt pids pn ep) (TSOk _ _ _ (sc-tyctor ctx pt _ spt) (sc-univ ctx))))))
      ((KValCtor)
        (let-match many items (Cons _ pr rest1) (else (TermStuck _ _)))
        (let-match many rest1 (Cons _ rr rest2) (else (TermStuck _ _)))
        (let-match many rest2 (Nil _) (else (TermStuck _ _)))
        (match many pr _
          ((RList ps) (tail $ elab-valctor ctx wf ps rr items (PInner)))
          (else (TermStuck _ _))))
      (else (TermStuck _ _))))
  ((many elab-fn : (many (Ctx) ctx) (many (WF ctx) wf) (many (Sexp) lr) (many (List (Sexp)) ps) (many (List (Sexp)) rs)
      (subterm erased (Cons (Sexp) lr (Cons (Sexp) (RList ps) (Cons (Sexp) (RList rs) (Nil (Sexp))))) is items) (subterm erased (PInner) is _ph) ->
      (many (TermDec ctx (RList (Cons (Sexp) (RKey (KFn)) items))) r))
    (let-match many (notail $ elab-term ctx wf lr (POuter (PInner))) (MkTermDec _ _ lout p sc) ((TermStuck _ _) (TermStuck _ _)))
    (let-match many lout (TOk l lty) ((TErr r) (MkTermDec _ _ (TErr r) (ETFnLevelErr ctx lr ps rs r p) (TSErr _ _))))
    (let-match erased sc (TSOk _ _ _ sl slty))
    (let-match many (same-dec ctx wf lty level-ty slty (sc-level-ty ctx wf)) (SDSame _ _ _ sm)
      ((SDDiffer _ _ _ df) (MkTermDec _ _ (TErr (RNotLevel)) (ETFnNotLevel ctx lr ps rs l lty p df) (TSErr _ _))))
    (let-match many (notail $ elab-tele ctx ctx wf (Nil _) _ (cov-refl ctx) ps (POuter (PInner))) (MkTeleDec _ _ _ _ _ pout ep psc)
      ((TeleStuck _ _ _ _ _) (TermStuck _ _)))
    (let-match many pout (TeleOk ctx1 pt pids pn)
      ((TeleErr r) (MkTermDec _ _ (TErr r) (ETFnParamsErr ctx lr ps rs l lty r p sm ep) (TSErr _ _))))
    (let-match many psc (TLOk _ _ _ _ _ _ _ _ _ wf1 cr spt li _))
    (let ((many acc) (erased bd)) (binder-accs pids))
    (let-match many (notail $ elab-tele ctx ctx1 wf1 acc _ (cov-binders ctx pids ctx1 acc _ pt cr bd spt li) rs (POuter (PInner))) (MkTeleDec _ _ _ _ _ rout er rsc)
      ((TeleStuck _ _ _ _ _) (TermStuck _ _)))
    (let-match many rout (TeleOk ctx2 rt rids rn)
      ((TeleErr r) (MkTermDec _ _ (TErr r) (ETFnRetsErr ctx lr ps rs l lty ctx1 pt pids pn acc r p sm ep bd er) (TSErr _ _))))
    (let-match many rsc (TLOk _ _ _ _ _ _ _ _ _ _ _ srt _ _))
    (MkTermDec _ _ (TOk (TFn l pt rt) (TUniv)) (ETFn ctx lr ps rs l lty ctx1 pt pids pn acc ctx2 rt rids rn p sm ep bd er)
      (TSOk _ _ _ (sc-fn ctx l pt rt _ _ sl spt srt) (sc-univ ctx))))
  ((many elab-valctor : (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Sexp)) ps) (many (Sexp) rr) (subterm erased (Cons (Sexp) (RList ps) (Cons (Sexp) rr (Nil (Sexp)))) is items) (subterm erased (PInner) is _ph) ->
      (many (TermDec ctx (RList (Cons (Sexp) (RKey (KValCtor)) items))) r))
    (let-match many (notail $ elab-tele ctx ctx wf (Nil _) _ (cov-refl ctx) ps (POuter (PInner))) (MkTeleDec _ _ _ _ _ pout ep psc)
      ((TeleStuck _ _ _ _ _) (TermStuck _ _)))
    (let-match many pout (TeleOk ctx1 pt pids pn)
      ((TeleErr r) (MkTermDec _ _ (TErr r) (ETValCtorParamsErr ctx ps rr r ep) (TSErr _ _))))
    (let-match many psc (TLOk _ _ _ _ _ _ _ _ _ wf1 cr spt li _))
    (let-match many (notail $ elab-term ctx1 wf1 rr (POuter (PInner))) (MkTermDec _ _ rout er sc)
      ((TermStuck _ _) (TermStuck _ _)))
    (let-match many rout (TOk ret rty)
      ((TErr r) (MkTermDec _ _ (TErr r) (ETValCtorRetErr ctx ps rr ctx1 pt pids pn r ep er) (TSErr _ _))))
    (let-match erased sc (TSOk _ _ _ sret _))
    (let ((many c) (erased cn) (erased scn)) (canonical ctx1 wf1 ret sret))
    (let-match many (former-ret-dec ctx1 wf1 pids c scn) (FROk _ _ t aps args tty tps nm tt ct)
      ((FRBad _ _ _ br) (MkTermDec _ _ (TErr (RBadReturn)) (ETValCtorBadRet ctx ps rr ctx1 pt pids pn ret rty c ep er cn br) (TSErr _ _))))
    (let ((many acc) (erased bd)) (binder-accs pids))
    (let ((many ret2) (erased ab)) (abstract acc ret))
    (MkTermDec _ _ (TOk (TValCtor pt ret2) (TUniv)) (ETValCtor ctx ps rr ctx1 pt pids pn acc ret rty t aps args tty tps ret2 ep er cn nm tt ct bd ab)
      (TSOk _ _ _ (sc-valctor ctx pt ret2 _ spt (sc-abstract ctx acc ctx1 _ ret ret2 (cov-binders ctx pids ctx1 acc _ pt cr bd spt li) sret ab)) (sc-univ ctx))))
  ((many elab-term-args : (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Maybe (Term))) acc) (erased (Nat) m) (erased (ScS ctx acc m) sacc) (many (List (Entry)) tele) (erased (Nat) out) (erased (ScT ctx m tele out) stele) (subterm many (List (Sexp)) args)
      (subterm erased (POuter (PInner)) is _ph) -> (many (ArgsDec ctx acc tele args) r))
    (let-match many (len-dec _ _ tele args) (LenSame _ _ _ _ le)
      ((LenDiff _ _ _ _ m8) (MkArgsDec _ _ _ _ (ArgsErr (RArity)) (ETAArity ctx acc tele args m8) (ASErr _ _))))
    (let-match many tele (Cons _ entry es)
      ((Nil _) (match many args _ ((Nil _) (MkArgsDec _ _ _ _ (ArgsOk (Nil _)) (ETANil ctx acc) (ASOk _ _ (scl-nil ctx)))) (absurd (Cons _ _ _) le))))
    (let-match many args (Cons _ ar rest) (absurd (Nil _) le))
    (let-match many entry (MkEntry s i t))
    (let ((erased st) (erased ses)) (sct-parts ctx _ _ s i t es stele))
    (let-match many (notail $ elab-term ctx wf ar (POuter (PInner))) (MkTermDec _ _ aout p sc)
      ((TermStuck _ _) (ArgsStuck _ _ _ _)))
    (let-match many aout (TOk at2 aty)
      ((TErr r) (MkArgsDec _ _ _ _ (ArgsErr r) (ETAErr ctx acc (MkEntry s i t) es ar rest r p) (ASErr _ _))))
    (let-match erased sc (TSOk _ _ _ sat saty))
    (let ((many t2) (erased sb)) (subst acc _ (scs-length ctx acc _ sacc) t (sc-closed ctx _ t st)))
    (let ((erased st2)) (sc-subst ctx acc _ t t2 sacc st sb))
    (match many i _
      ((BFalse)
        (let-match many (same-dec ctx wf aty t2 saty st2) (SDSame _ _ _ sm)
          ((SDDiffer _ _ _ d10) (MkArgsDec _ _ _ _ (ArgsErr (RMismatch)) (ETATyMismatch ctx acc s t es ar rest at2 aty t2 p sb d10) (ASErr _ _))))
        (let-match many (notail $ elab-term-args ctx wf (Cons _ (Some _ at2) acc) _ (scs-cons ctx at2 acc _ sat sacc) es _ ses rest (POuter (PInner))) (MkArgsDec _ _ _ _ rout q rsc)
          ((ArgsStuck _ _ _ _) (ArgsStuck _ _ _ _)))
        (let-match many rout (ArgsOk ts)
          ((ArgsErr r) (MkArgsDec _ _ _ _ (ArgsErr r) (ETARestErr ctx acc s (BFalse) t es ar rest at2 aty r p q) (ASErr _ _))))
        (match erased rsc _
          ((ASOk _ _ sts) (MkArgsDec _ _ _ _ (ArgsOk (Cons _ at2 ts)) (ETATy ctx acc s t es ar rest at2 aty t2 ts p sb sm q) (ASOk _ _ (scl-cons ctx at2 ts sat sts))))))
      ((BTrue)
        (let-match many (same-dec ctx wf at2 t2 sat st2) (SDSame _ _ _ sm)
          ((SDDiffer _ _ _ d10) (MkArgsDec _ _ _ _ (ArgsErr (RMismatch)) (ETAIsMismatch ctx acc s t es ar rest at2 aty t2 p sb d10) (ASErr _ _))))
        (let-match many (notail $ elab-term-args ctx wf (Cons _ (Some _ at2) acc) _ (scs-cons ctx at2 acc _ sat sacc) es _ ses rest (POuter (PInner))) (MkArgsDec _ _ _ _ rout q rsc)
          ((ArgsStuck _ _ _ _) (ArgsStuck _ _ _ _)))
        (let-match many rout (ArgsOk ts)
          ((ArgsErr r) (MkArgsDec _ _ _ _ (ArgsErr r) (ETARestErr ctx acc s (BTrue) t es ar rest at2 aty r p q) (ASErr _ _))))
        (match erased rsc _
          ((ASOk _ _ sts) (MkArgsDec _ _ _ _ (ArgsOk (Cons _ at2 ts)) (ETAIs ctx acc s t es ar rest at2 aty t2 ts p sb sm q) (ASOk _ _ (scl-cons ctx at2 ts sat sts))))))))
  ((many elab-tele : (erased (Ctx) ctx0) (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Maybe (Nat))) acc) (erased (Nat) m) (erased (Cov ctx0 acc ctx m) cov) (subterm many (List (Sexp)) raws) (subterm erased (POuter (PInner)) is _ph) ->
      (many (FnTeleDec ctx0 acc m ctx raws) r))
    (let-match many raws (Cons _ e rest)
      ((Nil _) (MkTeleDec _ _ _ _ _ (TeleOk ctx (Nil _) (Nil _) (Nil _)) (ELNil ctx acc) (TLOk _ _ _ _ _ _ _ _ _ wf (covrev-nil ctx0 acc ctx _ cov) (sct-nil ctx0 _) (LENil _ _) (LENil _ _)))))
    (let-match many (entry-dec e) (EntryShape _ s i tr x shape sub2) ((EntryNot _) (TeleStuck _ _ _ _ _)))
    (let-match many (notail $ elab-term ctx wf (subterm (subterm-trans sub2 (prove-subterm e raws))) tr (POuter (PInner))) (MkTermDec _ _ tout p sc)
      ((TermStuck _ _) (TeleStuck _ _ _ _ _)))
    (let-match many tout (TOk t tty)
      ((TErr r) (MkTeleDec _ _ _ _ _ (TeleErr r) (ELTermErr ctx acc e s i tr x rest r shape p) (TLErr _ _ _ _ _))))
    (let-match erased sc (TSOk _ _ _ st stty))
    (match many i _
      ((BFalse)
        (let-match many (same-dec ctx wf tty (TUniv) stty (sc-univ ctx)) (SDSame _ _ _ su)
          ((SDDiffer _ _ _ d10) (MkTeleDec _ _ _ _ _ (TeleErr (RMismatch)) (ELNotType ctx acc e s tr x rest t tty shape p d10) (TLErr _ _ _ _ _))))
        (let ((many id) (many ctx1) (erased m8) (many wf1) (erased _) (erased _)) (mint ctx wf (Some _ x) t (KPlain) (None _) st (scm-none ctx) (ROkNone _)))
        (let ((many t2) (erased ab)) (abstract acc t))
        (let-match many (notail $ elab-tele ctx0 ctx1 wf1 (Cons _ (Some _ id) acc) _ (cov-mint ctx0 acc ctx (Some _ x) t (KPlain) (None _) id ctx1 _ cov m8) rest (POuter (PInner))) (MkTeleDec _ _ _ _ _ rout q rsc)
          ((TeleStuck _ _ _ _ _) (TeleStuck _ _ _ _ _)))
        (let-match many rout (TeleOk out es ids names)
          ((TeleErr r) (MkTeleDec _ _ _ _ _ (TeleErr r) (ELRestErr ctx acc e s (BFalse) tr x rest t tty id ctx1 t (None _) r shape p (EMTy t tty) m8 q) (TLErr _ _ _ _ _))))
        (let-match many rsc (TLOk _ _ _ _ _ _ _ _ _ wf2 cr sct li ln))
        (MkTeleDec _ _ _ _ _ (TeleOk out (Cons _ (MkEntry s (BFalse) t2) es) (Cons _ id ids) (Cons _ (Some _ x) names))
          (ELTy ctx acc e s tr x rest t tty id ctx1 t2 out es ids names shape p su m8 ab q)
          (TLOk _ _ _ _ _ _ _ _ _ wf2 (covrev-cons ctx0 acc id ids out cr) (sct-cons ctx0 _ _ s (BFalse) t2 es (sc-abstract ctx0 acc ctx _ t t2 cov st ab) sct)
            (LECons _ _ _ id es ids li) (LECons _ _ _ (Some _ x) es names ln))))
      ((BTrue)
        (let ((many id) (many ctx1) (erased m8) (many wf1) (erased _) (erased _)) (mint ctx wf (Some _ x) tty (KPlain) (Some _ t) stty (scm-some ctx t st) (ROkSome _ _ (NDPlain))))
        (let ((many t2) (erased ab)) (abstract acc t))
        (let-match many (notail $ elab-tele ctx0 ctx1 wf1 (Cons _ (Some _ id) acc) _ (cov-mint ctx0 acc ctx (Some _ x) tty (KPlain) (Some _ t) id ctx1 _ cov m8) rest (POuter (PInner))) (MkTeleDec _ _ _ _ _ rout q rsc)
          ((TeleStuck _ _ _ _ _) (TeleStuck _ _ _ _ _)))
        (let-match many rout (TeleOk out es ids names)
          ((TeleErr r) (MkTeleDec _ _ _ _ _ (TeleErr r) (ELRestErr ctx acc e s (BTrue) tr x rest t tty id ctx1 tty (Some _ t) r shape p (EMIs t tty) m8 q) (TLErr _ _ _ _ _))))
        (let-match many rsc (TLOk _ _ _ _ _ _ _ _ _ wf2 cr sct li ln))
        (MkTeleDec _ _ _ _ _ (TeleOk out (Cons _ (MkEntry s (BTrue) t2) es) (Cons _ id ids) (Cons _ (Some _ x) names))
          (ELIs ctx acc e s tr x rest t tty id ctx1 t2 out es ids names shape p m8 ab q)
          (TLOk _ _ _ _ _ _ _ _ _ wf2 (covrev-cons ctx0 acc id ids out cr) (sct-cons ctx0 _ _ s (BTrue) t2 es (sc-abstract ctx0 acc ctx _ t t2 cov st ab) sct)
            (LECons _ _ _ id es ids li) (LECons _ _ _ (Some _ x) es names ln)))))))

; ---- Decisions for calls: the annotation among the arguments, the marked positions, the prefix check, and
; the shapes a proof's type must have. What a call's items yield is a subterm of the items, for the walk.

(def-adts
  ((Elems : ((List (Sexp)) parent) ((List (Sexp)) args) -> Type)
    enum
    (many ElNil : (erased (List (Sexp)) parent) -> (Elems parent (Nil (Sexp))))
    (many ElCons : (erased (List (Sexp)) parent) (erased (Sexp) a) (erased (List (Sexp)) rest) (erased (Subterm (Sexp) a (List (Sexp)) parent) p) (erased (Elems parent rest) q) -> (Elems parent (Cons (Sexp) a rest))))
  ((AnnIn : ((List (Sexp)) parent) ((Ann) ann) -> Type)
    enum
    (many InNone : (erased (List (Sexp)) parent) -> (AnnIn parent (ANone)))
    (many InPredates : (erased (List (Sexp)) parent) (erased (Sexp) p) (erased (Subterm (Sexp) p (List (Sexp)) parent) s) -> (AnnIn parent (APredates p)))
    (many InSubterm : (erased (List (Sexp)) parent) (erased (Nat) i) (erased (Sexp) p) (erased (Subterm (Sexp) p (List (Sexp)) parent) s) -> (AnnIn parent (ASubterm i p))))
  ((PlainDec : ((List (Sexp)) args) -> Type)
    enum
    (many PlainYes : (erased (List (Sexp)) args) (erased (Plain args) p) -> (PlainDec args))
    (many PlainNo : (erased (List (Sexp)) args) -> (PlainDec args)))
  ((AnnKeyDec : ((Key) k) -> Type)
    enum
    (many AKNot : (erased (Key) k) (erased (NotAnnKey k) p) -> (AnnKeyDec k))
    (many AKPredates : -> (AnnKeyDec (KPredates)))
    (many AKSubterm : -> (AnnKeyDec (KSubterm)))
    (many AKOther : (erased (Key) k) -> (AnnKeyDec k)))
  ((AnnItem : ((Sexp) item) -> Type)
    enum
    (many AIPredates : (many (Sexp) p) -> (AnnItem (RList (Cons (Sexp) (RKey (KPredates)) (Cons (Sexp) p (Nil (Sexp)))))))
    (many AISubterm : (many (Sexp) p) -> (AnnItem (RList (Cons (Sexp) (RKey (KSubterm)) (Cons (Sexp) p (Nil (Sexp)))))))
    (many AINone : (erased (Sexp) item) -> (AnnItem item)))
  ((SubAtDec : ((List (Sexp)) items) -> Type)
    enum
    (many SubAtYes : (erased (List (Sexp)) items) (many (Nat) i) (many (Sexp) p) (many (List (Sexp)) args) (erased (SubtermAt items i p args) q) (erased (Subterm (Sexp) p (List (Sexp)) items) s) (erased (Elems items args) el)
       -> (SubAtDec items))
    (many SubAtNo : (erased (List (Sexp)) items) -> (SubAtDec items)))
  ((CallRawDec : ((List (Sexp)) items) -> Type)
    enum
    (many MkCallRaw : (erased (List (Sexp)) items) (many (Ann) ann) (many (List (Sexp)) args) (erased (CallRaw items ann args) p) (erased (AnnIn items ann) ai) (erased (Elems items args) el) -> (CallRawDec items))
    (many CallRawStuck : (erased (List (Sexp)) items) -> (CallRawDec items))))

(def-fns _ $ (erased elems-weaken : (erased (List (Sexp)) inner) (erased (List (Sexp)) outer) (erased (List (Sexp)) args) (erased (Subterm (List (Sexp)) inner (List (Sexp)) outer) s) (subterm erased (Elems inner args) el) ->
    (erased (Elems outer args) el2))
  (match erased el _
    ((ElNil _) (ElNil outer))
    ((ElCons _ x rest p q) (ElCons outer x rest (subterm-trans p s) (elems-weaken inner outer rest s q)))))
(def-fns _ $ (erased elems-refl : (subterm erased (List (Sexp)) args) -> (erased (Elems args args) el))
  (match erased args _
    ((Nil _) (ElNil _))
    ((Cons _ x rest) (ElCons args x rest (prove-subterm x args) (elems-weaken rest args rest (prove-subterm rest args) (elems-refl rest))))))

(def-fns _ $ (many ann-key-dec : (many (Key) k) -> (many (AnnKeyDec k) r))
  (match many k _
    ((KFn) (AKNot _ (NAKFn))) ((KTyCtor) (AKNot _ (NAKTyCtor))) ((KValCtor) (AKNot _ (NAKValCtor))) ((KMatch) (AKNot _ (NAKMatch))) ((KValues) (AKNot _ (NAKValues)))
    ((KProveSubterm) (AKNot _ (NAKProveSubterm))) ((KProvePredates) (AKNot _ (NAKProvePredates))) ((KPredatesTrans) (AKNot _ (NAKPredatesTrans)))
    ((KSubtermTrans) (AKNot _ (NAKSubtermTrans))) ((KPredatesSubterm) (AKNot _ (NAKPredatesSubterm)))
    ((KPredates) (AKPredates)) ((KSubterm) (AKSubterm))
    (else (AKOther _))))
(def-fns _ $ (many plain-dec : (subterm many (List (Sexp)) args) -> (many (PlainDec args) r))
  (let-match many args (Cons _ x rest) ((Nil _) (PlainYes _ (PlainNil))))
  (let-match many (notail $ plain-dec rest) (PlainYes _ p) ((PlainNo _) (PlainNo _)))
  (let-match many x (RList items) ((RAtom s) (PlainYes _ (PlainAtom s rest p))) ((RKey _) (PlainNo _)))
  (let-match many items (Cons _ h more) ((Nil _) (PlainYes _ (PlainNilList rest p))))
  (let-match many h (RKey k)
    ((RAtom s) (PlainYes _ (PlainAtomList s more rest p)))
    ((RList inner) (PlainYes _ (PlainListList inner more rest p))))
  (match many (ann-key-dec k) _
    ((AKNot _ nk) (PlainYes _ (PlainKeyList k more rest nk p)))
    (else (PlainNo _))))
(def-fns _ $ (many ann-item : (many (Sexp) item) -> (many (AnnItem item) r))
  (let-match many item (RList items) (else (AINone _)))
  (let-match many items (Cons _ h rest) (else (AINone _)))
  (let-match many h (RKey k) (else (AINone _)))
  (let-match many rest (Cons _ p more) (else (AINone _)))
  (let-match many more (Nil _) (else (AINone _)))
  (match many k _
    ((KPredates) (AIPredates p))
    ((KSubterm) (AISubterm p))
    (else (AINone _))))
(def-fns _ $ (many subterm-at-dec : (subterm many (List (Sexp)) items) -> (many (SubAtDec items) r))
  (let-match many items (Cons _ x rest) ((Nil _) (SubAtNo _)))
  (match many (ann-item x) _
    ((AISubterm p)
      (let-match many rest (Cons _ arg args) ((Nil _) (SubAtNo _)))
      (match many (plain-dec rest) _
        ((PlainYes _ pl) (SubAtYes _ (Zero) p rest (SAHere p arg args pl) (prove-subterm p items) (elems-weaken rest items rest (prove-subterm rest items) (elems-refl rest))))
        ((PlainNo _) (SubAtNo _))))
    (else
      (let-match many (plain-dec (Cons _ x (Nil _))) (PlainYes _ pl) ((PlainNo _) (SubAtNo _)))
      (let-match many (notail $ subterm-at-dec rest) (SubAtYes _ i p args q s el) ((SubAtNo _) (SubAtNo _)))
      (SubAtYes _ (Succ i) p (Cons _ x args) (SAThere x rest i p args pl q) (subterm-trans s (prove-subterm rest items))
        (ElCons items x args (prove-subterm x items) (elems-weaken rest items args (prove-subterm rest items) el))))))
(def-fns _ $ (many call-raw-dec : (many (List (Sexp)) items) -> (many (CallRawDec items) r))
  (let-match many items (Cons _ x rest) ((Nil _) (MkCallRaw _ (ANone) (Nil _) (CRPlain (Nil _) (PlainNil)) (InNone _) (ElNil _))))
  (match many (ann-item x) _
    ((AIPredates p)
      (match many (plain-dec rest) _
        ((PlainYes _ pl) (MkCallRaw _ (APredates p) rest (CRPredates p rest pl) (InPredates _ p (prove-subterm p items)) (elems-weaken rest items rest (prove-subterm rest items) (elems-refl rest))))
        ((PlainNo _) (CallRawStuck _))))
    (else
      (let-match many (plain-dec items) (PlainNo _)
        ((PlainYes _ pl) (MkCallRaw _ (ANone) items (CRPlain items pl) (InNone _) (elems-refl items))))
      (match many (subterm-at-dec items) _
        ((SubAtNo _) (CallRawStuck _))
        ((SubAtYes _ i p args q s el) (MkCallRaw _ (ASubterm i p) args (CRSubterm items i p args q) (InSubterm _ i p s) el))))))

(def-adts
  ((MarkedIndexDec : ((List (Entry)) ps) ((Nat) i) -> Type)
    enum
    (many MIYesAt : (erased (List (Entry)) ps) (erased (Nat) i) (many (Nat) j) (erased (MarkedIndex ps i j) p) -> (MarkedIndexDec ps i))
    (many MINoAt : (erased (List (Entry)) ps) (erased (Nat) i) (erased (Unmarked ps i) p) -> (MarkedIndexDec ps i)))
  ((PrefixDec : ((Ctx) ctx) ((Nat) j) ((List (Term)) as) ((List (Term)) bs) -> Type)
    enum
    (many PrefixYes : (erased (Ctx) ctx) (erased (Nat) j) (erased (List (Term)) as) (erased (List (Term)) bs) (many (Term) b) (erased (SamePrefix ctx j as bs b) p) (erased (Sc ctx (Zero) b) sb) -> (PrefixDec ctx j as bs))
    (many PrefixNo : (erased (Ctx) ctx) (erased (Nat) j) (erased (List (Term)) as) (erased (List (Term)) bs) (erased (DifferPrefix ctx j as bs) p) -> (PrefixDec ctx j as bs)))
  ; A list of three or four terms, from its length.
  ((As3 : ((List (Term)) as) -> Type)
    enum
    (many MkAs3 : (erased (Term) a) (erased (Term) b) (erased (Term) c) -> (As3 (Cons (Term) a (Cons (Term) b (Cons (Term) c (Nil (Term))))))))
  ((As4 : ((List (Term)) as) -> Type)
    enum
    (many MkAs4 : (erased (Term) a) (erased (Term) b) (erased (Term) c) (erased (Term) d) -> (As4 (Cons (Term) a (Cons (Term) b (Cons (Term) c (Cons (Term) d (Nil (Term))))))))))
(def-fns _ $ (many marked-index-dec : (subterm many (List (Entry)) ps) (many (Nat) i) -> (many (MarkedIndexDec ps i) r))
  (let-match many ps (Cons _ e es) ((Nil _) (MINoAt _ _ (UmNil i))))
  (let-match many e (MkEntry s is2 t))
  (let-match many i (Succ i2)
    ((Zero) (match many s _ ((BTrue) (MIYesAt _ _ (Zero) (MIHere is2 t es))) ((BFalse) (MINoAt _ _ (UmHere is2 t es))))))
  (let-match many (notail $ marked-index-dec es i2) (MIYesAt _ _ j p)
    ((MINoAt _ _ p) (MINoAt _ _ (UmThere (MkEntry s is2 t) es i2 p))))
  (match many s _ ((BTrue) (MIYesAt _ _ (Succ j) (MIYes is2 t es i2 j p))) ((BFalse) (MIYesAt _ _ j (MINo is2 t es i2 j p)))))
(def-fns _ $ (many prefix-dec : (many (Ctx) ctx) (many (WF ctx) wf) (subterm many (Nat) j) (many (List (Term)) as) (many (List (Term)) bs) (erased (ScL ctx (Zero) as) sas) (erased (ScL ctx (Zero) bs) sbs) -> (many (PrefixDec ctx j as bs) r))
  (match many j _
    ((Zero)
      (let-match many bs (Cons _ b rest)
        ((Nil _) (PrefixNo _ _ _ _ (DPNilB ctx (Zero) as))))
      (let ((erased sb) (erased _)) (scl-parts ctx b rest sbs))
      (PrefixYes _ _ _ _ b (SPZero ctx as b rest) sb))
    ((Succ j2)
      (let-match many as (Cons _ x xs) ((Nil _) (PrefixNo _ _ _ _ (DPNilA ctx (Succ j2) bs))))
      (let-match many bs (Cons _ y ys) ((Nil _) (PrefixNo _ _ _ _ (DPNilB ctx (Succ j2) (Cons _ x xs)))))
      (let ((erased sx) (erased sxs)) (scl-parts ctx x xs sas))
      (let ((erased sy) (erased sys)) (scl-parts ctx y ys sbs))
      (let-match many (same-dec ctx wf x y sx sy) (SDSame _ _ _ sm)
        ((SDDiffer _ _ _ df) (PrefixNo _ _ _ _ (DPHere ctx j2 x xs y ys df))))
      (match many (notail $ prefix-dec ctx wf j2 xs ys sxs sys) _
        ((PrefixNo _ _ _ _ p) (PrefixNo _ _ _ _ (DPThere ctx j2 x xs y ys sm p)))
        ((PrefixYes _ _ _ _ bb p sb) (PrefixYes _ _ _ _ bb (SPSucc ctx j2 x xs y ys bb sm p) sb))))))
(def-fns _ $ (erased len3 : (erased (List (Term)) as) (erased (Length (Term) as (Succ (Succ (Succ (Zero))))) ln) -> (erased (As3 as) p))
  (let-match erased ln (LengthCons _ x _ _ l1))
  (let-match erased l1 (LengthCons _ y _ _ l2))
  (let-match erased l2 (LengthCons _ z _ _ l3))
  (match erased l3 _ ((LengthNil _) (MkAs3 x y z))))
(def-fns _ $ (erased len4 : (erased (List (Term)) as) (erased (Length (Term) as (Succ (Succ (Succ (Succ (Zero)))))) ln) -> (erased (As4 as) p))
  (let-match erased ln (LengthCons _ x _ _ l1))
  (let-match erased l1 (LengthCons _ y _ _ l2))
  (let-match erased l2 (LengthCons _ z _ _ l3))
  (let-match erased l3 (LengthCons _ w _ _ l4))
  (match erased l4 _ ((LengthNil _) (MkAs4 x y z w))))

; A proof's canonical type as (Predates ty a lv), with each part the same as required, or why not.
(def-adts
  ((PredatesDec : ((Ctx) ctx) ((Term) c) ((Term) l) ((Term) cur) -> Type)
    enum
    (many PDYes : (erased (Ctx) ctx) (erased (Term) c) (erased (Term) l) (erased (Term) cur) (many (Term) h) (many (List (Entry)) hps) (many (Term) ty) (many (Term) a) (many (Term) lv)
       (erased (Same ctx h (Ref (Succ (Zero)))) sh) (erased (Same ctx ty level-ty) sty) (erased (Same ctx a l) sa) (erased (Same ctx lv cur) sc)
       -> (PredatesDec ctx (TyApp h hps (Cons (Term) ty (Cons (Term) a (Cons (Term) lv (Nil (Term)))))) l cur))
    (many PDNo : (erased (Ctx) ctx) (erased (Term) c) (erased (Term) l) (erased (Term) cur) (erased (NotPredates ctx c l cur) p) -> (PredatesDec ctx c l cur)))
  ((SubtermDec : ((Ctx) ctx) ((Term) c) ((Term) a) ((Term) b) -> Type)
    enum
    (many STYes : (erased (Ctx) ctx) (erased (Term) c) (erased (Term) a) (erased (Term) b) (many (Term) h) (many (List (Entry)) hps) (many (Term) ta) (many (Term) a0) (many (Term) tb) (many (Term) b0)
       (erased (Same ctx h (Ref (Succ (Succ (Zero))))) sh) (erased (Same ctx a0 a) sa) (erased (Same ctx b0 b) sb)
       -> (SubtermDec ctx (TyApp h hps (Cons (Term) ta (Cons (Term) a0 (Cons (Term) tb (Cons (Term) b0 (Nil (Term))))))) a b))
    (many STNo : (erased (Ctx) ctx) (erased (Term) c) (erased (Term) a) (erased (Term) b) (erased (NotSubtermOf ctx c a b) p) -> (SubtermDec ctx c a b))))
(def-fns _ $ (many predates-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) c) (many (Term) l) (many (Term) cur) (erased (Sc ctx (Zero) c) scc) (erased (Sc ctx (Zero) l) sl) (erased (Sc ctx (Zero) cur) scur) -> (many (PredatesDec ctx c l cur) r))
  (let ((erased h1) (erased _)) (sc-builtin ctx wf))
  (let-match many (tyapp-dec c) (IsTyApp h hps as) ((IsNotTyApp _ na) (PDNo _ _ _ _ (NPNotApp ctx c l cur na))))
  (let ((erased sh) (erased sas)) (sc-app-parts ctx _ h as (APTy h hps as) scc))
  (let-match many (not-len-dec (Succ (Succ (Succ (Zero)))) as) (LenIs _ _ ln)
    ((LenIsNot _ _ nl) (PDNo _ _ _ _ (NPArity ctx h hps as l cur nl))))
  (let-match erased (len3 as ln) (MkAs3 _ _ _))
  (let-match many as (Cons _ ty rest1))
  (let-match many rest1 (Cons _ a rest2))
  (let-match many rest2 (Cons _ lv rest3))
  (let ((erased sty) (erased srest1)) (scl-parts ctx ty rest1 sas))
  (let ((erased sa) (erased srest2)) (scl-parts ctx a rest2 srest1))
  (let ((erased slv) (erased _)) (scl-parts ctx lv rest3 srest2))
  (let-match many (same-dec ctx wf h (Ref (Succ (Zero))) sh (sc-ref ctx _ h1)) (SDSame _ _ _ ssh)
    ((SDDiffer _ _ _ df) (PDNo _ _ _ _ (NPHead ctx h hps as l cur df))))
  (let-match many (same-dec ctx wf ty level-ty sty (sc-level-ty ctx wf)) (SDSame _ _ _ ssty)
    ((SDDiffer _ _ _ df) (PDNo _ _ _ _ (NPType ctx h hps ty a lv l cur df))))
  (let-match many (same-dec ctx wf a l sa sl) (SDSame _ _ _ ssa)
    ((SDDiffer _ _ _ df) (PDNo _ _ _ _ (NPLevel ctx h hps ty a lv l cur df))))
  (match many (same-dec ctx wf lv cur slv scur) _
    ((SDDiffer _ _ _ df) (PDNo _ _ _ _ (NPCur ctx h hps ty a lv l cur df)))
    ((SDSame _ _ _ ssc) (PDYes ctx c l cur h hps ty a lv ssh ssty ssa ssc))))
(def-fns _ $ (many subterm-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) c) (many (Term) a) (many (Term) b) (erased (Sc ctx (Zero) c) scc) (erased (Sc ctx (Zero) a) sa) (erased (Sc ctx (Zero) b) sb) -> (many (SubtermDec ctx c a b) r))
  (let ((erased _) (erased h2)) (sc-builtin ctx wf))
  (let-match many (tyapp-dec c) (IsTyApp h hps as) ((IsNotTyApp _ na) (STNo _ _ _ _ (NTNotApp ctx c a b na))))
  (let ((erased sh) (erased sas)) (sc-app-parts ctx _ h as (APTy h hps as) scc))
  (let-match many (not-len-dec (Succ (Succ (Succ (Succ (Zero))))) as) (LenIs _ _ ln)
    ((LenIsNot _ _ nl) (STNo _ _ _ _ (NTArity ctx h hps as a b nl))))
  (let-match erased (len4 as ln) (MkAs4 _ _ _ _))
  (let-match many as (Cons _ ta rest1))
  (let-match many rest1 (Cons _ a0 rest2))
  (let-match many rest2 (Cons _ tb rest3))
  (let-match many rest3 (Cons _ b0 rest4))
  (let ((erased _) (erased srest1)) (scl-parts ctx ta rest1 sas))
  (let ((erased sa0) (erased srest2)) (scl-parts ctx a0 rest2 srest1))
  (let ((erased _) (erased srest3)) (scl-parts ctx tb rest3 srest2))
  (let ((erased sb0) (erased _)) (scl-parts ctx b0 rest4 srest3))
  (let-match many (same-dec ctx wf h (Ref (Succ (Succ (Zero)))) sh (sc-ref ctx _ h2)) (SDSame _ _ _ ssh)
    ((SDDiffer _ _ _ df) (STNo _ _ _ _ (NTHead ctx h hps as a b df))))
  (let-match many (same-dec ctx wf a0 a sa0 sa) (SDSame _ _ _ ssa)
    ((SDDiffer _ _ _ df) (STNo _ _ _ _ (NTSmall ctx h hps ta a0 tb b0 a b df))))
  (match many (same-dec ctx wf b0 b sb0 sb) _
    ((SDDiffer _ _ _ df) (STNo _ _ _ _ (NTBig ctx h hps ta a0 tb b0 a b df)))
    ((SDSame _ _ _ ssb) (STYes ctx c a b h hps ta a0 tb b0 ssh ssa ssb))))

; A declared type constructor and a declared constructor, read through the entry each was minted with.
(def-fns _ $ (erased tycon-grew : (erased (Ctx) c1) (erased (Ctx) c2) (erased (Nat) tid) (many (WF c1) wf) (erased (Grew c1 c2) g) (erased (Tycon c1 tid) p) -> (erased (Tycon c2 tid) q))
  (let-match erased g (GrewBy n0 _ e0 _ _ _ _ _ _ e1 _ _ _ _ _ ext))
  (let-match erased p (MkTycon _ _ _ _ _ _ _ _ pt eo))
  (let-match erased wf (MkWF _ _ _ _ _ _ _ _ _ _ _ be _ _ _ _ _ _ _ _))
  (MkTycon _ _ _ _ _ _ _ tid pt (ent-of-ext n0 e0 e1 tid (TTyCtor pt) (KDecl) be eo ext)))
(def-fns _ $ (erased tycons-grew : (erased (Ctx) c1) (erased (Ctx) c2) (erased (List (Nat)) tids) (many (WF c1) wf) (erased (Grew c1 c2) g) (subterm erased (Tycons c1 tids) p) -> (erased (Tycons c2 tids) q))
  (match erased p _
    ((TyNil _) (TyNil _))
    ((TyCons _ tid rest t q2) (TyCons _ tid rest (tycon-grew c1 c2 tid wf g t) (tycons-grew c1 c2 rest wf g q2)))))
(def-fns _ $ (many tycon-of : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) tid) (erased (Tycon ctx tid) tc) ->
    (many (List (Entry)) pt) (many (Term) tty) (erased (TypeOf ctx tid tty) t) (erased (CanonAt ctx tty (TTyCtor pt)) c) (erased (Nat) pout) (erased (ScT ctx (Zero) pt pout) spt))
  (let-match erased tc (MkTycon _ _ _ _ _ _ _ _ pt0 eo))
  (let ((many tty) (erased k) (erased p) (erased _) (erased sty) (erased _) (erased ee) (erased eo2)) (type-of ctx wf tid (MkHas _ _ _ _ _ _ _ tid (ent-of-has _ tid _ _ eo))))
  (let-match erased ee (EntsOf _ _ _ _ _ _ _))
  (let-match erased (ent-of-unique _ tid tty k (TTyCtor pt0) (KDecl) eo2 eo) (SameEntRefl _ _))
  (let ((many u) (erased cn) (erased su)) (canonical ctx wf tty sty))
  (let-match erased cn (CanonicalBy _ _ _ r0 _ can))
  (let-match erased (canon-tyctor r0 pt0 u can) (ITC _))
  (let-match many u (TTyCtor pt))
  (let ((erased pd) (erased spt)) (sc-tyctor-parts ctx pt su))
  (values pt tty p cn pd spt))
(def-fns _ $ (many ctor-of : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) c) (erased (Ctor ctx c) cc) ->
    (many (List (Entry)) fs) (many (Term) ret) (many (Term) cty) (erased (TypeOf ctx c cty) t) (erased (CanonAt ctx cty (TValCtor fs ret)) cn) (erased (Nat) fout) (erased (ScT ctx (Zero) fs fout) sfs) (erased (Sc ctx fout ret) sret))
  (let-match erased cc (MkCtor _ _ _ _ _ _ _ _ fs0 r0 eo))
  (let ((many cty) (erased k) (erased p) (erased _) (erased sty) (erased _) (erased ee) (erased eo2)) (type-of ctx wf c (MkHas _ _ _ _ _ _ _ c (ent-of-has _ c _ _ eo))))
  (let-match erased ee (EntsOf _ _ _ _ _ _ _))
  (let-match erased (ent-of-unique _ c cty k (TValCtor fs0 r0) (KDecl) eo2 eo) (SameEntRefl _ _))
  (let ((many u) (erased cn) (erased su)) (canonical ctx wf cty sty))
  (let-match erased cn (CanonicalBy _ _ _ rl _ can))
  (let-match erased (canon-valctor rl fs0 r0 u can) (IVC _ _))
  (let-match many u (TValCtor fs ret))
  (let ((erased fd) (erased sfs) (erased sret)) (sc-valctor-parts ctx fs ret su))
  (values fs ret cty p cn fd sfs sret))

; A constructor's canonical return against its own type constructor and arity: a head that is not that
; type constructor differs from it outright, both being free of rules.
(def-adts
  ((RetDec : ((Ctx) ctx) ((Nat) tid) ((Nat) n) ((Term) c) -> Type)
    enum
    (many RetYes : (erased (Ctx) ctx) (erased (Nat) tid) (erased (Nat) n) (many (List (Entry)) tps) (many (List (Term)) args) (erased (Length (Term) args n) ln) -> (RetDec ctx tid n (TyApp (Ref tid) tps args)))
    (many RetNo : (erased (Ctx) ctx) (erased (Nat) tid) (erased (Nat) n) (erased (Term) c) (erased (BadRet ctx tid n c) p) -> (RetDec ctx tid n c))))
(def-fns _ $ (erased head-differ : (erased (Ctx) ctx) (erased (Term) h) (erased (Nat) tid) (erased (List (Ent)) e) (erased (Ents ctx e) ee) (erased (List (Rule)) r) (erased (Rules ctx r) rr) (erased (Canon r h h) chh)
    (erased (NonRef h) nr) (erased (NoRule r tid) nt) -> (erased (Differ ctx h (Ref tid)) d))
  (DifferBy ctx h (Ref tid) e r ee rr (UCheckRef e r h (Ref tid) (Nil _) (SR) tid h h (Ref tid) chh (CanFree r tid nt) (SidedR (Ref tid) h) nr)))
(def-fns _ $ (many ret-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) tid) (erased (Tycon ctx tid) tc) (many (Nat) n) (erased (Term) ret) (many (Term) c) (erased (CanonAt ctx ret c) cn) -> (many (RetDec ctx tid n c) r))
  (let-match many ctx (MkCtx nx s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ rp))
  (let-match erased tc (MkTycon _ _ _ _ _ _ _ _ pt eo))
  (let-match erased cn (CanonicalBy _ _ _ _ rr can))
  (let-match erased rr (RulesOf _ _ _ _ _ _ _))
  (let ((erased cc)) (canon-canonical r ret c can))
  (let ((erased nt)) (decl-no-rule e r tid (TTyCtor pt) eo rp))
  (let ((erased ee)) (EntsOf nx s e r a l sa))
  (let-match many (tyapp-dec c) (IsTyApp h hps as) ((IsNotTyApp _ na) (RetNo _ _ _ _ (BRNotApp ctx tid n c na))))
  (let-match erased cc (CnTyApp _ _ _ _ ch _))
  (let-match many h (Ref y)
    ((Bound k) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRBound k) nt))))
    ((TyApp h2 ps2 as2) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRTyApp h2 ps2 as2) nt))))
    ((ValApp h2 ps2 r2 as2) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRValApp h2 ps2 r2 as2) nt))))
    ((TUniv) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRUniv) nt))))
    ((TFn lv ps rs) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRFn lv ps rs) nt))))
    ((TTyCtor ps) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRTyCtor ps) nt))))
    ((TValCtor ps rt) (RetNo _ _ _ _ (BRHead ctx tid n h hps as (head-differ ctx h tid e ee r (RulesOf nx s e r a l sa) (canonical-fix r h ch) (NRValCtor ps rt) nt)))))
  (match many (nat-dec y tid) _
    ((NDSame _)
      (match many (not-len-dec n as) _
        ((LenIsNot _ _ nl) (RetNo _ _ _ _ (BRArity ctx tid n (Ref y) hps as nl)))
        ((LenIs _ _ ln) (RetYes _ _ _ hps as ln))))
    ((NDDiff _ _ nq)
      (match erased ch _
        ((CnRef _ _ ny)
          (RetNo _ _ _ _ (BRHead ctx tid n (Ref y) hps as (DifferBy ctx (Ref y) (Ref tid) e r ee (RulesOf nx s e r a l sa) (UCheckRefRef e r (Ref y) (Ref tid) (Nil _) y tid (CanFree r y ny) (CanFree r tid nt) nq)))))))))

; Why a canonical scrutinee type cannot be matched, or the declared type constructor at its head.
(def-adts
  ((MatchableDec : ((Ctx) ctx) ((Term) c) -> Type)
    enum
    (many MatchableYes : (erased (Ctx) ctx) (many (Nat) tc) (many (List (Entry)) tps) (many (List (Term)) targs) (many (List (Adt)) adts) (many (List (Nat)) ctors) (erased (Adts ctx adts) ad) (erased (AdtOf adts tc ctors) ao)
       (erased (Ctors ctx ctors) cs) -> (MatchableDec ctx (TyApp (Ref tc) tps targs)))
    (many MatchableNo : (erased (Ctx) ctx) (erased (Term) c) (erased (Unmatchable ctx c) p) -> (MatchableDec ctx c))))
(def-fns _ $ (many matchable-dec : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) c) -> (many (MatchableDec ctx c) r))
  (let-match many ctx (MkCtx nx s e r a l sa))
  (let-match many wf (MkWF _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ sa2 _ _ _ _))
  (let-match many (tyapp-dec c) (IsTyApp h hps as) ((IsNotTyApp _ na) (MatchableNo _ _ (UmNotApp ctx c na))))
  (let-match many h (Ref tc)
    ((Bound k) (MatchableNo _ _ (UmHeadVar ctx (Bound k) hps as (NRBound k))))
    ((TyApp h2 ps2 as2) (MatchableNo _ _ (UmHeadVar ctx (TyApp h2 ps2 as2) hps as (NRTyApp h2 ps2 as2))))
    ((ValApp h2 ps2 r2 as2) (MatchableNo _ _ (UmHeadVar ctx (ValApp h2 ps2 r2 as2) hps as (NRValApp h2 ps2 r2 as2))))
    ((TUniv) (MatchableNo _ _ (UmHeadVar ctx (TUniv) hps as (NRUniv))))
    ((TFn lv ps rs) (MatchableNo _ _ (UmHeadVar ctx (TFn lv ps rs) hps as (NRFn lv ps rs))))
    ((TTyCtor ps) (MatchableNo _ _ (UmHeadVar ctx (TTyCtor ps) hps as (NRTyCtor ps))))
    ((TValCtor ps rt) (MatchableNo _ _ (UmHeadVar ctx (TValCtor ps rt) hps as (NRValCtor ps rt)))))
  (let-match many (adt-dec a tc) (AdtHit _ _ ctors ao)
    ((AdtMiss _ _ n) (MatchableNo _ _ (UmNoAdt ctx tc hps as a (AdtsOf nx s e r a l sa) n))))
  (let ((erased _) (erased acs)) (adt-of-scoped e a tc ctors sa2 ao))
  (MatchableYes _ tc hps as a ctors (AdtsOf nx s e r a l sa) ao (MkCtors _ _ _ _ _ _ _ ctors acs)))

; A canonical proof type as a Predates or Subterm application, or why not.
(def-adts
  ((PShapeDec : ((Ctx) ctx) ((Term) c) -> Type)
    enum
    (many PSYes : (erased (Ctx) ctx) (erased (Term) c) (many (Term) ty) (many (Term) a) (many (Term) lv) (erased (PredatesShape ctx c ty a lv) p) (erased (Sc ctx (Zero) ty) sty) (erased (Sc ctx (Zero) a) sa) (erased (Sc ctx (Zero) lv) slv)
       -> (PShapeDec ctx c))
    (many PSNo : (erased (Ctx) ctx) (erased (Term) c) (erased (NotPredatesShape ctx c) p) -> (PShapeDec ctx c)))
  ((SShapeDec : ((Ctx) ctx) ((Term) c) -> Type)
    enum
    (many SSYes : (erased (Ctx) ctx) (erased (Term) c) (many (Term) ta) (many (Term) a) (many (Term) tb) (many (Term) b) (erased (SubtermShape ctx c ta a tb b) p)
       (erased (Sc ctx (Zero) ta) sta) (erased (Sc ctx (Zero) a) sa) (erased (Sc ctx (Zero) tb) stb) (erased (Sc ctx (Zero) b) sb) -> (SShapeDec ctx c))
    (many SSNo : (erased (Ctx) ctx) (erased (Term) c) (erased (NotSubtermShape ctx c) p) -> (SShapeDec ctx c))))
(def-fns _ $ (many predates-shape : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) c) (erased (Sc ctx (Zero) c) scc) -> (many (PShapeDec ctx c) r))
  (let ((erased h1) (erased _)) (sc-builtin ctx wf))
  (let-match many (tyapp-dec c) (IsTyApp h hps as) ((IsNotTyApp _ na) (PSNo _ _ (NPSNotApp ctx c na))))
  (let ((erased sh) (erased sas)) (sc-app-parts ctx _ h as (APTy h hps as) scc))
  (let-match many (not-len-dec (Succ (Succ (Succ (Zero)))) as) (LenIs _ _ ln)
    ((LenIsNot _ _ nl) (PSNo _ _ (NPSArity ctx h hps as nl))))
  (let-match many (same-dec ctx wf h (Ref (Succ (Zero))) sh (sc-ref ctx _ h1)) (SDSame _ _ _ ssh)
    ((SDDiffer _ _ _ df) (PSNo _ _ (NPSHead ctx h hps as df))))
  (let-match erased (len3 as ln) (MkAs3 _ _ _))
  (let-match many as (Cons _ ty rest1))
  (let-match many rest1 (Cons _ a rest2))
  (let-match many rest2 (Cons _ lv rest3))
  (let ((erased sty) (erased srest1)) (scl-parts ctx ty rest1 sas))
  (let ((erased sa) (erased srest2)) (scl-parts ctx a rest2 srest1))
  (let ((erased slv) (erased _)) (scl-parts ctx lv rest3 srest2))
  (PSYes ctx c ty a lv (PSBy ctx h hps ty a lv ssh) sty sa slv))
(def-fns _ $ (many subterm-shape : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) c) (erased (Sc ctx (Zero) c) scc) -> (many (SShapeDec ctx c) r))
  (let ((erased _) (erased h2)) (sc-builtin ctx wf))
  (let-match many (tyapp-dec c) (IsTyApp h hps as) ((IsNotTyApp _ na) (SSNo _ _ (NSSNotApp ctx c na))))
  (let ((erased sh) (erased sas)) (sc-app-parts ctx _ h as (APTy h hps as) scc))
  (let-match many (not-len-dec (Succ (Succ (Succ (Succ (Zero))))) as) (LenIs _ _ ln)
    ((LenIsNot _ _ nl) (SSNo _ _ (NSSArity ctx h hps as nl))))
  (let-match many (same-dec ctx wf h (Ref (Succ (Succ (Zero)))) sh (sc-ref ctx _ h2)) (SDSame _ _ _ ssh)
    ((SDDiffer _ _ _ df) (SSNo _ _ (NSSHead ctx h hps as df))))
  (let-match erased (len4 as ln) (MkAs4 _ _ _ _))
  (let-match many as (Cons _ ta rest1))
  (let-match many rest1 (Cons _ a rest2))
  (let-match many rest2 (Cons _ tb rest3))
  (let-match many rest3 (Cons _ b10 rest4))
  (let ((erased sta) (erased srest1)) (scl-parts ctx ta rest1 sas))
  (let ((erased sa) (erased srest2)) (scl-parts ctx a rest2 srest1))
  (let ((erased stb) (erased srest3)) (scl-parts ctx tb rest3 srest2))
  (let ((erased sb) (erased _)) (scl-parts ctx b10 rest4 srest3))
  (SSYes ctx c ta a tb b10 (SSBy ctx h hps ta a tb b10 ssh) sta sa stb sb))

; What each axiom concludes from two canonical proof types, with the evidence its rule wants; the
; derivation itself is assembled by [axiom-derivation], one case per axiom.
(def-adts
  ((AxiomOk : ((Key) k) ((Ctx) ctx1) ((Term) cp) ((Ctx) ctx2) ((Term) cq) ((Term) concl) -> Type)
    enum
    (many AOPredatesTrans : (erased (Ctx) ctx1) (erased (Term) cp) (erased (Ctx) ctx2) (erased (Term) cq) (erased (Term) ty) (erased (Term) a) (erased (Term) l1) (erased (Term) ty2) (erased (Term) l1b) (erased (Term) l2)
       (erased (PredatesShape ctx1 cp ty a l1) s1) (erased (PredatesShape ctx2 cq ty2 l1b l2) s2) (erased (Same ctx2 ty2 level-ty) st) (erased (Same ctx2 l1b l1) sl)
       -> (AxiomOk (KPredatesTrans) ctx1 cp ctx2 cq (TyApp (Ref (Succ (Zero))) predates-ps (Cons (Term) ty (Cons (Term) a (Cons (Term) l2 (Nil (Term))))))))
    (many AOSubtermTrans : (erased (Ctx) ctx1) (erased (Term) cp) (erased (Ctx) ctx2) (erased (Term) cq) (erased (Term) ta) (erased (Term) a) (erased (Term) tb) (erased (Term) b) (erased (Term) tb2) (erased (Term) b2) (erased (Term) tc) (erased (Term) c)
       (erased (SubtermShape ctx1 cp ta a tb b) s1) (erased (SubtermShape ctx2 cq tb2 b2 tc c) s2) (erased (Same ctx2 tb2 tb) st) (erased (Same ctx2 b2 b) sb)
       -> (AxiomOk (KSubtermTrans) ctx1 cp ctx2 cq (TyApp (Ref (Succ (Succ (Zero)))) subterm-ps (Cons (Term) ta (Cons (Term) a (Cons (Term) tc (Cons (Term) c (Nil (Term)))))))))
    (many AOPredatesSubterm : (erased (Ctx) ctx1) (erased (Term) cp) (erased (Ctx) ctx2) (erased (Term) cq) (erased (Term) ty) (erased (Term) a) (erased (Term) l) (erased (Term) tb) (erased (Term) b) (erased (Term) ty2) (erased (Term) a2)
       (erased (PredatesShape ctx1 cp ty a l) s1) (erased (SubtermShape ctx2 cq tb b ty2 a2) s2) (erased (Same ctx2 ty2 ty) st) (erased (Same ctx2 a2 a) sa)
       -> (AxiomOk (KPredatesSubterm) ctx1 cp ctx2 cq (TyApp (Ref (Succ (Zero))) predates-ps (Cons (Term) tb (Cons (Term) b (Cons (Term) l (Nil (Term)))))))))
  ((AxiomDec : ((Key) k) ((Ctx) ctx1) ((Term) cp) ((Ctx) ctx2) ((Term) cq) -> Type)
    enum
    (many AxOk : (erased (Key) k) (erased (Ctx) ctx1) (erased (Term) cp) (erased (Ctx) ctx2) (erased (Term) cq) (many (Term) concl) (erased (AxiomOk k ctx1 cp ctx2 cq concl) p) (erased (Sc ctx2 (Zero) concl) sc)
       -> (AxiomDec k ctx1 cp ctx2 cq))
    (many AxBad : (erased (Key) k) (erased (Ctx) ctx1) (erased (Term) cp) (erased (Ctx) ctx2) (erased (Term) cq) (erased (AxiomBad k ctx1 cp ctx2 cq) p) -> (AxiomDec k ctx1 cp ctx2 cq))))
(def-fns _ $ (many axiom-check : (many (Key) k) (many (Ctx) ctx1) (many (WF ctx1) wf1) (many (Term) cp) (erased (Sc ctx1 (Zero) cp) scp) (many (Ctx) ctx2) (many (WF ctx2) wf2) (erased (Grew ctx1 ctx2) g) (many (Term) cq) (erased (Sc ctx2 (Zero) cq) scq)
    (erased (AxiomKey k) ak) -> (many (AxiomDec k ctx1 cp ctx2 cq) r))
  (match many k _
    ((KPredatesTrans)
      (let-match many (predates-shape ctx1 wf1 cp scp) (PSYes _ _ ty a1 l1 s1 sty sa1 sl1)
        ((PSNo _ _ n) (AxBad _ _ _ _ _ (ABPredatesTransP ctx1 cp ctx2 cq n))))
      (let-match many (predates-shape ctx2 wf2 cq scq) (PSYes _ _ ty2 l1b l2 s2 sty2 sl1b sl2)
        ((PSNo _ _ n) (AxBad _ _ _ _ _ (ABPredatesTransQ ctx1 cp ctx2 cq n))))
      (let-match many (same-dec ctx2 wf2 ty2 level-ty sty2 (sc-level-ty ctx2 wf2)) (SDSame _ _ _ st)
        ((SDDiffer _ _ _ df) (AxBad _ _ _ _ _ (ABPredatesTransType ctx1 cp ctx2 cq ty2 l1b l2 s2 df))))
      (let-match many (same-dec ctx2 wf2 l1b l1 sl1b (sc-grew ctx1 ctx2 _ l1 g sl1)) (SDSame _ _ _ sl)
        ((SDDiffer _ _ _ df) (AxBad _ _ _ _ _ (ABPredatesTransLink ctx1 cp ctx2 cq ty a1 l1 ty2 l1b l2 s1 s2 df))))
      (AxOk _ _ _ _ _ (TyApp (Ref (Succ (Zero))) predates-ps (Cons _ ty (Cons _ a1 (Cons _ l2 (Nil _))))) (AOPredatesTrans ctx1 cp ctx2 cq ty a1 l1 ty2 l1b l2 s1 s2 st sl)
        (sc-predates ctx2 wf2 _ _ _ (sc-grew ctx1 ctx2 _ ty g sty) (sc-grew ctx1 ctx2 _ a1 g sa1) sl2)))
    ((KSubtermTrans)
      (let-match many (subterm-shape ctx1 wf1 cp scp) (SSYes _ _ ta a1 tb b1 s1 sta sa1 stb sb1)
        ((SSNo _ _ n) (AxBad _ _ _ _ _ (ABSubtermTransP ctx1 cp ctx2 cq n))))
      (let-match many (subterm-shape ctx2 wf2 cq scq) (SSYes _ _ tb2 b2 tc c1 s2 stb2 sb2 stc sc1)
        ((SSNo _ _ n) (AxBad _ _ _ _ _ (ABSubtermTransQ ctx1 cp ctx2 cq n))))
      (let-match many (same-dec ctx2 wf2 tb2 tb stb2 (sc-grew ctx1 ctx2 _ tb g stb)) (SDSame _ _ _ st)
        ((SDDiffer _ _ _ df) (AxBad _ _ _ _ _ (ABSubtermTransType ctx1 cp ctx2 cq ta a1 tb b1 tb2 b2 tc c1 s1 s2 df))))
      (let-match many (same-dec ctx2 wf2 b2 b1 sb2 (sc-grew ctx1 ctx2 _ b1 g sb1)) (SDSame _ _ _ sb)
        ((SDDiffer _ _ _ df) (AxBad _ _ _ _ _ (ABSubtermTransLink ctx1 cp ctx2 cq ta a1 tb b1 tb2 b2 tc c1 s1 s2 df))))
      (AxOk _ _ _ _ _ (TyApp (Ref (Succ (Succ (Zero)))) subterm-ps (Cons _ ta (Cons _ a1 (Cons _ tc (Cons _ c1 (Nil _)))))) (AOSubtermTrans ctx1 cp ctx2 cq ta a1 tb b1 tb2 b2 tc c1 s1 s2 st sb)
        (sc-subterm ctx2 wf2 _ _ _ _ (sc-grew ctx1 ctx2 _ ta g sta) (sc-grew ctx1 ctx2 _ a1 g sa1) stc sc1)))
    ((KPredatesSubterm)
      (let-match many (predates-shape ctx1 wf1 cp scp) (PSYes _ _ ty a1 l s1 sty sa1 sl)
        ((PSNo _ _ n) (AxBad _ _ _ _ _ (ABPredatesSubtermP ctx1 cp ctx2 cq n))))
      (let-match many (subterm-shape ctx2 wf2 cq scq) (SSYes _ _ tb b1 ty2 a2 s2 stb sb1 sty2 sa2)
        ((SSNo _ _ n) (AxBad _ _ _ _ _ (ABPredatesSubtermQ ctx1 cp ctx2 cq n))))
      (let-match many (same-dec ctx2 wf2 ty2 ty sty2 (sc-grew ctx1 ctx2 _ ty g sty)) (SDSame _ _ _ st)
        ((SDDiffer _ _ _ df) (AxBad _ _ _ _ _ (ABPredatesSubtermType ctx1 cp ctx2 cq ty a1 l tb b1 ty2 a2 s1 s2 df))))
      (let-match many (same-dec ctx2 wf2 a2 a1 sa2 (sc-grew ctx1 ctx2 _ a1 g sa1)) (SDSame _ _ _ sa)
        ((SDDiffer _ _ _ df) (AxBad _ _ _ _ _ (ABPredatesSubtermLink ctx1 cp ctx2 cq ty a1 l tb b1 ty2 a2 s1 s2 df))))
      (AxOk _ _ _ _ _ (TyApp (Ref (Succ (Zero))) predates-ps (Cons _ tb (Cons _ b1 (Cons _ l (Nil _))))) (AOPredatesSubterm ctx1 cp ctx2 cq ty a1 l tb b1 ty2 a2 s1 s2 st sa)
        (sc-predates ctx2 wf2 _ _ _ stb sb1 (sc-grew ctx1 ctx2 _ l g sl))))
    (absurd (KFn) ak) (absurd (KTyCtor) ak) (absurd (KValCtor) ak) (absurd (KIs) ak) (absurd (KSubterm) ak) (absurd (KPredates) ak) (absurd (KLet) ak) (absurd (KDefLvl) ak) (absurd (KDefFns) ak) (absurd (KDefAdts) ak) (absurd (KMatch) ak) (absurd (KValues) ak) (absurd (KProveSubterm) ak) (absurd (KProvePredates) ak)))

(def-fns _ $ (erased axiom-derivation : (erased (Ctx) ctx) (erased (Key) k) (erased (Sexp) pr) (erased (Sexp) qr) (erased (Ctx) ctx1) (erased (Core) pc) (erased (Nat) p) (erased (Term) pty) (erased (Term) cp)
    (erased (Ctx) ctx2) (erased (Core) qc) (erased (Nat) q) (erased (Term) qty) (erased (Term) cq) (erased (Nat) e) (erased (Ctx) out) (erased (Term) concl)
    (erased (ElabExpr ctx pr (EOk ctx1 pc (Cons (Nat) p (Nil (Nat))))) ep) (erased (TypeOf ctx1 p pty) tp) (erased (CanonAt ctx1 pty cp) c1)
    (erased (ElabExpr ctx1 qr (EOk ctx2 qc (Cons (Nat) q (Nil (Nat))))) eq) (erased (TypeOf ctx2 q qty) tq) (erased (CanonAt ctx2 qty cq) c2)
    (erased (AxiomOk k ctx1 cp ctx2 cq concl) ok) (erased (Mint ctx2 (None (String)) concl (KPlain) (None (Term)) e out) m) ->
    (erased (ElabExpr ctx (RList (Cons (Sexp) (RKey k) (Cons (Sexp) pr (Cons (Sexp) qr (Nil (Sexp)))))) (EOk out (CToken) (Cons (Nat) e (Nil (Nat))))) d))
  (match erased ok _
    ((AOPredatesTrans _ _ _ _ ty a l1 ty2 l1b l2 s1 s2 st sl) (EXPredatesTrans ctx pr qr ctx1 pc p pty cp ty a l1 ctx2 qc q qty cq ty2 l1b l2 e out ep tp c1 s1 eq tq c2 s2 st sl m))
    ((AOSubtermTrans _ _ _ _ ta a tb b tb2 b2 tc c s1 s2 st sb) (EXSubtermTrans ctx pr qr ctx1 pc p pty cp ta a tb b ctx2 qc q qty cq tb2 b2 tc c e out ep tp c1 s1 eq tq c2 s2 st sb m))
    ((AOPredatesSubterm _ _ _ _ ty a l tb b ty2 a2 s1 s2 st sa) (EXPredatesSubterm ctx pr qr ctx1 pc p pty cp ty a l ctx2 qc q qty cq tb b ty2 a2 e out ep tp c1 s1 eq tq c2 s2 st sa m))))

; ---- Expressions, statements, bodies and declarations: one function per judgment. Beside each outcome
; that carries a context out, its well-formedness and growth, and that the ids it names are entries.

(def-adts
  ((ESc : ((Ctx) ctx) ((EOut) out) -> Type)
    enum
    (many ESOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (Core) core) (erased (List (Nat)) ids) (many (WF out) wf) (erased (Grew ctx out) g) (erased (HasAll out ids) h) -> (ESc ctx (EOk out core ids)))
    (many ESErr : (erased (Ctx) ctx) (erased (Reason) r) -> (ESc ctx (EErr r))))
  ((AOSc : ((Ctx) ctx) ((AOut) out) -> Type)
    enum
    (many AOOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (Core)) cores) (erased (List (Nat)) ids) (many (WF out) wf) (erased (Grew ctx out) g) (erased (HasAll out ids) h) -> (AOSc ctx (AllOk out cores ids)))
    (many AOErr : (erased (Ctx) ctx) (erased (Reason) r) -> (AOSc ctx (AErr r))))
  ((ArgsLen : ((List (Entry)) tele) ((AOut) out) -> Type)
    enum
    (many ArgLenOk : (erased (List (Entry)) tele) (erased (Ctx) out) (erased (List (Core)) cores) (erased (List (Nat)) ids) (erased (LenEq (Entry) (Nat) tele ids) le) -> (ArgsLen tele (AllOk out cores ids)))
    (many ArgLenErr : (erased (List (Entry)) tele) (erased (Reason) r) -> (ArgsLen tele (AErr r))))
  ((NilCores : ((AOut) out) -> Type)
    enum
    (many NCOk : (erased (Ctx) out) (erased (List (Nat)) ids) -> (NilCores (AllOk out (Nil (Core)) ids)))
    (many NCErr : (erased (Reason) r) -> (NilCores (AErr r))))
  ((SSc : ((Ctx) ctx) ((SOut) out) -> Type)
    enum
    (many SSOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (Stmt) st) (many (WF out) wf) (erased (Grew ctx out) g) -> (SSc ctx (SOk out st)))
    (many SSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (SSc ctx (SErr r))))
  ((DSc : ((Ctx) ctx) ((DOut) out) -> Type)
    enum
    (many DSOk : (erased (Ctx) ctx) (erased (Ctx) out) (many (WF out) wf) (erased (Grew ctx out) g) -> (DSc ctx (DOk out)))
    (many DSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (DSc ctx (DErr r))))
  ((BrSc : ((Ctx) ctx) ((BrOut) out) -> Type)
    enum
    (many BrSOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (Branch)) bs) (erased (List (Nat)) seen) (many (WF out) wf) (erased (Grew ctx out) g) -> (BrSc ctx (BrOk out bs seen)))
    (many BrSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (BrSc ctx (BrErr r))))
  ((SigsSc : ((Ctx) ctx) ((List (Sig)) sigs) -> Type)
    enum
    (many SigsNil : (erased (Ctx) ctx) -> (SigsSc ctx (Nil (Sig))))
    (many SigsCons : (erased (Ctx) ctx) (erased (Nat) fid) (erased (List (Entry)) pt) (erased (List (Maybe (String))) pn) (erased (List (Entry)) rt) (erased (List (Sig)) sigs)
       (erased (Nat) d1) (erased (Nat) d2) (erased (ScT ctx (Zero) pt d1) spt) (erased (ScT ctx d1 rt d2) srt) (erased (LenEq (Entry) (Maybe (String)) pt pn) lpn) (erased (SigsSc ctx sigs) q) -> (SigsSc ctx (Cons (Sig) (MkSig fid pt pn rt) sigs))))
  ((FSc : ((Ctx) ctx) ((FOut) out) -> Type)
    enum
    (many FSOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (Sig)) sigs) (many (WF out) wf) (erased (Grew ctx out) g) (erased (SigsSc out sigs) ss) -> (FSc ctx (FOk out sigs)))
    (many FSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (FSc ctx (FErr r))))
  ((FnsLen : ((List (Sexp)) defs) ((FOut) out) -> Type)
    enum
    (many FLOk : (erased (List (Sexp)) defs) (erased (Ctx) out) (erased (List (Sig)) sigs) (erased (LenEq (Sexp) (Sig) defs sigs) le) -> (FnsLen defs (FOk out sigs)))
    (many FLErr : (erased (List (Sexp)) defs) (erased (Reason) r) -> (FnsLen defs (FErr r))))
  ((BsSc : ((Ctx) ctx) ((BsOut) out) -> Type)
    enum
    (many BsSOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (FnDef)) fds) (many (WF out) wf) (erased (Grew ctx out) g) -> (BsSc ctx (BsOk out fds)))
    (many BsSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (BsSc ctx (BsErr r))))
  ((TySc : ((Ctx) ctx) ((List (Sexp)) decls) ((FOutT) out) -> Type)
    enum
    (many TySOk : (erased (Ctx) ctx) (erased (List (Sexp)) decls) (erased (Ctx) out) (erased (List (Nat)) tids) (many (WF out) wf) (erased (Grew ctx out) g) (erased (Tycons out tids) ty) (erased (LenEq (Sexp) (Nat) decls tids) le)
       -> (TySc ctx decls (FOkT out tids)))
    (many TySErr : (erased (Ctx) ctx) (erased (List (Sexp)) decls) (erased (Reason) r) -> (TySc ctx decls (FErrT r))))
  ((CSc : ((Ctx) ctx) ((FOutT) out) -> Type)
    enum
    (many CSOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (Nat)) ids) (many (WF out) wf) (erased (Grew ctx out) g) -> (CSc ctx (FOkT out ids)))
    (many CSErr : (erased (Ctx) ctx) (erased (Reason) r) -> (CSc ctx (FErrT r))))
  ((DCSc : ((Ctx) ctx) ((FOutT) out) -> Type)
    enum
    (many DCOk : (erased (Ctx) ctx) (erased (Ctx) out) (erased (List (Nat)) cids) (many (WF out) wf) (erased (Grew ctx out) g) (erased (Ctors out cids) cs) -> (DCSc ctx (FOkT out cids)))
    (many DCErr : (erased (Ctx) ctx) (erased (Reason) r) -> (DCSc ctx (FErrT r)))))

(def-adts
  ((ExprDec : ((Ctx) ctx) ((Sexp) raw) -> Type)
    enum
    (many MkExprDec : (erased (Ctx) ctx) (erased (Sexp) raw) (many (EOut) out) (erased (ElabExpr ctx raw out) p) (many (ESc ctx out) sc) -> (ExprDec ctx raw))
    (many ExprStuck : (erased (Ctx) ctx) (erased (Sexp) raw) -> (ExprDec ctx raw)))
  ((ItemsDec : ((Ctx) ctx) ((List (Sexp)) raws) -> Type)
    enum
    (many MkItemsDec : (erased (Ctx) ctx) (erased (List (Sexp)) raws) (many (AOut) out) (erased (ElabItems ctx raws out) p) (many (AOSc ctx out) sc) -> (ItemsDec ctx raws))
    (many ItemsStuck : (erased (Ctx) ctx) (erased (List (Sexp)) raws) -> (ItemsDec ctx raws)))
  ((ExprArgsDec : ((Ctx) ctx) ((List (Maybe (Term))) acc) ((List (Entry)) tele) ((List (Sexp)) args) -> Type)
    enum
    (many MkExprArgsDec : (erased (Ctx) ctx) (erased (List (Maybe (Term))) acc) (erased (List (Entry)) tele) (erased (List (Sexp)) args) (many (AOut) out) (erased (ElabExprArgs ctx acc tele args out) p)
       (many (AOSc ctx out) sc) (erased (ArgsLen tele out) al) -> (ExprArgsDec ctx acc tele args))
    (many ExprArgsStuck : (erased (Ctx) ctx) (erased (List (Maybe (Term))) acc) (erased (List (Entry)) tele) (erased (List (Sexp)) args) -> (ExprArgsDec ctx acc tele args)))
  ((DecreaseDec : ((Ctx) ctx) ((Term) l) ((List (Entry)) ps) ((List (Nat)) ids) ((Ann) ann) -> Type)
    enum
    (many MkDecreaseDec : (erased (Ctx) ctx) (erased (Term) l) (erased (List (Entry)) ps) (erased (List (Nat)) ids) (erased (Ann) ann) (many (DOut) out) (erased (Decrease ctx l ps ids ann out) p) (many (DSc ctx out) sc)
       -> (DecreaseDec ctx l ps ids ann))
    (many DecreaseStuck : (erased (Ctx) ctx) (erased (Term) l) (erased (List (Entry)) ps) (erased (List (Nat)) ids) (erased (Ann) ann) -> (DecreaseDec ctx l ps ids ann)))
  ((BranchesDec : ((Ctx) ctx) ((Nat) s) ((Nat) tc) ((List (Nat)) ctors) ((List (Nat)) seen) ((List (Entry)) rt) ((List (Sexp)) brs) -> Type)
    enum
    (many MkBranchesDec : (erased (Ctx) ctx) (erased (Nat) s) (erased (Nat) tc) (erased (List (Nat)) ctors) (erased (List (Nat)) seen) (erased (List (Entry)) rt) (erased (List (Sexp)) brs) (many (BrOut) out)
       (erased (ElabBranches ctx s tc ctors seen rt brs out) p) (many (BrSc ctx out) sc) -> (BranchesDec ctx s tc ctors seen rt brs))
    (many BranchesStuck : (erased (Ctx) ctx) (erased (Nat) s) (erased (Nat) tc) (erased (List (Nat)) ctors) (erased (List (Nat)) seen) (erased (List (Entry)) rt) (erased (List (Sexp)) brs) -> (BranchesDec ctx s tc ctors seen rt brs)))
  ((CoveredDec : ((Ctx) ctx) ((Nat) s) ((List (Nat)) ctors) ((List (Nat)) seen) -> Type)
    enum
    (many CovYes : (erased (Ctx) ctx) (erased (Nat) s) (erased (List (Nat)) ctors) (erased (List (Nat)) seen) (erased (Covered ctx s ctors seen) p) -> (CoveredDec ctx s ctors seen))
    (many CovNo : (erased (Ctx) ctx) (erased (Nat) s) (erased (List (Nat)) ctors) (erased (List (Nat)) seen) (erased (Uncovered ctx s ctors seen) p) -> (CoveredDec ctx s ctors seen)))
  ((RefutedDec : ((Ctx) ctx) ((Nat) s) ((Nat) c) -> Type)
    enum
    (many RefYes : (erased (Ctx) ctx) (erased (Nat) s) (erased (Nat) c) (erased (Refuted ctx s c) p) -> (RefutedDec ctx s c))
    (many RefNo : (erased (Ctx) ctx) (erased (Nat) s) (erased (Nat) c) (erased (Reachable ctx s c) p) -> (RefutedDec ctx s c)))
  ((BodyDec : ((Ctx) ctx) ((List (Sexp)) items) -> Type)
    enum
    (many MkBodyDec : (erased (Ctx) ctx) (erased (List (Sexp)) items) (many (EOut) out) (erased (ElabBody ctx items out) p) (many (ESc ctx out) sc) -> (BodyDec ctx items))
    (many BodyStuck : (erased (Ctx) ctx) (erased (List (Sexp)) items) -> (BodyDec ctx items)))
  ((StmtDec : ((Ctx) ctx) ((Sexp) raw) -> Type)
    enum
    (many MkStmtDec : (erased (Ctx) ctx) (erased (Sexp) raw) (many (SOut) out) (erased (ElabStmt ctx raw out) p) (many (SSc ctx out) sc) -> (StmtDec ctx raw))
    (many StmtStuck : (erased (Ctx) ctx) (erased (Sexp) raw) -> (StmtDec ctx raw)))
  ((BindLetDec : ((Ctx) ctx) ((List (Sexp)) binders) ((List (Nat)) ids) -> Type)
    enum
    (many MkBindLetDec : (erased (Ctx) ctx) (erased (List (Sexp)) binders) (erased (List (Nat)) ids) (many (AOut) out) (erased (BindLet ctx binders ids out) p) (many (AOSc ctx out) sc) (erased (NilCores out) nc)
       -> (BindLetDec ctx binders ids))
    (many BindLetStuck : (erased (Ctx) ctx) (erased (List (Sexp)) binders) (erased (List (Nat)) ids) -> (BindLetDec ctx binders ids)))
  ((FnsDec : ((Ctx) ctx) ((Term) l) ((List (Sexp)) defs) -> Type)
    enum
    (many MkFnsDec : (erased (Ctx) ctx) (erased (Term) l) (erased (List (Sexp)) defs) (many (FOut) out) (erased (MintFns ctx l defs out) p) (many (FSc ctx out) sc) (erased (FnsLen defs out) fl) -> (FnsDec ctx l defs))
    (many FnsStuck : (erased (Ctx) ctx) (erased (Term) l) (erased (List (Sexp)) defs) -> (FnsDec ctx l defs)))
  ((BodiesDec : ((Ctx) ctx) ((Term) l) ((List (Sig)) sigs) ((List (Sexp)) defs) -> Type)
    enum
    (many MkBodiesDec : (erased (Ctx) ctx) (erased (Term) l) (erased (List (Sig)) sigs) (erased (List (Sexp)) defs) (many (BsOut) out) (erased (ElabBodies ctx l sigs defs out) p) (many (BsSc ctx out) sc) -> (BodiesDec ctx l sigs defs))
    (many BodiesStuck : (erased (Ctx) ctx) (erased (Term) l) (erased (List (Sig)) sigs) (erased (List (Sexp)) defs) -> (BodiesDec ctx l sigs defs)))
  ((TyconsDec : ((Ctx) ctx) ((List (Sexp)) decls) -> Type)
    enum
    (many MkTyconsDec : (erased (Ctx) ctx) (erased (List (Sexp)) decls) (many (FOutT) out) (erased (MintTycons ctx decls out) p) (many (TySc ctx decls out) sc) -> (TyconsDec ctx decls))
    (many TyconsStuck : (erased (Ctx) ctx) (erased (List (Sexp)) decls) -> (TyconsDec ctx decls)))
  ((CtorsDec : ((Ctx) ctx) ((List (Sexp)) decls) ((List (Nat)) tids) -> Type)
    enum
    (many MkCtorsDec : (erased (Ctx) ctx) (erased (List (Sexp)) decls) (erased (List (Nat)) tids) (many (FOutT) out) (erased (MintCtors ctx decls tids out) p) (many (CSc ctx out) sc) -> (CtorsDec ctx decls tids))
    (many CtorsStuck : (erased (Ctx) ctx) (erased (List (Sexp)) decls) (erased (List (Nat)) tids) -> (CtorsDec ctx decls tids)))
  ((DeclCtorsDec : ((Ctx) ctx) ((Nat) tid) ((Nat) n) ((List (Sexp)) ctors) -> Type)
    enum
    (many MkDeclCtorsDec : (erased (Ctx) ctx) (erased (Nat) tid) (erased (Nat) n) (erased (List (Sexp)) ctors) (many (FOutT) out) (erased (MintDeclCtors ctx tid n ctors out) p) (many (DCSc ctx out) sc) -> (DeclCtorsDec ctx tid n ctors))
    (many DeclCtorsStuck : (erased (Ctx) ctx) (erased (Nat) tid) (erased (Nat) n) (erased (List (Sexp)) ctors) -> (DeclCtorsDec ctx tid n ctors))))

(def-fns _ $ (erased sigs-grew : (erased (Ctx) c1) (erased (Ctx) c2) (erased (List (Sig)) sigs) (erased (Grew c1 c2) g) (subterm erased (SigsSc c1 sigs) p) -> (erased (SigsSc c2 sigs) q))
  (match erased p _
    ((SigsNil _) (SigsNil _))
    ((SigsCons _ fid pt pn rt rest _ _ spt srt lpn q2) (SigsCons _ fid pt pn rt rest _ _ (sct-grew c1 c2 _ pt _ g spt) (sct-grew c1 c2 _ rt _ g srt) lpn (sigs-grew c1 c2 rest g q2)))))

; The results of a body against a return telescope.
(def-fns _ $ (erased arglen-ok : (erased (List (Entry)) tele) (erased (Ctx) out) (erased (List (Core)) cores) (erased (List (Nat)) ids) (erased (ArgsLen tele (AllOk out cores ids)) al) -> (erased (LenEq (Entry) (Nat) tele ids) le))
  (match erased al _ ((ArgLenOk _ _ _ _ le) le)))
(def-fns _ $ (many check-rets : (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Maybe (Term))) acc) (erased (Nat) m) (erased (ScS ctx acc m) sacc) (subterm many (List (Entry)) rets) (erased (Nat) out) (erased (ScT ctx m rets out) srets) (many (List (Nat)) ids)
    (erased (HasAll ctx ids) hids) -> (many (ROut) rout) (erased (CheckRets ctx acc rets ids rout) p))
  (let-match many (len-dec _ _ rets ids) (LenSame _ _ _ _ le)
    ((LenDiff _ _ _ _ m8) (values (RErr (RSize)) (CRSize ctx acc rets ids m8))))
  (let-match many rets (Cons _ entry es)
    ((Nil _) (match many ids _ ((Nil _) (values (ROk) (CRNil ctx acc))) (absurd (Cons _ _ _) le))))
  (let-match many ids (Cons _ x rest) (absurd (Nil _) le))
  (let-match many entry (MkEntry s i t))
  (let ((erased st) (erased ses)) (sct-parts ctx _ _ s i t es srets))
  (let ((erased hx) (erased hrest)) (has-all-parts ctx x rest hids))
  (let ((many t2) (erased sb)) (subst acc _ (scs-length ctx acc _ sacc) t (sc-closed ctx _ t st)))
  (let ((erased st2)) (sc-subst ctx acc _ t t2 sacc st sb))
  (let ((erased sacc2)) (scs-cons ctx (Ref x) acc _ (sc-ref ctx x hx) sacc))
  (match many i _
    ((BFalse)
      (let ((many xty) (many _) (erased ty) (erased _) (erased sxty) (erased _) (erased _) (erased _)) (type-of ctx wf x hx))
      (let-match many (same-dec ctx wf xty t2 sxty st2) (SDSame _ _ _ sm)
        ((SDDiffer _ _ _ d2) (values (RErr (RMismatch)) (CRTyMismatch ctx acc s t es x rest xty t2 ty sb d2))))
      (let ((many out3) (erased q)) (tail $ check-rets ctx wf (Cons _ (Some _ (Ref x)) acc) _ sacc2 es _ ses rest hrest))
      (values out3 (CRTy ctx acc s t es x rest xty t2 out3 ty sb sm q)))
    ((BTrue)
      (let-match many (same-dec ctx wf (Ref x) t2 (sc-ref ctx x hx) st2) (SDSame _ _ _ sm)
        ((SDDiffer _ _ _ d2) (values (RErr (RMismatch)) (CRIsMismatch ctx acc s t es x rest t2 sb d2))))
      (let ((many out3) (erased q)) (tail $ check-rets ctx wf (Cons _ (Some _ (Ref x)) acc) _ sacc2 es _ ses rest hrest))
      (values out3 (CRIs ctx acc s t es x rest t2 out3 sb sm q)))))

; The binders of a let, each aliasing one value.
(def-fns _ $ (many bind-let : (many (Ctx) ctx) (many (WF ctx) wf) (subterm many (List (Sexp)) binders) (many (List (Nat)) ids) (erased (HasAll ctx ids) hids) -> (many (BindLetDec ctx binders ids) r))
  (let-match many (len-dec _ _ binders ids) (LenSame _ _ _ _ le)
    ((LenDiff _ _ _ _ m) (MkBindLetDec _ _ _ (AErr (RSize)) (BLSize ctx binders ids m) (AOErr _ _) (NCErr _))))
  (let-match many binders (Cons _ b10 brest)
    ((Nil _) (match many ids _ ((Nil _) (MkBindLetDec _ _ _ (AllOk ctx (Nil _) (Nil _)) (BLNil ctx) (AOOk _ _ _ _ wf (grew-refl ctx) (has-all-nil ctx)) (NCOk _ _))) (absurd (Cons _ _ _) le))))
  (let-match many ids (Cons _ id irest) (absurd (Nil _) le))
  (let ((erased hid) (erased hirest)) (has-all-parts ctx id irest hids))
  (let ((many ty) (many _) (erased t) (erased _) (erased sty) (erased _) (erased _) (erased _)) (type-of ctx wf id hid))
  (match many b10 _
    ((RAtom x)
      (let ((many aid) (many ctx1) (erased m) (many wf1) (erased g1) (erased eis)) (mint ctx wf (Some _ x) ty (KPlain) (Some _ (Ref id)) sty (scm-some ctx (Ref id) (sc-ref ctx id hid)) (ROkSome _ _ (NDPlain))))
      (let-match many (notail $ bind-let ctx1 wf1 brest irest (has-all-grew ctx ctx1 irest g1 hirest)) (MkBindLetDec _ _ _ rout q rsc nc)
        ((BindLetStuck _ _ _) (BindLetStuck _ _ _)))
      (let-match many rout (AllOk out _ aids)
        ((AErr r) (MkBindLetDec _ _ _ (AErr r) (BLRestErr ctx (RAtom x) brest id irest x ty aid ctx1 r (BNAtom x) t m q) (AOErr _ _) (NCErr _))))
      (let-match erased nc (NCOk _ _))
      (let-match many rsc (AOOk _ _ _ _ wf2 g2 h2b))
      (MkBindLetDec _ _ _ (AllOk out (Nil _) (Cons _ aid aids)) (BLName ctx x brest id irest ty aid ctx1 out aids t m q)
        (AOOk _ _ _ _ wf2 (grew-trans ctx ctx1 out g1 g2) (has-all-cons out aid aids (has-grew ctx1 out aid g2 (entis-has ctx1 aid _ _ eis)) h2b)) (NCOk _ _)))
    (else
      (let-match many (entry-dec b10) (EntryShape _ s i tr x shape _) ((EntryNot _) (BindLetStuck _ _ _)))
      (let-match many s (BFalse) ((BTrue) (BindLetStuck _ _ _)))
      (let-match many (elab-term ctx wf tr (POuter (PInner))) (MkTermDec _ _ tout et tsc) ((TermStuck _ _) (BindLetStuck _ _ _)))
      (let-match many tout (TOk t0 tty)
        ((TErr r) (MkBindLetDec _ _ _ (AErr r) (BLTermErr ctx b10 i tr x brest id irest r shape et) (AOErr _ _) (NCErr _))))
      (let-match erased tsc (TSOk _ _ _ st0 _))
      (match many i _
        ((BFalse)
          (let-match many (same-dec ctx wf ty t0 sty st0) (SDSame _ _ _ sm)
            ((SDDiffer _ _ _ d2) (MkBindLetDec _ _ _ (AErr (RMismatch)) (BLTyMismatch ctx b10 tr x brest id irest t0 tty ty shape et t d2) (AOErr _ _) (NCErr _))))
          (let ((many aid) (many ctx1) (erased m) (many wf1) (erased g1) (erased eis)) (mint ctx wf (Some _ x) ty (KPlain) (Some _ (Ref id)) sty (scm-some ctx (Ref id) (sc-ref ctx id hid)) (ROkSome _ _ (NDPlain))))
          (let-match many (notail $ bind-let ctx1 wf1 brest irest (has-all-grew ctx ctx1 irest g1 hirest)) (MkBindLetDec _ _ _ rout q rsc nc)
            ((BindLetStuck _ _ _) (BindLetStuck _ _ _)))
          (let-match many rout (AllOk out _ aids)
            ((AErr r) (MkBindLetDec _ _ _ (AErr r) (BLRestErr ctx b10 brest id irest x ty aid ctx1 r (BNEntry b10 (BFalse) tr x shape) t m q) (AOErr _ _) (NCErr _))))
          (let-match erased nc (NCOk _ _))
          (let-match many rsc (AOOk _ _ _ _ wf2 g2 h2b))
          (MkBindLetDec _ _ _ (AllOk out (Nil _) (Cons _ aid aids)) (BLTy ctx b10 tr x brest id irest t0 tty ty aid ctx1 out aids shape et t sm m q)
            (AOOk _ _ _ _ wf2 (grew-trans ctx ctx1 out g1 g2) (has-all-cons out aid aids (has-grew ctx1 out aid g2 (entis-has ctx1 aid _ _ eis)) h2b)) (NCOk _ _)))
        ((BTrue)
          (let-match many (same-dec ctx wf (Ref id) t0 (sc-ref ctx id hid) st0) (SDSame _ _ _ sm)
            ((SDDiffer _ _ _ d2) (MkBindLetDec _ _ _ (AErr (RMismatch)) (BLIsMismatch ctx b10 tr x brest id irest t0 tty shape et d2) (AOErr _ _) (NCErr _))))
          (let ((many aid) (many ctx1) (erased m) (many wf1) (erased g1) (erased eis)) (mint ctx wf (Some _ x) ty (KPlain) (Some _ (Ref id)) sty (scm-some ctx (Ref id) (sc-ref ctx id hid)) (ROkSome _ _ (NDPlain))))
          (let-match many (notail $ bind-let ctx1 wf1 brest irest (has-all-grew ctx ctx1 irest g1 hirest)) (MkBindLetDec _ _ _ rout q rsc nc)
            ((BindLetStuck _ _ _) (BindLetStuck _ _ _)))
          (let-match many rout (AllOk out _ aids)
            ((AErr r) (MkBindLetDec _ _ _ (AErr r) (BLRestErr ctx b10 brest id irest x ty aid ctx1 r (BNEntry b10 (BTrue) tr x shape) t m q) (AOErr _ _) (NCErr _))))
          (let-match erased nc (NCOk _ _))
          (let-match many rsc (AOOk _ _ _ _ wf2 g2 h2b))
          (MkBindLetDec _ _ _ (AllOk out (Nil _) (Cons _ aid aids)) (BLIs ctx b10 tr x brest id irest t0 tty ty aid ctx1 out aids shape et t sm m q)
            (AOOk _ _ _ _ wf2 (grew-trans ctx ctx1 out g1 g2) (has-all-cons out aid aids (has-grew ctx1 out aid g2 (entis-has ctx1 aid _ _ eis)) h2b)) (NCOk _ _)))))))

; A constructor refuted by the facts, or reachable; every constructor covered.
(def-fns _ $ (many refuted : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) s) (erased (Has ctx s) hs) (many (Nat) c) (erased (Ctor ctx c) cc) -> (many (RefutedDec ctx s c) r))
  (let ((many fs) (many ret) (erased cty) (erased t) (erased cn) (erased _) (erased sfs) (erased sret)) (ctor-of ctx wf c cc))
  (let ((many names) (erased nn) (erased ln)) (nones fs))
  (let-match many (mint-tele ctx wf (Nil _) _ (scs-nil ctx) fs _ sfs names ln) (MTMinted _ _ _ _ ctxF fids wfF gF hfids le mt))
  (let ((many frefs) (erased rf)) (refs fids))
  (let ((erased sfrefs)) (refs-scoped ctxF fids frefs hfids rf))
  (match many (refine ctxF wfF (Ref s) (ValApp (Ref c) fs ret frefs) (sc-ref ctxF s (has-grew ctx ctxF s gF hs)) (sc-valapp ctxF (Ref c) fs ret frefs _ (sc-ref ctxF c (has-grew ctx ctxF c gF (ctor-has ctx c cc))) (sct-grew ctx ctxF _ fs _ gF sfs) (sc-grew ctx ctxF _ ret gF sret) sfrefs (refs-len-eq fs fids frefs le rf))) _
    ((RDContradicted _ _ _ cd) (RefYes _ _ _ (RefutedBy ctx s c cty fs ret names ctxF fids frefs t cn nn mt rf cd)))
    ((RDRefined _ _ _ ctxR _ _ rf2) (RefNo _ _ _ (ReachableBy ctx s c cty fs ret names ctxF fids frefs ctxR t cn nn mt rf rf2)))))
(def-fns _ $ (many covered : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) s) (erased (Has ctx s) hs) (subterm many (List (Nat)) ctors) (erased (Ctors ctx ctors) cs) (many (List (Nat)) seen) -> (many (CoveredDec ctx s ctors seen) r))
  (let-match many ctors (Cons _ c rest) ((Nil _) (CovYes _ _ _ _ (CvNil ctx s seen))))
  (match many (mem-dec c seen) _
    ((MemYes _ _ m)
      (match many (notail $ covered ctx wf s hs rest (ctors-parts ctx c rest cs) seen) _
        ((CovYes _ _ _ _ p) (CovYes _ _ _ _ (CvSeen ctx s c rest seen m p)))
        ((CovNo _ _ _ _ p) (CovNo _ _ _ _ (UcThere ctx s c rest seen p)))))
    ((MemNo _ _ nm)
      (let-match many (refuted ctx wf s hs c (ctors-head ctx c rest cs)) (RefYes _ _ _ rf)
        ((RefNo _ _ _ rc) (CovNo _ _ _ _ (UcHere ctx s c rest seen nm rc))))
      (match many (notail $ covered ctx wf s hs rest (ctors-parts ctx c rest cs) seen) _
        ((CovYes _ _ _ _ p) (CovYes _ _ _ _ (CvRefuted ctx s c rest seen nm rf p)))
        ((CovNo _ _ _ _ p) (CovNo _ _ _ _ (UcThere ctx s c rest seen p)))))))

; A def-fns's signatures.
(def-fns _
  ((many mint-fns : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) l) (erased (Sc ctx (Zero) l) sl) (subterm many (List (Sexp)) defs) (subterm erased (POuter (PInner)) is _ph) -> (many (FnsDec ctx l defs) r))
    (let-match many defs (Cons _ def rest)
      ((Nil _) (MkFnsDec _ _ _ (FOk ctx (Nil _)) (MFNil ctx l) (FSOk _ _ _ wf (grew-refl ctx) (SigsNil _)) (FLOk _ _ _ (LENil _ _)))))
    (let-match many def (RList ditems) (else (FnsStuck _ _ _)))
    (let-match many ditems (Cons _ fr d1) (else (FnsStuck _ _ _)))
    (let-match many d1 (Cons _ pr d2) (else (FnsStuck _ _ _)))
    (let-match many d2 (Cons _ rr items) (else (FnsStuck _ _ _)))
    (let-match many fr (RAtom fn) (else (FnsStuck _ _ _)))
    (let-match many pr (RList ps) (else (FnsStuck _ _ _)))
    (match many rr _
      ((RList rs) (tail $ mint-fn ctx wf l sl fn ps rs items rest defs (PInner)))
      (else (FnsStuck _ _ _))))
  ((many mint-fn : (many (Ctx) ctx) (many (WF ctx) wf) (many (Term) l) (erased (Sc ctx (Zero) l) sl) (many (String) fn) (many (List (Sexp)) ps) (many (List (Sexp)) rs) (erased (List (Sexp)) items) (many (List (Sexp)) rest)
      (subterm erased (Cons (Sexp) (RList (Cons (Sexp) (RAtom fn) (Cons (Sexp) (RList ps) (Cons (Sexp) (RList rs) items)))) rest) is defs) (subterm erased (PInner) is _ph) -> (many (FnsDec ctx l defs) r))
    (let-match many (elab-tele ctx ctx wf (Nil _) _ (cov-refl ctx) ps (POuter (PInner))) (MkTeleDec _ _ _ _ _ pout ep psc)
      ((TeleStuck _ _ _ _ _) (FnsStuck _ _ _)))
    (let-match many pout (TeleOk ctxP pt pids pn)
      ((TeleErr r) (MkFnsDec _ _ _ (FErr r) (MFParamsErr ctx l fn ps rs items rest r ep) (FSErr _ _) (FLErr _ _))))
    (let-match many psc (TLOk _ _ _ _ _ _ _ _ _ wfP cr spt li ln))
    (let ((many acc) (erased bd)) (binder-accs pids))
    (let-match many (elab-tele ctx ctxP wfP acc _ (cov-binders ctx pids ctxP acc _ pt cr bd spt li) rs (POuter (PInner))) (MkTeleDec _ _ _ _ _ rout er rsc)
      ((TeleStuck _ _ _ _ _) (FnsStuck _ _ _)))
    (let-match many rout (TeleOk ctxR rt rids rn)
      ((TeleErr r) (MkFnsDec _ _ _ (FErr r) (MFRetsErr ctx l fn ps rs items rest ctxP pt pids pn acc r ep bd er) (FSErr _ _) (FLErr _ _))))
    (let-match many rsc (TLOk _ _ _ _ _ _ _ _ _ _ _ srt _ _))
    (let ((many fid) (many ctx1) (erased m) (many wf1) (erased g1) (erased _)) (mint ctx wf (Some _ fn) (TFn l pt rt) (KPlain) (None _) (sc-fn ctx l pt rt _ _ sl spt srt) (scm-none ctx) (ROkNone _)))
    (let-match many (notail $ mint-fns ctx1 wf1 l (sc-grew ctx ctx1 _ l g1 sl) rest (POuter (PInner))) (MkFnsDec _ _ _ fout q fsc fl)
      ((FnsStuck _ _ _) (FnsStuck _ _ _)))
    (let-match many fout (FOk out sigs)
      ((FErr r) (MkFnsDec _ _ _ (FErr r) (MFRestErr ctx l fn ps rs items rest ctxP pt pids pn acc ctxR rt rids rn fid ctx1 r ep bd er m q) (FSErr _ _) (FLErr _ _))))
    (let-match many fsc (FSOk _ _ _ wf2 g2 ssigs))
    (let-match erased fl (FLOk _ _ _ le))
    (let ((erased g)) (grew-trans ctx ctx1 out g1 g2))
    (MkFnsDec _ _ _ (FOk out (Cons _ (MkSig fid pt pn rt) sigs)) (MFCons ctx l fn ps rs items rest ctxP pt pids pn acc ctxR rt rids rn fid ctx1 out sigs ep bd er m q)
      (FSOk _ _ _ wf2 g (SigsCons _ fid pt pn rt sigs _ _ (sct-grew ctx out _ pt _ g spt) (sct-grew ctx out _ rt _ g srt) ln ssigs))
      (FLOk _ _ _ (LECons _ _ (RList (Cons _ (RAtom fn) (Cons _ (RList ps) (Cons _ (RList rs) items)))) (MkSig fid pt pn rt) rest sigs le)))))

; def-adts: the type constructors, then the constructors, each declaration adding its ADT.
(def-fns _
  ((many mint-decl-ctors : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) tid) (erased (Tycon ctx tid) tc) (many (Nat) n) (subterm many (List (Sexp)) ctors) (subterm erased (POuter (PInner)) is _ph) -> (many (DeclCtorsDec ctx tid n ctors) r))
    (let-match many ctors (Cons _ ctor rest)
      ((Nil _) (MkDeclCtorsDec _ _ _ _ (FOkT ctx (Nil _)) (MDNil ctx tid n) (DCOk _ _ _ wf (grew-refl ctx) (ctors-nil ctx)))))
    (let-match many ctor (RList citems) (else (DeclCtorsStuck _ _ _ _)))
    (let-match many citems (Cons _ cr d1) (else (DeclCtorsStuck _ _ _ _)))
    (let-match many d1 (Cons _ fr d2) (else (DeclCtorsStuck _ _ _ _)))
    (let-match many d2 (Cons _ rr d3) (else (DeclCtorsStuck _ _ _ _)))
    (let-match many d3 (Nil _) (else (DeclCtorsStuck _ _ _ _)))
    (let-match many cr (RAtom cn) (else (DeclCtorsStuck _ _ _ _)))
    (match many fr _
      ((RList fs) (tail $ mint-decl-ctor ctx wf tid tc n cn fs rr rest ctors (PInner)))
      (else (DeclCtorsStuck _ _ _ _))))
  ((many mint-decl-ctor : (many (Ctx) ctx) (many (WF ctx) wf) (many (Nat) tid) (erased (Tycon ctx tid) tc) (many (Nat) n) (many (String) cn) (many (List (Sexp)) fs) (many (Sexp) rr) (many (List (Sexp)) rest)
      (subterm erased (Cons (Sexp) (RList (Cons (Sexp) (RAtom cn) (Cons (Sexp) (RList fs) (Cons (Sexp) rr (Nil (Sexp)))))) rest) is ctors) (subterm erased (PInner) is _ph) -> (many (DeclCtorsDec ctx tid n ctors) r))
    (let-match many (elab-tele ctx ctx wf (Nil _) _ (cov-refl ctx) fs (POuter (PInner))) (MkTeleDec _ _ _ _ _ fout ef fsc)
      ((TeleStuck _ _ _ _ _) (DeclCtorsStuck _ _ _ _)))
    (let-match many fout (TeleOk ctxF ft fids fn)
      ((TeleErr r) (MkDeclCtorsDec _ _ _ _ (FErrT r) (MDFieldsErr ctx tid n cn fs rr rest r ef) (DCErr _ _))))
    (let-match many fsc (TLOk _ _ _ _ _ _ _ _ _ wfF cr sft li _))
    (let ((erased gF)) (covrev-grew ctx (Nil _) fids ctxF cr))
    (let-match many (elab-term ctxF wfF rr (POuter (PInner))) (MkTermDec _ _ rout er tsc)
      ((TermStuck _ _) (DeclCtorsStuck _ _ _ _)))
    (let-match many rout (TOk ret rty)
      ((TErr r) (MkDeclCtorsDec _ _ _ _ (FErrT r) (MDRetErr ctx tid n cn fs rr rest ctxF ft fids fn r ef er) (DCErr _ _))))
    (let-match erased tsc (TSOk _ _ _ sret _))
    (let ((many c10) (erased crn) (erased _)) (canonical ctxF wfF ret sret))
    (let-match many (ret-dec ctxF wfF tid (tycon-grew ctx ctxF tid wf gF tc) n ret c10 crn) (RetYes _ _ _ tps args lnn)
      ((RetNo _ _ _ _ br) (MkDeclCtorsDec _ _ _ _ (FErrT (RBadReturn)) (MDBadRet ctx tid n cn fs rr rest ctxF ft fids fn ret rty c10 ef er crn br) (DCErr _ _))))
    (let ((many acc) (erased bd)) (binder-accs fids))
    (let ((many ret2) (erased ab)) (abstract acc ret))
    (let ((erased sret2)) (sc-abstract ctx acc ctxF _ ret ret2 (cov-binders ctx fids ctxF acc _ ft cr bd sft li) sret ab))
    (let ((many cid) (many ctx1) (erased m) (many wf1) (erased g1) (erased eis)) (mint ctx wf (Some _ cn) (TValCtor ft ret2) (KDecl) (None _) (sc-valctor ctx ft ret2 _ sft sret2) (scm-none ctx) (ROkNone _)))
    (let-match many (notail $ mint-decl-ctors ctx1 wf1 tid (tycon-grew ctx ctx1 tid wf g1 tc) n rest (POuter (PInner))) (MkDeclCtorsDec _ _ _ _ dout q dsc)
      ((DeclCtorsStuck _ _ _ _) (DeclCtorsStuck _ _ _ _)))
    (let-match many dout (FOkT out cids)
      ((FErrT r) (MkDeclCtorsDec _ _ _ _ (FErrT r) (MDRestErr ctx tid n cn fs rr rest ctxF ft fids fn ret rty tps args acc ret2 cid ctx1 r ef er crn lnn bd ab m q) (DCErr _ _))))
    (let-match many dsc (DCOk _ _ _ wf2 g2 ccids))
    (MkDeclCtorsDec _ _ _ _ (FOkT out (Cons _ cid cids)) (MDCons ctx tid n cn fs rr rest ctxF ft fids fn ret rty tps args acc ret2 cid ctx1 out cids ef er crn lnn bd ab m q)
      (DCOk _ _ _ wf2 (grew-trans ctx ctx1 out g1 g2) (ctors-cons out cid cids (ctor-grew ctx1 out cid wf1 g2 (ctor-of-entis ctx1 cid ft ret2 eis)) ccids)))))
(def-fns _ $ (many mint-tycons : (many (Ctx) ctx) (many (WF ctx) wf) (subterm many (List (Sexp)) decls) -> (many (TyconsDec ctx decls) r))
  (let-match many decls (Cons _ decl rest)
    ((Nil _) (MkTyconsDec _ _ (FOkT ctx (Nil _)) (MTyNil ctx) (TySOk _ _ _ _ wf (grew-refl ctx) (TyNil _) (LENil _ _)))))
  (let-match many decl (RList ditems) (else (TyconsStuck _ _)))
  (let-match many ditems (Cons _ tr d1) (else (TyconsStuck _ _)))
  (let-match many d1 (Cons _ pr ctors) (else (TyconsStuck _ _)))
  (let-match many tr (RAtom tn) (else (TyconsStuck _ _)))
  (let-match many pr (RList ps) (else (TyconsStuck _ _)))
  (let-match many (elab-tele ctx ctx wf (Nil _) _ (cov-refl ctx) ps (POuter (PInner))) (MkTeleDec _ _ _ _ _ pout ep psc)
    ((TeleStuck _ _ _ _ _) (TyconsStuck _ _)))
  (let-match many pout (TeleOk ctxP pt pids pn)
    ((TeleErr r) (MkTyconsDec _ _ (FErrT r) (MTyErr ctx tn ps ctors rest r ep) (TySErr _ _ _))))
  (let-match many psc (TLOk _ _ _ _ _ _ _ _ _ _ _ spt _ _))
  (let ((many tid) (many ctx1) (erased m) (many wf1) (erased g1) (erased eis)) (mint ctx wf (Some _ tn) (TTyCtor pt) (KDecl) (None _) (sc-tyctor ctx pt _ spt) (scm-none ctx) (ROkNone _)))
  (let-match many (notail $ mint-tycons ctx1 wf1 rest) (MkTyconsDec _ _ rout q rsc) ((TyconsStuck _ _) (TyconsStuck _ _)))
  (let-match many rout (FOkT out tids)
    ((FErrT r) (MkTyconsDec _ _ (FErrT r) (MTyRestErr ctx tn ps ctors rest ctxP pt pids pn tid ctx1 r ep m q) (TySErr _ _ _))))
  (let-match many rsc (TySOk _ _ _ _ wf2 g2 tys le))
  (MkTyconsDec _ _ (FOkT out (Cons _ tid tids)) (MTyCons ctx tn ps ctors rest ctxP pt pids pn tid ctx1 out tids ep m q)
    (TySOk _ _ _ _ wf2 (grew-trans ctx ctx1 out g1 g2) (TyCons _ tid tids (tycon-grew ctx1 out tid wf1 g2 (tycon-of-entis ctx1 tid pt eis)) tys) (LECons _ _ decl tid rest tids le))))
(def-fns _ $ (many mint-ctors : (many (Ctx) ctx) (many (WF ctx) wf) (subterm many (List (Sexp)) decls) (many (List (Nat)) tids) (erased (Tycons ctx tids) tys) (erased (LenEq (Sexp) (Nat) decls tids) le) -> (many (CtorsDec ctx decls tids) r))
  (let-match many decls (Cons _ decl rest)
    ((Nil _) (match many tids _ ((Nil _) (MkCtorsDec _ _ _ (FOkT ctx (Nil _)) (MCNil ctx) (CSOk _ _ _ wf (grew-refl ctx)))) (absurd (Cons _ _ _) le))))
  (let-match many tids (Cons _ tid trest) (absurd (Nil _) le))
  (let-match erased le (LECons _ _ _ _ _ _ le2))
  (let-match erased tys (TyCons _ _ _ tc tys2))
  (let-match many decl (RList ditems) (else (CtorsStuck _ _ _)))
  (let-match many ditems (Cons _ tr d1) (else (CtorsStuck _ _ _)))
  (let-match many d1 (Cons _ pr ctors) (else (CtorsStuck _ _ _)))
  (let-match many tr (RAtom tn) (else (CtorsStuck _ _ _)))
  (let-match many pr (RList ps) (else (CtorsStuck _ _ _)))
  (let ((many pt) (erased tty) (erased t) (erased cn) (erased _) (erased _)) (tycon-of ctx wf tid tc))
  (let ((many n) (erased ln)) (list-len _ pt))
  (let-match many (mint-decl-ctors ctx wf tid tc n ctors (POuter (PInner))) (MkDeclCtorsDec _ _ _ _ dout mc dsc)
    ((DeclCtorsStuck _ _ _ _) (CtorsStuck _ _ _)))
  (let-match many dout (FOkT ctx1 cids)
    ((FErrT r) (MkCtorsDec _ _ _ (FErrT r) (MCErr ctx tn ps ctors rest tid trest tty pt n r t cn ln mc) (CSErr _ _))))
  (let-match many dsc (DCOk _ _ _ wf1 g1 ccids))
  (let ((many ctx2) (erased aa) (many wf2) (erased g2)) (add-adt ctx1 wf1 tid cids (has-grew ctx ctx1 tid g1 (tycon-has ctx tid tc)) ccids))
  (let ((erased g12)) (grew-trans ctx ctx1 ctx2 g1 g2))
  (let-match many (notail $ mint-ctors ctx2 wf2 rest trest (tycons-grew ctx ctx2 trest wf g12 tys2) le2) (MkCtorsDec _ _ _ rout q csc)
    ((CtorsStuck _ _ _) (CtorsStuck _ _ _)))
  (let-match many rout (FOkT out ids)
    ((FErrT r) (MkCtorsDec _ _ _ (FErrT r) (MCRestErr ctx tn ps ctors rest tid trest tty pt n ctx1 cids ctx2 r t cn ln mc aa q) (CSErr _ _))))
  (let-match many csc (CSOk _ _ _ wf3 g3))
  (let ((many all) (erased ap)) (append-nats (Cons _ tid cids) ids))
  (MkCtorsDec _ _ _ (FOkT out all) (MCCons ctx tn ps ctors rest tid trest tty pt n ctx1 cids ctx2 out ids all t cn ln mc aa q ap)
    (CSOk _ _ _ wf3 (grew-trans ctx ctx2 out g12 g3))))
(def-fns _ $ (many elab-def-adts : (many (Ctx) ctx) (many (WF ctx) wf) (many (List (Sexp)) decls) -> (many (StmtDec ctx (RList (Cons (Sexp) (RKey (KDefAdts)) decls))) r))
  (let ((many level) (erased lv) (erased _)) (ctx-level ctx wf))
  (let-match many level (None _)
    ((Some _ cur) (MkStmtDec _ _ (SErr (RTopLevelOnly)) (STDefAdtsNested ctx decls cur lv) (SSErr _ _))))
  (let-match many (mint-tycons ctx wf decls) (MkTyconsDec _ _ tout mt tsc) ((TyconsStuck _ _) (StmtStuck _ _)))
  (let-match many tout (FOkT ctx1 tids) ((FErrT r) (MkStmtDec _ _ (SErr r) (STDefAdtsTyconErr ctx decls r lv mt) (SSErr _ _))))
  (let-match many tsc (TySOk _ _ _ _ wf1 g1 tys le))
  (let-match many (mint-ctors ctx1 wf1 decls tids tys le) (MkCtorsDec _ _ _ cout mc csc) ((CtorsStuck _ _ _) (StmtStuck _ _)))
  (let-match many cout (FOkT out ids)
    ((FErrT r) (MkStmtDec _ _ (SErr r) (STDefAdtsCtorErr ctx decls ctx1 tids r lv mt mc) (SSErr _ _))))
  (match many csc _
    ((CSOk _ _ _ wf2 g2) (MkStmtDec _ _ (SOk out (SDefAdts ids)) (STDefAdts ctx decls ctx1 tids out ids lv mt mc) (SSOk _ _ _ wf2 (grew-trans ctx ctx1 out g1 g2))))))

; The proof forms: (prove-subterm a b), (prove-predates x L), and a former as a value.
(def-fns _ $ (many elab-prove-subterm : (many (Ctx) ctx) (many (WF ctx) wf) (many (Sexp) ar) (many (Sexp) br) ->
    (many (ExprDec ctx (RList (Cons (Sexp) (RKey (KProveSubterm)) (Cons (Sexp) ar (Cons (Sexp) br (Nil (Sexp))))))) r))
  (let-match many (elab-term ctx wf ar (POuter (PInner))) (MkTermDec _ _ aout p asc) ((TermStuck _ _) (ExprStuck _ _)))
  (let-match many aout (TOk at2 aty) ((TErr r) (MkExprDec _ _ (EErr r) (EXProveSubtermErrA ctx ar br r p) (ESErr _ _))))
  (let-match erased asc (TSOk _ _ _ sat saty))
  (let-match many (elab-term ctx wf br (POuter (PInner))) (MkTermDec _ _ bout q bsc) ((TermStuck _ _) (ExprStuck _ _)))
  (let-match many bout (TOk bt bty)
    ((TErr r) (MkExprDec _ _ (EErr r) (EXProveSubtermErrB ctx ar br at2 aty r p q) (ESErr _ _))))
  (let-match erased bsc (TSOk _ _ _ sbt sbty))
  (let ((many ca) (erased c1) (erased sca)) (canonical ctx wf at2 sat))
  (let ((many cb) (erased c2b) (erased scb)) (canonical ctx wf bt sbt))
  (let-match many (sub-dec ctx wf ca sca cb scb) (SubYes _ _ _ ss)
    ((SubNo _ _ _ ns) (MkExprDec _ _ (EErr (RBadProof)) (EXProveSubtermNot ctx ar br at2 aty bt bty ca cb p q c1 c2b ns) (ESErr _ _))))
  (let ((many e3b) (many out) (erased m) (many wf2) (erased g2) (erased eis))
    (mint ctx wf (None _) (TyApp (Ref (Succ (Succ (Zero)))) subterm-ps (Cons _ aty (Cons _ at2 (Cons _ bty (Cons _ bt (Nil _)))))) (KPlain) (None _)
      (sc-subterm ctx wf _ _ _ _ saty sat sbty sbt) (scm-none ctx) (ROkNone _)))
  (MkExprDec _ _ (EOk out (CToken) (Cons _ e3b (Nil _))) (EXProveSubterm ctx ar br at2 aty bt bty ca cb e3b out p q c1 c2b ss m)
    (ESOk _ _ _ _ wf2 g2 (has-all-cons out e3b (Nil _) (entis-has out e3b _ _ eis) (has-all-nil out)))))
(def-fns _ $ (many elab-prove-predates : (many (Ctx) ctx) (many (WF ctx) wf) (many (String) xs) (many (String) ls) ->
    (many (ExprDec ctx (RList (Cons (Sexp) (RKey (KProvePredates)) (Cons (Sexp) (RAtom xs) (Cons (Sexp) (RAtom ls) (Nil (Sexp))))))) r))
  (let ((many scope) (erased sc)) (ctx-scope ctx))
  (let-match many (name-dec scope xs) (NameHit _ _ x nx)
    ((NameMiss _ _ n) (MkExprDec _ _ (EErr (RNotInScope)) (EXProvePredatesUnboundX ctx xs ls scope sc n) (ESErr _ _))))
  (let-match many (name-dec scope ls) (NameHit _ _ l nl)
    ((NameMiss _ _ n) (MkExprDec _ _ (EErr (RNotInScope)) (EXProvePredatesUnboundL ctx xs ls scope x sc nx n) (ESErr _ _))))
  (let ((erased hx)) (scope-has-ctx ctx wf scope xs x sc nx))
  (let ((erased hl)) (scope-has-ctx ctx wf scope ls l sc nl))
  (let ((many tx) (many _) (erased t) (erased _) (erased stx) (erased _) (erased _) (erased _)) (type-of ctx wf x hx))
  (let ((many _) (many kl) (erased _) (erased kd) (erased _) (erased _) (erased _) (erased _)) (type-of ctx wf l hl))
  (let-match many kl (KLevel)
    ((KPlain) (MkExprDec _ _ (EErr (RNotLevel)) (EXProvePredatesNotLevel ctx xs ls scope x l (KPlain) sc nx nl kd (NLKPlain)) (ESErr _ _)))
    ((KDecl) (MkExprDec _ _ (EErr (RNotLevel)) (EXProvePredatesNotLevel ctx xs ls scope x l (KDecl) sc nx nl kd (NLKDecl)) (ESErr _ _))))
  (let-match many (nat-cmp x l) (CLt _ _ _ _ lt)
    ((CEq _ _ _) (MkExprDec _ _ (EErr (RBadProof)) (EXProvePredatesAfter ctx xs ls scope x l sc nx nl kd (lt-succ x)) (ESErr _ _)))
    ((CGt _ _ _ _ gt) (MkExprDec _ _ (EErr (RBadProof)) (EXProvePredatesAfter ctx xs ls scope x l sc nx nl kd (lt-weaken l x gt)) (ESErr _ _))))
  (let ((many e4) (many out) (erased m) (many wf2) (erased g2) (erased eis))
    (mint ctx wf (None _) (TyApp (Ref (Succ (Zero))) predates-ps (Cons _ tx (Cons _ (Ref x) (Cons _ (Ref l) (Nil _))))) (KPlain) (None _)
      (sc-predates ctx wf _ _ _ stx (sc-ref ctx x hx) (sc-ref ctx l hl)) (scm-none ctx) (ROkNone _)))
  (MkExprDec _ _ (EOk out (CToken) (Cons _ e4 (Nil _))) (EXProvePredates ctx xs ls scope x l tx e4 out sc nx nl t kd lt m)
    (ESOk _ _ _ _ wf2 g2 (has-all-cons out e4 (Nil _) (entis-has out e4 _ _ eis) (has-all-nil out)))))
(def-fns _ $ (many elab-former-expr : (many (Ctx) ctx) (many (WF ctx) wf) (many (Key) k) (many (List (Sexp)) items) (erased (FormerKey k) fk) -> (many (ExprDec ctx (RList (Cons (Sexp) (RKey k) items))) r))
  (let-match many (elab-term ctx wf (RList (Cons _ (RKey k) items)) (POuter (PInner))) (MkTermDec _ _ out p tsc)
    ((TermStuck _ _) (ExprStuck _ _)))
  (let-match many out (TOk t ty) ((TErr r) (MkExprDec _ _ (EErr r) (EXFormerErr ctx k items r fk p) (ESErr _ _))))
  (let-match erased tsc (TSOk _ _ _ st sty))
  (let ((many x) (many out2) (erased m) (many wf2) (erased g2) (erased eis)) (mint ctx wf (None _) ty (KPlain) (Some _ t) sty (scm-some ctx t st) (ROkSome _ _ (NDPlain))))
  (MkExprDec _ _ (EOk out2 (CFormer t) (Cons _ x (Nil _))) (EXFormer ctx k items t ty x out2 fk p m) (ESOk _ _ _ _ wf2 g2 (has-all-cons out2 x (Nil _) (entis-has out2 x _ _ eis) (has-all-nil out2)))))

; The group proper. Each function decreases on the raw syntax it walks, then on a phase for a call that
; walks the same syntax, then on the list of arguments still to be walked.
(def-fns _
  ((many elab-expr : (many (Ctx) ctx) (many (WF ctx) wf) (subterm many (Sexp) raw) (subterm erased (POuter (PInner)) is _ph) (subterm erased (Nil (Sexp)) is _tl) -> (many (ExprDec ctx raw) r))
    (match many raw _
      ((RAtom s)
        (let ((many scope) (erased sc)) (ctx-scope ctx))
        (match many (name-dec scope s) _
          ((NameMiss _ _ n) (MkExprDec _ _ (EErr (RNotInScope)) (EXUnbound ctx s scope sc n) (ESErr _ _)))
          ((NameHit _ _ x n)
            (MkExprDec _ _ (EOk ctx (CVar x) (Cons _ x (Nil _))) (EXName ctx s x scope sc n) (ESOk _ _ _ _ wf (grew-refl ctx) (has-all-cons ctx x (Nil _) (scope-has-ctx ctx wf scope s x sc n) (has-all-nil ctx)))))))
      ((RKey _) (ExprStuck _ _))
      ((RList items)
        (let-match many items (Cons _ h rest) ((Nil _) (ExprStuck _ _)))
        (let-match many h (RKey k)
          ((RAtom s) (tail $ elab-app ctx wf h rest items (POuter (PInner)) (Nil _) (HeadAtom s)))
          ((RList inner) (tail $ elab-app ctx wf h rest items (POuter (PInner)) (Nil _) (HeadList inner))))
        (match many k _
          ((KValues)
            (let-match many (notail $ elab-items ctx wf rest (POuter (PInner)) (Nil _)) (MkItemsDec _ _ out p isc)
              ((ItemsStuck _ _) (ExprStuck _ _)))
            (let-match many out (AllOk out2 cores ids) ((AErr r) (MkExprDec _ _ (EErr r) (EXValuesErr ctx rest r p) (ESErr _ _))))
            (match many isc _
              ((AOOk _ _ _ _ wf2 g2 h2) (MkExprDec _ _ (EOk out2 (CValues cores) ids) (EXValues ctx rest out2 cores ids p) (ESOk _ _ _ _ wf2 g2 h2)))))
          ((KFn) (elab-former-expr ctx wf (KFn) rest (FKFn)))
          ((KTyCtor) (elab-former-expr ctx wf (KTyCtor) rest (FKTyCtor)))
          ((KValCtor) (elab-former-expr ctx wf (KValCtor) rest (FKValCtor)))
          ((KMatch)
            (let-match many rest (Cons _ sr rest2) (else (ExprStuck _ _)))
            (let-match many rest2 (Cons _ annr brs) (else (ExprStuck _ _)))
            (match many annr _
              ((RList ann) (tail $ elab-match ctx wf sr ann brs rest (POuter (PInner)) (Nil _)))
              (else (ExprStuck _ _))))
          ((KProveSubterm)
            (let-match many rest (Cons _ ar rest2) (else (ExprStuck _ _)))
            (let-match many rest2 (Cons _ br rest3) (else (ExprStuck _ _)))
            (match many rest3 _
              ((Nil _) (elab-prove-subterm ctx wf ar br))
              (else (ExprStuck _ _))))
          ((KProvePredates)
            (let-match many rest (Cons _ xr rest2) (else (ExprStuck _ _)))
            (let-match many rest2 (Cons _ lr rest3) (else (ExprStuck _ _)))
            (let-match many rest3 (Nil _) (else (ExprStuck _ _)))
            (let-match many xr (RAtom xs) (else (ExprStuck _ _)))
            (match many lr _
              ((RAtom ls) (elab-prove-predates ctx wf xs ls))
              (else (ExprStuck _ _))))
          ((KPredatesTrans) (tail $ elab-axiom-args ctx wf (KPredatesTrans) rest (POuter (PInner)) (Nil _) (AKPredatesTrans)))
          ((KSubtermTrans) (tail $ elab-axiom-args ctx wf (KSubtermTrans) rest (POuter (PInner)) (Nil _) (AKSubtermTrans)))
          ((KPredatesSubterm) (tail $ elab-axiom-args ctx wf (KPredatesSubterm) rest (POuter (PInner)) (Nil _) (AKPredatesSubterm)))
          (else (ExprStuck _ _))))))
  ; an axiom's two items
  ((many elab-axiom-args : (many (Ctx) ctx) (many (WF ctx) wf) (many (Key) k) (subterm many (List (Sexp)) items) (subterm erased (POuter (PInner)) is _ph) (subterm erased (Nil (Sexp)) is _tl) (erased (AxiomKey k) ak) ->
      (many (ExprDec ctx (RList (Cons (Sexp) (RKey k) items))) r))
    (let-match many items (Cons _ pr rest1) (else (ExprStuck _ _)))
    (let-match many rest1 (Cons _ qr rest2) (else (ExprStuck _ _)))
    (match many rest2 _
      ((Nil _) (tail $ elab-axiom ctx wf k pr qr items (PInner) (Nil _) ak))
      (else (ExprStuck _ _))))
  ; (axiom p q): both proofs elaborated, their canonical types read, and the axiom's own check applied
  ((many elab-axiom : (many (Ctx) ctx) (many (WF ctx) wf) (many (Key) k) (many (Sexp) pr) (many (Sexp) qr) (subterm erased (Cons (Sexp) pr (Cons (Sexp) qr (Nil (Sexp)))) is items) (subterm erased (PInner) is _ph)
      (subterm erased (Nil (Sexp)) is _tl) (erased (AxiomKey k) ak) -> (many (ExprDec ctx (RList (Cons (Sexp) (RKey k) items))) r))
    (let-match many (notail $ elab-expr ctx wf pr (POuter (PInner)) (Nil _)) (MkExprDec _ _ pout ep psc)
      ((ExprStuck _ _) (ExprStuck _ _)))
    (let-match many pout (EOk ctx1 pc pids) ((EErr r) (MkExprDec _ _ (EErr r) (EXAxiomErrP ctx k pr qr r ak ep) (ESErr _ _))))
    (let-match many psc (ESOk _ _ _ _ wf1 g1 hp))
    (let-match many (one-dec pids) (OneYes p)
      ((OneNo _ n) (MkExprDec _ _ (EErr (RSize)) (EXAxiomSizeP ctx k pr qr ctx1 pc pids ak ep n) (ESErr _ _))))
    (let-match many (notail $ elab-expr ctx1 wf1 qr (POuter (PInner)) (Nil _)) (MkExprDec _ _ qout eq qsc)
      ((ExprStuck _ _) (ExprStuck _ _)))
    (let-match many qout (EOk ctx2 qc qids)
      ((EErr r) (MkExprDec _ _ (EErr r) (EXAxiomErrQ ctx k pr qr ctx1 pc p r ak ep eq) (ESErr _ _))))
    (let-match many qsc (ESOk _ _ _ _ wf2 g2 hq))
    (let-match many (one-dec qids) (OneYes q)
      ((OneNo _ n) (MkExprDec _ _ (EErr (RSize)) (EXAxiomSizeQ ctx k pr qr ctx1 pc p ctx2 qc qids ak ep eq n) (ESErr _ _))))
    (let ((erased hpp) (erased _)) (has-all-parts ctx1 p (Nil _) hp))
    (let ((erased hqq) (erased _)) (has-all-parts ctx2 q (Nil _) hq))
    (let ((many pty) (many _) (erased tp) (erased _) (erased spty) (erased _) (erased _) (erased _)) (type-of ctx1 wf1 p hpp))
    (let ((many cp) (erased c1b) (erased scp)) (canonical ctx1 wf1 pty spty))
    (let ((many qty) (many _) (erased tq) (erased _) (erased sqty) (erased _) (erased _) (erased _)) (type-of ctx2 wf2 q hqq))
    (let ((many cq) (erased c2b) (erased scq)) (canonical ctx2 wf2 qty sqty))
    (let-match many (axiom-check k ctx1 wf1 cp scp ctx2 wf2 g2 cq scq ak) (AxOk _ _ _ _ _ concl ok sconcl)
      ((AxBad _ _ _ _ _ bad) (MkExprDec _ _ (EErr (RBadProof)) (EXAxiomBad ctx k pr qr ctx1 pc p pty cp ctx2 qc q qty cq ep tp c1b eq tq c2b bad) (ESErr _ _))))
    (let ((many e3b) (many out) (erased m) (many wf3) (erased g3) (erased eis)) (mint ctx2 wf2 (None _) concl (KPlain) (None _) sconcl (scm-none ctx2) (ROkNone _)))
    (MkExprDec _ _ (EOk out (CToken) (Cons _ e3b (Nil _))) (axiom-derivation ctx k pr qr ctx1 pc p pty cp ctx2 qc q qty cq e3b out concl ep tp c1b eq tq c2b ok m)
      (ESOk _ _ _ _ wf3 (grew-trans ctx ctx2 out (grew-trans ctx ctx1 ctx2 g1 g2) g3) (has-all-cons out e3b (Nil _) (entis-has out e3b _ _ eis) (has-all-nil out)))))
