(def-fns _ $ (erased ctors-head : (erased (Ctx) ctx) (erased (Nat) c) (erased (List (Nat)) ids) (erased (Ctors ctx (Cons (Nat) c ids)) h) -> (erased (Ctor ctx c) q))
  (let-match erased h (MkCtors _ _ _ _ _ _ _ _ ah))
