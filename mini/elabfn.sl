(def-fns _ $ (erased ctors-mem : (erased (Ctx) ctx) (erased (Nat) c) (erased (List (Nat)) ids) (erased (Ctors ctx ids) h) (subterm erased (Mem c ids) m) -> (erased (Ctor ctx c) q))
  (match erased m _
    ((MemHere _ xs) (ctors-head ctx c xs h))
    ((MemThere _ y xs p) (ctors-mem ctx c xs (ctors-parts ctx y xs h) p))))
(def-fns _ $ (erased nth-has : (erased (Ctx) ctx) (erased (List (Nat)) ids) (erased (Nat) i) (erased (Nat) x) (erased (HasAll ctx ids) h) (subterm erased (Nth (Nat) ids i x) p) -> (erased (Has ctx x) q))
  (match erased p _
    ((NthHere _ _ rest) (let ((erased hx) (erased _)) (has-all-parts ctx x rest h)) hx)
    ((NthThere _ y rest i2 _ p2) (let ((erased _) (erased hrest)) (has-all-parts ctx y rest h)) (nth-has ctx rest i2 x hrest p2))))
(def-fns _ $ (erased ctor-grew : (erased (Ctx) c1) (erased (Ctx) c2) (erased (Nat) c) (many (WF c1) wf) (erased (Grew c1 c2) g) (erased (Ctor c1 c) p) -> (erased (Ctor c2 c) q))
  (let-match erased g (GrewBy n0 _ e0 _ _ _ _ _ _ e1 _ _ _ _ _ ext))
  (let-match erased p (MkCtor _ _ _ _ _ _ _ _ fs r eo))
  (let-match erased wf (MkWF _ _ _ _ _ _ _ _ _ _ _ be _ _ _ _ _ _ _ _))
  (MkCtor _ _ _ _ _ _ _ c fs r (ent-of-ext n0 e0 e1 c (TValCtor fs r) (KDecl) be eo ext)))

(def-fns _ $ (many snoc-id : (subterm many (List (Maybe (Nat))) xs) (many (Maybe (Nat)) x) -> (many (List (Maybe (Nat))) out) (erased (SnocId xs x out) p))
  (let-match many xs (Cons _ y ys)
    ((Nil _) (values (Cons _ x (Nil _)) (SnocIdNil x))))
  (let ((many out) (erased p)) (notail $ snoc-id ys x))
  (values (Cons _ y out) (SnocIdCons y ys x out p)))
(def-fns _ $ (many binder-accs : (subterm many (List (Nat)) ids) -> (many (List (Maybe (Nat))) acc) (erased (Binders ids acc) p))
  (let-match many ids (Cons _ x rest)
    ((Nil _) (values (Nil _) (BindersNil))))
  (let ((many acc) (erased p)) (notail $ binder-accs rest))
  (let ((many out) (erased q)) (snoc-id acc (Some _ x)))
  (values out (BindersCons x rest acc out p q)))
(def-fns _ $ (many refs : (subterm many (List (Nat)) ids) -> (many (List (Term)) ts) (erased (Refs ids ts) p))
  (let-match many ids (Cons _ x rest)
    ((Nil _) (values (Nil _) (RefsNil))))
  (let ((many ts) (erased p)) (notail $ refs rest))
  (values (Cons _ (Ref x) ts) (RefsCons x rest ts p)))
(def-fns _ $ (many nones : (subterm many (List (Entry)) es) -> (many (List (Maybe (String))) names) (erased (Nones es names) p) (erased (LenEq (Entry) (Maybe (String)) es names) l))
  (let-match many es (Cons _ e rest)
    ((Nil _) (values (Nil _) (NonesNil) (LENil _ _))))
  (let ((many names) (erased p) (erased l)) (notail $ nones rest))
  (values (Cons _ (None _) names) (NonesCons e rest names p) (LECons _ _ e (None _) rest names l)))
(def-fns _ $ (many append-nats : (subterm many (List (Nat)) xs) (many (List (Nat)) ys) -> (many (List (Nat)) out) (erased (AppendNats xs ys out) p))
  (let-match many xs (Cons _ x rest)
    ((Nil _) (values ys (AppendNil ys))))
  (let ((many out) (erased p)) (notail $ append-nats rest ys))
  (values (Cons _ x out) (AppendCons x rest ys out p)))
(def-fns _ $ (many marked : (subterm many (List (Entry)) tele) (many (List (Nat)) ids) (erased (LenEq (Entry) (Nat) tele ids) le) -> (many (List (Term)) out) (erased (Marked tele ids out) p))
  (let-match many tele (Cons _ e es)
    ((Nil _) (match many ids _ ((Nil _) (values (Nil _) (MarkedNil))) (absurd (Cons _ _ _) le))))
  (let-match many ids (Cons _ x rest) (absurd (Nil _) le))
  (let-match many e (MkEntry s i t))
  (let-match erased le (LECons _ _ _ _ _ _ le2))
  (let ((many out) (erased p)) (notail $ marked es rest le2))
  (match many s _
    ((BTrue) (values (Cons _ (Ref x) out) (MarkedYes i t es x rest out p)))
    ((BFalse) (values out (MarkedNo i t es x rest out p)))))

; Field names of a branch pattern: atoms, or a malformed shape.
(def-adts
  ((AtomNamesDec : ((List (Sexp)) raws) -> Type)
    enum
    (many MkAtomNames : (erased (List (Sexp)) raws) (many (List (Maybe (String))) names) (erased (AtomNames raws names) p) (erased (LenEq (Sexp) (Maybe (String)) raws names) l) -> (AtomNamesDec raws))
    (many AtomNamesStuck : (erased (List (Sexp)) raws) -> (AtomNamesDec raws))))
(def-fns _ $ (many atom-names : (subterm many (List (Sexp)) raws) -> (many (AtomNamesDec raws) r))
  (let-match many raws (Cons _ r rest) ((Nil _) (MkAtomNames _ (Nil _) (ANNil) (LENil _ _))))
  (let-match many r (RAtom x) (else (AtomNamesStuck _)))
  (match many (notail $ atom-names rest) _
    ((AtomNamesStuck _) (AtomNamesStuck _))
    ((MkAtomNames _ names p l) (MkAtomNames _ (Cons _ (Some _ x) names) (ANCons x rest names p) (LECons _ _ r (Some _ x) rest names l)))))

(def-adts
  ((MemDec : ((Nat) x) ((List (Nat)) xs) -> Type)
    enum
    (many MemYes : (erased (Nat) x) (erased (List (Nat)) xs) (erased (Mem x xs) p) -> (MemDec x xs))
    (many MemNo : (erased (Nat) x) (erased (List (Nat)) xs) (erased (NotMem x xs) p) -> (MemDec x xs)))
  ((OneDec : ((List (Nat)) ids) -> Type)
    enum
    (many OneYes : (many (Nat) x) -> (OneDec (Cons (Nat) x (Nil (Nat)))))
    (many OneNo : (erased (List (Nat)) ids) (erased (NotOne ids) p) -> (OneDec ids)))
  ((NotLenDec : ((Nat) n) ((List (Term)) as) -> Type)
    enum
    (many LenIs : (erased (Nat) n) (erased (List (Term)) as) (erased (Length (Term) as n) p) -> (NotLenDec n as))
    (many LenIsNot : (erased (Nat) n) (erased (List (Term)) as) (erased (NotLen n as) p) -> (NotLenDec n as))))
(def-fns _ $ (many mem-dec : (many (Nat) x) (subterm many (List (Nat)) xs) -> (many (MemDec x xs) r))
  (let-match many xs (Cons _ y rest) ((Nil _) (MemNo _ _ (NotMemNil x))))
  (let-match many (nat-dec x y) (NDDiff _ _ n) ((NDSame _) (MemYes _ _ (MemHere x rest))))
  (match many (notail $ mem-dec x rest) _
    ((MemYes _ _ p) (MemYes _ _ (MemThere x y rest p)))
    ((MemNo _ _ p) (MemNo _ _ (NotMemCons x y rest n p)))))
(def-fns _ $ (many one-dec : (many (List (Nat)) ids) -> (many (OneDec ids) r))
  (let-match many ids (Cons _ x rest) ((Nil _) (OneNo _ (NotOneNil))))
  (match many rest _
    ((Nil _) (OneYes x))
    ((Cons _ y more) (OneNo _ (NotOneMore x y more)))))
(def-fns _ $ (many not-len-dec : (many (Nat) n) (subterm many (List (Term)) as) -> (many (NotLenDec n as) r))
  (let-match many as (Cons _ t rest)
    ((Nil _) (match many n _ ((Zero) (LenIs _ _ (LengthNil _))) ((Succ m) (LenIsNot _ _ (NLNilSucc m))))))
  (let-match many n (Succ m) ((Zero) (LenIsNot _ _ (NLConsZero t rest))))
  (match many (notail $ not-len-dec m rest) _
    ((LenIs _ _ p) (LenIs _ _ (LengthCons _ t rest m p)))
    ((LenIsNot _ _ p) (LenIsNot _ _ (NLCons m t rest p)))))
(def-fns _ $ (erased len-eq-trans : (erased Type A) (erased Type B) (erased Type C) (erased (List A) xs) (erased (List B) ys) (erased (List C) zs) (subterm erased (LenEq A B xs ys) p) (erased (LenEq B C ys zs) q) ->
    (erased (LenEq A C xs zs) r))
  (match erased p _
    ((LENil _ _) (match erased q _ ((LENil _ _) (LENil _ _))))
    ((LECons _ _ x _ xs2 ys2 p2) (match erased q _ ((LECons _ _ _ z _ zs2 q2) (LECons _ _ x z xs2 zs2 (len-eq-trans _ _ _ xs2 ys2 zs2 p2 q2)))))))
(def-fns _ $ (erased len-eq-sym : (erased Type A) (erased Type B) (erased (List A) xs) (erased (List B) ys) (subterm erased (LenEq A B xs ys) p) -> (erased (LenEq B A ys xs) q))
  (match erased p _
    ((LENil _ _) (LENil _ _))
    ((LECons _ _ x y xs2 ys2 p2) (LECons _ _ y x ys2 xs2 (len-eq-sym _ _ xs2 ys2 p2)))))
; A marked position of a telescope has an id in a list of the telescope's length.
(def-fns _ $ (erased absurd nth-marked : (erased (List (Entry)) ps) (erased (List (Nat)) ids) (erased (Nat) i) (erased (Nat) j) (subterm erased (MarkedIndex ps i j) mi) (erased (LenEq (Entry) (Nat) ps ids) le) (erased (NoNth (Nat) ids i) nn) ->
    (erased (False) f))
  (match erased mi _
    (absurd (MIHere _ _ _) (let-match erased le (LECons _ _ _ _ _ _ _)) nn)
    (absurd (MIYes _ _ es i2 j2 p)
      (let-match erased le (LECons _ _ _ _ _ ys q))
      (let-match erased nn (NoNthCons _ _ _ _ nn2))
      (nth-marked es ys i2 j2 p q nn2))
    (absurd (MINo _ _ es i2 j2 p)
      (let-match erased le (LECons _ _ _ _ _ ys q))
      (let-match erased nn (NoNthCons _ _ _ _ nn2))
      (nth-marked es ys i2 j2 p q nn2))))

; Scope of what the helpers build.
(def-fns _ $ (erased sc-somes : (erased (Ctx) ctx) (erased (List (Term)) as) (erased (List (Maybe (Term))) subs) (erased (Nat) m) (erased (Length (Term) as m) ln) (erased (ScL ctx (Zero) as) p) (erased (Somes as subs) so) ->
    (erased (ScS ctx subs m) q))
  (let-match erased p (MkScL _ _ _ _ _ _ _ _ _ sas))
  (MkScS _ _ _ _ _ _ _ _ _ (somes-scoped _ as subs sas so) (somes-layout as subs m so ln)))
(def-fns _ $ (erased refs-scoped : (erased (Ctx) ctx) (erased (List (Nat)) ids) (erased (List (Term)) ts) (erased (HasAll ctx ids) h) (subterm erased (Refs ids ts) rf) -> (erased (ScL ctx (Zero) ts) q))
  (let-match erased rf (RefsCons x rest ts2 p) ((RefsNil) (scl-nil ctx)))
  (let ((erased hx) (erased hrest)) (has-all-parts ctx x rest h))
  (scl-cons ctx (Ref x) ts2 (sc-ref ctx x hx) (refs-scoped ctx rest ts2 hrest p)))
(def-fns _ $ (erased marked-scoped : (erased (Ctx) ctx) (erased (List (Entry)) tele) (erased (List (Nat)) ids) (erased (List (Term)) out) (erased (HasAll ctx ids) h) (subterm erased (Marked tele ids out) mk) -> (erased (ScL ctx (Zero) out) q))
  (match erased mk _
    ((MarkedNil) (scl-nil ctx))
    ((MarkedYes _ _ es x rest out2 p)
      (let ((erased hx) (erased hrest)) (has-all-parts ctx x rest h))
      (scl-cons ctx (Ref x) out2 (sc-ref ctx x hx) (marked-scoped ctx es rest out2 hrest p)))
    ((MarkedNo _ _ es x rest out2 p)
      (let ((erased _) (erased hrest)) (has-all-parts ctx x rest h))
      (marked-scoped ctx es rest out2 hrest p))))
(def-fns _ $ (erased sc-subst : (erased (Ctx) ctx) (erased (List (Maybe (Term))) subs) (erased (Nat) m) (erased (Term) t) (erased (Term) u) (erased (ScS ctx subs m) ss) (erased (Sc ctx m t) st) (erased (Subst subs t u) sb) ->
    (erased (Sc ctx (Zero) u) su))
  (let-match erased ss (MkScS _ _ _ _ _ _ _ _ _ ssub ly))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
  (MkSc _ _ _ _ _ _ _ _ u (subst-scoped _ subs (Zero) m t u ssub ly sct sb)))
(def-fns _ $ (erased scs-length : (erased (Ctx) ctx) (erased (List (Maybe (Term))) subs) (erased (Nat) m) (erased (ScS ctx subs m) ss) -> (erased (Length (Maybe (Term)) subs m) ln))
  (let-match erased ss (MkScS _ _ _ _ _ _ _ _ _ _ ly))
  (layout-length _ subs (Zero) m ly))
(def-fns _ $ (erased sc-closed : (erased (Ctx) ctx) (erased (Nat) d) (erased (Term) t) (erased (Sc ctx d t) st) -> (erased (Closed d t) c))
  (let-match erased st (MkSc _ _ _ _ _ _ _ _ _ sct))
