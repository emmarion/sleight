(def-fns _ $ (erased ctors-parts : (erased (Ctx) ctx) (erased (Nat) c) (erased (List (Nat)) ids) (erased (Ctors ctx (Cons (Nat) c ids)) h) -> (erased (Ctors ctx ids) q))
