(def-fns _ $ (erased scl-parts : (erased (Ctx) ctx) (erased (Term) t) (erased (List (Term)) ts) (erased (ScL ctx (Zero) (Cons (Term) t ts)) s) -> (erased (Sc ctx (Zero) t) p) (erased (ScL ctx (Zero) ts) q))
