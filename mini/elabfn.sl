(def-fns _ $ (erased has-all-parts : (erased (Ctx) ctx) (erased (Nat) x) (erased (List (Nat)) ids) (erased (HasAll ctx (Cons (Nat) x ids)) h) -> (erased (Has ctx x) p) (erased (HasAll ctx ids) q))
