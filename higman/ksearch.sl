(def-fns _ $ (many higman-factory : (erased (Level) M) ->
    (erased (Level) L)
    (many (Fn L (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G)
              (many (Fn M (many (Nat) i) -> (many (List (Nat)) w) (erased (G i w) g) (erased (Letters hk w) lw)) f)
              -> (many (GoodK G) r)) search))
  (def-lvl A)
  (let ((erased D) (many run)) (dm-factory A))
  (def-fns _ $ (many search : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G)
      (many (Fn M (many (Nat) i) -> (many (List (Nat)) w) (erased (G i w) g) (erased (Letters hk w) lw)) f) -> (many (GoodK G) r))
    (let ((many full) (erased rf)) (trues hk))
    (let ((many root)) (Cons (Item) (IStar full) (Nil (Item))))
    (let ((many roots)) (Cons (List (Item)) root (Nil (List (Item)))))
    (let ((erased ok)) (OKStar hk full (Nil (Item)) (repeat-length (Bool) hk (BTrue) full rf) (OKNil hk)))
    (let ((many r0) (erased x0)) (rank hk root ok))
    (let ((many m0) (erased i0)) (ins kn r0 (rk-length hk root r0 x0) (Nil (Grp)) (DcNil kn)))
    (let ((many fr0)) (KFCons G root (Nil (List (Item))) (KNLeaf G root) (KFNil G)))
    (let ((erased mf0))
      (KMCons G hk (Zero) root (Nil (List (Item))) (KNLeaf G root) (KFNil G) (Nil (Grp)) (Nil (Grp)) m0
        (KMNil G hk (Zero) (Nil (Grp))) (KMLeaf G hk (Zero) root r0 (Nil (Grp)) m0 ok x0 i0)))
    (def-adts $ (St : ((List (Grp)) m) -> Type)
      enum
      (many MkSt : (erased (List (Grp)) m) (many (Nat) nn) (many (KF G roots) fr) (erased (KMF G hk nn roots fr (Nil (Grp)) m) mf)
         -> (St m)))
    (def-fns A $ (many step : (many (List (Grp)) m) (many (St m) st) -> (many (DStep St (GoodK G) kn m) o))
      (let-match many st (MkSt _ nn fr mf))
      (let ((many w) (erased gw) (erased lw)) (f nn))
      (let ((erased fx)) (FitStar full w (Nil (List (Nat))) (Nil (Item)) (Nil (Nat)) w (letters-in hk full w rf lw) (FitNil) (wcat-nil w)))
      (let-match many (kinsert G hk nn nn (lt-succ nn) w gw roots fr (Zero) root (NthHere (List (Item)) root (Nil (List (Item))))
          (Cons (List (Nat)) w (Nil (List (Nat)))) fx (Nil (Grp)) m mf (DcNil kn))
        (KIns _ _ _ _ _ _ _ _ fr2 m2 mf2 rd dr)
        ((KFound _ _ _ _ _ _ _ _ n w2 gw2 l e) (DSDone St (GoodK G) kn m (MkGoodK G n nn l w2 w gw2 gw e))))
      (DSNext St (GoodK G) kn m m2 (MkSt m2 (Succ nn) fr2 mf2) rd dr (kmf-desc G hk (Succ nn) roots fr2 (Nil (Grp)) m2 mf2 (DcNil kn))))
    (run St (GoodK G) step m0 (ins-desc kn r0 (Nil (Grp)) m0 i0 (rk-length hk root r0 x0) (DcNil kn)) (MkSt m0 (Zero) fr0 mf0)))
  (values (level-of search) search))

(qed (MkHigmanK hk (level-of higman-factory) higman-factory))
