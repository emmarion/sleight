(def-fns _ $ (many higman-factory : (erased (Level) M) ->
    (erased (Level) L)
    (many (Fn L (erased (TyCtor ((Nat) i) ((List (Bool)) w) -> Type) G)
              (many (Fn M (many (Nat) i) -> (many (List (Bool)) w) (erased (G i w) g)) f)
              -> (many (Good G) r)) search))
  (def-lvl A)
  (let ((erased D) (many dickson)) (dickson-factory A))
  (def-fns _ $ (many search : (erased (TyCtor ((Nat) i) ((List (Bool)) w) -> Type) G)
      (many (Fn M (many (Nat) i) -> (many (List (Bool)) w) (erased (G i w) g)) f) -> (many (Good G) r))
    (let ((many w0) (erased g0)) (f (Zero)))
    (let ((many m) (erased lw)) (list-len (Bool) w0))
    (let ((many bs) (erased rs)) (roots (Zero) m))
    ; The point x of item u at index i: u is the word at index i+1, and x is its exponent vector against w0.
    (def-adts $ (At : ((Nat) i) ((List (Bool)) u) ((List (Nat)) x) -> Type)
      enum
      (many MkAt : (erased (Nat) i) (erased (List (Bool)) u) (erased (List (Nat)) x) (erased (G (Succ i) u) g)
         (erased (Av w0 x u) a) -> (At i u x)))
    (def-fns A $ (many item : (many (Nat) i) -> (many (Elem (List (Bool)) At (Good G) bs i) e))
      (let ((many v) (erased gv)) (f (Succ i)))
      (let-match many (decompose w0 v) (DAv _ _ x a)
        ((DEmb _ _ e) (EEsc (List (Bool)) At (Good G) bs i (MkGood G (Zero) (Succ i) (LtZ i) w0 v g0 gv e))))
      (let ((many n) (erased ln)) (list-len (Nat) x))
      (let ((erased n2) (erased ln2) (erased l)) (av-length w0 v x m a lw))
      (let-match erased (length-fn (Nat) x n n2 ln ln2) (Refl _ _))
      (let ((erased b) (erased nb) (erased r)) (roots-nth (Zero) m n n bs rs (add-zero-right n) l))
      (EPt (List (Bool)) At (Good G) bs i v x (MkAt i v x gv a) n b nb (all-any-inbox n b x r ln)))
    (let-match many (dickson (List (Bool)) At (Good G) m bs (roots-ok (Zero) m m bs rs (AddZero m)) item)
      (RFound _ _ _ i j l u x v y pu pv le)
      ((REsc _ _ _ r) r))
    (let-match erased pu (MkAt _ _ _ gu au))
    (let-match erased pv (MkAt _ _ _ gv av))
    (MkGood G (Succ i) (Succ j) (LtS i j l) u v gu gv (av-mono w0 u v x y au av le)))
  (values (level-of search) search))

(qed (MkHigman (level-of higman-factory) higman-factory))
