(def-adts $ (OKB : ((Nat) k) ((List (Item)) b) -> Type)
  enum
  (many OKNil : (erased (Nat) k) -> (OKB k (Nil (Item))))
  (many OKStar : (erased (Nat) k) (erased (List (Bool)) g) (erased (List (Item)) b) (erased (Length (Bool) g k) l) (erased (OKB k b) o)
     -> (OKB k (Cons (Item) (IStar g) b)))
  (many OKLit : (erased (Nat) k) (erased (Nat) c) (erased (List (Item)) b) (erased (OKB k b) o) -> (OKB k (Cons (Item) (ILit c) b))))

; r : one entry per alphabet size, from k down to 0, counting the blocks of b of that size.
(def-adts $ (RK : ((Nat) k) ((List (Item)) b) ((List (Nat)) r) -> Type)
  enum
  (many RKNil : (erased (Nat) k) (erased (List (Nat)) z) (erased (Repeat (Nat) (Succ k) (Zero) z) rp) -> (RK k (Nil (Item)) z))
  (many RKLit : (erased (Nat) k c) (erased (List (Item)) b) (erased (List (Nat)) r) (erased (RK k b r) x)
     -> (RK k (Cons (Item) (ILit c) b) r))
  (many RKStar : (erased (Nat) k) (erased (List (Bool)) g) (erased (Nat) s p) (erased (List (Item)) b) (erased (List (Nat)) e r1 r)
     (erased (Cnt g s) cn) (erased (Add p s k) ad) (erased (UnitP p s e) up) (erased (RK k b r1) x) (erased (VAdd e r1 r) va)
     -> (RK k (Cons (Item) (IStar g) b) r)))

(def-fns _ $ (many cnt : (subterm many (List (Bool)) g) -> (many (Nat) s) (erased (Cnt g s) c))
  (let-match many g (Cons _ x g1) ((Nil _) (values (Zero) (CntNil))))
  (let ((many s1) (erased c1)) (notail $ cnt g1))
  (match many x _ ((BTrue) (values (Succ s1) (CntT g1 s1 c1))) ((BFalse) (values s1 (CntF g1 s1 c1)))))

(def-fns _ $ (erased cnt-le : (erased (List (Bool)) g) (erased (Nat) s k) (subterm erased (Cnt g s) c) (erased (Length (Bool) g k) l)
    -> (erased (Lt s (Succ k)) q))
  (match erased c _
    ((CntNil) (let-match erased l (LengthNil _)) (LtZ (Zero)))
    ((CntT g1 s1 c1) (let-match erased l (LengthCons _ _ _ k1 l1)) (LtS s1 (Succ k1) (cnt-le g1 s1 k1 c1 l1)))
    ((CntF g1 _ c1) (let-match erased l (LengthCons _ _ _ k1 l1)) (lt-weaken s (Succ k1) (cnt-le g1 s k1 c1 l1)))))

(def-fns _ $ (erased cnt-fn : (erased (List (Bool)) g) (erased (Nat) s t) (subterm erased (Cnt g s) c) (erased (Cnt g t) d)
    -> (erased (Eq (Nat) s t) e))
  (match erased c _
    ((CntNil) (let-match erased d (CntNil)) (Refl (Nat) s))
    ((CntT g1 s1 c1) (let-match erased d (CntT _ t1 d1)) (let-match erased (cnt-fn g1 s1 t1 c1 d1) (Refl _ _)) (Refl (Nat) s))
    ((CntF g1 _ c1) (let-match erased d (CntF _ _ d1)) (cnt-fn g1 s t c1 d1))))

(def-fns _ $ (many zeros : (subterm many (Nat) n) -> (many (List (Nat)) z) (erased (Repeat (Nat) n (Zero) z) r))
  (let-match many n (Succ n1) ((Zero) (values (Nil (Nat)) (RepeatNil (Nat) (Zero)))))
  (let ((many z1) (erased r1)) (notail $ zeros n1))
  (values (Cons (Nat) (Zero) z1) (RepeatCons (Nat) n1 (Zero) z1 r1)))

(def-fns _ $ (many unit : (subterm many (Nat) p) (many (Nat) j) -> (many (List (Nat)) u) (erased (UnitP p j u) up))
  (let-match many p (Succ p1)
    ((Zero) (let ((many z) (erased r)) (zeros j)) (values (Cons (Nat) (Succ (Zero)) z) (UPZ j z r))))
  (let ((many u1) (erased up1)) (notail $ unit p1 j))
  (values (Cons (Nat) (Zero) u1) (UPS p1 j u1 up1)))

(def-fns _ $ (many vadd : (subterm many (List (Nat)) a) (many (List (Nat)) b) (erased (Nat) n) (erased (Length (Nat) a n) la)
    (erased (Length (Nat) b n) lb) -> (many (List (Nat)) c) (erased (VAdd a b c) va))
  (let-match many a (Cons _ x a1)
    ((Nil _) (let-match erased la (LengthNil _)) (let-match erased lb (LengthNil _)) (values (Nil (Nat)) (VANil))))
  (let-match erased la (LengthCons _ _ _ n1 la1))
  (let-match erased lb (LengthCons _ y0 b0 _ lb1))
  (let-match many b (Cons _ y b1))
  (let ((many z) (erased ad)) (add x y))
  (let ((many c1) (erased va1)) (notail $ vadd a1 b1 n1 la1 lb1))
  (values (Cons (Nat) z c1) (VACons x y z ad a1 b1 c1 va1)))

(def-fns _ $ (erased rk-length : (erased (Nat) k) (erased (List (Item)) b) (erased (List (Nat)) r) (subterm erased (RK k b r) x)
    -> (erased (Length (Nat) r (Succ k)) l))
  (match erased x _
    ((RKNil _ _ rp) (repeat-length (Nat) (Succ k) (Zero) r rp))
    ((RKLit _ _ b1 _ x1) (rk-length k b1 r x1))
    ((RKStar _ _ _ _ b1 _ r1 _ _ _ _ x1 va) (vadd-length (Succ k) r1 _ r (vadd-comm _ r1 r va) (rk-length k b1 r1 x1)))))

(def-fns _ $ (many rank : (many (Nat) k) (subterm many (List (Item)) b) (erased (OKB k b) o) -> (many (List (Nat)) r) (erased (RK k b r) x))
  (let-match many b (Cons _ it b1)
    ((Nil _) (let ((many z) (erased rp)) (zeros (Succ k))) (values z (RKNil k z rp))))
  (match many it _
    ((ILit c)
      (let-match erased o (OKLit _ _ _ o1))
      (let ((many r) (erased x)) (tail $ rank k b1 o1))
      (values r (RKLit k c b1 r x)))
    ((IStar g)
      (let-match erased o (OKStar _ _ _ lg o1))
      (let ((many r1) (erased x1)) (notail $ rank k b1 o1))
      (let ((many s) (erased cn)) (cnt g))
      (let ((many p) (erased ad)) (sub k s (cnt-le g s k cn lg)))
      (let ((erased ad2)) (add-comm s p k ad))
      (let ((many e) (erased up)) (unit p s))
      (let ((many r) (erased va)) (vadd e r1 (Succ k) (unit-length p s k e up ad2) (rk-length k b1 r1 x1)))
      (values r (RKStar k g s p b1 e r1 r cn ad2 up x1 va)))))

(def-fns _ $ (erased unitp-fn : (erased (Nat) p j) (erased (List (Nat)) u v) (subterm erased (UnitP p j u) a) (erased (UnitP p j v) b)
    -> (erased (Eq (List (Nat)) u v) e))
  (match erased a _
    ((UPZ _ z r) (let-match erased b (UPZ _ z2 r2)) (let-match erased (repeat-fn (Nat) j (Zero) z z2 r r2) (Refl _ _)) (Refl (List (Nat)) u))
    ((UPS p1 _ u1 a1) (let-match erased b (UPS _ _ v1 b1)) (let-match erased (unitp-fn p1 j u1 v1 a1 b1) (Refl _ _)) (Refl (List (Nat)) u))))

(def-fns _ $ (erased vadd-fn : (erased (List (Nat)) a b c d) (subterm erased (VAdd a b c) p) (erased (VAdd a b d) q)
    -> (erased (Eq (List (Nat)) c d) e))
  (let-match erased p (VACons x y z ad a1 b1 c1 p1) ((VANil) (let-match erased q (VANil)) (Refl (List (Nat)) c)))
  (let-match erased q (VACons _ _ z2 ad2 _ _ d1 q1))
  (let-match erased (add-fn x y z z2 ad ad2) (Refl _ _))
  (let-match erased (vadd-fn a1 b1 c1 d1 p1 q1) (Refl _ _))
  (Refl (List (Nat)) c))

(def-fns _ $ (erased rk-fn : (erased (Nat) k) (erased (List (Item)) b) (erased (List (Nat)) r r2) (subterm erased (RK k b r) x)
    (erased (RK k b r2) y) -> (erased (Eq (List (Nat)) r r2) e))
  (match erased x _
    ((RKNil _ _ rp) (let-match erased y (RKNil _ _ rp2)) (repeat-fn (Nat) (Succ k) (Zero) r r2 rp rp2))
    ((RKLit _ _ b1 _ x1) (let-match erased y (RKLit _ _ _ _ y1)) (rk-fn k b1 r r2 x1 y1))
    ((RKStar _ g s p b1 e r1 _ cn ad up x1 va)
      (let-match erased y (RKStar _ _ s2 p2 _ e2 r3 _ cn2 ad2 up2 y1 va2))
      (let-match erased (cnt-fn g s s2 cn cn2) (Refl _ _))
      (let-match erased (add-cancel s p p2 k (add-comm p s k ad) (add-comm p2 s k ad2)) (Refl _ _))
      (let-match erased (unitp-fn p s e e2 up up2) (Refl _ _))
      (let-match erased (rk-fn k b1 r1 r3 x1 y1) (Refl _ _))
      (vadd-fn e r1 r r2 va va2))))

(def-fns _ $ (erased vadd-reassoc : (erased (List (Nat)) a b ab c s) (subterm erased (VAdd a b ab) p) (erased (VAdd ab c s) q)
    -> (erased (List (Nat)) bc) (erased (VAdd b c bc) r) (erased (VAdd a bc s) t))
  (let-match erased p (VACons x y xy ad a1 b1 ab1 p1) ((VANil) (let-match erased q (VANil)) (values (Nil (Nat)) (VANil) (VANil))))
  (let-match erased q (VACons _ z w ad2 _ c1 s1 q1))
  (let ((erased yz) (erased r1) (erased t1)) (add-reassoc x y z xy w ad ad2))
  (let ((erased bc1) (erased r2) (erased t2)) (vadd-reassoc a1 b1 ab1 c1 s1 p1 q1))
  (values (Cons (Nat) yz bc1) (VACons y z yz r1 b1 c1 bc1 r2) (VACons x yz w t1 a1 bc1 s1 t2)))

(def-adts $ (LeafOKK : ((Nat) k) ((List (List (Item))) ps) ((List (Nat)) rb) -> Type)
  enum
  (many LKNil : (erased (Nat) k) (erased (List (Nat)) rb) -> (LeafOKK k (Nil (List (Item))) rb))
  (many LKCons : (erased (Nat) k) (erased (List (Item)) q) (erased (List (List (Item))) qs) (erased (List (Nat)) rq rb)
     (erased (OKB k q) o) (erased (RK k q rq) x) (erased (RLt (Succ k) rq rb) l) (erased (LeafOKK k qs rb) lk)
     -> (LeafOKK k (Cons (List (Item)) q qs) rb)))

(def-fns _ $ (erased lk-lit : (erased (Nat) k c) (erased (List (List (Item))) ps rs) (erased (List (Nat)) rb)
    (subterm erased (ConsAll (Item) (ILit c) ps rs) ca) (erased (LeafOKK k ps rb) lk) -> (erased (LeafOKK k rs rb) lk2))
  (let-match erased ca (CACons _ _ q ps1 rs1 ca1) ((CANil _ _) (LKNil k rb)))
  (let-match erased lk (LKCons _ _ _ rq _ o x l lk1))
  (LKCons k (Cons (Item) (ILit c) q) rs1 rq rb (OKLit k c q o) (RKLit k c q rq x) l (lk-lit k c ps1 rs1 rb ca1 lk1)))

(def-fns _ $ (erased lk-star : (erased (Nat) k s p) (erased (List (Bool)) g) (erased (List (List (Item))) ps rs) (erased (List (Nat)) e rb1 rb)
    (subterm erased (ConsAll (Item) (IStar g) ps rs) ca) (erased (LeafOKK k ps rb1) lk) (erased (Cnt g s) cn) (erased (Add p s k) ad)
    (erased (UnitP p s e) up) (erased (Length (Bool) g k) lg) (erased (VAdd e rb1 rb) va) (erased (Length (Nat) rb1 (Succ k)) lr)
    -> (erased (LeafOKK k rs rb) lk2))
  (let-match erased ca (CACons _ _ q ps1 rs1 ca1) ((CANil _ _) (LKNil k rb)))
  (let-match erased lk (LKCons _ _ _ rq _ o x l lk1))
  (let-match erased l (MkRLt _ p2 _ _ lp))
  (let ((erased rq2) (erased va2) (erased _)) (vadd-exists (Succ k) e rq (unit-length p s k e up ad) (rk-length k q rq x)))
  (LKCons k (Cons (Item) (IStar g) q) rs1 rq2 rb (OKStar k g q lg o) (RKStar k g s p q e rq rq2 cn ad up x va2)
    (MkRLt (Succ k) p2 rq2 rb (lexpos-add (Succ k) p2 rq rb1 e rq2 rb lp (vadd-comm e rq rq2 va2) (vadd-comm e rb1 rb va)))
    (lk-star k s p g ps1 rs1 e rb1 rb ca1 lk1 cn ad up lg va lr)))

(def-fns _ $ (erased lk-cat : (erased (Nat) k) (erased (List (List (Item))) a b c) (erased (List (Nat)) rb)
    (subterm erased (LCat (List (Item)) a b c) ap) (erased (LeafOKK k a rb) la) (erased (LeafOKK k b rb) lb) -> (erased (LeafOKK k c rb) lc))
  (let-match erased ap (LCCons _ x a1 _ c1 ap1) ((LCNil _ _) lb))
  (let-match erased la (LKCons _ _ _ rq _ o y l la1))
  (LKCons k x c1 rq rb o y l (lk-cat k a1 b c1 rb ap1 la1 lb)))

; Every q in ss has rank rb + d, d zero in its first p+1 entries.
(def-adts $ (AuxL : ((Nat) k p) ((List (List (Item))) ss) ((List (Nat)) rb) -> Type)
  enum
  (many AXNil : (erased (Nat) k p) (erased (List (Nat)) rb) -> (AuxL k p (Nil (List (Item))) rb))
  (many AXCons : (erased (Nat) k p) (erased (List (Item)) q) (erased (List (List (Item))) qs) (erased (List (Nat)) rb rq d)
     (erased (OKB k q) o) (erased (RK k q rq) x) (erased (VAdd d rb rq) va) (erased (ZP (Succ p) d) z) (erased (Length (Nat) d (Succ k)) ld)
     (erased (AuxL k p qs rb) ax) -> (AuxL k p (Cons (List (Item)) q qs) rb)))

(def-fns _ $ (erased aux-cons : (erased (Nat) k p s1) (erased (List (Bool)) h) (erased (Nat) a) (erased (List (List (Item))) ss ts rs)
    (erased (List (Nat)) rb eh) (subterm erased (ConsAll (Item) (ILit a) ss ts) c1) (erased (ConsAll (Item) (IStar h) ts rs) c2)
    (erased (AuxL k p ss rb) ax) (erased (Cnt h s1) cn) (erased (Add (Succ p) s1 k) ad) (erased (UnitP (Succ p) s1 eh) up)
    (erased (Length (Bool) h k) lh) (erased (Length (Nat) rb (Succ k)) lr) -> (erased (AuxL k p rs rb) ax2))
  (let-match erased c1 (CACons _ _ q ss1 ts1 c3) ((CANil _ _) (let-match erased c2 (CANil _ _)) (AXNil k p rb)))
  (let-match erased c2 (CACons _ _ _ _ rs1 c4))
  (let-match erased ax (AXCons _ _ _ _ _ rq d o x va z ld ax1))
  (let ((erased le)) (unit-length (Succ p) s1 k eh up ad))
  (let ((erased rq2) (erased va2) (erased lq2)) (vadd-exists (Succ k) eh rq le (rk-length k q rq x)))
  (let ((erased d2) (erased va3) (erased ld2)) (vadd-exists (Succ k) eh d le ld))
  (let ((erased s) (erased va4) (erased _)) (vadd-exists (Succ k) d2 rb ld2 lr))
  (let ((erased bc) (erased va5) (erased va6)) (vadd-reassoc eh d d2 rb s va3 va4))
  (let-match erased (vadd-fn d rb bc rq va5 va) (Refl _ _))
  (let-match erased (vadd-fn eh rq s rq2 va6 va2) (Refl _ _))
  (AXCons k p (Cons (Item) (IStar h) (Cons (Item) (ILit a) q)) rs1 rb rq2 d2
    (OKStar k h _ lh (OKLit k a q o)) (RKStar k h s1 (Succ p) _ eh rq rq2 cn ad up (RKLit k a q rq x) va2) va4
    (zp-vadd (Succ p) eh d d2 (zp-unit (Succ p) (Succ p) s1 eh up (lt-succ (Succ p))) z va3) ld2
    (aux-cons k p s1 h a ss1 ts1 rs1 rb eh c3 c4 ax1 cn ad up lh lr)))

(def-fns _ $ (erased aux-shapes : (erased (Nat) k s p) (erased (List (Bool)) g) (erased (List (Nat)) u) (erased (List (Item)) b)
    (erased (List (List (Item))) ss) (erased (List (Nat)) rb) (subterm erased (Shapes g u b ss) sh) (erased (AllIn g u) inu)
    (erased (Cnt g s) cn) (erased (Add p s k) ad) (erased (Length (Bool) g k) lg) (erased (OKB k b) o) (erased (RK k b rb) x)
    -> (erased (AuxL k p ss rb) ax))
  (let-match erased sh (ShCons _ h a u1 _ ss1 ts rs sp sh1 c1 c2) ((ShNil _ _) (AXNil k p rb)))
  (let-match erased inu (InCons _ _ _ na inu1))
  (let ((erased s1) (erased e) (erased cn1)) (cnt-clear g h a s sp na cn))
  (let-match erased e (Refl _ _))
  (let ((erased k1) (erased e2) (erased ad1)) (add-succ-right-inv p s1 k ad))
  (let-match erased e2 (Refl _ _))
  (let ((erased ad2)) (AddSucc p s1 k1 ad1))
  (let ((erased lh)) (setnth-length (Bool) g a k (BFalse) h sp lg))
  (let ((erased eh) (erased up)) (unit-exists (Succ p) s1))
  (let ((erased le)) (unit-length (Succ p) s1 k eh up ad2))
  (let ((erased lr)) (rk-length k b rb x))
  (let ((erased rq) (erased va) (erased _)) (vadd-exists (Succ k) eh rb le lr))
  (AXCons k p (Cons (Item) (IStar h) b) rs rb rq eh (OKStar k h b lh o) (RKStar k h s1 (Succ p) b eh rb rq cn1 ad2 up x va) va
    (zp-unit (Succ p) (Succ p) s1 eh up (lt-succ (Succ p))) le
    (aux-cons k p s1 h a ss1 ts rs rb eh c1 c2 (aux-shapes k s p g u1 b ss1 rb sh1 inu1 cn ad lg o x) cn1 ad2 up lh lr)))

(def-fns _ $ (erased aux-lk : (erased (Nat) k p s) (erased (List (List (Item))) ss) (erased (List (Nat)) rb e rbe)
    (subterm erased (AuxL k p ss rb) ax) (erased (UnitP p s e) up) (erased (Add p s k) ad) (erased (VAdd e rb rbe) va)
    -> (erased (LeafOKK k ss rbe) lk))
  (let-match erased ax (AXCons _ _ q qs _ rq d o x va1 z ld ax1) ((AXNil _ _ _) (LKNil k rbe)))
  (LKCons k q qs rq rbe o x
    (MkRLt (Succ k) p rq rbe (lexpos-add (Succ k) p d e rb rq rbe (lexpos-unit p s k d e up z ad) va1 va))
    (aux-lk k p s qs rb e rbe ax1 up ad va)))

(def-fns _ $ (erased pcs-lk : (erased (Nat) k) (erased (List (Item)) b) (erased (List (List (Nat))) pp) (erased (List (Nat)) w rb)
    (erased (List (List (Item))) ps) (subterm erased (Pcs b pp ps) pc) (erased (Fits b pp w) f) (erased (OKB k b) o) (erased (RK k b rb) x)
    -> (erased (LeafOKK k ps rb) lk))
  (match erased pc _
    ((PcNil) (LKNil k rb))
    ((PcLit c b1 _ ps1 _ pc1 ca)
      (let-match erased f (FitLit _ _ _ w1 f1))
      (let-match erased o (OKLit _ _ _ o1))
      (let-match erased x (RKLit _ _ _ _ x1))
      (lk-lit k c ps1 ps rb ca (pcs-lk k b1 pp w1 rb ps1 pc1 f1 o1 x1)))
    ((PcStar g u b1 pp1 ss ps1 rs _ sh pc1 ca ap)
      (let-match erased f (FitStar _ _ _ _ w1 _ inu f1 _))
      (let-match erased o (OKStar _ _ _ lg o1))
      (let-match erased x (RKStar _ _ s p _ e rb1 _ cn ad up x1 va))
      (lk-cat k ss rs ps rb ap
        (aux-lk k p s ss rb1 e rb (aux-shapes k s p g u b1 ss rb1 sh inu cn ad lg o1 x1) up ad va)
        (lk-star k s p g ps1 rs e rb1 rb ca (pcs-lk k b1 pp1 w1 rb1 ps1 pc1 f1 o1 x1) cn ad up lg va (rk-length k b1 rb1 x1))))))

; G n w : the word w is the sequence's word at index n.
(def-adts
  ((KF : ((TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) ((List (List (Item))) bs) -> Type)
    enum
    (many KFNil : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) -> (KF G (Nil (List (Item)))))
    (many KFCons : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (List (Item)) b) (erased (List (List (Item))) bs)
       (many (KN G b) node) (many (KF G bs) rest) -> (KF G (Cons (List (Item)) b bs))))
  ((KN : ((TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) ((List (Item)) b) -> Type)
    enum
    (many KNLeaf : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (List (Item)) b) -> (KN G b))
    (many KNSplit : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (List (Item)) b) (many (Nat) n) (many (List (Nat)) w)
       (many (List (List (Nat))) pp) (erased (G n w) gw) (erased (Fits b pp w) f) (many (List (List (Item))) ps) (erased (Pcs b pp ps) pc)
       (many (KF G ps) kids) -> (KN G b))))

; a, z : the measure before and after inserting the ranks of the forest's leaves; N bounds the indices it holds.
(def-adts
  ((KMF : ((TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) ((Nat) k) ((Nat) N) ((List (List (Item))) bs) ((KF G bs) f)
       ((List (Grp)) a) ((List (Grp)) z) -> Type)
    enum
    (many KMNil : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Grp)) a)
       -> (KMF G k N (Nil (List (Item))) (KFNil G) a a))
    (many KMCons : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Item)) b)
       (erased (List (List (Item))) bs) (erased (KN G b) node) (erased (KF G bs) rest) (erased (List (Grp)) a mid z)
       (erased (KMF G k N bs rest a mid) mf) (erased (KMN G k N b node mid z) mn) -> (KMF G k N (Cons (List (Item)) b bs) (KFCons G b bs node rest) a z)))
  ((KMN : ((TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) ((Nat) k) ((Nat) N) ((List (Item)) b) ((KN G b) nd)
       ((List (Grp)) a) ((List (Grp)) z) -> Type)
    enum
    (many KMLeaf : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Item)) b)
       (erased (List (Nat)) r) (erased (List (Grp)) a z) (erased (OKB k b) o) (erased (RK k b r) x) (erased (Ins (Succ k) r a z) i)
       -> (KMN G k N b (KNLeaf G b) a z))
    (many KMSplit : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Item)) b)
       (erased (Nat) n) (erased (List (Nat)) w) (erased (List (List (Nat))) pp) (erased (G n w) gw) (erased (Fits b pp w) f)
       (erased (List (List (Item))) ps) (erased (Pcs b pp ps) pc) (erased (KF G ps) kids) (erased (List (Grp)) a z)
       (erased (Lt n N) l) (erased (KMF G k N ps kids a z) mf) -> (KMN G k N b (KNSplit G b n w pp gw f ps pc kids) a z))))

(def-fns _
  ((erased kmf-desc : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (List (Item))) bs)
      (erased (KF G bs) f) (erased (List (Grp)) a z) (subterm erased (KMF G k N bs f a z) mf) (erased (Desc (Succ k) a) d)
      -> (erased (Desc (Succ k) z) e))
    (match erased mf _
      ((KMNil _ _ _ _) d)
      ((KMCons _ _ _ b bs1 node rest _ mid _ mf1 mn) (kmn-desc G k N b node mid z mn (kmf-desc G k N bs1 rest a mid mf1 d)))))
  ((erased kmn-desc : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Item)) b)
      (erased (KN G b) nd) (erased (List (Grp)) a z) (subterm erased (KMN G k N b nd a z) mn) (erased (Desc (Succ k) a) d)
      -> (erased (Desc (Succ k) z) e))
    (match erased mn _
      ((KMLeaf _ _ _ _ r _ _ _ x i) (ins-desc (Succ k) r a z i (rk-length k b r x) d))
      ((KMSplit _ _ _ _ _ _ _ _ _ ps _ kids _ _ _ mf) (kmf-desc G k N ps kids a z mf d)))))

(def-fns _
  ((erased kmf-weaken : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N Nb) (erased (Lt N (Succ Nb)) le)
      (erased (List (List (Item))) bs) (erased (KF G bs) f) (erased (List (Grp)) a z) (subterm erased (KMF G k N bs f a z) mf)
      -> (erased (KMF G k Nb bs f a z) mf2))
    (match erased mf _
      ((KMNil _ _ _ _) (KMNil G k Nb a))
      ((KMCons _ _ _ b bs1 node rest _ mid _ mf1 mn)
        (KMCons G k Nb b bs1 node rest a mid z (kmf-weaken G k N Nb le bs1 rest a mid mf1) (kmn-weaken G k N Nb le b node mid z mn)))))
  ((erased kmn-weaken : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N Nb) (erased (Lt N (Succ Nb)) le)
      (erased (List (Item)) b) (erased (KN G b) nd) (erased (List (Grp)) a z) (subterm erased (KMN G k N b nd a z) mn)
      -> (erased (KMN G k Nb b nd a z) mn2))
    (match erased mn _
      ((KMLeaf _ _ _ _ r _ _ o x i) (KMLeaf G k Nb b r a z o x i))
      ((KMSplit _ _ _ _ n w pp gw f ps pc kids _ _ l mf)
        (KMSplit G k Nb b n w pp gw f ps pc kids a z (lt-le-trans n N Nb l le) (kmf-weaken G k N Nb le ps kids a z mf))))))

(def-fns _
  ((erased kmf-drop : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N Nc) (erased (List (Nat)) rd)
      (erased (List (List (Item))) bs) (erased (KF G bs) f) (erased (List (Grp)) a a2 z z2) (erased (Drop (Succ k) rd a a2) d)
      (subterm erased (KMF G k N bs f a z) mf) (erased (KMF G k Nc bs f a2 z2) mf2) -> (erased (Drop (Succ k) rd z z2) e))
    (match erased mf _
      ((KMNil _ _ _ _) (let-match erased mf2 (KMNil _ _ _ _)) d)
      ((KMCons _ _ _ b bs1 node rest _ mid _ mf1 mn)
        (let-match erased mf2 (KMCons _ _ _ _ _ _ _ _ mid2 _ mf3 mn2))
        (kmn-drop G k N Nc rd b node mid mid2 z z2 (kmf-drop G k N Nc rd bs1 rest a a2 mid mid2 d mf1 mf3) mn mn2))))
  ((erased kmn-drop : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N Nc) (erased (List (Nat)) rd)
      (erased (List (Item)) b) (erased (KN G b) nd) (erased (List (Grp)) a a2 z z2) (erased (Drop (Succ k) rd a a2) d)
      (subterm erased (KMN G k N b nd a z) mn) (erased (KMN G k Nc b nd a2 z2) mn2) -> (erased (Drop (Succ k) rd z z2) e))
    (match erased mn _
      ((KMLeaf _ _ _ _ r _ _ _ x i)
        (let-match erased mn2 (KMLeaf _ _ _ _ r2 _ _ _ x2 i2))
        (let-match erased (rk-fn k b r r2 x x2) (Refl _ _))
        (ins-drop (Succ k) rd r a a2 z z2 d i i2))
      ((KMSplit _ _ _ _ _ _ _ _ _ ps _ kids _ _ _ mf)
        (let-match erased mn2 (KMSplit _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ mf2))
        (kmf-drop G k N Nc rd ps kids a a2 z z2 d mf mf2)))))

(def-fns _
  ((many kmf-run : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (many (Nat) k) (erased (Nat) N) (many (List (List (Item))) bs)
      (subterm many (KF G bs) f) (erased (List (Grp)) a z) (erased (KMF G k N bs f a z) mf) (many (List (Grp)) a2)
      (erased (Desc (Succ k) a2) d) -> (many (List (Grp)) z2) (erased (KMF G k N bs f a2 z2) mf2))
    (let-match many f (KFCons _ _ _ node rest) ((KFNil _) (let-match erased mf (KMNil _ _ _ _)) (values a2 (KMNil G k N a2))))
    (let-match many bs (Cons _ b bs2))
    (let-match erased mf (KMCons _ _ _ _ _ _ _ _ mid _ mf1 mn))
    (let ((many mid2) (erased mf3)) (notail $ kmf-run G k N bs2 rest a mid mf1 a2 d))
    (let ((many z2) (erased mn2)) (tail $ kmn-run G k N b node mid z mn mid2 (kmf-desc G k N bs2 rest a2 mid2 mf3 d)))
    (values z2 (KMCons G k N b bs2 node rest a2 mid2 z2 mf3 mn2)))
  ((many kmn-run : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (many (Nat) k) (erased (Nat) N) (many (List (Item)) b)
      (subterm many (KN G b) nd) (erased (List (Grp)) a z) (erased (KMN G k N b nd a z) mn) (many (List (Grp)) a2)
      (erased (Desc (Succ k) a2) d) -> (many (List (Grp)) z2) (erased (KMN G k N b nd a2 z2) mn2))
    (match many nd _
      ((KNLeaf _ _)
        (let-match erased mn (KMLeaf _ _ _ _ _ _ _ o _ _))
        (let ((many r) (erased x)) (rank k b o))
        (let ((many z2) (erased i)) (ins (Succ k) r (rk-length k b r x) a2 d))
        (values z2 (KMLeaf G k N b r a2 z2 o x i)))
      ((KNSplit _ _ n w pp gw f ps pc kids)
        (let-match erased mn (KMSplit _ _ _ _ _ _ _ _ _ _ _ _ _ _ l mf))
        (let ((many z2) (erased mf2)) (tail $ kmf-run G k N ps kids a z mf a2 d))
        (values z2 (KMSplit G k N b n w pp gw f ps pc kids a2 z2 l mf2))))))

(def-adts $ (KLB : ((TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) ((Nat) k) ((List (Nat)) rb) ((List (List (Item))) ps) ((KF G ps) f) -> Type)
  enum
  (many KLBNil : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k) (erased (List (Nat)) rb)
     -> (KLB G k rb (Nil (List (Item))) (KFNil G)))
  (many KLBCons : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k) (erased (List (Nat)) rb rq)
     (erased (List (Item)) q) (erased (List (List (Item))) qs) (erased (KF G qs) rest) (erased (RK k q rq) x)
     (erased (RLt (Succ k) rq rb) l) (erased (KLB G k rb qs rest) lb) -> (KLB G k rb (Cons (List (Item)) q qs) (KFCons G q qs (KNLeaf G q) rest))))

(def-fns _ $ (many leaves : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (many (Nat) k) (erased (Nat) N)
    (subterm many (List (List (Item))) ps) (erased (List (Nat)) rb) (erased (LeafOKK k ps rb) lk) (many (List (Grp)) a)
    (erased (Desc (Succ k) a) d) -> (many (KF G ps) f) (many (List (Grp)) z) (erased (KMF G k N ps f a z) mf) (erased (KLB G k rb ps f) lb))
  (let-match many ps (Cons _ q qs) ((Nil _) (values (KFNil G) a (KMNil G k N a) (KLBNil G k rb))))
  (let-match erased lk (LKCons _ _ _ rq _ o x l lk1))
  (let ((many f1) (many mid) (erased mf1) (erased lb1)) (notail $ leaves G k N qs rb lk1 a d))
  (let ((many r) (erased x2)) (rank k q o))
  (let ((many z) (erased i)) (ins (Succ k) r (rk-length k q r x2) mid (kmf-desc G k N qs f1 a mid mf1 d)))
  (values (KFCons G q qs (KNLeaf G q) f1) z
    (KMCons G k N q qs (KNLeaf G q) f1 a mid z mf1 (KMLeaf G k N q r mid z o x2 i)) (KLBCons G k rb rq q qs f1 x l lb1)))

(def-fns _ $ (erased lb-hd : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Nat)) x)
    (erased (List (List (Item))) ps) (erased (KF G ps) f) (erased (List (Grp)) a z) (subterm erased (KMF G k N ps f a z) mf)
    (erased (KLB G k x ps f) lb) (erased (Hd (Succ k) x a) h) -> (erased (Hd (Succ k) x z) h2))
  (let-match erased mf (KMCons _ _ _ q qs node rest _ mid _ mf1 mn) ((KMNil _ _ _ _) h))
  (let-match erased lb (KLBCons _ _ _ rq _ _ _ y l lb1))
  (let-match erased mn (KMLeaf _ _ _ _ r _ _ _ y2 i))
  (let-match erased (rk-fn k q rq r y y2) (Refl _ _))
  (ins-hd (Succ k) r x mid z i (lb-hd G k N x qs rest a mid mf1 lb1 h) l))

(def-fns _ $ (erased lb-weaken : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k) (erased (List (Nat)) rb r)
    (erased (List (List (Item))) ps) (erased (KF G ps) f) (subterm erased (KLB G k rb ps f) lb) (erased (RLt (Succ k) rb r) l)
    -> (erased (KLB G k r ps f) lb2))
  (match erased lb _
    ((KLBNil _ _ _) (KLBNil G k r))
    ((KLBCons _ _ _ rq q qs rest y l1 lb1) (KLBCons G k r rq q qs rest y (rlt-trans (Succ k) rq rb r l1 l) (lb-weaken G k rb r qs rest lb1 l)))))

(def-fns _ $ (erased lb-skip : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N c) (erased (List (Nat)) y)
    (erased (List (List (Item))) ps) (erased (KF G ps) f) (erased (List (Grp)) t z)
    (subterm erased (KMF G k N ps f (Cons (Grp) (MkGrp y c) t) z) mf) (erased (KLB G k y ps f) lb)
    -> (erased (List (Grp)) t2) (erased (Eq (List (Grp)) z (Cons (Grp) (MkGrp y c) t2)) e) (erased (KMF G k N ps f t t2) mf2))
  (let-match erased mf (KMCons _ _ _ q qs node rest _ mid _ mf1 mn) ((KMNil _ _ _ _) (values t (Refl (List (Grp)) z) (KMNil G k N t))))
  (let-match erased lb (KLBCons _ _ _ rq _ _ _ x l lb1))
  (let ((erased t1) (erased e1) (erased mf3)) (lb-skip G k N c y qs rest t mid mf1 lb1))
  (let-match erased e1 (Refl _ _))
  (let-match erased mn (KMLeaf _ _ _ _ r _ _ o x2 i))
  (let-match erased (rk-fn k q rq r x x2) (Refl _ _))
  (let-match erased i (InsSkip _ _ _ _ _ t3 _ i1)
    (absurd (InsHere _ _ _ h) (let-match erased h (HdCons _ _ _ _ _ l2)) (rlt-asym (Succ k) r y l l2))
    (absurd (InsEq _ _ _ _) (rlt-irrefl (Succ k) r l)))
  (values t3 (Refl (List (Grp)) z) (KMCons G k N q qs (KNLeaf G q) rest t t1 t3 mf3 (KMLeaf G k N q r t1 t3 o x2 i1))))

(def-fns _ $ (erased leaf-drop : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N) (erased (List (Nat)) rb)
    (erased (List (List (Item))) ps) (erased (KF G ps) f) (erased (List (Grp)) a z z2) (subterm erased (Ins (Succ k) rb a z) i)
    (erased (KMF G k N ps f a z2) mf) (erased (KLB G k rb ps f) lb) (erased (Desc (Succ k) a) d) -> (erased (Drop (Succ k) rb z z2) e))
  (match erased i _
    ((InsHere _ _ _ h) (DGone (Succ k) rb (Succ (Zero)) a z2 (LtZ (Zero)) (lb-hd G k N rb ps f a z2 mf lb h)))
    ((InsEq _ _ c t)
      (let ((erased t2) (erased e1) (erased mf2)) (lb-skip G k N c rb ps f t z2 mf lb))
      (let-match erased e1 (Refl _ _))
      (let-match erased d (DcCons _ _ _ _ _ _ h _))
      (DHere (Succ k) rb (Succ c) c t t2 (lt-succ c) (lb-hd G k N rb ps f t t2 mf2 lb h)))
    ((InsSkip _ _ r c t t1 l i1)
      (let ((erased t2) (erased e1) (erased mf2)) (lb-skip G k N c r ps f t z2 mf (lb-weaken G k rb r ps f lb l)))
      (let-match erased e1 (Refl _ _))
      (let-match erased d (DcCons _ _ _ _ _ _ _ d1))
      (DAbove (Succ k) rb r c t1 t2 l (leaf-drop G k N rb ps f t t1 t2 i1 mf2 lb d1)))))

(def-fns _ $ (erased ins-fn : (erased (Nat) n) (erased (List (Nat)) x) (erased (List (Grp)) gs hs hs2) (subterm erased (Ins n x gs hs) i)
    (erased (Ins n x gs hs2) j) -> (erased (Eq (List (Grp)) hs hs2) e))
  (match erased i _
    ((InsHere _ _ _ h)
      (match erased j _
        ((InsHere _ _ _ _) (Refl (List (Grp)) hs))
        (absurd (InsEq _ _ _ _) (let-match erased h (HdCons _ _ _ _ _ l)) (rlt-irrefl n x l))
        (absurd (InsSkip _ _ r _ _ _ l _) (let-match erased h (HdCons _ _ _ _ _ l2)) (rlt-asym n x r l l2))))
    ((InsEq _ _ c gs1)
      (match erased j _
        (absurd (InsHere _ _ _ h) (let-match erased h (HdCons _ _ _ _ _ l)) (rlt-irrefl n x l))
        ((InsEq _ _ _ _) (Refl (List (Grp)) hs))
        (absurd (InsSkip _ _ _ _ _ _ l _) (rlt-irrefl n x l))))
    ((InsSkip _ _ r c gs1 hs1 l i1)
      (match erased j _
        (absurd (InsHere _ _ _ h) (let-match erased h (HdCons _ _ _ _ _ l2)) (rlt-asym n x r l l2))
        (absurd (InsEq _ _ _ _) (rlt-irrefl n x l))
        ((InsSkip _ _ _ _ _ hs3 _ j1)
          (let-match erased (ins-fn n x gs1 hs1 hs3 i1 j1) (Refl _ _))
          (Refl (List (Grp)) hs))))))

(def-fns _
  ((erased kmf-fn : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N Nc) (erased (List (List (Item))) bs)
      (erased (KF G bs) f) (erased (List (Grp)) a z z2) (subterm erased (KMF G k N bs f a z) mf) (erased (KMF G k Nc bs f a z2) mf2)
      -> (erased (Eq (List (Grp)) z z2) e))
    (match erased mf _
      ((KMNil _ _ _ _) (let-match erased mf2 (KMNil _ _ _ _)) (Refl (List (Grp)) z))
      ((KMCons _ _ _ b bs1 node rest _ mid _ mf1 mn)
        (let-match erased mf2 (KMCons _ _ _ _ _ _ _ _ mid2 _ mf3 mn2))
        (let-match erased (kmf-fn G k N Nc bs1 rest a mid mid2 mf1 mf3) (Refl _ _))
        (kmn-fn G k N Nc b node mid z z2 mn mn2))))
  ((erased kmn-fn : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N Nc) (erased (List (Item)) b)
      (erased (KN G b) nd) (erased (List (Grp)) a z z2) (subterm erased (KMN G k N b nd a z) mn) (erased (KMN G k Nc b nd a z2) mn2)
      -> (erased (Eq (List (Grp)) z z2) e))
    (match erased mn _
      ((KMLeaf _ _ _ _ r _ _ _ x i)
        (let-match erased mn2 (KMLeaf _ _ _ _ r2 _ _ _ x2 i2))
        (let-match erased (rk-fn k b r r2 x x2) (Refl _ _))
        (ins-fn (Succ k) r a z z2 i i2))
      ((KMSplit _ _ _ _ _ _ _ _ _ ps _ kids _ _ _ mf)
        (let-match erased mn2 (KMSplit _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ mf2))
        (kmf-fn G k N Nc ps kids a z z2 mf mf2)))))

(def-adts $ (InsK : ((TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) ((Nat) k) ((Nat) N) ((Nat) nn) ((List (Nat)) wx)
    ((List (List (Item))) bs) ((List (Grp)) a) ((List (Grp)) z) -> Type)
  enum
  (many KFound : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N nn) (erased (List (Nat)) wx)
     (erased (List (List (Item))) bs) (erased (List (Grp)) a z) (many (Nat) n) (many (List (Nat)) w) (erased (G n w) gw)
     (erased (Lt n N) l) (erased (EmbN w wx) e) -> (InsK G k N nn wx bs a z))
  (many KIns : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (erased (Nat) k N nn) (erased (List (Nat)) wx)
     (erased (List (List (Item))) bs) (erased (List (Grp)) a z) (many (KF G bs) f2) (many (List (Grp)) z2)
     (erased (KMF G k (Succ nn) bs f2 a z2) mf) (many (List (Nat)) rd) (erased (Drop (Succ k) rd z z2) d) -> (InsK G k N nn wx bs a z)))

(def-fns _ $ (many kinsert : (erased (TyCtor ((Nat) i) ((List (Nat)) w) -> Type) G) (many (Nat) k) (erased (Nat) N) (many (Nat) nn)
    (erased (Lt N (Succ nn)) le) (many (List (Nat)) wx) (erased (G nn wx) gx)
    (many (List (List (Item))) bs) (subterm many (KF G bs) f) (many (Nat) r) (erased (List (Item)) b)
    (erased (Nth (List (Item)) bs r b) nb) (many (List (List (Nat))) xp) (erased (Fits b xp wx) fx)
    (many (List (Grp)) a) (erased (List (Grp)) z) (erased (KMF G k N bs f a z) mf) (erased (Desc (Succ k) a) d)
    -> (many (InsK G k N nn wx bs a z) res))
  (let-match many f (KFCons _ _ bs0 node rest) (absurd (KFNil _) nb))
  (let-match many bs (Cons _ bh bs2))
  (let-match erased mf (KMCons _ _ _ _ _ _ _ _ mid _ mf1 mn))
  (let ((erased dm)) (kmf-desc G k N bs2 rest a mid mf1 d))
  (let ((erased le2)) (lt-weaken N (Succ nn) le))
  (match many r _
    ((Succ r1)
      (let-match erased nb (NthThere _ _ _ _ _ nb1))
      (let-match many (notail $ kinsert G k N nn le wx gx bs2 rest r1 b nb1 xp fx a mid mf1 d)
        (KIns _ _ _ _ _ _ _ _ rest2 mid2 mf2 rd dr)
        ((KFound _ _ _ _ _ _ _ _ n w gw l e) (KFound G k N nn wx bs a z n w gw l e)))
      (let ((many z2) (erased mn2)) (kmn-run G k N bh node mid z mn mid2 (kmf-desc G k (Succ nn) bs2 rest2 a mid2 mf2 d)))
      (KIns G k N nn wx bs a z (KFCons G bh bs2 node rest2) z2
        (KMCons G k (Succ nn) bh bs2 node rest2 a mid2 z2 mf2 (kmn-weaken G k N (Succ nn) le2 bh node mid2 z2 mn2))
        rd (kmn-drop G k N N rd bh node mid mid2 z z2 dr mn mn2)))
    ((Zero)
      (let-match erased nb (NthHere _ _ _))
      (let ((many mid1) (erased mfm)) (kmf-run G k N bs2 rest a mid mf1 a d))
      (let-match erased (kmf-fn G k N N bs2 rest a mid mid1 mf1 mfm) (Refl _ _))
      (let ((erased mf1w)) (kmf-weaken G k N (Succ nn) le2 bs2 rest a mid mf1))
      (match many node _
        ((KNLeaf _ _)
          (let-match erased mn (KMLeaf _ _ _ _ rb0 _ _ o x i))
          (let ((many rb) (erased x2)) (rank k bh o))
          (let-match erased (rk-fn k bh rb0 rb x x2) (Refl _ _))
          (let ((many ps) (erased pc)) (pieces bh xp wx fx))
          (let ((erased lk)) (pcs-lk k bh xp wx rb ps pc fx o x))
          (let ((many kids) (many z2) (erased mfk) (erased lb)) (leaves G k (Succ nn) ps rb lk mid1 dm))
          (KIns G k N nn wx bs a z (KFCons G bh bs2 (KNSplit G bh nn wx xp gx fx ps pc kids) rest) z2
            (KMCons G k (Succ nn) bh bs2 (KNSplit G bh nn wx xp gx fx ps pc kids) rest a mid z2 mf1w
              (KMSplit G k (Succ nn) bh nn wx xp gx fx ps pc kids mid z2 (lt-succ nn) mfk))
            rb (leaf-drop G k (Succ nn) rb ps kids mid z z2 i mfk lb dm)))
        ((KNSplit _ _ n w pp gw fp ps pc kids)
          (let-match erased mn (KMSplit _ _ _ _ _ _ _ _ _ _ _ _ _ _ l mfk))
          (let-match many (classify-k bh pp xp w wx fp fx ps pc) (CKIn _ _ _ r2 q nq xq fq)
            ((CKLe _ _ _ e) (KFound G k N nn wx bs a z n w gw l e)))
          (let-match many (notail $ kinsert G k N nn le wx gx ps kids r2 q nq xq fq mid1 z mfk dm)
            (KIns _ _ _ _ _ _ _ _ kids2 z2 mfk2 rd dr)
            ((KFound _ _ _ _ _ _ _ _ n2 w2 gw2 l2 e2) (KFound G k N nn wx bs a z n2 w2 gw2 l2 e2)))
          (KIns G k N nn wx bs a z (KFCons G bh bs2 (KNSplit G bh n w pp gw fp ps pc kids2) rest) z2
            (KMCons G k (Succ nn) bh bs2 (KNSplit G bh n w pp gw fp ps pc kids2) rest a mid z2 mf1w
              (KMSplit G k (Succ nn) bh n w pp gw fp ps pc kids2 mid z2 (lt-trans n N (Succ nn) l le) mfk2))
            rd dr))))))

(def-fns _ $ (many trues : (subterm many (Nat) n) -> (many (List (Bool)) g) (erased (Repeat (Bool) n (BTrue) g) r))
  (let-match many n (Succ n1) ((Zero) (values (Nil (Bool)) (RepeatNil (Bool) (BTrue)))))
  (let ((many g1) (erased r1)) (notail $ trues n1))
  (values (Cons (Bool) (BTrue) g1) (RepeatCons (Bool) n1 (BTrue) g1 r1)))

(def-fns _ $ (erased letters-in : (erased (Nat) k) (erased (List (Bool)) g) (erased (List (Nat)) w) (erased (Repeat (Bool) k (BTrue) g) r)
    (subterm erased (Letters k w) lw) -> (erased (AllIn g w) i))
  (let-match erased lw (LetCons _ a w1 l lw1) ((LetNil _) (InNil g)))
  (InCons g a w1 (repeat-nth (Bool) k a (BTrue) g r l) (letters-in k g w1 r lw1)))
