(def-fns _ $ (erased setnth-back : (erased (List (Nat)) xs ys) (erased (Nat) i k y z)
    (erased (SetNth (Nat) xs i y ys) s) (erased (Nth (Nat) ys k z) n) (erased (Ne k i) ne) -> (erased (Nth (Nat) xs k z) r))
  (match erased ne _
    ((NeLt _ _ p) (setnth-back-lt _ _ _ _ _ _ _ s n p))
    ((NeGt _ _ p) (setnth-back-gt _ _ _ _ _ _ _ s n p))))

(def-adts
  ((Swap : ((List (Nat)) xs) ((Nat) i) ((Nat) j) ((List (Nat)) ys) -> Type)
    enum
    (many MkSwap : (erased (List (Nat)) xs) (erased (Nat) i j x y) (erased (List (Nat)) zs ys)
       (erased (Nth (Nat) xs i x) nx) (erased (Nth (Nat) xs j y) ny)
       (erased (SetNth (Nat) xs i y zs) s1) (erased (SetNth (Nat) zs j x ys) s2) -> (Swap xs i j ys))))

(def-fns _ $ (erased swap-at-i : (erased (List (Nat)) xs ys) (erased (Nat) i j z) (erased (Swap xs i j ys) sw)
    (erased (Lt i j) ij) (erased (Nth (Nat) ys i z) n) -> (erased (Nth (Nat) xs j z) r))
  (let-match erased sw (MkSwap _ _ _ x y zs _ nx ny s1 s2))
  (let-match erased (nth-fn _ _ _ _ _ (setnth-back-lt _ _ _ _ _ _ _ s2 n ij) (setnth-nth _ _ _ _ _ s1)) (Refl _ _))
  ny)

(def-fns _ $ (erased swap-at-j : (erased (List (Nat)) xs ys) (erased (Nat) i j z) (erased (Swap xs i j ys) sw)
    (erased (Nth (Nat) ys j z) n) -> (erased (Nth (Nat) xs i z) r))
  (let-match erased sw (MkSwap _ _ _ x y zs _ nx ny s1 s2))
  (let-match erased (nth-fn _ _ _ _ _ n (setnth-nth _ _ _ _ _ s2)) (Refl _ _))
  nx)

(def-fns _ $ (erased swap-at : (erased (List (Nat)) xs ys) (erased (Nat) i j k z) (erased (Swap xs i j ys) sw)
    (erased (Ne k i) ki) (erased (Ne k j) kj) (erased (Nth (Nat) ys k z) n) -> (erased (Nth (Nat) xs k z) r))
  (let-match erased sw (MkSwap _ _ _ x y zs _ nx ny s1 s2))
  (setnth-back _ _ _ _ _ _ s1 (setnth-back _ _ _ _ _ _ s2 n kj) ki))

(def-fns _ $ (erased perm-pull : (erased (Nat) x y k) (erased (List (Nat)) rest rest2)
    (erased (Nth (Nat) rest k y) n) (subterm erased (SetNth (Nat) rest k x rest2) s)
    -> (erased (Permutation (Nat) (Cons (Nat) x rest) (Cons (Nat) y rest2)) p))
  (let-match erased s (SetThere _ z r k1 _ r2 s1)
    ((SetHere _ _ _ r) (let-match erased n (NthHere _ _ _)) (PSwap _ x y r)))
  (let-match erased n (NthThere _ _ _ _ _ n1))
  (PTrans _ _ _ _ (PSwap _ x z r)
    (PTrans _ _ _ _ (PSkip _ z _ _ (perm-pull x y k1 r r2 n1 s1)) (PSwap _ z y r2))))

(def-fns _ $ (erased perm-swap : (erased (List (Nat)) xs zs ys) (erased (Nat) i j x y)
    (erased (Nth (Nat) xs i x) nx) (erased (Nth (Nat) xs j y) ny) (subterm erased (SetNth (Nat) xs i y zs) s1)
    (erased (SetNth (Nat) zs j x ys) s2) (erased (Lt i j) ij) -> (erased (Permutation (Nat) xs ys) p))
  (let-match erased ij (LtS i1 j1 ij1)
    ((LtZ j1)
      (let-match erased s1 (SetHere _ _ _ rest))
      (let-match erased nx (NthHere _ _ _))
      (let-match erased ny (NthThere _ _ _ _ _ ny1))
      (let-match erased s2 (SetThere _ _ _ _ _ rest2 s3))
      (perm-pull x y j1 rest rest2 ny1 s3)))
  (let-match erased s1 (SetThere _ h rest _ _ zs1 s11))
  (let-match erased s2 (SetThere _ _ _ _ _ ys1 s21))
  (let-match erased nx (NthThere _ _ _ _ _ nx1))
  (let-match erased ny (NthThere _ _ _ _ _ ny1))
  (PSkip _ h _ _ (perm-swap rest zs1 ys1 i1 j1 x y nx1 ny1 s11 s21 ij1)))

(def-fns _ $ (erased perm-of-swap : (erased (List (Nat)) xs xs0 ys) (erased (Nat) i j) (erased (Permutation (Nat) xs0 xs) p)
    (erased (Swap xs i j ys) sw) (erased (Lt i j) ij) -> (erased (Permutation (Nat) xs0 ys) q))
  (let-match erased sw (MkSwap _ _ _ x y zs _ nx ny s1 s2))
  (PTrans _ _ _ _ p (perm-swap _ _ _ _ _ _ _ nx ny s1 s2 ij)))

(def-fns _ $ (erased swap-pos : (erased (List (Nat)) xs ys) (erased (Nat) i j k z b) (erased (Swap xs i j ys) sw) (erased (Lt i j) ij)
    (erased (Lt j b) jb) (erased (Lt k b) kb) (erased (Nth (Nat) ys k z) n) -> (erased (Nat) a) (erased (Nth (Nat) xs a z) na) (erased (Lt a b) ab))
  (let-match erased (eq-ne k i) (Diff _ _ ki) ((Same _) (values j (swap-at-i _ _ _ _ _ sw ij n) jb)))
  (let-match erased (eq-ne k j) (Diff _ _ kj) ((Same _) (values i (swap-at-j _ _ _ _ _ sw n) (lt-trans _ _ _ ij jb))))
  (values k (swap-at _ _ _ _ _ _ sw ki kj n) kb))

(def-fns _ $ (erased perm-refl : (subterm erased (List (Nat)) xs) -> (erased (Permutation (Nat) xs xs) p))
  (let-match erased xs (Cons _ x rest) ((Nil _) (PNil _)))
  (PSkip _ x rest rest (perm-refl rest)))
