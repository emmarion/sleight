(def-fns _ $ (many heapsort-fast : (erased (List (Nat)) xs) (erased (AllTo (Nat) Lt xs u62-modulus) small)
    (erased (Nat) n0) (erased (Length (Nat) xs n0) len0) (erased (Lt n0 max-array-length) fits)
    (erased (List (Copy (Nat))) cs) (unique (Array (Copy (Nat)) cs) a) (erased (Copies (Nat) xs cs) rel0) ->
    (erased (List (Nat)) ys) (erased (List (Copy (Nat))) ds) (unique (Array (Copy (Nat)) ds) r at a)
    (erased (Copies (Nat) ys ds) cp) (erased (SortedPerm (Nat) Le xs ys) correct))
  (let ((erased us) (erased rel) (erased b) (erased c)) (to-u62 xs cs rel0 small a))
  (let ((many n) (erased lenu) (unique a1)) (array-length _ _ (coerce a c)))
  (let ((erased len)) (rel-length xs us rel n lenu))
  (let-match erased (length-fn _ _ _ _ len0 len) (Refl _ _))
  (let ((erased nfit)) (lt-trans n max-array-length u62-modulus fits max-array-length-below-u62))
  (let ((many q) (erased v) (erased pv) (erased k) (erased rr) (erased mm) (erased ad) (erased rl) (erased _))
    (u62-shr n 1 nfit (shr-one-ok)))
  (let ((erased hq)) (half-of _ _ _ _ _ pv mm ad rl))
  (let ((erased ys1) (erased us1) (erased rel1) (erased len1) (unique a2) (erased perm1) (erased h1))
    (heapify xs xs us rel n len nfit a1 (perm-refl xs) q hq n q (le-refl q) (heap-top xs n q hq)))
  (let ((erased ys) (erased us2) (erased rel2) (erased len2) (unique a3) (erased perm) (erased mf) (erased mf1) (erased sf))
    (sortdown xs ys1 us1 rel1 n len1 nfit a2 perm1 n (le-refl n) h1 (suffix-none ys1 n len1)))
  (let ((erased ds) (erased cp) (erased a4) (erased c2)) (from-u62 ys us2 rel2 a3))
  (values ys ds (coerce a3 c2) cp (MkSortedPerm _ _ xs ys (sorted-of-suffix ys n mf len2 sf mf1) perm)))
