(def-fns _
  ((many sift : (erased (List (Nat)) xp xs0 xs) (erased (List (Copy (U62))) us) (erased (Rel xs us) rel)
      (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n u62-modulus) nfit) (unique (Array (Copy (U62)) us) a)
      (erased (Permutation (Nat) xp xs) perm) (erased (Nat) k) (many (Nat) m q) (erased (Half2 m q) hq) (erased (Le m n) mn)
      (many (Nat) i) (erased (Le k i) ki) (erased (Lt i m) im) (subterm erased (Nat) cnt) (erased (Add i cnt m) ac)
      (subterm erased (Nat) ph) (erased (HeapExc xs k i m) h) (erased (Grand xs k i m) gr) (erased (Stays xs0 xs m) st) ->
      (erased (List (Nat)) ys) (erased (List (Copy (U62))) us2) (erased (Rel ys us2) rel2) (erased (Length (Nat) ys n) len2)
      (unique (Array (Copy (U62)) us2) r at a) (erased (Permutation (Nat) xp ys) perm2) (erased (HeapExc ys k m m) h2)
      (erased (Stays xs0 ys m) st2))
    (let ((erased in)) (lt-le-lt i m n im mn))
    (let ((erased mmod)) (le-lt-lt m n u62-modulus mn nfit))
    (let ((erased e) (erased de)) (double i))
    (let-match many (u62-lt-dec i q (lt-trans i m u62-modulus im mmod) (le-lt-lt q m u62-modulus (half-le m q hq) mmod)) (Yes _ _ iq)
      ((No _ _ qi)
        (let ((erased vi) (erased ni)) (nth-exists _ _ _ _ len in))
        (let ((erased k1) (erased k2))
          (values (KOut xs m _ vi (kids-out m q i _ hq (MkLe _ _ qi) (ChL i e de)))
                  (KOut xs m _ vi (kids-out m q i _ hq (MkLe _ _ qi) (ChR i e de)))))
        (values xs us rel len a perm (sift-done xs k i m vi vi h (cmax xs i e m vi de k1 k2) ni (le-refl vi)) st)))
    (let ((erased km)) (kids-in m q i e hq iq de))
    (let ((many c1)) (u62-inc (u62-add i i e (double-add i e de) (kid-bound0 e m _ km mmod)) (kid-bound1 e m _ km mmod)))
    (let ((many c2)) (u62-inc c1 (kid-bound2 e m _ km mmod)))
    (let ((many vi) (erased ni) (erased pvi) (unique a1)) (get xs us rel n len a i in))
    (let ((many v1) (erased n1) (erased pv1) (unique a2)) (get xs us rel n len a1 c1 (lt-le-lt _ m n (kid-in1 e m km) mn)))
    (let ((erased c1m)) (kid-in1 e m km))
    (let ((erased cnt1) (erased ac1) (erased lt1)) (cnt-step i c1 m cnt ac (child-lt i c1 (ChL i e de)) c1m))
    (let-match many (u62-lt-dec c2 m (kid-bound2 e m _ km mmod) mmod) (Yes _ _ c2m)
      ((No _ _ mc2)
        (tail (sift-to xp xs0 xs us rel n len nfit a2 perm k m q hq mn i ki im vi ni pvi e de c1 (ChL i e de) c1m v1 n1 pv1
          (cmax xs i e m v1 de (KIn xs m _ v1 v1 n1 (le-refl v1)) (KOut xs m _ v1 (MkLe _ _ mc2)))
          (subterm (lt-subterm cnt1 cnt lt1)) cnt1 ac1 (Succ (Zero)) h gr st))))
    (let ((many v2) (erased n2) (erased pv2) (unique a3)) (get xs us rel n len a2 c2 (lt-le-lt _ m n c2m mn)))
    (let ((erased cnt2) (erased ac2) (erased lt2)) (cnt-step i c2 m cnt ac (child-lt i c2 (ChR i e de)) c2m))
    (let-match many (u62-lt-dec v1 v2 pv1 pv2) (Yes _ _ v12)
      ((No _ _ v21)
        (tail (sift-to xp xs0 xs us rel n len nfit a3 perm k m q hq mn i ki im vi ni pvi e de c1 (ChL i e de) c1m v1 n1 pv1
          (cmax xs i e m v1 de (KIn xs m _ v1 v1 n1 (le-refl v1)) (KIn xs m _ v1 v2 n2 (MkLe _ _ v21)))
          (subterm (lt-subterm cnt1 cnt lt1)) cnt1 ac1 (Succ (Zero)) h gr st))))
    (tail (sift-to xp xs0 xs us rel n len nfit a3 perm k m q hq mn i ki im vi ni pvi e de c2 (ChR i e de) c2m v2 n2 pv2
      (cmax xs i e m v2 de (KIn xs m _ v2 v1 n1 (lt-le v1 v2 v12)) (KIn xs m _ v2 v2 n2 (le-refl v2)))
      (subterm (lt-subterm cnt2 cnt lt2)) cnt2 ac2 (Succ (Zero)) h gr st)))
  ((many sift-to : (erased (List (Nat)) xp xs0 xs) (erased (List (Copy (U62))) us) (erased (Rel xs us) rel)
      (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n u62-modulus) nfit) (unique (Array (Copy (U62)) us) a)
      (erased (Permutation (Nat) xp xs) perm) (erased (Nat) k) (many (Nat) m q) (erased (Half2 m q) hq) (erased (Le m n) mn)
      (many (Nat) i) (erased (Le k i) ki) (erased (Lt i m) im) (many (Nat) vi) (erased (Nth (Nat) xs i vi) ni)
      (erased (Lt vi u62-modulus) pvi) (erased (Nat) e) (erased (Double i e) de) (many (Nat) c) (erased (Child i c) ic)
      (erased (Lt c m) cm) (many (Nat) vc) (erased (Nth (Nat) xs c vc) nc) (erased (Lt vc u62-modulus) pvc)
      (erased (CMax xs i m vc) cmx) (subterm erased (Nat) cnt) (erased (Add c cnt m) ac) (subterm erased (Succ (Zero)) is ph)
      (erased (HeapExc xs k i m) h) (erased (Grand xs k i m) gr) (erased (Stays xs0 xs m) st) ->
      (erased (List (Nat)) ys) (erased (List (Copy (U62))) us2) (erased (Rel ys us2) rel2) (erased (Length (Nat) ys n) len2)
      (unique (Array (Copy (U62)) us2) r at a) (erased (Permutation (Nat) xp ys) perm2) (erased (HeapExc ys k m m) h2)
      (erased (Stays xs0 ys m) st2))
    (let-match many (u62-lt-dec vi vc pvi pvc) (Yes _ _ lt)
      ((No _ _ ge) (values xs us rel len a perm (sift-done xs k i m vi vc h cmx ni (MkLe _ _ ge)) st)))
    (let ((erased ic2)) (child-lt i c ic))
    (let ((erased ys) (erased us2) (erased sw) (erased rel2) (erased len2) (unique a2)) (swap xs us rel n len a i c ic2 vi vc ni nc))
    (let ((erased h2) (erased gr2) (erased st2)) (sift-swap xs0 xs ys k i c m vi vc sw ic cm ki ni nc lt h gr cmx st))
    (tail (sift xp xs0 ys us2 rel2 n len2 nfit a2 (perm-of-swap _ _ _ _ _ perm sw ic2) k m q hq mn c
      (le-le k i c ki (lt-le i c ic2)) cm cnt ac (Zero) h2 gr2 st2))))

(def-fns _ $ (many heapify : (erased (List (Nat)) xp xs) (erased (List (Copy (U62))) us) (erased (Rel xs us) rel)
    (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n u62-modulus) nfit) (unique (Array (Copy (U62)) us) a)
    (erased (Permutation (Nat) xp xs) perm) (many (Nat) q) (erased (Half2 n q) hq) (many n is nr)
    (subterm many (Nat) i) (erased (Le i q) iq) (erased (HeapExc xs i n n) h) ->
    (erased (List (Nat)) ys) (erased (List (Copy (U62))) us2) (erased (Rel ys us2) rel2) (erased (Length (Nat) ys n) len2)
    (unique (Array (Copy (U62)) us2) r at a) (erased (Permutation (Nat) xp ys) perm2) (erased (HeapExc ys (Zero) n n) h2))
  (let ((erased qn)) (half-le n q hq))
  (let ((erased imod)) (le-lt-lt i n u62-modulus (le-le i q n iq qn) nfit))
  (let-match many (u62-lt-dec (Zero) i u62-modulus-pos imod) (Yes _ _ ipos)
    ((No _ _ iz)
      (let-match erased iz (LtZ _) (absurd (LtS _ _ z) z))
      (values xs us rel len a perm h)))
  (let-match erased ipos (LtZ i1))
  (let ((many j)) (u62-dec i1 i imod))
  (let ((erased jn)) (lt-le-lt i1 q n (lt-le-lt i1 i q (lt-succ i1) iq) qn))
  (let ((erased cnt) (erased ac)) (sub n i1 (lt-weaken i1 n jn)))
  (let ((erased ys) (erased us2) (erased rel2) (erased len2) (unique a2) (erased perm2) (erased h2) (erased _))
    (sift xp xs xs us rel n len nfit a perm i1 nr q hq (le-refl n) j (le-refl i1) jn cnt ac (Zero)
      (heap-down xs i1 n h) (grand-none xs i1 n) (stays-id xs n)))
  (tail (heapify xp ys us2 rel2 n len2 nfit a2 perm2 q hq nr j (lt-le i1 q (lt-le-lt i1 i q (lt-succ i1) iq)) h2)))

(def-fns _ $ (many sortdown : (erased (List (Nat)) xp xs) (erased (List (Copy (U62))) us) (erased (Rel xs us) rel)
    (erased (Nat) n) (erased (Length (Nat) xs n) len) (erased (Lt n u62-modulus) nfit) (unique (Array (Copy (U62)) us) a)
    (erased (Permutation (Nat) xp xs) perm) (subterm many (Nat) m) (erased (Le m n) mn) (erased (HeapExc xs (Zero) m m) h)
    (erased (Suffix xs m) sf) ->
    (erased (List (Nat)) ys) (erased (List (Copy (U62))) us2) (erased (Rel ys us2) rel2) (erased (Length (Nat) ys n) len2)
    (unique (Array (Copy (U62)) us2) r at a) (erased (Permutation (Nat) xp ys) perm2) (erased (Nat) mf) (erased (Le mf 1) mf1)
    (erased (Suffix ys mf) sf2))
  (let ((erased mmod)) (le-lt-lt m n u62-modulus mn nfit))
  (let-match many (u62-lt-dec 1 m one-fits mmod) (Yes _ _ m2)
    ((No _ _ m1) (values xs us rel len a perm m (MkLe _ _ m1) sf)))
  (let-match erased m2 (LtS _ m1 zm))
  (let ((many k)) (u62-dec m1 m mmod))
  (let ((erased m1n)) (lt-le-lt m1 m n (lt-succ m1) mn))
  (let ((many vr) (erased nr) (erased _) (unique a1)) (get xs us rel n len a (Zero) (lt-trans (Zero) m1 n zm m1n)))
  (let ((many vt) (erased nt) (erased _) (unique a2)) (get xs us rel n len a1 k m1n))
  (let ((erased ys) (erased us2) (erased sw) (erased rel2) (erased len2) (unique a3)) (swap xs us rel n len a2 (Zero) k zm vr vt nr nt))
  (let ((many q) (erased v) (erased pv) (erased kk) (erased rr) (erased mm) (erased ad) (erased rl) (erased _))
    (u62-shr k 1 (lt-trans m1 n u62-modulus m1n nfit) (shr-one-ok)))
  (let ((erased zs) (erased us3) (erased rel3) (erased len3) (unique a4) (erased perm3) (erased h3) (erased st3))
    (sift xp ys ys us2 rel2 n len2 nfit a3 (perm-of-swap _ _ _ _ _ perm sw zm) (Zero) k q (half-of _ _ _ _ _ pv mm ad rl)
      (lt-le m1 n m1n) (Zero) (MkLe _ _ (LtZ (Zero))) zm m1 (AddZero m1) (Zero)
      (down-heap xs ys m1 sw h) (grand-none ys (Zero) m1) (stays-id ys m1)))
  (tail (sortdown xp zs us3 rel3 n len3 nfit a4 perm3 k (lt-le m1 n m1n) h3
    (down-suffix xs ys zs n m1 vr len mn h nr sf sw zm st3))))
