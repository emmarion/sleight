(def-adts
  ((Tail : ((Env) env) ((Core) c) ((Env) env1) ((Core) c1) -> Type)
    enum
    (many TailHere : (erased (Env) env) (erased (Core) c) -> (Tail env c env c))
    (many TailCall : (erased (Env) env1) (erased (Core) c1) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args)
       (erased (Env) cenv) (erased (List (FnDef)) group) (erased (Nat) id) (erased (List (Nat)) ps) (erased (Core) body)
       (erased (List (Val)) vals) (erased (Env) env2) (erased (Env) env3)
       (erased (Eval env fn (Cons (Val) (VClo cenv group (MkFnDef id ps body)) (Nil (Val)))) p) (erased (EvalList env args vals) q)
       (erased (BindGroup cenv group group cenv env2) g) (erased (BindAll env2 ps vals env3) b)
       (erased (Tail env (CCall fn args) env1 c1) outer) -> (Tail env3 body env1 c1))
    (many TailMatch : (erased (Env) env1) (erased (Core) c1) (erased (Env) env) (erased (Core) scrut) (erased (List (Branch)) bs)
       (erased (Nat) ctor) (erased (List (Val)) fields) (erased (List (Nat)) ids) (erased (Core) body) (erased (Env) env2)
       (erased (Eval env scrut (Cons (Val) (VCon ctor fields) (Nil (Val)))) p) (erased (BranchOf bs ctor ids body) br)
       (erased (BindAll env ids fields env2) b)
       (erased (Tail env (CMatch scrut bs) env1 c1) outer) -> (Tail env2 body env1 c1))
    (many TailStmt : (erased (Env) env1) (erased (Core) c1) (erased (Env) env) (erased (Stmt) stmt) (erased (Core) rest) (erased (Env) env2)
       (erased (EvalStmt env stmt env2) p)
       (erased (Tail env (CStmt stmt rest) env1 c1) outer) -> (Tail env2 rest env1 c1))))

(def-fns _ $ (erased finish-tail : (erased (Env) env) (erased (Core) c) (erased (Env) env1) (erased (Core) c1) (erased (List (Val)) vs)
    (subterm erased (Tail env c env1 c1) t) (erased (Eval env c vs) p) -> (erased (Eval env1 c1 vs) q))
  (match erased t _
    ((TailHere _ _) p)
    ((TailCall _ _ env2 fn args cenv group id ps body vals env3 env4 p2 q2 g b outer)
      (finish-tail _ _ _ _ vs outer (EvCall env2 fn args cenv group id ps body vals env3 env4 vs p2 q2 g b p)))
    ((TailMatch _ _ env2 scrut bs ctor fields ids body env3 p2 br b outer)
      (finish-tail _ _ _ _ vs outer (EvMatch env2 scrut bs ctor fields ids body env3 vs p2 br b p)))
    ((TailStmt _ _ env2 stmt rest env3 p2 outer)
      (finish-tail _ _ _ _ vs outer (EvStmt env2 stmt rest env3 vs p2 p)))))

(def-adts
  ((Resume : ((Env) env) ((Core) c) ((Env) env0) ((Core) c0) -> Type)
    enum newtype
    (many MkResume : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (Core) c) (erased (Env) env1) (erased (Core) c1)
       (erased (Tail env c env1 c1) t) (many (Stack env1 c1 env0 c0) k) -> (Resume env c env0 c0)))
  ((Stack : ((Env) env) ((Core) c) ((Env) env0) ((Core) c0) -> Type)
    enum
    (many KDone : (erased (Env) env0) (erased (Core) c0) -> (Stack env0 c0 env0 c0))
    (many KAppHead : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (erased (Core) h) (many (List (Core)) args)
       (many (Resume env (CApp h args) env0 c0) k) -> (Stack env h env0 c0))
    (many KCallFn : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (erased (Core) fn) (many (List (Core)) args)
       (many (Resume env (CCall fn args) env0 c0) k) -> (Stack env fn env0 c0))
    (many KMatchScrut : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (erased (Core) scrut) (many (List (Branch)) bs)
       (many (Resume env (CMatch scrut bs) env0 c0) k) -> (Stack env scrut env0 c0))
    (many KListHead : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (erased (Core) c) (many (List (Core)) cs)
       (many (ListStack env (Cons (Core) c cs) env0 c0) k) -> (Stack env c env0 c0))
    (many KLetRhs : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (many (List (Nat)) ids) (erased (Core) rhs) (many (Core) rest)
       (many (Resume env (CStmt (SLet ids rhs) rest) env0 c0) k) -> (Stack env rhs env0 c0)))
  ((ListStack : ((Env) env) ((List (Core)) cs) ((Env) env0) ((Core) c0) -> Type)
    enum
    (many KAppArgs : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (Core) h) (erased (List (Core)) args) (many (Nat) ctor)
       (erased (Eval env h (Cons (Val) (VAtom ctor) (Nil (Val)))) p)
       (many (Resume env (CApp h args) env0 c0) k) -> (ListStack env args env0 c0))
    (many KCallArgs : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args)
       (many (Env) cenv) (many (List (FnDef)) group) (erased (Nat) id) (many (List (Nat)) ps) (many (Core) body)
       (erased (Eval env fn (Cons (Val) (VClo cenv group (MkFnDef id ps body)) (Nil (Val)))) p)
       (many (Resume env (CCall fn args) env0 c0) k) -> (ListStack env args env0 c0))
    (many KValues : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (List (Core)) items)
       (many (Resume env (CValues items) env0 c0) k) -> (ListStack env items env0 c0))
    (many KListTail : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (Core) c) (erased (List (Core)) cs) (many (Val) v)
       (erased (Eval env c (Cons (Val) v (Nil (Val)))) p)
       (many (ListStack env (Cons (Core) c cs) env0 c0) k) -> (ListStack env cs env0 c0))))

(def-adts
  ((State : ((Env) env0) ((Core) c0) -> Type)
    enum
    (many SEval : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (many (Core) c) (many (Resume env c env0 c0) k) -> (State env0 c0))
    (many SEvalList : (erased (Env) env0) (erased (Core) c0) (many (Env) env) (many (List (Core)) cs) (many (ListStack env cs env0 c0) k) -> (State env0 c0))
    (many SRet : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (Core) c) (many (List (Val)) vs) (erased (Eval env c vs) p)
       (many (Resume env c env0 c0) k) -> (State env0 c0))
    (many SRetList : (erased (Env) env0) (erased (Core) c0) (erased (Env) env) (erased (List (Core)) cs) (many (List (Val)) vs) (erased (EvalList env cs vs) p)
       (many (ListStack env cs env0 c0) k) -> (State env0 c0)))
  ((Stepped : ((Env) env0) ((Core) c0) -> Type)
    enum
    (many Next : (erased (Env) env0) (erased (Core) c0) (many (State env0 c0) s) -> (Stepped env0 c0))
    (many Halted : (erased (Env) env0) (erased (Core) c0) (many (Evaled env0 c0) r) -> (Stepped env0 c0)))
  ((Single : ((List (Val)) vs) -> Type)
    enum
    (many IsSingle : (many (Val) v) -> (Single (Cons (Val) v (Nil (Val)))))
    (many NotSingle : (erased (List (Val)) vs) -> (Single vs))))

(def-fns _ $ (many single : (many (List (Val)) vs) -> (many (Single vs) r))
  (let-match many vs (Cons _ v rest) ((Nil _) (NotSingle _)))
  (match many rest _
    ((Nil _) (IsSingle v))
    ((Cons _ _ _) (NotSingle _))))

(def-fns _ $ (many step : (erased (Env) env0) (erased (Core) c0) (many (State env0 c0) s) -> (many (Stepped env0 c0) r))
  (match many s _
    ((SEval _ _ env c k)
      (match many c _
        ((CVar x)
          (match many (env-dec env x) _
            ((EnvMiss _ _) (Halted _ _ $ EvalStuck _ _))
            ((EnvHit _ _ v p) (Next _ _ $ SRet _ _ env c (Cons _ v (Nil _)) (EvVar env x v p) k))))
        ((CApp h args) (Next _ _ $ SEval _ _ env h $ MkResume _ _ _ _ _ _ (TailHere _ _) $ KAppHead _ _ env h args k))
        ((CCall fn args) (Next _ _ $ SEval _ _ env fn $ MkResume _ _ _ _ _ _ (TailHere _ _) $ KCallFn _ _ env fn args k))
        ((CMatch scrut bs) (Next _ _ $ SEval _ _ env scrut $ MkResume _ _ _ _ _ _ (TailHere _ _) $ KMatchScrut _ _ env scrut bs k))
        ((CValues items) (Next _ _ $ SEvalList _ _ env items $ KValues _ _ env items k))
        ((CFormer t) (Next _ _ $ SRet _ _ env c (Cons _ (VFormer t env) (Nil _)) (EvFormer env t) k))
        ((CToken) (Next _ _ $ SRet _ _ env c (Cons _ (VToken) (Nil _)) (EvToken env) k))
        ((CStmt stmt rest)
          (let-match many k (MkResume _ _ _ _ _ _ t k1))
          (match many stmt _
            ((SLet ids rhs) (Next _ _ $ SEval _ _ env rhs $ MkResume _ _ _ _ _ _ (TailHere _ _) $ KLetRhs _ _ env ids rhs rest k))
            ((SDefLvl x)
              (Next _ _ $ SEval _ _ (ECons x (VToken) env) rest $ MkResume _ _ _ _ _ _ (TailStmt _ _ env stmt rest (ECons x (VToken) env) (EvDefLvl env x) t) k1))
            ((SDefFns defs)
              (let ((many out) (erased g)) (bind-group env defs defs env))
              (Next _ _ $ SEval _ _ out rest $ MkResume _ _ _ _ _ _ (TailStmt _ _ env stmt rest out (EvDefFns env defs out g) t) k1))
            ((SDefAdts ids)
              (let ((many out) (erased b)) (bind-atoms env ids))
              (Next _ _ $ SEval _ _ out rest $ MkResume _ _ _ _ _ _ (TailStmt _ _ env stmt rest out (EvDefAdts env ids out b) t) k1))))))
    ((SEvalList _ _ env cs k)
      (match many cs _
        ((Nil _) (Next _ _ $ SRetList _ _ env cs (Nil _) (EvLNil env) k))
        ((Cons _ c rest) (Next _ _ $ SEval _ _ env c $ MkResume _ _ _ _ _ _ (TailHere _ _) $ KListHead _ _ env c rest k))))
    ((SRet _ _ _ _ vs returned resume)
      (let-match many resume (MkResume _ _ _ _ _ _ t k))
      (let ((erased p)) (finish-tail _ _ _ _ vs t returned))
      (match many k _
        ((KDone _ _) (Halted _ _ $ MkEvaled _ _ vs p))
        ((KAppHead _ _ env2 h args k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (Halted _ _ $ EvalStuck _ _)))
          (let-match many v (VAtom ctor) (else (Halted _ _ $ EvalStuck _ _)))
          (Next _ _ $ SEvalList _ _ env2 args $ KAppArgs _ _ env2 h args ctor p k2))
        ((KCallFn _ _ env2 fn args k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (Halted _ _ $ EvalStuck _ _)))
          (let-match many v (VClo cenv group def) (else (Halted _ _ $ EvalStuck _ _)))
          (let-match many def (MkFnDef id ps body))
          (Next _ _ $ SEvalList _ _ env2 args $ KCallArgs _ _ env2 fn args cenv group id ps body p k2))
        ((KMatchScrut _ _ env2 scrut bs k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (Halted _ _ $ EvalStuck _ _)))
          (let-match many v (VCon ctor fields) (else (Halted _ _ $ EvalStuck _ _)))
          (let-match many (branch-dec bs ctor) (BrHit _ _ ids body br) ((BrMiss _ _) (Halted _ _ $ EvalStuck _ _)))
          (let-match many (bind-all env2 ids fields) (BDOk _ _ _ env1 bd) ((BDStuck _ _ _) (Halted _ _ $ EvalStuck _ _)))
          (let-match many k2 (MkResume _ _ _ _ _ _ t2 k3))
          (Next _ _ $ SEval _ _ env1 body $ MkResume _ _ _ _ _ _ (TailMatch _ _ env2 scrut bs ctor fields ids body env1 p br bd t2) k3))
        ((KListHead _ _ env2 c2 cs k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (Halted _ _ $ EvalStuck _ _)))
          (Next _ _ $ SEvalList _ _ env2 cs $ KListTail _ _ env2 c2 cs v p k2))
        ((KLetRhs _ _ env2 ids rhs rest k2)
          (let-match many (bind-all env2 ids vs) (BDOk _ _ _ out bd) ((BDStuck _ _ _) (Halted _ _ $ EvalStuck _ _)))
          (let-match many k2 (MkResume _ _ _ _ _ _ t2 k3))
          (Next _ _ $ SEval _ _ out rest $ MkResume _ _ _ _ _ _ (TailStmt _ _ env2 (SLet ids rhs) rest out (EvLet env2 ids rhs vs out p bd) t2) k3))))
    ((SRetList _ _ _ _ vs p k)
      (let-match many k (KCallArgs _ _ env2 fn args cenv group id ps body p2 k2)
        ((KAppArgs _ _ env2 h args ctor p2 k2)
          (Next _ _ $ SRet _ _ env2 (CApp h args) (Cons _ (VCon ctor vs) (Nil _)) (EvApp env2 h args ctor vs p2 p) k2))
        ((KValues _ _ env2 items k2)
          (Next _ _ $ SRet _ _ env2 (CValues items) vs (EvValues env2 items vs p) k2))
        ((KListTail _ _ env2 c2 cs2 v p2 k2)
          (Next _ _ $ SRetList _ _ env2 (Cons _ c2 cs2) (Cons _ v vs) (EvLCons env2 c2 v cs2 vs p2 p) k2)))
      (let ((many env1) (erased g)) (bind-group cenv group group cenv))
      (let-match many (bind-all env1 ps vs) (BDOk _ _ _ env3 bd) ((BDStuck _ _ _) (Halted _ _ $ EvalStuck _ _)))
      (let-match many k2 (MkResume _ _ _ _ _ _ t2 k3))
      (Next _ _ $ SEval _ _ env3 body $ MkResume _ _ _ _ _ _ (TailCall _ _ env2 fn args cenv group id ps body vs env1 env3 p2 p g bd t2) k3))))

(def-fns _ $ (many load : (many (Core) program) -> (many (State (ENil) program) s))
  (SEval _ _ (ENil) program $ MkResume _ _ _ _ _ _ (TailHere _ _) $ KDone _ _))
