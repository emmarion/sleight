(def-fns _
  ((many eval-by : (erased (List (Val)) vs) (many (Env) env) (many (Core) c) (subterm erased (Eval env c vs) d) -> (many vs is out))
    (match many c _
      ((CVar x)
        (let-match erased d (EvVar _ _ v p))
        (Cons _ (env-get env x v p) (Nil _)))
      ((CApp h args)
        (let-match erased d (EvApp _ _ _ _ _ p q))
        (let-match many (notail $ eval-by _ env h p) (Cons _ head _))
        (let-match many head (VAtom ctor))
        (Cons _ (VCon ctor (notail $ eval-list-by _ env args q)) (Nil _)))
      ((CCall fn args)
        (let-match erased d (EvCall _ _ _ _ _ _ _ _ _ env1 env2 _ p q g b r))
        (let-match many (notail $ eval-by _ env fn p) (Cons _ callee _))
        (let-match many callee (VClo cenv group def))
        (let-match many def (MkFnDef _ ps body))
        (let ((many vals)) (notail $ eval-list-by _ env args q))
        (let ((many bound)) (bind-all-get (bind-group-get cenv group group cenv env1 g) ps vals env2 b))
        (tail $ eval-by _ env body r))
      ((CMatch scrut bs)
        (let-match erased d (EvMatch _ _ _ _ _ ids branch-body env1 _ p br b r))
        (let-match many (notail $ eval-by _ env scrut p) (Cons _ scrutinee _))
        (let-match many scrutinee (VCon ctor fields))
        (let ((many field-ids) (many body)) (branch-get bs ctor ids branch-body br))
        (tail $ eval-by _ (bind-all-get env field-ids fields env1 b) body r))
      ((CValues items)
        (let-match erased d (EvValues _ _ _ q))
        (tail $ eval-list-by _ env items q))
      ((CFormer t)
        (let-match erased d (EvFormer _ _))
        (Cons _ (VFormer t env) (Nil _)))
      ((CToken)
        (let-match erased d (EvToken _))
        (Cons _ (VToken) (Nil _)))
      ((CStmt stmt rest)
        (let-match erased d (EvStmt _ _ _ env1 _ p q))
        (tail $ eval-by _ (notail $ eval-stmt-by env1 env stmt p) rest q))))
  ((many eval-list-by : (erased (List (Val)) vs) (many (Env) env) (many (List (Core)) cs) (subterm erased (EvalList env cs vs) d) -> (many vs is out))
    (let-match many cs (Cons _ c rest) ((Nil _) (let-match erased d (EvLNil _)) (Nil _)))
    (let-match erased d (EvLCons _ _ _ _ _ p q))
    (let-match many (notail $ eval-by _ env c p) (Cons _ v _))
    (Cons _ v (notail $ eval-list-by _ env rest q)))
  ((many eval-stmt-by : (erased (Env) out) (many (Env) env) (many (Stmt) stmt) (subterm erased (EvalStmt env stmt out) d) -> (many out is bound))
    (match many stmt _
      ((SLet ids rhs)
        (let-match erased d (EvLet _ _ _ _ _ p b))
        (bind-all-get env ids (notail $ eval-by _ env rhs p) out b))
      ((SDefLvl x)
        (let-match erased d (EvDefLvl _ _))
        (ECons x (VToken) env))
      ((SDefFns defs)
        (let-match erased d (EvDefFns _ _ _ g))
        (bind-group-get env defs defs env out g))
      ((SDefAdts ids)
        (let-match erased d (EvDefAdts _ _ _ b))
        (bind-atoms-get env ids out b)))))
