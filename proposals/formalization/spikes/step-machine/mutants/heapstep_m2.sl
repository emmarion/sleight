(def-fns _ $ (many hstep : (erased Store now) (erased Store s0) (erased (HExpr) e0) (many (HControl now s0 e0) c) (unique (Array (Copy (Nat)) now) heap) ->
    (erased Store after) (unique (Array (Copy (Nat)) after) heap-after at heap) (many (HStepped after s0 e0) r))
  (match many c _
    ((HRun _ _ _ e k)
      (match many e _
        ((HLit n) (values now heap (HNext _ _ _ $ HRet _ _ _ now e n (HvLit now n) k)))
        ((HGet address) (values now heap (HNext _ _ _ $ HRun _ _ _ address $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKGet _ _ now address k)))
        ((HSet address value) (values now heap (HNext _ _ _ $ HRun _ _ _ address $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKSetAddress _ _ now address value k)))
        ((HPred inner) (values now heap (HNext _ _ _ $ HRun _ _ _ inner $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKPred _ _ now inner k)))
        ((HSeq first second) (values now heap (HNext _ _ _ $ HRun _ _ _ first $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKSeq _ _ now first second k)))
        ((HWhile condition body)
          (values now heap (HNext _ _ _ $ HRun _ _ _ condition $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKWhileCond _ _ now condition body k)))))
    ((HRet _ _ _ _ _ v returned resume)
      (let-match many resume (MkHResume _ _ _ _ _ _ t k))
      (let ((erased p)) (finish-htail _ _ _ _ v now t returned))
      (match many k _
        ((HDone _ _) (values now heap (HHalted _ _ _ v p)))
        ((HKGet _ _ s address k2)
          (let ((many len) (erased len-proof) (unique heap1)) (array-length _ _ heap))
          (let-match many (lt-dec v len) (Yes _ _ _ _ below) ((No _ _ _ _ _) (values now heap1 (HStuck _ _ _))))
          (let ((erased cell) (erased holds)) (nth-exists _ now len v len-proof below))
          (let-match erased cell (MkCopy _ content))
          (let ((many value) (unique heap2)) (array-get _ _ heap1 v content holds))
          (values now heap2 (HNext _ _ _ $ HRet _ _ _ s (HGet address) value (HvGet s address v now content p holds) k2)))
        ((HKSetAddress _ _ s address value k2)
          (values now heap (HNext _ _ _ $ HRun _ _ _ value $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKSetValue _ _ s address value v now p k2)))
        ((HKSetValue _ _ s address value a s1 p1 k2)
          (let ((many len) (erased len-proof) (unique heap1)) (array-length _ _ heap))
          (let-match many (lt-dec a len) (Yes _ _ _ _ below) ((No _ _ _ _ _) (values now heap1 (HStuck _ _ _))))
          (let ((erased old) (erased holds)) (nth-exists _ now len a len-proof below))
          (let ((erased after) (unique heap2) (erased written)) (array-place _ _ heap1 a (MkCopy _ v) old holds))
          (values now heap2 (HNext _ _ _ $ HRet _ _ _ s (HSet address value) v (HvSet s address value a s1 v now now p1 p written) k2)))
        ((HKPred _ _ s inner k2)
          (let ((many (Nat) m) (erased (PredOf v m) d))
            (match many v _
              ((Zero) (values (Zero) (PredZero)))
              ((Succ smaller) (values smaller (PredSucc smaller)))))
          (values now heap (HNext _ _ _ $ HRet _ _ _ s (HPred inner) m (HvPred s inner v m now p d) k2)))
        ((HKSeq _ _ s first second k2)
          (let-match many k2 (MkHResume _ _ _ _ _ _ t2 k3))
          (values now heap (HNext _ _ _ $ HRun _ _ _ second $ MkHResume _ _ _ _ _ _ (HTailSeq _ _ s first second v now p t2) k3)))
        ((HKWhileCond _ _ s condition body k2)
          (match many v _
            ((Zero) (values now heap (HNext _ _ _ $ HRet _ _ _ s (HWhile condition body) (Zero) (HvWhileDone s condition body now p) k2)))
            ((Succ n)
              (values now heap (HNext _ _ _ $ HRun _ _ _ body $ MkHResume _ _ _ _ _ _ (HTailHere _ _) $ HKWhileBody _ _ s condition body n now p k2)))))
        ((HKWhileBody _ _ s condition body n s1 p1 k2)
          (let-match many k2 (MkHResume _ _ _ _ _ _ t2 k3))
          (values now heap
            (HNext _ _ _ $ HRun _ _ _ (HWhile condition body) $ MkHResume _ _ _ _ _ _ (HTailWhile _ _ s condition body n s1 v now p1 p t2) k3)))))))
