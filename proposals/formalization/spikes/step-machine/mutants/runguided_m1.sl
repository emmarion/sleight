(def-fns _ $ (many run-guided : (erased (Env) env0) (erased (Core) c0) (erased (List (Val)) vs) (erased (Eval env0 c0 vs) p)
    (many (State env0 c0) s) (subterm erased (Reaches env0 c0 s (SRet env0 c0 env0 c0 vs p (KDone env0 c0))) path) -> (many vs is out))
  (match many s _
    ((SEval _ _ env c k)
      (let-match erased path (ReachStep _ _ _ _ _ first rest))
      (match many c _
        ((CVar x)
          (let-match erased first (StVar _ _ _ _ v q _))
          (tail $ run-guided _ _ vs p (SRet _ _ env c (Cons _ (env-get env x v q) (Nil _)) (EvVar env x v q) k) rest))
        ((CApp h args)
          (let-match erased first (StApp _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SEval _ _ env h k) rest))
        ((CCall fn args)
          (let-match erased first (StCall _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SEval _ _ env fn $ KCallFn _ _ env fn args k) rest))
        ((CMatch scrut bs)
          (let-match erased first (StMatch _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SEval _ _ env scrut $ KMatchScrut _ _ env scrut bs k) rest))
        ((CValues items)
          (let-match erased first (StValues _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SEvalList _ _ env items $ KValues _ _ env items k) rest))
        ((CFormer t)
          (let-match erased first (StFormer _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env c (Cons _ (VFormer t env) (Nil _)) (EvFormer env t) k) rest))
        ((CToken)
          (let-match erased first (StToken _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env c (Cons _ (VToken) (Nil _)) (EvToken env) k) rest))
        ((CStmt stmt after)
          (match many stmt _
            ((SLet ids rhs)
              (let-match erased first (StLet _ _ _ _ _ _ _))
              (tail $ run-guided _ _ vs p (SEval _ _ env rhs $ KLetRhs _ _ env ids rhs after k) rest))
            ((SDefLvl x)
              (let-match erased first (StDefLvl _ _ _ _ _ _))
              (tail $ run-guided _ _ vs p (SEval _ _ (ECons x (VToken) env) after $ KStmtRest _ _ env stmt after (ECons x (VToken) env) (EvDefLvl env x) k) rest))
            ((SDefFns defs)
              (let-match erased first (StDefFns _ _ _ _ _ out g _))
              (tail $ run-guided _ _ vs p (SEval _ _ (bind-group-get env defs defs env out g) after $ KStmtRest _ _ env stmt after out (EvDefFns env defs out g) k) rest))
            ((SDefAdts ids)
              (let-match erased first (StDefAdts _ _ _ _ _ out b _))
              (tail $ run-guided _ _ vs p (SEval _ _ (bind-atoms-get env ids out b) after $ KStmtRest _ _ env stmt after out (EvDefAdts env ids out b) k) rest))))))
    ((SEvalList _ _ env cs k)
      (let-match erased path (ReachStep _ _ _ _ _ first rest))
      (match many cs _
        ((Nil _)
          (let-match erased first (StListNil _ _ _ _))
          (tail $ run-guided _ _ vs p (SRetList _ _ env cs (Nil _) (EvLNil env) k) rest))
        ((Cons _ c others)
          (let-match erased first (StListCons _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SEval _ _ env c $ KListHead _ _ env c others k) rest))))
    ((SRet _ _ _ _ vals ret k)
      (match many k _
        ((KDone _ _)
          (let-match erased path (ReachHere _ _ _) (absurd (ReachStep _ _ _ _ _ first _) first))
          vals)
        ((KAppHead _ _ env2 h args k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetAppHead _ _ _ _ _ _ _ _))
          (let-match many vals (Cons _ v _))
          (let-match many v (VAtom ctor))
          (tail $ run-guided _ _ vs p (SEvalList _ _ env2 args $ KAppArgs _ _ env2 h args ctor ret k2) rest))
        ((KCallFn _ _ env2 fn args k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetCallFn _ _ _ _ _ _ _ _ _ _ _ _))
          (let-match many vals (Cons _ v _))
          (let-match many v (VClo cenv group def))
          (let-match many def (MkFnDef id ps body))
          (tail $ run-guided _ _ vs p (SEvalList _ _ env2 args $ KCallArgs _ _ env2 fn args cenv group id ps body ret k2) rest))
        ((KCallBody _ _ env2 fn args cenv group id ps body vals2 env1 env3 p2 q g b k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetCallBody _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env2 (CCall fn args) vals (EvCall env2 fn args cenv group id ps body vals2 env1 env3 vals p2 q g b ret) k2) rest))
        ((KMatchScrut _ _ env2 scrut bs k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetMatchScrut _ _ _ _ _ _ _ ids body env1 _ br b _))
          (let-match many vals (Cons _ v _))
          (let-match many v (VCon ctor fields))
          (let ((many field-ids) (many branch-body)) (branch-get bs ctor ids body br))
          (tail $ run-guided _ _ vs p
            (SEval _ _ (bind-all-get env2 field-ids fields env1 b) branch-body $ KMatchBody _ _ env2 scrut bs ctor fields ids body env1 ret br b k2) rest))
        ((KMatchBody _ _ env2 scrut bs ctor fields ids body env1 p2 br b k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetMatchBody _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env2 (CMatch scrut bs) vals (EvMatch env2 scrut bs ctor fields ids body env1 vals p2 br b ret) k2) rest))
        ((KListHead _ _ env2 c2 cs k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetListHead _ _ _ _ _ _ _ _))
          (let-match many vals (Cons _ v _))
          (tail $ run-guided _ _ vs p (SEvalList _ _ env2 cs $ KListTail _ _ env2 c2 cs v ret k2) rest))
        ((KLetRhs _ _ env2 ids rhs after k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetLetRhs _ _ _ _ _ _ _ out _ b _))
          (tail $ run-guided _ _ vs p
            (SEval _ _ (bind-all-get env2 ids vals out b) after $ KStmtRest _ _ env2 (SLet ids rhs) after out (EvLet env2 ids rhs vals out ret b) k2) rest))
        ((KStmtRest _ _ env2 stmt after env1 p2 k2)
          (let-match erased path (ReachStep _ _ _ _ _ first rest))
          (let-match erased first (StRetStmtRest _ _ _ _ _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env2 (CStmt stmt after) vals (EvStmt env2 stmt after env1 vals p2 ret) k2) rest))))
    ((SRetList _ _ _ _ vals ret k)
      (let-match erased path (ReachStep _ _ _ _ _ first rest))
      (match many k _
        ((KAppArgs _ _ env2 h args ctor p2 k2)
          (let-match erased first (StRetAppArgs _ _ _ _ _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env2 (CApp h args) (Cons _ (VCon ctor vals) (Nil _)) (EvApp env2 h args ctor vals p2 ret) k2) rest))
        ((KCallArgs _ _ env2 fn args cenv group id ps body p2 k2)
          (let-match erased first (StRetCallArgs _ _ _ _ _ _ _ _ _ _ _ env1 env3 _ _ g b _))
          (tail $ run-guided _ _ vs p
            (SEval _ _ (bind-all-get (bind-group-get cenv group group cenv env1 g) ps vals env3 b) body
              $ KCallBody _ _ env2 fn args cenv group id ps body vals env1 env3 p2 ret g b k2) rest))
        ((KValues _ _ env2 items k2)
          (let-match erased first (StRetValues _ _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRet _ _ env2 (CValues items) vals (EvValues env2 items vals ret) k2) rest))
        ((KListTail _ _ env2 c2 cs2 v p2 k2)
          (let-match erased first (StRetListTail _ _ _ _ _ _ _ _ _ _))
          (tail $ run-guided _ _ vs p (SRetList _ _ env2 (Cons _ c2 cs2) (Cons _ v vals) (EvLCons env2 c2 v cs2 vals p2 ret) k2) rest))))))

(def-fns _ $ (many run-from-spec : (many (Core) program) (erased (List (Val)) vs) (erased (Eval (ENil) program vs) derivation) -> (many vs is out))
  (let ((erased rebuilt) (erased path)) (eval-reaches (ENil) program vs derivation (ENil) program (KDone _ _)))
  (run-guided _ _ vs rebuilt (load program) path))
