(def-adts
  ((Traced : ((Env) env0) ((Core) c0) ((State env0 c0) s) -> Type)
    enum
    (many TracedNext : (erased (Env) env0) (erased (Core) c0) (erased (State env0 c0) s) (many (State env0 c0) s2) (erased (StepTo env0 c0 s s2) taken) -> (Traced env0 c0 s))
    (many TracedHalt : (erased (Env) env0) (erased (Core) c0) (erased (State env0 c0) s) (many (Evaled env0 c0) r) -> (Traced env0 c0 s))))

(def-fns _ $ (many step-traced : (erased (Env) env0) (erased (Core) c0) (many (State env0 c0) s) -> (many (Traced env0 c0 s) r))
  (match many s _
    ((SEval _ _ env c k)
      (match many c _
        ((CVar x)
          (match many (env-dec env x) _
            ((EnvMiss _ _) (TracedHalt _ _ _ $ EvalStuck _ _))
            ((EnvHit _ _ v p) (TracedNext _ _ _ (SRet _ _ env c (Cons _ v (Nil _)) (EvVar env x v p) k) (StVar _ _ env x v p k)))))
        ((CApp h args) (TracedNext _ _ _ (SEval _ _ env h $ KAppHead _ _ env h args k) (StApp _ _ env h args k)))
        ((CCall fn args) (TracedNext _ _ _ (SEval _ _ env fn $ KCallFn _ _ env fn args k) (StCall _ _ env fn args k)))
        ((CMatch scrut bs) (TracedNext _ _ _ (SEval _ _ env scrut $ KMatchScrut _ _ env scrut bs k) (StMatch _ _ env scrut bs k)))
        ((CValues items) (TracedNext _ _ _ (SEvalList _ _ env items $ KValues _ _ env items k) (StValues _ _ env items k)))
        ((CFormer t) (TracedNext _ _ _ (SRet _ _ env c (Cons _ (VFormer t env) (Nil _)) (EvFormer env t) k) (StFormer _ _ env t k)))
        ((CToken) (TracedNext _ _ _ (SRet _ _ env c (Cons _ (VToken) (Nil _)) (EvToken env) k) (StToken _ _ env k)))
        ((CStmt stmt rest)
          (match many stmt _
            ((SLet ids rhs) (TracedNext _ _ _ (SEval _ _ env rhs $ KLetRhs _ _ env ids rhs rest k) (StLet _ _ env ids rhs rest k)))
            ((SDefLvl x)
              (TracedNext _ _ _ (SEval _ _ (ECons x (VToken) env) rest $ KStmtRest _ _ env stmt rest (ECons x (VToken) env) (EvDefLvl env x) k)
                (StDefLvl _ _ env x rest k)))
            ((SDefFns defs)
              (let ((many out) (erased g)) (bind-group env defs defs env))
              (TracedNext _ _ _ (SEval _ _ out rest $ KStmtRest _ _ env stmt rest out (EvDefFns env defs out g) k) (StDefFns _ _ env defs rest out g k)))
            ((SDefAdts ids)
              (let ((many out) (erased b)) (bind-atoms env ids))
              (TracedNext _ _ _ (SEval _ _ out rest $ KStmtRest _ _ env stmt rest out (EvDefAdts env ids out b) k) (StDefAdts _ _ env ids rest out b k)))))))
    ((SEvalList _ _ env cs k)
      (match many cs _
        ((Nil _) (TracedNext _ _ _ (SRetList _ _ env cs (Nil _) (EvLNil env) k) (StListNil _ _ env k)))
        ((Cons _ c rest) (TracedNext _ _ _ (SEval _ _ env c $ KListHead _ _ env c rest k) (StListCons _ _ env c rest k)))))
    ((SRet _ _ _ _ vs p k)
      (match many k _
        ((KDone _ _) (TracedHalt _ _ _ $ MkEvaled _ _ vs p))
        ((KAppHead _ _ env2 h args k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (let-match many v (VAtom ctor) (else (TracedHalt _ _ _ $ EvalStuck _ _)))
          (TracedNext _ _ _ (SEvalList _ _ env2 args $ KAppArgs _ _ env2 h args ctor p k2) (StRetAppHead _ _ env2 h args ctor p k2)))
        ((KCallFn _ _ env2 fn args k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (let-match many v (VClo cenv group def) (else (TracedHalt _ _ _ $ EvalStuck _ _)))
          (let-match many def (MkFnDef id ps body))
          (TracedNext _ _ _ (SEvalList _ _ env2 args $ KCallArgs _ _ env2 fn args cenv group id ps body p k2)
            (StRetCallFn _ _ env2 fn args cenv group id ps body p k2)))
        ((KCallBody _ _ env2 fn args cenv group id ps body vals env1 env3 p2 q g b k2)
          (TracedNext _ _ _ (SRet _ _ env2 (CCall fn args) vs (EvCall env2 fn args cenv group id ps body vals env1 env3 vs p2 q g b p) k2)
            (StRetCallBody _ _ env2 fn args cenv group id ps body vals env1 env3 vs p2 q g b p k2)))
        ((KMatchScrut _ _ env2 scrut bs k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (let-match many v (VCon ctor fields) (else (TracedHalt _ _ _ $ EvalStuck _ _)))
          (let-match many (branch-dec bs ctor) (BrHit _ _ ids body br) ((BrMiss _ _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (let-match many (bind-all env2 ids fields) (BDOk _ _ _ env1 bd) ((BDStuck _ _ _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (TracedNext _ _ _ (SEval _ _ env1 body $ KMatchBody _ _ env2 scrut bs ctor fields ids body env1 p br bd k2)
            (StRetMatchScrut _ _ env2 scrut bs ctor fields ids body env1 p br bd k2)))
        ((KMatchBody _ _ env2 scrut bs ctor fields ids body env1 p2 br bd k2)
          (TracedNext _ _ _ (SRet _ _ env2 (CMatch scrut bs) vs (EvMatch env2 scrut bs ctor fields ids body env1 vs p2 br bd p) k2)
            (StRetMatchBody _ _ env2 scrut bs ctor fields ids body env1 vs p2 br bd p k2)))
        ((KListHead _ _ env2 c2 cs k2)
          (let-match many (single vs) (IsSingle v) ((NotSingle _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (TracedNext _ _ _ (SEvalList _ _ env2 cs $ KListTail _ _ env2 c2 cs v p k2) (StRetListHead _ _ env2 c2 cs v p k2)))
        ((KLetRhs _ _ env2 ids rhs rest k2)
          (let-match many (bind-all env2 ids vs) (BDOk _ _ _ out bd) ((BDStuck _ _ _) (TracedHalt _ _ _ $ EvalStuck _ _)))
          (TracedNext _ _ _ (SEval _ _ out rest $ KStmtRest _ _ env2 (SLet ids rhs) rest out (EvLet env2 ids rhs vs out p bd) k2)
            (StRetLetRhs _ _ env2 ids rhs rest vs out p bd k2)))
        ((KStmtRest _ _ env2 stmt rest env1 p2 k2)
          (TracedNext _ _ _ (SRet _ _ env2 (CStmt stmt rest) vs (EvStmt env2 stmt rest env1 vs p2 p) k2)
            (StRetStmtRest _ _ env2 stmt rest env1 vs p2 p k2)))))
    ((SRetList _ _ _ _ vs p k)
      (let-match many k (KCallArgs _ _ env2 fn args cenv group id ps body p2 k2)
        ((KAppArgs _ _ env2 h args ctor p2 k2)
          (TracedNext _ _ _ (SRet _ _ env2 (CApp h args) (Cons _ (VCon ctor vs) (Nil _)) (EvApp env2 h args ctor vs p2 p) k2)
            (StRetAppArgs _ _ env2 h args ctor vs p2 p k2)))
        ((KValues _ _ env2 items k2)
          (TracedNext _ _ _ (SRet _ _ env2 (CValues items) vs (EvValues env2 items vs p) k2) (StRetValues _ _ env2 items vs p k2)))
        ((KListTail _ _ env2 c2 cs2 v p2 k2)
          (TracedNext _ _ _ (SRetList _ _ env2 (Cons _ c2 cs2) (Cons _ v vs) (EvLCons env2 c2 v cs2 vs p2 p) k2)
            (StRetListTail _ _ env2 c2 cs2 v vs p2 p k2))))
      (let ((many env1) (erased g)) (bind-group cenv group group cenv))
      (let-match many (bind-all env1 ps vs) (BDOk _ _ _ env3 bd) ((BDStuck _ _ _) (TracedHalt _ _ _ $ EvalStuck _ _)))
      (TracedNext _ _ _ (SEval _ _ env3 body $ KCallBody _ _ env2 fn args cenv group id ps body vs env1 env3 p2 p g bd k2)
        (StRetCallArgs _ _ env2 fn args cenv group id ps body vs env1 env3 p2 p g bd k2)))))
