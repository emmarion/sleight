(def-fns _ $ (many tick-fn : (unique (MacroWorld) mw at vacant-slot) (many (Pos) here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let ((unique mw1) (many k) (erased _)) (gensym mw "t"))
  (let ((unique mw2) (many h)) (intern-nat mw1 k))
  (values mw2 (Cons _ (RawSettled here _ _ _ h) $ Nil _)))
(let ((many tick)) (MkMacro _ tick-fn))
(def-adts $ (T4 : -> Type) enum (many MkT4 : (many (Nat) a) (many (Nat) b) (many (Nat) c) (many (Nat) d) -> (T4)))
(def-fns _ $ (many add3 : (many (Nat) a) (many (Nat) b) (many (Nat) c) -> (many (List (Nat)) r)) (Cons _ a $ Cons _ b $ Cons _ c $ Nil _))
(def-lvl HL)
(def-fns HL $ (many pair-fn : (many (Nat) a) (many (Nat) b) -> (many (List (Nat)) r)) (Cons _ a $ Cons _ b $ Nil _))
(def-fns _ $ (many pick : (many (Nat) tag) -> (many (Fn HL (many (Nat) a) (many (Nat) b) -> (many (List (Nat)) r)) f)) pair-fn)
(def-fns _ $ (many body : -> (many (List (List (Nat))) r))
  (let ((many v1) (many v2) (many v3)) (values (tick) (tick) (tick)))
  (let ((many call)) (add3 (tick) (tick) (tick)))
  (let ((many nested)) (add3 (tick) (nat-add (tick) 0) (tick)))
  (let ((many headed)) ((pick (tick)) (tick) (tick)))
  (Cons _ (Cons _ v1 $ Cons _ v2 $ Cons _ v3 $ Nil _) $ Cons _ call $ Cons _ nested $ Cons _ headed $ Nil _))
(let ((many t1) (many t2) (many t3)) (values (tick) (tick) (tick)))
(let ((many tcall)) (add3 (tick) (nat-add (tick) 0) (tick)))
(let ((many theaded)) ((pick (tick)) (tick) (tick)))
(MkPair _ _ (body) (Cons _ (Cons _ t1 $ Cons _ t2 $ Cons _ t3 $ Nil _) $ Cons _ tcall $ Cons _ theaded $ Nil _))
