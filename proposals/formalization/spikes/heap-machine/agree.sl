(def-fns _ $ (erased steps-append : (erased (List (Code)) fns) (erased (Heap) h) (erased (Control) c) (erased (List (Label)) ls1)
    (erased (Heap) h1) (erased (Control) c1) (erased (List (Label)) ls2) (erased (Heap) h2) (erased (Control) c2)
    (subterm erased (Steps fns h c ls1 h1 c1) p) (erased (Steps fns h1 c1 ls2 h2 c2) q) ->
    (erased (List (Label)) ls) (erased (Steps fns h c ls h2 c2) r))
  (let-match erased p (StepsCons _ _ _ l hm cm rest _ _ s p1) ((StepsNil _ _ _) (values ls2 q)))
  (let ((erased ls) (erased r)) (steps-append fns hm cm rest h1 c1 ls2 h2 c2 p1 q))
  (values (Cons _ l ls) (StepsCons fns h c l hm cm ls h2 c2 s r)))

(def-fns _ $ (erased big-small : (erased (List (Code)) fns) (erased (Heap) h) (erased (List (Word)) env) (erased (Code) c) (erased (Choices) ch)
    (erased (Heap) h2) (erased (Word) w) (erased (Stack) k)
    (subterm erased (Run fns h env c ch h2 w) d) ->
    (erased (List (Label)) ls) (erased (Steps fns h (KRun env c k) ls h2 (KRet w k)) s))
  (match erased d _
    ((RunDo _ _ _ i l _ _ p)
      (values (Cons _ l (Nil _))
        (StepsCons fns h (KRun env (CDo i) k) l h2 (KRet w k) (Nil _) h2 (KRet w k)
          (StDo fns h env i k l h2 w p) (StepsNil fns h2 (KRet w k)))))
    ((RunLet _ _ _ rhs body ch1 h1 w1 ch2 _ _ p q)
      (let ((erased ls1) (erased s1)) (big-small fns h env rhs ch1 h1 w1 (KLet env body k) p))
      (let ((erased ls2) (erased s2)) (big-small fns h1 (Cons _ w1 env) body ch2 h2 w k q))
      (let ((erased ls3) (erased s3))
        (steps-append fns h (KRun env rhs (KLet env body k)) ls1 h1 (KRet w1 (KLet env body k)) (Cons _ (LTau) ls2) h2 (KRet w k) s1
          (StepsCons fns h1 (KRet w1 (KLet env body k)) (LTau) h1 (KRun (Cons _ w1 env) body k) ls2 h2 (KRet w k)
            (StRet fns h1 w1 env body k) s2)))
      (values (Cons _ (LTau) ls3)
        (StepsCons fns h (KRun env (CLet rhs body) k) (LTau) h (KRun env rhs (KLet env body k)) ls3 h2 (KRet w k)
          (StLet fns h env rhs body k) s3)))
    ((RunMatch _ _ _ a blocks imms v body fs env2 _ _ _ pa sel ct q)
      (let ((erased ls1) (erased s1)) (big-small fns h env2 body ch h2 w k q))
      (values (Cons _ (LTau) ls1)
        (StepsCons fns h (KRun env (CMatch a blocks imms) k) (LTau) h (KRun env2 body k) ls1 h2 (KRet w k)
          (StMatch fns h env a blocks imms k v body fs env2 pa sel ct) s1)))
    ((RunCall _ _ _ f args body ws _ _ _ pf pa q)
      (let ((erased ls1) (erased s1)) (big-small fns h ws body ch h2 w k q))
      (values (Cons _ (LTau) ls1)
        (StepsCons fns h (KRun env (CCall f args) k) (LTau) h (KRun ws body k) ls1 h2 (KRet w k)
          (StCall fns h env f args k body ws pf pa) s1)))))
