(def-fns _ $ (erased atomval-fn : (erased (List (Word)) env) (erased (Atom) a) (erased (Word) w1 w2)
    (erased (AtomVal env a w1) p) (erased (AtomVal env a w2) q) -> (erased (Eq (Word) w1 w2) e))
  (match erased p _
    ((AVVar _ i _ p1) (let-match erased q (AVVar _ _ _ q1)) (nth-fn _ env i w1 w2 p1 q1))
    ((AVImm _ n) (let-match erased q (AVImm _ _)) (Refl _ w1))))

(def-fns _ $ (erased atomvals-fn : (erased (List (Word)) env) (erased (List (Atom)) as) (erased (List (Word)) ws1 ws2)
    (subterm erased (AtomVals env as ws1) p) (erased (AtomVals env as ws2) q) -> (erased (Eq (List (Word)) ws1 ws2) e))
  (match erased p _
    ((AVsNil _) (let-match erased q (AVsNil _)) (Refl _ ws1))
    ((AVsCons _ a w1 rest r1 pa p1)
      (let-match erased q (AVsCons _ _ w2 _ r2 qa q1))
      (let-match erased (atomval-fn env a w1 w2 pa qa) (Refl _ _))
      (let-match erased (atomvals-fn env rest r1 r2 p1 q1) (Refl _ _))
      (Refl _ ws1))))

(def-fns _ $ (erased cat-fn : (erased (List (Word)) xs ys zs1 zs2)
    (subterm erased (Cat xs ys zs1) p) (erased (Cat xs ys zs2) q) -> (erased (Eq (List (Word)) zs1 zs2) e))
  (match erased p _
    ((CatNil _) (let-match erased q (CatNil _)) (Refl _ zs1))
    ((CatCons x rest _ r1 p1)
      (let-match erased q (CatCons _ _ _ r2 q1))
      (let-match erased (cat-fn rest ys r1 r2 p1 q1) (Refl _ _))
      (Refl _ zs1))))

(def-fns _ $ (erased lookup-fn : (erased (Heap) h) (erased (Nat) a) (erased (Block) b1 b2)
    (subterm erased (Lookup h a b1) p) (erased (Lookup h a b2) q) -> (erased (Eq (Block) b1 b2) e))
  (match erased p _
    ((LkHere _ _ rest)
      (match erased q _
        ((LkHere _ _ _) (Refl _ b1))
        (absurd (LkThere _ _ _ _ _ n _) (neq-irrefl a n))))
    ((LkThere _ b _ other rest n p1)
      (match erased q _
        (absurd (LkHere _ _ _) (neq-irrefl a n))
        ((LkThere _ _ _ _ _ _ q1) (lookup-fn rest a b1 b2 p1 q1))))))

(def-fns _ $ (erased update-fn : (erased (Heap) h) (erased (Nat) a) (erased (Block) blk) (erased (Heap) h1 h2)
    (subterm erased (Update h a blk h1) p) (erased (Update h a blk h2) q) -> (erased (Eq (Heap) h1 h2) e))
  (match erased p _
    ((UpHere _ old _ rest)
      (match erased q _
        ((UpHere _ _ _ _) (Refl _ h1))
        (absurd (UpThere _ _ _ _ _ _ n _) (neq-irrefl a n))))
    ((UpThere _ b _ other rest r1 n p1)
      (let-match erased q (UpThere _ _ _ _ _ r2 _ q1) (absurd (UpHere _ _ _ _) (neq-irrefl a n)))
      (let-match erased (update-fn rest a blk r1 r2 p1 q1) (Refl _ _))
      (Refl _ h1))))

(def-fns _ $ (erased alloc-fn : (erased (Heap) h) (erased (Nat) a) (erased (Block) blk) (erased (Heap) h1 h2)
    (erased (Alloc h a blk h1) p) (erased (Alloc h a blk h2) q) -> (erased (Eq (Heap) h1 h2) e))
  (let-match erased p (MkAlloc _ _ _ _))
  (let-match erased q (MkAlloc _ _ _ _))
  (Refl _ h1))

(def-fns _ $ (erased patched-fn : (erased (Heap) h) (erased (List (Word)) env) (erased (Atom) a) (erased (Nat) i) (erased (Atom) b)
    (erased (Nat) p1 p2) (erased (Block) blk1 blk2)
    (erased (Patched h env a i b p1 blk1) d1) (erased (Patched h env a i b p2 blk2) d2) ->
    (erased (Eq (Nat) p1 p2) ep) (erased (Eq (Block) blk1 blk2) eb))
  (let-match erased d1 (MkPatched _ _ _ _ _ _ w1 tag1 fs1 gs1 pa1 pb1 lk1 st1))
  (let-match erased d2 (MkPatched _ _ _ _ _ _ w2 tag2 fs2 gs2 pa2 pb2 lk2 st2))
  (let-match erased (atomval-fn env a (WAddr p1) (WAddr p2) pa1 pa2) (Refl _ _))
  (let-match erased (atomval-fn env b w1 w2 pb1 pb2) (Refl _ _))
  (let-match erased (lookup-fn h p1 (MkBlock tag1 fs1) (MkBlock tag2 fs2) lk1 lk2) (Refl _ _))
  (let-match erased (setnth-fn _ fs1 i w1 gs1 gs2 st1 st2) (Refl _ _))
  (values (Refl _ p1) (Refl _ blk1)))

(def-fns _ $ (erased prim-det : (erased (Heap) h) (erased (List (Word)) env) (erased (Instr) i) (erased (Label) l)
    (erased (Heap) h1 h2) (erased (Word) w1 w2)
    (erased (Prim h env i l h1 w1) d1) (erased (Prim h env i l h2 w2) d2) ->
    (erased (Eq (Heap) h1 h2) eh) (erased (Eq (Word) w1 w2) ew))
  (match erased d1 _
    ((PAtom _ _ a _ p)
      (let-match erased d2 (PAtom _ _ _ _ q))
      (values (Refl _ h1) (atomval-fn env a w1 w2 p q)))
    ((PCon _ _ tag args ws1 p _ pa1 al1)
      (let-match erased d2 (PCon _ _ _ _ ws2 _ _ pa2 al2))
      (let-match erased (atomvals-fn env args ws1 ws2 pa1 pa2) (Refl _ _))
      (values (alloc-fn h p (MkBlock tag ws1) h1 h2 al1 al2) (Refl _ w1)))
    ((PWrite _ _ a j b p1 blk1 _ pt1 up1)
      (let-match erased d2 (PWrite _ _ _ _ _ p2 blk2 _ pt2 up2))
      (let ((erased ep) (erased eb)) (patched-fn h env a j b p1 p2 blk1 blk2 pt1 pt2))
      (let-match erased ep (Refl _ _))
      (let-match erased eb (Refl _ _))
      (values (update-fn h p1 blk1 h1 h2 up1 up2) (Refl _ w1)))
    ((PCopy _ _ a j b p1 blk1 q _ pt1 al1)
      (let-match erased d2 (PCopy _ _ _ _ _ p2 blk2 _ _ pt2 al2))
      (let ((erased ep) (erased eb)) (patched-fn h env a j b p1 p2 blk1 blk2 pt1 pt2))
      (let-match erased eb (Refl _ _))
      (values (alloc-fn h q blk1 h1 h2 al1 al2) (Refl _ w1)))
    ((PSameYes _ _ _ _ _ _ _)
      (let-match erased d2 (PSameYes _ _ _ _ _ _ _))
      (values (Refl _ h1) (Refl _ w1)))
    ((PSameNo _ _ _ _ _ _ _ _)
      (let-match erased d2 (PSameNo _ _ _ _ _ _ _ _))
      (values (Refl _ h1) (Refl _ w1)))))

(def-fns _ $ (erased select-fn : (erased (Heap) h) (erased (Word) w) (erased (List (Code)) blocks imms) (erased (Code) body1 body2)
    (erased (List (Word)) fs1 fs2)
    (erased (Select h w blocks imms body1 fs1) d1) (erased (Select h w blocks imms body2 fs2) d2) ->
    (erased (Eq (Code) body1 body2) eb) (erased (Eq (List (Word)) fs1 fs2) ef))
  (match erased d1 _
    ((SelImm _ n _ _ _ br1)
      (let-match erased d2 (SelImm _ _ _ _ _ br2))
      (values (nth-fn _ imms n body1 body2 br1 br2) (Refl _ fs1)))
    ((SelBlock _ p _ _ _ tag1 _ lk1 br1)
      (let-match erased d2 (SelBlock _ _ _ _ _ tag2 _ lk2 br2))
      (let-match erased (lookup-fn h p (MkBlock tag1 fs1) (MkBlock tag2 fs2) lk1 lk2) (Refl _ _))
      (values (nth-fn _ blocks tag1 body1 body2 br1 br2) (Refl _ fs1)))))

(def-fns _ $ (erased run-det : (erased (List (Code)) fns) (erased (Heap) h) (erased (List (Word)) env) (erased (Code) c) (erased (Choices) ch)
    (erased (Heap) h1 h2) (erased (Word) w1 w2)
    (subterm erased (Run fns h env c ch h1 w1) d1) (erased (Run fns h env c ch h2 w2) d2) ->
    (erased (Eq (Heap) h1 h2) eh) (erased (Eq (Word) w1 w2) ew))
  (match erased d1 _
    ((RunDo _ _ _ i l _ _ p1)
      (let-match erased d2 (RunDo _ _ _ _ _ _ _ p2))
      (prim-det h env i l h1 h2 w1 w2 p1 p2))
    ((RunLet _ _ _ rhs body ch1 m1 v1 ch2 _ _ p1 q1)
      (let-match erased d2 (RunLet _ _ _ _ _ _ m2 v2 _ _ _ p2 q2))
      (let ((erased em) (erased ev)) (run-det fns h env rhs ch1 m1 m2 v1 v2 p1 p2))
      (let-match erased em (Refl _ _))
      (let-match erased ev (Refl _ _))
      (run-det fns m1 (Cons _ v1 env) body ch2 h1 h2 w1 w2 q1 q2))
    ((RunMatch _ _ _ a blocks imms v1 body1 fs1 env1 _ _ _ pa1 sel1 ct1 q1)
      (let-match erased d2 (RunMatch _ _ _ _ _ _ v2 body2 fs2 env2 _ _ _ pa2 sel2 ct2 q2))
      (let-match erased (atomval-fn env a v1 v2 pa1 pa2) (Refl _ _))
      (let ((erased eb) (erased ef)) (select-fn h v1 blocks imms body1 body2 fs1 fs2 sel1 sel2))
      (let-match erased eb (Refl _ _))
      (let-match erased ef (Refl _ _))
      (let-match erased (cat-fn fs1 env env1 env2 ct1 ct2) (Refl _ _))
      (run-det fns h env1 body1 ch h1 h2 w1 w2 q1 q2))
    ((RunCall _ _ _ f args body1 ws1 _ _ _ pf1 pa1 q1)
      (let-match erased d2 (RunCall _ _ _ _ _ body2 ws2 _ _ _ pf2 pa2 q2))
      (let-match erased (nth-fn _ fns f body1 body2 pf1 pf2) (Refl _ _))
      (let-match erased (atomvals-fn env args ws1 ws2 pa1 pa2) (Refl _ _))
      (run-det fns h ws1 body1 ch h1 h2 w1 w2 q1 q2))))

(def-fns _ $ (erased step-det : (erased (List (Code)) fns) (erased (Heap) h) (erased (Control) c) (erased (Label) l)
    (erased (Heap) h1 h2) (erased (Control) c1 c2)
    (erased (Step fns h c l h1 c1) d1) (erased (Step fns h c l h2 c2) d2) ->
    (erased (Eq (Heap) h1 h2) eh) (erased (Eq (Control) c1 c2) ec))
  (match erased d1 _
    ((StDo _ _ env i k _ _ v1 p1)
      (let-match erased d2 (StDo _ _ _ _ _ _ _ v2 p2))
      (let ((erased eh) (erased ev)) (prim-det h env i l h1 h2 v1 v2 p1 p2))
      (let-match erased ev (Refl _ _))
      (values eh (Refl _ c1)))
    ((StLet _ _ _ _ _ _)
      (let-match erased d2 (StLet _ _ _ _ _ _))
      (values (Refl _ h1) (Refl _ c1)))
    ((StRet _ _ _ _ _ _)
      (let-match erased d2 (StRet _ _ _ _ _ _))
      (values (Refl _ h1) (Refl _ c1)))
    ((StMatch _ _ env a blocks imms k v1 body1 fs1 env1 pa1 sel1 ct1)
      (let-match erased d2 (StMatch _ _ _ _ _ _ _ v2 body2 fs2 env2 pa2 sel2 ct2))
      (let-match erased (atomval-fn env a v1 v2 pa1 pa2) (Refl _ _))
      (let ((erased eb) (erased ef)) (select-fn h v1 blocks imms body1 body2 fs1 fs2 sel1 sel2))
      (let-match erased eb (Refl _ _))
      (let-match erased ef (Refl _ _))
      (let-match erased (cat-fn fs1 env env1 env2 ct1 ct2) (Refl _ _))
      (values (Refl _ h1) (Refl _ c1)))
    ((StCall _ _ env f args k body1 ws1 pf1 pa1)
      (let-match erased d2 (StCall _ _ _ _ _ _ body2 ws2 pf2 pa2))
      (let-match erased (nth-fn _ fns f body1 body2 pf1 pf2) (Refl _ _))
      (let-match erased (atomvals-fn env args ws1 ws2 pa1 pa2) (Refl _ _))
      (values (Refl _ h1) (Refl _ c1)))))

(def-fns _ $ (erased steps-det : (erased (List (Code)) fns) (erased (Heap) h) (erased (Control) c) (erased (List (Label)) ls)
    (erased (Heap) h1 h2) (erased (Control) c1 c2)
    (subterm erased (Steps fns h c ls h1 c1) d1) (erased (Steps fns h c ls h2 c2) d2) ->
    (erased (Eq (Heap) h1 h2) eh) (erased (Eq (Control) c1 c2) ec))
  (match erased d1 _
    ((StepsNil _ _ _)
      (let-match erased d2 (StepsNil _ _ _))
      (values (Refl _ h1) (Refl _ c1)))
    ((StepsCons _ _ _ l m1 k1 rest _ _ p1 q1)
      (let-match erased d2 (StepsCons _ _ _ _ m2 k2 _ _ _ p2 q2))
      (let ((erased em) (erased ek)) (step-det fns h c l m1 m2 k1 k2 p1 p2))
      (let-match erased em (Refl _ _))
      (let-match erased ek (Refl _ _))
      (steps-det fns m1 k1 rest h1 h2 c1 c2 q1 q2))))

(def-fns _ $ (erased same-yes-sound : (erased (Heap) h) (erased (List (Word)) env) (erased (Atom) a b) (erased (Heap) h2) (erased (Word) r)
    (erased (Word) wa wb) (erased (Prim h env (ISame a b) (LYes) h2 r) d)
    (erased (AtomVal env a wa) pa) (erased (AtomVal env b wb) pb) -> (erased (Eq (Word) wa wb) e))
  (let-match erased d (PSameYes _ _ _ _ w qa qb))
  (let-match erased (atomval-fn env a wa w pa qa) (Refl _ _))
  (atomval-fn env b wa wb qb pb))
