(def-fns _ $ (erased det-up-to-renaming : (erased (Ren) r) (erased (List (Code)) fns) (erased (Heap) h) (erased (List (Word)) env) (erased (Code) c)
    (erased (Choices) ch ch') (erased (Heap) h2 h2') (erased (Word) w w')
    (erased (RenH r h h) rh) (erased (RenWs r env env) re) (erased (RenCh r ch ch') rc)
    (erased (Run fns h env c ch h2 w) d) (erased (Run fns h env c ch' h2' w') d') ->
    (erased (RenH r h2 h2') rh2) (erased (RenW r w w') rw))
  (let ((erased h3) (erased w3) (erased d3) (erased rh3) (erased rw3)) (ren-run r fns h h env env c ch ch' h2 w rh re rc d))
  (let ((erased eh) (erased ew)) (run-det fns h env c ch' h3 h2' w3 w' d3 d'))
  (let-match erased eh (Refl _ _))
  (let-match erased ew (Refl _ _))
  (values rh3 rw3))

(let ((erased lt37)) (prove-literal-lt 3 7))
(let ((erased lt12)) (prove-literal-lt 100 200))
