(let ((erased prog)) (CLet (CDo (ICon 0 (Nil (Atom)))) (CDo (ICon 0 args))))
(let ((erased b0)) (MkBlock 0 (Nil (Word))))
(let ((erased h1)) (HCons 7 b0 (HNil)))
(let ((erased env2)) (Cons (Word) (WAddr 7) (Nil (Word))))
(let ((erased h2)) (HCons 3 (MkBlock 0 env2) h1))
(let ((erased (Run (Nil (Code)) (HNil) (Nil (Word)) prog (ChSeq (ChOne (LAddr 7)) (ChOne (LAddr 3))) h2 (WAddr 3)) d))
  (RunLet (Nil _) (HNil) (Nil _) (CDo (ICon 0 (Nil _))) (CDo (ICon 0 args)) (ChOne (LAddr 7)) h1 (WAddr 7) (ChOne (LAddr 3)) h2 (WAddr 3)
    (RunDo (Nil _) (HNil) (Nil _) (ICon 0 (Nil _)) (LAddr 7) h1 (WAddr 7)
      (PCon (HNil) (Nil _) 0 (Nil _) (Nil _) 7 h1 (AVsNil (Nil _)) (MkAlloc (HNil) 7 b0 (FreshNil 7))))
    (RunDo (Nil _) h1 env2 (ICon 0 args) (LAddr 3) h2 (WAddr 3)
      (PCon h1 env2 0 args env2 3 h2
        (AVsCons env2 (AVar (Zero)) (WAddr 7) (Nil _) (Nil _) (AVVar env2 (Zero) (WAddr 7) (NthHere _ (WAddr 7) (Nil _))) (AVsNil env2))
        (MkAlloc h1 3 (MkBlock 0 env2) (FreshCons 3 7 b0 (HNil) (NeqLt 3 7 lt37) (FreshNil 3)))))))
(let ((erased h2') (erased w')
      (erased (Run (Nil (Code)) (HNil) (Nil (Word)) prog (ChSeq (ChOne (LAddr 100)) (ChOne (LAddr 200))) h2' w') renamed-run)
      (erased (RenH r h2 h2') rh2) (erased (RenW r (WAddr 3) w') rw))
  (ren-run r (Nil _) (HNil) (HNil) (Nil _) (Nil _) prog
    (ChSeq (ChOne (LAddr 7)) (ChOne (LAddr 3))) (ChSeq (ChOne (LAddr 100)) (ChOne (LAddr 200))) h2 (WAddr 3)
    (RenHNil r) (RenWsNil r)
    (RenChSeq r (ChOne (LAddr 7)) (ChOne (LAddr 100)) (ChOne (LAddr 3)) (ChOne (LAddr 200))
      (RenChOne r (LAddr 7) (LAddr 100) (RenLAddr r 7 100 r7))
      (RenChOne r (LAddr 3) (LAddr 200) (RenLAddr r 3 200 r3)))
