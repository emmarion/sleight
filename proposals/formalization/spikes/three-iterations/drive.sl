(def-lvl drive-lvl)
(def-lvl program-lvl)
(let ((many zero-fits)) (lt-dec 0 u8-modulus))
(comptime-match many zero-fits (Yes _ _ _ _ zero-below))
(let ((many one-fits)) (lt-dec 1 u8-modulus))
(comptime-match many one-fits (Yes _ _ _ _ one-below))
(let ((many exit-accepted)) (MkU8 0 zero-below))
(let ((many exit-rejected)) (MkU8 1 one-below))
(let ((many quantum)) (Succ $ Succ $ Succ $ Zero))

(def-fns drive-lvl $ (many drive : (erased (List (Tok)) src) (many (Scan src) s) (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program program-lvl) p))
  (match many (run-counted quantum src s) (((World) w2 at w) ((Program program-lvl) p))
    ((Finished _ v)
      (match many v _
        ((Accepted _ _ _) (values w (Exit program-lvl exit-accepted)))
        ((Rejected _ _ _) (values w (Exit program-lvl exit-rejected)))))
    ((Paused _ next)
      (def-unique program-lvl $ (unique again : (unique (World) v at vacant-slot) -> (unique (World) v2 at v) (unique (Program program-lvl) p)) (drive src next v))
      (values w (Continue program-lvl again)))))
