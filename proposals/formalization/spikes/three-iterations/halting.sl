(def-fns _ $ (erased halts-all : (erased (List (Tok)) src) (erased (Nat) d) (subterm erased (List (Tok)) rest) (erased (Resumes src d rest) inv) -> (erased (Halts src (MkScan src d rest inv)) h))
  (let-match erased rest (Cons _ t more)
    ((Nil _)
      (match erased d _
        ((Zero)
          (let ((erased acc)) (resume-accepts src d rest inv (AccEnd)))
          (HaltDone src (MkScan src d rest inv) (Accepted (Zero) src acc) (StAccept src inv acc)))
        ((Succ k)
          (let ((erased bad)) (resume-fails src d rest inv (FailUnclosed k)))
          (HaltDone src (MkScan src d rest inv) (Rejected (Zero) src bad) (StUnclosed src k inv bad))))))
  (let-match erased t (Close)
    ((Open)
      (HaltMore src (MkScan src d rest inv) (MkScan src (Succ d) more (ResOpen src d more inv)) (StOpen src d more inv)
        (halts-all src (Succ d) more (ResOpen src d more inv)))))
  (let-match erased d (Succ k)
    ((Zero)
      (let ((erased bad)) (resume-fails src d rest inv (FailExtraClose more)))
      (HaltDone src (MkScan src d rest inv) (Rejected (Zero) src bad) (StExtraClose src more inv bad))))
  (HaltMore src (MkScan src d rest inv) (MkScan src k more (ResClose src k more inv)) (StClose src k more inv)
    (halts-all src k more (ResClose src k more inv))))

(def-fns _ $ (many decide-by : (many (List (Tok)) src) -> (many (Verdict (Zero) src) v))
  (run-by src (MkScan src (Zero) src (ResStart src)) (halts-all src (Zero) src (ResStart src))))
