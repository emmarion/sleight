(let ((many d0)) (lt-dec 0 u8-modulus))
(comptime-match many d0 (Yes _ _ za zb zp))
(let ((many code0)) (MkU8 0 zp))

(def-adts $ (WBox : -> Type)
  enum newtype
  (many MkWBox : (erased (World) w) (unique (Placed vacant-slot (World) w) p) -> (WBox)))

(def-fns _ $ (many say : (unique (World) w at vacant-slot) (many (String) s) -> (unique (WBox) b))
  (let ((unique w1) (many _)) (world-do _ w (WriteOut s)))
  (MkWBox _ (place-at _ w1)))

(def-fns _ $ (many deep : (subterm many (Nat) n) -> (many (Nat) r))
  (let-match many n (Succ m) ((Zero) 0))
  (Succ (notail $ deep m)))
(def-adts $ (MBox : -> Type) enum (many MkMBox : (unique (WBox) b) (many (Nat) words) -> (MBox)))
(def-fns _ $ (many measure : (unique (World) w at vacant-slot) -> (unique (MBox) r))
  (let ((unique w1) (many u)) (world-do _ w (Measure (Stop))))
  (let-match many u (MkUsage _ _ _ minor _ _ _ _))
  (MkMBox (MkWBox _ (place-at _ w1)) minor))
(def-fns _ $ (many build : (subterm many (Nat) n) (many (List (Nat)) acc) -> (many (List (Nat)) r))
  (let-match many n (Succ m) ((Zero) acc))
  (tail $ build m (Cons _ n acc)))
(def-fns _ $ (many id-list : (many (List (Nat)) xs) -> (many (List (Nat)) r)) xs)
(def-fns _ $ (many verdict : (many (Nat) words) -> (many (String) s))
  (match many (lt-dec words 300000) _
    ((Yes _ _ _ _ _) "measured BEFORE the build\n")
    ((No _ _ _ _ _) "measured AFTER the build\n")))

(def-lvl P)
(def-unique P $ (unique start : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program P) p))
  (let ((many _xs) (unique mb)) (values (build 200000 (Nil _)) (measure w)))
  (let-match unique mb (MkMBox b words))
  (let-match unique b (MkWBox _ pw))
  (let ((unique w1)) (unplace-at _ _ _ pw))
  (let-match erased (placed-slot _ _ _ pw) (Refl _ _))
  (let ((unique w3) (many _)) (world-do _ w1 (WriteOut (verdict words))))
  (values w3 (Exit P code0)))
(Continue P start)
