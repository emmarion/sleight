(def-adts
  ((EvalD : ((Nat) n) ((Env) env) ((Core) c) ((List (Val)) vs) -> Type)
    enum
    (many DVar : (erased (Nat) f) (erased (Env) env) (erased (Nat) x) (erased (Val) v) (erased (EnvOf env x v) p) -> (EvalD (Succ f) env (CVar x) (Cons (Val) v (Nil (Val)))))
    (many DApp : (erased (Nat) f) (erased (Env) env) (erased (Core) h) (erased (List (Core)) args) (erased (Nat) c) (erased (List (Val)) vals)
       (erased (EvalD f env h (Cons (Val) (VAtom c) (Nil (Val)))) p) (erased (EvalListD f env args vals) q) -> (EvalD (Succ f) env (CApp h args) (Cons (Val) (VCon c vals) (Nil (Val)))))
    (many DCall : (erased (Nat) f) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args) (erased (Env) cenv) (erased (List (FnDef)) group) (erased (Nat) id) (erased (List (Nat)) ps) (erased (Core) body)
       (erased (List (Val)) vals) (erased (Env) env1) (erased (Env) env2) (erased (List (Val)) outs)
       (erased (EvalD f env fn (Cons (Val) (VClo cenv group (MkFnDef id ps body)) (Nil (Val)))) p) (erased (EvalListD f env args vals) q)
       (erased (BindGroup cenv group group cenv env1) g) (erased (BindAll env1 ps vals env2) b) (erased (EvalD f env2 body outs) r) -> (EvalD (Succ f) env (CCall fn args) outs))
    (many DMatch : (erased (Nat) f) (erased (Env) env) (erased (Core) s) (erased (List (Branch)) bs) (erased (Nat) c) (erased (List (Val)) fields) (erased (List (Nat)) ids) (erased (Core) body)
       (erased (Env) env1) (erased (List (Val)) outs)
       (erased (EvalD f env s (Cons (Val) (VCon c fields) (Nil (Val)))) p) (erased (BranchOf bs c ids body) br) (erased (BindAll env ids fields env1) b) (erased (EvalD f env1 body outs) r)
       -> (EvalD (Succ f) env (CMatch s bs) outs))
    (many DValues : (erased (Nat) f) (erased (Env) env) (erased (List (Core)) items) (erased (List (Val)) vals) (erased (EvalListD f env items vals) q) -> (EvalD (Succ f) env (CValues items) vals))
    (many DFormer : (erased (Nat) f) (erased (Env) env) (erased (Term) t) -> (EvalD (Succ f) env (CFormer t) (Cons (Val) (VFormer t env) (Nil (Val)))))
    (many DToken : (erased (Nat) f) (erased (Env) env) -> (EvalD (Succ f) env (CToken) (Cons (Val) (VToken) (Nil (Val)))))
    (many DStmt : (erased (Nat) f) (erased (Env) env) (erased (Stmt) s) (erased (Core) rest) (erased (Env) env1) (erased (List (Val)) outs)
       (erased (EvalStmtD f env s env1) p) (erased (EvalD f env1 rest outs) q) -> (EvalD (Succ f) env (CStmt s rest) outs)))
  ((EvalListD : ((Nat) n) ((Env) env) ((List (Core)) cs) ((List (Val)) vs) -> Type)
    enum
    (many DLNil : (erased (Nat) f) (erased (Env) env) -> (EvalListD (Succ f) env (Nil (Core)) (Nil (Val))))
    (many DLCons : (erased (Nat) f) (erased (Env) env) (erased (Core) c) (erased (Val) v) (erased (List (Core)) cs) (erased (List (Val)) vs)
       (erased (EvalD f env c (Cons (Val) v (Nil (Val)))) p) (erased (EvalListD f env cs vs) q) -> (EvalListD (Succ f) env (Cons (Core) c cs) (Cons (Val) v vs))))
  ((EvalStmtD : ((Nat) n) ((Env) env) ((Stmt) s) ((Env) out) -> Type)
    enum
    (many DLet : (erased (Nat) f) (erased (Env) env) (erased (List (Nat)) ids) (erased (Core) rhs) (erased (List (Val)) vals) (erased (Env) out)
       (erased (EvalD f env rhs vals) p) (erased (BindAll env ids vals out) b) -> (EvalStmtD (Succ f) env (SLet ids rhs) out))
    (many DDefLvl : (erased (Nat) f) (erased (Env) env) (erased (Nat) x) -> (EvalStmtD (Succ f) env (SDefLvl x) (ECons x (VToken) env)))
    (many DDefFns : (erased (Nat) f) (erased (Env) env) (erased (List (FnDef)) defs) (erased (Env) out) (erased (BindGroup env defs defs env out) g) -> (EvalStmtD (Succ f) env (SDefFns defs) out))
    (many DDefAdts : (erased (Nat) f) (erased (Env) env) (erased (List (Nat)) ids) (erased (Env) out) (erased (BindAtoms env ids out) b) -> (EvalStmtD (Succ f) env (SDefAdts ids) out))))

(def-adts
  ((FailEv : ((Nat) n) ((Env) env) ((Core) c) ((Why) w) -> Type)
    enum
    (many FVarMiss : (erased (Nat) f) (erased (Env) env) (erased (Nat) x) (erased (NoEnv env x) p) -> (FailEv (Succ f) env (CVar x) (Stuck)))
    (many FAppShape : (erased (Nat) f) (erased (Env) env) (erased (Core) h) (erased (List (Core)) args) (erased (List (Val)) hv)
       (erased (EvalD f env h hv) p) (erased (BadShape hv (Succ (Zero))) s) -> (FailEv (Succ f) env (CApp h args) (Stuck)))
    (many FCallShape : (erased (Nat) f) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args) (erased (List (Val)) fv)
       (erased (EvalD f env fn fv) p) (erased (BadShape fv (Succ (Succ (Succ (Zero))))) s) -> (FailEv (Succ f) env (CCall fn args) (Stuck)))
    (many FCallBind : (erased (Nat) f) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args) (erased (Env) cenv) (erased (List (FnDef)) group) (erased (Nat) id) (erased (List (Nat)) ps) (erased (Core) body)
       (erased (List (Val)) vals) (erased (Env) env1)
       (erased (EvalD f env fn (Cons (Val) (VClo cenv group (MkFnDef id ps body)) (Nil (Val)))) p) (erased (EvalListD f env args vals) q)
       (erased (BindGroup cenv group group cenv env1) g) (erased (NoBind env1 ps vals) nb) -> (FailEv (Succ f) env (CCall fn args) (Stuck)))
    (many FMatchShape : (erased (Nat) f) (erased (Env) env) (erased (Core) s) (erased (List (Branch)) bs) (erased (List (Val)) sv)
       (erased (EvalD f env s sv) p) (erased (BadShape sv (Zero)) sh) -> (FailEv (Succ f) env (CMatch s bs) (Stuck)))
    (many FMatchMiss : (erased (Nat) f) (erased (Env) env) (erased (Core) s) (erased (List (Branch)) bs) (erased (Nat) c) (erased (List (Val)) fields)
       (erased (EvalD f env s (Cons (Val) (VCon c fields) (Nil (Val)))) p) (erased (NoBranch bs c) nbr) -> (FailEv (Succ f) env (CMatch s bs) (Stuck)))
    (many FMatchBind : (erased (Nat) f) (erased (Env) env) (erased (Core) s) (erased (List (Branch)) bs) (erased (Nat) c) (erased (List (Val)) fields) (erased (List (Nat)) ids) (erased (Core) body)
       (erased (EvalD f env s (Cons (Val) (VCon c fields) (Nil (Val)))) p) (erased (BranchOf bs c ids body) br) (erased (NoBind env ids fields) nb) -> (FailEv (Succ f) env (CMatch s bs) (Stuck)))
    (many FZero : (erased (Env) env) (erased (Core) c) -> (FailEv (Zero) env c (OutOfFuel)))
    (many FAppHead : (erased (Nat) f) (erased (Env) env) (erased (Core) h) (erased (List (Core)) args) (erased (Why) w) (erased (FailEv f env h w) e) -> (FailEv (Succ f) env (CApp h args) w))
    (many FAppArgs : (erased (Nat) f) (erased (Env) env) (erased (Core) h) (erased (List (Core)) args) (erased (Why) w) (erased (FailListEv f env args w) e) -> (FailEv (Succ f) env (CApp h args) w))
    (many FCallFn : (erased (Nat) f) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args) (erased (Why) w) (erased (FailEv f env fn w) e) -> (FailEv (Succ f) env (CCall fn args) w))
    (many FCallArgs : (erased (Nat) f) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args) (erased (Why) w) (erased (FailListEv f env args w) e) -> (FailEv (Succ f) env (CCall fn args) w))
    (many FCallBody : (erased (Nat) f) (erased (Env) env) (erased (Core) fn) (erased (List (Core)) args) (erased (Env) cenv) (erased (List (FnDef)) group) (erased (Nat) id) (erased (List (Nat)) ps) (erased (Core) body)
       (erased (List (Val)) vals) (erased (Env) env1) (erased (Env) env2) (erased (Why) w)
       (erased (EvalD f env fn (Cons (Val) (VClo cenv group (MkFnDef id ps body)) (Nil (Val)))) p) (erased (EvalListD f env args vals) q)
       (erased (BindGroup cenv group group cenv env1) g) (erased (BindAll env1 ps vals env2) b) (erased (FailEv f env2 body w) e) -> (FailEv (Succ f) env (CCall fn args) w))
    (many FMatchScrut : (erased (Nat) f) (erased (Env) env) (erased (Core) s) (erased (List (Branch)) bs) (erased (Why) w) (erased (FailEv f env s w) e) -> (FailEv (Succ f) env (CMatch s bs) w))
    (many FMatchBody : (erased (Nat) f) (erased (Env) env) (erased (Core) s) (erased (List (Branch)) bs) (erased (Nat) c) (erased (List (Val)) fields) (erased (List (Nat)) ids) (erased (Core) body)
       (erased (Env) env1) (erased (Why) w)
       (erased (EvalD f env s (Cons (Val) (VCon c fields) (Nil (Val)))) p) (erased (BranchOf bs c ids body) br) (erased (BindAll env ids fields env1) b) (erased (FailEv f env1 body w) e)
       -> (FailEv (Succ f) env (CMatch s bs) w))
    (many FValues : (erased (Nat) f) (erased (Env) env) (erased (List (Core)) items) (erased (Why) w) (erased (FailListEv f env items w) e) -> (FailEv (Succ f) env (CValues items) w))
    (many FStmtStmt : (erased (Nat) f) (erased (Env) env) (erased (Stmt) s) (erased (Core) rest) (erased (Why) w) (erased (FailStmtEv f env s w) e) -> (FailEv (Succ f) env (CStmt s rest) w))
    (many FStmtRest : (erased (Nat) f) (erased (Env) env) (erased (Stmt) s) (erased (Core) rest) (erased (Env) env1) (erased (Why) w)
       (erased (EvalStmtD f env s env1) p) (erased (FailEv f env1 rest w) e) -> (FailEv (Succ f) env (CStmt s rest) w)))
  ((FailListEv : ((Nat) n) ((Env) env) ((List (Core)) cs) ((Why) w) -> Type)
    enum
    (many FLOne : (erased (Nat) f) (erased (Env) env) (erased (Core) c) (erased (List (Core)) cs) (erased (List (Val)) vs)
       (erased (EvalD f env c vs) p) (erased (NotSingle vs) ns) -> (FailListEv (Succ f) env (Cons (Core) c cs) (Stuck)))
    (many FLZero : (erased (Env) env) (erased (List (Core)) cs) -> (FailListEv (Zero) env cs (OutOfFuel)))
    (many FLHead : (erased (Nat) f) (erased (Env) env) (erased (Core) c) (erased (List (Core)) cs) (erased (Why) w) (erased (FailEv f env c w) e) -> (FailListEv (Succ f) env (Cons (Core) c cs) w))
    (many FLTail : (erased (Nat) f) (erased (Env) env) (erased (Core) c) (erased (List (Core)) cs) (erased (Why) w) (erased (FailListEv f env cs w) e) -> (FailListEv (Succ f) env (Cons (Core) c cs) w)))
  ((FailStmtEv : ((Nat) n) ((Env) env) ((Stmt) s) ((Why) w) -> Type)
    enum
    (many FSLetBind : (erased (Nat) f) (erased (Env) env) (erased (List (Nat)) ids) (erased (Core) rhs) (erased (List (Val)) vals)
       (erased (EvalD f env rhs vals) p) (erased (NoBind env ids vals) nb) -> (FailStmtEv (Succ f) env (SLet ids rhs) (Stuck)))
    (many FSZero : (erased (Env) env) (erased (Stmt) s) -> (FailStmtEv (Zero) env s (OutOfFuel)))
    (many FSLetRhs : (erased (Nat) f) (erased (Env) env) (erased (List (Nat)) ids) (erased (Core) rhs) (erased (Why) w) (erased (FailEv f env rhs w) e) -> (FailStmtEv (Succ f) env (SLet ids rhs) w))))

(def-adts
  ((Ran : ((Nat) n) ((Env) env) ((Core) c) -> Type)
    enum
    (many Done : (erased (Nat) n) (erased (Env) env) (erased (Core) c) (many (List (Val)) vs) (erased (EvalD n env c vs) p) -> (Ran n env c))
    (many Failed : (erased (Nat) n) (erased (Env) env) (erased (Core) c) (many (Why) w) (erased (FailEv n env c w) e) -> (Ran n env c)))
  ((RanList : ((Nat) n) ((Env) env) ((List (Core)) cs) -> Type)
    enum
    (many DoneList : (erased (Nat) n) (erased (Env) env) (erased (List (Core)) cs) (many (List (Val)) vs) (erased (EvalListD n env cs vs) p) -> (RanList n env cs))
    (many FailedList : (erased (Nat) n) (erased (Env) env) (erased (List (Core)) cs) (many (Why) w) (erased (FailListEv n env cs w) e) -> (RanList n env cs)))
  ((RanStmt : ((Nat) n) ((Env) env) ((Stmt) s) -> Type)
    enum
    (many DoneStmt : (erased (Nat) n) (erased (Env) env) (erased (Stmt) s) (many (Env) out) (erased (EvalStmtD n env s out) p) -> (RanStmt n env s))
    (many FailedStmt : (erased (Nat) n) (erased (Env) env) (erased (Stmt) s) (many (Why) w) (erased (FailStmtEv n env s w) e) -> (RanStmt n env s))))

(def-fns _
  ((many run : (subterm many (Nat) fuel) (many (Env) env) (many (Core) c) -> (many (Ran fuel env c) r))
    (let-match many fuel (Succ f) ((Zero) (Failed _ _ _ (OutOfFuel) $ FZero env c)))
    (match many c _
      ((CVar x)
        (match many (env-dec2 env x) _
          ((EnvMiss2 _ _ ne) (Failed _ _ _ (Stuck) $ FVarMiss f env x ne))
          ((EnvHit2 _ _ v p) (Done _ _ _ (Cons _ v (Nil _)) $ DVar f env x v p))))
      ((CApp h args)
        (let-match many (notail $ run f env h) (Done _ _ _ hv p) ((Failed _ _ _ w e) (Failed _ _ _ w $ FAppHead f env h args w e)))
        (let-match many (shape-dec hv kind-atom) (ShapeOk _ v ko) ((ShapeBad _ _ sh) (Failed _ _ _ (Stuck) $ FAppShape f env h args hv p sh)))
        (let-match erased ko (KOAtom _))
        (let-match many v (VAtom ctor))
        (match many (notail $ run-list f env args) _
          ((FailedList _ _ _ w e) (Failed _ _ _ w $ FAppArgs f env h args w e))
          ((DoneList _ _ _ vals q) (Done _ _ _ (Cons _ (VCon ctor vals) (Nil _)) $ DApp f env h args ctor vals p q))))
      ((CCall fn args)
        (let-match many (notail $ run f env fn) (Done _ _ _ fv p) ((Failed _ _ _ w e) (Failed _ _ _ w $ FCallFn f env fn args w e)))
        (let-match many (shape-dec fv kind-clo) (ShapeOk _ v ko) ((ShapeBad _ _ sh) (Failed _ _ _ (Stuck) $ FCallShape f env fn args fv p sh)))
        (let-match erased ko (KOClo _ _ _))
        (let-match many v (VClo cenv group def))
        (let-match many def (MkFnDef id ps body))
        (let-match many (notail $ run-list f env args) (DoneList _ _ _ vals q) ((FailedList _ _ _ w e) (Failed _ _ _ w $ FCallArgs f env fn args w e)))
        (let ((many env1) (erased g)) (bind-group cenv group group cenv))
        (let-match many (bind-all2 env1 ps vals) (BDOk2 _ _ _ env2 bd) ((BDNo _ _ _ nb) (Failed _ _ _ (Stuck) $ FCallBind f env fn args cenv group id ps body vals env1 p q g nb)))
        (match many (notail $ run f env2 body) _
          ((Failed _ _ _ w e) (Failed _ _ _ w $ FCallBody f env fn args cenv group id ps body vals env1 env2 w p q g bd e))
          ((Done _ _ _ outs r) (Done _ _ _ outs $ DCall f env fn args cenv group id ps body vals env1 env2 outs p q g bd r))))
      ((CMatch s bs)
        (let-match many (notail $ run f env s) (Done _ _ _ sv p) ((Failed _ _ _ w e) (Failed _ _ _ w $ FMatchScrut f env s bs w e)))
        (let-match many (shape-dec sv kind-con) (ShapeOk _ v ko) ((ShapeBad _ _ sh) (Failed _ _ _ (Stuck) $ FMatchShape f env s bs sv p sh)))
        (let-match erased ko (KOCon _ _))
        (let-match many v (VCon ctor fields))
        (let-match many (branch-dec2 bs ctor) (BrHit2 _ _ ids body br) ((BrNo _ _ nbr) (Failed _ _ _ (Stuck) $ FMatchMiss f env s bs ctor fields p nbr)))
        (let-match many (bind-all2 env ids fields) (BDOk2 _ _ _ env1 bd) ((BDNo _ _ _ nb) (Failed _ _ _ (Stuck) $ FMatchBind f env s bs ctor fields ids body p br nb)))
        (match many (notail $ run f env1 body) _
          ((Failed _ _ _ w e) (Failed _ _ _ w $ FMatchBody f env s bs ctor fields ids body env1 w p br bd e))
          ((Done _ _ _ outs r) (Done _ _ _ outs $ DMatch f env s bs ctor fields ids body env1 outs p br bd r))))
      ((CValues items)
        (match many (notail $ run-list f env items) _
          ((FailedList _ _ _ w e) (Failed _ _ _ w $ FValues f env items w e))
          ((DoneList _ _ _ vals q) (Done _ _ _ vals $ DValues f env items vals q))))
      ((CFormer t) (Done _ _ _ (Cons _ (VFormer t env) (Nil _)) $ DFormer f env t))
      ((CToken) (Done _ _ _ (Cons _ (VToken) (Nil _)) $ DToken f env))
      ((CStmt s rest)
        (let-match many (notail $ run-stmt f env s) (DoneStmt _ _ _ env1 p) ((FailedStmt _ _ _ w e) (Failed _ _ _ w $ FStmtStmt f env s rest w e)))
        (match many (notail $ run f env1 rest) _
          ((Failed _ _ _ w e) (Failed _ _ _ w $ FStmtRest f env s rest env1 w p e))
          ((Done _ _ _ outs q) (Done _ _ _ outs $ DStmt f env s rest env1 outs p q))))))
  ((many run-list : (subterm many (Nat) fuel) (many (Env) env) (many (List (Core)) cs) -> (many (RanList fuel env cs) r))
    (let-match many fuel (Succ f) ((Zero) (FailedList _ _ _ (OutOfFuel) $ FLZero env cs)))
    (let-match many cs (Cons _ c rest) ((Nil _) (DoneList _ _ _ (Nil _) $ DLNil f env)))
    (let-match many (notail $ run f env c) (Done _ _ _ vs p) ((Failed _ _ _ w e) (FailedList _ _ _ w $ FLHead f env c rest w e)))
    (let-match many (single-dec vs) (IsSingle v) ((NotOne _ ns) (FailedList _ _ _ (Stuck) $ FLOne f env c rest vs p ns)))
    (match many (notail $ run-list f env rest) _
      ((FailedList _ _ _ w e) (FailedList _ _ _ w $ FLTail f env c rest w e))
      ((DoneList _ _ _ vals q) (DoneList _ _ _ (Cons _ v vals) $ DLCons f env c v rest vals p q))))
  ((many run-stmt : (subterm many (Nat) fuel) (many (Env) env) (many (Stmt) s) -> (many (RanStmt fuel env s) r))
    (let-match many fuel (Succ f) ((Zero) (FailedStmt _ _ _ (OutOfFuel) $ FSZero env s)))
    (match many s _
      ((SLet ids rhs)
        (let-match many (notail $ run f env rhs) (Done _ _ _ vals p) ((Failed _ _ _ w e) (FailedStmt _ _ _ w $ FSLetRhs f env ids rhs w e)))
        (match many (bind-all2 env ids vals) _
          ((BDNo _ _ _ nb) (FailedStmt _ _ _ (Stuck) $ FSLetBind f env ids rhs vals p nb))
          ((BDOk2 _ _ _ out bd) (DoneStmt _ _ _ out $ DLet f env ids rhs vals out p bd))))
      ((SDefLvl x) (DoneStmt _ _ _ (ECons x (VToken) env) $ DDefLvl f env x))
      ((SDefFns defs)
        (let ((many out) (erased g)) (bind-group env defs defs env))
        (DoneStmt _ _ _ out $ DDefFns f env defs out g))
      ((SDefAdts ids)
        (let ((many out) (erased b)) (bind-atoms env ids))
        (DoneStmt _ _ _ out $ DDefAdts f env ids out b)))))

(MkUnit)
