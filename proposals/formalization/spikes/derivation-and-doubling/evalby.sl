(def-fns _ $ (many env-by : (many (Env) env) (many (Nat) x) (erased (Val) v) (subterm erased (EnvOf env x v) p) -> (many v is r))
  (let-match many env (ECons y w rest) (absurd (ENil) p))
  (match many (nat-dec x y) _
    ((NDSame _) (match erased p _ ((EnvHere _ _ _) w) (absurd (EnvThere _ _ _ _ _ n _) (neq-irrefl x n))))
    ((NDDiff _ _ n) (match erased p _ (absurd (EnvHere _ _ _) (neq-irrefl x n)) ((EnvThere _ _ _ _ _ _ p2) (tail $ env-by rest x v p2))))))

(def-fns _ $ (many bind-all-by : (many (Env) env) (many (List (Nat)) ids) (many (List (Val)) vs) (erased (Env) out) (subterm erased (BindAll env ids vs out) p) -> (many out is r))
  (let-match many ids (Cons _ x rest) ((Nil _) (let-match erased p (BANil _)) env))
  (let-match many vs (Cons _ v vrest) (absurd (Nil _) p))
  (let-match erased p (BACons _ _ _ _ _ _ p2))
  (tail $ bind-all-by (ECons x v env) rest vrest out p2))

(def-fns _ $ (many bind-group-by : (many (Env) cenv) (many (List (FnDef)) group) (many (List (FnDef)) defs) (many (Env) env) (erased (Env) out) (subterm erased (BindGroup cenv group defs env out) p) -> (many out is r))
  (let-match many defs (Cons _ def rest) ((Nil _) (let-match erased p (BGNil _ _ _)) env))
  (let-match many def (MkFnDef id _ _))
  (let-match erased p (BGCons _ _ _ _ _ _ _ _ p2))
  (tail $ bind-group-by cenv group rest (ECons id (VClo cenv group def) env) out p2))

(def-fns _ $ (many bind-atoms-by : (many (Env) env) (many (List (Nat)) ids) (erased (Env) out) (subterm erased (BindAtoms env ids out) p) -> (many out is r))
  (let-match many ids (Cons _ x rest) ((Nil _) (let-match erased p (BTNil _)) env))
  (let-match erased p (BTCons _ _ _ _ p2))
  (tail $ bind-atoms-by (ECons x (VAtom x) env) rest out p2))

(def-fns _ $ (many branch-by : (many (List (Branch)) bs) (many (Nat) c) (erased (List (Nat)) fields) (erased (Core) body) (subterm erased (BranchOf bs c fields body) p) -> (many fields is fs) (many body is b))
  (let-match many bs (Cons _ br rest) (absurd (Nil _) p))
  (let-match many br (MkBranch d fields2 body2))
  (match many (nat-dec c d) _
    ((NDSame _) (match erased p _ ((BrHere _ _ _ _) (values fields2 body2)) (absurd (BrThere _ _ _ _ _ _ _ n _) (neq-irrefl c n))))
    ((NDDiff _ _ n) (match erased p _ (absurd (BrHere _ _ _ _) (neq-irrefl c n)) ((BrThere _ _ _ _ _ _ _ _ p2) (tail $ branch-by rest c fields body p2))))))

(def-fns _
  ((many eval-by : (many (Env) env) (many (Core) c) (erased (List (Val)) vs) (subterm erased (Eval env c vs) d) -> (many vs is r))
    (match many c _
      ((CVar x)
        (let-match erased d (EvVar _ _ v p))
        (Cons _ (env-by env x v p) (Nil _)))
      ((CApp h args)
        (let-match erased d (EvApp _ _ _ ctor vals p q))
        (let-match many (notail $ eval-by env h (Cons _ (VAtom ctor) (Nil _)) p) (Cons _ hv _))
        (let-match many hv (VAtom ctor2))
        (Cons _ (VCon ctor2 (notail $ eval-list-by env args vals q)) (Nil _)))
      ((CCall fn args)
        (let-match erased d (EvCall _ _ _ cenv group id ps body vals env1 env2 outs p q g b r))
        (let-match many (notail $ eval-by env fn (Cons _ (VClo cenv group (MkFnDef id ps body)) (Nil _)) p) (Cons _ fv _))
        (let-match many fv (VClo cenv2 group2 def))
        (let-match many def (MkFnDef _ ps2 body2))
        (let ((many vals2)) (notail $ eval-list-by env args vals q))
        (let ((many e1)) (bind-group-by cenv2 group2 group2 cenv2 env1 g))
        (let ((many e2)) (bind-all-by e1 ps2 vals2 env2 b))
        (tail $ eval-by e2 body2 outs r))
      ((CMatch s bs)
        (let-match erased d (EvMatch _ _ _ ctor fields ids body env1 outs p br b r))
        (let-match many (notail $ eval-by env s (Cons _ (VCon ctor fields) (Nil _)) p) (Cons _ sv _))
        (let-match many sv (VCon ctor2 fields2))
        (let ((many ids2) (many body2)) (branch-by bs ctor2 ids body br))
        (let ((many e1)) (bind-all-by env ids2 fields2 env1 b))
        (tail $ eval-by e1 body2 outs r))
      ((CValues items)
        (let-match erased d (EvValues _ _ vals q))
        (tail $ eval-list-by env items vals q))
      ((CFormer t) (let-match erased d (EvFormer _ _)) (Cons _ (VFormer t env) (Nil _)))
      ((CToken) (let-match erased d (EvToken _)) (Cons _ (VToken) (Nil _)))
      ((CStmt s rest)
        (let-match erased d (EvStmt _ _ _ env1 outs p q))
        (tail $ eval-by (notail $ eval-stmt-by env s env1 p) rest outs q))))
  ((many eval-list-by : (many (Env) env) (many (List (Core)) cs) (erased (List (Val)) vs) (subterm erased (EvalList env cs vs) d) -> (many vs is r))
    (let-match many cs (Cons _ c rest) ((Nil _) (let-match erased d (EvLNil _)) (Nil _)))
    (let-match erased d (EvLCons _ _ v _ vs2 p q))
    (let-match many (notail $ eval-by env c (Cons _ v (Nil _)) p) (Cons _ v2 _))
    (Cons _ v2 (notail $ eval-list-by env rest vs2 q)))
  ((many eval-stmt-by : (many (Env) env) (many (Stmt) s) (erased (Env) out) (subterm erased (EvalStmt env s out) d) -> (many out is r))
    (match many s _
      ((SLet ids rhs)
        (let-match erased d (EvLet _ _ _ vals _ p b))
        (tail $ bind-all-by env ids (notail $ eval-by env rhs vals p) out b))
      ((SDefLvl x) (let-match erased d (EvDefLvl _ _)) (ECons x (VToken) env))
      ((SDefFns defs) (let-match erased d (EvDefFns _ _ _ g)) (tail $ bind-group-by env defs defs env out g))
      ((SDefAdts ids) (let-match erased d (EvDefAdts _ _ _ b)) (tail $ bind-atoms-by env ids out b)))))

(MkUnit)
