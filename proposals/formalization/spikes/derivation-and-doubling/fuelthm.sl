(def-fns _
  ((erased evald-forget : (erased (Nat) n) (erased (Env) env) (erased (Core) c) (erased (List (Val)) vs) (subterm erased (EvalD n env c vs) d) -> (erased (Eval env c vs) p))
    (match erased d _
      ((DVar _ _ x v p) (EvVar env x v p))
      ((DApp f _ h args ctor vals p q) (EvApp env h args ctor vals (evald-forget f env h _ p) (evallistd-forget f env args vals q)))
      ((DCall f _ fn args cenv group id ps body vals env1 env2 outs p q g b r)
        (EvCall env fn args cenv group id ps body vals env1 env2 outs (evald-forget f env fn _ p) (evallistd-forget f env args vals q) g b (evald-forget f env2 body outs r)))
      ((DMatch f _ s bs ctor fields ids body env1 outs p br b r)
        (EvMatch env s bs ctor fields ids body env1 outs (evald-forget f env s _ p) br b (evald-forget f env1 body outs r)))
      ((DValues f _ items vals q) (EvValues env items vals (evallistd-forget f env items vals q)))
      ((DFormer _ _ t) (EvFormer env t))
      ((DToken _ _) (EvToken env))
      ((DStmt f _ s rest env1 outs p q) (EvStmt env s rest env1 outs (evalstmtd-forget f env s env1 p) (evald-forget f env1 rest outs q)))))
  ((erased evallistd-forget : (erased (Nat) n) (erased (Env) env) (erased (List (Core)) cs) (erased (List (Val)) vs) (subterm erased (EvalListD n env cs vs) d) -> (erased (EvalList env cs vs) p))
    (match erased d _
      ((DLNil _ _) (EvLNil env))
      ((DLCons f _ c v rest vs2 p q) (EvLCons env c v rest vs2 (evald-forget f env c _ p) (evallistd-forget f env rest vs2 q)))))
  ((erased evalstmtd-forget : (erased (Nat) n) (erased (Env) env) (erased (Stmt) s) (erased (Env) out) (subterm erased (EvalStmtD n env s out) d) -> (erased (EvalStmt env s out) p))
    (match erased d _
      ((DLet f _ ids rhs vals _ p b) (EvLet env ids rhs vals out (evald-forget f env rhs vals p) b))
      ((DDefLvl _ _ x) (EvDefLvl env x))
      ((DDefFns _ _ defs _ g) (EvDefFns env defs out g))
      ((DDefAdts _ _ ids _ b) (EvDefAdts env ids out b)))))

(def-fns _
  ((erased evald-step : (erased (Nat) n) (erased (Env) env) (erased (Core) c) (erased (List (Val)) vs) (subterm erased (EvalD n env c vs) d) -> (erased (EvalD (Succ n) env c vs) p))
    (match erased d _
      ((DVar f _ x v p) (DVar (Succ f) env x v p))
      ((DApp f _ h args ctor vals p q) (DApp (Succ f) env h args ctor vals (evald-step f env h _ p) (evallistd-step f env args vals q)))
      ((DCall f _ fn args cenv group id ps body vals env1 env2 outs p q g b r)
        (DCall (Succ f) env fn args cenv group id ps body vals env1 env2 outs (evald-step f env fn _ p) (evallistd-step f env args vals q) g b (evald-step f env2 body outs r)))
      ((DMatch f _ s bs ctor fields ids body env1 outs p br b r)
        (DMatch (Succ f) env s bs ctor fields ids body env1 outs (evald-step f env s _ p) br b (evald-step f env1 body outs r)))
      ((DValues f _ items vals q) (DValues (Succ f) env items vals (evallistd-step f env items vals q)))
      ((DFormer f _ t) (DFormer (Succ f) env t))
      ((DToken f _) (DToken (Succ f) env))
      ((DStmt f _ s rest env1 outs p q) (DStmt (Succ f) env s rest env1 outs (evalstmtd-step f env s env1 p) (evald-step f env1 rest outs q)))))
  ((erased evallistd-step : (erased (Nat) n) (erased (Env) env) (erased (List (Core)) cs) (erased (List (Val)) vs) (subterm erased (EvalListD n env cs vs) d) -> (erased (EvalListD (Succ n) env cs vs) p))
    (match erased d _
      ((DLNil f _) (DLNil (Succ f) env))
      ((DLCons f _ c v rest vs2 p q) (DLCons (Succ f) env c v rest vs2 (evald-step f env c _ p) (evallistd-step f env rest vs2 q)))))
  ((erased evalstmtd-step : (erased (Nat) n) (erased (Env) env) (erased (Stmt) s) (erased (Env) out) (subterm erased (EvalStmtD n env s out) d) -> (erased (EvalStmtD (Succ n) env s out) p))
    (match erased d _
      ((DLet f _ ids rhs vals _ p b) (DLet (Succ f) env ids rhs vals out (evald-step f env rhs vals p) b))
      ((DDefLvl f _ x) (DDefLvl (Succ f) env x))
      ((DDefFns f _ defs _ g) (DDefFns (Succ f) env defs out g))
      ((DDefAdts f _ ids _ b) (DDefAdts (Succ f) env ids out b)))))

(def-fns _ $ (erased evald-weaken : (erased (Nat) k) (erased (Nat) n) (erased (Nat) m) (erased (Env) env) (erased (Core) c) (erased (List (Val)) vs)
    (subterm erased (Plus k n m) pl) (erased (EvalD n env c vs) d) -> (erased (EvalD m env c vs) p))
  (match erased pl _
    ((PlusZ _) d)
    ((PlusS k2 _ m2 pl2) (evald-step m2 env c vs (evald-weaken k2 n m2 env c vs pl2 d)))))

(def-fns _ $ (erased evald-unique : (erased (Nat) n) (erased (Nat) m) (erased (Env) env) (erased (Core) c) (erased (List (Val)) v1) (erased (List (Val)) v2)
    (erased (EvalD n env c v1) p) (erased (EvalD m env c v2) q) -> (erased (Eq (List (Val)) v1 v2) e))
  (eval-unique env c v1 v2 (evald-forget n env c v1 p) (evald-forget m env c v2 q)))

(def-fns _ $ (erased evallistd-unique : (erased (Nat) n) (erased (Nat) m) (erased (Env) env) (erased (List (Core)) cs) (erased (List (Val)) v1) (erased (List (Val)) v2)
    (erased (EvalListD n env cs v1) p) (erased (EvalListD m env cs v2) q) -> (erased (Eq (List (Val)) v1 v2) e))
  (eval-list-unique env cs v1 v2 (evallistd-forget n env cs v1 p) (evallistd-forget m env cs v2 q)))

(def-fns _ $ (erased evalstmtd-unique : (erased (Nat) n) (erased (Nat) m) (erased (Env) env) (erased (Stmt) s) (erased (Env) o1) (erased (Env) o2)
    (erased (EvalStmtD n env s o1) p) (erased (EvalStmtD m env s o2) q) -> (erased (Eq (Env) o1 o2) e))
  (eval-stmt-unique env s o1 o2 (evalstmtd-forget n env s o1 p) (evalstmtd-forget m env s o2 q)))

(def-fns _
  ((erased absurd no-fail : (erased (Nat) n) (erased (Env) env) (erased (Core) c) (erased (List (Val)) vs) (erased (Why) w) (subterm erased (EvalD n env c vs) d) (erased (FailEv n env c w) e) -> (erased (False) x))
    (match erased d _
      (absurd (DVar _ _ x v p) (let-match erased e (FVarMiss _ _ _ ne)) (no-env-absurd env x v p ne))
      (absurd (DApp f _ h args ctor vals p q)
        (match erased e _
          (absurd (FAppHead _ _ _ _ _ e2) (no-fail f env h _ w p e2))
          (absurd (FAppShape _ _ _ _ hv p3 sh)
            (let-match erased (evald-unique f f env h (Cons _ (VAtom ctor) (Nil _)) hv p p3) (Refl _ _))
            (bad-shape-absurd (VAtom ctor) (Succ (Zero)) (KOAtom ctor) sh))
          (absurd (FAppArgs _ _ _ _ _ e2) (no-fail-list f env args vals w q e2))))
      (absurd (DCall f _ fn args cenv group id ps body vals env1 env2 outs p q g b r)
        (match erased e _
          (absurd (FCallFn _ _ _ _ _ e2) (no-fail f env fn _ w p e2))
          (absurd (FCallShape _ _ _ _ fv p3 sh)
            (let-match erased (evald-unique f f env fn (Cons _ (VClo cenv group (MkFnDef id ps body)) (Nil _)) fv p p3) (Refl _ _))
            (bad-shape-absurd (VClo cenv group (MkFnDef id ps body)) (Succ (Succ (Succ (Zero)))) (KOClo cenv group (MkFnDef id ps body)) sh))
          (absurd (FCallArgs _ _ _ _ _ e2) (no-fail-list f env args vals w q e2))
          (absurd (FCallBind _ _ _ _ cenv3 group3 id3 ps3 body3 vals3 env13 p3 q3 g3 nb)
            (let-match erased (evald-unique f f env fn (Cons _ (VClo cenv group (MkFnDef id ps body)) (Nil _)) (Cons _ (VClo cenv3 group3 (MkFnDef id3 ps3 body3)) (Nil _)) p p3) (Refl _ _))
            (let-match erased (evallistd-unique f f env args vals vals3 q q3) (Refl _ _))
            (let-match erased (bind-group-unique cenv group group cenv env1 env13 g g3) (Refl _ _))
            (no-bind-absurd env1 ps vals env2 b nb))
          (absurd (FCallBody _ _ _ _ cenv3 group3 id3 ps3 body3 vals3 env13 env23 _ p3 q3 g3 b3 e2)
            (let-match erased (evald-unique f f env fn (Cons _ (VClo cenv group (MkFnDef id ps body)) (Nil _)) (Cons _ (VClo cenv3 group3 (MkFnDef id3 ps3 body3)) (Nil _)) p p3) (Refl _ _))
            (let-match erased (evallistd-unique f f env args vals vals3 q q3) (Refl _ _))
            (let-match erased (bind-group-unique cenv group group cenv env1 env13 g g3) (Refl _ _))
            (let-match erased (bind-all-unique env1 ps vals env2 env23 b b3) (Refl _ _))
            (no-fail f env2 body outs w r e2))))
      (absurd (DMatch f _ s bs ctor fields ids body env1 outs p br b r)
        (match erased e _
          (absurd (FMatchScrut _ _ _ _ _ e2) (no-fail f env s _ w p e2))
          (absurd (FMatchShape _ _ _ _ sv p3 sh)
            (let-match erased (evald-unique f f env s (Cons _ (VCon ctor fields) (Nil _)) sv p p3) (Refl _ _))
            (bad-shape-absurd (VCon ctor fields) (Zero) (KOCon ctor fields) sh))
          (absurd (FMatchMiss _ _ _ _ ctor3 fields3 p3 nbr)
            (let-match erased (evald-unique f f env s (Cons _ (VCon ctor fields) (Nil _)) (Cons _ (VCon ctor3 fields3) (Nil _)) p p3) (Refl _ _))
            (no-branch-absurd bs ctor ids body br nbr))
          (absurd (FMatchBind _ _ _ _ ctor3 fields3 ids3 body3 p3 br3 nb)
            (let-match erased (evald-unique f f env s (Cons _ (VCon ctor fields) (Nil _)) (Cons _ (VCon ctor3 fields3) (Nil _)) p p3) (Refl _ _))
            (let ((erased ef) (erased eb)) (branch-of-unique bs ctor ids ids3 body body3 br br3))
            (let-match erased ef (Refl _ _))
            (let-match erased eb (Refl _ _))
            (no-bind-absurd env ids fields env1 b nb))
          (absurd (FMatchBody _ _ _ _ ctor3 fields3 ids3 body3 env13 _ p3 br3 b3 e2)
            (let-match erased (evald-unique f f env s (Cons _ (VCon ctor fields) (Nil _)) (Cons _ (VCon ctor3 fields3) (Nil _)) p p3) (Refl _ _))
            (let ((erased ef) (erased eb)) (branch-of-unique bs ctor ids ids3 body body3 br br3))
            (let-match erased ef (Refl _ _))
            (let-match erased eb (Refl _ _))
            (let-match erased (bind-all-unique env ids fields env1 env13 b b3) (Refl _ _))
            (no-fail f env1 body outs w r e2))))
      (absurd (DValues f _ items vals q) (let-match erased e (FValues _ _ _ _ e2)) (no-fail-list f env items vals w q e2))
      (absurd (DFormer _ _ _) e)
      (absurd (DToken _ _) e)
      (absurd (DStmt f _ s rest env1 outs p q)
        (match erased e _
          (absurd (FStmtStmt _ _ _ _ _ e2) (no-fail-stmt f env s env1 w p e2))
          (absurd (FStmtRest _ _ _ _ env13 _ p3 e2)
            (let-match erased (evalstmtd-unique f f env s env1 env13 p p3) (Refl _ _))
            (no-fail f env1 rest outs w q e2))))))
  ((erased absurd no-fail-list : (erased (Nat) n) (erased (Env) env) (erased (List (Core)) cs) (erased (List (Val)) vs) (erased (Why) w) (subterm erased (EvalListD n env cs vs) d) (erased (FailListEv n env cs w) e) -> (erased (False) x))
    (match erased d _
      (absurd (DLNil _ _) e)
      (absurd (DLCons f _ c v rest vs2 p q)
        (match erased e _
          (absurd (FLHead _ _ _ _ _ e2) (no-fail f env c _ w p e2))
          (absurd (FLOne _ _ _ _ vs3 p3 ns) (let-match erased (evald-unique f f env c (Cons _ v (Nil _)) vs3 p p3) (Refl _ _)) ns)
          (absurd (FLTail _ _ _ _ _ e2) (no-fail-list f env rest vs2 w q e2))))))
  ((erased absurd no-fail-stmt : (erased (Nat) n) (erased (Env) env) (erased (Stmt) s) (erased (Env) out) (erased (Why) w) (subterm erased (EvalStmtD n env s out) d) (erased (FailStmtEv n env s w) e) -> (erased (False) x))
    (match erased d _
      (absurd (DLet f _ ids rhs vals _ p b)
        (match erased e _
          (absurd (FSLetRhs _ _ _ _ _ e2) (no-fail f env rhs vals w p e2))
          (absurd (FSLetBind _ _ _ _ vals3 p3 nb) (let-match erased (evald-unique f f env rhs vals vals3 p p3) (Refl _ _)) (no-bind-absurd env ids vals out b nb))))
      (absurd (DDefLvl _ _ _) e)
      (absurd (DDefFns _ _ _ _ _) e)
      (absurd (DDefAdts _ _ _ _ _) e))))

(def-fns _ $ (erased absurd enough-fuel : (erased (Nat) k) (erased (Nat) n) (erased (Nat) m) (erased (Env) env) (erased (Core) c) (erased (List (Val)) vs) (erased (Why) w)
    (erased (Plus k n m) pl) (erased (EvalD n env c vs) d) (erased (FailEv m env c w) e) -> (erased (False) x))
  (no-fail m env c vs w (evald-weaken k n m env c vs pl d) e))

(def-fns _ $ (many fuel-is-unobservable : (erased (Nat) k) (erased (Nat) n) (erased (Nat) m) (erased (Env) env) (erased (Core) c) (erased (List (Val)) vs)
    (erased (Plus k n m) pl) (erased (EvalD n env c vs) d) (many (Ran m env c) r) -> (many vs is v))
  (let-match many r (Done _ _ _ vs2 p2) (absurd (Failed _ _ _ w e) (enough-fuel k n m env c vs w pl d e)))
  (let-match erased (evald-unique n m env c vs vs2 d p2) (Refl _ _))
  vs2)

(MkUnit)
