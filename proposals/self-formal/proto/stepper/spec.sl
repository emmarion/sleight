; A tiny imperative language with registers and a mutable heap of blocks, and its big-step semantics
; Runs as a relation. Needs std/list.sl earlier on the command line. An overnight agent's spike;
; nothing here is settled design.

(def-adts $ (Val : -> Type)
  enum
  (many VNum : (many (Nat) n) -> (Val))
  (many VPtr : (many (Nat) a) -> (Val)))

(def-adts $ (Mem : -> Type)
  enum
  (many MkMem : (many (List (Val)) env) (many (List (List (Val))) heap) -> (Mem)))

(def-adts $ (Op : -> Type)
  enum
  (many OSet : (many (Nat) x) (many (Nat) n) -> (Op))
  (many OMov : (many (Nat) x) (many (Nat) y) -> (Op))
  (many OPred : (many (Nat) x) (many (Nat) y) -> (Op))
  (many OAdd : (many (Nat) x) (many (Nat) y) (many (Nat) z) -> (Op))
  (many OAlloc : (many (Nat) x) (many (Nat) n) -> (Op))
  (many ORead : (many (Nat) x) (many (Nat) p) (many (Nat) i) -> (Op))
  (many OWrite : (many (Nat) p) (many (Nat) i) (many (Nat) y) -> (Op)))

(def-adts $ (Cmd : -> Type)
  enum
  (many CSkip : -> (Cmd))
  (many COp : (many (Op) o) -> (Cmd))
  (many CSeq : (many (Cmd) c1) (many (Cmd) c2) -> (Cmd))
  (many CIf : (many (Nat) x) (many (Cmd) c1) (many (Cmd) c2) -> (Cmd))
  (many CWhile : (many (Nat) x) (many (Cmd) body) -> (Cmd)))

(def-adts $ (Alloc : (Type A) ((List A) xs) (A y) ((Nat) a) ((List A) ys) -> Type)
  enum
  (many AllocNil : (erased Type A) (erased A y) -> (Alloc A (Nil A) y (Zero) (Cons A y (Nil A))))
  (many AllocCons : (erased Type A) (erased A x) (erased (List A) xs) (erased A y) (erased (Nat) a) (erased (List A) ys)
     (erased (Alloc A xs y a ys) p) -> (Alloc A (Cons A x xs) y (Succ a) (Cons A x ys))))

(def-adts $ (RunOp : ((Mem) m) ((Op) o) ((Mem) m2) -> Type)
  enum
  (many RSet : (erased (List (Val)) e e2) (erased (List (List (Val))) h) (erased (Nat) x n)
     (erased (SetNth (Val) e x (VNum n) e2) s) -> (RunOp (MkMem e h) (OSet x n) (MkMem e2 h)))
  (many RMov : (erased (List (Val)) e e2) (erased (List (List (Val))) h) (erased (Nat) x y) (erased (Val) v)
     (erased (Nth (Val) e y v) g) (erased (SetNth (Val) e x v e2) s) -> (RunOp (MkMem e h) (OMov x y) (MkMem e2 h)))
  (many RPred : (erased (List (Val)) e e2) (erased (List (List (Val))) h) (erased (Nat) x y n)
     (erased (Nth (Val) e y (VNum (Succ n))) g) (erased (SetNth (Val) e x (VNum n) e2) s)
     -> (RunOp (MkMem e h) (OPred x y) (MkMem e2 h)))
  (many RAdd : (erased (List (Val)) e e2) (erased (List (List (Val))) h) (erased (Nat) x y z a b c)
     (erased (Nth (Val) e y (VNum a)) g1) (erased (Nth (Val) e z (VNum b)) g2) (erased (Add a b c) ad)
     (erased (SetNth (Val) e x (VNum c) e2) s) -> (RunOp (MkMem e h) (OAdd x y z) (MkMem e2 h)))
  (many RAlloc : (erased (List (Val)) e e2) (erased (List (List (Val))) h h2) (erased (Nat) x n a) (erased (List (Val)) blk)
     (erased (Repeat (Val) n (VNum (Zero)) blk) r) (erased (Alloc (List (Val)) h blk a h2) al)
     (erased (SetNth (Val) e x (VPtr a) e2) s) -> (RunOp (MkMem e h) (OAlloc x n) (MkMem e2 h2)))
  (many RRead : (erased (List (Val)) e e2) (erased (List (List (Val))) h) (erased (Nat) x p i a) (erased (List (Val)) blk) (erased (Val) v)
     (erased (Nth (Val) e p (VPtr a)) g1) (erased (Nth (List (Val)) h a blk) g2) (erased (Nth (Val) blk i v) g3)
     (erased (SetNth (Val) e x v e2) s) -> (RunOp (MkMem e h) (ORead x p i) (MkMem e2 h)))
  (many RWrite : (erased (List (Val)) e) (erased (List (List (Val))) h h2) (erased (Nat) p i y a) (erased (Val) v)
     (erased (List (Val)) blk blk2)
     (erased (Nth (Val) e p (VPtr a)) g1) (erased (Nth (Val) e y v) g2) (erased (Nth (List (Val)) h a blk) g3)
     (erased (SetNth (Val) blk i v blk2) s1) (erased (SetNth (List (Val)) h a blk2 h2) s2)
     -> (RunOp (MkMem e h) (OWrite p i y) (MkMem e h2))))

(def-adts $ (Pick : ((Mem) m) ((Nat) x) ((Cmd) c1) ((Cmd) c2) ((Cmd) c) -> Type)
  enum
  (many PickZ : (erased (List (Val)) e) (erased (List (List (Val))) h) (erased (Nat) x) (erased (Cmd) c1 c2)
     (erased (Nth (Val) e x (VNum (Zero))) g) -> (Pick (MkMem e h) x c1 c2 c1))
  (many PickS : (erased (List (Val)) e) (erased (List (List (Val))) h) (erased (Nat) x n) (erased (Cmd) c1 c2)
     (erased (Nth (Val) e x (VNum (Succ n))) g) -> (Pick (MkMem e h) x c1 c2 c2)))

(def-adts $ (Runs : ((Mem) m) ((Cmd) c) ((Mem) m2) -> Type)
  enum
  (many ExSkip : (erased (Mem) m) -> (Runs m (CSkip) m))
  (many ExOp : (erased (Mem) m m2) (erased (Op) o) (erased (RunOp m o m2) r) -> (Runs m (COp o) m2))
  (many ExSeq : (erased (Mem) m m1 m2) (erased (Cmd) c1 c2) (erased (Runs m c1 m1) d1) (erased (Runs m1 c2 m2) d2)
     -> (Runs m (CSeq c1 c2) m2))
  (many ExIf : (erased (Mem) m m2) (erased (Nat) x) (erased (Cmd) c1 c2 c) (erased (Pick m x c1 c2 c) p) (erased (Runs m c m2) d)
     -> (Runs m (CIf x c1 c2) m2))
  (many ExWhile : (erased (Mem) m m2) (erased (Nat) x) (erased (Cmd) b)
     (erased (Runs m (CIf x (CSkip) (CSeq b (CWhile x b))) m2) d) -> (Runs m (CWhile x b) m2)))

(def-fns _ $ (erased alloc-fn : (erased Type A) (erased (List A) xs ys zs) (erased A y) (erased (Nat) a b)
    (subterm erased (Alloc A xs y a ys) p) (erased (Alloc A xs y b zs) q) -> (erased (Eq (Nat) a b) e) (erased (Eq (List A) ys zs) f))
  (let-match erased p (AllocCons _ x xs1 _ a1 ys1 p1)
    ((AllocNil _ _) (let-match erased q (AllocNil _ _)) (values (Refl _ a) (Refl _ ys))))
  (let-match erased q (AllocCons _ _ _ _ b1 zs1 q1))
  (let ((erased e1) (erased f1)) (alloc-fn _ xs1 ys1 zs1 y a1 b1 p1 q1))
  (let-match erased e1 (Refl _ _))
  (let-match erased f1 (Refl _ _))
  (values (Refl _ a) (Refl _ ys)))

(def-fns _ $ (erased runop-fn : (erased (Mem) m m1 m2) (erased (Op) o) (erased (RunOp m o m1) p) (erased (RunOp m o m2) q)
    -> (erased (Eq (Mem) m1 m2) r))
  (match erased p _
    ((RSet e e2 h x n s)
      (let-match erased q (RSet _ e3 _ _ _ s3))
      (let-match erased (setnth-fn _ e x _ e2 e3 s s3) (Refl _ _))
      (Refl _ m1))
    ((RMov e e2 h x y v g s)
      (let-match erased q (RMov _ e3 _ _ _ v3 g3 s3))
      (let-match erased (nth-fn _ e y v v3 g g3) (Refl _ _))
      (let-match erased (setnth-fn _ e x v e2 e3 s s3) (Refl _ _))
      (Refl _ m1))
    ((RPred e e2 h x y n g s)
      (let-match erased q (RPred _ e3 _ _ _ n3 g3 s3))
      (let-match erased (nth-fn _ e y _ _ g g3) (Refl _ _))
      (let-match erased (setnth-fn _ e x _ e2 e3 s s3) (Refl _ _))
      (Refl _ m1))
    ((RAdd e e2 h x y z a b c g1 g2 ad s)
      (let-match erased q (RAdd _ e3 _ _ _ _ a3 b3 c3 k1 k2 ad3 s3))
      (let-match erased (nth-fn _ e y _ _ g1 k1) (Refl _ _))
      (let-match erased (nth-fn _ e z _ _ g2 k2) (Refl _ _))
      (let-match erased (add-fn a b c c3 ad ad3) (Refl _ _))
      (let-match erased (setnth-fn _ e x _ e2 e3 s s3) (Refl _ _))
      (Refl _ m1))
    ((RAlloc e e2 h h2 x n a blk r al s)
      (let-match erased q (RAlloc _ e3 _ h3 _ _ a3 blk3 r3 al3 s3))
      (let-match erased (repeat-fn _ n _ blk blk3 r r3) (Refl _ _))
      (let ((erased ea) (erased eh)) (alloc-fn _ h h2 h3 blk a a3 al al3))
      (let-match erased ea (Refl _ _))
      (let-match erased eh (Refl _ _))
      (let-match erased (setnth-fn _ e x _ e2 e3 s s3) (Refl _ _))
      (Refl _ m1))
    ((RRead e e2 h x pr i a blk v g1 g2 g3 s)
      (let-match erased q (RRead _ e3 _ _ _ _ a3 blk3 v3 k1 k2 k3 s3))
      (let-match erased (nth-fn _ e pr _ _ g1 k1) (Refl _ _))
      (let-match erased (nth-fn _ h a blk blk3 g2 k2) (Refl _ _))
      (let-match erased (nth-fn _ blk i v v3 g3 k3) (Refl _ _))
      (let-match erased (setnth-fn _ e x v e2 e3 s s3) (Refl _ _))
      (Refl _ m1))
    ((RWrite e h h2 pr i y a v blk blk2 g1 g2 g3 s1 s2)
      (let-match erased q (RWrite _ _ h3 _ _ _ a3 v3 blk3 blk4 k1 k2 k3 t1 t2))
      (let-match erased (nth-fn _ e pr _ _ g1 k1) (Refl _ _))
      (let-match erased (nth-fn _ e y v v3 g2 k2) (Refl _ _))
      (let-match erased (nth-fn _ h a blk blk3 g3 k3) (Refl _ _))
      (let-match erased (setnth-fn _ blk i v blk2 blk4 s1 t1) (Refl _ _))
      (let-match erased (setnth-fn _ h a blk2 h2 h3 s2 t2) (Refl _ _))
      (Refl _ m1))))

(def-fns _ $ (erased pick-fn : (erased (Mem) m) (erased (Nat) x) (erased (Cmd) c1 c2 c c3)
    (erased (Pick m x c1 c2 c) p) (erased (Pick m x c1 c2 c3) q) -> (erased (Eq (Cmd) c c3) r))
  (match erased p _
    ((PickZ e h _ _ _ g)
      (match erased q _
        ((PickZ _ _ _ _ _ _) (Refl _ c))
        (absurd (PickS _ _ _ n _ _ g2) (nth-fn _ e x _ _ g g2))))
    ((PickS e h _ n _ _ g)
      (match erased q _
        (absurd (PickZ _ _ _ _ _ g2) (nth-fn _ e x _ _ g g2))
        ((PickS _ _ _ _ _ _ _) (Refl _ c))))))

(def-fns _ $ (erased runs-fn : (erased (Mem) m m1 m2) (erased (Cmd) c) (subterm erased (Runs m c m1) p) (erased (Runs m c m2) q)
    -> (erased (Eq (Mem) m1 m2) r))
  (match erased p _
    ((ExSkip _) (let-match erased q (ExSkip _)) (Refl _ m1))
    ((ExOp _ _ o r) (let-match erased q (ExOp _ _ _ r2)) (runop-fn m m1 m2 o r r2))
    ((ExSeq _ ma _ c1 c2 d1 d2)
      (let-match erased q (ExSeq _ mb _ _ _ e1 e2))
      (let-match erased (runs-fn m ma mb c1 d1 e1) (Refl _ _))
      (runs-fn ma m1 m2 c2 d2 e2))
    ((ExIf _ _ x c1 c2 ca pa d)
      (let-match erased q (ExIf _ _ _ _ _ cb pb e))
      (let-match erased (pick-fn m x c1 c2 ca cb pa pb) (Refl _ _))
      (runs-fn m m1 m2 ca d e))
    ((ExWhile _ _ x b d)
      (let-match erased q (ExWhile _ _ _ _ e))
      (runs-fn m m1 m2 _ d e))))
