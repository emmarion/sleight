(def-lvl L)
(def-fns _ $ (many extend : (erased (Nat) n)
    (many (Fn L (subterm erased (Nat) j) (erased (Eq (Nat) j n) e) (many (Nat) a) -> (many (Nat) r)) k) ->
    (many (Fn L (subterm erased (Nat) j) (erased (Eq (Nat) j (Succ n)) e) (many (Nat) a) -> (many (Nat) r)) out))
  (def-fns L $ (many k2 : (subterm erased (Nat) j) (erased (Eq (Nat) j (Succ n)) e) (many (Nat) a) -> (many (Nat) r))
    (let-match erased e (Refl _ _))
    (tail (k n (Refl _ n) (Succ a))))
  k2)
(def-fns L $ (many k0 : (subterm erased (Nat) j) (erased (Eq (Nat) j (Zero)) e) (many (Nat) a) -> (many (Nat) r))
  a)
(let ((many k1)) (extend (Zero) k0))
(let ((many k2)) (extend (Succ (Zero)) k1))
(let ((many k3)) (extend (Succ (Succ (Zero))) k2))
(k3 (Succ (Succ (Succ (Zero)))) (Refl _ _) 10)
