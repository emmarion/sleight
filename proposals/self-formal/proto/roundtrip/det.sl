(def-fns _ $ (erased nth-det : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x) (erased A y)
    (subterm erased (Nth A xs i x) p) (erased (Nth A xs i y) q) -> (erased (Eq A x y) e))
  (match erased p _
    ((NthHere _ _ _) (let-match erased q (NthHere _ _ _)) (Refl A x))
    ((NthThere _ _ rest j _ p1)
      (let-match erased q (NthThere _ _ _ _ _ q1))
      (nth-det A rest j x y p1 q1))))

(def-fns _ $ (erased nth-nonth : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A x)
    (subterm erased (Nth A xs i x) p) (erased (NoNth A xs i) nn) -> (erased (False) no))
  (match erased p _
    ((NthHere _ _ _) (match erased nn _))
    ((NthThere _ _ rest j _ p1)
      (let-match erased nn (NoCons _ _ _ _ nn1))
      (nth-nonth A rest j x p1 nn1))))

(def-fns _ $ (erased setnth-det : (erased Type A) (erased (List A) xs) (erased (Nat) i) (erased A y)
    (erased (List A) ys) (erased (List A) zs)
    (subterm erased (SetNth A xs i y ys) p) (erased (SetNth A xs i y zs) q) -> (erased (Eq (List A) ys zs) e))
  (match erased p _
    ((SetHere _ _ _ _) (let-match erased q (SetHere _ _ _ _)) (Refl _ ys))
    ((SetThere _ x0 rest j _ rest2 p1)
      (let-match erased q (SetThere _ _ _ _ _ rest3 q1))
      (let-match erased (setnth-det A rest j y rest2 rest3 p1 q1) (Refl _ _))
      (Refl _ ys))))

(def-fns _ $ (erased vals-det : (erased (List $ Ent) es) (erased (List $ Val) vs) (erased (List $ Val) ws)
    (subterm erased (Vals es vs) p) (erased (Vals es ws) q) -> (erased (Eq (List $ Val) vs ws) e))
  (match erased p _
    ((ValsNil) (let-match erased q (ValsNil)) (Refl _ vs))
    ((ValsCons v k es1 vs1 p1)
      (let-match erased q (ValsCons _ _ _ ws1 q1))
      (let-match erased (vals-det es1 vs1 ws1 p1 q1) (Refl _ _))
      (Refl _ vs))))

(def-fns _ $ (erased step-det : (erased (MSt) s) (erased (Out) o1) (erased (Out) o2)
    (erased (Step s o1) p) (erased (Step s o2) q) -> (erased (Eq (Out) o1 o2) e))
  (match erased p _
    ((SVar i env k v n1)
      (let-match erased q (SVar _ _ _ w n2) (absurd (SVarNo _ _ _ nn) (nth-nonth (Val) env i v n1 nn)))
      (let-match erased (nth-det (Val) env i v w n1 n2) (Refl _ _))
      (Refl _ o1))
    ((SVarNo i env k nn)
      (let-match erased q (SVarNo _ _ _ _) (absurd (SVar _ _ _ w n2) (nth-nonth (Val) env i w n2 nn)))
      (Refl _ o1))
    ((SLam _ _ _) (let-match erased q (SLam _ _ _)) (Refl _ o1))
    ((SApp _ _ _ _) (let-match erased q (SApp _ _ _ _)) (Refl _ o1))
    ((SNum _ _ _) (let-match erased q (SNum _ _ _)) (Refl _ o1))
    ((SRetNil _) (let-match erased q (SRetNil _)) (Refl _ o1))
    ((SArg _ _ _ _) (let-match erased q (SArg _ _ _ _)) (Refl _ o1))
    ((SCall _ _ _ _) (let-match erased q (SCall _ _ _ _)) (Refl _ o1))
    ((SCallNum _ _ _) (let-match erased q (SCallNum _ _ _)) (Refl _ o1))))

(def-fns _ $ (erased runs-det : (erased (MSt) s) (erased (Res) r1) (erased (Res) r2)
    (subterm erased (Runs s r1) p) (erased (Runs s r2) q) -> (erased (Eq (Res) r1 r2) e))
  (match erased p _
    ((RunHalt _ _ st1)
      (match erased q _
        ((RunHalt _ _ st2) (let-match erased (step-det s (Halt r1) (Halt r2) st1 st2) (Refl _ _)) (Refl _ r1))
        ((RunGo _ s2 _ st2 _) (match erased (step-det s (Halt r1) (Go s2) st1 st2) _))))
    ((RunGo _ s1 _ st1 p1)
      (match erased q _
        ((RunHalt _ _ st2) (match erased (step-det s (Go s1) (Halt r2) st1 st2) _))
        ((RunGo _ s2 _ st2 q1)
          (let-match erased (step-det s (Go s1) (Go s2) st1 st2) (Refl _ _))
          (runs-det s1 r1 r2 p1 q1))))))

(def-fns _ $ (erased head-det : (erased (Val) v) (erased (Ctor) c1) (erased (Ctor) c2)
    (erased (Head v c1) p) (erased (Head v c2) q) -> (erased (Eq (Ctor) c1 c2) e))
  (match erased p _
    ((HZero) (let-match erased q (HZero)) (Refl _ c1))
    ((HSucc _) (let-match erased q (HSucc _)) (Refl _ c1))
    ((HClo _ _) (let-match erased q (HClo _ _)) (Refl _ c1))))

(def-fns _ $ (erased evals-det : (erased (List $ Ent) es) (erased (Tm) t) (erased (Val) v1) (erased (Val) v2)
    (erased (Evals es t v1) p) (erased (Evals es t v2) q) -> (erased (Eq (Val) v1 v2) e))
  (let-match erased p (MkEvals _ _ _ env1 ve1 r1))
  (let-match erased q (MkEvals _ _ _ env2 ve2 r2))
  (let-match erased (vals-det es env1 env2 ve1 ve2) (Refl _ _))
  (let-match erased (runs-det (Ev t env1 (Nil (Frame))) (RVal v1) (RVal v2) r1 r2) (Refl _ _))
  (Refl _ v1))

(def-fns _ $ (erased evals-sticks : (erased (List $ Ent) es) (erased (Tm) t) (erased (Val) v)
    (erased (Evals es t v) p) (erased (Sticks es t) q) -> (erased (False) no))
  (let-match erased p (MkEvals _ _ _ env1 ve1 r1))
  (let-match erased q (MkSticks _ _ env2 ve2 r2))
  (let-match erased (vals-det es env1 env2 ve1 ve2) (Refl _ _))
  (match erased (runs-det (Ev t env1 (Nil (Frame))) (RVal v) (RStuck) r1 r2) _))

(def-fns _ $ (erased exclusive : (erased (List $ Ent) es) (erased (List $ Stmt) p)
    (erased (Elab es p) d) (subterm erased (Fails es p) f) -> (erased (False) no))
  (match erased f _
    ((FLetStuck _ t _ sk)
      (let-match erased d (ElLet _ _ _ v ev _))
      (evals-sticks es t v ev sk))
    ((FLetRest _ t rest v1 ev1 f1)
      (let-match erased d (ElLet _ _ _ v2 ev2 d1))
      (let-match erased (evals-det es t v1 v2 ev1 ev2) (Refl _ _))
      (exclusive (Cons (Ent) (MkEnt v1 (KNone)) es) rest d1 f1))
    ((FAssertRange _ i _ _ nn)
      (let-match erased d (ElAssert _ _ _ _ v k _ nth _ _ _))
      (nth-nonth (Ent) es i (MkEnt v k) nth nn))
    ((FAssertHead _ i c _ v1 k1 c2 nth1 hd1 ne)
      (let-match erased d (ElAssert _ _ _ _ v2 k2 _ nth2 hd2 _ _))
      (let-match erased (nth-det (Ent) es i (MkEnt v1 k1) (MkEnt v2 k2) nth1 nth2) (Refl _ _))
      (let-match erased (head-det v1 c c2 hd2 hd1) (Refl _ _))
      (match erased ne _))
    ((FAssertRest _ i c rest v1 k1 es1 nth1 hd1 sn1 f1)
      (let-match erased d (ElAssert _ _ _ _ v2 k2 es2 nth2 hd2 sn2 d1))
      (let-match erased (nth-det (Ent) es i (MkEnt v1 k1) (MkEnt v2 k2) nth1 nth2) (Refl _ _))
      (let-match erased (setnth-det (Ent) es i (MkEnt v1 (KIs c)) es1 es2 sn1 sn2) (Refl _ _))
      (exclusive es1 rest d1 f1))
    ((FNeedRange _ i _ _ nn)
      (let-match erased d (ElNeed _ _ c _ v nth _))
      (nth-nonth (Ent) es i (MkEnt v (KIs c)) nth nn))
    ((FNeedFact _ i c _ v1 k1 nth1 ni)
      (let-match erased d (ElNeed _ _ _ _ v2 nth2 _))
      (let-match erased (nth-det (Ent) es i (MkEnt v1 k1) (MkEnt v2 (KIs c)) nth1 nth2) (Refl _ _))
      (let-match erased ni (NotOther _ _ ne))
      (match erased ne _))
    ((FNeedRest _ i c rest v1 nth1 f1)
      (let-match erased d (ElNeed _ _ _ _ v2 nth2 d1))
      (exclusive es rest d1 f1))))
