(def-adts $ (Answer : -> Type)
  enum
  (many MkAnswer : (many (Tm) t) (many (List $ Val) env) (many (Res) r)
     (erased (Runs (Ev t env (Nil (Frame))) r) runs) -> (Answer)))

(def-fns _ $ (many nat-is : (many (Nat) a) (many (Nat) b) -> (many (ErasedMaybe (Eq (Nat) a b)) r))
  (let-match many (nat-eq a b) (Equal _ _ _) ((Unequal _ _ _ _ _) (ENone _)))
  (ESome _ (Refl _ a)))

(def-fns _ $ (many tm-eq : (subterm many (Tm) a) (many (Tm) b) -> (many (ErasedMaybe (Eq (Tm) a b)) r))
  (match many a _
    ((Var i) (let-match many b (Var j) (else (ENone _)))
      (let-match many (nat-is i j) (ESome _ e) ((ENone _) (ENone _)))
      (let-match erased e (Refl _ _))
      (ESome _ (Refl _ a)))
    ((Num i) (let-match many b (Num j) (else (ENone _)))
      (let-match many (nat-is i j) (ESome _ e) ((ENone _) (ENone _)))
      (let-match erased e (Refl _ _))
      (ESome _ (Refl _ a)))
    ((Lam x) (let-match many b (Lam y) (else (ENone _)))
      (let-match many (notail (tm-eq x y)) (ESome _ e) ((ENone _) (ENone _)))
      (let-match erased e (Refl _ _))
      (ESome _ (Refl _ a)))
    ((App f x) (let-match many b (App g y) (else (ENone _)))
      (let-match many (notail (tm-eq f g)) (ESome _ e1) ((ENone _) (ENone _)))
      (let-match many (notail (tm-eq x y)) (ESome _ e2) ((ENone _) (ENone _)))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (ESome _ (Refl _ a)))))

(def-fns _
  ((many val-eq : (subterm many (Val) a) (many (Val) b) -> (many (ErasedMaybe (Eq (Val) a b)) r))
    (match many a _
      ((VNum i) (let-match many b (VNum j) (else (ENone _)))
        (let-match many (nat-is i j) (ESome _ e) ((ENone _) (ENone _)))
        (let-match erased e (Refl _ _))
        (ESome _ (Refl _ a)))
      ((VClo x env) (let-match many b (VClo y env2) (else (ENone _)))
        (let-match many (tm-eq x y) (ESome _ e1) ((ENone _) (ENone _)))
        (let-match many (notail (vals-eq env env2)) (ESome _ e2) ((ENone _) (ENone _)))
        (let-match erased e1 (Refl _ _))
        (let-match erased e2 (Refl _ _))
        (ESome _ (Refl _ a)))))
  ((many vals-eq : (subterm many (List $ Val) a) (many (List $ Val) b) -> (many (ErasedMaybe (Eq (List $ Val) a b)) r))
    (match many a _
      ((Nil _) (let-match many b (Nil _) (else (ENone _))) (ESome _ (Refl _ a)))
      ((Cons _ x xs) (let-match many b (Cons _ y ys) (else (ENone _)))
        (let-match many (notail (val-eq x y)) (ESome _ e1) ((ENone _) (ENone _)))
        (let-match many (notail (vals-eq xs ys)) (ESome _ e2) ((ENone _) (ENone _)))
        (let-match erased e1 (Refl _ _))
        (let-match erased e2 (Refl _ _))
        (ESome _ (Refl _ a))))))

(def-adts $ (RTurn : ((List $ Ent) es) ((List $ Stmt) p) -> Type)
  enum
  (many RElab : (erased (List $ Ent) es) (erased (List $ Stmt) p) (erased (Elab es p) d) -> (RTurn es p))
  (many RFails : (erased (List $ Ent) es) (erased (List $ Stmt) p) (erased (Fails es p) f) (many (String) why) -> (RTurn es p))
  (many RAsk : (erased (List $ Ent) es) (erased (List $ Stmt) p) (many (Tm) t) (many (List $ Val) env) -> (RTurn es p)))

(def-fns _ $ (many elab-r : (many (List $ Ent) es) (subterm many (List $ Stmt) p) (many (List $ Answer) ans) -> (many (RTurn es p) o))
  (let-match many p (Cons _ st rest) ((Nil _) (RElab es p (ElNil es))))
  (match many st _
    ((Let t)
      (let ((many env) (erased ve)) (vals es))
      (let-match many ans (Cons _ a more) ((Nil _) (RAsk es p t env)))
      (let-match many a (MkAnswer t2 env2 r runs))
      (let-match many (tm-eq t t2) (ESome _ e1) ((ENone _) (RAsk es p t env)))
      (let-match many (vals-eq env env2) (ESome _ e2) ((ENone _) (RAsk es p t env)))
      (let-match erased e1 (Refl _ _))
      (let-match erased e2 (Refl _ _))
      (let-match many r (RVal v)
        ((RStuck) (RFails es p (FLetStuck es t rest (MkSticks es t env ve runs)) "let: the compile-time run is stuck")))
      (let ((erased ev)) (MkEvals es t v env ve runs))
      (match many (notail (elab-r (Cons (Ent) (MkEnt v (KNone)) es) rest more)) _
        ((RElab _ _ d) (RElab es p (ElLet es t rest v ev d)))
        ((RFails _ _ f why) (RFails es p (FLetRest es t rest v ev f) why))
        ((RAsk _ _ t3 env3) (RAsk es p t3 env3))))
    ((Assert i ct)
      (let-match many (nth-find (Ent) es i) (FoundAt _ _ _ e nth)
        ((MissingAt _ _ _ nn) (RFails es p (FAssertRange es i ct rest nn) "assert: no such entry")))
      (let-match many e (MkEnt v k))
      (let ((many ct2) (erased hd)) (head v))
      (let-match many (ctor-dec ct ct2) (CSame _)
        ((CDiff _ _ ne) (RFails es p (FAssertHead es i ct rest v k ct2 nth hd ne) "assert: the value has another constructor")))
      (let ((many es2) (erased sn)) (set-nth (Ent) es i (MkEnt v (KIs ct)) e nth))
      (match many (notail (elab-r es2 rest ans)) _
        ((RElab _ _ d) (RElab es p (ElAssert es i ct rest v k es2 nth hd sn d)))
        ((RFails _ _ f why) (RFails es p (FAssertRest es i ct rest v k es2 nth hd sn f) why))
        ((RAsk _ _ t3 env3) (RAsk es p t3 env3))))
    ((Need i ct)
      (let-match many (nth-find (Ent) es i) (FoundAt _ _ _ e nth)
        ((MissingAt _ _ _ nn) (RFails es p (FNeedRange es i ct rest nn) "need: no such entry")))
      (let-match many e (MkEnt v k))
      (let ((many no-fact)) "need: the fact is not known")
      (let-match many k (KIs ct2) ((KNone) (RFails es p (FNeedFact es i ct rest v k nth (NotNone ct)) no-fact)))
      (let-match many (ctor-dec ct2 ct) (CSame _)
        ((CDiff _ _ ne) (RFails es p (FNeedFact es i ct rest v k nth (NotOther ct2 ct ne)) no-fact)))
      (match many (notail (elab-r es rest ans)) _
        ((RElab _ _ d) (RElab es p (ElNeed es i ct rest v nth d)))
        ((RFails _ _ f why) (RFails es p (FNeedRest es i ct rest v nth f) why))
        ((RAsk _ _ t3 env3) (RAsk es p t3 env3))))))

(def-fns _ $ (many snoc : (erased Type A) (subterm many (List A) xs) (many A x) -> (many (List A) ys))
  (let-match many xs (Cons _ y rest) ((Nil _) (Cons A x (Nil A))))
  (Cons A y $ notail (snoc A rest x)))

(def-adts $ (RState : ((List $ Stmt) p0) -> Type)
  enum
  (many Replay : (erased (List $ Stmt) p0) (many p0 is src) (many (List $ Answer) ans) -> (RState p0))
  (many Running : (erased (List $ Stmt) p0) (many p0 is src) (many (List $ Answer) ans) (many (Tm) t) (many (List $ Val) env)
     (many (MSt) m) (erased (Reach (Ev t env (Nil (Frame))) m) r) -> (RState p0)))

(def-fns _ $ (many rstep : (erased (List $ Stmt) p0) (many (RState p0) s) -> (many (Turn RState p0) o))
  (match many s _
    ((Replay _ src ans)
      (match many (elab-r (Nil (Ent)) src ans) _
        ((RElab _ _ d) (Fin RState p0 $ Accepted p0 d))
        ((RFails _ _ f why) (Fin RState p0 $ Rejected p0 f why))
        ((RAsk _ _ t env) (More RState p0 $ Running p0 src ans t env (Ev t env (Nil (Frame))) (ReachZ _)))))
    ((Running _ src ans t env m r)
      (let ((many o) (erased st)) (mstep m))
      (let-match many o (Halt res) ((Go m2) (More RState p0 $ Running p0 src ans t env m2 (ReachS _ m m2 r st))))
      (let ((erased runs)) (reach-runs _ m res r (RunHalt m res st)))
      (More RState p0 $ Replay p0 src $ snoc _ ans (MkAnswer t env res runs)))))

(def-fns _ $ (many rstart : (many (List $ Stmt) p0) -> (many (RState p0) s))
  (Replay p0 p0 (Nil _)))
