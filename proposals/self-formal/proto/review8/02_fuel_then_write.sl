(def-fns _ $ (many deep : (subterm many (Nat) n) -> (many (Nat) r))
  (let-match many n (Succ m) ((Zero) 0))
  (Succ (notail (deep m))))
(def-fns _ $ (many say : (unique (World) w at vacant-slot) -> (unique (World) w2 at w))
  (let ((unique w1) (many _)) (world-do _ w (WriteOut "argument ran\n")))
  w1)
(def-fns _ $ (many pass : (unique (World) w at vacant-slot) -> (unique (World) w2 at w)) w)
(def-fns _ $ (many crashy : (many (Nat) n) ->
    (many (Fn (level-of pass) (unique (World) w at vacant-slot) -> (unique (World) w2 at w)) f))
  (let ((many z)) (deep n))
  pass)
(def-lvl io)
(def-unique io $ (unique start : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io) p))
  (let ((unique w1)) ((crashy 100) (say w)))
  (values w1 (Exit _ (MkU8 (Zero) u8-modulus-pos))))
(Continue _ start)
