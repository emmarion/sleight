(def-fns _ $ (many deep : (subterm many (Nat) n) -> (many (Nat) r))
  (let-match many n (Succ m) ((Zero) 0))
  (Succ (notail (deep m))))
(def-fns _ $ (many tree : (subterm many (Nat) n) -> (many (Nat) r))
  (let-match many n (Succ m) ((Zero) 0))
  (let ((many a)) (notail $ tree m))
  (let ((many b)) (notail $ tree m))
  0)
(def-fns _ $ (many big : (many (Nat) n) -> (many (Nat) r))
  (let ((erased xs) (unique a) (erased p)) (array-new (Nat) n))
  0)
(def-fns _ $ (many top : (many (Nat) n) (many (Nat) t) (many (Nat) h) -> (many (Nat) r))
  (let ((many d)) (deep n))
  (let ((many s)) (tree t))
  (big h))
(let ((many r)) (top 150 24 1152921504606846976))
r
