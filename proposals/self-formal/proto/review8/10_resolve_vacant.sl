(let ((many s-set)) "resolve answered RSettled")
(let ((many s-hyp)) "resolve answered RHypothetical")
(let ((many s-unb)) "resolve answered RUnbound")
(def-fns _ $ (many warn-raw : (many (Pos) here) (many (String) name) -> (many (Raw) r))
  (RawList here $ Cons _ (RawSymbol here (SName "compile-warn")) $ Cons _ (RawSymbol here (SName name)) $ Nil _))
(def-fns _ $ (many probe-fn : (unique (MacroWorld) mw at vacant-slot) (many (Pos) here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let-match many args (Cons _ a _) ((Nil _) (values mw (Nil _))))
  (let-match many a (RawSymbol _ s) (else (values mw (Nil _))))
  (let ((unique mw1) (many r)) (resolve mw s))
  (let ((many t)) $ match many r (((String) _))
    ((RSettled _ _ _ h) "s-set")
    ((RHypothetical) "s-hyp")
    ((RUnbound) "s-unb"))
  (values mw1 $ Cons _ (warn-raw here t) $ Nil _))
(let ((many probe)) (MkMacro _ probe-fn))
(let ((many v)) vacant-slot)
(probe vacant-slot)
(probe v)
(compile-error "first")
(probe vacant-slot)
(probe v)
