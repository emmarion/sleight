(def-lvl K)
(def-lvl KC)
(def-fns _ $ (erased g2-fixed : (erased (TyCtor ((Fm) c) -> Type) P) (erased (Fm) g)
    (erased (Fn K (erased (Fm) a) (erased (Fm) b) (erased (P (Imp a b)) pab) (erased (P a) pa) -> (erased (P b) pb)) d2)
    (erased (Fn K (erased (Fm) a) (erased (P a) pa) -> (erased (P (Pv a)) ppa)) d3)
    (erased (P (Imp g (Imp (Pv g) (Bot)))) dg)
    (erased (Fn KC (erased (P (Bot)) q) -> (erased (False) no)) c)
    (erased (P g) p) -> (erased (False) no))
  (c $ d2 _ _ (d2 _ _ dg p) (d3 _ p)))
(def-adts $ (G2Fixed : -> Type)
  enum
  (many MkG2Fixed : (erased (Level) L)
     (erased (Fn L (erased (TyCtor ((Fm) c) -> Type) P) (erased (Fm) g)
       (erased (Fn K (erased (Fm) a) (erased (Fm) b) (erased (P (Imp a b)) pab) (erased (P a) pa) -> (erased (P b) pb)) d2)
       (erased (Fn K (erased (Fm) a) (erased (P a) pa) -> (erased (P (Pv a)) ppa)) d3)
       (erased (P (Imp g (Imp (Pv g) (Bot)))) dg)
       (erased (Fn KC (erased (P (Bot)) q) -> (erased (False) no)) c)
       (erased (P g) p) -> (erased (False) no)) f)
     -> (G2Fixed)))
(goal erased (G2Fixed))
(qed (MkG2Fixed _ g2-fixed))
