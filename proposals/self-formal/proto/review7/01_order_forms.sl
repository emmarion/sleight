(def-fns _ $ (many gs-fn : (unique (MacroWorld) mw at vacant-slot) (many (Pos) here) (many (List $ Raw) args) ->
    (unique (MacroWorld) mw2 at mw) (many (List $ Raw) out))
  (let ((unique mw1) (many k) (erased g)) (gensym mw "t"))
  (let ((unique mw2) (many h)) (intern-nat mw1 k))
  (values mw2 $ Cons _ (RawSettled here _ _ _ h) $ Nil _))
(let ((many gs)) (MkMacro _ gs-fn))
(def-fns _ $ (many f : (many (Pair (Nat) (Nat)) x) (many (Nat) y) (many (Nat) z) -> (many (Pair (Pair (Nat) (Nat)) (Pair (Nat) (Nat))) r))
  (MkPair _ _ x $ MkPair _ _ y z))
(let ((many a) (many b) (many c)) (values (MkPair _ _ (gs) (gs)) (gs) (gs)))
(let ((many d)) (let ((many x)) (MkPair _ _ (gs) (gs))) (MkPair _ _ (gs) x))
(let ((many e)) (f (MkPair _ _ (gs) (gs)) (gs) (gs)))
(MkPair _ _ (MkPair _ _ a $ MkPair _ _ b c) $ MkPair _ _ d e)
