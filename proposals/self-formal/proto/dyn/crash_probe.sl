(def-fns _ $ (many deep : (subterm many (Nat) n) -> (many (Nat) r))
  (let-match many n (Succ m) ((Zero) 0))
  (Succ (notail (deep m))))
(def-fns _ $ (many say : (unique (World) w at vacant-slot) (many (String) s) -> (unique (World) w2 at w))
  (let ((unique w1) (many _)) (world-do _ w (WriteOut s)))
  w1)
(def-fns _ $ (many said : (unique (World) w at vacant-slot) (many (Nat) n) -> (unique (World) w2 at w))
  (say w "after\n"))
(def-lvl io)
(def-unique io $ (unique start : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io) p))
  (let ((unique w1)) (say w "before\n"))
  (let ((unique w2)) (said w1 (deep 100000000)))
  (values w2 (Exit _ (MkU8 (Zero) u8-modulus-pos))))
(Continue _ start)
