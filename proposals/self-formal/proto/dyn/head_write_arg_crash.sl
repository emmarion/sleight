(def-fns _ $ (many deep : (subterm many (Nat) n) -> (many (Nat) r))
  (let-match many n (Succ m) ((Zero) 0))
  (Succ (notail (deep m))))
(def-lvl K)
(def-fns _ $ (many mk : (unique (World) w at vacant-slot) ->
    (unique (UniqueFn K (many (Nat) x) -> (unique (World) w2 at vacant-slot)) k))
  (let ((unique w1) (many _)) (world-do _ w (WriteOut "head ran\n")))
  (def-unique K $ (unique k : (many (Nat) x) -> (unique (World) w2 at vacant-slot)) w1)
  k)
(def-lvl io)
(def-unique io $ (unique start : (unique (World) w at vacant-slot) -> (unique (World) w2 at w) (unique (Program io) p))
  (let ((unique w1)) ((mk w) (deep 100000000)))
  (values w1 (Exit _ (MkU8 (Zero) u8-modulus-pos))))
(Continue _ start)
